,"_20528":48151,"_26889":15},"Deploy from AWS Marketplace",[48148,48149,48150],"Docs","Deployment","Other models",[],{"_3376":16,"_29554":15,"_20528":48153,"_5":14087,"_26889":15,"_2862":48154},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_3376":17,"_29554":15,"_5":29903,"_20528":48156,"_26889":48157,"_2862":48158},[],"/docs/pr-preview/pr-52/deployment/aws-marketplace#before-you-begin","Before you begin",{"_3376":18,"_29554":15,"_5":29903,"_20528":48160,"_26889":48161,"_2862":48162},[],"/docs/pr-preview/pr-52/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_3376":19,"_29554":15,"_5":29903,"_20528":48164,"_26889":48165,"_2862":48166},[],"/docs/pr-preview/pr-52/deployment/aws-marketplace#open-the-offer","Open the offer",{"_3376":20,"_29554":15,"_5":29903,"_20528":48168,"_26889":48169,"_2862":48170},[],"/docs/pr-preview/pr-52/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_3376":21,"_29554":15,"_5":29903,"_20528":48172,"_26889":48173,"_2862":48174},[],"/docs/pr-preview/pr-52/deployment/aws-marketplace#limit-network-access","Limit network access",{"_3376":22,"_29554":15,"_5":29903,"_20528":48176,"_26889":48177,"_2862":48178},[],"/docs/pr-preview/pr-52/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_3376":23,"_29554":15,"_5":29903,"_20528":48180,"_26889":48181,"_2862":48182},[],"/docs/pr-preview/pr-52/deployment/aws-marketplace#next-step","Next step",{"_3376":24,"_29554":15,"_20528":48184,"_5":14087,"_26889":15,"_2862":48185},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_3376":25,"_29554":15,"_20528":48187,"_5":14087,"_26889":48157,"_2862":48188},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_3376":26,"_29554":15,"_20528":48190,"_5":14087,"_26889":48157,"_2862":48191},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_3376":27,"_29554":15,"_20528":48193,"_5":14087,"_26889":48157,"_2862":48194},[],"A security group allowing the necessary endpoints.",{"_3376":28,"_29554":15,"_20528":48196,"_5":14087,"_26889":48161,"_2862":48197},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_3376":29,"_29554":15,"_20528":48199,"_5":14087,"_26889":48161,"_2862":48200},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_3376":30,"_29554":15,"_20528":48202,"_5":14087,"_26889":48161,"_2862":48203},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_3376":31,"_29554":15,"_20528":48205,"_5":14087,"_26889":48165,"_2862":48206},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_3376":32,"_29554":15,"_20528":48208,"_5":14087,"_26889":48169,"_2862":48209},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_3376":33,"_29554":15,"_20528":48211,"_5":14087,"_26889":48173,"_2862":48212},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_3376":34,"_29554":15,"_20528":48214,"_5":14087,"_26889":48177,"_2862":48215},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_3376":35,"_29554":15,"_20528":48217,"_5":14087,"_26889":48181,"_2862":48218},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_3376":36,"_29554":36,"_5":14445,"_2862":48220,"_29906":48221,"_20528":48222,"_26889":36},"Deploy Lamassu",[48148,48149],[],{"_3376":37,"_29554":36,"_20528":48224,"_5":14087,"_26889":36,"_2862":48225},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_3376":38,"_29554":36,"_5":29903,"_20528":48227,"_26889":48228,"_2862":48229},[],"/docs/pr-preview/pr-52/deployment/overview#choose-a-model","Choose a model",{"_3376":39,"_29554":36,"_5":29903,"_20528":48231,"_26889":48232,"_2862":48233},[],"/docs/pr-preview/pr-52/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_3376":40,"_29554":36,"_5":29903,"_20528":48235,"_26889":48236,"_2862":48237},[],"/docs/pr-preview/pr-52/deployment/overview#after-deployment","After deployment",{"_3376":41,"_29554":36,"_20528":48239,"_5":14087,"_26889":36,"_2862":48240},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_3376":42,"_29554":36,"_20528":48242,"_5":14087,"_26889":48228,"_2862":48243},[],"Model",{"_3376":43,"_29554":36,"_20528":48245,"_5":14087,"_26889":48228,"_2862":48246},[],"Recommended for",{"_3376":44,"_29554":36,"_20528":48248,"_5":14087,"_26889":48228,"_2862":48249},[],"Who operates the infrastructure",{"_3376":45,"_29554":36,"_20528":48251,"_5":14087,"_26889":48228,"_2862":48252},[],"Starting point",{"_3376":46,"_29554":36,"_20528":48254,"_5":14087,"_26889":48228,"_2862":48255},[],"Kubernetes self-managed",{"_3376":47,"_29554":36,"_20528":48257,"_5":14087,"_26889":48228,"_2862":48258},[],"Production, regulated environments and custom deployments",{"_3376":48,"_29554":36,"_20528":48260,"_5":14087,"_26889":48228,"_2862":48261},[],"Your team",{"_3376":49,"_29554":36,"_20528":48263,"_5":14087,"_26889":48228,"_2862":48264},[],"Helm or Fastlane",{"_3376":50,"_29554":36,"_20528":48266,"_5":14087,"_26889":48228,"_2862":48267},[],"AWS Marketplace",{"_3376":51,"_29554":36,"_20528":48269,"_5":14087,"_26889":48228,"_2862":48270},[],"Evaluation or a dedicated deployment inside an AWS account",{"_3376":52,"_29554":36,"_20528":48272,"_5":14087,"_26889":48228,"_2862":48261},[],{"_3376":53,"_29554":36,"_20528":48274,"_5":14087,"_26889":48228,"_2862":48275},[],"Preconfigured image on EC2",{"_3376":54,"_29554":36,"_20528":48277,"_5":14087,"_26889":48228,"_2862":48278},[],"SaaS",{"_3376":55,"_29554":36,"_20528":48280,"_5":14087,"_26889":48228,"_2862":48281},[],"Teams that want to use the platform without operating it",{"_3376":56,"_29554":36,"_20528":48283,"_5":14087,"_26889":48228,"_2862":48284},[],"Lamassu",{"_3376":57,"_29554":36,"_20528":48286,"_5":14087,"_26889":48228,"_2862":48287},[],"Managed subscription",{"_3376":58,"_29554":36,"_20528":48289,"_5":14087,"_26889":48228,"_2862":48290},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3376":59,"_29554":36,"_20528":48292,"_5":14087,"_26889":48228,"_2862":48293},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3376":60,"_29554":36,"_20528":48295,"_5":14087,"_26889":48228,"_2862":48296},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_3376":61,"_29554":36,"_20528":48298,"_5":14087,"_26889":48232,"_2862":48299},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_3376":62,"_29554":36,"_20528":48301,"_5":14087,"_26889":48236,"_2862":48302},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_3376":63,"_29554":63,"_5":14445,"_2862":48304,"_29906":48305,"_20528":48306,"_26889":63},"Use Lamassu as SaaS",[48148,48149,48150],[],{"_3376":64,"_29554":63,"_20528":48308,"_5":14087,"_26889":63,"_2862":48309},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_3376":65,"_29554":63,"_5":29903,"_20528":48311,"_26889":48312,"_2862":48313},[],"/docs/pr-preview/pr-52/deployment/saas#what-the-service-manages","What the service manages",{"_3376":66,"_29554":63,"_5":29903,"_20528":48315,"_26889":48316,"_2862":48317},[],"/docs/pr-preview/pr-52/deployment/saas#plans","Plans",{"_3376":67,"_29554":63,"_5":29903,"_20528":48319,"_26889":48320,"_2862":48321},[],"/docs/pr-preview/pr-52/deployment/saas#request-access","Request access",{"_3376":68,"_29554":63,"_20528":48323,"_5":14087,"_26889":63,"_2862":48324},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_3376":69,"_29554":63,"_20528":48326,"_5":14087,"_26889":48312,"_2862":48327},[],"Platform availability and maintenance.",{"_3376":70,"_29554":63,"_20528":48329,"_5":14087,"_26889":48312,"_2862":48330},[],"Automatic backups.",{"_3376":71,"_29554":63,"_20528":48332,"_5":14087,"_26889":48312,"_2862":48333},[],"Version upgrades.",{"_3376":72,"_29554":63,"_20528":48335,"_5":14087,"_26889":48312,"_2862":48336},[],"Technical support and SLA according to your plan.",{"_3376":73,"_29554":63,"_20528":48338,"_5":14087,"_26889":48316,"_2862":48339},[],"Plan",{"_3376":74,"_29554":63,"_20528":48341,"_5":14087,"_26889":48316,"_2862":48342},[],"Devices",{"_3376":75,"_29554":63,"_20528":48344,"_5":14087,"_26889":48316,"_2862":48345},[],"Support",{"_3376":76,"_29554":63,"_20528":48347,"_5":14087,"_26889":48316,"_2862":48348},[],"SLA",{"_3376":77,"_29554":63,"_20528":48350,"_5":14087,"_26889":48316,"_2862":48351},[],"Starter",{"_3376":78,"_29554":63,"_20528":48353,"_5":14087,"_26889":48316,"_2862":48354},[],"Up to 1,000",{"_3376":79,"_29554":63,"_20528":48356,"_5":14087,"_26889":48316,"_2862":48357},[],"Email",{"_3376":80,"_29554":63,"_20528":48359,"_5":14087,"_26889":48316,"_2862":48360},[],"99.5 %",{"_3376":81,"_29554":63,"_20528":48362,"_5":14087,"_26889":48316,"_2862":48363},[],"Professional",{"_3376":82,"_29554":63,"_20528":48365,"_5":14087,"_26889":48316,"_2862":48366},[],"Up to 10,000",{"_3376":83,"_29554":63,"_20528":48368,"_5":14087,"_26889":48316,"_2862":48369},[],"Email and chat",{"_3376":84,"_29554":63,"_20528":48371,"_5":14087,"_26889":48316,"_2862":48372},[],"99.9 %",{"_3376":85,"_29554":63,"_20528":48374,"_5":14087,"_26889":48316,"_2862":48375},[],"Enterprise",{"_3376":86,"_29554":63,"_20528":48377,"_5":14087,"_26889":48316,"_2862":48378},[],"Unlimited",{"_3376":87,"_29554":63,"_20528":48380,"_5":14087,"_26889":48316,"_2862":48381},[],"Dedicated",{"_3376":88,"_29554":63,"_20528":48383,"_5":14087,"_26889":48316,"_2862":48384},[],"99.99 %",{"_3376":89,"_29554":63,"_20528":48386,"_5":14087,"_26889":48320,"_2862":48387},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_3376":90,"_29554":63,"_20528":48389,"_5":14087,"_26889":48320,"_2862":48390},[],"When you receive your instance's credentials, continue with Get started.",{"_3376":91,"_29554":91,"_5":14445,"_2862":48392,"_29906":48393,"_20528":48394,"_26889":91},"Fastlane",[48148,48149,48255],[],{"_3376":92,"_29554":91,"_20528":48396,"_5":14087,"_26889":91,"_2862":48397},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_3376":93,"_29554":91,"_5":29903,"_20528":48399,"_26889":48400,"_2862":48401},[],"/docs/pr-preview/pr-52/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_3376":94,"_29554":91,"_5":29903,"_20528":48403,"_26889":48404,"_2862":48405},[],"/docs/pr-preview/pr-52/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_3376":95,"_29554":91,"_5":29903,"_20528":48407,"_26889":48408,"_2862":48158},[],"/docs/pr-preview/pr-52/deployment/self-hosted/fastlane#before-you-begin",{"_3376":96,"_29554":91,"_5":29903,"_20528":48410,"_26889":48411,"_2862":48412},[],"/docs/pr-preview/pr-52/deployment/self-hosted/fastlane#quick-start","Quick start",{"_3376":97,"_29554":91,"_5":29903,"_20528":48414,"_26889":48415,"_2862":48416},[],"/docs/pr-preview/pr-52/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_3376":98,"_29554":91,"_5":29903,"_20528":48418,"_26889":48419,"_2862":48420},[],"/docs/pr-preview/pr-52/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_3376":99,"_29554":91,"_5":29903,"_20528":48422,"_26889":48423,"_2862":48424},[],"/docs/pr-preview/pr-52/deployment/self-hosted/fastlane#development-mode","Development mode",{"_3376":100,"_29554":91,"_5":29903,"_20528":48426,"_26889":48427,"_2862":48428},[],"/docs/pr-preview/pr-52/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_3376":101,"_29554":91,"_5":29903,"_20528":48430,"_26889":48431,"_2862":48432},[],"/docs/pr-preview/pr-52/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_3376":102,"_29554":91,"_5":29903,"_20528":48434,"_26889":48435,"_2862":48436},[],"/docs/pr-preview/pr-52/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_3376":103,"_29554":91,"_5":29903,"_20528":48438,"_26889":48439,"_2862":48440},[],"/docs/pr-preview/pr-52/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_3376":104,"_29554":91,"_20528":48442,"_5":14087,"_26889":48400,"_2862":48443},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_3376":105,"_29554":91,"_20528":48445,"_5":14087,"_26889":48400,"_2862":48446},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_3376":106,"_29554":91,"_20528":48448,"_5":14087,"_26889":48404,"_2862":48449},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_3376":107,"_29554":91,"_20528":48451,"_5":14087,"_26889":48404,"_2862":48452},[],"Fastlane installs or configures",{"_3376":108,"_29554":91,"_20528":48454,"_5":14087,"_26889":48404,"_2862":48455},[],"You still provide",{"_3376":109,"_29554":91,"_20528":48457,"_5":14087,"_26889":48404,"_2862":48458},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_3376":110,"_29554":91,"_20528":48460,"_5":14087,"_26889":48404,"_2862":48461},[],"The Kubernetes cluster, nodes and persistent storage",{"_3376":111,"_29554":91,"_20528":48463,"_5":14087,"_26889":48404,"_2862":48464},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_3376":112,"_29554":91,"_20528":48466,"_5":14087,"_26889":48404,"_2862":48467},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_3376":113,"_29554":91,"_20528":48469,"_5":14087,"_26889":48404,"_2862":48470},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_3376":114,"_29554":91,"_20528":48472,"_5":14087,"_26889":48404,"_2862":48473},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_3376":115,"_29554":91,"_20528":48475,"_5":14087,"_26889":48404,"_2862":48476},[],"Optional observability and lab HSM components",{"_3376":116,"_29554":91,"_20528":48478,"_5":14087,"_26889":48404,"_2862":48479},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_3376":117,"_29554":91,"_20528":48481,"_5":14087,"_26889":48404,"_2862":48482},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_3376":118,"_29554":91,"_20528":48484,"_5":14087,"_26889":48408,"_2862":48485},[],"You need:",{"_3376":119,"_29554":91,"_20528":48487,"_5":14087,"_26889":48408,"_2862":48488},[],"an existing Kubernetes cluster",{"_3376":120,"_29554":91,"_20528":48490,"_5":14087,"_26889":48408,"_2862":48491},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_3376":121,"_29554":91,"_20528":48493,"_5":14087,"_26889":48408,"_2862":48494},[],"`yq`",{"_3376":122,"_29554":91,"_20528":48496,"_5":14087,"_26889":48408,"_2862":23209},[],{"_3376":123,"_29554":91,"_20528":48498,"_5":14087,"_26889":48408,"_2862":48499},[],"`jq` only when using `--sample-data` or `--development`",{"_3376":124,"_29554":91,"_20528":48501,"_5":14087,"_26889":48408,"_2862":48502},[],"`ssh-keygen` only when using `--with-hsm`",{"_3376":125,"_29554":91,"_20528":48504,"_5":14087,"_26889":48408,"_2862":48505},[],"free external ports 80 and 443 on a single-node K3s host",{"_3376":126,"_29554":91,"_20528":48507,"_5":14087,"_26889":48408,"_2862":48508},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_3376":127,"_29554":91,"_20528":48510,"_5":14087,"_26889":48408,"_2862":48511},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_3376":128,"_29554":91,"_20528":48513,"_5":14087,"_26889":48411,"_2862":48514},[],"Run the script from a clone of the Helm repository:",{"_3376":129,"_29554":91,"_20528":48516,"_5":14087,"_26889":48411,"_2862":48517},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_3376":130,"_29554":91,"_20528":48519,"_5":14087,"_26889":48415,"_2862":48520},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_3376":131,"_29554":91,"_20528":48522,"_5":14087,"_26889":48415,"_2862":48523},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_3376":132,"_29554":91,"_20528":48525,"_5":14087,"_26889":48415,"_2862":48526},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_3376":133,"_29554":91,"_20528":48528,"_5":14087,"_26889":48415,"_2862":48529},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_3376":134,"_29554":91,"_20528":48531,"_5":14087,"_26889":48419,"_2862":48532},[],"Option",{"_3376":135,"_29554":91,"_20528":48534,"_5":14087,"_26889":48419,"_2862":48535},[],"Default",{"_3376":136,"_29554":91,"_20528":48537,"_5":14087,"_26889":48419,"_2862":48538},[],"Purpose",{"_3376":137,"_29554":91,"_20528":48540,"_5":14087,"_26889":48419,"_2862":48541},[],"`-h`, `--help`",{"_3376":138,"_29554":91,"_20528":48543,"_5":14087,"_26889":48419,"_2862":48544},[],"—",{"_3376":139,"_29554":91,"_20528":48546,"_5":14087,"_26889":48419,"_2862":48547},[],"Show help",{"_3376":140,"_29554":91,"_20528":48549,"_5":14087,"_26889":48419,"_2862":48550},[],"`-c`, `--context`",{"_3376":141,"_29554":91,"_20528":48552,"_5":14087,"_26889":48419,"_2862":48553},[],"current context",{"_3376":142,"_29554":91,"_20528":48555,"_5":14087,"_26889":48419,"_2862":48556},[],"Select the kubeconfig context for kubectl and Helm",{"_3376":143,"_29554":91,"_20528":48558,"_5":14087,"_26889":48419,"_2862":48559},[],"`-n`, `--non-interactive`",{"_3376":144,"_29554":91,"_20528":48561,"_5":14087,"_26889":48419,"_2862":6382},[],{"_3376":145,"_29554":91,"_20528":48563,"_5":14087,"_26889":48419,"_2862":48564},[],"Skip prompts and generate dependency credentials",{"_3376":146,"_29554":91,"_20528":48566,"_5":14087,"_26889":48419,"_2862":48567},[],"`-ns`, `--namespace`",{"_3376":147,"_29554":91,"_20528":48569,"_5":14087,"_26889":48419,"_2862":48570},[],"`lamassu-dev`",{"_3376":148,"_29554":91,"_20528":48572,"_5":14087,"_26889":48419,"_2862":48573},[],"Namespace for the installation",{"_3376":149,"_29554":91,"_20528":48575,"_5":14087,"_26889":48419,"_2862":48576},[],"`-d`, `--domain`",{"_3376":150,"_29554":91,"_20528":48578,"_5":14087,"_26889":48419,"_2862":48579},[],"`dev.lamassu.io`",{"_3376":151,"_29554":91,"_20528":48581,"_5":14087,"_26889":48419,"_2862":48582},[],"Domain used by the UI, OIDC and certificate",{"_3376":152,"_29554":91,"_20528":48584,"_5":14087,"_26889":48419,"_2862":48585},[],"`-v`, `--version`",{"_3376":153,"_29554":91,"_20528":48587,"_5":14087,"_26889":48419,"_2862":14774},[],{"_3376":154,"_29554":91,"_20528":48589,"_5":14087,"_26889":48419,"_2862":48590},[],"Lamassu chart version",{"_3376":155,"_29554":91,"_20528":48592,"_5":14087,"_26889":48419,"_2862":48593},[],"`--https-port`",{"_3376":156,"_29554":91,"_20528":48595,"_5":14087,"_26889":48419,"_2862":48596},[],"`443`",{"_3376":157,"_29554":91,"_20528":48598,"_5":14087,"_26889":48419,"_2862":48599},[],"Gateway HTTPS listener port",{"_3376":158,"_29554":91,"_20528":48601,"_5":14087,"_26889":48419,"_2862":48602},[],"`--http-port`",{"_3376":159,"_29554":91,"_20528":48604,"_5":14087,"_26889":48419,"_2862":48605},[],"`80`",{"_3376":160,"_29554":91,"_20528":48607,"_5":14087,"_26889":48419,"_2862":48608},[],"Gateway HTTP listener port",{"_3376":161,"_29554":91,"_20528":48610,"_5":14087,"_26889":48419,"_2862":48611},[],"`--tls-crt`",{"_3376":162,"_29554":91,"_20528":48613,"_5":14087,"_26889":48419,"_2862":48544},[],{"_3376":163,"_29554":91,"_20528":48615,"_5":14087,"_26889":48419,"_2862":48616},[],"PEM certificate for downstream TLS",{"_3376":164,"_29554":91,"_20528":48618,"_5":14087,"_26889":48419,"_2862":48619},[],"`--tls-key`",{"_3376":165,"_29554":91,"_20528":48621,"_5":14087,"_26889":48419,"_2862":48544},[],{"_3376":166,"_29554":91,"_20528":48623,"_5":14087,"_26889":48419,"_2862":48624},[],"PEM private key for downstream TLS",{"_3376":167,"_29554":91,"_20528":48626,"_5":14087,"_26889":48419,"_2862":48627},[],"`-l`, `--local-chart-path`",{"_3376":168,"_29554":91,"_20528":48629,"_5":14087,"_26889":48419,"_2862":48630},[],"repository chart",{"_3376":169,"_29554":91,"_20528":48632,"_5":14087,"_26889":48419,"_2862":48633},[],"Use an unpacked local Lamassu chart",{"_3376":170,"_29554":91,"_20528":48635,"_5":14087,"_26889":48419,"_2862":48636},[],"`-ip`, `--gateway-ip`",{"_3376":171,"_29554":91,"_20528":48638,"_5":14087,"_26889":48419,"_2862":8549},[],{"_3376":172,"_29554":91,"_20528":48640,"_5":14087,"_26889":48419,"_2862":48641},[],"Override the address written to `gateway.addresses`",{"_3376":173,"_29554":91,"_20528":48643,"_5":14087,"_26889":48419,"_2862":48644},[],"`--otel`",{"_3376":174,"_29554":91,"_20528":48646,"_5":14087,"_26889":48419,"_2862":6382},[],{"_3376":175,"_29554":91,"_20528":48648,"_5":14087,"_26889":48419,"_2862":48649},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_3376":176,"_29554":91,"_20528":48651,"_5":14087,"_26889":48419,"_2862":48652},[],"`--development`",{"_3376":177,"_29554":91,"_20528":48654,"_5":14087,"_26889":48419,"_2862":6382},[],{"_3376":178,"_29554":91,"_20528":48656,"_5":14087,"_26889":48419,"_2862":48657},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_3376":179,"_29554":91,"_20528":48659,"_5":14087,"_26889":48419,"_2862":48660},[],"`--sample-data`",{"_3376":180,"_29554":91,"_20528":48662,"_5":14087,"_26889":48419,"_2862":6382},[],{"_3376":181,"_29554":91,"_20528":48664,"_5":14087,"_26889":48419,"_2862":48665},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_3376":182,"_29554":91,"_20528":48667,"_5":14087,"_26889":48419,"_2862":48668},[],"`--with-hsm`",{"_3376":183,"_29554":91,"_20528":48670,"_5":14087,"_26889":48419,"_2862":6382},[],{"_3376":184,"_29554":91,"_20528":48672,"_5":14087,"_26889":48419,"_2862":48673},[],"Install lab HSM components and configure KMS for PKCS#11",{"_3376":185,"_29554":91,"_20528":48675,"_5":14087,"_26889":48419,"_2862":48676},[],"`--softhsm-chart-path`",{"_3376":186,"_29554":91,"_20528":48678,"_5":14087,"_26889":48419,"_2862":48679},[],"`./charts/softhsm`",{"_3376":187,"_29554":91,"_20528":48681,"_5":14087,"_26889":48419,"_2862":48682},[],"Use a different local SoftHSM chart",{"_3376":188,"_29554":91,"_20528":48684,"_5":14087,"_26889":48419,"_2862":48685},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_3376":189,"_29554":91,"_20528":48687,"_5":14087,"_26889":48423,"_2862":48688},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_3376":190,"_29554":91,"_20528":48690,"_5":14087,"_26889":48423,"_2862":48691},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_3376":191,"_29554":91,"_20528":48693,"_5":14087,"_26889":48423,"_2862":48694},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_3376":192,"_29554":91,"_20528":48696,"_5":14087,"_26889":48423,"_2862":48697},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_3376":193,"_29554":91,"_20528":48699,"_5":14087,"_26889":48423,"_2862":48700},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_3376":194,"_29554":91,"_20528":48702,"_5":14087,"_26889":48423,"_2862":48703},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_3376":195,"_29554":91,"_20528":48705,"_5":14087,"_26889":48427,"_2862":48706},[],"Fastlane:",{"_3376":196,"_29554":91,"_20528":48708,"_5":14087,"_26889":48427,"_2862":48709},[],"validates local tools and the selected cluster",{"_3376":197,"_29554":91,"_20528":48711,"_5":14087,"_26889":48427,"_2862":48712},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_3376":198,"_29554":91,"_20528":48714,"_5":14087,"_26889":48427,"_2862":48715},[],"creates the namespace",{"_3376":199,"_29554":91,"_20528":48717,"_5":14087,"_26889":48427,"_2862":48718},[],"installs PostgreSQL and creates the required databases",{"_3376":200,"_29554":91,"_20528":48720,"_5":14087,"_26889":48427,"_2862":48721},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_3376":201,"_29554":91,"_20528":48723,"_5":14087,"_26889":48427,"_2862":48724},[],"installs RabbitMQ",{"_3376":202,"_29554":91,"_20528":48726,"_5":14087,"_26889":48427,"_2862":48727},[],"optionally installs observability and lab HSM components",{"_3376":203,"_29554":91,"_20528":48729,"_5":14087,"_26889":48427,"_2862":48730},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_3376":204,"_29554":91,"_20528":48732,"_5":14087,"_26889":48427,"_2862":48733},[],"optionally loads sample data",{"_3376":205,"_29554":91,"_20528":48735,"_5":14087,"_26889":48427,"_2862":48736},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_3376":206,"_29554":91,"_20528":48738,"_5":14087,"_26889":48431,"_2862":48739},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_3376":207,"_29554":91,"_20528":48741,"_5":14087,"_26889":48431,"_2862":48742},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_3376":208,"_29554":91,"_20528":48744,"_5":14087,"_26889":48435,"_2862":48745},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_3376":209,"_29554":91,"_20528":48747,"_5":14087,"_26889":48435,"_2862":48748},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_3376":210,"_29554":91,"_20528":48750,"_5":14087,"_26889":48435,"_2862":48751},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_3376":211,"_29554":91,"_20528":48753,"_5":14087,"_26889":48439,"_2862":48754},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_3376":212,"_29554":212,"_5":14445,"_2862":48756,"_29906":48757,"_20528":48758,"_26889":212},"Install with Helm",[48148,48149,48255],[],{"_3376":213,"_29554":212,"_20528":48760,"_5":14087,"_26889":212,"_2862":48761},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_3376":214,"_29554":212,"_5":29903,"_20528":48763,"_26889":48764,"_2862":48765},[],"/docs/pr-preview/pr-52/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_3376":215,"_29554":212,"_5":29903,"_20528":48767,"_26889":48768,"_2862":48158},[],"/docs/pr-preview/pr-52/deployment/self-hosted/helm#before-you-begin",{"_3376":216,"_29554":212,"_5":29903,"_20528":48770,"_26889":48771,"_2862":48772},[],"/docs/pr-preview/pr-52/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_3376":217,"_29554":212,"_5":29903,"_20528":48774,"_26889":48775,"_2862":48776},[],"/docs/pr-preview/pr-52/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_3376":218,"_29554":212,"_5":29903,"_20528":48778,"_26889":48779,"_2862":48780},[],"/docs/pr-preview/pr-52/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_3376":219,"_29554":212,"_5":29903,"_20528":48782,"_26889":48783,"_2862":48784},[],"/docs/pr-preview/pr-52/deployment/self-hosted/helm#amqp-tls-amqps","AMQP TLS (AMQPS)",{"_3376":220,"_29554":212,"_5":29903,"_20528":48786,"_26889":48787,"_2862":48788},[],"/docs/pr-preview/pr-52/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_3376":221,"_29554":212,"_5":29903,"_20528":48790,"_26889":48791,"_2862":48792},[],"/docs/pr-preview/pr-52/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_3376":222,"_29554":212,"_5":29903,"_20528":48794,"_26889":48795,"_2862":48796},[],"/docs/pr-preview/pr-52/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_3376":223,"_29554":212,"_5":29903,"_20528":48798,"_26889":48799,"_2862":48800},[],"/docs/pr-preview/pr-52/deployment/self-hosted/helm#upgrading-lamassu","Upgrading Lamassu",{"_3376":224,"_29554":212,"_5":29903,"_20528":48802,"_26889":48803,"_2862":48804},[],"/docs/pr-preview/pr-52/deployment/self-hosted/helm#production-decisions","Production decisions",{"_3376":225,"_29554":212,"_20528":48806,"_5":14087,"_26889":48764,"_2862":48807},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_3376":226,"_29554":212,"_20528":48809,"_5":14087,"_26889":48768,"_2862":48810},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_3376":227,"_29554":212,"_20528":48812,"_5":14087,"_26889":48768,"_2862":48813},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_3376":228,"_29554":212,"_20528":48815,"_5":14087,"_26889":48768,"_2862":48816},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_3376":229,"_29554":212,"_20528":48818,"_5":14087,"_26889":48768,"_2862":48819},[],"a reachable RabbitMQ broker and credentials",{"_3376":230,"_29554":212,"_20528":48821,"_5":14087,"_26889":48768,"_2862":48822},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_3376":231,"_29554":212,"_20528":48824,"_5":14087,"_26889":48768,"_2862":48825},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_3376":232,"_29554":212,"_20528":48827,"_5":14087,"_26889":48768,"_2862":48828},[],"cert-manager 1.14+ (only for the default `tls.type: certManager` mode); for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_3376":233,"_29554":212,"_20528":48830,"_5":14087,"_26889":48768,"_2862":48831},[],"a StorageClass and an external traffic design",{"_3376":234,"_29554":212,"_20528":48833,"_5":14087,"_26889":48768,"_2862":48834},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_3376":235,"_29554":212,"_20528":48836,"_5":14087,"_26889":48768,"_2862":48837},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_3376":236,"_29554":212,"_20528":48839,"_5":14087,"_26889":48768,"_2862":48840},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_3376":237,"_29554":212,"_20528":48842,"_5":14087,"_26889":48771,"_2862":48843},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_3376":238,"_29554":212,"_20528":48845,"_5":14087,"_26889":48771,"_2862":48846},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_3376":239,"_29554":212,"_20528":48848,"_5":14087,"_26889":48771,"_2862":48849},[],"Install cert-manager separately before Lamassu, but only for the default `tls.type: certManager` mode. In that mode the chart renders its self-signed Issuer and CA Certificate resources regardless of whether `tls.certManagerOptions.clusterIssuer` is set, so cert-manager stays a prerequisite. With `tls.type: external`, the chart renders no cert-manager resources and the Gateway terminates TLS with an existing Secret you provide instead.",{"_3376":240,"_29554":212,"_20528":48851,"_5":14087,"_26889":48775,"_2862":48852},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_3376":241,"_29554":212,"_20528":48854,"_5":14087,"_26889":48775,"_2862":48855},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_3376":242,"_29554":212,"_20528":48857,"_5":14087,"_26889":48775,"_2862":48858},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_3376":243,"_29554":212,"_20528":48860,"_5":14087,"_26889":48775,"_2862":48861},[],"If your values file still carries the legacy gateway JWT validation settings — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` or `auth.authorization.roles.admin` — remove them. The migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documents their removal with no compatibility aliases, and `values.schema.json` rejects the leftover blocks instead of silently ignoring them. The replacements are `services.authz.jwkUrl` and `services.authz.bootstrap`, already shown in the example above.",{"_3376":244,"_29554":212,"_20528":48863,"_5":14087,"_26889":48779,"_2862":48864},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it. The Secret must already exist before installing: in `external` mode the chart renders no cert-manager resources and never creates this Secret.",{"_3376":245,"_29554":212,"_20528":48866,"_5":14087,"_26889":48783,"_2862":48867},[],"`amqp.tls: true` selects AMQPS in every event-bus configuration block. The default port stays `5672` and does not change automatically when TLS is enabled, so set `amqp.port` to the broker's TLS listener, commonly `5671`.",{"_3376":246,"_29554":212,"_20528":48869,"_5":14087,"_26889":48783,"_2862":48870},[],"With no CA Secret configured, the event-bus clients use the system-trusted CAs. To trust a private CA, create a Secret in the release namespace containing the CA certificate in PEM format and set `amqp.ca.secretName` (and `amqp.ca.certificateKey` if the data key is not `ca.crt`).",{"_3376":247,"_29554":212,"_20528":48872,"_5":14087,"_26889":48783,"_2862":48873},[],"For brokers that require mutual TLS, create a Secret containing the client certificate and private key and set `amqp.client.secretName` (with `amqp.client.certificateKey` and `amqp.client.privateKeyKey` if the data keys are not `tls.crt` and `tls.key`).",{"_3376":248,"_29554":212,"_20528":48875,"_5":14087,"_26889":48783,"_2862":48876},[],"The chart mounts configured Secrets read-only into every AMQP-consuming workload: the CA certificate under `/etc/lamassu/amqp/ca` and the client certificate and key under `/etc/lamassu/amqp/client`. The mounted file names are always `ca.crt`, `tls.crt` and `tls.key` — the `certificateKey` and `privateKeyKey` values rename only the Secret data keys, never the on-disk paths. The client private key is mounted with restrictive permissions (`defaultMode: 0440`; the CA volume uses `0444`), which works because the chart adds `fsGroup` to the pod security context when `amqp.client.secretName` is set — it uses the container `runAsGroup` (default `65532`) when `fsGroup` is not already set.",{"_3376":249,"_29554":212,"_20528":48878,"_5":14087,"_26889":48783,"_2862":48879},[],"Both Secret options require `amqp.tls: true`: `values.schema.json` rejects a non-empty `secretName` when `tls` is false, rejects unknown keys and rejects data-key names outside `^[A-Za-z0-9._-]+$`. The referenced Secret must exist in the release namespace or the consuming pods fail to start.",{"_3376":250,"_29554":212,"_20528":48881,"_5":14087,"_26889":48783,"_2862":48882},[],"The AMQP client loads certificates at startup, so restart the consuming pods after updating either Secret. Changing any `amqp` value rolls the consuming pods through the `checksum/config` annotation, but a change to Secret content alone does not trigger a rollout.",{"_3376":251,"_29554":212,"_20528":48884,"_5":14087,"_26889":48783,"_2862":48885},[],"Per the migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: in 3.8.0 `amqp.tls` was not applied and event-bus clients used plaintext AMQP; from 4.0.0, `amqp.tls: true` switches them to AMQPS. Set `amqp.port` to the broker TLS listener before upgrading, or set `amqp.tls: false` to keep plaintext AMQP. `amqp.tls: false` sends the broker credentials and all event-bus traffic in cleartext.",{"_3376":252,"_29554":212,"_20528":48887,"_5":14087,"_26889":48787,"_2862":48888},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_3376":253,"_29554":212,"_20528":48890,"_5":14087,"_26889":48787,"_2862":48891},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_3376":254,"_29554":212,"_20528":48893,"_5":14087,"_26889":48787,"_2862":48894},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_3376":255,"_29554":212,"_20528":48896,"_5":14087,"_26889":48787,"_2862":48897},[],"See Access control for the principal and policy model.",{"_3376":256,"_29554":212,"_20528":48899,"_5":14087,"_26889":48791,"_2862":48900},[],"To install a local checkout instead:",{"_3376":257,"_29554":212,"_20528":48902,"_5":14087,"_26889":48795,"_2862":48903},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_3376":258,"_29554":212,"_20528":48905,"_5":14087,"_26889":48795,"_2862":48906},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_3376":259,"_29554":212,"_20528":48908,"_5":14087,"_26889":48799,"_2862":48909},[],"Version-specific upgrade steps live in `charts/lamassu/CHANGELOG/` in the Helm repository. The chart also ships an optional pre-upgrade Job that migrates existing CA private keys into the KMS engine configured for the release. It is off by default (`migrations.caToKms.enabled: false`) and is only needed when upgrading from a version prior to 3.7.0.",{"_3376":260,"_29554":212,"_20528":48911,"_5":14087,"_26889":48799,"_2862":48912},[],"While the flag is enabled, every `helm upgrade` creates the `<chart fullname>-ca-to-kms-migration` Job (`lamassu-ca-to-kms-migration` for release `lamassu`); a fresh install does not create it. Its hook weight is `-10`, so it runs before the other pre-upgrade hooks: the authorization bootstrap configuration (weight `-4`) and the database-migration Job (weight `-3`).",{"_3376":261,"_29554":212,"_20528":48914,"_5":14087,"_26889":48799,"_2862":48915},[],"The Job consumes the same KMS service configuration the chart renders into the KMS ConfigMap, including the engines from `services.kms.cryptoEngines`, and runs the migration tool defined in `migrations.caToKms.image`. It mounts that configuration read-only at `/etc/lamassuiot/config.yml` from the ConfigMap key `config`, so configure the destination engine in your values before the upgrade that performs the migration.",{"_3376":262,"_29554":212,"_20528":48917,"_5":14087,"_26889":48799,"_2862":48918},[],"The Job resolves its configuration through a projected volume with two optional sources: the release-scoped `<chart fullname>-kms-config` (`lamassu-kms-config` for release `lamassu`, `prod-lamassu-kms-config` for release `prod`) and the legacy unscoped `kms-config` created by chart versions before release-scoped naming. The legacy configuration remains authoritative while it is still present, and the release-scoped one is used once the legacy one is gone. Both sources are optional, so a missing ConfigMap never leaves the upgrade pod in `ContainerCreating`.",{"_3376":263,"_29554":212,"_20528":48920,"_5":14087,"_26889":48799,"_2862":48921},[],"Keep `migrations.caToKms.enabled: true` for the upgrade that performs the migration, then remove the flag from your values once the migration completes; it defaults to `false`.",{"_3376":264,"_29554":212,"_20528":48923,"_5":14087,"_26889":48803,"_2862":48924},[],"Before going live, review:",{"_3376":265,"_29554":212,"_20528":48926,"_5":14087,"_26889":48803,"_2862":48927},[],"backup and recovery for PostgreSQL and persistent volumes",{"_3376":266,"_29554":212,"_20528":48929,"_5":14087,"_26889":48803,"_2862":48930},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_3376":267,"_29554":212,"_20528":48932,"_5":14087,"_26889":48803,"_2862":48933},[],"shared VA storage before increasing VA replicas",{"_3376":268,"_29554":212,"_20528":48935,"_5":14087,"_26889":48803,"_2862":48936},[],"managed OIDC roles and removal of evaluation credentials",{"_3376":269,"_29554":212,"_20528":48938,"_5":14087,"_26889":48803,"_2862":48939},[],"a trusted TLS issuer or externally managed certificate",{"_3376":270,"_29554":212,"_20528":48941,"_5":14087,"_26889":48803,"_2862":48942},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_3376":271,"_29554":212,"_20528":48944,"_5":14087,"_26889":48803,"_2862":48945},[],"SMTP, observability and alert delivery",{"_3376":272,"_29554":212,"_20528":48947,"_5":14087,"_26889":48803,"_2862":48948},[],"the version upgrade guides and migration notes in `charts/lamassu/CHANGELOG/` before every upgrade, including the optional CA-to-KMS migration hook described above",{"_3376":273,"_29554":212,"_20528":48950,"_5":14087,"_26889":48803,"_2862":48951},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_3376":274,"_29554":274,"_5":14445,"_2862":48953,"_29906":48954,"_20528":48955,"_26889":274},"Expose the Gateway",[48148,48149,48255],[],{"_3376":275,"_29554":274,"_20528":48957,"_5":14087,"_26889":274,"_2862":48958},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_3376":276,"_29554":274,"_5":29903,"_20528":48960,"_26889":48961,"_2862":48962},[],"/docs/pr-preview/pr-52/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_3376":277,"_29554":274,"_5":29903,"_20528":48964,"_26889":48965,"_2862":48966},[],"/docs/pr-preview/pr-52/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_3376":278,"_29554":274,"_5":29903,"_20528":48968,"_26889":48969,"_2862":48970},[],"/docs/pr-preview/pr-52/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_3376":279,"_29554":274,"_5":29903,"_20528":48972,"_26889":48973,"_2862":48974},[],"/docs/pr-preview/pr-52/deployment/self-hosted/networking#k3s","K3s",{"_3376":280,"_29554":274,"_5":29903,"_20528":48976,"_26889":48977,"_2862":48978},[],"/docs/pr-preview/pr-52/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_3376":281,"_29554":274,"_5":29903,"_20528":48980,"_26889":48981,"_2862":48982},[],"/docs/pr-preview/pr-52/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_3376":282,"_29554":274,"_5":29903,"_20528":48984,"_26889":48985,"_2862":48986},[],"/docs/pr-preview/pr-52/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_3376":283,"_29554":274,"_5":29903,"_20528":48988,"_26889":48989,"_2862":48990},[],"/docs/pr-preview/pr-52/deployment/self-hosted/networking#decision-guide","Decision guide",{"_3376":284,"_29554":274,"_5":29903,"_20528":48992,"_26889":48993,"_2862":48994},[],"/docs/pr-preview/pr-52/deployment/self-hosted/networking#egress-proxy","Egress proxy",{"_3376":285,"_29554":274,"_5":29903,"_20528":48996,"_26889":48997,"_2862":48998},[],"/docs/pr-preview/pr-52/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_3376":286,"_29554":274,"_20528":49000,"_5":14087,"_26889":48961,"_2862":49001},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_3376":287,"_29554":274,"_20528":49003,"_5":14087,"_26889":48961,"_2862":49004},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_3376":288,"_29554":274,"_20528":49006,"_5":14087,"_26889":48965,"_2862":49007},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_3376":289,"_29554":274,"_20528":49009,"_5":14087,"_26889":48965,"_2862":49010},[],"Set it only when:",{"_3376":290,"_29554":274,"_20528":49012,"_5":14087,"_26889":48965,"_2862":49013},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_3376":291,"_29554":274,"_20528":49015,"_5":14087,"_26889":48965,"_2862":49016},[],"that address is allocated to this Gateway",{"_3376":292,"_29554":274,"_20528":49018,"_5":14087,"_26889":48965,"_2862":49019},[],"the surrounding network already routes traffic for it to the cluster",{"_3376":293,"_29554":274,"_20528":49021,"_5":14087,"_26889":48965,"_2862":49022},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_3376":294,"_29554":274,"_20528":49024,"_5":14087,"_26889":48965,"_2862":49025},[],"Keep these two settings separate:",{"_3376":295,"_29554":274,"_20528":49027,"_5":14087,"_26889":48965,"_2862":49028},[],"`gateway.addresses` requests an address for the Gateway.",{"_3376":296,"_29554":274,"_20528":49030,"_5":14087,"_26889":48965,"_2862":49031},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_3376":297,"_29554":274,"_20528":49033,"_5":14087,"_26889":48965,"_2862":49034},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_3376":298,"_29554":274,"_20528":49036,"_5":14087,"_26889":48969,"_2862":49037},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_3376":299,"_29554":274,"_20528":49039,"_5":14087,"_26889":48969,"_2862":49040},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_3376":300,"_29554":274,"_20528":49042,"_5":14087,"_26889":48973,"_2862":49043},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_3376":301,"_29554":274,"_20528":49045,"_5":14087,"_26889":48973,"_2862":49046},[],"For the recommended design:",{"_3376":302,"_29554":274,"_20528":49048,"_5":14087,"_26889":48973,"_2862":49049},[],"Use only one externally exposed Lamassu Gateway.",{"_3376":303,"_29554":274,"_20528":49051,"_5":14087,"_26889":48973,"_2862":49052},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_3376":304,"_29554":274,"_20528":49054,"_5":14087,"_26889":48973,"_2862":49055},[],"Allow those ports through the VM firewall and any upstream security group.",{"_3376":305,"_29554":274,"_20528":49057,"_5":14087,"_26889":48973,"_2862":49058},[],"Point DNS at the VM's reachable address.",{"_3376":306,"_29554":274,"_20528":49060,"_5":14087,"_26889":48973,"_2862":49061},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_3376":307,"_29554":274,"_20528":49063,"_5":14087,"_26889":48977,"_2862":49064},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_3376":308,"_29554":274,"_20528":49066,"_5":14087,"_26889":48981,"_2862":49067},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_3376":309,"_29554":274,"_20528":49069,"_5":14087,"_26889":48981,"_2862":49070},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_3376":310,"_29554":274,"_20528":49072,"_5":14087,"_26889":48985,"_2862":49073},[],"First decide whether you need three independent data planes or only three hostnames.",{"_3376":311,"_29554":274,"_20528":49075,"_5":14087,"_26889":48985,"_2862":49076},[],"Requirement",{"_3376":312,"_29554":274,"_20528":49078,"_5":14087,"_26889":48985,"_2862":49079},[],"Recommended design",{"_3376":313,"_29554":274,"_20528":49081,"_5":14087,"_26889":48985,"_2862":49082},[],"Consequence",{"_3376":314,"_29554":274,"_20528":49084,"_5":14087,"_26889":48985,"_2862":49085},[],"Several Lamassu URLs or services",{"_3376":315,"_29554":274,"_20528":49087,"_5":14087,"_26889":48985,"_2862":49088},[],"One Gateway with multiple routes",{"_3376":316,"_29554":274,"_20528":49090,"_5":14087,"_26889":48985,"_2862":49091},[],"One IP and one proxy fleet; this is the chart default",{"_3376":317,"_29554":274,"_20528":49093,"_5":14087,"_26889":48985,"_2862":49094},[],"Independent Gateways and separate external IPs",{"_3376":318,"_29554":274,"_20528":49096,"_5":14087,"_26889":48985,"_2862":49097},[],"One VIP per Gateway",{"_3376":319,"_29554":274,"_20528":49099,"_5":14087,"_26889":48985,"_2862":49100},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_3376":320,"_29554":274,"_20528":49102,"_5":14087,"_26889":48985,"_2862":49103},[],"Independent Gateways on one node and one IP",{"_3376":321,"_29554":274,"_20528":49105,"_5":14087,"_26889":48985,"_2862":49106},[],"Use different external ports",{"_3376":322,"_29554":274,"_20528":49108,"_5":14087,"_26889":48985,"_2862":49109},[],"Clients must include non-standard ports",{"_3376":323,"_29554":274,"_20528":49111,"_5":14087,"_26889":48985,"_2862":49112},[],"Separate TLS/mTLS termination behind one IP",{"_3376":324,"_29554":274,"_20528":49114,"_5":14087,"_26889":48985,"_2862":49115},[],"Front-door SNI routing to internal Gateways",{"_3376":325,"_29554":274,"_20528":49117,"_5":14087,"_26889":48985,"_2862":49118},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_3376":326,"_29554":274,"_20528":49120,"_5":14087,"_26889":48985,"_2862":49121},[],"Separate Gateway resources but shared proxy infrastructure",{"_3376":327,"_29554":274,"_20528":49123,"_5":14087,"_26889":48985,"_2862":49124},[],"Envoy merged-Gateway mode",{"_3376":328,"_29554":274,"_20528":49126,"_5":14087,"_26889":48985,"_2862":49127},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_3376":329,"_29554":274,"_20528":49129,"_5":14087,"_26889":48985,"_2862":49130},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_3376":330,"_29554":274,"_20528":49132,"_5":14087,"_26889":48985,"_2862":49133},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_3376":331,"_29554":274,"_20528":49135,"_5":14087,"_26889":48985,"_2862":49136},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_3376":332,"_29554":274,"_20528":49138,"_5":14087,"_26889":48985,"_2862":49139},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_3376":333,"_29554":274,"_20528":49141,"_5":14087,"_26889":48989,"_2862":49142},[],"If one Gateway can own TLS and routing, use the chart default.",{"_3376":334,"_29554":274,"_20528":49144,"_5":14087,"_26889":48989,"_2862":49145},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_3376":335,"_29554":274,"_20528":49147,"_5":14087,"_26889":48989,"_2862":49148},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_3376":336,"_29554":274,"_20528":49150,"_5":14087,"_26889":48989,"_2862":49151},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_3376":337,"_29554":274,"_20528":49153,"_5":14087,"_26889":48989,"_2862":49154},[],"If none of those are possible, use different external ports or change the external network design.",{"_3376":338,"_29554":274,"_20528":49156,"_5":14087,"_26889":48993,"_2862":49157},[],"Internal Lamassu clients — the Vault engine connection, service-to-service calls and webhook deliveries — honor the `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables. The exception is the authorization-engine connector: it uses its own transport and does not consult these proxy variables. If your deployment routes egress through a proxy, list in-cluster service names in `NO_PROXY` (for example `.svc,.cluster.local`) so internal traffic stays inside the cluster. Loopback traffic is never sent through a proxy.",{"_3376":339,"_29554":274,"_20528":49159,"_5":14087,"_26889":48993,"_2862":49160},[],"The default transport of these clients bounds the dial timeout (30 seconds), the TLS handshake (10 seconds) and idle connection reuse (90 seconds) so an unreachable dependency fails fast instead of hanging; these values are Go transport defaults, not Lamassu settings. HTTP/2 is negotiated when the peer supports it. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call.",{"_3376":340,"_29554":274,"_20528":49162,"_5":14087,"_26889":48997,"_2862":49163},[],"Check, in order:",{"_3376":341,"_29554":274,"_20528":49165,"_5":14087,"_26889":48997,"_2862":49166},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_3376":342,"_29554":274,"_20528":49168,"_5":14087,"_26889":48997,"_2862":49169},[],"Its status contains the expected address.",{"_3376":343,"_29554":274,"_20528":49171,"_5":14087,"_26889":48997,"_2862":49172},[],"The generated `LoadBalancer` Service has a usable external address.",{"_3376":344,"_29554":274,"_20528":49174,"_5":14087,"_26889":48997,"_2862":49175},[],"Port 443 reaches that address from the client network.",{"_3376":345,"_29554":274,"_20528":49177,"_5":14087,"_26889":48997,"_2862":49178},[],"DNS resolves to the externally reachable endpoint.",{"_3376":346,"_29554":274,"_20528":49180,"_5":14087,"_26889":48997,"_2862":49181},[],"The certificate contains the DNS name or IP used by the client.",{"_3376":347,"_29554":274,"_20528":49183,"_5":14087,"_26889":48997,"_2862":49184},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_3376":348,"_29554":348,"_5":14445,"_2862":48255,"_29906":49186,"_20528":49187,"_26889":348},[48148,48149,48255],[],{"_3376":349,"_29554":348,"_20528":49189,"_5":14087,"_26889":348,"_2862":49190},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_3376":350,"_29554":348,"_5":29903,"_20528":49192,"_26889":49193,"_2862":49194},[],"/docs/pr-preview/pr-52/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_3376":351,"_29554":348,"_5":29903,"_20528":49196,"_26889":49197,"_2862":49198},[],"/docs/pr-preview/pr-52/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_3376":352,"_29554":348,"_5":29903,"_20528":49200,"_26889":49201,"_2862":49202},[],"/docs/pr-preview/pr-52/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_3376":353,"_29554":348,"_5":29903,"_20528":49204,"_26889":49205,"_2862":49206},[],"/docs/pr-preview/pr-52/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_3376":354,"_29554":348,"_5":29903,"_20528":49208,"_26889":49209,"_2862":49210},[],"/docs/pr-preview/pr-52/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_3376":355,"_29554":348,"_5":29903,"_20528":49212,"_26889":49213,"_2862":49214},[],"/docs/pr-preview/pr-52/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_3376":356,"_29554":348,"_20528":49216,"_5":14087,"_26889":49193,"_2862":49217},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_3376":357,"_29554":348,"_20528":49219,"_5":14087,"_26889":49197,"_2862":49220},[],"Workflow",{"_3376":358,"_29554":348,"_20528":49222,"_5":14087,"_26889":49197,"_2862":49223},[],"Use it for",{"_3376":359,"_29554":348,"_20528":49225,"_5":14087,"_26889":49197,"_2862":49226},[],"What it installs",{"_3376":360,"_29554":348,"_20528":49228,"_5":14087,"_26889":49197,"_2862":49229},[],"Helm",{"_3376":361,"_29554":348,"_20528":49231,"_5":14087,"_26889":49197,"_2862":49232},[],"Production and controlled environments",{"_3376":362,"_29554":348,"_20528":49234,"_5":14087,"_26889":49197,"_2862":49235},[],"Lamassu services and Gateway API resources",{"_3376":363,"_29554":348,"_20528":49237,"_5":14087,"_26889":49197,"_2862":48392},[],{"_3376":364,"_29554":348,"_20528":49239,"_5":14087,"_26889":49197,"_2862":49240},[],"Evaluation, demos, CI and small lab clusters",{"_3376":365,"_29554":348,"_20528":49242,"_5":14087,"_26889":49197,"_2862":49243},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_3376":366,"_29554":348,"_20528":49245,"_5":14087,"_26889":49201,"_2862":49246},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_3376":367,"_29554":348,"_20528":49248,"_5":14087,"_26889":49201,"_2862":49249},[],"Area",{"_3376":368,"_29554":348,"_20528":49251,"_5":14087,"_26889":49201,"_2862":49252},[],"The Lamassu chart provides",{"_3376":369,"_29554":348,"_20528":49254,"_5":14087,"_26889":49201,"_2862":49255},[],"You provide",{"_3376":370,"_29554":348,"_20528":49257,"_5":14087,"_26889":49201,"_2862":49258},[],"Lamassu applications",{"_3376":371,"_29554":348,"_20528":49260,"_5":14087,"_26889":49201,"_2862":49261},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_3376":372,"_29554":348,"_20528":49263,"_5":14087,"_26889":49201,"_2862":49264},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_3376":373,"_29554":348,"_20528":49266,"_5":14087,"_26889":49201,"_2862":49267},[],"PostgreSQL data",{"_3376":374,"_29554":348,"_20528":49269,"_5":14087,"_26889":49201,"_2862":49270},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_3376":375,"_29554":348,"_20528":49272,"_5":14087,"_26889":49201,"_2862":49273},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_3376":376,"_29554":348,"_20528":49275,"_5":14087,"_26889":49201,"_2862":49276},[],"Messaging",{"_3376":377,"_29554":348,"_20528":49278,"_5":14087,"_26889":49201,"_2862":49279},[],"RabbitMQ connection configuration for the Lamassu services; the connection can use AMQPS, with an optional private CA and an optional client certificate, both set through chart values",{"_3376":378,"_29554":348,"_20528":49281,"_5":14087,"_26889":49201,"_2862":49282},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_3376":379,"_29554":348,"_20528":49284,"_5":14087,"_26889":49201,"_2862":49285},[],"Identity",{"_3376":380,"_29554":348,"_20528":49287,"_5":14087,"_26889":49201,"_2862":49288},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_3376":381,"_29554":348,"_20528":49290,"_5":14087,"_26889":49201,"_2862":49291},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_3376":382,"_29554":348,"_20528":49293,"_5":14087,"_26889":49201,"_2862":49294},[],"External routing",{"_3376":383,"_29554":348,"_20528":49296,"_5":14087,"_26889":49201,"_2862":49297},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_3376":384,"_29554":348,"_20528":49299,"_5":14087,"_26889":49201,"_2862":49300},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_3376":385,"_29554":348,"_20528":49302,"_5":14087,"_26889":49201,"_2862":49303},[],"TLS",{"_3376":386,"_29554":348,"_20528":49305,"_5":14087,"_26889":49201,"_2862":49306},[],"In the default `tls.type: certManager` mode, cert-manager `Issuer` and CA `Certificate` resources and a chart-managed downstream `Certificate`; in the `tls.type: external` mode, a reference to your TLS Secret",{"_3376":387,"_29554":348,"_20528":49308,"_5":14087,"_26889":49201,"_2862":49309},[],"cert-manager only for the default `tls.type: certManager` mode; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_3376":388,"_29554":348,"_20528":49311,"_5":14087,"_26889":49201,"_2862":49312},[],"Persistent application data",{"_3376":389,"_29554":348,"_20528":49314,"_5":14087,"_26889":49201,"_2862":49315},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_3376":390,"_29554":348,"_20528":49317,"_5":14087,"_26889":49201,"_2862":49318},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_3376":391,"_29554":348,"_20528":49320,"_5":14087,"_26889":49201,"_2862":49321},[],"Optional integrations",{"_3376":392,"_29554":348,"_20528":49323,"_5":14087,"_26889":49201,"_2862":49324},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_3376":393,"_29554":348,"_20528":49326,"_5":14087,"_26889":49201,"_2862":49327},[],"The observability backends, cloud credentials and production HSM or external key service",{"_3376":394,"_29554":348,"_20528":49329,"_5":14087,"_26889":49201,"_2862":49330},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_3376":395,"_29554":348,"_20528":49332,"_5":14087,"_26889":49201,"_2862":49333},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_3376":396,"_29554":348,"_20528":49335,"_5":14087,"_26889":49205,"_2862":49336},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_3376":397,"_29554":348,"_20528":49338,"_5":14087,"_26889":49205,"_2862":49339},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_3376":398,"_29554":348,"_20528":49341,"_5":14087,"_26889":49209,"_2862":49342},[],"Kubernetes 1.24 or newer",{"_3376":399,"_29554":348,"_20528":49344,"_5":14087,"_26889":49209,"_2862":49345},[],"Helm 3.2 or newer",{"_3376":400,"_29554":348,"_20528":49347,"_5":14087,"_26889":49209,"_2862":49348},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_3376":401,"_29554":348,"_20528":49350,"_5":14087,"_26889":49209,"_2862":49351},[],"cert-manager 1.14 or newer; required only for the default `tls.type: certManager` TLS mode, not for `tls.type: external`",{"_3376":402,"_29554":348,"_20528":49353,"_5":14087,"_26889":49209,"_2862":49354},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_3376":403,"_29554":348,"_20528":49356,"_5":14087,"_26889":49209,"_2862":49357},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_3376":404,"_29554":348,"_20528":49359,"_5":14087,"_26889":49209,"_2862":49360},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_3376":405,"_29554":348,"_20528":49362,"_5":14087,"_26889":49213,"_2862":49363},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3376":406,"_29554":348,"_20528":49365,"_5":14087,"_26889":49213,"_2862":49366},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3376":407,"_29554":348,"_20528":49368,"_5":14087,"_26889":49213,"_2862":49369},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3376":408,"_29554":348,"_20528":49371,"_5":14087,"_26889":49213,"_2862":49372},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3376":409,"_29554":409,"_5":14445,"_2862":49374,"_29906":49375,"_20528":49377,"_26889":409},"Deployment troubleshooting",[48148,48149,49376],"Operations",[],{"_3376":410,"_29554":409,"_20528":49379,"_5":14087,"_26889":409,"_2862":49380},[],"Diagnose access, service health and infrastructure dependencies.",{"_3376":411,"_29554":409,"_5":29903,"_20528":49382,"_26889":49383,"_2862":49384},[],"/docs/pr-preview/pr-52/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_3376":412,"_29554":409,"_5":29903,"_20528":49386,"_26889":49387,"_2862":49388},[],"/docs/pr-preview/pr-52/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_3376":413,"_29554":409,"_5":29903,"_20528":49390,"_26889":49391,"_2862":49392},[],"/docs/pr-preview/pr-52/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_3376":414,"_29554":409,"_5":29903,"_20528":49394,"_26889":49395,"_2862":49396},[],"/docs/pr-preview/pr-52/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_3376":415,"_29554":409,"_5":29903,"_20528":49398,"_26889":49399,"_2862":49400},[],"/docs/pr-preview/pr-52/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_3376":416,"_29554":409,"_5":29903,"_20528":49402,"_26889":49403,"_2862":49404},[],"/docs/pr-preview/pr-52/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_3376":417,"_29554":409,"_5":29903,"_20528":49406,"_26889":49407,"_2862":49408},[],"/docs/pr-preview/pr-52/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_3376":418,"_29554":409,"_5":29903,"_20528":49410,"_26889":49411,"_2862":49412},[],"/docs/pr-preview/pr-52/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_3376":419,"_29554":409,"_5":29903,"_20528":49414,"_26889":49415,"_2862":49416},[],"/docs/pr-preview/pr-52/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_3376":420,"_29554":409,"_5":29903,"_20528":49418,"_26889":49419,"_2862":49420},[],"/docs/pr-preview/pr-52/deployment/troubleshooting#api-500-errors","API 500 errors",{"_3376":421,"_29554":409,"_5":29903,"_20528":49422,"_26889":49423,"_2862":49424},[],"/docs/pr-preview/pr-52/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_3376":422,"_29554":409,"_5":29903,"_20528":49426,"_26889":49427,"_2862":49428},[],"/docs/pr-preview/pr-52/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_3376":423,"_29554":409,"_5":29903,"_20528":49430,"_26889":49431,"_2862":49432},[],"/docs/pr-preview/pr-52/deployment/troubleshooting#observability","Observability",{"_3376":424,"_29554":409,"_20528":49434,"_5":14087,"_26889":409,"_2862":49435},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_3376":425,"_29554":409,"_20528":49437,"_5":14087,"_26889":49387,"_2862":49438},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_3376":426,"_29554":409,"_20528":49440,"_5":14087,"_26889":49391,"_2862":49441},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_3376":427,"_29554":409,"_20528":49443,"_5":14087,"_26889":49395,"_2862":49444},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_3376":428,"_29554":409,"_20528":49446,"_5":14087,"_26889":49399,"_2862":49447},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_3376":429,"_29554":409,"_20528":49449,"_5":14087,"_26889":49403,"_2862":49450},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_3376":430,"_29554":409,"_20528":49452,"_5":14087,"_26889":49407,"_2862":49453},[],"Replace the placeholders with your real release, namespace and deployment.",{"_3376":431,"_29554":409,"_20528":49455,"_5":14087,"_26889":49407,"_2862":49456},[],"Also run the chart's connectivity test:",{"_3376":432,"_29554":409,"_20528":49458,"_5":14087,"_26889":49407,"_2862":49459},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_3376":433,"_29554":409,"_20528":49461,"_5":14087,"_26889":49407,"_2862":49462},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_3376":434,"_29554":409,"_20528":49464,"_5":14087,"_26889":49411,"_2862":49465},[],"If you receive a 401:",{"_3376":435,"_29554":409,"_20528":49467,"_5":14087,"_26889":49411,"_2862":49468},[],"check that the UI's OIDC authority is reachable from the browser;",{"_3376":436,"_29554":409,"_20528":49470,"_5":14087,"_26889":49411,"_2862":49471},[],"verify issuer, audience and expiration of the token;",{"_3376":437,"_29554":409,"_20528":49473,"_5":14087,"_26889":49411,"_2862":49474},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_3376":438,"_29554":409,"_20528":49476,"_5":14087,"_26889":49411,"_2862":49477},[],"check that the provider's public and internal routes point to the same realm.",{"_3376":439,"_29554":409,"_20528":49479,"_5":14087,"_26889":49411,"_2862":49480},[],"If login succeeds but the APIs return 403:",{"_3376":440,"_29554":409,"_20528":49482,"_5":14087,"_26889":49411,"_2862":49483},[],"inspect the token's real claims;",{"_3376":441,"_29554":409,"_20528":49485,"_5":14087,"_26889":49411,"_2862":49486},[],"confirm they match an active principal;",{"_3376":442,"_29554":409,"_20528":49488,"_5":14087,"_26889":49411,"_2862":49489},[],"review the policies granted to that principal;",{"_3376":443,"_29554":409,"_20528":49491,"_5":14087,"_26889":49411,"_2862":49492},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_3376":444,"_29554":409,"_20528":49494,"_5":14087,"_26889":49411,"_2862":49495},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_3376":445,"_29554":409,"_20528":49497,"_5":14087,"_26889":49415,"_2862":49498},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_3376":446,"_29554":409,"_20528":49500,"_5":14087,"_26889":49415,"_2862":49501},[],"Locate the authz pod and Service.",{"_3376":447,"_29554":409,"_20528":49503,"_5":14087,"_26889":49415,"_2862":49504},[],"Check /health, logs and its database connection.",{"_3376":448,"_29554":409,"_20528":49506,"_5":14087,"_26889":49415,"_2862":49507},[],"Verify the DNS and port configured in externalAuthorization.",{"_3376":449,"_29554":409,"_20528":49509,"_5":14087,"_26889":49415,"_2862":49510},[],"Check the check route is /v1/ext\\_authz/check.",{"_3376":450,"_29554":409,"_20528":49512,"_5":14087,"_26889":49415,"_2862":49513},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_3376":451,"_29554":409,"_20528":49515,"_5":14087,"_26889":49419,"_2862":49516},[],"A 500 indicates an internal failure, such as an unavailable database. The `{\"err\": ...}` body currently includes the text of the internal error, which can contain schema, table and constraint names and, on connection failures, the database host and user (not the password). Find the cause in the service log using the request time, and do not forward the body to third parties or show it to end users. This is a known information-disclosure defect: generic messages are planned for 500 responses, keeping the detail only in the service log (tracked in lamassuiot#814). The authorization connector also returns the internal error, in the `details.error` field. Some request errors, such as a key size the engine does not support, are also returned as 500.",{"_3376":452,"_29554":409,"_20528":49518,"_5":14087,"_26889":49423,"_2862":49519},[],"Review kubectl describe pod first. Common causes are:",{"_3376":453,"_29554":409,"_20528":49521,"_5":14087,"_26889":49423,"_2862":49522},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_3376":454,"_29554":409,"_20528":49524,"_5":14087,"_26889":49423,"_2862":49525},[],"a missing AMQP CA or client certificate Secret referenced by `amqp.ca.secretName` or `amqp.client.secretName`;",{"_3376":455,"_29554":409,"_20528":49527,"_5":14087,"_26889":49423,"_2862":49528},[],"unbound persistent volume;",{"_3376":456,"_29554":409,"_20528":49530,"_5":14087,"_26889":49423,"_2862":49531},[],"inaccessible image or incorrect pull policy;",{"_3376":457,"_29554":409,"_20528":49533,"_5":14087,"_26889":49423,"_2862":49534},[],"invalid cryptographic engine configuration;",{"_3376":458,"_29554":409,"_20528":49536,"_5":14087,"_26889":49423,"_2862":49537},[],"CPU or memory limits set too low;",{"_3376":459,"_29554":409,"_20528":49539,"_5":14087,"_26889":49423,"_2862":49540},[],"an incomplete prior migration.",{"_3376":460,"_29554":409,"_20528":49542,"_5":14087,"_26889":49423,"_2862":49543},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_3376":461,"_29554":409,"_20528":49545,"_5":14087,"_26889":49423,"_2862":49546},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_3376":462,"_29554":409,"_20528":49548,"_5":14087,"_26889":49423,"_2862":49549},[],"Internal calls now fail fast instead of hanging for the clients covered by Egress proxy: connection attempts time out after 30 seconds and TLS handshakes after 10 seconds. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call. If an egress proxy handles the cluster's outbound traffic, check the pod's `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables and list in-cluster service names in `NO_PROXY`.",{"_3376":463,"_29554":409,"_20528":49551,"_5":14087,"_26889":49427,"_2862":49552},[],"Domain and audit events depend on the bus publisher:",{"_3376":464,"_29554":409,"_20528":49554,"_5":14087,"_26889":49427,"_2862":49555},[],"verify it is enabled in the emitting service;",{"_3376":465,"_29554":409,"_20528":49557,"_5":14087,"_26889":49427,"_2862":49558},[],"check AMQP connectivity and credentials;",{"_3376":466,"_29554":409,"_20528":49560,"_5":14087,"_26889":49427,"_2862":49561},[],"review exchange, routing key, queues and consumers;",{"_3376":467,"_29554":409,"_20528":49563,"_5":14087,"_26889":49427,"_2862":49564},[],"inspect dead-letter queues;",{"_3376":468,"_29554":409,"_20528":49566,"_5":14087,"_26889":49427,"_2862":49567},[],"alert on orphan durable queues and backlog growth.",{"_3376":469,"_29554":409,"_20528":49569,"_5":14087,"_26889":49427,"_2862":49570},[],"If `amqp.tls` is enabled, verify the TLS side as well:",{"_3376":470,"_29554":409,"_20528":49572,"_5":14087,"_26889":49427,"_2862":49573},[],"confirm the broker listener speaks AMQPS on the configured port — the default port stays `5672` and does not follow TLS automatically;",{"_3376":471,"_29554":409,"_20528":49575,"_5":14087,"_26889":49427,"_2862":49576},[],"if you set `amqp.ca.secretName`, confirm the Secret exists in the release namespace and its data key matches `amqp.ca.certificateKey` (default `ca.crt`); if `amqp.ca.secretName` is not set, the clients trust the system CAs;",{"_3376":472,"_29554":409,"_20528":49578,"_5":14087,"_26889":49427,"_2862":49579},[],"remember that a missing referenced Secret prevents the consuming pods from starting;",{"_3376":473,"_29554":409,"_20528":49581,"_5":14087,"_26889":49427,"_2862":49582},[],"after updating the CA or client certificate Secret, restart the consuming pods: the AMQP client loads certificates at startup.",{"_3376":474,"_29554":409,"_20528":49584,"_5":14087,"_26889":49427,"_2862":49585},[],"See AMQP TLS (AMQPS) for the full configuration.",{"_3376":475,"_29554":409,"_20528":49587,"_5":14087,"_26889":49427,"_2862":49588},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_3376":476,"_29554":409,"_20528":49590,"_5":14087,"_26889":49431,"_2862":49591},[],"The chart can enable OpenTelemetry instrumentation for the services that support it, including authz; it does not configure OpenTelemetry for AWS Connector, wfx or the UI. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, service and dependency.",{"_3376":477,"_29554":409,"_20528":49593,"_5":14087,"_26889":49431,"_2862":49594},[],"Before closing an incident, record:",{"_3376":478,"_29554":409,"_20528":49596,"_5":14087,"_26889":49431,"_2862":49597},[],"the confirmed cause;",{"_3376":479,"_29554":409,"_20528":49599,"_5":14087,"_26889":49431,"_2862":49600},[],"the time scope and affected resources;",{"_3376":480,"_29554":409,"_20528":49602,"_5":14087,"_26889":49431,"_2862":49603},[],"the commands or queries used;",{"_3376":481,"_29554":409,"_20528":49605,"_5":14087,"_26889":49431,"_2862":49606},[],"the applied change and how to revert it;",{"_3376":482,"_29554":409,"_20528":49608,"_5":14087,"_26889":49431,"_2862":49609},[],"validation from a consumer;",{"_3376":483,"_29554":409,"_20528":49611,"_5":14087,"_26889":49431,"_2862":49612},[],"the preventive action and its owner.",{"_3376":484,"_29554":484,"_5":14445,"_2862":49614,"_29906":49615,"_20528":49618,"_26889":484},"Access control",[48148,49616,49617],"Platform","Administration",[],{"_3376":485,"_29554":484,"_20528":49620,"_5":14087,"_26889":484,"_2862":49621},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_3376":486,"_29554":484,"_5":29903,"_20528":49623,"_26889":49624,"_2862":49625},[],"/docs/pr-preview/pr-52/platform/administration/access-control#essential-concepts","Essential concepts",{"_3376":487,"_29554":484,"_5":29903,"_20528":49627,"_26889":49628,"_2862":49629},[],"/docs/pr-preview/pr-52/platform/administration/access-control#two-decision-systems","Two decision systems",{"_3376":488,"_29554":484,"_5":29903,"_20528":49631,"_26889":49632,"_2862":49633},[],"/docs/pr-preview/pr-52/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_3376":489,"_29554":484,"_5":29903,"_20528":49635,"_26889":49636,"_2862":49637},[],"/docs/pr-preview/pr-52/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_3376":490,"_29554":484,"_5":29903,"_20528":49639,"_26889":49640,"_2862":49641},[],"/docs/pr-preview/pr-52/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_3376":491,"_29554":484,"_5":29903,"_20528":49643,"_26889":49644,"_2862":49645},[],"/docs/pr-preview/pr-52/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_3376":492,"_29554":484,"_5":29903,"_20528":49647,"_26889":49648,"_2862":49649},[],"/docs/pr-preview/pr-52/platform/administration/access-control#oidc-principals","OIDC principals",{"_3376":493,"_29554":484,"_5":29903,"_20528":49651,"_26889":49652,"_2862":49653},[],"/docs/pr-preview/pr-52/platform/administration/access-control#x509-principals","X.509 principals",{"_3376":494,"_29554":484,"_5":29903,"_20528":49655,"_26889":49656,"_2862":49657},[],"/docs/pr-preview/pr-52/platform/administration/access-control#when-several-principals-match","When several principals match",{"_3376":495,"_29554":484,"_5":29903,"_20528":49659,"_26889":49660,"_2862":49661},[],"/docs/pr-preview/pr-52/platform/administration/access-control#how-policies-express-access","How policies express access",{"_3376":496,"_29554":484,"_5":29903,"_20528":49663,"_26889":49664,"_2862":49665},[],"/docs/pr-preview/pr-52/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_3376":497,"_29554":484,"_5":29903,"_20528":49667,"_26889":49668,"_2862":49669},[],"/docs/pr-preview/pr-52/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_3376":498,"_29554":484,"_5":29903,"_20528":49671,"_26889":49672,"_2862":49673},[],"/docs/pr-preview/pr-52/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_3376":499,"_29554":484,"_5":29903,"_20528":49675,"_26889":49676,"_2862":49677},[],"/docs/pr-preview/pr-52/platform/administration/access-control#http-rules","HTTP rules",{"_3376":500,"_29554":484,"_5":29903,"_20528":49679,"_26889":49680,"_2862":49681},[],"/docs/pr-preview/pr-52/platform/administration/access-control#included-policies","Included policies",{"_3376":501,"_29554":484,"_5":29903,"_20528":49683,"_26889":49684,"_2862":48788},[],"/docs/pr-preview/pr-52/platform/administration/access-control#provision-the-first-administrator",{"_3376":502,"_29554":484,"_5":29903,"_20528":49686,"_26889":49687,"_2862":49688},[],"/docs/pr-preview/pr-52/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_3376":503,"_29554":484,"_5":29903,"_20528":49690,"_26889":49691,"_2862":49692},[],"/docs/pr-preview/pr-52/platform/administration/access-control#configure-token-validation","Configure token validation",{"_3376":504,"_29554":484,"_5":29903,"_20528":49694,"_26889":49695,"_2862":49696},[],"/docs/pr-preview/pr-52/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_3376":505,"_29554":484,"_5":29903,"_20528":49698,"_26889":49699,"_2862":49700},[],"/docs/pr-preview/pr-52/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_3376":506,"_29554":484,"_5":29903,"_20528":49702,"_26889":49703,"_2862":49704},[],"/docs/pr-preview/pr-52/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_3376":507,"_29554":484,"_5":29903,"_20528":49706,"_26889":49707,"_2862":49708},[],"/docs/pr-preview/pr-52/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_3376":508,"_29554":484,"_5":29903,"_20528":49710,"_26889":49711,"_2862":49712},[],"/docs/pr-preview/pr-52/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_3376":509,"_29554":484,"_5":29903,"_20528":49714,"_26889":49715,"_2862":49716},[],"/docs/pr-preview/pr-52/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_3376":510,"_29554":484,"_5":29903,"_20528":49718,"_26889":49719,"_2862":49720},[],"/docs/pr-preview/pr-52/platform/administration/access-control#operational-checklist","Operational checklist",{"_3376":511,"_29554":484,"_5":29903,"_20528":49722,"_26889":49723,"_2862":49724},[],"/docs/pr-preview/pr-52/platform/administration/access-control#diagnostics","Diagnostics",{"_3376":512,"_29554":484,"_5":29903,"_20528":49726,"_26889":49727,"_2862":49728},[],"/docs/pr-preview/pr-52/platform/administration/access-control#the-response-is-401","The response is 401",{"_3376":513,"_29554":484,"_5":29903,"_20528":49730,"_26889":49731,"_2862":49732},[],"/docs/pr-preview/pr-52/platform/administration/access-control#the-response-is-403","The response is 403",{"_3376":514,"_29554":484,"_5":29903,"_20528":49734,"_26889":49735,"_2862":49736},[],"/docs/pr-preview/pr-52/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_3376":515,"_29554":484,"_5":29903,"_20528":49738,"_26889":49739,"_2862":49740},[],"/docs/pr-preview/pr-52/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_3376":516,"_29554":484,"_5":29903,"_20528":49742,"_26889":49743,"_2862":49744},[],"/docs/pr-preview/pr-52/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_3376":517,"_29554":484,"_20528":49746,"_5":14087,"_26889":484,"_2862":49747},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_3376":518,"_29554":484,"_20528":49749,"_5":14087,"_26889":484,"_2862":49750},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_3376":519,"_29554":484,"_20528":49752,"_5":14087,"_26889":484,"_2862":49753},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_3376":520,"_29554":484,"_20528":49755,"_5":14087,"_26889":49624,"_2862":49756},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_3376":521,"_29554":484,"_20528":49758,"_5":14087,"_26889":49624,"_2862":49759},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_3376":522,"_29554":484,"_20528":49761,"_5":14087,"_26889":49624,"_2862":49762},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_3376":523,"_29554":484,"_20528":49764,"_5":14087,"_26889":49624,"_2862":49765},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_3376":524,"_29554":484,"_20528":49767,"_5":14087,"_26889":49624,"_2862":49768},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_3376":525,"_29554":484,"_20528":49770,"_5":14087,"_26889":49624,"_2862":49771},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_3376":526,"_29554":484,"_20528":49773,"_5":14087,"_26889":49628,"_2862":49774},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_3376":527,"_29554":484,"_20528":49776,"_5":14087,"_26889":49628,"_2862":49777},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_3376":528,"_29554":484,"_20528":49779,"_5":14087,"_26889":49632,"_2862":49780},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_3376":529,"_29554":484,"_20528":49782,"_5":14087,"_26889":49632,"_2862":49783},[],"The decision is made **before forwarding the request to the service**:",{"_3376":530,"_29554":484,"_20528":49785,"_5":14087,"_26889":49632,"_2862":49786},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_3376":531,"_29554":484,"_20528":49788,"_5":14087,"_26889":49632,"_2862":49789},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_3376":532,"_29554":484,"_20528":49791,"_5":14087,"_26889":49632,"_2862":49792},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_3376":533,"_29554":484,"_20528":49794,"_5":14087,"_26889":49632,"_2862":49795},[],"It separately loads the policies granted to each principal.",{"_3376":534,"_29554":484,"_20528":49797,"_5":14087,"_26889":49632,"_2862":49798},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_3376":535,"_29554":484,"_20528":49800,"_5":14087,"_26889":49632,"_2862":49801},[],"`authz` looks for an HTTP rule granting that action.",{"_3376":536,"_29554":484,"_20528":49803,"_5":14087,"_26889":49632,"_2862":49804},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_3376":537,"_29554":484,"_20528":49806,"_5":14087,"_26889":49632,"_2862":49807},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_3376":538,"_29554":484,"_20528":49809,"_5":14087,"_26889":49632,"_2862":49810},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context.",{"_3376":539,"_29554":484,"_20528":49812,"_5":14087,"_26889":49632,"_2862":49813},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_3376":540,"_29554":484,"_20528":49815,"_5":14087,"_26889":49636,"_2862":49816},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_3376":541,"_29554":484,"_20528":49818,"_5":14087,"_26889":49636,"_2862":49819},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_3376":542,"_29554":484,"_20528":49821,"_5":14087,"_26889":49636,"_2862":49822},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_3376":543,"_29554":484,"_20528":49824,"_5":14087,"_26889":49636,"_2862":49825},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_3376":544,"_29554":484,"_20528":49827,"_5":14087,"_26889":49636,"_2862":49828},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_3376":545,"_29554":484,"_20528":49830,"_5":14087,"_26889":49636,"_2862":49831},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_3376":546,"_29554":484,"_20528":49833,"_5":14087,"_26889":49636,"_2862":49834},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_3376":547,"_29554":484,"_20528":49836,"_5":14087,"_26889":49636,"_2862":49837},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_3376":548,"_29554":484,"_20528":49839,"_5":14087,"_26889":49640,"_2862":49840},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_3376":549,"_29554":484,"_20528":49842,"_5":14087,"_26889":49640,"_2862":49843},[],"The decision is made with the domain operation context:",{"_3376":550,"_29554":484,"_20528":49845,"_5":14087,"_26889":49640,"_2862":49846},[],"The middleware extracts the credential and resolves the matching principals.",{"_3376":551,"_29554":484,"_20528":49848,"_5":14087,"_26889":49640,"_2862":49849},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_3376":552,"_29554":484,"_20528":49851,"_5":14087,"_26889":49640,"_2862":49852},[],"`authz` gathers the entity rules of the granted policies.",{"_3376":553,"_29554":484,"_20528":49854,"_5":14087,"_26889":49640,"_2862":49855},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_3376":554,"_29554":484,"_20528":49857,"_5":14087,"_26889":49640,"_2862":49858},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_3376":555,"_29554":484,"_20528":49860,"_5":14087,"_26889":49640,"_2862":49861},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_3376":556,"_29554":484,"_20528":49863,"_5":14087,"_26889":49640,"_2862":49864},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_3376":557,"_29554":484,"_20528":49866,"_5":14087,"_26889":49640,"_2862":49867},[],"Actions fall into two groups:",{"_3376":558,"_29554":484,"_20528":49869,"_5":14087,"_26889":49640,"_2862":49870},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_3376":559,"_29554":484,"_20528":49872,"_5":14087,"_26889":49640,"_2862":49873},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_3376":560,"_29554":484,"_20528":49875,"_5":14087,"_26889":49640,"_2862":49876},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_3376":561,"_29554":484,"_20528":49878,"_5":14087,"_26889":49644,"_2862":49879},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_3376":562,"_29554":484,"_20528":49881,"_5":14087,"_26889":49644,"_2862":49882},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_3376":563,"_29554":484,"_20528":49884,"_5":14087,"_26889":49644,"_2862":49885},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_3376":564,"_29554":484,"_20528":49887,"_5":14087,"_26889":49648,"_2862":49888},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_3376":565,"_29554":484,"_20528":49890,"_5":14087,"_26889":49648,"_2862":49891},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_3376":566,"_29554":484,"_20528":49893,"_5":14087,"_26889":49648,"_2862":49894},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_3376":567,"_29554":484,"_20528":49896,"_5":14087,"_26889":49648,"_2862":49897},[],"The implemented operators are:",{"_3376":568,"_29554":484,"_20528":49899,"_5":14087,"_26889":49648,"_2862":49900},[],"`equals`, for exact equality;",{"_3376":569,"_29554":484,"_20528":49902,"_5":14087,"_26889":49648,"_2862":49903},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_3376":570,"_29554":484,"_20528":49905,"_5":14087,"_26889":49648,"_2862":49906},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_3376":571,"_29554":484,"_20528":49908,"_5":14087,"_26889":49648,"_2862":49909},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_3376":572,"_29554":484,"_20528":49911,"_5":14087,"_26889":49652,"_2862":49912},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_3376":573,"_29554":484,"_20528":49914,"_5":14087,"_26889":49652,"_2862":49915},[],"The available modes are:",{"_3376":574,"_29554":484,"_20528":49917,"_5":14087,"_26889":49652,"_2862":49918},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_3376":575,"_29554":484,"_20528":49920,"_5":14087,"_26889":49652,"_2862":49921},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_3376":576,"_29554":484,"_20528":49923,"_5":14087,"_26889":49652,"_2862":49924},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_3376":577,"_29554":484,"_20528":49926,"_5":14087,"_26889":49652,"_2862":49927},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_3376":578,"_29554":484,"_20528":49929,"_5":14087,"_26889":49652,"_2862":49930},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_3376":579,"_29554":484,"_20528":49932,"_5":14087,"_26889":49652,"_2862":49933},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_3376":580,"_29554":484,"_20528":49935,"_5":14087,"_26889":49656,"_2862":49936},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_3376":581,"_29554":484,"_20528":49938,"_5":14087,"_26889":49656,"_2862":49939},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_3376":582,"_29554":484,"_20528":49941,"_5":14087,"_26889":49656,"_2862":49942},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_3376":583,"_29554":484,"_20528":49944,"_5":14087,"_26889":49656,"_2862":49945},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_3376":584,"_29554":484,"_20528":49947,"_5":14087,"_26889":49664,"_2862":49948},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_3376":585,"_29554":484,"_20528":49950,"_5":14087,"_26889":49664,"_2862":49951},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_3376":586,"_29554":484,"_20528":49953,"_5":14087,"_26889":49668,"_2862":49954},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA and of a device to its DMS. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_3376":587,"_29554":484,"_20528":49956,"_5":14087,"_26889":49668,"_2862":49957},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_3376":588,"_29554":484,"_20528":49959,"_5":14087,"_26889":49672,"_2862":49960},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_3376":589,"_29554":484,"_20528":49962,"_5":14087,"_26889":49672,"_2862":49963},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_3376":590,"_29554":484,"_20528":49965,"_5":14087,"_26889":49672,"_2862":49966},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_3376":591,"_29554":484,"_20528":49968,"_5":14087,"_26889":49676,"_2862":49969},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_3376":592,"_29554":484,"_20528":49971,"_5":14087,"_26889":49676,"_2862":49972},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_3376":593,"_29554":484,"_20528":49974,"_5":14087,"_26889":49676,"_2862":49975},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_3376":594,"_29554":484,"_20528":49977,"_5":14087,"_26889":49676,"_2862":49978},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_3376":595,"_29554":484,"_20528":49980,"_5":14087,"_26889":49676,"_2862":49981},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_3376":596,"_29554":484,"_20528":49983,"_5":14087,"_26889":49676,"_2862":49984},[],"Note that:",{"_3376":597,"_29554":484,"_20528":49986,"_5":14087,"_26889":49676,"_2862":49987},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_3376":598,"_29554":484,"_20528":49989,"_5":14087,"_26889":49676,"_2862":49990},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_3376":599,"_29554":484,"_20528":49992,"_5":14087,"_26889":49676,"_2862":49993},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_3376":600,"_29554":484,"_20528":49995,"_5":14087,"_26889":49680,"_2862":49996},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_3376":601,"_29554":484,"_20528":49998,"_5":14087,"_26889":49680,"_2862":49999},[],"full and read-only access to certificates and authorities;",{"_3376":602,"_29554":484,"_20528":50001,"_5":14087,"_26889":49680,"_2862":50002},[],"full and read-only access to the KMS;",{"_3376":603,"_29554":484,"_20528":50004,"_5":14087,"_26889":49680,"_2862":50005},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_3376":604,"_29554":484,"_20528":50007,"_5":14087,"_26889":49680,"_2862":50008},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_3376":605,"_29554":484,"_20528":50010,"_5":14087,"_26889":49680,"_2862":50011},[],"console access;",{"_3376":606,"_29554":484,"_20528":50013,"_5":14087,"_26889":49680,"_2862":50014},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_3376":607,"_29554":484,"_20528":50016,"_5":14087,"_26889":49680,"_2862":50017},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_3376":608,"_29554":484,"_20528":50019,"_5":14087,"_26889":49680,"_2862":50020},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_3376":609,"_29554":484,"_20528":50022,"_5":14087,"_26889":49684,"_2862":50023},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_3376":610,"_29554":484,"_20528":50025,"_5":14087,"_26889":49684,"_2862":50026},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_3376":611,"_29554":484,"_20528":50028,"_5":14087,"_26889":49684,"_2862":50029},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_3376":612,"_29554":484,"_20528":50031,"_5":14087,"_26889":49687,"_2862":50032},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_3376":613,"_29554":484,"_20528":50034,"_5":14087,"_26889":49691,"_2862":50035},[],"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`.",{"_3376":614,"_29554":484,"_20528":50037,"_5":14087,"_26889":49691,"_2862":50038},[],"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0.",{"_3376":615,"_29554":484,"_20528":50040,"_5":14087,"_26889":49695,"_2862":50041},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_3376":616,"_29554":484,"_20528":50043,"_5":14087,"_26889":49699,"_2862":50044},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_3376":617,"_29554":484,"_20528":50046,"_5":14087,"_26889":49703,"_2862":50047},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_3376":618,"_29554":484,"_20528":50049,"_5":14087,"_26889":49707,"_2862":50050},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_3376":619,"_29554":484,"_20528":50052,"_5":14087,"_26889":49707,"_2862":50053},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_3376":620,"_29554":484,"_20528":50055,"_5":14087,"_26889":49711,"_2862":50056},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_3376":621,"_29554":484,"_20528":50058,"_5":14087,"_26889":49711,"_2862":50059},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_3376":622,"_29554":484,"_20528":50061,"_5":14087,"_26889":49711,"_2862":50062},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_3376":623,"_29554":484,"_20528":50064,"_5":14087,"_26889":49711,"_2862":50065},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_3376":624,"_29554":484,"_20528":50067,"_5":14087,"_26889":49711,"_2862":50068},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_3376":625,"_29554":484,"_20528":50070,"_5":14087,"_26889":49711,"_2862":50071},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_3376":626,"_29554":484,"_20528":50073,"_5":14087,"_26889":49711,"_2862":50074},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_3376":627,"_29554":484,"_20528":50076,"_5":14087,"_26889":49711,"_2862":50077},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_3376":628,"_29554":484,"_20528":50079,"_5":14087,"_26889":49715,"_2862":50080},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_3376":629,"_29554":484,"_20528":50082,"_5":14087,"_26889":49715,"_2862":50083},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_3376":630,"_29554":484,"_20528":50085,"_5":14087,"_26889":49715,"_2862":50086},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_3376":631,"_29554":484,"_20528":50088,"_5":14087,"_26889":49719,"_2862":50089},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_3376":632,"_29554":484,"_20528":50091,"_5":14087,"_26889":49719,"_2862":50092},[],"Use groups or stable roles for people and independent identities for automations.",{"_3376":633,"_29554":484,"_20528":50094,"_5":14087,"_26889":49719,"_2862":50095},[],"Keep at least two recovery administrators and test their access periodically.",{"_3376":634,"_29554":484,"_20528":50097,"_5":14087,"_26889":49719,"_2862":50098},[],"Review active principals, their matches and their grants after IdP changes.",{"_3376":635,"_29554":484,"_20528":50100,"_5":14087,"_26889":49719,"_2862":50101},[],"Search for wildcards in policies before upgrading Lamassu.",{"_3376":636,"_29554":484,"_20528":50103,"_5":14087,"_26889":49719,"_2862":50104},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_3376":637,"_29554":484,"_20528":50106,"_5":14087,"_26889":49719,"_2862":50107},[],"Always test one allowed and one denied operation for each role.",{"_3376":638,"_29554":484,"_20528":50109,"_5":14087,"_26889":49719,"_2862":50110},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_3376":639,"_29554":484,"_20528":50112,"_5":14087,"_26889":49727,"_2862":50113},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_3376":640,"_29554":484,"_20528":50115,"_5":14087,"_26889":49731,"_2862":50116},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_3376":641,"_29554":484,"_20528":50118,"_5":14087,"_26889":49731,"_2862":50119},[],"that an active principal of the correct type exists;",{"_3376":642,"_29554":484,"_20528":50121,"_5":14087,"_26889":49731,"_2862":50122},[],"that the claim paths and values match the real token exactly;",{"_3376":643,"_29554":484,"_20528":50124,"_5":14087,"_26889":49731,"_2862":50125},[],"that all of the principal's conditions hold;",{"_3376":644,"_29554":484,"_20528":50127,"_5":14087,"_26889":49731,"_2862":50128},[],"that the principal has the expected policy granted;",{"_3376":645,"_29554":484,"_20528":50130,"_5":14087,"_26889":49731,"_2862":50131},[],"that the policy includes the action and the requested resource type or route;",{"_3376":646,"_29554":484,"_20528":50133,"_5":14087,"_26889":49731,"_2862":50134},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_3376":647,"_29554":484,"_20528":50136,"_5":14087,"_26889":49731,"_2862":50137},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry tracing enabled, a request that reaches the policy engine produces an `engine.CheckHTTPRequest` span whose attributes record `authz.allowed`, the matched policy and the matched principal. Correlation with the Gateway trace requires trace context to be propagated to authz.",{"_3376":648,"_29554":484,"_20528":50139,"_5":14087,"_26889":49735,"_2862":50140},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_3376":649,"_29554":484,"_20528":50142,"_5":14087,"_26889":49739,"_2862":50143},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_3376":650,"_29554":484,"_20528":50145,"_5":14087,"_26889":49743,"_2862":50146},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_3376":651,"_29554":484,"_20528":50148,"_5":14087,"_26889":49743,"_2862":50149},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_3376":652,"_29554":652,"_5":14445,"_2862":50151,"_29906":50152,"_20528":50153,"_26889":652},"Alerts and subscriptions",[48148,49616,49617],[],{"_3376":653,"_29554":652,"_20528":50155,"_5":14087,"_26889":652,"_2862":50156},[],"Send PKI events to people and external systems.",{"_3376":654,"_29554":652,"_5":29903,"_20528":50158,"_26889":50159,"_2862":50160},[],"/docs/pr-preview/pr-52/platform/administration/alerts#how-it-works","How it works",{"_3376":655,"_29554":652,"_5":29903,"_20528":50162,"_26889":50163,"_2862":50164},[],"/docs/pr-preview/pr-52/platform/administration/alerts#available-channels","Available channels",{"_3376":656,"_29554":652,"_5":29903,"_20528":50166,"_26889":50167,"_2862":50168},[],"/docs/pr-preview/pr-52/platform/administration/alerts#create-a-subscription","Create a subscription",{"_3376":657,"_29554":652,"_5":29903,"_20528":50170,"_26889":50171,"_2862":50172},[],"/docs/pr-preview/pr-52/platform/administration/alerts#choose-the-event","Choose the event",{"_3376":658,"_29554":652,"_5":29903,"_20528":50174,"_26889":50175,"_2862":50176},[],"/docs/pr-preview/pr-52/platform/administration/alerts#configure-the-destination","Configure the destination",{"_3376":659,"_29554":652,"_5":29903,"_20528":50178,"_26889":50179,"_2862":50180},[],"/docs/pr-preview/pr-52/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_3376":660,"_29554":652,"_5":29903,"_20528":50182,"_26889":50183,"_2862":50184},[],"/docs/pr-preview/pr-52/platform/administration/alerts#review-and-activate","Review and activate",{"_3376":661,"_29554":652,"_5":29903,"_20528":50186,"_26889":50187,"_2862":50188},[],"/docs/pr-preview/pr-52/platform/administration/alerts#configure-the-webhook-http-client","Configure the webhook HTTP client",{"_3376":662,"_29554":652,"_5":29903,"_20528":50190,"_26889":50191,"_2862":50192},[],"/docs/pr-preview/pr-52/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_3376":663,"_29554":652,"_5":29903,"_20528":50194,"_26889":50195,"_2862":50196},[],"/docs/pr-preview/pr-52/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_3376":664,"_29554":652,"_5":29903,"_20528":50198,"_26889":50199,"_2862":50200},[],"/docs/pr-preview/pr-52/platform/administration/alerts#event-families","Event families",{"_3376":665,"_29554":652,"_20528":50202,"_5":14087,"_26889":652,"_2862":50203},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_3376":666,"_29554":652,"_20528":50205,"_5":14087,"_26889":50159,"_2862":50206},[],"A service publishes a domain event.",{"_3376":667,"_29554":652,"_20528":50208,"_5":14087,"_26889":50159,"_2862":50209},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_3376":668,"_29554":652,"_20528":50211,"_5":14087,"_26889":50159,"_2862":50212},[],"Each subscription's filter decides whether it should be notified.",{"_3376":669,"_29554":652,"_20528":50214,"_5":14087,"_26889":50159,"_2862":50215},[],"Lamassu delivers the event to the configured channel.",{"_3376":670,"_29554":652,"_20528":50217,"_5":14087,"_26889":50159,"_2862":50218},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_3376":671,"_29554":652,"_20528":50220,"_5":14087,"_26889":50163,"_2862":50221},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_3376":672,"_29554":652,"_20528":50223,"_5":14087,"_26889":50163,"_2862":50224},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_3376":673,"_29554":652,"_20528":50226,"_5":14087,"_26889":50163,"_2862":50227},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_3376":674,"_29554":652,"_20528":50229,"_5":14087,"_26889":50163,"_2862":50230},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_3376":675,"_29554":652,"_20528":50232,"_5":14087,"_26889":50163,"_2862":50233},[],"`apikey_options` requires `header` and `key`.",{"_3376":676,"_29554":652,"_20528":50235,"_5":14087,"_26889":50163,"_2862":50236},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3376":677,"_29554":652,"_20528":50238,"_5":14087,"_26889":50163,"_2862":50239},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_3376":678,"_29554":652,"_20528":50241,"_5":14087,"_26889":50163,"_2862":50242},[],"The alerts API reference documents the full `http_client` schema.",{"_3376":679,"_29554":652,"_20528":50244,"_5":14087,"_26889":50171,"_2862":50245},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_3376":680,"_29554":652,"_20528":50247,"_5":14087,"_26889":50175,"_2862":50248},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_3376":681,"_29554":652,"_20528":50250,"_5":14087,"_26889":50179,"_2862":50251},[],"Add a filter if you don't want to receive every instance of the event.",{"_3376":682,"_29554":652,"_20528":50253,"_5":14087,"_26889":50179,"_2862":50254},[],"**None** notifies all instances of the event.",{"_3376":683,"_29554":652,"_20528":50256,"_5":14087,"_26889":50179,"_2862":50257},[],"**JSON Path** evaluates one or more specific fields.",{"_3376":684,"_29554":652,"_20528":50259,"_5":14087,"_26889":50179,"_2862":50260},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_3376":685,"_29554":652,"_20528":50262,"_5":14087,"_26889":50179,"_2862":50263},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_3376":686,"_29554":652,"_20528":50265,"_5":14087,"_26889":50179,"_2862":50266},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_3376":687,"_29554":652,"_20528":50268,"_5":14087,"_26889":50179,"_2862":50269},[],"The console evaluates the filter against the JSON shown in the **Input Event** editor, which is prefilled with the latest event, and reports whether it matches. For JSON Path and JavaScript filters, it shows **The filter matches this Cloud Event** or **The filter does not match this Cloud Event**. JSON Path expressions are evaluated against the full Cloud Event, so the default `$.data` selects the event's `data` field, and the expression must start with `$`.",{"_3376":688,"_29554":652,"_20528":50271,"_5":14087,"_26889":50183,"_2862":50272},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_3376":689,"_29554":652,"_20528":50274,"_5":14087,"_26889":50187,"_2862":50275},[],"The Webhook and Microsoft Teams channels show this configuration in the subscribe form, at the channel step, and again when editing a subscription; Email does not use it. The fields map to the optional `http_client` block described above:",{"_3376":690,"_29554":652,"_20528":50277,"_5":14087,"_26889":50187,"_2862":50278},[],"**Log Level** selects `debug`, `info`, `warn` or `error`; `info` is the default.",{"_3376":691,"_29554":652,"_20528":50280,"_5":14087,"_26889":50187,"_2862":50281},[],"**Call Timeout** defaults to 10 seconds. The console rejects a value above 30 seconds with `Webhook timeout must be at most 30s.`; the API clamps the same value to the cap instead (see Calls are bounded).",{"_3376":692,"_29554":652,"_20528":50283,"_5":14087,"_26889":50187,"_2862":50284},[],"There is no TLS-verification switch for these channels, because the service always verifies the receiver certificate (see TLS is always verified).",{"_3376":693,"_29554":652,"_20528":50286,"_5":14087,"_26889":50187,"_2862":50287},[],"**HTTP Authentication** selects `No Authentication` (the default), `API Key` (API key value and Header Name, `X-API-Key` by default), `OIDC Client Credentials` (Client ID, Client Secret and Well-Known URL) or `Mutual TLS` (Client Certificate and Client Private Key pasted as PEM). A stored private key stays hidden until you select **Show**.",{"_3376":694,"_29554":652,"_20528":50289,"_5":14087,"_26889":50187,"_2862":50290},[],"A `http://` URL shows the console warning `Unencrypted HTTP connection` (see the Credentials over http\\:// callout below).",{"_3376":695,"_29554":652,"_20528":50292,"_5":14087,"_26889":50187,"_2862":50293},[],"The form validates inline against the same delivery rules: the webhook URL and the OIDC Well-Known URL must be absolute `http` or `https` URLs, an API-key header may not use a reserved name, and the mTLS certificate and key must be PEM content, not file paths.",{"_3376":696,"_29554":652,"_20528":50295,"_5":14087,"_26889":50187,"_2862":50296},[],"The summary in the Confirm step shows the authentication as `None`, `OIDC client credentials`, `API key` or `Mutual TLS`. The subscription details show the authentication, the API key header name (never the value), the OIDC issuer URL, mTLS as `Configured` and a fixed `TLS verification: Verified` row. The API key, client secret and private key are not shown in the subscription details.",{"_3376":697,"_29554":652,"_20528":50298,"_5":14087,"_26889":50191,"_2862":50299},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_3376":698,"_29554":652,"_20528":50301,"_5":14087,"_26889":50191,"_2862":50302},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_3376":699,"_29554":652,"_20528":50304,"_5":14087,"_26889":50191,"_2862":50305},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_3376":700,"_29554":652,"_20528":50307,"_5":14087,"_26889":50191,"_2862":50308},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_3376":701,"_29554":652,"_20528":50310,"_5":14087,"_26889":50191,"_2862":50311},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_3376":702,"_29554":652,"_20528":50313,"_5":14087,"_26889":50191,"_2862":50314},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_3376":703,"_29554":652,"_20528":50316,"_5":14087,"_26889":50191,"_2862":50317},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_3376":704,"_29554":652,"_20528":50319,"_5":14087,"_26889":50191,"_2862":50320},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_3376":705,"_29554":652,"_20528":50322,"_5":14087,"_26889":50195,"_2862":50323},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_3376":706,"_29554":652,"_20528":50325,"_5":14087,"_26889":50195,"_2862":50326},[],"Subscriptions created with older console versions may store the webhook target under `url` and `method` instead of `webhook_url` and `webhook_method`. The service delivers only through `webhook_url` and `webhook_method`, so such a subscription does not deliver even though the subscription details show the stored target. Open the subscription and save it again: the edit form prefills the stored target, and saving rewrites the channel configuration in the current layout.",{"_3376":707,"_29554":652,"_20528":50328,"_5":14087,"_26889":50199,"_2862":50329},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_3376":708,"_29554":652,"_20528":50331,"_5":14087,"_26889":50199,"_2862":50332},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_3376":709,"_29554":652,"_20528":50334,"_5":14087,"_26889":50199,"_2862":50335},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_3376":710,"_29554":652,"_20528":50337,"_5":14087,"_26889":50199,"_2862":50338},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_3376":711,"_29554":652,"_20528":50340,"_5":14087,"_26889":50199,"_2862":50341},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_3376":712,"_29554":652,"_20528":50343,"_5":14087,"_26889":50199,"_2862":50344},[],"**Validation:** `va.role.crl.create`.",{"_3376":713,"_29554":652,"_20528":50346,"_5":14087,"_26889":50199,"_2862":50347},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_3376":714,"_29554":652,"_20528":50349,"_5":14087,"_26889":50199,"_2862":50350},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_3376":715,"_29554":715,"_5":14445,"_2862":50352,"_29906":50353,"_20528":50354,"_26889":715},"Audit logs",[48148,49616,49617],[],{"_3376":716,"_29554":715,"_20528":50356,"_5":14087,"_26889":715,"_2862":50357},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_3376":717,"_29554":715,"_5":29903,"_20528":50359,"_26889":50360,"_2862":50361},[],"/docs/pr-preview/pr-52/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_3376":718,"_29554":715,"_5":29903,"_20528":50363,"_26889":50364,"_2862":50365},[],"/docs/pr-preview/pr-52/platform/administration/audit-logs#coverage","Coverage",{"_3376":719,"_29554":715,"_5":29903,"_20528":50367,"_26889":50368,"_2862":50369},[],"/docs/pr-preview/pr-52/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_3376":720,"_29554":715,"_5":29903,"_20528":50371,"_26889":50372,"_2862":50373},[],"/docs/pr-preview/pr-52/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_3376":721,"_29554":715,"_5":29903,"_20528":50375,"_26889":50376,"_2862":50377},[],"/docs/pr-preview/pr-52/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_3376":722,"_29554":715,"_5":29903,"_20528":50379,"_26889":50380,"_2862":50381},[],"/docs/pr-preview/pr-52/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_3376":723,"_29554":715,"_5":29903,"_20528":50383,"_26889":50384,"_2862":50385},[],"/docs/pr-preview/pr-52/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_3376":724,"_29554":715,"_5":29903,"_20528":50387,"_26889":50388,"_2862":50389},[],"/docs/pr-preview/pr-52/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_3376":725,"_29554":715,"_5":29903,"_20528":50391,"_26889":50392,"_2862":50393},[],"/docs/pr-preview/pr-52/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_3376":726,"_29554":715,"_5":29903,"_20528":50395,"_26889":50396,"_2862":50397},[],"/docs/pr-preview/pr-52/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_3376":727,"_29554":715,"_5":29903,"_20528":50399,"_26889":50400,"_2862":50401},[],"/docs/pr-preview/pr-52/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_3376":728,"_29554":715,"_20528":50403,"_5":14087,"_26889":715,"_2862":50404},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_3376":729,"_29554":715,"_20528":50406,"_5":14087,"_26889":50360,"_2862":50407},[],"The audit body includes:",{"_3376":730,"_29554":715,"_20528":50409,"_5":14087,"_26889":50360,"_2862":50410},[],"input: data received by the operation;",{"_3376":731,"_29554":715,"_20528":50412,"_5":14087,"_26889":50360,"_2862":50413},[],"has\\_error: whether the service returned an error;",{"_3376":732,"_29554":715,"_20528":50415,"_5":14087,"_26889":50360,"_2862":50416},[],"output: produced result or error message;",{"_3376":733,"_29554":715,"_20528":50418,"_5":14087,"_26889":50360,"_2862":50419},[],"principals: identifiers of the principals that matched the request.",{"_3376":734,"_29554":715,"_20528":50421,"_5":14087,"_26889":50360,"_2862":50422},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_3376":735,"_29554":715,"_20528":50424,"_5":14087,"_26889":50360,"_2862":50425},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_3376":736,"_29554":715,"_20528":50427,"_5":14087,"_26889":50364,"_2862":50428},[],"The backend applies auditing to mutations of:",{"_3376":737,"_29554":715,"_20528":50430,"_5":14087,"_26889":50364,"_2862":50431},[],"authorities, certificates and issuance profiles;",{"_3376":738,"_29554":715,"_20528":50433,"_5":14087,"_26889":50364,"_2862":50434},[],"keys and KMS engines;",{"_3376":739,"_29554":715,"_20528":50436,"_5":14087,"_26889":50364,"_2862":50437},[],"devices and identities;",{"_3376":740,"_29554":715,"_20528":50439,"_5":14087,"_26889":50364,"_2862":50440},[],"DMSs and enrollment operations;",{"_3376":741,"_29554":715,"_20528":50442,"_5":14087,"_26889":50364,"_2862":50443},[],"validation functions and CRL;",{"_3376":742,"_29554":715,"_20528":50445,"_5":14087,"_26889":50364,"_2862":50446},[],"principals, policies and authorization grants.",{"_3376":743,"_29554":715,"_20528":50448,"_5":14087,"_26889":50364,"_2862":50449},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_3376":744,"_29554":715,"_20528":50451,"_5":14087,"_26889":50368,"_2862":50452},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_3376":745,"_29554":715,"_20528":50454,"_5":14087,"_26889":50368,"_2862":50455},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_3376":746,"_29554":715,"_20528":50457,"_5":14087,"_26889":50368,"_2862":50458},[],"Design the consumer to:",{"_3376":747,"_29554":715,"_20528":50460,"_5":14087,"_26889":50368,"_2862":50461},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_3376":748,"_29554":715,"_20528":50463,"_5":14087,"_26889":50368,"_2862":50464},[],"keep the complete CloudEvent unmodified;",{"_3376":749,"_29554":715,"_20528":50466,"_5":14087,"_26889":50368,"_2862":50467},[],"record the ingestion time and detect duplicates by ID;",{"_3376":750,"_29554":715,"_20528":50469,"_5":14087,"_26889":50368,"_2862":50470},[],"encrypt in transit and at rest;",{"_3376":751,"_29554":715,"_20528":50472,"_5":14087,"_26889":50368,"_2862":50473},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_3376":752,"_29554":715,"_20528":50475,"_5":14087,"_26889":50368,"_2862":50476},[],"apply an explicit retention and legal hold policy;",{"_3376":753,"_29554":715,"_20528":50478,"_5":14087,"_26889":50368,"_2862":50479},[],"alert if it stops consuming or the pending queue grows.",{"_3376":754,"_29554":715,"_20528":50481,"_5":14087,"_26889":50372,"_2862":50482},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_3376":755,"_29554":715,"_20528":50484,"_5":14087,"_26889":50372,"_2862":50485},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_3376":756,"_29554":715,"_20528":50487,"_5":14087,"_26889":50380,"_2862":50488},[],"Start from the reported time and normalize every source to UTC.",{"_3376":757,"_29554":715,"_20528":50490,"_5":14087,"_26889":50384,"_2862":50491},[],"Filter by event type, service source and resource identifier.",{"_3376":758,"_29554":715,"_20528":50493,"_5":14087,"_26889":50388,"_2862":50494},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_3376":759,"_29554":715,"_20528":50496,"_5":14087,"_26889":50392,"_2862":50497},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_3376":760,"_29554":715,"_20528":50499,"_5":14087,"_26889":50396,"_2862":50500},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_3376":761,"_29554":715,"_20528":50502,"_5":14087,"_26889":50400,"_2862":50503},[],"Generate a controlled mutation in a test environment and check that:",{"_3376":762,"_29554":715,"_20528":50505,"_5":14087,"_26889":50400,"_2862":50506},[],"a successful audit event appears;",{"_3376":763,"_29554":715,"_20528":50508,"_5":14087,"_26889":50400,"_2862":50509},[],"the principal matches the identity used;",{"_3376":764,"_29554":715,"_20528":50511,"_5":14087,"_26889":50400,"_2862":50512},[],"the consumer persists it exactly once;",{"_3376":765,"_29554":715,"_20528":50514,"_5":14087,"_26889":50400,"_2862":50515},[],"it can be retrieved by resource, actor and period;",{"_3376":766,"_29554":715,"_20528":50517,"_5":14087,"_26889":50400,"_2862":50518},[],"a consumer outage raises an alert.",{"_3376":767,"_29554":715,"_20528":50520,"_5":14087,"_26889":50400,"_2862":50521},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_3376":768,"_29554":768,"_5":14445,"_2862":50523,"_29906":50524,"_20528":50525,"_26889":768},"Platform architecture",[48148,49616],[],{"_3376":769,"_29554":768,"_20528":50527,"_5":14087,"_26889":768,"_2862":50528},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_3376":770,"_29554":768,"_5":29903,"_20528":50530,"_26889":50531,"_2862":50532},[],"/docs/pr-preview/pr-52/platform/concepts/architecture#control-plane","Control plane",{"_3376":771,"_29554":768,"_5":29903,"_20528":50534,"_26889":50535,"_2862":50536},[],"/docs/pr-preview/pr-52/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_3376":772,"_29554":768,"_5":29903,"_20528":50538,"_26889":50539,"_2862":50540},[],"/docs/pr-preview/pr-52/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_3376":773,"_29554":768,"_5":29903,"_20528":50542,"_26889":50543,"_2862":50544},[],"/docs/pr-preview/pr-52/platform/concepts/architecture#status-and-validation","Status and validation",{"_3376":774,"_29554":768,"_5":29903,"_20528":50546,"_26889":50547,"_2862":50548},[],"/docs/pr-preview/pr-52/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_3376":775,"_29554":768,"_20528":50550,"_5":14087,"_26889":768,"_2862":50551},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_3376":776,"_29554":768,"_20528":50553,"_5":14087,"_26889":768,"_2862":50554},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_3376":777,"_29554":768,"_20528":50556,"_5":14087,"_26889":50531,"_2862":50557},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_3376":778,"_29554":768,"_20528":50559,"_5":14087,"_26889":50535,"_2862":50560},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_3376":779,"_29554":768,"_20528":50562,"_5":14087,"_26889":50539,"_2862":50563},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_3376":780,"_29554":768,"_20528":50565,"_5":14087,"_26889":50543,"_2862":50566},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_3376":781,"_29554":768,"_20528":50568,"_5":14087,"_26889":50547,"_2862":50569},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_3376":782,"_29554":782,"_5":14445,"_2862":50571,"_29906":50572,"_20528":50573,"_26889":782},"How Lamassu works",[48148,49616],[],{"_3376":783,"_29554":782,"_20528":50575,"_5":14087,"_26889":782,"_2862":50576},[],"The mental model of trust, keys, certificates and devices.",{"_3376":784,"_29554":782,"_5":29903,"_20528":50578,"_26889":50579,"_2862":50580},[],"/docs/pr-preview/pr-52/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_3376":785,"_29554":782,"_5":29903,"_20528":50582,"_26889":50583,"_2862":50584},[],"/docs/pr-preview/pr-52/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_3376":786,"_29554":782,"_20528":50586,"_5":14087,"_26889":782,"_2862":50587},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_3376":787,"_29554":782,"_20528":50589,"_5":14087,"_26889":50579,"_2862":50590},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_3376":788,"_29554":782,"_20528":50592,"_5":14087,"_26889":50579,"_2862":50593},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_3376":789,"_29554":782,"_20528":50595,"_5":14087,"_26889":50579,"_2862":50596},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_3376":790,"_29554":782,"_20528":50598,"_5":14087,"_26889":50579,"_2862":50599},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_3376":791,"_29554":782,"_20528":50601,"_5":14087,"_26889":50579,"_2862":50602},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_3376":792,"_29554":782,"_20528":50604,"_5":14087,"_26889":50583,"_2862":50605},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_3376":793,"_29554":782,"_20528":50607,"_5":14087,"_26889":50583,"_2862":50608},[],"A DMS relates that CA to an enrollment policy.",{"_3376":794,"_29554":782,"_20528":50610,"_5":14087,"_26889":50583,"_2862":50611},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_3376":795,"_29554":782,"_20528":50613,"_5":14087,"_26889":50583,"_2862":50614},[],"Lamassu keeps the inventory, history and status of the identity.",{"_3376":796,"_29554":782,"_20528":50616,"_5":14087,"_26889":50583,"_2862":50617},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_3376":797,"_29554":782,"_20528":50619,"_5":14087,"_26889":50583,"_2862":50620},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_3376":798,"_29554":782,"_20528":50622,"_5":14087,"_26889":50583,"_2862":50623},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3376":799,"_29554":799,"_5":14445,"_2862":50625,"_29906":50626,"_20528":50628,"_26889":799},"Devices and identities",[48148,49616,50627,50625],"IoT Fleets",[],{"_3376":800,"_29554":799,"_20528":50630,"_5":14087,"_26889":799,"_2862":50631},[],"Register, inspect and retire devices while checking their current identity and history.",{"_3376":801,"_29554":799,"_5":29903,"_20528":50633,"_26889":50634,"_2862":50635},[],"/docs/pr-preview/pr-52/platform/iot-fleets/device-management#device-states","Device states",{"_3376":802,"_29554":799,"_5":29903,"_20528":50637,"_26889":50638,"_2862":50639},[],"/docs/pr-preview/pr-52/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_3376":803,"_29554":799,"_5":29903,"_20528":50641,"_26889":50642,"_2862":50643},[],"/docs/pr-preview/pr-52/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_3376":804,"_29554":799,"_5":29903,"_20528":50645,"_26889":50646,"_2862":50647},[],"/docs/pr-preview/pr-52/platform/iot-fleets/device-management#create-the-device","Create the device",{"_3376":805,"_29554":799,"_5":29903,"_20528":50649,"_26889":50650,"_2862":50651},[],"/docs/pr-preview/pr-52/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_3376":806,"_29554":799,"_5":29903,"_20528":50653,"_26889":50654,"_2862":50655},[],"/docs/pr-preview/pr-52/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_3376":807,"_29554":799,"_5":29903,"_20528":50657,"_26889":50658,"_2862":50659},[],"/docs/pr-preview/pr-52/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_3376":808,"_29554":799,"_5":29903,"_20528":50661,"_26889":50662,"_2862":50663},[],"/docs/pr-preview/pr-52/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_3376":809,"_29554":799,"_5":29903,"_20528":50665,"_26889":50666,"_2862":50667},[],"/docs/pr-preview/pr-52/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_3376":810,"_29554":799,"_5":29903,"_20528":50669,"_26889":50670,"_2862":50671},[],"/docs/pr-preview/pr-52/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_3376":811,"_29554":799,"_5":29903,"_20528":50673,"_26889":50674,"_2862":50675},[],"/docs/pr-preview/pr-52/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_3376":812,"_29554":799,"_20528":50677,"_5":14087,"_26889":799,"_2862":50678},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_3376":813,"_29554":799,"_20528":50680,"_5":14087,"_26889":799,"_2862":50681},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_3376":814,"_29554":799,"_20528":50683,"_5":14087,"_26889":50634,"_2862":50684},[],"Operational view",{"_3376":815,"_29554":799,"_20528":50686,"_5":14087,"_26889":50634,"_2862":50687},[],"Meaning",{"_3376":816,"_29554":799,"_20528":50689,"_5":14087,"_26889":50634,"_2862":50690},[],"**No Identity**",{"_3376":817,"_29554":799,"_20528":50692,"_5":14087,"_26889":50634,"_2862":50693},[],"A record exists without an associated identity.",{"_3376":818,"_29554":799,"_20528":50695,"_5":14087,"_26889":50634,"_2862":50696},[],"**Active**",{"_3376":819,"_29554":799,"_20528":50698,"_5":14087,"_26889":50634,"_2862":50699},[],"The slot is active; also check certificate dates, status and usages.",{"_3376":820,"_29554":799,"_20528":50701,"_5":14087,"_26889":50634,"_2862":50702},[],"**Renewal Pending**",{"_3376":821,"_29554":799,"_20528":50704,"_5":14087,"_26889":50634,"_2862":50705},[],"The identity is in the operational renewal window.",{"_3376":822,"_29554":799,"_20528":50707,"_5":14087,"_26889":50634,"_2862":50708},[],"**Expiring Soon**",{"_3376":823,"_29554":799,"_20528":50710,"_5":14087,"_26889":50634,"_2862":50711},[],"Expiration is approaching according to configured thresholds.",{"_3376":824,"_29554":799,"_20528":50713,"_5":14087,"_26889":50634,"_2862":50714},[],"**Expired**",{"_3376":825,"_29554":799,"_20528":50716,"_5":14087,"_26889":50634,"_2862":50717},[],"The identity has expired.",{"_3376":826,"_29554":799,"_20528":50719,"_5":14087,"_26889":50634,"_2862":50720},[],"**Revoked**",{"_3376":827,"_29554":799,"_20528":50722,"_5":14087,"_26889":50634,"_2862":50723},[],"The identity is marked revoked.",{"_3376":828,"_29554":799,"_20528":50725,"_5":14087,"_26889":50634,"_2862":50726},[],"**Decommissioned**",{"_3376":829,"_29554":799,"_20528":50728,"_5":14087,"_26889":50634,"_2862":50729},[],"The record is retired and ordinary updates do not restore operation.",{"_3376":830,"_29554":799,"_20528":50731,"_5":14087,"_26889":50634,"_2862":50732},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_3376":831,"_29554":799,"_20528":50734,"_5":14087,"_26889":50638,"_2862":50735},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_3376":832,"_29554":799,"_20528":50737,"_5":14087,"_26889":50638,"_2862":50738},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_3376":833,"_29554":799,"_20528":50740,"_5":14087,"_26889":50638,"_2862":50741},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_3376":834,"_29554":799,"_20528":50743,"_5":14087,"_26889":50638,"_2862":50744},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_3376":835,"_29554":799,"_20528":50746,"_5":14087,"_26889":50642,"_2862":50747},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_3376":836,"_29554":799,"_20528":50749,"_5":14087,"_26889":50646,"_2862":50750},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_3376":837,"_29554":799,"_20528":50752,"_5":14087,"_26889":50650,"_2862":50753},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_3376":838,"_29554":799,"_20528":50755,"_5":14087,"_26889":50654,"_2862":50756},[],"Add model, environment or location tags and an icon according to your inventory.",{"_3376":839,"_29554":799,"_20528":50758,"_5":14087,"_26889":50658,"_2862":50759},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_3376":840,"_29554":799,"_20528":50761,"_5":14087,"_26889":50658,"_2862":50762},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_3376":841,"_29554":799,"_20528":50764,"_5":14087,"_26889":50662,"_2862":50765},[],"From **No Identity**, use **Assign Identity**:",{"_3376":842,"_29554":799,"_20528":50767,"_5":14087,"_26889":50662,"_2862":50768},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_3376":843,"_29554":799,"_20528":50770,"_5":14087,"_26889":50662,"_2862":50771},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_3376":844,"_29554":799,"_20528":50773,"_5":14087,"_26889":50662,"_2862":50774},[],"Confirm and read the serial, active version and history again.",{"_3376":845,"_29554":799,"_20528":50776,"_5":14087,"_26889":50662,"_2862":50777},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_3376":846,"_29554":799,"_20528":50779,"_5":14087,"_26889":50662,"_2862":50780},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_3376":847,"_29554":799,"_20528":50782,"_5":14087,"_26889":50666,"_2862":50783},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_3376":848,"_29554":799,"_20528":50785,"_5":14087,"_26889":50666,"_2862":50786},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_3376":849,"_29554":799,"_20528":50788,"_5":14087,"_26889":50670,"_2862":50789},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_3376":850,"_29554":799,"_20528":50791,"_5":14087,"_26889":50670,"_2862":50792},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_3376":851,"_29554":799,"_20528":50794,"_5":14087,"_26889":50670,"_2862":50795},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_3376":852,"_29554":799,"_20528":50797,"_5":14087,"_26889":50670,"_2862":50798},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_3376":853,"_29554":799,"_20528":50800,"_5":14087,"_26889":50674,"_2862":50801},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3376":854,"_29554":799,"_20528":50803,"_5":14087,"_26889":50674,"_2862":50804},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3376":855,"_29554":855,"_5":14445,"_2862":50806,"_29906":50807,"_20528":50809,"_26889":855},"Bootstrap identity and authentication",[48148,49616,50627,50625,50808],"Enrollment with PKI",[],{"_3376":856,"_29554":855,"_20528":50811,"_5":14087,"_26889":855,"_2862":50812},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_3376":857,"_29554":855,"_5":29903,"_20528":50814,"_26889":50815,"_2862":50816},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_3376":858,"_29554":855,"_5":29903,"_20528":50818,"_26889":50819,"_2862":50820},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_3376":859,"_29554":855,"_5":29903,"_20528":50822,"_26889":50823,"_2862":50824},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_3376":860,"_29554":855,"_5":29903,"_20528":50826,"_26889":50827,"_2862":50828},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_3376":861,"_29554":855,"_5":29903,"_20528":50830,"_26889":50831,"_2862":50832},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_3376":862,"_29554":855,"_20528":50834,"_5":14087,"_26889":855,"_2862":50835},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_3376":863,"_29554":855,"_20528":50837,"_5":14087,"_26889":50815,"_2862":50838},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_3376":864,"_29554":855,"_20528":50840,"_5":14087,"_26889":50815,"_2862":50841},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_3376":865,"_29554":855,"_20528":50843,"_5":14087,"_26889":50819,"_2862":50844},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_3376":866,"_29554":855,"_20528":50846,"_5":14087,"_26889":50819,"_2862":50847},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_3376":867,"_29554":855,"_20528":50849,"_5":14087,"_26889":50819,"_2862":50850},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_3376":868,"_29554":855,"_20528":50852,"_5":14087,"_26889":50823,"_2862":50853},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_3376":869,"_29554":855,"_20528":50855,"_5":14087,"_26889":50823,"_2862":50856},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_3376":870,"_29554":855,"_20528":50858,"_5":14087,"_26889":50827,"_2862":50859},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_3376":871,"_29554":855,"_20528":50861,"_5":14087,"_26889":50827,"_2862":50862},[],"Example body:",{"_3376":872,"_29554":855,"_20528":50864,"_5":14087,"_26889":50827,"_2862":50865},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_3376":873,"_29554":855,"_20528":50867,"_5":14087,"_26889":50827,"_2862":50868},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_3376":874,"_29554":855,"_20528":50870,"_5":14087,"_26889":50827,"_2862":50871},[],"Continuation requires a successful HTTP response and JSON:",{"_3376":875,"_29554":855,"_20528":50873,"_5":14087,"_26889":50827,"_2862":50874},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_3376":876,"_29554":855,"_20528":50876,"_5":14087,"_26889":50831,"_2862":50877},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_3376":877,"_29554":855,"_20528":50879,"_5":14087,"_26889":50831,"_2862":50880},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_3376":878,"_29554":878,"_5":14445,"_2862":50882,"_29906":50883,"_20528":50884,"_26889":878},"Configure and operate the DMS",[48148,49616,50627,50625,50808],[],{"_3376":879,"_29554":878,"_20528":50886,"_5":14087,"_26889":878,"_2862":50887},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_3376":880,"_29554":878,"_5":29903,"_20528":50889,"_26889":50890,"_2862":48158},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/dms#before-you-begin",{"_3376":881,"_29554":878,"_5":29903,"_20528":50892,"_26889":50893,"_2862":50894},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_3376":882,"_29554":878,"_5":29903,"_20528":50896,"_26889":50897,"_2862":50898},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_3376":883,"_29554":878,"_5":29903,"_20528":50900,"_26889":50901,"_2862":50902},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_3376":884,"_29554":878,"_5":29903,"_20528":50904,"_26889":50905,"_2862":50906},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_3376":885,"_29554":878,"_5":29903,"_20528":50908,"_26889":50909,"_2862":50910},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_3376":886,"_29554":878,"_5":29903,"_20528":50912,"_26889":50913,"_2862":50914},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_3376":887,"_29554":878,"_5":29903,"_20528":50916,"_26889":50917,"_2862":50918},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_3376":888,"_29554":878,"_5":29903,"_20528":50920,"_26889":50921,"_2862":50922},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_3376":889,"_29554":878,"_5":29903,"_20528":50924,"_26889":50925,"_2862":50926},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_3376":890,"_29554":878,"_5":29903,"_20528":50928,"_26889":50929,"_2862":50930},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_3376":891,"_29554":878,"_5":29903,"_20528":50932,"_26889":50933,"_2862":50934},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_3376":892,"_29554":878,"_5":29903,"_20528":50936,"_26889":50937,"_2862":50938},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_3376":893,"_29554":878,"_5":29903,"_20528":50940,"_26889":50941,"_2862":50942},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_3376":894,"_29554":878,"_5":29903,"_20528":50944,"_26889":50945,"_2862":50946},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_3376":895,"_29554":878,"_5":29903,"_20528":50948,"_26889":50949,"_2862":50950},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_3376":896,"_29554":878,"_5":29903,"_20528":50952,"_26889":50953,"_2862":50954},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_3376":897,"_29554":878,"_5":29903,"_20528":50956,"_26889":50957,"_2862":50958},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_3376":898,"_29554":878,"_20528":50960,"_5":14087,"_26889":878,"_2862":50961},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_3376":899,"_29554":878,"_20528":50963,"_5":14087,"_26889":50890,"_2862":50964},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_3376":900,"_29554":878,"_20528":50966,"_5":14087,"_26889":50890,"_2862":50967},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_3376":901,"_29554":878,"_20528":50969,"_5":14087,"_26889":50897,"_2862":50970},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_3376":902,"_29554":878,"_20528":50972,"_5":14087,"_26889":50901,"_2862":50973},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_3376":903,"_29554":878,"_20528":50975,"_5":14087,"_26889":50905,"_2862":50976},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_3376":904,"_29554":878,"_20528":50978,"_5":14087,"_26889":50909,"_2862":50979},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_3376":905,"_29554":878,"_20528":50981,"_5":14087,"_26889":50913,"_2862":50982},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_3376":906,"_29554":878,"_20528":50984,"_5":14087,"_26889":50921,"_2862":50985},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_3376":907,"_29554":878,"_20528":50987,"_5":14087,"_26889":50921,"_2862":50988},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_3376":908,"_29554":878,"_20528":50990,"_5":14087,"_26889":50925,"_2862":50991},[],"`settings.enrollment_settings` field",{"_3376":909,"_29554":878,"_20528":50993,"_5":14087,"_26889":50925,"_2862":50994},[],"Decision",{"_3376":910,"_29554":878,"_20528":50996,"_5":14087,"_26889":50925,"_2862":50997},[],"`protocol`",{"_3376":911,"_29554":878,"_20528":50999,"_5":14087,"_26889":50925,"_2862":51000},[],"`EST_RFC7030` for these operations.",{"_3376":912,"_29554":878,"_20528":51002,"_5":14087,"_26889":50925,"_2862":51003},[],"`enrollment_ca`",{"_3376":913,"_29554":878,"_20528":51005,"_5":14087,"_26889":50925,"_2862":51006},[],"ID of the signing CA.",{"_3376":914,"_29554":878,"_20528":51008,"_5":14087,"_26889":50925,"_2862":51009},[],"`verify_csr_signature`",{"_3376":915,"_29554":878,"_20528":51011,"_5":14087,"_26889":50925,"_2862":51012},[],"Keep `true` to verify CSR key possession.",{"_3376":916,"_29554":878,"_20528":51014,"_5":14087,"_26889":50925,"_2862":51015},[],"`enable_replaceable_enrollment`",{"_3376":917,"_29554":878,"_20528":51017,"_5":14087,"_26889":50925,"_2862":51018},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_3376":918,"_29554":878,"_20528":51020,"_5":14087,"_26889":50925,"_2862":51021},[],"`est_rfc7030_settings.auth_mode`",{"_3376":919,"_29554":878,"_20528":51023,"_5":14087,"_26889":50925,"_2862":51024},[],"One of the four authentication modes.",{"_3376":920,"_29554":878,"_20528":51026,"_5":14087,"_26889":50925,"_2862":51027},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_3376":921,"_29554":878,"_20528":51029,"_5":14087,"_26889":50929,"_2862":51030},[],"The blocks are independent:",{"_3376":922,"_29554":878,"_20528":51032,"_5":14087,"_26889":50929,"_2862":51033},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_3376":923,"_29554":878,"_20528":51035,"_5":14087,"_26889":50929,"_2862":51036},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_3376":924,"_29554":878,"_20528":51038,"_5":14087,"_26889":50929,"_2862":51039},[],"`auth_mode`",{"_3376":925,"_29554":878,"_20528":51041,"_5":14087,"_26889":50929,"_2862":51042},[],"Control applied in the configured operation",{"_3376":926,"_29554":878,"_20528":51044,"_5":14087,"_26889":50929,"_2862":51045},[],"`CLIENT_CERTIFICATE`",{"_3376":927,"_29554":878,"_20528":51047,"_5":14087,"_26889":50929,"_2862":51048},[],"Presented certificate validation.",{"_3376":928,"_29554":878,"_20528":51050,"_5":14087,"_26889":50929,"_2862":51051},[],"`EXTERNAL_WEBHOOK`",{"_3376":929,"_29554":878,"_20528":51053,"_5":14087,"_26889":50929,"_2862":51054},[],"Configured webhook authorization.",{"_3376":930,"_29554":878,"_20528":51056,"_5":14087,"_26889":50929,"_2862":51057},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3376":931,"_29554":878,"_20528":51059,"_5":14087,"_26889":50929,"_2862":51060},[],"Certificate validation followed by webhook approval.",{"_3376":932,"_29554":878,"_20528":51062,"_5":14087,"_26889":50929,"_2862":51063},[],"`NO_AUTH`",{"_3376":933,"_29554":878,"_20528":51065,"_5":14087,"_26889":50929,"_2862":51066},[],"No DMS requester authentication.",{"_3376":934,"_29554":878,"_20528":51068,"_5":14087,"_26889":50929,"_2862":51069},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_3376":935,"_29554":878,"_20528":51071,"_5":14087,"_26889":50929,"_2862":51072},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_3376":936,"_29554":878,"_20528":51074,"_5":14087,"_26889":50929,"_2862":51075},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs. That list is optional because the enrollment CA is always trusted for re-enrollment, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`.",{"_3376":937,"_29554":878,"_20528":51077,"_5":14087,"_26889":50929,"_2862":51078},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_3376":938,"_29554":878,"_20528":51080,"_5":14087,"_26889":50933,"_2862":51081},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_3376":939,"_29554":878,"_20528":51083,"_5":14087,"_26889":50933,"_2862":51084},[],"`external_webhook_settings` field",{"_3376":940,"_29554":878,"_20528":51086,"_5":14087,"_26889":50933,"_2862":50994},[],{"_3376":941,"_29554":878,"_20528":51088,"_5":14087,"_26889":50933,"_2862":51089},[],"`url`",{"_3376":942,"_29554":878,"_20528":51091,"_5":14087,"_26889":50933,"_2862":51092},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_3376":943,"_29554":878,"_20528":51094,"_5":14087,"_26889":50933,"_2862":51095},[],"`method`",{"_3376":944,"_29554":878,"_20528":51097,"_5":14087,"_26889":50933,"_2862":51098},[],"`POST` or `PUT`; `POST` by default.",{"_3376":945,"_29554":878,"_20528":51100,"_5":14087,"_26889":50933,"_2862":51101},[],"`name`",{"_3376":946,"_29554":878,"_20528":51103,"_5":14087,"_26889":50933,"_2862":51104},[],"Label used in service logs.",{"_3376":947,"_29554":878,"_20528":51106,"_5":14087,"_26889":50933,"_2862":51107},[],"`config.auth_mode`",{"_3376":948,"_29554":878,"_20528":51109,"_5":14087,"_26889":50933,"_2862":51110},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_3376":949,"_29554":878,"_20528":51112,"_5":14087,"_26889":50933,"_2862":51113},[],"`config.log_level`",{"_3376":950,"_29554":878,"_20528":51115,"_5":14087,"_26889":50933,"_2862":51116},[],"Log level of the webhook call: `debug`, `info`, `warn` or `error`; `info` by default.",{"_3376":951,"_29554":878,"_20528":51118,"_5":14087,"_26889":50933,"_2862":51119},[],"`config.apikey_options`",{"_3376":952,"_29554":878,"_20528":51121,"_5":14087,"_26889":50933,"_2862":51122},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_3376":953,"_29554":878,"_20528":51124,"_5":14087,"_26889":50933,"_2862":51125},[],"`config.jwt_options`",{"_3376":954,"_29554":878,"_20528":51127,"_5":14087,"_26889":50933,"_2862":51128},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3376":955,"_29554":878,"_20528":51130,"_5":14087,"_26889":50933,"_2862":51131},[],"`config.mtls_options`",{"_3376":956,"_29554":878,"_20528":51133,"_5":14087,"_26889":50933,"_2862":51134},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_3376":957,"_29554":878,"_20528":51136,"_5":14087,"_26889":50933,"_2862":51137},[],"`config.insecure_skip_verify`",{"_3376":958,"_29554":878,"_20528":51139,"_5":14087,"_26889":50933,"_2862":51140},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_3376":959,"_29554":878,"_20528":51142,"_5":14087,"_26889":50933,"_2862":51143},[],"`config.call_timeout`",{"_3376":960,"_29554":878,"_20528":51145,"_5":14087,"_26889":50933,"_2862":51146},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_3376":961,"_29554":878,"_20528":51148,"_5":14087,"_26889":50933,"_2862":51149},[],"Rules for that configuration:",{"_3376":962,"_29554":878,"_20528":51151,"_5":14087,"_26889":50933,"_2862":51152},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_3376":963,"_29554":878,"_20528":51154,"_5":14087,"_26889":50933,"_2862":51155},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_3376":964,"_29554":878,"_20528":51157,"_5":14087,"_26889":50933,"_2862":51158},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_3376":965,"_29554":878,"_20528":51160,"_5":14087,"_26889":50933,"_2862":51161},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_3376":966,"_29554":878,"_20528":51163,"_5":14087,"_26889":50933,"_2862":51164},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_3376":967,"_29554":878,"_20528":51166,"_5":14087,"_26889":50933,"_2862":51167},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_3376":968,"_29554":878,"_20528":51169,"_5":14087,"_26889":50933,"_2862":51170},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing. The console exposes independent editors for the enrollment and re-enrollment authentication, with the same Log Level, Call Timeout, HTTP Authentication and credential fields as the webhook channels, plus a **Skip TLS Verification** switch (off by default, so verification stays on; the console warns when you enable it).",{"_3376":969,"_29554":878,"_20528":51172,"_5":14087,"_26889":50933,"_2862":51173},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. To fix it in the console, open the DMS, replace any file-path value with PEM content — the editor rejects file paths with an inline field error — and save. Saving rewrites `external_webhook_settings.config` with the current keys, and the console reads both plain and Base64-encoded PEM from migrated configurations and stores the material Base64-encoded. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_3376":970,"_29554":878,"_20528":51175,"_5":14087,"_26889":50933,"_2862":51176},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_3376":971,"_29554":878,"_20528":51178,"_5":14087,"_26889":50937,"_2862":51179},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_3376":972,"_29554":878,"_20528":51181,"_5":14087,"_26889":50941,"_2862":51182},[],"`settings.reenrollment_settings` field",{"_3376":973,"_29554":878,"_20528":51184,"_5":14087,"_26889":50941,"_2862":48538},[],{"_3376":974,"_29554":878,"_20528":51186,"_5":14087,"_26889":50941,"_2862":51187},[],"`reenrollment_delta`",{"_3376":975,"_29554":878,"_20528":51189,"_5":14087,"_26889":50941,"_2862":51190},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_3376":976,"_29554":878,"_20528":51192,"_5":14087,"_26889":50941,"_2862":51193},[],"`preventive_delta`",{"_3376":977,"_29554":878,"_20528":51195,"_5":14087,"_26889":50941,"_2862":51196},[],"Preventive operational monitoring threshold.",{"_3376":978,"_29554":878,"_20528":51198,"_5":14087,"_26889":50941,"_2862":51199},[],"`critical_delta`",{"_3376":979,"_29554":878,"_20528":51201,"_5":14087,"_26889":50941,"_2862":51202},[],"Critical operational monitoring threshold.",{"_3376":980,"_29554":878,"_20528":51204,"_5":14087,"_26889":50941,"_2862":51205},[],"`enable_expired_renewal`",{"_3376":981,"_29554":878,"_20528":51207,"_5":14087,"_26889":50941,"_2862":51208},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_3376":982,"_29554":878,"_20528":51210,"_5":14087,"_26889":50941,"_2862":51211},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_3376":983,"_29554":878,"_20528":51213,"_5":14087,"_26889":50941,"_2862":51214},[],"Re-enrollment validation CAs for the renewal mTLS credential, tried after the enrollment CA; optional, because the enrollment CA is always trusted. Typically populated during CA rotation while old-CA cohorts renew.",{"_3376":984,"_29554":878,"_20528":51216,"_5":14087,"_26889":50941,"_2862":51217},[],"`revoke_on_reenrollment`",{"_3376":985,"_29554":878,"_20528":51219,"_5":14087,"_26889":50941,"_2862":51220},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_3376":986,"_29554":878,"_20528":51222,"_5":14087,"_26889":50941,"_2862":51223},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_3376":987,"_29554":878,"_20528":51225,"_5":14087,"_26889":50945,"_2862":51226},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. The console exposes it through an **Enable server-side key generation** switch and a **Key type** selection: `ECDSA` P-256, P-384 or P-521, or `RSA` with 2048, 3072 or 4096 bits; the defaults are P-256 for `ECDSA` and 4096 bit for `RSA`. Algorithm and size come from its `key` field, stored as `{type,bits}` where P-256, P-384 and P-521 map to `bits` 256, 384 and 521; `key` is omitted when disabled. The profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_3376":988,"_29554":878,"_20528":51228,"_5":14087,"_26889":50949,"_2862":48532},[],{"_3376":989,"_29554":878,"_20528":51230,"_5":14087,"_26889":50949,"_2862":51231},[],"Published material",{"_3376":990,"_29554":878,"_20528":51233,"_5":14087,"_26889":50949,"_2862":51234},[],"**Include Lamassu System CA**",{"_3376":991,"_29554":878,"_20528":51236,"_5":14087,"_26889":50949,"_2862":51237},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_3376":992,"_29554":878,"_20528":51239,"_5":14087,"_26889":50949,"_2862":51240},[],"**Include Enrollment CA**",{"_3376":993,"_29554":878,"_20528":51242,"_5":14087,"_26889":50949,"_2862":51243},[],"Selected issuing CA certificate.",{"_3376":994,"_29554":878,"_20528":51245,"_5":14087,"_26889":50949,"_2862":51246},[],"**Managed CAs**",{"_3376":995,"_29554":878,"_20528":51248,"_5":14087,"_26889":50949,"_2862":51249},[],"Explicitly selected CA certificates.",{"_3376":996,"_29554":878,"_20528":51251,"_5":14087,"_26889":50949,"_2862":51252},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_3376":997,"_29554":878,"_20528":51254,"_5":14087,"_26889":50953,"_2862":51255},[],"**Edit** changes name, settings and metadata. Updates go through the DMS API. `PUT /v1/dms/{id}` always targets the DMS identified by the URL path: the body carries no `id` field, and any `id` or `creation_ts` in it is silently ignored — authorization is evaluated against the same URL identifier. The body must include a non-empty `name` and a `settings` object; missing either returns HTTP 400 and leaves the stored DMS unchanged. `name` and `settings` are always full replacements, so read the DMS before sending API edits to avoid losing fields. `metadata` is optional: omitting it or sending `null` keeps the stored metadata, a supplied object replaces it entirely, and `{}` clears it (a later GET returns an empty object, not `null`). Old-style bodies that carry the full DMS object keep working while they include `name` and `settings`; unknown fields are ignored. Updates reject an empty `name` with HTTP 400: a DMS whose stored name was zeroed by an earlier update must be renamed before any client round-trips it — the AWS IoT connector’s JITP writeback included. If the object does not include the AWS IoT connector key (`lamassu.io/iot/{connector_id}`), the connector ignores the DMS's later events.",{"_3376":998,"_29554":878,"_20528":51257,"_5":14087,"_26889":50953,"_2862":51258},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_3376":999,"_29554":878,"_20528":51260,"_5":14087,"_26889":50953,"_2862":51261},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_3376":1000,"_29554":878,"_20528":51263,"_5":14087,"_26889":50957,"_2862":51264},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_3376":1001,"_29554":1001,"_5":14445,"_2862":51266,"_29906":51267,"_20528":51268,"_26889":1001},"Integrate the EST client",[48148,49616,50627,50625,50808],[],{"_3376":1002,"_29554":1001,"_20528":51270,"_5":14087,"_26889":1001,"_2862":51271},[],"Prepare trust, send a CSR and check the identity you receive.",{"_3376":1003,"_29554":1001,"_5":29903,"_20528":51273,"_26889":51274,"_2862":48158},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_3376":1004,"_29554":1001,"_5":29903,"_20528":51276,"_26889":51277,"_2862":51278},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_3376":1005,"_29554":1001,"_5":29903,"_20528":51280,"_26889":51281,"_2862":51282},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_3376":1006,"_29554":1001,"_5":29903,"_20528":51284,"_26889":51285,"_2862":51286},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_3376":1007,"_29554":1001,"_5":29903,"_20528":51288,"_26889":51289,"_2862":51290},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_3376":1008,"_29554":1001,"_5":29903,"_20528":51292,"_26889":51293,"_2862":51294},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_3376":1009,"_29554":1001,"_20528":51296,"_5":14087,"_26889":1001,"_2862":51297},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_3376":1010,"_29554":1001,"_20528":51299,"_5":14087,"_26889":51274,"_2862":51300},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_3376":1011,"_29554":1001,"_20528":51302,"_5":14087,"_26889":51274,"_2862":51303},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_3376":1012,"_29554":1001,"_20528":51305,"_5":14087,"_26889":51274,"_2862":51306},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_3376":1013,"_29554":1001,"_20528":51308,"_5":14087,"_26889":51277,"_2862":51309},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_3376":1014,"_29554":1001,"_20528":51311,"_5":14087,"_26889":51277,"_2862":51312},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_3376":1015,"_29554":1001,"_20528":51314,"_5":14087,"_26889":51281,"_2862":51315},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_3376":1016,"_29554":1001,"_20528":51317,"_5":14087,"_26889":51281,"_2862":51318},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_3376":1017,"_29554":1001,"_20528":51320,"_5":14087,"_26889":51285,"_2862":51321},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_3376":1018,"_29554":1001,"_20528":51323,"_5":14087,"_26889":51285,"_2862":51324},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_3376":1019,"_29554":1001,"_20528":51326,"_5":14087,"_26889":51289,"_2862":51327},[],"For a root that issues directly:",{"_3376":1020,"_29554":1001,"_20528":51329,"_5":14087,"_26889":51289,"_2862":51330},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_3376":1021,"_29554":1001,"_20528":51332,"_5":14087,"_26889":51289,"_2862":51333},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_3376":1022,"_29554":1001,"_20528":51335,"_5":14087,"_26889":51293,"_2862":51336},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_3376":1023,"_29554":1023,"_5":14445,"_2862":51338,"_29906":51339,"_20528":51340,"_26889":1023},"EST reference",[48148,49616,50627,50625,50808],[],{"_3376":1024,"_29554":1023,"_20528":51342,"_5":14087,"_26889":1023,"_2862":51343},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_3376":1025,"_29554":1023,"_5":29903,"_20528":51345,"_26889":51346,"_2862":51347},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_3376":1026,"_29554":1023,"_5":29903,"_20528":51349,"_26889":51350,"_2862":22256},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3376":1027,"_29554":1023,"_5":29903,"_20528":51352,"_26889":51353,"_2862":25536},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3376":1028,"_29554":1023,"_5":29903,"_20528":51355,"_26889":51356,"_2862":25543},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3376":1029,"_29554":1023,"_5":29903,"_20528":51358,"_26889":51359,"_2862":24871},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3376":1030,"_29554":1023,"_5":29903,"_20528":51361,"_26889":51362,"_2862":51363},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_3376":1031,"_29554":1023,"_5":29903,"_20528":51365,"_26889":51366,"_2862":51367},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_3376":1032,"_29554":1023,"_5":29903,"_20528":51369,"_26889":51370,"_2862":51371},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_3376":1033,"_29554":1023,"_20528":51373,"_5":14087,"_26889":1023,"_2862":51374},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_3376":1034,"_29554":1023,"_20528":51376,"_5":14087,"_26889":51346,"_2862":51377},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_3376":1035,"_29554":1023,"_20528":51379,"_5":14087,"_26889":51346,"_2862":51380},[],"Operation",{"_3376":1036,"_29554":1023,"_20528":51382,"_5":14087,"_26889":51346,"_2862":51383},[],"Method",{"_3376":1037,"_29554":1023,"_20528":51385,"_5":14087,"_26889":51346,"_2862":51386},[],"Authentication and condition",{"_3376":1038,"_29554":1023,"_20528":51388,"_5":14087,"_26889":51346,"_2862":51389},[],"`/cacerts`",{"_3376":1039,"_29554":1023,"_20528":51391,"_5":14087,"_26889":51346,"_2862":51392},[],"GET",{"_3376":1040,"_29554":1023,"_20528":51394,"_5":14087,"_26889":51346,"_2862":51395},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_3376":1041,"_29554":1023,"_20528":51397,"_5":14087,"_26889":51346,"_2862":51398},[],"`/simpleenroll`",{"_3376":1042,"_29554":1023,"_20528":51400,"_5":14087,"_26889":51346,"_2862":51401},[],"POST",{"_3376":1043,"_29554":1023,"_20528":51403,"_5":14087,"_26889":51346,"_2862":51404},[],"Initial authentication and DMS registration/replacement policy.",{"_3376":1044,"_29554":1023,"_20528":51406,"_5":14087,"_26889":51346,"_2862":51407},[],"`/simplereenroll`",{"_3376":1045,"_29554":1023,"_20528":51409,"_5":14087,"_26889":51346,"_2862":51401},[],{"_3376":1046,"_29554":1023,"_20528":51411,"_5":14087,"_26889":51346,"_2862":51412},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_3376":1047,"_29554":1023,"_20528":51414,"_5":14087,"_26889":51346,"_2862":51415},[],"`/serverkeygen`",{"_3376":1048,"_29554":1023,"_20528":51417,"_5":14087,"_26889":51346,"_2862":51401},[],{"_3376":1049,"_29554":1023,"_20528":51419,"_5":14087,"_26889":51346,"_2862":51420},[],"Initial authentication and admission; server generation enabled.",{"_3376":1050,"_29554":1023,"_20528":51422,"_5":14087,"_26889":51346,"_2862":51423},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_3376":1051,"_29554":1023,"_20528":51425,"_5":14087,"_26889":51350,"_2862":51426},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_3376":1052,"_29554":1023,"_20528":51428,"_5":14087,"_26889":51350,"_2862":51429},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_3376":1053,"_29554":1023,"_20528":51431,"_5":14087,"_26889":51353,"_2862":51432},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_3376":1054,"_29554":1023,"_20528":51434,"_5":14087,"_26889":51353,"_2862":51435},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_3376":1055,"_29554":1023,"_20528":51437,"_5":14087,"_26889":51356,"_2862":51438},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_3376":1056,"_29554":1023,"_20528":51440,"_5":14087,"_26889":51356,"_2862":51441},[],"In mTLS mode, the enrollment CA always validates the re-enrollment credential; certificates from other issuers are accepted only if they are listed as validation CAs in the re-enrollment block. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_3376":1057,"_29554":1023,"_20528":51443,"_5":14087,"_26889":51359,"_2862":51444},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_3376":1058,"_29554":1023,"_20528":51446,"_5":14087,"_26889":51359,"_2862":51447},[],"The code supports RSA and ECDSA, and the `bits` value of the DMS key setting means something different for each. For ECDSA it selects the curve: 224, 256, 384 or 521 map to P-224, P-256, P-384 and P-521, and an unrecognized size falls back to P-256, so explicitly select a compatible size and check the resulting key. For RSA it is used directly as the modulus size; the console offers 2048, 3072 and 4096 bits. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_3376":1059,"_29554":1023,"_20528":51449,"_5":14087,"_26889":51362,"_2862":51450},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_3376":1060,"_29554":1023,"_20528":51452,"_5":14087,"_26889":51362,"_2862":51453},[],"Part",{"_3376":1061,"_29554":1023,"_20528":51455,"_5":14087,"_26889":51362,"_2862":51456},[],"Content after decoding its Base64",{"_3376":1062,"_29554":1023,"_20528":51458,"_5":14087,"_26889":51362,"_2862":51459},[],"`application/pkcs8`",{"_3376":1063,"_29554":1023,"_20528":51461,"_5":14087,"_26889":51362,"_2862":51462},[],"Unencrypted DER PKCS#8 private key.",{"_3376":1064,"_29554":1023,"_20528":51464,"_5":14087,"_26889":51362,"_2862":51465},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_3376":1065,"_29554":1023,"_20528":51467,"_5":14087,"_26889":51362,"_2862":51468},[],"DER PKCS#7 containing the issued certificate.",{"_3376":1066,"_29554":1023,"_20528":51470,"_5":14087,"_26889":51362,"_2862":51471},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_3376":1067,"_29554":1023,"_20528":51473,"_5":14087,"_26889":51366,"_2862":51474},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_3376":1068,"_29554":1023,"_20528":51476,"_5":14087,"_26889":51366,"_2862":51477},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_3376":1069,"_29554":1023,"_20528":51479,"_5":14087,"_26889":51366,"_2862":51480},[],"Convert and check the result:",{"_3376":1070,"_29554":1023,"_20528":51482,"_5":14087,"_26889":51366,"_2862":51483},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_3376":1071,"_29554":1023,"_20528":51485,"_5":14087,"_26889":51370,"_2862":51486},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_3376":1072,"_29554":1023,"_20528":51488,"_5":14087,"_26889":51370,"_2862":51489},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_3376":1073,"_29554":1073,"_5":14445,"_2862":50808,"_29906":51491,"_20528":51492,"_26889":1073},[48148,49616,50627,50625,50808],[],{"_3376":1074,"_29554":1073,"_20528":51494,"_5":14087,"_26889":1073,"_2862":51495},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_3376":1075,"_29554":1073,"_5":29903,"_20528":51497,"_26889":51498,"_2862":51499},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_3376":1076,"_29554":1073,"_5":29903,"_20528":51501,"_26889":51502,"_2862":51503},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_3376":1077,"_29554":1073,"_5":29903,"_20528":51505,"_26889":51506,"_2862":51507},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_3376":1078,"_29554":1073,"_5":29903,"_20528":51509,"_26889":51510,"_2862":51511},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_3376":1079,"_29554":1073,"_20528":51513,"_5":14087,"_26889":1073,"_2862":51514},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_3376":1080,"_29554":1073,"_20528":51516,"_5":14087,"_26889":51498,"_2862":51517},[],"The administrator prepares the CA, issuance profile and DMS.",{"_3376":1081,"_29554":1073,"_20528":51519,"_5":14087,"_26889":51498,"_2862":51520},[],"The integrator installs initial EST server trust and an admission credential.",{"_3376":1082,"_29554":1073,"_20528":51522,"_5":14087,"_26889":51498,"_2862":51523},[],"The client requests an identity for its `Device ID` through EST.",{"_3376":1083,"_29554":1073,"_20528":51525,"_5":14087,"_26889":51498,"_2862":51526},[],"Certificate, device binding and key/certificate installation are checked.",{"_3376":1084,"_29554":1073,"_20528":51528,"_5":14087,"_26889":51498,"_2862":51529},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_3376":1085,"_29554":1073,"_20528":51531,"_5":14087,"_26889":51498,"_2862":51532},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_3376":1086,"_29554":1073,"_20528":51534,"_5":14087,"_26889":51502,"_2862":51535},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3376":1087,"_29554":1073,"_20528":51537,"_5":14087,"_26889":51502,"_2862":51538},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3376":1088,"_29554":1073,"_20528":51540,"_5":14087,"_26889":51502,"_2862":51541},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3376":1089,"_29554":1073,"_20528":51543,"_5":14087,"_26889":51502,"_2862":51544},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3376":1090,"_29554":1073,"_20528":51546,"_5":14087,"_26889":51506,"_2862":51547},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3376":1091,"_29554":1073,"_20528":51549,"_5":14087,"_26889":51506,"_2862":51550},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3376":1092,"_29554":1073,"_20528":51552,"_5":14087,"_26889":51506,"_2862":51553},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3376":1093,"_29554":1073,"_20528":51555,"_5":14087,"_26889":51506,"_2862":51556},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3376":1094,"_29554":1073,"_20528":51558,"_5":14087,"_26889":51510,"_2862":51559},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_3376":1095,"_29554":1073,"_20528":51561,"_5":14087,"_26889":51510,"_2862":51562},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_3376":1096,"_29554":1096,"_5":14445,"_2862":51564,"_29906":51565,"_20528":51566,"_26889":1096},"Provisioning strategies",[48148,49616,50627,50625,50808],[],{"_3376":1097,"_29554":1096,"_20528":51568,"_5":14087,"_26889":1096,"_2862":51569},[],"Choose device registration, identity authorization and key generation.",{"_3376":1098,"_29554":1096,"_5":29903,"_20528":51571,"_26889":51572,"_2862":51573},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_3376":1099,"_29554":1096,"_5":29903,"_20528":51575,"_26889":51576,"_2862":51577},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_3376":1100,"_29554":1096,"_5":29903,"_20528":51579,"_26889":51580,"_2862":51581},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_3376":1101,"_29554":1096,"_5":29903,"_20528":51583,"_26889":51584,"_2862":51585},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_3376":1102,"_29554":1096,"_5":29903,"_20528":51587,"_26889":51588,"_2862":51589},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_3376":1103,"_29554":1096,"_20528":51591,"_5":14087,"_26889":1096,"_2862":51592},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_3376":1104,"_29554":1096,"_20528":51594,"_5":14087,"_26889":51572,"_2862":51595},[],"Path",{"_3376":1105,"_29554":1096,"_20528":51597,"_5":14087,"_26889":51572,"_2862":51598},[],"When the device exists",{"_3376":1106,"_29554":1096,"_20528":51600,"_5":14087,"_26889":51572,"_2862":51601},[],"What to check",{"_3376":1107,"_29554":1096,"_20528":51603,"_5":14087,"_26889":51572,"_2862":51604},[],"Manual assignment",{"_3376":1108,"_29554":1096,"_20528":51606,"_5":14087,"_26889":51572,"_2862":51607},[],"An operator creates it before associating a certificate.",{"_3376":1109,"_29554":1096,"_20528":51609,"_5":14087,"_26889":51572,"_2862":51610},[],"ID, owning DMS, certificate CN and bound serial.",{"_3376":1110,"_29554":1096,"_20528":51612,"_5":14087,"_26889":51572,"_2862":51613},[],"EST with `JITP`",{"_3376":1111,"_29554":1096,"_20528":51615,"_5":14087,"_26889":51572,"_2862":51616},[],"Created for an unknown CN during `/simpleenroll`.",{"_3376":1112,"_29554":1096,"_20528":51618,"_5":14087,"_26889":51572,"_2862":51619},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_3376":1113,"_29554":1096,"_20528":51621,"_5":14087,"_26889":51572,"_2862":51622},[],"EST with `PRE_REGISTRATION`",{"_3376":1114,"_29554":1096,"_20528":51624,"_5":14087,"_26889":51572,"_2862":51625},[],"Must exist before `/simpleenroll`.",{"_3376":1115,"_29554":1096,"_20528":51627,"_5":14087,"_26889":51572,"_2862":51628},[],"Approved record, same DMS and replacement conditions for your version.",{"_3376":1116,"_29554":1096,"_20528":51630,"_5":14087,"_26889":51572,"_2862":51631},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_3376":1117,"_29554":1096,"_20528":51633,"_5":14087,"_26889":51572,"_2862":51634},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_3376":1118,"_29554":1096,"_20528":51636,"_5":14087,"_26889":51576,"_2862":51637},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_3376":1119,"_29554":1096,"_20528":51639,"_5":14087,"_26889":51576,"_2862":51640},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_3376":1120,"_29554":1096,"_20528":51642,"_5":14087,"_26889":51576,"_2862":51643},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_3376":1121,"_29554":1096,"_20528":51645,"_5":14087,"_26889":51580,"_2862":51646},[],"Decide initial enrollment and re-enrollment separately:",{"_3376":1122,"_29554":1096,"_20528":51648,"_5":14087,"_26889":51580,"_2862":51649},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_3376":1123,"_29554":1096,"_20528":51651,"_5":14087,"_26889":51580,"_2862":51652},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_3376":1124,"_29554":1096,"_20528":51654,"_5":14087,"_26889":51580,"_2862":51655},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_3376":1125,"_29554":1096,"_20528":51657,"_5":14087,"_26889":51580,"_2862":51658},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_3376":1126,"_29554":1096,"_20528":51660,"_5":14087,"_26889":51580,"_2862":51661},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_3376":1127,"_29554":1096,"_20528":51663,"_5":14087,"_26889":51584,"_2862":48532},[],{"_3376":1128,"_29554":1096,"_20528":51665,"_5":14087,"_26889":51584,"_2862":51666},[],"Material crossing EST",{"_3376":1129,"_29554":1096,"_20528":51668,"_5":14087,"_26889":51584,"_2862":51669},[],"Device-generated key",{"_3376":1130,"_29554":1096,"_20528":51671,"_5":14087,"_26889":51584,"_2862":51672},[],"Public CSR and certificate; the key stays on the client.",{"_3376":1131,"_29554":1096,"_20528":51674,"_5":14087,"_26889":51584,"_2862":51675},[],"Existing device key",{"_3376":1132,"_29554":1096,"_20528":51677,"_5":14087,"_26889":51584,"_2862":51678},[],"CSR signed with that key and a new certificate.",{"_3376":1133,"_29554":1096,"_20528":51680,"_5":14087,"_26889":51584,"_2862":50946},[],{"_3376":1134,"_29554":1096,"_20528":51682,"_5":14087,"_26889":51584,"_2862":51683},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_3376":1135,"_29554":1096,"_20528":51685,"_5":14087,"_26889":51584,"_2862":51686},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_3376":1136,"_29554":1096,"_20528":51688,"_5":14087,"_26889":51588,"_2862":51689},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_3376":1137,"_29554":1137,"_5":14445,"_2862":51691,"_29906":51692,"_20528":51693,"_26889":1137},"Renewal and recovery",[48148,49616,50627,50625,50808],[],{"_3376":1138,"_29554":1137,"_20528":51695,"_5":14087,"_26889":1137,"_2862":51696},[],"Renew without losing the identity and recover devices according to their actual state.",{"_3376":1139,"_29554":1137,"_5":29903,"_20528":51698,"_26889":51699,"_2862":51700},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_3376":1140,"_29554":1137,"_5":29903,"_20528":51702,"_26889":51703,"_2862":51704},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_3376":1141,"_29554":1137,"_5":29903,"_20528":51706,"_26889":51707,"_2862":51708},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_3376":1142,"_29554":1137,"_5":29903,"_20528":51710,"_26889":51711,"_2862":51712},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_3376":1143,"_29554":1137,"_5":29903,"_20528":51714,"_26889":51715,"_2862":51716},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_3376":1144,"_29554":1137,"_20528":51718,"_5":14087,"_26889":1137,"_2862":51719},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_3376":1145,"_29554":1137,"_20528":51721,"_5":14087,"_26889":51699,"_2862":51722},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_3376":1146,"_29554":1137,"_20528":51724,"_5":14087,"_26889":51699,"_2862":51725},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_3376":1147,"_29554":1137,"_20528":51727,"_5":14087,"_26889":51699,"_2862":51728},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_3376":1148,"_29554":1137,"_20528":51730,"_5":14087,"_26889":51699,"_2862":51731},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_3376":1149,"_29554":1137,"_20528":51733,"_5":14087,"_26889":51703,"_2862":51734},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_3376":1150,"_29554":1137,"_20528":51736,"_5":14087,"_26889":51703,"_2862":51737},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_3376":1151,"_29554":1137,"_20528":51739,"_5":14087,"_26889":51707,"_2862":51740},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_3376":1152,"_29554":1137,"_20528":51742,"_5":14087,"_26889":51707,"_2862":51743},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_3376":1153,"_29554":1137,"_20528":51745,"_5":14087,"_26889":51707,"_2862":51746},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_3376":1154,"_29554":1137,"_20528":51748,"_5":14087,"_26889":51711,"_2862":51749},[],"Situation",{"_3376":1155,"_29554":1137,"_20528":51751,"_5":14087,"_26889":51711,"_2862":51752},[],"Procedure",{"_3376":1156,"_29554":1137,"_20528":51754,"_5":14087,"_26889":51711,"_2862":51755},[],"Valid certificate, outside the window",{"_3376":1157,"_29554":1137,"_20528":51757,"_5":14087,"_26889":51711,"_2862":51758},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_3376":1158,"_29554":1137,"_20528":51760,"_5":14087,"_26889":51711,"_2862":51761},[],"Expired certificate, key available",{"_3376":1159,"_29554":1137,"_20528":51763,"_5":14087,"_26889":51711,"_2862":51764},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_3376":1160,"_29554":1137,"_20528":51766,"_5":14087,"_26889":51711,"_2862":51767},[],"Renewal through webhook or `NO_AUTH`",{"_3376":1161,"_29554":1137,"_20528":51769,"_5":14087,"_26889":51711,"_2862":51770},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_3376":1162,"_29554":1137,"_20528":51772,"_5":14087,"_26889":51711,"_2862":51773},[],"Lost or inaccessible key",{"_3376":1163,"_29554":1137,"_20528":51775,"_5":14087,"_26889":51711,"_2862":51776},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_3376":1164,"_29554":1137,"_20528":51778,"_5":14087,"_26889":51711,"_2862":51779},[],"Current identity revoked",{"_3376":1165,"_29554":1137,"_20528":51781,"_5":14087,"_26889":51711,"_2862":51782},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_3376":1166,"_29554":1137,"_20528":51784,"_5":14087,"_26889":51711,"_2862":51785},[],"Device without an identity",{"_3376":1167,"_29554":1137,"_20528":51787,"_5":14087,"_26889":51711,"_2862":51788},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_3376":1168,"_29554":1137,"_20528":51790,"_5":14087,"_26889":51711,"_2862":51791},[],"Retired device",{"_3376":1169,"_29554":1137,"_20528":51793,"_5":14087,"_26889":51711,"_2862":51794},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_3376":1170,"_29554":1137,"_20528":51796,"_5":14087,"_26889":51711,"_2862":51797},[],"Timeout, HTTP 500 or installation failure",{"_3376":1171,"_29554":1137,"_20528":51799,"_5":14087,"_26889":51711,"_2862":51800},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_3376":1172,"_29554":1137,"_20528":51802,"_5":14087,"_26889":51715,"_2862":51803},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_3376":1173,"_29554":1137,"_20528":51805,"_5":14087,"_26889":51715,"_2862":51806},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_3376":1174,"_29554":1174,"_5":14445,"_2862":51808,"_29906":51809,"_20528":51810,"_26889":1174},"Enrollment troubleshooting",[48148,49616,50627,50625,50808],[],{"_3376":1175,"_29554":1174,"_20528":51812,"_5":14087,"_26889":1174,"_2862":51813},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_3376":1176,"_29554":1174,"_5":29903,"_20528":51815,"_26889":51816,"_2862":51817},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_3376":1177,"_29554":1174,"_5":29903,"_20528":51819,"_26889":51820,"_2862":51821},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_3376":1178,"_29554":1174,"_5":29903,"_20528":51823,"_26889":51824,"_2862":51371},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_3376":1179,"_29554":1174,"_5":29903,"_20528":51826,"_26889":51827,"_2862":51828},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_3376":1180,"_29554":1174,"_20528":51830,"_5":14087,"_26889":1174,"_2862":51831},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_3376":1181,"_29554":1174,"_20528":51833,"_5":14087,"_26889":51820,"_2862":51834},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_3376":1182,"_29554":1174,"_20528":51836,"_5":14087,"_26889":51820,"_2862":51837},[],"Symptom or message",{"_3376":1183,"_29554":1174,"_20528":51839,"_5":14087,"_26889":51820,"_2862":51601},[],{"_3376":1184,"_29554":1174,"_20528":51841,"_5":14087,"_26889":51820,"_2862":51842},[],"curl rejects TLS, name or issuer",{"_3376":1185,"_29554":1174,"_20528":51844,"_5":14087,"_26889":51820,"_2862":51845},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_3376":1186,"_29554":1174,"_20528":51847,"_5":14087,"_26889":51820,"_2862":51848},[],"404 or missing APS",{"_3376":1187,"_29554":1174,"_20528":51850,"_5":14087,"_26889":51820,"_2862":51851},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_3376":1188,"_29554":1174,"_20528":51853,"_5":14087,"_26889":51820,"_2862":51854},[],"400, CSR or format error",{"_3376":1189,"_29554":1174,"_20528":51856,"_5":14087,"_26889":51820,"_2862":51857},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_3376":1190,"_29554":1174,"_20528":51859,"_5":14087,"_26889":51820,"_2862":51860},[],"Missing credential or invalid certificate",{"_3376":1191,"_29554":1174,"_20528":51862,"_5":14087,"_26889":51820,"_2862":51863},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_3376":1192,"_29554":1174,"_20528":51865,"_5":14087,"_26889":51820,"_2862":51866},[],"Webhook denies, times out or responds without authorization",{"_3376":1193,"_29554":1174,"_20528":51868,"_5":14087,"_26889":51820,"_2862":51869},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_3376":1194,"_29554":1174,"_20528":51871,"_5":14087,"_26889":51820,"_2862":51872},[],"`unexpected status code: <n>: redirects are not followed`",{"_3376":1195,"_29554":1174,"_20528":51874,"_5":14087,"_26889":51820,"_2862":51875},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_3376":1196,"_29554":1174,"_20528":51877,"_5":14087,"_26889":51820,"_2862":51878},[],"`webhook response exceeds 1048576 bytes`",{"_3376":1197,"_29554":1174,"_20528":51880,"_5":14087,"_26889":51820,"_2862":51881},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_3376":1198,"_29554":1174,"_20528":51883,"_5":14087,"_26889":51820,"_2862":51884},[],"`webhook config must not reference files`",{"_3376":1199,"_29554":1174,"_20528":51886,"_5":14087,"_26889":51820,"_2862":51887},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_3376":1200,"_29554":1174,"_20528":51889,"_5":14087,"_26889":51820,"_2862":51890},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_3376":1201,"_29554":1174,"_20528":51892,"_5":14087,"_26889":51820,"_2862":51893},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_3376":1202,"_29554":1174,"_20528":51895,"_5":14087,"_26889":51820,"_2862":51896},[],"`webhook mTLS certificate and key are invalid: …`",{"_3376":1203,"_29554":1174,"_20528":51898,"_5":14087,"_26889":51820,"_2862":51899},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_3376":1204,"_29554":1174,"_20528":51901,"_5":14087,"_26889":51820,"_2862":51902},[],"400 `struct validation error` creating or updating a DMS",{"_3376":1205,"_29554":1174,"_20528":51904,"_5":14087,"_26889":51820,"_2862":51905},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_3376":1206,"_29554":1174,"_20528":51907,"_5":14087,"_26889":51820,"_2862":51908},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_3376":1207,"_29554":1174,"_20528":51910,"_5":14087,"_26889":51820,"_2862":51911},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_3376":1208,"_29554":1174,"_20528":51913,"_5":14087,"_26889":51820,"_2862":51914},[],"`device not preregistered`",{"_3376":1209,"_29554":1174,"_20528":51916,"_5":14087,"_26889":51820,"_2862":51917},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_3376":1210,"_29554":1174,"_20528":51919,"_5":14087,"_26889":51820,"_2862":51920},[],"`forbiddenNewEnrollment`",{"_3376":1211,"_29554":1174,"_20528":51922,"_5":14087,"_26889":51820,"_2862":51923},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_3376":1212,"_29554":1174,"_20528":51925,"_5":14087,"_26889":51820,"_2862":51926},[],"Different owning DMS",{"_3376":1213,"_29554":1174,"_20528":51928,"_5":14087,"_26889":51820,"_2862":51929},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_3376":1214,"_29554":1174,"_20528":51931,"_5":14087,"_26889":51820,"_2862":51932},[],"`invalid RawSubject bytes`",{"_3376":1215,"_29554":1174,"_20528":51934,"_5":14087,"_26889":51820,"_2862":51935},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_3376":1216,"_29554":1174,"_20528":51937,"_5":14087,"_26889":51820,"_2862":51938},[],"`invalid reenroll window`",{"_3376":1217,"_29554":1174,"_20528":51940,"_5":14087,"_26889":51820,"_2862":51941},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_3376":1218,"_29554":1174,"_20528":51943,"_5":14087,"_26889":51820,"_2862":51944},[],"Current certificate revoked",{"_3376":1219,"_29554":1174,"_20528":51946,"_5":14087,"_26889":51820,"_2862":51947},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_3376":1220,"_29554":1174,"_20528":51949,"_5":14087,"_26889":51820,"_2862":51950},[],"CA, profile or signing error",{"_3376":1221,"_29554":1174,"_20528":51952,"_5":14087,"_26889":51820,"_2862":51953},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_3376":1222,"_29554":1174,"_20528":51955,"_5":14087,"_26889":51820,"_2862":51956},[],"HTTP 200 without a device connection",{"_3376":1223,"_29554":1174,"_20528":51958,"_5":14087,"_26889":51820,"_2862":51959},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_3376":1224,"_29554":1174,"_20528":51961,"_5":14087,"_26889":51820,"_2862":51962},[],"Timeout or error after issuance",{"_3376":1225,"_29554":1174,"_20528":51964,"_5":14087,"_26889":51820,"_2862":51965},[],"New certificates, current slot and previous identity's state before retrying.",{"_3376":1226,"_29554":1174,"_20528":51967,"_5":14087,"_26889":51824,"_2862":51968},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_3376":1227,"_29554":1174,"_20528":51970,"_5":14087,"_26889":51824,"_2862":51971},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_3376":1228,"_29554":1174,"_20528":51973,"_5":14087,"_26889":51827,"_2862":51974},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_3376":1229,"_29554":1174,"_20528":51976,"_5":14087,"_26889":51827,"_2862":51977},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_3376":1230,"_29554":1174,"_20528":51979,"_5":14087,"_26889":51827,"_2862":51980},[],"Verify the CSR locally and relate its CN to the inventory.",{"_3376":1231,"_29554":1174,"_20528":51982,"_5":14087,"_26889":51827,"_2862":51983},[],"Make one request, save headers/body and query the device and certificates.",{"_3376":1232,"_29554":1174,"_20528":51985,"_5":14087,"_26889":51827,"_2862":51986},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_3376":1233,"_29554":1174,"_20528":51988,"_5":14087,"_26889":51827,"_2862":51989},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_3376":1234,"_29554":1174,"_20528":51991,"_5":14087,"_26889":51827,"_2862":51992},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_3376":1235,"_29554":1235,"_5":14445,"_2862":51994,"_29906":51995,"_20528":51996,"_26889":1235},"Trust distribution and updates",[48148,49616,50627,50625,50808],[],{"_3376":1236,"_29554":1235,"_20528":51998,"_5":14087,"_26889":1235,"_2862":51999},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_3376":1237,"_29554":1235,"_5":29903,"_20528":52001,"_26889":52002,"_2862":52003},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_3376":1238,"_29554":1235,"_5":29903,"_20528":52005,"_26889":52006,"_2862":52007},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_3376":1239,"_29554":1235,"_5":29903,"_20528":52009,"_26889":52010,"_2862":52011},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_3376":1240,"_29554":1235,"_5":29903,"_20528":52013,"_26889":52014,"_2862":52015},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_3376":1241,"_29554":1235,"_5":29903,"_20528":52017,"_26889":52018,"_2862":52019},[],"/docs/pr-preview/pr-52/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_3376":1242,"_29554":1235,"_20528":52021,"_5":14087,"_26889":1235,"_2862":52022},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_3376":1243,"_29554":1235,"_20528":52024,"_5":14087,"_26889":52002,"_2862":52025},[],"Relationship",{"_3376":1244,"_29554":1235,"_20528":52027,"_5":14087,"_26889":52002,"_2862":52028},[],"Material prepared by its owner",{"_3376":1245,"_29554":1235,"_20528":52030,"_5":14087,"_26889":52002,"_2862":52031},[],"Device → EST server",{"_3376":1246,"_29554":1235,"_20528":52033,"_5":14087,"_26889":52002,"_2862":52034},[],"Previously verified server root, chain or pin and TLS name.",{"_3376":1247,"_29554":1235,"_20528":52036,"_5":14087,"_26889":52002,"_2862":52037},[],"DMS → requester",{"_3376":1248,"_29554":1235,"_20528":52039,"_5":14087,"_26889":52002,"_2862":52040},[],"CAs and rules authorizing initial or renewal credentials.",{"_3376":1249,"_29554":1235,"_20528":52042,"_5":14087,"_26889":52002,"_2862":52043},[],"Consumer → device",{"_3376":1250,"_29554":1235,"_20528":52045,"_5":14087,"_26889":52002,"_2862":52046},[],"Operational identity roots, intermediates, validation and permissions.",{"_3376":1251,"_29554":1235,"_20528":52048,"_5":14087,"_26889":52002,"_2862":52049},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_3376":1252,"_29554":1235,"_20528":52051,"_5":14087,"_26889":52006,"_2862":52052},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_3376":1253,"_29554":1235,"_20528":52054,"_5":14087,"_26889":52006,"_2862":52055},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_3376":1254,"_29554":1235,"_20528":52057,"_5":14087,"_26889":52010,"_2862":52058},[],"Keep initial EST server trust separate from identity consumer trust.",{"_3376":1255,"_29554":1235,"_20528":52060,"_5":14087,"_26889":52010,"_2862":52061},[],"Select policy-approved roots as anchors.",{"_3376":1256,"_29554":1235,"_20528":52063,"_5":14087,"_26889":52010,"_2862":52064},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_3376":1257,"_29554":1235,"_20528":52066,"_5":14087,"_26889":52010,"_2862":52067},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_3376":1258,"_29554":1235,"_20528":52069,"_5":14087,"_26889":52010,"_2862":52070},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_3376":1259,"_29554":1235,"_20528":52072,"_5":14087,"_26889":52010,"_2862":52073},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_3376":1260,"_29554":1235,"_20528":52075,"_5":14087,"_26889":52014,"_2862":52076},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_3376":1261,"_29554":1235,"_20528":52078,"_5":14087,"_26889":52014,"_2862":52079},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. That list is optional because the enrollment CA always validates re-enrollment credentials, but when switching the enrollment CA, add the previous issuance CA to it so old-CA identities keep re-enrolling during overlap. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_3376":1262,"_29554":1235,"_20528":52081,"_5":14087,"_26889":52014,"_2862":52082},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_3376":1263,"_29554":1235,"_20528":52084,"_5":14087,"_26889":52018,"_2862":52085},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_3376":1264,"_29554":1264,"_5":14445,"_2862":52087,"_29906":52088,"_20528":52090,"_26889":1264},"AWS IoT Core",[48148,49616,50627,50625,52089],"Integrations",[],{"_3376":1265,"_29554":1264,"_20528":52092,"_5":14087,"_26889":1264,"_2862":52093},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_3376":1266,"_29554":1264,"_5":29903,"_20528":52095,"_26889":52096,"_2862":52097},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_3376":1267,"_29554":1264,"_5":29903,"_20528":52099,"_26889":52100,"_2862":52101},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_3376":1268,"_29554":1264,"_5":29903,"_20528":52103,"_26889":52104,"_2862":52105},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_3376":1269,"_29554":1264,"_5":29903,"_20528":52107,"_26889":52108,"_2862":52109},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_3376":1270,"_29554":1264,"_5":29903,"_20528":52111,"_26889":52112,"_2862":52113},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#resource-state-machine","Resource state machine",{"_3376":1271,"_29554":1264,"_5":29903,"_20528":52115,"_26889":52116,"_2862":52117},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#events-the-connector-handles","Events the connector handles",{"_3376":1272,"_29554":1264,"_5":29903,"_20528":52119,"_26889":52120,"_2862":52121},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#ca-registration-states","CA registration states",{"_3376":1273,"_29554":1264,"_5":29903,"_20528":52123,"_26889":52124,"_2862":52125},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#dms-registration-mode-states","DMS registration-mode states",{"_3376":1274,"_29554":1264,"_5":29903,"_20528":52127,"_26889":52128,"_2862":52129},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#certificate-status-states","Certificate status states",{"_3376":1275,"_29554":1264,"_5":29903,"_20528":52131,"_26889":52132,"_2862":52133},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#thing-lifecycle","Thing lifecycle",{"_3376":1276,"_29554":1264,"_5":29903,"_20528":52135,"_26889":52136,"_2862":52137},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_3376":1277,"_29554":1264,"_5":29903,"_20528":52139,"_26889":52140,"_2862":52141},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_3376":1278,"_29554":1264,"_5":29903,"_20528":52143,"_26889":52144,"_2862":52145},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_3376":1279,"_29554":1264,"_5":29903,"_20528":52147,"_26889":52148,"_2862":52149},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3376":1280,"_29554":1264,"_5":29903,"_20528":52151,"_26889":52152,"_2862":52153},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_3376":1281,"_29554":1264,"_5":29903,"_20528":52155,"_26889":52156,"_2862":52157},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_3376":1282,"_29554":1264,"_5":29903,"_20528":52159,"_26889":52160,"_2862":52161},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_3376":1283,"_29554":1264,"_5":29903,"_20528":52163,"_26889":52164,"_2862":52165},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_3376":1284,"_29554":1264,"_5":29903,"_20528":52167,"_26889":52168,"_2862":52169},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_3376":1285,"_29554":1264,"_5":29903,"_20528":52171,"_26889":52172,"_2862":52173},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_3376":1286,"_29554":1264,"_5":29903,"_20528":52175,"_26889":52176,"_2862":52177},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_3376":1287,"_29554":1264,"_5":29903,"_20528":52179,"_26889":52180,"_2862":52181},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_3376":1288,"_29554":1264,"_5":29903,"_20528":52183,"_26889":52184,"_2862":52185},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_3376":1289,"_29554":1264,"_5":29903,"_20528":52187,"_26889":52188,"_2862":52189},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_3376":1290,"_29554":1264,"_5":29903,"_20528":52191,"_26889":52192,"_2862":52193},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_3376":1291,"_29554":1264,"_5":29903,"_20528":52195,"_26889":52196,"_2862":52197},[],"/docs/pr-preview/pr-52/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_3376":1292,"_29554":1264,"_20528":52199,"_5":14087,"_26889":1264,"_2862":52200},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_3376":1293,"_29554":1264,"_20528":52202,"_5":14087,"_26889":1264,"_2862":52203},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_3376":1294,"_29554":1264,"_20528":52205,"_5":14087,"_26889":1264,"_2862":52206},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_3376":1295,"_29554":1264,"_20528":52208,"_5":14087,"_26889":52096,"_2862":52209},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_3376":1296,"_29554":1264,"_20528":52211,"_5":14087,"_26889":52096,"_2862":52212},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_3376":1297,"_29554":1264,"_20528":52214,"_5":14087,"_26889":52096,"_2862":52215},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_3376":1298,"_29554":1264,"_20528":52217,"_5":14087,"_26889":52096,"_2862":52218},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_3376":1299,"_29554":1264,"_20528":52220,"_5":14087,"_26889":52100,"_2862":52221},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_3376":1300,"_29554":1264,"_20528":52223,"_5":14087,"_26889":52104,"_2862":52224},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_3376":1301,"_29554":1264,"_20528":52226,"_5":14087,"_26889":52104,"_2862":52227},[],"IAM action",{"_3376":1302,"_29554":1264,"_20528":52229,"_5":14087,"_26889":52104,"_2862":48538},[],{"_3376":1303,"_29554":1264,"_20528":52231,"_5":14087,"_26889":52104,"_2862":52232},[],"`iot:GetRegistrationCode`",{"_3376":1304,"_29554":1264,"_20528":52234,"_5":14087,"_26889":52104,"_2862":52235},[],"Obtain the verification code for CA registration in the Primary Account",{"_3376":1305,"_29554":1264,"_20528":52237,"_5":14087,"_26889":52104,"_2862":52238},[],"`iot:RegisterCACertificate`",{"_3376":1306,"_29554":1264,"_20528":52240,"_5":14087,"_26889":52104,"_2862":52241},[],"Register the CA in AWS IoT",{"_3376":1307,"_29554":1264,"_20528":52243,"_5":14087,"_26889":52104,"_2862":52244},[],"`iot:DescribeCACertificate`",{"_3376":1308,"_29554":1264,"_20528":52246,"_5":14087,"_26889":52104,"_2862":52247},[],"Check the CA registration status",{"_3376":1309,"_29554":1264,"_20528":52249,"_5":14087,"_26889":52104,"_2862":52250},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3376":1310,"_29554":1264,"_20528":52252,"_5":14087,"_26889":52104,"_2862":52253},[],"Create or update Things in IoT Core",{"_3376":1311,"_29554":1264,"_20528":52255,"_5":14087,"_26889":52104,"_2862":52256},[],"`iot:RegisterThing`",{"_3376":1312,"_29554":1264,"_20528":52258,"_5":14087,"_26889":52104,"_2862":52259},[],"Provision Things through a template",{"_3376":1313,"_29554":1264,"_20528":52261,"_5":14087,"_26889":52104,"_2862":52262},[],"`iot:RegisterCertificate`",{"_3376":1314,"_29554":1264,"_20528":52264,"_5":14087,"_26889":52104,"_2862":52265},[],"Register device certificates",{"_3376":1315,"_29554":1264,"_20528":52267,"_5":14087,"_26889":52104,"_2862":52268},[],"`iot:UpdateCertificate`",{"_3376":1316,"_29554":1264,"_20528":52270,"_5":14087,"_26889":52104,"_2862":52271},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_3376":1317,"_29554":1264,"_20528":52273,"_5":14087,"_26889":52104,"_2862":52274},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3376":1318,"_29554":1264,"_20528":52276,"_5":14087,"_26889":52104,"_2862":52277},[],"Create and attach IoT policies",{"_3376":1319,"_29554":1264,"_20528":52279,"_5":14087,"_26889":52104,"_2862":52280},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3376":1320,"_29554":1264,"_20528":52282,"_5":14087,"_26889":52104,"_2862":52283},[],"Manage Thing groups",{"_3376":1321,"_29554":1264,"_20528":52285,"_5":14087,"_26889":52104,"_2862":52286},[],"`iot:CreateProvisioningTemplate`",{"_3376":1322,"_29554":1264,"_20528":52288,"_5":14087,"_26889":52104,"_2862":52289},[],"Create JITP templates",{"_3376":1323,"_29554":1264,"_20528":52291,"_5":14087,"_26889":52104,"_2862":52292},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3376":1324,"_29554":1264,"_20528":52294,"_5":14087,"_26889":52104,"_2862":52295},[],"Read and write the Device Shadow",{"_3376":1325,"_29554":1264,"_20528":52297,"_5":14087,"_26889":52104,"_2862":52298},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_3376":1326,"_29554":1264,"_20528":52300,"_5":14087,"_26889":52108,"_2862":52301},[],"Parameter",{"_3376":1327,"_29554":1264,"_20528":52303,"_5":14087,"_26889":52108,"_2862":52304},[],"Type",{"_3376":1328,"_29554":1264,"_20528":52306,"_5":14087,"_26889":52108,"_2862":52307},[],"Required",{"_3376":1329,"_29554":1264,"_20528":52309,"_5":14087,"_26889":52108,"_2862":52310},[],"Description",{"_3376":1330,"_29554":1264,"_20528":52312,"_5":14087,"_26889":52108,"_2862":52313},[],"`connector_id`",{"_3376":1331,"_29554":1264,"_20528":52315,"_5":14087,"_26889":52108,"_2862":24527},[],{"_3376":1332,"_29554":1264,"_20528":52317,"_5":14087,"_26889":52108,"_2862":52318},[],"Yes",{"_3376":1333,"_29554":1264,"_20528":52320,"_5":14087,"_26889":52108,"_2862":52321},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_3376":1334,"_29554":1264,"_20528":52323,"_5":14087,"_26889":52108,"_2862":52324},[],"`aws_config.region`",{"_3376":1335,"_29554":1264,"_20528":52326,"_5":14087,"_26889":52108,"_2862":24527},[],{"_3376":1336,"_29554":1264,"_20528":52328,"_5":14087,"_26889":52108,"_2862":52318},[],{"_3376":1337,"_29554":1264,"_20528":52330,"_5":14087,"_26889":52108,"_2862":52331},[],"AWS region where the connector operates.",{"_3376":1338,"_29554":1264,"_20528":52333,"_5":14087,"_26889":52108,"_2862":52334},[],"`aws_config.auth_method`",{"_3376":1339,"_29554":1264,"_20528":52336,"_5":14087,"_26889":52108,"_2862":24527},[],{"_3376":1340,"_29554":1264,"_20528":52338,"_5":14087,"_26889":52108,"_2862":52318},[],{"_3376":1341,"_29554":1264,"_20528":52340,"_5":14087,"_26889":52108,"_2862":52341},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_3376":1342,"_29554":1264,"_20528":52343,"_5":14087,"_26889":52108,"_2862":52344},[],"`aws_config.access_key_id`",{"_3376":1343,"_29554":1264,"_20528":52346,"_5":14087,"_26889":52108,"_2862":24527},[],{"_3376":1344,"_29554":1264,"_20528":52348,"_5":14087,"_26889":52108,"_2862":52349},[],"Only with `auth_method=static`",{"_3376":1345,"_29554":1264,"_20528":52351,"_5":14087,"_26889":52108,"_2862":52352},[],"AWS access key.",{"_3376":1346,"_29554":1264,"_20528":52354,"_5":14087,"_26889":52108,"_2862":52355},[],"`aws_config.secret_access_key`",{"_3376":1347,"_29554":1264,"_20528":52357,"_5":14087,"_26889":52108,"_2862":24527},[],{"_3376":1348,"_29554":1264,"_20528":52359,"_5":14087,"_26889":52108,"_2862":52349},[],{"_3376":1349,"_29554":1264,"_20528":52361,"_5":14087,"_26889":52108,"_2862":52362},[],"AWS secret key.",{"_3376":1350,"_29554":1264,"_20528":52364,"_5":14087,"_26889":52108,"_2862":52365},[],"`aws_config.session_token`",{"_3376":1351,"_29554":1264,"_20528":52367,"_5":14087,"_26889":52108,"_2862":24527},[],{"_3376":1352,"_29554":1264,"_20528":52369,"_5":14087,"_26889":52108,"_2862":52370},[],"No",{"_3376":1353,"_29554":1264,"_20528":52372,"_5":14087,"_26889":52108,"_2862":52373},[],"Session token (with `auth_method=static`).",{"_3376":1354,"_29554":1264,"_20528":52375,"_5":14087,"_26889":52108,"_2862":52376},[],"`aws_config.role_arn`",{"_3376":1355,"_29554":1264,"_20528":52378,"_5":14087,"_26889":52108,"_2862":24527},[],{"_3376":1356,"_29554":1264,"_20528":52380,"_5":14087,"_26889":52108,"_2862":52381},[],"Only with `auth_method=role`",{"_3376":1357,"_29554":1264,"_20528":52383,"_5":14087,"_26889":52108,"_2862":52384},[],"ARN of the role to assume.",{"_3376":1358,"_29554":1264,"_20528":52386,"_5":14087,"_26889":52108,"_2862":52387},[],"`aws_config.endpoint_url`",{"_3376":1359,"_29554":1264,"_20528":52389,"_5":14087,"_26889":52108,"_2862":24527},[],{"_3376":1360,"_29554":1264,"_20528":52391,"_5":14087,"_26889":52108,"_2862":52370},[],{"_3376":1361,"_29554":1264,"_20528":52393,"_5":14087,"_26889":52108,"_2862":52394},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_3376":1362,"_29554":1264,"_20528":52396,"_5":14087,"_26889":52108,"_2862":52397},[],"`subscriber_event_bus`",{"_3376":1363,"_29554":1264,"_20528":52399,"_5":14087,"_26889":52108,"_2862":17284},[],{"_3376":1364,"_29554":1264,"_20528":52401,"_5":14087,"_26889":52108,"_2862":52318},[],{"_3376":1365,"_29554":1264,"_20528":52403,"_5":14087,"_26889":52108,"_2862":52404},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_3376":1366,"_29554":1264,"_20528":52406,"_5":14087,"_26889":52108,"_2862":52407},[],"`dms_manager_client`",{"_3376":1367,"_29554":1264,"_20528":52409,"_5":14087,"_26889":52108,"_2862":24527},[],{"_3376":1368,"_29554":1264,"_20528":52411,"_5":14087,"_26889":52108,"_2862":52318},[],{"_3376":1369,"_29554":1264,"_20528":52413,"_5":14087,"_26889":52108,"_2862":52414},[],"HTTP URL of Lamassu's DMS Manager service.",{"_3376":1370,"_29554":1264,"_20528":52416,"_5":14087,"_26889":52108,"_2862":52417},[],"`device_manager_client`",{"_3376":1371,"_29554":1264,"_20528":52419,"_5":14087,"_26889":52108,"_2862":24527},[],{"_3376":1372,"_29554":1264,"_20528":52421,"_5":14087,"_26889":52108,"_2862":52318},[],{"_3376":1373,"_29554":1264,"_20528":52423,"_5":14087,"_26889":52108,"_2862":52424},[],"HTTP URL of Lamassu's Device Manager.",{"_3376":1374,"_29554":1264,"_20528":52426,"_5":14087,"_26889":52108,"_2862":52427},[],"`ca_client`",{"_3376":1375,"_29554":1264,"_20528":52429,"_5":14087,"_26889":52108,"_2862":24527},[],{"_3376":1376,"_29554":1264,"_20528":52431,"_5":14087,"_26889":52108,"_2862":52318},[],{"_3376":1377,"_29554":1264,"_20528":52433,"_5":14087,"_26889":52108,"_2862":52434},[],"HTTP URL of Lamassu's CA service.",{"_3376":1378,"_29554":1264,"_20528":52436,"_5":14087,"_26889":52112,"_2862":52437},[],"The connector owns the AWS side of four resource types — CAs, DMS provisioning templates (JITP), device certificates and Things. This section maps the bus events the connector consumes to the AWS resources they touch and to the AWS calls each transition performs. AWS resources are referenced with the notation `IoTCore/<resource>`.",{"_3376":1379,"_29554":1264,"_20528":52439,"_5":14087,"_26889":52116,"_2862":52440},[],"The **CloudEvent type** column lists the event name on Lamassu's internal event bus; the **IAM actions** column lists the exact AWS SDK operations each flow invokes, so the required permissions can be derived directly from this table.",{"_3376":1380,"_29554":1264,"_20528":52442,"_5":14087,"_26889":52116,"_2862":52443},[],"CloudEvent type",{"_3376":1381,"_29554":1264,"_20528":52445,"_5":14087,"_26889":52116,"_2862":52446},[],"Lamassu resource",{"_3376":1382,"_29554":1264,"_20528":52448,"_5":14087,"_26889":52116,"_2862":52449},[],"AWS Resource",{"_3376":1383,"_29554":1264,"_20528":52451,"_5":14087,"_26889":52116,"_2862":52452},[],"IAM actions",{"_3376":1384,"_29554":1264,"_20528":52454,"_5":14087,"_26889":52116,"_2862":52455},[],"AWS calls and effect",{"_3376":1385,"_29554":1264,"_20528":52457,"_5":14087,"_26889":52116,"_2862":52458},[],"Where in this page",{"_3376":1386,"_29554":1264,"_20528":52460,"_5":14087,"_26889":52116,"_2862":52461},[],"`EventCreateCAKey` / `EventImportCAKey` / `EventUpdateCAMetadataKey`",{"_3376":1387,"_29554":1264,"_20528":52463,"_5":14087,"_26889":52116,"_2862":52464},[],"CA",{"_3376":1388,"_29554":1264,"_20528":52466,"_5":14087,"_26889":52116,"_2862":52467},[],"`IoTCore/CACertificate`",{"_3376":1389,"_29554":1264,"_20528":52469,"_5":14087,"_26889":52116,"_2862":52470},[],"`iot:GetRegistrationCode`, `iot:RegisterCACertificate`, `iot:DescribeCACertificate`, `iot:ListCACertificates`",{"_3376":1390,"_29554":1264,"_20528":52472,"_5":14087,"_26889":52116,"_2862":52473},[],"Loads the CA into connector state; a `registration.status = REQUESTED` write fires the registration flow (Primary with verification certificate, or SNI-only) and writes `SUCCEEDED` or `FAILED` back to the CA's metadata.",{"_3376":1391,"_29554":1264,"_20528":52475,"_5":14087,"_26889":52116,"_2862":52121},[],{"_3376":1392,"_29554":1264,"_20528":52477,"_5":14087,"_26889":52116,"_2862":52478},[],"`EventCreateDMSKey` / `EventUpdateDMSKey`",{"_3376":1393,"_29554":1264,"_20528":52480,"_5":14087,"_26889":52116,"_2862":52481},[],"DMS",{"_3376":1394,"_29554":1264,"_20528":52483,"_5":14087,"_26889":52116,"_2862":52484},[],"`IoTCore/ProvisioningTemplate`",{"_3376":1395,"_29554":1264,"_20528":52486,"_5":14087,"_26889":52116,"_2862":52487},[],"`iot:CreateProvisioningTemplate`, `iot:UpdateCACertificate`",{"_3376":1396,"_29554":1264,"_20528":52489,"_5":14087,"_26889":52116,"_2862":52490},[],"In `jitp` mode, attempts to create the provisioning template and attaches it to the registered CA. Non-idempotent: a `PUT /v1/dms/{id}` edit retries the creation and lands in `lamassu-dlq` after 3 retries. Idempotent for `none` and `auto` (configuration only).",{"_3376":1397,"_29554":1264,"_20528":52492,"_5":14087,"_26889":52116,"_2862":52125},[],{"_3376":1398,"_29554":1264,"_20528":52494,"_5":14087,"_26889":52116,"_2862":52495},[],"`EventBindDeviceIdentityKey`",{"_3376":1399,"_29554":1264,"_20528":52497,"_5":14087,"_26889":52116,"_2862":52498},[],"Device",{"_3376":1400,"_29554":1264,"_20528":52500,"_5":14087,"_26889":52116,"_2862":52501},[],"`IoTCore/Policy`, `IoTCore/ThingGroup`, `IoTCore/Thing`",{"_3376":1401,"_29554":1264,"_20528":52503,"_5":14087,"_26889":52116,"_2862":52504},[],"`iot:CreatePolicy` / `iot:DeletePolicyVersion`, `iot:GetPolicy` / `iot:ListPolicyVersions`, `iot:CreateThingGroup`, `iot:DescribeThing` / `iot:ListThingPrincipals`, `iot:RegisterThing`",{"_3376":1402,"_29554":1264,"_20528":52506,"_5":14087,"_26889":52116,"_2862":52507},[],"In `auto` mode: creates/updates policies, ensures Thing groups, revokes stale principals and provisions the Thing via `iot:RegisterThing`. In `jitp` mode: no AWS calls; AWS runs the JITP template on first connection.",{"_3376":1403,"_29554":1264,"_20528":52509,"_5":14087,"_26889":52116,"_2862":52133},[],{"_3376":1404,"_29554":1264,"_20528":52511,"_5":14087,"_26889":52116,"_2862":52512},[],"`EventUpdateCertificateStatusKey`",{"_3376":1405,"_29554":1264,"_20528":52514,"_5":14087,"_26889":52116,"_2862":52515},[],"Certificate",{"_3376":1406,"_29554":1264,"_20528":52517,"_5":14087,"_26889":52116,"_2862":52518},[],"`IoTCore/Certificate`",{"_3376":1407,"_29554":1264,"_20528":52520,"_5":14087,"_26889":52116,"_2862":52521},[],"`iot:UpdateCertificate`, `iot:Connect` (data plane)",{"_3376":1408,"_29554":1264,"_20528":52523,"_5":14087,"_26889":52116,"_2862":52524},[],"Maps status to AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), calls `iot:UpdateCertificate` and forces an MQTT disconnect on revoke.",{"_3376":1409,"_29554":1264,"_20528":52526,"_5":14087,"_26889":52116,"_2862":52129},[],{"_3376":1410,"_29554":1264,"_20528":52528,"_5":14087,"_26889":52116,"_2862":52529},[],"`EventUpdateCertificateMetadataKey` / `EventUpdateDeviceMetadataKey`",{"_3376":1411,"_29554":1264,"_20528":52531,"_5":14087,"_26889":52116,"_2862":52532},[],"Certificate / Device",{"_3376":1412,"_29554":1264,"_20528":52534,"_5":14087,"_26889":52116,"_2862":52535},[],"`IoTCore/Certificate`, `IoTCore/Thing`",{"_3376":1413,"_29554":1264,"_20528":52537,"_5":14087,"_26889":52116,"_2862":48544},[],{"_3376":1414,"_29554":1264,"_20528":52539,"_5":14087,"_26889":52116,"_2862":52540},[],"Refreshes internal state; the connector ignores events whose CloudEvent `source` matches its own URI to avoid self-triggered loops.",{"_3376":1415,"_29554":1264,"_20528":52542,"_5":14087,"_26889":52116,"_2862":52185},[],{"_3376":1416,"_29554":1264,"_20528":52544,"_5":14087,"_26889":52120,"_2862":52545},[],"The CA registration flow is driven by the `registration.status` field of the CA's connector metadata:",{"_3376":1417,"_29554":1264,"_20528":52547,"_5":14087,"_26889":52120,"_2862":52548},[],"by the `registration.status` field of the CA's connector metadata:",{"_3376":1418,"_29554":1264,"_20528":52550,"_5":14087,"_26889":52120,"_2862":52551},[],"Transition",{"_3376":1419,"_29554":1264,"_20528":52553,"_5":14087,"_26889":52120,"_2862":52554},[],"AWS calls",{"_3376":1420,"_29554":1264,"_20528":52556,"_5":14087,"_26889":52120,"_2862":52557},[],"`NotRegistered` → `Requested`",{"_3376":1421,"_29554":1264,"_20528":52559,"_5":14087,"_26889":52120,"_2862":52560},[],"none (metadata write only)",{"_3376":1422,"_29554":1264,"_20528":52562,"_5":14087,"_26889":52120,"_2862":52563},[],"`Requested` → `Registering`",{"_3376":1423,"_29554":1264,"_20528":52565,"_5":14087,"_26889":52120,"_2862":52566},[],"`iot:GetRegistrationCode` (Primary Account only)",{"_3376":1424,"_29554":1264,"_20528":52568,"_5":14087,"_26889":52120,"_2862":52569},[],"`Registering` → `Succeeded`",{"_3376":1425,"_29554":1264,"_20528":52571,"_5":14087,"_26889":52120,"_2862":52572},[],"`iot:RegisterCACertificate` (Primary: proof-of-possession with an ephemeral key; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3376":1426,"_29554":1264,"_20528":52574,"_5":14087,"_26889":52120,"_2862":52575},[],"`Registering` → `Failed`",{"_3376":1427,"_29554":1264,"_20528":52577,"_5":14087,"_26889":52120,"_2862":52578},[],"failed `iot:RegisterCACertificate`; the error detail is written to the CA's metadata",{"_3376":1428,"_29554":1264,"_20528":52580,"_5":14087,"_26889":52120,"_2862":52581},[],"`Failed` / `Succeeded` → `Requested`",{"_3376":1429,"_29554":1264,"_20528":52583,"_5":14087,"_26889":52120,"_2862":52584},[],"none (a new `REQUESTED` write re-runs the flow)",{"_3376":1430,"_29554":1264,"_20528":52586,"_5":14087,"_26889":52124,"_2862":52587},[],"The DMS's `registration_mode` determines what the connector does on the AWS side when the DMS is created or fully edited:",{"_3376":1431,"_29554":1264,"_20528":52589,"_5":14087,"_26889":52124,"_2862":52551},[],{"_3376":1432,"_29554":1264,"_20528":52591,"_5":14087,"_26889":52124,"_2862":52554},[],{"_3376":1433,"_29554":1264,"_20528":52593,"_5":14087,"_26889":52124,"_2862":52594},[],"`Unconfigured` → `None` / `Auto`",{"_3376":1434,"_29554":1264,"_20528":52596,"_5":14087,"_26889":52124,"_2862":52597},[],"none (configuration only)",{"_3376":1435,"_29554":1264,"_20528":52599,"_5":14087,"_26889":52124,"_2862":52600},[],"`None` ↔ `Auto`",{"_3376":1436,"_29554":1264,"_20528":52602,"_5":14087,"_26889":52124,"_2862":52597},[],{"_3376":1437,"_29554":1264,"_20528":52604,"_5":14087,"_26889":52124,"_2862":52605},[],"Any → `Jitp`",{"_3376":1438,"_29554":1264,"_20528":52607,"_5":14087,"_26889":52124,"_2862":52608},[],"`iot:CreateProvisioningTemplate` (non-idempotent: it fails when the template already exists; after 3 retries the event lands in `lamassu-dlq`)",{"_3376":1439,"_29554":1264,"_20528":52610,"_5":14087,"_26889":52124,"_2862":52611},[],"`Jitp` → `None` / `Auto`",{"_3376":1440,"_29554":1264,"_20528":52613,"_5":14087,"_26889":52124,"_2862":52614},[],"none (the template stays in the AWS account)",{"_3376":1441,"_29554":1264,"_20528":52616,"_5":14087,"_26889":52128,"_2862":52617},[],"Certificates holding the connector's metadata key sync their status; certificates provisioned via JITP have no metadata key and stay out of this machine:",{"_3376":1442,"_29554":1264,"_20528":52619,"_5":14087,"_26889":52128,"_2862":52551},[],{"_3376":1443,"_29554":1264,"_20528":52621,"_5":14087,"_26889":52128,"_2862":52554},[],{"_3376":1444,"_29554":1264,"_20528":52623,"_5":14087,"_26889":52128,"_2862":52624},[],"`NotSynced` → `Active`",{"_3376":1445,"_29554":1264,"_20528":52626,"_5":14087,"_26889":52128,"_2862":52268},[],{"_3376":1446,"_29554":1264,"_20528":52628,"_5":14087,"_26889":52128,"_2862":52629},[],"`Active` → `Inactive`",{"_3376":1447,"_29554":1264,"_20528":52631,"_5":14087,"_26889":52128,"_2862":52632},[],"`iot:UpdateCertificate` + forced MQTT disconnect",{"_3376":1448,"_29554":1264,"_20528":52634,"_5":14087,"_26889":52128,"_2862":52635},[],"`Active` → `Revoked`",{"_3376":1449,"_29554":1264,"_20528":52637,"_5":14087,"_26889":52128,"_2862":52632},[],{"_3376":1450,"_29554":1264,"_20528":52639,"_5":14087,"_26889":52128,"_2862":52640},[],"`Inactive` / `Revoked` → `Active`",{"_3376":1451,"_29554":1264,"_20528":52642,"_5":14087,"_26889":52128,"_2862":52268},[],{"_3376":1452,"_29554":1264,"_20528":52644,"_5":14087,"_26889":52128,"_2862":52645},[],"`RenewalWindow` / `AboutToExpire` / `Expired`",{"_3376":1453,"_29554":1264,"_20528":52647,"_5":14087,"_26889":52128,"_2862":52648},[],"none (these states are not synced to AWS)",{"_3376":1454,"_29554":1264,"_20528":52650,"_5":14087,"_26889":52132,"_2862":52651},[],"Things only exist under `auto` mode; in `jitp` mode AWS creates the Thing itself when the device first connects. The Thing name is always the device certificate's CN:",{"_3376":1455,"_29554":1264,"_20528":52653,"_5":14087,"_26889":52132,"_2862":52551},[],{"_3376":1456,"_29554":1264,"_20528":52655,"_5":14087,"_26889":52132,"_2862":52554},[],{"_3376":1457,"_29554":1264,"_20528":52657,"_5":14087,"_26889":52132,"_2862":52658},[],"`Absent` → `Provisioned`",{"_3376":1458,"_29554":1264,"_20528":52660,"_5":14087,"_26889":52132,"_2862":52661},[],"policies created/updated, Thing groups ensured, `iot:RegisterThing` (creates the Thing, registers the certificate, attaches policies)",{"_3376":1459,"_29554":1264,"_20528":52663,"_5":14087,"_26889":52132,"_2862":52664},[],"`Provisioned` → `Provisioned` (re-enrollment)",{"_3376":1460,"_29554":1264,"_20528":52666,"_5":14087,"_26889":52132,"_2862":52667},[],"stale principals marked `REVOKED`, new `iot:RegisterThing` run; the new certificate ARN replaces the old one in Lamassu metadata",{"_3376":1461,"_29554":1264,"_20528":52669,"_5":14087,"_26889":52132,"_2862":52670},[],"In `jitp` mode the connector makes no provisioning calls: AWS executes the JITP template on the device's first connection and creates the Thing, registers the certificate and activates it on its own.",{"_3376":1462,"_29554":1264,"_20528":52672,"_5":14087,"_26889":52136,"_2862":52673},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_3376":1463,"_29554":1264,"_20528":52675,"_5":14087,"_26889":52140,"_2862":52676},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_3376":1464,"_29554":1264,"_20528":52678,"_5":14087,"_26889":52140,"_2862":52679},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_3376":1465,"_29554":1264,"_20528":52681,"_5":14087,"_26889":52144,"_2862":52682},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_3376":1466,"_29554":1264,"_20528":52684,"_5":14087,"_26889":52144,"_2862":52685},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_3376":1467,"_29554":1264,"_20528":52687,"_5":14087,"_26889":52144,"_2862":52688},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_3376":1468,"_29554":1264,"_20528":52690,"_5":14087,"_26889":52144,"_2862":52691},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_3376":1469,"_29554":1264,"_20528":52693,"_5":14087,"_26889":52144,"_2862":52694},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_3376":1470,"_29554":1264,"_20528":52696,"_5":14087,"_26889":52144,"_2862":52697},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_3376":1471,"_29554":1264,"_20528":52699,"_5":14087,"_26889":52148,"_2862":52700},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_3376":1472,"_29554":1264,"_20528":52702,"_5":14087,"_26889":52152,"_2862":52703},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_3376":1473,"_29554":1264,"_20528":52705,"_5":14087,"_26889":52152,"_2862":52706},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_3376":1474,"_29554":1264,"_20528":52708,"_5":14087,"_26889":52156,"_2862":52709},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_3376":1475,"_29554":1264,"_20528":52711,"_5":14087,"_26889":52160,"_2862":52712},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_3376":1476,"_29554":1264,"_20528":52714,"_5":14087,"_26889":52160,"_2862":52715},[],"Creates or updates the IoT policies configured in the DMS.",{"_3376":1477,"_29554":1264,"_20528":52717,"_5":14087,"_26889":52160,"_2862":52718},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_3376":1478,"_29554":1264,"_20528":52720,"_5":14087,"_26889":52160,"_2862":52721},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_3376":1479,"_29554":1264,"_20528":52723,"_5":14087,"_26889":52160,"_2862":52724},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_3376":1480,"_29554":1264,"_20528":52726,"_5":14087,"_26889":52160,"_2862":52727},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_3376":1481,"_29554":1264,"_20528":52729,"_5":14087,"_26889":52160,"_2862":52730},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_3376":1482,"_29554":1264,"_20528":52732,"_5":14087,"_26889":52164,"_2862":52733},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. The connector attempts to create this template when the DMS is created and again on every full DMS edit (`PUT /v1/dms/{id}`) — not at device enrollment time. The attempt is not idempotent: when a template named after the DMS ID already exists, the creation call fails, the event is retried three times and finally lands in the `lamassu-dlq` poison queue (see Troubleshooting). The template is created once; later DMS edits never update its content. A DMS update that omits `metadata` or sends `null` keeps the stored metadata, so the connector key `lamassu.io/iot/{connector_id}` remains present and the attempt is still triggered. A body that supplies a `metadata` object replaces the stored metadata entirely: if that object does not carry the connector key, the key is dropped and the connector silently skips the DMS's future events. Once the template is attached, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_3376":1483,"_29554":1264,"_20528":52735,"_5":14087,"_26889":52164,"_2862":52736},[],"The connector creates the template, named after the DMS ID, only once. Each later edit of the DMS that keeps the connector key tries to create it again and fails, because the connector does not update existing templates. Later changes to `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` or to the groups and policies the template references must be applied by hand in AWS IoT Core.",{"_3376":1484,"_29554":1264,"_20528":52738,"_5":14087,"_26889":52164,"_2862":52739},[],"The failed event is retried and ends in `lamassu-dlq`. Groups and policies are registered before the failure, but the assignment of the template to the registered CA, the write-back of the ARN to the DMS and the shadow update when `ManagedCAs` changes are skipped.",{"_3376":1485,"_29554":1264,"_20528":52741,"_5":14087,"_26889":52164,"_2862":52742},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_3376":1486,"_29554":1264,"_20528":52744,"_5":14087,"_26889":52164,"_2862":52745},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_3376":1487,"_29554":1264,"_20528":52747,"_5":14087,"_26889":52168,"_2862":52748},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_3376":1488,"_29554":1264,"_20528":52750,"_5":14087,"_26889":52168,"_2862":52751},[],"The full flow from the device's perspective is:",{"_3376":1489,"_29554":1264,"_20528":52753,"_5":14087,"_26889":52168,"_2862":52754},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_3376":1490,"_29554":1264,"_20528":52756,"_5":14087,"_26889":52172,"_2862":52757},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_3376":1491,"_29554":1264,"_20528":52759,"_5":14087,"_26889":52172,"_2862":52760},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_3376":1492,"_29554":1264,"_20528":52762,"_5":14087,"_26889":52172,"_2862":52763},[],"For the JITP flow to work correctly:",{"_3376":1493,"_29554":1264,"_20528":52765,"_5":14087,"_26889":52172,"_2862":52766},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_3376":1494,"_29554":1264,"_20528":52768,"_5":14087,"_26889":52172,"_2862":52769},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_3376":1495,"_29554":1264,"_20528":52771,"_5":14087,"_26889":52172,"_2862":52772},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_3376":1496,"_29554":1264,"_20528":52774,"_5":14087,"_26889":52172,"_2862":52775},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_3376":1497,"_29554":1264,"_20528":52777,"_5":14087,"_26889":52176,"_2862":52778},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_3376":1498,"_29554":1264,"_20528":52780,"_5":14087,"_26889":52176,"_2862":52781},[],"Status in Lamassu",{"_3376":1499,"_29554":1264,"_20528":52783,"_5":14087,"_26889":52176,"_2862":52784},[],"Revocation reason",{"_3376":1500,"_29554":1264,"_20528":52786,"_5":14087,"_26889":52176,"_2862":52787},[],"Status in AWS IoT Core",{"_3376":1501,"_29554":1264,"_20528":52789,"_5":14087,"_26889":52176,"_2862":52790},[],"`Active`",{"_3376":1502,"_29554":1264,"_20528":52792,"_5":14087,"_26889":52176,"_2862":52793},[],"None",{"_3376":1503,"_29554":1264,"_20528":52795,"_5":14087,"_26889":52176,"_2862":52796},[],"`ACTIVE`",{"_3376":1504,"_29554":1264,"_20528":52798,"_5":14087,"_26889":52176,"_2862":52799},[],"`Revoked`",{"_3376":1505,"_29554":1264,"_20528":52801,"_5":14087,"_26889":52176,"_2862":52802},[],"`certificateHold`",{"_3376":1506,"_29554":1264,"_20528":52804,"_5":14087,"_26889":52176,"_2862":52805},[],"`INACTIVE`",{"_3376":1507,"_29554":1264,"_20528":52807,"_5":14087,"_26889":52176,"_2862":52799},[],{"_3376":1508,"_29554":1264,"_20528":52809,"_5":14087,"_26889":52176,"_2862":52810},[],"Any other reason",{"_3376":1509,"_29554":1264,"_20528":52812,"_5":14087,"_26889":52176,"_2862":52813},[],"`REVOKED`",{"_3376":1510,"_29554":1264,"_20528":52815,"_5":14087,"_26889":52176,"_2862":52816},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_3376":1511,"_29554":1264,"_20528":52818,"_5":14087,"_26889":52180,"_2862":52819},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_3376":1512,"_29554":1264,"_20528":52821,"_5":14087,"_26889":52180,"_2862":52822},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_3376":1513,"_29554":1264,"_20528":52824,"_5":14087,"_26889":52180,"_2862":52825},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_3376":1514,"_29554":1264,"_20528":52827,"_5":14087,"_26889":52184,"_2862":52828},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_3376":1515,"_29554":1264,"_20528":52830,"_5":14087,"_26889":52184,"_2862":52831},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_3376":1516,"_29554":1264,"_20528":52833,"_5":14087,"_26889":52188,"_2862":52834},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_3376":1517,"_29554":1264,"_20528":52836,"_5":14087,"_26889":52188,"_2862":52837},[],"There are two action types:",{"_3376":1518,"_29554":1264,"_20528":52839,"_5":14087,"_26889":52188,"_2862":52840},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_3376":1519,"_29554":1264,"_20528":52842,"_5":14087,"_26889":52188,"_2862":52843},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_3376":1520,"_29554":1264,"_20528":52845,"_5":14087,"_26889":52188,"_2862":52846},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_3376":1521,"_29554":1264,"_20528":52848,"_5":14087,"_26889":52192,"_2862":52849},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_3376":1522,"_29554":1264,"_20528":52851,"_5":14087,"_26889":52192,"_2862":52852},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_3376":1523,"_29554":1264,"_20528":52854,"_5":14087,"_26889":52192,"_2862":52855},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_3376":1524,"_29554":1264,"_20528":52857,"_5":14087,"_26889":52196,"_2862":52858},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_3376":1525,"_29554":1264,"_20528":52860,"_5":14087,"_26889":52196,"_2862":52861},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_3376":1526,"_29554":1264,"_20528":52863,"_5":14087,"_26889":52196,"_2862":52864},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_3376":1527,"_29554":1264,"_20528":52866,"_5":14087,"_26889":52196,"_2862":52867},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_3376":1528,"_29554":1264,"_20528":52869,"_5":14087,"_26889":52196,"_2862":52870},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_3376":1529,"_29554":1264,"_20528":52872,"_5":14087,"_26889":52196,"_2862":52873},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_3376":1530,"_29554":1264,"_20528":52875,"_5":14087,"_26889":52196,"_2862":52876},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_3376":1531,"_29554":1264,"_20528":52878,"_5":14087,"_26889":52196,"_2862":52879},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_3376":1532,"_29554":1264,"_20528":52881,"_5":14087,"_26889":52196,"_2862":52882},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_3376":1533,"_29554":1264,"_20528":52884,"_5":14087,"_26889":52196,"_2862":52885},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_3376":1534,"_29554":1264,"_20528":52887,"_5":14087,"_26889":52196,"_2862":52888},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_3376":1535,"_29554":1264,"_20528":52890,"_5":14087,"_26889":52196,"_2862":52891},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_3376":1536,"_29554":1264,"_20528":52893,"_5":14087,"_26889":52196,"_2862":52894},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_3376":1537,"_29554":1264,"_20528":52896,"_5":14087,"_26889":52196,"_2862":52897},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_3376":1538,"_29554":1264,"_20528":52899,"_5":14087,"_26889":52196,"_2862":52900},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_3376":1539,"_29554":1264,"_20528":52902,"_5":14087,"_26889":52196,"_2862":52903},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_3376":1540,"_29554":1264,"_20528":52905,"_5":14087,"_26889":52196,"_2862":52906},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_3376":1541,"_29554":1264,"_20528":52908,"_5":14087,"_26889":52196,"_2862":52909},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_3376":1542,"_29554":1264,"_20528":52911,"_5":14087,"_26889":52196,"_2862":52912},[],"**Symptom:** After editing a DMS in `jitp` mode, DMS update messages appear in `lamassu-dlq`, or JITP configuration changes have no effect in AWS.",{"_3376":1543,"_29554":1264,"_20528":52914,"_5":14087,"_26889":52196,"_2862":52915},[],"**Cause:** Every full DMS edit (`PUT /v1/dms/{id}`) triggers a `CreateProvisioningTemplate` attempt for the template named after the DMS ID, and the call is not idempotent: when the template already exists, it fails, the event is retried three times and finally lands in `lamassu-dlq`. The connector’s later steps are skipped.",{"_3376":1544,"_29554":1264,"_20528":52917,"_5":14087,"_26889":52196,"_2862":52918},[],"**Resolution:** Check that the template named with the DMS ID exists in AWS IoT Core and that JITP enrollment works. If the JITP configuration was changed, apply it by hand to the AWS template.",{"_3376":1545,"_29554":1264,"_20528":52920,"_5":14087,"_26889":52196,"_2862":52921},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3376":1546,"_29554":1264,"_20528":52923,"_5":14087,"_26889":52196,"_2862":52924},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3376":1547,"_29554":1264,"_20528":52926,"_5":14087,"_26889":52196,"_2862":52927},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_3376":1548,"_29554":1548,"_5":14445,"_2862":50627,"_29906":52929,"_20528":52930,"_26889":1548},[48148,49616,50627],[],{"_3376":1549,"_29554":1548,"_20528":52932,"_5":14087,"_26889":1548,"_2862":52933},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_3376":1550,"_29554":1548,"_5":29903,"_20528":52935,"_26889":52936,"_2862":52937},[],"/docs/pr-preview/pr-52/platform/iot-fleets/overview#start-here","Start here",{"_3376":1551,"_29554":1548,"_5":29903,"_20528":52939,"_26889":52940,"_2862":50625},[],"/docs/pr-preview/pr-52/platform/iot-fleets/overview#devices-and-identities",{"_3376":1552,"_29554":1548,"_5":29903,"_20528":52942,"_26889":52943,"_2862":50808},[],"/docs/pr-preview/pr-52/platform/iot-fleets/overview#enrollment-with-pki",{"_3376":1553,"_29554":1548,"_5":29903,"_20528":52945,"_26889":52946,"_2862":52089},[],"/docs/pr-preview/pr-52/platform/iot-fleets/overview#integrations",{"_3376":1554,"_29554":1548,"_5":29903,"_20528":52948,"_26889":52949,"_2862":52950},[],"/docs/pr-preview/pr-52/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_3376":1555,"_29554":1548,"_20528":52952,"_5":14087,"_26889":1548,"_2862":52953},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_3376":1556,"_29554":1548,"_20528":52955,"_5":14087,"_26889":52936,"_2862":52956},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_3376":1557,"_29554":1548,"_20528":52958,"_5":14087,"_26889":52936,"_2862":52959},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_3376":1558,"_29554":1548,"_20528":52961,"_5":14087,"_26889":52940,"_2862":52962},[],"Resource",{"_3376":1559,"_29554":1548,"_20528":52964,"_5":14087,"_26889":52940,"_2862":52965},[],"What it represents",{"_3376":1560,"_29554":1548,"_20528":52967,"_5":14087,"_26889":52940,"_2862":52968},[],"**Device**",{"_3376":1561,"_29554":1548,"_20528":52970,"_5":14087,"_26889":52940,"_2862":52971},[],"An inventory entry with an identifier, owning DMS and classification.",{"_3376":1562,"_29554":1548,"_20528":52973,"_5":14087,"_26889":52940,"_2862":52974},[],"**Identity**",{"_3376":1563,"_29554":1548,"_20528":52976,"_5":14087,"_26889":52940,"_2862":52977},[],"The device's association with its certificates: an active version and a history.",{"_3376":1564,"_29554":1548,"_20528":52979,"_5":14087,"_26889":52940,"_2862":52980},[],"**DMS**",{"_3376":1565,"_29554":1548,"_20528":52982,"_5":14087,"_26889":52940,"_2862":52983},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_3376":1566,"_29554":1548,"_20528":52985,"_5":14087,"_26889":52940,"_2862":52986},[],"**Fleet**",{"_3376":1567,"_29554":1548,"_20528":52988,"_5":14087,"_26889":52940,"_2862":52989},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_3376":1568,"_29554":1548,"_20528":52991,"_5":14087,"_26889":52940,"_2862":52992},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_3376":1569,"_29554":1548,"_20528":52994,"_5":14087,"_26889":52940,"_2862":52995},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_3376":1570,"_29554":1548,"_20528":52997,"_5":14087,"_26889":52943,"_2862":52998},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_3376":1571,"_29554":1548,"_20528":53000,"_5":14087,"_26889":52943,"_2862":53001},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_3376":1572,"_29554":1548,"_20528":53003,"_5":14087,"_26889":52943,"_2862":53004},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_3376":1573,"_29554":1548,"_20528":53006,"_5":14087,"_26889":52943,"_2862":53007},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_3376":1574,"_29554":1548,"_20528":53009,"_5":14087,"_26889":52943,"_2862":53010},[],"**Result:** request the certificate, install it and check its association with the device.",{"_3376":1575,"_29554":1548,"_20528":53012,"_5":14087,"_26889":52943,"_2862":53013},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_3376":1576,"_29554":1548,"_20528":53015,"_5":14087,"_26889":52943,"_2862":53016},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3376":1577,"_29554":1548,"_20528":53018,"_5":14087,"_26889":52943,"_2862":53019},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3376":1578,"_29554":1548,"_20528":53021,"_5":14087,"_26889":52946,"_2862":53022},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_3376":1579,"_29554":1548,"_20528":53024,"_5":14087,"_26889":52946,"_2862":53025},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_3376":1580,"_29554":1548,"_20528":53027,"_5":14087,"_26889":52949,"_2862":53028},[],"Participant",{"_3376":1581,"_29554":1548,"_20528":53030,"_5":14087,"_26889":52949,"_2862":53031},[],"Responsibility",{"_3376":1582,"_29554":1548,"_20528":53033,"_5":14087,"_26889":52949,"_2862":53034},[],"PKI administrator",{"_3376":1583,"_29554":1548,"_20528":53036,"_5":14087,"_26889":52949,"_2862":53037},[],"CA, issuance profile, chain and revocation publication.",{"_3376":1584,"_29554":1548,"_20528":53039,"_5":14087,"_26889":52949,"_2862":53040},[],"Provisioning administrator",{"_3376":1585,"_29554":1548,"_20528":53042,"_5":14087,"_26889":52949,"_2862":53043},[],"DMS, admission, authentication per operation and inventory.",{"_3376":1586,"_29554":1548,"_20528":53045,"_5":14087,"_26889":52949,"_2862":53046},[],"Device integrator",{"_3376":1587,"_29554":1548,"_20528":53048,"_5":14087,"_26889":52949,"_2862":53049},[],"Initial credential, key, EST client, trust and certificate installation.",{"_3376":1588,"_29554":1548,"_20528":53051,"_5":14087,"_26889":52949,"_2862":53052},[],"Consumer integrator",{"_3376":1589,"_29554":1548,"_20528":53054,"_5":14087,"_26889":52949,"_2862":53055},[],"Trusted issuers, validation and device permissions in the destination.",{"_3376":1590,"_29554":1548,"_20528":53057,"_5":14087,"_26889":52949,"_2862":53058},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_3376":1591,"_29554":1591,"_5":14445,"_2862":53060,"_29906":53061,"_20528":53063,"_26889":1591},"Enroll and connect your first device",[48148,49616,50627,53062],"Getting started",[],{"_3376":1592,"_29554":1591,"_20528":53065,"_5":14087,"_26889":1591,"_2862":53066},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_3376":1593,"_29554":1591,"_5":29903,"_20528":53068,"_26889":53069,"_2862":48158},[],"/docs/pr-preview/pr-52/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_3376":1594,"_29554":1591,"_5":29903,"_20528":53071,"_26889":53072,"_2862":53073},[],"/docs/pr-preview/pr-52/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_3376":1595,"_29554":1591,"_5":29903,"_20528":53075,"_26889":53076,"_2862":53077},[],"/docs/pr-preview/pr-52/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_3376":1596,"_29554":1591,"_5":29903,"_20528":53079,"_26889":53080,"_2862":53081},[],"/docs/pr-preview/pr-52/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_3376":1597,"_29554":1591,"_5":29903,"_20528":53083,"_26889":53084,"_2862":53085},[],"/docs/pr-preview/pr-52/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_3376":1598,"_29554":1591,"_5":29903,"_20528":53087,"_26889":53088,"_2862":53089},[],"/docs/pr-preview/pr-52/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_3376":1599,"_29554":1591,"_5":29903,"_20528":53091,"_26889":53092,"_2862":53093},[],"/docs/pr-preview/pr-52/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_3376":1600,"_29554":1591,"_5":29903,"_20528":53095,"_26889":53096,"_2862":53097},[],"/docs/pr-preview/pr-52/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_3376":1601,"_29554":1591,"_20528":53099,"_5":14087,"_26889":1591,"_2862":53100},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_3376":1602,"_29554":1591,"_20528":53102,"_5":14087,"_26889":53069,"_2862":53103},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_3376":1603,"_29554":1591,"_20528":53105,"_5":14087,"_26889":53069,"_2862":53106},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_3376":1604,"_29554":1591,"_20528":53108,"_5":14087,"_26889":53069,"_2862":53109},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_3376":1605,"_29554":1591,"_20528":53111,"_5":14087,"_26889":53069,"_2862":53112},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_3376":1606,"_29554":1591,"_20528":53114,"_5":14087,"_26889":53069,"_2862":53115},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_3376":1607,"_29554":1591,"_20528":53117,"_5":14087,"_26889":53072,"_2862":53118},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_3376":1608,"_29554":1591,"_20528":53120,"_5":14087,"_26889":53072,"_2862":53121},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_3376":1609,"_29554":1591,"_20528":53123,"_5":14087,"_26889":53076,"_2862":53124},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_3376":1610,"_29554":1591,"_20528":53126,"_5":14087,"_26889":53076,"_2862":53127},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_3376":1611,"_29554":1591,"_20528":53129,"_5":14087,"_26889":53076,"_2862":53130},[],"Setting",{"_3376":1612,"_29554":1591,"_20528":53132,"_5":14087,"_26889":53076,"_2862":53133},[],"Evaluation value",{"_3376":1613,"_29554":1591,"_20528":53135,"_5":14087,"_26889":53076,"_2862":53136},[],"Enrollment CA",{"_3376":1614,"_29554":1591,"_20528":53138,"_5":14087,"_26889":53076,"_2862":53139},[],"Issuing root from `device-root.pem`.",{"_3376":1615,"_29554":1591,"_20528":53141,"_5":14087,"_26889":53076,"_2862":50938},[],{"_3376":1616,"_29554":1591,"_20528":53143,"_5":14087,"_26889":53076,"_2862":53144},[],"The 1-hour leaf profile you just prepared.",{"_3376":1617,"_29554":1591,"_20528":53146,"_5":14087,"_26889":53076,"_2862":53147},[],"Protocol / Registration Mode",{"_3376":1618,"_29554":1591,"_20528":53149,"_5":14087,"_26889":53076,"_2862":53150},[],"`EST_RFC7030` / `JITP`.",{"_3376":1619,"_29554":1591,"_20528":53152,"_5":14087,"_26889":53076,"_2862":53153},[],"Verify CSR Signature",{"_3376":1620,"_29554":1591,"_20528":53155,"_5":14087,"_26889":53076,"_2862":53156},[],"Enabled.",{"_3376":1621,"_29554":1591,"_20528":53158,"_5":14087,"_26889":53076,"_2862":53159},[],"Enable Replaceable Enrollment",{"_3376":1622,"_29554":1591,"_20528":53161,"_5":14087,"_26889":53076,"_2862":53162},[],"Disabled; the ID must be new.",{"_3376":1623,"_29554":1591,"_20528":53164,"_5":14087,"_26889":53076,"_2862":53165},[],"Initial authentication",{"_3376":1624,"_29554":1591,"_20528":53167,"_5":14087,"_26889":53076,"_2862":53168},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_3376":1625,"_29554":1591,"_20528":53170,"_5":14087,"_26889":53076,"_2862":53171},[],"Renewal authentication",{"_3376":1626,"_29554":1591,"_20528":53173,"_5":14087,"_26889":53076,"_2862":53174},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_3376":1627,"_29554":1591,"_20528":53176,"_5":14087,"_26889":53076,"_2862":53177},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_3376":1628,"_29554":1591,"_20528":53179,"_5":14087,"_26889":53076,"_2862":53180},[],"Not needed for this direct issuance; the Enrollment CA is always trusted for re-enrollment / disabled.",{"_3376":1629,"_29554":1591,"_20528":53182,"_5":14087,"_26889":53076,"_2862":53183},[],"Re-enrollment Delta",{"_3376":1630,"_29554":1591,"_20528":53185,"_5":14087,"_26889":53076,"_2862":53186},[],"1 hour.",{"_3376":1631,"_29554":1591,"_20528":53188,"_5":14087,"_26889":53076,"_2862":53189},[],"Preventive / Critical Delta",{"_3376":1632,"_29554":1591,"_20528":53191,"_5":14087,"_26889":53076,"_2862":53192},[],"30 minutes / 10 minutes.",{"_3376":1633,"_29554":1591,"_20528":53194,"_5":14087,"_26889":53076,"_2862":53195},[],"Revoke on Re-enrollment",{"_3376":1634,"_29554":1591,"_20528":53197,"_5":14087,"_26889":53076,"_2862":53198},[],"Disabled to test the successor before retiring the previous identity.",{"_3376":1635,"_29554":1591,"_20528":53200,"_5":14087,"_26889":53076,"_2862":50946},[],{"_3376":1636,"_29554":1591,"_20528":53202,"_5":14087,"_26889":53076,"_2862":53203},[],"Disabled; the operational key is generated in the client.",{"_3376":1637,"_29554":1591,"_20528":53205,"_5":14087,"_26889":53076,"_2862":53206},[],"CA Distribution",{"_3376":1638,"_29554":1591,"_20528":53208,"_5":14087,"_26889":53076,"_2862":53209},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_3376":1639,"_29554":1591,"_20528":53211,"_5":14087,"_26889":53076,"_2862":53212},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. The console exposes independent editors for the enrollment and re-enrollment authentication; the DMS guide describes their fields, and you can also check the resource through the DMS API.",{"_3376":1640,"_29554":1591,"_20528":53214,"_5":14087,"_26889":53080,"_2862":53215},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_3376":1641,"_29554":1591,"_20528":53217,"_5":14087,"_26889":53080,"_2862":53218},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_3376":1642,"_29554":1591,"_20528":53220,"_5":14087,"_26889":53084,"_2862":53221},[],"Generate a new key and CSR with the selected identifier:",{"_3376":1643,"_29554":1591,"_20528":53223,"_5":14087,"_26889":53084,"_2862":53224},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_3376":1644,"_29554":1591,"_20528":53226,"_5":14087,"_26889":53084,"_2862":53227},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_3376":1645,"_29554":1591,"_20528":53229,"_5":14087,"_26889":53088,"_2862":53230},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_3376":1646,"_29554":1591,"_20528":53232,"_5":14087,"_26889":53088,"_2862":53233},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_3376":1647,"_29554":1591,"_20528":53235,"_5":14087,"_26889":53092,"_2862":53236},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_3376":1648,"_29554":1591,"_20528":53238,"_5":14087,"_26889":53092,"_2862":53239},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_3376":1649,"_29554":1591,"_20528":53241,"_5":14087,"_26889":53092,"_2862":53242},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_3376":1650,"_29554":1591,"_20528":53244,"_5":14087,"_26889":53092,"_2862":53245},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_3376":1651,"_29554":1591,"_20528":53247,"_5":14087,"_26889":53092,"_2862":53248},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_3376":1652,"_29554":1591,"_20528":53250,"_5":14087,"_26889":53096,"_2862":53251},[],"Check",{"_3376":1653,"_29554":1591,"_20528":53253,"_5":14087,"_26889":53096,"_2862":53254},[],"Expected result",{"_3376":1654,"_29554":1591,"_20528":53256,"_5":14087,"_26889":53096,"_2862":53257},[],"Registration",{"_3376":1655,"_29554":1591,"_20528":53259,"_5":14087,"_26889":53096,"_2862":53260},[],"ID created automatically and correct DMS.",{"_3376":1656,"_29554":1591,"_20528":53262,"_5":14087,"_26889":53096,"_2862":52515},[],{"_3376":1657,"_29554":1591,"_20528":53264,"_5":14087,"_26889":53096,"_2862":53265},[],"CN, profile, serial and key verified.",{"_3376":1658,"_29554":1591,"_20528":53267,"_5":14087,"_26889":53096,"_2862":53268},[],"Inventory",{"_3376":1659,"_29554":1591,"_20528":53270,"_5":14087,"_26889":53096,"_2862":53271},[],"Received serial visible as the current identity and in history.",{"_3376":1660,"_29554":1591,"_20528":53273,"_5":14087,"_26889":53096,"_2862":53274},[],"Consumer",{"_3376":1661,"_29554":1591,"_20528":53276,"_5":14087,"_26889":53096,"_2862":53277},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_3376":1662,"_29554":1591,"_20528":53279,"_5":14087,"_26889":53096,"_2862":53280},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_3376":1663,"_29554":1591,"_20528":53282,"_5":14087,"_26889":53096,"_2862":53283},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_3376":1664,"_29554":1664,"_5":14445,"_2862":50643,"_29906":53285,"_20528":53286,"_26889":1664},[48148,49616,50627,53062],[],{"_3376":1665,"_29554":1664,"_20528":53288,"_5":14087,"_26889":1664,"_2862":53289},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_3376":1666,"_29554":1664,"_5":29903,"_20528":53291,"_26889":53292,"_2862":48158},[],"/docs/pr-preview/pr-52/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_3376":1667,"_29554":1664,"_5":29903,"_20528":53294,"_26889":53295,"_2862":53296},[],"/docs/pr-preview/pr-52/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_3376":1668,"_29554":1664,"_5":29903,"_20528":53298,"_26889":53299,"_2862":53300},[],"/docs/pr-preview/pr-52/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_3376":1669,"_29554":1664,"_5":29903,"_20528":53302,"_26889":53303,"_2862":53304},[],"/docs/pr-preview/pr-52/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_3376":1670,"_29554":1664,"_5":29903,"_20528":53306,"_26889":53307,"_2862":53308},[],"/docs/pr-preview/pr-52/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_3376":1671,"_29554":1664,"_5":29903,"_20528":53310,"_26889":53311,"_2862":53312},[],"/docs/pr-preview/pr-52/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_3376":1672,"_29554":1664,"_5":29903,"_20528":53314,"_26889":53315,"_2862":53254},[],"/docs/pr-preview/pr-52/platform/iot-fleets/quickstarts/register-device#expected-result",{"_3376":1673,"_29554":1664,"_5":29903,"_20528":53317,"_26889":53318,"_2862":53319},[],"/docs/pr-preview/pr-52/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_3376":1674,"_29554":1664,"_5":29903,"_20528":53321,"_26889":53322,"_2862":53323},[],"/docs/pr-preview/pr-52/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_3376":1675,"_29554":1664,"_20528":53325,"_5":14087,"_26889":1664,"_2862":53326},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_3376":1676,"_29554":1664,"_20528":53328,"_5":14087,"_26889":1664,"_2862":53329},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_3376":1677,"_29554":1664,"_20528":53331,"_5":14087,"_26889":53292,"_2862":53332},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_3376":1678,"_29554":1664,"_20528":53334,"_5":14087,"_26889":53292,"_2862":53335},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_3376":1679,"_29554":1664,"_20528":53337,"_5":14087,"_26889":53292,"_2862":53338},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_3376":1680,"_29554":1664,"_20528":53340,"_5":14087,"_26889":53292,"_2862":53341},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_3376":1681,"_29554":1664,"_20528":53343,"_5":14087,"_26889":53295,"_2862":53344},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_3376":1682,"_29554":1664,"_20528":53346,"_5":14087,"_26889":53295,"_2862":53347},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_3376":1683,"_29554":1664,"_20528":53349,"_5":14087,"_26889":53295,"_2862":53350},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_3376":1684,"_29554":1664,"_20528":53352,"_5":14087,"_26889":53295,"_2862":53353},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_3376":1685,"_29554":1664,"_20528":53355,"_5":14087,"_26889":53295,"_2862":53356},[],"In the authentication section, enable **Require client certificate** and leave **Call external webhook** off. Under **Require client certificate**, add the CA whose initial certificates you will accept to **Validation CAs**; for this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and leave **Enable server-side key generation** off if you will not use it.",{"_3376":1686,"_29554":1664,"_20528":53358,"_5":14087,"_26889":53295,"_2862":53359},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_3376":1687,"_29554":1664,"_20528":53361,"_5":14087,"_26889":53295,"_2862":53362},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_3376":1688,"_29554":1664,"_20528":53364,"_5":14087,"_26889":53295,"_2862":53365},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_3376":1689,"_29554":1664,"_20528":53367,"_5":14087,"_26889":53299,"_2862":53368},[],"Open **Managed Devices** and the registration action. Complete:",{"_3376":1690,"_29554":1664,"_20528":53370,"_5":14087,"_26889":53299,"_2862":53371},[],"**Device ID**: `device-001`.",{"_3376":1691,"_29554":1664,"_20528":53373,"_5":14087,"_26889":53299,"_2862":53374},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_3376":1692,"_29554":1664,"_20528":53376,"_5":14087,"_26889":53299,"_2862":53377},[],"**Icon** and **Tags**: optional classification.",{"_3376":1693,"_29554":1664,"_20528":53379,"_5":14087,"_26889":53299,"_2862":53380},[],"Confirm registration.",{"_3376":1694,"_29554":1664,"_20528":53382,"_5":14087,"_26889":53303,"_2862":53383},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_3376":1695,"_29554":1664,"_20528":53385,"_5":14087,"_26889":53303,"_2862":53386},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_3376":1696,"_29554":1664,"_20528":53388,"_5":14087,"_26889":53307,"_2862":53389},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_3376":1697,"_29554":1664,"_20528":53391,"_5":14087,"_26889":53307,"_2862":53392},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_3376":1698,"_29554":1664,"_20528":53394,"_5":14087,"_26889":53311,"_2862":53395},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_3376":1699,"_29554":1664,"_20528":53397,"_5":14087,"_26889":53311,"_2862":53398},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_3376":1700,"_29554":1664,"_20528":53400,"_5":14087,"_26889":53315,"_2862":53251},[],{"_3376":1701,"_29554":1664,"_20528":53402,"_5":14087,"_26889":53315,"_2862":53403},[],"Result",{"_3376":1702,"_29554":1664,"_20528":53405,"_5":14087,"_26889":53315,"_2862":52498},[],{"_3376":1703,"_29554":1664,"_20528":53407,"_5":14087,"_26889":53315,"_2862":53408},[],"`device-001` appears in inventory with the expected DMS.",{"_3376":1704,"_29554":1664,"_20528":53410,"_5":14087,"_26889":53315,"_2862":53411},[],"Current identity",{"_3376":1705,"_29554":1664,"_20528":53413,"_5":14087,"_26889":53315,"_2862":53414},[],"The associated certificate matches the one you verified in PKI.",{"_3376":1706,"_29554":1664,"_20528":53416,"_5":14087,"_26889":53315,"_2862":53417},[],"History",{"_3376":1707,"_29554":1664,"_20528":53419,"_5":14087,"_26889":53315,"_2862":53420},[],"The associated issuance appears with its serial number and dates.",{"_3376":1708,"_29554":1664,"_20528":53422,"_5":14087,"_26889":53315,"_2862":53423},[],"Key and certificate",{"_3376":1709,"_29554":1664,"_20528":53425,"_5":14087,"_26889":53315,"_2862":53426},[],"You have the verified pair ready to install on the device.",{"_3376":1710,"_29554":1664,"_20528":53428,"_5":14087,"_26889":53318,"_2862":53429},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_3376":1711,"_29554":1664,"_20528":53431,"_5":14087,"_26889":53318,"_2862":53432},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_3376":1712,"_29554":1664,"_20528":53434,"_5":14087,"_26889":53318,"_2862":53435},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_3376":1713,"_29554":1664,"_20528":53437,"_5":14087,"_26889":53318,"_2862":53438},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_3376":1714,"_29554":1664,"_20528":53440,"_5":14087,"_26889":53322,"_2862":53441},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_3376":1715,"_29554":1664,"_20528":53443,"_5":14087,"_26889":53322,"_2862":53444},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_3376":1716,"_29554":1664,"_20528":53446,"_5":14087,"_26889":53322,"_2862":53447},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_3376":1717,"_29554":1717,"_5":14445,"_2862":53449,"_29906":53450,"_20528":53451,"_26889":1717},"Lamassu IoT Platform",[48148,49616],[],{"_3376":1718,"_29554":1717,"_20528":53453,"_5":14087,"_26889":1717,"_2862":53454},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_3376":1719,"_29554":1717,"_5":29903,"_20528":53456,"_26889":53457,"_2862":52937},[],"/docs/pr-preview/pr-52/platform/overview#start-here",{"_3376":1720,"_29554":1717,"_5":29903,"_20528":53459,"_26889":53460,"_2862":53461},[],"/docs/pr-preview/pr-52/platform/overview#choose-your-path","Choose your path",{"_3376":1721,"_29554":1717,"_5":29903,"_20528":53463,"_26889":53464,"_2862":53465},[],"/docs/pr-preview/pr-52/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_3376":1722,"_29554":1717,"_5":29903,"_20528":53467,"_26889":53468,"_2862":53469},[],"/docs/pr-preview/pr-52/platform/overview#core-capabilities","Core capabilities",{"_3376":1723,"_29554":1717,"_5":29903,"_20528":53471,"_26889":53472,"_2862":53473},[],"/docs/pr-preview/pr-52/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_3376":1724,"_29554":1717,"_5":29903,"_20528":53475,"_26889":53476,"_2862":53477},[],"/docs/pr-preview/pr-52/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_3376":1725,"_29554":1717,"_5":29903,"_20528":53479,"_26889":53480,"_2862":53481},[],"/docs/pr-preview/pr-52/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_3376":1726,"_29554":1717,"_5":29903,"_20528":53483,"_26889":53484,"_2862":53485},[],"/docs/pr-preview/pr-52/platform/overview#automate-device-identities","Automate device identities",{"_3376":1727,"_29554":1717,"_5":29903,"_20528":53487,"_26889":53488,"_2862":53489},[],"/docs/pr-preview/pr-52/platform/overview#publish-validation-status","Publish validation status",{"_3376":1728,"_29554":1717,"_5":29903,"_20528":53491,"_26889":53492,"_2862":53493},[],"/docs/pr-preview/pr-52/platform/overview#react-to-events","React to events",{"_3376":1729,"_29554":1717,"_5":29903,"_20528":53495,"_26889":53496,"_2862":53497},[],"/docs/pr-preview/pr-52/platform/overview#operational-reference","Operational reference",{"_3376":1730,"_29554":1717,"_20528":53499,"_5":14087,"_26889":1717,"_2862":53500},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_3376":1731,"_29554":1717,"_20528":53502,"_5":14087,"_26889":53457,"_2862":53503},[],"Choose the result you need:",{"_3376":1732,"_29554":1717,"_20528":53505,"_5":14087,"_26889":53457,"_2862":53506},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3376":1733,"_29554":1717,"_20528":53508,"_5":14087,"_26889":53457,"_2862":53509},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3376":1734,"_29554":1717,"_20528":53511,"_5":14087,"_26889":53457,"_2862":53512},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_3376":1735,"_29554":1717,"_20528":53514,"_5":14087,"_26889":53460,"_2862":53515},[],"Section",{"_3376":1736,"_29554":1717,"_20528":53517,"_5":14087,"_26889":53460,"_2862":53518},[],"What you manage",{"_3376":1737,"_29554":1717,"_20528":53520,"_5":14087,"_26889":53460,"_2862":53521},[],"Entry point",{"_3376":1738,"_29554":1717,"_20528":53523,"_5":14087,"_26889":53460,"_2862":53524},[],"**PKI**",{"_3376":1739,"_29554":1717,"_20528":53526,"_5":14087,"_26889":53460,"_2862":53527},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_3376":1740,"_29554":1717,"_20528":53529,"_5":14087,"_26889":53460,"_2862":53530},[],"PKI overview",{"_3376":1741,"_29554":1717,"_20528":53532,"_5":14087,"_26889":53460,"_2862":53533},[],"**IoT Fleets**",{"_3376":1742,"_29554":1717,"_20528":53535,"_5":14087,"_26889":53460,"_2862":53536},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_3376":1743,"_29554":1717,"_20528":53538,"_5":14087,"_26889":53460,"_2862":53539},[],"IoT Fleets overview",{"_3376":1744,"_29554":1717,"_20528":53541,"_5":14087,"_26889":53460,"_2862":53542},[],"**Administration**",{"_3376":1745,"_29554":1717,"_20528":53544,"_5":14087,"_26889":53460,"_2862":53545},[],"Operator permissions, audit and event subscriptions.",{"_3376":1746,"_29554":1717,"_20528":53547,"_5":14087,"_26889":53460,"_2862":49614},[],{"_3376":1747,"_29554":1717,"_20528":53549,"_5":14087,"_26889":53460,"_2862":53550},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_3376":1748,"_29554":1717,"_20528":53552,"_5":14087,"_26889":53464,"_2862":53553},[],"An identity's journey connects four responsibilities:",{"_3376":1749,"_29554":1717,"_20528":53555,"_5":14087,"_26889":53464,"_2862":53556},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_3376":1750,"_29554":1717,"_20528":53558,"_5":14087,"_26889":53464,"_2862":53559},[],"The provisioning administrator configures the DMS and initial trust.",{"_3376":1751,"_29554":1717,"_20528":53561,"_5":14087,"_26889":53464,"_2862":53562},[],"The device client requests a certificate and installs it with the matching key.",{"_3376":1752,"_29554":1717,"_20528":53564,"_5":14087,"_26889":53464,"_2862":53565},[],"The consumer validates the identity and applies its access permissions.",{"_3376":1753,"_29554":1717,"_20528":53567,"_5":14087,"_26889":53464,"_2862":53568},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_3376":1754,"_29554":1717,"_20528":53570,"_5":14087,"_26889":53472,"_2862":53571},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_3376":1755,"_29554":1717,"_20528":53573,"_5":14087,"_26889":53476,"_2862":53574},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_3376":1756,"_29554":1717,"_20528":53576,"_5":14087,"_26889":53480,"_2862":53577},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_3376":1757,"_29554":1717,"_20528":53579,"_5":14087,"_26889":53484,"_2862":53580},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_3376":1758,"_29554":1717,"_20528":53582,"_5":14087,"_26889":53488,"_2862":53583},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_3376":1759,"_29554":1717,"_20528":53585,"_5":14087,"_26889":53492,"_2862":53586},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_3376":1760,"_29554":1717,"_20528":53588,"_5":14087,"_26889":53496,"_2862":53031},[],{"_3376":1761,"_29554":1717,"_20528":53590,"_5":14087,"_26889":53496,"_2862":53591},[],"What it prepares or checks",{"_3376":1762,"_29554":1717,"_20528":53593,"_5":14087,"_26889":53496,"_2862":53034},[],{"_3376":1763,"_29554":1717,"_20528":53595,"_5":14087,"_26889":53496,"_2862":53596},[],"Key custody, CA hierarchy, profiles and validation.",{"_3376":1764,"_29554":1717,"_20528":53598,"_5":14087,"_26889":53496,"_2862":53599},[],"Fleet administrator",{"_3376":1765,"_29554":1717,"_20528":53601,"_5":14087,"_26889":53496,"_2862":53602},[],"DMS, device admission, renewal policy and inventory.",{"_3376":1766,"_29554":1717,"_20528":53604,"_5":14087,"_26889":53496,"_2862":53046},[],{"_3376":1767,"_29554":1717,"_20528":53606,"_5":14087,"_26889":53496,"_2862":53607},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_3376":1768,"_29554":1717,"_20528":53609,"_5":14087,"_26889":53496,"_2862":53052},[],{"_3376":1769,"_29554":1717,"_20528":53611,"_5":14087,"_26889":53496,"_2862":53612},[],"Issuer trust, certificate validation and permissions in the destination.",{"_3376":1770,"_29554":1717,"_20528":53614,"_5":14087,"_26889":53496,"_2862":53615},[],"Infrastructure operator",{"_3376":1771,"_29554":1717,"_20528":53617,"_5":14087,"_26889":53496,"_2862":53618},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_3376":1772,"_29554":1717,"_20528":53620,"_5":14087,"_26889":53496,"_2862":53621},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_3376":1773,"_29554":1773,"_5":14445,"_2862":53623,"_29906":53624,"_20528":53627,"_26889":1773},"CA hierarchy and rotation",[48148,49616,53625,53626],"PKI","Keys, authorities and certificates",[],{"_3376":1774,"_29554":1773,"_20528":53629,"_5":14087,"_26889":1773,"_2862":53630},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_3376":1775,"_29554":1773,"_5":29903,"_20528":53632,"_26889":53633,"_2862":53634},[],"/docs/pr-preview/pr-52/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_3376":1776,"_29554":1773,"_5":29903,"_20528":53636,"_26889":53637,"_2862":53638},[],"/docs/pr-preview/pr-52/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_3376":1777,"_29554":1773,"_5":29903,"_20528":53640,"_26889":53641,"_2862":53642},[],"/docs/pr-preview/pr-52/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_3376":1778,"_29554":1773,"_5":29903,"_20528":53644,"_26889":53645,"_2862":53646},[],"/docs/pr-preview/pr-52/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_3376":1779,"_29554":1773,"_5":29903,"_20528":53648,"_26889":53649,"_2862":53650},[],"/docs/pr-preview/pr-52/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_3376":1780,"_29554":1773,"_5":29903,"_20528":53652,"_26889":53653,"_2862":53654},[],"/docs/pr-preview/pr-52/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_3376":1781,"_29554":1773,"_5":29903,"_20528":53656,"_26889":53657,"_2862":53658},[],"/docs/pr-preview/pr-52/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_3376":1782,"_29554":1773,"_5":29903,"_20528":53660,"_26889":53661,"_2862":53662},[],"/docs/pr-preview/pr-52/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_3376":1783,"_29554":1773,"_5":29903,"_20528":53664,"_26889":53665,"_2862":53666},[],"/docs/pr-preview/pr-52/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_3376":1784,"_29554":1773,"_5":29903,"_20528":53668,"_26889":53669,"_2862":53670},[],"/docs/pr-preview/pr-52/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_3376":1785,"_29554":1773,"_5":29903,"_20528":53672,"_26889":53673,"_2862":53674},[],"/docs/pr-preview/pr-52/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_3376":1786,"_29554":1773,"_5":29903,"_20528":53676,"_26889":53677,"_2862":53678},[],"/docs/pr-preview/pr-52/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_3376":1787,"_29554":1773,"_20528":53680,"_5":14087,"_26889":1773,"_2862":53681},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_3376":1788,"_29554":1773,"_20528":53683,"_5":14087,"_26889":1773,"_2862":53684},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_3376":1789,"_29554":1773,"_20528":53686,"_5":14087,"_26889":53633,"_2862":53687},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_3376":1790,"_29554":1773,"_20528":53689,"_5":14087,"_26889":53633,"_2862":53690},[],"environment, such as production and preproduction;",{"_3376":1791,"_29554":1773,"_20528":53692,"_5":14087,"_26889":53633,"_2862":53693},[],"owner or operating team;",{"_3376":1792,"_29554":1773,"_20528":53695,"_5":14087,"_26889":53633,"_2862":53696},[],"device family or manufacturing process;",{"_3376":1793,"_29554":1773,"_20528":53698,"_5":14087,"_26889":53633,"_2862":53699},[],"region or regulatory requirement;",{"_3376":1794,"_29554":1773,"_20528":53701,"_5":14087,"_26889":53633,"_2862":53702},[],"cryptographic engine or key policy;",{"_3376":1795,"_29554":1773,"_20528":53704,"_5":14087,"_26889":53633,"_2862":53705},[],"maintenance window and renewal cadence.",{"_3376":1796,"_29554":1773,"_20528":53707,"_5":14087,"_26889":53633,"_2862":53708},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_3376":1797,"_29554":1773,"_20528":53710,"_5":14087,"_26889":53633,"_2862":53711},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_3376":1798,"_29554":1773,"_20528":53713,"_5":14087,"_26889":53637,"_2862":53714},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_3376":1799,"_29554":1773,"_20528":53716,"_5":14087,"_26889":53637,"_2862":53717},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_3376":1800,"_29554":1773,"_20528":53719,"_5":14087,"_26889":53637,"_2862":53720},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_3376":1801,"_29554":1773,"_20528":53722,"_5":14087,"_26889":53641,"_2862":53723},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_3376":1802,"_29554":1773,"_20528":53725,"_5":14087,"_26889":53641,"_2862":53726},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_3376":1803,"_29554":1773,"_20528":53728,"_5":14087,"_26889":53641,"_2862":53729},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_3376":1804,"_29554":1773,"_20528":53731,"_5":14087,"_26889":53641,"_2862":53732},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_3376":1805,"_29554":1773,"_20528":53734,"_5":14087,"_26889":53649,"_2862":53735},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_3376":1806,"_29554":1773,"_20528":53737,"_5":14087,"_26889":53653,"_2862":53738},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_3376":1807,"_29554":1773,"_20528":53740,"_5":14087,"_26889":53657,"_2862":53741},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_3376":1808,"_29554":1773,"_20528":53743,"_5":14087,"_26889":53661,"_2862":53744},[],"Update the enrollment CA and profile of the DMSs. While old-CA cohorts still renew, add the previous enrollment CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`): the new enrollment CA is trusted automatically, but the old one was the enrollment CA and appears in no re-enrollment trust list, so without that entry its certificates can no longer renew. The DMS guide documents the setting.",{"_3376":1809,"_29554":1773,"_20528":53746,"_5":14087,"_26889":53665,"_2862":53747},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_3376":1810,"_29554":1773,"_20528":53749,"_5":14087,"_26889":53669,"_2862":53750},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance, from the re-enrollment validation CAs and from the distributed CAs. Revoke it if policy requires it.",{"_3376":1811,"_29554":1773,"_20528":53752,"_5":14087,"_26889":53673,"_2862":53753},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_3376":1812,"_29554":1773,"_20528":53755,"_5":14087,"_26889":53673,"_2862":53756},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_3376":1813,"_29554":1773,"_20528":53758,"_5":14087,"_26889":53673,"_2862":53759},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_3376":1814,"_29554":1773,"_20528":53761,"_5":14087,"_26889":53673,"_2862":53762},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_3376":1815,"_29554":1773,"_20528":53764,"_5":14087,"_26889":53677,"_2862":53765},[],"The new chain ends in an anchor installed by the consumer.",{"_3376":1816,"_29554":1773,"_20528":53767,"_5":14087,"_26889":53677,"_2862":53768},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_3376":1817,"_29554":1773,"_20528":53770,"_5":14087,"_26889":53677,"_2862":53771},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_3376":1818,"_29554":1773,"_20528":53773,"_5":14087,"_26889":53677,"_2862":53774},[],"Re-enrollment accepts the old identity during the planned period.",{"_3376":1819,"_29554":1773,"_20528":53776,"_5":14087,"_26889":53677,"_2862":53777},[],"OCSP and CRL respond for the authorities that remain active.",{"_3376":1820,"_29554":1773,"_20528":53779,"_5":14087,"_26889":53677,"_2862":53780},[],"No DMS is left accidentally issuing from the old CA.",{"_3376":1821,"_29554":1773,"_20528":53782,"_5":14087,"_26889":53677,"_2862":53783},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_3376":1822,"_29554":1822,"_5":14445,"_2862":53785,"_29906":53786,"_20528":53787,"_26889":1822},"Certification authorities",[48148,49616,53625,53626],[],{"_3376":1823,"_29554":1822,"_20528":53789,"_5":14087,"_26889":1822,"_2862":53790},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_3376":1824,"_29554":1822,"_5":29903,"_20528":53792,"_26889":53793,"_2862":53794},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_3376":1825,"_29554":1822,"_5":29903,"_20528":53796,"_26889":53797,"_2862":53798},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_3376":1826,"_29554":1822,"_5":29903,"_20528":53800,"_26889":53801,"_2862":48158},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#before-you-begin",{"_3376":1827,"_29554":1822,"_5":29903,"_20528":53803,"_26889":53804,"_2862":53805},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_3376":1828,"_29554":1822,"_5":29903,"_20528":53807,"_26889":53808,"_2862":53809},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_3376":1829,"_29554":1822,"_5":29903,"_20528":53811,"_26889":53812,"_2862":53813},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_3376":1830,"_29554":1822,"_5":29903,"_20528":53815,"_26889":53816,"_2862":53817},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_3376":1831,"_29554":1822,"_5":29903,"_20528":53819,"_26889":53820,"_2862":53821},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_3376":1832,"_29554":1822,"_5":29903,"_20528":53823,"_26889":53824,"_2862":53825},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_3376":1833,"_29554":1822,"_5":29903,"_20528":53827,"_26889":53828,"_2862":53829},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_3376":1834,"_29554":1822,"_5":29903,"_20528":53831,"_26889":53832,"_2862":53833},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_3376":1835,"_29554":1822,"_5":29903,"_20528":53835,"_26889":53836,"_2862":53837},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_3376":1836,"_29554":1822,"_5":29903,"_20528":53839,"_26889":53840,"_2862":53841},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#load-the-material","Load the material",{"_3376":1837,"_29554":1822,"_5":29903,"_20528":53843,"_26889":53844,"_2862":53845},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_3376":1838,"_29554":1822,"_5":29903,"_20528":53847,"_26889":53848,"_2862":53849},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_3376":1839,"_29554":1822,"_5":29903,"_20528":53851,"_26889":53852,"_2862":53853},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_3376":1840,"_29554":1822,"_5":29903,"_20528":53855,"_26889":53856,"_2862":53857},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_3376":1841,"_29554":1822,"_5":29903,"_20528":53859,"_26889":53860,"_2862":53861},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_3376":1842,"_29554":1822,"_5":29903,"_20528":53863,"_26889":53864,"_2862":53865},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_3376":1843,"_29554":1822,"_5":29903,"_20528":53867,"_26889":53868,"_2862":53869},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_3376":1844,"_29554":1822,"_5":29903,"_20528":53871,"_26889":53872,"_2862":53873},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_3376":1845,"_29554":1822,"_5":29903,"_20528":53875,"_26889":53876,"_2862":53877},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_3376":1846,"_29554":1822,"_5":29903,"_20528":53879,"_26889":53880,"_2862":53881},[],"/docs/pr-preview/pr-52/platform/pki/certificate-authorities#delete-a-ca","Delete a CA",{"_3376":1847,"_29554":1822,"_20528":53883,"_5":14087,"_26889":1822,"_2862":53884},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_3376":1848,"_29554":1822,"_20528":53886,"_5":14087,"_26889":1822,"_2862":53887},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_3376":1849,"_29554":1822,"_20528":53889,"_5":14087,"_26889":1822,"_2862":53890},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_3376":1850,"_29554":1822,"_20528":53892,"_5":14087,"_26889":53793,"_2862":53893},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_3376":1851,"_29554":1822,"_20528":53895,"_5":14087,"_26889":53793,"_2862":53896},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_3376":1852,"_29554":1822,"_20528":53898,"_5":14087,"_26889":53793,"_2862":53899},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_3376":1853,"_29554":1822,"_20528":53901,"_5":14087,"_26889":53793,"_2862":53902},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_3376":1854,"_29554":1822,"_20528":53904,"_5":14087,"_26889":53793,"_2862":53905},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_3376":1855,"_29554":1822,"_20528":53907,"_5":14087,"_26889":53801,"_2862":53908},[],"Decide whether the CA will be a root or an intermediate.",{"_3376":1856,"_29554":1822,"_20528":53910,"_5":14087,"_26889":53801,"_2862":53911},[],"Choose the engine that will keep the key.",{"_3376":1857,"_29554":1822,"_20528":53913,"_5":14087,"_26889":53801,"_2862":53914},[],"Define a validity longer than that of the certificates it will issue.",{"_3376":1858,"_29554":1822,"_20528":53916,"_5":14087,"_26889":53801,"_2862":53917},[],"For an intermediate CA, make sure the parent CA is active.",{"_3376":1859,"_29554":1822,"_20528":53919,"_5":14087,"_26889":53804,"_2862":53920},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_3376":1860,"_29554":1822,"_20528":53922,"_5":14087,"_26889":53808,"_2862":53923},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_3376":1861,"_29554":1822,"_20528":53925,"_5":14087,"_26889":53808,"_2862":53926},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_3376":1862,"_29554":1822,"_20528":53928,"_5":14087,"_26889":53812,"_2862":53929},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_3376":1863,"_29554":1822,"_20528":53931,"_5":14087,"_26889":53816,"_2862":53932},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_3376":1864,"_29554":1822,"_20528":53934,"_5":14087,"_26889":53816,"_2862":53935},[],"`C`: two-letter ISO 3166-1 country code.",{"_3376":1865,"_29554":1822,"_20528":53937,"_5":14087,"_26889":53816,"_2862":53938},[],"`ST`: state or province.",{"_3376":1866,"_29554":1822,"_20528":53940,"_5":14087,"_26889":53816,"_2862":53941},[],"`L`: locality.",{"_3376":1867,"_29554":1822,"_20528":53943,"_5":14087,"_26889":53816,"_2862":53944},[],"`O`: organization.",{"_3376":1868,"_29554":1822,"_20528":53946,"_5":14087,"_26889":53816,"_2862":53947},[],"`OU`: organizational unit.",{"_3376":1869,"_29554":1822,"_20528":53949,"_5":14087,"_26889":53816,"_2862":53950},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_3376":1870,"_29554":1822,"_20528":53952,"_5":14087,"_26889":53820,"_2862":53953},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_3376":1871,"_29554":1822,"_20528":53955,"_5":14087,"_26889":53820,"_2862":53956},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_3376":1872,"_29554":1822,"_20528":53958,"_5":14087,"_26889":53824,"_2862":53959},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_3376":1873,"_29554":1822,"_20528":53961,"_5":14087,"_26889":53824,"_2862":53962},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_3376":1874,"_29554":1822,"_20528":53964,"_5":14087,"_26889":53828,"_2862":53965},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_3376":1875,"_29554":1822,"_20528":53967,"_5":14087,"_26889":53828,"_2862":53968},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_3376":1876,"_29554":1822,"_20528":53970,"_5":14087,"_26889":53832,"_2862":53971},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages (including `cRLSign`, without which the CA cannot publish its CRL) and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_3376":1877,"_29554":1822,"_20528":53973,"_5":14087,"_26889":53832,"_2862":53974},[],"The backend rejects an import whose certificate lacks the CA basic constraint (`basicConstraints cA flag is not set`), whose serial number matches a stored certificate with different contents, or whose identical certificate already belongs to an existing CA. A deleted CA's certificate record is kept and can be reused when re-importing the same certificate, including its previous status. Re-importing a different certificate with that serial number is rejected; check the certificate and status after re-importing.",{"_3376":1878,"_29554":1822,"_20528":53976,"_5":14087,"_26889":53832,"_2862":53977},[],"Deleting a CA releases the key references of its own current certificate and linked reissued certificates, while keeping those records for its issuer's CRL and OCSP. It then attempts to delete the key; the KMS keeps it if other certificates still reference it, such as another CA sharing the key. Revoking certificates issued by the deleted CA does not release their own key references.",{"_3376":1879,"_29554":1822,"_20528":53979,"_5":14087,"_26889":53836,"_2862":53980},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_3376":1880,"_29554":1822,"_20528":53982,"_5":14087,"_26889":53840,"_2862":53983},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_3376":1881,"_29554":1822,"_20528":53985,"_5":14087,"_26889":53844,"_2862":53986},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_3376":1882,"_29554":1822,"_20528":53988,"_5":14087,"_26889":53848,"_2862":53989},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_3376":1883,"_29554":1822,"_20528":53991,"_5":14087,"_26889":53848,"_2862":53992},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_3376":1884,"_29554":1822,"_20528":53994,"_5":14087,"_26889":53852,"_2862":53995},[],"Open a CA from the inventory to review:",{"_3376":1885,"_29554":1822,"_20528":53997,"_5":14087,"_26889":53852,"_2862":53998},[],"Status and validity period.",{"_3376":1886,"_29554":1822,"_20528":54000,"_5":14087,"_26889":53852,"_2862":54001},[],"Certificate and chain in PEM format.",{"_3376":1887,"_29554":1822,"_20528":54003,"_5":14087,"_26889":53852,"_2862":54004},[],"Number of active, expired and revoked certificates.",{"_3376":1888,"_29554":1822,"_20528":54006,"_5":14087,"_26889":53852,"_2862":54007},[],"Certificates issued in **Issued Certificates**.",{"_3376":1889,"_29554":1822,"_20528":54009,"_5":14087,"_26889":53852,"_2862":54010},[],"The CRL linked to the authority.",{"_3376":1890,"_29554":1822,"_20528":54012,"_5":14087,"_26889":53852,"_2862":54013},[],"Metadata and the associated cryptographic engine.",{"_3376":1891,"_29554":1822,"_20528":54015,"_5":14087,"_26889":53852,"_2862":54016},[],"You can filter the inventory by name, status and CA type.",{"_3376":1892,"_29554":1822,"_20528":54018,"_5":14087,"_26889":53856,"_2862":54019},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_3376":1893,"_29554":1822,"_20528":54021,"_5":14087,"_26889":53856,"_2862":54022},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_3376":1894,"_29554":1822,"_20528":54024,"_5":14087,"_26889":53856,"_2862":54025},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_3376":1895,"_29554":1822,"_20528":54027,"_5":14087,"_26889":53856,"_2862":54028},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_3376":1896,"_29554":1822,"_20528":54030,"_5":14087,"_26889":53860,"_2862":54031},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_3376":1897,"_29554":1822,"_20528":54033,"_5":14087,"_26889":53864,"_2862":54034},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_3376":1898,"_29554":1822,"_20528":54036,"_5":14087,"_26889":53868,"_2862":54037},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_3376":1899,"_29554":1822,"_20528":54039,"_5":14087,"_26889":53872,"_2862":54040},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_3376":1900,"_29554":1822,"_20528":54042,"_5":14087,"_26889":53876,"_2862":54043},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_3376":1901,"_29554":1822,"_20528":54045,"_5":14087,"_26889":53880,"_2862":54046},[],"Permanent deletion is only available with the CA revoked or expired; a CA imported without a key can be deleted in any state. Delete the record only when your retention and audit policy allows it.",{"_3376":1902,"_29554":1822,"_20528":54048,"_5":14087,"_26889":53880,"_2862":54049},[],"The CA’s VA role is kept. If no other CA with the same SKI remains, it can no longer be edited (see CRL), so adjust its validity and signer beforehand. The CA’s key is released, but the KMS keeps it while other certificates still reference it.",{"_3376":1903,"_29554":1822,"_20528":54051,"_5":14087,"_26889":53880,"_2862":54052},[],"Lamassu keeps the certificate record of a deleted CA. If that same certificate is imported again, the import succeeds and reuses the record: it updates the type, issuer and key but keeps the status, so the CA reappears in the state it had when deleted (normally revoked or expired). A different certificate with the same serial number is rejected with a 400 error, and a certificate that already belongs to an existing CA with a 409 error. To avoid inheriting the previous status, use a certificate with a different serial number and check the result after importing. If the new certificate uses the same key, it shares the SKI with the retained VA role of the deleted CA, whose signer is the old certificate: check that the CRL is generated and, if it is not, use `PUT` to set a signer of the new CA (see CRL).",{"_3376":1904,"_29554":1904,"_5":14445,"_2862":54054,"_29906":54055,"_20528":54056,"_26889":1904},"Certificate profiles",[48148,49616,53625,53626],[],{"_3376":1905,"_29554":1904,"_20528":54058,"_5":14087,"_26889":1904,"_2862":54059},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_3376":1906,"_29554":1904,"_5":29903,"_20528":54061,"_26889":54062,"_2862":54063},[],"/docs/pr-preview/pr-52/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_3376":1907,"_29554":1904,"_5":29903,"_20528":54065,"_26889":54066,"_2862":54067},[],"/docs/pr-preview/pr-52/platform/pki/certificate-profiles#validity","Validity",{"_3376":1908,"_29554":1904,"_5":29903,"_20528":54069,"_26889":54070,"_2862":54071},[],"/docs/pr-preview/pr-52/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_3376":1909,"_29554":1904,"_5":29903,"_20528":54073,"_26889":54074,"_2862":54075},[],"/docs/pr-preview/pr-52/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_3376":1910,"_29554":1904,"_5":29903,"_20528":54077,"_26889":54078,"_2862":54079},[],"/docs/pr-preview/pr-52/platform/pki/certificate-profiles#subject","Subject",{"_3376":1911,"_29554":1904,"_5":29903,"_20528":54081,"_26889":54082,"_2862":54083},[],"/docs/pr-preview/pr-52/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_3376":1912,"_29554":1904,"_5":29903,"_20528":54085,"_26889":54086,"_2862":54087},[],"/docs/pr-preview/pr-52/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_3376":1913,"_29554":1904,"_5":29903,"_20528":54089,"_26889":54090,"_2862":54091},[],"/docs/pr-preview/pr-52/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_3376":1914,"_29554":1904,"_5":29903,"_20528":54093,"_26889":54094,"_2862":54095},[],"/docs/pr-preview/pr-52/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_3376":1915,"_29554":1904,"_5":29903,"_20528":54097,"_26889":54098,"_2862":54099},[],"/docs/pr-preview/pr-52/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_3376":1916,"_29554":1904,"_5":29903,"_20528":54101,"_26889":54102,"_2862":54103},[],"/docs/pr-preview/pr-52/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_3376":1917,"_29554":1904,"_5":29903,"_20528":54105,"_26889":54106,"_2862":54107},[],"/docs/pr-preview/pr-52/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_3376":1918,"_29554":1904,"_5":29903,"_20528":54109,"_26889":54110,"_2862":54111},[],"/docs/pr-preview/pr-52/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_3376":1919,"_29554":1904,"_5":29903,"_20528":54113,"_26889":54114,"_2862":54115},[],"/docs/pr-preview/pr-52/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_3376":1920,"_29554":1904,"_5":29903,"_20528":54117,"_26889":54118,"_2862":54119},[],"/docs/pr-preview/pr-52/platform/pki/certificate-profiles#design-examples","Design examples",{"_3376":1921,"_29554":1904,"_5":29903,"_20528":54121,"_26889":54122,"_2862":54123},[],"/docs/pr-preview/pr-52/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_3376":1922,"_29554":1904,"_20528":54125,"_5":14087,"_26889":1904,"_2862":54126},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_3376":1923,"_29554":1904,"_20528":54128,"_5":14087,"_26889":1904,"_2862":54129},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_3376":1924,"_29554":1904,"_20528":54131,"_5":14087,"_26889":54066,"_2862":54132},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_3376":1925,"_29554":1904,"_20528":54134,"_5":14087,"_26889":54066,"_2862":54135},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_3376":1926,"_29554":1904,"_20528":54137,"_5":14087,"_26889":54070,"_2862":54138},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Enable it only in profiles intended to create or reissue subordinate CAs.",{"_3376":1927,"_29554":1904,"_20528":54140,"_5":14087,"_26889":54074,"_2862":54141},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_3376":1928,"_29554":1904,"_20528":54143,"_5":14087,"_26889":54074,"_2862":54144},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_3376":1929,"_29554":1904,"_20528":54146,"_5":14087,"_26889":54074,"_2862":54147},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_3376":1930,"_29554":1904,"_20528":54149,"_5":14087,"_26889":54078,"_2862":54150},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_3376":1931,"_29554":1904,"_20528":54152,"_5":14087,"_26889":54082,"_2862":54153},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_3376":1932,"_29554":1904,"_20528":54155,"_5":14087,"_26889":54082,"_2862":54156},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_3376":1933,"_29554":1904,"_20528":54158,"_5":14087,"_26889":54086,"_2862":54159},[],"The cryptographic enforcement can:",{"_3376":1934,"_29554":1904,"_20528":54161,"_5":14087,"_26889":54086,"_2862":54162},[],"allow or block RSA keys;",{"_3376":1935,"_29554":1904,"_20528":54164,"_5":14087,"_26889":54086,"_2862":54165},[],"limit the supported RSA sizes;",{"_3376":1936,"_29554":1904,"_20528":54167,"_5":14087,"_26889":54086,"_2862":54168},[],"allow or block ECDSA keys;",{"_3376":1937,"_29554":1904,"_20528":54170,"_5":14087,"_26889":54086,"_2862":54171},[],"limit the supported ECDSA sizes or curves.",{"_3376":1938,"_29554":1904,"_20528":54173,"_5":14087,"_26889":54086,"_2862":54174},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_3376":1939,"_29554":1904,"_20528":54176,"_5":14087,"_26889":54090,"_2862":54177},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_3376":1940,"_29554":1904,"_20528":54179,"_5":14087,"_26889":54090,"_2862":51380},[],{"_3376":1941,"_29554":1904,"_20528":54181,"_5":14087,"_26889":54090,"_2862":54182},[],"First choice",{"_3376":1942,"_29554":1904,"_20528":54184,"_5":14087,"_26889":54090,"_2862":54185},[],"Second choice",{"_3376":1943,"_29554":1904,"_20528":54187,"_5":14087,"_26889":54090,"_2862":54188},[],"If neither is supplied",{"_3376":1944,"_29554":1904,"_20528":54190,"_5":14087,"_26889":54090,"_2862":54191},[],"Direct signing with a CA",{"_3376":1945,"_29554":1904,"_20528":54193,"_5":14087,"_26889":54090,"_2862":54194},[],"`issuance_profile` embedded in the request",{"_3376":1946,"_29554":1904,"_20528":54196,"_5":14087,"_26889":54090,"_2862":54197},[],"Request `issuance_profile_id`",{"_3376":1947,"_29554":1904,"_20528":54199,"_5":14087,"_26889":54090,"_2862":54200},[],"CA default profile (`profile_id`).",{"_3376":1948,"_29554":1904,"_20528":54202,"_5":14087,"_26889":54090,"_2862":54203},[],"Issuance through a DMS",{"_3376":1949,"_29554":1904,"_20528":54205,"_5":14087,"_26889":54090,"_2862":54206},[],"`settings.issuance_profile_id`",{"_3376":1950,"_29554":1904,"_20528":54208,"_5":14087,"_26889":54090,"_2862":54209},[],"`settings.issuance_profile` embedded in the DMS",{"_3376":1951,"_29554":1904,"_20528":54211,"_5":14087,"_26889":54090,"_2862":54212},[],"Enrollment CA default profile.",{"_3376":1952,"_29554":1904,"_20528":54214,"_5":14087,"_26889":54090,"_2862":54215},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_3376":1953,"_29554":1904,"_20528":54217,"_5":14087,"_26889":54090,"_2862":54218},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_3376":1954,"_29554":1904,"_20528":54220,"_5":14087,"_26889":54098,"_2862":54221},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_3376":1955,"_29554":1904,"_20528":54223,"_5":14087,"_26889":54102,"_2862":54224},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_3376":1956,"_29554":1904,"_20528":54226,"_5":14087,"_26889":54106,"_2862":54227},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_3376":1957,"_29554":1904,"_20528":54229,"_5":14087,"_26889":54110,"_2862":54230},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_3376":1958,"_29554":1904,"_20528":54232,"_5":14087,"_26889":54114,"_2862":54233},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_3376":1959,"_29554":1904,"_20528":54235,"_5":14087,"_26889":54114,"_2862":54236},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_3376":1960,"_29554":1904,"_20528":54238,"_5":14087,"_26889":54118,"_2862":54239},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_3376":1961,"_29554":1904,"_20528":54241,"_5":14087,"_26889":54118,"_2862":54242},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_3376":1962,"_29554":1904,"_20528":54244,"_5":14087,"_26889":54118,"_2862":54245},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_3376":1963,"_29554":1904,"_20528":54247,"_5":14087,"_26889":54118,"_2862":54248},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_3376":1964,"_29554":1904,"_20528":54250,"_5":14087,"_26889":54122,"_2862":54251},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_3376":1965,"_29554":1904,"_20528":54253,"_5":14087,"_26889":54122,"_2862":54254},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_3376":1966,"_29554":1966,"_5":14445,"_2862":54256,"_29906":54257,"_20528":54259,"_26889":1966},"Certificate validation",[48148,49616,53625,54258],"Validation",[],{"_3376":1967,"_29554":1966,"_20528":54261,"_5":14087,"_26889":1966,"_2862":54262},[],"Check chain, identity, purpose and revocation from the consumer.",{"_3376":1968,"_29554":1966,"_5":29903,"_20528":54264,"_26889":54265,"_2862":54266},[],"/docs/pr-preview/pr-52/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_3376":1969,"_29554":1966,"_5":29903,"_20528":54268,"_26889":54269,"_2862":54270},[],"/docs/pr-preview/pr-52/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_3376":1970,"_29554":1966,"_5":29903,"_20528":54272,"_26889":54273,"_2862":54274},[],"/docs/pr-preview/pr-52/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_3376":1971,"_29554":1966,"_20528":54276,"_5":14087,"_26889":1966,"_2862":54277},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_3376":1972,"_29554":1966,"_20528":54279,"_5":14087,"_26889":54265,"_2862":54280},[],"Verify these criteria together:",{"_3376":1973,"_29554":1966,"_20528":54282,"_5":14087,"_26889":54265,"_2862":53251},[],{"_3376":1974,"_29554":1966,"_20528":54284,"_5":14087,"_26889":54265,"_2862":54285},[],"Required result",{"_3376":1975,"_29554":1966,"_20528":54287,"_5":14087,"_26889":54265,"_2862":54288},[],"Chain and signature",{"_3376":1976,"_29554":1966,"_20528":54290,"_5":14087,"_26889":54265,"_2862":54291},[],"Valid chain to a root deliberately installed in the consumer.",{"_3376":1977,"_29554":1966,"_20528":54293,"_5":14087,"_26889":54265,"_2862":54294},[],"Dates",{"_3376":1978,"_29554":1966,"_20528":54296,"_5":14087,"_26889":54265,"_2862":54297},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_3376":1979,"_29554":1966,"_20528":54299,"_5":14087,"_26889":54265,"_2862":49285},[],{"_3376":1980,"_29554":1966,"_20528":54301,"_5":14087,"_26889":54265,"_2862":54302},[],"Name, SAN or identifier matches the expected peer.",{"_3376":1981,"_29554":1966,"_20528":54304,"_5":14087,"_26889":54265,"_2862":48538},[],{"_3376":1982,"_29554":1966,"_20528":54306,"_5":14087,"_26889":54265,"_2862":54307},[],"KU, EKU and constraints permit the specific operation.",{"_3376":1983,"_29554":1966,"_20528":54309,"_5":14087,"_26889":54265,"_2862":54310},[],"Revocation",{"_3376":1984,"_29554":1966,"_20528":54312,"_5":14087,"_26889":54265,"_2862":54313},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_3376":1985,"_29554":1966,"_20528":54315,"_5":14087,"_26889":54265,"_2862":54316},[],"Authorization",{"_3376":1986,"_29554":1966,"_20528":54318,"_5":14087,"_26889":54265,"_2862":54319},[],"The application permits that identity to perform the action.",{"_3376":1987,"_29554":1966,"_20528":54321,"_5":14087,"_26889":54265,"_2862":54322},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_3376":1988,"_29554":1966,"_20528":54324,"_5":14087,"_26889":54269,"_2862":54325},[],"Mechanism",{"_3376":1989,"_29554":1966,"_20528":54327,"_5":14087,"_26889":54269,"_2862":54328},[],"When to use it",{"_3376":1990,"_29554":1966,"_20528":54330,"_5":14087,"_26889":54269,"_2862":54331},[],"What you must maintain",{"_3376":1991,"_29554":1966,"_20528":54333,"_5":14087,"_26889":54269,"_2862":54334},[],"OCSP",{"_3376":1992,"_29554":1966,"_20528":54336,"_5":14087,"_26889":54269,"_2862":54337},[],"Status query for a specific certificate.",{"_3376":1993,"_29554":1966,"_20528":54339,"_5":14087,"_26889":54269,"_2862":54340},[],"Responder access, signature verification and cache/freshness policy.",{"_3376":1994,"_29554":1966,"_20528":54342,"_5":14087,"_26889":54269,"_2862":54343},[],"CRL",{"_3376":1995,"_29554":1966,"_20528":54345,"_5":14087,"_26889":54269,"_2862":54346},[],"Local checks for many certificates or offline operation.",{"_3376":1996,"_29554":1966,"_20528":54348,"_5":14087,"_26889":54269,"_2862":54349},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_3376":1997,"_29554":1966,"_20528":54351,"_5":14087,"_26889":54269,"_2862":54352},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_3376":1998,"_29554":1966,"_20528":54354,"_5":14087,"_26889":54269,"_2862":54355},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_3376":1999,"_29554":1966,"_20528":54357,"_5":14087,"_26889":54273,"_2862":54358},[],"Accept a current, authorized certificate with a known chain.",{"_3376":2000,"_29554":1966,"_20528":54360,"_5":14087,"_26889":54273,"_2862":54361},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_3376":2001,"_29554":1966,"_20528":54363,"_5":14087,"_26889":54273,"_2862":54364},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_3376":2002,"_29554":1966,"_20528":54366,"_5":14087,"_26889":54273,"_2862":54367},[],"Check that a new connection with that identity is rejected.",{"_3376":2003,"_29554":1966,"_20528":54369,"_5":14087,"_26889":54273,"_2862":54370},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_3376":2004,"_29554":1966,"_20528":54372,"_5":14087,"_26889":54273,"_2862":54373},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_3376":2005,"_29554":1966,"_20528":54375,"_5":14087,"_26889":54273,"_2862":54376},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_3376":2006,"_29554":1966,"_20528":54378,"_5":14087,"_26889":54273,"_2862":54379},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_3376":2007,"_29554":1966,"_20528":54381,"_5":14087,"_26889":54273,"_2862":54382},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_3376":2008,"_29554":2008,"_5":14445,"_2862":54384,"_29906":54385,"_20528":54386,"_26889":2008},"Certificates",[48148,49616,53625,53626],[],{"_3376":2009,"_29554":2008,"_20528":54388,"_5":14087,"_26889":2008,"_2862":54389},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_3376":2010,"_29554":2008,"_5":29903,"_20528":54391,"_26889":54392,"_2862":54393},[],"/docs/pr-preview/pr-52/platform/pki/certificates#find-a-certificate","Find a certificate",{"_3376":2011,"_29554":2008,"_5":29903,"_20528":54395,"_26889":54396,"_2862":54397},[],"/docs/pr-preview/pr-52/platform/pki/certificates#download-the-certificate","Download the certificate",{"_3376":2012,"_29554":2008,"_5":29903,"_20528":54399,"_26889":54400,"_2862":54401},[],"/docs/pr-preview/pr-52/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_3376":2013,"_29554":2008,"_5":29903,"_20528":54403,"_26889":54404,"_2862":54405},[],"/docs/pr-preview/pr-52/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_3376":2014,"_29554":2008,"_5":29903,"_20528":54407,"_26889":54408,"_2862":54409},[],"/docs/pr-preview/pr-52/platform/pki/certificates#open-the-action","Open the action",{"_3376":2015,"_29554":2008,"_5":29903,"_20528":54411,"_26889":54412,"_2862":54413},[],"/docs/pr-preview/pr-52/platform/pki/certificates#choose-a-reason","Choose a reason",{"_3376":2016,"_29554":2008,"_5":29903,"_20528":54415,"_26889":54416,"_2862":54417},[],"/docs/pr-preview/pr-52/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_3376":2017,"_29554":2008,"_5":29903,"_20528":54419,"_26889":54420,"_2862":54421},[],"/docs/pr-preview/pr-52/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_3376":2018,"_29554":2008,"_5":29903,"_20528":54423,"_26889":54424,"_2862":54425},[],"/docs/pr-preview/pr-52/platform/pki/certificates#continue","Continue",{"_3376":2019,"_29554":2008,"_20528":54427,"_5":14087,"_26889":2008,"_2862":54428},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_3376":2020,"_29554":2008,"_20528":54430,"_5":14087,"_26889":54392,"_2862":54431},[],"Filter by `Common Name`, serial, status and issuer. Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata. Certificate details include the key reference (`key_id`) and whether the private key is managed (`has_private_key`), and certificate lists can be filtered on `has_private_key`.",{"_3376":2021,"_29554":2008,"_20528":54433,"_5":14087,"_26889":54392,"_2862":54434},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_3376":2022,"_29554":2008,"_20528":54436,"_5":14087,"_26889":54396,"_2862":54437},[],"Download the PEM and inspect it:",{"_3376":2023,"_29554":2008,"_20528":54439,"_5":14087,"_26889":54396,"_2862":54440},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_3376":2024,"_29554":2008,"_20528":54442,"_5":14087,"_26889":54400,"_2862":54443},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_3376":2025,"_29554":2008,"_20528":54445,"_5":14087,"_26889":54400,"_2862":54446},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_3376":2026,"_29554":2008,"_20528":54448,"_5":14087,"_26889":54400,"_2862":54449},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_3376":2027,"_29554":2008,"_20528":54451,"_5":14087,"_26889":54400,"_2862":54452},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_3376":2028,"_29554":2008,"_20528":54454,"_5":14087,"_26889":54400,"_2862":54455},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_3376":2029,"_29554":2008,"_20528":54457,"_5":14087,"_26889":54400,"_2862":54458},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_3376":2030,"_29554":2008,"_20528":54460,"_5":14087,"_26889":54400,"_2862":54461},[],"For browser key generation, follow Issue your first certificate.",{"_3376":2031,"_29554":2008,"_20528":54463,"_5":14087,"_26889":54404,"_2862":54464},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_3376":2032,"_29554":2008,"_20528":54466,"_5":14087,"_26889":54408,"_2862":54467},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_3376":2033,"_29554":2008,"_20528":54469,"_5":14087,"_26889":54412,"_2862":54470},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_3376":2034,"_29554":2008,"_20528":54472,"_5":14087,"_26889":54416,"_2862":54473},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_3376":2035,"_29554":2008,"_20528":54475,"_5":14087,"_26889":54416,"_2862":54476},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_3376":2036,"_29554":2008,"_20528":54478,"_5":14087,"_26889":54416,"_2862":54479},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_3376":2037,"_29554":2008,"_20528":54481,"_5":14087,"_26889":54420,"_2862":54482},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_3376":2038,"_29554":2008,"_20528":54484,"_5":14087,"_26889":54420,"_2862":54485},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_3376":2039,"_29554":2008,"_20528":54487,"_5":14087,"_26889":54420,"_2862":54488},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_3376":2040,"_29554":2008,"_20528":54490,"_5":14087,"_26889":54424,"_2862":54491},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_3376":2041,"_29554":2008,"_20528":54493,"_5":14087,"_26889":54424,"_2862":54494},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_3376":2042,"_29554":2042,"_5":14445,"_2862":54496,"_29906":54497,"_20528":54499,"_26889":2042},"Certificate lifecycle",[48148,49616,53625,54498],"Concepts",[],{"_3376":2043,"_29554":2042,"_20528":54501,"_5":14087,"_26889":2042,"_2862":54502},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_3376":2044,"_29554":2042,"_5":29903,"_20528":54504,"_26889":54505,"_2862":54506},[],"/docs/pr-preview/pr-52/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_3376":2045,"_29554":2042,"_5":29903,"_20528":54508,"_26889":54509,"_2862":54510},[],"/docs/pr-preview/pr-52/platform/pki/concepts/certificate-lifecycle#request","Request",{"_3376":2046,"_29554":2042,"_5":29903,"_20528":54512,"_26889":54513,"_2862":54514},[],"/docs/pr-preview/pr-52/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_3376":2047,"_29554":2042,"_5":29903,"_20528":54516,"_26889":54517,"_2862":54518},[],"/docs/pr-preview/pr-52/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_3376":2048,"_29554":2042,"_5":29903,"_20528":54520,"_26889":54521,"_2862":54522},[],"/docs/pr-preview/pr-52/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_3376":2049,"_29554":2042,"_5":29903,"_20528":54524,"_26889":54525,"_2862":54526},[],"/docs/pr-preview/pr-52/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_3376":2050,"_29554":2042,"_5":29903,"_20528":54528,"_26889":54529,"_2862":54530},[],"/docs/pr-preview/pr-52/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_3376":2051,"_29554":2042,"_5":29903,"_20528":54532,"_26889":54533,"_2862":54534},[],"/docs/pr-preview/pr-52/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_3376":2052,"_29554":2042,"_5":29903,"_20528":54536,"_26889":54537,"_2862":54538},[],"/docs/pr-preview/pr-52/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_3376":2053,"_29554":2042,"_5":29903,"_20528":54540,"_26889":54541,"_2862":54542},[],"/docs/pr-preview/pr-52/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_3376":2054,"_29554":2042,"_20528":54544,"_5":14087,"_26889":2042,"_2862":54545},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_3376":2055,"_29554":2042,"_20528":54547,"_5":14087,"_26889":54509,"_2862":54548},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_3376":2056,"_29554":2042,"_20528":54550,"_5":14087,"_26889":54513,"_2862":54551},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_3376":2057,"_29554":2042,"_20528":54553,"_5":14087,"_26889":54517,"_2862":54554},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_3376":2058,"_29554":2042,"_20528":54556,"_5":14087,"_26889":54521,"_2862":54557},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_3376":2059,"_29554":2042,"_20528":54559,"_5":14087,"_26889":54525,"_2862":54560},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_3376":2060,"_29554":2042,"_20528":54562,"_5":14087,"_26889":54529,"_2862":54563},[],"Lamassu persists four X.509 states:",{"_3376":2061,"_29554":2042,"_20528":54565,"_5":14087,"_26889":54529,"_2862":54566},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_3376":2062,"_29554":2042,"_20528":54568,"_5":14087,"_26889":54529,"_2862":54569},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_3376":2063,"_29554":2042,"_20528":54571,"_5":14087,"_26889":54529,"_2862":54572},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_3376":2064,"_29554":2042,"_20528":54574,"_5":14087,"_26889":54529,"_2862":54575},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_3376":2065,"_29554":2042,"_20528":54577,"_5":14087,"_26889":54529,"_2862":54578},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_3376":2066,"_29554":2042,"_20528":54580,"_5":14087,"_26889":54533,"_2862":54581},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_3376":2067,"_29554":2042,"_20528":54583,"_5":14087,"_26889":54533,"_2862":54584},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_3376":2068,"_29554":2042,"_20528":54586,"_5":14087,"_26889":54533,"_2862":54587},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_3376":2069,"_29554":2042,"_20528":54589,"_5":14087,"_26889":54537,"_2862":54590},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_3376":2070,"_29554":2042,"_20528":54592,"_5":14087,"_26889":54537,"_2862":54593},[],"Before confirming:",{"_3376":2071,"_29554":2042,"_20528":54595,"_5":14087,"_26889":54537,"_2862":54596},[],"Identify DMSs, devices and services that trust that chain.",{"_3376":2072,"_29554":2042,"_20528":54598,"_5":14087,"_26889":54537,"_2862":54599},[],"Distribute the new chain of trust.",{"_3376":2073,"_29554":2042,"_20528":54601,"_5":14087,"_26889":54537,"_2862":54602},[],"Reissue the necessary identities.",{"_3376":2074,"_29554":2042,"_20528":54604,"_5":14087,"_26889":54537,"_2862":54605},[],"Check OCSP and CRL from a real consumer.",{"_3376":2075,"_29554":2042,"_20528":54607,"_5":14087,"_26889":54537,"_2862":54608},[],"Revoke the old CA once no legitimate traffic remains.",{"_3376":2076,"_29554":2042,"_20528":54610,"_5":14087,"_26889":54537,"_2862":54611},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_3376":2077,"_29554":2042,"_20528":54613,"_5":14087,"_26889":54541,"_2862":54614},[],"Certificates entering the preventive or critical renewal window.",{"_3376":2078,"_29554":2042,"_20528":54616,"_5":14087,"_26889":54541,"_2862":54617},[],"Repeated enrollment or re-enrollment failures.",{"_3376":2079,"_29554":2042,"_20528":54619,"_5":14087,"_26889":54541,"_2862":54620},[],"Status changes and revocation reasons.",{"_3376":2080,"_29554":2042,"_20528":54622,"_5":14087,"_26889":54541,"_2862":54623},[],"OCSP and CRL publication and validity.",{"_3376":2081,"_29554":2042,"_20528":54625,"_5":14087,"_26889":54541,"_2862":54626},[],"Dependencies still presenting a replaced certificate.",{"_3376":2082,"_29554":2042,"_20528":54628,"_5":14087,"_26889":54541,"_2862":54629},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_3376":2083,"_29554":2083,"_5":14445,"_2862":54631,"_29906":54632,"_20528":54633,"_26889":2083},"Trust model",[48148,49616,53625,54498],[],{"_3376":2084,"_29554":2083,"_20528":54635,"_5":14087,"_26889":2083,"_2862":54636},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_3376":2085,"_29554":2083,"_5":29903,"_20528":54638,"_26889":54639,"_2862":54640},[],"/docs/pr-preview/pr-52/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_3376":2086,"_29554":2083,"_5":29903,"_20528":54642,"_26889":54643,"_2862":54644},[],"/docs/pr-preview/pr-52/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_3376":2087,"_29554":2083,"_5":29903,"_20528":54646,"_26889":54647,"_2862":54648},[],"/docs/pr-preview/pr-52/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_3376":2088,"_29554":2083,"_5":29903,"_20528":54650,"_26889":54651,"_2862":54652},[],"/docs/pr-preview/pr-52/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_3376":2089,"_29554":2083,"_5":29903,"_20528":54654,"_26889":54655,"_2862":54656},[],"/docs/pr-preview/pr-52/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_3376":2090,"_29554":2083,"_5":29903,"_20528":54658,"_26889":54659,"_2862":54660},[],"/docs/pr-preview/pr-52/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_3376":2091,"_29554":2083,"_5":29903,"_20528":54662,"_26889":54663,"_2862":54664},[],"/docs/pr-preview/pr-52/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_3376":2092,"_29554":2083,"_5":29903,"_20528":54666,"_26889":54667,"_2862":54668},[],"/docs/pr-preview/pr-52/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_3376":2093,"_29554":2083,"_5":29903,"_20528":54670,"_26889":54671,"_2862":54672},[],"/docs/pr-preview/pr-52/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_3376":2094,"_29554":2083,"_5":29903,"_20528":54674,"_26889":54675,"_2862":54676},[],"/docs/pr-preview/pr-52/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_3376":2095,"_29554":2083,"_20528":54678,"_5":14087,"_26889":2083,"_2862":54679},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_3376":2096,"_29554":2083,"_20528":54681,"_5":14087,"_26889":54643,"_2862":54682},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_3376":2097,"_29554":2083,"_20528":54684,"_5":14087,"_26889":54647,"_2862":54685},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_3376":2098,"_29554":2083,"_20528":54687,"_5":14087,"_26889":54651,"_2862":54688},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_3376":2099,"_29554":2083,"_20528":54690,"_5":14087,"_26889":54655,"_2862":54691},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_3376":2100,"_29554":2083,"_20528":54693,"_5":14087,"_26889":54659,"_2862":54694},[],"The device proves it can enroll according to the DMS policy.",{"_3376":2101,"_29554":2083,"_20528":54696,"_5":14087,"_26889":54659,"_2862":54697},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_3376":2102,"_29554":2083,"_20528":54699,"_5":14087,"_26889":54659,"_2862":54700},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_3376":2103,"_29554":2083,"_20528":54702,"_5":14087,"_26889":54659,"_2862":54703},[],"The device installs the certificate and the chain it needs.",{"_3376":2104,"_29554":2083,"_20528":54705,"_5":14087,"_26889":54659,"_2862":54706},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_3376":2105,"_29554":2083,"_20528":54708,"_5":14087,"_26889":54659,"_2862":54709},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_3376":2106,"_29554":2083,"_20528":54711,"_5":14087,"_26889":54663,"_2862":54712},[],"A DMS relates three sets that are worth designing separately:",{"_3376":2107,"_29554":2083,"_20528":54714,"_5":14087,"_26889":54663,"_2862":54715},[],"**Enrollment CA:** signs the new identities.",{"_3376":2108,"_29554":2083,"_20528":54717,"_5":14087,"_26889":54663,"_2862":54718},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, the enrollment CA is always trusted and Lamassu then tries the validation CAs configured in the re-enrollment block; those are optional.",{"_3376":2109,"_29554":2083,"_20528":54720,"_5":14087,"_26889":54663,"_2862":54721},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_3376":2110,"_29554":2083,"_20528":54723,"_5":14087,"_26889":54663,"_2862":54724},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_3376":2111,"_29554":2083,"_20528":54726,"_5":14087,"_26889":54667,"_2862":54727},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_3376":2112,"_29554":2083,"_20528":54729,"_5":14087,"_26889":54667,"_2862":54730},[],"that the current date is between `Not Before` and `Not After`;",{"_3376":2113,"_29554":2083,"_20528":54732,"_5":14087,"_26889":54667,"_2862":54733},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_3376":2114,"_29554":2083,"_20528":54735,"_5":14087,"_26889":54667,"_2862":54736},[],"that names, SANs and subject match the expected identity;",{"_3376":2115,"_29554":2083,"_20528":54738,"_5":14087,"_26889":54667,"_2862":54739},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_3376":2116,"_29554":2083,"_20528":54741,"_5":14087,"_26889":54667,"_2862":54742},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_3376":2117,"_29554":2083,"_20528":54744,"_5":14087,"_26889":54667,"_2862":54745},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_3376":2118,"_29554":2083,"_20528":54747,"_5":14087,"_26889":54671,"_2862":54748},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_3376":2119,"_29554":2083,"_20528":54750,"_5":14087,"_26889":54675,"_2862":54751},[],"Keep the root out of daily operations, or with very restricted access.",{"_3376":2120,"_29554":2083,"_20528":54753,"_5":14087,"_26889":54675,"_2862":54754},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_3376":2121,"_29554":2083,"_20528":54756,"_5":14087,"_26889":54675,"_2862":54757},[],"Assign explicit profiles to every use case.",{"_3376":2122,"_29554":2083,"_20528":54759,"_5":14087,"_26889":54675,"_2862":54760},[],"Distribute the new trust before starting a rotation.",{"_3376":2123,"_29554":2083,"_20528":54762,"_5":14087,"_26889":54675,"_2862":54763},[],"Keep enough overlap to renew a disconnected fleet.",{"_3376":2124,"_29554":2083,"_20528":54765,"_5":14087,"_26889":54675,"_2862":54766},[],"Validate from the consuming system, not only from the Lamassu console.",{"_3376":2125,"_29554":2083,"_20528":54768,"_5":14087,"_26889":54675,"_2862":54769},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_3376":2126,"_29554":2126,"_5":14445,"_2862":54771,"_29906":54772,"_20528":54773,"_26889":2126},"Revocation lists (CRL)",[48148,49616,53625,54258],[],{"_3376":2127,"_29554":2126,"_20528":54775,"_5":14087,"_26889":2126,"_2862":54776},[],"Generate and distribute signed lists to validate certificates offline.",{"_3376":2128,"_29554":2126,"_5":29903,"_20528":54778,"_26889":54779,"_2862":54780},[],"/docs/pr-preview/pr-52/platform/pki/crl#va-role-and-per-ca-configuration","VA role and per-CA configuration",{"_3376":2129,"_29554":2126,"_5":29903,"_20528":54782,"_26889":54783,"_2862":54784},[],"/docs/pr-preview/pr-52/platform/pki/crl#cas-that-share-a-key","CAs that share a key",{"_3376":2130,"_29554":2126,"_5":29903,"_20528":54786,"_26889":54787,"_2862":54788},[],"/docs/pr-preview/pr-52/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_3376":2131,"_29554":2126,"_5":29903,"_20528":54790,"_26889":54791,"_2862":54792},[],"/docs/pr-preview/pr-52/platform/pki/crl#crl-contents","CRL contents",{"_3376":2132,"_29554":2126,"_5":29903,"_20528":54794,"_26889":54795,"_2862":54796},[],"/docs/pr-preview/pr-52/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_3376":2133,"_29554":2126,"_5":29903,"_20528":54798,"_26889":54799,"_2862":54800},[],"/docs/pr-preview/pr-52/platform/pki/crl#va-role-management-api","VA role management API",{"_3376":2134,"_29554":2126,"_5":29903,"_20528":54802,"_26889":54803,"_2862":54804},[],"/docs/pr-preview/pr-52/platform/pki/crl#common-va-role-errors","Common VA role errors",{"_3376":2135,"_29554":2126,"_5":29903,"_20528":54806,"_26889":54807,"_2862":54808},[],"/docs/pr-preview/pr-52/platform/pki/crl#from-the-interface","From the interface",{"_3376":2136,"_29554":2126,"_5":29903,"_20528":54810,"_26889":54811,"_2862":54812},[],"/docs/pr-preview/pr-52/platform/pki/crl#references","References",{"_3376":2137,"_29554":2126,"_20528":54814,"_5":14087,"_26889":2126,"_2862":54815},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its SKI and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_3376":2138,"_29554":2126,"_20528":54817,"_5":14087,"_26889":54779,"_2862":54818},[],"The VA role stores configuration and metadata for the latest list published for a CA’s SKI. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_3376":2139,"_29554":2126,"_20528":54820,"_5":14087,"_26889":54779,"_2862":54821},[],"`crl_options` field",{"_3376":2140,"_29554":2126,"_20528":54823,"_5":14087,"_26889":54779,"_2862":48538},[],{"_3376":2141,"_29554":2126,"_20528":54825,"_5":14087,"_26889":54779,"_2862":54826},[],"Backend initial value",{"_3376":2142,"_29554":2126,"_20528":54828,"_5":14087,"_26889":54779,"_2862":54829},[],"`validity`",{"_3376":2143,"_29554":2126,"_20528":54831,"_5":14087,"_26889":54779,"_2862":54832},[],"Time from `thisUpdate` to `nextUpdate`.",{"_3376":2144,"_29554":2126,"_20528":54834,"_5":14087,"_26889":54779,"_2862":54835},[],"7 days.",{"_3376":2145,"_29554":2126,"_20528":54837,"_5":14087,"_26889":54779,"_2862":54838},[],"`refresh_interval`",{"_3376":2146,"_29554":2126,"_20528":54840,"_5":14087,"_26889":54779,"_2862":54841},[],"Stored and returned by the API, but the VA does not use it: scheduled renewal does not depend on it (see Periodic and automatic regeneration).",{"_3376":2147,"_29554":2126,"_20528":54843,"_5":14087,"_26889":54779,"_2862":54844},[],"6 days and 23 hours.",{"_3376":2148,"_29554":2126,"_20528":54846,"_5":14087,"_26889":54779,"_2862":54847},[],"`regenerate_on_revoke`",{"_3376":2149,"_29554":2126,"_20528":54849,"_5":14087,"_26889":54779,"_2862":54850},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_3376":2150,"_29554":2126,"_20528":54852,"_5":14087,"_26889":54779,"_2862":54853},[],"`true`.",{"_3376":2151,"_29554":2126,"_20528":54855,"_5":14087,"_26889":54779,"_2862":54856},[],"`signer_certificate_serial_number`",{"_3376":2152,"_29554":2126,"_20528":54858,"_5":14087,"_26889":54779,"_2862":54859},[],"Serial number of the existing certificate that signs the CRL.",{"_3376":2153,"_29554":2126,"_20528":54861,"_5":14087,"_26889":54779,"_2862":54862},[],"Serial number of the CA’s current certificate.",{"_3376":2154,"_29554":2126,"_20528":54864,"_5":14087,"_26889":54779,"_2862":54865},[],"The signer must be an existing certificate with the `cRLSign` key usage and the same subject and public key as the CA. Certificates from before a reissue qualify. A delegated signer is not supported: a certificate with the CA’s subject but a different key is rejected.",{"_3376":2155,"_29554":2126,"_20528":54867,"_5":14087,"_26889":54779,"_2862":54868},[],"When a CA is reissued, the role keeps pointing at the previous certificate. CRLs remain valid because both certificates share subject and key, but the previous certificate cannot be deleted while the role uses it. To retire it, update the role’s signer.",{"_3376":2156,"_29554":2126,"_20528":54870,"_5":14087,"_26889":54779,"_2862":54871},[],"When a CA is deleted, its VA role is kept and cannot be removed through the API. If no other CA with the same SKI remains, the role can be read but any `PUT` returns 404, and the renewal job logs a warning on every cycle because it no longer finds the CA. The API offers no way out; it can only be fixed by editing the database. If another CA with that SKI remains, the role is still editable (see CAs that share a key). Adjust validity and signer before deleting the CA.",{"_3376":2157,"_29554":2126,"_20528":54873,"_5":14087,"_26889":54779,"_2862":54874},[],"A CA whose certificate lacks `cRLSign` cannot generate its CRL or edit its role (400 error). Since 4.0 the VA requires this usage. Check before importing with `openssl x509 -noout -ext keyUsage` and, if it is missing, obtain a certificate for the same CA and key that includes it and set it as the signer with `PUT`. After reissuing a CA, also check the key usage of the new certificate: it may not keep the original’s usages.",{"_3376":2158,"_29554":2126,"_20528":54876,"_5":14087,"_26889":54779,"_2862":54877},[],"`PUT` always validates the signer, even when the request does not change it. If the stored signer is no longer valid, no field of the role can be modified, not even the validity, until a valid one is set.",{"_3376":2159,"_29554":2126,"_20528":54879,"_5":14087,"_26889":54779,"_2862":54880},[],"Today the VA identifies the CRL by the CA's SKI, so two CAs with the same key (or a CA imported with an SKI that already exists) share a single role and a single CRL. Certificates from one of them may never appear in the list, and clients will reject it because the issuer does not match. Create each CA with its own key. If you already have CAs that share a key, review them before upgrading.",{"_3376":2160,"_29554":2126,"_20528":54882,"_5":14087,"_26889":54779,"_2862":54883},[],"`latest_crl` contains version, validity start and end. Versions are kept as PEM in object storage at `pki/va/crl/{subject_key_id}/{version}.crl`; the public endpoint returns DER.",{"_3376":2161,"_29554":2126,"_20528":54885,"_5":14087,"_26889":54783,"_2862":54886},[],"The VA identifies each CRL by the CA’s SKI, and the SKI is derived from its key. Two CAs with the same key have the same SKI and share a single VA role and a single CRL. This happens when a CA is created on an existing KMS key, or when a CA is imported whose certificate declares an SKI already in use. Lamassu takes the SKI of an imported certificate as-is and does not check that it corresponds to its public key. The first CA creates the role and the others keep it.",{"_3376":2162,"_29554":2126,"_20528":54888,"_5":14087,"_26889":54783,"_2862":54889},[],"The certificates of all of them point to `/crl/{ski}`, but the published list has the first CA as issuer and only includes its revocations. A verifier compares the CRL issuer with the issuer of the certificate it validates (RFC 5280, §6.3.2) and rejects the list if they differ. Depending on its policy, the certificate is blocked (*hard-fail*) or accepted even though it is revoked (*soft-fail*). Revocations of the secondary CAs do not appear in any list.",{"_3376":2163,"_29554":2126,"_20528":54891,"_5":14087,"_26889":54783,"_2862":54892},[],"If the first CA is deleted, CRL generation for the remaining one fails because the configured signer no longer matches a CA with that name. Until the role’s signer is updated to a certificate of the remaining CA, the last published list keeps being served until it expires (7 days by default).",{"_3376":2164,"_29554":2126,"_20528":54894,"_5":14087,"_26889":54783,"_2862":54895},[],"To detect the problem, compare the SKI of the CAs in the inventory: two with the same SKI are affected. To fix it, create a CA with its own key and reissue its certificates; those already issued keep the old URL and are not corrected until reissued. A CA imported with an SKI already in use does not replace the existing one as CRL issuer, because the issuer is resolved from the role’s signer. However, its own certificates point to that same URL and its revocations are not published. Until Lamassu rejects these imports, restrict the permission to import CAs as an interim control; it covers only the import path. Creating a CA with &#x2A;*Create New CA (Existing Key)** on a KMS key another CA already uses produces the same collision, so also avoid reusing keys across CAs. A per-CA CRL and the rejection of imports whose SKI collides with an existing CA are both proposed in lamassuiot#834, and neither is implemented yet.",{"_3376":2165,"_29554":2126,"_20528":54897,"_5":14087,"_26889":54787,"_2862":54898},[],"The VA scheduled job checks every role on each run and requests another list when the remaining validity of `latest_crl` is less than the interval between runs. The frequency is set in Helm with `services.va.job.crl.frequency` (default `0 * * * *`) and accepts a duration (`1h`) or a cron expression. A cron expression is converted into a constant interval equal to the time left until its next firing when the service starts, so it is not aligned with the clock. `refresh_interval` plays no part. Keep `validity` well above the interval: with a shorter validity, the list is regenerated on every cycle.",{"_3376":2166,"_29554":2126,"_20528":54900,"_5":14087,"_26889":54787,"_2862":54901},[],"If generation fails (for example, because of a role without a CA or an invalid signer), the job logs the warning `something went wrong while calculating CRL for CA <ski>` and retries on the next cycle. There is no other renewal path until the cause is fixed, and the last published list keeps being served until it expires. All of this depends on working jobs, storage and signing.",{"_3376":2167,"_29554":2126,"_20528":54903,"_5":14087,"_26889":54787,"_2862":54904},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths: if it fails (missing role, invalid signer), the event is retried and, once retries are exhausted, moves to the failed-events queue. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_3376":2168,"_29554":2126,"_20528":54906,"_5":14087,"_26889":54787,"_2862":54907},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_3376":2169,"_29554":2126,"_20528":54909,"_5":14087,"_26889":54791,"_2862":54910},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_3376":2170,"_29554":2126,"_20528":54912,"_5":14087,"_26889":54791,"_2862":54913},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_3376":2171,"_29554":2126,"_20528":54915,"_5":14087,"_26889":54795,"_2862":54916},[],"The VA service exposes `GET /crl/{subject_key_id}` without management authorization. Use the **issuing CA’s** SKI, not the end-entity certificate’s SKI or serial. First inspect the certificate’s CDP:",{"_3376":2172,"_29554":2126,"_20528":54918,"_5":14087,"_26889":54795,"_2862":54919},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_3376":2173,"_29554":2126,"_20528":54921,"_5":14087,"_26889":54795,"_2862":54922},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_3376":2174,"_29554":2126,"_20528":54924,"_5":14087,"_26889":54795,"_2862":54925},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_3376":2175,"_29554":2126,"_20528":54927,"_5":14087,"_26889":54795,"_2862":54928},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_3376":2176,"_29554":2126,"_20528":54930,"_5":14087,"_26889":54799,"_2862":54931},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_3376":2177,"_29554":2126,"_20528":54933,"_5":14087,"_26889":54799,"_2862":51383},[],{"_3376":2178,"_29554":2126,"_20528":54935,"_5":14087,"_26889":54799,"_2862":54936},[],"Relative path",{"_3376":2179,"_29554":2126,"_20528":54938,"_5":14087,"_26889":54799,"_2862":51380},[],{"_3376":2180,"_29554":2126,"_20528":54940,"_5":14087,"_26889":54799,"_2862":54941},[],"`GET`",{"_3376":2181,"_29554":2126,"_20528":54943,"_5":14087,"_26889":54799,"_2862":54944},[],"`/v1/roles/{ca-ski}`",{"_3376":2182,"_29554":2126,"_20528":54946,"_5":14087,"_26889":54799,"_2862":54947},[],"Read `crl_options` and `latest_crl`.",{"_3376":2183,"_29554":2126,"_20528":54949,"_5":14087,"_26889":54799,"_2862":54950},[],"`PUT`",{"_3376":2184,"_29554":2126,"_20528":54952,"_5":14087,"_26889":54799,"_2862":54944},[],{"_3376":2185,"_29554":2126,"_20528":54954,"_5":14087,"_26889":54799,"_2862":54955},[],"Replace CRL configuration.",{"_3376":2186,"_29554":2126,"_20528":54957,"_5":14087,"_26889":54799,"_2862":54958},[],"You need authentication and role read or update permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract: the backend replaces `crl_options`; it does not merge omitted fields.",{"_3376":2187,"_29554":2126,"_20528":54960,"_5":14087,"_26889":54799,"_2862":54961},[],"After a change, check saved configuration and the next list actually published. Updating the role alone does not establish regeneration or client acceptance.",{"_3376":2188,"_29554":2126,"_20528":54963,"_5":14087,"_26889":54803,"_2862":54964},[],"Symptom",{"_3376":2189,"_29554":2126,"_20528":54966,"_5":14087,"_26889":54803,"_2862":54967},[],"Cause",{"_3376":2190,"_29554":2126,"_20528":54969,"_5":14087,"_26889":54803,"_2862":54970},[],"Action",{"_3376":2191,"_29554":2126,"_20528":54972,"_5":14087,"_26889":54803,"_2862":54973},[],"`PUT /v1/roles/{ca-ski}` returns 404 and `GET` returns 200.",{"_3376":2192,"_29554":2126,"_20528":54975,"_5":14087,"_26889":54803,"_2862":54976},[],"The role’s CA was deleted and no other CA with the same SKI remains.",{"_3376":2193,"_29554":2126,"_20528":54978,"_5":14087,"_26889":54803,"_2862":54979},[],"There is no API way out; it requires database intervention. Avoid it by adjusting the role before deleting the CA.",{"_3376":2194,"_29554":2126,"_20528":54981,"_5":14087,"_26889":54803,"_2862":54982},[],"`PUT` returns 400.",{"_3376":2195,"_29554":2126,"_20528":54984,"_5":14087,"_26889":54803,"_2862":54985},[],"The signer lacks `cRLSign`, or its subject and key match no CA with that SKI (for example, after deleting the first of two CAs that share a key).",{"_3376":2196,"_29554":2126,"_20528":54987,"_5":14087,"_26889":54803,"_2862":54988},[],"Use `PUT` to set the serial number of a valid certificate of the remaining CA.",{"_3376":2197,"_29554":2126,"_20528":54990,"_5":14087,"_26889":54803,"_2862":54991},[],"`PUT` returns 400 from a 3.x client.",{"_3376":2198,"_29554":2126,"_20528":54993,"_5":14087,"_26889":54803,"_2862":54994},[],"`crl_options.subject_key_id_signer` was replaced by `signer_certificate_serial_number`, which is required.",{"_3376":2199,"_29554":2126,"_20528":54996,"_5":14087,"_26889":54803,"_2862":54997},[],"Update the client to send the new field.",{"_3376":2200,"_29554":2126,"_20528":54999,"_5":14087,"_26889":54803,"_2862":55000},[],"The CRL does not change after revoking a certificate.",{"_3376":2201,"_29554":2126,"_20528":55002,"_5":14087,"_26889":54803,"_2862":55003},[],"`regenerate_on_revoke` is `false`, or the event failed because of a missing role or an invalid signer.",{"_3376":2202,"_29554":2126,"_20528":55005,"_5":14087,"_26889":54803,"_2862":55006},[],"Check the VA logs and the failed-events queue; fix the signer.",{"_3376":2203,"_29554":2126,"_20528":55008,"_5":14087,"_26889":54803,"_2862":55009},[],"A verifier rejects the CRL because of the issuer.",{"_3376":2204,"_29554":2126,"_20528":55011,"_5":14087,"_26889":54803,"_2862":55012},[],"Several CAs share an SKI.",{"_3376":2205,"_29554":2126,"_20528":55014,"_5":14087,"_26889":54803,"_2862":55015},[],"See CAs that share a key.",{"_3376":2206,"_29554":2126,"_20528":55017,"_5":14087,"_26889":54807,"_2862":55018},[],"The CA view lets you inspect and download the available list. Compare version, issuer and timestamps with the copy downloaded from the public endpoint. Diagnose differences using PKI troubleshooting.",{"_3376":2207,"_29554":2126,"_20528":55020,"_5":14087,"_26889":54811,"_2862":55021},[],"RFC 5280: X.509 and CRL profile.",{"_3376":2208,"_29554":2126,"_20528":55023,"_5":14087,"_26889":54811,"_2862":55024},[],"OpenSSL: openssl-crl.",{"_3376":2209,"_29554":2126,"_20528":55026,"_5":14087,"_26889":54811,"_2862":55027},[],"OpenSSL: openssl-verify.",{"_3376":2210,"_29554":2126,"_20528":55029,"_5":14087,"_26889":54811,"_2862":55030},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_3376":2211,"_29554":2126,"_20528":55032,"_5":14087,"_26889":54811,"_2862":55033},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3376":2212,"_29554":2212,"_5":14445,"_2862":55035,"_29906":55036,"_20528":55037,"_26889":2212},"Keys and cryptographic engines",[48148,49616,53625,53626],[],{"_3376":2213,"_29554":2212,"_20528":55039,"_5":14087,"_26889":2212,"_2862":55040},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_3376":2214,"_29554":2212,"_5":29903,"_20528":55042,"_26889":55043,"_2862":55044},[],"/docs/pr-preview/pr-52/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_3376":2215,"_29554":2212,"_5":29903,"_20528":55046,"_26889":55047,"_2862":55048},[],"/docs/pr-preview/pr-52/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_3376":2216,"_29554":2212,"_5":29903,"_20528":55050,"_26889":55051,"_2862":55052},[],"/docs/pr-preview/pr-52/platform/pki/key-management#file-system","File System",{"_3376":2217,"_29554":2212,"_5":29903,"_20528":55054,"_26889":55055,"_2862":55056},[],"/docs/pr-preview/pr-52/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3376":2218,"_29554":2212,"_5":29903,"_20528":55058,"_26889":55059,"_2862":55060},[],"/docs/pr-preview/pr-52/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3376":2219,"_29554":2212,"_5":29903,"_20528":55062,"_26889":55063,"_2862":55064},[],"/docs/pr-preview/pr-52/platform/pki/key-management#aws-kms","AWS KMS",{"_3376":2220,"_29554":2212,"_5":29903,"_20528":55066,"_26889":55067,"_2862":55068},[],"/docs/pr-preview/pr-52/platform/pki/key-management#pkcs11","PKCS#11",{"_3376":2221,"_29554":2212,"_5":29903,"_20528":55070,"_26889":55071,"_2862":55072},[],"/docs/pr-preview/pr-52/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_3376":2222,"_29554":2212,"_5":29903,"_20528":55074,"_26889":55075,"_2862":55076},[],"/docs/pr-preview/pr-52/platform/pki/key-management#key-inventory","Key inventory",{"_3376":2223,"_29554":2212,"_5":29903,"_20528":55078,"_26889":55079,"_2862":55080},[],"/docs/pr-preview/pr-52/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_3376":2224,"_29554":2212,"_5":29903,"_20528":55082,"_26889":55083,"_2862":55084},[],"/docs/pr-preview/pr-52/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_3376":2225,"_29554":2212,"_5":29903,"_20528":55086,"_26889":55087,"_2862":55088},[],"/docs/pr-preview/pr-52/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_3376":2226,"_29554":2212,"_5":29903,"_20528":55090,"_26889":55091,"_2862":55092},[],"/docs/pr-preview/pr-52/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_3376":2227,"_29554":2212,"_5":29903,"_20528":55094,"_26889":55095,"_2862":55096},[],"/docs/pr-preview/pr-52/platform/pki/key-management#view-details","View details",{"_3376":2228,"_29554":2212,"_5":29903,"_20528":55098,"_26889":55099,"_2862":55100},[],"/docs/pr-preview/pr-52/platform/pki/key-management#sign-and-verify","Sign and verify",{"_3376":2229,"_29554":2212,"_5":29903,"_20528":55102,"_26889":55103,"_2862":55104},[],"/docs/pr-preview/pr-52/platform/pki/key-management#sign","Sign",{"_3376":2230,"_29554":2212,"_5":29903,"_20528":55106,"_26889":55107,"_2862":55108},[],"/docs/pr-preview/pr-52/platform/pki/key-management#verify","Verify",{"_3376":2231,"_29554":2212,"_5":29903,"_20528":55110,"_26889":55111,"_2862":55112},[],"/docs/pr-preview/pr-52/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_3376":2232,"_29554":2212,"_5":29903,"_20528":55114,"_26889":55115,"_2862":55116},[],"/docs/pr-preview/pr-52/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_3376":2233,"_29554":2212,"_5":29903,"_20528":55118,"_26889":55119,"_2862":55120},[],"/docs/pr-preview/pr-52/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_3376":2234,"_29554":2212,"_20528":55122,"_5":14087,"_26889":2212,"_2862":55123},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_3376":2235,"_29554":2212,"_20528":55125,"_5":14087,"_26889":2212,"_2862":55126},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_3376":2236,"_29554":2212,"_20528":55128,"_5":14087,"_26889":55043,"_2862":55129},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_3376":2237,"_29554":2212,"_20528":55131,"_5":14087,"_26889":55043,"_2862":55132},[],"In practice, it lets you:",{"_3376":2238,"_29554":2212,"_20528":55134,"_5":14087,"_26889":55043,"_2862":55135},[],"Generate new key pairs from Lamassu IoT.",{"_3376":2239,"_29554":2212,"_20528":55137,"_5":14087,"_26889":55043,"_2862":55138},[],"Import keys created externally.",{"_3376":2240,"_29554":2212,"_20528":55140,"_5":14087,"_26889":55043,"_2862":55141},[],"Delegate custody and cryptographic operations to external engines.",{"_3376":2241,"_29554":2212,"_20528":55143,"_5":14087,"_26889":55043,"_2862":55144},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_3376":2242,"_29554":2212,"_20528":55146,"_5":14087,"_26889":55047,"_2862":55147},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_3376":2243,"_29554":2212,"_20528":55149,"_5":14087,"_26889":55047,"_2862":55150},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_3376":2244,"_29554":2212,"_20528":55152,"_5":14087,"_26889":55047,"_2862":55153},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_3376":2245,"_29554":2212,"_20528":55155,"_5":14087,"_26889":55051,"_2862":55156},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_3376":2246,"_29554":2212,"_20528":55158,"_5":14087,"_26889":55055,"_2862":55159},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_3376":2247,"_29554":2212,"_20528":55161,"_5":14087,"_26889":55055,"_2862":55162},[],"The adapter reaches Vault over its configured HTTP(S) endpoint. The Vault server certificate is verified against the system trust store; a Vault signed by a private CA is trusted by adding its CA certificate to the engine's `ca_cert_file` (PEM-encoded). `insecure_skip_verify=true` disables verification and is a last resort; agree the transport settings with the deployment owner.",{"_3376":2248,"_29554":2212,"_20528":55164,"_5":14087,"_26889":55059,"_2862":55165},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_3376":2249,"_29554":2212,"_20528":55167,"_5":14087,"_26889":55063,"_2862":55168},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_3376":2250,"_29554":2212,"_20528":55170,"_5":14087,"_26889":55067,"_2862":55171},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_3376":2251,"_29554":2212,"_20528":55173,"_5":14087,"_26889":55071,"_2862":55174},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_3376":2252,"_29554":2212,"_20528":55176,"_5":14087,"_26889":55071,"_2862":55177},[],"Lamassu shows the enabled engines in the console.",{"_3376":2253,"_29554":2212,"_20528":55179,"_5":14087,"_26889":55071,"_2862":55180},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_3376":2254,"_29554":2212,"_20528":55182,"_5":14087,"_26889":55071,"_2862":55183},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_3376":2255,"_29554":2212,"_20528":55185,"_5":14087,"_26889":55075,"_2862":55186},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_3376":2256,"_29554":2212,"_20528":55188,"_5":14087,"_26889":55075,"_2862":55189},[],"The table includes the following fields:",{"_3376":2257,"_29554":2212,"_20528":55191,"_5":14087,"_26889":55075,"_2862":55192},[],"**Name**: descriptive name of the key.",{"_3376":2258,"_29554":2212,"_20528":55194,"_5":14087,"_26889":55075,"_2862":55195},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_3376":2259,"_29554":2212,"_20528":55197,"_5":14087,"_26889":55075,"_2862":55198},[],"**Strength**: visual indicator of cryptographic strength.",{"_3376":2260,"_29554":2212,"_20528":55200,"_5":14087,"_26889":55075,"_2862":55201},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_3376":2261,"_29554":2212,"_20528":55203,"_5":14087,"_26889":55075,"_2862":55204},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_3376":2262,"_29554":2212,"_20528":55206,"_5":14087,"_26889":55075,"_2862":55207},[],"**Aliases**: alternative names associated with the key.",{"_3376":2263,"_29554":2212,"_20528":55209,"_5":14087,"_26889":55075,"_2862":55210},[],"**Tags**: labels for classification and search.",{"_3376":2264,"_29554":2212,"_20528":55212,"_5":14087,"_26889":55075,"_2862":55213},[],"**Related Entities**: certificates or other entities linked to that key.",{"_3376":2265,"_29554":2212,"_20528":55215,"_5":14087,"_26889":55075,"_2862":55216},[],"From this view you also reach the most common actions:",{"_3376":2266,"_29554":2212,"_20528":55218,"_5":14087,"_26889":55075,"_2862":55219},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_3376":2267,"_29554":2212,"_20528":55221,"_5":14087,"_26889":55075,"_2862":55222},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_3376":2268,"_29554":2212,"_20528":55224,"_5":14087,"_26889":55075,"_2862":55225},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_3376":2269,"_29554":2212,"_20528":55227,"_5":14087,"_26889":55075,"_2862":55228},[],"**Delete Key** to remove the key from the system.",{"_3376":2270,"_29554":2212,"_20528":55230,"_5":14087,"_26889":55079,"_2862":55231},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_3376":2271,"_29554":2212,"_20528":55233,"_5":14087,"_26889":55083,"_2862":55234},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_3376":2272,"_29554":2212,"_20528":55236,"_5":14087,"_26889":55083,"_2862":55237},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_3376":2273,"_29554":2212,"_20528":55239,"_5":14087,"_26889":55083,"_2862":55240},[],"**Key Name**: unique and descriptive name.",{"_3376":2274,"_29554":2212,"_20528":55242,"_5":14087,"_26889":55083,"_2862":55243},[],"**Crypto Engine**: engine that will keep the key.",{"_3376":2275,"_29554":2212,"_20528":55245,"_5":14087,"_26889":55083,"_2862":55246},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_3376":2276,"_29554":2212,"_20528":55248,"_5":14087,"_26889":55083,"_2862":55249},[],"**Tags**: metadata to classify the key.",{"_3376":2277,"_29554":2212,"_20528":55251,"_5":14087,"_26889":55083,"_2862":55252},[],"**Metadata**: additional information for advanced uses.",{"_3376":2278,"_29554":2212,"_20528":55254,"_5":14087,"_26889":55087,"_2862":55255},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_3376":2279,"_29554":2212,"_20528":55257,"_5":14087,"_26889":55087,"_2862":55258},[],"When you have an exportable private key and the destination engine supports import.",{"_3376":2280,"_29554":2212,"_20528":55260,"_5":14087,"_26889":55087,"_2862":55261},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_3376":2281,"_29554":2212,"_20528":55263,"_5":14087,"_26889":55087,"_2862":55264},[],"When Lamassu must operate with a root of trust created by a third party.",{"_3376":2282,"_29554":2212,"_20528":55266,"_5":14087,"_26889":55087,"_2862":55267},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_3376":2283,"_29554":2212,"_20528":55269,"_5":14087,"_26889":55087,"_2862":55270},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_3376":2284,"_29554":2212,"_20528":55272,"_5":14087,"_26889":55087,"_2862":55273},[],"**Crypto Engine**: engine that will keep the imported key.",{"_3376":2285,"_29554":2212,"_20528":55275,"_5":14087,"_26889":55087,"_2862":55276},[],"**Tags**: labels for organization and search.",{"_3376":2286,"_29554":2212,"_20528":55278,"_5":14087,"_26889":55087,"_2862":55279},[],"**Metadata**: additional optional information.",{"_3376":2287,"_29554":2212,"_20528":55281,"_5":14087,"_26889":55087,"_2862":55282},[],"**Private Key (PEM)**: private key in PEM format.",{"_3376":2288,"_29554":2212,"_20528":55284,"_5":14087,"_26889":55087,"_2862":55285},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_3376":2289,"_29554":2212,"_20528":55287,"_5":14087,"_26889":55091,"_2862":55288},[],"Each registered key has a detail view and several operational actions.",{"_3376":2290,"_29554":2212,"_20528":55290,"_5":14087,"_26889":55095,"_2862":55291},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_3376":2291,"_29554":2212,"_20528":55293,"_5":14087,"_26889":55095,"_2862":55294},[],"The **Overview** tab shows, among others, these fields:",{"_3376":2292,"_29554":2212,"_20528":55296,"_5":14087,"_26889":55095,"_2862":55297},[],"**Key Name**: descriptive name.",{"_3376":2293,"_29554":2212,"_20528":55299,"_5":14087,"_26889":55095,"_2862":55300},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_3376":2294,"_29554":2212,"_20528":55302,"_5":14087,"_26889":55095,"_2862":55303},[],"**Tags**: associated labels.",{"_3376":2295,"_29554":2212,"_20528":55305,"_5":14087,"_26889":55095,"_2862":55306},[],"**Aliases**: alternative names.",{"_3376":2296,"_29554":2212,"_20528":55308,"_5":14087,"_26889":55095,"_2862":55309},[],"**Crypto Engine**: engine where the key resides.",{"_3376":2297,"_29554":2212,"_20528":55311,"_5":14087,"_26889":55095,"_2862":55312},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_3376":2298,"_29554":2212,"_20528":55314,"_5":14087,"_26889":55095,"_2862":55315},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_3376":2299,"_29554":2212,"_20528":55317,"_5":14087,"_26889":55095,"_2862":55318},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_3376":2300,"_29554":2212,"_20528":55320,"_5":14087,"_26889":55099,"_2862":55321},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_3376":2301,"_29554":2212,"_20528":55323,"_5":14087,"_26889":55099,"_2862":55324},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_3376":2302,"_29554":2212,"_20528":55326,"_5":14087,"_26889":55099,"_2862":55327},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_3376":2303,"_29554":2212,"_20528":55329,"_5":14087,"_26889":55103,"_2862":55330},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_3376":2304,"_29554":2212,"_20528":55332,"_5":14087,"_26889":55103,"_2862":55333},[],"Main fields:",{"_3376":2305,"_29554":2212,"_20528":55335,"_5":14087,"_26889":55103,"_2862":55336},[],"**Algorithm**: signing algorithm available for the key type.",{"_3376":2306,"_29554":2212,"_20528":55338,"_5":14087,"_26889":55103,"_2862":55339},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_3376":2307,"_29554":2212,"_20528":55341,"_5":14087,"_26889":55103,"_2862":55342},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_3376":2308,"_29554":2212,"_20528":55344,"_5":14087,"_26889":55103,"_2862":55345},[],"**Message**: content to sign.",{"_3376":2309,"_29554":2212,"_20528":55347,"_5":14087,"_26889":55103,"_2862":55348},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_3376":2310,"_29554":2212,"_20528":55350,"_5":14087,"_26889":55107,"_2862":55351},[],"This tab checks whether a signature corresponds to the associated public key.",{"_3376":2311,"_29554":2212,"_20528":55353,"_5":14087,"_26889":55107,"_2862":55333},[],{"_3376":2312,"_29554":2212,"_20528":55355,"_5":14087,"_26889":55107,"_2862":55356},[],"**Algorithm**: must match the algorithm used for the signature.",{"_3376":2313,"_29554":2212,"_20528":55358,"_5":14087,"_26889":55107,"_2862":55359},[],"**Message Type**: `Raw` or `Digest`.",{"_3376":2314,"_29554":2212,"_20528":55361,"_5":14087,"_26889":55107,"_2862":55362},[],"**Payload Encoding**: encoding of the message.",{"_3376":2315,"_29554":2212,"_20528":55364,"_5":14087,"_26889":55107,"_2862":55365},[],"**Message**: original message or hash.",{"_3376":2316,"_29554":2212,"_20528":55367,"_5":14087,"_26889":55107,"_2862":55368},[],"**Signature**: signature to check.",{"_3376":2317,"_29554":2212,"_20528":55370,"_5":14087,"_26889":55107,"_2862":55371},[],"**Result**: indicator of the validation result.",{"_3376":2318,"_29554":2212,"_20528":55373,"_5":14087,"_26889":55111,"_2862":55374},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_3376":2319,"_29554":2212,"_20528":55376,"_5":14087,"_26889":55111,"_2862":55377},[],"This flow is useful for:",{"_3376":2320,"_29554":2212,"_20528":55379,"_5":14087,"_26889":55111,"_2862":55380},[],"Requesting certificates from an external CA.",{"_3376":2321,"_29554":2212,"_20528":55382,"_5":14087,"_26889":55111,"_2862":55383},[],"Renewing an identity while keeping the same key.",{"_3376":2322,"_29554":2212,"_20528":55385,"_5":14087,"_26889":55111,"_2862":55386},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_3376":2323,"_29554":2212,"_20528":55388,"_5":14087,"_26889":55111,"_2862":55389},[],"**Common Name (CN)**: main name of the identity.",{"_3376":2324,"_29554":2212,"_20528":55391,"_5":14087,"_26889":55111,"_2862":55392},[],"**Organization (O)**: organization or company.",{"_3376":2325,"_29554":2212,"_20528":55394,"_5":14087,"_26889":55111,"_2862":55395},[],"**Organizational Unit (OU)**: department or unit.",{"_3376":2326,"_29554":2212,"_20528":55397,"_5":14087,"_26889":55111,"_2862":55398},[],"**Country (C)**: two-letter country code.",{"_3376":2327,"_29554":2212,"_20528":55400,"_5":14087,"_26889":55111,"_2862":55401},[],"**State / Province (ST)**: state or province.",{"_3376":2328,"_29554":2212,"_20528":55403,"_5":14087,"_26889":55111,"_2862":55404},[],"**Locality (L)**: city or locality.",{"_3376":2329,"_29554":2212,"_20528":55406,"_5":14087,"_26889":55111,"_2862":55407},[],"**Email Address**: contact email.",{"_3376":2330,"_29554":2212,"_20528":55409,"_5":14087,"_26889":55111,"_2862":55410},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_3376":2331,"_29554":2212,"_20528":55412,"_5":14087,"_26889":55111,"_2862":55413},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_3376":2332,"_29554":2212,"_20528":55415,"_5":14087,"_26889":55115,"_2862":55416},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_3376":2333,"_29554":2212,"_20528":55418,"_5":14087,"_26889":55115,"_2862":55419},[],"It requires the module, token and permissions of the corresponding provider. Check that the Lamassu identifier matches the object accessible from that module. Module configuration belongs to the client environment or Deployment.",{"_3376":2334,"_29554":2212,"_20528":55421,"_5":14087,"_26889":55119,"_2862":55422},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_3376":2335,"_29554":2212,"_20528":55424,"_5":14087,"_26889":55119,"_2862":55425},[],"The KMS refuses to delete a key that certificates still reference. Deleting a CA releases the references from its own current certificate and linked reissued certificates, then attempts to delete the key. If other certificates still reference the key, such as another CA sharing it, the KMS keeps it. Revoking certificates issued by the deleted CA does not release their own key references. Legacy references retained by the upgrade migration are described in the upgrade guide.",{"_3376":2336,"_29554":2336,"_5":14445,"_2862":55427,"_29906":55428,"_20528":55429,"_26889":2336},"Online validation with OCSP",[48148,49616,53625,54258],[],{"_3376":2337,"_29554":2336,"_20528":55431,"_5":14087,"_26889":2336,"_2862":55432},[],"Query signed status and verify the responder’s response.",{"_3376":2338,"_29554":2336,"_5":29903,"_20528":55434,"_26889":55435,"_2862":55436},[],"/docs/pr-preview/pr-52/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_3376":2339,"_29554":2336,"_5":29903,"_20528":55438,"_26889":55439,"_2862":55440},[],"/docs/pr-preview/pr-52/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_3376":2340,"_29554":2336,"_5":29903,"_20528":55442,"_26889":55443,"_2862":55444},[],"/docs/pr-preview/pr-52/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_3376":2341,"_29554":2336,"_5":29903,"_20528":55446,"_26889":55447,"_2862":55448},[],"/docs/pr-preview/pr-52/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_3376":2342,"_29554":2336,"_5":29903,"_20528":55450,"_26889":55451,"_2862":55452},[],"/docs/pr-preview/pr-52/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_3376":2343,"_29554":2336,"_5":29903,"_20528":55454,"_26889":55455,"_2862":54812},[],"/docs/pr-preview/pr-52/platform/pki/ocsp#references",{"_3376":2344,"_29554":2336,"_20528":55457,"_5":14087,"_26889":2336,"_2862":55458},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_3376":2345,"_29554":2336,"_20528":55460,"_5":14087,"_26889":55435,"_2862":55461},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_3376":2346,"_29554":2336,"_20528":55463,"_5":14087,"_26889":55435,"_2862":55464},[],"Record status",{"_3376":2347,"_29554":2336,"_20528":55466,"_5":14087,"_26889":55435,"_2862":55467},[],"Signed response",{"_3376":2348,"_29554":2336,"_20528":55469,"_5":14087,"_26889":55435,"_2862":52796},[],{"_3376":2349,"_29554":2336,"_20528":55471,"_5":14087,"_26889":55435,"_2862":55472},[],"`Good`.",{"_3376":2350,"_29554":2336,"_20528":55474,"_5":14087,"_26889":55435,"_2862":52813},[],{"_3376":2351,"_29554":2336,"_20528":55476,"_5":14087,"_26889":55435,"_2862":55477},[],"`Revoked`, with revocation reason and timestamp.",{"_3376":2352,"_29554":2336,"_20528":55479,"_5":14087,"_26889":55435,"_2862":55480},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_3376":2353,"_29554":2336,"_20528":55482,"_5":14087,"_26889":55435,"_2862":55483},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_3376":2354,"_29554":2336,"_20528":55485,"_5":14087,"_26889":55435,"_2862":55486},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_3376":2355,"_29554":2336,"_20528":55488,"_5":14087,"_26889":55435,"_2862":55489},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_3376":2356,"_29554":2336,"_20528":55491,"_5":14087,"_26889":55435,"_2862":55492},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_3376":2357,"_29554":2336,"_20528":55494,"_5":14087,"_26889":55439,"_2862":55495},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_3376":2358,"_29554":2336,"_20528":55497,"_5":14087,"_26889":55439,"_2862":55498},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_3376":2359,"_29554":2336,"_20528":55500,"_5":14087,"_26889":55443,"_2862":55501},[],"The service accepts:",{"_3376":2360,"_29554":2336,"_20528":55503,"_5":14087,"_26889":55443,"_2862":51383},[],{"_3376":2361,"_29554":2336,"_20528":55505,"_5":14087,"_26889":55443,"_2862":55506},[],"VA service path",{"_3376":2362,"_29554":2336,"_20528":55508,"_5":14087,"_26889":55443,"_2862":55509},[],"Format",{"_3376":2363,"_29554":2336,"_20528":55511,"_5":14087,"_26889":55443,"_2862":55512},[],"`POST`",{"_3376":2364,"_29554":2336,"_20528":55514,"_5":14087,"_26889":55443,"_2862":55515},[],"`/ocsp`",{"_3376":2365,"_29554":2336,"_20528":55517,"_5":14087,"_26889":55443,"_2862":55518},[],"DER request, `Content-Type: application/ocsp-request`.",{"_3376":2366,"_29554":2336,"_20528":55520,"_5":14087,"_26889":55443,"_2862":54941},[],{"_3376":2367,"_29554":2336,"_20528":55522,"_5":14087,"_26889":55443,"_2862":55523},[],"`/ocsp/{ocsp_request}`",{"_3376":2368,"_29554":2336,"_20528":55525,"_5":14087,"_26889":55443,"_2862":55526},[],"DER request encoded using padded URL Base64.",{"_3376":2369,"_29554":2336,"_20528":55528,"_5":14087,"_26889":55443,"_2862":55529},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_3376":2370,"_29554":2336,"_20528":55531,"_5":14087,"_26889":55447,"_2862":55532},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_3376":2371,"_29554":2336,"_20528":55534,"_5":14087,"_26889":55447,"_2862":55535},[],"Generate the request:",{"_3376":2372,"_29554":2336,"_20528":55537,"_5":14087,"_26889":55447,"_2862":55538},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_3376":2373,"_29554":2336,"_20528":55540,"_5":14087,"_26889":55447,"_2862":55541},[],"Replace the example URL with the inspected endpoint:",{"_3376":2374,"_29554":2336,"_20528":55543,"_5":14087,"_26889":55447,"_2862":55544},[],"Verify the returned DER:",{"_3376":2375,"_29554":2336,"_20528":55546,"_5":14087,"_26889":55447,"_2862":55547},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_3376":2376,"_29554":2336,"_20528":55549,"_5":14087,"_26889":55451,"_2862":55550},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_3376":2377,"_29554":2336,"_20528":55552,"_5":14087,"_26889":55451,"_2862":55553},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_3376":2378,"_29554":2336,"_20528":55555,"_5":14087,"_26889":55455,"_2862":55556},[],"RFC 6960: OCSP.",{"_3376":2379,"_29554":2336,"_20528":55558,"_5":14087,"_26889":55455,"_2862":55559},[],"OpenSSL: openssl-ocsp.",{"_3376":2380,"_29554":2336,"_20528":55561,"_5":14087,"_26889":55455,"_2862":55562},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_3376":2381,"_29554":2336,"_20528":55564,"_5":14087,"_26889":55455,"_2862":55033},[],{"_3376":2382,"_29554":2382,"_5":14445,"_2862":53625,"_29906":55566,"_20528":55567,"_26889":2382},[48148,49616,53625],[],{"_3376":2383,"_29554":2382,"_20528":55569,"_5":14087,"_26889":2382,"_2862":55570},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_3376":2384,"_29554":2382,"_5":29903,"_20528":55572,"_26889":55573,"_2862":52937},[],"/docs/pr-preview/pr-52/platform/pki/overview#start-here",{"_3376":2385,"_29554":2382,"_5":29903,"_20528":55575,"_26889":55576,"_2862":55577},[],"/docs/pr-preview/pr-52/platform/pki/overview#what-you-need","What you need",{"_3376":2386,"_29554":2382,"_5":29903,"_20528":55579,"_26889":55580,"_2862":53469},[],"/docs/pr-preview/pr-52/platform/pki/overview#core-capabilities",{"_3376":2387,"_29554":2382,"_5":29903,"_20528":55582,"_26889":55583,"_2862":53473},[],"/docs/pr-preview/pr-52/platform/pki/overview#build-your-trust-hierarchy",{"_3376":2388,"_29554":2382,"_5":29903,"_20528":55585,"_26889":55586,"_2862":53477},[],"/docs/pr-preview/pr-52/platform/pki/overview#protect-cryptographic-keys",{"_3376":2389,"_29554":2382,"_5":29903,"_20528":55588,"_26889":55589,"_2862":53481},[],"/docs/pr-preview/pr-52/platform/pki/overview#issue-and-control-certificates",{"_3376":2390,"_29554":2382,"_5":29903,"_20528":55591,"_26889":55592,"_2862":53489},[],"/docs/pr-preview/pr-52/platform/pki/overview#publish-validation-status",{"_3376":2391,"_29554":2382,"_5":29903,"_20528":55594,"_26889":55595,"_2862":55596},[],"/docs/pr-preview/pr-52/platform/pki/overview#how-to-check-the-result","How to check the result",{"_3376":2392,"_29554":2382,"_5":29903,"_20528":55598,"_26889":55599,"_2862":54425},[],"/docs/pr-preview/pr-52/platform/pki/overview#continue",{"_3376":2393,"_29554":2382,"_20528":55601,"_5":14087,"_26889":2382,"_2862":55602},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_3376":2394,"_29554":2382,"_20528":55604,"_5":14087,"_26889":55573,"_2862":55605},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_3376":2395,"_29554":2382,"_20528":55607,"_5":14087,"_26889":55573,"_2862":55608},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_3376":2396,"_29554":2382,"_20528":55610,"_5":14087,"_26889":55576,"_2862":55611},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_3376":2397,"_29554":2382,"_20528":55613,"_5":14087,"_26889":55576,"_2862":55614},[],"An available cryptographic engine to keep the authority's key.",{"_3376":2398,"_29554":2382,"_20528":55616,"_5":14087,"_26889":55576,"_2862":55617},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_3376":2399,"_29554":2382,"_20528":55619,"_5":14087,"_26889":55576,"_2862":55620},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_3376":2400,"_29554":2382,"_20528":55622,"_5":14087,"_26889":55576,"_2862":55623},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_3376":2401,"_29554":2382,"_20528":55625,"_5":14087,"_26889":55583,"_2862":55626},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_3376":2402,"_29554":2382,"_20528":55628,"_5":14087,"_26889":55586,"_2862":55629},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_3376":2403,"_29554":2382,"_20528":55631,"_5":14087,"_26889":55589,"_2862":55632},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_3376":2404,"_29554":2382,"_20528":55634,"_5":14087,"_26889":55592,"_2862":55635},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_3376":2405,"_29554":2382,"_20528":55637,"_5":14087,"_26889":55595,"_2862":55638},[],"An active certificate in the console is one part of the check. Also verify that:",{"_3376":2406,"_29554":2382,"_20528":55640,"_5":14087,"_26889":55595,"_2862":55641},[],"its subject and extensions identify the expected client;",{"_3376":2407,"_29554":2382,"_20528":55643,"_5":14087,"_26889":55595,"_2862":55644},[],"its public key matches the client's private key;",{"_3376":2408,"_29554":2382,"_20528":55646,"_5":14087,"_26889":55595,"_2862":55647},[],"its chain reaches a root trusted by the consumer;",{"_3376":2409,"_29554":2382,"_20528":55649,"_5":14087,"_26889":55595,"_2862":55650},[],"its dates and usages allow the operation;",{"_3376":2410,"_29554":2382,"_20528":55652,"_5":14087,"_26889":55595,"_2862":55653},[],"the consumer applies revocation checks and authorization.",{"_3376":2411,"_29554":2382,"_20528":55655,"_5":14087,"_26889":55595,"_2862":55656},[],"The issuance path includes the first independent checks.",{"_3376":2412,"_29554":2382,"_20528":55658,"_5":14087,"_26889":55599,"_2862":55659},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3376":2413,"_29554":2382,"_20528":55661,"_5":14087,"_26889":55599,"_2862":55662},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3376":2414,"_29554":2382,"_20528":55664,"_5":14087,"_26889":55599,"_2862":55665},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3376":2415,"_29554":2415,"_5":14445,"_2862":55667,"_29906":55668,"_20528":55669,"_26889":2415},"Create your first CA",[48148,49616,53625,53062],[],{"_3376":2416,"_29554":2415,"_20528":55671,"_5":14087,"_26889":2415,"_2862":55672},[],"Create an evaluation root and check its certificate before issuing.",{"_3376":2417,"_29554":2415,"_5":29903,"_20528":55674,"_26889":55675,"_2862":48158},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_3376":2418,"_29554":2415,"_5":29903,"_20528":55677,"_26889":55678,"_2862":55679},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard-toc","Open the creation wizard [!toc]",{"_3376":2419,"_29554":2415,"_5":29903,"_20528":55681,"_26889":55682,"_2862":55683},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/create-certificate-authority#select-the-key-toc","Select the key [!toc]",{"_3376":2420,"_29554":2415,"_5":29903,"_20528":55685,"_26889":55686,"_2862":55687},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/create-certificate-authority#define-the-authority-toc","Define the authority [!toc]",{"_3376":2421,"_29554":2415,"_5":29903,"_20528":55689,"_26889":55690,"_2862":55691},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca-toc","Review and create the CA [!toc]",{"_3376":2422,"_29554":2415,"_5":29903,"_20528":55693,"_26889":55694,"_2862":55695},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/create-certificate-authority#verify-the-result-toc","Verify the result [!toc]",{"_3376":2423,"_29554":2415,"_5":29903,"_20528":55697,"_26889":55698,"_2862":55699},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_3376":2424,"_29554":2415,"_5":29903,"_20528":55701,"_26889":55702,"_2862":53319},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_3376":2425,"_29554":2415,"_5":29903,"_20528":55704,"_26889":55705,"_2862":48182},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/create-certificate-authority#next-step",{"_3376":2426,"_29554":2415,"_20528":55707,"_5":14087,"_26889":2415,"_2862":55708},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_3376":2427,"_29554":2415,"_20528":55710,"_5":14087,"_26889":55675,"_2862":55711},[],"Console access and permission to create keys and authorities.",{"_3376":2428,"_29554":2415,"_20528":55713,"_5":14087,"_26889":55675,"_2862":55714},[],"An available cryptographic engine that supports the chosen algorithm.",{"_3376":2429,"_29554":2415,"_20528":55716,"_5":14087,"_26889":55675,"_2862":55717},[],"OpenSSL 3.x to check the downloaded certificate.",{"_3376":2430,"_29554":2415,"_20528":55719,"_5":14087,"_26889":55675,"_2862":55720},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_3376":2431,"_29554":2415,"_20528":55722,"_5":14087,"_26889":55678,"_2862":55723},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_3376":2432,"_29554":2415,"_20528":55725,"_5":14087,"_26889":55678,"_2862":55726},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_3376":2433,"_29554":2415,"_20528":55728,"_5":14087,"_26889":55682,"_2862":55729},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_3376":2434,"_29554":2415,"_20528":55731,"_5":14087,"_26889":55682,"_2862":55732},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_3376":2435,"_29554":2415,"_20528":55734,"_5":14087,"_26889":55686,"_2862":55735},[],"Select **Root CA** and complete:",{"_3376":2436,"_29554":2415,"_20528":55737,"_5":14087,"_26889":55686,"_2862":55738},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_3376":2437,"_29554":2415,"_20528":55740,"_5":14087,"_26889":55686,"_2862":55741},[],"**Subject**: organization and country details for your evaluation.",{"_3376":2438,"_29554":2415,"_20528":55743,"_5":14087,"_26889":55686,"_2862":55744},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_3376":2439,"_29554":2415,"_20528":55746,"_5":14087,"_26889":55686,"_2862":55747},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_3376":2440,"_29554":2415,"_20528":55749,"_5":14087,"_26889":55686,"_2862":55750},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_3376":2441,"_29554":2415,"_20528":55752,"_5":14087,"_26889":55690,"_2862":55753},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_3376":2442,"_29554":2415,"_20528":55755,"_5":14087,"_26889":55694,"_2862":55756},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_3376":2443,"_29554":2415,"_20528":55758,"_5":14087,"_26889":55694,"_2862":55759},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_3376":2444,"_29554":2415,"_20528":55761,"_5":14087,"_26889":55698,"_2862":55762},[],"Run from the directory where you saved `ca.pem`:",{"_3376":2445,"_29554":2415,"_20528":55764,"_5":14087,"_26889":55698,"_2862":55765},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_3376":2446,"_29554":2415,"_20528":55767,"_5":14087,"_26889":55698,"_2862":55768},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_3376":2447,"_29554":2415,"_20528":55770,"_5":14087,"_26889":55702,"_2862":55771},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_3376":2448,"_29554":2415,"_20528":55773,"_5":14087,"_26889":55702,"_2862":55774},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_3376":2449,"_29554":2415,"_20528":55776,"_5":14087,"_26889":55702,"_2862":55777},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_3376":2450,"_29554":2415,"_20528":55779,"_5":14087,"_26889":55702,"_2862":55780},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_3376":2451,"_29554":2415,"_20528":55782,"_5":14087,"_26889":55705,"_2862":55783},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_3376":2452,"_29554":2452,"_5":14445,"_2862":55785,"_29906":55786,"_20528":55787,"_26889":2452},"Issue and verify a certificate",[48148,49616,53625,53062],[],{"_3376":2453,"_29554":2452,"_20528":55789,"_5":14087,"_26889":2452,"_2862":55790},[],"Issue a client certificate and check content, chain and key correspondence.",{"_3376":2454,"_29554":2452,"_5":29903,"_20528":55792,"_26889":55793,"_2862":48158},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_3376":2455,"_29554":2452,"_5":29903,"_20528":55795,"_26889":55796,"_2862":55797},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_3376":2456,"_29554":2452,"_5":29903,"_20528":55799,"_26889":55800,"_2862":55801},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_3376":2457,"_29554":2452,"_5":29903,"_20528":55803,"_26889":55804,"_2862":55805},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_3376":2458,"_29554":2452,"_5":29903,"_20528":55807,"_26889":55808,"_2862":55809},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_3376":2459,"_29554":2452,"_5":29903,"_20528":55811,"_26889":55812,"_2862":55813},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_3376":2460,"_29554":2452,"_5":29903,"_20528":55815,"_26889":55816,"_2862":55817},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/issue-certificate#verify-the-result","Verify the result",{"_3376":2461,"_29554":2452,"_5":29903,"_20528":55819,"_26889":55820,"_2862":55821},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_3376":2462,"_29554":2452,"_5":29903,"_20528":55823,"_26889":55824,"_2862":55825},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_3376":2463,"_29554":2452,"_5":29903,"_20528":55827,"_26889":55828,"_2862":55829},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_3376":2464,"_29554":2452,"_5":29903,"_20528":55831,"_26889":55832,"_2862":53319},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_3376":2465,"_29554":2452,"_5":29903,"_20528":55834,"_26889":55835,"_2862":48182},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/issue-certificate#next-step",{"_3376":2466,"_29554":2452,"_20528":55837,"_5":14087,"_26889":2452,"_2862":55838},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_3376":2467,"_29554":2452,"_20528":55840,"_5":14087,"_26889":55793,"_2862":55841},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_3376":2468,"_29554":2452,"_20528":55843,"_5":14087,"_26889":55793,"_2862":55844},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_3376":2469,"_29554":2452,"_20528":55846,"_5":14087,"_26889":55793,"_2862":55847},[],"OpenSSL 3.x and a working directory with restricted access.",{"_3376":2470,"_29554":2452,"_20528":55849,"_5":14087,"_26889":55793,"_2862":55850},[],"A client identifier: here we use `device-001`.",{"_3376":2471,"_29554":2452,"_20528":55852,"_5":14087,"_26889":55793,"_2862":55853},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_3376":2472,"_29554":2452,"_20528":55855,"_5":14087,"_26889":55796,"_2862":55856},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_3376":2473,"_29554":2452,"_20528":55858,"_5":14087,"_26889":55800,"_2862":55859},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_3376":2474,"_29554":2452,"_20528":55861,"_5":14087,"_26889":55800,"_2862":55862},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_3376":2475,"_29554":2452,"_20528":55864,"_5":14087,"_26889":55804,"_2862":55865},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_3376":2476,"_29554":2452,"_20528":55867,"_5":14087,"_26889":55804,"_2862":55868},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_3376":2477,"_29554":2452,"_20528":55870,"_5":14087,"_26889":55808,"_2862":55871},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_3376":2478,"_29554":2452,"_20528":55873,"_5":14087,"_26889":55808,"_2862":55874},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_3376":2479,"_29554":2452,"_20528":55876,"_5":14087,"_26889":55812,"_2862":55877},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_3376":2480,"_29554":2452,"_20528":55879,"_5":14087,"_26889":55816,"_2862":55880},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_3376":2481,"_29554":2452,"_20528":55882,"_5":14087,"_26889":55820,"_2862":55883},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_3376":2482,"_29554":2452,"_20528":55885,"_5":14087,"_26889":55824,"_2862":55886},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_3376":2483,"_29554":2452,"_20528":55888,"_5":14087,"_26889":55824,"_2862":55889},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_3376":2484,"_29554":2452,"_20528":55891,"_5":14087,"_26889":55824,"_2862":55892},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_3376":2485,"_29554":2452,"_20528":55894,"_5":14087,"_26889":55828,"_2862":55895},[],"In Bash, compare the two public-key digests:",{"_3376":2486,"_29554":2452,"_20528":55897,"_5":14087,"_26889":55828,"_2862":55898},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_3376":2487,"_29554":2452,"_20528":55900,"_5":14087,"_26889":55828,"_2862":55901},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_3376":2488,"_29554":2452,"_20528":55903,"_5":14087,"_26889":55832,"_2862":53403},[],{"_3376":2489,"_29554":2452,"_20528":55905,"_5":14087,"_26889":55832,"_2862":55906},[],"What to review",{"_3376":2490,"_29554":2452,"_20528":55908,"_5":14087,"_26889":55832,"_2862":55909},[],"The CA rejects issuance",{"_3376":2491,"_29554":2452,"_20528":55911,"_5":14087,"_26889":55832,"_2862":55912},[],"Permissions, CA state and key, algorithm and profile.",{"_3376":2492,"_29554":2452,"_20528":55914,"_5":14087,"_26889":55832,"_2862":55915},[],"Different subject or usages",{"_3376":2493,"_29554":2452,"_20528":55917,"_5":14087,"_26889":55832,"_2862":55918},[],"Applied profile and requested values.",{"_3376":2494,"_29554":2452,"_20528":55920,"_5":14087,"_26889":55832,"_2862":55921},[],"Issuer cannot be found",{"_3376":2495,"_29554":2452,"_20528":55923,"_5":14087,"_26889":55832,"_2862":55924},[],"Downloaded CA and required intermediate chain.",{"_3376":2496,"_29554":2452,"_20528":55926,"_5":14087,"_26889":55832,"_2862":55927},[],"Validity fails",{"_3376":2497,"_29554":2452,"_20528":55929,"_5":14087,"_26889":55832,"_2862":55930},[],"Certificate and CA dates, and the computer's clock.",{"_3376":2498,"_29554":2452,"_20528":55932,"_5":14087,"_26889":55832,"_2862":55933},[],"Public-key digests differ",{"_3376":2499,"_29554":2452,"_20528":55935,"_5":14087,"_26889":55832,"_2862":55936},[],"Certificate and key files from the same issuance.",{"_3376":2500,"_29554":2452,"_20528":55938,"_5":14087,"_26889":55832,"_2862":55939},[],"See PKI diagnostics to narrow an issuance failure.",{"_3376":2501,"_29554":2452,"_20528":55941,"_5":14087,"_26889":55835,"_2862":55942},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_3376":2502,"_29554":2452,"_20528":55944,"_5":14087,"_26889":55835,"_2862":55945},[],"Manage certificates for inspection, status and revocation.",{"_3376":2503,"_29554":2452,"_20528":55947,"_5":14087,"_26889":55835,"_2862":55948},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_3376":2504,"_29554":2452,"_20528":55950,"_5":14087,"_26889":55835,"_2862":55951},[],"Prepare EST for the device to request its next identities.",{"_3376":2505,"_29554":2452,"_20528":55953,"_5":14087,"_26889":55835,"_2862":55954},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_3376":2506,"_29554":2506,"_5":14445,"_2862":55956,"_29906":55957,"_20528":55958,"_26889":2506},"PKI getting started",[48148,49616,53625,53062],[],{"_3376":2507,"_29554":2506,"_20528":55960,"_5":14087,"_26889":2506,"_2862":55961},[],"Create a CA, issue a client certificate and check its chain and key.",{"_3376":2508,"_29554":2506,"_5":29903,"_20528":55963,"_26889":55964,"_2862":48158},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/overview#before-you-begin",{"_3376":2509,"_29554":2506,"_5":29903,"_20528":55966,"_26889":55967,"_2862":55968},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_3376":2510,"_29554":2506,"_5":29903,"_20528":55970,"_26889":55971,"_2862":53254},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/overview#expected-result",{"_3376":2511,"_29554":2506,"_5":29903,"_20528":55973,"_26889":55974,"_2862":55975},[],"/docs/pr-preview/pr-52/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_3376":2512,"_29554":2506,"_20528":55977,"_5":14087,"_26889":2506,"_2862":55978},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_3376":2513,"_29554":2506,"_20528":55980,"_5":14087,"_26889":55964,"_2862":55981},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_3376":2514,"_29554":2506,"_20528":55983,"_5":14087,"_26889":55964,"_2862":55984},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_3376":2515,"_29554":2506,"_20528":55986,"_5":14087,"_26889":55964,"_2862":55987},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_3376":2516,"_29554":2506,"_20528":55989,"_5":14087,"_26889":55964,"_2862":55990},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_3376":2517,"_29554":2506,"_20528":55992,"_5":14087,"_26889":55964,"_2862":55993},[],"A working directory with restricted access for the downloaded key.",{"_3376":2518,"_29554":2506,"_20528":55995,"_5":14087,"_26889":55967,"_2862":55996},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3376":2519,"_29554":2506,"_20528":55998,"_5":14087,"_26889":55967,"_2862":55999},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3376":2520,"_29554":2506,"_20528":56001,"_5":14087,"_26889":55967,"_2862":56002},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_3376":2521,"_29554":2506,"_20528":56004,"_5":14087,"_26889":55967,"_2862":56005},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_3376":2522,"_29554":2506,"_20528":56007,"_5":14087,"_26889":55971,"_2862":56008},[],"File or resource",{"_3376":2523,"_29554":2506,"_20528":56010,"_5":14087,"_26889":55971,"_2862":53251},[],{"_3376":2524,"_29554":2506,"_20528":56012,"_5":14087,"_26889":55971,"_2862":56013},[],"Active root CA and `ca.pem`",{"_3376":2525,"_29554":2506,"_20528":56015,"_5":14087,"_26889":55971,"_2862":56016},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_3376":2526,"_29554":2506,"_20528":56018,"_5":14087,"_26889":55971,"_2862":56019},[],"End-entity certificate and `device.crt`",{"_3376":2527,"_29554":2506,"_20528":56021,"_5":14087,"_26889":55971,"_2862":56022},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_3376":2528,"_29554":2506,"_20528":56024,"_5":14087,"_26889":55971,"_2862":56025},[],"Private key `device.key`",{"_3376":2529,"_29554":2506,"_20528":56027,"_5":14087,"_26889":55971,"_2862":56028},[],"Its public key matches the one included in `device.crt`.",{"_3376":2530,"_29554":2506,"_20528":56030,"_5":14087,"_26889":55971,"_2862":56031},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_3376":2531,"_29554":2506,"_20528":56033,"_5":14087,"_26889":55974,"_2862":56034},[],"To operate certificates, continue with Certificates and Validation.",{"_3376":2532,"_29554":2506,"_20528":56036,"_5":14087,"_26889":55974,"_2862":56037},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_3376":2533,"_29554":2506,"_20528":56039,"_5":14087,"_26889":55974,"_2862":56040},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_3376":2534,"_29554":2534,"_5":14445,"_2862":56042,"_29906":56043,"_20528":56044,"_26889":2534},"PKI troubleshooting",[48148,49616,53625,52197],[],{"_3376":2535,"_29554":2534,"_20528":56046,"_5":14087,"_26889":2534,"_2862":56047},[],"Diagnose certificate issuance, OCSP and CRL.",{"_3376":2536,"_29554":2534,"_5":29903,"_20528":56049,"_26889":56050,"_2862":56051},[],"/docs/pr-preview/pr-52/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_3376":2537,"_29554":2534,"_5":29903,"_20528":56053,"_26889":56054,"_2862":56055},[],"/docs/pr-preview/pr-52/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_3376":2538,"_29554":2534,"_5":29903,"_20528":56057,"_26889":56058,"_2862":56059},[],"/docs/pr-preview/pr-52/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_3376":2539,"_29554":2534,"_20528":56061,"_5":14087,"_26889":2534,"_2862":56062},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_3376":2540,"_29554":2534,"_20528":56064,"_5":14087,"_26889":2534,"_2862":56065},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_3376":2541,"_29554":2534,"_20528":56067,"_5":14087,"_26889":56050,"_2862":53251},[],{"_3376":2542,"_29554":2534,"_20528":56069,"_5":14087,"_26889":56050,"_2862":56070},[],"What to inspect",{"_3376":2543,"_29554":2534,"_20528":56072,"_5":14087,"_26889":56050,"_2862":48182},[],{"_3376":2544,"_29554":2534,"_20528":56074,"_5":14087,"_26889":56050,"_2862":52464},[],{"_3376":2545,"_29554":2534,"_20528":56076,"_5":14087,"_26889":56050,"_2862":56077},[],"Exists, is active and has usable dates.",{"_3376":2546,"_29554":2534,"_20528":56079,"_5":14087,"_26889":56050,"_2862":56080},[],"Authorities.",{"_3376":2547,"_29554":2534,"_20528":56082,"_5":14087,"_26889":56050,"_2862":56083},[],"Key",{"_3376":2548,"_29554":2534,"_20528":56085,"_5":14087,"_26889":56050,"_2862":56086},[],"The record has a usable private key and the engine can sign.",{"_3376":2549,"_29554":2534,"_20528":56088,"_5":14087,"_26889":56050,"_2862":56089},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_3376":2550,"_29554":2534,"_20528":56091,"_5":14087,"_26889":56050,"_2862":56092},[],"CSR",{"_3376":2551,"_29554":2534,"_20528":56094,"_5":14087,"_26889":56050,"_2862":56095},[],"Correct PEM and verifiable signature.",{"_3376":2552,"_29554":2534,"_20528":56097,"_5":14087,"_26889":56050,"_2862":56098},[],"`openssl req -in request.csr -noout -verify -text`.",{"_3376":2553,"_29554":2534,"_20528":56100,"_5":14087,"_26889":56050,"_2862":56101},[],"Profile",{"_3376":2554,"_29554":2534,"_20528":56103,"_5":14087,"_26889":56050,"_2862":56104},[],"Selected source, existing ID, allowed algorithm and size.",{"_3376":2555,"_29554":2534,"_20528":56106,"_5":14087,"_26889":56050,"_2862":56107},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_3376":2556,"_29554":2534,"_20528":56109,"_5":14087,"_26889":56050,"_2862":53403},[],{"_3376":2557,"_29554":2534,"_20528":56111,"_5":14087,"_26889":56050,"_2862":56112},[],"Appropriate subject, SAN, usages and dates.",{"_3376":2558,"_29554":2534,"_20528":56114,"_5":14087,"_26889":56050,"_2862":56115},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_3376":2559,"_29554":2534,"_20528":56117,"_5":14087,"_26889":56050,"_2862":56118},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_3376":2560,"_29554":2534,"_20528":56120,"_5":14087,"_26889":56050,"_2862":56121},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation.",{"_3376":2561,"_29554":2534,"_20528":56123,"_5":14087,"_26889":56054,"_2862":56124},[],"Check each boundary independently:",{"_3376":2562,"_29554":2534,"_20528":56126,"_5":14087,"_26889":56054,"_2862":56127},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_3376":2563,"_29554":2534,"_20528":56129,"_5":14087,"_26889":56054,"_2862":56130},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_3376":2564,"_29554":2534,"_20528":56132,"_5":14087,"_26889":56054,"_2862":56133},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_3376":2565,"_29554":2534,"_20528":56135,"_5":14087,"_26889":56054,"_2862":56136},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_3376":2566,"_29554":2534,"_20528":56138,"_5":14087,"_26889":56054,"_2862":56139},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_3376":2567,"_29554":2534,"_20528":56141,"_5":14087,"_26889":56054,"_2862":56142},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_3376":2568,"_29554":2534,"_20528":56144,"_5":14087,"_26889":56058,"_2862":56145},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_3376":2569,"_29554":2534,"_20528":56147,"_5":14087,"_26889":56058,"_2862":56148},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_3376":2570,"_29554":2570,"_5":14445,"_2862":56150,"_29906":56151,"_20528":56152,"_26889":2570},"Security",[48148],[],{"_3376":2571,"_29554":2570,"_20528":56154,"_5":14087,"_26889":2570,"_2862":56155},[],"How to report a security vulnerability in Lamassu privately, what to include in a report and which releases receive security fixes.",{"_3376":2572,"_29554":2570,"_5":29903,"_20528":56157,"_26889":56158,"_2862":56159},[],"/docs/pr-preview/pr-52/security#report-a-vulnerability","Report a vulnerability",{"_3376":2573,"_29554":2570,"_5":29903,"_20528":56161,"_26889":56162,"_2862":56163},[],"/docs/pr-preview/pr-52/security#what-to-include-in-a-report","What to include in a report",{"_3376":2574,"_29554":2570,"_5":29903,"_20528":56165,"_26889":56166,"_2862":56167},[],"/docs/pr-preview/pr-52/security#supported-versions","Supported versions",{"_3376":2575,"_29554":2570,"_5":29903,"_20528":56169,"_26889":56170,"_2862":56171},[],"/docs/pr-preview/pr-52/security#responsible-disclosure","Responsible disclosure",{"_3376":2576,"_29554":2570,"_20528":56173,"_5":14087,"_26889":2570,"_2862":56174},[],"Found a security vulnerability in lamassuiot, lamassu-dashboard, or lamassu-helm? This page explains how to report it privately, what to include in your report and which releases receive security fixes.",{"_3376":2577,"_29554":2570,"_20528":56176,"_5":14087,"_26889":56158,"_2862":56177},[],"Do not report security vulnerabilities through public GitHub issues, discussions, or pull requests. Public reports disclose the problem before maintainers can fix it.",{"_3376":2578,"_29554":2570,"_20528":56179,"_5":14087,"_26889":56158,"_2862":56180},[],"Instead, report privately using GitHub Security Advisories for the affected repository:",{"_3376":2579,"_29554":2570,"_20528":56182,"_5":14087,"_26889":56158,"_2862":14707},[],{"_3376":2580,"_29554":2570,"_20528":56184,"_5":14087,"_26889":56158,"_2862":14653},[],{"_3376":2581,"_29554":2570,"_20528":56186,"_5":14087,"_26889":56158,"_2862":14700},[],{"_3376":2582,"_29554":2570,"_20528":56188,"_5":14087,"_26889":56158,"_2862":56189},[],"This lets maintainers assess and address the issue before it is publicly disclosed.",{"_3376":2583,"_29554":2570,"_20528":56191,"_5":14087,"_26889":56158,"_2862":56192},[],"If private vulnerability reporting is not enabled for that repository, report the vulnerability privately to lamassuiot\\@lksnext.com before disclosing any details publicly.",{"_3376":2584,"_29554":2570,"_20528":56194,"_5":14087,"_26889":56162,"_2862":56195},[],"Describe the vulnerability, its potential impact, and steps to reproduce it using non-sensitive, redacted examples.",{"_3376":2585,"_29554":2570,"_20528":56197,"_5":14087,"_26889":56162,"_2862":56198},[],"Do not include in the report:",{"_3376":2586,"_29554":2570,"_20528":56200,"_5":14087,"_26889":56162,"_2862":56201},[],"Credentials, tokens, or private keys",{"_3376":2587,"_29554":2570,"_20528":56203,"_5":14087,"_26889":56162,"_2862":56204},[],"Customer data or customer-identifiable information",{"_3376":2588,"_29554":2570,"_20528":56206,"_5":14087,"_26889":56162,"_2862":56207},[],"Confidential architecture or internal infrastructure details",{"_3376":2589,"_29554":2570,"_20528":56209,"_5":14087,"_26889":56166,"_2862":56210},[],"Only the latest stable release receives security support. Support for a stable release ends when the next stable release is published. Older releases and pre-releases are not supported.",{"_3376":2590,"_29554":2570,"_20528":56212,"_5":14087,"_26889":56166,"_2862":56213},[],"For upgrade guidance, see Upgrades.",{"_3376":2591,"_29554":2570,"_20528":56215,"_5":14087,"_26889":56170,"_2862":56216},[],"Give maintainers reasonable time to investigate and address a reported vulnerability before any public disclosure.",{"_3376":2592,"_29554":2570,"_20528":56218,"_5":14087,"_26889":56170,"_2862":56219},[],"Avoid privacy violations, data destruction, and service disruption while researching a vulnerability.",{"_3376":2593,"_29554":2570,"_20528":56221,"_5":14087,"_26889":56170,"_2862":56222},[],"Only interact with accounts or data you own, or for which you have explicit permission.",{"_3376":2594,"_29554":2570,"_20528":56224,"_5":14087,"_26889":56170,"_2862":56225},[],"Maintainers acknowledge reports in a timely manner and keep you informed of remediation progress.",{"_3376":2595,"_29554":2570,"_20528":56227,"_5":14087,"_26889":56170,"_2862":56228},[],"This policy covers the source code, configuration, and CI/CD workflows of the lamassuiot, lamassu-dashboard, and lamassu-helm repositories.",{"_3376":2596,"_29554":2596,"_5":14445,"_2862":56230,"_29906":56231,"_20528":56233,"_26889":2596},"3.8.0 to 4.0.0",[48148,56232],"Upgrades",[],{"_3376":2597,"_29554":2596,"_20528":56235,"_5":14087,"_26889":2596,"_2862":56236},[],"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result.",{"_3376":2598,"_29554":2596,"_5":29903,"_20528":56238,"_26889":56239,"_2862":56240},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#architecture-changes","Architecture changes",{"_3376":2599,"_29554":2596,"_5":29903,"_20528":56242,"_26889":56243,"_2862":56244},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_3376":2600,"_29554":2596,"_5":29903,"_20528":56246,"_26889":56247,"_2862":56248},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_3376":2601,"_29554":2596,"_5":29903,"_20528":56250,"_26889":56251,"_2862":56252},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_3376":2602,"_29554":2596,"_5":29903,"_20528":56254,"_26889":56255,"_2862":56256},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_3376":2603,"_29554":2596,"_5":29903,"_20528":56258,"_26889":56259,"_2862":56260},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_3376":2604,"_29554":2596,"_5":29903,"_20528":56262,"_26889":56263,"_2862":56264},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_3376":2605,"_29554":2596,"_5":29903,"_20528":56266,"_26889":56267,"_2862":56268},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#helm-chart-and-values","Helm chart and values",{"_3376":2606,"_29554":2596,"_5":29903,"_20528":56270,"_26889":56271,"_2862":56272},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_3376":2607,"_29554":2596,"_5":29903,"_20528":56274,"_26889":56275,"_2862":56276},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_3376":2608,"_29554":2596,"_5":29903,"_20528":56278,"_26889":56279,"_2862":56280},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_3376":2609,"_29554":2596,"_5":29903,"_20528":56282,"_26889":56283,"_2862":56284},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_3376":2610,"_29554":2596,"_5":29903,"_20528":56286,"_26889":56287,"_2862":56288},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_3376":2611,"_29554":2596,"_5":29903,"_20528":56290,"_26889":56291,"_2862":56292},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_3376":2612,"_29554":2596,"_5":29903,"_20528":56294,"_26889":56295,"_2862":56296},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_3376":2613,"_29554":2596,"_5":29903,"_20528":56298,"_26889":56299,"_2862":56300},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#data-and-storage","Data and storage",{"_3376":2614,"_29554":2596,"_5":29903,"_20528":56302,"_26889":56303,"_2862":56304},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_3376":2615,"_29554":2596,"_5":29903,"_20528":56306,"_26889":56307,"_2862":56308},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","SQLite storage removed",{"_3376":2616,"_29554":2596,"_5":29903,"_20528":56310,"_26889":56311,"_2862":56312},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_3376":2617,"_29554":2596,"_5":29903,"_20528":56314,"_26889":56315,"_2862":56316},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#references-between-certificates-keys-and-va-roles","References between certificates, keys and VA roles",{"_3376":2618,"_29554":2596,"_5":29903,"_20528":56318,"_26889":56319,"_2862":56320},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#apis-and-stored-configuration","APIs and stored configuration",{"_3376":2619,"_29554":2596,"_5":29903,"_20528":56322,"_26889":56323,"_2862":56324},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_3376":2620,"_29554":2596,"_5":29903,"_20528":56326,"_26889":56327,"_2862":56328},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_3376":2621,"_29554":2596,"_5":29903,"_20528":56330,"_26889":56331,"_2862":56332},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_3376":2622,"_29554":2596,"_5":29903,"_20528":56334,"_26889":56335,"_2862":56336},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_3376":2623,"_29554":2596,"_5":29903,"_20528":56338,"_26889":56339,"_2862":56340},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_3376":2624,"_29554":2596,"_5":29903,"_20528":56342,"_26889":56343,"_2862":56344},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_3376":2625,"_29554":2596,"_5":29903,"_20528":56346,"_26889":56347,"_2862":56348},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#va-role-signer-field","VA role signer field",{"_3376":2626,"_29554":2596,"_5":29903,"_20528":56350,"_26889":56351,"_2862":56352},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_3376":2627,"_29554":2596,"_5":29903,"_20528":56354,"_26889":56355,"_2862":56356},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_3376":2628,"_29554":2596,"_5":29903,"_20528":56358,"_26889":56359,"_2862":56360},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_3376":2629,"_29554":2596,"_5":29903,"_20528":56362,"_26889":56363,"_2862":56364},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_3376":2630,"_29554":2596,"_5":29903,"_20528":56366,"_26889":56367,"_2862":56368},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_3376":2631,"_29554":2596,"_5":29903,"_20528":56370,"_26889":56371,"_2862":56372},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_3376":2632,"_29554":2596,"_5":29903,"_20528":56374,"_26889":56375,"_2862":56376},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_3376":2633,"_29554":2596,"_5":29903,"_20528":56378,"_26889":56379,"_2862":52197},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_3376":2634,"_29554":2596,"_5":29903,"_20528":56381,"_26889":56382,"_2862":56383},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_3376":2635,"_29554":2596,"_5":29903,"_20528":56385,"_26889":56386,"_2862":56387},[],"/docs/pr-preview/pr-52/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_3376":2636,"_29554":2596,"_20528":56389,"_5":14087,"_26889":2596,"_2862":56390},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_3376":2637,"_29554":2596,"_20528":56392,"_5":14087,"_26889":2596,"_2862":56393},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_3376":2638,"_29554":2596,"_20528":56395,"_5":14087,"_26889":2596,"_2862":56396},[],"Architecture changes: what is different in 4.0.0 and what the upgrade migrates on its own.",{"_3376":2639,"_29554":2596,"_20528":56398,"_5":14087,"_26889":2596,"_2862":56399},[],"Breaking changes: every change that can break a 3.8.0 deployment, who it affects and what to do.",{"_3376":2640,"_29554":2596,"_20528":56401,"_5":14087,"_26889":2596,"_2862":56402},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_3376":2641,"_29554":2596,"_20528":56404,"_5":14087,"_26889":2596,"_2862":56405},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_3376":2642,"_29554":2596,"_20528":56407,"_5":14087,"_26889":2596,"_2862":56408},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_3376":2643,"_29554":2596,"_20528":56410,"_5":14087,"_26889":56243,"_2862":56411},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_3376":2644,"_29554":2596,"_20528":56413,"_5":14087,"_26889":56243,"_2862":56414},[],"PostgreSQL is now the only storage engine. SQLite support is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0.",{"_3376":2645,"_29554":2596,"_20528":56416,"_5":14087,"_26889":56247,"_2862":56417},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_3376":2646,"_29554":2596,"_20528":56419,"_5":14087,"_26889":56247,"_2862":56420},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and VA roles. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_3376":2647,"_29554":2596,"_20528":56422,"_5":14087,"_26889":56251,"_2862":56423},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. The events endpoint can also stream events over Server-Sent Events (SSE); to fan events out across service instances, each Device Manager instance binds its own durable AMQP queue.",{"_3376":2648,"_29554":2596,"_20528":56425,"_5":14087,"_26889":56255,"_2862":56426},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_3376":2649,"_29554":2596,"_20528":56428,"_5":14087,"_26889":56255,"_2862":56429},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_3376":2650,"_29554":2596,"_20528":56431,"_5":14087,"_26889":56255,"_2862":56432},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_3376":2651,"_29554":2596,"_20528":56434,"_5":14087,"_26889":56255,"_2862":56435},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_3376":2652,"_29554":2596,"_20528":56437,"_5":14087,"_26889":56255,"_2862":56438},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_3376":2653,"_29554":2596,"_20528":56440,"_5":14087,"_26889":56259,"_2862":56441},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_3376":2654,"_29554":2596,"_20528":56443,"_5":14087,"_26889":56259,"_2862":56444},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_3376":2655,"_29554":2596,"_20528":56446,"_5":14087,"_26889":56259,"_2862":56447},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_3376":2656,"_29554":2596,"_20528":56449,"_5":14087,"_26889":56259,"_2862":56450},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_3376":2657,"_29554":2596,"_20528":56452,"_5":14087,"_26889":56259,"_2862":56453},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_3376":2658,"_29554":2596,"_20528":56455,"_5":14087,"_26889":56263,"_2862":56456},[],"Change",{"_3376":2659,"_29554":2596,"_20528":56458,"_5":14087,"_26889":56263,"_2862":56459},[],"Who is affected",{"_3376":2660,"_29554":2596,"_20528":56461,"_5":14087,"_26889":56263,"_2862":56462},[],"Severity",{"_3376":2661,"_29554":2596,"_20528":56464,"_5":14087,"_26889":56263,"_2862":54970},[],{"_3376":2662,"_29554":2596,"_20528":56466,"_5":14087,"_26889":56263,"_2862":56272},[],{"_3376":2663,"_29554":2596,"_20528":56468,"_5":14087,"_26889":56263,"_2862":56469},[],"Helm releases with a filesystem KMS engine or local VA CRL storage",{"_3376":2664,"_29554":2596,"_20528":56471,"_5":14087,"_26889":56263,"_2862":56472},[],"High: KMS and VA start on empty volumes",{"_3376":2665,"_29554":2596,"_20528":56474,"_5":14087,"_26889":56263,"_2862":56475},[],"Copy the data into the new volumes",{"_3376":2666,"_29554":2596,"_20528":56477,"_5":14087,"_26889":56263,"_2862":56276},[],{"_3376":2667,"_29554":2596,"_20528":56479,"_5":14087,"_26889":56263,"_2862":56480},[],"Every Helm release",{"_3376":2668,"_29554":2596,"_20528":56482,"_5":14087,"_26889":56263,"_2862":56483},[],"High: `helm upgrade` fails",{"_3376":2669,"_29554":2596,"_20528":56485,"_5":14087,"_26889":56263,"_2862":56486},[],"Remove or rename legacy keys",{"_3376":2670,"_29554":2596,"_20528":56488,"_5":14087,"_26889":56263,"_2862":56280},[],{"_3376":2671,"_29554":2596,"_20528":56490,"_5":14087,"_26889":56263,"_2862":56491},[],"Every deployment",{"_3376":2672,"_29554":2596,"_20528":56493,"_5":14087,"_26889":56263,"_2862":56494},[],"High: without a bootstrap principal there is no administrator",{"_3376":2673,"_29554":2596,"_20528":56496,"_5":14087,"_26889":56263,"_2862":56497},[],"Configure `services.authz`",{"_3376":2674,"_29554":2596,"_20528":56499,"_5":14087,"_26889":56263,"_2862":56284},[],{"_3376":2675,"_29554":2596,"_20528":56501,"_5":14087,"_26889":56263,"_2862":56480},[],{"_3376":2676,"_29554":2596,"_20528":56503,"_5":14087,"_26889":56263,"_2862":56504},[],"High: `helm upgrade` fails on the old keys",{"_3376":2677,"_29554":2596,"_20528":56506,"_5":14087,"_26889":56263,"_2862":56507},[],"Move JWKS and roles into `services.authz`",{"_3376":2678,"_29554":2596,"_20528":56509,"_5":14087,"_26889":56263,"_2862":56304},[],{"_3376":2679,"_29554":2596,"_20528":56511,"_5":14087,"_26889":56263,"_2862":56512},[],"3.8.0 deployments with per-service databases",{"_3376":2680,"_29554":2596,"_20528":56514,"_5":14087,"_26889":56263,"_2862":56515},[],"High: services find no data, or a migration aborts",{"_3376":2681,"_29554":2596,"_20528":56517,"_5":14087,"_26889":56263,"_2862":56518},[],"Clean duplicate CA IDs and empty `engine_id` values first; move data manually outside Helm",{"_3376":2682,"_29554":2596,"_20528":56520,"_5":14087,"_26889":56263,"_2862":56308},[],{"_3376":2683,"_29554":2596,"_20528":56522,"_5":14087,"_26889":56263,"_2862":56523},[],"Deployments on SQLite, `couch_db` or `dynamo_db`",{"_3376":2684,"_29554":2596,"_20528":56525,"_5":14087,"_26889":56263,"_2862":56526},[],"High: the backend no longer starts with them",{"_3376":2685,"_29554":2596,"_20528":56528,"_5":14087,"_26889":56263,"_2862":56529},[],"Move to PostgreSQL before upgrading",{"_3376":2686,"_29554":2596,"_20528":56531,"_5":14087,"_26889":56263,"_2862":56532},[],"Webhooks with file references",{"_3376":2687,"_29554":2596,"_20528":56534,"_5":14087,"_26889":56263,"_2862":56535},[],"DMSs whose webhook mTLS certificate or key were file paths",{"_3376":2688,"_29554":2596,"_20528":56537,"_5":14087,"_26889":56263,"_2862":56538},[],"High: enrollments calling the webhook fail",{"_3376":2689,"_29554":2596,"_20528":56540,"_5":14087,"_26889":56263,"_2862":56541},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_3376":2690,"_29554":2596,"_20528":56543,"_5":14087,"_26889":56263,"_2862":56288},[],{"_3376":2691,"_29554":2596,"_20528":56545,"_5":14087,"_26889":56263,"_2862":56546},[],"Releases with per-service identity overrides or mounted key material",{"_3376":2692,"_29554":2596,"_20528":56548,"_5":14087,"_26889":56263,"_2862":56549},[],"Medium: services cannot read their files",{"_3376":2693,"_29554":2596,"_20528":56551,"_5":14087,"_26889":56263,"_2862":56552},[],"Remove the overrides and fix volume ownership",{"_3376":2694,"_29554":2596,"_20528":56554,"_5":14087,"_26889":56263,"_2862":56292},[],{"_3376":2695,"_29554":2596,"_20528":56556,"_5":14087,"_26889":56263,"_2862":56557},[],"Releases that set `amqp.tls`",{"_3376":2696,"_29554":2596,"_20528":56559,"_5":14087,"_26889":56263,"_2862":56560},[],"Medium: clients connect to the wrong port",{"_3376":2697,"_29554":2596,"_20528":56562,"_5":14087,"_26889":56263,"_2862":56563},[],"Point `amqp.port` at the TLS listener, or disable TLS",{"_3376":2698,"_29554":2596,"_20528":56565,"_5":14087,"_26889":56263,"_2862":56312},[],{"_3376":2699,"_29554":2596,"_20528":56567,"_5":14087,"_26889":56263,"_2862":56568},[],"Installations whose CA keys predate the KMS",{"_3376":2700,"_29554":2596,"_20528":56570,"_5":14087,"_26889":56263,"_2862":56571},[],"Medium: CA keys stay unmanaged",{"_3376":2701,"_29554":2596,"_20528":56573,"_5":14087,"_26889":56263,"_2862":56574},[],"Run the CA-to-KMS migration",{"_3376":2702,"_29554":2596,"_20528":56576,"_5":14087,"_26889":56263,"_2862":56577},[],"Receiver certificate verification",{"_3376":2703,"_29554":2596,"_20528":56579,"_5":14087,"_26889":56263,"_2862":56580},[],"DMSs whose webhook had `validate_server_cert: false`",{"_3376":2704,"_29554":2596,"_20528":56582,"_5":14087,"_26889":56263,"_2862":56583},[],"Medium: credentials go to an unverified receiver",{"_3376":2705,"_29554":2596,"_20528":56585,"_5":14087,"_26889":56263,"_2862":56586},[],"Set `insecure_skip_verify` to `false`",{"_3376":2706,"_29554":2596,"_20528":56588,"_5":14087,"_26889":56263,"_2862":56328},[],{"_3376":2707,"_29554":2596,"_20528":56590,"_5":14087,"_26889":56263,"_2862":56591},[],"Scripts and consoles that edit DMSs through the API",{"_3376":2708,"_29554":2596,"_20528":56593,"_5":14087,"_26889":56263,"_2862":56594},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_3376":2709,"_29554":2596,"_20528":56596,"_5":14087,"_26889":56263,"_2862":56597},[],"Read the DMS before editing and use the new field",{"_3376":2710,"_29554":2596,"_20528":56599,"_5":14087,"_26889":56263,"_2862":56348},[],{"_3376":2711,"_29554":2596,"_20528":56601,"_5":14087,"_26889":56263,"_2862":56602},[],"Clients that create or update VA roles through the API",{"_3376":2712,"_29554":2596,"_20528":56604,"_5":14087,"_26889":56263,"_2862":56605},[],"Medium: requests with the old field return an error",{"_3376":2713,"_29554":2596,"_20528":56607,"_5":14087,"_26889":56263,"_2862":56608},[],"Replace `crl_options.subject_key_id_signer` with the required `crl_options.signer_certificate_serial_number`",{"_3376":2714,"_29554":2596,"_20528":56610,"_5":14087,"_26889":56263,"_2862":56344},[],{"_3376":2715,"_29554":2596,"_20528":56612,"_5":14087,"_26889":56263,"_2862":56613},[],"Consumers that read the device `events` field",{"_3376":2716,"_29554":2596,"_20528":56615,"_5":14087,"_26889":56263,"_2862":56616},[],"Medium: the field disappears",{"_3376":2717,"_29554":2596,"_20528":56618,"_5":14087,"_26889":56263,"_2862":56619},[],"Use the new event endpoints",{"_3376":2718,"_29554":2596,"_20528":56621,"_5":14087,"_26889":56263,"_2862":56296},[],{"_3376":2719,"_29554":2596,"_20528":56623,"_5":14087,"_26889":56263,"_2862":56624},[],"Releases that override `toolbox`, `services.connectors`, ports, probes or scheduling",{"_3376":2720,"_29554":2596,"_20528":56626,"_5":14087,"_26889":56263,"_2862":56627},[],"Low to medium: validation errors or changed defaults",{"_3376":2721,"_29554":2596,"_20528":56629,"_5":14087,"_26889":56263,"_2862":56630},[],"Update the values file",{"_3376":2722,"_29554":2596,"_20528":56632,"_5":14087,"_26889":56263,"_2862":56336},[],{"_3376":2723,"_29554":2596,"_20528":56634,"_5":14087,"_26889":56263,"_2862":56635},[],"Clients that send the DMS ID in the update body",{"_3376":2724,"_29554":2596,"_20528":56637,"_5":14087,"_26889":56263,"_2862":56638},[],"Low: the ID in the URL wins",{"_3376":2725,"_29554":2596,"_20528":56640,"_5":14087,"_26889":56263,"_2862":56641},[],"Send the ID in the URL",{"_3376":2726,"_29554":2596,"_20528":56643,"_5":14087,"_26889":56263,"_2862":56340},[],{"_3376":2727,"_29554":2596,"_20528":56645,"_5":14087,"_26889":56263,"_2862":56646},[],"Consumers that match on certificate `type`",{"_3376":2728,"_29554":2596,"_20528":56648,"_5":14087,"_26889":56263,"_2862":56649},[],"Low: two values are renamed",{"_3376":2729,"_29554":2596,"_20528":56651,"_5":14087,"_26889":56263,"_2862":56652},[],"Adapt consumers",{"_3376":2730,"_29554":2596,"_20528":56654,"_5":14087,"_26889":56263,"_2862":56332},[],{"_3376":2731,"_29554":2596,"_20528":56656,"_5":14087,"_26889":56263,"_2862":56657},[],"Any DMS",{"_3376":2732,"_29554":2596,"_20528":56659,"_5":14087,"_26889":56263,"_2862":56660},[],"Low: informational",{"_3376":2733,"_29554":2596,"_20528":56662,"_5":14087,"_26889":56263,"_2862":56663},[],"Read both blocks before editing",{"_3376":2734,"_29554":2596,"_20528":56665,"_5":14087,"_26889":56271,"_2862":56666},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_3376":2735,"_29554":2596,"_20528":56668,"_5":14087,"_26889":56271,"_2862":56669},[],"Step 4 of the migration guide copies the data.",{"_3376":2736,"_29554":2596,"_20528":56671,"_5":14087,"_26889":56275,"_2862":56672},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_3376":2737,"_29554":2596,"_20528":56674,"_5":14087,"_26889":56279,"_2862":56675},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_3376":2738,"_29554":2596,"_20528":56677,"_5":14087,"_26889":56283,"_2862":56678},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_3376":2739,"_29554":2596,"_20528":56680,"_5":14087,"_26889":56287,"_2862":56681},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_3376":2740,"_29554":2596,"_20528":56683,"_5":14087,"_26889":56287,"_2862":56684},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_3376":2741,"_29554":2596,"_20528":56686,"_5":14087,"_26889":56291,"_2862":56687},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_3376":2742,"_29554":2596,"_20528":56689,"_5":14087,"_26889":56295,"_2862":56690},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_3376":2743,"_29554":2596,"_20528":56692,"_5":14087,"_26889":56295,"_2862":56693},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_3376":2744,"_29554":2596,"_20528":56695,"_5":14087,"_26889":56295,"_2862":56696},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_3376":2745,"_29554":2596,"_20528":56698,"_5":14087,"_26889":56295,"_2862":56699},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_3376":2746,"_29554":2596,"_20528":56701,"_5":14087,"_26889":56295,"_2862":56702},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_3376":2747,"_29554":2596,"_20528":56704,"_5":14087,"_26889":56295,"_2862":56705},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_3376":2748,"_29554":2596,"_20528":56707,"_5":14087,"_26889":56303,"_2862":56708},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_3376":2749,"_29554":2596,"_20528":56710,"_5":14087,"_26889":56303,"_2862":56711},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_3376":2750,"_29554":2596,"_20528":56713,"_5":14087,"_26889":56303,"_2862":56714},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_3376":2751,"_29554":2596,"_20528":56716,"_5":14087,"_26889":56303,"_2862":56717},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_3376":2752,"_29554":2596,"_20528":56719,"_5":14087,"_26889":56303,"_2862":56720},[],"The same KMS migration deletes, with a `NOTICE`, aliases that equal an existing key ID, because identifiers now resolve as a key ID before an alias. Affected aliases are dropped, not redirected.",{"_3376":2753,"_29554":2596,"_20528":56722,"_5":14087,"_26889":56307,"_2862":56723},[],"The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_3376":2754,"_29554":2596,"_20528":56725,"_5":14087,"_26889":56311,"_2862":56726},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_3376":2755,"_29554":2596,"_20528":56728,"_5":14087,"_26889":56311,"_2862":56729},[],"The `key_id` is the certificate's `subject_key_id` (SHA-256 of the public key).",{"_3376":2756,"_29554":2596,"_20528":56731,"_5":14087,"_26889":56311,"_2862":56732},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_3376":2757,"_29554":2596,"_20528":56734,"_5":14087,"_26889":56311,"_2862":56735},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_3376":2758,"_29554":2596,"_20528":56737,"_5":14087,"_26889":56311,"_2862":56738},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_3376":2759,"_29554":2596,"_20528":56740,"_5":14087,"_26889":56311,"_2862":56741},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_3376":2760,"_29554":2596,"_20528":56743,"_5":14087,"_26889":56311,"_2862":56744},[],"Once legacy keys are registered, starting the KMS with the backend configuration option `crypto_engines.migrate_keys_format` renames keys whose name is not the public-key SHA-256 digest, keeps the old name as an alias and moves certificate references along. It is safe to re-run and can be disabled afterwards.",{"_3376":2761,"_29554":2596,"_20528":56746,"_5":14087,"_26889":56315,"_2862":56747},[],"Certificates now reference their KMS key, and VA roles reference their signer certificate, so a key or certificate in use cannot be deleted. The KMS migration drops the legacy `lamassu.io/kms/binded-resources` key metadata. Before 4.0.0, deleting a CA could remove its key while leaving key references in its retained certificate records. The CA migration registers those missing keys in the KMS with only their public key to satisfy the retained references. These entries cannot be deleted while the retained certificates reference them; they do not restore the private key. In 4.0.0, deleting a CA releases the references from its own current certificate and linked reissued certificates before attempting to delete the key; other certificates that still reference it prevent deletion.",{"_3376":2762,"_29554":2596,"_20528":56749,"_5":14087,"_26889":56323,"_2862":56750},[],"Stored webhook configs are rewritten to the current layout and their fields renamed:",{"_3376":2763,"_29554":2596,"_20528":56752,"_5":14087,"_26889":56323,"_2862":56753},[],"Field in 3.8.0",{"_3376":2764,"_29554":2596,"_20528":56755,"_5":14087,"_26889":56323,"_2862":56756},[],"Field in 4.0.0",{"_3376":2765,"_29554":2596,"_20528":56758,"_5":14087,"_26889":56323,"_2862":56759},[],"`validate_server_cert`",{"_3376":2766,"_29554":2596,"_20528":56761,"_5":14087,"_26889":56323,"_2862":56762},[],"`insecure_skip_verify` (value negated)",{"_3376":2767,"_29554":2596,"_20528":56764,"_5":14087,"_26889":56323,"_2862":56765},[],"`oidc`",{"_3376":2768,"_29554":2596,"_20528":56767,"_5":14087,"_26889":56323,"_2862":56768},[],"`jwt_options`",{"_3376":2769,"_29554":2596,"_20528":56770,"_5":14087,"_26889":56323,"_2862":56771},[],"`apikey`",{"_3376":2770,"_29554":2596,"_20528":56773,"_5":14087,"_26889":56323,"_2862":56774},[],"`apikey_options`",{"_3376":2771,"_29554":2596,"_20528":56776,"_5":14087,"_26889":56323,"_2862":56777},[],"`mtls`",{"_3376":2772,"_29554":2596,"_20528":56779,"_5":14087,"_26889":56323,"_2862":56780},[],"`mtls_options`",{"_3376":2773,"_29554":2596,"_20528":56782,"_5":14087,"_26889":56323,"_2862":56783},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. Two cases do need it.",{"_3376":2774,"_29554":2596,"_20528":56785,"_5":14087,"_26889":56323,"_2862":56786},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_3376":2775,"_29554":2596,"_20528":56788,"_5":14087,"_26889":56323,"_2862":56789},[],"**Receiver certificate verification.** A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_3376":2776,"_29554":2596,"_20528":56791,"_5":14087,"_26889":56327,"_2862":56792},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3376":2777,"_29554":2596,"_20528":56794,"_5":14087,"_26889":56327,"_2862":56795},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_3376":2778,"_29554":2596,"_20528":56797,"_5":14087,"_26889":56327,"_2862":56798},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_3376":2779,"_29554":2596,"_20528":56800,"_5":14087,"_26889":56331,"_2862":56801},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but read both blocks before editing a DMS so that you do not modify one while believing you are editing the other. The console exposes independent editors for both blocks; the DMS guide describes their fields, and you can also edit them through the DMS API.",{"_3376":2780,"_29554":2596,"_20528":56803,"_5":14087,"_26889":56335,"_2862":56804},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_3376":2781,"_29554":2596,"_20528":56806,"_5":14087,"_26889":56339,"_2862":56807},[],"Stored certificate type values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Adapt consumers that read or match on those values.",{"_3376":2782,"_29554":2596,"_20528":56809,"_5":14087,"_26889":56343,"_2862":56810},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_3376":2783,"_29554":2596,"_20528":56812,"_5":14087,"_26889":56343,"_2862":56813},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_3376":2784,"_29554":2596,"_20528":56815,"_5":14087,"_26889":56343,"_2862":56816},[],"`POST /v1/devices/:id/events` creates an event.",{"_3376":2785,"_29554":2596,"_20528":56818,"_5":14087,"_26889":56343,"_2862":56819},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Each Device Manager instance binds a durable AMQP queue named after its service ID, `device-manager-sse-<uuid>`. Queues from crashed or replaced instances linger until removed, so configure an expiration or cleanup policy on the broker.",{"_3376":2786,"_29554":2596,"_20528":56821,"_5":14087,"_26889":56347,"_2862":56822},[],"`crl_options.subject_key_id_signer` is replaced by the required `crl_options.signer_certificate_serial_number`, the serial number of the existing certificate that signs the CRL. A new role's initial value is the CA's current certificate serial number. Requests that still carry `subject_key_id_signer` return an error. Custom authorization policies that filter on the old field must be updated: the filter `crl_subject_key_id_signer` is renamed to `crl_signer_certificate_serial_number` and takes serial-number values.",{"_3376":2787,"_29554":2596,"_20528":56824,"_5":14087,"_26889":56351,"_2862":56825},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_3376":2788,"_29554":2596,"_20528":56827,"_5":14087,"_26889":56355,"_2862":56828},[],"Take a verifiable backup of PostgreSQL and schedule downtime. The upgrade moves every service's data into `pki`.",{"_3376":2789,"_29554":2596,"_20528":56830,"_5":14087,"_26889":56355,"_2862":56831},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_3376":2790,"_29554":2596,"_20528":56833,"_5":14087,"_26889":56355,"_2862":56834},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_3376":2791,"_29554":2596,"_20528":56836,"_5":14087,"_26889":56355,"_2862":56837},[],"Record the names of your local-storage PVCs:",{"_3376":2792,"_29554":2596,"_20528":56839,"_5":14087,"_26889":56355,"_2862":56840},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_3376":2793,"_29554":2596,"_20528":56842,"_5":14087,"_26889":56359,"_2862":56843},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_3376":2794,"_29554":2596,"_20528":56845,"_5":14087,"_26889":56359,"_2862":56846},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_3376":2795,"_29554":2596,"_20528":56848,"_5":14087,"_26889":56359,"_2862":56849},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is read; the connection always uses the global `postgres.hostname`, `postgres.port`, `postgres.username` and `postgres.password` values.",{"_3376":2796,"_29554":2596,"_20528":56851,"_5":14087,"_26889":56359,"_2862":56852},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_3376":2797,"_29554":2596,"_20528":56854,"_5":14087,"_26889":56359,"_2862":56855},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_3376":2798,"_29554":2596,"_20528":56857,"_5":14087,"_26889":56359,"_2862":56858},[],"**Rename `toolbox` to `connectivityTest`:**",{"_3376":2799,"_29554":2596,"_20528":56860,"_5":14087,"_26889":56359,"_2862":56861},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3376":2800,"_29554":2596,"_20528":56863,"_5":14087,"_26889":56359,"_2862":56864},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_3376":2801,"_29554":2596,"_20528":56866,"_5":14087,"_26889":56359,"_2862":56867},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_3376":2802,"_29554":2596,"_20528":56869,"_5":14087,"_26889":56359,"_2862":56870},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_3376":2803,"_29554":2596,"_20528":56872,"_5":14087,"_26889":56359,"_2862":56873},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_3376":2804,"_29554":2596,"_20528":56875,"_5":14087,"_26889":56359,"_2862":56876},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown.",{"_3376":2805,"_29554":2596,"_20528":56878,"_5":14087,"_26889":56363,"_2862":56879},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_3376":2806,"_29554":2596,"_20528":56881,"_5":14087,"_26889":56363,"_2862":56882},[],"If the deployment uses local KMS or VA storage, those pods fail until you complete step 4, so `--wait` cannot succeed: Helm waits for them to become ready, times out, exits with an error and marks the release `failed`. The hooks have already run by then, and every manifest, including the new StatefulSets and their PVCs, has been applied. Helm does not roll anything back without `--atomic`. Continue with step 4, then re-run the same `helm upgrade` command so it completes and Helm records the release as `deployed`. Both hooks are idempotent, so they are safe to run again.",{"_3376":2807,"_29554":2596,"_20528":56884,"_5":14087,"_26889":56367,"_2862":56885},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_3376":2808,"_29554":2596,"_20528":56887,"_5":14087,"_26889":56367,"_2862":56888},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_3376":2809,"_29554":2596,"_20528":56890,"_5":14087,"_26889":56367,"_2862":56891},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If `claims_ok` prints `ABORT`, the block stops before listing the claims: either a StatefulSet lookup failed, or a new claim resolves to the 3.8.0 claim. In the second case the copy would verify against itself and the final cleanup would delete the live volume. The chart always appends `-kms` and `-va` to the release-scoped name, so a collision means the claims are not what this guide expects; investigate before going on. Item 3 runs the same check and refuses to create the helper pod, so nothing touches the volumes. The check returns instead of calling `exit`, which would close your shell and lose the variables set so far. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_3376":2810,"_29554":2596,"_20528":56893,"_5":14087,"_26889":56367,"_2862":56894},[],"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:",{"_3376":2811,"_29554":2596,"_20528":56896,"_5":14087,"_26889":56367,"_2862":56897},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_3376":2812,"_29554":2596,"_20528":56899,"_5":14087,"_26889":56367,"_2862":56900},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_3376":2813,"_29554":2596,"_20528":56902,"_5":14087,"_26889":56367,"_2862":56903},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_3376":2814,"_29554":2596,"_20528":56905,"_5":14087,"_26889":56367,"_2862":56906},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_3376":2815,"_29554":2596,"_20528":56908,"_5":14087,"_26889":56367,"_2862":56909},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_3376":2816,"_29554":2596,"_20528":56911,"_5":14087,"_26889":56367,"_2862":56912},[],"**Remove the helper and restore the recorded replica counts:**",{"_3376":2817,"_29554":2596,"_20528":56914,"_5":14087,"_26889":56367,"_2862":56915},[],"**Re-run the step 3 `helm upgrade` command.** The KMS and VA pods now start against the copied data, so `--wait` succeeds and the release moves from `failed` to `deployed`.",{"_3376":2818,"_29554":2596,"_20528":56917,"_5":14087,"_26889":56371,"_2862":56918},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_3376":2819,"_29554":2596,"_20528":56920,"_5":14087,"_26889":56371,"_2862":56921},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_3376":2820,"_29554":2596,"_20528":56923,"_5":14087,"_26889":56375,"_2862":56924},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_3376":2821,"_29554":2596,"_20528":56926,"_5":14087,"_26889":56375,"_2862":56927},[],"Run the migrations in the required order, one schema at a time: `kms` first, then the `ca-to-kms-migration` tool (needed only for legacy deployments whose CA keys are named by SKI), then `ca`, then `va`. The `devicemanager`, `dmsmanager` and `alerts` schemas are independent and can be migrated in any order. With Helm, the chart's pre-install job applies the schemas in the correct order automatically.",{"_3376":2822,"_29554":2596,"_20528":56929,"_5":14087,"_26889":56375,"_2862":56930},[],"The schemas reference each other, so the PostgreSQL role running the migrations needs cross-schema privileges: the `ca` schema needs `USAGE` on `kms` plus `SELECT`, `REFERENCES` and `INSERT` on `kms.kms_keys`, and the `va` schema needs `USAGE` on `ca` plus `SELECT` and `REFERENCES` on `ca.certificates` and `SELECT` on `ca.ca_certificates`. If your services connect with a different user than the one that ran the migrations, grant that user `SELECT` on `ca.certificates_view` after the migrations.",{"_3376":2823,"_29554":2596,"_20528":56932,"_5":14087,"_26889":56375,"_2862":56933},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_3376":2824,"_29554":2596,"_20528":56935,"_5":14087,"_26889":56375,"_2862":56936},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_3376":2825,"_29554":2596,"_20528":56938,"_5":14087,"_26889":56375,"_2862":56939},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository.",{"_3376":2826,"_29554":2596,"_20528":56941,"_5":14087,"_26889":56375,"_2862":56942},[],"Both tools' READMEs document the 4.0.0 `pki` layout and match this page: `goose-lamassu` uses `dbname=pki` examples and does not validate the database name, and the `ca-to-kms-migration` README describes the single `pki` database and the migration order.",{"_3376":2827,"_29554":2596,"_20528":56944,"_5":14087,"_26889":56379,"_2862":56945},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_3376":2828,"_29554":2596,"_20528":56947,"_5":14087,"_26889":56379,"_2862":56948},[],"**`helm upgrade --wait` times out and `helm status` reports the release as `failed`.** With local KMS or VA storage this is expected on the first run: the new pods cannot become ready before their data is copied. The hooks ran and the manifests and PVCs were applied, so complete step 4 and re-run the same `helm upgrade` command. If other pods are also not ready, check their logs, because something else is wrong.",{"_3376":2829,"_29554":2596,"_20528":56950,"_5":14087,"_26889":56379,"_2862":56951},[],"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait.",{"_3376":2830,"_29554":2596,"_20528":56953,"_5":14087,"_26889":56379,"_2862":56954},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_3376":2831,"_29554":2596,"_20528":56956,"_5":14087,"_26889":56379,"_2862":56957},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted on duplicate CA IDs or missing `engine_id` values. Check the job logs, fix the privileges or the data, and re-run the upgrade.",{"_3376":2832,"_29554":2596,"_20528":56959,"_5":14087,"_26889":56379,"_2862":56960},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_3376":2833,"_29554":2596,"_20528":56962,"_5":14087,"_26889":56379,"_2862":56963},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_3376":2834,"_29554":2596,"_20528":56965,"_5":14087,"_26889":56379,"_2862":56966},[],"**A migration aborts with `kms schema not found`.** The schemas must be migrated in order: run the `kms` schema migration before the `ca` schema migration.",{"_3376":2835,"_29554":2596,"_20528":56968,"_5":14087,"_26889":56379,"_2862":56969},[],"**A migration aborts with `ca schema not found`.** Run the `ca` schema migration before the `va` schema migration.",{"_3376":2836,"_29554":2596,"_20528":56971,"_5":14087,"_26889":56379,"_2862":56972},[],"**The VA migration fails with `cannot resolve signer certificate for VA role ... N candidates`.** The migration cannot uniquely identify a signer certificate from the SKI stored on the role. Review the SKI and candidate certificates reported in the error; correct the pre-migration data with a verified backup and rerun the migration. The new `signer_certificate_serial_number` field is created during that migration, so it cannot be set through the VA API while the migration is failing.",{"_3376":2837,"_29554":2596,"_20528":56974,"_5":14087,"_26889":56379,"_2862":56975},[],"**A migration or service fails with `permission denied for table ...`.** The PostgreSQL role is missing the cross-schema privileges listed in Deployments without Helm; this includes `certificates_view` when the post-migration `GRANT SELECT` was skipped. Grant the missing privileges and re-run.",{"_3376":2838,"_29554":2596,"_20528":56977,"_5":14087,"_26889":56382,"_2862":56978},[],"After the upgrade, check in this order:",{"_3376":2839,"_29554":2596,"_20528":56980,"_5":14087,"_26889":56382,"_2862":56981},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations and the foreign-key migrations that run per schema in the required order.",{"_3376":2840,"_29554":2596,"_20528":56983,"_5":14087,"_26889":56382,"_2862":56984},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_3376":2841,"_29554":2596,"_20528":56986,"_5":14087,"_26889":56382,"_2862":56987},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_3376":2842,"_29554":2596,"_20528":56989,"_5":14087,"_26889":56382,"_2862":56990},[],"**Existing CRLs are served.** `GET /crl/<ca-ski>` on VA returns a previously issued CRL, and new CRLs are issued.",{"_3376":2843,"_29554":2596,"_20528":56992,"_5":14087,"_26889":56382,"_2862":56993},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS.",{"_3376":2844,"_29554":2596,"_20528":56995,"_5":14087,"_26889":56382,"_2862":56996},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_3376":2845,"_29554":2596,"_20528":56998,"_5":14087,"_26889":56382,"_2862":56999},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_3376":2846,"_29554":2596,"_20528":57001,"_5":14087,"_26889":56382,"_2862":57002},[],"**AMQP.** The backend connects to the broker with the expected TLS settings, and the cleanup policy for SSE queues is in place.",{"_3376":2847,"_29554":2596,"_20528":57004,"_5":14087,"_26889":56382,"_2862":57005},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_3376":2848,"_29554":2596,"_20528":57007,"_5":14087,"_26889":56382,"_2862":57008},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_3376":2849,"_29554":2596,"_20528":57010,"_5":14087,"_26889":56382,"_2862":57011},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_3376":2850,"_29554":2596,"_20528":57013,"_5":14087,"_26889":56382,"_2862":57014},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_3376":2851,"_29554":2596,"_20528":57016,"_5":14087,"_26889":56382,"_2862":57017},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_3376":2852,"_29554":2596,"_20528":57019,"_5":14087,"_26889":56382,"_2862":57020},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_3376":2853,"_29554":2596,"_20528":57022,"_5":14087,"_26889":56386,"_2862":57023},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy. These are the fixed 3.8.0 names recorded in step 1; before deleting, confirm that neither is mounted by a running pod, for example with `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, where `Used By` must be `<none>`:",{"_3376":2854,"_29554":2596,"_20528":57025,"_5":14087,"_26889":56386,"_2862":57026},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_3376":2855,"_29554":2596,"_20528":57028,"_5":14087,"_26889":56386,"_2862":57029},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3376":2856,"_29554":2596,"_20528":57031,"_5":14087,"_26889":56386,"_2862":57032},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_3376":2857,"_29554":2596,"_20528":57034,"_5":14087,"_26889":56386,"_2862":57035},[],"<Card title=\"Configure a DMS\" description=\"Enrollment, re-enrollment and webhook settings.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />","sorting",{"_57038":57039,"_57040":57041,"_57042":57043,"_57044":57045,"_17785":2897,"_68431":2897},"language","english","sortableProperties",[2862,29554,5,26889],"sortablePropertiesWithTypes",{"_2862":24527,"_29554":24527,"_5":24527,"_26889":24527},"sorts",{"_2862":57046,"_29554":59893,"_5":62739,"_26889":65585},{"_4531":57047,"_57048":57049,"_5":24527},{"_14169":3548,"_14545":4962,"_14564":4599,"_28563":3574,"_14551":19044,"_19483":14750,"_14190":3250,"_14197":3437,"_28505":7422,"_28914":4334,"_28935":3913,"_28539":3378,"_33867":5813,"_28642":7328,"_28979":7336,"_33874":3095,"_33877":20666,"_33880":5711,"_33883":7293,"_29386":4326,"_33888":3935,"_33890":3549,"_29416":4058,"_14560":18402,"_33894":18005,"_33897":5819,"_33899":6047,"_28963":14133,"_29381":3979,"_29429":3616,"_33904":5869,"_33906":6804,"_33908":5433,"_28659":2961,"_33911":15495,"_33913":7370,"_33915":5324,"_33917":3566,"_33919":25136,"_28576":20109,"_33922":4652,"_33924":3240,"_28570":3259,"_29000":19959,"_33928":7360,"_33930":7025,"_33933":2972,"_28616":4469,"_33937":2973,"_28496":4488,"_33940":4260,"_28544":15504,"_33943":3280,"_33945":5030,"_33948":7438,"_14554":6780,"_33951":6441,"_33953":7226,"_33956":7437,"_33958":16952,"_33960":6339,"_33962":13471,"_33964":2947,"_19486":24936,"_33967":6411,"_33969":5806,"_28517":10270,"_28957":7227,"_33973":6017,"_33975":4109,"_33977":7122,"_29446":8629,"_33980":4142,"_33982":5900,"_33984":9727,"_29540":3923,"_29016":23139,"_33988":14066,"_33990":3550,"_28554":4311,"_33993":4674,"_33995":7443,"_33997":8202,"_29462":8733,"_28636":3162,"_27971":5406,"_34002":8345,"_34004":9965,"_34006":20668,"_28685":3184,"_34010":6932,"_28951":10269,"_34014":8492,"_34016":4217,"_34018":24112,"_34020":4659,"_34022":3177,"_34024":7292,"_28674":4594,"_28919":17799,"_34028":5699,"_34030":16391,"_34032":5010,"_34035":3311,"_34037":19758,"_34039":3106,"_34041":4589,"_34043":3124,"_34045":15938,"_34047":15764,"_34050":24533,"_34052":7099,"_34054":9651,"_34056":5710,"_34058":7385,"_34061":14623,"_34063":7429,"_34066":13007,"_34069":3918,"_34071":4284,"_34073":5694,"_34075":23144,"_34077":5678,"_34079":48138,"_34081":15741,"_34083":4897,"_34085":3905,"_28962":4649,"_34088":4370,"_34090":14424,"_34092":3004,"_34094":5792,"_34096":4588,"_34098":7032,"_34100":4583,"_34102":10820,"_34104":6464,"_34106":6750,"_34108":4621,"_34110":22347,"_34112":5677,"_34114":3661,"_34116":23501,"_34118":3660,"_34120":11685,"_34122":24536,"_34124":4822,"_34126":2899,"_34128":5855,"_34130":4823,"_34132":6738,"_34134":5367,"_34136":7339,"_34138":4639,"_34140":12011,"_34142":7338,"_34144":7288,"_34146":17649,"_34148":4557,"_34150":9154,"_34152":3223,"_34154":3875,"_34156":18063,"_34158":19943,"_34160":6749,"_34162":11379,"_34164":5349,"_28956":3878,"_