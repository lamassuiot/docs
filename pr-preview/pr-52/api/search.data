221,"_36883":114223,"_36885":114226,"_36887":114229,"_36889":114232,"_36891":114234,"_36893":114237,"_36895":114240,"_36897":114243,"_36899":114245,"_36901":114248,"_36903":114251,"_36905":114254,"_36907":114256,"_36909":114259,"_36911":114262,"_36913":114265,"_36915":114267,"_36917":114270,"_36919":114273,"_36921":114276,"_36923":114279,"_36926":114282,"_36928":114285,"_36930":114288,"_36932":114291,"_36934":114294,"_36936":114297,"_36938":114300,"_36940":114303,"_36942":114306,"_36944":114309,"_36946":114312,"_36948":114315,"_36950":114318,"_36952":114321,"_36954":114324,"_36956":114327,"_36958":114330,"_36960":114333,"_36962":114336,"_36964":114339,"_36966":114342,"_36968":114345,"_36970":114348,"_36972":114351,"_36974":114354,"_36976":114357,"_36978":114360,"_36980":114363,"_36982":114366,"_36984":114369,"_36986":114371,"_36988":114374,"_36990":114376,"_36992":114378,"_36994":114380,"_36996":114382,"_36998":114384,"_37000":114386,"_37002":114389,"_37004":114392,"_37007":114395,"_37009":114398,"_37011":114401,"_37013":114404,"_37015":114407,"_37017":114410,"_37019":114413,"_37021":114416,"_37023":114419,"_37025":114422,"_37027":114425,"_37030":114428,"_37032":114431,"_37034":114434,"_37036":114437,"_37038":114440,"_37040":114443,"_37042":114446,"_37044":114449,"_37046":114452,"_37048":114455,"_37050":114458,"_37052":114461,"_37054":114464,"_37056":114467,"_37058":114470,"_37060":114473,"_37062":114476,"_37064":114479,"_37066":114482,"_37068":114485,"_37070":114488,"_37073":114491,"_37075":114494,"_37077":114497,"_37080":114500,"_37082":114503,"_37084":114506,"_37086":114509,"_37089":114512,"_37091":114515,"_37093":114518,"_37095":114521,"_37097":114524,"_37099":114527,"_37101":114530,"_37103":114533,"_37105":114536,"_37107":114539,"_37109":114542,"_37111":114545,"_37113":114548,"_37115":114551,"_37117":114554,"_37120":114557,"_37122":114560,"_37124":114563,"_37126":114566,"_37128":114569,"_37130":114572,"_37132":114575,"_37134":114578,"_37136":114581,"_37138":114584,"_37140":114587,"_37142":114590,"_37144":114593,"_37146":114596,"_37148":114599,"_37150":114602,"_37152":114605,"_37154":114608,"_37156":114611,"_37158":114614,"_37160":114617,"_37162":114620,"_37164":114623,"_37166":114626,"_37168":114629,"_37171":114632,"_37173":114635,"_37175":114638},{"_3170":64115,"_27782":64115,"_5":13558,"_2666":106518,"_28124":106519,"_19244":106522,"_26277":64115},"Despliega desde AWS Marketplace",[45194,106520,106521],"Despliegue","Otros modelos",[],{"_3170":64116,"_27782":64115,"_19244":106524,"_5":13232,"_26277":64115,"_2666":106525},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_3170":64117,"_27782":64115,"_5":28121,"_19244":106527,"_26277":106528,"_2666":106529},[],"/docs/pr-preview/pr-52/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_3170":64118,"_27782":64115,"_5":28121,"_19244":106531,"_26277":106532,"_2666":106533},[],"/docs/pr-preview/pr-52/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_3170":64119,"_27782":64115,"_5":28121,"_19244":106535,"_26277":106536,"_2666":106537},[],"/docs/pr-preview/pr-52/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3170":64120,"_27782":64115,"_5":28121,"_19244":106539,"_26277":106540,"_2666":106541},[],"/docs/pr-preview/pr-52/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3170":64121,"_27782":64115,"_5":28121,"_19244":106543,"_26277":106544,"_2666":106545},[],"/docs/pr-preview/pr-52/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3170":64122,"_27782":64115,"_5":28121,"_19244":106547,"_26277":106548,"_2666":106549},[],"/docs/pr-preview/pr-52/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3170":64123,"_27782":64115,"_5":28121,"_19244":106551,"_26277":106552,"_2666":106553},[],"/docs/pr-preview/pr-52/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3170":64124,"_27782":64115,"_19244":106555,"_5":13232,"_26277":64115,"_2666":106556},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3170":64125,"_27782":64115,"_19244":106558,"_5":13232,"_26277":106528,"_2666":106559},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3170":64126,"_27782":64115,"_19244":106561,"_5":13232,"_26277":106528,"_2666":106562},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3170":64127,"_27782":64115,"_19244":106564,"_5":13232,"_26277":106528,"_2666":106565},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3170":64128,"_27782":64115,"_19244":106567,"_5":13232,"_26277":106532,"_2666":106568},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3170":64129,"_27782":64115,"_19244":106570,"_5":13232,"_26277":106532,"_2666":106571},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3170":64130,"_27782":64115,"_19244":106573,"_5":13232,"_26277":106532,"_2666":106574},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3170":64131,"_27782":64115,"_19244":106576,"_5":13232,"_26277":106536,"_2666":106577},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3170":64132,"_27782":64115,"_19244":106579,"_5":13232,"_26277":106540,"_2666":106580},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3170":64133,"_27782":64115,"_19244":106582,"_5":13232,"_26277":106544,"_2666":106583},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3170":64134,"_27782":64115,"_19244":106585,"_5":13232,"_26277":106548,"_2666":106586},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3170":64135,"_27782":64115,"_19244":106588,"_5":13232,"_26277":106552,"_2666":106589},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3170":64136,"_27782":64136,"_5":13558,"_2666":106591,"_28124":106592,"_19244":106593,"_26277":64136},"Despliega Lamassu",[45194,106520],[],{"_3170":64137,"_27782":64136,"_19244":106595,"_5":13232,"_26277":64136,"_2666":106596},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3170":64138,"_27782":64136,"_5":28121,"_19244":106598,"_26277":106599,"_2666":106600},[],"/docs/pr-preview/pr-52/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3170":64139,"_27782":64136,"_5":28121,"_19244":106602,"_26277":106603,"_2666":106604},[],"/docs/pr-preview/pr-52/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3170":64140,"_27782":64136,"_5":28121,"_19244":106606,"_26277":106607,"_2666":106608},[],"/docs/pr-preview/pr-52/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3170":64141,"_27782":64136,"_19244":106610,"_5":13232,"_26277":64136,"_2666":106611},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3170":64142,"_27782":64136,"_19244":106613,"_5":13232,"_26277":106599,"_2666":106614},[],"Modelo",{"_3170":64143,"_27782":64136,"_19244":106616,"_5":13232,"_26277":106599,"_2666":106617},[],"Recomendado para",{"_3170":64144,"_27782":64136,"_19244":106619,"_5":13232,"_26277":106599,"_2666":106620},[],"Quién opera la infraestructura",{"_3170":64145,"_27782":64136,"_19244":106622,"_5":13232,"_26277":106599,"_2666":106623},[],"Punto de partida",{"_3170":64146,"_27782":64136,"_19244":106625,"_5":13232,"_26277":106599,"_2666":45301},[],{"_3170":64147,"_27782":64136,"_19244":106627,"_5":13232,"_26277":106599,"_2666":106628},[],"Producción, entornos regulados y despliegues personalizados",{"_3170":64148,"_27782":64136,"_19244":106630,"_5":13232,"_26277":106599,"_2666":106631},[],"Tu equipo",{"_3170":64149,"_27782":64136,"_19244":106633,"_5":13232,"_26277":106599,"_2666":106634},[],"Helm o Fastlane",{"_3170":64150,"_27782":64136,"_19244":106636,"_5":13232,"_26277":106599,"_2666":45313},[],{"_3170":64151,"_27782":64136,"_19244":106638,"_5":13232,"_26277":106599,"_2666":106639},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3170":64152,"_27782":64136,"_19244":106641,"_5":13232,"_26277":106599,"_2666":106631},[],{"_3170":64153,"_27782":64136,"_19244":106643,"_5":13232,"_26277":106599,"_2666":106644},[],"Imagen preconfigurada en EC2",{"_3170":64154,"_27782":64136,"_19244":106646,"_5":13232,"_26277":106599,"_2666":45324},[],{"_3170":64155,"_27782":64136,"_19244":106648,"_5":13232,"_26277":106599,"_2666":106649},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3170":64156,"_27782":64136,"_19244":106651,"_5":13232,"_26277":106599,"_2666":45330},[],{"_3170":64157,"_27782":64136,"_19244":106653,"_5":13232,"_26277":106599,"_2666":106654},[],"Suscripción gestionada",{"_3170":64158,"_27782":64136,"_19244":106656,"_5":13232,"_26277":106599,"_2666":106657},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3170":64159,"_27782":64136,"_19244":106659,"_5":13232,"_26277":106599,"_2666":106660},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3170":64160,"_27782":64136,"_19244":106662,"_5":13232,"_26277":106599,"_2666":106663},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3170":64161,"_27782":64136,"_19244":106665,"_5":13232,"_26277":106603,"_2666":106666},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3170":64162,"_27782":64136,"_19244":106668,"_5":13232,"_26277":106607,"_2666":106669},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3170":64163,"_27782":64163,"_5":13558,"_2666":106671,"_28124":106672,"_19244":106673,"_26277":64163},"Utiliza Lamassu como SaaS",[45194,106520,106521],[],{"_3170":64164,"_27782":64163,"_19244":106675,"_5":13232,"_26277":64163,"_2666":106676},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3170":64165,"_27782":64163,"_5":28121,"_19244":106678,"_26277":106679,"_2666":106680},[],"/docs/pr-preview/pr-52/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3170":64166,"_27782":64163,"_5":28121,"_19244":106682,"_26277":106683,"_2666":106684},[],"/docs/pr-preview/pr-52/es/deployment/saas#planes","Planes",{"_3170":64167,"_27782":64163,"_5":28121,"_19244":106686,"_26277":106687,"_2666":106688},[],"/docs/pr-preview/pr-52/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3170":64168,"_27782":64163,"_19244":106690,"_5":13232,"_26277":64163,"_2666":106691},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3170":64169,"_27782":64163,"_19244":106693,"_5":13232,"_26277":106679,"_2666":106694},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3170":64170,"_27782":64163,"_19244":106696,"_5":13232,"_26277":106679,"_2666":106697},[],"Copias de seguridad automáticas.",{"_3170":64171,"_27782":64163,"_19244":106699,"_5":13232,"_26277":106679,"_2666":106700},[],"Actualizaciones de versión.",{"_3170":64172,"_27782":64163,"_19244":106702,"_5":13232,"_26277":106679,"_2666":106703},[],"Soporte técnico y SLA según el plan contratado.",{"_3170":64173,"_27782":64163,"_19244":106705,"_5":13232,"_26277":106683,"_2666":45385},[],{"_3170":64174,"_27782":64163,"_19244":106707,"_5":13232,"_26277":106683,"_2666":106708},[],"Dispositivos",{"_3170":64175,"_27782":64163,"_19244":106710,"_5":13232,"_26277":106683,"_2666":106711},[],"Soporte",{"_3170":64176,"_27782":64163,"_19244":106713,"_5":13232,"_26277":106683,"_2666":45394},[],{"_3170":64177,"_27782":64163,"_19244":106715,"_5":13232,"_26277":106683,"_2666":45397},[],{"_3170":64178,"_27782":64163,"_19244":106717,"_5":13232,"_26277":106683,"_2666":106718},[],"Hasta 1.000",{"_3170":64179,"_27782":64163,"_19244":106720,"_5":13232,"_26277":106683,"_2666":45403},[],{"_3170":64180,"_27782":64163,"_19244":106722,"_5":13232,"_26277":106683,"_2666":106723},[],"99,5 %",{"_3170":64181,"_27782":64163,"_19244":106725,"_5":13232,"_26277":106683,"_2666":45409},[],{"_3170":64182,"_27782":64163,"_19244":106727,"_5":13232,"_26277":106683,"_2666":106728},[],"Hasta 10.000",{"_3170":64183,"_27782":64163,"_19244":106730,"_5":13232,"_26277":106683,"_2666":106731},[],"Email y chat",{"_3170":64184,"_27782":64163,"_19244":106733,"_5":13232,"_26277":106683,"_2666":106734},[],"99,9 %",{"_3170":64185,"_27782":64163,"_19244":106736,"_5":13232,"_26277":106683,"_2666":45421},[],{"_3170":64186,"_27782":64163,"_19244":106738,"_5":13232,"_26277":106683,"_2666":106739},[],"Ilimitados",{"_3170":64187,"_27782":64163,"_19244":106741,"_5":13232,"_26277":106683,"_2666":106742},[],"Dedicado",{"_3170":64188,"_27782":64163,"_19244":106744,"_5":13232,"_26277":106683,"_2666":106745},[],"99,99 %",{"_3170":64189,"_27782":64163,"_19244":106747,"_5":13232,"_26277":106687,"_2666":106748},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3170":64190,"_27782":64163,"_19244":106750,"_5":13232,"_26277":106687,"_2666":106751},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3170":64191,"_27782":64191,"_5":13558,"_2666":45438,"_28124":106753,"_19244":106755,"_26277":64191},[45194,106520,106754],"Kubernetes autogestionado",[],{"_3170":64192,"_27782":64191,"_19244":106757,"_5":13232,"_26277":64191,"_2666":106758},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3170":64193,"_27782":64191,"_5":28121,"_19244":106760,"_26277":106761,"_2666":106762},[],"/docs/pr-preview/pr-52/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3170":64194,"_27782":64191,"_5":28121,"_19244":106764,"_26277":106765,"_2666":106766},[],"/docs/pr-preview/pr-52/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3170":64195,"_27782":64191,"_5":28121,"_19244":106768,"_26277":106769,"_2666":106770},[],"/docs/pr-preview/pr-52/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3170":64196,"_27782":64191,"_5":28121,"_19244":106772,"_26277":106773,"_2666":106774},[],"/docs/pr-preview/pr-52/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3170":64197,"_27782":64191,"_5":28121,"_19244":106776,"_26277":106777,"_2666":106778},[],"/docs/pr-preview/pr-52/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3170":64198,"_27782":64191,"_5":28121,"_19244":106780,"_26277":106781,"_2666":106782},[],"/docs/pr-preview/pr-52/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3170":64199,"_27782":64191,"_5":28121,"_19244":106784,"_26277":106785,"_2666":106786},[],"/docs/pr-preview/pr-52/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3170":64200,"_27782":64191,"_5":28121,"_19244":106788,"_26277":106789,"_2666":106790},[],"/docs/pr-preview/pr-52/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3170":64201,"_27782":64191,"_5":28121,"_19244":106792,"_26277":106793,"_2666":106794},[],"/docs/pr-preview/pr-52/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3170":64202,"_27782":64191,"_5":28121,"_19244":106796,"_26277":106797,"_2666":106798},[],"/docs/pr-preview/pr-52/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3170":64203,"_27782":64191,"_5":28121,"_19244":106800,"_26277":106801,"_2666":106802},[],"/docs/pr-preview/pr-52/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3170":64204,"_27782":64191,"_19244":106804,"_5":13232,"_26277":106761,"_2666":106805},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3170":64205,"_27782":64191,"_19244":106807,"_5":13232,"_26277":106761,"_2666":106808},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3170":64206,"_27782":64191,"_19244":106810,"_5":13232,"_26277":106765,"_2666":106811},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3170":64207,"_27782":64191,"_19244":106813,"_5":13232,"_26277":106765,"_2666":106814},[],"Fastlane instala o configura",{"_3170":64208,"_27782":64191,"_19244":106816,"_5":13232,"_26277":106765,"_2666":106817},[],"Tú sigues proporcionando",{"_3170":64209,"_27782":64191,"_19244":106819,"_5":13232,"_26277":106765,"_2666":106820},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3170":64210,"_27782":64191,"_19244":106822,"_5":13232,"_26277":106765,"_2666":106823},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3170":64211,"_27782":64191,"_19244":106825,"_5":13232,"_26277":106765,"_2666":106826},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3170":64212,"_27782":64191,"_19244":106828,"_5":13232,"_26277":106765,"_2666":106829},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3170":64213,"_27782":64191,"_19244":106831,"_5":13232,"_26277":106765,"_2666":106832},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_3170":64214,"_27782":64191,"_19244":106834,"_5":13232,"_26277":106765,"_2666":106835},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3170":64215,"_27782":64191,"_19244":106837,"_5":13232,"_26277":106765,"_2666":106838},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3170":64216,"_27782":64191,"_19244":106840,"_5":13232,"_26277":106765,"_2666":106841},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3170":64217,"_27782":64191,"_19244":106843,"_5":13232,"_26277":106765,"_2666":106844},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3170":64218,"_27782":64191,"_19244":106846,"_5":13232,"_26277":106769,"_2666":106847},[],"Necesitas:",{"_3170":64219,"_27782":64191,"_19244":106849,"_5":13232,"_26277":106769,"_2666":106850},[],"un clúster Kubernetes existente",{"_3170":64220,"_27782":64191,"_19244":106852,"_5":13232,"_26277":106769,"_2666":106853},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3170":64221,"_27782":64191,"_19244":106855,"_5":13232,"_26277":106769,"_2666":45540},[],{"_3170":64222,"_27782":64191,"_19244":106857,"_5":13232,"_26277":106769,"_2666":21800},[],{"_3170":64223,"_27782":64191,"_19244":106859,"_5":13232,"_26277":106769,"_2666":106860},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3170":64224,"_27782":64191,"_19244":106862,"_5":13232,"_26277":106769,"_2666":106863},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3170":64225,"_27782":64191,"_19244":106865,"_5":13232,"_26277":106769,"_2666":106866},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3170":64226,"_27782":64191,"_19244":106868,"_5":13232,"_26277":106769,"_2666":106869},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3170":64227,"_27782":64191,"_19244":106871,"_5":13232,"_26277":106769,"_2666":106872},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3170":64228,"_27782":64191,"_19244":106874,"_5":13232,"_26277":106773,"_2666":106875},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3170":64229,"_27782":64191,"_19244":106877,"_5":13232,"_26277":106773,"_2666":106878},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3170":64230,"_27782":64191,"_19244":106880,"_5":13232,"_26277":106777,"_2666":106881},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3170":64231,"_27782":64191,"_19244":106883,"_5":13232,"_26277":106777,"_2666":106884},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3170":64232,"_27782":64191,"_19244":106886,"_5":13232,"_26277":106777,"_2666":106887},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3170":64233,"_27782":64191,"_19244":106889,"_5":13232,"_26277":106777,"_2666":106890},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3170":64234,"_27782":64191,"_19244":106892,"_5":13232,"_26277":106781,"_2666":106893},[],"Opción",{"_3170":64235,"_27782":64191,"_19244":106895,"_5":13232,"_26277":106781,"_2666":106896},[],"Valor predeterminado",{"_3170":64236,"_27782":64191,"_19244":106898,"_5":13232,"_26277":106781,"_2666":106899},[],"Propósito",{"_3170":64237,"_27782":64191,"_19244":106901,"_5":13232,"_26277":106781,"_2666":45587},[],{"_3170":64238,"_27782":64191,"_19244":106903,"_5":13232,"_26277":106781,"_2666":45590},[],{"_3170":64239,"_27782":64191,"_19244":106905,"_5":13232,"_26277":106781,"_2666":106906},[],"Muestra la ayuda",{"_3170":64240,"_27782":64191,"_19244":106908,"_5":13232,"_26277":106781,"_2666":45596},[],{"_3170":64241,"_27782":64191,"_19244":106910,"_5":13232,"_26277":106781,"_2666":106911},[],"contexto actual",{"_3170":64242,"_27782":64191,"_19244":106913,"_5":13232,"_26277":106781,"_2666":106914},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3170":64243,"_27782":64191,"_19244":106916,"_5":13232,"_26277":106781,"_2666":45605},[],{"_3170":64244,"_27782":64191,"_19244":106918,"_5":13232,"_26277":106781,"_2666":5936},[],{"_3170":64245,"_27782":64191,"_19244":106920,"_5":13232,"_26277":106781,"_2666":106921},[],"Omite prompts y genera credenciales para las dependencias",{"_3170":64246,"_27782":64191,"_19244":106923,"_5":13232,"_26277":106781,"_2666":45613},[],{"_3170":64247,"_27782":64191,"_19244":106925,"_5":13232,"_26277":106781,"_2666":45616},[],{"_3170":64248,"_27782":64191,"_19244":106927,"_5":13232,"_26277":106781,"_2666":106928},[],"Namespace de la instalación",{"_3170":64249,"_27782":64191,"_19244":106930,"_5":13232,"_26277":106781,"_2666":45622},[],{"_3170":64250,"_27782":64191,"_19244":106932,"_5":13232,"_26277":106781,"_2666":45625},[],{"_3170":64251,"_27782":64191,"_19244":106934,"_5":13232,"_26277":106781,"_2666":106935},[],"Dominio usado por la UI, OIDC y el certificado",{"_3170":64252,"_27782":64191,"_19244":106937,"_5":13232,"_26277":106781,"_2666":45631},[],{"_3170":64253,"_27782":64191,"_19244":106939,"_5":13232,"_26277":106781,"_2666":13852},[],{"_3170":64254,"_27782":64191,"_19244":106941,"_5":13232,"_26277":106781,"_2666":106942},[],"Versión del chart de Lamassu",{"_3170":64255,"_27782":64191,"_19244":106944,"_5":13232,"_26277":106781,"_2666":45639},[],{"_3170":64256,"_27782":64191,"_19244":106946,"_5":13232,"_26277":106781,"_2666":45642},[],{"_3170":64257,"_27782":64191,"_19244":106948,"_5":13232,"_26277":106781,"_2666":106949},[],"Puerto del listener HTTPS",{"_3170":64258,"_27782":64191,"_19244":106951,"_5":13232,"_26277":106781,"_2666":45648},[],{"_3170":64259,"_27782":64191,"_19244":106953,"_5":13232,"_26277":106781,"_2666":45651},[],{"_3170":64260,"_27782":64191,"_19244":106955,"_5":13232,"_26277":106781,"_2666":106956},[],"Puerto del listener HTTP",{"_3170":64261,"_27782":64191,"_19244":106958,"_5":13232,"_26277":106781,"_2666":45657},[],{"_3170":64262,"_27782":64191,"_19244":106960,"_5":13232,"_26277":106781,"_2666":45590},[],{"_3170":64263,"_27782":64191,"_19244":106962,"_5":13232,"_26277":106781,"_2666":106963},[],"Certificado PEM para TLS downstream",{"_3170":64264,"_27782":64191,"_19244":106965,"_5":13232,"_26277":106781,"_2666":45665},[],{"_3170":64265,"_27782":64191,"_19244":106967,"_5":13232,"_26277":106781,"_2666":45590},[],{"_3170":64266,"_27782":64191,"_19244":106969,"_5":13232,"_26277":106781,"_2666":106970},[],"Clave privada PEM para TLS downstream",{"_3170":64267,"_27782":64191,"_19244":106972,"_5":13232,"_26277":106781,"_2666":45673},[],{"_3170":64268,"_27782":64191,"_19244":106974,"_5":13232,"_26277":106781,"_2666":106975},[],"chart del repositorio",{"_3170":64269,"_27782":64191,"_19244":106977,"_5":13232,"_26277":106781,"_2666":106978},[],"Usa un chart local de Lamassu sin empaquetar",{"_3170":64270,"_27782":64191,"_19244":106980,"_5":13232,"_26277":106781,"_2666":45682},[],{"_3170":64271,"_27782":64191,"_19244":106982,"_5":13232,"_26277":106781,"_2666":106983},[],"detección automática",{"_3170":64272,"_27782":64191,"_19244":106985,"_5":13232,"_26277":106781,"_2666":106986},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3170":64273,"_27782":64191,"_19244":106988,"_5":13232,"_26277":106781,"_2666":45690},[],{"_3170":64274,"_27782":64191,"_19244":106990,"_5":13232,"_26277":106781,"_2666":5936},[],{"_3170":64275,"_27782":64191,"_19244":106992,"_5":13232,"_26277":106781,"_2666":106993},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3170":64276,"_27782":64191,"_19244":106995,"_5":13232,"_26277":106781,"_2666":45698},[],{"_3170":64277,"_27782":64191,"_19244":106997,"_5":13232,"_26277":106781,"_2666":5936},[],{"_3170":64278,"_27782":64191,"_19244":106999,"_5":13232,"_26277":106781,"_2666":107000},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3170":64279,"_27782":64191,"_19244":107002,"_5":13232,"_26277":106781,"_2666":45706},[],{"_3170":64280,"_27782":64191,"_19244":107004,"_5":13232,"_26277":106781,"_2666":5936},[],{"_3170":64281,"_27782":64191,"_19244":107006,"_5":13232,"_26277":106781,"_2666":107007},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3170":64282,"_27782":64191,"_19244":107009,"_5":13232,"_26277":106781,"_2666":45714},[],{"_3170":64283,"_27782":64191,"_19244":107011,"_5":13232,"_26277":106781,"_2666":5936},[],{"_3170":64284,"_27782":64191,"_19244":107013,"_5":13232,"_26277":106781,"_2666":107014},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3170":64285,"_27782":64191,"_19244":107016,"_5":13232,"_26277":106781,"_2666":45722},[],{"_3170":64286,"_27782":64191,"_19244":107018,"_5":13232,"_26277":106781,"_2666":45725},[],{"_3170":64287,"_27782":64191,"_19244":107020,"_5":13232,"_26277":106781,"_2666":107021},[],"Usa otro chart local de SoftHSM",{"_3170":64288,"_27782":64191,"_19244":107023,"_5":13232,"_26277":106781,"_2666":107024},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3170":64289,"_27782":64191,"_19244":107026,"_5":13232,"_26277":106785,"_2666":107027},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3170":64290,"_27782":64191,"_19244":107029,"_5":13232,"_26277":106785,"_2666":107030},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3170":64291,"_27782":64191,"_19244":107032,"_5":13232,"_26277":106785,"_2666":107033},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3170":64292,"_27782":64191,"_19244":107035,"_5":13232,"_26277":106785,"_2666":107036},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3170":64293,"_27782":64191,"_19244":107038,"_5":13232,"_26277":106785,"_2666":107039},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3170":64294,"_27782":64191,"_19244":107041,"_5":13232,"_26277":106785,"_2666":107042},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3170":64295,"_27782":64191,"_19244":107044,"_5":13232,"_26277":106789,"_2666":45752},[],{"_3170":64296,"_27782":64191,"_19244":107046,"_5":13232,"_26277":106789,"_2666":107047},[],"valida las herramientas locales y el clúster seleccionado",{"_3170":64297,"_27782":64191,"_19244":107049,"_5":13232,"_26277":106789,"_2666":107050},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3170":64298,"_27782":64191,"_19244":107052,"_5":13232,"_26277":106789,"_2666":107053},[],"crea el namespace",{"_3170":64299,"_27782":64191,"_19244":107055,"_5":13232,"_26277":106789,"_2666":107056},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3170":64300,"_27782":64191,"_19244":107058,"_5":13232,"_26277":106789,"_2666":107059},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3170":64301,"_27782":64191,"_19244":107061,"_5":13232,"_26277":106789,"_2666":107062},[],"instala RabbitMQ",{"_3170":64302,"_27782":64191,"_19244":107064,"_5":13232,"_26277":106789,"_2666":107065},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3170":64303,"_27782":64191,"_19244":107067,"_5":13232,"_26277":106789,"_2666":107068},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_3170":64304,"_27782":64191,"_19244":107070,"_5":13232,"_26277":106789,"_2666":107071},[],"carga datos de ejemplo opcionalmente",{"_3170":64305,"_27782":64191,"_19244":107073,"_5":13232,"_26277":106789,"_2666":107074},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3170":64306,"_27782":64191,"_19244":107076,"_5":13232,"_26277":106793,"_2666":107077},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3170":64307,"_27782":64191,"_19244":107079,"_5":13232,"_26277":106793,"_2666":107080},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3170":64308,"_27782":64191,"_19244":107082,"_5":13232,"_26277":106797,"_2666":107083},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3170":64309,"_27782":64191,"_19244":107085,"_5":13232,"_26277":106797,"_2666":107086},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_3170":64310,"_27782":64191,"_19244":107088,"_5":13232,"_26277":106797,"_2666":107089},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3170":64311,"_27782":64191,"_19244":107091,"_5":13232,"_26277":106801,"_2666":107092},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3170":64312,"_27782":64312,"_5":13558,"_2666":107094,"_28124":107095,"_19244":107096,"_26277":64312},"Instala con Helm",[45194,106520,106754],[],{"_3170":64313,"_27782":64312,"_19244":107098,"_5":13232,"_26277":64312,"_2666":107099},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3170":64314,"_27782":64312,"_5":28121,"_19244":107101,"_26277":107102,"_2666":107103},[],"/docs/pr-preview/pr-52/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3170":64315,"_27782":64312,"_5":28121,"_19244":107105,"_26277":107106,"_2666":106770},[],"/docs/pr-preview/pr-52/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3170":64316,"_27782":64312,"_5":28121,"_19244":107108,"_26277":107109,"_2666":107110},[],"/docs/pr-preview/pr-52/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3170":64317,"_27782":64312,"_5":28121,"_19244":107112,"_26277":107113,"_2666":107114},[],"/docs/pr-preview/pr-52/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3170":64318,"_27782":64312,"_5":28121,"_19244":107116,"_26277":107117,"_2666":107118},[],"/docs/pr-preview/pr-52/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3170":64319,"_27782":64312,"_5":28121,"_19244":107120,"_26277":107121,"_2666":107122},[],"/docs/pr-preview/pr-52/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3170":64320,"_27782":64312,"_5":28121,"_19244":107124,"_26277":107125,"_2666":107126},[],"/docs/pr-preview/pr-52/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3170":64321,"_27782":64312,"_5":28121,"_19244":107128,"_26277":107129,"_2666":107130},[],"/docs/pr-preview/pr-52/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3170":64322,"_27782":64312,"_5":28121,"_19244":107132,"_26277":107133,"_2666":107134},[],"/docs/pr-preview/pr-52/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3170":64323,"_27782":64312,"_19244":107136,"_5":13232,"_26277":107102,"_2666":107137},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3170":64324,"_27782":64312,"_19244":107139,"_5":13232,"_26277":107106,"_2666":107140},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3170":64325,"_27782":64312,"_19244":107142,"_5":13232,"_26277":107106,"_2666":107143},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3170":64326,"_27782":64312,"_19244":107145,"_5":13232,"_26277":107106,"_2666":107146},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3170":64327,"_27782":64312,"_19244":107148,"_5":13232,"_26277":107106,"_2666":107149},[],"un broker RabbitMQ accesible y sus credenciales",{"_3170":64328,"_27782":64312,"_19244":107151,"_5":13232,"_26277":107106,"_2666":107152},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3170":64329,"_27782":64312,"_19244":107154,"_5":13232,"_26277":107106,"_2666":107155},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3170":64330,"_27782":64312,"_19244":107157,"_5":13232,"_26277":107106,"_2666":107158},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3170":64331,"_27782":64312,"_19244":107160,"_5":13232,"_26277":107106,"_2666":107161},[],"una StorageClass y un diseño de tráfico externo",{"_3170":64332,"_27782":64312,"_19244":107163,"_5":13232,"_26277":107106,"_2666":107164},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3170":64333,"_27782":64312,"_19244":107166,"_5":13232,"_26277":107106,"_2666":107167},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3170":64334,"_27782":64312,"_19244":107169,"_5":13232,"_26277":107106,"_2666":107170},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3170":64335,"_27782":64312,"_19244":107172,"_5":13232,"_26277":107109,"_2666":107173},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3170":64336,"_27782":64312,"_19244":107175,"_5":13232,"_26277":107109,"_2666":107176},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3170":64337,"_27782":64312,"_19244":107178,"_5":13232,"_26277":107109,"_2666":107179},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_3170":64338,"_27782":64312,"_19244":107181,"_5":13232,"_26277":107113,"_2666":107182},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3170":64339,"_27782":64312,"_19244":107184,"_5":13232,"_26277":107113,"_2666":107185},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3170":64340,"_27782":64312,"_19244":107187,"_5":13232,"_26277":107113,"_2666":107188},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3170":64341,"_27782":64312,"_19244":107190,"_5":13232,"_26277":107117,"_2666":107191},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_3170":64342,"_27782":64312,"_19244":107193,"_5":13232,"_26277":107121,"_2666":107194},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3170":64343,"_27782":64312,"_19244":107196,"_5":13232,"_26277":107121,"_2666":107197},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3170":64344,"_27782":64312,"_19244":107199,"_5":13232,"_26277":107121,"_2666":107200},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3170":64345,"_27782":64312,"_19244":107202,"_5":13232,"_26277":107121,"_2666":107203},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3170":64346,"_27782":64312,"_19244":107205,"_5":13232,"_26277":107125,"_2666":107206},[],"Para instalar un checkout local:",{"_3170":64347,"_27782":64312,"_19244":107208,"_5":13232,"_26277":107129,"_2666":107209},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3170":64348,"_27782":64312,"_19244":107211,"_5":13232,"_26277":107129,"_2666":107212},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3170":64349,"_27782":64312,"_19244":107214,"_5":13232,"_26277":107133,"_2666":107215},[],"Antes de pasar a producción, revisa:",{"_3170":64350,"_27782":64312,"_19244":107217,"_5":13232,"_26277":107133,"_2666":107218},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3170":64351,"_27782":64312,"_19244":107220,"_5":13232,"_26277":107133,"_2666":107221},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3170":64352,"_27782":64312,"_19244":107223,"_5":13232,"_26277":107133,"_2666":107224},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3170":64353,"_27782":64312,"_19244":107226,"_5":13232,"_26277":107133,"_2666":107227},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3170":64354,"_27782":64312,"_19244":107229,"_5":13232,"_26277":107133,"_2666":107230},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3170":64355,"_27782":64312,"_19244":107232,"_5":13232,"_26277":107133,"_2666":107233},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3170":64356,"_27782":64312,"_19244":107235,"_5":13232,"_26277":107133,"_2666":107236},[],"SMTP, observabilidad y entrega de alertas",{"_3170":64357,"_27782":64312,"_19244":107238,"_5":13232,"_26277":107133,"_2666":107239},[],"las guías de actualización entre versiones y las notas de `charts/lamassu/CHANGELOG/` antes de cada upgrade",{"_3170":64358,"_27782":64312,"_19244":107241,"_5":13232,"_26277":107133,"_2666":107242},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3170":64359,"_27782":64359,"_5":13558,"_2666":107244,"_28124":107245,"_19244":107246,"_26277":64359},"Expón el Gateway",[45194,106520,106754],[],{"_3170":64360,"_27782":64359,"_19244":107248,"_5":13232,"_26277":64359,"_2666":107249},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3170":64361,"_27782":64359,"_5":28121,"_19244":107251,"_26277":107252,"_2666":107253},[],"/docs/pr-preview/pr-52/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3170":64362,"_27782":64359,"_5":28121,"_19244":107255,"_26277":107256,"_2666":107257},[],"/docs/pr-preview/pr-52/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3170":64363,"_27782":64359,"_5":28121,"_19244":107259,"_26277":107260,"_2666":107261},[],"/docs/pr-preview/pr-52/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3170":64364,"_27782":64359,"_5":28121,"_19244":107263,"_26277":107264,"_2666":45973},[],"/docs/pr-preview/pr-52/es/deployment/self-hosted/networking#k3s",{"_3170":64365,"_27782":64359,"_5":28121,"_19244":107266,"_26277":107267,"_2666":107268},[],"/docs/pr-preview/pr-52/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3170":64366,"_27782":64359,"_5":28121,"_19244":107270,"_26277":107271,"_2666":107272},[],"/docs/pr-preview/pr-52/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3170":64367,"_27782":64359,"_5":28121,"_19244":107274,"_26277":107275,"_2666":107276},[],"/docs/pr-preview/pr-52/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3170":64368,"_27782":64359,"_5":28121,"_19244":107278,"_26277":107279,"_2666":107280},[],"/docs/pr-preview/pr-52/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3170":64369,"_27782":64359,"_5":28121,"_19244":107282,"_26277":107283,"_2666":107284},[],"/docs/pr-preview/pr-52/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3170":64370,"_27782":64359,"_19244":107286,"_5":13232,"_26277":107252,"_2666":107287},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3170":64371,"_27782":64359,"_19244":107289,"_5":13232,"_26277":107252,"_2666":107290},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3170":64372,"_27782":64359,"_19244":107292,"_5":13232,"_26277":107256,"_2666":107293},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3170":64373,"_27782":64359,"_19244":107295,"_5":13232,"_26277":107256,"_2666":107296},[],"Defínelo únicamente cuando:",{"_3170":64374,"_27782":64359,"_19244":107298,"_5":13232,"_26277":107256,"_2666":107299},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3170":64375,"_27782":64359,"_19244":107301,"_5":13232,"_26277":107256,"_2666":107302},[],"esa dirección está asignada a este Gateway",{"_3170":64376,"_27782":64359,"_19244":107304,"_5":13232,"_26277":107256,"_2666":107305},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3170":64377,"_27782":64359,"_19244":107307,"_5":13232,"_26277":107256,"_2666":107308},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3170":64378,"_27782":64359,"_19244":107310,"_5":13232,"_26277":107256,"_2666":107311},[],"No confundas estos valores:",{"_3170":64379,"_27782":64359,"_19244":107313,"_5":13232,"_26277":107256,"_2666":107314},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3170":64380,"_27782":64359,"_19244":107316,"_5":13232,"_26277":107256,"_2666":107317},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3170":64381,"_27782":64359,"_19244":107319,"_5":13232,"_26277":107256,"_2666":107320},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3170":64382,"_27782":64359,"_19244":107322,"_5":13232,"_26277":107260,"_2666":107323},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3170":64383,"_27782":64359,"_19244":107325,"_5":13232,"_26277":107260,"_2666":107326},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3170":64384,"_27782":64359,"_19244":107328,"_5":13232,"_26277":107264,"_2666":107329},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3170":64385,"_27782":64359,"_19244":107331,"_5":13232,"_26277":107264,"_2666":107332},[],"Para el diseño recomendado:",{"_3170":64386,"_27782":64359,"_19244":107334,"_5":13232,"_26277":107264,"_2666":107335},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3170":64387,"_27782":64359,"_19244":107337,"_5":13232,"_26277":107264,"_2666":107338},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3170":64388,"_27782":64359,"_19244":107340,"_5":13232,"_26277":107264,"_2666":107341},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3170":64389,"_27782":64359,"_19244":107343,"_5":13232,"_26277":107264,"_2666":107344},[],"Apunta DNS a la dirección accesible de la VM.",{"_3170":64390,"_27782":64359,"_19244":107346,"_5":13232,"_26277":107264,"_2666":107347},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3170":64391,"_27782":64359,"_19244":107349,"_5":13232,"_26277":107267,"_2666":107350},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3170":64392,"_27782":64359,"_19244":107352,"_5":13232,"_26277":107271,"_2666":107353},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3170":64393,"_27782":64359,"_19244":107355,"_5":13232,"_26277":107271,"_2666":107356},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3170":64394,"_27782":64359,"_19244":107358,"_5":13232,"_26277":107275,"_2666":107359},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3170":64395,"_27782":64359,"_19244":107361,"_5":13232,"_26277":107275,"_2666":107362},[],"Requisito",{"_3170":64396,"_27782":64359,"_19244":107364,"_5":13232,"_26277":107275,"_2666":107365},[],"Diseño recomendado",{"_3170":64397,"_27782":64359,"_19244":107367,"_5":13232,"_26277":107275,"_2666":107368},[],"Consecuencia",{"_3170":64398,"_27782":64359,"_19244":107370,"_5":13232,"_26277":107275,"_2666":107371},[],"Varias URL o servicios de Lamassu",{"_3170":64399,"_27782":64359,"_19244":107373,"_5":13232,"_26277":107275,"_2666":107374},[],"Un Gateway con varias rutas",{"_3170":64400,"_27782":64359,"_19244":107376,"_5":13232,"_26277":107275,"_2666":107377},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3170":64401,"_27782":64359,"_19244":107379,"_5":13232,"_26277":107275,"_2666":107380},[],"Gateways independientes e IP externas distintas",{"_3170":64402,"_27782":64359,"_19244":107382,"_5":13232,"_26277":107275,"_2666":107383},[],"Una VIP por Gateway",{"_3170":64403,"_27782":64359,"_19244":107385,"_5":13232,"_26277":107275,"_2666":107386},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3170":64404,"_27782":64359,"_19244":107388,"_5":13232,"_26277":107275,"_2666":107389},[],"Gateways independientes, un nodo y una IP",{"_3170":64405,"_27782":64359,"_19244":107391,"_5":13232,"_26277":107275,"_2666":107392},[],"Puertos externos diferentes",{"_3170":64406,"_27782":64359,"_19244":107394,"_5":13232,"_26277":107275,"_2666":107395},[],"Los clientes deben indicar puertos no estándar",{"_3170":64407,"_27782":64359,"_19244":107397,"_5":13232,"_26277":107275,"_2666":107398},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3170":64408,"_27782":64359,"_19244":107400,"_5":13232,"_26277":107275,"_2666":107401},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3170":64409,"_27782":64359,"_19244":107403,"_5":13232,"_26277":107275,"_2666":107404},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3170":64410,"_27782":64359,"_19244":107406,"_5":13232,"_26277":107275,"_2666":107407},[],"Recursos Gateway separados pero proxy compartido",{"_3170":64411,"_27782":64359,"_19244":107409,"_5":13232,"_26277":107275,"_2666":107410},[],"Modo merged Gateway de Envoy",{"_3170":64412,"_27782":64359,"_19244":107412,"_5":13232,"_26277":107275,"_2666":107413},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3170":64413,"_27782":64359,"_19244":107415,"_5":13232,"_26277":107275,"_2666":107416},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3170":64414,"_27782":64359,"_19244":107418,"_5":13232,"_26277":107275,"_2666":107419},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3170":64415,"_27782":64359,"_19244":107421,"_5":13232,"_26277":107275,"_2666":107422},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3170":64416,"_27782":64359,"_19244":107424,"_5":13232,"_26277":107275,"_2666":107425},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3170":64417,"_27782":64359,"_19244":107427,"_5":13232,"_26277":107279,"_2666":107428},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3170":64418,"_27782":64359,"_19244":107430,"_5":13232,"_26277":107279,"_2666":107431},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3170":64419,"_27782":64359,"_19244":107433,"_5":13232,"_26277":107279,"_2666":107434},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3170":64420,"_27782":64359,"_19244":107436,"_5":13232,"_26277":107279,"_2666":107437},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3170":64421,"_27782":64359,"_19244":107439,"_5":13232,"_26277":107279,"_2666":107440},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3170":64422,"_27782":64359,"_19244":107442,"_5":13232,"_26277":107283,"_2666":107443},[],"Comprueba, en orden:",{"_3170":64423,"_27782":64359,"_19244":107445,"_5":13232,"_26277":107283,"_2666":107446},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3170":64424,"_27782":64359,"_19244":107448,"_5":13232,"_26277":107283,"_2666":107449},[],"Su estado contiene la dirección esperada.",{"_3170":64425,"_27782":64359,"_19244":107451,"_5":13232,"_26277":107283,"_2666":107452},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3170":64426,"_27782":64359,"_19244":107454,"_5":13232,"_26277":107283,"_2666":107455},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3170":64427,"_27782":64359,"_19244":107457,"_5":13232,"_26277":107283,"_2666":107458},[],"DNS resuelve al endpoint accesible externamente.",{"_3170":64428,"_27782":64359,"_19244":107460,"_5":13232,"_26277":107283,"_2666":107461},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3170":64429,"_27782":64359,"_19244":107463,"_5":13232,"_26277":107283,"_2666":107464},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3170":64430,"_27782":64430,"_5":13558,"_2666":45301,"_28124":107466,"_19244":107467,"_26277":64430},[45194,106520,106754],[],{"_3170":64431,"_27782":64430,"_19244":107469,"_5":13232,"_26277":64430,"_2666":107470},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3170":64432,"_27782":64430,"_5":28121,"_19244":107472,"_26277":107473,"_2666":107474},[],"/docs/pr-preview/pr-52/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3170":64433,"_27782":64430,"_5":28121,"_19244":107476,"_26277":107477,"_2666":107478},[],"/docs/pr-preview/pr-52/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3170":64434,"_27782":64430,"_5":28121,"_19244":107480,"_26277":107481,"_2666":107482},[],"/docs/pr-preview/pr-52/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3170":64435,"_27782":64430,"_5":28121,"_19244":107484,"_26277":107485,"_2666":107486},[],"/docs/pr-preview/pr-52/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3170":64436,"_27782":64430,"_5":28121,"_19244":107488,"_26277":107489,"_2666":107490},[],"/docs/pr-preview/pr-52/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3170":64437,"_27782":64430,"_5":28121,"_19244":107492,"_26277":107493,"_2666":107494},[],"/docs/pr-preview/pr-52/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3170":64438,"_27782":64430,"_19244":107496,"_5":13232,"_26277":107473,"_2666":107497},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3170":64439,"_27782":64430,"_19244":107499,"_5":13232,"_26277":107477,"_2666":107500},[],"Flujo",{"_3170":64440,"_27782":64430,"_19244":107502,"_5":13232,"_26277":107477,"_2666":107503},[],"Úsalo para",{"_3170":64441,"_27782":64430,"_19244":107505,"_5":13232,"_26277":107477,"_2666":107506},[],"Qué instala",{"_3170":64442,"_27782":64430,"_19244":107508,"_5":13232,"_26277":107477,"_2666":46218},[],{"_3170":64443,"_27782":64430,"_19244":107510,"_5":13232,"_26277":107477,"_2666":107511},[],"Producción y entornos controlados",{"_3170":64444,"_27782":64430,"_19244":107513,"_5":13232,"_26277":107477,"_2666":107514},[],"Servicios de Lamassu y recursos de Gateway API",{"_3170":64445,"_27782":64430,"_19244":107516,"_5":13232,"_26277":107477,"_2666":45438},[],{"_3170":64446,"_27782":64430,"_19244":107518,"_5":13232,"_26277":107477,"_2666":107519},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3170":64447,"_27782":64430,"_19244":107521,"_5":13232,"_26277":107477,"_2666":107522},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3170":64448,"_27782":64430,"_19244":107524,"_5":13232,"_26277":107481,"_2666":107525},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3170":64449,"_27782":64430,"_19244":107527,"_5":13232,"_26277":107481,"_2666":107528},[],"Área",{"_3170":64450,"_27782":64430,"_19244":107530,"_5":13232,"_26277":107481,"_2666":107531},[],"El chart de Lamassu proporciona",{"_3170":64451,"_27782":64430,"_19244":107533,"_5":13232,"_26277":107481,"_2666":107534},[],"Tú proporcionas",{"_3170":64452,"_27782":64430,"_19244":107536,"_5":13232,"_26277":107481,"_2666":107537},[],"Aplicaciones Lamassu",{"_3170":64453,"_27782":64430,"_19244":107539,"_5":13232,"_26277":107481,"_2666":107540},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3170":64454,"_27782":64430,"_19244":107542,"_5":13232,"_26277":107481,"_2666":107543},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3170":64455,"_27782":64430,"_19244":107545,"_5":13232,"_26277":107481,"_2666":107546},[],"Datos PostgreSQL",{"_3170":64456,"_27782":64430,"_19244":107548,"_5":13232,"_26277":107481,"_2666":107549},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3170":64457,"_27782":64430,"_19244":107551,"_5":13232,"_26277":107481,"_2666":107552},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3170":64458,"_27782":64430,"_19244":107554,"_5":13232,"_26277":107481,"_2666":107555},[],"Mensajería",{"_3170":64459,"_27782":64430,"_19244":107557,"_5":13232,"_26277":107481,"_2666":107558},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu",{"_3170":64460,"_27782":64430,"_19244":107560,"_5":13232,"_26277":107481,"_2666":107561},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3170":64461,"_27782":64430,"_19244":107563,"_5":13232,"_26277":107481,"_2666":107564},[],"Identidad",{"_3170":64462,"_27782":64430,"_19244":107566,"_5":13232,"_26277":107481,"_2666":107567},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3170":64463,"_27782":64430,"_19244":107569,"_5":13232,"_26277":107481,"_2666":107570},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3170":64464,"_27782":64430,"_19244":107572,"_5":13232,"_26277":107481,"_2666":107573},[],"Enrutamiento externo",{"_3170":64465,"_27782":64430,"_19244":107575,"_5":13232,"_26277":107481,"_2666":107576},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3170":64466,"_27782":64430,"_19244":107578,"_5":13232,"_26277":107481,"_2666":107579},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3170":64467,"_27782":64430,"_19244":107581,"_5":13232,"_26277":107481,"_2666":46292},[],{"_3170":64468,"_27782":64430,"_19244":107583,"_5":13232,"_26277":107481,"_2666":107584},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_3170":64469,"_27782":64430,"_19244":107586,"_5":13232,"_26277":107481,"_2666":107587},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3170":64470,"_27782":64430,"_19244":107589,"_5":13232,"_26277":107481,"_2666":107590},[],"Datos persistentes de la aplicación",{"_3170":64471,"_27782":64430,"_19244":107592,"_5":13232,"_26277":107481,"_2666":107593},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3170":64472,"_27782":64430,"_19244":107595,"_5":13232,"_26277":107481,"_2666":107596},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3170":64473,"_27782":64430,"_19244":107598,"_5":13232,"_26277":107481,"_2666":107599},[],"Integraciones opcionales",{"_3170":64474,"_27782":64430,"_19244":107601,"_5":13232,"_26277":107481,"_2666":107602},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3170":64475,"_27782":64430,"_19244":107604,"_5":13232,"_26277":107481,"_2666":107605},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3170":64476,"_27782":64430,"_19244":107607,"_5":13232,"_26277":107481,"_2666":107608},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3170":64477,"_27782":64430,"_19244":107610,"_5":13232,"_26277":107481,"_2666":107611},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3170":64478,"_27782":64430,"_19244":107613,"_5":13232,"_26277":107485,"_2666":107614},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3170":64479,"_27782":64430,"_19244":107616,"_5":13232,"_26277":107485,"_2666":107617},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3170":64480,"_27782":64430,"_19244":107619,"_5":13232,"_26277":107489,"_2666":107620},[],"Kubernetes 1.24 o posterior",{"_3170":64481,"_27782":64430,"_19244":107622,"_5":13232,"_26277":107489,"_2666":107623},[],"Helm 3.2 o posterior",{"_3170":64482,"_27782":64430,"_19244":107625,"_5":13232,"_26277":107489,"_2666":107626},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3170":64483,"_27782":64430,"_19244":107628,"_5":13232,"_26277":107489,"_2666":107629},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_3170":64484,"_27782":64430,"_19244":107631,"_5":13232,"_26277":107489,"_2666":107632},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3170":64485,"_27782":64430,"_19244":107634,"_5":13232,"_26277":107489,"_2666":107635},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3170":64486,"_27782":64430,"_19244":107637,"_5":13232,"_26277":107489,"_2666":107638},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3170":64487,"_27782":64430,"_19244":107640,"_5":13232,"_26277":107493,"_2666":107641},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3170":64488,"_27782":64430,"_19244":107643,"_5":13232,"_26277":107493,"_2666":107644},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3170":64489,"_27782":64430,"_19244":107646,"_5":13232,"_26277":107493,"_2666":107647},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3170":64490,"_27782":64430,"_19244":107649,"_5":13232,"_26277":107493,"_2666":107650},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3170":64491,"_27782":64491,"_5":13558,"_2666":107652,"_28124":107653,"_19244":107655,"_26277":64491},"Resolución de problemas de despliegue",[45194,106520,107654],"Operación",[],{"_3170":64492,"_27782":64491,"_19244":107657,"_5":13232,"_26277":64491,"_2666":107658},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3170":64493,"_27782":64491,"_5":28121,"_19244":107660,"_26277":107661,"_2666":107662},[],"/docs/pr-preview/pr-52/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3170":64494,"_27782":64491,"_5":28121,"_19244":107664,"_26277":107665,"_2666":107666},[],"/docs/pr-preview/pr-52/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3170":64495,"_27782":64491,"_5":28121,"_19244":107668,"_26277":107669,"_2666":107670},[],"/docs/pr-preview/pr-52/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3170":64496,"_27782":64491,"_5":28121,"_19244":107672,"_26277":107673,"_2666":107674},[],"/docs/pr-preview/pr-52/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3170":64497,"_27782":64491,"_5":28121,"_19244":107676,"_26277":107677,"_2666":107678},[],"/docs/pr-preview/pr-52/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3170":64498,"_27782":64491,"_5":28121,"_19244":107680,"_26277":107681,"_2666":107682},[],"/docs/pr-preview/pr-52/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3170":64499,"_27782":64491,"_5":28121,"_19244":107684,"_26277":107685,"_2666":107686},[],"/docs/pr-preview/pr-52/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3170":64500,"_27782":64491,"_5":28121,"_19244":107688,"_26277":107689,"_2666":107690},[],"/docs/pr-preview/pr-52/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3170":64501,"_27782":64491,"_5":28121,"_19244":107692,"_26277":107693,"_2666":107694},[],"/docs/pr-preview/pr-52/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3170":64502,"_27782":64491,"_5":28121,"_19244":107696,"_26277":107697,"_2666":107698},[],"/docs/pr-preview/pr-52/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3170":64503,"_27782":64491,"_5":28121,"_19244":107700,"_26277":107701,"_2666":107702},[],"/docs/pr-preview/pr-52/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3170":64504,"_27782":64491,"_5":28121,"_19244":107704,"_26277":107705,"_2666":107706},[],"/docs/pr-preview/pr-52/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3170":64505,"_27782":64491,"_19244":107708,"_5":13232,"_26277":64491,"_2666":107709},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3170":64506,"_27782":64491,"_19244":107711,"_5":13232,"_26277":107665,"_2666":107712},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3170":64507,"_27782":64491,"_19244":107714,"_5":13232,"_26277":107669,"_2666":107715},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3170":64508,"_27782":64491,"_19244":107717,"_5":13232,"_26277":107673,"_2666":107718},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3170":64509,"_27782":64491,"_19244":107720,"_5":13232,"_26277":107677,"_2666":107721},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3170":64510,"_27782":64491,"_19244":107723,"_5":13232,"_26277":107681,"_2666":107724},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3170":64511,"_27782":64491,"_19244":107726,"_5":13232,"_26277":107685,"_2666":107727},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3170":64512,"_27782":64491,"_19244":107729,"_5":13232,"_26277":107685,"_2666":107730},[],"Ejecuta también la prueba de conectividad del chart:",{"_3170":64513,"_27782":64491,"_19244":107732,"_5":13232,"_26277":107685,"_2666":107733},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3170":64514,"_27782":64491,"_19244":107735,"_5":13232,"_26277":107685,"_2666":107736},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3170":64515,"_27782":64491,"_19244":107738,"_5":13232,"_26277":107689,"_2666":107739},[],"Si recibes un 401:",{"_3170":64516,"_27782":64491,"_19244":107741,"_5":13232,"_26277":107689,"_2666":107742},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3170":64517,"_27782":64491,"_19244":107744,"_5":13232,"_26277":107689,"_2666":107745},[],"verifica emisor, audiencia y expiración del token;",{"_3170":64518,"_27782":64491,"_19244":107747,"_5":13232,"_26277":107689,"_2666":107748},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3170":64519,"_27782":64491,"_19244":107750,"_5":13232,"_26277":107689,"_2666":107751},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3170":64520,"_27782":64491,"_19244":107753,"_5":13232,"_26277":107689,"_2666":107754},[],"Si el login termina pero las APIs devuelven 403:",{"_3170":64521,"_27782":64491,"_19244":107756,"_5":13232,"_26277":107689,"_2666":107757},[],"inspecciona los claims reales del token;",{"_3170":64522,"_27782":64491,"_19244":107759,"_5":13232,"_26277":107689,"_2666":107760},[],"confirma que coinciden con un principal activo;",{"_3170":64523,"_27782":64491,"_19244":107762,"_5":13232,"_26277":107689,"_2666":107763},[],"revisa las políticas concedidas al principal;",{"_3170":64524,"_27782":64491,"_19244":107765,"_5":13232,"_26277":107689,"_2666":107766},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3170":64525,"_27782":64491,"_19244":107768,"_5":13232,"_26277":107689,"_2666":107769},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3170":64526,"_27782":64491,"_19244":107771,"_5":13232,"_26277":107693,"_2666":107772},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3170":64527,"_27782":64491,"_19244":107774,"_5":13232,"_26277":107693,"_2666":107775},[],"Localiza el pod y Service de authz.",{"_3170":64528,"_27782":64491,"_19244":107777,"_5":13232,"_26277":107693,"_2666":107778},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3170":64529,"_27782":64491,"_19244":107780,"_5":13232,"_26277":107693,"_2666":107781},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3170":64530,"_27782":64491,"_19244":107783,"_5":13232,"_26277":107693,"_2666":107784},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3170":64531,"_27782":64491,"_19244":107786,"_5":13232,"_26277":107693,"_2666":107787},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3170":64532,"_27782":64491,"_19244":107789,"_5":13232,"_26277":107697,"_2666":107790},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3170":64533,"_27782":64491,"_19244":107792,"_5":13232,"_26277":107697,"_2666":107793},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3170":64534,"_27782":64491,"_19244":107795,"_5":13232,"_26277":107697,"_2666":107796},[],"volumen persistente sin enlazar;",{"_3170":64535,"_27782":64491,"_19244":107798,"_5":13232,"_26277":107697,"_2666":107799},[],"imagen inaccesible o política de pull incorrecta;",{"_3170":64536,"_27782":64491,"_19244":107801,"_5":13232,"_26277":107697,"_2666":107802},[],"configuración inválida del motor criptográfico;",{"_3170":64537,"_27782":64491,"_19244":107804,"_5":13232,"_26277":107697,"_2666":107805},[],"límites de CPU o memoria demasiado bajos;",{"_3170":64538,"_27782":64491,"_19244":107807,"_5":13232,"_26277":107697,"_2666":107808},[],"migración previa incompleta.",{"_3170":64539,"_27782":64491,"_19244":107810,"_5":13232,"_26277":107697,"_2666":107811},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3170":64540,"_27782":64491,"_19244":107813,"_5":13232,"_26277":107697,"_2666":107814},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3170":64541,"_27782":64491,"_19244":107816,"_5":13232,"_26277":107701,"_2666":107817},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3170":64542,"_27782":64491,"_19244":107819,"_5":13232,"_26277":107701,"_2666":107820},[],"verifica que esté habilitado en el servicio emisor;",{"_3170":64543,"_27782":64491,"_19244":107822,"_5":13232,"_26277":107701,"_2666":107823},[],"comprueba conectividad y credenciales AMQP;",{"_3170":64544,"_27782":64491,"_19244":107825,"_5":13232,"_26277":107701,"_2666":107826},[],"revisa exchange, routing key, colas y consumidores;",{"_3170":64545,"_27782":64491,"_19244":107828,"_5":13232,"_26277":107701,"_2666":107829},[],"inspecciona dead-letter queues;",{"_3170":64546,"_27782":64491,"_19244":107831,"_5":13232,"_26277":107701,"_2666":107832},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3170":64547,"_27782":64491,"_19244":107834,"_5":13232,"_26277":107701,"_2666":107835},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3170":64548,"_27782":64491,"_19244":107837,"_5":13232,"_26277":107705,"_2666":107838},[],"El chart puede habilitar instrumentación OpenTelemetry. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, authz, servicio y dependencia.",{"_3170":64549,"_27782":64491,"_19244":107840,"_5":13232,"_26277":107705,"_2666":107841},[],"Antes de cerrar una incidencia, guarda:",{"_3170":64550,"_27782":64491,"_19244":107843,"_5":13232,"_26277":107705,"_2666":107844},[],"causa confirmada;",{"_3170":64551,"_27782":64491,"_19244":107846,"_5":13232,"_26277":107705,"_2666":107847},[],"alcance temporal y recursos afectados;",{"_3170":64552,"_27782":64491,"_19244":107849,"_5":13232,"_26277":107705,"_2666":107850},[],"comandos o consultas utilizados;",{"_3170":64553,"_27782":64491,"_19244":107852,"_5":13232,"_26277":107705,"_2666":107853},[],"cambio aplicado y forma de revertirlo;",{"_3170":64554,"_27782":64491,"_19244":107855,"_5":13232,"_26277":107705,"_2666":107856},[],"validación desde un consumidor;",{"_3170":64555,"_27782":64491,"_19244":107858,"_5":13232,"_26277":107705,"_2666":107859},[],"acción preventiva y propietario.",{"_3170":64556,"_27782":64556,"_5":13558,"_2666":107861,"_28124":107862,"_19244":107865,"_26277":64556},"Control de acceso",[45194,107863,107864],"Plataforma","Administración",[],{"_3170":64557,"_27782":64556,"_19244":107867,"_5":13232,"_26277":64556,"_2666":107868},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3170":64558,"_27782":64556,"_5":28121,"_19244":107870,"_26277":107871,"_2666":107872},[],"/docs/pr-preview/pr-52/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3170":64559,"_27782":64556,"_5":28121,"_19244":107874,"_26277":107875,"_2666":107876},[],"/docs/pr-preview/pr-52/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3170":64560,"_27782":64556,"_5":28121,"_19244":107878,"_26277":107879,"_2666":107880},[],"/docs/pr-preview/pr-52/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3170":64561,"_27782":64556,"_5":28121,"_19244":107882,"_26277":107883,"_2666":107884},[],"/docs/pr-preview/pr-52/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3170":64562,"_27782":64556,"_5":28121,"_19244":107886,"_26277":107887,"_2666":107888},[],"/docs/pr-preview/pr-52/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3170":64563,"_27782":64556,"_5":28121,"_19244":107890,"_26277":107891,"_2666":107892},[],"/docs/pr-preview/pr-52/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3170":64564,"_27782":64556,"_5":28121,"_19244":107894,"_26277":107895,"_2666":107896},[],"/docs/pr-preview/pr-52/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3170":64565,"_27782":64556,"_5":28121,"_19244":107898,"_26277":107899,"_2666":107900},[],"/docs/pr-preview/pr-52/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3170":64566,"_27782":64556,"_5":28121,"_19244":107902,"_26277":107903,"_2666":107904},[],"/docs/pr-preview/pr-52/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3170":64567,"_27782":64556,"_5":28121,"_19244":107906,"_26277":107907,"_2666":107908},[],"/docs/pr-preview/pr-52/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3170":64568,"_27782":64556,"_5":28121,"_19244":107910,"_26277":107911,"_2666":107912},[],"/docs/pr-preview/pr-52/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3170":64569,"_27782":64556,"_5":28121,"_19244":107914,"_26277":107915,"_2666":107916},[],"/docs/pr-preview/pr-52/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3170":64570,"_27782":64556,"_5":28121,"_19244":107918,"_26277":107919,"_2666":107920},[],"/docs/pr-preview/pr-52/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3170":64571,"_27782":64556,"_5":28121,"_19244":107922,"_26277":107923,"_2666":107924},[],"/docs/pr-preview/pr-52/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3170":64572,"_27782":64556,"_5":28121,"_19244":107926,"_26277":107927,"_2666":107928},[],"/docs/pr-preview/pr-52/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3170":64573,"_27782":64556,"_5":28121,"_19244":107930,"_26277":107931,"_2666":107122},[],"/docs/pr-preview/pr-52/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3170":64574,"_27782":64556,"_5":28121,"_19244":107933,"_26277":107934,"_2666":107935},[],"/docs/pr-preview/pr-52/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3170":64575,"_27782":64556,"_5":28121,"_19244":107937,"_26277":107938,"_2666":107939},[],"/docs/pr-preview/pr-52/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_3170":64576,"_27782":64556,"_5":28121,"_19244":107941,"_26277":107942,"_2666":107943},[],"/docs/pr-preview/pr-52/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3170":64577,"_27782":64556,"_5":28121,"_19244":107945,"_26277":107946,"_2666":107947},[],"/docs/pr-preview/pr-52/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3170":64578,"_27782":64556,"_5":28121,"_19244":107949,"_26277":107950,"_2666":107951},[],"/docs/pr-preview/pr-52/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3170":64579,"_27782":64556,"_5":28121,"_19244":107953,"_26277":107954,"_2666":107955},[],"/docs/pr-preview/pr-52/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3170":64580,"_27782":64556,"_5":28121,"_19244":107957,"_26277":107958,"_2666":107959},[],"/docs/pr-preview/pr-52/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3170":64581,"_27782":64556,"_5":28121,"_19244":107961,"_26277":107962,"_2666":107963},[],"/docs/pr-preview/pr-52/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3170":64582,"_27782":64556,"_5":28121,"_19244":107965,"_26277":107966,"_2666":107967},[],"/docs/pr-preview/pr-52/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3170":64583,"_27782":64556,"_5":28121,"_19244":107969,"_26277":107970,"_2666":107971},[],"/docs/pr-preview/pr-52/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3170":64584,"_27782":64556,"_5":28121,"_19244":107973,"_26277":107974,"_2666":107975},[],"/docs/pr-preview/pr-52/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3170":64585,"_27782":64556,"_5":28121,"_19244":107977,"_26277":107978,"_2666":107979},[],"/docs/pr-preview/pr-52/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3170":64586,"_27782":64556,"_5":28121,"_19244":107981,"_26277":107982,"_2666":107983},[],"/docs/pr-preview/pr-52/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3170":64587,"_27782":64556,"_5":28121,"_19244":107985,"_26277":107986,"_2666":107987},[],"/docs/pr-preview/pr-52/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3170":64588,"_27782":64556,"_5":28121,"_19244":107989,"_26277":107990,"_2666":107991},[],"/docs/pr-preview/pr-52/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3170":64589,"_27782":64556,"_19244":107993,"_5":13232,"_26277":64556,"_2666":107994},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3170":64590,"_27782":64556,"_19244":107996,"_5":13232,"_26277":64556,"_2666":107997},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3170":64591,"_27782":64556,"_19244":107999,"_5":13232,"_26277":64556,"_2666":108000},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3170":64592,"_27782":64556,"_19244":108002,"_5":13232,"_26277":107871,"_2666":108003},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3170":64593,"_27782":64556,"_19244":108005,"_5":13232,"_26277":107871,"_2666":108006},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3170":64594,"_27782":64556,"_19244":108008,"_5":13232,"_26277":107871,"_2666":108009},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3170":64595,"_27782":64556,"_19244":108011,"_5":13232,"_26277":107871,"_2666":108012},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3170":64596,"_27782":64556,"_19244":108014,"_5":13232,"_26277":107871,"_2666":108015},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3170":64597,"_27782":64556,"_19244":108017,"_5":13232,"_26277":107871,"_2666":108018},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3170":64598,"_27782":64556,"_19244":108020,"_5":13232,"_26277":107875,"_2666":108021},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3170":64599,"_27782":64556,"_19244":108023,"_5":13232,"_26277":107875,"_2666":108024},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3170":64600,"_27782":64556,"_19244":108026,"_5":13232,"_26277":107879,"_2666":108027},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3170":64601,"_27782":64556,"_19244":108029,"_5":13232,"_26277":107879,"_2666":108030},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3170":64602,"_27782":64556,"_19244":108032,"_5":13232,"_26277":107879,"_2666":108033},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3170":64603,"_27782":64556,"_19244":108035,"_5":13232,"_26277":107879,"_2666":108036},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3170":64604,"_27782":64556,"_19244":108038,"_5":13232,"_26277":107879,"_2666":108039},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3170":64605,"_27782":64556,"_19244":108041,"_5":13232,"_26277":107879,"_2666":108042},[],"Carga por separado las políticas concedidas a cada principal.",{"_3170":64606,"_27782":64556,"_19244":108044,"_5":13232,"_26277":107879,"_2666":108045},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3170":64607,"_27782":64556,"_19244":108047,"_5":13232,"_26277":107879,"_2666":108048},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3170":64608,"_27782":64556,"_19244":108050,"_5":13232,"_26277":107879,"_2666":108051},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3170":64609,"_27782":64556,"_19244":108053,"_5":13232,"_26277":107879,"_2666":108054},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3170":64610,"_27782":64556,"_19244":108056,"_5":13232,"_26277":107879,"_2666":108057},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad.",{"_3170":64611,"_27782":64556,"_19244":108059,"_5":13232,"_26277":107879,"_2666":108060},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3170":64612,"_27782":64556,"_19244":108062,"_5":13232,"_26277":107883,"_2666":108063},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3170":64613,"_27782":64556,"_19244":108065,"_5":13232,"_26277":107883,"_2666":108066},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3170":64614,"_27782":64556,"_19244":108068,"_5":13232,"_26277":107883,"_2666":108069},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3170":64615,"_27782":64556,"_19244":108071,"_5":13232,"_26277":107883,"_2666":108072},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3170":64616,"_27782":64556,"_19244":108074,"_5":13232,"_26277":107883,"_2666":108075},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3170":64617,"_27782":64556,"_19244":108077,"_5":13232,"_26277":107883,"_2666":108078},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3170":64618,"_27782":64556,"_19244":108080,"_5":13232,"_26277":107883,"_2666":108081},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3170":64619,"_27782":64556,"_19244":108083,"_5":13232,"_26277":107883,"_2666":108084},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3170":64620,"_27782":64556,"_19244":108086,"_5":13232,"_26277":107887,"_2666":108087},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3170":64621,"_27782":64556,"_19244":108089,"_5":13232,"_26277":107887,"_2666":108090},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3170":64622,"_27782":64556,"_19244":108092,"_5":13232,"_26277":107887,"_2666":108093},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3170":64623,"_27782":64556,"_19244":108095,"_5":13232,"_26277":107887,"_2666":108096},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3170":64624,"_27782":64556,"_19244":108098,"_5":13232,"_26277":107887,"_2666":108099},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3170":64625,"_27782":64556,"_19244":108101,"_5":13232,"_26277":107887,"_2666":108102},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3170":64626,"_27782":64556,"_19244":108104,"_5":13232,"_26277":107887,"_2666":108105},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3170":64627,"_27782":64556,"_19244":108107,"_5":13232,"_26277":107887,"_2666":108108},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3170":64628,"_27782":64556,"_19244":108110,"_5":13232,"_26277":107887,"_2666":108111},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3170":64629,"_27782":64556,"_19244":108113,"_5":13232,"_26277":107887,"_2666":108114},[],"Las acciones se dividen en dos grupos:",{"_3170":64630,"_27782":64556,"_19244":108116,"_5":13232,"_26277":107887,"_2666":108117},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3170":64631,"_27782":64556,"_19244":108119,"_5":13232,"_26277":107887,"_2666":108120},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3170":64632,"_27782":64556,"_19244":108122,"_5":13232,"_26277":107887,"_2666":108123},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3170":64633,"_27782":64556,"_19244":108125,"_5":13232,"_26277":107891,"_2666":108126},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3170":64634,"_27782":64556,"_19244":108128,"_5":13232,"_26277":107891,"_2666":108129},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3170":64635,"_27782":64556,"_19244":108131,"_5":13232,"_26277":107891,"_2666":108132},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3170":64636,"_27782":64556,"_19244":108134,"_5":13232,"_26277":107895,"_2666":108135},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3170":64637,"_27782":64556,"_19244":108137,"_5":13232,"_26277":107895,"_2666":108138},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3170":64638,"_27782":64556,"_19244":108140,"_5":13232,"_26277":107895,"_2666":108141},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3170":64639,"_27782":64556,"_19244":108143,"_5":13232,"_26277":107895,"_2666":108144},[],"Los operadores implementados son:",{"_3170":64640,"_27782":64556,"_19244":108146,"_5":13232,"_26277":107895,"_2666":108147},[],"`equals`, para igualdad exacta;",{"_3170":64641,"_27782":64556,"_19244":108149,"_5":13232,"_26277":107895,"_2666":108150},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3170":64642,"_27782":64556,"_19244":108152,"_5":13232,"_26277":107895,"_2666":108153},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3170":64643,"_27782":64556,"_19244":108155,"_5":13232,"_26277":107895,"_2666":108156},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3170":64644,"_27782":64556,"_19244":108158,"_5":13232,"_26277":107899,"_2666":108159},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3170":64645,"_27782":64556,"_19244":108161,"_5":13232,"_26277":107899,"_2666":108162},[],"Los modos disponibles son:",{"_3170":64646,"_27782":64556,"_19244":108164,"_5":13232,"_26277":107899,"_2666":108165},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3170":64647,"_27782":64556,"_19244":108167,"_5":13232,"_26277":107899,"_2666":108168},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3170":64648,"_27782":64556,"_19244":108170,"_5":13232,"_26277":107899,"_2666":108171},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3170":64649,"_27782":64556,"_19244":108173,"_5":13232,"_26277":107899,"_2666":108174},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3170":64650,"_27782":64556,"_19244":108176,"_5":13232,"_26277":107899,"_2666":108177},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3170":64651,"_27782":64556,"_19244":108179,"_5":13232,"_26277":107899,"_2666":108180},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3170":64652,"_27782":64556,"_19244":108182,"_5":13232,"_26277":107903,"_2666":108183},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3170":64653,"_27782":64556,"_19244":108185,"_5":13232,"_26277":107903,"_2666":108186},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3170":64654,"_27782":64556,"_19244":108188,"_5":13232,"_26277":107903,"_2666":108189},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3170":64655,"_27782":64556,"_19244":108191,"_5":13232,"_26277":107903,"_2666":108192},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3170":64656,"_27782":64556,"_19244":108194,"_5":13232,"_26277":107911,"_2666":108195},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3170":64657,"_27782":64556,"_19244":108197,"_5":13232,"_26277":107911,"_2666":108198},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3170":64658,"_27782":64556,"_19244":108200,"_5":13232,"_26277":107915,"_2666":108201},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora y la de un dispositivo con su DMS. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3170":64659,"_27782":64556,"_19244":108203,"_5":13232,"_26277":107915,"_2666":108204},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3170":64660,"_27782":64556,"_19244":108206,"_5":13232,"_26277":107919,"_2666":108207},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3170":64661,"_27782":64556,"_19244":108209,"_5":13232,"_26277":107919,"_2666":108210},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3170":64662,"_27782":64556,"_19244":108212,"_5":13232,"_26277":107919,"_2666":108213},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3170":64663,"_27782":64556,"_19244":108215,"_5":13232,"_26277":107923,"_2666":108216},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3170":64664,"_27782":64556,"_19244":108218,"_5":13232,"_26277":107923,"_2666":108219},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3170":64665,"_27782":64556,"_19244":108221,"_5":13232,"_26277":107923,"_2666":108222},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3170":64666,"_27782":64556,"_19244":108224,"_5":13232,"_26277":107923,"_2666":108225},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3170":64667,"_27782":64556,"_19244":108227,"_5":13232,"_26277":107923,"_2666":108228},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3170":64668,"_27782":64556,"_19244":108230,"_5":13232,"_26277":107923,"_2666":108231},[],"Ten en cuenta que:",{"_3170":64669,"_27782":64556,"_19244":108233,"_5":13232,"_26277":107923,"_2666":108234},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3170":64670,"_27782":64556,"_19244":108236,"_5":13232,"_26277":107923,"_2666":108237},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3170":64671,"_27782":64556,"_19244":108239,"_5":13232,"_26277":107923,"_2666":108240},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3170":64672,"_27782":64556,"_19244":108242,"_5":13232,"_26277":107927,"_2666":108243},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3170":64673,"_27782":64556,"_19244":108245,"_5":13232,"_26277":107927,"_2666":108246},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3170":64674,"_27782":64556,"_19244":108248,"_5":13232,"_26277":107927,"_2666":108249},[],"acceso completo y de solo lectura a KMS;",{"_3170":64675,"_27782":64556,"_19244":108251,"_5":13232,"_26277":107927,"_2666":108252},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3170":64676,"_27782":64556,"_19244":108254,"_5":13232,"_26277":107927,"_2666":108255},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3170":64677,"_27782":64556,"_19244":108257,"_5":13232,"_26277":107927,"_2666":108258},[],"acceso a la interfaz;",{"_3170":64678,"_27782":64556,"_19244":108260,"_5":13232,"_26277":107927,"_2666":108261},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3170":64679,"_27782":64556,"_19244":108263,"_5":13232,"_26277":107927,"_2666":108264},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3170":64680,"_27782":64556,"_19244":108266,"_5":13232,"_26277":107927,"_2666":108267},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3170":64681,"_27782":64556,"_19244":108269,"_5":13232,"_26277":107931,"_2666":108270},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3170":64682,"_27782":64556,"_19244":108272,"_5":13232,"_26277":107931,"_2666":108273},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3170":64683,"_27782":64556,"_19244":108275,"_5":13232,"_26277":107931,"_2666":108276},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3170":64684,"_27782":64556,"_19244":108278,"_5":13232,"_26277":107934,"_2666":108279},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3170":64685,"_27782":64556,"_19244":108281,"_5":13232,"_26277":107938,"_2666":108282},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_3170":64686,"_27782":64556,"_19244":108284,"_5":13232,"_26277":107938,"_2666":108285},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_3170":64687,"_27782":64556,"_19244":108287,"_5":13232,"_26277":107942,"_2666":108288},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3170":64688,"_27782":64556,"_19244":108290,"_5":13232,"_26277":107946,"_2666":108291},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3170":64689,"_27782":64556,"_19244":108293,"_5":13232,"_26277":107950,"_2666":108294},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3170":64690,"_27782":64556,"_19244":108296,"_5":13232,"_26277":107954,"_2666":108297},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3170":64691,"_27782":64556,"_19244":108299,"_5":13232,"_26277":107954,"_2666":108300},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3170":64692,"_27782":64556,"_19244":108302,"_5":13232,"_26277":107958,"_2666":108303},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3170":64693,"_27782":64556,"_19244":108305,"_5":13232,"_26277":107958,"_2666":108306},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3170":64694,"_27782":64556,"_19244":108308,"_5":13232,"_26277":107958,"_2666":108309},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3170":64695,"_27782":64556,"_19244":108311,"_5":13232,"_26277":107958,"_2666":108312},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3170":64696,"_27782":64556,"_19244":108314,"_5":13232,"_26277":107958,"_2666":108315},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3170":64697,"_27782":64556,"_19244":108317,"_5":13232,"_26277":107958,"_2666":108318},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3170":64698,"_27782":64556,"_19244":108320,"_5":13232,"_26277":107958,"_2666":108321},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3170":64699,"_27782":64556,"_19244":108323,"_5":13232,"_26277":107958,"_2666":108324},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3170":64700,"_27782":64556,"_19244":108326,"_5":13232,"_26277":107962,"_2666":108327},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3170":64701,"_27782":64556,"_19244":108329,"_5":13232,"_26277":107962,"_2666":108330},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3170":64702,"_27782":64556,"_19244":108332,"_5":13232,"_26277":107962,"_2666":108333},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3170":64703,"_27782":64556,"_19244":108335,"_5":13232,"_26277":107966,"_2666":108336},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3170":64704,"_27782":64556,"_19244":108338,"_5":13232,"_26277":107966,"_2666":108339},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3170":64705,"_27782":64556,"_19244":108341,"_5":13232,"_26277":107966,"_2666":108342},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3170":64706,"_27782":64556,"_19244":108344,"_5":13232,"_26277":107966,"_2666":108345},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3170":64707,"_27782":64556,"_19244":108347,"_5":13232,"_26277":107966,"_2666":108348},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3170":64708,"_27782":64556,"_19244":108350,"_5":13232,"_26277":107966,"_2666":108351},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3170":64709,"_27782":64556,"_19244":108353,"_5":13232,"_26277":107966,"_2666":108354},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3170":64710,"_27782":64556,"_19244":108356,"_5":13232,"_26277":107966,"_2666":108357},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3170":64711,"_27782":64556,"_19244":108359,"_5":13232,"_26277":107974,"_2666":108360},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3170":64712,"_27782":64556,"_19244":108362,"_5":13232,"_26277":107978,"_2666":108363},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3170":64713,"_27782":64556,"_19244":108365,"_5":13232,"_26277":107978,"_2666":108366},[],"que exista un principal activo del tipo correcto;",{"_3170":64714,"_27782":64556,"_19244":108368,"_5":13232,"_26277":107978,"_2666":108369},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3170":64715,"_27782":64556,"_19244":108371,"_5":13232,"_26277":107978,"_2666":108372},[],"que todas las condiciones del principal se cumplan;",{"_3170":64716,"_27782":64556,"_19244":108374,"_5":13232,"_26277":107978,"_2666":108375},[],"que el principal tenga concedida la política esperada;",{"_3170":64717,"_27782":64556,"_19244":108377,"_5":13232,"_26277":107978,"_2666":108378},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3170":64718,"_27782":64556,"_19244":108380,"_5":13232,"_26277":107978,"_2666":108381},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3170":64719,"_27782":64556,"_19244":108383,"_5":13232,"_26277":107978,"_2666":108384},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con la instrumentación OpenTelemetry habilitada, cada decisión genera además un span —`engine.CheckHTTP` en el camino del Gateway— cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente, de forma que puedas correlacionar la denegación con la traza del Gateway.",{"_3170":64720,"_27782":64556,"_19244":108386,"_5":13232,"_26277":107982,"_2666":108387},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3170":64721,"_27782":64556,"_19244":108389,"_5":13232,"_26277":107986,"_2666":108390},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3170":64722,"_27782":64556,"_19244":108392,"_5":13232,"_26277":107990,"_2666":108393},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3170":64723,"_27782":64556,"_19244":108395,"_5":13232,"_26277":107990,"_2666":108396},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3170":64724,"_27782":64724,"_5":13558,"_2666":108398,"_28124":108399,"_19244":108400,"_26277":64724},"Alertas y suscripciones",[45194,107863,107864],[],{"_3170":64725,"_27782":64724,"_19244":108402,"_5":13232,"_26277":64724,"_2666":108403},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3170":64726,"_27782":64724,"_5":28121,"_19244":108405,"_26277":108406,"_2666":108407},[],"/docs/pr-preview/pr-52/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3170":64727,"_27782":64724,"_5":28121,"_19244":108409,"_26277":108410,"_2666":108411},[],"/docs/pr-preview/pr-52/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3170":64728,"_27782":64724,"_5":28121,"_19244":108413,"_26277":108414,"_2666":108415},[],"/docs/pr-preview/pr-52/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3170":64729,"_27782":64724,"_5":28121,"_19244":108417,"_26277":108418,"_2666":108419},[],"/docs/pr-preview/pr-52/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3170":64730,"_27782":64724,"_5":28121,"_19244":108421,"_26277":108422,"_2666":108423},[],"/docs/pr-preview/pr-52/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3170":64731,"_27782":64724,"_5":28121,"_19244":108425,"_26277":108426,"_2666":108427},[],"/docs/pr-preview/pr-52/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3170":64732,"_27782":64724,"_5":28121,"_19244":108429,"_26277":108430,"_2666":108431},[],"/docs/pr-preview/pr-52/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3170":64733,"_27782":64724,"_5":28121,"_19244":108433,"_26277":108434,"_2666":108435},[],"/docs/pr-preview/pr-52/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3170":64734,"_27782":64724,"_5":28121,"_19244":108437,"_26277":108438,"_2666":108439},[],"/docs/pr-preview/pr-52/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3170":64735,"_27782":64724,"_5":28121,"_19244":108441,"_26277":108442,"_2666":108443},[],"/docs/pr-preview/pr-52/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3170":64736,"_27782":64724,"_19244":108445,"_5":13232,"_26277":64724,"_2666":108446},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3170":64737,"_27782":64724,"_19244":108448,"_5":13232,"_26277":108406,"_2666":108449},[],"Un servicio publica un evento de dominio.",{"_3170":64738,"_27782":64724,"_19244":108451,"_5":13232,"_26277":108406,"_2666":108452},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3170":64739,"_27782":64724,"_19244":108454,"_5":13232,"_26277":108406,"_2666":108455},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3170":64740,"_27782":64724,"_19244":108457,"_5":13232,"_26277":108406,"_2666":108458},[],"Lamassu entrega el evento al canal configurado.",{"_3170":64741,"_27782":64724,"_19244":108460,"_5":13232,"_26277":108406,"_2666":108461},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3170":64742,"_27782":64724,"_19244":108463,"_5":13232,"_26277":108410,"_2666":108464},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3170":64743,"_27782":64724,"_19244":108466,"_5":13232,"_26277":108410,"_2666":108467},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3170":64744,"_27782":64724,"_19244":108469,"_5":13232,"_26277":108410,"_2666":108470},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3170":64745,"_27782":64724,"_19244":108472,"_5":13232,"_26277":108410,"_2666":108473},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3170":64746,"_27782":64724,"_19244":108475,"_5":13232,"_26277":108410,"_2666":108476},[],"`apikey_options` necesita `header` y `key`.",{"_3170":64747,"_27782":64724,"_19244":108478,"_5":13232,"_26277":108410,"_2666":108479},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3170":64748,"_27782":64724,"_19244":108481,"_5":13232,"_26277":108410,"_2666":108482},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3170":64749,"_27782":64724,"_19244":108484,"_5":13232,"_26277":108410,"_2666":108485},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3170":64750,"_27782":64724,"_19244":108487,"_5":13232,"_26277":108418,"_2666":108488},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3170":64751,"_27782":64724,"_19244":108490,"_5":13232,"_26277":108422,"_2666":108491},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3170":64752,"_27782":64724,"_19244":108493,"_5":13232,"_26277":108426,"_2666":108494},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3170":64753,"_27782":64724,"_19244":108496,"_5":13232,"_26277":108426,"_2666":108497},[],"**None** notifica todas las instancias del evento.",{"_3170":64754,"_27782":64724,"_19244":108499,"_5":13232,"_26277":108426,"_2666":108500},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3170":64755,"_27782":64724,"_19244":108502,"_5":13232,"_26277":108426,"_2666":108503},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3170":64756,"_27782":64724,"_19244":108505,"_5":13232,"_26277":108426,"_2666":108506},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3170":64757,"_27782":64724,"_19244":108508,"_5":13232,"_26277":108426,"_2666":108509},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3170":64758,"_27782":64724,"_19244":108511,"_5":13232,"_26277":108430,"_2666":108512},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3170":64759,"_27782":64724,"_19244":108514,"_5":13232,"_26277":108434,"_2666":108515},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3170":64760,"_27782":64724,"_19244":108517,"_5":13232,"_26277":108434,"_2666":108518},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3170":64761,"_27782":64724,"_19244":108520,"_5":13232,"_26277":108434,"_2666":108521},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3170":64762,"_27782":64724,"_19244":108523,"_5":13232,"_26277":108434,"_2666":108524},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3170":64763,"_27782":64724,"_19244":108526,"_5":13232,"_26277":108434,"_2666":108527},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3170":64764,"_27782":64724,"_19244":108529,"_5":13232,"_26277":108434,"_2666":108530},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3170":64765,"_27782":64724,"_19244":108532,"_5":13232,"_26277":108434,"_2666":108533},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3170":64766,"_27782":64724,"_19244":108535,"_5":13232,"_26277":108434,"_2666":108536},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3170":64767,"_27782":64724,"_19244":108538,"_5":13232,"_26277":108438,"_2666":108539},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3170":64768,"_27782":64724,"_19244":108541,"_5":13232,"_26277":108442,"_2666":108542},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3170":64769,"_27782":64724,"_19244":108544,"_5":13232,"_26277":108442,"_2666":108545},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3170":64770,"_27782":64724,"_19244":108547,"_5":13232,"_26277":108442,"_2666":108548},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3170":64771,"_27782":64724,"_19244":108550,"_5":13232,"_26277":108442,"_2666":108551},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3170":64772,"_27782":64724,"_19244":108553,"_5":13232,"_26277":108442,"_2666":108554},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3170":64773,"_27782":64724,"_19244":108556,"_5":13232,"_26277":108442,"_2666":108557},[],"**Validación:** `va.role.crl.create`.",{"_3170":64774,"_27782":64724,"_19244":108559,"_5":13232,"_26277":108442,"_2666":108560},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3170":64775,"_27782":64724,"_19244":108562,"_5":13232,"_26277":108442,"_2666":108563},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3170":64776,"_27782":64776,"_5":13558,"_2666":108565,"_28124":108566,"_19244":108567,"_26277":64776},"Registros de auditoría",[45194,107863,107864],[],{"_3170":64777,"_27782":64776,"_19244":108569,"_5":13232,"_26277":64776,"_2666":108570},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3170":64778,"_27782":64776,"_5":28121,"_19244":108572,"_26277":108573,"_2666":108574},[],"/docs/pr-preview/pr-52/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3170":64779,"_27782":64776,"_5":28121,"_19244":108576,"_26277":108577,"_2666":108578},[],"/docs/pr-preview/pr-52/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3170":64780,"_27782":64776,"_5":28121,"_19244":108580,"_26277":108581,"_2666":108582},[],"/docs/pr-preview/pr-52/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3170":64781,"_27782":64776,"_5":28121,"_19244":108584,"_26277":108585,"_2666":108586},[],"/docs/pr-preview/pr-52/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3170":64782,"_27782":64776,"_5":28121,"_19244":108588,"_26277":108589,"_2666":108590},[],"/docs/pr-preview/pr-52/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3170":64783,"_27782":64776,"_5":28121,"_19244":108592,"_26277":108593,"_2666":108594},[],"/docs/pr-preview/pr-52/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3170":64784,"_27782":64776,"_5":28121,"_19244":108596,"_26277":108597,"_2666":108598},[],"/docs/pr-preview/pr-52/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3170":64785,"_27782":64776,"_5":28121,"_19244":108600,"_26277":108601,"_2666":108602},[],"/docs/pr-preview/pr-52/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3170":64786,"_27782":64776,"_5":28121,"_19244":108604,"_26277":108605,"_2666":108606},[],"/docs/pr-preview/pr-52/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3170":64787,"_27782":64776,"_5":28121,"_19244":108608,"_26277":108609,"_2666":108610},[],"/docs/pr-preview/pr-52/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3170":64788,"_27782":64776,"_5":28121,"_19244":108612,"_26277":108613,"_2666":108614},[],"/docs/pr-preview/pr-52/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3170":64789,"_27782":64776,"_19244":108616,"_5":13232,"_26277":64776,"_2666":108617},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3170":64790,"_27782":64776,"_19244":108619,"_5":13232,"_26277":108573,"_2666":108620},[],"El cuerpo de auditoría incluye:",{"_3170":64791,"_27782":64776,"_19244":108622,"_5":13232,"_26277":108573,"_2666":108623},[],"input: datos recibidos por la operación;",{"_3170":64792,"_27782":64776,"_19244":108625,"_5":13232,"_26277":108573,"_2666":108626},[],"has\\_error: indica si el servicio devolvió un error;",{"_3170":64793,"_27782":64776,"_19244":108628,"_5":13232,"_26277":108573,"_2666":108629},[],"output: resultado producido o mensaje de error;",{"_3170":64794,"_27782":64776,"_19244":108631,"_5":13232,"_26277":108573,"_2666":108632},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3170":64795,"_27782":64776,"_19244":108634,"_5":13232,"_26277":108573,"_2666":108635},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3170":64796,"_27782":64776,"_19244":108637,"_5":13232,"_26277":108573,"_2666":108638},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3170":64797,"_27782":64776,"_19244":108640,"_5":13232,"_26277":108577,"_2666":108641},[],"El backend aplica auditoría a mutaciones de:",{"_3170":64798,"_27782":64776,"_19244":108643,"_5":13232,"_26277":108577,"_2666":108644},[],"autoridades, certificados y perfiles de emisión;",{"_3170":64799,"_27782":64776,"_19244":108646,"_5":13232,"_26277":108577,"_2666":108647},[],"claves y motores KMS;",{"_3170":64800,"_27782":64776,"_19244":108649,"_5":13232,"_26277":108577,"_2666":108650},[],"dispositivos e identidades;",{"_3170":64801,"_27782":64776,"_19244":108652,"_5":13232,"_26277":108577,"_2666":108653},[],"DMS y operaciones de enrolamiento;",{"_3170":64802,"_27782":64776,"_19244":108655,"_5":13232,"_26277":108577,"_2666":108656},[],"funciones de validación y CRL;",{"_3170":64803,"_27782":64776,"_19244":108658,"_5":13232,"_26277":108577,"_2666":108659},[],"principales, políticas y concesiones de autorización.",{"_3170":64804,"_27782":64776,"_19244":108661,"_5":13232,"_26277":108577,"_2666":108662},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3170":64805,"_27782":64776,"_19244":108664,"_5":13232,"_26277":108581,"_2666":108665},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3170":64806,"_27782":64776,"_19244":108667,"_5":13232,"_26277":108581,"_2666":108668},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3170":64807,"_27782":64776,"_19244":108670,"_5":13232,"_26277":108581,"_2666":108671},[],"Diseña el consumidor para:",{"_3170":64808,"_27782":64776,"_19244":108673,"_5":13232,"_26277":108581,"_2666":108674},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3170":64809,"_27782":64776,"_19244":108676,"_5":13232,"_26277":108581,"_2666":108677},[],"conservar el CloudEvent completo sin modificar;",{"_3170":64810,"_27782":64776,"_19244":108679,"_5":13232,"_26277":108581,"_2666":108680},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3170":64811,"_27782":64776,"_19244":108682,"_5":13232,"_26277":108581,"_2666":108683},[],"cifrar en tránsito y en reposo;",{"_3170":64812,"_27782":64776,"_19244":108685,"_5":13232,"_26277":108581,"_2666":108686},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3170":64813,"_27782":64776,"_19244":108688,"_5":13232,"_26277":108581,"_2666":108689},[],"aplicar una política explícita de retención y legal hold;",{"_3170":64814,"_27782":64776,"_19244":108691,"_5":13232,"_26277":108581,"_2666":108692},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3170":64815,"_27782":64776,"_19244":108694,"_5":13232,"_26277":108585,"_2666":108695},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3170":64816,"_27782":64776,"_19244":108697,"_5":13232,"_26277":108585,"_2666":108698},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3170":64817,"_27782":64776,"_19244":108700,"_5":13232,"_26277":108593,"_2666":108701},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3170":64818,"_27782":64776,"_19244":108703,"_5":13232,"_26277":108597,"_2666":108704},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3170":64819,"_27782":64776,"_19244":108706,"_5":13232,"_26277":108601,"_2666":108707},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3170":64820,"_27782":64776,"_19244":108709,"_5":13232,"_26277":108605,"_2666":108710},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3170":64821,"_27782":64776,"_19244":108712,"_5":13232,"_26277":108609,"_2666":108713},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3170":64822,"_27782":64776,"_19244":108715,"_5":13232,"_26277":108613,"_2666":108716},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3170":64823,"_27782":64776,"_19244":108718,"_5":13232,"_26277":108613,"_2666":108719},[],"aparece un evento de auditoría correcto;",{"_3170":64824,"_27782":64776,"_19244":108721,"_5":13232,"_26277":108613,"_2666":108722},[],"el principal coincide con la identidad utilizada;",{"_3170":64825,"_27782":64776,"_19244":108724,"_5":13232,"_26277":108613,"_2666":108725},[],"el consumidor lo persiste una sola vez;",{"_3170":64826,"_27782":64776,"_19244":108727,"_5":13232,"_26277":108613,"_2666":108728},[],"puede recuperarse por recurso, actor y periodo;",{"_3170":64827,"_27782":64776,"_19244":108730,"_5":13232,"_26277":108613,"_2666":108731},[],"una interrupción del consumidor produce una alerta.",{"_3170":64828,"_27782":64776,"_19244":108733,"_5":13232,"_26277":108613,"_2666":108734},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3170":64829,"_27782":64829,"_5":13558,"_2666":108736,"_28124":108737,"_19244":108738,"_26277":64829},"Arquitectura de la plataforma",[45194,107863],[],{"_3170":64830,"_27782":64829,"_19244":108740,"_5":13232,"_26277":64829,"_2666":108741},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3170":64831,"_27782":64829,"_5":28121,"_19244":108743,"_26277":108744,"_2666":108745},[],"/docs/pr-preview/pr-52/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3170":64832,"_27782":64829,"_5":28121,"_19244":108747,"_26277":108748,"_2666":108749},[],"/docs/pr-preview/pr-52/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3170":64833,"_27782":64829,"_5":28121,"_19244":108751,"_26277":108752,"_2666":108753},[],"/docs/pr-preview/pr-52/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3170":64834,"_27782":64829,"_5":28121,"_19244":108755,"_26277":108756,"_2666":108757},[],"/docs/pr-preview/pr-52/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3170":64835,"_27782":64829,"_5":28121,"_19244":108759,"_26277":108760,"_2666":108761},[],"/docs/pr-preview/pr-52/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3170":64836,"_27782":64829,"_19244":108763,"_5":13232,"_26277":64829,"_2666":108764},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3170":64837,"_27782":64829,"_19244":108766,"_5":13232,"_26277":64829,"_2666":108767},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3170":64838,"_27782":64829,"_19244":108769,"_5":13232,"_26277":108744,"_2666":108770},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3170":64839,"_27782":64829,"_19244":108772,"_5":13232,"_26277":108748,"_2666":108773},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3170":64840,"_27782":64829,"_19244":108775,"_5":13232,"_26277":108752,"_2666":108776},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3170":64841,"_27782":64829,"_19244":108778,"_5":13232,"_26277":108756,"_2666":108779},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3170":64842,"_27782":64829,"_19244":108781,"_5":13232,"_26277":108760,"_2666":108782},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3170":64843,"_27782":64843,"_5":13558,"_2666":108784,"_28124":108785,"_19244":108786,"_26277":64843},"Cómo funciona Lamassu",[45194,107863],[],{"_3170":64844,"_27782":64843,"_19244":108788,"_5":13232,"_26277":64843,"_2666":108789},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3170":64845,"_27782":64843,"_5":28121,"_19244":108791,"_26277":108792,"_2666":108793},[],"/docs/pr-preview/pr-52/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3170":64846,"_27782":64843,"_5":28121,"_19244":108795,"_26277":108796,"_2666":108797},[],"/docs/pr-preview/pr-52/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3170":64847,"_27782":64843,"_19244":108799,"_5":13232,"_26277":64843,"_2666":108800},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3170":64848,"_27782":64843,"_19244":108802,"_5":13232,"_26277":108792,"_2666":108803},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3170":64849,"_27782":64843,"_19244":108805,"_5":13232,"_26277":108792,"_2666":108806},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3170":64850,"_27782":64843,"_19244":108808,"_5":13232,"_26277":108792,"_2666":108809},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3170":64851,"_27782":64843,"_19244":108811,"_5":13232,"_26277":108792,"_2666":108812},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3170":64852,"_27782":64843,"_19244":108814,"_5":13232,"_26277":108792,"_2666":108815},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3170":64853,"_27782":64843,"_19244":108817,"_5":13232,"_26277":108796,"_2666":108818},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3170":64854,"_27782":64843,"_19244":108820,"_5":13232,"_26277":108796,"_2666":108821},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3170":64855,"_27782":64843,"_19244":108823,"_5":13232,"_26277":108796,"_2666":108824},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3170":64856,"_27782":64843,"_19244":108826,"_5":13232,"_26277":108796,"_2666":108827},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3170":64857,"_27782":64843,"_19244":108829,"_5":13232,"_26277":108796,"_2666":108830},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3170":64858,"_27782":64843,"_19244":108832,"_5":13232,"_26277":108796,"_2666":108833},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3170":64859,"_27782":64843,"_19244":108835,"_5":13232,"_26277":108796,"_2666":108836},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3170":64860,"_27782":64860,"_5":13558,"_2666":108838,"_28124":108839,"_19244":108840,"_26277":64860},"Dispositivos e identidades",[45194,107863,47551,108838],[],{"_3170":64861,"_27782":64860,"_19244":108842,"_5":13232,"_26277":64860,"_2666":108843},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3170":64862,"_27782":64860,"_5":28121,"_19244":108845,"_26277":108846,"_2666":108847},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3170":64863,"_27782":64860,"_5":28121,"_19244":108849,"_26277":108850,"_2666":108851},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3170":64864,"_27782":64860,"_5":28121,"_19244":108853,"_26277":108854,"_2666":108855},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3170":64865,"_27782":64860,"_5":28121,"_19244":108857,"_26277":108858,"_2666":108859},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3170":64866,"_27782":64860,"_5":28121,"_19244":108861,"_26277":108862,"_2666":108863},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3170":64867,"_27782":64860,"_5":28121,"_19244":108865,"_26277":108866,"_2666":108867},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3170":64868,"_27782":64860,"_5":28121,"_19244":108869,"_26277":108870,"_2666":108871},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3170":64869,"_27782":64860,"_5":28121,"_19244":108873,"_26277":108874,"_2666":108875},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3170":64870,"_27782":64860,"_5":28121,"_19244":108877,"_26277":108878,"_2666":108879},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3170":64871,"_27782":64860,"_5":28121,"_19244":108881,"_26277":108882,"_2666":108883},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3170":64872,"_27782":64860,"_5":28121,"_19244":108885,"_26277":108886,"_2666":108887},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3170":64873,"_27782":64860,"_19244":108889,"_5":13232,"_26277":64860,"_2666":108890},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3170":64874,"_27782":64860,"_19244":108892,"_5":13232,"_26277":64860,"_2666":108893},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3170":64875,"_27782":64860,"_19244":108895,"_5":13232,"_26277":108846,"_2666":108896},[],"Vista operativa",{"_3170":64876,"_27782":64860,"_19244":108898,"_5":13232,"_26277":108846,"_2666":108899},[],"Interpretación",{"_3170":64877,"_27782":64860,"_19244":108901,"_5":13232,"_26277":108846,"_2666":47614},[],{"_3170":64878,"_27782":64860,"_19244":108903,"_5":13232,"_26277":108846,"_2666":108904},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3170":64879,"_27782":64860,"_19244":108906,"_5":13232,"_26277":108846,"_2666":47620},[],{"_3170":64880,"_27782":64860,"_19244":108908,"_5":13232,"_26277":108846,"_2666":108909},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3170":64881,"_27782":64860,"_19244":108911,"_5":13232,"_26277":108846,"_2666":47626},[],{"_3170":64882,"_27782":64860,"_19244":108913,"_5":13232,"_26277":108846,"_2666":108914},[],"La identidad está en la ventana operativa de renovación.",{"_3170":64883,"_27782":64860,"_19244":108916,"_5":13232,"_26277":108846,"_2666":47632},[],{"_3170":64884,"_27782":64860,"_19244":108918,"_5":13232,"_26277":108846,"_2666":108919},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3170":64885,"_27782":64860,"_19244":108921,"_5":13232,"_26277":108846,"_2666":47638},[],{"_3170":64886,"_27782":64860,"_19244":108923,"_5":13232,"_26277":108846,"_2666":108924},[],"La identidad ha vencido.",{"_3170":64887,"_27782":64860,"_19244":108926,"_5":13232,"_26277":108846,"_2666":47644},[],{"_3170":64888,"_27782":64860,"_19244":108928,"_5":13232,"_26277":108846,"_2666":108929},[],"La identidad está marcada como revocada.",{"_3170":64889,"_27782":64860,"_19244":108931,"_5":13232,"_26277":108846,"_2666":47650},[],{"_3170":64890,"_27782":64860,"_19244":108933,"_5":13232,"_26277":108846,"_2666":108934},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3170":64891,"_27782":64860,"_19244":108936,"_5":13232,"_26277":108846,"_2666":108937},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3170":64892,"_27782":64860,"_19244":108939,"_5":13232,"_26277":108850,"_2666":108940},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3170":64893,"_27782":64860,"_19244":108942,"_5":13232,"_26277":108850,"_2666":108943},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3170":64894,"_27782":64860,"_19244":108945,"_5":13232,"_26277":108850,"_2666":108946},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3170":64895,"_27782":64860,"_19244":108948,"_5":13232,"_26277":108850,"_2666":108949},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3170":64896,"_27782":64860,"_19244":108951,"_5":13232,"_26277":108854,"_2666":108952},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3170":64897,"_27782":64860,"_19244":108954,"_5":13232,"_26277":108858,"_2666":108955},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3170":64898,"_27782":64860,"_19244":108957,"_5":13232,"_26277":108862,"_2666":108958},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3170":64899,"_27782":64860,"_19244":108960,"_5":13232,"_26277":108866,"_2666":108961},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3170":64900,"_27782":64860,"_19244":108963,"_5":13232,"_26277":108870,"_2666":108964},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3170":64901,"_27782":64860,"_19244":108966,"_5":13232,"_26277":108870,"_2666":108967},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3170":64902,"_27782":64860,"_19244":108969,"_5":13232,"_26277":108874,"_2666":108970},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3170":64903,"_27782":64860,"_19244":108972,"_5":13232,"_26277":108874,"_2666":108973},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3170":64904,"_27782":64860,"_19244":108975,"_5":13232,"_26277":108874,"_2666":108976},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3170":64905,"_27782":64860,"_19244":108978,"_5":13232,"_26277":108874,"_2666":108979},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3170":64906,"_27782":64860,"_19244":108981,"_5":13232,"_26277":108874,"_2666":108982},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3170":64907,"_27782":64860,"_19244":108984,"_5":13232,"_26277":108874,"_2666":108985},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3170":64908,"_27782":64860,"_19244":108987,"_5":13232,"_26277":108878,"_2666":108988},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3170":64909,"_27782":64860,"_19244":108990,"_5":13232,"_26277":108878,"_2666":108991},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3170":64910,"_27782":64860,"_19244":108993,"_5":13232,"_26277":108882,"_2666":108994},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3170":64911,"_27782":64860,"_19244":108996,"_5":13232,"_26277":108882,"_2666":108997},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3170":64912,"_27782":64860,"_19244":108999,"_5":13232,"_26277":108882,"_2666":109000},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3170":64913,"_27782":64860,"_19244":109002,"_5":13232,"_26277":108882,"_2666":109003},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3170":64914,"_27782":64860,"_19244":109005,"_5":13232,"_26277":108886,"_2666":109006},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3170":64915,"_27782":64860,"_19244":109008,"_5":13232,"_26277":108886,"_2666":109009},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3170":64916,"_27782":64916,"_5":13558,"_2666":109011,"_28124":109012,"_19244":109014,"_26277":64916},"Identidad inicial y autenticación",[45194,107863,47551,108838,109013],"Enrolamiento con PKI",[],{"_3170":64917,"_27782":64916,"_19244":109016,"_5":13232,"_26277":64916,"_2666":109017},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_3170":64918,"_27782":64916,"_5":28121,"_19244":109019,"_26277":109020,"_2666":109021},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3170":64919,"_27782":64916,"_5":28121,"_19244":109023,"_26277":109024,"_2666":109025},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3170":64920,"_27782":64916,"_5":28121,"_19244":109027,"_26277":109028,"_2666":109029},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_3170":64921,"_27782":64916,"_5":28121,"_19244":109031,"_26277":109032,"_2666":109033},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3170":64922,"_27782":64916,"_5":28121,"_19244":109035,"_26277":109036,"_2666":109037},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3170":64923,"_27782":64916,"_19244":109039,"_5":13232,"_26277":64916,"_2666":109040},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3170":64924,"_27782":64916,"_19244":109042,"_5":13232,"_26277":109020,"_2666":109043},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3170":64925,"_27782":64916,"_19244":109045,"_5":13232,"_26277":109020,"_2666":109046},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3170":64926,"_27782":64916,"_19244":109048,"_5":13232,"_26277":109024,"_2666":109049},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3170":64927,"_27782":64916,"_19244":109051,"_5":13232,"_26277":109024,"_2666":109052},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3170":64928,"_27782":64916,"_19244":109054,"_5":13232,"_26277":109024,"_2666":109055},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3170":64929,"_27782":64916,"_19244":109057,"_5":13232,"_26277":109028,"_2666":109058},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3170":64930,"_27782":64916,"_19244":109060,"_5":13232,"_26277":109028,"_2666":109061},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3170":64931,"_27782":64916,"_19244":109063,"_5":13232,"_26277":109032,"_2666":109064},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3170":64932,"_27782":64916,"_19244":109066,"_5":13232,"_26277":109032,"_2666":109067},[],"Ejemplo de cuerpo:",{"_3170":64933,"_27782":64916,"_19244":109069,"_5":13232,"_26277":109032,"_2666":109070},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3170":64934,"_27782":64916,"_19244":109072,"_5":13232,"_26277":109032,"_2666":109073},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3170":64935,"_27782":64916,"_19244":109075,"_5":13232,"_26277":109032,"_2666":109076},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3170":64936,"_27782":64916,"_19244":109078,"_5":13232,"_26277":109032,"_2666":109079},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3170":64937,"_27782":64916,"_19244":109081,"_5":13232,"_26277":109036,"_2666":109082},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_3170":64938,"_27782":64916,"_19244":109084,"_5":13232,"_26277":109036,"_2666":109085},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3170":64939,"_27782":64939,"_5":13558,"_2666":109087,"_28124":109088,"_19244":109089,"_26277":64939},"Configura y opera el DMS",[45194,107863,47551,108838,109013],[],{"_3170":64940,"_27782":64939,"_19244":109091,"_5":13232,"_26277":64939,"_2666":109092},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3170":64941,"_27782":64939,"_5":28121,"_19244":109094,"_26277":109095,"_2666":106529},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3170":64942,"_27782":64939,"_5":28121,"_19244":109097,"_26277":109098,"_2666":109099},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3170":64943,"_27782":64939,"_5":28121,"_19244":109101,"_26277":109102,"_2666":109103},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3170":64944,"_27782":64939,"_5":28121,"_19244":109105,"_26277":109106,"_2666":109107},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3170":64945,"_27782":64939,"_5":28121,"_19244":109109,"_26277":109110,"_2666":109111},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3170":64946,"_27782":64939,"_5":28121,"_19244":109113,"_26277":109114,"_2666":109115},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3170":64947,"_27782":64939,"_5":28121,"_19244":109117,"_26277":109118,"_2666":109119},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3170":64948,"_27782":64939,"_5":28121,"_19244":109121,"_26277":109122,"_2666":109123},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_3170":64949,"_27782":64939,"_5":28121,"_19244":109125,"_26277":109126,"_2666":47846},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_3170":64950,"_27782":64939,"_5":28121,"_19244":109128,"_26277":109129,"_2666":47850},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_3170":64951,"_27782":64939,"_5":28121,"_19244":109131,"_26277":109132,"_2666":109133},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_3170":64952,"_27782":64939,"_5":28121,"_19244":109135,"_26277":109136,"_2666":109137},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3170":64953,"_27782":64939,"_5":28121,"_19244":109139,"_26277":109140,"_2666":109141},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_3170":64954,"_27782":64939,"_5":28121,"_19244":109143,"_26277":109144,"_2666":109145},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3170":64955,"_27782":64939,"_5":28121,"_19244":109147,"_26277":109148,"_2666":47870},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_3170":64956,"_27782":64939,"_5":28121,"_19244":109150,"_26277":109151,"_2666":109152},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_3170":64957,"_27782":64939,"_5":28121,"_19244":109154,"_26277":109155,"_2666":109156},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3170":64958,"_27782":64939,"_5":28121,"_19244":109158,"_26277":109159,"_2666":109160},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3170":64959,"_27782":64939,"_19244":109162,"_5":13232,"_26277":64939,"_2666":109163},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3170":64960,"_27782":64939,"_19244":109165,"_5":13232,"_26277":109095,"_2666":109166},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3170":64961,"_27782":64939,"_19244":109168,"_5":13232,"_26277":109095,"_2666":109169},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3170":64962,"_27782":64939,"_19244":109171,"_5":13232,"_26277":109102,"_2666":109172},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3170":64963,"_27782":64939,"_19244":109174,"_5":13232,"_26277":109106,"_2666":109175},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3170":64964,"_27782":64939,"_19244":109177,"_5":13232,"_26277":109110,"_2666":109178},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3170":64965,"_27782":64939,"_19244":109180,"_5":13232,"_26277":109114,"_2666":109181},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3170":64966,"_27782":64939,"_19244":109183,"_5":13232,"_26277":109118,"_2666":109184},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3170":64967,"_27782":64939,"_19244":109186,"_5":13232,"_26277":109126,"_2666":109187},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_3170":64968,"_27782":64939,"_19244":109189,"_5":13232,"_26277":109126,"_2666":109190},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3170":64969,"_27782":64939,"_19244":109192,"_5":13232,"_26277":109129,"_2666":109193},[],"Campo de `settings.enrollment_settings`",{"_3170":64970,"_27782":64939,"_19244":109195,"_5":13232,"_26277":109129,"_2666":109196},[],"Decisión",{"_3170":64971,"_27782":64939,"_19244":109198,"_5":13232,"_26277":109129,"_2666":47921},[],{"_3170":64972,"_27782":64939,"_19244":109200,"_5":13232,"_26277":109129,"_2666":109201},[],"`EST_RFC7030` para estas operaciones.",{"_3170":64973,"_27782":64939,"_19244":109203,"_5":13232,"_26277":109129,"_2666":47927},[],{"_3170":64974,"_27782":64939,"_19244":109205,"_5":13232,"_26277":109129,"_2666":109206},[],"ID de la CA que firmará.",{"_3170":64975,"_27782":64939,"_19244":109208,"_5":13232,"_26277":109129,"_2666":47933},[],{"_3170":64976,"_27782":64939,"_19244":109210,"_5":13232,"_26277":109129,"_2666":109211},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3170":64977,"_27782":64939,"_19244":109213,"_5":13232,"_26277":109129,"_2666":47939},[],{"_3170":64978,"_27782":64939,"_19244":109215,"_5":13232,"_26277":109129,"_2666":109216},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3170":64979,"_27782":64939,"_19244":109218,"_5":13232,"_26277":109129,"_2666":47945},[],{"_3170":64980,"_27782":64939,"_19244":109220,"_5":13232,"_26277":109129,"_2666":109221},[],"Uno de los cuatro modos de autenticación.",{"_3170":64981,"_27782":64939,"_19244":109223,"_5":13232,"_26277":109129,"_2666":109224},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3170":64982,"_27782":64939,"_19244":109226,"_5":13232,"_26277":109132,"_2666":109227},[],"Los bloques son independientes:",{"_3170":64983,"_27782":64939,"_19244":109229,"_5":13232,"_26277":109132,"_2666":109230},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3170":64984,"_27782":64939,"_19244":109232,"_5":13232,"_26277":109132,"_2666":109233},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3170":64985,"_27782":64939,"_19244":109235,"_5":13232,"_26277":109132,"_2666":47963},[],{"_3170":64986,"_27782":64939,"_19244":109237,"_5":13232,"_26277":109132,"_2666":109238},[],"Control aplicado en la operación configurada",{"_3170":64987,"_27782":64939,"_19244":109240,"_5":13232,"_26277":109132,"_2666":47969},[],{"_3170":64988,"_27782":64939,"_19244":109242,"_5":13232,"_26277":109132,"_2666":109243},[],"Validación del certificado presentado.",{"_3170":64989,"_27782":64939,"_19244":109245,"_5":13232,"_26277":109132,"_2666":47975},[],{"_3170":64990,"_27782":64939,"_19244":109247,"_5":13232,"_26277":109132,"_2666":109248},[],"Autorización del webhook configurado.",{"_3170":64991,"_27782":64939,"_19244":109250,"_5":13232,"_26277":109132,"_2666":47981},[],{"_3170":64992,"_27782":64939,"_19244":109252,"_5":13232,"_26277":109132,"_2666":109253},[],"Validación del certificado y, después, aprobación del webhook.",{"_3170":64993,"_27782":64939,"_19244":109255,"_5":13232,"_26277":109132,"_2666":47987},[],{"_3170":64994,"_27782":64939,"_19244":109257,"_5":13232,"_26277":109132,"_2666":109258},[],"Sin autenticación del solicitante por el DMS.",{"_3170":64995,"_27782":64939,"_19244":109260,"_5":13232,"_26277":109132,"_2666":109261},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3170":64996,"_27782":64939,"_19244":109263,"_5":13232,"_26277":109132,"_2666":109264},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3170":64997,"_27782":64939,"_19244":109266,"_5":13232,"_26277":109132,"_2666":109267},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`.",{"_3170":64998,"_27782":64939,"_19244":109269,"_5":13232,"_26277":109132,"_2666":109270},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3170":64999,"_27782":64939,"_19244":109272,"_5":13232,"_26277":109136,"_2666":109273},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3170":65000,"_27782":64939,"_19244":109275,"_5":13232,"_26277":109136,"_2666":109276},[],"Campo de `external_webhook_settings`",{"_3170":65001,"_27782":64939,"_19244":109278,"_5":13232,"_26277":109136,"_2666":109196},[],{"_3170":65002,"_27782":64939,"_19244":109280,"_5":13232,"_26277":109136,"_2666":48013},[],{"_3170":65003,"_27782":64939,"_19244":109282,"_5":13232,"_26277":109136,"_2666":109283},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3170":65004,"_27782":64939,"_19244":109285,"_5":13232,"_26277":109136,"_2666":48019},[],{"_3170":65005,"_27782":64939,"_19244":109287,"_5":13232,"_26277":109136,"_2666":109288},[],"`POST` o `PUT`; `POST` por defecto.",{"_3170":65006,"_27782":64939,"_19244":109290,"_5":13232,"_26277":109136,"_2666":48025},[],{"_3170":65007,"_27782":64939,"_19244":109292,"_5":13232,"_26277":109136,"_2666":109293},[],"Etiqueta usada en los logs del servicio.",{"_3170":65008,"_27782":64939,"_19244":109295,"_5":13232,"_26277":109136,"_2666":48031},[],{"_3170":65009,"_27782":64939,"_19244":109297,"_5":13232,"_26277":109136,"_2666":109298},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3170":65010,"_27782":64939,"_19244":109300,"_5":13232,"_26277":109136,"_2666":48037},[],{"_3170":65011,"_27782":64939,"_19244":109302,"_5":13232,"_26277":109136,"_2666":109303},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3170":65012,"_27782":64939,"_19244":109305,"_5":13232,"_26277":109136,"_2666":48043},[],{"_3170":65013,"_27782":64939,"_19244":109307,"_5":13232,"_26277":109136,"_2666":109308},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3170":65014,"_27782":64939,"_19244":109310,"_5":13232,"_26277":109136,"_2666":48049},[],{"_3170":65015,"_27782":64939,"_19244":109312,"_5":13232,"_26277":109136,"_2666":109313},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3170":65016,"_27782":64939,"_19244":109315,"_5":13232,"_26277":109136,"_2666":48055},[],{"_3170":65017,"_27782":64939,"_19244":109317,"_5":13232,"_26277":109136,"_2666":109318},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3170":65018,"_27782":64939,"_19244":109320,"_5":13232,"_26277":109136,"_2666":48061},[],{"_3170":65019,"_27782":64939,"_19244":109322,"_5":13232,"_26277":109136,"_2666":109323},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3170":65020,"_27782":64939,"_19244":109325,"_5":13232,"_26277":109136,"_2666":109326},[],"Reglas de esa configuración:",{"_3170":65021,"_27782":64939,"_19244":109328,"_5":13232,"_26277":109136,"_2666":109329},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3170":65022,"_27782":64939,"_19244":109331,"_5":13232,"_26277":109136,"_2666":109332},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3170":65023,"_27782":64939,"_19244":109334,"_5":13232,"_26277":109136,"_2666":109335},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3170":65024,"_27782":64939,"_19244":109337,"_5":13232,"_26277":109136,"_2666":109338},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3170":65025,"_27782":64939,"_19244":109340,"_5":13232,"_26277":109136,"_2666":109341},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3170":65026,"_27782":64939,"_19244":109343,"_5":13232,"_26277":109136,"_2666":109344},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3170":65027,"_27782":64939,"_19244":109346,"_5":13232,"_26277":109136,"_2666":109347},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar, y si la consola de tu versión no expone la configuración independiente, utiliza la API DMS.",{"_3170":65028,"_27782":64939,"_19244":109349,"_5":13232,"_26277":109136,"_2666":109350},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3170":65029,"_27782":64939,"_19244":109352,"_5":13232,"_26277":109136,"_2666":109353},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3170":65030,"_27782":64939,"_19244":109355,"_5":13232,"_26277":109140,"_2666":109356},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3170":65031,"_27782":64939,"_19244":109358,"_5":13232,"_26277":109144,"_2666":109359},[],"Campo de `settings.reenrollment_settings`",{"_3170":65032,"_27782":64939,"_19244":109361,"_5":13232,"_26277":109144,"_2666":109362},[],"Función",{"_3170":65033,"_27782":64939,"_19244":109364,"_5":13232,"_26277":109144,"_2666":48105},[],{"_3170":65034,"_27782":64939,"_19244":109366,"_5":13232,"_26277":109144,"_2666":109367},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3170":65035,"_27782":64939,"_19244":109369,"_5":13232,"_26277":109144,"_2666":48111},[],{"_3170":65036,"_27782":64939,"_19244":109371,"_5":13232,"_26277":109144,"_2666":109372},[],"Umbral operativo preventivo de monitorización.",{"_3170":65037,"_27782":64939,"_19244":109374,"_5":13232,"_26277":109144,"_2666":48117},[],{"_3170":65038,"_27782":64939,"_19244":109376,"_5":13232,"_26277":109144,"_2666":109377},[],"Umbral operativo crítico de monitorización.",{"_3170":65039,"_27782":64939,"_19244":109379,"_5":13232,"_26277":109144,"_2666":48123},[],{"_3170":65040,"_27782":64939,"_19244":109381,"_5":13232,"_26277":109144,"_2666":109382},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3170":65041,"_27782":64939,"_19244":109384,"_5":13232,"_26277":109144,"_2666":48129},[],{"_3170":65042,"_27782":64939,"_19244":109386,"_5":13232,"_26277":109144,"_2666":109387},[],"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3170":65043,"_27782":64939,"_19244":109389,"_5":13232,"_26277":109144,"_2666":48135},[],{"_3170":65044,"_27782":64939,"_19244":109391,"_5":13232,"_26277":109144,"_2666":109392},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3170":65045,"_27782":64939,"_19244":109394,"_5":13232,"_26277":109144,"_2666":109395},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_3170":65046,"_27782":64939,"_19244":109397,"_5":13232,"_26277":109148,"_2666":109398},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_3170":65047,"_27782":64939,"_19244":109400,"_5":13232,"_26277":109151,"_2666":106893},[],{"_3170":65048,"_27782":64939,"_19244":109402,"_5":13232,"_26277":109151,"_2666":109403},[],"Qué publica",{"_3170":65049,"_27782":64939,"_19244":109405,"_5":13232,"_26277":109151,"_2666":48152},[],{"_3170":65050,"_27782":64939,"_19244":109407,"_5":13232,"_26277":109151,"_2666":109408},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3170":65051,"_27782":64939,"_19244":109410,"_5":13232,"_26277":109151,"_2666":48158},[],{"_3170":65052,"_27782":64939,"_19244":109412,"_5":13232,"_26277":109151,"_2666":109413},[],"Certificado de la CA emisora seleccionada.",{"_3170":65053,"_27782":64939,"_19244":109415,"_5":13232,"_26277":109151,"_2666":48164},[],{"_3170":65054,"_27782":64939,"_19244":109417,"_5":13232,"_26277":109151,"_2666":109418},[],"Certificados de las CAs elegidas explícitamente.",{"_3170":65055,"_27782":64939,"_19244":109420,"_5":13232,"_26277":109151,"_2666":109421},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_3170":65056,"_27782":64939,"_19244":109423,"_5":13232,"_26277":109155,"_2666":109424},[],"**Edit** cambia nombre, ajustes y metadatos. La actualización del backend sustituye esos bloques completos; al usar la API, lee el DMS antes de enviar una edición para no perder campos.",{"_3170":65057,"_27782":64939,"_19244":109426,"_5":13232,"_26277":109155,"_2666":109427},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3170":65058,"_27782":64939,"_19244":109429,"_5":13232,"_26277":109155,"_2666":109430},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3170":65059,"_27782":64939,"_19244":109432,"_5":13232,"_26277":109159,"_2666":109433},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3170":65060,"_27782":65060,"_5":13558,"_2666":109435,"_28124":109436,"_19244":109437,"_26277":65060},"Integra el cliente EST",[45194,107863,47551,108838,109013],[],{"_3170":65061,"_27782":65060,"_19244":109439,"_5":13232,"_26277":65060,"_2666":109440},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_3170":65062,"_27782":65060,"_5":28121,"_19244":109442,"_26277":109443,"_2666":106529},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_3170":65063,"_27782":65060,"_5":28121,"_19244":109445,"_26277":109446,"_2666":109447},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_3170":65064,"_27782":65060,"_5":28121,"_19244":109449,"_26277":109450,"_2666":109451},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_3170":65065,"_27782":65060,"_5":28121,"_19244":109453,"_26277":109454,"_2666":109455},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_3170":65066,"_27782":65060,"_5":28121,"_19244":109457,"_26277":109458,"_2666":109459},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_3170":65067,"_27782":65060,"_5":28121,"_19244":109461,"_26277":109462,"_2666":109463},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_3170":65068,"_27782":65060,"_19244":109465,"_5":13232,"_26277":65060,"_2666":109466},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_3170":65069,"_27782":65060,"_19244":109468,"_5":13232,"_26277":109443,"_2666":109469},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3170":65070,"_27782":65060,"_19244":109471,"_5":13232,"_26277":109443,"_2666":109472},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3170":65071,"_27782":65060,"_19244":109474,"_5":13232,"_26277":109443,"_2666":109475},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3170":65072,"_27782":65060,"_19244":109477,"_5":13232,"_26277":109446,"_2666":109478},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_3170":65073,"_27782":65060,"_19244":109480,"_5":13232,"_26277":109446,"_2666":109481},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3170":65074,"_27782":65060,"_19244":109483,"_5":13232,"_26277":109450,"_2666":109484},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3170":65075,"_27782":65060,"_19244":109486,"_5":13232,"_26277":109450,"_2666":109487},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3170":65076,"_27782":65060,"_19244":109489,"_5":13232,"_26277":109454,"_2666":109490},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3170":65077,"_27782":65060,"_19244":109492,"_5":13232,"_26277":109454,"_2666":109493},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3170":65078,"_27782":65060,"_19244":109495,"_5":13232,"_26277":109458,"_2666":109496},[],"Para el caso de una raíz que emite directamente:",{"_3170":65079,"_27782":65060,"_19244":109498,"_5":13232,"_26277":109458,"_2666":109499},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3170":65080,"_27782":65060,"_19244":109501,"_5":13232,"_26277":109458,"_2666":109502},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3170":65081,"_27782":65060,"_19244":109504,"_5":13232,"_26277":109462,"_2666":109505},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_3170":65082,"_27782":65082,"_5":13558,"_2666":109507,"_28124":109508,"_19244":109509,"_26277":65082},"Referencia EST",[45194,107863,47551,108838,109013],[],{"_3170":65083,"_27782":65082,"_19244":109511,"_5":13232,"_26277":65082,"_2666":109512},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_3170":65084,"_27782":65082,"_5":28121,"_19244":109514,"_26277":109515,"_2666":109516},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_3170":65085,"_27782":65082,"_5":28121,"_19244":109518,"_26277":109519,"_2666":20880},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3170":65086,"_27782":65082,"_5":28121,"_19244":109521,"_26277":109522,"_2666":24010},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3170":65087,"_27782":65082,"_5":28121,"_19244":109524,"_26277":109525,"_2666":24017},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3170":65088,"_27782":65082,"_5":28121,"_19244":109527,"_26277":109528,"_2666":23345},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3170":65089,"_27782":65082,"_5":28121,"_19244":109530,"_26277":109531,"_2666":109532},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_3170":65090,"_27782":65082,"_5":28121,"_19244":109534,"_26277":109535,"_2666":109536},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_3170":65091,"_27782":65082,"_5":28121,"_19244":109538,"_26277":109539,"_2666":109540},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_3170":65092,"_27782":65082,"_19244":109542,"_5":13232,"_26277":65082,"_2666":109543},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_3170":65093,"_27782":65082,"_19244":109545,"_5":13232,"_26277":109515,"_2666":109546},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3170":65094,"_27782":65082,"_19244":109548,"_5":13232,"_26277":109515,"_2666":107654},[],{"_3170":65095,"_27782":65082,"_19244":109550,"_5":13232,"_26277":109515,"_2666":109551},[],"Método",{"_3170":65096,"_27782":65082,"_19244":109553,"_5":13232,"_26277":109515,"_2666":109554},[],"Autenticación y condición",{"_3170":65097,"_27782":65082,"_19244":109556,"_5":13232,"_26277":109515,"_2666":48307},[],{"_3170":65098,"_27782":65082,"_19244":109558,"_5":13232,"_26277":109515,"_2666":48310},[],{"_3170":65099,"_27782":65082,"_19244":109560,"_5":13232,"_26277":109515,"_2666":109561},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3170":65100,"_27782":65082,"_19244":109563,"_5":13232,"_26277":109515,"_2666":48316},[],{"_3170":65101,"_27782":65082,"_19244":109565,"_5":13232,"_26277":109515,"_2666":48319},[],{"_3170":65102,"_27782":65082,"_19244":109567,"_5":13232,"_26277":109515,"_2666":109568},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3170":65103,"_27782":65082,"_19244":109570,"_5":13232,"_26277":109515,"_2666":48325},[],{"_3170":65104,"_27782":65082,"_19244":109572,"_5":13232,"_26277":109515,"_2666":48319},[],{"_3170":65105,"_27782":65082,"_19244":109574,"_5":13232,"_26277":109515,"_2666":109575},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3170":65106,"_27782":65082,"_19244":109577,"_5":13232,"_26277":109515,"_2666":48333},[],{"_3170":65107,"_27782":65082,"_19244":109579,"_5":13232,"_26277":109515,"_2666":48319},[],{"_3170":65108,"_27782":65082,"_19244":109581,"_5":13232,"_26277":109515,"_2666":109582},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_3170":65109,"_27782":65082,"_19244":109584,"_5":13232,"_26277":109515,"_2666":109585},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3170":65110,"_27782":65082,"_19244":109587,"_5":13232,"_26277":109519,"_2666":109588},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_3170":65111,"_27782":65082,"_19244":109590,"_5":13232,"_26277":109519,"_2666":109591},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_3170":65112,"_27782":65082,"_19244":109593,"_5":13232,"_26277":109522,"_2666":109594},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_3170":65113,"_27782":65082,"_19244":109596,"_5":13232,"_26277":109522,"_2666":109597},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_3170":65114,"_27782":65082,"_19244":109599,"_5":13232,"_26277":109525,"_2666":109600},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_3170":65115,"_27782":65082,"_19244":109602,"_5":13232,"_26277":109525,"_2666":109603},[],"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_3170":65116,"_27782":65082,"_19244":109605,"_5":13232,"_26277":109528,"_2666":109606},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_3170":65117,"_27782":65082,"_19244":109608,"_5":13232,"_26277":109528,"_2666":109609},[],"El código admite RSA y ECDSA, y el valor `bits` del ajuste de clave del DMS significa algo distinto en cada caso. En ECDSA selecciona la curva: 224, 256, 384 o 521 corresponden a P-224, P-256, P-384 y P-521, y un tamaño no reconocido produce fallback a P-256, así que elige explícitamente un tamaño compatible y comprueba la clave resultante. En RSA se usa directamente como tamaño del módulo; la consola ofrece 2048, 3072 y 4096 bits. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_3170":65118,"_27782":65082,"_19244":109611,"_5":13232,"_26277":109531,"_2666":109612},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3170":65119,"_27782":65082,"_19244":109614,"_5":13232,"_26277":109531,"_2666":109615},[],"Parte",{"_3170":65120,"_27782":65082,"_19244":109617,"_5":13232,"_26277":109531,"_2666":109618},[],"Contenido tras decodificar su Base64",{"_3170":65121,"_27782":65082,"_19244":109620,"_5":13232,"_26277":109531,"_2666":48377},[],{"_3170":65122,"_27782":65082,"_19244":109622,"_5":13232,"_26277":109531,"_2666":109623},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3170":65123,"_27782":65082,"_19244":109625,"_5":13232,"_26277":109531,"_2666":48383},[],{"_3170":65124,"_27782":65082,"_19244":109627,"_5":13232,"_26277":109531,"_2666":109628},[],"PKCS#7 DER con el certificado emitido.",{"_3170":65125,"_27782":65082,"_19244":109630,"_5":13232,"_26277":109531,"_2666":109631},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3170":65126,"_27782":65082,"_19244":109633,"_5":13232,"_26277":109535,"_2666":109634},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3170":65127,"_27782":65082,"_19244":109636,"_5":13232,"_26277":109535,"_2666":109637},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_3170":65128,"_27782":65082,"_19244":109639,"_5":13232,"_26277":109535,"_2666":109640},[],"Convierte y comprueba el resultado:",{"_3170":65129,"_27782":65082,"_19244":109642,"_5":13232,"_26277":109535,"_2666":109643},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_3170":65130,"_27782":65082,"_19244":109645,"_5":13232,"_26277":109539,"_2666":109646},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3170":65131,"_27782":65082,"_19244":109648,"_5":13232,"_26277":109539,"_2666":109649},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3170":65132,"_27782":65132,"_5":13558,"_2666":109013,"_28124":109651,"_19244":109652,"_26277":65132},[45194,107863,47551,108838,109013],[],{"_3170":65133,"_27782":65132,"_19244":109654,"_5":13232,"_26277":65132,"_2666":109655},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_3170":65134,"_27782":65132,"_5":28121,"_19244":109657,"_26277":109658,"_2666":109659},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3170":65135,"_27782":65132,"_5":28121,"_19244":109661,"_26277":109662,"_2666":109663},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3170":65136,"_27782":65132,"_5":28121,"_19244":109665,"_26277":109666,"_2666":109667},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3170":65137,"_27782":65132,"_5":28121,"_19244":109669,"_26277":109670,"_2666":109671},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_3170":65138,"_27782":65132,"_19244":109673,"_5":13232,"_26277":65132,"_2666":109674},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3170":65139,"_27782":65132,"_19244":109676,"_5":13232,"_26277":109658,"_2666":109677},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3170":65140,"_27782":65132,"_19244":109679,"_5":13232,"_26277":109658,"_2666":109680},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3170":65141,"_27782":65132,"_19244":109682,"_5":13232,"_26277":109658,"_2666":109683},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3170":65142,"_27782":65132,"_19244":109685,"_5":13232,"_26277":109658,"_2666":109686},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3170":65143,"_27782":65132,"_19244":109688,"_5":13232,"_26277":109658,"_2666":109689},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3170":65144,"_27782":65132,"_19244":109691,"_5":13232,"_26277":109658,"_2666":109692},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3170":65145,"_27782":65132,"_19244":109694,"_5":13232,"_26277":109662,"_2666":109695},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3170":65146,"_27782":65132,"_19244":109697,"_5":13232,"_26277":109662,"_2666":109698},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3170":65147,"_27782":65132,"_19244":109700,"_5":13232,"_26277":109662,"_2666":109701},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3170":65148,"_27782":65132,"_19244":109703,"_5":13232,"_26277":109662,"_2666":109704},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3170":65149,"_27782":65132,"_19244":109706,"_5":13232,"_26277":109666,"_2666":109707},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3170":65150,"_27782":65132,"_19244":109709,"_5":13232,"_26277":109666,"_2666":109710},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3170":65151,"_27782":65132,"_19244":109712,"_5":13232,"_26277":109666,"_2666":109713},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3170":65152,"_27782":65132,"_19244":109715,"_5":13232,"_26277":109666,"_2666":109716},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3170":65153,"_27782":65132,"_19244":109718,"_5":13232,"_26277":109670,"_2666":109719},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_3170":65154,"_27782":65132,"_19244":109721,"_5":13232,"_26277":109670,"_2666":109722},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3170":65155,"_27782":65155,"_5":13558,"_2666":109724,"_28124":109725,"_19244":109726,"_26277":65155},"Estrategias de aprovisionamiento",[45194,107863,47551,108838,109013],[],{"_3170":65156,"_27782":65155,"_19244":109728,"_5":13232,"_26277":65155,"_2666":109729},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3170":65157,"_27782":65155,"_5":28121,"_19244":109731,"_26277":109732,"_2666":109733},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3170":65158,"_27782":65155,"_5":28121,"_19244":109735,"_26277":109736,"_2666":109737},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3170":65159,"_27782":65155,"_5":28121,"_19244":109739,"_26277":109740,"_2666":109741},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3170":65160,"_27782":65155,"_5":28121,"_19244":109743,"_26277":109744,"_2666":109745},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3170":65161,"_27782":65155,"_5":28121,"_19244":109747,"_26277":109748,"_2666":109749},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3170":65162,"_27782":65155,"_19244":109751,"_5":13232,"_26277":65155,"_2666":109752},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3170":65163,"_27782":65155,"_19244":109754,"_5":13232,"_26277":109732,"_2666":109755},[],"Recorrido",{"_3170":65164,"_27782":65155,"_19244":109757,"_5":13232,"_26277":109732,"_2666":109758},[],"Cuándo existe el dispositivo",{"_3170":65165,"_27782":65155,"_19244":109760,"_5":13232,"_26277":109732,"_2666":109761},[],"Qué compruebas",{"_3170":65166,"_27782":65155,"_19244":109763,"_5":13232,"_26277":109732,"_2666":109764},[],"Asignación manual",{"_3170":65167,"_27782":65155,"_19244":109766,"_5":13232,"_26277":109732,"_2666":109767},[],"El operador lo crea antes de asociar un certificado.",{"_3170":65168,"_27782":65155,"_19244":109769,"_5":13232,"_26277":109732,"_2666":109770},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3170":65169,"_27782":65155,"_19244":109772,"_5":13232,"_26277":109732,"_2666":109773},[],"EST con `JITP`",{"_3170":65170,"_27782":65155,"_19244":109775,"_5":13232,"_26277":109732,"_2666":109776},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3170":65171,"_27782":65155,"_19244":109778,"_5":13232,"_26277":109732,"_2666":109779},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3170":65172,"_27782":65155,"_19244":109781,"_5":13232,"_26277":109732,"_2666":109782},[],"EST con `PRE_REGISTRATION`",{"_3170":65173,"_27782":65155,"_19244":109784,"_5":13232,"_26277":109732,"_2666":109785},[],"Debe existir antes de `/simpleenroll`.",{"_3170":65174,"_27782":65155,"_19244":109787,"_5":13232,"_26277":109732,"_2666":109788},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3170":65175,"_27782":65155,"_19244":109790,"_5":13232,"_26277":109732,"_2666":109791},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3170":65176,"_27782":65155,"_19244":109793,"_5":13232,"_26277":109732,"_2666":109794},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3170":65177,"_27782":65155,"_19244":109796,"_5":13232,"_26277":109736,"_2666":109797},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3170":65178,"_27782":65155,"_19244":109799,"_5":13232,"_26277":109736,"_2666":109800},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3170":65179,"_27782":65155,"_19244":109802,"_5":13232,"_26277":109736,"_2666":109803},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3170":65180,"_27782":65155,"_19244":109805,"_5":13232,"_26277":109740,"_2666":109806},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3170":65181,"_27782":65155,"_19244":109808,"_5":13232,"_26277":109740,"_2666":109809},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3170":65182,"_27782":65155,"_19244":109811,"_5":13232,"_26277":109740,"_2666":109812},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3170":65183,"_27782":65155,"_19244":109814,"_5":13232,"_26277":109740,"_2666":109815},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3170":65184,"_27782":65155,"_19244":109817,"_5":13232,"_26277":109740,"_2666":109818},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3170":65185,"_27782":65155,"_19244":109820,"_5":13232,"_26277":109740,"_2666":109821},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3170":65186,"_27782":65155,"_19244":109823,"_5":13232,"_26277":109744,"_2666":106893},[],{"_3170":65187,"_27782":65155,"_19244":109825,"_5":13232,"_26277":109744,"_2666":109826},[],"Material que atraviesa EST",{"_3170":65188,"_27782":65155,"_19244":109828,"_5":13232,"_26277":109744,"_2666":109829},[],"Clave generada por el dispositivo",{"_3170":65189,"_27782":65155,"_19244":109831,"_5":13232,"_26277":109744,"_2666":109832},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3170":65190,"_27782":65155,"_19244":109834,"_5":13232,"_26277":109744,"_2666":109835},[],"Clave ya disponible en el dispositivo",{"_3170":65191,"_27782":65155,"_19244":109837,"_5":13232,"_26277":109744,"_2666":109838},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3170":65192,"_27782":65155,"_19244":109840,"_5":13232,"_26277":109744,"_2666":47870},[],{"_3170":65193,"_27782":65155,"_19244":109842,"_5":13232,"_26277":109744,"_2666":109843},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3170":65194,"_27782":65155,"_19244":109845,"_5":13232,"_26277":109744,"_2666":109846},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3170":65195,"_27782":65155,"_19244":109848,"_5":13232,"_26277":109748,"_2666":109849},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3170":65196,"_27782":65196,"_5":13558,"_2666":109851,"_28124":109852,"_19244":109853,"_26277":65196},"Renovación y recuperación",[45194,107863,47551,108838,109013],[],{"_3170":65197,"_27782":65196,"_19244":109855,"_5":13232,"_26277":65196,"_2666":109856},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_3170":65198,"_27782":65196,"_5":28121,"_19244":109858,"_26277":109859,"_2666":109860},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_3170":65199,"_27782":65196,"_5":28121,"_19244":109862,"_26277":109863,"_2666":109864},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_3170":65200,"_27782":65196,"_5":28121,"_19244":109866,"_26277":109867,"_2666":109868},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_3170":65201,"_27782":65196,"_5":28121,"_19244":109870,"_26277":109871,"_2666":109872},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_3170":65202,"_27782":65196,"_5":28121,"_19244":109874,"_26277":109875,"_2666":109876},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_3170":65203,"_27782":65196,"_19244":109878,"_5":13232,"_26277":65196,"_2666":109879},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_3170":65204,"_27782":65196,"_19244":109881,"_5":13232,"_26277":109859,"_2666":109882},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3170":65205,"_27782":65196,"_19244":109884,"_5":13232,"_26277":109859,"_2666":109885},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3170":65206,"_27782":65196,"_19244":109887,"_5":13232,"_26277":109859,"_2666":109888},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3170":65207,"_27782":65196,"_19244":109890,"_5":13232,"_26277":109859,"_2666":109891},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3170":65208,"_27782":65196,"_19244":109893,"_5":13232,"_26277":109863,"_2666":109894},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3170":65209,"_27782":65196,"_19244":109896,"_5":13232,"_26277":109863,"_2666":109897},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3170":65210,"_27782":65196,"_19244":109899,"_5":13232,"_26277":109867,"_2666":109900},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3170":65211,"_27782":65196,"_19244":109902,"_5":13232,"_26277":109867,"_2666":109903},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3170":65212,"_27782":65196,"_19244":109905,"_5":13232,"_26277":109867,"_2666":109906},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3170":65213,"_27782":65196,"_19244":109908,"_5":13232,"_26277":109871,"_2666":109909},[],"Situación",{"_3170":65214,"_27782":65196,"_19244":109911,"_5":13232,"_26277":109871,"_2666":109912},[],"Procedimiento",{"_3170":65215,"_27782":65196,"_19244":109914,"_5":13232,"_26277":109871,"_2666":109915},[],"Certificado vigente, fuera de ventana",{"_3170":65216,"_27782":65196,"_19244":109917,"_5":13232,"_26277":109871,"_2666":109918},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3170":65217,"_27782":65196,"_19244":109920,"_5":13232,"_26277":109871,"_2666":109921},[],"Certificado vencido, clave disponible",{"_3170":65218,"_27782":65196,"_19244":109923,"_5":13232,"_26277":109871,"_2666":109924},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3170":65219,"_27782":65196,"_19244":109926,"_5":13232,"_26277":109871,"_2666":109927},[],"Renovación por webhook o `NO_AUTH`",{"_3170":65220,"_27782":65196,"_19244":109929,"_5":13232,"_26277":109871,"_2666":109930},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3170":65221,"_27782":65196,"_19244":109932,"_5":13232,"_26277":109871,"_2666":109933},[],"Clave perdida o inaccesible",{"_3170":65222,"_27782":65196,"_19244":109935,"_5":13232,"_26277":109871,"_2666":109936},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3170":65223,"_27782":65196,"_19244":109938,"_5":13232,"_26277":109871,"_2666":109939},[],"Identidad actual revocada",{"_3170":65224,"_27782":65196,"_19244":109941,"_5":13232,"_26277":109871,"_2666":109942},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3170":65225,"_27782":65196,"_19244":109944,"_5":13232,"_26277":109871,"_2666":109945},[],"Dispositivo sin identidad",{"_3170":65226,"_27782":65196,"_19244":109947,"_5":13232,"_26277":109871,"_2666":109948},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3170":65227,"_27782":65196,"_19244":109950,"_5":13232,"_26277":109871,"_2666":109951},[],"Dispositivo retirado",{"_3170":65228,"_27782":65196,"_19244":109953,"_5":13232,"_26277":109871,"_2666":109954},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3170":65229,"_27782":65196,"_19244":109956,"_5":13232,"_26277":109871,"_2666":109957},[],"Timeout, HTTP 500 o fallo de instalación",{"_3170":65230,"_27782":65196,"_19244":109959,"_5":13232,"_26277":109871,"_2666":109960},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3170":65231,"_27782":65196,"_19244":109962,"_5":13232,"_26277":109875,"_2666":109963},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3170":65232,"_27782":65196,"_19244":109965,"_5":13232,"_26277":109875,"_2666":109966},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3170":65233,"_27782":65233,"_5":13558,"_2666":109968,"_28124":109969,"_19244":109970,"_26277":65233},"Diagnóstico de enrolamiento",[45194,107863,47551,108838,109013],[],{"_3170":65234,"_27782":65233,"_19244":109972,"_5":13232,"_26277":65233,"_2666":109973},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3170":65235,"_27782":65233,"_5":28121,"_19244":109975,"_26277":109976,"_2666":109977},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3170":65236,"_27782":65233,"_5":28121,"_19244":109979,"_26277":109980,"_2666":109981},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3170":65237,"_27782":65233,"_5":28121,"_19244":109983,"_26277":109984,"_2666":109540},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_3170":65238,"_27782":65233,"_5":28121,"_19244":109986,"_26277":109987,"_2666":109988},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3170":65239,"_27782":65233,"_19244":109990,"_5":13232,"_26277":65233,"_2666":109991},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3170":65240,"_27782":65233,"_19244":109993,"_5":13232,"_26277":109980,"_2666":109994},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3170":65241,"_27782":65233,"_19244":109996,"_5":13232,"_26277":109980,"_2666":109997},[],"Síntoma o mensaje",{"_3170":65242,"_27782":65233,"_19244":109999,"_5":13232,"_26277":109980,"_2666":110000},[],"Qué revisar",{"_3170":65243,"_27782":65233,"_19244":110002,"_5":13232,"_26277":109980,"_2666":110003},[],"curl rechaza TLS, nombre o emisor",{"_3170":65244,"_27782":65233,"_19244":110005,"_5":13232,"_26277":109980,"_2666":110006},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3170":65245,"_27782":65233,"_19244":110008,"_5":13232,"_26277":109980,"_2666":110009},[],"404 o APS ausente",{"_3170":65246,"_27782":65233,"_19244":110011,"_5":13232,"_26277":109980,"_2666":110012},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3170":65247,"_27782":65233,"_19244":110014,"_5":13232,"_26277":109980,"_2666":110015},[],"400, error de CSR o formato",{"_3170":65248,"_27782":65233,"_19244":110017,"_5":13232,"_26277":109980,"_2666":110018},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3170":65249,"_27782":65233,"_19244":110020,"_5":13232,"_26277":109980,"_2666":110021},[],"Credencial ausente o certificado no válido",{"_3170":65250,"_27782":65233,"_19244":110023,"_5":13232,"_26277":109980,"_2666":110024},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3170":65251,"_27782":65233,"_19244":110026,"_5":13232,"_26277":109980,"_2666":110027},[],"Webhook deniega, expira o responde sin autorización",{"_3170":65252,"_27782":65233,"_19244":110029,"_5":13232,"_26277":109980,"_2666":110030},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3170":65253,"_27782":65233,"_19244":110032,"_5":13232,"_26277":109980,"_2666":48790},[],{"_3170":65254,"_27782":65233,"_19244":110034,"_5":13232,"_26277":109980,"_2666":110035},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3170":65255,"_27782":65233,"_19244":110037,"_5":13232,"_26277":109980,"_2666":48796},[],{"_3170":65256,"_27782":65233,"_19244":110039,"_5":13232,"_26277":109980,"_2666":110040},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3170":65257,"_27782":65233,"_19244":110042,"_5":13232,"_26277":109980,"_2666":48802},[],{"_3170":65258,"_27782":65233,"_19244":110044,"_5":13232,"_26277":109980,"_2666":110045},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3170":65259,"_27782":65233,"_19244":110047,"_5":13232,"_26277":109980,"_2666":48808},[],{"_3170":65260,"_27782":65233,"_19244":110049,"_5":13232,"_26277":109980,"_2666":110050},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3170":65261,"_27782":65233,"_19244":110052,"_5":13232,"_26277":109980,"_2666":48814},[],{"_3170":65262,"_27782":65233,"_19244":110054,"_5":13232,"_26277":109980,"_2666":110055},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3170":65263,"_27782":65233,"_19244":110057,"_5":13232,"_26277":109980,"_2666":110058},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3170":65264,"_27782":65233,"_19244":110060,"_5":13232,"_26277":109980,"_2666":110061},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3170":65265,"_27782":65233,"_19244":110063,"_5":13232,"_26277":109980,"_2666":110064},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3170":65266,"_27782":65233,"_19244":110066,"_5":13232,"_26277":109980,"_2666":110067},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3170":65267,"_27782":65233,"_19244":110069,"_5":13232,"_26277":109980,"_2666":48832},[],{"_3170":65268,"_27782":65233,"_19244":110071,"_5":13232,"_26277":109980,"_2666":110072},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3170":65269,"_27782":65233,"_19244":110074,"_5":13232,"_26277":109980,"_2666":48838},[],{"_3170":65270,"_27782":65233,"_19244":110076,"_5":13232,"_26277":109980,"_2666":110077},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3170":65271,"_27782":65233,"_19244":110079,"_5":13232,"_26277":109980,"_2666":110080},[],"DMS propietario distinto",{"_3170":65272,"_27782":65233,"_19244":110082,"_5":13232,"_26277":109980,"_2666":110083},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3170":65273,"_27782":65233,"_19244":110085,"_5":13232,"_26277":109980,"_2666":48850},[],{"_3170":65274,"_27782":65233,"_19244":110087,"_5":13232,"_26277":109980,"_2666":110088},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3170":65275,"_27782":65233,"_19244":110090,"_5":13232,"_26277":109980,"_2666":48856},[],{"_3170":65276,"_27782":65233,"_19244":110092,"_5":13232,"_26277":109980,"_2666":110093},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3170":65277,"_27782":65233,"_19244":110095,"_5":13232,"_26277":109980,"_2666":110096},[],"Certificado actual revocado",{"_3170":65278,"_27782":65233,"_19244":110098,"_5":13232,"_26277":109980,"_2666":110099},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3170":65279,"_27782":65233,"_19244":110101,"_5":13232,"_26277":109980,"_2666":110102},[],"Error de CA, perfil o firma",{"_3170":65280,"_27782":65233,"_19244":110104,"_5":13232,"_26277":109980,"_2666":110105},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3170":65281,"_27782":65233,"_19244":110107,"_5":13232,"_26277":109980,"_2666":110108},[],"HTTP 200 sin conexión del dispositivo",{"_3170":65282,"_27782":65233,"_19244":110110,"_5":13232,"_26277":109980,"_2666":110111},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3170":65283,"_27782":65233,"_19244":110113,"_5":13232,"_26277":109980,"_2666":110114},[],"Timeout o error después de emitir",{"_3170":65284,"_27782":65233,"_19244":110116,"_5":13232,"_26277":109980,"_2666":110117},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3170":65285,"_27782":65233,"_19244":110119,"_5":13232,"_26277":109984,"_2666":110120},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3170":65286,"_27782":65233,"_19244":110122,"_5":13232,"_26277":109984,"_2666":110123},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_3170":65287,"_27782":65233,"_19244":110125,"_5":13232,"_26277":109987,"_2666":110126},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3170":65288,"_27782":65233,"_19244":110128,"_5":13232,"_26277":109987,"_2666":110129},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3170":65289,"_27782":65233,"_19244":110131,"_5":13232,"_26277":109987,"_2666":110132},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3170":65290,"_27782":65233,"_19244":110134,"_5":13232,"_26277":109987,"_2666":110135},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3170":65291,"_27782":65233,"_19244":110137,"_5":13232,"_26277":109987,"_2666":110138},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3170":65292,"_27782":65233,"_19244":110140,"_5":13232,"_26277":109987,"_2666":110141},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3170":65293,"_27782":65233,"_19244":110143,"_5":13232,"_26277":109987,"_2666":110144},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3170":65294,"_27782":65294,"_5":13558,"_2666":110146,"_28124":110147,"_19244":110148,"_26277":65294},"Distribución y actualización de confianza",[45194,107863,47551,108838,109013],[],{"_3170":65295,"_27782":65294,"_19244":110150,"_5":13232,"_26277":65294,"_2666":110151},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_3170":65296,"_27782":65294,"_5":28121,"_19244":110153,"_26277":110154,"_2666":110155},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_3170":65297,"_27782":65294,"_5":28121,"_19244":110157,"_26277":110158,"_2666":110159},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_3170":65298,"_27782":65294,"_5":28121,"_19244":110161,"_26277":110162,"_2666":110163},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_3170":65299,"_27782":65294,"_5":28121,"_19244":110165,"_26277":110166,"_2666":110167},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_3170":65300,"_27782":65294,"_5":28121,"_19244":110169,"_26277":110170,"_2666":110171},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_3170":65301,"_27782":65294,"_19244":110173,"_5":13232,"_26277":65294,"_2666":110174},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_3170":65302,"_27782":65294,"_19244":110176,"_5":13232,"_26277":110154,"_2666":110177},[],"Relación",{"_3170":65303,"_27782":65294,"_19244":110179,"_5":13232,"_26277":110154,"_2666":110180},[],"Material que prepara el responsable",{"_3170":65304,"_27782":65294,"_19244":110182,"_5":13232,"_26277":110154,"_2666":110183},[],"Dispositivo → servidor EST",{"_3170":65305,"_27782":65294,"_19244":110185,"_5":13232,"_26277":110154,"_2666":110186},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_3170":65306,"_27782":65294,"_19244":110188,"_5":13232,"_26277":110154,"_2666":110189},[],"DMS → solicitante",{"_3170":65307,"_27782":65294,"_19244":110191,"_5":13232,"_26277":110154,"_2666":110192},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_3170":65308,"_27782":65294,"_19244":110194,"_5":13232,"_26277":110154,"_2666":110195},[],"Consumidor → dispositivo",{"_3170":65309,"_27782":65294,"_19244":110197,"_5":13232,"_26277":110154,"_2666":110198},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_3170":65310,"_27782":65294,"_19244":110200,"_5":13232,"_26277":110154,"_2666":110201},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_3170":65311,"_27782":65294,"_19244":110203,"_5":13232,"_26277":110158,"_2666":110204},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3170":65312,"_27782":65294,"_19244":110206,"_5":13232,"_26277":110158,"_2666":110207},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3170":65313,"_27782":65294,"_19244":110209,"_5":13232,"_26277":110162,"_2666":110210},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_3170":65314,"_27782":65294,"_19244":110212,"_5":13232,"_26277":110162,"_2666":110213},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_3170":65315,"_27782":65294,"_19244":110215,"_5":13232,"_26277":110162,"_2666":110216},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_3170":65316,"_27782":65294,"_19244":110218,"_5":13232,"_26277":110162,"_2666":110219},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_3170":65317,"_27782":65294,"_19244":110221,"_5":13232,"_26277":110162,"_2666":110222},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_3170":65318,"_27782":65294,"_19244":110224,"_5":13232,"_26277":110162,"_2666":110225},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_3170":65319,"_27782":65294,"_19244":110227,"_5":13232,"_26277":110166,"_2666":110228},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_3170":65320,"_27782":65294,"_19244":110230,"_5":13232,"_26277":110166,"_2666":110231},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_3170":65321,"_27782":65294,"_19244":110233,"_5":13232,"_26277":110166,"_2666":110234},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_3170":65322,"_27782":65294,"_19244":110236,"_5":13232,"_26277":110170,"_2666":110237},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_3170":65323,"_27782":65323,"_5":13558,"_2666":49005,"_28124":110239,"_19244":110241,"_26277":65323},[45194,107863,47551,108838,110240],"Integraciones",[],{"_3170":65324,"_27782":65323,"_19244":110243,"_5":13232,"_26277":65323,"_2666":110244},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3170":65325,"_27782":65323,"_5":28121,"_19244":110246,"_26277":110247,"_2666":110248},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3170":65326,"_27782":65323,"_5":28121,"_19244":110250,"_26277":110251,"_2666":110252},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3170":65327,"_27782":65323,"_5":28121,"_19244":110254,"_26277":110255,"_2666":110256},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3170":65328,"_27782":65323,"_5":28121,"_19244":110258,"_26277":110259,"_2666":110260},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3170":65329,"_27782":65323,"_5":28121,"_19244":110262,"_26277":110263,"_2666":110264},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3170":65330,"_27782":65323,"_5":28121,"_19244":110266,"_26277":110267,"_2666":110268},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3170":65331,"_27782":65323,"_5":28121,"_19244":110270,"_26277":110271,"_2666":49039},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3170":65332,"_27782":65323,"_5":28121,"_19244":110273,"_26277":110274,"_2666":49043},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3170":65333,"_27782":65323,"_5":28121,"_19244":110276,"_26277":110277,"_2666":110278},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3170":65334,"_27782":65323,"_5":28121,"_19244":110280,"_26277":110281,"_2666":110282},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3170":65335,"_27782":65323,"_5":28121,"_19244":110284,"_26277":110285,"_2666":110286},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3170":65336,"_27782":65323,"_5":28121,"_19244":110288,"_26277":110289,"_2666":110290},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3170":65337,"_27782":65323,"_5":28121,"_19244":110292,"_26277":110293,"_2666":110294},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3170":65338,"_27782":65323,"_5":28121,"_19244":110296,"_26277":110297,"_2666":110298},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3170":65339,"_27782":65323,"_5":28121,"_19244":110300,"_26277":110301,"_2666":110302},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3170":65340,"_27782":65323,"_5":28121,"_19244":110304,"_26277":110305,"_2666":110306},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3170":65341,"_27782":65323,"_5":28121,"_19244":110308,"_26277":110309,"_2666":110310},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3170":65342,"_27782":65323,"_5":28121,"_19244":110312,"_26277":110313,"_2666":110314},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3170":65343,"_27782":65323,"_5":28121,"_19244":110316,"_26277":110317,"_2666":110318},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3170":65344,"_27782":65323,"_5":28121,"_19244":110320,"_26277":110321,"_2666":110322},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3170":65345,"_27782":65323,"_19244":110324,"_5":13232,"_26277":65323,"_2666":110325},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3170":65346,"_27782":65323,"_19244":110327,"_5":13232,"_26277":65323,"_2666":110328},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3170":65347,"_27782":65323,"_19244":110330,"_5":13232,"_26277":65323,"_2666":110331},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3170":65348,"_27782":65323,"_19244":110333,"_5":13232,"_26277":110247,"_2666":110334},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3170":65349,"_27782":65323,"_19244":110336,"_5":13232,"_26277":110247,"_2666":110337},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3170":65350,"_27782":65323,"_19244":110339,"_5":13232,"_26277":110247,"_2666":110340},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3170":65351,"_27782":65323,"_19244":110342,"_5":13232,"_26277":110247,"_2666":110343},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3170":65352,"_27782":65323,"_19244":110345,"_5":13232,"_26277":110251,"_2666":110346},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3170":65353,"_27782":65323,"_19244":110348,"_5":13232,"_26277":110255,"_2666":110349},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3170":65354,"_27782":65323,"_19244":110351,"_5":13232,"_26277":110255,"_2666":110352},[],"Acción IAM",{"_3170":65355,"_27782":65323,"_19244":110354,"_5":13232,"_26277":110255,"_2666":106899},[],{"_3170":65356,"_27782":65323,"_19244":110356,"_5":13232,"_26277":110255,"_2666":49126},[],{"_3170":65357,"_27782":65323,"_19244":110358,"_5":13232,"_26277":110255,"_2666":110359},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3170":65358,"_27782":65323,"_19244":110361,"_5":13232,"_26277":110255,"_2666":49132},[],{"_3170":65359,"_27782":65323,"_19244":110363,"_5":13232,"_26277":110255,"_2666":110364},[],"Registrar la CA en AWS IoT",{"_3170":65360,"_27782":65323,"_19244":110366,"_5":13232,"_26277":110255,"_2666":49138},[],{"_3170":65361,"_27782":65323,"_19244":110368,"_5":13232,"_26277":110255,"_2666":110369},[],"Consultar el estado del registro de la CA",{"_3170":65362,"_27782":65323,"_19244":110371,"_5":13232,"_26277":110255,"_2666":49144},[],{"_3170":65363,"_27782":65323,"_19244":110373,"_5":13232,"_26277":110255,"_2666":110374},[],"Crear o actualizar Things en IoT Core",{"_3170":65364,"_27782":65323,"_19244":110376,"_5":13232,"_26277":110255,"_2666":49150},[],{"_3170":65365,"_27782":65323,"_19244":110378,"_5":13232,"_26277":110255,"_2666":110379},[],"Aprovisionar Things mediante plantilla",{"_3170":65366,"_27782":65323,"_19244":110381,"_5":13232,"_26277":110255,"_2666":49156},[],{"_3170":65367,"_27782":65323,"_19244":110383,"_5":13232,"_26277":110255,"_2666":110384},[],"Registrar certificados de dispositivo",{"_3170":65368,"_27782":65323,"_19244":110386,"_5":13232,"_26277":110255,"_2666":49162},[],{"_3170":65369,"_27782":65323,"_19244":110388,"_5":13232,"_26277":110255,"_2666":110389},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3170":65370,"_27782":65323,"_19244":110391,"_5":13232,"_26277":110255,"_2666":49168},[],{"_3170":65371,"_27782":65323,"_19244":110393,"_5":13232,"_26277":110255,"_2666":110394},[],"Crear y adjuntar políticas IoT",{"_3170":65372,"_27782":65323,"_19244":110396,"_5":13232,"_26277":110255,"_2666":49174},[],{"_3170":65373,"_27782":65323,"_19244":110398,"_5":13232,"_26277":110255,"_2666":110399},[],"Gestionar grupos de Things",{"_3170":65374,"_27782":65323,"_19244":110401,"_5":13232,"_26277":110255,"_2666":49180},[],{"_3170":65375,"_27782":65323,"_19244":110403,"_5":13232,"_26277":110255,"_2666":110404},[],"Crear plantillas JITP",{"_3170":65376,"_27782":65323,"_19244":110406,"_5":13232,"_26277":110255,"_2666":49186},[],{"_3170":65377,"_27782":65323,"_19244":110408,"_5":13232,"_26277":110255,"_2666":110409},[],"Leer y escribir el Device Shadow",{"_3170":65378,"_27782":65323,"_19244":110411,"_5":13232,"_26277":110255,"_2666":110412},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3170":65379,"_27782":65323,"_19244":110414,"_5":13232,"_26277":110259,"_2666":110415},[],"Parámetro",{"_3170":65380,"_27782":65323,"_19244":110417,"_5":13232,"_26277":110259,"_2666":110418},[],"Tipo",{"_3170":65381,"_27782":65323,"_19244":110420,"_5":13232,"_26277":110259,"_2666":110421},[],"Requerido",{"_3170":65382,"_27782":65323,"_19244":110423,"_5":13232,"_26277":110259,"_2666":110424},[],"Descripción",{"_3170":65383,"_27782":65323,"_19244":110426,"_5":13232,"_26277":110259,"_2666":49207},[],{"_3170":65384,"_27782":65323,"_19244":110428,"_5":13232,"_26277":110259,"_2666":23022},[],{"_3170":65385,"_27782":65323,"_19244":110430,"_5":13232,"_26277":110259,"_2666":110431},[],"Sí",{"_3170":65386,"_27782":65323,"_19244":110433,"_5":13232,"_26277":110259,"_2666":110434},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3170":65387,"_27782":65323,"_19244":110436,"_5":13232,"_26277":110259,"_2666":49218},[],{"_3170":65388,"_27782":65323,"_19244":110438,"_5":13232,"_26277":110259,"_2666":23022},[],{"_3170":65389,"_27782":65323,"_19244":110440,"_5":13232,"_26277":110259,"_2666":110431},[],{"_3170":65390,"_27782":65323,"_19244":110442,"_5":13232,"_26277":110259,"_2666":110443},[],"Región AWS donde opera el conector.",{"_3170":65391,"_27782":65323,"_19244":110445,"_5":13232,"_26277":110259,"_2666":49228},[],{"_3170":65392,"_27782":65323,"_19244":110447,"_5":13232,"_26277":110259,"_2666":23022},[],{"_3170":65393,"_27782":65323,"_19244":110449,"_5":13232,"_26277":110259,"_2666":110431},[],{"_3170":65394,"_27782":65323,"_19244":110451,"_5":13232,"_26277":110259,"_2666":110452},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3170":65395,"_27782":65323,"_19244":110454,"_5":13232,"_26277":110259,"_2666":49238},[],{"_3170":65396,"_27782":65323,"_19244":110456,"_5":13232,"_26277":110259,"_2666":23022},[],{"_3170":65397,"_27782":65323,"_19244":110458,"_5":13232,"_26277":110259,"_2666":110459},[],"Solo con `auth_method=static`",{"_3170":65398,"_27782":65323,"_19244":110461,"_5":13232,"_26277":110259,"_2666":110462},[],"Clave de acceso AWS.",{"_3170":65399,"_27782":65323,"_19244":110464,"_5":13232,"_26277":110259,"_2666":49249},[],{"_3170":65400,"_27782":65323,"_19244":110466,"_5":13232,"_26277":110259,"_2666":23022},[],{"_3170":65401,"_27782":65323,"_19244":110468,"_5":13232,"_26277":110259,"_2666":110459},[],{"_3170":65402,"_27782":65323,"_19244":110470,"_5":13232,"_26277":110259,"_2666":110471},[],"Clave secreta AWS.",{"_3170":65403,"_27782":65323,"_19244":110473,"_5":13232,"_26277":110259,"_2666":49259},[],{"_3170":65404,"_27782":65323,"_19244":110475,"_5":13232,"_26277":110259,"_2666":23022},[],{"_3170":65405,"_27782":65323,"_19244":110477,"_5":13232,"_26277":110259,"_2666":49264},[],{"_3170":65406,"_27782":65323,"_19244":110479,"_5":13232,"_26277":110259,"_2666":110480},[],"Token de sesión (con `auth_method=static`).",{"_3170":65407,"_27782":65323,"_19244":110482,"_5":13232,"_26277":110259,"_2666":49270},[],{"_3170":65408,"_27782":65323,"_19244":110484,"_5":13232,"_26277":110259,"_2666":23022},[],{"_3170":65409,"_27782":65323,"_19244":110486,"_5":13232,"_26277":110259,"_2666":110487},[],"Solo con `auth_method=role`",{"_3170":65410,"_27782":65323,"_19244":110489,"_5":13232,"_26277":110259,"_2666":110490},[],"ARN del rol a asumir.",{"_3170":65411,"_27782":65323,"_19244":110492,"_5":13232,"_26277":110259,"_2666":49281},[],{"_3170":65412,"_27782":65323,"_19244":110494,"_5":13232,"_26277":110259,"_2666":23022},[],{"_3170":65413,"_27782":65323,"_19244":110496,"_5":13232,"_26277":110259,"_2666":49264},[],{"_3170":65414,"_27782":65323,"_19244":110498,"_5":13232,"_26277":110259,"_2666":110499},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3170":65415,"_27782":65323,"_19244":110501,"_5":13232,"_26277":110259,"_2666":49291},[],{"_3170":65416,"_27782":65323,"_19244":110503,"_5":13232,"_26277":110259,"_2666":82124},[],{"_3170":65417,"_27782":65323,"_19244":110505,"_5":13232,"_26277":110259,"_2666":110431},[],{"_3170":65418,"_27782":65323,"_19244":110507,"_5":13232,"_26277":110259,"_2666":110508},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3170":65419,"_27782":65323,"_19244":110510,"_5":13232,"_26277":110259,"_2666":49301},[],{"_3170":65420,"_27782":65323,"_19244":110512,"_5":13232,"_26277":110259,"_2666":23022},[],{"_3170":65421,"_27782":65323,"_19244":110514,"_5":13232,"_26277":110259,"_2666":110431},[],{"_3170":65422,"_27782":65323,"_19244":110516,"_5":13232,"_26277":110259,"_2666":110517},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3170":65423,"_27782":65323,"_19244":110519,"_5":13232,"_26277":110259,"_2666":49311},[],{"_3170":65424,"_27782":65323,"_19244":110521,"_5":13232,"_26277":110259,"_2666":23022},[],{"_3170":65425,"_27782":65323,"_19244":110523,"_5":13232,"_26277":110259,"_2666":110431},[],{"_3170":65426,"_27782":65323,"_19244":110525,"_5":13232,"_26277":110259,"_2666":110526},[],"URL HTTP del Device Manager de Lamassu.",{"_3170":65427,"_27782":65323,"_19244":110528,"_5":13232,"_26277":110259,"_2666":49321},[],{"_3170":65428,"_27782":65323,"_19244":110530,"_5":13232,"_26277":110259,"_2666":23022},[],{"_3170":65429,"_27782":65323,"_19244":110532,"_5":13232,"_26277":110259,"_2666":110431},[],{"_3170":65430,"_27782":65323,"_19244":110534,"_5":13232,"_26277":110259,"_2666":110535},[],"URL HTTP del servicio de CA de Lamassu.",{"_3170":65431,"_27782":65323,"_19244":110537,"_5":13232,"_26277":110263,"_2666":110538},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3170":65432,"_27782":65323,"_19244":110540,"_5":13232,"_26277":110267,"_2666":110541},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3170":65433,"_27782":65323,"_19244":110543,"_5":13232,"_26277":110267,"_2666":110544},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3170":65434,"_27782":65323,"_19244":110546,"_5":13232,"_26277":110271,"_2666":110547},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3170":65435,"_27782":65323,"_19244":110549,"_5":13232,"_26277":110271,"_2666":110550},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3170":65436,"_27782":65323,"_19244":110552,"_5":13232,"_26277":110271,"_2666":110553},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3170":65437,"_27782":65323,"_19244":110555,"_5":13232,"_26277":110271,"_2666":110556},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3170":65438,"_27782":65323,"_19244":110558,"_5":13232,"_26277":110271,"_2666":110559},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3170":65439,"_27782":65323,"_19244":110561,"_5":13232,"_26277":110271,"_2666":110562},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3170":65440,"_27782":65323,"_19244":110564,"_5":13232,"_26277":110274,"_2666":110565},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3170":65441,"_27782":65323,"_19244":110567,"_5":13232,"_26277":110277,"_2666":110568},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3170":65442,"_27782":65323,"_19244":110570,"_5":13232,"_26277":110277,"_2666":110571},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3170":65443,"_27782":65323,"_19244":110573,"_5":13232,"_26277":110281,"_2666":110574},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3170":65444,"_27782":65323,"_19244":110576,"_5":13232,"_26277":110285,"_2666":110577},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3170":65445,"_27782":65323,"_19244":110579,"_5":13232,"_26277":110285,"_2666":110580},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3170":65446,"_27782":65323,"_19244":110582,"_5":13232,"_26277":110285,"_2666":110583},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3170":65447,"_27782":65323,"_19244":110585,"_5":13232,"_26277":110285,"_2666":110586},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3170":65448,"_27782":65323,"_19244":110588,"_5":13232,"_26277":110285,"_2666":110589},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3170":65449,"_27782":65323,"_19244":110591,"_5":13232,"_26277":110285,"_2666":110592},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3170":65450,"_27782":65323,"_19244":110594,"_5":13232,"_26277":110289,"_2666":110595},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. Esta plantilla se crea o actualiza en el momento en que el DMS se crea o actualiza en Lamassu - no en el momento del enrolamiento del dispositivo. A partir de ese momento, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3170":65451,"_27782":65323,"_19244":110597,"_5":13232,"_26277":110289,"_2666":110598},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3170":65452,"_27782":65323,"_19244":110600,"_5":13232,"_26277":110289,"_2666":110601},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3170":65453,"_27782":65323,"_19244":110603,"_5":13232,"_26277":110293,"_2666":110604},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3170":65454,"_27782":65323,"_19244":110606,"_5":13232,"_26277":110293,"_2666":110607},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3170":65455,"_27782":65323,"_19244":110609,"_5":13232,"_26277":110293,"_2666":110610},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3170":65456,"_27782":65323,"_19244":110612,"_5":13232,"_26277":110297,"_2666":110613},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3170":65457,"_27782":65323,"_19244":110615,"_5":13232,"_26277":110297,"_2666":110616},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3170":65458,"_27782":65323,"_19244":110618,"_5":13232,"_26277":110297,"_2666":110619},[],"Para que el flujo JITP funcione correctamente:",{"_3170":65459,"_27782":65323,"_19244":110621,"_5":13232,"_26277":110297,"_2666":110622},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3170":65460,"_27782":65323,"_19244":110624,"_5":13232,"_26277":110297,"_2666":110625},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3170":65461,"_27782":65323,"_19244":110627,"_5":13232,"_26277":110297,"_2666":110628},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3170":65462,"_27782":65323,"_19244":110630,"_5":13232,"_26277":110297,"_2666":110631},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3170":65463,"_27782":65323,"_19244":110633,"_5":13232,"_26277":110301,"_2666":110634},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3170":65464,"_27782":65323,"_19244":110636,"_5":13232,"_26277":110301,"_2666":110637},[],"Estado en Lamassu",{"_3170":65465,"_27782":65323,"_19244":110639,"_5":13232,"_26277":110301,"_2666":110640},[],"Razón de revocación",{"_3170":65466,"_27782":65323,"_19244":110642,"_5":13232,"_26277":110301,"_2666":110643},[],"Estado en AWS IoT Core",{"_3170":65467,"_27782":65323,"_19244":110645,"_5":13232,"_26277":110301,"_2666":49442},[],{"_3170":65468,"_27782":65323,"_19244":110647,"_5":13232,"_26277":110301,"_2666":110648},[],"Ninguna",{"_3170":65469,"_27782":65323,"_19244":110650,"_5":13232,"_26277":110301,"_2666":49448},[],{"_3170":65470,"_27782":65323,"_19244":110652,"_5":13232,"_26277":110301,"_2666":49451},[],{"_3170":65471,"_27782":65323,"_19244":110654,"_5":13232,"_26277":110301,"_2666":49454},[],{"_3170":65472,"_27782":65323,"_19244":110656,"_5":13232,"_26277":110301,"_2666":49457},[],{"_3170":65473,"_27782":65323,"_19244":110658,"_5":13232,"_26277":110301,"_2666":49451},[],{"_3170":65474,"_27782":65323,"_19244":110660,"_5":13232,"_26277":110301,"_2666":110661},[],"Cualquier otra razón",{"_3170":65475,"_27782":65323,"_19244":110663,"_5":13232,"_26277":110301,"_2666":49465},[],{"_3170":65476,"_27782":65323,"_19244":110665,"_5":13232,"_26277":110301,"_2666":110666},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3170":65477,"_27782":65323,"_19244":110668,"_5":13232,"_26277":110305,"_2666":110669},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3170":65478,"_27782":65323,"_19244":110671,"_5":13232,"_26277":110305,"_2666":110672},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3170":65479,"_27782":65323,"_19244":110674,"_5":13232,"_26277":110305,"_2666":110675},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3170":65480,"_27782":65323,"_19244":110677,"_5":13232,"_26277":110309,"_2666":110678},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3170":65481,"_27782":65323,"_19244":110680,"_5":13232,"_26277":110309,"_2666":110681},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3170":65482,"_27782":65323,"_19244":110683,"_5":13232,"_26277":110313,"_2666":110684},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3170":65483,"_27782":65323,"_19244":110686,"_5":13232,"_26277":110313,"_2666":110687},[],"Existen dos tipos de acciones:",{"_3170":65484,"_27782":65323,"_19244":110689,"_5":13232,"_26277":110313,"_2666":110690},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3170":65485,"_27782":65323,"_19244":110692,"_5":13232,"_26277":110313,"_2666":110693},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3170":65486,"_27782":65323,"_19244":110695,"_5":13232,"_26277":110313,"_2666":110696},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3170":65487,"_27782":65323,"_19244":110698,"_5":13232,"_26277":110317,"_2666":110699},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3170":65488,"_27782":65323,"_19244":110701,"_5":13232,"_26277":110317,"_2666":110702},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3170":65489,"_27782":65323,"_19244":110704,"_5":13232,"_26277":110317,"_2666":110705},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3170":65490,"_27782":65323,"_19244":110707,"_5":13232,"_26277":110321,"_2666":110708},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3170":65491,"_27782":65323,"_19244":110710,"_5":13232,"_26277":110321,"_2666":110711},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3170":65492,"_27782":65323,"_19244":110713,"_5":13232,"_26277":110321,"_2666":110714},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3170":65493,"_27782":65323,"_19244":110716,"_5":13232,"_26277":110321,"_2666":110717},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3170":65494,"_27782":65323,"_19244":110719,"_5":13232,"_26277":110321,"_2666":110720},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3170":65495,"_27782":65323,"_19244":110722,"_5":13232,"_26277":110321,"_2666":110723},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3170":65496,"_27782":65323,"_19244":110725,"_5":13232,"_26277":110321,"_2666":110726},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3170":65497,"_27782":65323,"_19244":110728,"_5":13232,"_26277":110321,"_2666":110729},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3170":65498,"_27782":65323,"_19244":110731,"_5":13232,"_26277":110321,"_2666":110732},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3170":65499,"_27782":65323,"_19244":110734,"_5":13232,"_26277":110321,"_2666":110735},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3170":65500,"_27782":65323,"_19244":110737,"_5":13232,"_26277":110321,"_2666":110738},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3170":65501,"_27782":65323,"_19244":110740,"_5":13232,"_26277":110321,"_2666":110741},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3170":65502,"_27782":65323,"_19244":110743,"_5":13232,"_26277":110321,"_2666":110744},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3170":65503,"_27782":65323,"_19244":110746,"_5":13232,"_26277":110321,"_2666":110747},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3170":65504,"_27782":65323,"_19244":110749,"_5":13232,"_26277":110321,"_2666":110750},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3170":65505,"_27782":65323,"_19244":110752,"_5":13232,"_26277":110321,"_2666":110753},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3170":65506,"_27782":65323,"_19244":110755,"_5":13232,"_26277":110321,"_2666":110756},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3170":65507,"_27782":65323,"_19244":110758,"_5":13232,"_26277":110321,"_2666":110759},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3170":65508,"_27782":65323,"_19244":110761,"_5":13232,"_26277":110321,"_2666":110762},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3170":65509,"_27782":65323,"_19244":110764,"_5":13232,"_26277":110321,"_2666":110765},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3170":65510,"_27782":65323,"_19244":110767,"_5":13232,"_26277":110321,"_2666":110768},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3170":65511,"_27782":65511,"_5":13558,"_2666":47551,"_28124":110770,"_19244":110771,"_26277":65511},[45194,107863,47551],[],{"_3170":65512,"_27782":65511,"_19244":110773,"_5":13232,"_26277":65511,"_2666":110774},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3170":65513,"_27782":65511,"_5":28121,"_19244":110776,"_26277":110777,"_2666":110778},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3170":65514,"_27782":65511,"_5":28121,"_19244":110780,"_26277":110781,"_2666":108838},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3170":65515,"_27782":65511,"_5":28121,"_19244":110783,"_26277":110784,"_2666":109013},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3170":65516,"_27782":65511,"_5":28121,"_19244":110786,"_26277":110787,"_2666":110240},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/overview#integraciones",{"_3170":65517,"_27782":65511,"_5":28121,"_19244":110789,"_26277":110790,"_2666":110791},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3170":65518,"_27782":65511,"_19244":110793,"_5":13232,"_26277":65511,"_2666":110794},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3170":65519,"_27782":65511,"_19244":110796,"_5":13232,"_26277":110777,"_2666":110797},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3170":65520,"_27782":65511,"_19244":110799,"_5":13232,"_26277":110777,"_2666":110800},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3170":65521,"_27782":65511,"_19244":110802,"_5":13232,"_26277":110781,"_2666":110803},[],"Recurso",{"_3170":65522,"_27782":65511,"_19244":110805,"_5":13232,"_26277":110781,"_2666":110806},[],"Qué representa",{"_3170":65523,"_27782":65511,"_19244":110808,"_5":13232,"_26277":110781,"_2666":110809},[],"**Dispositivo**",{"_3170":65524,"_27782":65511,"_19244":110811,"_5":13232,"_26277":110781,"_2666":110812},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3170":65525,"_27782":65511,"_19244":110814,"_5":13232,"_26277":110781,"_2666":110815},[],"**Identidad**",{"_3170":65526,"_27782":65511,"_19244":110817,"_5":13232,"_26277":110781,"_2666":110818},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3170":65527,"_27782":65511,"_19244":110820,"_5":13232,"_26277":110781,"_2666":49623},[],{"_3170":65528,"_27782":65511,"_19244":110822,"_5":13232,"_26277":110781,"_2666":110823},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3170":65529,"_27782":65511,"_19244":110825,"_5":13232,"_26277":110781,"_2666":110826},[],"**Flota**",{"_3170":65530,"_27782":65511,"_19244":110828,"_5":13232,"_26277":110781,"_2666":110829},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3170":65531,"_27782":65511,"_19244":110831,"_5":13232,"_26277":110781,"_2666":110832},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3170":65532,"_27782":65511,"_19244":110834,"_5":13232,"_26277":110781,"_2666":110835},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3170":65533,"_27782":65511,"_19244":110837,"_5":13232,"_26277":110784,"_2666":110838},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3170":65534,"_27782":65511,"_19244":110840,"_5":13232,"_26277":110784,"_2666":110841},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3170":65535,"_27782":65511,"_19244":110843,"_5":13232,"_26277":110784,"_2666":110844},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3170":65536,"_27782":65511,"_19244":110846,"_5":13232,"_26277":110784,"_2666":110847},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3170":65537,"_27782":65511,"_19244":110849,"_5":13232,"_26277":110784,"_2666":110850},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3170":65538,"_27782":65511,"_19244":110852,"_5":13232,"_26277":110784,"_2666":110853},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3170":65539,"_27782":65511,"_19244":110855,"_5":13232,"_26277":110784,"_2666":110856},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3170":65540,"_27782":65511,"_19244":110858,"_5":13232,"_26277":110784,"_2666":110859},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3170":65541,"_27782":65511,"_19244":110861,"_5":13232,"_26277":110787,"_2666":110862},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3170":65542,"_27782":65511,"_19244":110864,"_5":13232,"_26277":110787,"_2666":110865},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3170":65543,"_27782":65511,"_19244":110867,"_5":13232,"_26277":110790,"_2666":110868},[],"Participante",{"_3170":65544,"_27782":65511,"_19244":110870,"_5":13232,"_26277":110790,"_2666":110871},[],"Responsabilidad",{"_3170":65545,"_27782":65511,"_19244":110873,"_5":13232,"_26277":110790,"_2666":110874},[],"Administrador PKI",{"_3170":65546,"_27782":65511,"_19244":110876,"_5":13232,"_26277":110790,"_2666":110877},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3170":65547,"_27782":65511,"_19244":110879,"_5":13232,"_26277":110790,"_2666":110880},[],"Administrador del aprovisionamiento",{"_3170":65548,"_27782":65511,"_19244":110882,"_5":13232,"_26277":110790,"_2666":110883},[],"DMS, admisión, autenticación por operación e inventario.",{"_3170":65549,"_27782":65511,"_19244":110885,"_5":13232,"_26277":110790,"_2666":110886},[],"Integrador del dispositivo",{"_3170":65550,"_27782":65511,"_19244":110888,"_5":13232,"_26277":110790,"_2666":110889},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3170":65551,"_27782":65511,"_19244":110891,"_5":13232,"_26277":110790,"_2666":110892},[],"Integrador del consumidor",{"_3170":65552,"_27782":65511,"_19244":110894,"_5":13232,"_26277":110790,"_2666":110895},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3170":65553,"_27782":65511,"_19244":110897,"_5":13232,"_26277":110790,"_2666":110898},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3170":65554,"_27782":65554,"_5":13558,"_2666":110900,"_28124":110901,"_19244":110903,"_26277":65554},"Enrola y conecta tu primer dispositivo",[45194,107863,47551,110902],"Primeros pasos",[],{"_3170":65555,"_27782":65554,"_19244":110905,"_5":13232,"_26277":65554,"_2666":110906},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3170":65556,"_27782":65554,"_5":28121,"_19244":110908,"_26277":110909,"_2666":106529},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3170":65557,"_27782":65554,"_5":28121,"_19244":110911,"_26277":110912,"_2666":110913},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3170":65558,"_27782":65554,"_5":28121,"_19244":110915,"_26277":110916,"_2666":110917},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3170":65559,"_27782":65554,"_5":28121,"_19244":110919,"_26277":110920,"_2666":110921},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3170":65560,"_27782":65554,"_5":28121,"_19244":110923,"_26277":110924,"_2666":110925},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3170":65561,"_27782":65554,"_5":28121,"_19244":110927,"_26277":110928,"_2666":110929},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3170":65562,"_27782":65554,"_5":28121,"_19244":110931,"_26277":110932,"_2666":110933},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3170":65563,"_27782":65554,"_5":28121,"_19244":110935,"_26277":110936,"_2666":110937},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3170":65564,"_27782":65554,"_19244":110939,"_5":13232,"_26277":65554,"_2666":110940},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3170":65565,"_27782":65554,"_19244":110942,"_5":13232,"_26277":110909,"_2666":110943},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3170":65566,"_27782":65554,"_19244":110945,"_5":13232,"_26277":110909,"_2666":110946},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3170":65567,"_27782":65554,"_19244":110948,"_5":13232,"_26277":110909,"_2666":110949},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3170":65568,"_27782":65554,"_19244":110951,"_5":13232,"_26277":110909,"_2666":110952},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3170":65569,"_27782":65554,"_19244":110954,"_5":13232,"_26277":110909,"_2666":110955},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3170":65570,"_27782":65554,"_19244":110957,"_5":13232,"_26277":110912,"_2666":110958},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3170":65571,"_27782":65554,"_19244":110960,"_5":13232,"_26277":110912,"_2666":110961},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3170":65572,"_27782":65554,"_19244":110963,"_5":13232,"_26277":110916,"_2666":110964},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3170":65573,"_27782":65554,"_19244":110966,"_5":13232,"_26277":110916,"_2666":110967},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3170":65574,"_27782":65554,"_19244":110969,"_5":13232,"_26277":110916,"_2666":110970},[],"Ajuste",{"_3170":65575,"_27782":65554,"_19244":110972,"_5":13232,"_26277":110916,"_2666":110973},[],"Valor de evaluación",{"_3170":65576,"_27782":65554,"_19244":110975,"_5":13232,"_26277":110916,"_2666":49779},[],{"_3170":65577,"_27782":65554,"_19244":110977,"_5":13232,"_26277":110916,"_2666":110978},[],"Raíz emisora de `device-root.pem`.",{"_3170":65578,"_27782":65554,"_19244":110980,"_5":13232,"_26277":110916,"_2666":109141},[],{"_3170":65579,"_27782":65554,"_19244":110982,"_5":13232,"_26277":110916,"_2666":110983},[],"Perfil final de 1 hora que acabas de preparar.",{"_3170":65580,"_27782":65554,"_19244":110985,"_5":13232,"_26277":110916,"_2666":49790},[],{"_3170":65581,"_27782":65554,"_19244":110987,"_5":13232,"_26277":110916,"_2666":49793},[],{"_3170":65582,"_27782":65554,"_19244":110989,"_5":13232,"_26277":110916,"_2666":49796},[],{"_3170":65583,"_27782":65554,"_19244":110991,"_5":13232,"_26277":110916,"_2666":110992},[],"Habilitado.",{"_3170":65584,"_27782":65554,"_19244":110994,"_5":13232,"_26277":110916,"_2666":49802},[],{"_3170":65585,"_27782":65554,"_19244":110996,"_5":13232,"_26277":110916,"_2666":110997},[],"Deshabilitado; el ID debe ser nuevo.",{"_3170":65586,"_27782":65554,"_19244":110999,"_5":13232,"_26277":110916,"_2666":111000},[],"Autenticación inicial",{"_3170":65587,"_27782":65554,"_19244":111002,"_5":13232,"_26277":110916,"_2666":111003},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3170":65588,"_27782":65554,"_19244":111005,"_5":13232,"_26277":110916,"_2666":111006},[],"Autenticación de renovación",{"_3170":65589,"_27782":65554,"_19244":111008,"_5":13232,"_26277":110916,"_2666":111009},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3170":65590,"_27782":65554,"_19244":111011,"_5":13232,"_26277":110916,"_2666":49820},[],{"_3170":65591,"_27782":65554,"_19244":111013,"_5":13232,"_26277":110916,"_2666":111014},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_3170":65592,"_27782":65554,"_19244":111016,"_5":13232,"_26277":110916,"_2666":49826},[],{"_3170":65593,"_27782":65554,"_19244":111018,"_5":13232,"_26277":110916,"_2666":111019},[],"1 hora.",{"_3170":65594,"_27782":65554,"_19244":111021,"_5":13232,"_26277":110916,"_2666":49832},[],{"_3170":65595,"_27782":65554,"_19244":111023,"_5":13232,"_26277":110916,"_2666":111024},[],"30 minutos / 10 minutos.",{"_3170":65596,"_27782":65554,"_19244":111026,"_5":13232,"_26277":110916,"_2666":49838},[],{"_3170":65597,"_27782":65554,"_19244":111028,"_5":13232,"_26277":110916,"_2666":111029},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3170":65598,"_27782":65554,"_19244":111031,"_5":13232,"_26277":110916,"_2666":47870},[],{"_3170":65599,"_27782":65554,"_19244":111033,"_5":13232,"_26277":110916,"_2666":111034},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3170":65600,"_27782":65554,"_19244":111036,"_5":13232,"_26277":110916,"_2666":49849},[],{"_3170":65601,"_27782":65554,"_19244":111038,"_5":13232,"_26277":110916,"_2666":111039},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3170":65602,"_27782":65554,"_19244":111041,"_5":13232,"_26277":110916,"_2666":111042},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. Si tu consola no expone el bloque independiente, configura y comprueba el recurso mediante la API DMS y la guía DMS.",{"_3170":65603,"_27782":65554,"_19244":111044,"_5":13232,"_26277":110920,"_2666":111045},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3170":65604,"_27782":65554,"_19244":111047,"_5":13232,"_26277":110920,"_2666":111048},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3170":65605,"_27782":65554,"_19244":111050,"_5":13232,"_26277":110924,"_2666":111051},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3170":65606,"_27782":65554,"_19244":111053,"_5":13232,"_26277":110924,"_2666":111054},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3170":65607,"_27782":65554,"_19244":111056,"_5":13232,"_26277":110924,"_2666":111057},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3170":65608,"_27782":65554,"_19244":111059,"_5":13232,"_26277":110928,"_2666":111060},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3170":65609,"_27782":65554,"_19244":111062,"_5":13232,"_26277":110928,"_2666":111063},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3170":65610,"_27782":65554,"_19244":111065,"_5":13232,"_26277":110932,"_2666":111066},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3170":65611,"_27782":65554,"_19244":111068,"_5":13232,"_26277":110932,"_2666":111069},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3170":65612,"_27782":65554,"_19244":111071,"_5":13232,"_26277":110932,"_2666":111072},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3170":65613,"_27782":65554,"_19244":111074,"_5":13232,"_26277":110932,"_2666":111075},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3170":65614,"_27782":65554,"_19244":111077,"_5":13232,"_26277":110932,"_2666":111078},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3170":65615,"_27782":65554,"_19244":111080,"_5":13232,"_26277":110936,"_2666":111081},[],"Comprobación",{"_3170":65616,"_27782":65554,"_19244":111083,"_5":13232,"_26277":110936,"_2666":111084},[],"Resultado esperado",{"_3170":65617,"_27782":65554,"_19244":111086,"_5":13232,"_26277":110936,"_2666":111087},[],"Registro",{"_3170":65618,"_27782":65554,"_19244":111089,"_5":13232,"_26277":110936,"_2666":111090},[],"ID creado automáticamente y DMS correcto.",{"_3170":65619,"_27782":65554,"_19244":111092,"_5":13232,"_26277":110936,"_2666":111093},[],"Certificado",{"_3170":65620,"_27782":65554,"_19244":111095,"_5":13232,"_26277":110936,"_2666":111096},[],"CN, perfil, serie y clave verificados.",{"_3170":65621,"_27782":65554,"_19244":111098,"_5":13232,"_26277":110936,"_2666":111099},[],"Inventario",{"_3170":65622,"_27782":65554,"_19244":111101,"_5":13232,"_26277":110936,"_2666":111102},[],"Serie recibida visible como identidad actual y en el historial.",{"_3170":65623,"_27782":65554,"_19244":111104,"_5":13232,"_26277":110936,"_2666":111105},[],"Consumidor",{"_3170":65624,"_27782":65554,"_19244":111107,"_5":13232,"_26277":110936,"_2666":111108},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3170":65625,"_27782":65554,"_19244":111110,"_5":13232,"_26277":110936,"_2666":111111},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3170":65626,"_27782":65554,"_19244":111113,"_5":13232,"_26277":110936,"_2666":111114},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3170":65627,"_27782":65627,"_5":13558,"_2666":108855,"_28124":111116,"_19244":111117,"_26277":65627},[45194,107863,47551,110902],[],{"_3170":65628,"_27782":65627,"_19244":111119,"_5":13232,"_26277":65627,"_2666":111120},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3170":65629,"_27782":65627,"_5":28121,"_19244":111122,"_26277":111123,"_2666":106529},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3170":65630,"_27782":65627,"_5":28121,"_19244":111125,"_26277":111126,"_2666":111127},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3170":65631,"_27782":65627,"_5":28121,"_19244":111129,"_26277":111130,"_2666":111131},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3170":65632,"_27782":65627,"_5":28121,"_19244":111133,"_26277":111134,"_2666":111135},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3170":65633,"_27782":65627,"_5":28121,"_19244":111137,"_26277":111138,"_2666":111139},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3170":65634,"_27782":65627,"_5":28121,"_19244":111141,"_26277":111142,"_2666":111143},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3170":65635,"_27782":65627,"_5":28121,"_19244":111145,"_26277":111146,"_2666":111084},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3170":65636,"_27782":65627,"_5":28121,"_19244":111148,"_26277":111149,"_2666":111150},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3170":65637,"_27782":65627,"_5":28121,"_19244":111152,"_26277":111153,"_2666":111154},[],"/docs/pr-preview/pr-52/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3170":65638,"_27782":65627,"_19244":111156,"_5":13232,"_26277":65627,"_2666":111157},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3170":65639,"_27782":65627,"_19244":111159,"_5":13232,"_26277":65627,"_2666":111160},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3170":65640,"_27782":65627,"_19244":111162,"_5":13232,"_26277":111123,"_2666":111163},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3170":65641,"_27782":65627,"_19244":111165,"_5":13232,"_26277":111123,"_2666":111166},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3170":65642,"_27782":65627,"_19244":111168,"_5":13232,"_26277":111123,"_2666":111169},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3170":65643,"_27782":65627,"_19244":111171,"_5":13232,"_26277":111123,"_2666":111172},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3170":65644,"_27782":65627,"_19244":111174,"_5":13232,"_26277":111126,"_2666":111175},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3170":65645,"_27782":65627,"_19244":111177,"_5":13232,"_26277":111126,"_2666":111178},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3170":65646,"_27782":65627,"_19244":111180,"_5":13232,"_26277":111126,"_2666":111181},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3170":65647,"_27782":65627,"_19244":111183,"_5":13232,"_26277":111126,"_2666":111184},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3170":65648,"_27782":65627,"_19244":111186,"_5":13232,"_26277":111126,"_2666":111187},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_3170":65649,"_27782":65627,"_19244":111189,"_5":13232,"_26277":111126,"_2666":111190},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3170":65650,"_27782":65627,"_19244":111192,"_5":13232,"_26277":111126,"_2666":111193},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3170":65651,"_27782":65627,"_19244":111195,"_5":13232,"_26277":111126,"_2666":111196},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3170":65652,"_27782":65627,"_19244":111198,"_5":13232,"_26277":111130,"_2666":111199},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3170":65653,"_27782":65627,"_19244":111201,"_5":13232,"_26277":111130,"_2666":50015},[],{"_3170":65654,"_27782":65627,"_19244":111203,"_5":13232,"_26277":111130,"_2666":111204},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3170":65655,"_27782":65627,"_19244":111206,"_5":13232,"_26277":111130,"_2666":111207},[],"**Icon** y **Tags**: clasificación opcional.",{"_3170":65656,"_27782":65627,"_19244":111209,"_5":13232,"_26277":111130,"_2666":111210},[],"Confirma el registro.",{"_3170":65657,"_27782":65627,"_19244":111212,"_5":13232,"_26277":111134,"_2666":111213},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3170":65658,"_27782":65627,"_19244":111215,"_5":13232,"_26277":111134,"_2666":111216},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3170":65659,"_27782":65627,"_19244":111218,"_5":13232,"_26277":111138,"_2666":111219},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3170":65660,"_27782":65627,"_19244":111221,"_5":13232,"_26277":111138,"_2666":111222},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3170":65661,"_27782":65627,"_19244":111224,"_5":13232,"_26277":111142,"_2666":111225},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3170":65662,"_27782":65627,"_19244":111227,"_5":13232,"_26277":111142,"_2666":111228},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3170":65663,"_27782":65627,"_19244":111230,"_5":13232,"_26277":111146,"_2666":111081},[],{"_3170":65664,"_27782":65627,"_19244":111232,"_5":13232,"_26277":111146,"_2666":111233},[],"Resultado",{"_3170":65665,"_27782":65627,"_19244":111235,"_5":13232,"_26277":111146,"_2666":111236},[],"Dispositivo",{"_3170":65666,"_27782":65627,"_19244":111238,"_5":13232,"_26277":111146,"_2666":111239},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3170":65667,"_27782":65627,"_19244":111241,"_5":13232,"_26277":111146,"_2666":111242},[],"Identidad actual",{"_3170":65668,"_27782":65627,"_19244":111244,"_5":13232,"_26277":111146,"_2666":111245},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3170":65669,"_27782":65627,"_19244":111247,"_5":13232,"_26277":111146,"_2666":111248},[],"Historial",{"_3170":65670,"_27782":65627,"_19244":111250,"_5":13232,"_26277":111146,"_2666":111251},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3170":65671,"_27782":65627,"_19244":111253,"_5":13232,"_26277":111146,"_2666":111254},[],"Clave y certificado",{"_3170":65672,"_27782":65627,"_19244":111256,"_5":13232,"_26277":111146,"_2666":111257},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3170":65673,"_27782":65627,"_19244":111259,"_5":13232,"_26277":111149,"_2666":111260},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3170":65674,"_27782":65627,"_19244":111262,"_5":13232,"_26277":111149,"_2666":111263},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3170":65675,"_27782":65627,"_19244":111265,"_5":13232,"_26277":111149,"_2666":111266},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3170":65676,"_27782":65627,"_19244":111268,"_5":13232,"_26277":111149,"_2666":111269},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3170":65677,"_27782":65627,"_19244":111271,"_5":13232,"_26277":111153,"_2666":111272},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3170":65678,"_27782":65627,"_19244":111274,"_5":13232,"_26277":111153,"_2666":111275},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3170":65679,"_27782":65627,"_19244":111277,"_5":13232,"_26277":111153,"_2666":111278},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3170":65680,"_27782":65680,"_5":13558,"_2666":111280,"_28124":111281,"_19244":111282,"_26277":65680},"Plataforma Lamassu IoT",[45194,107863],[],{"_3170":65681,"_27782":65680,"_19244":111284,"_5":13232,"_26277":65680,"_2666":111285},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3170":65682,"_27782":65680,"_5":28121,"_19244":111287,"_26277":111288,"_2666":110778},[],"/docs/pr-preview/pr-52/es/platform/overview#empieza-aquí",{"_3170":65683,"_27782":65680,"_5":28121,"_19244":111290,"_26277":111291,"_2666":111292},[],"/docs/pr-preview/pr-52/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3170":65684,"_27782":65680,"_5":28121,"_19244":111294,"_26277":111295,"_2666":111296},[],"/docs/pr-preview/pr-52/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3170":65685,"_27782":65680,"_5":28121,"_19244":111298,"_26277":111299,"_2666":111300},[],"/docs/pr-preview/pr-52/es/platform/overview#capacidades-principales","Capacidades principales",{"_3170":65686,"_27782":65680,"_5":28121,"_19244":111302,"_26277":111303,"_2666":111304},[],"/docs/pr-preview/pr-52/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3170":65687,"_27782":65680,"_5":28121,"_19244":111306,"_26277":111307,"_2666":111308},[],"/docs/pr-preview/pr-52/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3170":65688,"_27782":65680,"_5":28121,"_19244":111310,"_26277":111311,"_2666":111312},[],"/docs/pr-preview/pr-52/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3170":65689,"_27782":65680,"_5":28121,"_19244":111314,"_26277":111315,"_2666":111316},[],"/docs/pr-preview/pr-52/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3170":65690,"_27782":65680,"_5":28121,"_19244":111318,"_26277":111319,"_2666":111320},[],"/docs/pr-preview/pr-52/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3170":65691,"_27782":65680,"_5":28121,"_19244":111322,"_26277":111323,"_2666":111324},[],"/docs/pr-preview/pr-52/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3170":65692,"_27782":65680,"_5":28121,"_19244":111326,"_26277":111327,"_2666":111328},[],"/docs/pr-preview/pr-52/es/platform/overview#referencia-operativa","Referencia operativa",{"_3170":65693,"_27782":65680,"_19244":111330,"_5":13232,"_26277":65680,"_2666":111331},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3170":65694,"_27782":65680,"_19244":111333,"_5":13232,"_26277":111288,"_2666":111334},[],"Elige el resultado que necesitas obtener:",{"_3170":65695,"_27782":65680,"_19244":111336,"_5":13232,"_26277":111288,"_2666":111337},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3170":65696,"_27782":65680,"_19244":111339,"_5":13232,"_26277":111288,"_2666":111340},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3170":65697,"_27782":65680,"_19244":111342,"_5":13232,"_26277":111288,"_2666":111343},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3170":65698,"_27782":65680,"_19244":111345,"_5":13232,"_26277":111291,"_2666":111346},[],"Bloque",{"_3170":65699,"_27782":65680,"_19244":111348,"_5":13232,"_26277":111291,"_2666":111349},[],"Qué gestionas",{"_3170":65700,"_27782":65680,"_19244":111351,"_5":13232,"_26277":111291,"_2666":111352},[],"Punto de entrada",{"_3170":65701,"_27782":65680,"_19244":111354,"_5":13232,"_26277":111291,"_2666":50169},[],{"_3170":65702,"_27782":65680,"_19244":111356,"_5":13232,"_26277":111291,"_2666":111357},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3170":65703,"_27782":65680,"_19244":111359,"_5":13232,"_26277":111291,"_2666":111360},[],"Visión general de PKI",{"_3170":65704,"_27782":65680,"_19244":111362,"_5":13232,"_26277":111291,"_2666":50178},[],{"_3170":65705,"_27782":65680,"_19244":111364,"_5":13232,"_26277":111291,"_2666":111365},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3170":65706,"_27782":65680,"_19244":111367,"_5":13232,"_26277":111291,"_2666":111368},[],"Visión general de IoT Fleets",{"_3170":65707,"_27782":65680,"_19244":111370,"_5":13232,"_26277":111291,"_2666":111371},[],"**Administración**",{"_3170":65708,"_27782":65680,"_19244":111373,"_5":13232,"_26277":111291,"_2666":111374},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3170":65709,"_27782":65680,"_19244":111376,"_5":13232,"_26277":111291,"_2666":107861},[],{"_3170":65710,"_27782":65680,"_19244":111378,"_5":13232,"_26277":111291,"_2666":111379},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3170":65711,"_27782":65680,"_19244":111381,"_5":13232,"_26277":111295,"_2666":111382},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3170":65712,"_27782":65680,"_19244":111384,"_5":13232,"_26277":111295,"_2666":111385},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3170":65713,"_27782":65680,"_19244":111387,"_5":13232,"_26277":111295,"_2666":111388},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3170":65714,"_27782":65680,"_19244":111390,"_5":13232,"_26277":111295,"_2666":111391},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3170":65715,"_27782":65680,"_19244":111393,"_5":13232,"_26277":111295,"_2666":111394},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3170":65716,"_27782":65680,"_19244":111396,"_5":13232,"_26277":111295,"_2666":111397},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3170":65717,"_27782":65680,"_19244":111399,"_5":13232,"_26277":111303,"_2666":111400},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3170":65718,"_27782":65680,"_19244":111402,"_5":13232,"_26277":111307,"_2666":111403},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3170":65719,"_27782":65680,"_19244":111405,"_5":13232,"_26277":111311,"_2666":111406},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3170":65720,"_27782":65680,"_19244":111408,"_5":13232,"_26277":111315,"_2666":111409},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3170":65721,"_27782":65680,"_19244":111411,"_5":13232,"_26277":111319,"_2666":111412},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3170":65722,"_27782":65680,"_19244":111414,"_5":13232,"_26277":111323,"_2666":111415},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3170":65723,"_27782":65680,"_19244":111417,"_5":13232,"_26277":111327,"_2666":110871},[],{"_3170":65724,"_27782":65680,"_19244":111419,"_5":13232,"_26277":111327,"_2666":111420},[],"Qué prepara o comprueba",{"_3170":65725,"_27782":65680,"_19244":111422,"_5":13232,"_26277":111327,"_2666":110874},[],{"_3170":65726,"_27782":65680,"_19244":111424,"_5":13232,"_26277":111327,"_2666":111425},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3170":65727,"_27782":65680,"_19244":111427,"_5":13232,"_26277":111327,"_2666":111428},[],"Administrador de la flota",{"_3170":65728,"_27782":65680,"_19244":111430,"_5":13232,"_26277":111327,"_2666":111431},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3170":65729,"_27782":65680,"_19244":111433,"_5":13232,"_26277":111327,"_2666":110886},[],{"_3170":65730,"_27782":65680,"_19244":111435,"_5":13232,"_26277":111327,"_2666":111436},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3170":65731,"_27782":65680,"_19244":111438,"_5":13232,"_26277":111327,"_2666":110892},[],{"_3170":65732,"_27782":65680,"_19244":111440,"_5":13232,"_26277":111327,"_2666":111441},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3170":65733,"_27782":65680,"_19244":111443,"_5":13232,"_26277":111327,"_2666":111444},[],"Operador de infraestructura",{"_3170":65734,"_27782":65680,"_19244":111446,"_5":13232,"_26277":111327,"_2666":111447},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3170":65735,"_27782":65680,"_19244":111449,"_5":13232,"_26277":111327,"_2666":111450},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3170":65736,"_27782":65736,"_5":13558,"_2666":111452,"_28124":111453,"_19244":111455,"_26277":65736},"Jerarquía y rotación de CAs",[45194,107863,50270,111454],"Claves, autoridades y certificados",[],{"_3170":65737,"_27782":65736,"_19244":111457,"_5":13232,"_26277":65736,"_2666":111458},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3170":65738,"_27782":65736,"_5":28121,"_19244":111460,"_26277":111461,"_2666":111462},[],"/docs/pr-preview/pr-52/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3170":65739,"_27782":65736,"_5":28121,"_19244":111464,"_26277":111465,"_2666":111466},[],"/docs/pr-preview/pr-52/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3170":65740,"_27782":65736,"_5":28121,"_19244":111468,"_26277":111469,"_2666":111470},[],"/docs/pr-preview/pr-52/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3170":65741,"_27782":65736,"_5":28121,"_19244":111472,"_26277":111473,"_2666":111474},[],"/docs/pr-preview/pr-52/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3170":65742,"_27782":65736,"_5":28121,"_19244":111476,"_26277":111477,"_2666":111478},[],"/docs/pr-preview/pr-52/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3170":65743,"_27782":65736,"_5":28121,"_19244":111480,"_26277":111481,"_2666":111482},[],"/docs/pr-preview/pr-52/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3170":65744,"_27782":65736,"_5":28121,"_19244":111484,"_26277":111485,"_2666":111486},[],"/docs/pr-preview/pr-52/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3170":65745,"_27782":65736,"_5":28121,"_19244":111488,"_26277":111489,"_2666":111490},[],"/docs/pr-preview/pr-52/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3170":65746,"_27782":65736,"_5":28121,"_19244":111492,"_26277":111493,"_2666":111494},[],"/docs/pr-preview/pr-52/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3170":65747,"_27782":65736,"_5":28121,"_19244":111496,"_26277":111497,"_2666":111498},[],"/docs/pr-preview/pr-52/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3170":65748,"_27782":65736,"_5":28121,"_19244":111500,"_26277":111501,"_2666":111502},[],"/docs/pr-preview/pr-52/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3170":65749,"_27782":65736,"_5":28121,"_19244":111504,"_26277":111505,"_2666":111506},[],"/docs/pr-preview/pr-52/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3170":65750,"_27782":65736,"_19244":111508,"_5":13232,"_26277":65736,"_2666":111509},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3170":65751,"_27782":65736,"_19244":111511,"_5":13232,"_26277":65736,"_2666":111512},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3170":65752,"_27782":65736,"_19244":111514,"_5":13232,"_26277":111461,"_2666":111515},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3170":65753,"_27782":65736,"_19244":111517,"_5":13232,"_26277":111461,"_2666":111518},[],"entorno, como producción y preproducción;",{"_3170":65754,"_27782":65736,"_19244":111520,"_5":13232,"_26277":111461,"_2666":111521},[],"propietario o equipo operador;",{"_3170":65755,"_27782":65736,"_19244":111523,"_5":13232,"_26277":111461,"_2666":111524},[],"familia de dispositivos o proceso de fabricación;",{"_3170":65756,"_27782":65736,"_19244":111526,"_5":13232,"_26277":111461,"_2666":111527},[],"región o requisito regulatorio;",{"_3170":65757,"_27782":65736,"_19244":111529,"_5":13232,"_26277":111461,"_2666":111530},[],"motor criptográfico o política de clave;",{"_3170":65758,"_27782":65736,"_19244":111532,"_5":13232,"_26277":111461,"_2666":111533},[],"ventana de mantenimiento y ritmo de renovación.",{"_3170":65759,"_27782":65736,"_19244":111535,"_5":13232,"_26277":111461,"_2666":111536},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3170":65760,"_27782":65736,"_19244":111538,"_5":13232,"_26277":111461,"_2666":111539},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3170":65761,"_27782":65736,"_19244":111541,"_5":13232,"_26277":111465,"_2666":111542},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3170":65762,"_27782":65736,"_19244":111544,"_5":13232,"_26277":111465,"_2666":111545},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3170":65763,"_27782":65736,"_19244":111547,"_5":13232,"_26277":111465,"_2666":111548},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_3170":65764,"_27782":65736,"_19244":111550,"_5":13232,"_26277":111469,"_2666":111551},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3170":65765,"_27782":65736,"_19244":111553,"_5":13232,"_26277":111469,"_2666":111554},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3170":65766,"_27782":65736,"_19244":111556,"_5":13232,"_26277":111469,"_2666":111557},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3170":65767,"_27782":65736,"_19244":111559,"_5":13232,"_26277":111469,"_2666":111560},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3170":65768,"_27782":65736,"_19244":111562,"_5":13232,"_26277":111477,"_2666":111563},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3170":65769,"_27782":65736,"_19244":111565,"_5":13232,"_26277":111481,"_2666":111566},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3170":65770,"_27782":65736,"_19244":111568,"_5":13232,"_26277":111485,"_2666":111569},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3170":65771,"_27782":65736,"_19244":111571,"_5":13232,"_26277":111489,"_2666":111572},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_3170":65772,"_27782":65736,"_19244":111574,"_5":13232,"_26277":111493,"_2666":111575},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3170":65773,"_27782":65736,"_19244":111577,"_5":13232,"_26277":111497,"_2666":111578},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_3170":65774,"_27782":65736,"_19244":111580,"_5":13232,"_26277":111501,"_2666":111581},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3170":65775,"_27782":65736,"_19244":111583,"_5":13232,"_26277":111501,"_2666":111584},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3170":65776,"_27782":65736,"_19244":111586,"_5":13232,"_26277":111501,"_2666":111587},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_3170":65777,"_27782":65736,"_19244":111589,"_5":13232,"_26277":111501,"_2666":111590},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3170":65778,"_27782":65736,"_19244":111592,"_5":13232,"_26277":111505,"_2666":111593},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3170":65779,"_27782":65736,"_19244":111595,"_5":13232,"_26277":111505,"_2666":111596},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3170":65780,"_27782":65736,"_19244":111598,"_5":13232,"_26277":111505,"_2666":111599},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3170":65781,"_27782":65736,"_19244":111601,"_5":13232,"_26277":111505,"_2666":111602},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3170":65782,"_27782":65736,"_19244":111604,"_5":13232,"_26277":111505,"_2666":111605},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3170":65783,"_27782":65736,"_19244":111607,"_5":13232,"_26277":111505,"_2666":111608},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3170":65784,"_27782":65736,"_19244":111610,"_5":13232,"_26277":111505,"_2666":111611},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3170":65785,"_27782":65785,"_5":13558,"_2666":111613,"_28124":111614,"_19244":111615,"_26277":65785},"Autoridades de certificación",[45194,107863,50270,111454],[],{"_3170":65786,"_27782":65785,"_19244":111617,"_5":13232,"_26277":65785,"_2666":111618},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3170":65787,"_27782":65785,"_5":28121,"_19244":111620,"_26277":111621,"_2666":111622},[],"/docs/pr-preview/pr-52/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3170":65788,"_27782":65785,"_5":28121,"_19244":111624,"_26277":111625,"_2666":111626},[],"/docs/pr-preview/pr-52/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3170":65789,"_27782":65785,"_5":28121,"_19244":111628,"_26277":111629,"_2666":106529},[],"/docs/pr-preview/pr-52/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3170":65790,"_27782":65785,"_5":28121,"_19244":111631,"_26277":111632,"_2666":111633},[],"/docs/pr-preview/pr-52/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3170":65791,"_27782":65785,"_5":28121,"_19244":111635,"_26277":111636,"_2666":111637},[],"/docs/pr-preview/pr-52/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3170":65792,"_27782":65785,"_5":28121,"_19244":111639,"_26277":111640,"_2666":111641},[],"/docs/pr-preview/pr-52/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3170":65793,"_27782":65785,"_5":28121,"_19244":111643,"_26277":111644,"_2666":111645},[],"/docs/pr-preview/pr-52/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3170":65794,"_27782":65785,"_5":28121,"_19244":111647,"_26277":111648,"_2666":111649},[],"/docs/pr-preview/pr-52/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3170":65795,"_27782":65785,"_5":28121,"_19244":111651,"_26277":111652,"_2666":111653},[],"/docs/pr-preview/pr-52/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3170":65796,"_27782":65785,"_5":28121,"_19244":111655,"_26277":111656,"_2666":111657},[],"/docs/pr-preview/pr-52/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3170":65797,"_27782":65785,"_5":28121,"_19244":111659,"_26277":111660,"_2666":111661},[],"/docs/pr-preview/pr-52/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3170":65798,"_27782":65785,"_5":28121,"_19244":111663,"_26277":111664,"_2666":111665},[],"/docs/pr-preview/pr-52/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3170":65799,"_27782":65785,"_5":28121,"_19244":111667,"_26277":111668,"_2666":111669},[],"/docs/pr-preview/pr-52/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3170":65800,"_27782":65785,"_5":28121,"_19244":111671,"_26277":111672,"_2666":111673},[],"/docs/pr-preview/pr-52/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3170":65801,"_27782":65785,"_5":28121,"_19244":111675,"_26277":111676,"_2666":111677},[],"/docs/pr-preview/pr-52/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3170":65802,"_27782":65785,"_5":28121,"_19244":111679,"_26277":111680,"_2666":111681},[],"/docs/pr-preview/pr-52/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3170":65803,"_27782":65785,"_5":28121,"_19244":111683,"_26277":111684,"_2666":111685},[],"/docs/pr-preview/pr-52/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3170":65804,"_27782":65785,"_5":28121,"_19244":111687,"_26277":111688,"_2666":111689},[],"/docs/pr-preview/pr-52/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3170":65805,"_27782":65785,"_5":28121,"_19244":111691,"_26277":111692,"_2666":111693},[],"/docs/pr-preview/pr-52/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3170":65806,"_27782":65785,"_5":28121,"_19244":111695,"_26277":111696,"_2666":111697},[],"/docs/pr-preview/pr-52/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3170":65807,"_27782":65785,"_5":28121,"_19244":111699,"_26277":111700,"_2666":111701},[],"/docs/pr-preview/pr-52/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3170":65808,"_27782":65785,"_5":28121,"_19244":111703,"_26277":111704,"_2666":111705},[],"/docs/pr-preview/pr-52/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3170":65809,"_27782":65785,"_19244":111707,"_5":13232,"_26277":65785,"_2666":111708},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3170":65810,"_27782":65785,"_19244":111710,"_5":13232,"_26277":65785,"_2666":111711},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3170":65811,"_27782":65785,"_19244":111713,"_5":13232,"_26277":65785,"_2666":111714},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3170":65812,"_27782":65785,"_19244":111716,"_5":13232,"_26277":111621,"_2666":111717},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3170":65813,"_27782":65785,"_19244":111719,"_5":13232,"_26277":111621,"_2666":111720},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3170":65814,"_27782":65785,"_19244":111722,"_5":13232,"_26277":111621,"_2666":111723},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3170":65815,"_27782":65785,"_19244":111725,"_5":13232,"_26277":111621,"_2666":111726},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3170":65816,"_27782":65785,"_19244":111728,"_5":13232,"_26277":111621,"_2666":111729},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3170":65817,"_27782":65785,"_19244":111731,"_5":13232,"_26277":111629,"_2666":111732},[],"Decide si la CA será raíz o intermedia.",{"_3170":65818,"_27782":65785,"_19244":111734,"_5":13232,"_26277":111629,"_2666":111735},[],"Elige el motor que custodiará la clave.",{"_3170":65819,"_27782":65785,"_19244":111737,"_5":13232,"_26277":111629,"_2666":111738},[],"Define una validez superior a la de los certificados que emitirá.",{"_3170":65820,"_27782":65785,"_19244":111740,"_5":13232,"_26277":111629,"_2666":111741},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3170":65821,"_27782":65785,"_19244":111743,"_5":13232,"_26277":111632,"_2666":111744},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3170":65822,"_27782":65785,"_19244":111746,"_5":13232,"_26277":111636,"_2666":111747},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3170":65823,"_27782":65785,"_19244":111749,"_5":13232,"_26277":111636,"_2666":111750},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3170":65824,"_27782":65785,"_19244":111752,"_5":13232,"_26277":111640,"_2666":111753},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3170":65825,"_27782":65785,"_19244":111755,"_5":13232,"_26277":111644,"_2666":111756},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3170":65826,"_27782":65785,"_19244":111758,"_5":13232,"_26277":111644,"_2666":111759},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3170":65827,"_27782":65785,"_19244":111761,"_5":13232,"_26277":111644,"_2666":111762},[],"`ST`: estado o provincia.",{"_3170":65828,"_27782":65785,"_19244":111764,"_5":13232,"_26277":111644,"_2666":111765},[],"`L`: localidad.",{"_3170":65829,"_27782":65785,"_19244":111767,"_5":13232,"_26277":111644,"_2666":111768},[],"`O`: organización.",{"_3170":65830,"_27782":65785,"_19244":111770,"_5":13232,"_26277":111644,"_2666":111771},[],"`OU`: unidad organizativa.",{"_3170":65831,"_27782":65785,"_19244":111773,"_5":13232,"_26277":111644,"_2666":111774},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3170":65832,"_27782":65785,"_19244":111776,"_5":13232,"_26277":111648,"_2666":111777},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3170":65833,"_27782":65785,"_19244":111779,"_5":13232,"_26277":111648,"_2666":111780},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3170":65834,"_27782":65785,"_19244":111782,"_5":13232,"_26277":111652,"_2666":111783},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3170":65835,"_27782":65785,"_19244":111785,"_5":13232,"_26277":111652,"_2666":111786},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3170":65836,"_27782":65785,"_19244":111788,"_5":13232,"_26277":111656,"_2666":111789},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3170":65837,"_27782":65785,"_19244":111791,"_5":13232,"_26277":111656,"_2666":111792},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3170":65838,"_27782":65785,"_19244":111794,"_5":13232,"_26277":111660,"_2666":111795},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3170":65839,"_27782":65785,"_19244":111797,"_5":13232,"_26277":111660,"_2666":111798},[],"El backend rechaza una importación cuyo certificado carece de la restricción básica de CA (`basicConstraints cA flag is not set`), cuyo número de serie colisiona con un certificado existente distinto, o que es una CA duplicada idéntica. El registro de certificado de una CA eliminada se conserva y se reutiliza al importarla de nuevo, incluido su estado anterior. Eliminar una CA libera su clave, que el KMS conserva mientras otros certificados la sigan referenciando.",{"_3170":65840,"_27782":65785,"_19244":111800,"_5":13232,"_26277":111664,"_2666":111801},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3170":65841,"_27782":65785,"_19244":111803,"_5":13232,"_26277":111668,"_2666":111804},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3170":65842,"_27782":65785,"_19244":111806,"_5":13232,"_26277":111672,"_2666":111807},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3170":65843,"_27782":65785,"_19244":111809,"_5":13232,"_26277":111676,"_2666":111810},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3170":65844,"_27782":65785,"_19244":111812,"_5":13232,"_26277":111676,"_2666":111813},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3170":65845,"_27782":65785,"_19244":111815,"_5":13232,"_26277":111680,"_2666":111816},[],"Abre una CA desde el inventario para consultar:",{"_3170":65846,"_27782":65785,"_19244":111818,"_5":13232,"_26277":111680,"_2666":111819},[],"Estado y periodo de validez.",{"_3170":65847,"_27782":65785,"_19244":111821,"_5":13232,"_26277":111680,"_2666":111822},[],"Certificado y cadena en formato PEM.",{"_3170":65848,"_27782":65785,"_19244":111824,"_5":13232,"_26277":111680,"_2666":111825},[],"Número de certificados activos, expirados y revocados.",{"_3170":65849,"_27782":65785,"_19244":111827,"_5":13232,"_26277":111680,"_2666":111828},[],"Certificados emitidos en **Issued Certificates**.",{"_3170":65850,"_27782":65785,"_19244":111830,"_5":13232,"_26277":111680,"_2666":111831},[],"CRL vinculada a la autoridad.",{"_3170":65851,"_27782":65785,"_19244":111833,"_5":13232,"_26277":111680,"_2666":111834},[],"Metadatos y motor criptográfico asociado.",{"_3170":65852,"_27782":65785,"_19244":111836,"_5":13232,"_26277":111680,"_2666":111837},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3170":65853,"_27782":65785,"_19244":111839,"_5":13232,"_26277":111684,"_2666":111840},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3170":65854,"_27782":65785,"_19244":111842,"_5":13232,"_26277":111684,"_2666":111843},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3170":65855,"_27782":65785,"_19244":111845,"_5":13232,"_26277":111684,"_2666":111846},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3170":65856,"_27782":65785,"_19244":111848,"_5":13232,"_26277":111684,"_2666":111849},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3170":65857,"_27782":65785,"_19244":111851,"_5":13232,"_26277":111688,"_2666":111852},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_3170":65858,"_27782":65785,"_19244":111854,"_5":13232,"_26277":111692,"_2666":111855},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3170":65859,"_27782":65785,"_19244":111857,"_5":13232,"_26277":111696,"_2666":111858},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3170":65860,"_27782":65785,"_19244":111860,"_5":13232,"_26277":111700,"_2666":111861},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3170":65861,"_27782":65785,"_19244":111863,"_5":13232,"_26277":111704,"_2666":111864},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3170":65862,"_27782":65785,"_19244":111866,"_5":13232,"_26277":111704,"_2666":111867},[],"La eliminación permanente solo está disponible después de revocar. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3170":65863,"_27782":65863,"_5":13558,"_2666":111869,"_28124":111870,"_19244":111871,"_26277":65863},"Perfiles de certificado",[45194,107863,50270,111454],[],{"_3170":65864,"_27782":65863,"_19244":111873,"_5":13232,"_26277":65863,"_2666":111874},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3170":65865,"_27782":65863,"_5":28121,"_19244":111876,"_26277":111877,"_2666":111878},[],"/docs/pr-preview/pr-52/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3170":65866,"_27782":65863,"_5":28121,"_19244":111880,"_26277":111881,"_2666":111882},[],"/docs/pr-preview/pr-52/es/platform/pki/certificate-profiles#validez","Validez",{"_3170":65867,"_27782":65863,"_5":28121,"_19244":111884,"_26277":111885,"_2666":111886},[],"/docs/pr-preview/pr-52/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3170":65868,"_27782":65863,"_5":28121,"_19244":111888,"_26277":111889,"_2666":111890},[],"/docs/pr-preview/pr-52/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3170":65869,"_27782":65863,"_5":28121,"_19244":111892,"_26277":111893,"_2666":111894},[],"/docs/pr-preview/pr-52/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3170":65870,"_27782":65863,"_5":28121,"_19244":111896,"_26277":111897,"_2666":111898},[],"/docs/pr-preview/pr-52/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3170":65871,"_27782":65863,"_5":28121,"_19244":111900,"_26277":111901,"_2666":111902},[],"/docs/pr-preview/pr-52/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3170":65872,"_27782":65863,"_5":28121,"_19244":111904,"_26277":111905,"_2666":111906},[],"/docs/pr-preview/pr-52/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3170":65873,"_27782":65863,"_5":28121,"_19244":111908,"_26277":111909,"_2666":111910},[],"/docs/pr-preview/pr-52/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3170":65874,"_27782":65863,"_5":28121,"_19244":111912,"_26277":111913,"_2666":111914},[],"/docs/pr-preview/pr-52/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3170":65875,"_27782":65863,"_5":28121,"_19244":111916,"_26277":111917,"_2666":111918},[],"/docs/pr-preview/pr-52/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3170":65876,"_27782":65863,"_5":28121,"_19244":111920,"_26277":111921,"_2666":111922},[],"/docs/pr-preview/pr-52/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3170":65877,"_27782":65863,"_5":28121,"_19244":111924,"_26277":111925,"_2666":111926},[],"/docs/pr-preview/pr-52/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3170":65878,"_27782":65863,"_5":28121,"_19244":111928,"_26277":111929,"_2666":111930},[],"/docs/pr-preview/pr-52/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3170":65879,"_27782":65863,"_5":28121,"_19244":111932,"_26277":111933,"_2666":111934},[],"/docs/pr-preview/pr-52/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3170":65880,"_27782":65863,"_5":28121,"_19244":111936,"_26277":111937,"_2666":111938},[],"/docs/pr-preview/pr-52/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3170":65881,"_27782":65863,"_19244":111940,"_5":13232,"_26277":65863,"_2666":111941},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3170":65882,"_27782":65863,"_19244":111943,"_5":13232,"_26277":65863,"_2666":111944},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3170":65883,"_27782":65863,"_19244":111946,"_5":13232,"_26277":111881,"_2666":111947},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3170":65884,"_27782":65863,"_19244":111949,"_5":13232,"_26277":111881,"_2666":111950},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3170":65885,"_27782":65863,"_19244":111952,"_5":13232,"_26277":111885,"_2666":111953},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Actívalo solo en perfiles destinados a crear o reemitir CAs subordinadas.",{"_3170":65886,"_27782":65863,"_19244":111955,"_5":13232,"_26277":111889,"_2666":111956},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3170":65887,"_27782":65863,"_19244":111958,"_5":13232,"_26277":111889,"_2666":111959},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3170":65888,"_27782":65863,"_19244":111961,"_5":13232,"_26277":111889,"_2666":111962},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3170":65889,"_27782":65863,"_19244":111964,"_5":13232,"_26277":111893,"_2666":111965},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3170":65890,"_27782":65863,"_19244":111967,"_5":13232,"_26277":111897,"_2666":111968},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3170":65891,"_27782":65863,"_19244":111970,"_5":13232,"_26277":111897,"_2666":111971},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3170":65892,"_27782":65863,"_19244":111973,"_5":13232,"_26277":111901,"_2666":111974},[],"La aplicación criptográfica puede:",{"_3170":65893,"_27782":65863,"_19244":111976,"_5":13232,"_26277":111901,"_2666":111977},[],"permitir o bloquear claves RSA;",{"_3170":65894,"_27782":65863,"_19244":111979,"_5":13232,"_26277":111901,"_2666":111980},[],"limitar los tamaños RSA admitidos;",{"_3170":65895,"_27782":65863,"_19244":111982,"_5":13232,"_26277":111901,"_2666":111983},[],"permitir o bloquear claves ECDSA;",{"_3170":65896,"_27782":65863,"_19244":111985,"_5":13232,"_26277":111901,"_2666":111986},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3170":65897,"_27782":65863,"_19244":111988,"_5":13232,"_26277":111901,"_2666":111989},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3170":65898,"_27782":65863,"_19244":111991,"_5":13232,"_26277":111905,"_2666":111992},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3170":65899,"_27782":65863,"_19244":111994,"_5":13232,"_26277":111905,"_2666":107654},[],{"_3170":65900,"_27782":65863,"_19244":111996,"_5":13232,"_26277":111905,"_2666":111997},[],"Primera opción",{"_3170":65901,"_27782":65863,"_19244":111999,"_5":13232,"_26277":111905,"_2666":112000},[],"Segunda opción",{"_3170":65902,"_27782":65863,"_19244":112002,"_5":13232,"_26277":111905,"_2666":112003},[],"Si no hay ninguna",{"_3170":65903,"_27782":65863,"_19244":112005,"_5":13232,"_26277":111905,"_2666":112006},[],"Firma directa con una CA",{"_3170":65904,"_27782":65863,"_19244":112008,"_5":13232,"_26277":111905,"_2666":112009},[],"`issuance_profile` incluido en la solicitud",{"_3170":65905,"_27782":65863,"_19244":112011,"_5":13232,"_26277":111905,"_2666":112012},[],"`issuance_profile_id` de la solicitud",{"_3170":65906,"_27782":65863,"_19244":112014,"_5":13232,"_26277":111905,"_2666":112015},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3170":65907,"_27782":65863,"_19244":112017,"_5":13232,"_26277":111905,"_2666":112018},[],"Emisión mediante DMS",{"_3170":65908,"_27782":65863,"_19244":112020,"_5":13232,"_26277":111905,"_2666":50838},[],{"_3170":65909,"_27782":65863,"_19244":112022,"_5":13232,"_26277":111905,"_2666":112023},[],"`settings.issuance_profile` incluido en el DMS",{"_3170":65910,"_27782":65863,"_19244":112025,"_5":13232,"_26277":111905,"_2666":112026},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3170":65911,"_27782":65863,"_19244":112028,"_5":13232,"_26277":111905,"_2666":112029},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3170":65912,"_27782":65863,"_19244":112031,"_5":13232,"_26277":111905,"_2666":112032},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3170":65913,"_27782":65863,"_19244":112034,"_5":13232,"_26277":111913,"_2666":112035},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3170":65914,"_27782":65863,"_19244":112037,"_5":13232,"_26277":111917,"_2666":112038},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3170":65915,"_27782":65863,"_19244":112040,"_5":13232,"_26277":111921,"_2666":112041},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3170":65916,"_27782":65863,"_19244":112043,"_5":13232,"_26277":111925,"_2666":112044},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3170":65917,"_27782":65863,"_19244":112046,"_5":13232,"_26277":111929,"_2666":112047},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3170":65918,"_27782":65863,"_19244":112049,"_5":13232,"_26277":111929,"_2666":112050},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3170":65919,"_27782":65863,"_19244":112052,"_5":13232,"_26277":111933,"_2666":112053},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3170":65920,"_27782":65863,"_19244":112055,"_5":13232,"_26277":111933,"_2666":112056},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3170":65921,"_27782":65863,"_19244":112058,"_5":13232,"_26277":111933,"_2666":112059},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3170":65922,"_27782":65863,"_19244":112061,"_5":13232,"_26277":111933,"_2666":112062},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3170":65923,"_27782":65863,"_19244":112064,"_5":13232,"_26277":111937,"_2666":112065},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3170":65924,"_27782":65863,"_19244":112067,"_5":13232,"_26277":111937,"_2666":112068},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3170":65925,"_27782":65925,"_5":13558,"_2666":112070,"_28124":112071,"_19244":112073,"_26277":65925},"Validación de certificados",[45194,107863,50270,112072],"Validación",[],{"_3170":65926,"_27782":65925,"_19244":112075,"_5":13232,"_26277":65925,"_2666":112076},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3170":65927,"_27782":65925,"_5":28121,"_19244":112078,"_26277":112079,"_2666":112080},[],"/docs/pr-preview/pr-52/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3170":65928,"_27782":65925,"_5":28121,"_19244":112082,"_26277":112083,"_2666":112084},[],"/docs/pr-preview/pr-52/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3170":65929,"_27782":65925,"_5":28121,"_19244":112086,"_26277":112087,"_2666":112088},[],"/docs/pr-preview/pr-52/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3170":65930,"_27782":65925,"_19244":112090,"_5":13232,"_26277":65925,"_2666":112091},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3170":65931,"_27782":65925,"_19244":112093,"_5":13232,"_26277":112079,"_2666":112094},[],"Verifica estos criterios juntos:",{"_3170":65932,"_27782":65925,"_19244":112096,"_5":13232,"_26277":112079,"_2666":111081},[],{"_3170":65933,"_27782":65925,"_19244":112098,"_5":13232,"_26277":112079,"_2666":112099},[],"Resultado necesario",{"_3170":65934,"_27782":65925,"_19244":112101,"_5":13232,"_26277":112079,"_2666":112102},[],"Cadena y firma",{"_3170":65935,"_27782":65925,"_19244":112104,"_5":13232,"_26277":112079,"_2666":112105},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3170":65936,"_27782":65925,"_19244":112107,"_5":13232,"_26277":112079,"_2666":112108},[],"Fechas",{"_3170":65937,"_27782":65925,"_19244":112110,"_5":13232,"_26277":112079,"_2666":112111},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3170":65938,"_27782":65925,"_19244":112113,"_5":13232,"_26277":112079,"_2666":107564},[],{"_3170":65939,"_27782":65925,"_19244":112115,"_5":13232,"_26277":112079,"_2666":112116},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3170":65940,"_27782":65925,"_19244":112118,"_5":13232,"_26277":112079,"_2666":112119},[],"Uso",{"_3170":65941,"_27782":65925,"_19244":112121,"_5":13232,"_26277":112079,"_2666":112122},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3170":65942,"_27782":65925,"_19244":112124,"_5":13232,"_26277":112079,"_2666":112125},[],"Revocación",{"_3170":65943,"_27782":65925,"_19244":112127,"_5":13232,"_26277":112079,"_2666":112128},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3170":65944,"_27782":65925,"_19244":112130,"_5":13232,"_26277":112079,"_2666":112131},[],"Autorización",{"_3170":65945,"_27782":65925,"_19244":112133,"_5":13232,"_26277":112079,"_2666":112134},[],"La aplicación permite la acción a esa identidad.",{"_3170":65946,"_27782":65925,"_19244":112136,"_5":13232,"_26277":112079,"_2666":112137},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3170":65947,"_27782":65925,"_19244":112139,"_5":13232,"_26277":112083,"_2666":112140},[],"Mecanismo",{"_3170":65948,"_27782":65925,"_19244":112142,"_5":13232,"_26277":112083,"_2666":112143},[],"Cuándo utilizarlo",{"_3170":65949,"_27782":65925,"_19244":112145,"_5":13232,"_26277":112083,"_2666":112146},[],"Qué debes mantener",{"_3170":65950,"_27782":65925,"_19244":112148,"_5":13232,"_26277":112083,"_2666":50966},[],{"_3170":65951,"_27782":65925,"_19244":112150,"_5":13232,"_26277":112083,"_2666":112151},[],"Consulta del estado de un certificado concreto.",{"_3170":65952,"_27782":65925,"_19244":112153,"_5":13232,"_26277":112083,"_2666":112154},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3170":65953,"_27782":65925,"_19244":112156,"_5":13232,"_26277":112083,"_2666":50975},[],{"_3170":65954,"_27782":65925,"_19244":112158,"_5":13232,"_26277":112083,"_2666":112159},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3170":65955,"_27782":65925,"_19244":112161,"_5":13232,"_26277":112083,"_2666":112162},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3170":65956,"_27782":65925,"_19244":112164,"_5":13232,"_26277":112083,"_2666":112165},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3170":65957,"_27782":65925,"_19244":112167,"_5":13232,"_26277":112083,"_2666":112168},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3170":65958,"_27782":65925,"_19244":112170,"_5":13232,"_26277":112087,"_2666":112171},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3170":65959,"_27782":65925,"_19244":112173,"_5":13232,"_26277":112087,"_2666":112174},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3170":65960,"_27782":65925,"_19244":112176,"_5":13232,"_26277":112087,"_2666":112177},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3170":65961,"_27782":65925,"_19244":112179,"_5":13232,"_26277":112087,"_2666":112180},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3170":65962,"_27782":65925,"_19244":112182,"_5":13232,"_26277":112087,"_2666":112183},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3170":65963,"_27782":65925,"_19244":112185,"_5":13232,"_26277":112087,"_2666":112186},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3170":65964,"_27782":65925,"_19244":112188,"_5":13232,"_26277":112087,"_2666":112189},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3170":65965,"_27782":65925,"_19244":112191,"_5":13232,"_26277":112087,"_2666":112192},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3170":65966,"_27782":65925,"_19244":112194,"_5":13232,"_26277":112087,"_2666":112195},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3170":65967,"_27782":65967,"_5":13558,"_2666":112197,"_28124":112198,"_19244":112199,"_26277":65967},"Certificados",[45194,107863,50270,111454],[],{"_3170":65968,"_27782":65967,"_19244":112201,"_5":13232,"_26277":65967,"_2666":112202},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3170":65969,"_27782":65967,"_5":28121,"_19244":112204,"_26277":112205,"_2666":112206},[],"/docs/pr-preview/pr-52/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3170":65970,"_27782":65967,"_5":28121,"_19244":112208,"_26277":112209,"_2666":112210},[],"/docs/pr-preview/pr-52/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3170":65971,"_27782":65967,"_5":28121,"_19244":112212,"_26277":112213,"_2666":112214},[],"/docs/pr-preview/pr-52/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3170":65972,"_27782":65967,"_5":28121,"_19244":112216,"_26277":112217,"_2666":112218},[],"/docs/pr-preview/pr-52/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3170":65973,"_27782":65967,"_5":28121,"_19244":112220,"_26277":112221,"_2666":112222},[],"/docs/pr-preview/pr-52/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3170":65974,"_27782":65967,"_5":28121,"_19244":112224,"_26277":112225,"_2666":112226},[],"/docs/pr-preview/pr-52/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3170":65975,"_27782":65967,"_5":28121,"_19244":112228,"_26277":112229,"_2666":112230},[],"/docs/pr-preview/pr-52/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3170":65976,"_27782":65967,"_5":28121,"_19244":112232,"_26277":112233,"_2666":112234},[],"/docs/pr-preview/pr-52/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3170":65977,"_27782":65967,"_5":28121,"_19244":112236,"_26277":112237,"_2666":112238},[],"/docs/pr-preview/pr-52/es/platform/pki/certificates#continúa","Continúa",{"_3170":65978,"_27782":65967,"_19244":112240,"_5":13232,"_26277":65967,"_2666":112241},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3170":65979,"_27782":65967,"_19244":112243,"_5":13232,"_26277":112205,"_2666":112244},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos. Los detalles del certificado incluyen la referencia a la clave (`key_id`) y si la clave privada está gestionada (`has_private_key`), y las listas de certificados pueden filtrarse por `has_private_key`.",{"_3170":65980,"_27782":65967,"_19244":112246,"_5":13232,"_26277":112205,"_2666":112247},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3170":65981,"_27782":65967,"_19244":112249,"_5":13232,"_26277":112209,"_2666":112250},[],"Descarga el PEM e inspecciónalo:",{"_3170":65982,"_27782":65967,"_19244":112252,"_5":13232,"_26277":112209,"_2666":112253},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3170":65983,"_27782":65967,"_19244":112255,"_5":13232,"_26277":112213,"_2666":112256},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3170":65984,"_27782":65967,"_19244":112258,"_5":13232,"_26277":112213,"_2666":112259},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3170":65985,"_27782":65967,"_19244":112261,"_5":13232,"_26277":112213,"_2666":112262},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3170":65986,"_27782":65967,"_19244":112264,"_5":13232,"_26277":112213,"_2666":112265},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3170":65987,"_27782":65967,"_19244":112267,"_5":13232,"_26277":112213,"_2666":112268},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3170":65988,"_27782":65967,"_19244":112270,"_5":13232,"_26277":112213,"_2666":112271},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3170":65989,"_27782":65967,"_19244":112273,"_5":13232,"_26277":112213,"_2666":112274},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3170":65990,"_27782":65967,"_19244":112276,"_5":13232,"_26277":112217,"_2666":112277},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3170":65991,"_27782":65967,"_19244":112279,"_5":13232,"_26277":112221,"_2666":112280},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3170":65992,"_27782":65967,"_19244":112282,"_5":13232,"_26277":112225,"_2666":112283},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3170":65993,"_27782":65967,"_19244":112285,"_5":13232,"_26277":112229,"_2666":112286},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3170":65994,"_27782":65967,"_19244":112288,"_5":13232,"_26277":112229,"_2666":112289},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3170":65995,"_27782":65967,"_19244":112291,"_5":13232,"_26277":112229,"_2666":112292},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3170":65996,"_27782":65967,"_19244":112294,"_5":13232,"_26277":112233,"_2666":112295},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3170":65997,"_27782":65967,"_19244":112297,"_5":13232,"_26277":112233,"_2666":112298},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3170":65998,"_27782":65967,"_19244":112300,"_5":13232,"_26277":112233,"_2666":112301},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_3170":65999,"_27782":65967,"_19244":112303,"_5":13232,"_26277":112237,"_2666":112304},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3170":66000,"_27782":65967,"_19244":112306,"_5":13232,"_26277":112237,"_2666":112307},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3170":66001,"_27782":66001,"_5":13558,"_2666":112309,"_28124":112310,"_19244":112312,"_26277":66001},"Ciclo de vida de un certificado",[45194,107863,50270,112311],"Conceptos",[],{"_3170":66002,"_27782":66001,"_19244":112314,"_5":13232,"_26277":66001,"_2666":112315},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3170":66003,"_27782":66001,"_5":28121,"_19244":112317,"_26277":112318,"_2666":112319},[],"/docs/pr-preview/pr-52/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3170":66004,"_27782":66001,"_5":28121,"_19244":112321,"_26277":112322,"_2666":112323},[],"/docs/pr-preview/pr-52/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3170":66005,"_27782":66001,"_5":28121,"_19244":112325,"_26277":112326,"_2666":112327},[],"/docs/pr-preview/pr-52/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3170":66006,"_27782":66001,"_5":28121,"_19244":112329,"_26277":112330,"_2666":112331},[],"/docs/pr-preview/pr-52/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3170":66007,"_27782":66001,"_5":28121,"_19244":112333,"_26277":112334,"_2666":112335},[],"/docs/pr-preview/pr-52/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3170":66008,"_27782":66001,"_5":28121,"_19244":112337,"_26277":112338,"_2666":112339},[],"/docs/pr-preview/pr-52/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3170":66009,"_27782":66001,"_5":28121,"_19244":112341,"_26277":112342,"_2666":112343},[],"/docs/pr-preview/pr-52/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado","Estados del certificado",{"_3170":66010,"_27782":66001,"_5":28121,"_19244":112345,"_26277":112346,"_2666":112347},[],"/docs/pr-preview/pr-52/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3170":66011,"_27782":66001,"_5":28121,"_19244":112349,"_26277":112350,"_2666":112351},[],"/docs/pr-preview/pr-52/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3170":66012,"_27782":66001,"_5":28121,"_19244":112353,"_26277":112354,"_2666":112355},[],"/docs/pr-preview/pr-52/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3170":66013,"_27782":66001,"_19244":112357,"_5":13232,"_26277":66001,"_2666":112358},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3170":66014,"_27782":66001,"_19244":112360,"_5":13232,"_26277":112322,"_2666":112361},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3170":66015,"_27782":66001,"_19244":112363,"_5":13232,"_26277":112326,"_2666":112364},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3170":66016,"_27782":66001,"_19244":112366,"_5":13232,"_26277":112330,"_2666":112367},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3170":66017,"_27782":66001,"_19244":112369,"_5":13232,"_26277":112334,"_2666":112370},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3170":66018,"_27782":66001,"_19244":112372,"_5":13232,"_26277":112338,"_2666":112373},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3170":66019,"_27782":66001,"_19244":112375,"_5":13232,"_26277":112342,"_2666":112376},[],"Lamassu persiste cuatro estados X.509:",{"_3170":66020,"_27782":66001,"_19244":112378,"_5":13232,"_26277":112342,"_2666":112379},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3170":66021,"_27782":66001,"_19244":112381,"_5":13232,"_26277":112342,"_2666":112382},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3170":66022,"_27782":66001,"_19244":112384,"_5":13232,"_26277":112342,"_2666":112385},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3170":66023,"_27782":66001,"_19244":112387,"_5":13232,"_26277":112342,"_2666":112388},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3170":66024,"_27782":66001,"_19244":112390,"_5":13232,"_26277":112342,"_2666":112391},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3170":66025,"_27782":66001,"_19244":112393,"_5":13232,"_26277":112346,"_2666":112394},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3170":66026,"_27782":66001,"_19244":112396,"_5":13232,"_26277":112346,"_2666":112397},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3170":66027,"_27782":66001,"_19244":112399,"_5":13232,"_26277":112346,"_2666":112400},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3170":66028,"_27782":66001,"_19244":112402,"_5":13232,"_26277":112350,"_2666":112403},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3170":66029,"_27782":66001,"_19244":112405,"_5":13232,"_26277":112350,"_2666":112406},[],"Antes de confirmar:",{"_3170":66030,"_27782":66001,"_19244":112408,"_5":13232,"_26277":112350,"_2666":112409},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3170":66031,"_27782":66001,"_19244":112411,"_5":13232,"_26277":112350,"_2666":112412},[],"Distribuye la nueva cadena de confianza.",{"_3170":66032,"_27782":66001,"_19244":112414,"_5":13232,"_26277":112350,"_2666":112415},[],"Reemite las identidades necesarias.",{"_3170":66033,"_27782":66001,"_19244":112417,"_5":13232,"_26277":112350,"_2666":112418},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3170":66034,"_27782":66001,"_19244":112420,"_5":13232,"_26277":112350,"_2666":112421},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3170":66035,"_27782":66001,"_19244":112423,"_5":13232,"_26277":112350,"_2666":112424},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3170":66036,"_27782":66001,"_19244":112426,"_5":13232,"_26277":112354,"_2666":112427},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3170":66037,"_27782":66001,"_19244":112429,"_5":13232,"_26277":112354,"_2666":112430},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3170":66038,"_27782":66001,"_19244":112432,"_5":13232,"_26277":112354,"_2666":112433},[],"Cambios de estado y razones de revocación.",{"_3170":66039,"_27782":66001,"_19244":112435,"_5":13232,"_26277":112354,"_2666":112436},[],"Publicación y vigencia de OCSP y CRLs.",{"_3170":66040,"_27782":66001,"_19244":112438,"_5":13232,"_26277":112354,"_2666":112439},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3170":66041,"_27782":66001,"_19244":112441,"_5":13232,"_26277":112354,"_2666":112442},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3170":66042,"_27782":66042,"_5":13558,"_2666":112444,"_28124":112445,"_19244":112446,"_26277":66042},"Modelo de confianza",[45194,107863,50270,112311],[],{"_3170":66043,"_27782":66042,"_19244":112448,"_5":13232,"_26277":66042,"_2666":112449},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3170":66044,"_27782":66042,"_5":28121,"_19244":112451,"_26277":112452,"_2666":112453},[],"/docs/pr-preview/pr-52/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3170":66045,"_27782":66042,"_5":28121,"_19244":112455,"_26277":112456,"_2666":112457},[],"/docs/pr-preview/pr-52/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3170":66046,"_27782":66042,"_5":28121,"_19244":112459,"_26277":112460,"_2666":112461},[],"/docs/pr-preview/pr-52/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3170":66047,"_27782":66042,"_5":28121,"_19244":112463,"_26277":112464,"_2666":112465},[],"/docs/pr-preview/pr-52/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3170":66048,"_27782":66042,"_5":28121,"_19244":112467,"_26277":112468,"_2666":112469},[],"/docs/pr-preview/pr-52/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3170":66049,"_27782":66042,"_5":28121,"_19244":112471,"_26277":112472,"_2666":112473},[],"/docs/pr-preview/pr-52/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3170":66050,"_27782":66042,"_5":28121,"_19244":112475,"_26277":112476,"_2666":112477},[],"/docs/pr-preview/pr-52/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3170":66051,"_27782":66042,"_5":28121,"_19244":112479,"_26277":112480,"_2666":112481},[],"/docs/pr-preview/pr-52/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3170":66052,"_27782":66042,"_5":28121,"_19244":112483,"_26277":112484,"_2666":112485},[],"/docs/pr-preview/pr-52/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3170":66053,"_27782":66042,"_5":28121,"_19244":112487,"_26277":112488,"_2666":112489},[],"/docs/pr-preview/pr-52/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3170":66054,"_27782":66042,"_19244":112491,"_5":13232,"_26277":66042,"_2666":112492},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3170":66055,"_27782":66042,"_19244":112494,"_5":13232,"_26277":112456,"_2666":112495},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3170":66056,"_27782":66042,"_19244":112497,"_5":13232,"_26277":112460,"_2666":112498},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3170":66057,"_27782":66042,"_19244":112500,"_5":13232,"_26277":112464,"_2666":112501},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3170":66058,"_27782":66042,"_19244":112503,"_5":13232,"_26277":112468,"_2666":112504},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3170":66059,"_27782":66042,"_19244":112506,"_5":13232,"_26277":112472,"_2666":112507},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3170":66060,"_27782":66042,"_19244":112509,"_5":13232,"_26277":112472,"_2666":112510},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3170":66061,"_27782":66042,"_19244":112512,"_5":13232,"_26277":112472,"_2666":112513},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3170":66062,"_27782":66042,"_19244":112515,"_5":13232,"_26277":112472,"_2666":112516},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3170":66063,"_27782":66042,"_19244":112518,"_5":13232,"_26277":112472,"_2666":112519},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3170":66064,"_27782":66042,"_19244":112521,"_5":13232,"_26277":112472,"_2666":112522},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3170":66065,"_27782":66042,"_19244":112524,"_5":13232,"_26277":112476,"_2666":112525},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3170":66066,"_27782":66042,"_19244":112527,"_5":13232,"_26277":112476,"_2666":112528},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3170":66067,"_27782":66042,"_19244":112530,"_5":13232,"_26277":112476,"_2666":112531},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_3170":66068,"_27782":66042,"_19244":112533,"_5":13232,"_26277":112476,"_2666":112534},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3170":66069,"_27782":66042,"_19244":112536,"_5":13232,"_26277":112476,"_2666":112537},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3170":66070,"_27782":66042,"_19244":112539,"_5":13232,"_26277":112480,"_2666":112540},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3170":66071,"_27782":66042,"_19244":112542,"_5":13232,"_26277":112480,"_2666":112543},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3170":66072,"_27782":66042,"_19244":112545,"_5":13232,"_26277":112480,"_2666":112546},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3170":66073,"_27782":66042,"_19244":112548,"_5":13232,"_26277":112480,"_2666":112549},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3170":66074,"_27782":66042,"_19244":112551,"_5":13232,"_26277":112480,"_2666":112552},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3170":66075,"_27782":66042,"_19244":112554,"_5":13232,"_26277":112480,"_2666":112555},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3170":66076,"_27782":66042,"_19244":112557,"_5":13232,"_26277":112480,"_2666":112558},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_3170":66077,"_27782":66042,"_19244":112560,"_5":13232,"_26277":112484,"_2666":112561},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3170":66078,"_27782":66042,"_19244":112563,"_5":13232,"_26277":112488,"_2666":112564},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3170":66079,"_27782":66042,"_19244":112566,"_5":13232,"_26277":112488,"_2666":112567},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3170":66080,"_27782":66042,"_19244":112569,"_5":13232,"_26277":112488,"_2666":112570},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3170":66081,"_27782":66042,"_19244":112572,"_5":13232,"_26277":112488,"_2666":112573},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3170":66082,"_27782":66042,"_19244":112575,"_5":13232,"_26277":112488,"_2666":112576},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3170":66083,"_27782":66042,"_19244":112578,"_5":13232,"_26277":112488,"_2666":112579},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3170":66084,"_27782":66042,"_19244":112581,"_5":13232,"_26277":112488,"_2666":112582},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3170":66085,"_27782":66085,"_5":13558,"_2666":112584,"_28124":112585,"_19244":112586,"_26277":66085},"Listas de revocación (CRL)",[45194,107863,50270,112072],[],{"_3170":66086,"_27782":66085,"_19244":112588,"_5":13232,"_26277":66085,"_2666":112589},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3170":66087,"_27782":66085,"_5":28121,"_19244":112591,"_26277":112592,"_2666":112593},[],"/docs/pr-preview/pr-52/es/platform/pki/crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_3170":66088,"_27782":66085,"_5":28121,"_19244":112595,"_26277":112596,"_2666":112597},[],"/docs/pr-preview/pr-52/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3170":66089,"_27782":66085,"_5":28121,"_19244":112599,"_26277":112600,"_2666":112601},[],"/docs/pr-preview/pr-52/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3170":66090,"_27782":66085,"_5":28121,"_19244":112603,"_26277":112604,"_2666":112605},[],"/docs/pr-preview/pr-52/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3170":66091,"_27782":66085,"_5":28121,"_19244":112607,"_26277":112608,"_2666":112609},[],"/docs/pr-preview/pr-52/es/platform/pki/crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_3170":66092,"_27782":66085,"_5":28121,"_19244":112611,"_26277":112612,"_2666":112613},[],"/docs/pr-preview/pr-52/es/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_3170":66093,"_27782":66085,"_5":28121,"_19244":112615,"_26277":112616,"_2666":112617},[],"/docs/pr-preview/pr-52/es/platform/pki/crl#referencias","Referencias",{"_3170":66094,"_27782":66085,"_19244":112619,"_5":13232,"_26277":66085,"_2666":112620},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su SKI y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3170":66095,"_27782":66085,"_19244":112622,"_5":13232,"_26277":112592,"_2666":112623},[],"El rol VA guarda la configuración y los metadatos de la última lista publicada para el SKI de una CA. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3170":66096,"_27782":66085,"_19244":112625,"_5":13232,"_26277":112592,"_2666":112626},[],"Campo de `crl_options`",{"_3170":66097,"_27782":66085,"_19244":112628,"_5":13232,"_26277":112592,"_2666":109362},[],{"_3170":66098,"_27782":66085,"_19244":112630,"_5":13232,"_26277":112592,"_2666":112631},[],"Valor inicial del backend",{"_3170":66099,"_27782":66085,"_19244":112633,"_5":13232,"_26277":112592,"_2666":51453},[],{"_3170":66100,"_27782":66085,"_19244":112635,"_5":13232,"_26277":112592,"_2666":112636},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3170":66101,"_27782":66085,"_19244":112638,"_5":13232,"_26277":112592,"_2666":112639},[],"7 días.",{"_3170":66102,"_27782":66085,"_19244":112641,"_5":13232,"_26277":112592,"_2666":51462},[],{"_3170":66103,"_27782":66085,"_19244":112643,"_5":13232,"_26277":112592,"_2666":112644},[],"Plazo desde la publicación que activa la renovación programada.",{"_3170":66104,"_27782":66085,"_19244":112646,"_5":13232,"_26277":112592,"_2666":112647},[],"6 días y 23 horas.",{"_3170":66105,"_27782":66085,"_19244":112649,"_5":13232,"_26277":112592,"_2666":51471},[],{"_3170":66106,"_27782":66085,"_19244":112651,"_5":13232,"_26277":112592,"_2666":112652},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3170":66107,"_27782":66085,"_19244":112654,"_5":13232,"_26277":112592,"_2666":51477},[],{"_3170":66108,"_27782":66085,"_19244":112656,"_5":13232,"_26277":112592,"_2666":51480},[],{"_3170":66109,"_27782":66085,"_19244":112658,"_5":13232,"_26277":112592,"_2666":112659},[],"Número de serie del certificado existente que firma la CRL.",{"_3170":66110,"_27782":66085,"_19244":112661,"_5":13232,"_26277":112592,"_2666":112662},[],"Número de serie del certificado actual de la CA.",{"_3170":66111,"_27782":66085,"_19244":112664,"_5":13232,"_26277":112592,"_2666":112665},[],"El firmante debe ser un certificado existente con el uso de clave `cRLSign`, cuyo sujeto y clave pública coincidan con la CA del rol. Los certificados reemitidos que comparten la clave de la CA son firmantes válidos; los firmantes no relacionados se rechazan. El certificado referenciado como firmante no puede eliminarse mientras el rol lo use.",{"_3170":66112,"_27782":66085,"_19244":112667,"_5":13232,"_26277":112592,"_2666":112668},[],"Las CA que comparten clave comparten un rol VA y una CRL.",{"_3170":66113,"_27782":66085,"_19244":112670,"_5":13232,"_26277":112592,"_2666":112671},[],"`latest_crl` contiene versión, inicio y fin de validez. Las versiones se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/{subject_key_id}/{version}.crl`; el endpoint público entrega DER.",{"_3170":66114,"_27782":66085,"_19244":112673,"_5":13232,"_26277":112596,"_2666":112674},[],"El trabajo programado solicita otra lista cuando se alcanza `refresh_interval` o cuando la lista está próxima a vencer según el periodo de vigilancia configurado. Esto depende de que el trabajo, almacenamiento y firma funcionen; no garantiza renovación ante un fallo del servicio.",{"_3170":66115,"_27782":66085,"_19244":112676,"_5":13232,"_26277":112596,"_2666":112677},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3170":66116,"_27782":66085,"_19244":112679,"_5":13232,"_26277":112596,"_2666":112680},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3170":66117,"_27782":66085,"_19244":112682,"_5":13232,"_26277":112600,"_2666":112683},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3170":66118,"_27782":66085,"_19244":112685,"_5":13232,"_26277":112600,"_2666":112686},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3170":66119,"_27782":66085,"_19244":112688,"_5":13232,"_26277":112604,"_2666":112689},[],"El servicio VA expone `GET /crl/{subject_key_id}` sin autorización de gestión. Usa el SKI de la **CA emisora**, no el SKI del certificado final ni su número de serie. Inspecciona primero el CDP del certificado:",{"_3170":66120,"_27782":66085,"_19244":112691,"_5":13232,"_26277":112604,"_2666":112692},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3170":66121,"_27782":66085,"_19244":112694,"_5":13232,"_26277":112604,"_2666":112695},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3170":66122,"_27782":66085,"_19244":112697,"_5":13232,"_26277":112604,"_2666":112698},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3170":66123,"_27782":66085,"_19244":112700,"_5":13232,"_26277":112604,"_2666":112701},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3170":66124,"_27782":66085,"_19244":112703,"_5":13232,"_26277":112608,"_2666":112704},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3170":66125,"_27782":66085,"_19244":112706,"_5":13232,"_26277":112608,"_2666":109551},[],{"_3170":66126,"_27782":66085,"_19244":112708,"_5":13232,"_26277":112608,"_2666":112709},[],"Path relativo",{"_3170":66127,"_27782":66085,"_19244":112711,"_5":13232,"_26277":112608,"_2666":107654},[],{"_3170":66128,"_27782":66085,"_19244":112713,"_5":13232,"_26277":112608,"_2666":51538},[],{"_3170":66129,"_27782":66085,"_19244":112715,"_5":13232,"_26277":112608,"_2666":51541},[],{"_3170":66130,"_27782":66085,"_19244":112717,"_5":13232,"_26277":112608,"_2666":112718},[],"Consultar `crl_options` y `latest_crl`.",{"_3170":66131,"_27782":66085,"_19244":112720,"_5":13232,"_26277":112608,"_2666":51547},[],{"_3170":66132,"_27782":66085,"_19244":112722,"_5":13232,"_26277":112608,"_2666":51541},[],{"_3170":66133,"_27782":66085,"_19244":112724,"_5":13232,"_26277":112608,"_2666":112725},[],"Sustituir la configuración de CRL.",{"_3170":66134,"_27782":66085,"_19244":112727,"_5":13232,"_26277":112608,"_2666":112728},[],"Necesitas autenticación y permisos de lectura o actualización del rol. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato: el backend sustituye `crl_options`; no fusiona campos omitidos.",{"_3170":66135,"_27782":66085,"_19244":112730,"_5":13232,"_26277":112608,"_2666":112731},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar el rol no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3170":66136,"_27782":66085,"_19244":112733,"_5":13232,"_26277":112612,"_2666":112734},[],"La vista de la CA permite inspeccionar y descargar la lista disponible. Compara versión, emisor y tiempos con la copia descargada desde el endpoint público. Para diagnosticar una diferencia, sigue Diagnóstico PKI.",{"_3170":66137,"_27782":66085,"_19244":112736,"_5":13232,"_26277":112616,"_2666":112737},[],"RFC 5280: perfil X.509 y CRL.",{"_3170":66138,"_27782":66085,"_19244":112739,"_5":13232,"_26277":112616,"_2666":51567},[],{"_3170":66139,"_27782":66085,"_19244":112741,"_5":13232,"_26277":112616,"_2666":51570},[],{"_3170":66140,"_27782":66085,"_19244":112743,"_5":13232,"_26277":112616,"_2666":112744},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3170":66141,"_27782":66085,"_19244":112746,"_5":13232,"_26277":112616,"_2666":112747},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3170":66142,"_27782":66142,"_5":13558,"_2666":112749,"_28124":112750,"_19244":112751,"_26277":66142},"Claves y motores criptográficos",[45194,107863,50270,111454],[],{"_3170":66143,"_27782":66142,"_19244":112753,"_5":13232,"_26277":66142,"_2666":112754},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3170":66144,"_27782":66142,"_5":28121,"_19244":112756,"_26277":112757,"_2666":112758},[],"/docs/pr-preview/pr-52/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3170":66145,"_27782":66142,"_5":28121,"_19244":112760,"_26277":112761,"_2666":112762},[],"/docs/pr-preview/pr-52/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3170":66146,"_27782":66142,"_5":28121,"_19244":112764,"_26277":112765,"_2666":51595},[],"/docs/pr-preview/pr-52/es/platform/pki/key-management#file-system",{"_3170":66147,"_27782":66142,"_5":28121,"_19244":112767,"_26277":112768,"_2666":51599},[],"/docs/pr-preview/pr-52/es/platform/pki/key-management#hashicorp-vault",{"_3170":66148,"_27782":66142,"_5":28121,"_19244":112770,"_26277":112771,"_2666":51603},[],"/docs/pr-preview/pr-52/es/platform/pki/key-management#aws-secrets-manager",{"_3170":66149,"_27782":66142,"_5":28121,"_19244":112773,"_26277":112774,"_2666":51607},[],"/docs/pr-preview/pr-52/es/platform/pki/key-management#aws-kms",{"_3170":66150,"_27782":66142,"_5":28121,"_19244":112776,"_26277":112777,"_2666":51611},[],"/docs/pr-preview/pr-52/es/platform/pki/key-management#pkcs11",{"_3170":66151,"_27782":66142,"_5":28121,"_19244":112779,"_26277":112780,"_2666":51615},[],"/docs/pr-preview/pr-52/es/platform/pki/key-management#azure-key-vault",{"_3170":66152,"_27782":66142,"_5":28121,"_19244":112782,"_26277":112783,"_2666":112784},[],"/docs/pr-preview/pr-52/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3170":66153,"_27782":66142,"_5":28121,"_19244":112786,"_26277":112787,"_2666":112788},[],"/docs/pr-preview/pr-52/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3170":66154,"_27782":66142,"_5":28121,"_19244":112790,"_26277":112791,"_2666":112792},[],"/docs/pr-preview/pr-52/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3170":66155,"_27782":66142,"_5":28121,"_19244":112794,"_26277":112795,"_2666":112796},[],"/docs/pr-preview/pr-52/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3170":66156,"_27782":66142,"_5":28121,"_19244":112798,"_26277":112799,"_2666":112800},[],"/docs/pr-preview/pr-52/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3170":66157,"_27782":66142,"_5":28121,"_19244":112802,"_26277":112803,"_2666":112804},[],"/docs/pr-preview/pr-52/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3170":66158,"_27782":66142,"_5":28121,"_19244":112806,"_26277":112807,"_2666":112808},[],"/docs/pr-preview/pr-52/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3170":66159,"_27782":66142,"_5":28121,"_19244":112810,"_26277":112811,"_2666":51647},[],"/docs/pr-preview/pr-52/es/platform/pki/key-management#sign",{"_3170":66160,"_27782":66142,"_5":28121,"_19244":112813,"_26277":112814,"_2666":51651},[],"/docs/pr-preview/pr-52/es/platform/pki/key-management#verify",{"_3170":66161,"_27782":66142,"_5":28121,"_19244":112816,"_26277":112817,"_2666":112818},[],"/docs/pr-preview/pr-52/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3170":66162,"_27782":66142,"_5":28121,"_19244":112820,"_26277":112821,"_2666":112822},[],"/docs/pr-preview/pr-52/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3170":66163,"_27782":66142,"_5":28121,"_19244":112824,"_26277":112825,"_2666":112826},[],"/docs/pr-preview/pr-52/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3170":66164,"_27782":66142,"_19244":112828,"_5":13232,"_26277":66142,"_2666":112829},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3170":66165,"_27782":66142,"_19244":112831,"_5":13232,"_26277":66142,"_2666":112832},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3170":66166,"_27782":66142,"_19244":112834,"_5":13232,"_26277":112757,"_2666":112835},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3170":66167,"_27782":66142,"_19244":112837,"_5":13232,"_26277":112757,"_2666":112838},[],"En la práctica, permite:",{"_3170":66168,"_27782":66142,"_19244":112840,"_5":13232,"_26277":112757,"_2666":112841},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3170":66169,"_27782":66142,"_19244":112843,"_5":13232,"_26277":112757,"_2666":112844},[],"Importar claves creadas externamente.",{"_3170":66170,"_27782":66142,"_19244":112846,"_5":13232,"_26277":112757,"_2666":112847},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3170":66171,"_27782":66142,"_19244":112849,"_5":13232,"_26277":112757,"_2666":112850},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3170":66172,"_27782":66142,"_19244":112852,"_5":13232,"_26277":112761,"_2666":112853},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3170":66173,"_27782":66142,"_19244":112855,"_5":13232,"_26277":112761,"_2666":112856},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3170":66174,"_27782":66142,"_19244":112858,"_5":13232,"_26277":112761,"_2666":112859},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3170":66175,"_27782":66142,"_19244":112861,"_5":13232,"_26277":112765,"_2666":112862},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3170":66176,"_27782":66142,"_19244":112864,"_5":13232,"_26277":112768,"_2666":112865},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3170":66177,"_27782":66142,"_19244":112867,"_5":13232,"_26277":112771,"_2666":112868},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3170":66178,"_27782":66142,"_19244":112870,"_5":13232,"_26277":112774,"_2666":112871},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3170":66179,"_27782":66142,"_19244":112873,"_5":13232,"_26277":112777,"_2666":112874},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3170":66180,"_27782":66142,"_19244":112876,"_5":13232,"_26277":112780,"_2666":112877},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3170":66181,"_27782":66142,"_19244":112879,"_5":13232,"_26277":112780,"_2666":112880},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3170":66182,"_27782":66142,"_19244":112882,"_5":13232,"_26277":112780,"_2666":112883},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3170":66183,"_27782":66142,"_19244":112885,"_5":13232,"_26277":112780,"_2666":112886},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3170":66184,"_27782":66142,"_19244":112888,"_5":13232,"_26277":112783,"_2666":112889},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3170":66185,"_27782":66142,"_19244":112891,"_5":13232,"_26277":112783,"_2666":112892},[],"La tabla incluye los siguientes campos:",{"_3170":66186,"_27782":66142,"_19244":112894,"_5":13232,"_26277":112783,"_2666":112895},[],"**Name**: nombre descriptivo de la clave.",{"_3170":66187,"_27782":66142,"_19244":112897,"_5":13232,"_26277":112783,"_2666":112898},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3170":66188,"_27782":66142,"_19244":112900,"_5":13232,"_26277":112783,"_2666":112901},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3170":66189,"_27782":66142,"_19244":112903,"_5":13232,"_26277":112783,"_2666":112904},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3170":66190,"_27782":66142,"_19244":112906,"_5":13232,"_26277":112783,"_2666":112907},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3170":66191,"_27782":66142,"_19244":112909,"_5":13232,"_26277":112783,"_2666":112910},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3170":66192,"_27782":66142,"_19244":112912,"_5":13232,"_26277":112783,"_2666":112913},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3170":66193,"_27782":66142,"_19244":112915,"_5":13232,"_26277":112783,"_2666":112916},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3170":66194,"_27782":66142,"_19244":112918,"_5":13232,"_26277":112783,"_2666":112919},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3170":66195,"_27782":66142,"_19244":112921,"_5":13232,"_26277":112783,"_2666":112922},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3170":66196,"_27782":66142,"_19244":112924,"_5":13232,"_26277":112783,"_2666":112925},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3170":66197,"_27782":66142,"_19244":112927,"_5":13232,"_26277":112783,"_2666":112928},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3170":66198,"_27782":66142,"_19244":112930,"_5":13232,"_26277":112783,"_2666":112931},[],"**Delete Key** para eliminar la clave del sistema.",{"_3170":66199,"_27782":66142,"_19244":112933,"_5":13232,"_26277":112787,"_2666":112934},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3170":66200,"_27782":66142,"_19244":112936,"_5":13232,"_26277":112791,"_2666":112937},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3170":66201,"_27782":66142,"_19244":112939,"_5":13232,"_26277":112791,"_2666":112940},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3170":66202,"_27782":66142,"_19244":112942,"_5":13232,"_26277":112791,"_2666":112943},[],"**Key Name**: nombre único y descriptivo.",{"_3170":66203,"_27782":66142,"_19244":112945,"_5":13232,"_26277":112791,"_2666":112946},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3170":66204,"_27782":66142,"_19244":112948,"_5":13232,"_26277":112791,"_2666":112949},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3170":66205,"_27782":66142,"_19244":112951,"_5":13232,"_26277":112791,"_2666":112952},[],"**Tags**: metadatos para clasificar la clave.",{"_3170":66206,"_27782":66142,"_19244":112954,"_5":13232,"_26277":112791,"_2666":112955},[],"**Metadata**: información adicional para usos avanzados.",{"_3170":66207,"_27782":66142,"_19244":112957,"_5":13232,"_26277":112795,"_2666":112958},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3170":66208,"_27782":66142,"_19244":112960,"_5":13232,"_26277":112795,"_2666":112961},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3170":66209,"_27782":66142,"_19244":112963,"_5":13232,"_26277":112795,"_2666":112964},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3170":66210,"_27782":66142,"_19244":112966,"_5":13232,"_26277":112795,"_2666":112967},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3170":66211,"_27782":66142,"_19244":112969,"_5":13232,"_26277":112795,"_2666":112970},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3170":66212,"_27782":66142,"_19244":112972,"_5":13232,"_26277":112795,"_2666":112973},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3170":66213,"_27782":66142,"_19244":112975,"_5":13232,"_26277":112795,"_2666":112976},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3170":66214,"_27782":66142,"_19244":112978,"_5":13232,"_26277":112795,"_2666":112979},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3170":66215,"_27782":66142,"_19244":112981,"_5":13232,"_26277":112795,"_2666":112982},[],"**Metadata**: información adicional opcional.",{"_3170":66216,"_27782":66142,"_19244":112984,"_5":13232,"_26277":112795,"_2666":112985},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3170":66217,"_27782":66142,"_19244":112987,"_5":13232,"_26277":112795,"_2666":112988},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3170":66218,"_27782":66142,"_19244":112990,"_5":13232,"_26277":112799,"_2666":112991},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3170":66219,"_27782":66142,"_19244":112993,"_5":13232,"_26277":112803,"_2666":112994},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3170":66220,"_27782":66142,"_19244":112996,"_5":13232,"_26277":112803,"_2666":112997},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3170":66221,"_27782":66142,"_19244":112999,"_5":13232,"_26277":112803,"_2666":113000},[],"**Key Name**: nombre descriptivo.",{"_3170":66222,"_27782":66142,"_19244":113002,"_5":13232,"_26277":112803,"_2666":113003},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3170":66223,"_27782":66142,"_19244":113005,"_5":13232,"_26277":112803,"_2666":113006},[],"**Tags**: etiquetas asociadas.",{"_3170":66224,"_27782":66142,"_19244":113008,"_5":13232,"_26277":112803,"_2666":113009},[],"**Aliases**: nombres alternativos.",{"_3170":66225,"_27782":66142,"_19244":113011,"_5":13232,"_26277":112803,"_2666":113012},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3170":66226,"_27782":66142,"_19244":113014,"_5":13232,"_26277":112803,"_2666":113015},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3170":66227,"_27782":66142,"_19244":113017,"_5":13232,"_26277":112803,"_2666":113018},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3170":66228,"_27782":66142,"_19244":113020,"_5":13232,"_26277":112803,"_2666":113021},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3170":66229,"_27782":66142,"_19244":113023,"_5":13232,"_26277":112807,"_2666":113024},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3170":66230,"_27782":66142,"_19244":113026,"_5":13232,"_26277":112807,"_2666":113027},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3170":66231,"_27782":66142,"_19244":113029,"_5":13232,"_26277":112807,"_2666":113030},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3170":66232,"_27782":66142,"_19244":113032,"_5":13232,"_26277":112811,"_2666":113033},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3170":66233,"_27782":66142,"_19244":113035,"_5":13232,"_26277":112811,"_2666":113036},[],"Campos principales:",{"_3170":66234,"_27782":66142,"_19244":113038,"_5":13232,"_26277":112811,"_2666":113039},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3170":66235,"_27782":66142,"_19244":113041,"_5":13232,"_26277":112811,"_2666":113042},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3170":66236,"_27782":66142,"_19244":113044,"_5":13232,"_26277":112811,"_2666":113045},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3170":66237,"_27782":66142,"_19244":113047,"_5":13232,"_26277":112811,"_2666":113048},[],"**Message**: contenido que se va a firmar.",{"_3170":66238,"_27782":66142,"_19244":113050,"_5":13232,"_26277":112811,"_2666":113051},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3170":66239,"_27782":66142,"_19244":113053,"_5":13232,"_26277":112814,"_2666":113054},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3170":66240,"_27782":66142,"_19244":113056,"_5":13232,"_26277":112814,"_2666":113036},[],{"_3170":66241,"_27782":66142,"_19244":113058,"_5":13232,"_26277":112814,"_2666":113059},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3170":66242,"_27782":66142,"_19244":113061,"_5":13232,"_26277":112814,"_2666":113062},[],"**Message Type**: `Raw` o `Digest`.",{"_3170":66243,"_27782":66142,"_19244":113064,"_5":13232,"_26277":112814,"_2666":113065},[],"**Payload Encoding**: codificación del mensaje.",{"_3170":66244,"_27782":66142,"_19244":113067,"_5":13232,"_26277":112814,"_2666":113068},[],"**Message**: mensaje original o hash.",{"_3170":66245,"_27782":66142,"_19244":113070,"_5":13232,"_26277":112814,"_2666":113071},[],"**Signature**: firma que se desea comprobar.",{"_3170":66246,"_27782":66142,"_19244":113073,"_5":13232,"_26277":112814,"_2666":113074},[],"**Result**: indicador del resultado de la validación.",{"_3170":66247,"_27782":66142,"_19244":113076,"_5":13232,"_26277":112817,"_2666":113077},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3170":66248,"_27782":66142,"_19244":113079,"_5":13232,"_26277":112817,"_2666":113080},[],"Este flujo es útil para:",{"_3170":66249,"_27782":66142,"_19244":113082,"_5":13232,"_26277":112817,"_2666":113083},[],"Solicitar certificados a una CA externa.",{"_3170":66250,"_27782":66142,"_19244":113085,"_5":13232,"_26277":112817,"_2666":113086},[],"Renovar una identidad manteniendo la misma clave.",{"_3170":66251,"_27782":66142,"_19244":113088,"_5":13232,"_26277":112817,"_2666":113089},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3170":66252,"_27782":66142,"_19244":113091,"_5":13232,"_26277":112817,"_2666":113092},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3170":66253,"_27782":66142,"_19244":113094,"_5":13232,"_26277":112817,"_2666":113095},[],"**Organization (O)**: organización o empresa.",{"_3170":66254,"_27782":66142,"_19244":113097,"_5":13232,"_26277":112817,"_2666":113098},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3170":66255,"_27782":66142,"_19244":113100,"_5":13232,"_26277":112817,"_2666":113101},[],"**Country (C)**: código de país de dos letras.",{"_3170":66256,"_27782":66142,"_19244":113103,"_5":13232,"_26277":112817,"_2666":113104},[],"**State / Province (ST)**: estado o provincia.",{"_3170":66257,"_27782":66142,"_19244":113106,"_5":13232,"_26277":112817,"_2666":113107},[],"**Locality (L)**: ciudad o localidad.",{"_3170":66258,"_27782":66142,"_19244":113109,"_5":13232,"_26277":112817,"_2666":113110},[],"**Email Address**: correo de contacto.",{"_3170":66259,"_27782":66142,"_19244":113112,"_5":13232,"_26277":112817,"_2666":113113},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3170":66260,"_27782":66142,"_19244":113115,"_5":13232,"_26277":112817,"_2666":113116},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3170":66261,"_27782":66142,"_19244":113118,"_5":13232,"_26277":112821,"_2666":113119},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3170":66262,"_27782":66142,"_19244":113121,"_5":13232,"_26277":112821,"_2666":113122},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3170":66263,"_27782":66142,"_19244":113124,"_5":13232,"_26277":112825,"_2666":113125},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3170":66264,"_27782":66142,"_19244":113127,"_5":13232,"_26277":112825,"_2666":113128},[],"Ten en cuenta que el KMS se niega a eliminar una clave que certificados todavía referencian. La referencia se libera cuando se elimina la CA propietaria de esos certificados; también puedes conservar la clave de forma deliberada.",{"_3170":66265,"_27782":66265,"_5":13558,"_2666":113130,"_28124":113131,"_19244":113132,"_26277":66265},"Validación online con OCSP",[45194,107863,50270,112072],[],{"_3170":66266,"_27782":66265,"_19244":113134,"_5":13232,"_26277":66265,"_2666":113135},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3170":66267,"_27782":66265,"_5":28121,"_19244":113137,"_26277":113138,"_2666":113139},[],"/docs/pr-preview/pr-52/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3170":66268,"_27782":66265,"_5":28121,"_19244":113141,"_26277":113142,"_2666":113143},[],"/docs/pr-preview/pr-52/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3170":66269,"_27782":66265,"_5":28121,"_19244":113145,"_26277":113146,"_2666":113147},[],"/docs/pr-preview/pr-52/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3170":66270,"_27782":66265,"_5":28121,"_19244":113149,"_26277":113150,"_2666":113151},[],"/docs/pr-preview/pr-52/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3170":66271,"_27782":66265,"_5":28121,"_19244":113153,"_26277":113154,"_2666":113155},[],"/docs/pr-preview/pr-52/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3170":66272,"_27782":66265,"_5":28121,"_19244":113157,"_26277":113158,"_2666":112617},[],"/docs/pr-preview/pr-52/es/platform/pki/ocsp#referencias",{"_3170":66273,"_27782":66265,"_19244":113160,"_5":13232,"_26277":66265,"_2666":113161},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3170":66274,"_27782":66265,"_19244":113163,"_5":13232,"_26277":113138,"_2666":113164},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3170":66275,"_27782":66265,"_19244":113166,"_5":13232,"_26277":113138,"_2666":113167},[],"Estado del registro",{"_3170":66276,"_27782":66265,"_19244":113169,"_5":13232,"_26277":113138,"_2666":113170},[],"Respuesta firmada",{"_3170":66277,"_27782":66265,"_19244":113172,"_5":13232,"_26277":113138,"_2666":49448},[],{"_3170":66278,"_27782":66265,"_19244":113174,"_5":13232,"_26277":113138,"_2666":52012},[],{"_3170":66279,"_27782":66265,"_19244":113176,"_5":13232,"_26277":113138,"_2666":49465},[],{"_3170":66280,"_27782":66265,"_19244":113178,"_5":13232,"_26277":113138,"_2666":113179},[],"`Revoked`, con razón y fecha de revocación.",{"_3170":66281,"_27782":66265,"_19244":113181,"_5":13232,"_26277":113138,"_2666":113182},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3170":66282,"_27782":66265,"_19244":113184,"_5":13232,"_26277":113138,"_2666":113185},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3170":66283,"_27782":66265,"_19244":113187,"_5":13232,"_26277":113138,"_2666":113188},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3170":66284,"_27782":66265,"_19244":113190,"_5":13232,"_26277":113138,"_2666":113191},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3170":66285,"_27782":66265,"_19244":113193,"_5":13232,"_26277":113138,"_2666":113194},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3170":66286,"_27782":66265,"_19244":113196,"_5":13232,"_26277":113142,"_2666":113197},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3170":66287,"_27782":66265,"_19244":113199,"_5":13232,"_26277":113142,"_2666":113200},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3170":66288,"_27782":66265,"_19244":113202,"_5":13232,"_26277":113146,"_2666":113203},[],"El servicio acepta:",{"_3170":66289,"_27782":66265,"_19244":113205,"_5":13232,"_26277":113146,"_2666":109551},[],{"_3170":66290,"_27782":66265,"_19244":113207,"_5":13232,"_26277":113146,"_2666":113208},[],"Ruta del servicio VA",{"_3170":66291,"_27782":66265,"_19244":113210,"_5":13232,"_26277":113146,"_2666":113211},[],"Formato",{"_3170":66292,"_27782":66265,"_19244":113213,"_5":13232,"_26277":113146,"_2666":52052},[],{"_3170":66293,"_27782":66265,"_19244":113215,"_5":13232,"_26277":113146,"_2666":52055},[],{"_3170":66294,"_27782":66265,"_19244":113217,"_5":13232,"_26277":113146,"_2666":113218},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3170":66295,"_27782":66265,"_19244":113220,"_5":13232,"_26277":113146,"_2666":51538},[],{"_3170":66296,"_27782":66265,"_19244":113222,"_5":13232,"_26277":113146,"_2666":52063},[],{"_3170":66297,"_27782":66265,"_19244":113224,"_5":13232,"_26277":113146,"_2666":113225},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3170":66298,"_27782":66265,"_19244":113227,"_5":13232,"_26277":113146,"_2666":113228},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3170":66299,"_27782":66265,"_19244":113230,"_5":13232,"_26277":113150,"_2666":113231},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3170":66300,"_27782":66265,"_19244":113233,"_5":13232,"_26277":113150,"_2666":113234},[],"Genera la solicitud:",{"_3170":66301,"_27782":66265,"_19244":113236,"_5":13232,"_26277":113150,"_2666":113237},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3170":66302,"_27782":66265,"_19244":113239,"_5":13232,"_26277":113150,"_2666":113240},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3170":66303,"_27782":66265,"_19244":113242,"_5":13232,"_26277":113150,"_2666":113243},[],"Verifica el DER recibido:",{"_3170":66304,"_27782":66265,"_19244":113245,"_5":13232,"_26277":113150,"_2666":113246},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3170":66305,"_27782":66265,"_19244":113248,"_5":13232,"_26277":113154,"_2666":113249},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3170":66306,"_27782":66265,"_19244":113251,"_5":13232,"_26277":113154,"_2666":113252},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3170":66307,"_27782":66265,"_19244":113254,"_5":13232,"_26277":113158,"_2666":52096},[],{"_3170":66308,"_27782":66265,"_19244":113256,"_5":13232,"_26277":113158,"_2666":52099},[],{"_3170":66309,"_27782":66265,"_19244":113258,"_5":13232,"_26277":113158,"_2666":113259},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3170":66310,"_27782":66265,"_19244":113261,"_5":13232,"_26277":113158,"_2666":112747},[],{"_3170":66311,"_27782":66311,"_5":13558,"_2666":50270,"_28124":113263,"_19244":113264,"_26277":66311},[45194,107863,50270],[],{"_3170":66312,"_27782":66311,"_19244":113266,"_5":13232,"_26277":66311,"_2666":113267},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3170":66313,"_27782":66311,"_5":28121,"_19244":113269,"_26277":113270,"_2666":110778},[],"/docs/pr-preview/pr-52/es/platform/pki/overview#empieza-aquí",{"_3170":66314,"_27782":66311,"_5":28121,"_19244":113272,"_26277":113273,"_2666":113274},[],"/docs/pr-preview/pr-52/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3170":66315,"_27782":66311,"_5":28121,"_19244":113276,"_26277":113277,"_2666":111300},[],"/docs/pr-preview/pr-52/es/platform/pki/overview#capacidades-principales",{"_3170":66316,"_27782":66311,"_5":28121,"_19244":113279,"_26277":113280,"_2666":111304},[],"/docs/pr-preview/pr-52/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3170":66317,"_27782":66311,"_5":28121,"_19244":113282,"_26277":113283,"_2666":111308},[],"/docs/pr-preview/pr-52/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3170":66318,"_27782":66311,"_5":28121,"_19244":113285,"_26277":113286,"_2666":111312},[],"/docs/pr-preview/pr-52/es/platform/pki/overview#emite-y-controla-certificados",{"_3170":66319,"_27782":66311,"_5":28121,"_19244":113288,"_26277":113289,"_2666":111320},[],"/docs/pr-preview/pr-52/es/platform/pki/overview#publica-el-estado-de-validación",{"_3170":66320,"_27782":66311,"_5":28121,"_19244":113291,"_26277":113292,"_2666":113293},[],"/docs/pr-preview/pr-52/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3170":66321,"_27782":66311,"_5":28121,"_19244":113295,"_26277":113296,"_2666":112238},[],"/docs/pr-preview/pr-52/es/platform/pki/overview#continúa",{"_3170":66322,"_27782":66311,"_19244":113298,"_5":13232,"_26277":66311,"_2666":113299},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3170":66323,"_27782":66311,"_19244":113301,"_5":13232,"_26277":113270,"_2666":113302},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3170":66324,"_27782":66311,"_19244":113304,"_5":13232,"_26277":113270,"_2666":113305},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3170":66325,"_27782":66311,"_19244":113307,"_5":13232,"_26277":113273,"_2666":113308},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3170":66326,"_27782":66311,"_19244":113310,"_5":13232,"_26277":113273,"_2666":113311},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3170":66327,"_27782":66311,"_19244":113313,"_5":13232,"_26277":113273,"_2666":113314},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3170":66328,"_27782":66311,"_19244":113316,"_5":13232,"_26277":113273,"_2666":113317},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3170":66329,"_27782":66311,"_19244":113319,"_5":13232,"_26277":113273,"_2666":113320},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3170":66330,"_27782":66311,"_19244":113322,"_5":13232,"_26277":113280,"_2666":113323},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3170":66331,"_27782":66311,"_19244":113325,"_5":13232,"_26277":113283,"_2666":113326},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3170":66332,"_27782":66311,"_19244":113328,"_5":13232,"_26277":113286,"_2666":113329},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3170":66333,"_27782":66311,"_19244":113331,"_5":13232,"_26277":113289,"_2666":113332},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3170":66334,"_27782":66311,"_19244":113334,"_5":13232,"_26277":113292,"_2666":113335},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3170":66335,"_27782":66311,"_19244":113337,"_5":13232,"_26277":113292,"_2666":113338},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3170":66336,"_27782":66311,"_19244":113340,"_5":13232,"_26277":113292,"_2666":113341},[],"su clave pública corresponda a la clave privada del cliente;",{"_3170":66337,"_27782":66311,"_19244":113343,"_5":13232,"_26277":113292,"_2666":113344},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3170":66338,"_27782":66311,"_19244":113346,"_5":13232,"_26277":113292,"_2666":113347},[],"sus fechas y usos permitan la operación;",{"_3170":66339,"_27782":66311,"_19244":113349,"_5":13232,"_26277":113292,"_2666":113350},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3170":66340,"_27782":66311,"_19244":113352,"_5":13232,"_26277":113292,"_2666":113353},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3170":66341,"_27782":66311,"_19244":113355,"_5":13232,"_26277":113296,"_2666":113356},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3170":66342,"_27782":66311,"_19244":113358,"_5":13232,"_26277":113296,"_2666":113359},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3170":66343,"_27782":66311,"_19244":113361,"_5":13232,"_26277":113296,"_2666":113362},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3170":66344,"_27782":66344,"_5":13558,"_2666":113364,"_28124":113365,"_19244":113366,"_26277":66344},"Crea tu primera CA",[45194,107863,50270,110902],[],{"_3170":66345,"_27782":66344,"_19244":113368,"_5":13232,"_26277":66344,"_2666":113369},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3170":66346,"_27782":66344,"_5":28121,"_19244":113371,"_26277":113372,"_2666":106529},[],"/docs/pr-preview/pr-52/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3170":66347,"_27782":66344,"_5":28121,"_19244":113374,"_26277":113375,"_2666":113376},[],"/docs/pr-preview/pr-52/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación","Abre el asistente de creación",{"_3170":66348,"_27782":66344,"_5":28121,"_19244":113378,"_26277":113379,"_2666":113380},[],"/docs/pr-preview/pr-52/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave","Selecciona la clave",{"_3170":66349,"_27782":66344,"_5":28121,"_19244":113382,"_26277":113383,"_2666":113384},[],"/docs/pr-preview/pr-52/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad","Define la autoridad",{"_3170":66350,"_27782":66344,"_5":28121,"_19244":113386,"_26277":113387,"_2666":113388},[],"/docs/pr-preview/pr-52/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca","Revisa y crea la CA",{"_3170":66351,"_27782":66344,"_5":28121,"_19244":113390,"_26277":113391,"_2666":113392},[],"/docs/pr-preview/pr-52/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado","Verifica el resultado",{"_3170":66352,"_27782":66344,"_5":28121,"_19244":113394,"_26277":113395,"_2666":113396},[],"/docs/pr-preview/pr-52/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3170":66353,"_27782":66344,"_5":28121,"_19244":113398,"_26277":113399,"_2666":111150},[],"/docs/pr-preview/pr-52/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3170":66354,"_27782":66344,"_5":28121,"_19244":113401,"_26277":113402,"_2666":106553},[],"/docs/pr-preview/pr-52/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3170":66355,"_27782":66344,"_19244":113404,"_5":13232,"_26277":66344,"_2666":113405},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3170":66356,"_27782":66344,"_19244":113407,"_5":13232,"_26277":113372,"_2666":113408},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3170":66357,"_27782":66344,"_19244":113410,"_5":13232,"_26277":113372,"_2666":113411},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3170":66358,"_27782":66344,"_19244":113413,"_5":13232,"_26277":113372,"_2666":113414},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3170":66359,"_27782":66344,"_19244":113416,"_5":13232,"_26277":113372,"_2666":113417},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3170":66360,"_27782":66344,"_19244":113419,"_5":13232,"_26277":113375,"_2666":113420},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_3170":66361,"_27782":66344,"_19244":113422,"_5":13232,"_26277":113375,"_2666":113423},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_3170":66362,"_27782":66344,"_19244":113425,"_5":13232,"_26277":113379,"_2666":113426},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_3170":66363,"_27782":66344,"_19244":113428,"_5":13232,"_26277":113379,"_2666":113429},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_3170":66364,"_27782":66344,"_19244":113431,"_5":13232,"_26277":113383,"_2666":113432},[],"Selecciona **Root CA** y completa:",{"_3170":66365,"_27782":66344,"_19244":113434,"_5":13232,"_26277":113383,"_2666":52278},[],{"_3170":66366,"_27782":66344,"_19244":113436,"_5":13232,"_26277":113383,"_2666":113437},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_3170":66367,"_27782":66344,"_19244":113439,"_5":13232,"_26277":113383,"_2666":113440},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_3170":66368,"_27782":66344,"_19244":113442,"_5":13232,"_26277":113383,"_2666":113443},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_3170":66369,"_27782":66344,"_19244":113445,"_5":13232,"_26277":113383,"_2666":113446},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_3170":66370,"_27782":66344,"_19244":113448,"_5":13232,"_26277":113387,"_2666":113449},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_3170":66371,"_27782":66344,"_19244":113451,"_5":13232,"_26277":113391,"_2666":113452},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_3170":66372,"_27782":66344,"_19244":113454,"_5":13232,"_26277":113391,"_2666":113455},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_3170":66373,"_27782":66344,"_19244":113457,"_5":13232,"_26277":113395,"_2666":113458},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3170":66374,"_27782":66344,"_19244":113460,"_5":13232,"_26277":113395,"_2666":113461},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3170":66375,"_27782":66344,"_19244":113463,"_5":13232,"_26277":113395,"_2666":113464},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3170":66376,"_27782":66344,"_19244":113466,"_5":13232,"_26277":113399,"_2666":113467},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3170":66377,"_27782":66344,"_19244":113469,"_5":13232,"_26277":113399,"_2666":113470},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3170":66378,"_27782":66344,"_19244":113472,"_5":13232,"_26277":113399,"_2666":113473},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3170":66379,"_27782":66344,"_19244":113475,"_5":13232,"_26277":113399,"_2666":113476},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3170":66380,"_27782":66344,"_19244":113478,"_5":13232,"_26277":113402,"_2666":113479},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3170":66381,"_27782":66381,"_5":13558,"_2666":113481,"_28124":113482,"_19244":113483,"_26277":66381},"Emite y verifica un certificado",[45194,107863,50270,110902],[],{"_3170":66382,"_27782":66381,"_19244":113485,"_5":13232,"_26277":66381,"_2666":113486},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3170":66383,"_27782":66381,"_5":28121,"_19244":113488,"_26277":113489,"_2666":106529},[],"/docs/pr-preview/pr-52/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3170":66384,"_27782":66381,"_5":28121,"_19244":113491,"_26277":113492,"_2666":113493},[],"/docs/pr-preview/pr-52/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3170":66385,"_27782":66381,"_5":28121,"_19244":113495,"_26277":113496,"_2666":113497},[],"/docs/pr-preview/pr-52/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3170":66386,"_27782":66381,"_5":28121,"_19244":113499,"_26277":113500,"_2666":113501},[],"/docs/pr-preview/pr-52/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3170":66387,"_27782":66381,"_5":28121,"_19244":113503,"_26277":113504,"_2666":113505},[],"/docs/pr-preview/pr-52/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3170":66388,"_27782":66381,"_5":28121,"_19244":113507,"_26277":113508,"_2666":113509},[],"/docs/pr-preview/pr-52/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3170":66389,"_27782":66381,"_5":28121,"_19244":113511,"_26277":113512,"_2666":113392},[],"/docs/pr-preview/pr-52/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado",{"_3170":66390,"_27782":66381,"_5":28121,"_19244":113514,"_26277":113515,"_2666":113516},[],"/docs/pr-preview/pr-52/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3170":66391,"_27782":66381,"_5":28121,"_19244":113518,"_26277":113519,"_2666":113520},[],"/docs/pr-preview/pr-52/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3170":66392,"_27782":66381,"_5":28121,"_19244":113522,"_26277":113523,"_2666":113524},[],"/docs/pr-preview/pr-52/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3170":66393,"_27782":66381,"_5":28121,"_19244":113526,"_26277":113527,"_2666":111150},[],"/docs/pr-preview/pr-52/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3170":66394,"_27782":66381,"_5":28121,"_19244":113529,"_26277":113530,"_2666":106553},[],"/docs/pr-preview/pr-52/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3170":66395,"_27782":66381,"_19244":113532,"_5":13232,"_26277":66381,"_2666":113533},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3170":66396,"_27782":66381,"_19244":113535,"_5":13232,"_26277":113489,"_2666":113536},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3170":66397,"_27782":66381,"_19244":113538,"_5":13232,"_26277":113489,"_2666":113539},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3170":66398,"_27782":66381,"_19244":113541,"_5":13232,"_26277":113489,"_2666":113542},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3170":66399,"_27782":66381,"_19244":113544,"_5":13232,"_26277":113489,"_2666":113545},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3170":66400,"_27782":66381,"_19244":113547,"_5":13232,"_26277":113489,"_2666":113548},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3170":66401,"_27782":66381,"_19244":113550,"_5":13232,"_26277":113492,"_2666":113551},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3170":66402,"_27782":66381,"_19244":113553,"_5":13232,"_26277":113496,"_2666":113554},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3170":66403,"_27782":66381,"_19244":113556,"_5":13232,"_26277":113496,"_2666":113557},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3170":66404,"_27782":66381,"_19244":113559,"_5":13232,"_26277":113500,"_2666":113560},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3170":66405,"_27782":66381,"_19244":113562,"_5":13232,"_26277":113500,"_2666":113563},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3170":66406,"_27782":66381,"_19244":113565,"_5":13232,"_26277":113504,"_2666":113566},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3170":66407,"_27782":66381,"_19244":113568,"_5":13232,"_26277":113504,"_2666":113569},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3170":66408,"_27782":66381,"_19244":113571,"_5":13232,"_26277":113508,"_2666":113572},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3170":66409,"_27782":66381,"_19244":113574,"_5":13232,"_26277":113512,"_2666":113575},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3170":66410,"_27782":66381,"_19244":113577,"_5":13232,"_26277":113515,"_2666":113578},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3170":66411,"_27782":66381,"_19244":113580,"_5":13232,"_26277":113519,"_2666":113581},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3170":66412,"_27782":66381,"_19244":113583,"_5":13232,"_26277":113519,"_2666":113584},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3170":66413,"_27782":66381,"_19244":113586,"_5":13232,"_26277":113519,"_2666":113587},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3170":66414,"_27782":66381,"_19244":113589,"_5":13232,"_26277":113523,"_2666":113590},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3170":66415,"_27782":66381,"_19244":113592,"_5":13232,"_26277":113523,"_2666":113593},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3170":66416,"_27782":66381,"_19244":113595,"_5":13232,"_26277":113523,"_2666":113596},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3170":66417,"_27782":66381,"_19244":113598,"_5":13232,"_26277":113527,"_2666":111233},[],{"_3170":66418,"_27782":66381,"_19244":113600,"_5":13232,"_26277":113527,"_2666":110000},[],{"_3170":66419,"_27782":66381,"_19244":113602,"_5":13232,"_26277":113527,"_2666":113603},[],"La CA rechaza la emisión",{"_3170":66420,"_27782":66381,"_19244":113605,"_5":13232,"_26277":113527,"_2666":113606},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3170":66421,"_27782":66381,"_19244":113608,"_5":13232,"_26277":113527,"_2666":113609},[],"Sujeto o usos diferentes",{"_3170":66422,"_27782":66381,"_19244":113611,"_5":13232,"_26277":113527,"_2666":113612},[],"Perfil aplicado y valores solicitados.",{"_3170":66423,"_27782":66381,"_19244":113614,"_5":13232,"_26277":113527,"_2666":113615},[],"No se encuentra el emisor",{"_3170":66424,"_27782":66381,"_19244":113617,"_5":13232,"_26277":113527,"_2666":113618},[],"CA descargada y cadena intermedia necesaria.",{"_3170":66425,"_27782":66381,"_19244":113620,"_5":13232,"_26277":113527,"_2666":113621},[],"Falla la vigencia",{"_3170":66426,"_27782":66381,"_19244":113623,"_5":13232,"_26277":113527,"_2666":113624},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3170":66427,"_27782":66381,"_19244":113626,"_5":13232,"_26277":113527,"_2666":113627},[],"Los resúmenes de clave difieren",{"_3170":66428,"_27782":66381,"_19244":113629,"_5":13232,"_26277":113527,"_2666":113630},[],"Archivos de certificado y clave de la misma emisión.",{"_3170":66429,"_27782":66381,"_19244":113632,"_5":13232,"_26277":113527,"_2666":113633},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3170":66430,"_27782":66381,"_19244":113635,"_5":13232,"_26277":113530,"_2666":113636},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3170":66431,"_27782":66381,"_19244":113638,"_5":13232,"_26277":113530,"_2666":113639},[],"Gestionar certificados para inspección, estado y revocación.",{"_3170":66432,"_27782":66381,"_19244":113641,"_5":13232,"_26277":113530,"_2666":113642},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3170":66433,"_27782":66381,"_19244":113644,"_5":13232,"_26277":113530,"_2666":113645},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3170":66434,"_27782":66381,"_19244":113647,"_5":13232,"_26277":113530,"_2666":113648},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3170":66435,"_27782":66435,"_5":13558,"_2666":113650,"_28124":113651,"_19244":113652,"_26277":66435},"Primeros pasos de PKI",[45194,107863,50270,110902],[],{"_3170":66436,"_27782":66435,"_19244":113654,"_5":13232,"_26277":66435,"_2666":113655},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3170":66437,"_27782":66435,"_5":28121,"_19244":113657,"_26277":113658,"_2666":106529},[],"/docs/pr-preview/pr-52/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3170":66438,"_27782":66435,"_5":28121,"_19244":113660,"_26277":113661,"_2666":113662},[],"/docs/pr-preview/pr-52/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3170":66439,"_27782":66435,"_5":28121,"_19244":113664,"_26277":113665,"_2666":111084},[],"/docs/pr-preview/pr-52/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3170":66440,"_27782":66435,"_5":28121,"_19244":113667,"_26277":113668,"_2666":113669},[],"/docs/pr-preview/pr-52/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3170":66441,"_27782":66435,"_19244":113671,"_5":13232,"_26277":66435,"_2666":113672},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3170":66442,"_27782":66435,"_19244":113674,"_5":13232,"_26277":113658,"_2666":113675},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3170":66443,"_27782":66435,"_19244":113677,"_5":13232,"_26277":113658,"_2666":113678},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3170":66444,"_27782":66435,"_19244":113680,"_5":13232,"_26277":113658,"_2666":113681},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3170":66445,"_27782":66435,"_19244":113683,"_5":13232,"_26277":113658,"_2666":113684},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3170":66446,"_27782":66435,"_19244":113686,"_5":13232,"_26277":113658,"_2666":113687},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3170":66447,"_27782":66435,"_19244":113689,"_5":13232,"_26277":113661,"_2666":113690},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3170":66448,"_27782":66435,"_19244":113692,"_5":13232,"_26277":113661,"_2666":113693},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3170":66449,"_27782":66435,"_19244":113695,"_5":13232,"_26277":113661,"_2666":113696},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3170":66450,"_27782":66435,"_19244":113698,"_5":13232,"_26277":113661,"_2666":113699},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3170":66451,"_27782":66435,"_19244":113701,"_5":13232,"_26277":113665,"_2666":113702},[],"Archivo o recurso",{"_3170":66452,"_27782":66435,"_19244":113704,"_5":13232,"_26277":113665,"_2666":111081},[],{"_3170":66453,"_27782":66435,"_19244":113706,"_5":13232,"_26277":113665,"_2666":113707},[],"CA raíz activa y `ca.pem`",{"_3170":66454,"_27782":66435,"_19244":113709,"_5":13232,"_26277":113665,"_2666":113710},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3170":66455,"_27782":66435,"_19244":113712,"_5":13232,"_26277":113665,"_2666":113713},[],"Certificado final y `device.crt`",{"_3170":66456,"_27782":66435,"_19244":113715,"_5":13232,"_26277":113665,"_2666":113716},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3170":66457,"_27782":66435,"_19244":113718,"_5":13232,"_26277":113665,"_2666":113719},[],"Clave privada `device.key`",{"_3170":66458,"_27782":66435,"_19244":113721,"_5":13232,"_26277":113665,"_2666":113722},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3170":66459,"_27782":66435,"_19244":113724,"_5":13232,"_26277":113665,"_2666":113725},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3170":66460,"_27782":66435,"_19244":113727,"_5":13232,"_26277":113668,"_2666":113728},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3170":66461,"_27782":66435,"_19244":113730,"_5":13232,"_26277":113668,"_2666":113731},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3170":66462,"_27782":66435,"_19244":113733,"_5":13232,"_26277":113668,"_2666":113734},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3170":66463,"_27782":66463,"_5":13558,"_2666":113736,"_28124":113737,"_19244":113739,"_26277":66463},"Resolución de problemas PKI",[45194,107863,50270,113738],"Resolución de problemas",[],{"_3170":66464,"_27782":66463,"_19244":113741,"_5":13232,"_26277":66463,"_2666":113742},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3170":66465,"_27782":66463,"_5":28121,"_19244":113744,"_26277":113745,"_2666":113746},[],"/docs/pr-preview/pr-52/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3170":66466,"_27782":66463,"_5":28121,"_19244":113748,"_26277":113749,"_2666":113750},[],"/docs/pr-preview/pr-52/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3170":66467,"_27782":66463,"_5":28121,"_19244":113752,"_26277":113753,"_2666":113754},[],"/docs/pr-preview/pr-52/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3170":66468,"_27782":66463,"_19244":113756,"_5":13232,"_26277":66463,"_2666":113757},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3170":66469,"_27782":66463,"_19244":113759,"_5":13232,"_26277":66463,"_2666":113760},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3170":66470,"_27782":66463,"_19244":113762,"_5":13232,"_26277":113745,"_2666":111081},[],{"_3170":66471,"_27782":66463,"_19244":113764,"_5":13232,"_26277":113745,"_2666":110000},[],{"_3170":66472,"_27782":66463,"_19244":113766,"_5":13232,"_26277":113745,"_2666":106553},[],{"_3170":66473,"_27782":66463,"_19244":113768,"_5":13232,"_26277":113745,"_2666":52614},[],{"_3170":66474,"_27782":66463,"_19244":113770,"_5":13232,"_26277":113745,"_2666":113771},[],"Existe, está activa y sus fechas son utilizables.",{"_3170":66475,"_27782":66463,"_19244":113773,"_5":13232,"_26277":113745,"_2666":113774},[],"Autoridades.",{"_3170":66476,"_27782":66463,"_19244":113776,"_5":13232,"_26277":113745,"_2666":113777},[],"Clave",{"_3170":66477,"_27782":66463,"_19244":113779,"_5":13232,"_26277":113745,"_2666":113780},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3170":66478,"_27782":66463,"_19244":113782,"_5":13232,"_26277":113745,"_2666":113783},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3170":66479,"_27782":66463,"_19244":113785,"_5":13232,"_26277":113745,"_2666":52632},[],{"_3170":66480,"_27782":66463,"_19244":113787,"_5":13232,"_26277":113745,"_2666":113788},[],"PEM correcto y firma verificable.",{"_3170":66481,"_27782":66463,"_19244":113790,"_5":13232,"_26277":113745,"_2666":52638},[],{"_3170":66482,"_27782":66463,"_19244":113792,"_5":13232,"_26277":113745,"_2666":113793},[],"Perfil",{"_3170":66483,"_27782":66463,"_19244":113795,"_5":13232,"_26277":113745,"_2666":113796},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3170":66484,"_27782":66463,"_19244":113798,"_5":13232,"_26277":113745,"_2666":113799},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3170":66485,"_27782":66463,"_19244":113801,"_5":13232,"_26277":113745,"_2666":111233},[],{"_3170":66486,"_27782":66463,"_19244":113803,"_5":13232,"_26277":113745,"_2666":113804},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3170":66487,"_27782":66463,"_19244":113806,"_5":13232,"_26277":113745,"_2666":113807},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3170":66488,"_27782":66463,"_19244":113809,"_5":13232,"_26277":113745,"_2666":113810},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3170":66489,"_27782":66463,"_19244":113812,"_5":13232,"_26277":113745,"_2666":113813},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3170":66490,"_27782":66463,"_19244":113815,"_5":13232,"_26277":113749,"_2666":113816},[],"Revisa cada frontera por separado:",{"_3170":66491,"_27782":66463,"_19244":113818,"_5":13232,"_26277":113749,"_2666":113819},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3170":66492,"_27782":66463,"_19244":113821,"_5":13232,"_26277":113749,"_2666":113822},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3170":66493,"_27782":66463,"_19244":113824,"_5":13232,"_26277":113749,"_2666":113825},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3170":66494,"_27782":66463,"_19244":113827,"_5":13232,"_26277":113749,"_2666":113828},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3170":66495,"_27782":66463,"_19244":113830,"_5":13232,"_26277":113749,"_2666":113831},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3170":66496,"_27782":66463,"_19244":113833,"_5":13232,"_26277":113749,"_2666":113834},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_3170":66497,"_27782":66463,"_19244":113836,"_5":13232,"_26277":113753,"_2666":113837},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3170":66498,"_27782":66463,"_19244":113839,"_5":13232,"_26277":113753,"_2666":113840},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3170":66499,"_27782":66499,"_5":13558,"_2666":113842,"_28124":113843,"_19244":113845,"_26277":66499},"3.8.0 a 4.0.0",[45194,113844],"Actualizaciones",[],{"_3170":66500,"_27782":66499,"_19244":113847,"_5":13232,"_26277":66499,"_2666":113848},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3170":66501,"_27782":66499,"_5":28121,"_19244":113850,"_26277":113851,"_2666":113852},[],"/docs/pr-preview/pr-52/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_3170":66502,"_27782":66499,"_5":28121,"_19244":113854,"_26277":113855,"_2666":113856},[],"/docs/pr-preview/pr-52/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3170":66503,"_27782":66499,"_5":28121,"_19244":113858,"_26277":113859,"_2666":113860},[],"/docs/pr-preview/pr-52/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3170":66504,"_27782":66499,"_5":28121,"_19244":113862,"_26277":113863,"_2666":113864},[],"/docs/pr-preview/pr-52/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3170":66505,"_27782":66499,"_5":28121,"_19244":113866,"_26277":113867,"_2666":113868},[],"/docs/pr-preview/pr-52/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3170":66506,"_27782":66499,"_5":28121,"_19244":113870,"_26277":113871,"_2666":113872},[],"/docs/pr-preview/pr-52/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3170":66507,"_27782":66499,"_5":28121,"_19244":113874,"_26277":113875,"_2666":52724},[],"/docs/pr-preview/pr-52/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3170":66508,"_27782":66499,"_5":28121,"_19244":113877,"_26277":113878,"_2666":113879},[],"/docs/pr-preview/pr-52/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_3170":66509,"_27782":66499,"_5":28121,"_19244":113881,"_26277":113882,"_2666":113883},[],"/docs/pr-preview/pr-52/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3170":66510,"_27782":66499,"_5":28121,"_19244":113885,"_26277":113886,"_2666":113887},[],"/docs/pr-preview/pr-52/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3170":66511,"_27782":66499,"_5":28121,"_19244":113889,"_26277":113890,"_2666":113891},[],"/docs/pr-preview/pr-52/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3170":66512,"_27782":66499,"_5":28121,"_19244":113893,"_26277":113894,"_2666":113895},[],"/docs/pr-preview/pr-52/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3170":66513,"_27782":66499,"_5":28121,"_19244":113897,"_26277":113898,"_2666":113899},[],"/docs/pr-preview/pr-52/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3170":66514,"_27782":66499,"_5":28121,"_19244":113901,"_26277":113902,"_2666":113903},[],"/docs/pr-preview/pr-52/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3170":66515,"_27782":66499,"_5":28121,"_19244":113905,"_26277":113906,"_2666":113907},[],"/docs/pr-preview/pr-52/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3170":66516,"_27782":66499,"_5":28121,"_19244":113909,"_26277":113910,"_2666":113911},[],"/docs/pr-preview/pr-52/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_3170":66517,"_27782":66499,"_5":28121,"_19244":113913,"_26277":113914,"_2666":113915},[],"/docs/pr-preview/pr-52/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3170":66518,"_27782":66499,"_5":28121,"_19244":113917,"_26277":113918,"_2666":113919},[],"/docs/pr-preview/pr-52/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3170":66519,"_27782":66499,"_5":28121,"_19244":113921,"_26277":113922,"_2666":113923},[],"/docs/pr-preview/pr-52/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3170":66520,"_27782":66499,"_5":28121,"_19244":113925,"_26277":113926,"_2666":113927},[],"/docs/pr-preview/pr-52/es/upgrades/3-8-0-to-4-0-0#referencias-entre-certificados-claves-y-roles-va","Referencias entre certificados, claves y roles VA",{"_3170":66521,"_27782":66499,"_5":28121,"_19244":113929,"_26277":113930,"_2666":113931},[],"/docs/pr-preview/pr-52/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_3170":66522,"_27782":66499,"_5":28121,"_19244":113933,"_26277":113934,"_2666":113935},[],"/docs/pr-preview/pr-52/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3170":66523,"_27782":66499,"_5":28121,"_19244":113937,"_26277":113938,"_2666":113939},[],"/docs/pr-preview/pr-52/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3170":66524,"_27782":66499,"_5":28121,"_19244":113941,"_26277":113942,"_2666":113943},[],"/docs/pr-preview/pr-52/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3170":66525,"_27782":66499,"_5":28121,"_19244":113945,"_26277":113946,"_2666":113947},[],"/docs/pr-preview/pr-52/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3170":66526,"_27782":66499,"_5":28121,"_19244":113949,"_26277":113950,"_2666":113951},[],"/docs/pr-preview/pr-52/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3170":66527,"_27782":66499,"_5":28121,"_19244":113953,"_26277":113954,"_2666":113955},[],"/docs/pr-preview/pr-52/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3170":66528,"_27782":66499,"_5":28121,"_19244":113957,"_26277":113958,"_2666":113959},[],"/docs/pr-preview/pr-52/es/upgrades/3-8-0-to-4-0-0#campo-firmante-del-rol-va","Campo firmante del rol VA",{"_3170":66529,"_27782":66499,"_5":28121,"_19244":113961,"_26277":113962,"_2666":113963},[],"/docs/pr-preview/pr-52/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3170":66530,"_27782":66499,"_5":28121,"_19244":113965,"_26277":113966,"_2666":113967},[],"/docs/pr-preview/pr-52/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3170":66531,"_27782":66499,"_5":28121,"_19244":113969,"_26277":113970,"_2666":113971},[],"/docs/pr-preview/pr-52/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3170":66532,"_27782":66499,"_5":28121,"_19244":113973,"_26277":113974,"_2666":113975},[],"/docs/pr-preview/pr-52/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3170":66533,"_27782":66499,"_5":28121,"_19244":113977,"_26277":113978,"_2666":113979},[],"/docs/pr-preview/pr-52/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3170":66534,"_27782":66499,"_5":28121,"_19244":113981,"_26277":113982,"_2666":113983},[],"/docs/pr-preview/pr-52/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3170":66535,"_27782":66499,"_5":28121,"_19244":113985,"_26277":113986,"_2666":113987},[],"/docs/pr-preview/pr-52/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3170":66536,"_27782":66499,"_5":28121,"_19244":113989,"_26277":113990,"_2666":110322},[],"/docs/pr-preview/pr-52/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3170":66537,"_27782":66499,"_5":28121,"_19244":113992,"_26277":113993,"_2666":113994},[],"/docs/pr-preview/pr-52/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3170":66538,"_27782":66499,"_5":28121,"_19244":113996,"_26277":113997,"_2666":113998},[],"/docs/pr-preview/pr-52/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3170":66539,"_27782":66499,"_19244":114000,"_5":13232,"_26277":66499,"_2666":114001},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3170":66540,"_27782":66499,"_19244":114003,"_5":13232,"_26277":66499,"_2666":114004},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3170":66541,"_27782":66499,"_19244":114006,"_5":13232,"_26277":66499,"_2666":114007},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_3170":66542,"_27782":66499,"_19244":114009,"_5":13232,"_26277":66499,"_2666":114010},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_3170":66543,"_27782":66499,"_19244":114012,"_5":13232,"_26277":66499,"_2666":114013},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3170":66544,"_27782":66499,"_19244":114015,"_5":13232,"_26277":66499,"_2666":114016},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3170":66545,"_27782":66499,"_19244":114018,"_5":13232,"_26277":66499,"_2666":114019},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3170":66546,"_27782":66499,"_19244":114021,"_5":13232,"_26277":113855,"_2666":114022},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3170":66547,"_27782":66499,"_19244":114024,"_5":13232,"_26277":113855,"_2666":114025},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_3170":66548,"_27782":66499,"_19244":114027,"_5":13232,"_26277":113859,"_2666":114028},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3170":66549,"_27782":66499,"_19244":114030,"_5":13232,"_26277":113859,"_2666":114031},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y roles de la VA. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3170":66550,"_27782":66499,"_19244":114033,"_5":13232,"_26277":113863,"_2666":114034},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera.",{"_3170":66551,"_27782":66499,"_19244":114036,"_5":13232,"_26277":113867,"_2666":114037},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3170":66552,"_27782":66499,"_19244":114039,"_5":13232,"_26277":113867,"_2666":114040},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3170":66553,"_27782":66499,"_19244":114042,"_5":13232,"_26277":113867,"_2666":114043},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_3170":66554,"_27782":66499,"_19244":114045,"_5":13232,"_26277":113867,"_2666":114046},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3170":66555,"_27782":66499,"_19244":114048,"_5":13232,"_26277":113867,"_2666":114049},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3170":66556,"_27782":66499,"_19244":114051,"_5":13232,"_26277":113871,"_2666":114052},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3170":66557,"_27782":66499,"_19244":114054,"_5":13232,"_26277":113871,"_2666":114055},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3170":66558,"_27782":66499,"_19244":114057,"_5":13232,"_26277":113871,"_2666":114058},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3170":66559,"_27782":66499,"_19244":114060,"_5":13232,"_26277":113871,"_2666":114061},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3170":66560,"_27782":66499,"_19244":114063,"_5":13232,"_26277":113871,"_2666":114064},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3170":66561,"_27782":66499,"_19244":114066,"_5":13232,"_26277":113875,"_2666":114067},[],"Cambio",{"_3170":66562,"_27782":66499,"_19244":114069,"_5":13232,"_26277":113875,"_2666":114070},[],"A quién afecta",{"_3170":66563,"_27782":66499,"_19244":114072,"_5":13232,"_26277":113875,"_2666":114073},[],"Gravedad",{"_3170":66564,"_27782":66499,"_19244":114075,"_5":13232,"_26277":113875,"_2666":114076},[],"Acción",{"_3170":66565,"_27782":66499,"_19244":114078,"_5":13232,"_26277":113875,"_2666":113883},[],{"_3170":66566,"_27782":66499,"_19244":114080,"_5":13232,"_26277":113875,"_2666":114081},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_3170":66567,"_27782":66499,"_19244":114083,"_5":13232,"_26277":113875,"_2666":114084},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_3170":66568,"_27782":66499,"_19244":114086,"_5":13232,"_26277":113875,"_2666":114087},[],"Copiar los datos a los volúmenes nuevos",{"_3170":66569,"_27782":66499,"_19244":114089,"_5":13232,"_26277":113875,"_2666":113887},[],{"_3170":66570,"_27782":66499,"_19244":114091,"_5":13232,"_26277":113875,"_2666":114092},[],"Todas las releases de Helm",{"_3170":66571,"_27782":66499,"_19244":114094,"_5":13232,"_26277":113875,"_2666":114095},[],"Alta: `helm upgrade` falla",{"_3170":66572,"_27782":66499,"_19244":114097,"_5":13232,"_26277":113875,"_2666":114098},[],"Eliminar o renombrar las claves heredadas",{"_3170":66573,"_27782":66499,"_19244":114100,"_5":13232,"_26277":113875,"_2666":113891},[],{"_3170":66574,"_27782":66499,"_19244":114102,"_5":13232,"_26277":113875,"_2666":114103},[],"Todos los despliegues",{"_3170":66575,"_27782":66499,"_19244":114105,"_5":13232,"_26277":113875,"_2666":114106},[],"Alta: sin principal de bootstrap no hay administrador",{"_3170":66576,"_27782":66499,"_19244":114108,"_5":13232,"_26277":113875,"_2666":114109},[],"Configurar `services.authz`",{"_3170":66577,"_27782":66499,"_19244":114111,"_5":13232,"_26277":113875,"_2666":113895},[],{"_3170":66578,"_27782":66499,"_19244":114113,"_5":13232,"_26277":113875,"_2666":114092},[],{"_3170":66579,"_27782":66499,"_19244":114115,"_5":13232,"_26277":113875,"_2666":114116},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_3170":66580,"_27782":66499,"_19244":114118,"_5":13232,"_26277":113875,"_2666":114119},[],"Mover JWKS y roles a `services.authz`",{"_3170":66581,"_27782":66499,"_19244":114121,"_5":13232,"_26277":113875,"_2666":113915},[],{"_3170":66582,"_27782":66499,"_19244":114123,"_5":13232,"_26277":113875,"_2666":114124},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_3170":66583,"_27782":66499,"_19244":114126,"_5":13232,"_26277":113875,"_2666":114127},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_3170":66584,"_27782":66499,"_19244":114129,"_5":13232,"_26277":113875,"_2666":114130},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_3170":66585,"_27782":66499,"_19244":114132,"_5":13232,"_26277":113875,"_2666":113919},[],{"_3170":66586,"_27782":66499,"_19244":114134,"_5":13232,"_26277":113875,"_2666":114135},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_3170":66587,"_27782":66499,"_19244":114137,"_5":13232,"_26277":113875,"_2666":114138},[],"Alta: el backend ya no arranca con ellos",{"_3170":66588,"_27782":66499,"_19244":114140,"_5":13232,"_26277":113875,"_2666":114141},[],"Pasar a PostgreSQL antes de actualizar",{"_3170":66589,"_27782":66499,"_19244":114143,"_5":13232,"_26277":113875,"_2666":114144},[],"Webhooks con referencias a archivos",{"_3170":66590,"_27782":66499,"_19244":114146,"_5":13232,"_26277":113875,"_2666":114147},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3170":66591,"_27782":66499,"_19244":114149,"_5":13232,"_26277":113875,"_2666":114150},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_3170":66592,"_27782":66499,"_19244":114152,"_5":13232,"_26277":113875,"_2666":114153},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3170":66593,"_27782":66499,"_19244":114155,"_5":13232,"_26277":113875,"_2666":113899},[],{"_3170":66594,"_27782":66499,"_19244":114157,"_5":13232,"_26277":113875,"_2666":114158},[],"Releases con identidades por servicio o material de claves montado",{"_3170":66595,"_27782":66499,"_19244":114160,"_5":13232,"_26277":113875,"_2666":114161},[],"Media: los servicios no pueden leer sus archivos",{"_3170":66596,"_27782":66499,"_19244":114163,"_5":13232,"_26277":113875,"_2666":114164},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_3170":66597,"_27782":66499,"_19244":114166,"_5":13232,"_26277":113875,"_2666":113903},[],{"_3170":66598,"_27782":66499,"_19244":114168,"_5":13232,"_26277":113875,"_2666":114169},[],"Releases que definen `amqp.tls`",{"_3170":66599,"_27782":66499,"_19244":114171,"_5":13232,"_26277":113875,"_2666":114172},[],"Media: los clientes se conectan al puerto equivocado",{"_3170":66600,"_27782":66499,"_19244":114174,"_5":13232,"_26277":113875,"_2666":114175},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_3170":66601,"_27782":66499,"_19244":114177,"_5":13232,"_26277":113875,"_2666":113923},[],{"_3170":66602,"_27782":66499,"_19244":114179,"_5":13232,"_26277":113875,"_2666":114180},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3170":66603,"_27782":66499,"_19244":114182,"_5":13232,"_26277":113875,"_2666":114183},[],"Media: las claves de CA quedan sin gestionar",{"_3170":66604,"_27782":66499,"_19244":114185,"_5":13232,"_26277":113875,"_2666":114186},[],"Ejecutar la migración de CA a KMS",{"_3170":66605,"_27782":66499,"_19244":114188,"_5":13232,"_26277":113875,"_2666":114189},[],"Verificación del certificado del receptor",{"_3170":66606,"_27782":66499,"_19244":114191,"_5":13232,"_26277":113875,"_2666":114192},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_3170":66607,"_27782":66499,"_19244":114194,"_5":13232,"_26277":113875,"_2666":114195},[],"Media: las credenciales viajan a un receptor sin verificar",{"_3170":66608,"_27782":66499,"_19244":114197,"_5":13232,"_26277":113875,"_2666":114198},[],"Poner `insecure_skip_verify` a `false`",{"_3170":66609,"_27782":66499,"_19244":114200,"_5":13232,"_26277":113875,"_2666":113939},[],{"_3170":66610,"_27782":66499,"_19244":114202,"_5":13232,"_26277":113875,"_2666":114203},[],"Scripts y consolas que editan DMS por API",{"_3170":66611,"_27782":66499,"_19244":114205,"_5":13232,"_26277":113875,"_2666":114206},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3170":66612,"_27782":66499,"_19244":114208,"_5":13232,"_26277":113875,"_2666":114209},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3170":66613,"_27782":66499,"_19244":114211,"_5":13232,"_26277":113875,"_2666":113959},[],{"_3170":66614,"_27782":66499,"_19244":114213,"_5":13232,"_26277":113875,"_2666":114214},[],"Clientes que crean o actualizan roles VA por API",{"_3170":66615,"_27782":66499,"_19244":114216,"_5":13232,"_26277":113875,"_2666":114217},[],"Media: las peticiones con el campo antiguo devuelven un error",{"_3170":66616,"_27782":66499,"_19244":114219,"_5":13232,"_26277":113875,"_2666":114220},[],"Sustituir `crl_options.subject_key_id_signer` por el obligatorio `crl_options.signer_certificate_serial_number`",{"_3170":66617,"_27782":66499,"_19244":114222,"_5":13232,"_26277":113875,"_2666":113955},[],{"_3170":66618,"_27782":66499,"_19244":114224,"_5":13232,"_26277":113875,"_2666":114225},[],"Consumidores que leen el campo `events` del dispositivo",{"_3170":66619,"_27782":66499,"_19244":114227,"_5":13232,"_26277":113875,"_2666":114228},[],"Media: el campo desaparece",{"_3170":66620,"_27782":66499,"_19244":114230,"_5":13232,"_26277":113875,"_2666":114231},[],"Usar los nuevos endpoints de eventos",{"_3170":66621,"_27782":66499,"_19244":114233,"_5":13232,"_26277":113875,"_2666":113907},[],{"_3170":66622,"_27782":66499,"_19244":114235,"_5":13232,"_26277":113875,"_2666":114236},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_3170":66623,"_27782":66499,"_19244":114238,"_5":13232,"_26277":113875,"_2666":114239},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_3170":66624,"_27782":66499,"_19244":114241,"_5":13232,"_26277":113875,"_2666":114242},[],"Actualizar el archivo de values",{"_3170":66625,"_27782":66499,"_19244":114244,"_5":13232,"_26277":113875,"_2666":113947},[],{"_3170":66626,"_27782":66499,"_19244":114246,"_5":13232,"_26277":113875,"_2666":114247},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3170":66627,"_27782":66499,"_19244":114249,"_5":13232,"_26277":113875,"_2666":114250},[],"Baja: prevalece el ID de la URL",{"_3170":66628,"_27782":66499,"_19244":114252,"_5":13232,"_26277":113875,"_2666":114253},[],"Enviar el ID en la URL",{"_3170":66629,"_27782":66499,"_19244":114255,"_5":13232,"_26277":113875,"_2666":113951},[],{"_3170":66630,"_27782":66499,"_19244":114257,"_5":13232,"_26277":113875,"_2666":114258},[],"Consumidores que comparan el `type` del certificado",{"_3170":66631,"_27782":66499,"_19244":114260,"_5":13232,"_26277":113875,"_2666":114261},[],"Baja: dos valores cambian de nombre",{"_3170":66632,"_27782":66499,"_19244":114263,"_5":13232,"_26277":113875,"_2666":114264},[],"Adaptar los consumidores",{"_3170":66633,"_27782":66499,"_19244":114266,"_5":13232,"_26277":113875,"_2666":113943},[],{"_3170":66634,"_27782":66499,"_19244":114268,"_5":13232,"_26277":113875,"_2666":114269},[],"Cualquier DMS",{"_3170":66635,"_27782":66499,"_19244":114271,"_5":13232,"_26277":113875,"_2666":114272},[],"Baja: solo informativo",{"_3170":66636,"_27782":66499,"_19244":114274,"_5":13232,"_26277":113875,"_2666":114275},[],"Revisar ambos bloques antes de editar",{"_3170":66637,"_27782":66499,"_19244":114277,"_5":13232,"_26277":113882,"_2666":114278},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3170":66638,"_27782":66499,"_19244":114280,"_5":13232,"_26277":113882,"_2666":114281},[],"El paso 4 de la guía de migración copia los datos.",{"_3170":66639,"_27782":66499,"_19244":114283,"_5":13232,"_26277":113886,"_2666":114284},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3170":66640,"_27782":66499,"_19244":114286,"_5":13232,"_26277":113890,"_2666":114287},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3170":66641,"_27782":66499,"_19244":114289,"_5":13232,"_26277":113894,"_2666":114290},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3170":66642,"_27782":66499,"_19244":114292,"_5":13232,"_26277":113898,"_2666":114293},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3170":66643,"_27782":66499,"_19244":114295,"_5":13232,"_26277":113898,"_2666":114296},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3170":66644,"_27782":66499,"_19244":114298,"_5":13232,"_26277":113902,"_2666":114299},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3170":66645,"_27782":66499,"_19244":114301,"_5":13232,"_26277":113906,"_2666":114302},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3170":66646,"_27782":66499,"_19244":114304,"_5":13232,"_26277":113906,"_2666":114305},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3170":66647,"_27782":66499,"_19244":114307,"_5":13232,"_26277":113906,"_2666":114308},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3170":66648,"_27782":66499,"_19244":114310,"_5":13232,"_26277":113906,"_2666":114311},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3170":66649,"_27782":66499,"_19244":114313,"_5":13232,"_26277":113906,"_2666":114314},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3170":66650,"_27782":66499,"_19244":114316,"_5":13232,"_26277":113906,"_2666":114317},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3170":66651,"_27782":66499,"_19244":114319,"_5":13232,"_26277":113914,"_2666":114320},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3170":66652,"_27782":66499,"_19244":114322,"_5":13232,"_26277":113914,"_2666":114323},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3170":66653,"_27782":66499,"_19244":114325,"_5":13232,"_26277":113914,"_2666":114326},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3170":66654,"_27782":66499,"_19244":114328,"_5":13232,"_26277":113914,"_2666":114329},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3170":66655,"_27782":66499,"_19244":114331,"_5":13232,"_26277":113914,"_2666":114332},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_3170":66656,"_27782":66499,"_19244":114334,"_5":13232,"_26277":113918,"_2666":114335},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3170":66657,"_27782":66499,"_19244":114337,"_5":13232,"_26277":113922,"_2666":114338},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3170":66658,"_27782":66499,"_19244":114340,"_5":13232,"_26277":113922,"_2666":114341},[],"El `key_id` es el `subject_key_id` del certificado (SHA-256 de la clave pública).",{"_3170":66659,"_27782":66499,"_19244":114343,"_5":13232,"_26277":113922,"_2666":114344},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3170":66660,"_27782":66499,"_19244":114346,"_5":13232,"_26277":113922,"_2666":114347},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3170":66661,"_27782":66499,"_19244":114349,"_5":13232,"_26277":113922,"_2666":114350},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3170":66662,"_27782":66499,"_19244":114352,"_5":13232,"_26277":113922,"_2666":114353},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3170":66663,"_27782":66499,"_19244":114355,"_5":13232,"_26277":113922,"_2666":114356},[],"Una vez registradas las claves heredadas, arrancar el KMS con la opción de configuración del backend `crypto_engines.migrate_keys_format` renombra las claves cuyo nombre no es el digest SHA-256 de la clave pública, conserva el nombre antiguo como alias y traslada consigo las referencias de certificados. Es seguro volver a ejecutarla y puede desactivarse después.",{"_3170":66664,"_27782":66499,"_19244":114358,"_5":13232,"_26277":113926,"_2666":114359},[],"Los certificados referencian ahora su clave del KMS, y los roles VA referencian su certificado firmante, de modo que no se puede eliminar una clave o un certificado en uso. La migración del KMS descarta los metadatos de clave heredados `lamassu.io/kms/binded-resources`. La migración de CA registra las claves públicas de las CA eliminadas como claves del KMS sin clave privada; existen para satisfacer la referencia y es seguro eliminarlas.",{"_3170":66665,"_27782":66499,"_19244":114361,"_5":13232,"_26277":113934,"_2666":114362},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_3170":66666,"_27782":66499,"_19244":114364,"_5":13232,"_26277":113934,"_2666":114365},[],"Campo en 3.8.0",{"_3170":66667,"_27782":66499,"_19244":114367,"_5":13232,"_26277":113934,"_2666":114368},[],"Campo en 4.0.0",{"_3170":66668,"_27782":66499,"_19244":114370,"_5":13232,"_26277":113934,"_2666":53220},[],{"_3170":66669,"_27782":66499,"_19244":114372,"_5":13232,"_26277":113934,"_2666":114373},[],"`insecure_skip_verify` (con el valor negado)",{"_3170":66670,"_27782":66499,"_19244":114375,"_5":13232,"_26277":113934,"_2666":53226},[],{"_3170":66671,"_27782":66499,"_19244":114377,"_5":13232,"_26277":113934,"_2666":53229},[],{"_3170":66672,"_27782":66499,"_19244":114379,"_5":13232,"_26277":113934,"_2666":53232},[],{"_3170":66673,"_27782":66499,"_19244":114381,"_5":13232,"_26277":113934,"_2666":53235},[],{"_3170":66674,"_27782":66499,"_19244":114383,"_5":13232,"_26277":113934,"_2666":53238},[],{"_3170":66675,"_27782":66499,"_19244":114385,"_5":13232,"_26277":113934,"_2666":53241},[],{"_3170":66676,"_27782":66499,"_19244":114387,"_5":13232,"_26277":113934,"_2666":114388},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_3170":66677,"_27782":66499,"_19244":114390,"_5":13232,"_26277":113934,"_2666":114391},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3170":66678,"_27782":66499,"_19244":114393,"_5":13232,"_26277":113934,"_2666":114394},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3170":66679,"_27782":66499,"_19244":114396,"_5":13232,"_26277":113938,"_2666":114397},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3170":66680,"_27782":66499,"_19244":114399,"_5":13232,"_26277":113938,"_2666":114400},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3170":66681,"_27782":66499,"_19244":114402,"_5":13232,"_26277":113938,"_2666":114403},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3170":66682,"_27782":66499,"_19244":114405,"_5":13232,"_26277":113942,"_2666":114406},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. Si la versión de la consola no expone los ajustes independientes, edítalos mediante la API DMS.",{"_3170":66683,"_27782":66499,"_19244":114408,"_5":13232,"_26277":113946,"_2666":114409},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3170":66684,"_27782":66499,"_19244":114411,"_5":13232,"_26277":113950,"_2666":114412},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_3170":66685,"_27782":66499,"_19244":114414,"_5":13232,"_26277":113954,"_2666":114415},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3170":66686,"_27782":66499,"_19244":114417,"_5":13232,"_26277":113954,"_2666":114418},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3170":66687,"_27782":66499,"_19244":114420,"_5":13232,"_26277":113954,"_2666":114421},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3170":66688,"_27782":66499,"_19244":114423,"_5":13232,"_26277":113954,"_2666":114424},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza.",{"_3170":66689,"_27782":66499,"_19244":114426,"_5":13232,"_26277":113958,"_2666":114427},[],"`crl_options.subject_key_id_signer` se sustituye por el obligatorio `crl_options.signer_certificate_serial_number`, el número de serie del certificado existente que firma la CRL. El valor inicial de un rol nuevo es el número de serie del certificado actual de la CA. Las peticiones que aún contienen `subject_key_id_signer` devuelven un error. Las políticas de autorización personalizadas que filtran por el campo antiguo deben actualizarse: el filtro `crl_subject_key_id_signer` se renombra a `crl_signer_certificate_serial_number` y toma valores de número de serie.",{"_3170":66690,"_27782":66499,"_19244":114429,"_5":13232,"_26277":113962,"_2666":114430},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3170":66691,"_27782":66499,"_19244":114432,"_5":13232,"_26277":113966,"_2666":114433},[],"Haz una copia de seguridad verificable de PostgreSQL y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`.",{"_3170":66692,"_27782":66499,"_19244":114435,"_5":13232,"_26277":113966,"_2666":114436},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3170":66693,"_27782":66499,"_19244":114438,"_5":13232,"_26277":113966,"_2666":114439},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3170":66694,"_27782":66499,"_19244":114441,"_5":13232,"_26277":113966,"_2666":114442},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3170":66695,"_27782":66499,"_19244":114444,"_5":13232,"_26277":113966,"_2666":114445},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3170":66696,"_27782":66499,"_19244":114447,"_5":13232,"_26277":113970,"_2666":114448},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3170":66697,"_27782":66499,"_19244":114450,"_5":13232,"_26277":113970,"_2666":114451},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3170":66698,"_27782":66499,"_19244":114453,"_5":13232,"_26277":113970,"_2666":114454},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se lee el campo `database` de cada entrada; la conexión usa siempre los values globales `postgres.hostname`, `postgres.port`, `postgres.username` y `postgres.password`.",{"_3170":66699,"_27782":66499,"_19244":114456,"_5":13232,"_26277":113970,"_2666":114457},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3170":66700,"_27782":66499,"_19244":114459,"_5":13232,"_26277":113970,"_2666":114460},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3170":66701,"_27782":66499,"_19244":114462,"_5":13232,"_26277":113970,"_2666":114463},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3170":66702,"_27782":66499,"_19244":114465,"_5":13232,"_26277":113970,"_2666":114466},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3170":66703,"_27782":66499,"_19244":114468,"_5":13232,"_26277":113970,"_2666":114469},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3170":66704,"_27782":66499,"_19244":114471,"_5":13232,"_26277":113970,"_2666":114472},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3170":66705,"_27782":66499,"_19244":114474,"_5":13232,"_26277":113970,"_2666":114475},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3170":66706,"_27782":66499,"_19244":114477,"_5":13232,"_26277":113970,"_2666":114478},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3170":66707,"_27782":66499,"_19244":114480,"_5":13232,"_26277":113970,"_2666":114481},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida.",{"_3170":66708,"_27782":66499,"_19244":114483,"_5":13232,"_26277":113974,"_2666":114484},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_3170":66709,"_27782":66499,"_19244":114486,"_5":13232,"_26277":113974,"_2666":114487},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_3170":66710,"_27782":66499,"_19244":114489,"_5":13232,"_26277":113978,"_2666":114490},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3170":66711,"_27782":66499,"_19244":114492,"_5":13232,"_26277":113978,"_2666":114493},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3170":66712,"_27782":66499,"_19244":114495,"_5":13232,"_26277":113978,"_2666":114496},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3170":66713,"_27782":66499,"_19244":114498,"_5":13232,"_26277":113978,"_2666":114499},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_3170":66714,"_27782":66499,"_19244":114501,"_5":13232,"_26277":113978,"_2666":114502},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3170":66715,"_27782":66499,"_19244":114504,"_5":13232,"_26277":113978,"_2666":114505},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3170":66716,"_27782":66499,"_19244":114507,"_5":13232,"_26277":113978,"_2666":114508},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3170":66717,"_27782":66499,"_19244":114510,"_5":13232,"_26277":113978,"_2666":114511},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3170":66718,"_27782":66499,"_19244":114513,"_5":13232,"_26277":113978,"_2666":114514},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3170":66719,"_27782":66499,"_19244":114516,"_5":13232,"_26277":113978,"_2666":114517},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3170":66720,"_27782":66499,"_19244":114519,"_5":13232,"_26277":113978,"_2666":114520},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_3170":66721,"_27782":66499,"_19244":114522,"_5":13232,"_26277":113982,"_2666":114523},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3170":66722,"_27782":66499,"_19244":114525,"_5":13232,"_26277":113982,"_2666":114526},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3170":66723,"_27782":66499,"_19244":114528,"_5":13232,"_26277":113986,"_2666":114529},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3170":66724,"_27782":66499,"_19244":114531,"_5":13232,"_26277":113986,"_2666":114532},[],"Ejecuta las migraciones en el orden obligatorio, un esquema cada vez: primero `kms`, después la herramienta `ca-to-kms-migration` (necesaria solo en despliegues heredados cuyas claves de CA se nombran por SKI), luego `ca` y por último `va`. Los esquemas `devicemanager`, `dmsmanager` y `alerts` son independientes y pueden migrarse en cualquier orden. Con Helm, el job de preinstalación del chart aplica los esquemas en el orden correcto automáticamente.",{"_3170":66725,"_27782":66499,"_19244":114534,"_5":13232,"_26277":113986,"_2666":114535},[],"Los esquemas se referencian entre sí, así que el rol de PostgreSQL que ejecuta las migraciones necesita privilegios entre esquemas: el esquema `ca` necesita `USAGE` sobre `kms` más `SELECT`, `REFERENCES` e `INSERT` sobre `kms.kms_keys`, y el esquema `va` necesita `USAGE` sobre `ca` más `SELECT` y `REFERENCES` sobre `ca.certificates` y `SELECT` sobre `ca.ca_certificates`. Si tus servicios se conectan con un usuario distinto del que ejecutó las migraciones, concédele tras las migraciones `SELECT` sobre `ca.certificates_view`.",{"_3170":66726,"_27782":66499,"_19244":114537,"_5":13232,"_26277":113986,"_2666":114538},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3170":66727,"_27782":66499,"_19244":114540,"_5":13232,"_26277":113986,"_2666":114541},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3170":66728,"_27782":66499,"_19244":114543,"_5":13232,"_26277":113986,"_2666":114544},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_3170":66729,"_27782":66499,"_19244":114546,"_5":13232,"_26277":113986,"_2666":114547},[],"Los README de ambas herramientas documentan el layout de 4.0.0 con la base `pki` y coinciden con esta página: `goose-lamassu` usa ejemplos con `dbname=pki` y no valida el nombre de la base de datos, y el README de `ca-to-kms-migration` describe la base única `pki` y el orden de migración.",{"_3170":66730,"_27782":66499,"_19244":114549,"_5":13232,"_26277":113990,"_2666":114550},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3170":66731,"_27782":66499,"_19244":114552,"_5":13232,"_26277":113990,"_2666":114553},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_3170":66732,"_27782":66499,"_19244":114555,"_5":13232,"_26277":113990,"_2666":114556},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_3170":66733,"_27782":66499,"_19244":114558,"_5":13232,"_26277":113990,"_2666":114559},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3170":66734,"_27782":66499,"_19244":114561,"_5":13232,"_26277":113990,"_2666":114562},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó por IDs de CA duplicados o por valores de `engine_id` vacíos. Revisa los logs del job, corrige los permisos o los datos y vuelve a ejecutar la actualización.",{"_3170":66735,"_27782":66499,"_19244":114564,"_5":13232,"_26277":113990,"_2666":114565},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3170":66736,"_27782":66499,"_19244":114567,"_5":13232,"_26277":113990,"_2666":114568},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3170":66737,"_27782":66499,"_19244":114570,"_5":13232,"_26277":113990,"_2666":114571},[],"**Una migración aborta con `kms schema not found`.** Los esquemas deben migrarse en orden: ejecuta la migración del esquema `kms` antes que la del esquema `ca`.",{"_3170":66738,"_27782":66499,"_19244":114573,"_5":13232,"_26277":113990,"_2666":114574},[],"**Una migración aborta con `ca schema not found`.** Ejecuta la migración del esquema `ca` antes que la del esquema `va`.",{"_3170":66739,"_27782":66499,"_19244":114576,"_5":13232,"_26277":113990,"_2666":114577},[],"**La VA no arranca con `cannot resolve signer certificate for VA role ... N candidates`.** El certificado firmante del rol no puede identificarse de forma única entre N candidatos. Revisa los certificados que comparten el sujeto y la clave de la CA, y define en el rol `signer_certificate_serial_number` con el número de serie del firmante previsto.",{"_3170":66740,"_27782":66499,"_19244":114579,"_5":13232,"_26277":113990,"_2666":114580},[],"**Una migración o un servicio falla con `permission denied for table ...`.** Al rol de PostgreSQL le faltan los privilegios entre esquemas listados en Despliegues sin Helm; incluye `certificates_view` cuando se omitió el `GRANT SELECT` posterior a la migración. Concede los privilegios que falten y vuelve a ejecutar.",{"_3170":66741,"_27782":66499,"_19244":114582,"_5":13232,"_26277":113993,"_2666":114583},[],"Tras la actualización, comprueba en este orden:",{"_3170":66742,"_27782":66499,"_19244":114585,"_5":13232,"_26277":113993,"_2666":114586},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS, y las migraciones de claves foráneas que se ejecutan por esquema en el orden obligatorio.",{"_3170":66743,"_27782":66499,"_19244":114588,"_5":13232,"_26277":113993,"_2666":114589},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3170":66744,"_27782":66499,"_19244":114591,"_5":13232,"_26277":113993,"_2666":114592},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3170":66745,"_27782":66499,"_19244":114594,"_5":13232,"_26277":113993,"_2666":114595},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-ski>` sobre la VA devuelve una CRL emitida anteriormente, y se emiten CRLs nuevas.",{"_3170":66746,"_27782":66499,"_19244":114597,"_5":13232,"_26277":113993,"_2666":114598},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS.",{"_3170":66747,"_27782":66499,"_19244":114600,"_5":13232,"_26277":113993,"_2666":114601},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3170":66748,"_27782":66499,"_19244":114603,"_5":13232,"_26277":113993,"_2666":114604},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3170":66749,"_27782":66499,"_19244":114606,"_5":13232,"_26277":113993,"_2666":114607},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha.",{"_3170":66750,"_27782":66499,"_19244":114609,"_5":13232,"_26277":113993,"_2666":114610},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3170":66751,"_27782":66499,"_19244":114612,"_5":13232,"_26277":113993,"_2666":114613},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3170":66752,"_27782":66499,"_19244":114615,"_5":13232,"_26277":113993,"_2666":114616},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3170":66753,"_27782":66499,"_19244":114618,"_5":13232,"_26277":113993,"_2666":114619},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3170":66754,"_27782":66499,"_19244":114621,"_5":13232,"_26277":113993,"_2666":114622},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3170":66755,"_27782":66499,"_19244":114624,"_5":13232,"_26277":113993,"_2666":114625},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3170":66756,"_27782":66499,"_19244":114627,"_5":13232,"_26277":113997,"_2666":114628},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_3170":66757,"_27782":66499,"_19244":114630,"_5":13232,"_26277":113997,"_2666":114631},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3170":66758,"_27782":66499,"_19244":114633,"_5":13232,"_26277":113997,"_2666":114634},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3170":66759,"_27782":66499,"_19244":114636,"_5":13232,"_26277":113997,"_2666":114637},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_3170":66760,"_27782":66499,"_19244":114639,"_5":13232,"_26277":113997,"_2666":114640},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_53499":114642,"_53501":114643,"_53503":114644,"_53505":114645,"_16769":2701,"_64108":2701},"spanish",[2666,27782,5,26277],{"_2666":23022,"_27782":23022,"_5":23022,"_26277":23022},{"_2666":114646,"_27782":117295,"_5":119944,"_26277":122593},{"_4232":114647,"_53509":114648,"_5":23022},{"_13287":6329,"_13657":6634,"_13676":2908,"_26893":10949,"_13663":3114,"_18258":2937,"_13308":6937,"_13315":6636,"_26835":20619,"_27227":6115,"_27248":14714,"_26853":5036,"_31900":9509,"_27259":3112,"_27288":2714,"_31907":27345,"_31910":3115,"_31913":10154,"_31916":9094,"_27635":4702,"_31921":4301,"_31923":13249,"_27665":5431,"_13672":14504,"_31927":14534,"_31930":2955,"_31932":7459,"_27277":8776,"_27630":6811,"_27689":7624,"_31937":6371,"_31939":7151,"_31941":13284,"_31943":5734,"_31945":21739,"_31947":15186,"_31949":3259,"_31951":6989,"_31953":4319,"_26906":5069,"_31956":6422,"_31958":6347,"_26900":4010,"_31961":4287,"_31963":6855,"_31965":2846,"_31968":9528,"_26946":2951,"_31972":4458,"_26826":8317,"_31975":5517,"_26858":15921,"_31978":15062,"_31980":16561,"_31983":20955,"_13666":5420,"_31986":4181,"_31988":19702,"_31991":15920,"_31993":18697,"_31995":10868,"_31997":4355,"_31999":6498,"_18261":3035,"_32002":3349,"_32004":6539,"_26879":3997,"_27271":6341,"_32008":19997,"_32010":6786,"_32012":2999,"_27695":3042,"_32015":3598,"_32017":7127,"_32019":21507,"_27762":4304,"_27304":7129,"_32023":2912,"_32025":3883,"_26868":3369,"_32028":5402,"_32030":3045,"_32032":17838,"_27700":3071,"_26966":7855,"_26341":9352,"_32037":6323,"_32039":13735,"_32041":3832,"_27003":14936,"_32045":4338,"_27265":3028,"_32049":2738,"_32051":11269,"_32053":22839,"_32055":20187,"_32057":3389,"_32059":6791,"_269