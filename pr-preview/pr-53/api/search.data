610":57131},{"_3381":15,"_29612":15,"_5":14455,"_2867":48229,"_29965":48230,"_20544":48234,"_26932":15},"Deploy from AWS Marketplace",[48231,48232,48233],"Docs","Deployment","Other models",[],{"_3381":16,"_29612":15,"_20544":48236,"_5":14097,"_26932":15,"_2867":48237},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_3381":17,"_29612":15,"_5":29962,"_20544":48239,"_26932":48240,"_2867":48241},[],"/docs/pr-preview/pr-53/deployment/aws-marketplace#before-you-begin","Before you begin",{"_3381":18,"_29612":15,"_5":29962,"_20544":48243,"_26932":48244,"_2867":48245},[],"/docs/pr-preview/pr-53/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_3381":19,"_29612":15,"_5":29962,"_20544":48247,"_26932":48248,"_2867":48249},[],"/docs/pr-preview/pr-53/deployment/aws-marketplace#open-the-offer","Open the offer",{"_3381":20,"_29612":15,"_5":29962,"_20544":48251,"_26932":48252,"_2867":48253},[],"/docs/pr-preview/pr-53/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_3381":21,"_29612":15,"_5":29962,"_20544":48255,"_26932":48256,"_2867":48257},[],"/docs/pr-preview/pr-53/deployment/aws-marketplace#limit-network-access","Limit network access",{"_3381":22,"_29612":15,"_5":29962,"_20544":48259,"_26932":48260,"_2867":48261},[],"/docs/pr-preview/pr-53/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_3381":23,"_29612":15,"_5":29962,"_20544":48263,"_26932":48264,"_2867":48265},[],"/docs/pr-preview/pr-53/deployment/aws-marketplace#next-step","Next step",{"_3381":24,"_29612":15,"_20544":48267,"_5":14097,"_26932":15,"_2867":48268},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_3381":25,"_29612":15,"_20544":48270,"_5":14097,"_26932":48240,"_2867":48271},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_3381":26,"_29612":15,"_20544":48273,"_5":14097,"_26932":48240,"_2867":48274},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_3381":27,"_29612":15,"_20544":48276,"_5":14097,"_26932":48240,"_2867":48277},[],"A security group allowing the necessary endpoints.",{"_3381":28,"_29612":15,"_20544":48279,"_5":14097,"_26932":48244,"_2867":48280},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_3381":29,"_29612":15,"_20544":48282,"_5":14097,"_26932":48244,"_2867":48283},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_3381":30,"_29612":15,"_20544":48285,"_5":14097,"_26932":48244,"_2867":48286},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_3381":31,"_29612":15,"_20544":48288,"_5":14097,"_26932":48248,"_2867":48289},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_3381":32,"_29612":15,"_20544":48291,"_5":14097,"_26932":48252,"_2867":48292},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_3381":33,"_29612":15,"_20544":48294,"_5":14097,"_26932":48256,"_2867":48295},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_3381":34,"_29612":15,"_20544":48297,"_5":14097,"_26932":48260,"_2867":48298},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_3381":35,"_29612":15,"_20544":48300,"_5":14097,"_26932":48264,"_2867":48301},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_3381":36,"_29612":36,"_5":14455,"_2867":48303,"_29965":48304,"_20544":48305,"_26932":36},"Deploy Lamassu",[48231,48232],[],{"_3381":37,"_29612":36,"_20544":48307,"_5":14097,"_26932":36,"_2867":48308},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_3381":38,"_29612":36,"_5":29962,"_20544":48310,"_26932":48311,"_2867":48312},[],"/docs/pr-preview/pr-53/deployment/overview#choose-a-model","Choose a model",{"_3381":39,"_29612":36,"_5":29962,"_20544":48314,"_26932":48315,"_2867":48316},[],"/docs/pr-preview/pr-53/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_3381":40,"_29612":36,"_5":29962,"_20544":48318,"_26932":48319,"_2867":48320},[],"/docs/pr-preview/pr-53/deployment/overview#after-deployment","After deployment",{"_3381":41,"_29612":36,"_20544":48322,"_5":14097,"_26932":36,"_2867":48323},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_3381":42,"_29612":36,"_20544":48325,"_5":14097,"_26932":48311,"_2867":48326},[],"Model",{"_3381":43,"_29612":36,"_20544":48328,"_5":14097,"_26932":48311,"_2867":48329},[],"Recommended for",{"_3381":44,"_29612":36,"_20544":48331,"_5":14097,"_26932":48311,"_2867":48332},[],"Who operates the infrastructure",{"_3381":45,"_29612":36,"_20544":48334,"_5":14097,"_26932":48311,"_2867":48335},[],"Starting point",{"_3381":46,"_29612":36,"_20544":48337,"_5":14097,"_26932":48311,"_2867":48338},[],"Kubernetes self-managed",{"_3381":47,"_29612":36,"_20544":48340,"_5":14097,"_26932":48311,"_2867":48341},[],"Production, regulated environments and custom deployments",{"_3381":48,"_29612":36,"_20544":48343,"_5":14097,"_26932":48311,"_2867":48344},[],"Your team",{"_3381":49,"_29612":36,"_20544":48346,"_5":14097,"_26932":48311,"_2867":48347},[],"Helm or Fastlane",{"_3381":50,"_29612":36,"_20544":48349,"_5":14097,"_26932":48311,"_2867":48350},[],"AWS Marketplace",{"_3381":51,"_29612":36,"_20544":48352,"_5":14097,"_26932":48311,"_2867":48353},[],"Evaluation or a dedicated deployment inside an AWS account",{"_3381":52,"_29612":36,"_20544":48355,"_5":14097,"_26932":48311,"_2867":48344},[],{"_3381":53,"_29612":36,"_20544":48357,"_5":14097,"_26932":48311,"_2867":48358},[],"Preconfigured image on EC2",{"_3381":54,"_29612":36,"_20544":48360,"_5":14097,"_26932":48311,"_2867":48361},[],"SaaS",{"_3381":55,"_29612":36,"_20544":48363,"_5":14097,"_26932":48311,"_2867":48364},[],"Teams that want to use the platform without operating it",{"_3381":56,"_29612":36,"_20544":48366,"_5":14097,"_26932":48311,"_2867":48367},[],"Lamassu",{"_3381":57,"_29612":36,"_20544":48369,"_5":14097,"_26932":48311,"_2867":48370},[],"Managed subscription",{"_3381":58,"_29612":36,"_20544":48372,"_5":14097,"_26932":48311,"_2867":48373},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3381":59,"_29612":36,"_20544":48375,"_5":14097,"_26932":48311,"_2867":48376},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3381":60,"_29612":36,"_20544":48378,"_5":14097,"_26932":48311,"_2867":48379},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_3381":61,"_29612":36,"_20544":48381,"_5":14097,"_26932":48315,"_2867":48382},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_3381":62,"_29612":36,"_20544":48384,"_5":14097,"_26932":48319,"_2867":48385},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_3381":63,"_29612":63,"_5":14455,"_2867":48387,"_29965":48388,"_20544":48389,"_26932":63},"Use Lamassu as SaaS",[48231,48232,48233],[],{"_3381":64,"_29612":63,"_20544":48391,"_5":14097,"_26932":63,"_2867":48392},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_3381":65,"_29612":63,"_5":29962,"_20544":48394,"_26932":48395,"_2867":48396},[],"/docs/pr-preview/pr-53/deployment/saas#what-the-service-manages","What the service manages",{"_3381":66,"_29612":63,"_5":29962,"_20544":48398,"_26932":48399,"_2867":48400},[],"/docs/pr-preview/pr-53/deployment/saas#plans","Plans",{"_3381":67,"_29612":63,"_5":29962,"_20544":48402,"_26932":48403,"_2867":48404},[],"/docs/pr-preview/pr-53/deployment/saas#request-access","Request access",{"_3381":68,"_29612":63,"_20544":48406,"_5":14097,"_26932":63,"_2867":48407},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_3381":69,"_29612":63,"_20544":48409,"_5":14097,"_26932":48395,"_2867":48410},[],"Platform availability and maintenance.",{"_3381":70,"_29612":63,"_20544":48412,"_5":14097,"_26932":48395,"_2867":48413},[],"Automatic backups.",{"_3381":71,"_29612":63,"_20544":48415,"_5":14097,"_26932":48395,"_2867":48416},[],"Version upgrades.",{"_3381":72,"_29612":63,"_20544":48418,"_5":14097,"_26932":48395,"_2867":48419},[],"Technical support and SLA according to your plan.",{"_3381":73,"_29612":63,"_20544":48421,"_5":14097,"_26932":48399,"_2867":48422},[],"Plan",{"_3381":74,"_29612":63,"_20544":48424,"_5":14097,"_26932":48399,"_2867":48425},[],"Devices",{"_3381":75,"_29612":63,"_20544":48427,"_5":14097,"_26932":48399,"_2867":48428},[],"Support",{"_3381":76,"_29612":63,"_20544":48430,"_5":14097,"_26932":48399,"_2867":48431},[],"SLA",{"_3381":77,"_29612":63,"_20544":48433,"_5":14097,"_26932":48399,"_2867":48434},[],"Starter",{"_3381":78,"_29612":63,"_20544":48436,"_5":14097,"_26932":48399,"_2867":48437},[],"Up to 1,000",{"_3381":79,"_29612":63,"_20544":48439,"_5":14097,"_26932":48399,"_2867":48440},[],"Email",{"_3381":80,"_29612":63,"_20544":48442,"_5":14097,"_26932":48399,"_2867":48443},[],"99.5 %",{"_3381":81,"_29612":63,"_20544":48445,"_5":14097,"_26932":48399,"_2867":48446},[],"Professional",{"_3381":82,"_29612":63,"_20544":48448,"_5":14097,"_26932":48399,"_2867":48449},[],"Up to 10,000",{"_3381":83,"_29612":63,"_20544":48451,"_5":14097,"_26932":48399,"_2867":48452},[],"Email and chat",{"_3381":84,"_29612":63,"_20544":48454,"_5":14097,"_26932":48399,"_2867":48455},[],"99.9 %",{"_3381":85,"_29612":63,"_20544":48457,"_5":14097,"_26932":48399,"_2867":48458},[],"Enterprise",{"_3381":86,"_29612":63,"_20544":48460,"_5":14097,"_26932":48399,"_2867":48461},[],"Unlimited",{"_3381":87,"_29612":63,"_20544":48463,"_5":14097,"_26932":48399,"_2867":48464},[],"Dedicated",{"_3381":88,"_29612":63,"_20544":48466,"_5":14097,"_26932":48399,"_2867":48467},[],"99.99 %",{"_3381":89,"_29612":63,"_20544":48469,"_5":14097,"_26932":48403,"_2867":48470},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_3381":90,"_29612":63,"_20544":48472,"_5":14097,"_26932":48403,"_2867":48473},[],"When you receive your instance's credentials, continue with Get started.",{"_3381":91,"_29612":91,"_5":14455,"_2867":48475,"_29965":48476,"_20544":48477,"_26932":91},"Fastlane",[48231,48232,48338],[],{"_3381":92,"_29612":91,"_20544":48479,"_5":14097,"_26932":91,"_2867":48480},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_3381":93,"_29612":91,"_5":29962,"_20544":48482,"_26932":48483,"_2867":48484},[],"/docs/pr-preview/pr-53/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_3381":94,"_29612":91,"_5":29962,"_20544":48486,"_26932":48487,"_2867":48488},[],"/docs/pr-preview/pr-53/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_3381":95,"_29612":91,"_5":29962,"_20544":48490,"_26932":48491,"_2867":48241},[],"/docs/pr-preview/pr-53/deployment/self-hosted/fastlane#before-you-begin",{"_3381":96,"_29612":91,"_5":29962,"_20544":48493,"_26932":48494,"_2867":48495},[],"/docs/pr-preview/pr-53/deployment/self-hosted/fastlane#quick-start","Quick start",{"_3381":97,"_29612":91,"_5":29962,"_20544":48497,"_26932":48498,"_2867":48499},[],"/docs/pr-preview/pr-53/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_3381":98,"_29612":91,"_5":29962,"_20544":48501,"_26932":48502,"_2867":48503},[],"/docs/pr-preview/pr-53/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_3381":99,"_29612":91,"_5":29962,"_20544":48505,"_26932":48506,"_2867":48507},[],"/docs/pr-preview/pr-53/deployment/self-hosted/fastlane#development-mode","Development mode",{"_3381":100,"_29612":91,"_5":29962,"_20544":48509,"_26932":48510,"_2867":48511},[],"/docs/pr-preview/pr-53/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_3381":101,"_29612":91,"_5":29962,"_20544":48513,"_26932":48514,"_2867":48515},[],"/docs/pr-preview/pr-53/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_3381":102,"_29612":91,"_5":29962,"_20544":48517,"_26932":48518,"_2867":48519},[],"/docs/pr-preview/pr-53/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_3381":103,"_29612":91,"_5":29962,"_20544":48521,"_26932":48522,"_2867":48523},[],"/docs/pr-preview/pr-53/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_3381":104,"_29612":91,"_20544":48525,"_5":14097,"_26932":48483,"_2867":48526},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_3381":105,"_29612":91,"_20544":48528,"_5":14097,"_26932":48483,"_2867":48529},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_3381":106,"_29612":91,"_20544":48531,"_5":14097,"_26932":48487,"_2867":48532},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_3381":107,"_29612":91,"_20544":48534,"_5":14097,"_26932":48487,"_2867":48535},[],"Fastlane installs or configures",{"_3381":108,"_29612":91,"_20544":48537,"_5":14097,"_26932":48487,"_2867":48538},[],"You still provide",{"_3381":109,"_29612":91,"_20544":48540,"_5":14097,"_26932":48487,"_2867":48541},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_3381":110,"_29612":91,"_20544":48543,"_5":14097,"_26932":48487,"_2867":48544},[],"The Kubernetes cluster, nodes and persistent storage",{"_3381":111,"_29612":91,"_20544":48546,"_5":14097,"_26932":48487,"_2867":48547},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_3381":112,"_29612":91,"_20544":48549,"_5":14097,"_26932":48487,"_2867":48550},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_3381":113,"_29612":91,"_20544":48552,"_5":14097,"_26932":48487,"_2867":48553},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_3381":114,"_29612":91,"_20544":48555,"_5":14097,"_26932":48487,"_2867":48556},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_3381":115,"_29612":91,"_20544":48558,"_5":14097,"_26932":48487,"_2867":48559},[],"Optional observability and lab HSM components",{"_3381":116,"_29612":91,"_20544":48561,"_5":14097,"_26932":48487,"_2867":48562},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_3381":117,"_29612":91,"_20544":48564,"_5":14097,"_26932":48487,"_2867":48565},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_3381":118,"_29612":91,"_20544":48567,"_5":14097,"_26932":48491,"_2867":48568},[],"You need:",{"_3381":119,"_29612":91,"_20544":48570,"_5":14097,"_26932":48491,"_2867":48571},[],"an existing Kubernetes cluster",{"_3381":120,"_29612":91,"_20544":48573,"_5":14097,"_26932":48491,"_2867":48574},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_3381":121,"_29612":91,"_20544":48576,"_5":14097,"_26932":48491,"_2867":48577},[],"`yq`",{"_3381":122,"_29612":91,"_20544":48579,"_5":14097,"_26932":48491,"_2867":23225},[],{"_3381":123,"_29612":91,"_20544":48581,"_5":14097,"_26932":48491,"_2867":48582},[],"`jq` only when using `--sample-data` or `--development`",{"_3381":124,"_29612":91,"_20544":48584,"_5":14097,"_26932":48491,"_2867":48585},[],"`ssh-keygen` only when using `--with-hsm`",{"_3381":125,"_29612":91,"_20544":48587,"_5":14097,"_26932":48491,"_2867":48588},[],"free external ports 80 and 443 on a single-node K3s host",{"_3381":126,"_29612":91,"_20544":48590,"_5":14097,"_26932":48491,"_2867":48591},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_3381":127,"_29612":91,"_20544":48593,"_5":14097,"_26932":48491,"_2867":48594},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_3381":128,"_29612":91,"_20544":48596,"_5":14097,"_26932":48494,"_2867":48597},[],"Run the script from a clone of the Helm repository:",{"_3381":129,"_29612":91,"_20544":48599,"_5":14097,"_26932":48494,"_2867":48600},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_3381":130,"_29612":91,"_20544":48602,"_5":14097,"_26932":48498,"_2867":48603},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_3381":131,"_29612":91,"_20544":48605,"_5":14097,"_26932":48498,"_2867":48606},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_3381":132,"_29612":91,"_20544":48608,"_5":14097,"_26932":48498,"_2867":48609},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_3381":133,"_29612":91,"_20544":48611,"_5":14097,"_26932":48498,"_2867":48612},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_3381":134,"_29612":91,"_20544":48614,"_5":14097,"_26932":48502,"_2867":48615},[],"Option",{"_3381":135,"_29612":91,"_20544":48617,"_5":14097,"_26932":48502,"_2867":48618},[],"Default",{"_3381":136,"_29612":91,"_20544":48620,"_5":14097,"_26932":48502,"_2867":48621},[],"Purpose",{"_3381":137,"_29612":91,"_20544":48623,"_5":14097,"_26932":48502,"_2867":48624},[],"`-h`, `--help`",{"_3381":138,"_29612":91,"_20544":48626,"_5":14097,"_26932":48502,"_2867":48627},[],"—",{"_3381":139,"_29612":91,"_20544":48629,"_5":14097,"_26932":48502,"_2867":48630},[],"Show help",{"_3381":140,"_29612":91,"_20544":48632,"_5":14097,"_26932":48502,"_2867":48633},[],"`-c`, `--context`",{"_3381":141,"_29612":91,"_20544":48635,"_5":14097,"_26932":48502,"_2867":48636},[],"current context",{"_3381":142,"_29612":91,"_20544":48638,"_5":14097,"_26932":48502,"_2867":48639},[],"Select the kubeconfig context for kubectl and Helm",{"_3381":143,"_29612":91,"_20544":48641,"_5":14097,"_26932":48502,"_2867":48642},[],"`-n`, `--non-interactive`",{"_3381":144,"_29612":91,"_20544":48644,"_5":14097,"_26932":48502,"_2867":6391},[],{"_3381":145,"_29612":91,"_20544":48646,"_5":14097,"_26932":48502,"_2867":48647},[],"Skip prompts and generate dependency credentials",{"_3381":146,"_29612":91,"_20544":48649,"_5":14097,"_26932":48502,"_2867":48650},[],"`-ns`, `--namespace`",{"_3381":147,"_29612":91,"_20544":48652,"_5":14097,"_26932":48502,"_2867":48653},[],"`lamassu-dev`",{"_3381":148,"_29612":91,"_20544":48655,"_5":14097,"_26932":48502,"_2867":48656},[],"Namespace for the installation",{"_3381":149,"_29612":91,"_20544":48658,"_5":14097,"_26932":48502,"_2867":48659},[],"`-d`, `--domain`",{"_3381":150,"_29612":91,"_20544":48661,"_5":14097,"_26932":48502,"_2867":48662},[],"`dev.lamassu.io`",{"_3381":151,"_29612":91,"_20544":48664,"_5":14097,"_26932":48502,"_2867":48665},[],"Domain used by the UI, OIDC and certificate",{"_3381":152,"_29612":91,"_20544":48667,"_5":14097,"_26932":48502,"_2867":48668},[],"`-v`, `--version`",{"_3381":153,"_29612":91,"_20544":48670,"_5":14097,"_26932":48502,"_2867":14789},[],{"_3381":154,"_29612":91,"_20544":48672,"_5":14097,"_26932":48502,"_2867":48673},[],"Lamassu chart version",{"_3381":155,"_29612":91,"_20544":48675,"_5":14097,"_26932":48502,"_2867":48676},[],"`--https-port`",{"_3381":156,"_29612":91,"_20544":48678,"_5":14097,"_26932":48502,"_2867":48679},[],"`443`",{"_3381":157,"_29612":91,"_20544":48681,"_5":14097,"_26932":48502,"_2867":48682},[],"Gateway HTTPS listener port",{"_3381":158,"_29612":91,"_20544":48684,"_5":14097,"_26932":48502,"_2867":48685},[],"`--http-port`",{"_3381":159,"_29612":91,"_20544":48687,"_5":14097,"_26932":48502,"_2867":48688},[],"`80`",{"_3381":160,"_29612":91,"_20544":48690,"_5":14097,"_26932":48502,"_2867":48691},[],"Gateway HTTP listener port",{"_3381":161,"_29612":91,"_20544":48693,"_5":14097,"_26932":48502,"_2867":48694},[],"`--tls-crt`",{"_3381":162,"_29612":91,"_20544":48696,"_5":14097,"_26932":48502,"_2867":48627},[],{"_3381":163,"_29612":91,"_20544":48698,"_5":14097,"_26932":48502,"_2867":48699},[],"PEM certificate for downstream TLS",{"_3381":164,"_29612":91,"_20544":48701,"_5":14097,"_26932":48502,"_2867":48702},[],"`--tls-key`",{"_3381":165,"_29612":91,"_20544":48704,"_5":14097,"_26932":48502,"_2867":48627},[],{"_3381":166,"_29612":91,"_20544":48706,"_5":14097,"_26932":48502,"_2867":48707},[],"PEM private key for downstream TLS",{"_3381":167,"_29612":91,"_20544":48709,"_5":14097,"_26932":48502,"_2867":48710},[],"`-l`, `--local-chart-path`",{"_3381":168,"_29612":91,"_20544":48712,"_5":14097,"_26932":48502,"_2867":48713},[],"repository chart",{"_3381":169,"_29612":91,"_20544":48715,"_5":14097,"_26932":48502,"_2867":48716},[],"Use an unpacked local Lamassu chart",{"_3381":170,"_29612":91,"_20544":48718,"_5":14097,"_26932":48502,"_2867":48719},[],"`-ip`, `--gateway-ip`",{"_3381":171,"_29612":91,"_20544":48721,"_5":14097,"_26932":48502,"_2867":8559},[],{"_3381":172,"_29612":91,"_20544":48723,"_5":14097,"_26932":48502,"_2867":48724},[],"Override the address written to `gateway.addresses`",{"_3381":173,"_29612":91,"_20544":48726,"_5":14097,"_26932":48502,"_2867":48727},[],"`--otel`",{"_3381":174,"_29612":91,"_20544":48729,"_5":14097,"_26932":48502,"_2867":6391},[],{"_3381":175,"_29612":91,"_20544":48731,"_5":14097,"_26932":48502,"_2867":48732},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_3381":176,"_29612":91,"_20544":48734,"_5":14097,"_26932":48502,"_2867":48735},[],"`--development`",{"_3381":177,"_29612":91,"_20544":48737,"_5":14097,"_26932":48502,"_2867":6391},[],{"_3381":178,"_29612":91,"_20544":48739,"_5":14097,"_26932":48502,"_2867":48740},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_3381":179,"_29612":91,"_20544":48742,"_5":14097,"_26932":48502,"_2867":48743},[],"`--sample-data`",{"_3381":180,"_29612":91,"_20544":48745,"_5":14097,"_26932":48502,"_2867":6391},[],{"_3381":181,"_29612":91,"_20544":48747,"_5":14097,"_26932":48502,"_2867":48748},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_3381":182,"_29612":91,"_20544":48750,"_5":14097,"_26932":48502,"_2867":48751},[],"`--with-hsm`",{"_3381":183,"_29612":91,"_20544":48753,"_5":14097,"_26932":48502,"_2867":6391},[],{"_3381":184,"_29612":91,"_20544":48755,"_5":14097,"_26932":48502,"_2867":48756},[],"Install lab HSM components and configure KMS for PKCS#11",{"_3381":185,"_29612":91,"_20544":48758,"_5":14097,"_26932":48502,"_2867":48759},[],"`--softhsm-chart-path`",{"_3381":186,"_29612":91,"_20544":48761,"_5":14097,"_26932":48502,"_2867":48762},[],"`./charts/softhsm`",{"_3381":187,"_29612":91,"_20544":48764,"_5":14097,"_26932":48502,"_2867":48765},[],"Use a different local SoftHSM chart",{"_3381":188,"_29612":91,"_20544":48767,"_5":14097,"_26932":48502,"_2867":48768},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_3381":189,"_29612":91,"_20544":48770,"_5":14097,"_26932":48506,"_2867":48771},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_3381":190,"_29612":91,"_20544":48773,"_5":14097,"_26932":48506,"_2867":48774},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_3381":191,"_29612":91,"_20544":48776,"_5":14097,"_26932":48506,"_2867":48777},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_3381":192,"_29612":91,"_20544":48779,"_5":14097,"_26932":48506,"_2867":48780},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_3381":193,"_29612":91,"_20544":48782,"_5":14097,"_26932":48506,"_2867":48783},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_3381":194,"_29612":91,"_20544":48785,"_5":14097,"_26932":48506,"_2867":48786},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_3381":195,"_29612":91,"_20544":48788,"_5":14097,"_26932":48510,"_2867":48789},[],"Fastlane:",{"_3381":196,"_29612":91,"_20544":48791,"_5":14097,"_26932":48510,"_2867":48792},[],"validates local tools and the selected cluster",{"_3381":197,"_29612":91,"_20544":48794,"_5":14097,"_26932":48510,"_2867":48795},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_3381":198,"_29612":91,"_20544":48797,"_5":14097,"_26932":48510,"_2867":48798},[],"creates the namespace",{"_3381":199,"_29612":91,"_20544":48800,"_5":14097,"_26932":48510,"_2867":48801},[],"installs PostgreSQL and creates the required databases",{"_3381":200,"_29612":91,"_20544":48803,"_5":14097,"_26932":48510,"_2867":48804},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_3381":201,"_29612":91,"_20544":48806,"_5":14097,"_26932":48510,"_2867":48807},[],"installs RabbitMQ",{"_3381":202,"_29612":91,"_20544":48809,"_5":14097,"_26932":48510,"_2867":48810},[],"optionally installs observability and lab HSM components",{"_3381":203,"_29612":91,"_20544":48812,"_5":14097,"_26932":48510,"_2867":48813},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_3381":204,"_29612":91,"_20544":48815,"_5":14097,"_26932":48510,"_2867":48816},[],"optionally loads sample data",{"_3381":205,"_29612":91,"_20544":48818,"_5":14097,"_26932":48510,"_2867":48819},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_3381":206,"_29612":91,"_20544":48821,"_5":14097,"_26932":48514,"_2867":48822},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_3381":207,"_29612":91,"_20544":48824,"_5":14097,"_26932":48514,"_2867":48825},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_3381":208,"_29612":91,"_20544":48827,"_5":14097,"_26932":48518,"_2867":48828},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_3381":209,"_29612":91,"_20544":48830,"_5":14097,"_26932":48518,"_2867":48831},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_3381":210,"_29612":91,"_20544":48833,"_5":14097,"_26932":48518,"_2867":48834},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_3381":211,"_29612":91,"_20544":48836,"_5":14097,"_26932":48522,"_2867":48837},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_3381":212,"_29612":212,"_5":14455,"_2867":48839,"_29965":48840,"_20544":48841,"_26932":212},"Install with Helm",[48231,48232,48338],[],{"_3381":213,"_29612":212,"_20544":48843,"_5":14097,"_26932":212,"_2867":48844},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_3381":214,"_29612":212,"_5":29962,"_20544":48846,"_26932":48847,"_2867":48848},[],"/docs/pr-preview/pr-53/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_3381":215,"_29612":212,"_5":29962,"_20544":48850,"_26932":48851,"_2867":48241},[],"/docs/pr-preview/pr-53/deployment/self-hosted/helm#before-you-begin",{"_3381":216,"_29612":212,"_5":29962,"_20544":48853,"_26932":48854,"_2867":48855},[],"/docs/pr-preview/pr-53/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_3381":217,"_29612":212,"_5":29962,"_20544":48857,"_26932":48858,"_2867":48859},[],"/docs/pr-preview/pr-53/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_3381":218,"_29612":212,"_5":29962,"_20544":48861,"_26932":48862,"_2867":48863},[],"/docs/pr-preview/pr-53/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_3381":219,"_29612":212,"_5":29962,"_20544":48865,"_26932":48866,"_2867":48867},[],"/docs/pr-preview/pr-53/deployment/self-hosted/helm#amqp-tls-amqps","AMQP TLS (AMQPS)",{"_3381":220,"_29612":212,"_5":29962,"_20544":48869,"_26932":48870,"_2867":48871},[],"/docs/pr-preview/pr-53/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_3381":221,"_29612":212,"_5":29962,"_20544":48873,"_26932":48874,"_2867":48875},[],"/docs/pr-preview/pr-53/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_3381":222,"_29612":212,"_5":29962,"_20544":48877,"_26932":48878,"_2867":48879},[],"/docs/pr-preview/pr-53/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_3381":223,"_29612":212,"_5":29962,"_20544":48881,"_26932":48882,"_2867":48883},[],"/docs/pr-preview/pr-53/deployment/self-hosted/helm#upgrading-lamassu","Upgrading Lamassu",{"_3381":224,"_29612":212,"_5":29962,"_20544":48885,"_26932":48886,"_2867":48887},[],"/docs/pr-preview/pr-53/deployment/self-hosted/helm#production-decisions","Production decisions",{"_3381":225,"_29612":212,"_20544":48889,"_5":14097,"_26932":48847,"_2867":48890},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_3381":226,"_29612":212,"_20544":48892,"_5":14097,"_26932":48851,"_2867":48893},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_3381":227,"_29612":212,"_20544":48895,"_5":14097,"_26932":48851,"_2867":48896},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_3381":228,"_29612":212,"_20544":48898,"_5":14097,"_26932":48851,"_2867":48899},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_3381":229,"_29612":212,"_20544":48901,"_5":14097,"_26932":48851,"_2867":48902},[],"a reachable RabbitMQ broker and credentials",{"_3381":230,"_29612":212,"_20544":48904,"_5":14097,"_26932":48851,"_2867":48905},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_3381":231,"_29612":212,"_20544":48907,"_5":14097,"_26932":48851,"_2867":48908},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_3381":232,"_29612":212,"_20544":48910,"_5":14097,"_26932":48851,"_2867":48911},[],"cert-manager 1.14+ (only for the default `tls.type: certManager` mode); for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_3381":233,"_29612":212,"_20544":48913,"_5":14097,"_26932":48851,"_2867":48914},[],"a StorageClass and an external traffic design",{"_3381":234,"_29612":212,"_20544":48916,"_5":14097,"_26932":48851,"_2867":48917},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_3381":235,"_29612":212,"_20544":48919,"_5":14097,"_26932":48851,"_2867":48920},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_3381":236,"_29612":212,"_20544":48922,"_5":14097,"_26932":48851,"_2867":48923},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_3381":237,"_29612":212,"_20544":48925,"_5":14097,"_26932":48854,"_2867":48926},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_3381":238,"_29612":212,"_20544":48928,"_5":14097,"_26932":48854,"_2867":48929},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_3381":239,"_29612":212,"_20544":48931,"_5":14097,"_26932":48854,"_2867":48932},[],"Install cert-manager separately before Lamassu, but only for the default `tls.type: certManager` mode. In that mode the chart renders its self-signed Issuer and CA Certificate resources regardless of whether `tls.certManagerOptions.clusterIssuer` is set, so cert-manager stays a prerequisite. With `tls.type: external`, the chart renders no cert-manager resources and the Gateway terminates TLS with an existing Secret you provide instead.",{"_3381":240,"_29612":212,"_20544":48934,"_5":14097,"_26932":48858,"_2867":48935},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_3381":241,"_29612":212,"_20544":48937,"_5":14097,"_26932":48858,"_2867":48938},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_3381":242,"_29612":212,"_20544":48940,"_5":14097,"_26932":48858,"_2867":48941},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_3381":243,"_29612":212,"_20544":48943,"_5":14097,"_26932":48858,"_2867":48944},[],"If your values file still carries the legacy gateway JWT validation settings — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` or `auth.authorization.roles.admin` — remove them. The migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documents their removal with no compatibility aliases, and `values.schema.json` rejects the leftover blocks instead of silently ignoring them. The replacements are `services.authz.jwkUrl` and `services.authz.bootstrap`, already shown in the example above.",{"_3381":244,"_29612":212,"_20544":48946,"_5":14097,"_26932":48862,"_2867":48947},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it. The Secret must already exist before installing: in `external` mode the chart renders no cert-manager resources and never creates this Secret.",{"_3381":245,"_29612":212,"_20544":48949,"_5":14097,"_26932":48866,"_2867":48950},[],"`amqp.tls: true` selects AMQPS in every event-bus configuration block. The default port stays `5672` and does not change automatically when TLS is enabled, so set `amqp.port` to the broker's TLS listener, commonly `5671`.",{"_3381":246,"_29612":212,"_20544":48952,"_5":14097,"_26932":48866,"_2867":48953},[],"With no CA Secret configured, the event-bus clients use the system-trusted CAs. To trust a private CA, create a Secret in the release namespace containing the CA certificate in PEM format and set `amqp.ca.secretName` (and `amqp.ca.certificateKey` if the data key is not `ca.crt`).",{"_3381":247,"_29612":212,"_20544":48955,"_5":14097,"_26932":48866,"_2867":48956},[],"For brokers that require mutual TLS, create a Secret containing the client certificate and private key and set `amqp.client.secretName` (with `amqp.client.certificateKey` and `amqp.client.privateKeyKey` if the data keys are not `tls.crt` and `tls.key`).",{"_3381":248,"_29612":212,"_20544":48958,"_5":14097,"_26932":48866,"_2867":48959},[],"The chart mounts configured Secrets read-only into every AMQP-consuming workload: the CA certificate under `/etc/lamassu/amqp/ca` and the client certificate and key under `/etc/lamassu/amqp/client`. The mounted file names are always `ca.crt`, `tls.crt` and `tls.key` — the `certificateKey` and `privateKeyKey` values rename only the Secret data keys, never the on-disk paths. The client private key is mounted with restrictive permissions (`defaultMode: 0440`; the CA volume uses `0444`), which works because the chart adds `fsGroup` to the pod security context when `amqp.client.secretName` is set — it uses the container `runAsGroup` (default `65532`) when `fsGroup` is not already set.",{"_3381":249,"_29612":212,"_20544":48961,"_5":14097,"_26932":48866,"_2867":48962},[],"Both Secret options require `amqp.tls: true`: `values.schema.json` rejects a non-empty `secretName` when `tls` is false, rejects unknown keys and rejects data-key names outside `^[A-Za-z0-9._-]+$`. The referenced Secret must exist in the release namespace or the consuming pods fail to start.",{"_3381":250,"_29612":212,"_20544":48964,"_5":14097,"_26932":48866,"_2867":48965},[],"The AMQP client loads certificates at startup, so restart the consuming pods after updating either Secret. Changing any `amqp` value rolls the consuming pods through the `checksum/config` annotation, but a change to Secret content alone does not trigger a rollout.",{"_3381":251,"_29612":212,"_20544":48967,"_5":14097,"_26932":48866,"_2867":48968},[],"Per the migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: in 3.8.0 `amqp.tls` was not applied and event-bus clients used plaintext AMQP; from 4.0.0, `amqp.tls: true` switches them to AMQPS. Set `amqp.port` to the broker TLS listener before upgrading, or set `amqp.tls: false` to keep plaintext AMQP. `amqp.tls: false` sends the broker credentials and all event-bus traffic in cleartext.",{"_3381":252,"_29612":212,"_20544":48970,"_5":14097,"_26932":48870,"_2867":48971},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_3381":253,"_29612":212,"_20544":48973,"_5":14097,"_26932":48870,"_2867":48974},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_3381":254,"_29612":212,"_20544":48976,"_5":14097,"_26932":48870,"_2867":48977},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_3381":255,"_29612":212,"_20544":48979,"_5":14097,"_26932":48870,"_2867":48980},[],"See Access control for the principal and policy model.",{"_3381":256,"_29612":212,"_20544":48982,"_5":14097,"_26932":48874,"_2867":48983},[],"To install a local checkout instead:",{"_3381":257,"_29612":212,"_20544":48985,"_5":14097,"_26932":48878,"_2867":48986},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_3381":258,"_29612":212,"_20544":48988,"_5":14097,"_26932":48878,"_2867":48989},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_3381":259,"_29612":212,"_20544":48991,"_5":14097,"_26932":48882,"_2867":48992},[],"Version-specific upgrade steps live in `charts/lamassu/CHANGELOG/` in the Helm repository. The chart also ships an optional pre-upgrade Job that migrates existing CA private keys into the KMS engine configured for the release. It is off by default (`migrations.caToKms.enabled: false`) and is only needed when upgrading from a version prior to 3.7.0.",{"_3381":260,"_29612":212,"_20544":48994,"_5":14097,"_26932":48882,"_2867":48995},[],"While the flag is enabled, every `helm upgrade` creates the `<chart fullname>-ca-to-kms-migration` Job (`lamassu-ca-to-kms-migration` for release `lamassu`); a fresh install does not create it. Its hook weight is `-10`, so it runs before the other pre-upgrade hooks: the authorization bootstrap configuration (weight `-4`) and the database-migration Job (weight `-3`).",{"_3381":261,"_29612":212,"_20544":48997,"_5":14097,"_26932":48882,"_2867":48998},[],"The Job consumes the same KMS service configuration the chart renders into the KMS ConfigMap, including the engines from `services.kms.cryptoEngines`, and runs the migration tool defined in `migrations.caToKms.image`. It mounts that configuration read-only at `/etc/lamassuiot/config.yml` from the ConfigMap key `config`, so configure the destination engine in your values before the upgrade that performs the migration.",{"_3381":262,"_29612":212,"_20544":49000,"_5":14097,"_26932":48882,"_2867":49001},[],"The Job resolves its configuration through a projected volume with two optional sources: the release-scoped `<chart fullname>-kms-config` (`lamassu-kms-config` for release `lamassu`, `prod-lamassu-kms-config` for release `prod`) and the legacy unscoped `kms-config` created by chart versions before release-scoped naming. The legacy configuration remains authoritative while it is still present, and the release-scoped one is used once the legacy one is gone. Both sources are optional, so a missing ConfigMap never leaves the upgrade pod in `ContainerCreating`.",{"_3381":263,"_29612":212,"_20544":49003,"_5":14097,"_26932":48882,"_2867":49004},[],"Keep `migrations.caToKms.enabled: true` for the upgrade that performs the migration, then remove the flag from your values once the migration completes; it defaults to `false`.",{"_3381":264,"_29612":212,"_20544":49006,"_5":14097,"_26932":48886,"_2867":49007},[],"Before going live, review:",{"_3381":265,"_29612":212,"_20544":49009,"_5":14097,"_26932":48886,"_2867":49010},[],"backup and recovery for PostgreSQL and persistent volumes",{"_3381":266,"_29612":212,"_20544":49012,"_5":14097,"_26932":48886,"_2867":49013},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_3381":267,"_29612":212,"_20544":49015,"_5":14097,"_26932":48886,"_2867":49016},[],"shared VA storage before increasing VA replicas",{"_3381":268,"_29612":212,"_20544":49018,"_5":14097,"_26932":48886,"_2867":49019},[],"managed OIDC roles and removal of evaluation credentials",{"_3381":269,"_29612":212,"_20544":49021,"_5":14097,"_26932":48886,"_2867":49022},[],"a trusted TLS issuer or externally managed certificate",{"_3381":270,"_29612":212,"_20544":49024,"_5":14097,"_26932":48886,"_2867":49025},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_3381":271,"_29612":212,"_20544":49027,"_5":14097,"_26932":48886,"_2867":49028},[],"SMTP, observability and alert delivery",{"_3381":272,"_29612":212,"_20544":49030,"_5":14097,"_26932":48886,"_2867":49031},[],"the version upgrade guides and migration notes in `charts/lamassu/CHANGELOG/` before every upgrade, including the optional CA-to-KMS migration hook described above",{"_3381":273,"_29612":212,"_20544":49033,"_5":14097,"_26932":48886,"_2867":49034},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_3381":274,"_29612":274,"_5":14455,"_2867":49036,"_29965":49037,"_20544":49038,"_26932":274},"Expose the Gateway",[48231,48232,48338],[],{"_3381":275,"_29612":274,"_20544":49040,"_5":14097,"_26932":274,"_2867":49041},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_3381":276,"_29612":274,"_5":29962,"_20544":49043,"_26932":49044,"_2867":49045},[],"/docs/pr-preview/pr-53/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_3381":277,"_29612":274,"_5":29962,"_20544":49047,"_26932":49048,"_2867":49049},[],"/docs/pr-preview/pr-53/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_3381":278,"_29612":274,"_5":29962,"_20544":49051,"_26932":49052,"_2867":49053},[],"/docs/pr-preview/pr-53/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_3381":279,"_29612":274,"_5":29962,"_20544":49055,"_26932":49056,"_2867":49057},[],"/docs/pr-preview/pr-53/deployment/self-hosted/networking#k3s","K3s",{"_3381":280,"_29612":274,"_5":29962,"_20544":49059,"_26932":49060,"_2867":49061},[],"/docs/pr-preview/pr-53/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_3381":281,"_29612":274,"_5":29962,"_20544":49063,"_26932":49064,"_2867":49065},[],"/docs/pr-preview/pr-53/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_3381":282,"_29612":274,"_5":29962,"_20544":49067,"_26932":49068,"_2867":49069},[],"/docs/pr-preview/pr-53/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_3381":283,"_29612":274,"_5":29962,"_20544":49071,"_26932":49072,"_2867":49073},[],"/docs/pr-preview/pr-53/deployment/self-hosted/networking#decision-guide","Decision guide",{"_3381":284,"_29612":274,"_5":29962,"_20544":49075,"_26932":49076,"_2867":49077},[],"/docs/pr-preview/pr-53/deployment/self-hosted/networking#egress-proxy","Egress proxy",{"_3381":285,"_29612":274,"_5":29962,"_20544":49079,"_26932":49080,"_2867":49081},[],"/docs/pr-preview/pr-53/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_3381":286,"_29612":274,"_20544":49083,"_5":14097,"_26932":49044,"_2867":49084},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_3381":287,"_29612":274,"_20544":49086,"_5":14097,"_26932":49044,"_2867":49087},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_3381":288,"_29612":274,"_20544":49089,"_5":14097,"_26932":49048,"_2867":49090},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_3381":289,"_29612":274,"_20544":49092,"_5":14097,"_26932":49048,"_2867":49093},[],"Set it only when:",{"_3381":290,"_29612":274,"_20544":49095,"_5":14097,"_26932":49048,"_2867":49096},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_3381":291,"_29612":274,"_20544":49098,"_5":14097,"_26932":49048,"_2867":49099},[],"that address is allocated to this Gateway",{"_3381":292,"_29612":274,"_20544":49101,"_5":14097,"_26932":49048,"_2867":49102},[],"the surrounding network already routes traffic for it to the cluster",{"_3381":293,"_29612":274,"_20544":49104,"_5":14097,"_26932":49048,"_2867":49105},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_3381":294,"_29612":274,"_20544":49107,"_5":14097,"_26932":49048,"_2867":49108},[],"Keep these two settings separate:",{"_3381":295,"_29612":274,"_20544":49110,"_5":14097,"_26932":49048,"_2867":49111},[],"`gateway.addresses` requests an address for the Gateway.",{"_3381":296,"_29612":274,"_20544":49113,"_5":14097,"_26932":49048,"_2867":49114},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_3381":297,"_29612":274,"_20544":49116,"_5":14097,"_26932":49048,"_2867":49117},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_3381":298,"_29612":274,"_20544":49119,"_5":14097,"_26932":49052,"_2867":49120},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_3381":299,"_29612":274,"_20544":49122,"_5":14097,"_26932":49052,"_2867":49123},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_3381":300,"_29612":274,"_20544":49125,"_5":14097,"_26932":49056,"_2867":49126},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_3381":301,"_29612":274,"_20544":49128,"_5":14097,"_26932":49056,"_2867":49129},[],"For the recommended design:",{"_3381":302,"_29612":274,"_20544":49131,"_5":14097,"_26932":49056,"_2867":49132},[],"Use only one externally exposed Lamassu Gateway.",{"_3381":303,"_29612":274,"_20544":49134,"_5":14097,"_26932":49056,"_2867":49135},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_3381":304,"_29612":274,"_20544":49137,"_5":14097,"_26932":49056,"_2867":49138},[],"Allow those ports through the VM firewall and any upstream security group.",{"_3381":305,"_29612":274,"_20544":49140,"_5":14097,"_26932":49056,"_2867":49141},[],"Point DNS at the VM's reachable address.",{"_3381":306,"_29612":274,"_20544":49143,"_5":14097,"_26932":49056,"_2867":49144},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_3381":307,"_29612":274,"_20544":49146,"_5":14097,"_26932":49060,"_2867":49147},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_3381":308,"_29612":274,"_20544":49149,"_5":14097,"_26932":49064,"_2867":49150},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_3381":309,"_29612":274,"_20544":49152,"_5":14097,"_26932":49064,"_2867":49153},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_3381":310,"_29612":274,"_20544":49155,"_5":14097,"_26932":49068,"_2867":49156},[],"First decide whether you need three independent data planes or only three hostnames.",{"_3381":311,"_29612":274,"_20544":49158,"_5":14097,"_26932":49068,"_2867":49159},[],"Requirement",{"_3381":312,"_29612":274,"_20544":49161,"_5":14097,"_26932":49068,"_2867":49162},[],"Recommended design",{"_3381":313,"_29612":274,"_20544":49164,"_5":14097,"_26932":49068,"_2867":49165},[],"Consequence",{"_3381":314,"_29612":274,"_20544":49167,"_5":14097,"_26932":49068,"_2867":49168},[],"Several Lamassu URLs or services",{"_3381":315,"_29612":274,"_20544":49170,"_5":14097,"_26932":49068,"_2867":49171},[],"One Gateway with multiple routes",{"_3381":316,"_29612":274,"_20544":49173,"_5":14097,"_26932":49068,"_2867":49174},[],"One IP and one proxy fleet; this is the chart default",{"_3381":317,"_29612":274,"_20544":49176,"_5":14097,"_26932":49068,"_2867":49177},[],"Independent Gateways and separate external IPs",{"_3381":318,"_29612":274,"_20544":49179,"_5":14097,"_26932":49068,"_2867":49180},[],"One VIP per Gateway",{"_3381":319,"_29612":274,"_20544":49182,"_5":14097,"_26932":49068,"_2867":49183},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_3381":320,"_29612":274,"_20544":49185,"_5":14097,"_26932":49068,"_2867":49186},[],"Independent Gateways on one node and one IP",{"_3381":321,"_29612":274,"_20544":49188,"_5":14097,"_26932":49068,"_2867":49189},[],"Use different external ports",{"_3381":322,"_29612":274,"_20544":49191,"_5":14097,"_26932":49068,"_2867":49192},[],"Clients must include non-standard ports",{"_3381":323,"_29612":274,"_20544":49194,"_5":14097,"_26932":49068,"_2867":49195},[],"Separate TLS/mTLS termination behind one IP",{"_3381":324,"_29612":274,"_20544":49197,"_5":14097,"_26932":49068,"_2867":49198},[],"Front-door SNI routing to internal Gateways",{"_3381":325,"_29612":274,"_20544":49200,"_5":14097,"_26932":49068,"_2867":49201},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_3381":326,"_29612":274,"_20544":49203,"_5":14097,"_26932":49068,"_2867":49204},[],"Separate Gateway resources but shared proxy infrastructure",{"_3381":327,"_29612":274,"_20544":49206,"_5":14097,"_26932":49068,"_2867":49207},[],"Envoy merged-Gateway mode",{"_3381":328,"_29612":274,"_20544":49209,"_5":14097,"_26932":49068,"_2867":49210},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_3381":329,"_29612":274,"_20544":49212,"_5":14097,"_26932":49068,"_2867":49213},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_3381":330,"_29612":274,"_20544":49215,"_5":14097,"_26932":49068,"_2867":49216},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_3381":331,"_29612":274,"_20544":49218,"_5":14097,"_26932":49068,"_2867":49219},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_3381":332,"_29612":274,"_20544":49221,"_5":14097,"_26932":49068,"_2867":49222},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_3381":333,"_29612":274,"_20544":49224,"_5":14097,"_26932":49072,"_2867":49225},[],"If one Gateway can own TLS and routing, use the chart default.",{"_3381":334,"_29612":274,"_20544":49227,"_5":14097,"_26932":49072,"_2867":49228},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_3381":335,"_29612":274,"_20544":49230,"_5":14097,"_26932":49072,"_2867":49231},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_3381":336,"_29612":274,"_20544":49233,"_5":14097,"_26932":49072,"_2867":49234},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_3381":337,"_29612":274,"_20544":49236,"_5":14097,"_26932":49072,"_2867":49237},[],"If none of those are possible, use different external ports or change the external network design.",{"_3381":338,"_29612":274,"_20544":49239,"_5":14097,"_26932":49076,"_2867":49240},[],"Internal Lamassu clients — the Vault engine connection, service-to-service calls and webhook deliveries — honor the `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables. The exception is the authorization-engine connector: it uses its own transport and does not consult these proxy variables. If your deployment routes egress through a proxy, list in-cluster service names in `NO_PROXY` (for example `.svc,.cluster.local`) so internal traffic stays inside the cluster. Loopback traffic is never sent through a proxy.",{"_3381":339,"_29612":274,"_20544":49242,"_5":14097,"_26932":49076,"_2867":49243},[],"The default transport of these clients bounds the dial timeout (30 seconds), the TLS handshake (10 seconds) and idle connection reuse (90 seconds) so an unreachable dependency fails fast instead of hanging; these values are Go transport defaults, not Lamassu settings. HTTP/2 is negotiated when the peer supports it. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call.",{"_3381":340,"_29612":274,"_20544":49245,"_5":14097,"_26932":49080,"_2867":49246},[],"Check, in order:",{"_3381":341,"_29612":274,"_20544":49248,"_5":14097,"_26932":49080,"_2867":49249},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_3381":342,"_29612":274,"_20544":49251,"_5":14097,"_26932":49080,"_2867":49252},[],"Its status contains the expected address.",{"_3381":343,"_29612":274,"_20544":49254,"_5":14097,"_26932":49080,"_2867":49255},[],"The generated `LoadBalancer` Service has a usable external address.",{"_3381":344,"_29612":274,"_20544":49257,"_5":14097,"_26932":49080,"_2867":49258},[],"Port 443 reaches that address from the client network.",{"_3381":345,"_29612":274,"_20544":49260,"_5":14097,"_26932":49080,"_2867":49261},[],"DNS resolves to the externally reachable endpoint.",{"_3381":346,"_29612":274,"_20544":49263,"_5":14097,"_26932":49080,"_2867":49264},[],"The certificate contains the DNS name or IP used by the client.",{"_3381":347,"_29612":274,"_20544":49266,"_5":14097,"_26932":49080,"_2867":49267},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_3381":348,"_29612":348,"_5":14455,"_2867":48338,"_29965":49269,"_20544":49270,"_26932":348},[48231,48232,48338],[],{"_3381":349,"_29612":348,"_20544":49272,"_5":14097,"_26932":348,"_2867":49273},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_3381":350,"_29612":348,"_5":29962,"_20544":49275,"_26932":49276,"_2867":49277},[],"/docs/pr-preview/pr-53/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_3381":351,"_29612":348,"_5":29962,"_20544":49279,"_26932":49280,"_2867":49281},[],"/docs/pr-preview/pr-53/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_3381":352,"_29612":348,"_5":29962,"_20544":49283,"_26932":49284,"_2867":49285},[],"/docs/pr-preview/pr-53/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_3381":353,"_29612":348,"_5":29962,"_20544":49287,"_26932":49288,"_2867":49289},[],"/docs/pr-preview/pr-53/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_3381":354,"_29612":348,"_5":29962,"_20544":49291,"_26932":49292,"_2867":49293},[],"/docs/pr-preview/pr-53/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_3381":355,"_29612":348,"_5":29962,"_20544":49295,"_26932":49296,"_2867":49297},[],"/docs/pr-preview/pr-53/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_3381":356,"_29612":348,"_20544":49299,"_5":14097,"_26932":49276,"_2867":49300},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_3381":357,"_29612":348,"_20544":49302,"_5":14097,"_26932":49280,"_2867":49303},[],"Workflow",{"_3381":358,"_29612":348,"_20544":49305,"_5":14097,"_26932":49280,"_2867":49306},[],"Use it for",{"_3381":359,"_29612":348,"_20544":49308,"_5":14097,"_26932":49280,"_2867":49309},[],"What it installs",{"_3381":360,"_29612":348,"_20544":49311,"_5":14097,"_26932":49280,"_2867":49312},[],"Helm",{"_3381":361,"_29612":348,"_20544":49314,"_5":14097,"_26932":49280,"_2867":49315},[],"Production and controlled environments",{"_3381":362,"_29612":348,"_20544":49317,"_5":14097,"_26932":49280,"_2867":49318},[],"Lamassu services and Gateway API resources",{"_3381":363,"_29612":348,"_20544":49320,"_5":14097,"_26932":49280,"_2867":48475},[],{"_3381":364,"_29612":348,"_20544":49322,"_5":14097,"_26932":49280,"_2867":49323},[],"Evaluation, demos, CI and small lab clusters",{"_3381":365,"_29612":348,"_20544":49325,"_5":14097,"_26932":49280,"_2867":49326},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_3381":366,"_29612":348,"_20544":49328,"_5":14097,"_26932":49284,"_2867":49329},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_3381":367,"_29612":348,"_20544":49331,"_5":14097,"_26932":49284,"_2867":49332},[],"Area",{"_3381":368,"_29612":348,"_20544":49334,"_5":14097,"_26932":49284,"_2867":49335},[],"The Lamassu chart provides",{"_3381":369,"_29612":348,"_20544":49337,"_5":14097,"_26932":49284,"_2867":49338},[],"You provide",{"_3381":370,"_29612":348,"_20544":49340,"_5":14097,"_26932":49284,"_2867":49341},[],"Lamassu applications",{"_3381":371,"_29612":348,"_20544":49343,"_5":14097,"_26932":49284,"_2867":49344},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_3381":372,"_29612":348,"_20544":49346,"_5":14097,"_26932":49284,"_2867":49347},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_3381":373,"_29612":348,"_20544":49349,"_5":14097,"_26932":49284,"_2867":49350},[],"PostgreSQL data",{"_3381":374,"_29612":348,"_20544":49352,"_5":14097,"_26932":49284,"_2867":49353},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_3381":375,"_29612":348,"_20544":49355,"_5":14097,"_26932":49284,"_2867":49356},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_3381":376,"_29612":348,"_20544":49358,"_5":14097,"_26932":49284,"_2867":49359},[],"Messaging",{"_3381":377,"_29612":348,"_20544":49361,"_5":14097,"_26932":49284,"_2867":49362},[],"RabbitMQ connection configuration for the Lamassu services; the connection can use AMQPS, with an optional private CA and an optional client certificate, both set through chart values",{"_3381":378,"_29612":348,"_20544":49364,"_5":14097,"_26932":49284,"_2867":49365},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_3381":379,"_29612":348,"_20544":49367,"_5":14097,"_26932":49284,"_2867":49368},[],"Identity",{"_3381":380,"_29612":348,"_20544":49370,"_5":14097,"_26932":49284,"_2867":49371},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_3381":381,"_29612":348,"_20544":49373,"_5":14097,"_26932":49284,"_2867":49374},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_3381":382,"_29612":348,"_20544":49376,"_5":14097,"_26932":49284,"_2867":49377},[],"External routing",{"_3381":383,"_29612":348,"_20544":49379,"_5":14097,"_26932":49284,"_2867":49380},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_3381":384,"_29612":348,"_20544":49382,"_5":14097,"_26932":49284,"_2867":49383},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_3381":385,"_29612":348,"_20544":49385,"_5":14097,"_26932":49284,"_2867":49386},[],"TLS",{"_3381":386,"_29612":348,"_20544":49388,"_5":14097,"_26932":49284,"_2867":49389},[],"In the default `tls.type: certManager` mode, cert-manager `Issuer` and CA `Certificate` resources and a chart-managed downstream `Certificate`; in the `tls.type: external` mode, a reference to your TLS Secret",{"_3381":387,"_29612":348,"_20544":49391,"_5":14097,"_26932":49284,"_2867":49392},[],"cert-manager only for the default `tls.type: certManager` mode; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_3381":388,"_29612":348,"_20544":49394,"_5":14097,"_26932":49284,"_2867":49395},[],"Persistent application data",{"_3381":389,"_29612":348,"_20544":49397,"_5":14097,"_26932":49284,"_2867":49398},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_3381":390,"_29612":348,"_20544":49400,"_5":14097,"_26932":49284,"_2867":49401},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_3381":391,"_29612":348,"_20544":49403,"_5":14097,"_26932":49284,"_2867":49404},[],"Optional integrations",{"_3381":392,"_29612":348,"_20544":49406,"_5":14097,"_26932":49284,"_2867":49407},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_3381":393,"_29612":348,"_20544":49409,"_5":14097,"_26932":49284,"_2867":49410},[],"The observability backends, cloud credentials and production HSM or external key service",{"_3381":394,"_29612":348,"_20544":49412,"_5":14097,"_26932":49284,"_2867":49413},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_3381":395,"_29612":348,"_20544":49415,"_5":14097,"_26932":49284,"_2867":49416},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_3381":396,"_29612":348,"_20544":49418,"_5":14097,"_26932":49288,"_2867":49419},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_3381":397,"_29612":348,"_20544":49421,"_5":14097,"_26932":49288,"_2867":49422},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_3381":398,"_29612":348,"_20544":49424,"_5":14097,"_26932":49292,"_2867":49425},[],"Kubernetes 1.24 or newer",{"_3381":399,"_29612":348,"_20544":49427,"_5":14097,"_26932":49292,"_2867":49428},[],"Helm 3.2 or newer",{"_3381":400,"_29612":348,"_20544":49430,"_5":14097,"_26932":49292,"_2867":49431},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_3381":401,"_29612":348,"_20544":49433,"_5":14097,"_26932":49292,"_2867":49434},[],"cert-manager 1.14 or newer; required only for the default `tls.type: certManager` TLS mode, not for `tls.type: external`",{"_3381":402,"_29612":348,"_20544":49436,"_5":14097,"_26932":49292,"_2867":49437},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_3381":403,"_29612":348,"_20544":49439,"_5":14097,"_26932":49292,"_2867":49440},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_3381":404,"_29612":348,"_20544":49442,"_5":14097,"_26932":49292,"_2867":49443},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_3381":405,"_29612":348,"_20544":49445,"_5":14097,"_26932":49296,"_2867":49446},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3381":406,"_29612":348,"_20544":49448,"_5":14097,"_26932":49296,"_2867":49449},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3381":407,"_29612":348,"_20544":49451,"_5":14097,"_26932":49296,"_2867":49452},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3381":408,"_29612":348,"_20544":49454,"_5":14097,"_26932":49296,"_2867":49455},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3381":409,"_29612":409,"_5":14455,"_2867":49457,"_29965":49458,"_20544":49460,"_26932":409},"Deployment troubleshooting",[48231,48232,49459],"Operations",[],{"_3381":410,"_29612":409,"_20544":49462,"_5":14097,"_26932":409,"_2867":49463},[],"Diagnose access, service health and infrastructure dependencies.",{"_3381":411,"_29612":409,"_5":29962,"_20544":49465,"_26932":49466,"_2867":49467},[],"/docs/pr-preview/pr-53/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_3381":412,"_29612":409,"_5":29962,"_20544":49469,"_26932":49470,"_2867":49471},[],"/docs/pr-preview/pr-53/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_3381":413,"_29612":409,"_5":29962,"_20544":49473,"_26932":49474,"_2867":49475},[],"/docs/pr-preview/pr-53/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_3381":414,"_29612":409,"_5":29962,"_20544":49477,"_26932":49478,"_2867":49479},[],"/docs/pr-preview/pr-53/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_3381":415,"_29612":409,"_5":29962,"_20544":49481,"_26932":49482,"_2867":49483},[],"/docs/pr-preview/pr-53/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_3381":416,"_29612":409,"_5":29962,"_20544":49485,"_26932":49486,"_2867":49487},[],"/docs/pr-preview/pr-53/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_3381":417,"_29612":409,"_5":29962,"_20544":49489,"_26932":49490,"_2867":49491},[],"/docs/pr-preview/pr-53/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_3381":418,"_29612":409,"_5":29962,"_20544":49493,"_26932":49494,"_2867":49495},[],"/docs/pr-preview/pr-53/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_3381":419,"_29612":409,"_5":29962,"_20544":49497,"_26932":49498,"_2867":49499},[],"/docs/pr-preview/pr-53/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_3381":420,"_29612":409,"_5":29962,"_20544":49501,"_26932":49502,"_2867":49503},[],"/docs/pr-preview/pr-53/deployment/troubleshooting#api-500-errors","API 500 errors",{"_3381":421,"_29612":409,"_5":29962,"_20544":49505,"_26932":49506,"_2867":49507},[],"/docs/pr-preview/pr-53/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_3381":422,"_29612":409,"_5":29962,"_20544":49509,"_26932":49510,"_2867":49511},[],"/docs/pr-preview/pr-53/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_3381":423,"_29612":409,"_5":29962,"_20544":49513,"_26932":49514,"_2867":49515},[],"/docs/pr-preview/pr-53/deployment/troubleshooting#observability","Observability",{"_3381":424,"_29612":409,"_20544":49517,"_5":14097,"_26932":409,"_2867":49518},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_3381":425,"_29612":409,"_20544":49520,"_5":14097,"_26932":49470,"_2867":49521},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_3381":426,"_29612":409,"_20544":49523,"_5":14097,"_26932":49474,"_2867":49524},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_3381":427,"_29612":409,"_20544":49526,"_5":14097,"_26932":49478,"_2867":49527},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_3381":428,"_29612":409,"_20544":49529,"_5":14097,"_26932":49482,"_2867":49530},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_3381":429,"_29612":409,"_20544":49532,"_5":14097,"_26932":49486,"_2867":49533},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_3381":430,"_29612":409,"_20544":49535,"_5":14097,"_26932":49490,"_2867":49536},[],"Replace the placeholders with your real release, namespace and deployment.",{"_3381":431,"_29612":409,"_20544":49538,"_5":14097,"_26932":49490,"_2867":49539},[],"Also run the chart's connectivity test:",{"_3381":432,"_29612":409,"_20544":49541,"_5":14097,"_26932":49490,"_2867":49542},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_3381":433,"_29612":409,"_20544":49544,"_5":14097,"_26932":49490,"_2867":49545},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_3381":434,"_29612":409,"_20544":49547,"_5":14097,"_26932":49494,"_2867":49548},[],"If you receive a 401:",{"_3381":435,"_29612":409,"_20544":49550,"_5":14097,"_26932":49494,"_2867":49551},[],"check that the UI's OIDC authority is reachable from the browser;",{"_3381":436,"_29612":409,"_20544":49553,"_5":14097,"_26932":49494,"_2867":49554},[],"verify issuer, audience and expiration of the token;",{"_3381":437,"_29612":409,"_20544":49556,"_5":14097,"_26932":49494,"_2867":49557},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_3381":438,"_29612":409,"_20544":49559,"_5":14097,"_26932":49494,"_2867":49560},[],"check that the provider's public and internal routes point to the same realm.",{"_3381":439,"_29612":409,"_20544":49562,"_5":14097,"_26932":49494,"_2867":49563},[],"If login succeeds but the APIs return 403:",{"_3381":440,"_29612":409,"_20544":49565,"_5":14097,"_26932":49494,"_2867":49566},[],"inspect the token's real claims;",{"_3381":441,"_29612":409,"_20544":49568,"_5":14097,"_26932":49494,"_2867":49569},[],"confirm they match an active principal;",{"_3381":442,"_29612":409,"_20544":49571,"_5":14097,"_26932":49494,"_2867":49572},[],"review the policies granted to that principal;",{"_3381":443,"_29612":409,"_20544":49574,"_5":14097,"_26932":49494,"_2867":49575},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_3381":444,"_29612":409,"_20544":49577,"_5":14097,"_26932":49494,"_2867":49578},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_3381":445,"_29612":409,"_20544":49580,"_5":14097,"_26932":49498,"_2867":49581},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_3381":446,"_29612":409,"_20544":49583,"_5":14097,"_26932":49498,"_2867":49584},[],"Locate the authz pod and Service.",{"_3381":447,"_29612":409,"_20544":49586,"_5":14097,"_26932":49498,"_2867":49587},[],"Check /health, logs and its database connection.",{"_3381":448,"_29612":409,"_20544":49589,"_5":14097,"_26932":49498,"_2867":49590},[],"Verify the DNS and port configured in externalAuthorization.",{"_3381":449,"_29612":409,"_20544":49592,"_5":14097,"_26932":49498,"_2867":49593},[],"Check the check route is /v1/ext\\_authz/check.",{"_3381":450,"_29612":409,"_20544":49595,"_5":14097,"_26932":49498,"_2867":49596},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_3381":451,"_29612":409,"_20544":49598,"_5":14097,"_26932":49502,"_2867":49599},[],"A 500 indicates an internal failure, such as an unavailable database. The `{\"err\": ...}` body currently includes the text of the internal error, which can contain schema, table and constraint names and, on connection failures, the database host and user (not the password). Find the cause in the service log using the request time, and do not forward the body to third parties or show it to end users. This is a known information-disclosure defect: generic messages are planned for 500 responses, keeping the detail only in the service log (tracked in lamassuiot#814). The authorization connector also returns the internal error, in the `details.error` field. Some request errors, such as a key size the engine does not support, are also returned as 500.",{"_3381":452,"_29612":409,"_20544":49601,"_5":14097,"_26932":49506,"_2867":49602},[],"Review kubectl describe pod first. Common causes are:",{"_3381":453,"_29612":409,"_20544":49604,"_5":14097,"_26932":49506,"_2867":49605},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_3381":454,"_29612":409,"_20544":49607,"_5":14097,"_26932":49506,"_2867":49608},[],"a missing AMQP CA or client certificate Secret referenced by `amqp.ca.secretName` or `amqp.client.secretName`;",{"_3381":455,"_29612":409,"_20544":49610,"_5":14097,"_26932":49506,"_2867":49611},[],"unbound persistent volume;",{"_3381":456,"_29612":409,"_20544":49613,"_5":14097,"_26932":49506,"_2867":49614},[],"inaccessible image or incorrect pull policy;",{"_3381":457,"_29612":409,"_20544":49616,"_5":14097,"_26932":49506,"_2867":49617},[],"invalid cryptographic engine configuration;",{"_3381":458,"_29612":409,"_20544":49619,"_5":14097,"_26932":49506,"_2867":49620},[],"CPU or memory limits set too low;",{"_3381":459,"_29612":409,"_20544":49622,"_5":14097,"_26932":49506,"_2867":49623},[],"an incomplete prior migration.",{"_3381":460,"_29612":409,"_20544":49625,"_5":14097,"_26932":49506,"_2867":49626},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_3381":461,"_29612":409,"_20544":49628,"_5":14097,"_26932":49506,"_2867":49629},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_3381":462,"_29612":409,"_20544":49631,"_5":14097,"_26932":49506,"_2867":49632},[],"Internal calls now fail fast instead of hanging for the clients covered by Egress proxy: connection attempts time out after 30 seconds and TLS handshakes after 10 seconds. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call. If an egress proxy handles the cluster's outbound traffic, check the pod's `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables and list in-cluster service names in `NO_PROXY`.",{"_3381":463,"_29612":409,"_20544":49634,"_5":14097,"_26932":49510,"_2867":49635},[],"Domain and audit events depend on the bus publisher:",{"_3381":464,"_29612":409,"_20544":49637,"_5":14097,"_26932":49510,"_2867":49638},[],"verify it is enabled in the emitting service;",{"_3381":465,"_29612":409,"_20544":49640,"_5":14097,"_26932":49510,"_2867":49641},[],"check AMQP connectivity and credentials;",{"_3381":466,"_29612":409,"_20544":49643,"_5":14097,"_26932":49510,"_2867":49644},[],"review exchange, routing key, queues and consumers;",{"_3381":467,"_29612":409,"_20544":49646,"_5":14097,"_26932":49510,"_2867":49647},[],"inspect dead-letter queues;",{"_3381":468,"_29612":409,"_20544":49649,"_5":14097,"_26932":49510,"_2867":49650},[],"alert on orphan durable queues and backlog growth.",{"_3381":469,"_29612":409,"_20544":49652,"_5":14097,"_26932":49510,"_2867":49653},[],"If `amqp.tls` is enabled, verify the TLS side as well:",{"_3381":470,"_29612":409,"_20544":49655,"_5":14097,"_26932":49510,"_2867":49656},[],"confirm the broker listener speaks AMQPS on the configured port — the default port stays `5672` and does not follow TLS automatically;",{"_3381":471,"_29612":409,"_20544":49658,"_5":14097,"_26932":49510,"_2867":49659},[],"if you set `amqp.ca.secretName`, confirm the Secret exists in the release namespace and its data key matches `amqp.ca.certificateKey` (default `ca.crt`); if `amqp.ca.secretName` is not set, the clients trust the system CAs;",{"_3381":472,"_29612":409,"_20544":49661,"_5":14097,"_26932":49510,"_2867":49662},[],"remember that a missing referenced Secret prevents the consuming pods from starting;",{"_3381":473,"_29612":409,"_20544":49664,"_5":14097,"_26932":49510,"_2867":49665},[],"after updating the CA or client certificate Secret, restart the consuming pods: the AMQP client loads certificates at startup.",{"_3381":474,"_29612":409,"_20544":49667,"_5":14097,"_26932":49510,"_2867":49668},[],"See AMQP TLS (AMQPS) for the full configuration.",{"_3381":475,"_29612":409,"_20544":49670,"_5":14097,"_26932":49510,"_2867":49671},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_3381":476,"_29612":409,"_20544":49673,"_5":14097,"_26932":49514,"_2867":49674},[],"The chart can enable OpenTelemetry instrumentation for the services that support it, including authz; it does not configure OpenTelemetry for AWS Connector, wfx or the UI. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, service and dependency.",{"_3381":477,"_29612":409,"_20544":49676,"_5":14097,"_26932":49514,"_2867":49677},[],"Before closing an incident, record:",{"_3381":478,"_29612":409,"_20544":49679,"_5":14097,"_26932":49514,"_2867":49680},[],"the confirmed cause;",{"_3381":479,"_29612":409,"_20544":49682,"_5":14097,"_26932":49514,"_2867":49683},[],"the time scope and affected resources;",{"_3381":480,"_29612":409,"_20544":49685,"_5":14097,"_26932":49514,"_2867":49686},[],"the commands or queries used;",{"_3381":481,"_29612":409,"_20544":49688,"_5":14097,"_26932":49514,"_2867":49689},[],"the applied change and how to revert it;",{"_3381":482,"_29612":409,"_20544":49691,"_5":14097,"_26932":49514,"_2867":49692},[],"validation from a consumer;",{"_3381":483,"_29612":409,"_20544":49694,"_5":14097,"_26932":49514,"_2867":49695},[],"the preventive action and its owner.",{"_3381":484,"_29612":484,"_5":14455,"_2867":49697,"_29965":49698,"_20544":49701,"_26932":484},"Access control",[48231,49699,49700],"Platform","Administration",[],{"_3381":485,"_29612":484,"_20544":49703,"_5":14097,"_26932":484,"_2867":49704},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_3381":486,"_29612":484,"_5":29962,"_20544":49706,"_26932":49707,"_2867":49708},[],"/docs/pr-preview/pr-53/platform/administration/access-control#essential-concepts","Essential concepts",{"_3381":487,"_29612":484,"_5":29962,"_20544":49710,"_26932":49711,"_2867":49712},[],"/docs/pr-preview/pr-53/platform/administration/access-control#two-decision-systems","Two decision systems",{"_3381":488,"_29612":484,"_5":29962,"_20544":49714,"_26932":49715,"_2867":49716},[],"/docs/pr-preview/pr-53/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_3381":489,"_29612":484,"_5":29962,"_20544":49718,"_26932":49719,"_2867":49720},[],"/docs/pr-preview/pr-53/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_3381":490,"_29612":484,"_5":29962,"_20544":49722,"_26932":49723,"_2867":49724},[],"/docs/pr-preview/pr-53/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_3381":491,"_29612":484,"_5":29962,"_20544":49726,"_26932":49727,"_2867":49728},[],"/docs/pr-preview/pr-53/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_3381":492,"_29612":484,"_5":29962,"_20544":49730,"_26932":49731,"_2867":49732},[],"/docs/pr-preview/pr-53/platform/administration/access-control#oidc-principals","OIDC principals",{"_3381":493,"_29612":484,"_5":29962,"_20544":49734,"_26932":49735,"_2867":49736},[],"/docs/pr-preview/pr-53/platform/administration/access-control#x509-principals","X.509 principals",{"_3381":494,"_29612":484,"_5":29962,"_20544":49738,"_26932":49739,"_2867":49740},[],"/docs/pr-preview/pr-53/platform/administration/access-control#when-several-principals-match","When several principals match",{"_3381":495,"_29612":484,"_5":29962,"_20544":49742,"_26932":49743,"_2867":49744},[],"/docs/pr-preview/pr-53/platform/administration/access-control#how-policies-express-access","How policies express access",{"_3381":496,"_29612":484,"_5":29962,"_20544":49746,"_26932":49747,"_2867":49748},[],"/docs/pr-preview/pr-53/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_3381":497,"_29612":484,"_5":29962,"_20544":49750,"_26932":49751,"_2867":49752},[],"/docs/pr-preview/pr-53/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_3381":498,"_29612":484,"_5":29962,"_20544":49754,"_26932":49755,"_2867":49756},[],"/docs/pr-preview/pr-53/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_3381":499,"_29612":484,"_5":29962,"_20544":49758,"_26932":49759,"_2867":49760},[],"/docs/pr-preview/pr-53/platform/administration/access-control#http-rules","HTTP rules",{"_3381":500,"_29612":484,"_5":29962,"_20544":49762,"_26932":49763,"_2867":49764},[],"/docs/pr-preview/pr-53/platform/administration/access-control#included-policies","Included policies",{"_3381":501,"_29612":484,"_5":29962,"_20544":49766,"_26932":49767,"_2867":48871},[],"/docs/pr-preview/pr-53/platform/administration/access-control#provision-the-first-administrator",{"_3381":502,"_29612":484,"_5":29962,"_20544":49769,"_26932":49770,"_2867":49771},[],"/docs/pr-preview/pr-53/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_3381":503,"_29612":484,"_5":29962,"_20544":49773,"_26932":49774,"_2867":49775},[],"/docs/pr-preview/pr-53/platform/administration/access-control#configure-token-validation","Configure token validation",{"_3381":504,"_29612":484,"_5":29962,"_20544":49777,"_26932":49778,"_2867":49779},[],"/docs/pr-preview/pr-53/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_3381":505,"_29612":484,"_5":29962,"_20544":49781,"_26932":49782,"_2867":49783},[],"/docs/pr-preview/pr-53/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_3381":506,"_29612":484,"_5":29962,"_20544":49785,"_26932":49786,"_2867":49787},[],"/docs/pr-preview/pr-53/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_3381":507,"_29612":484,"_5":29962,"_20544":49789,"_26932":49790,"_2867":49791},[],"/docs/pr-preview/pr-53/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_3381":508,"_29612":484,"_5":29962,"_20544":49793,"_26932":49794,"_2867":49795},[],"/docs/pr-preview/pr-53/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_3381":509,"_29612":484,"_5":29962,"_20544":49797,"_26932":49798,"_2867":49799},[],"/docs/pr-preview/pr-53/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_3381":510,"_29612":484,"_5":29962,"_20544":49801,"_26932":49802,"_2867":49803},[],"/docs/pr-preview/pr-53/platform/administration/access-control#operational-checklist","Operational checklist",{"_3381":511,"_29612":484,"_5":29962,"_20544":49805,"_26932":49806,"_2867":49807},[],"/docs/pr-preview/pr-53/platform/administration/access-control#diagnostics","Diagnostics",{"_3381":512,"_29612":484,"_5":29962,"_20544":49809,"_26932":49810,"_2867":49811},[],"/docs/pr-preview/pr-53/platform/administration/access-control#the-response-is-401","The response is 401",{"_3381":513,"_29612":484,"_5":29962,"_20544":49813,"_26932":49814,"_2867":49815},[],"/docs/pr-preview/pr-53/platform/administration/access-control#the-response-is-403","The response is 403",{"_3381":514,"_29612":484,"_5":29962,"_20544":49817,"_26932":49818,"_2867":49819},[],"/docs/pr-preview/pr-53/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_3381":515,"_29612":484,"_5":29962,"_20544":49821,"_26932":49822,"_2867":49823},[],"/docs/pr-preview/pr-53/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_3381":516,"_29612":484,"_5":29962,"_20544":49825,"_26932":49826,"_2867":49827},[],"/docs/pr-preview/pr-53/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_3381":517,"_29612":484,"_20544":49829,"_5":14097,"_26932":484,"_2867":49830},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_3381":518,"_29612":484,"_20544":49832,"_5":14097,"_26932":484,"_2867":49833},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_3381":519,"_29612":484,"_20544":49835,"_5":14097,"_26932":484,"_2867":49836},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_3381":520,"_29612":484,"_20544":49838,"_5":14097,"_26932":49707,"_2867":49839},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_3381":521,"_29612":484,"_20544":49841,"_5":14097,"_26932":49707,"_2867":49842},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_3381":522,"_29612":484,"_20544":49844,"_5":14097,"_26932":49707,"_2867":49845},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_3381":523,"_29612":484,"_20544":49847,"_5":14097,"_26932":49707,"_2867":49848},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_3381":524,"_29612":484,"_20544":49850,"_5":14097,"_26932":49707,"_2867":49851},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_3381":525,"_29612":484,"_20544":49853,"_5":14097,"_26932":49707,"_2867":49854},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_3381":526,"_29612":484,"_20544":49856,"_5":14097,"_26932":49711,"_2867":49857},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_3381":527,"_29612":484,"_20544":49859,"_5":14097,"_26932":49711,"_2867":49860},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_3381":528,"_29612":484,"_20544":49862,"_5":14097,"_26932":49715,"_2867":49863},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_3381":529,"_29612":484,"_20544":49865,"_5":14097,"_26932":49715,"_2867":49866},[],"The decision is made **before forwarding the request to the service**:",{"_3381":530,"_29612":484,"_20544":49868,"_5":14097,"_26932":49715,"_2867":49869},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_3381":531,"_29612":484,"_20544":49871,"_5":14097,"_26932":49715,"_2867":49872},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_3381":532,"_29612":484,"_20544":49874,"_5":14097,"_26932":49715,"_2867":49875},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_3381":533,"_29612":484,"_20544":49877,"_5":14097,"_26932":49715,"_2867":49878},[],"It separately loads the policies granted to each principal.",{"_3381":534,"_29612":484,"_20544":49880,"_5":14097,"_26932":49715,"_2867":49881},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_3381":535,"_29612":484,"_20544":49883,"_5":14097,"_26932":49715,"_2867":49884},[],"`authz` looks for an HTTP rule granting that action.",{"_3381":536,"_29612":484,"_20544":49886,"_5":14097,"_26932":49715,"_2867":49887},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_3381":537,"_29612":484,"_20544":49889,"_5":14097,"_26932":49715,"_2867":49890},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_3381":538,"_29612":484,"_20544":49892,"_5":14097,"_26932":49715,"_2867":49893},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context.",{"_3381":539,"_29612":484,"_20544":49895,"_5":14097,"_26932":49715,"_2867":49896},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_3381":540,"_29612":484,"_20544":49898,"_5":14097,"_26932":49719,"_2867":49899},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_3381":541,"_29612":484,"_20544":49901,"_5":14097,"_26932":49719,"_2867":49902},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_3381":542,"_29612":484,"_20544":49904,"_5":14097,"_26932":49719,"_2867":49905},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_3381":543,"_29612":484,"_20544":49907,"_5":14097,"_26932":49719,"_2867":49908},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_3381":544,"_29612":484,"_20544":49910,"_5":14097,"_26932":49719,"_2867":49911},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_3381":545,"_29612":484,"_20544":49913,"_5":14097,"_26932":49719,"_2867":49914},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_3381":546,"_29612":484,"_20544":49916,"_5":14097,"_26932":49719,"_2867":49917},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_3381":547,"_29612":484,"_20544":49919,"_5":14097,"_26932":49719,"_2867":49920},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_3381":548,"_29612":484,"_20544":49922,"_5":14097,"_26932":49723,"_2867":49923},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_3381":549,"_29612":484,"_20544":49925,"_5":14097,"_26932":49723,"_2867":49926},[],"The decision is made with the domain operation context:",{"_3381":550,"_29612":484,"_20544":49928,"_5":14097,"_26932":49723,"_2867":49929},[],"The middleware extracts the credential and resolves the matching principals.",{"_3381":551,"_29612":484,"_20544":49931,"_5":14097,"_26932":49723,"_2867":49932},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_3381":552,"_29612":484,"_20544":49934,"_5":14097,"_26932":49723,"_2867":49935},[],"`authz` gathers the entity rules of the granted policies.",{"_3381":553,"_29612":484,"_20544":49937,"_5":14097,"_26932":49723,"_2867":49938},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_3381":554,"_29612":484,"_20544":49940,"_5":14097,"_26932":49723,"_2867":49941},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_3381":555,"_29612":484,"_20544":49943,"_5":14097,"_26932":49723,"_2867":49944},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_3381":556,"_29612":484,"_20544":49946,"_5":14097,"_26932":49723,"_2867":49947},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_3381":557,"_29612":484,"_20544":49949,"_5":14097,"_26932":49723,"_2867":49950},[],"Actions fall into two groups:",{"_3381":558,"_29612":484,"_20544":49952,"_5":14097,"_26932":49723,"_2867":49953},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_3381":559,"_29612":484,"_20544":49955,"_5":14097,"_26932":49723,"_2867":49956},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_3381":560,"_29612":484,"_20544":49958,"_5":14097,"_26932":49723,"_2867":49959},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_3381":561,"_29612":484,"_20544":49961,"_5":14097,"_26932":49727,"_2867":49962},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_3381":562,"_29612":484,"_20544":49964,"_5":14097,"_26932":49727,"_2867":49965},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_3381":563,"_29612":484,"_20544":49967,"_5":14097,"_26932":49727,"_2867":49968},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_3381":564,"_29612":484,"_20544":49970,"_5":14097,"_26932":49731,"_2867":49971},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_3381":565,"_29612":484,"_20544":49973,"_5":14097,"_26932":49731,"_2867":49974},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_3381":566,"_29612":484,"_20544":49976,"_5":14097,"_26932":49731,"_2867":49977},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_3381":567,"_29612":484,"_20544":49979,"_5":14097,"_26932":49731,"_2867":49980},[],"The implemented operators are:",{"_3381":568,"_29612":484,"_20544":49982,"_5":14097,"_26932":49731,"_2867":49983},[],"`equals`, for exact equality;",{"_3381":569,"_29612":484,"_20544":49985,"_5":14097,"_26932":49731,"_2867":49986},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_3381":570,"_29612":484,"_20544":49988,"_5":14097,"_26932":49731,"_2867":49989},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_3381":571,"_29612":484,"_20544":49991,"_5":14097,"_26932":49731,"_2867":49992},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_3381":572,"_29612":484,"_20544":49994,"_5":14097,"_26932":49735,"_2867":49995},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_3381":573,"_29612":484,"_20544":49997,"_5":14097,"_26932":49735,"_2867":49998},[],"The available modes are:",{"_3381":574,"_29612":484,"_20544":50000,"_5":14097,"_26932":49735,"_2867":50001},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_3381":575,"_29612":484,"_20544":50003,"_5":14097,"_26932":49735,"_2867":50004},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_3381":576,"_29612":484,"_20544":50006,"_5":14097,"_26932":49735,"_2867":50007},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_3381":577,"_29612":484,"_20544":50009,"_5":14097,"_26932":49735,"_2867":50010},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_3381":578,"_29612":484,"_20544":50012,"_5":14097,"_26932":49735,"_2867":50013},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_3381":579,"_29612":484,"_20544":50015,"_5":14097,"_26932":49735,"_2867":50016},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_3381":580,"_29612":484,"_20544":50018,"_5":14097,"_26932":49739,"_2867":50019},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_3381":581,"_29612":484,"_20544":50021,"_5":14097,"_26932":49739,"_2867":50022},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_3381":582,"_29612":484,"_20544":50024,"_5":14097,"_26932":49739,"_2867":50025},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_3381":583,"_29612":484,"_20544":50027,"_5":14097,"_26932":49739,"_2867":50028},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_3381":584,"_29612":484,"_20544":50030,"_5":14097,"_26932":49747,"_2867":50031},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_3381":585,"_29612":484,"_20544":50033,"_5":14097,"_26932":49747,"_2867":50034},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_3381":586,"_29612":484,"_20544":50036,"_5":14097,"_26932":49751,"_2867":50037},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA and of a device to its DMS. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_3381":587,"_29612":484,"_20544":50039,"_5":14097,"_26932":49751,"_2867":50040},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_3381":588,"_29612":484,"_20544":50042,"_5":14097,"_26932":49755,"_2867":50043},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_3381":589,"_29612":484,"_20544":50045,"_5":14097,"_26932":49755,"_2867":50046},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_3381":590,"_29612":484,"_20544":50048,"_5":14097,"_26932":49755,"_2867":50049},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_3381":591,"_29612":484,"_20544":50051,"_5":14097,"_26932":49759,"_2867":50052},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_3381":592,"_29612":484,"_20544":50054,"_5":14097,"_26932":49759,"_2867":50055},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_3381":593,"_29612":484,"_20544":50057,"_5":14097,"_26932":49759,"_2867":50058},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_3381":594,"_29612":484,"_20544":50060,"_5":14097,"_26932":49759,"_2867":50061},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_3381":595,"_29612":484,"_20544":50063,"_5":14097,"_26932":49759,"_2867":50064},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_3381":596,"_29612":484,"_20544":50066,"_5":14097,"_26932":49759,"_2867":50067},[],"Note that:",{"_3381":597,"_29612":484,"_20544":50069,"_5":14097,"_26932":49759,"_2867":50070},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_3381":598,"_29612":484,"_20544":50072,"_5":14097,"_26932":49759,"_2867":50073},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_3381":599,"_29612":484,"_20544":50075,"_5":14097,"_26932":49759,"_2867":50076},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_3381":600,"_29612":484,"_20544":50078,"_5":14097,"_26932":49763,"_2867":50079},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_3381":601,"_29612":484,"_20544":50081,"_5":14097,"_26932":49763,"_2867":50082},[],"full and read-only access to certificates and authorities;",{"_3381":602,"_29612":484,"_20544":50084,"_5":14097,"_26932":49763,"_2867":50085},[],"full and read-only access to the KMS;",{"_3381":603,"_29612":484,"_20544":50087,"_5":14097,"_26932":49763,"_2867":50088},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_3381":604,"_29612":484,"_20544":50090,"_5":14097,"_26932":49763,"_2867":50091},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_3381":605,"_29612":484,"_20544":50093,"_5":14097,"_26932":49763,"_2867":50094},[],"console access;",{"_3381":606,"_29612":484,"_20544":50096,"_5":14097,"_26932":49763,"_2867":50097},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_3381":607,"_29612":484,"_20544":50099,"_5":14097,"_26932":49763,"_2867":50100},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_3381":608,"_29612":484,"_20544":50102,"_5":14097,"_26932":49763,"_2867":50103},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_3381":609,"_29612":484,"_20544":50105,"_5":14097,"_26932":49767,"_2867":50106},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_3381":610,"_29612":484,"_20544":50108,"_5":14097,"_26932":49767,"_2867":50109},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_3381":611,"_29612":484,"_20544":50111,"_5":14097,"_26932":49767,"_2867":50112},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_3381":612,"_29612":484,"_20544":50114,"_5":14097,"_26932":49770,"_2867":50115},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_3381":613,"_29612":484,"_20544":50117,"_5":14097,"_26932":49774,"_2867":50118},[],"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`.",{"_3381":614,"_29612":484,"_20544":50120,"_5":14097,"_26932":49774,"_2867":50121},[],"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0.",{"_3381":615,"_29612":484,"_20544":50123,"_5":14097,"_26932":49778,"_2867":50124},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_3381":616,"_29612":484,"_20544":50126,"_5":14097,"_26932":49782,"_2867":50127},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_3381":617,"_29612":484,"_20544":50129,"_5":14097,"_26932":49786,"_2867":50130},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_3381":618,"_29612":484,"_20544":50132,"_5":14097,"_26932":49790,"_2867":50133},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_3381":619,"_29612":484,"_20544":50135,"_5":14097,"_26932":49790,"_2867":50136},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_3381":620,"_29612":484,"_20544":50138,"_5":14097,"_26932":49794,"_2867":50139},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_3381":621,"_29612":484,"_20544":50141,"_5":14097,"_26932":49794,"_2867":50142},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_3381":622,"_29612":484,"_20544":50144,"_5":14097,"_26932":49794,"_2867":50145},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_3381":623,"_29612":484,"_20544":50147,"_5":14097,"_26932":49794,"_2867":50148},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_3381":624,"_29612":484,"_20544":50150,"_5":14097,"_26932":49794,"_2867":50151},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_3381":625,"_29612":484,"_20544":50153,"_5":14097,"_26932":49794,"_2867":50154},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_3381":626,"_29612":484,"_20544":50156,"_5":14097,"_26932":49794,"_2867":50157},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_3381":627,"_29612":484,"_20544":50159,"_5":14097,"_26932":49794,"_2867":50160},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_3381":628,"_29612":484,"_20544":50162,"_5":14097,"_26932":49798,"_2867":50163},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_3381":629,"_29612":484,"_20544":50165,"_5":14097,"_26932":49798,"_2867":50166},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_3381":630,"_29612":484,"_20544":50168,"_5":14097,"_26932":49798,"_2867":50169},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_3381":631,"_29612":484,"_20544":50171,"_5":14097,"_26932":49802,"_2867":50172},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_3381":632,"_29612":484,"_20544":50174,"_5":14097,"_26932":49802,"_2867":50175},[],"Use groups or stable roles for people and independent identities for automations.",{"_3381":633,"_29612":484,"_20544":50177,"_5":14097,"_26932":49802,"_2867":50178},[],"Keep at least two recovery administrators and test their access periodically.",{"_3381":634,"_29612":484,"_20544":50180,"_5":14097,"_26932":49802,"_2867":50181},[],"Review active principals, their matches and their grants after IdP changes.",{"_3381":635,"_29612":484,"_20544":50183,"_5":14097,"_26932":49802,"_2867":50184},[],"Search for wildcards in policies before upgrading Lamassu.",{"_3381":636,"_29612":484,"_20544":50186,"_5":14097,"_26932":49802,"_2867":50187},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_3381":637,"_29612":484,"_20544":50189,"_5":14097,"_26932":49802,"_2867":50190},[],"Always test one allowed and one denied operation for each role.",{"_3381":638,"_29612":484,"_20544":50192,"_5":14097,"_26932":49802,"_2867":50193},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_3381":639,"_29612":484,"_20544":50195,"_5":14097,"_26932":49810,"_2867":50196},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_3381":640,"_29612":484,"_20544":50198,"_5":14097,"_26932":49814,"_2867":50199},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_3381":641,"_29612":484,"_20544":50201,"_5":14097,"_26932":49814,"_2867":50202},[],"that an active principal of the correct type exists;",{"_3381":642,"_29612":484,"_20544":50204,"_5":14097,"_26932":49814,"_2867":50205},[],"that the claim paths and values match the real token exactly;",{"_3381":643,"_29612":484,"_20544":50207,"_5":14097,"_26932":49814,"_2867":50208},[],"that all of the principal's conditions hold;",{"_3381":644,"_29612":484,"_20544":50210,"_5":14097,"_26932":49814,"_2867":50211},[],"that the principal has the expected policy granted;",{"_3381":645,"_29612":484,"_20544":50213,"_5":14097,"_26932":49814,"_2867":50214},[],"that the policy includes the action and the requested resource type or route;",{"_3381":646,"_29612":484,"_20544":50216,"_5":14097,"_26932":49814,"_2867":50217},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_3381":647,"_29612":484,"_20544":50219,"_5":14097,"_26932":49814,"_2867":50220},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry tracing enabled, a request that reaches the policy engine produces an `engine.CheckHTTPRequest` span whose attributes record `authz.allowed`, the matched policy and the matched principal. Correlation with the Gateway trace requires trace context to be propagated to authz.",{"_3381":648,"_29612":484,"_20544":50222,"_5":14097,"_26932":49818,"_2867":50223},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_3381":649,"_29612":484,"_20544":50225,"_5":14097,"_26932":49822,"_2867":50226},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_3381":650,"_29612":484,"_20544":50228,"_5":14097,"_26932":49826,"_2867":50229},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_3381":651,"_29612":484,"_20544":50231,"_5":14097,"_26932":49826,"_2867":50232},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_3381":652,"_29612":652,"_5":14455,"_2867":50234,"_29965":50235,"_20544":50236,"_26932":652},"Alerts and subscriptions",[48231,49699,49700],[],{"_3381":653,"_29612":652,"_20544":50238,"_5":14097,"_26932":652,"_2867":50239},[],"Send PKI events to people and external systems.",{"_3381":654,"_29612":652,"_5":29962,"_20544":50241,"_26932":50242,"_2867":50243},[],"/docs/pr-preview/pr-53/platform/administration/alerts#how-it-works","How it works",{"_3381":655,"_29612":652,"_5":29962,"_20544":50245,"_26932":50246,"_2867":50247},[],"/docs/pr-preview/pr-53/platform/administration/alerts#available-channels","Available channels",{"_3381":656,"_29612":652,"_5":29962,"_20544":50249,"_26932":50250,"_2867":50251},[],"/docs/pr-preview/pr-53/platform/administration/alerts#create-a-subscription","Create a subscription",{"_3381":657,"_29612":652,"_5":29962,"_20544":50253,"_26932":50254,"_2867":50255},[],"/docs/pr-preview/pr-53/platform/administration/alerts#choose-the-event","Choose the event",{"_3381":658,"_29612":652,"_5":29962,"_20544":50257,"_26932":50258,"_2867":50259},[],"/docs/pr-preview/pr-53/platform/administration/alerts#configure-the-destination","Configure the destination",{"_3381":659,"_29612":652,"_5":29962,"_20544":50261,"_26932":50262,"_2867":50263},[],"/docs/pr-preview/pr-53/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_3381":660,"_29612":652,"_5":29962,"_20544":50265,"_26932":50266,"_2867":50267},[],"/docs/pr-preview/pr-53/platform/administration/alerts#review-and-activate","Review and activate",{"_3381":661,"_29612":652,"_5":29962,"_20544":50269,"_26932":50270,"_2867":50271},[],"/docs/pr-preview/pr-53/platform/administration/alerts#configure-the-webhook-http-client","Configure the webhook HTTP client",{"_3381":662,"_29612":652,"_5":29962,"_20544":50273,"_26932":50274,"_2867":50275},[],"/docs/pr-preview/pr-53/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_3381":663,"_29612":652,"_5":29962,"_20544":50277,"_26932":50278,"_2867":50279},[],"/docs/pr-preview/pr-53/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_3381":664,"_29612":652,"_5":29962,"_20544":50281,"_26932":50282,"_2867":50283},[],"/docs/pr-preview/pr-53/platform/administration/alerts#event-families","Event families",{"_3381":665,"_29612":652,"_20544":50285,"_5":14097,"_26932":652,"_2867":50286},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_3381":666,"_29612":652,"_20544":50288,"_5":14097,"_26932":50242,"_2867":50289},[],"A service publishes a domain event.",{"_3381":667,"_29612":652,"_20544":50291,"_5":14097,"_26932":50242,"_2867":50292},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_3381":668,"_29612":652,"_20544":50294,"_5":14097,"_26932":50242,"_2867":50295},[],"Each subscription's filter decides whether it should be notified.",{"_3381":669,"_29612":652,"_20544":50297,"_5":14097,"_26932":50242,"_2867":50298},[],"Lamassu delivers the event to the configured channel.",{"_3381":670,"_29612":652,"_20544":50300,"_5":14097,"_26932":50242,"_2867":50301},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_3381":671,"_29612":652,"_20544":50303,"_5":14097,"_26932":50246,"_2867":50304},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_3381":672,"_29612":652,"_20544":50306,"_5":14097,"_26932":50246,"_2867":50307},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_3381":673,"_29612":652,"_20544":50309,"_5":14097,"_26932":50246,"_2867":50310},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_3381":674,"_29612":652,"_20544":50312,"_5":14097,"_26932":50246,"_2867":50313},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_3381":675,"_29612":652,"_20544":50315,"_5":14097,"_26932":50246,"_2867":50316},[],"`apikey_options` requires `header` and `key`.",{"_3381":676,"_29612":652,"_20544":50318,"_5":14097,"_26932":50246,"_2867":50319},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3381":677,"_29612":652,"_20544":50321,"_5":14097,"_26932":50246,"_2867":50322},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_3381":678,"_29612":652,"_20544":50324,"_5":14097,"_26932":50246,"_2867":50325},[],"The alerts API reference documents the full `http_client` schema.",{"_3381":679,"_29612":652,"_20544":50327,"_5":14097,"_26932":50254,"_2867":50328},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_3381":680,"_29612":652,"_20544":50330,"_5":14097,"_26932":50258,"_2867":50331},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_3381":681,"_29612":652,"_20544":50333,"_5":14097,"_26932":50262,"_2867":50334},[],"Add a filter if you don't want to receive every instance of the event.",{"_3381":682,"_29612":652,"_20544":50336,"_5":14097,"_26932":50262,"_2867":50337},[],"**None** notifies all instances of the event.",{"_3381":683,"_29612":652,"_20544":50339,"_5":14097,"_26932":50262,"_2867":50340},[],"**JSON Path** evaluates one or more specific fields.",{"_3381":684,"_29612":652,"_20544":50342,"_5":14097,"_26932":50262,"_2867":50343},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_3381":685,"_29612":652,"_20544":50345,"_5":14097,"_26932":50262,"_2867":50346},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_3381":686,"_29612":652,"_20544":50348,"_5":14097,"_26932":50262,"_2867":50349},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_3381":687,"_29612":652,"_20544":50351,"_5":14097,"_26932":50262,"_2867":50352},[],"The console evaluates the filter against the JSON shown in the **Input Event** editor, which is prefilled with the latest event, and reports whether it matches. For JSON Path and JavaScript filters, it shows **The filter matches this Cloud Event** or **The filter does not match this Cloud Event**. JSON Path expressions are evaluated against the full Cloud Event, so the default `$.data` selects the event's `data` field, and the expression must start with `$`.",{"_3381":688,"_29612":652,"_20544":50354,"_5":14097,"_26932":50266,"_2867":50355},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_3381":689,"_29612":652,"_20544":50357,"_5":14097,"_26932":50270,"_2867":50358},[],"The Webhook and Microsoft Teams channels show this configuration in the subscribe form, at the channel step, and again when editing a subscription; Email does not use it. The fields map to the optional `http_client` block described above:",{"_3381":690,"_29612":652,"_20544":50360,"_5":14097,"_26932":50270,"_2867":50361},[],"**Log Level** selects `debug`, `info`, `warn` or `error`; `info` is the default.",{"_3381":691,"_29612":652,"_20544":50363,"_5":14097,"_26932":50270,"_2867":50364},[],"**Call Timeout** defaults to 10 seconds. The console rejects a value above 30 seconds with `Webhook timeout must be at most 30s.`; the API clamps the same value to the cap instead (see Calls are bounded).",{"_3381":692,"_29612":652,"_20544":50366,"_5":14097,"_26932":50270,"_2867":50367},[],"There is no TLS-verification switch for these channels, because the service always verifies the receiver certificate (see TLS is always verified).",{"_3381":693,"_29612":652,"_20544":50369,"_5":14097,"_26932":50270,"_2867":50370},[],"**HTTP Authentication** selects `No Authentication` (the default), `API Key` (API key value and Header Name, `X-API-Key` by default), `OIDC Client Credentials` (Client ID, Client Secret and Well-Known URL) or `Mutual TLS` (Client Certificate and Client Private Key pasted as PEM). A stored private key stays hidden until you select **Show**.",{"_3381":694,"_29612":652,"_20544":50372,"_5":14097,"_26932":50270,"_2867":50373},[],"A `http://` URL shows the console warning `Unencrypted HTTP connection` (see the Credentials over http\\:// callout below).",{"_3381":695,"_29612":652,"_20544":50375,"_5":14097,"_26932":50270,"_2867":50376},[],"The form validates inline against the same delivery rules: the webhook URL and the OIDC Well-Known URL must be absolute `http` or `https` URLs, an API-key header may not use a reserved name, and the mTLS certificate and key must be PEM content, not file paths.",{"_3381":696,"_29612":652,"_20544":50378,"_5":14097,"_26932":50270,"_2867":50379},[],"The summary in the Confirm step shows the authentication as `None`, `OIDC client credentials`, `API key` or `Mutual TLS`. The subscription details show the authentication, the API key header name (never the value), the OIDC issuer URL, mTLS as `Configured` and a fixed `TLS verification: Verified` row. The API key, client secret and private key are not shown in the subscription details.",{"_3381":697,"_29612":652,"_20544":50381,"_5":14097,"_26932":50274,"_2867":50382},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_3381":698,"_29612":652,"_20544":50384,"_5":14097,"_26932":50274,"_2867":50385},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_3381":699,"_29612":652,"_20544":50387,"_5":14097,"_26932":50274,"_2867":50388},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_3381":700,"_29612":652,"_20544":50390,"_5":14097,"_26932":50274,"_2867":50391},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_3381":701,"_29612":652,"_20544":50393,"_5":14097,"_26932":50274,"_2867":50394},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_3381":702,"_29612":652,"_20544":50396,"_5":14097,"_26932":50274,"_2867":50397},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_3381":703,"_29612":652,"_20544":50399,"_5":14097,"_26932":50274,"_2867":50400},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_3381":704,"_29612":652,"_20544":50402,"_5":14097,"_26932":50274,"_2867":50403},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_3381":705,"_29612":652,"_20544":50405,"_5":14097,"_26932":50278,"_2867":50406},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_3381":706,"_29612":652,"_20544":50408,"_5":14097,"_26932":50278,"_2867":50409},[],"Subscriptions created with older console versions may store the webhook target under `url` and `method` instead of `webhook_url` and `webhook_method`. The service delivers only through `webhook_url` and `webhook_method`, so such a subscription does not deliver even though the subscription details show the stored target. Open the subscription and save it again: the edit form prefills the stored target, and saving rewrites the channel configuration in the current layout.",{"_3381":707,"_29612":652,"_20544":50411,"_5":14097,"_26932":50282,"_2867":50412},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_3381":708,"_29612":652,"_20544":50414,"_5":14097,"_26932":50282,"_2867":50415},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_3381":709,"_29612":652,"_20544":50417,"_5":14097,"_26932":50282,"_2867":50418},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_3381":710,"_29612":652,"_20544":50420,"_5":14097,"_26932":50282,"_2867":50421},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_3381":711,"_29612":652,"_20544":50423,"_5":14097,"_26932":50282,"_2867":50424},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_3381":712,"_29612":652,"_20544":50426,"_5":14097,"_26932":50282,"_2867":50427},[],"**Validation:** `va.role.crl.create`.",{"_3381":713,"_29612":652,"_20544":50429,"_5":14097,"_26932":50282,"_2867":50430},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_3381":714,"_29612":652,"_20544":50432,"_5":14097,"_26932":50282,"_2867":50433},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_3381":715,"_29612":715,"_5":14455,"_2867":50435,"_29965":50436,"_20544":50437,"_26932":715},"Audit logs",[48231,49699,49700],[],{"_3381":716,"_29612":715,"_20544":50439,"_5":14097,"_26932":715,"_2867":50440},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_3381":717,"_29612":715,"_5":29962,"_20544":50442,"_26932":50443,"_2867":50444},[],"/docs/pr-preview/pr-53/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_3381":718,"_29612":715,"_5":29962,"_20544":50446,"_26932":50447,"_2867":50448},[],"/docs/pr-preview/pr-53/platform/administration/audit-logs#coverage","Coverage",{"_3381":719,"_29612":715,"_5":29962,"_20544":50450,"_26932":50451,"_2867":50452},[],"/docs/pr-preview/pr-53/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_3381":720,"_29612":715,"_5":29962,"_20544":50454,"_26932":50455,"_2867":50456},[],"/docs/pr-preview/pr-53/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_3381":721,"_29612":715,"_5":29962,"_20544":50458,"_26932":50459,"_2867":50460},[],"/docs/pr-preview/pr-53/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_3381":722,"_29612":715,"_5":29962,"_20544":50462,"_26932":50463,"_2867":50464},[],"/docs/pr-preview/pr-53/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_3381":723,"_29612":715,"_5":29962,"_20544":50466,"_26932":50467,"_2867":50468},[],"/docs/pr-preview/pr-53/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_3381":724,"_29612":715,"_5":29962,"_20544":50470,"_26932":50471,"_2867":50472},[],"/docs/pr-preview/pr-53/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_3381":725,"_29612":715,"_5":29962,"_20544":50474,"_26932":50475,"_2867":50476},[],"/docs/pr-preview/pr-53/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_3381":726,"_29612":715,"_5":29962,"_20544":50478,"_26932":50479,"_2867":50480},[],"/docs/pr-preview/pr-53/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_3381":727,"_29612":715,"_5":29962,"_20544":50482,"_26932":50483,"_2867":50484},[],"/docs/pr-preview/pr-53/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_3381":728,"_29612":715,"_20544":50486,"_5":14097,"_26932":715,"_2867":50487},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_3381":729,"_29612":715,"_20544":50489,"_5":14097,"_26932":50443,"_2867":50490},[],"The audit body includes:",{"_3381":730,"_29612":715,"_20544":50492,"_5":14097,"_26932":50443,"_2867":50493},[],"input: data received by the operation;",{"_3381":731,"_29612":715,"_20544":50495,"_5":14097,"_26932":50443,"_2867":50496},[],"has\\_error: whether the service returned an error;",{"_3381":732,"_29612":715,"_20544":50498,"_5":14097,"_26932":50443,"_2867":50499},[],"output: produced result or error message;",{"_3381":733,"_29612":715,"_20544":50501,"_5":14097,"_26932":50443,"_2867":50502},[],"principals: identifiers of the principals that matched the request.",{"_3381":734,"_29612":715,"_20544":50504,"_5":14097,"_26932":50443,"_2867":50505},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_3381":735,"_29612":715,"_20544":50507,"_5":14097,"_26932":50443,"_2867":50508},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_3381":736,"_29612":715,"_20544":50510,"_5":14097,"_26932":50447,"_2867":50511},[],"The backend applies auditing to mutations of:",{"_3381":737,"_29612":715,"_20544":50513,"_5":14097,"_26932":50447,"_2867":50514},[],"authorities, certificates and issuance profiles;",{"_3381":738,"_29612":715,"_20544":50516,"_5":14097,"_26932":50447,"_2867":50517},[],"keys and KMS engines;",{"_3381":739,"_29612":715,"_20544":50519,"_5":14097,"_26932":50447,"_2867":50520},[],"devices and identities;",{"_3381":740,"_29612":715,"_20544":50522,"_5":14097,"_26932":50447,"_2867":50523},[],"DMSs and enrollment operations;",{"_3381":741,"_29612":715,"_20544":50525,"_5":14097,"_26932":50447,"_2867":50526},[],"validation functions and CRL;",{"_3381":742,"_29612":715,"_20544":50528,"_5":14097,"_26932":50447,"_2867":50529},[],"principals, policies and authorization grants.",{"_3381":743,"_29612":715,"_20544":50531,"_5":14097,"_26932":50447,"_2867":50532},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_3381":744,"_29612":715,"_20544":50534,"_5":14097,"_26932":50451,"_2867":50535},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_3381":745,"_29612":715,"_20544":50537,"_5":14097,"_26932":50451,"_2867":50538},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_3381":746,"_29612":715,"_20544":50540,"_5":14097,"_26932":50451,"_2867":50541},[],"Design the consumer to:",{"_3381":747,"_29612":715,"_20544":50543,"_5":14097,"_26932":50451,"_2867":50544},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_3381":748,"_29612":715,"_20544":50546,"_5":14097,"_26932":50451,"_2867":50547},[],"keep the complete CloudEvent unmodified;",{"_3381":749,"_29612":715,"_20544":50549,"_5":14097,"_26932":50451,"_2867":50550},[],"record the ingestion time and detect duplicates by ID;",{"_3381":750,"_29612":715,"_20544":50552,"_5":14097,"_26932":50451,"_2867":50553},[],"encrypt in transit and at rest;",{"_3381":751,"_29612":715,"_20544":50555,"_5":14097,"_26932":50451,"_2867":50556},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_3381":752,"_29612":715,"_20544":50558,"_5":14097,"_26932":50451,"_2867":50559},[],"apply an explicit retention and legal hold policy;",{"_3381":753,"_29612":715,"_20544":50561,"_5":14097,"_26932":50451,"_2867":50562},[],"alert if it stops consuming or the pending queue grows.",{"_3381":754,"_29612":715,"_20544":50564,"_5":14097,"_26932":50455,"_2867":50565},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_3381":755,"_29612":715,"_20544":50567,"_5":14097,"_26932":50455,"_2867":50568},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_3381":756,"_29612":715,"_20544":50570,"_5":14097,"_26932":50463,"_2867":50571},[],"Start from the reported time and normalize every source to UTC.",{"_3381":757,"_29612":715,"_20544":50573,"_5":14097,"_26932":50467,"_2867":50574},[],"Filter by event type, service source and resource identifier.",{"_3381":758,"_29612":715,"_20544":50576,"_5":14097,"_26932":50471,"_2867":50577},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_3381":759,"_29612":715,"_20544":50579,"_5":14097,"_26932":50475,"_2867":50580},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_3381":760,"_29612":715,"_20544":50582,"_5":14097,"_26932":50479,"_2867":50583},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_3381":761,"_29612":715,"_20544":50585,"_5":14097,"_26932":50483,"_2867":50586},[],"Generate a controlled mutation in a test environment and check that:",{"_3381":762,"_29612":715,"_20544":50588,"_5":14097,"_26932":50483,"_2867":50589},[],"a successful audit event appears;",{"_3381":763,"_29612":715,"_20544":50591,"_5":14097,"_26932":50483,"_2867":50592},[],"the principal matches the identity used;",{"_3381":764,"_29612":715,"_20544":50594,"_5":14097,"_26932":50483,"_2867":50595},[],"the consumer persists it exactly once;",{"_3381":765,"_29612":715,"_20544":50597,"_5":14097,"_26932":50483,"_2867":50598},[],"it can be retrieved by resource, actor and period;",{"_3381":766,"_29612":715,"_20544":50600,"_5":14097,"_26932":50483,"_2867":50601},[],"a consumer outage raises an alert.",{"_3381":767,"_29612":715,"_20544":50603,"_5":14097,"_26932":50483,"_2867":50604},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_3381":768,"_29612":768,"_5":14455,"_2867":50606,"_29965":50607,"_20544":50608,"_26932":768},"Platform architecture",[48231,49699],[],{"_3381":769,"_29612":768,"_20544":50610,"_5":14097,"_26932":768,"_2867":50611},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_3381":770,"_29612":768,"_5":29962,"_20544":50613,"_26932":50614,"_2867":50615},[],"/docs/pr-preview/pr-53/platform/concepts/architecture#control-plane","Control plane",{"_3381":771,"_29612":768,"_5":29962,"_20544":50617,"_26932":50618,"_2867":50619},[],"/docs/pr-preview/pr-53/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_3381":772,"_29612":768,"_5":29962,"_20544":50621,"_26932":50622,"_2867":50623},[],"/docs/pr-preview/pr-53/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_3381":773,"_29612":768,"_5":29962,"_20544":50625,"_26932":50626,"_2867":50627},[],"/docs/pr-preview/pr-53/platform/concepts/architecture#status-and-validation","Status and validation",{"_3381":774,"_29612":768,"_5":29962,"_20544":50629,"_26932":50630,"_2867":50631},[],"/docs/pr-preview/pr-53/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_3381":775,"_29612":768,"_20544":50633,"_5":14097,"_26932":768,"_2867":50634},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_3381":776,"_29612":768,"_20544":50636,"_5":14097,"_26932":768,"_2867":50637},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_3381":777,"_29612":768,"_20544":50639,"_5":14097,"_26932":50614,"_2867":50640},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_3381":778,"_29612":768,"_20544":50642,"_5":14097,"_26932":50618,"_2867":50643},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_3381":779,"_29612":768,"_20544":50645,"_5":14097,"_26932":50622,"_2867":50646},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_3381":780,"_29612":768,"_20544":50648,"_5":14097,"_26932":50626,"_2867":50649},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_3381":781,"_29612":768,"_20544":50651,"_5":14097,"_26932":50630,"_2867":50652},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_3381":782,"_29612":782,"_5":14455,"_2867":50654,"_29965":50655,"_20544":50656,"_26932":782},"How Lamassu works",[48231,49699],[],{"_3381":783,"_29612":782,"_20544":50658,"_5":14097,"_26932":782,"_2867":50659},[],"The mental model of trust, keys, certificates and devices.",{"_3381":784,"_29612":782,"_5":29962,"_20544":50661,"_26932":50662,"_2867":50663},[],"/docs/pr-preview/pr-53/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_3381":785,"_29612":782,"_5":29962,"_20544":50665,"_26932":50666,"_2867":50667},[],"/docs/pr-preview/pr-53/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_3381":786,"_29612":782,"_20544":50669,"_5":14097,"_26932":782,"_2867":50670},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_3381":787,"_29612":782,"_20544":50672,"_5":14097,"_26932":50662,"_2867":50673},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_3381":788,"_29612":782,"_20544":50675,"_5":14097,"_26932":50662,"_2867":50676},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_3381":789,"_29612":782,"_20544":50678,"_5":14097,"_26932":50662,"_2867":50679},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_3381":790,"_29612":782,"_20544":50681,"_5":14097,"_26932":50662,"_2867":50682},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_3381":791,"_29612":782,"_20544":50684,"_5":14097,"_26932":50662,"_2867":50685},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_3381":792,"_29612":782,"_20544":50687,"_5":14097,"_26932":50666,"_2867":50688},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_3381":793,"_29612":782,"_20544":50690,"_5":14097,"_26932":50666,"_2867":50691},[],"A DMS relates that CA to an enrollment policy.",{"_3381":794,"_29612":782,"_20544":50693,"_5":14097,"_26932":50666,"_2867":50694},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_3381":795,"_29612":782,"_20544":50696,"_5":14097,"_26932":50666,"_2867":50697},[],"Lamassu keeps the inventory, history and status of the identity.",{"_3381":796,"_29612":782,"_20544":50699,"_5":14097,"_26932":50666,"_2867":50700},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_3381":797,"_29612":782,"_20544":50702,"_5":14097,"_26932":50666,"_2867":50703},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_3381":798,"_29612":782,"_20544":50705,"_5":14097,"_26932":50666,"_2867":50706},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3381":799,"_29612":799,"_5":14455,"_2867":50708,"_29965":50709,"_20544":50711,"_26932":799},"Devices and identities",[48231,49699,50710,50708],"IoT Fleets",[],{"_3381":800,"_29612":799,"_20544":50713,"_5":14097,"_26932":799,"_2867":50714},[],"Register, inspect and retire devices while checking their current identity and history.",{"_3381":801,"_29612":799,"_5":29962,"_20544":50716,"_26932":50717,"_2867":50718},[],"/docs/pr-preview/pr-53/platform/iot-fleets/device-management#device-states","Device states",{"_3381":802,"_29612":799,"_5":29962,"_20544":50720,"_26932":50721,"_2867":50722},[],"/docs/pr-preview/pr-53/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_3381":803,"_29612":799,"_5":29962,"_20544":50724,"_26932":50725,"_2867":50726},[],"/docs/pr-preview/pr-53/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_3381":804,"_29612":799,"_5":29962,"_20544":50728,"_26932":50729,"_2867":50730},[],"/docs/pr-preview/pr-53/platform/iot-fleets/device-management#create-the-device","Create the device",{"_3381":805,"_29612":799,"_5":29962,"_20544":50732,"_26932":50733,"_2867":50734},[],"/docs/pr-preview/pr-53/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_3381":806,"_29612":799,"_5":29962,"_20544":50736,"_26932":50737,"_2867":50738},[],"/docs/pr-preview/pr-53/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_3381":807,"_29612":799,"_5":29962,"_20544":50740,"_26932":50741,"_2867":50742},[],"/docs/pr-preview/pr-53/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_3381":808,"_29612":799,"_5":29962,"_20544":50744,"_26932":50745,"_2867":50746},[],"/docs/pr-preview/pr-53/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_3381":809,"_29612":799,"_5":29962,"_20544":50748,"_26932":50749,"_2867":50750},[],"/docs/pr-preview/pr-53/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_3381":810,"_29612":799,"_5":29962,"_20544":50752,"_26932":50753,"_2867":50754},[],"/docs/pr-preview/pr-53/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_3381":811,"_29612":799,"_5":29962,"_20544":50756,"_26932":50757,"_2867":50758},[],"/docs/pr-preview/pr-53/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_3381":812,"_29612":799,"_20544":50760,"_5":14097,"_26932":799,"_2867":50761},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_3381":813,"_29612":799,"_20544":50763,"_5":14097,"_26932":799,"_2867":50764},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_3381":814,"_29612":799,"_20544":50766,"_5":14097,"_26932":50717,"_2867":50767},[],"Operational view",{"_3381":815,"_29612":799,"_20544":50769,"_5":14097,"_26932":50717,"_2867":50770},[],"Meaning",{"_3381":816,"_29612":799,"_20544":50772,"_5":14097,"_26932":50717,"_2867":50773},[],"**No Identity**",{"_3381":817,"_29612":799,"_20544":50775,"_5":14097,"_26932":50717,"_2867":50776},[],"A record exists without an associated identity.",{"_3381":818,"_29612":799,"_20544":50778,"_5":14097,"_26932":50717,"_2867":50779},[],"**Active**",{"_3381":819,"_29612":799,"_20544":50781,"_5":14097,"_26932":50717,"_2867":50782},[],"The slot is active; also check certificate dates, status and usages.",{"_3381":820,"_29612":799,"_20544":50784,"_5":14097,"_26932":50717,"_2867":50785},[],"**Renewal Pending**",{"_3381":821,"_29612":799,"_20544":50787,"_5":14097,"_26932":50717,"_2867":50788},[],"The identity is in the operational renewal window.",{"_3381":822,"_29612":799,"_20544":50790,"_5":14097,"_26932":50717,"_2867":50791},[],"**Expiring Soon**",{"_3381":823,"_29612":799,"_20544":50793,"_5":14097,"_26932":50717,"_2867":50794},[],"Expiration is approaching according to configured thresholds.",{"_3381":824,"_29612":799,"_20544":50796,"_5":14097,"_26932":50717,"_2867":50797},[],"**Expired**",{"_3381":825,"_29612":799,"_20544":50799,"_5":14097,"_26932":50717,"_2867":50800},[],"The identity has expired.",{"_3381":826,"_29612":799,"_20544":50802,"_5":14097,"_26932":50717,"_2867":50803},[],"**Revoked**",{"_3381":827,"_29612":799,"_20544":50805,"_5":14097,"_26932":50717,"_2867":50806},[],"The identity is marked revoked.",{"_3381":828,"_29612":799,"_20544":50808,"_5":14097,"_26932":50717,"_2867":50809},[],"**Decommissioned**",{"_3381":829,"_29612":799,"_20544":50811,"_5":14097,"_26932":50717,"_2867":50812},[],"The record is retired and ordinary updates do not restore operation.",{"_3381":830,"_29612":799,"_20544":50814,"_5":14097,"_26932":50717,"_2867":50815},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_3381":831,"_29612":799,"_20544":50817,"_5":14097,"_26932":50721,"_2867":50818},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_3381":832,"_29612":799,"_20544":50820,"_5":14097,"_26932":50721,"_2867":50821},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_3381":833,"_29612":799,"_20544":50823,"_5":14097,"_26932":50721,"_2867":50824},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_3381":834,"_29612":799,"_20544":50826,"_5":14097,"_26932":50721,"_2867":50827},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_3381":835,"_29612":799,"_20544":50829,"_5":14097,"_26932":50725,"_2867":50830},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_3381":836,"_29612":799,"_20544":50832,"_5":14097,"_26932":50729,"_2867":50833},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_3381":837,"_29612":799,"_20544":50835,"_5":14097,"_26932":50733,"_2867":50836},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_3381":838,"_29612":799,"_20544":50838,"_5":14097,"_26932":50737,"_2867":50839},[],"Add model, environment or location tags and an icon according to your inventory.",{"_3381":839,"_29612":799,"_20544":50841,"_5":14097,"_26932":50741,"_2867":50842},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_3381":840,"_29612":799,"_20544":50844,"_5":14097,"_26932":50741,"_2867":50845},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_3381":841,"_29612":799,"_20544":50847,"_5":14097,"_26932":50745,"_2867":50848},[],"From **No Identity**, use **Assign Identity**:",{"_3381":842,"_29612":799,"_20544":50850,"_5":14097,"_26932":50745,"_2867":50851},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_3381":843,"_29612":799,"_20544":50853,"_5":14097,"_26932":50745,"_2867":50854},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_3381":844,"_29612":799,"_20544":50856,"_5":14097,"_26932":50745,"_2867":50857},[],"Confirm and read the serial, active version and history again.",{"_3381":845,"_29612":799,"_20544":50859,"_5":14097,"_26932":50745,"_2867":50860},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_3381":846,"_29612":799,"_20544":50862,"_5":14097,"_26932":50745,"_2867":50863},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_3381":847,"_29612":799,"_20544":50865,"_5":14097,"_26932":50749,"_2867":50866},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_3381":848,"_29612":799,"_20544":50868,"_5":14097,"_26932":50749,"_2867":50869},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_3381":849,"_29612":799,"_20544":50871,"_5":14097,"_26932":50753,"_2867":50872},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_3381":850,"_29612":799,"_20544":50874,"_5":14097,"_26932":50753,"_2867":50875},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_3381":851,"_29612":799,"_20544":50877,"_5":14097,"_26932":50753,"_2867":50878},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_3381":852,"_29612":799,"_20544":50880,"_5":14097,"_26932":50753,"_2867":50881},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_3381":853,"_29612":799,"_20544":50883,"_5":14097,"_26932":50757,"_2867":50884},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3381":854,"_29612":799,"_20544":50886,"_5":14097,"_26932":50757,"_2867":50887},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3381":855,"_29612":855,"_5":14455,"_2867":50889,"_29965":50890,"_20544":50892,"_26932":855},"Bootstrap identity and authentication",[48231,49699,50710,50708,50891],"Enrollment with PKI",[],{"_3381":856,"_29612":855,"_20544":50894,"_5":14097,"_26932":855,"_2867":50895},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_3381":857,"_29612":855,"_5":29962,"_20544":50897,"_26932":50898,"_2867":50899},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_3381":858,"_29612":855,"_5":29962,"_20544":50901,"_26932":50902,"_2867":50903},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_3381":859,"_29612":855,"_5":29962,"_20544":50905,"_26932":50906,"_2867":50907},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_3381":860,"_29612":855,"_5":29962,"_20544":50909,"_26932":50910,"_2867":50911},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_3381":861,"_29612":855,"_5":29962,"_20544":50913,"_26932":50914,"_2867":50915},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_3381":862,"_29612":855,"_20544":50917,"_5":14097,"_26932":855,"_2867":50918},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_3381":863,"_29612":855,"_20544":50920,"_5":14097,"_26932":50898,"_2867":50921},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_3381":864,"_29612":855,"_20544":50923,"_5":14097,"_26932":50898,"_2867":50924},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_3381":865,"_29612":855,"_20544":50926,"_5":14097,"_26932":50902,"_2867":50927},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_3381":866,"_29612":855,"_20544":50929,"_5":14097,"_26932":50902,"_2867":50930},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_3381":867,"_29612":855,"_20544":50932,"_5":14097,"_26932":50902,"_2867":50933},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_3381":868,"_29612":855,"_20544":50935,"_5":14097,"_26932":50906,"_2867":50936},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_3381":869,"_29612":855,"_20544":50938,"_5":14097,"_26932":50906,"_2867":50939},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_3381":870,"_29612":855,"_20544":50941,"_5":14097,"_26932":50910,"_2867":50942},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_3381":871,"_29612":855,"_20544":50944,"_5":14097,"_26932":50910,"_2867":50945},[],"Example body:",{"_3381":872,"_29612":855,"_20544":50947,"_5":14097,"_26932":50910,"_2867":50948},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_3381":873,"_29612":855,"_20544":50950,"_5":14097,"_26932":50910,"_2867":50951},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_3381":874,"_29612":855,"_20544":50953,"_5":14097,"_26932":50910,"_2867":50954},[],"Continuation requires a successful HTTP response and JSON:",{"_3381":875,"_29612":855,"_20544":50956,"_5":14097,"_26932":50910,"_2867":50957},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_3381":876,"_29612":855,"_20544":50959,"_5":14097,"_26932":50914,"_2867":50960},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_3381":877,"_29612":855,"_20544":50962,"_5":14097,"_26932":50914,"_2867":50963},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_3381":878,"_29612":878,"_5":14455,"_2867":50965,"_29965":50966,"_20544":50967,"_26932":878},"Configure and operate the DMS",[48231,49699,50710,50708,50891],[],{"_3381":879,"_29612":878,"_20544":50969,"_5":14097,"_26932":878,"_2867":50970},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_3381":880,"_29612":878,"_5":29962,"_20544":50972,"_26932":50973,"_2867":48241},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/dms#before-you-begin",{"_3381":881,"_29612":878,"_5":29962,"_20544":50975,"_26932":50976,"_2867":50977},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_3381":882,"_29612":878,"_5":29962,"_20544":50979,"_26932":50980,"_2867":50981},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_3381":883,"_29612":878,"_5":29962,"_20544":50983,"_26932":50984,"_2867":50985},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_3381":884,"_29612":878,"_5":29962,"_20544":50987,"_26932":50988,"_2867":50989},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_3381":885,"_29612":878,"_5":29962,"_20544":50991,"_26932":50992,"_2867":50993},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_3381":886,"_29612":878,"_5":29962,"_20544":50995,"_26932":50996,"_2867":50997},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_3381":887,"_29612":878,"_5":29962,"_20544":50999,"_26932":51000,"_2867":51001},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_3381":888,"_29612":878,"_5":29962,"_20544":51003,"_26932":51004,"_2867":51005},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_3381":889,"_29612":878,"_5":29962,"_20544":51007,"_26932":51008,"_2867":51009},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_3381":890,"_29612":878,"_5":29962,"_20544":51011,"_26932":51012,"_2867":51013},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_3381":891,"_29612":878,"_5":29962,"_20544":51015,"_26932":51016,"_2867":51017},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_3381":892,"_29612":878,"_5":29962,"_20544":51019,"_26932":51020,"_2867":51021},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_3381":893,"_29612":878,"_5":29962,"_20544":51023,"_26932":51024,"_2867":51025},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_3381":894,"_29612":878,"_5":29962,"_20544":51027,"_26932":51028,"_2867":51029},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_3381":895,"_29612":878,"_5":29962,"_20544":51031,"_26932":51032,"_2867":51033},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_3381":896,"_29612":878,"_5":29962,"_20544":51035,"_26932":51036,"_2867":51037},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_3381":897,"_29612":878,"_5":29962,"_20544":51039,"_26932":51040,"_2867":51041},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_3381":898,"_29612":878,"_20544":51043,"_5":14097,"_26932":878,"_2867":51044},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_3381":899,"_29612":878,"_20544":51046,"_5":14097,"_26932":50973,"_2867":51047},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_3381":900,"_29612":878,"_20544":51049,"_5":14097,"_26932":50973,"_2867":51050},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_3381":901,"_29612":878,"_20544":51052,"_5":14097,"_26932":50980,"_2867":51053},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_3381":902,"_29612":878,"_20544":51055,"_5":14097,"_26932":50984,"_2867":51056},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_3381":903,"_29612":878,"_20544":51058,"_5":14097,"_26932":50988,"_2867":51059},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_3381":904,"_29612":878,"_20544":51061,"_5":14097,"_26932":50992,"_2867":51062},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_3381":905,"_29612":878,"_20544":51064,"_5":14097,"_26932":50996,"_2867":51065},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_3381":906,"_29612":878,"_20544":51067,"_5":14097,"_26932":51004,"_2867":51068},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_3381":907,"_29612":878,"_20544":51070,"_5":14097,"_26932":51004,"_2867":51071},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_3381":908,"_29612":878,"_20544":51073,"_5":14097,"_26932":51008,"_2867":51074},[],"`settings.enrollment_settings` field",{"_3381":909,"_29612":878,"_20544":51076,"_5":14097,"_26932":51008,"_2867":51077},[],"Decision",{"_3381":910,"_29612":878,"_20544":51079,"_5":14097,"_26932":51008,"_2867":51080},[],"`protocol`",{"_3381":911,"_29612":878,"_20544":51082,"_5":14097,"_26932":51008,"_2867":51083},[],"`EST_RFC7030` for these operations.",{"_3381":912,"_29612":878,"_20544":51085,"_5":14097,"_26932":51008,"_2867":51086},[],"`enrollment_ca`",{"_3381":913,"_29612":878,"_20544":51088,"_5":14097,"_26932":51008,"_2867":51089},[],"ID of the signing CA.",{"_3381":914,"_29612":878,"_20544":51091,"_5":14097,"_26932":51008,"_2867":51092},[],"`verify_csr_signature`",{"_3381":915,"_29612":878,"_20544":51094,"_5":14097,"_26932":51008,"_2867":51095},[],"Keep `true` to verify CSR key possession.",{"_3381":916,"_29612":878,"_20544":51097,"_5":14097,"_26932":51008,"_2867":51098},[],"`enable_replaceable_enrollment`",{"_3381":917,"_29612":878,"_20544":51100,"_5":14097,"_26932":51008,"_2867":51101},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_3381":918,"_29612":878,"_20544":51103,"_5":14097,"_26932":51008,"_2867":51104},[],"`est_rfc7030_settings.auth_mode`",{"_3381":919,"_29612":878,"_20544":51106,"_5":14097,"_26932":51008,"_2867":51107},[],"One of the four authentication modes.",{"_3381":920,"_29612":878,"_20544":51109,"_5":14097,"_26932":51008,"_2867":51110},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_3381":921,"_29612":878,"_20544":51112,"_5":14097,"_26932":51012,"_2867":51113},[],"The blocks are independent:",{"_3381":922,"_29612":878,"_20544":51115,"_5":14097,"_26932":51012,"_2867":51116},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_3381":923,"_29612":878,"_20544":51118,"_5":14097,"_26932":51012,"_2867":51119},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_3381":924,"_29612":878,"_20544":51121,"_5":14097,"_26932":51012,"_2867":51122},[],"`auth_mode`",{"_3381":925,"_29612":878,"_20544":51124,"_5":14097,"_26932":51012,"_2867":51125},[],"Control applied in the configured operation",{"_3381":926,"_29612":878,"_20544":51127,"_5":14097,"_26932":51012,"_2867":51128},[],"`CLIENT_CERTIFICATE`",{"_3381":927,"_29612":878,"_20544":51130,"_5":14097,"_26932":51012,"_2867":51131},[],"Presented certificate validation.",{"_3381":928,"_29612":878,"_20544":51133,"_5":14097,"_26932":51012,"_2867":51134},[],"`EXTERNAL_WEBHOOK`",{"_3381":929,"_29612":878,"_20544":51136,"_5":14097,"_26932":51012,"_2867":51137},[],"Configured webhook authorization.",{"_3381":930,"_29612":878,"_20544":51139,"_5":14097,"_26932":51012,"_2867":51140},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3381":931,"_29612":878,"_20544":51142,"_5":14097,"_26932":51012,"_2867":51143},[],"Certificate validation followed by webhook approval.",{"_3381":932,"_29612":878,"_20544":51145,"_5":14097,"_26932":51012,"_2867":51146},[],"`NO_AUTH`",{"_3381":933,"_29612":878,"_20544":51148,"_5":14097,"_26932":51012,"_2867":51149},[],"No DMS requester authentication.",{"_3381":934,"_29612":878,"_20544":51151,"_5":14097,"_26932":51012,"_2867":51152},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_3381":935,"_29612":878,"_20544":51154,"_5":14097,"_26932":51012,"_2867":51155},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_3381":936,"_29612":878,"_20544":51157,"_5":14097,"_26932":51012,"_2867":51158},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs. That list is optional because the enrollment CA is always trusted for re-enrollment, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`.",{"_3381":937,"_29612":878,"_20544":51160,"_5":14097,"_26932":51012,"_2867":51161},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_3381":938,"_29612":878,"_20544":51163,"_5":14097,"_26932":51016,"_2867":51164},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_3381":939,"_29612":878,"_20544":51166,"_5":14097,"_26932":51016,"_2867":51167},[],"`external_webhook_settings` field",{"_3381":940,"_29612":878,"_20544":51169,"_5":14097,"_26932":51016,"_2867":51077},[],{"_3381":941,"_29612":878,"_20544":51171,"_5":14097,"_26932":51016,"_2867":51172},[],"`url`",{"_3381":942,"_29612":878,"_20544":51174,"_5":14097,"_26932":51016,"_2867":51175},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_3381":943,"_29612":878,"_20544":51177,"_5":14097,"_26932":51016,"_2867":51178},[],"`method`",{"_3381":944,"_29612":878,"_20544":51180,"_5":14097,"_26932":51016,"_2867":51181},[],"`POST` or `PUT`; `POST` by default.",{"_3381":945,"_29612":878,"_20544":51183,"_5":14097,"_26932":51016,"_2867":51184},[],"`name`",{"_3381":946,"_29612":878,"_20544":51186,"_5":14097,"_26932":51016,"_2867":51187},[],"Label used in service logs.",{"_3381":947,"_29612":878,"_20544":51189,"_5":14097,"_26932":51016,"_2867":51190},[],"`config.auth_mode`",{"_3381":948,"_29612":878,"_20544":51192,"_5":14097,"_26932":51016,"_2867":51193},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_3381":949,"_29612":878,"_20544":51195,"_5":14097,"_26932":51016,"_2867":51196},[],"`config.log_level`",{"_3381":950,"_29612":878,"_20544":51198,"_5":14097,"_26932":51016,"_2867":51199},[],"Log level of the webhook call: `debug`, `info`, `warn` or `error`; `info` by default.",{"_3381":951,"_29612":878,"_20544":51201,"_5":14097,"_26932":51016,"_2867":51202},[],"`config.apikey_options`",{"_3381":952,"_29612":878,"_20544":51204,"_5":14097,"_26932":51016,"_2867":51205},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_3381":953,"_29612":878,"_20544":51207,"_5":14097,"_26932":51016,"_2867":51208},[],"`config.jwt_options`",{"_3381":954,"_29612":878,"_20544":51210,"_5":14097,"_26932":51016,"_2867":51211},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3381":955,"_29612":878,"_20544":51213,"_5":14097,"_26932":51016,"_2867":51214},[],"`config.mtls_options`",{"_3381":956,"_29612":878,"_20544":51216,"_5":14097,"_26932":51016,"_2867":51217},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_3381":957,"_29612":878,"_20544":51219,"_5":14097,"_26932":51016,"_2867":51220},[],"`config.insecure_skip_verify`",{"_3381":958,"_29612":878,"_20544":51222,"_5":14097,"_26932":51016,"_2867":51223},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_3381":959,"_29612":878,"_20544":51225,"_5":14097,"_26932":51016,"_2867":51226},[],"`config.call_timeout`",{"_3381":960,"_29612":878,"_20544":51228,"_5":14097,"_26932":51016,"_2867":51229},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_3381":961,"_29612":878,"_20544":51231,"_5":14097,"_26932":51016,"_2867":51232},[],"Rules for that configuration:",{"_3381":962,"_29612":878,"_20544":51234,"_5":14097,"_26932":51016,"_2867":51235},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_3381":963,"_29612":878,"_20544":51237,"_5":14097,"_26932":51016,"_2867":51238},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_3381":964,"_29612":878,"_20544":51240,"_5":14097,"_26932":51016,"_2867":51241},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_3381":965,"_29612":878,"_20544":51243,"_5":14097,"_26932":51016,"_2867":51244},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_3381":966,"_29612":878,"_20544":51246,"_5":14097,"_26932":51016,"_2867":51247},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_3381":967,"_29612":878,"_20544":51249,"_5":14097,"_26932":51016,"_2867":51250},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_3381":968,"_29612":878,"_20544":51252,"_5":14097,"_26932":51016,"_2867":51253},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing. The console exposes independent editors for the enrollment and re-enrollment authentication, with the same Log Level, Call Timeout, HTTP Authentication and credential fields as the webhook channels, plus a **Skip TLS Verification** switch (off by default, so verification stays on; the console warns when you enable it).",{"_3381":969,"_29612":878,"_20544":51255,"_5":14097,"_26932":51016,"_2867":51256},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. To fix it in the console, open the DMS, replace any file-path value with PEM content — the editor rejects file paths with an inline field error — and save. Saving rewrites `external_webhook_settings.config` with the current keys, and the console reads both plain and Base64-encoded PEM from migrated configurations and stores the material Base64-encoded. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_3381":970,"_29612":878,"_20544":51258,"_5":14097,"_26932":51016,"_2867":51259},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_3381":971,"_29612":878,"_20544":51261,"_5":14097,"_26932":51020,"_2867":51262},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_3381":972,"_29612":878,"_20544":51264,"_5":14097,"_26932":51024,"_2867":51265},[],"`settings.reenrollment_settings` field",{"_3381":973,"_29612":878,"_20544":51267,"_5":14097,"_26932":51024,"_2867":48621},[],{"_3381":974,"_29612":878,"_20544":51269,"_5":14097,"_26932":51024,"_2867":51270},[],"`reenrollment_delta`",{"_3381":975,"_29612":878,"_20544":51272,"_5":14097,"_26932":51024,"_2867":51273},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_3381":976,"_29612":878,"_20544":51275,"_5":14097,"_26932":51024,"_2867":51276},[],"`preventive_delta`",{"_3381":977,"_29612":878,"_20544":51278,"_5":14097,"_26932":51024,"_2867":51279},[],"Preventive operational monitoring threshold.",{"_3381":978,"_29612":878,"_20544":51281,"_5":14097,"_26932":51024,"_2867":51282},[],"`critical_delta`",{"_3381":979,"_29612":878,"_20544":51284,"_5":14097,"_26932":51024,"_2867":51285},[],"Critical operational monitoring threshold.",{"_3381":980,"_29612":878,"_20544":51287,"_5":14097,"_26932":51024,"_2867":51288},[],"`enable_expired_renewal`",{"_3381":981,"_29612":878,"_20544":51290,"_5":14097,"_26932":51024,"_2867":51291},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_3381":982,"_29612":878,"_20544":51293,"_5":14097,"_26932":51024,"_2867":51294},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_3381":983,"_29612":878,"_20544":51296,"_5":14097,"_26932":51024,"_2867":51297},[],"Re-enrollment validation CAs for the renewal mTLS credential, tried after the enrollment CA; optional, because the enrollment CA is always trusted. Typically populated during CA rotation while old-CA cohorts renew.",{"_3381":984,"_29612":878,"_20544":51299,"_5":14097,"_26932":51024,"_2867":51300},[],"`revoke_on_reenrollment`",{"_3381":985,"_29612":878,"_20544":51302,"_5":14097,"_26932":51024,"_2867":51303},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_3381":986,"_29612":878,"_20544":51305,"_5":14097,"_26932":51024,"_2867":51306},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_3381":987,"_29612":878,"_20544":51308,"_5":14097,"_26932":51028,"_2867":51309},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. The console exposes it through an **Enable server-side key generation** switch and a **Key type** selection: `ECDSA` P-256, P-384 or P-521, or `RSA` with 2048, 3072 or 4096 bits; the defaults are P-256 for `ECDSA` and 4096 bit for `RSA`. Algorithm and size come from its `key` field, stored as `{type,bits}` where P-256, P-384 and P-521 map to `bits` 256, 384 and 521; `key` is omitted when disabled. The profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_3381":988,"_29612":878,"_20544":51311,"_5":14097,"_26932":51032,"_2867":48615},[],{"_3381":989,"_29612":878,"_20544":51313,"_5":14097,"_26932":51032,"_2867":51314},[],"Published material",{"_3381":990,"_29612":878,"_20544":51316,"_5":14097,"_26932":51032,"_2867":51317},[],"**Include Lamassu System CA**",{"_3381":991,"_29612":878,"_20544":51319,"_5":14097,"_26932":51032,"_2867":51320},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_3381":992,"_29612":878,"_20544":51322,"_5":14097,"_26932":51032,"_2867":51323},[],"**Include Enrollment CA**",{"_3381":993,"_29612":878,"_20544":51325,"_5":14097,"_26932":51032,"_2867":51326},[],"Selected issuing CA certificate.",{"_3381":994,"_29612":878,"_20544":51328,"_5":14097,"_26932":51032,"_2867":51329},[],"**Managed CAs**",{"_3381":995,"_29612":878,"_20544":51331,"_5":14097,"_26932":51032,"_2867":51332},[],"Explicitly selected CA certificates.",{"_3381":996,"_29612":878,"_20544":51334,"_5":14097,"_26932":51032,"_2867":51335},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_3381":997,"_29612":878,"_20544":51337,"_5":14097,"_26932":51036,"_2867":51338},[],"**Edit** changes name, settings and metadata. Updates go through the DMS API. `PUT /v1/dms/{id}` always targets the DMS identified by the URL path: the body carries no `id` field, and any `id` or `creation_ts` in it is silently ignored — authorization is evaluated against the same URL identifier. The body must include a non-empty `name` and a `settings` object; missing either returns HTTP 400 and leaves the stored DMS unchanged. `name` and `settings` are always full replacements, so read the DMS before sending API edits to avoid losing fields. `metadata` is optional: omitting it or sending `null` keeps the stored metadata, a supplied object replaces it entirely, and `{}` clears it (a later GET returns an empty object, not `null`). Old-style bodies that carry the full DMS object keep working while they include `name` and `settings`; unknown fields are ignored. Updates reject an empty `name` with HTTP 400: a DMS whose stored name was zeroed by an earlier update must be renamed before any client round-trips it — the AWS IoT connector’s JITP writeback included. If the object does not include the AWS IoT connector key (`lamassu.io/iot/{connector_id}`), the connector ignores the DMS's later events.",{"_3381":998,"_29612":878,"_20544":51340,"_5":14097,"_26932":51036,"_2867":51341},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_3381":999,"_29612":878,"_20544":51343,"_5":14097,"_26932":51036,"_2867":51344},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_3381":1000,"_29612":878,"_20544":51346,"_5":14097,"_26932":51040,"_2867":51347},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_3381":1001,"_29612":1001,"_5":14455,"_2867":51349,"_29965":51350,"_20544":51351,"_26932":1001},"Integrate the EST client",[48231,49699,50710,50708,50891],[],{"_3381":1002,"_29612":1001,"_20544":51353,"_5":14097,"_26932":1001,"_2867":51354},[],"Prepare trust, send a CSR and check the identity you receive.",{"_3381":1003,"_29612":1001,"_5":29962,"_20544":51356,"_26932":51357,"_2867":48241},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_3381":1004,"_29612":1001,"_5":29962,"_20544":51359,"_26932":51360,"_2867":51361},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_3381":1005,"_29612":1001,"_5":29962,"_20544":51363,"_26932":51364,"_2867":51365},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_3381":1006,"_29612":1001,"_5":29962,"_20544":51367,"_26932":51368,"_2867":51369},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_3381":1007,"_29612":1001,"_5":29962,"_20544":51371,"_26932":51372,"_2867":51373},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_3381":1008,"_29612":1001,"_5":29962,"_20544":51375,"_26932":51376,"_2867":51377},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_3381":1009,"_29612":1001,"_20544":51379,"_5":14097,"_26932":1001,"_2867":51380},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_3381":1010,"_29612":1001,"_20544":51382,"_5":14097,"_26932":51357,"_2867":51383},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_3381":1011,"_29612":1001,"_20544":51385,"_5":14097,"_26932":51357,"_2867":51386},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_3381":1012,"_29612":1001,"_20544":51388,"_5":14097,"_26932":51357,"_2867":51389},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_3381":1013,"_29612":1001,"_20544":51391,"_5":14097,"_26932":51360,"_2867":51392},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_3381":1014,"_29612":1001,"_20544":51394,"_5":14097,"_26932":51360,"_2867":51395},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_3381":1015,"_29612":1001,"_20544":51397,"_5":14097,"_26932":51364,"_2867":51398},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_3381":1016,"_29612":1001,"_20544":51400,"_5":14097,"_26932":51364,"_2867":51401},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_3381":1017,"_29612":1001,"_20544":51403,"_5":14097,"_26932":51368,"_2867":51404},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_3381":1018,"_29612":1001,"_20544":51406,"_5":14097,"_26932":51368,"_2867":51407},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_3381":1019,"_29612":1001,"_20544":51409,"_5":14097,"_26932":51372,"_2867":51410},[],"For a root that issues directly:",{"_3381":1020,"_29612":1001,"_20544":51412,"_5":14097,"_26932":51372,"_2867":51413},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_3381":1021,"_29612":1001,"_20544":51415,"_5":14097,"_26932":51372,"_2867":51416},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_3381":1022,"_29612":1001,"_20544":51418,"_5":14097,"_26932":51376,"_2867":51419},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_3381":1023,"_29612":1023,"_5":14455,"_2867":51421,"_29965":51422,"_20544":51423,"_26932":1023},"EST reference",[48231,49699,50710,50708,50891],[],{"_3381":1024,"_29612":1023,"_20544":51425,"_5":14097,"_26932":1023,"_2867":51426},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_3381":1025,"_29612":1023,"_5":29962,"_20544":51428,"_26932":51429,"_2867":51430},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_3381":1026,"_29612":1023,"_5":29962,"_20544":51432,"_26932":51433,"_2867":22272},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3381":1027,"_29612":1023,"_5":29962,"_20544":51435,"_26932":51436,"_2867":25568},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3381":1028,"_29612":1023,"_5":29962,"_20544":51438,"_26932":51439,"_2867":25575},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3381":1029,"_29612":1023,"_5":29962,"_20544":51441,"_26932":51442,"_2867":24892},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3381":1030,"_29612":1023,"_5":29962,"_20544":51444,"_26932":51445,"_2867":51446},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_3381":1031,"_29612":1023,"_5":29962,"_20544":51448,"_26932":51449,"_2867":51450},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_3381":1032,"_29612":1023,"_5":29962,"_20544":51452,"_26932":51453,"_2867":51454},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_3381":1033,"_29612":1023,"_20544":51456,"_5":14097,"_26932":1023,"_2867":51457},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_3381":1034,"_29612":1023,"_20544":51459,"_5":14097,"_26932":51429,"_2867":51460},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_3381":1035,"_29612":1023,"_20544":51462,"_5":14097,"_26932":51429,"_2867":51463},[],"Operation",{"_3381":1036,"_29612":1023,"_20544":51465,"_5":14097,"_26932":51429,"_2867":51466},[],"Method",{"_3381":1037,"_29612":1023,"_20544":51468,"_5":14097,"_26932":51429,"_2867":51469},[],"Authentication and condition",{"_3381":1038,"_29612":1023,"_20544":51471,"_5":14097,"_26932":51429,"_2867":51472},[],"`/cacerts`",{"_3381":1039,"_29612":1023,"_20544":51474,"_5":14097,"_26932":51429,"_2867":51475},[],"GET",{"_3381":1040,"_29612":1023,"_20544":51477,"_5":14097,"_26932":51429,"_2867":51478},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_3381":1041,"_29612":1023,"_20544":51480,"_5":14097,"_26932":51429,"_2867":51481},[],"`/simpleenroll`",{"_3381":1042,"_29612":1023,"_20544":51483,"_5":14097,"_26932":51429,"_2867":51484},[],"POST",{"_3381":1043,"_29612":1023,"_20544":51486,"_5":14097,"_26932":51429,"_2867":51487},[],"Initial authentication and DMS registration/replacement policy.",{"_3381":1044,"_29612":1023,"_20544":51489,"_5":14097,"_26932":51429,"_2867":51490},[],"`/simplereenroll`",{"_3381":1045,"_29612":1023,"_20544":51492,"_5":14097,"_26932":51429,"_2867":51484},[],{"_3381":1046,"_29612":1023,"_20544":51494,"_5":14097,"_26932":51429,"_2867":51495},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_3381":1047,"_29612":1023,"_20544":51497,"_5":14097,"_26932":51429,"_2867":51498},[],"`/serverkeygen`",{"_3381":1048,"_29612":1023,"_20544":51500,"_5":14097,"_26932":51429,"_2867":51484},[],{"_3381":1049,"_29612":1023,"_20544":51502,"_5":14097,"_26932":51429,"_2867":51503},[],"Initial authentication and admission; server generation enabled.",{"_3381":1050,"_29612":1023,"_20544":51505,"_5":14097,"_26932":51429,"_2867":51506},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_3381":1051,"_29612":1023,"_20544":51508,"_5":14097,"_26932":51433,"_2867":51509},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_3381":1052,"_29612":1023,"_20544":51511,"_5":14097,"_26932":51433,"_2867":51512},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_3381":1053,"_29612":1023,"_20544":51514,"_5":14097,"_26932":51436,"_2867":51515},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_3381":1054,"_29612":1023,"_20544":51517,"_5":14097,"_26932":51436,"_2867":51518},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_3381":1055,"_29612":1023,"_20544":51520,"_5":14097,"_26932":51439,"_2867":51521},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_3381":1056,"_29612":1023,"_20544":51523,"_5":14097,"_26932":51439,"_2867":51524},[],"In mTLS mode, the enrollment CA always validates the re-enrollment credential; certificates from other issuers are accepted only if they are listed as validation CAs in the re-enrollment block. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_3381":1057,"_29612":1023,"_20544":51526,"_5":14097,"_26932":51442,"_2867":51527},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_3381":1058,"_29612":1023,"_20544":51529,"_5":14097,"_26932":51442,"_2867":51530},[],"The code supports RSA and ECDSA, and the `bits` value of the DMS key setting means something different for each. For ECDSA it selects the curve: 224, 256, 384 or 521 map to P-224, P-256, P-384 and P-521, and an unrecognized size falls back to P-256, so explicitly select a compatible size and check the resulting key. For RSA it is used directly as the modulus size; the console offers 2048, 3072 and 4096 bits. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_3381":1059,"_29612":1023,"_20544":51532,"_5":14097,"_26932":51445,"_2867":51533},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_3381":1060,"_29612":1023,"_20544":51535,"_5":14097,"_26932":51445,"_2867":51536},[],"Part",{"_3381":1061,"_29612":1023,"_20544":51538,"_5":14097,"_26932":51445,"_2867":51539},[],"Content after decoding its Base64",{"_3381":1062,"_29612":1023,"_20544":51541,"_5":14097,"_26932":51445,"_2867":51542},[],"`application/pkcs8`",{"_3381":1063,"_29612":1023,"_20544":51544,"_5":14097,"_26932":51445,"_2867":51545},[],"Unencrypted DER PKCS#8 private key.",{"_3381":1064,"_29612":1023,"_20544":51547,"_5":14097,"_26932":51445,"_2867":51548},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_3381":1065,"_29612":1023,"_20544":51550,"_5":14097,"_26932":51445,"_2867":51551},[],"DER PKCS#7 containing the issued certificate.",{"_3381":1066,"_29612":1023,"_20544":51553,"_5":14097,"_26932":51445,"_2867":51554},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_3381":1067,"_29612":1023,"_20544":51556,"_5":14097,"_26932":51449,"_2867":51557},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_3381":1068,"_29612":1023,"_20544":51559,"_5":14097,"_26932":51449,"_2867":51560},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_3381":1069,"_29612":1023,"_20544":51562,"_5":14097,"_26932":51449,"_2867":51563},[],"Convert and check the result:",{"_3381":1070,"_29612":1023,"_20544":51565,"_5":14097,"_26932":51449,"_2867":51566},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_3381":1071,"_29612":1023,"_20544":51568,"_5":14097,"_26932":51453,"_2867":51569},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_3381":1072,"_29612":1023,"_20544":51571,"_5":14097,"_26932":51453,"_2867":51572},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_3381":1073,"_29612":1073,"_5":14455,"_2867":50891,"_29965":51574,"_20544":51575,"_26932":1073},[48231,49699,50710,50708,50891],[],{"_3381":1074,"_29612":1073,"_20544":51577,"_5":14097,"_26932":1073,"_2867":51578},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_3381":1075,"_29612":1073,"_5":29962,"_20544":51580,"_26932":51581,"_2867":51582},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_3381":1076,"_29612":1073,"_5":29962,"_20544":51584,"_26932":51585,"_2867":51586},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_3381":1077,"_29612":1073,"_5":29962,"_20544":51588,"_26932":51589,"_2867":51590},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_3381":1078,"_29612":1073,"_5":29962,"_20544":51592,"_26932":51593,"_2867":51594},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_3381":1079,"_29612":1073,"_20544":51596,"_5":14097,"_26932":1073,"_2867":51597},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_3381":1080,"_29612":1073,"_20544":51599,"_5":14097,"_26932":51581,"_2867":51600},[],"The administrator prepares the CA, issuance profile and DMS.",{"_3381":1081,"_29612":1073,"_20544":51602,"_5":14097,"_26932":51581,"_2867":51603},[],"The integrator installs initial EST server trust and an admission credential.",{"_3381":1082,"_29612":1073,"_20544":51605,"_5":14097,"_26932":51581,"_2867":51606},[],"The client requests an identity for its `Device ID` through EST.",{"_3381":1083,"_29612":1073,"_20544":51608,"_5":14097,"_26932":51581,"_2867":51609},[],"Certificate, device binding and key/certificate installation are checked.",{"_3381":1084,"_29612":1073,"_20544":51611,"_5":14097,"_26932":51581,"_2867":51612},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_3381":1085,"_29612":1073,"_20544":51614,"_5":14097,"_26932":51581,"_2867":51615},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_3381":1086,"_29612":1073,"_20544":51617,"_5":14097,"_26932":51585,"_2867":51618},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3381":1087,"_29612":1073,"_20544":51620,"_5":14097,"_26932":51585,"_2867":51621},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3381":1088,"_29612":1073,"_20544":51623,"_5":14097,"_26932":51585,"_2867":51624},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3381":1089,"_29612":1073,"_20544":51626,"_5":14097,"_26932":51585,"_2867":51627},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3381":1090,"_29612":1073,"_20544":51629,"_5":14097,"_26932":51589,"_2867":51630},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3381":1091,"_29612":1073,"_20544":51632,"_5":14097,"_26932":51589,"_2867":51633},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3381":1092,"_29612":1073,"_20544":51635,"_5":14097,"_26932":51589,"_2867":51636},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3381":1093,"_29612":1073,"_20544":51638,"_5":14097,"_26932":51589,"_2867":51639},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3381":1094,"_29612":1073,"_20544":51641,"_5":14097,"_26932":51593,"_2867":51642},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_3381":1095,"_29612":1073,"_20544":51644,"_5":14097,"_26932":51593,"_2867":51645},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_3381":1096,"_29612":1096,"_5":14455,"_2867":51647,"_29965":51648,"_20544":51649,"_26932":1096},"Provisioning strategies",[48231,49699,50710,50708,50891],[],{"_3381":1097,"_29612":1096,"_20544":51651,"_5":14097,"_26932":1096,"_2867":51652},[],"Choose device registration, identity authorization and key generation.",{"_3381":1098,"_29612":1096,"_5":29962,"_20544":51654,"_26932":51655,"_2867":51656},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_3381":1099,"_29612":1096,"_5":29962,"_20544":51658,"_26932":51659,"_2867":51660},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_3381":1100,"_29612":1096,"_5":29962,"_20544":51662,"_26932":51663,"_2867":51664},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_3381":1101,"_29612":1096,"_5":29962,"_20544":51666,"_26932":51667,"_2867":51668},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_3381":1102,"_29612":1096,"_5":29962,"_20544":51670,"_26932":51671,"_2867":51672},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_3381":1103,"_29612":1096,"_20544":51674,"_5":14097,"_26932":1096,"_2867":51675},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_3381":1104,"_29612":1096,"_20544":51677,"_5":14097,"_26932":51655,"_2867":51678},[],"Path",{"_3381":1105,"_29612":1096,"_20544":51680,"_5":14097,"_26932":51655,"_2867":51681},[],"When the device exists",{"_3381":1106,"_29612":1096,"_20544":51683,"_5":14097,"_26932":51655,"_2867":51684},[],"What to check",{"_3381":1107,"_29612":1096,"_20544":51686,"_5":14097,"_26932":51655,"_2867":51687},[],"Manual assignment",{"_3381":1108,"_29612":1096,"_20544":51689,"_5":14097,"_26932":51655,"_2867":51690},[],"An operator creates it before associating a certificate.",{"_3381":1109,"_29612":1096,"_20544":51692,"_5":14097,"_26932":51655,"_2867":51693},[],"ID, owning DMS, certificate CN and bound serial.",{"_3381":1110,"_29612":1096,"_20544":51695,"_5":14097,"_26932":51655,"_2867":51696},[],"EST with `JITP`",{"_3381":1111,"_29612":1096,"_20544":51698,"_5":14097,"_26932":51655,"_2867":51699},[],"Created for an unknown CN during `/simpleenroll`.",{"_3381":1112,"_29612":1096,"_20544":51701,"_5":14097,"_26932":51655,"_2867":51702},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_3381":1113,"_29612":1096,"_20544":51704,"_5":14097,"_26932":51655,"_2867":51705},[],"EST with `PRE_REGISTRATION`",{"_3381":1114,"_29612":1096,"_20544":51707,"_5":14097,"_26932":51655,"_2867":51708},[],"Must exist before `/simpleenroll`.",{"_3381":1115,"_29612":1096,"_20544":51710,"_5":14097,"_26932":51655,"_2867":51711},[],"Approved record, same DMS and replacement conditions for your version.",{"_3381":1116,"_29612":1096,"_20544":51713,"_5":14097,"_26932":51655,"_2867":51714},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_3381":1117,"_29612":1096,"_20544":51716,"_5":14097,"_26932":51655,"_2867":51717},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_3381":1118,"_29612":1096,"_20544":51719,"_5":14097,"_26932":51659,"_2867":51720},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_3381":1119,"_29612":1096,"_20544":51722,"_5":14097,"_26932":51659,"_2867":51723},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_3381":1120,"_29612":1096,"_20544":51725,"_5":14097,"_26932":51659,"_2867":51726},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_3381":1121,"_29612":1096,"_20544":51728,"_5":14097,"_26932":51663,"_2867":51729},[],"Decide initial enrollment and re-enrollment separately:",{"_3381":1122,"_29612":1096,"_20544":51731,"_5":14097,"_26932":51663,"_2867":51732},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_3381":1123,"_29612":1096,"_20544":51734,"_5":14097,"_26932":51663,"_2867":51735},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_3381":1124,"_29612":1096,"_20544":51737,"_5":14097,"_26932":51663,"_2867":51738},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_3381":1125,"_29612":1096,"_20544":51740,"_5":14097,"_26932":51663,"_2867":51741},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_3381":1126,"_29612":1096,"_20544":51743,"_5":14097,"_26932":51663,"_2867":51744},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_3381":1127,"_29612":1096,"_20544":51746,"_5":14097,"_26932":51667,"_2867":48615},[],{"_3381":1128,"_29612":1096,"_20544":51748,"_5":14097,"_26932":51667,"_2867":51749},[],"Material crossing EST",{"_3381":1129,"_29612":1096,"_20544":51751,"_5":14097,"_26932":51667,"_2867":51752},[],"Device-generated key",{"_3381":1130,"_29612":1096,"_20544":51754,"_5":14097,"_26932":51667,"_2867":51755},[],"Public CSR and certificate; the key stays on the client.",{"_3381":1131,"_29612":1096,"_20544":51757,"_5":14097,"_26932":51667,"_2867":51758},[],"Existing device key",{"_3381":1132,"_29612":1096,"_20544":51760,"_5":14097,"_26932":51667,"_2867":51761},[],"CSR signed with that key and a new certificate.",{"_3381":1133,"_29612":1096,"_20544":51763,"_5":14097,"_26932":51667,"_2867":51029},[],{"_3381":1134,"_29612":1096,"_20544":51765,"_5":14097,"_26932":51667,"_2867":51766},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_3381":1135,"_29612":1096,"_20544":51768,"_5":14097,"_26932":51667,"_2867":51769},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_3381":1136,"_29612":1096,"_20544":51771,"_5":14097,"_26932":51671,"_2867":51772},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_3381":1137,"_29612":1137,"_5":14455,"_2867":51774,"_29965":51775,"_20544":51776,"_26932":1137},"Renewal and recovery",[48231,49699,50710,50708,50891],[],{"_3381":1138,"_29612":1137,"_20544":51778,"_5":14097,"_26932":1137,"_2867":51779},[],"Renew without losing the identity and recover devices according to their actual state.",{"_3381":1139,"_29612":1137,"_5":29962,"_20544":51781,"_26932":51782,"_2867":51783},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_3381":1140,"_29612":1137,"_5":29962,"_20544":51785,"_26932":51786,"_2867":51787},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_3381":1141,"_29612":1137,"_5":29962,"_20544":51789,"_26932":51790,"_2867":51791},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_3381":1142,"_29612":1137,"_5":29962,"_20544":51793,"_26932":51794,"_2867":51795},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_3381":1143,"_29612":1137,"_5":29962,"_20544":51797,"_26932":51798,"_2867":51799},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_3381":1144,"_29612":1137,"_20544":51801,"_5":14097,"_26932":1137,"_2867":51802},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_3381":1145,"_29612":1137,"_20544":51804,"_5":14097,"_26932":51782,"_2867":51805},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_3381":1146,"_29612":1137,"_20544":51807,"_5":14097,"_26932":51782,"_2867":51808},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_3381":1147,"_29612":1137,"_20544":51810,"_5":14097,"_26932":51782,"_2867":51811},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_3381":1148,"_29612":1137,"_20544":51813,"_5":14097,"_26932":51782,"_2867":51814},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_3381":1149,"_29612":1137,"_20544":51816,"_5":14097,"_26932":51786,"_2867":51817},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_3381":1150,"_29612":1137,"_20544":51819,"_5":14097,"_26932":51786,"_2867":51820},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_3381":1151,"_29612":1137,"_20544":51822,"_5":14097,"_26932":51790,"_2867":51823},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_3381":1152,"_29612":1137,"_20544":51825,"_5":14097,"_26932":51790,"_2867":51826},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_3381":1153,"_29612":1137,"_20544":51828,"_5":14097,"_26932":51790,"_2867":51829},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_3381":1154,"_29612":1137,"_20544":51831,"_5":14097,"_26932":51794,"_2867":51832},[],"Situation",{"_3381":1155,"_29612":1137,"_20544":51834,"_5":14097,"_26932":51794,"_2867":51835},[],"Procedure",{"_3381":1156,"_29612":1137,"_20544":51837,"_5":14097,"_26932":51794,"_2867":51838},[],"Valid certificate, outside the window",{"_3381":1157,"_29612":1137,"_20544":51840,"_5":14097,"_26932":51794,"_2867":51841},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_3381":1158,"_29612":1137,"_20544":51843,"_5":14097,"_26932":51794,"_2867":51844},[],"Expired certificate, key available",{"_3381":1159,"_29612":1137,"_20544":51846,"_5":14097,"_26932":51794,"_2867":51847},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_3381":1160,"_29612":1137,"_20544":51849,"_5":14097,"_26932":51794,"_2867":51850},[],"Renewal through webhook or `NO_AUTH`",{"_3381":1161,"_29612":1137,"_20544":51852,"_5":14097,"_26932":51794,"_2867":51853},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_3381":1162,"_29612":1137,"_20544":51855,"_5":14097,"_26932":51794,"_2867":51856},[],"Lost or inaccessible key",{"_3381":1163,"_29612":1137,"_20544":51858,"_5":14097,"_26932":51794,"_2867":51859},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_3381":1164,"_29612":1137,"_20544":51861,"_5":14097,"_26932":51794,"_2867":51862},[],"Current identity revoked",{"_3381":1165,"_29612":1137,"_20544":51864,"_5":14097,"_26932":51794,"_2867":51865},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_3381":1166,"_29612":1137,"_20544":51867,"_5":14097,"_26932":51794,"_2867":51868},[],"Device without an identity",{"_3381":1167,"_29612":1137,"_20544":51870,"_5":14097,"_26932":51794,"_2867":51871},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_3381":1168,"_29612":1137,"_20544":51873,"_5":14097,"_26932":51794,"_2867":51874},[],"Retired device",{"_3381":1169,"_29612":1137,"_20544":51876,"_5":14097,"_26932":51794,"_2867":51877},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_3381":1170,"_29612":1137,"_20544":51879,"_5":14097,"_26932":51794,"_2867":51880},[],"Timeout, HTTP 500 or installation failure",{"_3381":1171,"_29612":1137,"_20544":51882,"_5":14097,"_26932":51794,"_2867":51883},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_3381":1172,"_29612":1137,"_20544":51885,"_5":14097,"_26932":51798,"_2867":51886},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_3381":1173,"_29612":1137,"_20544":51888,"_5":14097,"_26932":51798,"_2867":51889},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_3381":1174,"_29612":1174,"_5":14455,"_2867":51891,"_29965":51892,"_20544":51893,"_26932":1174},"Enrollment troubleshooting",[48231,49699,50710,50708,50891],[],{"_3381":1175,"_29612":1174,"_20544":51895,"_5":14097,"_26932":1174,"_2867":51896},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_3381":1176,"_29612":1174,"_5":29962,"_20544":51898,"_26932":51899,"_2867":51900},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_3381":1177,"_29612":1174,"_5":29962,"_20544":51902,"_26932":51903,"_2867":51904},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_3381":1178,"_29612":1174,"_5":29962,"_20544":51906,"_26932":51907,"_2867":51454},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_3381":1179,"_29612":1174,"_5":29962,"_20544":51909,"_26932":51910,"_2867":51911},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_3381":1180,"_29612":1174,"_20544":51913,"_5":14097,"_26932":1174,"_2867":51914},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_3381":1181,"_29612":1174,"_20544":51916,"_5":14097,"_26932":51903,"_2867":51917},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_3381":1182,"_29612":1174,"_20544":51919,"_5":14097,"_26932":51903,"_2867":51920},[],"Symptom or message",{"_3381":1183,"_29612":1174,"_20544":51922,"_5":14097,"_26932":51903,"_2867":51684},[],{"_3381":1184,"_29612":1174,"_20544":51924,"_5":14097,"_26932":51903,"_2867":51925},[],"curl rejects TLS, name or issuer",{"_3381":1185,"_29612":1174,"_20544":51927,"_5":14097,"_26932":51903,"_2867":51928},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_3381":1186,"_29612":1174,"_20544":51930,"_5":14097,"_26932":51903,"_2867":51931},[],"404 or missing APS",{"_3381":1187,"_29612":1174,"_20544":51933,"_5":14097,"_26932":51903,"_2867":51934},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_3381":1188,"_29612":1174,"_20544":51936,"_5":14097,"_26932":51903,"_2867":51937},[],"400, CSR or format error",{"_3381":1189,"_29612":1174,"_20544":51939,"_5":14097,"_26932":51903,"_2867":51940},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_3381":1190,"_29612":1174,"_20544":51942,"_5":14097,"_26932":51903,"_2867":51943},[],"Missing credential or invalid certificate",{"_3381":1191,"_29612":1174,"_20544":51945,"_5":14097,"_26932":51903,"_2867":51946},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_3381":1192,"_29612":1174,"_20544":51948,"_5":14097,"_26932":51903,"_2867":51949},[],"Webhook denies, times out or responds without authorization",{"_3381":1193,"_29612":1174,"_20544":51951,"_5":14097,"_26932":51903,"_2867":51952},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_3381":1194,"_29612":1174,"_20544":51954,"_5":14097,"_26932":51903,"_2867":51955},[],"`unexpected status code: <n>: redirects are not followed`",{"_3381":1195,"_29612":1174,"_20544":51957,"_5":14097,"_26932":51903,"_2867":51958},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_3381":1196,"_29612":1174,"_20544":51960,"_5":14097,"_26932":51903,"_2867":51961},[],"`webhook response exceeds 1048576 bytes`",{"_3381":1197,"_29612":1174,"_20544":51963,"_5":14097,"_26932":51903,"_2867":51964},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_3381":1198,"_29612":1174,"_20544":51966,"_5":14097,"_26932":51903,"_2867":51967},[],"`webhook config must not reference files`",{"_3381":1199,"_29612":1174,"_20544":51969,"_5":14097,"_26932":51903,"_2867":51970},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_3381":1200,"_29612":1174,"_20544":51972,"_5":14097,"_26932":51903,"_2867":51973},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_3381":1201,"_29612":1174,"_20544":51975,"_5":14097,"_26932":51903,"_2867":51976},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_3381":1202,"_29612":1174,"_20544":51978,"_5":14097,"_26932":51903,"_2867":51979},[],"`webhook mTLS certificate and key are invalid: …`",{"_3381":1203,"_29612":1174,"_20544":51981,"_5":14097,"_26932":51903,"_2867":51982},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_3381":1204,"_29612":1174,"_20544":51984,"_5":14097,"_26932":51903,"_2867":51985},[],"400 `struct validation error` creating or updating a DMS",{"_3381":1205,"_29612":1174,"_20544":51987,"_5":14097,"_26932":51903,"_2867":51988},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_3381":1206,"_29612":1174,"_20544":51990,"_5":14097,"_26932":51903,"_2867":51991},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_3381":1207,"_29612":1174,"_20544":51993,"_5":14097,"_26932":51903,"_2867":51994},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_3381":1208,"_29612":1174,"_20544":51996,"_5":14097,"_26932":51903,"_2867":51997},[],"`device not preregistered`",{"_3381":1209,"_29612":1174,"_20544":51999,"_5":14097,"_26932":51903,"_2867":52000},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_3381":1210,"_29612":1174,"_20544":52002,"_5":14097,"_26932":51903,"_2867":52003},[],"`forbiddenNewEnrollment`",{"_3381":1211,"_29612":1174,"_20544":52005,"_5":14097,"_26932":51903,"_2867":52006},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_3381":1212,"_29612":1174,"_20544":52008,"_5":14097,"_26932":51903,"_2867":52009},[],"Different owning DMS",{"_3381":1213,"_29612":1174,"_20544":52011,"_5":14097,"_26932":51903,"_2867":52012},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_3381":1214,"_29612":1174,"_20544":52014,"_5":14097,"_26932":51903,"_2867":52015},[],"`invalid RawSubject bytes`",{"_3381":1215,"_29612":1174,"_20544":52017,"_5":14097,"_26932":51903,"_2867":52018},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_3381":1216,"_29612":1174,"_20544":52020,"_5":14097,"_26932":51903,"_2867":52021},[],"`invalid reenroll window`",{"_3381":1217,"_29612":1174,"_20544":52023,"_5":14097,"_26932":51903,"_2867":52024},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_3381":1218,"_29612":1174,"_20544":52026,"_5":14097,"_26932":51903,"_2867":52027},[],"Current certificate revoked",{"_3381":1219,"_29612":1174,"_20544":52029,"_5":14097,"_26932":51903,"_2867":52030},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_3381":1220,"_29612":1174,"_20544":52032,"_5":14097,"_26932":51903,"_2867":52033},[],"CA, profile or signing error",{"_3381":1221,"_29612":1174,"_20544":52035,"_5":14097,"_26932":51903,"_2867":52036},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_3381":1222,"_29612":1174,"_20544":52038,"_5":14097,"_26932":51903,"_2867":52039},[],"HTTP 200 without a device connection",{"_3381":1223,"_29612":1174,"_20544":52041,"_5":14097,"_26932":51903,"_2867":52042},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_3381":1224,"_29612":1174,"_20544":52044,"_5":14097,"_26932":51903,"_2867":52045},[],"Timeout or error after issuance",{"_3381":1225,"_29612":1174,"_20544":52047,"_5":14097,"_26932":51903,"_2867":52048},[],"New certificates, current slot and previous identity's state before retrying.",{"_3381":1226,"_29612":1174,"_20544":52050,"_5":14097,"_26932":51907,"_2867":52051},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_3381":1227,"_29612":1174,"_20544":52053,"_5":14097,"_26932":51907,"_2867":52054},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_3381":1228,"_29612":1174,"_20544":52056,"_5":14097,"_26932":51910,"_2867":52057},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_3381":1229,"_29612":1174,"_20544":52059,"_5":14097,"_26932":51910,"_2867":52060},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_3381":1230,"_29612":1174,"_20544":52062,"_5":14097,"_26932":51910,"_2867":52063},[],"Verify the CSR locally and relate its CN to the inventory.",{"_3381":1231,"_29612":1174,"_20544":52065,"_5":14097,"_26932":51910,"_2867":52066},[],"Make one request, save headers/body and query the device and certificates.",{"_3381":1232,"_29612":1174,"_20544":52068,"_5":14097,"_26932":51910,"_2867":52069},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_3381":1233,"_29612":1174,"_20544":52071,"_5":14097,"_26932":51910,"_2867":52072},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_3381":1234,"_29612":1174,"_20544":52074,"_5":14097,"_26932":51910,"_2867":52075},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_3381":1235,"_29612":1235,"_5":14455,"_2867":52077,"_29965":52078,"_20544":52079,"_26932":1235},"Trust distribution and updates",[48231,49699,50710,50708,50891],[],{"_3381":1236,"_29612":1235,"_20544":52081,"_5":14097,"_26932":1235,"_2867":52082},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_3381":1237,"_29612":1235,"_5":29962,"_20544":52084,"_26932":52085,"_2867":52086},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_3381":1238,"_29612":1235,"_5":29962,"_20544":52088,"_26932":52089,"_2867":52090},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_3381":1239,"_29612":1235,"_5":29962,"_20544":52092,"_26932":52093,"_2867":52094},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_3381":1240,"_29612":1235,"_5":29962,"_20544":52096,"_26932":52097,"_2867":52098},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_3381":1241,"_29612":1235,"_5":29962,"_20544":52100,"_26932":52101,"_2867":52102},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_3381":1242,"_29612":1235,"_20544":52104,"_5":14097,"_26932":1235,"_2867":52105},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_3381":1243,"_29612":1235,"_20544":52107,"_5":14097,"_26932":52085,"_2867":52108},[],"Relationship",{"_3381":1244,"_29612":1235,"_20544":52110,"_5":14097,"_26932":52085,"_2867":52111},[],"Material prepared by its owner",{"_3381":1245,"_29612":1235,"_20544":52113,"_5":14097,"_26932":52085,"_2867":52114},[],"Device → EST server",{"_3381":1246,"_29612":1235,"_20544":52116,"_5":14097,"_26932":52085,"_2867":52117},[],"Previously verified server root, chain or pin and TLS name.",{"_3381":1247,"_29612":1235,"_20544":52119,"_5":14097,"_26932":52085,"_2867":52120},[],"DMS → requester",{"_3381":1248,"_29612":1235,"_20544":52122,"_5":14097,"_26932":52085,"_2867":52123},[],"CAs and rules authorizing initial or renewal credentials.",{"_3381":1249,"_29612":1235,"_20544":52125,"_5":14097,"_26932":52085,"_2867":52126},[],"Consumer → device",{"_3381":1250,"_29612":1235,"_20544":52128,"_5":14097,"_26932":52085,"_2867":52129},[],"Operational identity roots, intermediates, validation and permissions.",{"_3381":1251,"_29612":1235,"_20544":52131,"_5":14097,"_26932":52085,"_2867":52132},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_3381":1252,"_29612":1235,"_20544":52134,"_5":14097,"_26932":52089,"_2867":52135},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_3381":1253,"_29612":1235,"_20544":52137,"_5":14097,"_26932":52089,"_2867":52138},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_3381":1254,"_29612":1235,"_20544":52140,"_5":14097,"_26932":52093,"_2867":52141},[],"Keep initial EST server trust separate from identity consumer trust.",{"_3381":1255,"_29612":1235,"_20544":52143,"_5":14097,"_26932":52093,"_2867":52144},[],"Select policy-approved roots as anchors.",{"_3381":1256,"_29612":1235,"_20544":52146,"_5":14097,"_26932":52093,"_2867":52147},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_3381":1257,"_29612":1235,"_20544":52149,"_5":14097,"_26932":52093,"_2867":52150},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_3381":1258,"_29612":1235,"_20544":52152,"_5":14097,"_26932":52093,"_2867":52153},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_3381":1259,"_29612":1235,"_20544":52155,"_5":14097,"_26932":52093,"_2867":52156},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_3381":1260,"_29612":1235,"_20544":52158,"_5":14097,"_26932":52097,"_2867":52159},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_3381":1261,"_29612":1235,"_20544":52161,"_5":14097,"_26932":52097,"_2867":52162},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. That list is optional because the enrollment CA always validates re-enrollment credentials, but when switching the enrollment CA, add the previous issuance CA to it so old-CA identities keep re-enrolling during overlap. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_3381":1262,"_29612":1235,"_20544":52164,"_5":14097,"_26932":52097,"_2867":52165},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_3381":1263,"_29612":1235,"_20544":52167,"_5":14097,"_26932":52101,"_2867":52168},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_3381":1264,"_29612":1264,"_5":14455,"_2867":52170,"_29965":52171,"_20544":52173,"_26932":1264},"AWS IoT Core",[48231,49699,50710,50708,52172],"Integrations",[],{"_3381":1265,"_29612":1264,"_20544":52175,"_5":14097,"_26932":1264,"_2867":52176},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_3381":1266,"_29612":1264,"_5":29962,"_20544":52178,"_26932":52179,"_2867":52180},[],"/docs/pr-preview/pr-53/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_3381":1267,"_29612":1264,"_5":29962,"_20544":52182,"_26932":52183,"_2867":52184},[],"/docs/pr-preview/pr-53/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_3381":1268,"_29612":1264,"_5":29962,"_20544":52186,"_26932":52187,"_2867":52188},[],"/docs/pr-preview/pr-53/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_3381":1269,"_29612":1264,"_5":29962,"_20544":52190,"_26932":52191,"_2867":52192},[],"/docs/pr-preview/pr-53/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_3381":1270,"_29612":1264,"_5":29962,"_20544":52194,"_26932":52195,"_2867":52196},[],"/docs/pr-preview/pr-53/platform/iot-fleets/integrations/aws-iot-core#resource-state-machine","Resource state machine",{"_3381":1271,"_29612":1264,"_5":29962,"_20544":52198,"_26932":52199,"_2867":52200},[],"/docs/pr-preview/pr-53/platform/iot-fleets/integrations/aws-iot-core#events-the-connector-handles","Events the connector handles",{"_3381":1272,"_29612":1264,"_5":29962,"_20544":52202,"_26932":52203,"_2867":52204},[],"/docs/pr-preview/pr-53/platform/iot-fleets/integrations/aws-iot-core#ca-registration-states","CA registration states",{"_3381":1273,"_29612":1264,"_5":29962,"_20544":52206,"_26932":52207,"_2867":52208},[],"/docs/pr-preview/pr-53/platform/iot-fleets/integrations/aws-iot-core#dms-registration-mode-states","DMS registration-mode states",{"_3381":1274,"_29612":1264,"_5":29962,"_20544":52210,"_26932":52211,"_2867":52212},[],"/docs/pr-preview/pr-53/platform/iot-fleets/integrations/aws-iot-core#certificate-status-states","Certificate status states",{"_3381":1275,"_29612":1264,"_5":29962,"_20544":52214,"_26932":52215,"_2867":52216},[],"/docs/pr-preview/pr-53/platform/iot-fleets/integrations/aws-iot-core#thing-lifecycle","Thing lifecycle",{"_3381":1276,"_29612":1264,"_5":29962,"_20544":52218,"_26932":52219,"_2867":52220},[],"/docs/pr-preview/pr-53/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_3381":1277,"_29612":1264,"_5":29962,"_20544":52222,"_26932":52223,"_2867":52224},[],"/docs/pr-preview/pr-53/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_3381":1278,"_29612":1264,"_5":29962,"_20544":52226,"_26932":52227,"_2867":52228},[],"/docs/pr-preview/pr-53/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_3381":1279,"_29612":1264,"_5":29962,"_20544":52230,"_26932":52231,"_2867":52232},[],"/docs/pr-preview/pr-53/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3381":1280,"_29612":1264,"_5":29962,"_20544":52234,"_26932":52235,"_2867":52236},[],"/docs/pr-preview/pr-53/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_3381":1281,"_29612":1264,"_5":29962,"_20544":52238,"_26932":52239,"_2867":52240},[],"/docs/pr-preview/pr-53/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_3381":1282,"_29612":1264,"_5":29962,"_20544":52242,"_26932":52243,"_2867":52244},[],"/docs/pr-preview/pr-53/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_3381":1283,"_29612":1264,"_5":29962,"_20544":52246,"_26932":52247,"_2867":52248},[],"/docs/pr-preview/pr-53/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_3381":1284,"_29612":1264,"_5":29962,"_20544":52250,"_26932":52251,"_2867":52252},[],"/docs/pr-preview/pr-53/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_3381":1285,"_29612":1264,"_5":29962,"_20544":52254,"_26932":52255,"_2867":52256},[],"/docs/pr-preview/pr-53/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_3381":1286,"_29612":1264,"_5":29962,"_20544":52258,"_26932":52259,"_2867":52260},[],"/docs/pr-preview/pr-53/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_3381":1287,"_29612":1264,"_5":29962,"_20544":52262,"_26932":52263,"_2867":52264},[],"/docs/pr-preview/pr-53/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_3381":1288,"_29612":1264,"_5":29962,"_20544":52266,"_26932":52267,"_2867":52268},[],"/docs/pr-preview/pr-53/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_3381":1289,"_29612":1264,"_5":29962,"_20544":52270,"_26932":52271,"_2867":52272},[],"/docs/pr-preview/pr-53/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_3381":1290,"_29612":1264,"_5":29962,"_20544":52274,"_26932":52275,"_2867":52276},[],"/docs/pr-preview/pr-53/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_3381":1291,"_29612":1264,"_5":29962,"_20544":52278,"_26932":52279,"_2867":52280},[],"/docs/pr-preview/pr-53/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_3381":1292,"_29612":1264,"_20544":52282,"_5":14097,"_26932":1264,"_2867":52283},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_3381":1293,"_29612":1264,"_20544":52285,"_5":14097,"_26932":1264,"_2867":52286},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_3381":1294,"_29612":1264,"_20544":52288,"_5":14097,"_26932":1264,"_2867":52289},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_3381":1295,"_29612":1264,"_20544":52291,"_5":14097,"_26932":52179,"_2867":52292},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_3381":1296,"_29612":1264,"_20544":52294,"_5":14097,"_26932":52179,"_2867":52295},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_3381":1297,"_29612":1264,"_20544":52297,"_5":14097,"_26932":52179,"_2867":52298},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_3381":1298,"_29612":1264,"_20544":52300,"_5":14097,"_26932":52179,"_2867":52301},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_3381":1299,"_29612":1264,"_20544":52303,"_5":14097,"_26932":52183,"_2867":52304},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_3381":1300,"_29612":1264,"_20544":52306,"_5":14097,"_26932":52187,"_2867":52307},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_3381":1301,"_29612":1264,"_20544":52309,"_5":14097,"_26932":52187,"_2867":52310},[],"IAM action",{"_3381":1302,"_29612":1264,"_20544":52312,"_5":14097,"_26932":52187,"_2867":48621},[],{"_3381":1303,"_29612":1264,"_20544":52314,"_5":14097,"_26932":52187,"_2867":52315},[],"`iot:GetRegistrationCode`",{"_3381":1304,"_29612":1264,"_20544":52317,"_5":14097,"_26932":52187,"_2867":52318},[],"Obtain the verification code for CA registration in the Primary Account",{"_3381":1305,"_29612":1264,"_20544":52320,"_5":14097,"_26932":52187,"_2867":52321},[],"`iot:RegisterCACertificate`",{"_3381":1306,"_29612":1264,"_20544":52323,"_5":14097,"_26932":52187,"_2867":52324},[],"Register the CA in AWS IoT",{"_3381":1307,"_29612":1264,"_20544":52326,"_5":14097,"_26932":52187,"_2867":52327},[],"`iot:DescribeCACertificate`",{"_3381":1308,"_29612":1264,"_20544":52329,"_5":14097,"_26932":52187,"_2867":52330},[],"Check the CA registration status",{"_3381":1309,"_29612":1264,"_20544":52332,"_5":14097,"_26932":52187,"_2867":52333},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3381":1310,"_29612":1264,"_20544":52335,"_5":14097,"_26932":52187,"_2867":52336},[],"Create or update Things in IoT Core",{"_3381":1311,"_29612":1264,"_20544":52338,"_5":14097,"_26932":52187,"_2867":52339},[],"`iot:RegisterThing`",{"_3381":1312,"_29612":1264,"_20544":52341,"_5":14097,"_26932":52187,"_2867":52342},[],"Provision Things through a template",{"_3381":1313,"_29612":1264,"_20544":52344,"_5":14097,"_26932":52187,"_2867":52345},[],"`iot:RegisterCertificate`",{"_3381":1314,"_29612":1264,"_20544":52347,"_5":14097,"_26932":52187,"_2867":52348},[],"Register device certificates",{"_3381":1315,"_29612":1264,"_20544":52350,"_5":14097,"_26932":52187,"_2867":52351},[],"`iot:UpdateCertificate`",{"_3381":1316,"_29612":1264,"_20544":52353,"_5":14097,"_26932":52187,"_2867":52354},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_3381":1317,"_29612":1264,"_20544":52356,"_5":14097,"_26932":52187,"_2867":52357},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3381":1318,"_29612":1264,"_20544":52359,"_5":14097,"_26932":52187,"_2867":52360},[],"Create and attach IoT policies",{"_3381":1319,"_29612":1264,"_20544":52362,"_5":14097,"_26932":52187,"_2867":52363},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3381":1320,"_29612":1264,"_20544":52365,"_5":14097,"_26932":52187,"_2867":52366},[],"Manage Thing groups",{"_3381":1321,"_29612":1264,"_20544":52368,"_5":14097,"_26932":52187,"_2867":52369},[],"`iot:CreateProvisioningTemplate`",{"_3381":1322,"_29612":1264,"_20544":52371,"_5":14097,"_26932":52187,"_2867":52372},[],"Create JITP templates",{"_3381":1323,"_29612":1264,"_20544":52374,"_5":14097,"_26932":52187,"_2867":52375},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3381":1324,"_29612":1264,"_20544":52377,"_5":14097,"_26932":52187,"_2867":52378},[],"Read and write the Device Shadow",{"_3381":1325,"_29612":1264,"_20544":52380,"_5":14097,"_26932":52187,"_2867":52381},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_3381":1326,"_29612":1264,"_20544":52383,"_5":14097,"_26932":52191,"_2867":52384},[],"Parameter",{"_3381":1327,"_29612":1264,"_20544":52386,"_5":14097,"_26932":52191,"_2867":52387},[],"Type",{"_3381":1328,"_29612":1264,"_20544":52389,"_5":14097,"_26932":52191,"_2867":52390},[],"Required",{"_3381":1329,"_29612":1264,"_20544":52392,"_5":14097,"_26932":52191,"_2867":52393},[],"Description",{"_3381":1330,"_29612":1264,"_20544":52395,"_5":14097,"_26932":52191,"_2867":52396},[],"`connector_id`",{"_3381":1331,"_29612":1264,"_20544":52398,"_5":14097,"_26932":52191,"_2867":24548},[],{"_3381":1332,"_29612":1264,"_20544":52400,"_5":14097,"_26932":52191,"_2867":52401},[],"Yes",{"_3381":1333,"_29612":1264,"_20544":52403,"_5":14097,"_26932":52191,"_2867":52404},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_3381":1334,"_29612":1264,"_20544":52406,"_5":14097,"_26932":52191,"_2867":52407},[],"`aws_config.region`",{"_3381":1335,"_29612":1264,"_20544":52409,"_5":14097,"_26932":52191,"_2867":24548},[],{"_3381":1336,"_29612":1264,"_20544":52411,"_5":14097,"_26932":52191,"_2867":52401},[],{"_3381":1337,"_29612":1264,"_20544":52413,"_5":14097,"_26932":52191,"_2867":52414},[],"AWS region where the connector operates.",{"_3381":1338,"_29612":1264,"_20544":52416,"_5":14097,"_26932":52191,"_2867":52417},[],"`aws_config.auth_method`",{"_3381":1339,"_29612":1264,"_20544":52419,"_5":14097,"_26932":52191,"_2867":24548},[],{"_3381":1340,"_29612":1264,"_20544":52421,"_5":14097,"_26932":52191,"_2867":52401},[],{"_3381":1341,"_29612":1264,"_20544":52423,"_5":14097,"_26932":52191,"_2867":52424},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_3381":1342,"_29612":1264,"_20544":52426,"_5":14097,"_26932":52191,"_2867":52427},[],"`aws_config.access_key_id`",{"_3381":1343,"_29612":1264,"_20544":52429,"_5":14097,"_26932":52191,"_2867":24548},[],{"_3381":1344,"_29612":1264,"_20544":52431,"_5":14097,"_26932":52191,"_2867":52432},[],"Only with `auth_method=static`",{"_3381":1345,"_29612":1264,"_20544":52434,"_5":14097,"_26932":52191,"_2867":52435},[],"AWS access key.",{"_3381":1346,"_29612":1264,"_20544":52437,"_5":14097,"_26932":52191,"_2867":52438},[],"`aws_config.secret_access_key`",{"_3381":1347,"_29612":1264,"_20544":52440,"_5":14097,"_26932":52191,"_2867":24548},[],{"_3381":1348,"_29612":1264,"_20544":52442,"_5":14097,"_26932":52191,"_2867":52432},[],{"_3381":1349,"_29612":1264,"_20544":52444,"_5":14097,"_26932":52191,"_2867":52445},[],"AWS secret key.",{"_3381":1350,"_29612":1264,"_20544":52447,"_5":14097,"_26932":52191,"_2867":52448},[],"`aws_config.session_token`",{"_3381":1351,"_29612":1264,"_20544":52450,"_5":14097,"_26932":52191,"_2867":24548},[],{"_3381":1352,"_29612":1264,"_20544":52452,"_5":14097,"_26932":52191,"_2867":52453},[],"No",{"_3381":1353,"_29612":1264,"_20544":52455,"_5":14097,"_26932":52191,"_2867":52456},[],"Session token (with `auth_method=static`).",{"_3381":1354,"_29612":1264,"_20544":52458,"_5":14097,"_26932":52191,"_2867":52459},[],"`aws_config.role_arn`",{"_3381":1355,"_29612":1264,"_20544":52461,"_5":14097,"_26932":52191,"_2867":24548},[],{"_3381":1356,"_29612":1264,"_20544":52463,"_5":14097,"_26932":52191,"_2867":52464},[],"Only with `auth_method=role`",{"_3381":1357,"_29612":1264,"_20544":52466,"_5":14097,"_26932":52191,"_2867":52467},[],"ARN of the role to assume.",{"_3381":1358,"_29612":1264,"_20544":52469,"_5":14097,"_26932":52191,"_2867":52470},[],"`aws_config.endpoint_url`",{"_3381":1359,"_29612":1264,"_20544":52472,"_5":14097,"_26932":52191,"_2867":24548},[],{"_3381":1360,"_29612":1264,"_20544":52474,"_5":14097,"_26932":52191,"_2867":52453},[],{"_3381":1361,"_29612":1264,"_20544":52476,"_5":14097,"_26932":52191,"_2867":52477},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_3381":1362,"_29612":1264,"_20544":52479,"_5":14097,"_26932":52191,"_2867":52480},[],"`subscriber_event_bus`",{"_3381":1363,"_29612":1264,"_20544":52482,"_5":14097,"_26932":52191,"_2867":17299},[],{"_3381":1364,"_29612":1264,"_20544":52484,"_5":14097,"_26932":52191,"_2867":52401},[],{"_3381":1365,"_29612":1264,"_20544":52486,"_5":14097,"_26932":52191,"_2867":52487},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_3381":1366,"_29612":1264,"_20544":52489,"_5":14097,"_26932":52191,"_2867":52490},[],"`dms_manager_client`",{"_3381":1367,"_29612":1264,"_20544":52492,"_5":14097,"_26932":52191,"_2867":24548},[],{"_3381":1368,"_29612":1264,"_20544":52494,"_5":14097,"_26932":52191,"_2867":52401},[],{"_3381":1369,"_29612":1264,"_20544":52496,"_5":14097,"_26932":52191,"_2867":52497},[],"HTTP URL of Lamassu's DMS Manager service.",{"_3381":1370,"_29612":1264,"_20544":52499,"_5":14097,"_26932":52191,"_2867":52500},[],"`device_manager_client`",{"_3381":1371,"_29612":1264,"_20544":52502,"_5":14097,"_26932":52191,"_2867":24548},[],{"_3381":1372,"_29612":1264,"_20544":52504,"_5":14097,"_26932":52191,"_2867":52401},[],{"_3381":1373,"_29612":1264,"_20544":52506,"_5":14097,"_26932":52191,"_2867":52507},[],"HTTP URL of Lamassu's Device Manager.",{"_3381":1374,"_29612":1264,"_20544":52509,"_5":14097,"_26932":52191,"_2867":52510},[],"`ca_client`",{"_3381":1375,"_29612":1264,"_20544":52512,"_5":14097,"_26932":52191,"_2867":24548},[],{"_3381":1376,"_29612":1264,"_20544":52514,"_5":14097,"_26932":52191,"_2867":52401},[],{"_3381":1377,"_29612":1264,"_20544":52516,"_5":14097,"_26932":52191,"_2867":52517},[],"HTTP URL of Lamassu's CA service.",{"_3381":1378,"_29612":1264,"_20544":52519,"_5":14097,"_26932":52195,"_2867":52520},[],"The connector owns the AWS side of four resource types — CAs, DMS provisioning templates (JITP), device certificates and Things. This section maps the bus events the connector consumes to the AWS resources they touch and to the AWS calls each transition performs. AWS resources are referenced with the notation `IoTCore/<resource>`.",{"_3381":1379,"_29612":1264,"_20544":52522,"_5":14097,"_26932":52199,"_2867":52523},[],"The **CloudEvent type** column lists the event name on Lamassu's internal event bus; the **IAM actions** column lists the exact AWS SDK operations each flow invokes, so the required permissions can be derived directly from this table.",{"_3381":1380,"_29612":1264,"_20544":52525,"_5":14097,"_26932":52199,"_2867":52526},[],"CloudEvent type",{"_3381":1381,"_29612":1264,"_20544":52528,"_5":14097,"_26932":52199,"_2867":52529},[],"Lamassu resource",{"_3381":1382,"_29612":1264,"_20544":52531,"_5":14097,"_26932":52199,"_2867":52532},[],"AWS Resource",{"_3381":1383,"_29612":1264,"_20544":52534,"_5":14097,"_26932":52199,"_2867":52535},[],"IAM actions",{"_3381":1384,"_29612":1264,"_20544":52537,"_5":14097,"_26932":52199,"_2867":52538},[],"AWS calls and effect",{"_3381":1385,"_29612":1264,"_20544":52540,"_5":14097,"_26932":52199,"_2867":52541},[],"Where in this page",{"_3381":1386,"_29612":1264,"_20544":52543,"_5":14097,"_26932":52199,"_2867":52544},[],"`EventCreateCAKey` / `EventImportCAKey` / `EventUpdateCAMetadataKey`",{"_3381":1387,"_29612":1264,"_20544":52546,"_5":14097,"_26932":52199,"_2867":52547},[],"CA",{"_3381":1388,"_29612":1264,"_20544":52549,"_5":14097,"_26932":52199,"_2867":52550},[],"`IoTCore/CACertificate`",{"_3381":1389,"_29612":1264,"_20544":52552,"_5":14097,"_26932":52199,"_2867":52553},[],"`iot:GetRegistrationCode`, `iot:RegisterCACertificate`, `iot:DescribeCACertificate`, `iot:ListCACertificates`",{"_3381":1390,"_29612":1264,"_20544":52555,"_5":14097,"_26932":52199,"_2867":52556},[],"Loads the CA into connector state; a `registration.status = REQUESTED` write fires the registration flow (Primary with verification certificate, or SNI-only) and writes `SUCCEEDED` or `FAILED` back to the CA's metadata.",{"_3381":1391,"_29612":1264,"_20544":52558,"_5":14097,"_26932":52199,"_2867":52204},[],{"_3381":1392,"_29612":1264,"_20544":52560,"_5":14097,"_26932":52199,"_2867":52561},[],"`EventCreateDMSKey` / `EventUpdateDMSKey`",{"_3381":1393,"_29612":1264,"_20544":52563,"_5":14097,"_26932":52199,"_2867":52564},[],"DMS",{"_3381":1394,"_29612":1264,"_20544":52566,"_5":14097,"_26932":52199,"_2867":52567},[],"`IoTCore/ProvisioningTemplate`",{"_3381":1395,"_29612":1264,"_20544":52569,"_5":14097,"_26932":52199,"_2867":52570},[],"`iot:CreateProvisioningTemplate`, `iot:UpdateCACertificate`",{"_3381":1396,"_29612":1264,"_20544":52572,"_5":14097,"_26932":52199,"_2867":52573},[],"In `jitp` mode, attempts to create the provisioning template and attaches it to the registered CA. Non-idempotent: a `PUT /v1/dms/{id}` edit retries the creation and lands in `lamassu-dlq` after 3 retries. Idempotent for `none` and `auto` (configuration only).",{"_3381":1397,"_29612":1264,"_20544":52575,"_5":14097,"_26932":52199,"_2867":52208},[],{"_3381":1398,"_29612":1264,"_20544":52577,"_5":14097,"_26932":52199,"_2867":52578},[],"`EventBindDeviceIdentityKey`",{"_3381":1399,"_29612":1264,"_20544":52580,"_5":14097,"_26932":52199,"_2867":52581},[],"Device",{"_3381":1400,"_29612":1264,"_20544":52583,"_5":14097,"_26932":52199,"_2867":52584},[],"`IoTCore/Policy`, `IoTCore/ThingGroup`, `IoTCore/Thing`",{"_3381":1401,"_29612":1264,"_20544":52586,"_5":14097,"_26932":52199,"_2867":52587},[],"`iot:CreatePolicy` / `iot:DeletePolicyVersion`, `iot:GetPolicy` / `iot:ListPolicyVersions`, `iot:CreateThingGroup`, `iot:DescribeThing` / `iot:ListThingPrincipals`, `iot:RegisterThing`",{"_3381":1402,"_29612":1264,"_20544":52589,"_5":14097,"_26932":52199,"_2867":52590},[],"In `auto` mode: creates/updates policies, ensures Thing groups, revokes stale principals and provisions the Thing via `iot:RegisterThing`. In `jitp` mode: no AWS calls; AWS runs the JITP template on first connection.",{"_3381":1403,"_29612":1264,"_20544":52592,"_5":14097,"_26932":52199,"_2867":52216},[],{"_3381":1404,"_29612":1264,"_20544":52594,"_5":14097,"_26932":52199,"_2867":52595},[],"`EventUpdateCertificateStatusKey`",{"_3381":1405,"_29612":1264,"_20544":52597,"_5":14097,"_26932":52199,"_2867":52598},[],"Certificate",{"_3381":1406,"_29612":1264,"_20544":52600,"_5":14097,"_26932":52199,"_2867":52601},[],"`IoTCore/Certificate`",{"_3381":1407,"_29612":1264,"_20544":52603,"_5":14097,"_26932":52199,"_2867":52604},[],"`iot:UpdateCertificate`, `iot:Connect` (data plane)",{"_3381":1408,"_29612":1264,"_20544":52606,"_5":14097,"_26932":52199,"_2867":52607},[],"Maps status to AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), calls `iot:UpdateCertificate` and forces an MQTT disconnect on revoke.",{"_3381":1409,"_29612":1264,"_20544":52609,"_5":14097,"_26932":52199,"_2867":52212},[],{"_3381":1410,"_29612":1264,"_20544":52611,"_5":14097,"_26932":52199,"_2867":52612},[],"`EventUpdateCertificateMetadataKey` / `EventUpdateDeviceMetadataKey`",{"_3381":1411,"_29612":1264,"_20544":52614,"_5":14097,"_26932":52199,"_2867":52615},[],"Certificate / Device",{"_3381":1412,"_29612":1264,"_20544":52617,"_5":14097,"_26932":52199,"_2867":52618},[],"`IoTCore/Certificate`, `IoTCore/Thing`",{"_3381":1413,"_29612":1264,"_20544":52620,"_5":14097,"_26932":52199,"_2867":48627},[],{"_3381":1414,"_29612":1264,"_20544":52622,"_5":14097,"_26932":52199,"_2867":52623},[],"Refreshes internal state; the connector ignores events whose CloudEvent `source` matches its own URI to avoid self-triggered loops.",{"_3381":1415,"_29612":1264,"_20544":52625,"_5":14097,"_26932":52199,"_2867":52268},[],{"_3381":1416,"_29612":1264,"_20544":52627,"_5":14097,"_26932":52203,"_2867":52628},[],"The CA registration flow is driven by the `registration.status` field of the CA's connector metadata:",{"_3381":1417,"_29612":1264,"_20544":52630,"_5":14097,"_26932":52203,"_2867":52631},[],"by the `registration.status` field of the CA's connector metadata:",{"_3381":1418,"_29612":1264,"_20544":52633,"_5":14097,"_26932":52203,"_2867":52634},[],"Transition",{"_3381":1419,"_29612":1264,"_20544":52636,"_5":14097,"_26932":52203,"_2867":52637},[],"AWS calls",{"_3381":1420,"_29612":1264,"_20544":52639,"_5":14097,"_26932":52203,"_2867":52640},[],"`NotRegistered` → `Requested`",{"_3381":1421,"_29612":1264,"_20544":52642,"_5":14097,"_26932":52203,"_2867":52643},[],"none (metadata write only)",{"_3381":1422,"_29612":1264,"_20544":52645,"_5":14097,"_26932":52203,"_2867":52646},[],"`Requested` → `Registering`",{"_3381":1423,"_29612":1264,"_20544":52648,"_5":14097,"_26932":52203,"_2867":52649},[],"`iot:GetRegistrationCode` (Primary Account only)",{"_3381":1424,"_29612":1264,"_20544":52651,"_5":14097,"_26932":52203,"_2867":52652},[],"`Registering` → `Succeeded`",{"_3381":1425,"_29612":1264,"_20544":52654,"_5":14097,"_26932":52203,"_2867":52655},[],"`iot:RegisterCACertificate` (Primary: proof-of-possession with an ephemeral key; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3381":1426,"_29612":1264,"_20544":52657,"_5":14097,"_26932":52203,"_2867":52658},[],"`Registering` → `Failed`",{"_3381":1427,"_29612":1264,"_20544":52660,"_5":14097,"_26932":52203,"_2867":52661},[],"failed `iot:RegisterCACertificate`; the error detail is written to the CA's metadata",{"_3381":1428,"_29612":1264,"_20544":52663,"_5":14097,"_26932":52203,"_2867":52664},[],"`Failed` / `Succeeded` → `Requested`",{"_3381":1429,"_29612":1264,"_20544":52666,"_5":14097,"_26932":52203,"_2867":52667},[],"none (a new `REQUESTED` write re-runs the flow)",{"_3381":1430,"_29612":1264,"_20544":52669,"_5":14097,"_26932":52207,"_2867":52670},[],"The DMS's `registration_mode` determines what the connector does on the AWS side when the DMS is created or fully edited:",{"_3381":1431,"_29612":1264,"_20544":52672,"_5":14097,"_26932":52207,"_2867":52634},[],{"_3381":1432,"_29612":1264,"_20544":52674,"_5":14097,"_26932":52207,"_2867":52637},[],{"_3381":1433,"_29612":1264,"_20544":52676,"_5":14097,"_26932":52207,"_2867":52677},[],"`Unconfigured` → `None` / `Auto`",{"_3381":1434,"_29612":1264,"_20544":52679,"_5":14097,"_26932":52207,"_2867":52680},[],"none (configuration only)",{"_3381":1435,"_29612":1264,"_20544":52682,"_5":14097,"_26932":52207,"_2867":52683},[],"`None` ↔ `Auto`",{"_3381":1436,"_29612":1264,"_20544":52685,"_5":14097,"_26932":52207,"_2867":52680},[],{"_3381":1437,"_29612":1264,"_20544":52687,"_5":14097,"_26932":52207,"_2867":52688},[],"Any → `Jitp`",{"_3381":1438,"_29612":1264,"_20544":52690,"_5":14097,"_26932":52207,"_2867":52691},[],"`iot:CreateProvisioningTemplate` (non-idempotent: it fails when the template already exists; after 3 retries the event lands in `lamassu-dlq`)",{"_3381":1439,"_29612":1264,"_20544":52693,"_5":14097,"_26932":52207,"_2867":52694},[],"`Jitp` → `None` / `Auto`",{"_3381":1440,"_29612":1264,"_20544":52696,"_5":14097,"_26932":52207,"_2867":52697},[],"none (the template stays in the AWS account)",{"_3381":1441,"_29612":1264,"_20544":52699,"_5":14097,"_26932":52211,"_2867":52700},[],"Certificates holding the connector's metadata key sync their status; certificates provisioned via JITP have no metadata key and stay out of this machine:",{"_3381":1442,"_29612":1264,"_20544":52702,"_5":14097,"_26932":52211,"_2867":52634},[],{"_3381":1443,"_29612":1264,"_20544":52704,"_5":14097,"_26932":52211,"_2867":52637},[],{"_3381":1444,"_29612":1264,"_20544":52706,"_5":14097,"_26932":52211,"_2867":52707},[],"`NotSynced` → `Active`",{"_3381":1445,"_29612":1264,"_20544":52709,"_5":14097,"_26932":52211,"_2867":52351},[],{"_3381":1446,"_29612":1264,"_20544":52711,"_5":14097,"_26932":52211,"_2867":52712},[],"`Active` → `Inactive`",{"_3381":1447,"_29612":1264,"_20544":52714,"_5":14097,"_26932":52211,"_2867":52715},[],"`iot:UpdateCertificate` + forced MQTT disconnect",{"_3381":1448,"_29612":1264,"_20544":52717,"_5":14097,"_26932":52211,"_2867":52718},[],"`Active` → `Revoked`",{"_3381":1449,"_29612":1264,"_20544":52720,"_5":14097,"_26932":52211,"_2867":52715},[],{"_3381":1450,"_29612":1264,"_20544":52722,"_5":14097,"_26932":52211,"_2867":52723},[],"`Inactive` / `Revoked` → `Active`",{"_3381":1451,"_29612":1264,"_20544":52725,"_5":14097,"_26932":52211,"_2867":52351},[],{"_3381":1452,"_29612":1264,"_20544":52727,"_5":14097,"_26932":52211,"_2867":52728},[],"`RenewalWindow` / `AboutToExpire` / `Expired`",{"_3381":1453,"_29612":1264,"_20544":52730,"_5":14097,"_26932":52211,"_2867":52731},[],"none (these states are not synced to AWS)",{"_3381":1454,"_29612":1264,"_20544":52733,"_5":14097,"_26932":52215,"_2867":52734},[],"Things only exist under `auto` mode; in `jitp` mode AWS creates the Thing itself when the device first connects. The Thing name is always the device certificate's CN:",{"_3381":1455,"_29612":1264,"_20544":52736,"_5":14097,"_26932":52215,"_2867":52634},[],{"_3381":1456,"_29612":1264,"_20544":52738,"_5":14097,"_26932":52215,"_2867":52637},[],{"_3381":1457,"_29612":1264,"_20544":52740,"_5":14097,"_26932":52215,"_2867":52741},[],"`Absent` → `Provisioned`",{"_3381":1458,"_29612":1264,"_20544":52743,"_5":14097,"_26932":52215,"_2867":52744},[],"policies created/updated, Thing groups ensured, `iot:RegisterThing` (creates the Thing, registers the certificate, attaches policies)",{"_3381":1459,"_29612":1264,"_20544":52746,"_5":14097,"_26932":52215,"_2867":52747},[],"`Provisioned` → `Provisioned` (re-enrollment)",{"_3381":1460,"_29612":1264,"_20544":52749,"_5":14097,"_26932":52215,"_2867":52750},[],"stale principals marked `REVOKED`, new `iot:RegisterThing` run; the new certificate ARN replaces the old one in Lamassu metadata",{"_3381":1461,"_29612":1264,"_20544":52752,"_5":14097,"_26932":52215,"_2867":52753},[],"In `jitp` mode the connector makes no provisioning calls: AWS executes the JITP template on the device's first connection and creates the Thing, registers the certificate and activates it on its own.",{"_3381":1462,"_29612":1264,"_20544":52755,"_5":14097,"_26932":52219,"_2867":52756},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_3381":1463,"_29612":1264,"_20544":52758,"_5":14097,"_26932":52223,"_2867":52759},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_3381":1464,"_29612":1264,"_20544":52761,"_5":14097,"_26932":52223,"_2867":52762},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_3381":1465,"_29612":1264,"_20544":52764,"_5":14097,"_26932":52227,"_2867":52765},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_3381":1466,"_29612":1264,"_20544":52767,"_5":14097,"_26932":52227,"_2867":52768},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_3381":1467,"_29612":1264,"_20544":52770,"_5":14097,"_26932":52227,"_2867":52771},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_3381":1468,"_29612":1264,"_20544":52773,"_5":14097,"_26932":52227,"_2867":52774},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_3381":1469,"_29612":1264,"_20544":52776,"_5":14097,"_26932":52227,"_2867":52777},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_3381":1470,"_29612":1264,"_20544":52779,"_5":14097,"_26932":52227,"_2867":52780},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_3381":1471,"_29612":1264,"_20544":52782,"_5":14097,"_26932":52231,"_2867":52783},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_3381":1472,"_29612":1264,"_20544":52785,"_5":14097,"_26932":52235,"_2867":52786},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_3381":1473,"_29612":1264,"_20544":52788,"_5":14097,"_26932":52235,"_2867":52789},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_3381":1474,"_29612":1264,"_20544":52791,"_5":14097,"_26932":52239,"_2867":52792},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_3381":1475,"_29612":1264,"_20544":52794,"_5":14097,"_26932":52243,"_2867":52795},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_3381":1476,"_29612":1264,"_20544":52797,"_5":14097,"_26932":52243,"_2867":52798},[],"Creates or updates the IoT policies configured in the DMS.",{"_3381":1477,"_29612":1264,"_20544":52800,"_5":14097,"_26932":52243,"_2867":52801},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_3381":1478,"_29612":1264,"_20544":52803,"_5":14097,"_26932":52243,"_2867":52804},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_3381":1479,"_29612":1264,"_20544":52806,"_5":14097,"_26932":52243,"_2867":52807},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_3381":1480,"_29612":1264,"_20544":52809,"_5":14097,"_26932":52243,"_2867":52810},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_3381":1481,"_29612":1264,"_20544":52812,"_5":14097,"_26932":52243,"_2867":52813},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_3381":1482,"_29612":1264,"_20544":52815,"_5":14097,"_26932":52247,"_2867":52816},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. The connector attempts to create this template when the DMS is created and again on every full DMS edit (`PUT /v1/dms/{id}`) — not at device enrollment time. The attempt is not idempotent: when a template named after the DMS ID already exists, the creation call fails, the event is retried three times and finally lands in the `lamassu-dlq` poison queue (see Troubleshooting). The template is created once; later DMS edits never update its content. A DMS update that omits `metadata` or sends `null` keeps the stored metadata, so the connector key `lamassu.io/iot/{connector_id}` remains present and the attempt is still triggered. A body that supplies a `metadata` object replaces the stored metadata entirely: if that object does not carry the connector key, the key is dropped and the connector silently skips the DMS's future events. Once the template is attached, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_3381":1483,"_29612":1264,"_20544":52818,"_5":14097,"_26932":52247,"_2867":52819},[],"The connector creates the template, named after the DMS ID, only once. Each later edit of the DMS that keeps the connector key tries to create it again and fails, because the connector does not update existing templates. Later changes to `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` or to the groups and policies the template references must be applied by hand in AWS IoT Core.",{"_3381":1484,"_29612":1264,"_20544":52821,"_5":14097,"_26932":52247,"_2867":52822},[],"The failed event is retried and ends in `lamassu-dlq`. Groups and policies are registered before the failure, but the assignment of the template to the registered CA, the write-back of the ARN to the DMS and the shadow update when `ManagedCAs` changes are skipped.",{"_3381":1485,"_29612":1264,"_20544":52824,"_5":14097,"_26932":52247,"_2867":52825},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_3381":1486,"_29612":1264,"_20544":52827,"_5":14097,"_26932":52247,"_2867":52828},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_3381":1487,"_29612":1264,"_20544":52830,"_5":14097,"_26932":52251,"_2867":52831},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_3381":1488,"_29612":1264,"_20544":52833,"_5":14097,"_26932":52251,"_2867":52834},[],"The full flow from the device's perspective is:",{"_3381":1489,"_29612":1264,"_20544":52836,"_5":14097,"_26932":52251,"_2867":52837},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_3381":1490,"_29612":1264,"_20544":52839,"_5":14097,"_26932":52255,"_2867":52840},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_3381":1491,"_29612":1264,"_20544":52842,"_5":14097,"_26932":52255,"_2867":52843},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_3381":1492,"_29612":1264,"_20544":52845,"_5":14097,"_26932":52255,"_2867":52846},[],"For the JITP flow to work correctly:",{"_3381":1493,"_29612":1264,"_20544":52848,"_5":14097,"_26932":52255,"_2867":52849},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_3381":1494,"_29612":1264,"_20544":52851,"_5":14097,"_26932":52255,"_2867":52852},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_3381":1495,"_29612":1264,"_20544":52854,"_5":14097,"_26932":52255,"_2867":52855},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_3381":1496,"_29612":1264,"_20544":52857,"_5":14097,"_26932":52255,"_2867":52858},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_3381":1497,"_29612":1264,"_20544":52860,"_5":14097,"_26932":52259,"_2867":52861},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_3381":1498,"_29612":1264,"_20544":52863,"_5":14097,"_26932":52259,"_2867":52864},[],"Status in Lamassu",{"_3381":1499,"_29612":1264,"_20544":52866,"_5":14097,"_26932":52259,"_2867":52867},[],"Revocation reason",{"_3381":1500,"_29612":1264,"_20544":52869,"_5":14097,"_26932":52259,"_2867":52870},[],"Status in AWS IoT Core",{"_3381":1501,"_29612":1264,"_20544":52872,"_5":14097,"_26932":52259,"_2867":52873},[],"`Active`",{"_3381":1502,"_29612":1264,"_20544":52875,"_5":14097,"_26932":52259,"_2867":52876},[],"None",{"_3381":1503,"_29612":1264,"_20544":52878,"_5":14097,"_26932":52259,"_2867":52879},[],"`ACTIVE`",{"_3381":1504,"_29612":1264,"_20544":52881,"_5":14097,"_26932":52259,"_2867":52882},[],"`Revoked`",{"_3381":1505,"_29612":1264,"_20544":52884,"_5":14097,"_26932":52259,"_2867":52885},[],"`certificateHold`",{"_3381":1506,"_29612":1264,"_20544":52887,"_5":14097,"_26932":52259,"_2867":52888},[],"`INACTIVE`",{"_3381":1507,"_29612":1264,"_20544":52890,"_5":14097,"_26932":52259,"_2867":52882},[],{"_3381":1508,"_29612":1264,"_20544":52892,"_5":14097,"_26932":52259,"_2867":52893},[],"Any other reason",{"_3381":1509,"_29612":1264,"_20544":52895,"_5":14097,"_26932":52259,"_2867":52896},[],"`REVOKED`",{"_3381":1510,"_29612":1264,"_20544":52898,"_5":14097,"_26932":52259,"_2867":52899},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_3381":1511,"_29612":1264,"_20544":52901,"_5":14097,"_26932":52263,"_2867":52902},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_3381":1512,"_29612":1264,"_20544":52904,"_5":14097,"_26932":52263,"_2867":52905},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_3381":1513,"_29612":1264,"_20544":52907,"_5":14097,"_26932":52263,"_2867":52908},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_3381":1514,"_29612":1264,"_20544":52910,"_5":14097,"_26932":52267,"_2867":52911},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_3381":1515,"_29612":1264,"_20544":52913,"_5":14097,"_26932":52267,"_2867":52914},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_3381":1516,"_29612":1264,"_20544":52916,"_5":14097,"_26932":52271,"_2867":52917},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_3381":1517,"_29612":1264,"_20544":52919,"_5":14097,"_26932":52271,"_2867":52920},[],"There are two action types:",{"_3381":1518,"_29612":1264,"_20544":52922,"_5":14097,"_26932":52271,"_2867":52923},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_3381":1519,"_29612":1264,"_20544":52925,"_5":14097,"_26932":52271,"_2867":52926},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_3381":1520,"_29612":1264,"_20544":52928,"_5":14097,"_26932":52271,"_2867":52929},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_3381":1521,"_29612":1264,"_20544":52931,"_5":14097,"_26932":52275,"_2867":52932},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_3381":1522,"_29612":1264,"_20544":52934,"_5":14097,"_26932":52275,"_2867":52935},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_3381":1523,"_29612":1264,"_20544":52937,"_5":14097,"_26932":52275,"_2867":52938},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_3381":1524,"_29612":1264,"_20544":52940,"_5":14097,"_26932":52279,"_2867":52941},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_3381":1525,"_29612":1264,"_20544":52943,"_5":14097,"_26932":52279,"_2867":52944},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_3381":1526,"_29612":1264,"_20544":52946,"_5":14097,"_26932":52279,"_2867":52947},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_3381":1527,"_29612":1264,"_20544":52949,"_5":14097,"_26932":52279,"_2867":52950},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_3381":1528,"_29612":1264,"_20544":52952,"_5":14097,"_26932":52279,"_2867":52953},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_3381":1529,"_29612":1264,"_20544":52955,"_5":14097,"_26932":52279,"_2867":52956},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_3381":1530,"_29612":1264,"_20544":52958,"_5":14097,"_26932":52279,"_2867":52959},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_3381":1531,"_29612":1264,"_20544":52961,"_5":14097,"_26932":52279,"_2867":52962},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_3381":1532,"_29612":1264,"_20544":52964,"_5":14097,"_26932":52279,"_2867":52965},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_3381":1533,"_29612":1264,"_20544":52967,"_5":14097,"_26932":52279,"_2867":52968},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_3381":1534,"_29612":1264,"_20544":52970,"_5":14097,"_26932":52279,"_2867":52971},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_3381":1535,"_29612":1264,"_20544":52973,"_5":14097,"_26932":52279,"_2867":52974},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_3381":1536,"_29612":1264,"_20544":52976,"_5":14097,"_26932":52279,"_2867":52977},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_3381":1537,"_29612":1264,"_20544":52979,"_5":14097,"_26932":52279,"_2867":52980},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_3381":1538,"_29612":1264,"_20544":52982,"_5":14097,"_26932":52279,"_2867":52983},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_3381":1539,"_29612":1264,"_20544":52985,"_5":14097,"_26932":52279,"_2867":52986},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_3381":1540,"_29612":1264,"_20544":52988,"_5":14097,"_26932":52279,"_2867":52989},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_3381":1541,"_29612":1264,"_20544":52991,"_5":14097,"_26932":52279,"_2867":52992},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_3381":1542,"_29612":1264,"_20544":52994,"_5":14097,"_26932":52279,"_2867":52995},[],"**Symptom:** After editing a DMS in `jitp` mode, DMS update messages appear in `lamassu-dlq`, or JITP configuration changes have no effect in AWS.",{"_3381":1543,"_29612":1264,"_20544":52997,"_5":14097,"_26932":52279,"_2867":52998},[],"**Cause:** Every full DMS edit (`PUT /v1/dms/{id}`) triggers a `CreateProvisioningTemplate` attempt for the template named after the DMS ID, and the call is not idempotent: when the template already exists, it fails, the event is retried three times and finally lands in `lamassu-dlq`. The connector’s later steps are skipped.",{"_3381":1544,"_29612":1264,"_20544":53000,"_5":14097,"_26932":52279,"_2867":53001},[],"**Resolution:** Check that the template named with the DMS ID exists in AWS IoT Core and that JITP enrollment works. If the JITP configuration was changed, apply it by hand to the AWS template.",{"_3381":1545,"_29612":1264,"_20544":53003,"_5":14097,"_26932":52279,"_2867":53004},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3381":1546,"_29612":1264,"_20544":53006,"_5":14097,"_26932":52279,"_2867":53007},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3381":1547,"_29612":1264,"_20544":53009,"_5":14097,"_26932":52279,"_2867":53010},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_3381":1548,"_29612":1548,"_5":14455,"_2867":50710,"_29965":53012,"_20544":53013,"_26932":1548},[48231,49699,50710],[],{"_3381":1549,"_29612":1548,"_20544":53015,"_5":14097,"_26932":1548,"_2867":53016},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_3381":1550,"_29612":1548,"_5":29962,"_20544":53018,"_26932":53019,"_2867":53020},[],"/docs/pr-preview/pr-53/platform/iot-fleets/overview#start-here","Start here",{"_3381":1551,"_29612":1548,"_5":29962,"_20544":53022,"_26932":53023,"_2867":50708},[],"/docs/pr-preview/pr-53/platform/iot-fleets/overview#devices-and-identities",{"_3381":1552,"_29612":1548,"_5":29962,"_20544":53025,"_26932":53026,"_2867":50891},[],"/docs/pr-preview/pr-53/platform/iot-fleets/overview#enrollment-with-pki",{"_3381":1553,"_29612":1548,"_5":29962,"_20544":53028,"_26932":53029,"_2867":52172},[],"/docs/pr-preview/pr-53/platform/iot-fleets/overview#integrations",{"_3381":1554,"_29612":1548,"_5":29962,"_20544":53031,"_26932":53032,"_2867":53033},[],"/docs/pr-preview/pr-53/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_3381":1555,"_29612":1548,"_20544":53035,"_5":14097,"_26932":1548,"_2867":53036},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_3381":1556,"_29612":1548,"_20544":53038,"_5":14097,"_26932":53019,"_2867":53039},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_3381":1557,"_29612":1548,"_20544":53041,"_5":14097,"_26932":53019,"_2867":53042},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_3381":1558,"_29612":1548,"_20544":53044,"_5":14097,"_26932":53023,"_2867":53045},[],"Resource",{"_3381":1559,"_29612":1548,"_20544":53047,"_5":14097,"_26932":53023,"_2867":53048},[],"What it represents",{"_3381":1560,"_29612":1548,"_20544":53050,"_5":14097,"_26932":53023,"_2867":53051},[],"**Device**",{"_3381":1561,"_29612":1548,"_20544":53053,"_5":14097,"_26932":53023,"_2867":53054},[],"An inventory entry with an identifier, owning DMS and classification.",{"_3381":1562,"_29612":1548,"_20544":53056,"_5":14097,"_26932":53023,"_2867":53057},[],"**Identity**",{"_3381":1563,"_29612":1548,"_20544":53059,"_5":14097,"_26932":53023,"_2867":53060},[],"The device's association with its certificates: an active version and a history.",{"_3381":1564,"_29612":1548,"_20544":53062,"_5":14097,"_26932":53023,"_2867":53063},[],"**DMS**",{"_3381":1565,"_29612":1548,"_20544":53065,"_5":14097,"_26932":53023,"_2867":53066},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_3381":1566,"_29612":1548,"_20544":53068,"_5":14097,"_26932":53023,"_2867":53069},[],"**Fleet**",{"_3381":1567,"_29612":1548,"_20544":53071,"_5":14097,"_26932":53023,"_2867":53072},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_3381":1568,"_29612":1548,"_20544":53074,"_5":14097,"_26932":53023,"_2867":53075},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_3381":1569,"_29612":1548,"_20544":53077,"_5":14097,"_26932":53023,"_2867":53078},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_3381":1570,"_29612":1548,"_20544":53080,"_5":14097,"_26932":53026,"_2867":53081},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_3381":1571,"_29612":1548,"_20544":53083,"_5":14097,"_26932":53026,"_2867":53084},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_3381":1572,"_29612":1548,"_20544":53086,"_5":14097,"_26932":53026,"_2867":53087},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_3381":1573,"_29612":1548,"_20544":53089,"_5":14097,"_26932":53026,"_2867":53090},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_3381":1574,"_29612":1548,"_20544":53092,"_5":14097,"_26932":53026,"_2867":53093},[],"**Result:** request the certificate, install it and check its association with the device.",{"_3381":1575,"_29612":1548,"_20544":53095,"_5":14097,"_26932":53026,"_2867":53096},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_3381":1576,"_29612":1548,"_20544":53098,"_5":14097,"_26932":53026,"_2867":53099},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3381":1577,"_29612":1548,"_20544":53101,"_5":14097,"_26932":53026,"_2867":53102},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3381":1578,"_29612":1548,"_20544":53104,"_5":14097,"_26932":53029,"_2867":53105},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_3381":1579,"_29612":1548,"_20544":53107,"_5":14097,"_26932":53029,"_2867":53108},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_3381":1580,"_29612":1548,"_20544":53110,"_5":14097,"_26932":53032,"_2867":53111},[],"Participant",{"_3381":1581,"_29612":1548,"_20544":53113,"_5":14097,"_26932":53032,"_2867":53114},[],"Responsibility",{"_3381":1582,"_29612":1548,"_20544":53116,"_5":14097,"_26932":53032,"_2867":53117},[],"PKI administrator",{"_3381":1583,"_29612":1548,"_20544":53119,"_5":14097,"_26932":53032,"_2867":53120},[],"CA, issuance profile, chain and revocation publication.",{"_3381":1584,"_29612":1548,"_20544":53122,"_5":14097,"_26932":53032,"_2867":53123},[],"Provisioning administrator",{"_3381":1585,"_29612":1548,"_20544":53125,"_5":14097,"_26932":53032,"_2867":53126},[],"DMS, admission, authentication per operation and inventory.",{"_3381":1586,"_29612":1548,"_20544":53128,"_5":14097,"_26932":53032,"_2867":53129},[],"Device integrator",{"_3381":1587,"_29612":1548,"_20544":53131,"_5":14097,"_26932":53032,"_2867":53132},[],"Initial credential, key, EST client, trust and certificate installation.",{"_3381":1588,"_29612":1548,"_20544":53134,"_5":14097,"_26932":53032,"_2867":53135},[],"Consumer integrator",{"_3381":1589,"_29612":1548,"_20544":53137,"_5":14097,"_26932":53032,"_2867":53138},[],"Trusted issuers, validation and device permissions in the destination.",{"_3381":1590,"_29612":1548,"_20544":53140,"_5":14097,"_26932":53032,"_2867":53141},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_3381":1591,"_29612":1591,"_5":14455,"_2867":53143,"_29965":53144,"_20544":53146,"_26932":1591},"Enroll and connect your first device",[48231,49699,50710,53145],"Getting started",[],{"_3381":1592,"_29612":1591,"_20544":53148,"_5":14097,"_26932":1591,"_2867":53149},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_3381":1593,"_29612":1591,"_5":29962,"_20544":53151,"_26932":53152,"_2867":48241},[],"/docs/pr-preview/pr-53/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_3381":1594,"_29612":1591,"_5":29962,"_20544":53154,"_26932":53155,"_2867":53156},[],"/docs/pr-preview/pr-53/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_3381":1595,"_29612":1591,"_5":29962,"_20544":53158,"_26932":53159,"_2867":53160},[],"/docs/pr-preview/pr-53/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_3381":1596,"_29612":1591,"_5":29962,"_20544":53162,"_26932":53163,"_2867":53164},[],"/docs/pr-preview/pr-53/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_3381":1597,"_29612":1591,"_5":29962,"_20544":53166,"_26932":53167,"_2867":53168},[],"/docs/pr-preview/pr-53/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_3381":1598,"_29612":1591,"_5":29962,"_20544":53170,"_26932":53171,"_2867":53172},[],"/docs/pr-preview/pr-53/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_3381":1599,"_29612":1591,"_5":29962,"_20544":53174,"_26932":53175,"_2867":53176},[],"/docs/pr-preview/pr-53/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_3381":1600,"_29612":1591,"_5":29962,"_20544":53178,"_26932":53179,"_2867":53180},[],"/docs/pr-preview/pr-53/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_3381":1601,"_29612":1591,"_20544":53182,"_5":14097,"_26932":1591,"_2867":53183},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_3381":1602,"_29612":1591,"_20544":53185,"_5":14097,"_26932":53152,"_2867":53186},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_3381":1603,"_29612":1591,"_20544":53188,"_5":14097,"_26932":53152,"_2867":53189},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_3381":1604,"_29612":1591,"_20544":53191,"_5":14097,"_26932":53152,"_2867":53192},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_3381":1605,"_29612":1591,"_20544":53194,"_5":14097,"_26932":53152,"_2867":53195},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_3381":1606,"_29612":1591,"_20544":53197,"_5":14097,"_26932":53152,"_2867":53198},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_3381":1607,"_29612":1591,"_20544":53200,"_5":14097,"_26932":53155,"_2867":53201},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_3381":1608,"_29612":1591,"_20544":53203,"_5":14097,"_26932":53155,"_2867":53204},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_3381":1609,"_29612":1591,"_20544":53206,"_5":14097,"_26932":53159,"_2867":53207},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_3381":1610,"_29612":1591,"_20544":53209,"_5":14097,"_26932":53159,"_2867":53210},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_3381":1611,"_29612":1591,"_20544":53212,"_5":14097,"_26932":53159,"_2867":53213},[],"Setting",{"_3381":1612,"_29612":1591,"_20544":53215,"_5":14097,"_26932":53159,"_2867":53216},[],"Evaluation value",{"_3381":1613,"_29612":1591,"_20544":53218,"_5":14097,"_26932":53159,"_2867":53219},[],"Enrollment CA",{"_3381":1614,"_29612":1591,"_20544":53221,"_5":14097,"_26932":53159,"_2867":53222},[],"Issuing root from `device-root.pem`.",{"_3381":1615,"_29612":1591,"_20544":53224,"_5":14097,"_26932":53159,"_2867":51021},[],{"_3381":1616,"_29612":1591,"_20544":53226,"_5":14097,"_26932":53159,"_2867":53227},[],"The 1-hour leaf profile you just prepared.",{"_3381":1617,"_29612":1591,"_20544":53229,"_5":14097,"_26932":53159,"_2867":53230},[],"Protocol / Registration Mode",{"_3381":1618,"_29612":1591,"_20544":53232,"_5":14097,"_26932":53159,"_2867":53233},[],"`EST_RFC7030` / `JITP`.",{"_3381":1619,"_29612":1591,"_20544":53235,"_5":14097,"_26932":53159,"_2867":53236},[],"Verify CSR Signature",{"_3381":1620,"_29612":1591,"_20544":53238,"_5":14097,"_26932":53159,"_2867":53239},[],"Enabled.",{"_3381":1621,"_29612":1591,"_20544":53241,"_5":14097,"_26932":53159,"_2867":53242},[],"Enable Replaceable Enrollment",{"_3381":1622,"_29612":1591,"_20544":53244,"_5":14097,"_26932":53159,"_2867":53245},[],"Disabled; the ID must be new.",{"_3381":1623,"_29612":1591,"_20544":53247,"_5":14097,"_26932":53159,"_2867":53248},[],"Initial authentication",{"_3381":1624,"_29612":1591,"_20544":53250,"_5":14097,"_26932":53159,"_2867":53251},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_3381":1625,"_29612":1591,"_20544":53253,"_5":14097,"_26932":53159,"_2867":53254},[],"Renewal authentication",{"_3381":1626,"_29612":1591,"_20544":53256,"_5":14097,"_26932":53159,"_2867":53257},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_3381":1627,"_29612":1591,"_20544":53259,"_5":14097,"_26932":53159,"_2867":53260},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_3381":1628,"_29612":1591,"_20544":53262,"_5":14097,"_26932":53159,"_2867":53263},[],"Not needed for this direct issuance; the Enrollment CA is always trusted for re-enrollment / disabled.",{"_3381":1629,"_29612":1591,"_20544":53265,"_5":14097,"_26932":53159,"_2867":53266},[],"Re-enrollment Delta",{"_3381":1630,"_29612":1591,"_20544":53268,"_5":14097,"_26932":53159,"_2867":53269},[],"1 hour.",{"_3381":1631,"_29612":1591,"_20544":53271,"_5":14097,"_26932":53159,"_2867":53272},[],"Preventive / Critical Delta",{"_3381":1632,"_29612":1591,"_20544":53274,"_5":14097,"_26932":53159,"_2867":53275},[],"30 minutes / 10 minutes.",{"_3381":1633,"_29612":1591,"_20544":53277,"_5":14097,"_26932":53159,"_2867":53278},[],"Revoke on Re-enrollment",{"_3381":1634,"_29612":1591,"_20544":53280,"_5":14097,"_26932":53159,"_2867":53281},[],"Disabled to test the successor before retiring the previous identity.",{"_3381":1635,"_29612":1591,"_20544":53283,"_5":14097,"_26932":53159,"_2867":51029},[],{"_3381":1636,"_29612":1591,"_20544":53285,"_5":14097,"_26932":53159,"_2867":53286},[],"Disabled; the operational key is generated in the client.",{"_3381":1637,"_29612":1591,"_20544":53288,"_5":14097,"_26932":53159,"_2867":53289},[],"CA Distribution",{"_3381":1638,"_29612":1591,"_20544":53291,"_5":14097,"_26932":53159,"_2867":53292},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_3381":1639,"_29612":1591,"_20544":53294,"_5":14097,"_26932":53159,"_2867":53295},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. The console exposes independent editors for the enrollment and re-enrollment authentication; the DMS guide describes their fields, and you can also check the resource through the DMS API.",{"_3381":1640,"_29612":1591,"_20544":53297,"_5":14097,"_26932":53163,"_2867":53298},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_3381":1641,"_29612":1591,"_20544":53300,"_5":14097,"_26932":53163,"_2867":53301},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_3381":1642,"_29612":1591,"_20544":53303,"_5":14097,"_26932":53167,"_2867":53304},[],"Generate a new key and CSR with the selected identifier:",{"_3381":1643,"_29612":1591,"_20544":53306,"_5":14097,"_26932":53167,"_2867":53307},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_3381":1644,"_29612":1591,"_20544":53309,"_5":14097,"_26932":53167,"_2867":53310},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_3381":1645,"_29612":1591,"_20544":53312,"_5":14097,"_26932":53171,"_2867":53313},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_3381":1646,"_29612":1591,"_20544":53315,"_5":14097,"_26932":53171,"_2867":53316},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_3381":1647,"_29612":1591,"_20544":53318,"_5":14097,"_26932":53175,"_2867":53319},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_3381":1648,"_29612":1591,"_20544":53321,"_5":14097,"_26932":53175,"_2867":53322},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_3381":1649,"_29612":1591,"_20544":53324,"_5":14097,"_26932":53175,"_2867":53325},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_3381":1650,"_29612":1591,"_20544":53327,"_5":14097,"_26932":53175,"_2867":53328},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_3381":1651,"_29612":1591,"_20544":53330,"_5":14097,"_26932":53175,"_2867":53331},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_3381":1652,"_29612":1591,"_20544":53333,"_5":14097,"_26932":53179,"_2867":53334},[],"Check",{"_3381":1653,"_29612":1591,"_20544":53336,"_5":14097,"_26932":53179,"_2867":53337},[],"Expected result",{"_3381":1654,"_29612":1591,"_20544":53339,"_5":14097,"_26932":53179,"_2867":53340},[],"Registration",{"_3381":1655,"_29612":1591,"_20544":53342,"_5":14097,"_26932":53179,"_2867":53343},[],"ID created automatically and correct DMS.",{"_3381":1656,"_29612":1591,"_20544":53345,"_5":14097,"_26932":53179,"_2867":52598},[],{"_3381":1657,"_29612":1591,"_20544":53347,"_5":14097,"_26932":53179,"_2867":53348},[],"CN, profile, serial and key verified.",{"_3381":1658,"_29612":1591,"_20544":53350,"_5":14097,"_26932":53179,"_2867":53351},[],"Inventory",{"_3381":1659,"_29612":1591,"_20544":53353,"_5":14097,"_26932":53179,"_2867":53354},[],"Received serial visible as the current identity and in history.",{"_3381":1660,"_29612":1591,"_20544":53356,"_5":14097,"_26932":53179,"_2867":53357},[],"Consumer",{"_3381":1661,"_29612":1591,"_20544":53359,"_5":14097,"_26932":53179,"_2867":53360},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_3381":1662,"_29612":1591,"_20544":53362,"_5":14097,"_26932":53179,"_2867":53363},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_3381":1663,"_29612":1591,"_20544":53365,"_5":14097,"_26932":53179,"_2867":53366},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_3381":1664,"_29612":1664,"_5":14455,"_2867":50726,"_29965":53368,"_20544":53369,"_26932":1664},[48231,49699,50710,53145],[],{"_3381":1665,"_29612":1664,"_20544":53371,"_5":14097,"_26932":1664,"_2867":53372},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_3381":1666,"_29612":1664,"_5":29962,"_20544":53374,"_26932":53375,"_2867":48241},[],"/docs/pr-preview/pr-53/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_3381":1667,"_29612":1664,"_5":29962,"_20544":53377,"_26932":53378,"_2867":53379},[],"/docs/pr-preview/pr-53/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_3381":1668,"_29612":1664,"_5":29962,"_20544":53381,"_26932":53382,"_2867":53383},[],"/docs/pr-preview/pr-53/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_3381":1669,"_29612":1664,"_5":29962,"_20544":53385,"_26932":53386,"_2867":53387},[],"/docs/pr-preview/pr-53/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_3381":1670,"_29612":1664,"_5":29962,"_20544":53389,"_26932":53390,"_2867":53391},[],"/docs/pr-preview/pr-53/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_3381":1671,"_29612":1664,"_5":29962,"_20544":53393,"_26932":53394,"_2867":53395},[],"/docs/pr-preview/pr-53/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_3381":1672,"_29612":1664,"_5":29962,"_20544":53397,"_26932":53398,"_2867":53337},[],"/docs/pr-preview/pr-53/platform/iot-fleets/quickstarts/register-device#expected-result",{"_3381":1673,"_29612":1664,"_5":29962,"_20544":53400,"_26932":53401,"_2867":53402},[],"/docs/pr-preview/pr-53/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_3381":1674,"_29612":1664,"_5":29962,"_20544":53404,"_26932":53405,"_2867":53406},[],"/docs/pr-preview/pr-53/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_3381":1675,"_29612":1664,"_20544":53408,"_5":14097,"_26932":1664,"_2867":53409},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_3381":1676,"_29612":1664,"_20544":53411,"_5":14097,"_26932":1664,"_2867":53412},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_3381":1677,"_29612":1664,"_20544":53414,"_5":14097,"_26932":53375,"_2867":53415},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_3381":1678,"_29612":1664,"_20544":53417,"_5":14097,"_26932":53375,"_2867":53418},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_3381":1679,"_29612":1664,"_20544":53420,"_5":14097,"_26932":53375,"_2867":53421},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_3381":1680,"_29612":1664,"_20544":53423,"_5":14097,"_26932":53375,"_2867":53424},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_3381":1681,"_29612":1664,"_20544":53426,"_5":14097,"_26932":53378,"_2867":53427},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_3381":1682,"_29612":1664,"_20544":53429,"_5":14097,"_26932":53378,"_2867":53430},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_3381":1683,"_29612":1664,"_20544":53432,"_5":14097,"_26932":53378,"_2867":53433},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_3381":1684,"_29612":1664,"_20544":53435,"_5":14097,"_26932":53378,"_2867":53436},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_3381":1685,"_29612":1664,"_20544":53438,"_5":14097,"_26932":53378,"_2867":53439},[],"In the authentication section, enable **Require client certificate** and leave **Call external webhook** off. Under **Require client certificate**, add the CA whose initial certificates you will accept to **Validation CAs**; for this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and leave **Enable server-side key generation** off if you will not use it.",{"_3381":1686,"_29612":1664,"_20544":53441,"_5":14097,"_26932":53378,"_2867":53442},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_3381":1687,"_29612":1664,"_20544":53444,"_5":14097,"_26932":53378,"_2867":53445},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_3381":1688,"_29612":1664,"_20544":53447,"_5":14097,"_26932":53378,"_2867":53448},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_3381":1689,"_29612":1664,"_20544":53450,"_5":14097,"_26932":53382,"_2867":53451},[],"Open **Managed Devices** and the registration action. Complete:",{"_3381":1690,"_29612":1664,"_20544":53453,"_5":14097,"_26932":53382,"_2867":53454},[],"**Device ID**: `device-001`.",{"_3381":1691,"_29612":1664,"_20544":53456,"_5":14097,"_26932":53382,"_2867":53457},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_3381":1692,"_29612":1664,"_20544":53459,"_5":14097,"_26932":53382,"_2867":53460},[],"**Icon** and **Tags**: optional classification.",{"_3381":1693,"_29612":1664,"_20544":53462,"_5":14097,"_26932":53382,"_2867":53463},[],"Confirm registration.",{"_3381":1694,"_29612":1664,"_20544":53465,"_5":14097,"_26932":53386,"_2867":53466},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_3381":1695,"_29612":1664,"_20544":53468,"_5":14097,"_26932":53386,"_2867":53469},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_3381":1696,"_29612":1664,"_20544":53471,"_5":14097,"_26932":53390,"_2867":53472},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_3381":1697,"_29612":1664,"_20544":53474,"_5":14097,"_26932":53390,"_2867":53475},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_3381":1698,"_29612":1664,"_20544":53477,"_5":14097,"_26932":53394,"_2867":53478},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_3381":1699,"_29612":1664,"_20544":53480,"_5":14097,"_26932":53394,"_2867":53481},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_3381":1700,"_29612":1664,"_20544":53483,"_5":14097,"_26932":53398,"_2867":53334},[],{"_3381":1701,"_29612":1664,"_20544":53485,"_5":14097,"_26932":53398,"_2867":53486},[],"Result",{"_3381":1702,"_29612":1664,"_20544":53488,"_5":14097,"_26932":53398,"_2867":52581},[],{"_3381":1703,"_29612":1664,"_20544":53490,"_5":14097,"_26932":53398,"_2867":53491},[],"`device-001` appears in inventory with the expected DMS.",{"_3381":1704,"_29612":1664,"_20544":53493,"_5":14097,"_26932":53398,"_2867":53494},[],"Current identity",{"_3381":1705,"_29612":1664,"_20544":53496,"_5":14097,"_26932":53398,"_2867":53497},[],"The associated certificate matches the one you verified in PKI.",{"_3381":1706,"_29612":1664,"_20544":53499,"_5":14097,"_26932":53398,"_2867":53500},[],"History",{"_3381":1707,"_29612":1664,"_20544":53502,"_5":14097,"_26932":53398,"_2867":53503},[],"The associated issuance appears with its serial number and dates.",{"_3381":1708,"_29612":1664,"_20544":53505,"_5":14097,"_26932":53398,"_2867":53506},[],"Key and certificate",{"_3381":1709,"_29612":1664,"_20544":53508,"_5":14097,"_26932":53398,"_2867":53509},[],"You have the verified pair ready to install on the device.",{"_3381":1710,"_29612":1664,"_20544":53511,"_5":14097,"_26932":53401,"_2867":53512},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_3381":1711,"_29612":1664,"_20544":53514,"_5":14097,"_26932":53401,"_2867":53515},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_3381":1712,"_29612":1664,"_20544":53517,"_5":14097,"_26932":53401,"_2867":53518},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_3381":1713,"_29612":1664,"_20544":53520,"_5":14097,"_26932":53401,"_2867":53521},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_3381":1714,"_29612":1664,"_20544":53523,"_5":14097,"_26932":53405,"_2867":53524},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_3381":1715,"_29612":1664,"_20544":53526,"_5":14097,"_26932":53405,"_2867":53527},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_3381":1716,"_29612":1664,"_20544":53529,"_5":14097,"_26932":53405,"_2867":53530},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_3381":1717,"_29612":1717,"_5":14455,"_2867":53532,"_29965":53533,"_20544":53534,"_26932":1717},"Lamassu IoT Platform",[48231,49699],[],{"_3381":1718,"_29612":1717,"_20544":53536,"_5":14097,"_26932":1717,"_2867":53537},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_3381":1719,"_29612":1717,"_5":29962,"_20544":53539,"_26932":53540,"_2867":53020},[],"/docs/pr-preview/pr-53/platform/overview#start-here",{"_3381":1720,"_29612":1717,"_5":29962,"_20544":53542,"_26932":53543,"_2867":53544},[],"/docs/pr-preview/pr-53/platform/overview#choose-your-path","Choose your path",{"_3381":1721,"_29612":1717,"_5":29962,"_20544":53546,"_26932":53547,"_2867":53548},[],"/docs/pr-preview/pr-53/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_3381":1722,"_29612":1717,"_5":29962,"_20544":53550,"_26932":53551,"_2867":53552},[],"/docs/pr-preview/pr-53/platform/overview#core-capabilities","Core capabilities",{"_3381":1723,"_29612":1717,"_5":29962,"_20544":53554,"_26932":53555,"_2867":53556},[],"/docs/pr-preview/pr-53/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_3381":1724,"_29612":1717,"_5":29962,"_20544":53558,"_26932":53559,"_2867":53560},[],"/docs/pr-preview/pr-53/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_3381":1725,"_29612":1717,"_5":29962,"_20544":53562,"_26932":53563,"_2867":53564},[],"/docs/pr-preview/pr-53/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_3381":1726,"_29612":1717,"_5":29962,"_20544":53566,"_26932":53567,"_2867":53568},[],"/docs/pr-preview/pr-53/platform/overview#automate-device-identities","Automate device identities",{"_3381":1727,"_29612":1717,"_5":29962,"_20544":53570,"_26932":53571,"_2867":53572},[],"/docs/pr-preview/pr-53/platform/overview#publish-validation-status","Publish validation status",{"_3381":1728,"_29612":1717,"_5":29962,"_20544":53574,"_26932":53575,"_2867":53576},[],"/docs/pr-preview/pr-53/platform/overview#react-to-events","React to events",{"_3381":1729,"_29612":1717,"_5":29962,"_20544":53578,"_26932":53579,"_2867":53580},[],"/docs/pr-preview/pr-53/platform/overview#operational-reference","Operational reference",{"_3381":1730,"_29612":1717,"_20544":53582,"_5":14097,"_26932":1717,"_2867":53583},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_3381":1731,"_29612":1717,"_20544":53585,"_5":14097,"_26932":53540,"_2867":53586},[],"Choose the result you need:",{"_3381":1732,"_29612":1717,"_20544":53588,"_5":14097,"_26932":53540,"_2867":53589},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3381":1733,"_29612":1717,"_20544":53591,"_5":14097,"_26932":53540,"_2867":53592},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3381":1734,"_29612":1717,"_20544":53594,"_5":14097,"_26932":53540,"_2867":53595},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_3381":1735,"_29612":1717,"_20544":53597,"_5":14097,"_26932":53543,"_2867":53598},[],"Section",{"_3381":1736,"_29612":1717,"_20544":53600,"_5":14097,"_26932":53543,"_2867":53601},[],"What you manage",{"_3381":1737,"_29612":1717,"_20544":53603,"_5":14097,"_26932":53543,"_2867":53604},[],"Entry point",{"_3381":1738,"_29612":1717,"_20544":53606,"_5":14097,"_26932":53543,"_2867":53607},[],"**PKI**",{"_3381":1739,"_29612":1717,"_20544":53609,"_5":14097,"_26932":53543,"_2867":53610},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_3381":1740,"_29612":1717,"_20544":53612,"_5":14097,"_26932":53543,"_2867":53613},[],"PKI overview",{"_3381":1741,"_29612":1717,"_20544":53615,"_5":14097,"_26932":53543,"_2867":53616},[],"**IoT Fleets**",{"_3381":1742,"_29612":1717,"_20544":53618,"_5":14097,"_26932":53543,"_2867":53619},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_3381":1743,"_29612":1717,"_20544":53621,"_5":14097,"_26932":53543,"_2867":53622},[],"IoT Fleets overview",{"_3381":1744,"_29612":1717,"_20544":53624,"_5":14097,"_26932":53543,"_2867":53625},[],"**Administration**",{"_3381":1745,"_29612":1717,"_20544":53627,"_5":14097,"_26932":53543,"_2867":53628},[],"Operator permissions, audit and event subscriptions.",{"_3381":1746,"_29612":1717,"_20544":53630,"_5":14097,"_26932":53543,"_2867":49697},[],{"_3381":1747,"_29612":1717,"_20544":53632,"_5":14097,"_26932":53543,"_2867":53633},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_3381":1748,"_29612":1717,"_20544":53635,"_5":14097,"_26932":53547,"_2867":53636},[],"An identity's journey connects four responsibilities:",{"_3381":1749,"_29612":1717,"_20544":53638,"_5":14097,"_26932":53547,"_2867":53639},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_3381":1750,"_29612":1717,"_20544":53641,"_5":14097,"_26932":53547,"_2867":53642},[],"The provisioning administrator configures the DMS and initial trust.",{"_3381":1751,"_29612":1717,"_20544":53644,"_5":14097,"_26932":53547,"_2867":53645},[],"The device client requests a certificate and installs it with the matching key.",{"_3381":1752,"_29612":1717,"_20544":53647,"_5":14097,"_26932":53547,"_2867":53648},[],"The consumer validates the identity and applies its access permissions.",{"_3381":1753,"_29612":1717,"_20544":53650,"_5":14097,"_26932":53547,"_2867":53651},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_3381":1754,"_29612":1717,"_20544":53653,"_5":14097,"_26932":53555,"_2867":53654},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_3381":1755,"_29612":1717,"_20544":53656,"_5":14097,"_26932":53559,"_2867":53657},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_3381":1756,"_29612":1717,"_20544":53659,"_5":14097,"_26932":53563,"_2867":53660},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_3381":1757,"_29612":1717,"_20544":53662,"_5":14097,"_26932":53567,"_2867":53663},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_3381":1758,"_29612":1717,"_20544":53665,"_5":14097,"_26932":53571,"_2867":53666},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_3381":1759,"_29612":1717,"_20544":53668,"_5":14097,"_26932":53575,"_2867":53669},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_3381":1760,"_29612":1717,"_20544":53671,"_5":14097,"_26932":53579,"_2867":53114},[],{"_3381":1761,"_29612":1717,"_20544":53673,"_5":14097,"_26932":53579,"_2867":53674},[],"What it prepares or checks",{"_3381":1762,"_29612":1717,"_20544":53676,"_5":14097,"_26932":53579,"_2867":53117},[],{"_3381":1763,"_29612":1717,"_20544":53678,"_5":14097,"_26932":53579,"_2867":53679},[],"Key custody, CA hierarchy, profiles and validation.",{"_3381":1764,"_29612":1717,"_20544":53681,"_5":14097,"_26932":53579,"_2867":53682},[],"Fleet administrator",{"_3381":1765,"_29612":1717,"_20544":53684,"_5":14097,"_26932":53579,"_2867":53685},[],"DMS, device admission, renewal policy and inventory.",{"_3381":1766,"_29612":1717,"_20544":53687,"_5":14097,"_26932":53579,"_2867":53129},[],{"_3381":1767,"_29612":1717,"_20544":53689,"_5":14097,"_26932":53579,"_2867":53690},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_3381":1768,"_29612":1717,"_20544":53692,"_5":14097,"_26932":53579,"_2867":53135},[],{"_3381":1769,"_29612":1717,"_20544":53694,"_5":14097,"_26932":53579,"_2867":53695},[],"Issuer trust, certificate validation and permissions in the destination.",{"_3381":1770,"_29612":1717,"_20544":53697,"_5":14097,"_26932":53579,"_2867":53698},[],"Infrastructure operator",{"_3381":1771,"_29612":1717,"_20544":53700,"_5":14097,"_26932":53579,"_2867":53701},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_3381":1772,"_29612":1717,"_20544":53703,"_5":14097,"_26932":53579,"_2867":53704},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_3381":1773,"_29612":1773,"_5":14455,"_2867":53706,"_29965":53707,"_20544":53710,"_26932":1773},"CA hierarchy and rotation",[48231,49699,53708,53709],"PKI","Keys, authorities and certificates",[],{"_3381":1774,"_29612":1773,"_20544":53712,"_5":14097,"_26932":1773,"_2867":53713},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_3381":1775,"_29612":1773,"_5":29962,"_20544":53715,"_26932":53716,"_2867":53717},[],"/docs/pr-preview/pr-53/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_3381":1776,"_29612":1773,"_5":29962,"_20544":53719,"_26932":53720,"_2867":53721},[],"/docs/pr-preview/pr-53/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_3381":1777,"_29612":1773,"_5":29962,"_20544":53723,"_26932":53724,"_2867":53725},[],"/docs/pr-preview/pr-53/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_3381":1778,"_29612":1773,"_5":29962,"_20544":53727,"_26932":53728,"_2867":53729},[],"/docs/pr-preview/pr-53/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_3381":1779,"_29612":1773,"_5":29962,"_20544":53731,"_26932":53732,"_2867":53733},[],"/docs/pr-preview/pr-53/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_3381":1780,"_29612":1773,"_5":29962,"_20544":53735,"_26932":53736,"_2867":53737},[],"/docs/pr-preview/pr-53/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_3381":1781,"_29612":1773,"_5":29962,"_20544":53739,"_26932":53740,"_2867":53741},[],"/docs/pr-preview/pr-53/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_3381":1782,"_29612":1773,"_5":29962,"_20544":53743,"_26932":53744,"_2867":53745},[],"/docs/pr-preview/pr-53/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_3381":1783,"_29612":1773,"_5":29962,"_20544":53747,"_26932":53748,"_2867":53749},[],"/docs/pr-preview/pr-53/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_3381":1784,"_29612":1773,"_5":29962,"_20544":53751,"_26932":53752,"_2867":53753},[],"/docs/pr-preview/pr-53/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_3381":1785,"_29612":1773,"_5":29962,"_20544":53755,"_26932":53756,"_2867":53757},[],"/docs/pr-preview/pr-53/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_3381":1786,"_29612":1773,"_5":29962,"_20544":53759,"_26932":53760,"_2867":53761},[],"/docs/pr-preview/pr-53/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_3381":1787,"_29612":1773,"_20544":53763,"_5":14097,"_26932":1773,"_2867":53764},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_3381":1788,"_29612":1773,"_20544":53766,"_5":14097,"_26932":1773,"_2867":53767},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_3381":1789,"_29612":1773,"_20544":53769,"_5":14097,"_26932":53716,"_2867":53770},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_3381":1790,"_29612":1773,"_20544":53772,"_5":14097,"_26932":53716,"_2867":53773},[],"environment, such as production and preproduction;",{"_3381":1791,"_29612":1773,"_20544":53775,"_5":14097,"_26932":53716,"_2867":53776},[],"owner or operating team;",{"_3381":1792,"_29612":1773,"_20544":53778,"_5":14097,"_26932":53716,"_2867":53779},[],"device family or manufacturing process;",{"_3381":1793,"_29612":1773,"_20544":53781,"_5":14097,"_26932":53716,"_2867":53782},[],"region or regulatory requirement;",{"_3381":1794,"_29612":1773,"_20544":53784,"_5":14097,"_26932":53716,"_2867":53785},[],"cryptographic engine or key policy;",{"_3381":1795,"_29612":1773,"_20544":53787,"_5":14097,"_26932":53716,"_2867":53788},[],"maintenance window and renewal cadence.",{"_3381":1796,"_29612":1773,"_20544":53790,"_5":14097,"_26932":53716,"_2867":53791},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_3381":1797,"_29612":1773,"_20544":53793,"_5":14097,"_26932":53716,"_2867":53794},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_3381":1798,"_29612":1773,"_20544":53796,"_5":14097,"_26932":53720,"_2867":53797},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_3381":1799,"_29612":1773,"_20544":53799,"_5":14097,"_26932":53720,"_2867":53800},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_3381":1800,"_29612":1773,"_20544":53802,"_5":14097,"_26932":53720,"_2867":53803},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_3381":1801,"_29612":1773,"_20544":53805,"_5":14097,"_26932":53724,"_2867":53806},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_3381":1802,"_29612":1773,"_20544":53808,"_5":14097,"_26932":53724,"_2867":53809},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_3381":1803,"_29612":1773,"_20544":53811,"_5":14097,"_26932":53724,"_2867":53812},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_3381":1804,"_29612":1773,"_20544":53814,"_5":14097,"_26932":53724,"_2867":53815},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_3381":1805,"_29612":1773,"_20544":53817,"_5":14097,"_26932":53732,"_2867":53818},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_3381":1806,"_29612":1773,"_20544":53820,"_5":14097,"_26932":53736,"_2867":53821},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_3381":1807,"_29612":1773,"_20544":53823,"_5":14097,"_26932":53740,"_2867":53824},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_3381":1808,"_29612":1773,"_20544":53826,"_5":14097,"_26932":53744,"_2867":53827},[],"Update the enrollment CA and profile of the DMSs. While old-CA cohorts still renew, add the previous enrollment CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`): the new enrollment CA is trusted automatically, but the old one was the enrollment CA and appears in no re-enrollment trust list, so without that entry its certificates can no longer renew. The DMS guide documents the setting.",{"_3381":1809,"_29612":1773,"_20544":53829,"_5":14097,"_26932":53748,"_2867":53830},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_3381":1810,"_29612":1773,"_20544":53832,"_5":14097,"_26932":53752,"_2867":53833},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance, from the re-enrollment validation CAs and from the distributed CAs. Revoke it if policy requires it.",{"_3381":1811,"_29612":1773,"_20544":53835,"_5":14097,"_26932":53756,"_2867":53836},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_3381":1812,"_29612":1773,"_20544":53838,"_5":14097,"_26932":53756,"_2867":53839},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_3381":1813,"_29612":1773,"_20544":53841,"_5":14097,"_26932":53756,"_2867":53842},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_3381":1814,"_29612":1773,"_20544":53844,"_5":14097,"_26932":53756,"_2867":53845},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_3381":1815,"_29612":1773,"_20544":53847,"_5":14097,"_26932":53760,"_2867":53848},[],"The new chain ends in an anchor installed by the consumer.",{"_3381":1816,"_29612":1773,"_20544":53850,"_5":14097,"_26932":53760,"_2867":53851},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_3381":1817,"_29612":1773,"_20544":53853,"_5":14097,"_26932":53760,"_2867":53854},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_3381":1818,"_29612":1773,"_20544":53856,"_5":14097,"_26932":53760,"_2867":53857},[],"Re-enrollment accepts the old identity during the planned period.",{"_3381":1819,"_29612":1773,"_20544":53859,"_5":14097,"_26932":53760,"_2867":53860},[],"OCSP and CRL respond for the authorities that remain active.",{"_3381":1820,"_29612":1773,"_20544":53862,"_5":14097,"_26932":53760,"_2867":53863},[],"No DMS is left accidentally issuing from the old CA.",{"_3381":1821,"_29612":1773,"_20544":53865,"_5":14097,"_26932":53760,"_2867":53866},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_3381":1822,"_29612":1822,"_5":14455,"_2867":53868,"_29965":53869,"_20544":53870,"_26932":1822},"Certification authorities",[48231,49699,53708,53709],[],{"_3381":1823,"_29612":1822,"_20544":53872,"_5":14097,"_26932":1822,"_2867":53873},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_3381":1824,"_29612":1822,"_5":29962,"_20544":53875,"_26932":53876,"_2867":53877},[],"/docs/pr-preview/pr-53/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_3381":1825,"_29612":1822,"_5":29962,"_20544":53879,"_26932":53880,"_2867":53881},[],"/docs/pr-preview/pr-53/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_3381":1826,"_29612":1822,"_5":29962,"_20544":53883,"_26932":53884,"_2867":48241},[],"/docs/pr-preview/pr-53/platform/pki/certificate-authorities#before-you-begin",{"_3381":1827,"_29612":1822,"_5":29962,"_20544":53886,"_26932":53887,"_2867":53888},[],"/docs/pr-preview/pr-53/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_3381":1828,"_29612":1822,"_5":29962,"_20544":53890,"_26932":53891,"_2867":53892},[],"/docs/pr-preview/pr-53/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_3381":1829,"_29612":1822,"_5":29962,"_20544":53894,"_26932":53895,"_2867":53896},[],"/docs/pr-preview/pr-53/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_3381":1830,"_29612":1822,"_5":29962,"_20544":53898,"_26932":53899,"_2867":53900},[],"/docs/pr-preview/pr-53/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_3381":1831,"_29612":1822,"_5":29962,"_20544":53902,"_26932":53903,"_2867":53904},[],"/docs/pr-preview/pr-53/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_3381":1832,"_29612":1822,"_5":29962,"_20544":53906,"_26932":53907,"_2867":53908},[],"/docs/pr-preview/pr-53/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_3381":1833,"_29612":1822,"_5":29962,"_20544":53910,"_26932":53911,"_2867":53912},[],"/docs/pr-preview/pr-53/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_3381":1834,"_29612":1822,"_5":29962,"_20544":53914,"_26932":53915,"_2867":53916},[],"/docs/pr-preview/pr-53/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_3381":1835,"_29612":1822,"_5":29962,"_20544":53918,"_26932":53919,"_2867":53920},[],"/docs/pr-preview/pr-53/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_3381":1836,"_29612":1822,"_5":29962,"_20544":53922,"_26932":53923,"_2867":53924},[],"/docs/pr-preview/pr-53/platform/pki/certificate-authorities#load-the-material","Load the material",{"_3381":1837,"_29612":1822,"_5":29962,"_20544":53926,"_26932":53927,"_2867":53928},[],"/docs/pr-preview/pr-53/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_3381":1838,"_29612":1822,"_5":29962,"_20544":53930,"_26932":53931,"_2867":53932},[],"/docs/pr-preview/pr-53/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_3381":1839,"_29612":1822,"_5":29962,"_20544":53934,"_26932":53935,"_2867":53936},[],"/docs/pr-preview/pr-53/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_3381":1840,"_29612":1822,"_5":29962,"_20544":53938,"_26932":53939,"_2867":53940},[],"/docs/pr-preview/pr-53/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_3381":1841,"_29612":1822,"_5":29962,"_20544":53942,"_26932":53943,"_2867":53944},[],"/docs/pr-preview/pr-53/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_3381":1842,"_29612":1822,"_5":29962,"_20544":53946,"_26932":53947,"_2867":53948},[],"/docs/pr-preview/pr-53/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_3381":1843,"_29612":1822,"_5":29962,"_20544":53950,"_26932":53951,"_2867":53952},[],"/docs/pr-preview/pr-53/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_3381":1844,"_29612":1822,"_5":29962,"_20544":53954,"_26932":53955,"_2867":53956},[],"/docs/pr-preview/pr-53/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_3381":1845,"_29612":1822,"_5":29962,"_20544":53958,"_26932":53959,"_2867":53960},[],"/docs/pr-preview/pr-53/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_3381":1846,"_29612":1822,"_5":29962,"_20544":53962,"_26932":53963,"_2867":53964},[],"/docs/pr-preview/pr-53/platform/pki/certificate-authorities#delete-a-ca","Delete a CA",{"_3381":1847,"_29612":1822,"_20544":53966,"_5":14097,"_26932":1822,"_2867":53967},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_3381":1848,"_29612":1822,"_20544":53969,"_5":14097,"_26932":1822,"_2867":53970},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_3381":1849,"_29612":1822,"_20544":53972,"_5":14097,"_26932":1822,"_2867":53973},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_3381":1850,"_29612":1822,"_20544":53975,"_5":14097,"_26932":53876,"_2867":53976},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_3381":1851,"_29612":1822,"_20544":53978,"_5":14097,"_26932":53876,"_2867":53979},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_3381":1852,"_29612":1822,"_20544":53981,"_5":14097,"_26932":53876,"_2867":53982},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_3381":1853,"_29612":1822,"_20544":53984,"_5":14097,"_26932":53876,"_2867":53985},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_3381":1854,"_29612":1822,"_20544":53987,"_5":14097,"_26932":53876,"_2867":53988},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_3381":1855,"_29612":1822,"_20544":53990,"_5":14097,"_26932":53884,"_2867":53991},[],"Decide whether the CA will be a root or an intermediate.",{"_3381":1856,"_29612":1822,"_20544":53993,"_5":14097,"_26932":53884,"_2867":53994},[],"Choose the engine that will keep the key.",{"_3381":1857,"_29612":1822,"_20544":53996,"_5":14097,"_26932":53884,"_2867":53997},[],"Define a validity longer than that of the certificates it will issue.",{"_3381":1858,"_29612":1822,"_20544":53999,"_5":14097,"_26932":53884,"_2867":54000},[],"For an intermediate CA, make sure the parent CA is active.",{"_3381":1859,"_29612":1822,"_20544":54002,"_5":14097,"_26932":53887,"_2867":54003},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_3381":1860,"_29612":1822,"_20544":54005,"_5":14097,"_26932":53891,"_2867":54006},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_3381":1861,"_29612":1822,"_20544":54008,"_5":14097,"_26932":53891,"_2867":54009},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_3381":1862,"_29612":1822,"_20544":54011,"_5":14097,"_26932":53895,"_2867":54012},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_3381":1863,"_29612":1822,"_20544":54014,"_5":14097,"_26932":53899,"_2867":54015},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_3381":1864,"_29612":1822,"_20544":54017,"_5":14097,"_26932":53899,"_2867":54018},[],"`C`: two-letter ISO 3166-1 country code.",{"_3381":1865,"_29612":1822,"_20544":54020,"_5":14097,"_26932":53899,"_2867":54021},[],"`ST`: state or province.",{"_3381":1866,"_29612":1822,"_20544":54023,"_5":14097,"_26932":53899,"_2867":54024},[],"`L`: locality.",{"_3381":1867,"_29612":1822,"_20544":54026,"_5":14097,"_26932":53899,"_2867":54027},[],"`O`: organization.",{"_3381":1868,"_29612":1822,"_20544":54029,"_5":14097,"_26932":53899,"_2867":54030},[],"`OU`: organizational unit.",{"_3381":1869,"_29612":1822,"_20544":54032,"_5":14097,"_26932":53899,"_2867":54033},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_3381":1870,"_29612":1822,"_20544":54035,"_5":14097,"_26932":53903,"_2867":54036},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_3381":1871,"_29612":1822,"_20544":54038,"_5":14097,"_26932":53903,"_2867":54039},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_3381":1872,"_29612":1822,"_20544":54041,"_5":14097,"_26932":53907,"_2867":54042},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_3381":1873,"_29612":1822,"_20544":54044,"_5":14097,"_26932":53907,"_2867":54045},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_3381":1874,"_29612":1822,"_20544":54047,"_5":14097,"_26932":53911,"_2867":54048},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_3381":1875,"_29612":1822,"_20544":54050,"_5":14097,"_26932":53911,"_2867":54051},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_3381":1876,"_29612":1822,"_20544":54053,"_5":14097,"_26932":53915,"_2867":54054},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages (including `cRLSign`, without which the CA cannot publish its CRL) and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_3381":1877,"_29612":1822,"_20544":54056,"_5":14097,"_26932":53915,"_2867":54057},[],"The backend rejects an import whose certificate lacks the CA basic constraint (`basicConstraints cA flag is not set`), whose serial number matches a stored certificate with different contents, or whose identical certificate already belongs to an existing CA. A deleted CA's certificate record is kept and can be reused when re-importing the same certificate, including its previous status. Re-importing a different certificate with that serial number is rejected; check the certificate and status after re-importing.",{"_3381":1878,"_29612":1822,"_20544":54059,"_5":14097,"_26932":53915,"_2867":54060},[],"Deleting a CA releases the key references of its own current certificate and linked reissued certificates, while keeping those records for its issuer's CRL and OCSP. It then attempts to delete the key; the KMS keeps it if other certificates still reference it, such as another CA sharing the key. Revoking certificates issued by the deleted CA does not release their own key references.",{"_3381":1879,"_29612":1822,"_20544":54062,"_5":14097,"_26932":53919,"_2867":54063},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_3381":1880,"_29612":1822,"_20544":54065,"_5":14097,"_26932":53923,"_2867":54066},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_3381":1881,"_29612":1822,"_20544":54068,"_5":14097,"_26932":53927,"_2867":54069},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_3381":1882,"_29612":1822,"_20544":54071,"_5":14097,"_26932":53931,"_2867":54072},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_3381":1883,"_29612":1822,"_20544":54074,"_5":14097,"_26932":53931,"_2867":54075},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_3381":1884,"_29612":1822,"_20544":54077,"_5":14097,"_26932":53935,"_2867":54078},[],"Open a CA from the inventory to review:",{"_3381":1885,"_29612":1822,"_20544":54080,"_5":14097,"_26932":53935,"_2867":54081},[],"Status and validity period.",{"_3381":1886,"_29612":1822,"_20544":54083,"_5":14097,"_26932":53935,"_2867":54084},[],"Certificate and chain in PEM format.",{"_3381":1887,"_29612":1822,"_20544":54086,"_5":14097,"_26932":53935,"_2867":54087},[],"Number of active, expired and revoked certificates.",{"_3381":1888,"_29612":1822,"_20544":54089,"_5":14097,"_26932":53935,"_2867":54090},[],"Certificates issued in **Issued Certificates**.",{"_3381":1889,"_29612":1822,"_20544":54092,"_5":14097,"_26932":53935,"_2867":54093},[],"The CRL linked to the authority.",{"_3381":1890,"_29612":1822,"_20544":54095,"_5":14097,"_26932":53935,"_2867":54096},[],"Metadata and the associated cryptographic engine.",{"_3381":1891,"_29612":1822,"_20544":54098,"_5":14097,"_26932":53935,"_2867":54099},[],"You can filter the inventory by name, status and CA type.",{"_3381":1892,"_29612":1822,"_20544":54101,"_5":14097,"_26932":53939,"_2867":54102},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_3381":1893,"_29612":1822,"_20544":54104,"_5":14097,"_26932":53939,"_2867":54105},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_3381":1894,"_29612":1822,"_20544":54107,"_5":14097,"_26932":53939,"_2867":54108},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_3381":1895,"_29612":1822,"_20544":54110,"_5":14097,"_26932":53939,"_2867":54111},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_3381":1896,"_29612":1822,"_20544":54113,"_5":14097,"_26932":53943,"_2867":54114},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_3381":1897,"_29612":1822,"_20544":54116,"_5":14097,"_26932":53947,"_2867":54117},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_3381":1898,"_29612":1822,"_20544":54119,"_5":14097,"_26932":53951,"_2867":54120},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_3381":1899,"_29612":1822,"_20544":54122,"_5":14097,"_26932":53955,"_2867":54123},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_3381":1900,"_29612":1822,"_20544":54125,"_5":14097,"_26932":53959,"_2867":54126},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_3381":1901,"_29612":1822,"_20544":54128,"_5":14097,"_26932":53963,"_2867":54129},[],"Permanent deletion is only available with the CA revoked or expired; a CA imported without a key can be deleted in any state. Delete the record only when your retention and audit policy allows it.",{"_3381":1902,"_29612":1822,"_20544":54131,"_5":14097,"_26932":53963,"_2867":54132},[],"The CA’s VA role is kept. If no other CA with the same SKI remains, it can no longer be edited (see CRL), so adjust its validity and signer beforehand. The CA’s key is released, but the KMS keeps it while other certificates still reference it.",{"_3381":1903,"_29612":1822,"_20544":54134,"_5":14097,"_26932":53963,"_2867":54135},[],"Lamassu keeps the certificate record of a deleted CA. If that same certificate is imported again, the import succeeds and reuses the record: it updates the type, issuer and key but keeps the status, so the CA reappears in the state it had when deleted (normally revoked or expired). A different certificate with the same serial number is rejected with a 400 error, and a certificate that already belongs to an existing CA with a 409 error. To avoid inheriting the previous status, use a certificate with a different serial number and check the result after importing. If the new certificate uses the same key, it shares the SKI with the retained VA role of the deleted CA, whose signer is the old certificate: check that the CRL is generated and, if it is not, use `PUT` to set a signer of the new CA (see CRL).",{"_3381":1904,"_29612":1904,"_5":14455,"_2867":54137,"_29965":54138,"_20544":54139,"_26932":1904},"Certificate profiles",[48231,49699,53708,53709],[],{"_3381":1905,"_29612":1904,"_20544":54141,"_5":14097,"_26932":1904,"_2867":54142},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_3381":1906,"_29612":1904,"_5":29962,"_20544":54144,"_26932":54145,"_2867":54146},[],"/docs/pr-preview/pr-53/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_3381":1907,"_29612":1904,"_5":29962,"_20544":54148,"_26932":54149,"_2867":54150},[],"/docs/pr-preview/pr-53/platform/pki/certificate-profiles#validity","Validity",{"_3381":1908,"_29612":1904,"_5":29962,"_20544":54152,"_26932":54153,"_2867":54154},[],"/docs/pr-preview/pr-53/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_3381":1909,"_29612":1904,"_5":29962,"_20544":54156,"_26932":54157,"_2867":54158},[],"/docs/pr-preview/pr-53/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_3381":1910,"_29612":1904,"_5":29962,"_20544":54160,"_26932":54161,"_2867":54162},[],"/docs/pr-preview/pr-53/platform/pki/certificate-profiles#subject","Subject",{"_3381":1911,"_29612":1904,"_5":29962,"_20544":54164,"_26932":54165,"_2867":54166},[],"/docs/pr-preview/pr-53/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_3381":1912,"_29612":1904,"_5":29962,"_20544":54168,"_26932":54169,"_2867":54170},[],"/docs/pr-preview/pr-53/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_3381":1913,"_29612":1904,"_5":29962,"_20544":54172,"_26932":54173,"_2867":54174},[],"/docs/pr-preview/pr-53/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_3381":1914,"_29612":1904,"_5":29962,"_20544":54176,"_26932":54177,"_2867":54178},[],"/docs/pr-preview/pr-53/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_3381":1915,"_29612":1904,"_5":29962,"_20544":54180,"_26932":54181,"_2867":54182},[],"/docs/pr-preview/pr-53/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_3381":1916,"_29612":1904,"_5":29962,"_20544":54184,"_26932":54185,"_2867":54186},[],"/docs/pr-preview/pr-53/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_3381":1917,"_29612":1904,"_5":29962,"_20544":54188,"_26932":54189,"_2867":54190},[],"/docs/pr-preview/pr-53/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_3381":1918,"_29612":1904,"_5":29962,"_20544":54192,"_26932":54193,"_2867":54194},[],"/docs/pr-preview/pr-53/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_3381":1919,"_29612":1904,"_5":29962,"_20544":54196,"_26932":54197,"_2867":54198},[],"/docs/pr-preview/pr-53/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_3381":1920,"_29612":1904,"_5":29962,"_20544":54200,"_26932":54201,"_2867":54202},[],"/docs/pr-preview/pr-53/platform/pki/certificate-profiles#design-examples","Design examples",{"_3381":1921,"_29612":1904,"_5":29962,"_20544":54204,"_26932":54205,"_2867":54206},[],"/docs/pr-preview/pr-53/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_3381":1922,"_29612":1904,"_20544":54208,"_5":14097,"_26932":1904,"_2867":54209},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_3381":1923,"_29612":1904,"_20544":54211,"_5":14097,"_26932":1904,"_2867":54212},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_3381":1924,"_29612":1904,"_20544":54214,"_5":14097,"_26932":54149,"_2867":54215},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_3381":1925,"_29612":1904,"_20544":54217,"_5":14097,"_26932":54149,"_2867":54218},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_3381":1926,"_29612":1904,"_20544":54220,"_5":14097,"_26932":54153,"_2867":54221},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Enable it only in profiles intended to create or reissue subordinate CAs.",{"_3381":1927,"_29612":1904,"_20544":54223,"_5":14097,"_26932":54157,"_2867":54224},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_3381":1928,"_29612":1904,"_20544":54226,"_5":14097,"_26932":54157,"_2867":54227},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_3381":1929,"_29612":1904,"_20544":54229,"_5":14097,"_26932":54157,"_2867":54230},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_3381":1930,"_29612":1904,"_20544":54232,"_5":14097,"_26932":54161,"_2867":54233},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_3381":1931,"_29612":1904,"_20544":54235,"_5":14097,"_26932":54165,"_2867":54236},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_3381":1932,"_29612":1904,"_20544":54238,"_5":14097,"_26932":54165,"_2867":54239},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_3381":1933,"_29612":1904,"_20544":54241,"_5":14097,"_26932":54169,"_2867":54242},[],"The cryptographic enforcement can:",{"_3381":1934,"_29612":1904,"_20544":54244,"_5":14097,"_26932":54169,"_2867":54245},[],"allow or block RSA keys;",{"_3381":1935,"_29612":1904,"_20544":54247,"_5":14097,"_26932":54169,"_2867":54248},[],"limit the supported RSA sizes;",{"_3381":1936,"_29612":1904,"_20544":54250,"_5":14097,"_26932":54169,"_2867":54251},[],"allow or block ECDSA keys;",{"_3381":1937,"_29612":1904,"_20544":54253,"_5":14097,"_26932":54169,"_2867":54254},[],"limit the supported ECDSA sizes or curves.",{"_3381":1938,"_29612":1904,"_20544":54256,"_5":14097,"_26932":54169,"_2867":54257},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_3381":1939,"_29612":1904,"_20544":54259,"_5":14097,"_26932":54173,"_2867":54260},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_3381":1940,"_29612":1904,"_20544":54262,"_5":14097,"_26932":54173,"_2867":51463},[],{"_3381":1941,"_29612":1904,"_20544":54264,"_5":14097,"_26932":54173,"_2867":54265},[],"First choice",{"_3381":1942,"_29612":1904,"_20544":54267,"_5":14097,"_26932":54173,"_2867":54268},[],"Second choice",{"_3381":1943,"_29612":1904,"_20544":54270,"_5":14097,"_26932":54173,"_2867":54271},[],"If neither is supplied",{"_3381":1944,"_29612":1904,"_20544":54273,"_5":14097,"_26932":54173,"_2867":54274},[],"Direct signing with a CA",{"_3381":1945,"_29612":1904,"_20544":54276,"_5":14097,"_26932":54173,"_2867":54277},[],"`issuance_profile` embedded in the request",{"_3381":1946,"_29612":1904,"_20544":54279,"_5":14097,"_26932":54173,"_2867":54280},[],"Request `issuance_profile_id`",{"_3381":1947,"_29612":1904,"_20544":54282,"_5":14097,"_26932":54173,"_2867":54283},[],"CA default profile (`profile_id`).",{"_3381":1948,"_29612":1904,"_20544":54285,"_5":14097,"_26932":54173,"_2867":54286},[],"Issuance through a DMS",{"_3381":1949,"_29612":1904,"_20544":54288,"_5":14097,"_26932":54173,"_2867":54289},[],"`settings.issuance_profile_id`",{"_3381":1950,"_29612":1904,"_20544":54291,"_5":14097,"_26932":54173,"_2867":54292},[],"`settings.issuance_profile` embedded in the DMS",{"_3381":1951,"_29612":1904,"_20544":54294,"_5":14097,"_26932":54173,"_2867":54295},[],"Enrollment CA default profile.",{"_3381":1952,"_29612":1904,"_20544":54297,"_5":14097,"_26932":54173,"_2867":54298},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_3381":1953,"_29612":1904,"_20544":54300,"_5":14097,"_26932":54173,"_2867":54301},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_3381":1954,"_29612":1904,"_20544":54303,"_5":14097,"_26932":54181,"_2867":54304},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_3381":1955,"_29612":1904,"_20544":54306,"_5":14097,"_26932":54185,"_2867":54307},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_3381":1956,"_29612":1904,"_20544":54309,"_5":14097,"_26932":54189,"_2867":54310},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_3381":1957,"_29612":1904,"_20544":54312,"_5":14097,"_26932":54193,"_2867":54313},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_3381":1958,"_29612":1904,"_20544":54315,"_5":14097,"_26932":54197,"_2867":54316},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_3381":1959,"_29612":1904,"_20544":54318,"_5":14097,"_26932":54197,"_2867":54319},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_3381":1960,"_29612":1904,"_20544":54321,"_5":14097,"_26932":54201,"_2867":54322},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_3381":1961,"_29612":1904,"_20544":54324,"_5":14097,"_26932":54201,"_2867":54325},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_3381":1962,"_29612":1904,"_20544":54327,"_5":14097,"_26932":54201,"_2867":54328},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_3381":1963,"_29612":1904,"_20544":54330,"_5":14097,"_26932":54201,"_2867":54331},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_3381":1964,"_29612":1904,"_20544":54333,"_5":14097,"_26932":54205,"_2867":54334},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_3381":1965,"_29612":1904,"_20544":54336,"_5":14097,"_26932":54205,"_2867":54337},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_3381":1966,"_29612":1966,"_5":14455,"_2867":54339,"_29965":54340,"_20544":54342,"_26932":1966},"Certificate validation",[48231,49699,53708,54341],"Validation",[],{"_3381":1967,"_29612":1966,"_20544":54344,"_5":14097,"_26932":1966,"_2867":54345},[],"Check chain, identity, purpose and revocation from the consumer.",{"_3381":1968,"_29612":1966,"_5":29962,"_20544":54347,"_26932":54348,"_2867":54349},[],"/docs/pr-preview/pr-53/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_3381":1969,"_29612":1966,"_5":29962,"_20544":54351,"_26932":54352,"_2867":54353},[],"/docs/pr-preview/pr-53/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_3381":1970,"_29612":1966,"_5":29962,"_20544":54355,"_26932":54356,"_2867":54357},[],"/docs/pr-preview/pr-53/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_3381":1971,"_29612":1966,"_20544":54359,"_5":14097,"_26932":1966,"_2867":54360},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_3381":1972,"_29612":1966,"_20544":54362,"_5":14097,"_26932":54348,"_2867":54363},[],"Verify these criteria together:",{"_3381":1973,"_29612":1966,"_20544":54365,"_5":14097,"_26932":54348,"_2867":53334},[],{"_3381":1974,"_29612":1966,"_20544":54367,"_5":14097,"_26932":54348,"_2867":54368},[],"Required result",{"_3381":1975,"_29612":1966,"_20544":54370,"_5":14097,"_26932":54348,"_2867":54371},[],"Chain and signature",{"_3381":1976,"_29612":1966,"_20544":54373,"_5":14097,"_26932":54348,"_2867":54374},[],"Valid chain to a root deliberately installed in the consumer.",{"_3381":1977,"_29612":1966,"_20544":54376,"_5":14097,"_26932":54348,"_2867":54377},[],"Dates",{"_3381":1978,"_29612":1966,"_20544":54379,"_5":14097,"_26932":54348,"_2867":54380},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_3381":1979,"_29612":1966,"_20544":54382,"_5":14097,"_26932":54348,"_2867":49368},[],{"_3381":1980,"_29612":1966,"_20544":54384,"_5":14097,"_26932":54348,"_2867":54385},[],"Name, SAN or identifier matches the expected peer.",{"_3381":1981,"_29612":1966,"_20544":54387,"_5":14097,"_26932":54348,"_2867":48621},[],{"_3381":1982,"_29612":1966,"_20544":54389,"_5":14097,"_26932":54348,"_2867":54390},[],"KU, EKU and constraints permit the specific operation.",{"_3381":1983,"_29612":1966,"_20544":54392,"_5":14097,"_26932":54348,"_2867":54393},[],"Revocation",{"_3381":1984,"_29612":1966,"_20544":54395,"_5":14097,"_26932":54348,"_2867":54396},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_3381":1985,"_29612":1966,"_20544":54398,"_5":14097,"_26932":54348,"_2867":54399},[],"Authorization",{"_3381":1986,"_29612":1966,"_20544":54401,"_5":14097,"_26932":54348,"_2867":54402},[],"The application permits that identity to perform the action.",{"_3381":1987,"_29612":1966,"_20544":54404,"_5":14097,"_26932":54348,"_2867":54405},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_3381":1988,"_29612":1966,"_20544":54407,"_5":14097,"_26932":54352,"_2867":54408},[],"Mechanism",{"_3381":1989,"_29612":1966,"_20544":54410,"_5":14097,"_26932":54352,"_2867":54411},[],"When to use it",{"_3381":1990,"_29612":1966,"_20544":54413,"_5":14097,"_26932":54352,"_2867":54414},[],"What you must maintain",{"_3381":1991,"_29612":1966,"_20544":54416,"_5":14097,"_26932":54352,"_2867":54417},[],"OCSP",{"_3381":1992,"_29612":1966,"_20544":54419,"_5":14097,"_26932":54352,"_2867":54420},[],"Status query for a specific certificate.",{"_3381":1993,"_29612":1966,"_20544":54422,"_5":14097,"_26932":54352,"_2867":54423},[],"Responder access, signature verification and cache/freshness policy.",{"_3381":1994,"_29612":1966,"_20544":54425,"_5":14097,"_26932":54352,"_2867":54426},[],"CRL",{"_3381":1995,"_29612":1966,"_20544":54428,"_5":14097,"_26932":54352,"_2867":54429},[],"Local checks for many certificates or offline operation.",{"_3381":1996,"_29612":1966,"_20544":54431,"_5":14097,"_26932":54352,"_2867":54432},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_3381":1997,"_29612":1966,"_20544":54434,"_5":14097,"_26932":54352,"_2867":54435},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_3381":1998,"_29612":1966,"_20544":54437,"_5":14097,"_26932":54352,"_2867":54438},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_3381":1999,"_29612":1966,"_20544":54440,"_5":14097,"_26932":54356,"_2867":54441},[],"Accept a current, authorized certificate with a known chain.",{"_3381":2000,"_29612":1966,"_20544":54443,"_5":14097,"_26932":54356,"_2867":54444},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_3381":2001,"_29612":1966,"_20544":54446,"_5":14097,"_26932":54356,"_2867":54447},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_3381":2002,"_29612":1966,"_20544":54449,"_5":14097,"_26932":54356,"_2867":54450},[],"Check that a new connection with that identity is rejected.",{"_3381":2003,"_29612":1966,"_20544":54452,"_5":14097,"_26932":54356,"_2867":54453},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_3381":2004,"_29612":1966,"_20544":54455,"_5":14097,"_26932":54356,"_2867":54456},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_3381":2005,"_29612":1966,"_20544":54458,"_5":14097,"_26932":54356,"_2867":54459},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_3381":2006,"_29612":1966,"_20544":54461,"_5":14097,"_26932":54356,"_2867":54462},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_3381":2007,"_29612":1966,"_20544":54464,"_5":14097,"_26932":54356,"_2867":54465},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_3381":2008,"_29612":2008,"_5":14455,"_2867":54467,"_29965":54468,"_20544":54469,"_26932":2008},"Certificates",[48231,49699,53708,53709],[],{"_3381":2009,"_29612":2008,"_20544":54471,"_5":14097,"_26932":2008,"_2867":54472},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_3381":2010,"_29612":2008,"_5":29962,"_20544":54474,"_26932":54475,"_2867":54476},[],"/docs/pr-preview/pr-53/platform/pki/certificates#find-a-certificate","Find a certificate",{"_3381":2011,"_29612":2008,"_5":29962,"_20544":54478,"_26932":54479,"_2867":54480},[],"/docs/pr-preview/pr-53/platform/pki/certificates#download-the-certificate","Download the certificate",{"_3381":2012,"_29612":2008,"_5":29962,"_20544":54482,"_26932":54483,"_2867":54484},[],"/docs/pr-preview/pr-53/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_3381":2013,"_29612":2008,"_5":29962,"_20544":54486,"_26932":54487,"_2867":54488},[],"/docs/pr-preview/pr-53/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_3381":2014,"_29612":2008,"_5":29962,"_20544":54490,"_26932":54491,"_2867":54492},[],"/docs/pr-preview/pr-53/platform/pki/certificates#open-the-action","Open the action",{"_3381":2015,"_29612":2008,"_5":29962,"_20544":54494,"_26932":54495,"_2867":54496},[],"/docs/pr-preview/pr-53/platform/pki/certificates#choose-a-reason","Choose a reason",{"_3381":2016,"_29612":2008,"_5":29962,"_20544":54498,"_26932":54499,"_2867":54500},[],"/docs/pr-preview/pr-53/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_3381":2017,"_29612":2008,"_5":29962,"_20544":54502,"_26932":54503,"_2867":54504},[],"/docs/pr-preview/pr-53/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_3381":2018,"_29612":2008,"_5":29962,"_20544":54506,"_26932":54507,"_2867":54508},[],"/docs/pr-preview/pr-53/platform/pki/certificates#continue","Continue",{"_3381":2019,"_29612":2008,"_20544":54510,"_5":14097,"_26932":2008,"_2867":54511},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_3381":2020,"_29612":2008,"_20544":54513,"_5":14097,"_26932":54475,"_2867":54514},[],"Filter by `Common Name`, serial, status and issuer. A certificate does not contain its private key, so the private-key surfaces answer which certificates have their key held in Lamassu's KMS:",{"_3381":2021,"_29612":2008,"_20544":54516,"_5":14097,"_26932":54475,"_2867":54517},[],"The advanced **Private Key** filter, available on the Certificates page and on a CA's **Issued Certificates** tab, narrows the list to **All Certificates**, **With Private Key** or **Without Private Key**.",{"_3381":2022,"_29612":2008,"_20544":54519,"_5":14097,"_26932":54475,"_2867":54520},[],"The sortable **Private Key** column — shown by default, hidden on narrow screens — marks a key held in the KMS with a green check mark and otherwise shows `-`.",{"_3381":2023,"_29612":2008,"_20544":54522,"_5":14097,"_26932":54475,"_2867":54523},[],"In certificate details, the **Information** tab shows a **Private Key** row in the **Key & Signature** section. When the certificate reports a private key and its KMS engine and key IDs are available, the row links to the key (tooltip: **Open private key in KMS**). Otherwise, it shows **Present** if the certificate reports a private key, or **Not available** if it does not. This does not establish whether a key exists outside Lamassu.",{"_3381":2024,"_29612":2008,"_20544":54525,"_5":14097,"_26932":54475,"_2867":54526},[],"Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_3381":2025,"_29612":2008,"_20544":54528,"_5":14097,"_26932":54475,"_2867":54529},[],"Certificate details include the key reference (`key_id`) and whether the private key is managed (`has_private_key`); certificate lists can be filtered on `has_private_key`.",{"_3381":2026,"_29612":2008,"_20544":54531,"_5":14097,"_26932":54475,"_2867":54532},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_3381":2027,"_29612":2008,"_20544":54534,"_5":14097,"_26932":54479,"_2867":54535},[],"Download the PEM and inspect it:",{"_3381":2028,"_29612":2008,"_20544":54537,"_5":14097,"_26932":54479,"_2867":54538},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_3381":2029,"_29612":2008,"_20544":54540,"_5":14097,"_26932":54483,"_2867":54541},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_3381":2030,"_29612":2008,"_20544":54543,"_5":14097,"_26932":54483,"_2867":54544},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_3381":2031,"_29612":2008,"_20544":54546,"_5":14097,"_26932":54483,"_2867":54547},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_3381":2032,"_29612":2008,"_20544":54549,"_5":14097,"_26932":54483,"_2867":54550},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_3381":2033,"_29612":2008,"_20544":54552,"_5":14097,"_26932":54483,"_2867":54553},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_3381":2034,"_29612":2008,"_20544":54555,"_5":14097,"_26932":54483,"_2867":54556},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_3381":2035,"_29612":2008,"_20544":54558,"_5":14097,"_26932":54483,"_2867":54559},[],"For browser key generation, follow Issue your first certificate.",{"_3381":2036,"_29612":2008,"_20544":54561,"_5":14097,"_26932":54487,"_2867":54562},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_3381":2037,"_29612":2008,"_20544":54564,"_5":14097,"_26932":54491,"_2867":54565},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_3381":2038,"_29612":2008,"_20544":54567,"_5":14097,"_26932":54495,"_2867":54568},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_3381":2039,"_29612":2008,"_20544":54570,"_5":14097,"_26932":54499,"_2867":54571},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_3381":2040,"_29612":2008,"_20544":54573,"_5":14097,"_26932":54499,"_2867":54574},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_3381":2041,"_29612":2008,"_20544":54576,"_5":14097,"_26932":54499,"_2867":54577},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_3381":2042,"_29612":2008,"_20544":54579,"_5":14097,"_26932":54503,"_2867":54580},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_3381":2043,"_29612":2008,"_20544":54582,"_5":14097,"_26932":54503,"_2867":54583},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_3381":2044,"_29612":2008,"_20544":54585,"_5":14097,"_26932":54503,"_2867":54586},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_3381":2045,"_29612":2008,"_20544":54588,"_5":14097,"_26932":54507,"_2867":54589},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_3381":2046,"_29612":2008,"_20544":54591,"_5":14097,"_26932":54507,"_2867":54592},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_3381":2047,"_29612":2047,"_5":14455,"_2867":54594,"_29965":54595,"_20544":54597,"_26932":2047},"Certificate lifecycle",[48231,49699,53708,54596],"Concepts",[],{"_3381":2048,"_29612":2047,"_20544":54599,"_5":14097,"_26932":2047,"_2867":54600},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_3381":2049,"_29612":2047,"_5":29962,"_20544":54602,"_26932":54603,"_2867":54604},[],"/docs/pr-preview/pr-53/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_3381":2050,"_29612":2047,"_5":29962,"_20544":54606,"_26932":54607,"_2867":54608},[],"/docs/pr-preview/pr-53/platform/pki/concepts/certificate-lifecycle#request","Request",{"_3381":2051,"_29612":2047,"_5":29962,"_20544":54610,"_26932":54611,"_2867":54612},[],"/docs/pr-preview/pr-53/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_3381":2052,"_29612":2047,"_5":29962,"_20544":54614,"_26932":54615,"_2867":54616},[],"/docs/pr-preview/pr-53/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_3381":2053,"_29612":2047,"_5":29962,"_20544":54618,"_26932":54619,"_2867":54620},[],"/docs/pr-preview/pr-53/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_3381":2054,"_29612":2047,"_5":29962,"_20544":54622,"_26932":54623,"_2867":54624},[],"/docs/pr-preview/pr-53/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_3381":2055,"_29612":2047,"_5":29962,"_20544":54626,"_26932":54627,"_2867":54628},[],"/docs/pr-preview/pr-53/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_3381":2056,"_29612":2047,"_5":29962,"_20544":54630,"_26932":54631,"_2867":54632},[],"/docs/pr-preview/pr-53/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_3381":2057,"_29612":2047,"_5":29962,"_20544":54634,"_26932":54635,"_2867":54636},[],"/docs/pr-preview/pr-53/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_3381":2058,"_29612":2047,"_5":29962,"_20544":54638,"_26932":54639,"_2867":54640},[],"/docs/pr-preview/pr-53/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_3381":2059,"_29612":2047,"_20544":54642,"_5":14097,"_26932":2047,"_2867":54643},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_3381":2060,"_29612":2047,"_20544":54645,"_5":14097,"_26932":54607,"_2867":54646},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_3381":2061,"_29612":2047,"_20544":54648,"_5":14097,"_26932":54611,"_2867":54649},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_3381":2062,"_29612":2047,"_20544":54651,"_5":14097,"_26932":54615,"_2867":54652},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_3381":2063,"_29612":2047,"_20544":54654,"_5":14097,"_26932":54619,"_2867":54655},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_3381":2064,"_29612":2047,"_20544":54657,"_5":14097,"_26932":54623,"_2867":54658},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_3381":2065,"_29612":2047,"_20544":54660,"_5":14097,"_26932":54627,"_2867":54661},[],"Lamassu persists four X.509 states:",{"_3381":2066,"_29612":2047,"_20544":54663,"_5":14097,"_26932":54627,"_2867":54664},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_3381":2067,"_29612":2047,"_20544":54666,"_5":14097,"_26932":54627,"_2867":54667},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_3381":2068,"_29612":2047,"_20544":54669,"_5":14097,"_26932":54627,"_2867":54670},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_3381":2069,"_29612":2047,"_20544":54672,"_5":14097,"_26932":54627,"_2867":54673},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_3381":2070,"_29612":2047,"_20544":54675,"_5":14097,"_26932":54627,"_2867":54676},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_3381":2071,"_29612":2047,"_20544":54678,"_5":14097,"_26932":54631,"_2867":54679},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_3381":2072,"_29612":2047,"_20544":54681,"_5":14097,"_26932":54631,"_2867":54682},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_3381":2073,"_29612":2047,"_20544":54684,"_5":14097,"_26932":54631,"_2867":54685},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_3381":2074,"_29612":2047,"_20544":54687,"_5":14097,"_26932":54635,"_2867":54688},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_3381":2075,"_29612":2047,"_20544":54690,"_5":14097,"_26932":54635,"_2867":54691},[],"Before confirming:",{"_3381":2076,"_29612":2047,"_20544":54693,"_5":14097,"_26932":54635,"_2867":54694},[],"Identify DMSs, devices and services that trust that chain.",{"_3381":2077,"_29612":2047,"_20544":54696,"_5":14097,"_26932":54635,"_2867":54697},[],"Distribute the new chain of trust.",{"_3381":2078,"_29612":2047,"_20544":54699,"_5":14097,"_26932":54635,"_2867":54700},[],"Reissue the necessary identities.",{"_3381":2079,"_29612":2047,"_20544":54702,"_5":14097,"_26932":54635,"_2867":54703},[],"Check OCSP and CRL from a real consumer.",{"_3381":2080,"_29612":2047,"_20544":54705,"_5":14097,"_26932":54635,"_2867":54706},[],"Revoke the old CA once no legitimate traffic remains.",{"_3381":2081,"_29612":2047,"_20544":54708,"_5":14097,"_26932":54635,"_2867":54709},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_3381":2082,"_29612":2047,"_20544":54711,"_5":14097,"_26932":54639,"_2867":54712},[],"Certificates entering the preventive or critical renewal window.",{"_3381":2083,"_29612":2047,"_20544":54714,"_5":14097,"_26932":54639,"_2867":54715},[],"Repeated enrollment or re-enrollment failures.",{"_3381":2084,"_29612":2047,"_20544":54717,"_5":14097,"_26932":54639,"_2867":54718},[],"Status changes and revocation reasons.",{"_3381":2085,"_29612":2047,"_20544":54720,"_5":14097,"_26932":54639,"_2867":54721},[],"OCSP and CRL publication and validity.",{"_3381":2086,"_29612":2047,"_20544":54723,"_5":14097,"_26932":54639,"_2867":54724},[],"Dependencies still presenting a replaced certificate.",{"_3381":2087,"_29612":2047,"_20544":54726,"_5":14097,"_26932":54639,"_2867":54727},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_3381":2088,"_29612":2088,"_5":14455,"_2867":54729,"_29965":54730,"_20544":54731,"_26932":2088},"Trust model",[48231,49699,53708,54596],[],{"_3381":2089,"_29612":2088,"_20544":54733,"_5":14097,"_26932":2088,"_2867":54734},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_3381":2090,"_29612":2088,"_5":29962,"_20544":54736,"_26932":54737,"_2867":54738},[],"/docs/pr-preview/pr-53/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_3381":2091,"_29612":2088,"_5":29962,"_20544":54740,"_26932":54741,"_2867":54742},[],"/docs/pr-preview/pr-53/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_3381":2092,"_29612":2088,"_5":29962,"_20544":54744,"_26932":54745,"_2867":54746},[],"/docs/pr-preview/pr-53/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_3381":2093,"_29612":2088,"_5":29962,"_20544":54748,"_26932":54749,"_2867":54750},[],"/docs/pr-preview/pr-53/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_3381":2094,"_29612":2088,"_5":29962,"_20544":54752,"_26932":54753,"_2867":54754},[],"/docs/pr-preview/pr-53/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_3381":2095,"_29612":2088,"_5":29962,"_20544":54756,"_26932":54757,"_2867":54758},[],"/docs/pr-preview/pr-53/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_3381":2096,"_29612":2088,"_5":29962,"_20544":54760,"_26932":54761,"_2867":54762},[],"/docs/pr-preview/pr-53/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_3381":2097,"_29612":2088,"_5":29962,"_20544":54764,"_26932":54765,"_2867":54766},[],"/docs/pr-preview/pr-53/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_3381":2098,"_29612":2088,"_5":29962,"_20544":54768,"_26932":54769,"_2867":54770},[],"/docs/pr-preview/pr-53/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_3381":2099,"_29612":2088,"_5":29962,"_20544":54772,"_26932":54773,"_2867":54774},[],"/docs/pr-preview/pr-53/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_3381":2100,"_29612":2088,"_20544":54776,"_5":14097,"_26932":2088,"_2867":54777},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_3381":2101,"_29612":2088,"_20544":54779,"_5":14097,"_26932":54741,"_2867":54780},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_3381":2102,"_29612":2088,"_20544":54782,"_5":14097,"_26932":54745,"_2867":54783},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_3381":2103,"_29612":2088,"_20544":54785,"_5":14097,"_26932":54749,"_2867":54786},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_3381":2104,"_29612":2088,"_20544":54788,"_5":14097,"_26932":54753,"_2867":54789},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_3381":2105,"_29612":2088,"_20544":54791,"_5":14097,"_26932":54757,"_2867":54792},[],"The device proves it can enroll according to the DMS policy.",{"_3381":2106,"_29612":2088,"_20544":54794,"_5":14097,"_26932":54757,"_2867":54795},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_3381":2107,"_29612":2088,"_20544":54797,"_5":14097,"_26932":54757,"_2867":54798},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_3381":2108,"_29612":2088,"_20544":54800,"_5":14097,"_26932":54757,"_2867":54801},[],"The device installs the certificate and the chain it needs.",{"_3381":2109,"_29612":2088,"_20544":54803,"_5":14097,"_26932":54757,"_2867":54804},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_3381":2110,"_29612":2088,"_20544":54806,"_5":14097,"_26932":54757,"_2867":54807},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_3381":2111,"_29612":2088,"_20544":54809,"_5":14097,"_26932":54761,"_2867":54810},[],"A DMS relates three sets that are worth designing separately:",{"_3381":2112,"_29612":2088,"_20544":54812,"_5":14097,"_26932":54761,"_2867":54813},[],"**Enrollment CA:** signs the new identities.",{"_3381":2113,"_29612":2088,"_20544":54815,"_5":14097,"_26932":54761,"_2867":54816},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, the enrollment CA is always trusted and Lamassu then tries the validation CAs configured in the re-enrollment block; those are optional.",{"_3381":2114,"_29612":2088,"_20544":54818,"_5":14097,"_26932":54761,"_2867":54819},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_3381":2115,"_29612":2088,"_20544":54821,"_5":14097,"_26932":54761,"_2867":54822},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_3381":2116,"_29612":2088,"_20544":54824,"_5":14097,"_26932":54765,"_2867":54825},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_3381":2117,"_29612":2088,"_20544":54827,"_5":14097,"_26932":54765,"_2867":54828},[],"that the current date is between `Not Before` and `Not After`;",{"_3381":2118,"_29612":2088,"_20544":54830,"_5":14097,"_26932":54765,"_2867":54831},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_3381":2119,"_29612":2088,"_20544":54833,"_5":14097,"_26932":54765,"_2867":54834},[],"that names, SANs and subject match the expected identity;",{"_3381":2120,"_29612":2088,"_20544":54836,"_5":14097,"_26932":54765,"_2867":54837},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_3381":2121,"_29612":2088,"_20544":54839,"_5":14097,"_26932":54765,"_2867":54840},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_3381":2122,"_29612":2088,"_20544":54842,"_5":14097,"_26932":54765,"_2867":54843},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_3381":2123,"_29612":2088,"_20544":54845,"_5":14097,"_26932":54769,"_2867":54846},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_3381":2124,"_29612":2088,"_20544":54848,"_5":14097,"_26932":54773,"_2867":54849},[],"Keep the root out of daily operations, or with very restricted access.",{"_3381":2125,"_29612":2088,"_20544":54851,"_5":14097,"_26932":54773,"_2867":54852},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_3381":2126,"_29612":2088,"_20544":54854,"_5":14097,"_26932":54773,"_2867":54855},[],"Assign explicit profiles to every use case.",{"_3381":2127,"_29612":2088,"_20544":54857,"_5":14097,"_26932":54773,"_2867":54858},[],"Distribute the new trust before starting a rotation.",{"_3381":2128,"_29612":2088,"_20544":54860,"_5":14097,"_26932":54773,"_2867":54861},[],"Keep enough overlap to renew a disconnected fleet.",{"_3381":2129,"_29612":2088,"_20544":54863,"_5":14097,"_26932":54773,"_2867":54864},[],"Validate from the consuming system, not only from the Lamassu console.",{"_3381":2130,"_29612":2088,"_20544":54866,"_5":14097,"_26932":54773,"_2867":54867},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_3381":2131,"_29612":2131,"_5":14455,"_2867":54869,"_29965":54870,"_20544":54871,"_26932":2131},"Revocation lists (CRL)",[48231,49699,53708,54341],[],{"_3381":2132,"_29612":2131,"_20544":54873,"_5":14097,"_26932":2131,"_2867":54874},[],"Generate and distribute signed lists to validate certificates offline.",{"_3381":2133,"_29612":2131,"_5":29962,"_20544":54876,"_26932":54877,"_2867":54878},[],"/docs/pr-preview/pr-53/platform/pki/crl#va-role-and-per-ca-configuration","VA role and per-CA configuration",{"_3381":2134,"_29612":2131,"_5":29962,"_20544":54880,"_26932":54881,"_2867":54882},[],"/docs/pr-preview/pr-53/platform/pki/crl#cas-that-share-a-key","CAs that share a key",{"_3381":2135,"_29612":2131,"_5":29962,"_20544":54884,"_26932":54885,"_2867":54886},[],"/docs/pr-preview/pr-53/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_3381":2136,"_29612":2131,"_5":29962,"_20544":54888,"_26932":54889,"_2867":54890},[],"/docs/pr-preview/pr-53/platform/pki/crl#crl-contents","CRL contents",{"_3381":2137,"_29612":2131,"_5":29962,"_20544":54892,"_26932":54893,"_2867":54894},[],"/docs/pr-preview/pr-53/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_3381":2138,"_29612":2131,"_5":29962,"_20544":54896,"_26932":54897,"_2867":54898},[],"/docs/pr-preview/pr-53/platform/pki/crl#va-role-management-api","VA role management API",{"_3381":2139,"_29612":2131,"_5":29962,"_20544":54900,"_26932":54901,"_2867":54902},[],"/docs/pr-preview/pr-53/platform/pki/crl#common-va-role-errors","Common VA role errors",{"_3381":2140,"_29612":2131,"_5":29962,"_20544":54904,"_26932":54905,"_2867":54906},[],"/docs/pr-preview/pr-53/platform/pki/crl#from-the-interface","From the interface",{"_3381":2141,"_29612":2131,"_5":29962,"_20544":54908,"_26932":54909,"_2867":54910},[],"/docs/pr-preview/pr-53/platform/pki/crl#references","References",{"_3381":2142,"_29612":2131,"_20544":54912,"_5":14097,"_26932":2131,"_2867":54913},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its SKI and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_3381":2143,"_29612":2131,"_20544":54915,"_5":14097,"_26932":54877,"_2867":54916},[],"The VA role stores configuration and metadata for the latest list published for a CA’s SKI. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_3381":2144,"_29612":2131,"_20544":54918,"_5":14097,"_26932":54877,"_2867":54919},[],"`crl_options` field",{"_3381":2145,"_29612":2131,"_20544":54921,"_5":14097,"_26932":54877,"_2867":48621},[],{"_3381":2146,"_29612":2131,"_20544":54923,"_5":14097,"_26932":54877,"_2867":54924},[],"Backend initial value",{"_3381":2147,"_29612":2131,"_20544":54926,"_5":14097,"_26932":54877,"_2867":54927},[],"`validity`",{"_3381":2148,"_29612":2131,"_20544":54929,"_5":14097,"_26932":54877,"_2867":54930},[],"Time from `thisUpdate` to `nextUpdate`.",{"_3381":2149,"_29612":2131,"_20544":54932,"_5":14097,"_26932":54877,"_2867":54933},[],"7 days.",{"_3381":2150,"_29612":2131,"_20544":54935,"_5":14097,"_26932":54877,"_2867":54936},[],"`refresh_interval`",{"_3381":2151,"_29612":2131,"_20544":54938,"_5":14097,"_26932":54877,"_2867":54939},[],"Stored and returned by the API, but the VA does not use it: scheduled renewal does not depend on it (see Periodic and automatic regeneration).",{"_3381":2152,"_29612":2131,"_20544":54941,"_5":14097,"_26932":54877,"_2867":54942},[],"6 days and 23 hours.",{"_3381":2153,"_29612":2131,"_20544":54944,"_5":14097,"_26932":54877,"_2867":54945},[],"`regenerate_on_revoke`",{"_3381":2154,"_29612":2131,"_20544":54947,"_5":14097,"_26932":54877,"_2867":54948},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_3381":2155,"_29612":2131,"_20544":54950,"_5":14097,"_26932":54877,"_2867":54951},[],"`true`.",{"_3381":2156,"_29612":2131,"_20544":54953,"_5":14097,"_26932":54877,"_2867":54954},[],"`signer_certificate_serial_number`",{"_3381":2157,"_29612":2131,"_20544":54956,"_5":14097,"_26932":54877,"_2867":54957},[],"Serial number of the existing certificate that signs the CRL.",{"_3381":2158,"_29612":2131,"_20544":54959,"_5":14097,"_26932":54877,"_2867":54960},[],"Serial number of the CA’s current certificate.",{"_3381":2159,"_29612":2131,"_20544":54962,"_5":14097,"_26932":54877,"_2867":54963},[],"The signer must be an existing certificate with the `cRLSign` key usage and the same subject and public key as the CA. Certificates from before a reissue qualify. A delegated signer is not supported: a certificate with the CA’s subject but a different key is rejected.",{"_3381":2160,"_29612":2131,"_20544":54965,"_5":14097,"_26932":54877,"_2867":54966},[],"When a CA is reissued, the role keeps pointing at the previous certificate. CRLs remain valid because both certificates share subject and key, but the previous certificate cannot be deleted while the role uses it. To retire it, update the role’s signer.",{"_3381":2161,"_29612":2131,"_20544":54968,"_5":14097,"_26932":54877,"_2867":54969},[],"When a CA is deleted, its VA role is kept and cannot be removed through the API. If no other CA with the same SKI remains, the role can be read but any `PUT` returns 404, and the renewal job logs a warning on every cycle because it no longer finds the CA. The API offers no way out; it can only be fixed by editing the database. If another CA with that SKI remains, the role is still editable (see CAs that share a key). Adjust validity and signer before deleting the CA.",{"_3381":2162,"_29612":2131,"_20544":54971,"_5":14097,"_26932":54877,"_2867":54972},[],"A CA whose certificate lacks `cRLSign` cannot generate its CRL or edit its role (400 error). Since 4.0 the VA requires this usage. Check before importing with `openssl x509 -noout -ext keyUsage` and, if it is missing, obtain a certificate for the same CA and key that includes it and set it as the signer with `PUT`. After reissuing a CA, also check the key usage of the new certificate: it may not keep the original’s usages.",{"_3381":2163,"_29612":2131,"_20544":54974,"_5":14097,"_26932":54877,"_2867":54975},[],"`PUT` always validates the signer, even when the request does not change it. If the stored signer is no longer valid, no field of the role can be modified, not even the validity, until a valid one is set.",{"_3381":2164,"_29612":2131,"_20544":54977,"_5":14097,"_26932":54877,"_2867":54978},[],"Sharing a key between CAs can prevent CRL validation. See CAs that share a key.",{"_3381":2165,"_29612":2131,"_20544":54980,"_5":14097,"_26932":54877,"_2867":54981},[],"`latest_crl` contains version, validity start and end. Versions are kept as PEM in object storage at `pki/va/crl/{subject_key_id}/{version}.crl`; the public endpoint returns DER.",{"_3381":2166,"_29612":2131,"_20544":54983,"_5":14097,"_26932":54881,"_2867":54984},[],"The VA identifies each CRL by the CA’s SKI, and the SKI is derived from its key. Two CAs with the same key have the same SKI and share a single VA role and a single CRL. This happens when a CA is created on an existing KMS key, or when a CA is imported whose certificate declares an SKI already in use. Lamassu takes the SKI of an imported certificate as-is and does not check that it corresponds to its public key. The first CA creates the role and the others keep it.",{"_3381":2167,"_29612":2131,"_20544":54986,"_5":14097,"_26932":54881,"_2867":54987},[],"The certificates of all of them point to `/crl/{ski}`, but the published list has the first CA as issuer and only includes its revocations. A verifier compares the CRL issuer with the issuer of the certificate it validates (RFC 5280, §6.3.2) and rejects the list if they differ. Depending on its policy, the certificate is blocked (*hard-fail*) or accepted even though it is revoked (*soft-fail*). Revocations of the secondary CAs do not appear in any list.",{"_3381":2168,"_29612":2131,"_20544":54989,"_5":14097,"_26932":54881,"_2867":54990},[],"If the first CA is deleted, CRL generation for the remaining one fails because the configured signer no longer matches a CA with that name. Until the role’s signer is updated to a certificate of the remaining CA, the last published list keeps being served until it expires (7 days by default).",{"_3381":2169,"_29612":2131,"_20544":54992,"_5":14097,"_26932":54881,"_2867":54993},[],"Before upgrading, review CAs that share a key. To detect the problem, compare the SKI of the CAs in the inventory: two with the same SKI are affected. To fix it, create a CA with its own key and reissue its certificates; those already issued keep the old URL and are not corrected until reissued. A CA imported with an SKI already in use does not replace the existing one as CRL issuer, because the issuer is resolved from the role’s signer. However, its own certificates point to that same URL and its revocations are not published. Until Lamassu rejects these imports, restrict the permission to import CAs as an interim control; it covers only the import path. Creating a CA with &#x2A;*Create New CA (Existing Key)** on a KMS key another CA already uses produces the same collision, so also avoid reusing keys across CAs. A per-CA CRL and the rejection of imports whose SKI collides with an existing CA are both proposed in lamassuiot#834, and neither is implemented yet.",{"_3381":2170,"_29612":2131,"_20544":54995,"_5":14097,"_26932":54885,"_2867":54996},[],"The VA scheduled job checks every role on each run and requests another list when the remaining validity of `latest_crl` is less than the interval between runs. The frequency is set in Helm with `services.va.job.crl.frequency` (default `0 * * * *`) and accepts a duration (`1h`) or a cron expression. A cron expression is converted into a constant interval equal to the time left until its next firing when the service starts, so it is not aligned with the clock. `refresh_interval` plays no part. Keep `validity` well above the interval: with a shorter validity, the list is regenerated on every cycle.",{"_3381":2171,"_29612":2131,"_20544":54998,"_5":14097,"_26932":54885,"_2867":54999},[],"If generation fails (for example, because of a role without a CA or an invalid signer), the job logs the warning `something went wrong while calculating CRL for CA <ski>` and retries on the next cycle. There is no other renewal path until the cause is fixed, and the last published list keeps being served until it expires. All of this depends on working jobs, storage and signing.",{"_3381":2172,"_29612":2131,"_20544":55001,"_5":14097,"_26932":54885,"_2867":55002},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths: if it fails (missing role, invalid signer), the event is retried and, once retries are exhausted, moves to the failed-events queue. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_3381":2173,"_29612":2131,"_20544":55004,"_5":14097,"_26932":54885,"_2867":55005},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_3381":2174,"_29612":2131,"_20544":55007,"_5":14097,"_26932":54889,"_2867":55008},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_3381":2175,"_29612":2131,"_20544":55010,"_5":14097,"_26932":54889,"_2867":55011},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_3381":2176,"_29612":2131,"_20544":55013,"_5":14097,"_26932":54893,"_2867":55014},[],"The VA service exposes `GET /crl/{subject_key_id}` without management authorization. Use the **issuing CA’s** SKI, not the end-entity certificate’s SKI or serial. First inspect the certificate’s CDP:",{"_3381":2177,"_29612":2131,"_20544":55016,"_5":14097,"_26932":54893,"_2867":55017},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_3381":2178,"_29612":2131,"_20544":55019,"_5":14097,"_26932":54893,"_2867":55020},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. An accepted signer certificate has the same subject and public key as the CA, so this signature check also works when the role points to an earlier certificate for that CA and key. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_3381":2179,"_29612":2131,"_20544":55022,"_5":14097,"_26932":54893,"_2867":55023},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_3381":2180,"_29612":2131,"_20544":55025,"_5":14097,"_26932":54893,"_2867":55026},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_3381":2181,"_29612":2131,"_20544":55028,"_5":14097,"_26932":54897,"_2867":55029},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_3381":2182,"_29612":2131,"_20544":55031,"_5":14097,"_26932":54897,"_2867":51466},[],{"_3381":2183,"_29612":2131,"_20544":55033,"_5":14097,"_26932":54897,"_2867":55034},[],"Relative path",{"_3381":2184,"_29612":2131,"_20544":55036,"_5":14097,"_26932":54897,"_2867":51463},[],{"_3381":2185,"_29612":2131,"_20544":55038,"_5":14097,"_26932":54897,"_2867":55039},[],"`GET`",{"_3381":2186,"_29612":2131,"_20544":55041,"_5":14097,"_26932":54897,"_2867":55042},[],"`/v1/roles/{ca-ski}`",{"_3381":2187,"_29612":2131,"_20544":55044,"_5":14097,"_26932":54897,"_2867":55045},[],"Read `crl_options` and `latest_crl`.",{"_3381":2188,"_29612":2131,"_20544":55047,"_5":14097,"_26932":54897,"_2867":55048},[],"`PUT`",{"_3381":2189,"_29612":2131,"_20544":55050,"_5":14097,"_26932":54897,"_2867":55042},[],{"_3381":2190,"_29612":2131,"_20544":55052,"_5":14097,"_26932":54897,"_2867":55053},[],"Replace CRL configuration.",{"_3381":2191,"_29612":2131,"_20544":55055,"_5":14097,"_26932":54897,"_2867":55056},[],"You need authentication and role read or update permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract: the backend replaces `crl_options`; it does not merge omitted fields.",{"_3381":2192,"_29612":2131,"_20544":55058,"_5":14097,"_26932":54897,"_2867":55059},[],"After a change, check saved configuration and the next list actually published. Updating the role alone does not establish regeneration or client acceptance.",{"_3381":2193,"_29612":2131,"_20544":55061,"_5":14097,"_26932":54901,"_2867":55062},[],"Symptom",{"_3381":2194,"_29612":2131,"_20544":55064,"_5":14097,"_26932":54901,"_2867":55065},[],"Cause",{"_3381":2195,"_29612":2131,"_20544":55067,"_5":14097,"_26932":54901,"_2867":55068},[],"Action",{"_3381":2196,"_29612":2131,"_20544":55070,"_5":14097,"_26932":54901,"_2867":55071},[],"`PUT /v1/roles/{ca-ski}` returns 404 and `GET` returns 200.",{"_3381":2197,"_29612":2131,"_20544":55073,"_5":14097,"_26932":54901,"_2867":55074},[],"The role’s CA was deleted and no other CA with the same SKI remains.",{"_3381":2198,"_29612":2131,"_20544":55076,"_5":14097,"_26932":54901,"_2867":55077},[],"There is no API way out; it requires database intervention. Avoid it by adjusting the role before deleting the CA.",{"_3381":2199,"_29612":2131,"_20544":55079,"_5":14097,"_26932":54901,"_2867":55080},[],"`PUT` returns 400.",{"_3381":2200,"_29612":2131,"_20544":55082,"_5":14097,"_26932":54901,"_2867":55083},[],"The signer lacks `cRLSign`, or its subject and key match no CA with that SKI (for example, after deleting the first of two CAs that share a key).",{"_3381":2201,"_29612":2131,"_20544":55085,"_5":14097,"_26932":54901,"_2867":55086},[],"Use `PUT` to set the serial number of a valid certificate of the remaining CA.",{"_3381":2202,"_29612":2131,"_20544":55088,"_5":14097,"_26932":54901,"_2867":55089},[],"`PUT` returns 400 from a 3.x client.",{"_3381":2203,"_29612":2131,"_20544":55091,"_5":14097,"_26932":54901,"_2867":55092},[],"`crl_options.subject_key_id_signer` was replaced by `signer_certificate_serial_number`, which is required.",{"_3381":2204,"_29612":2131,"_20544":55094,"_5":14097,"_26932":54901,"_2867":55095},[],"Update the client to send the new field.",{"_3381":2205,"_29612":2131,"_20544":55097,"_5":14097,"_26932":54901,"_2867":55098},[],"The CRL does not change after revoking a certificate.",{"_3381":2206,"_29612":2131,"_20544":55100,"_5":14097,"_26932":54901,"_2867":55101},[],"`regenerate_on_revoke` is `false`, or the event failed because of a missing role or an invalid signer.",{"_3381":2207,"_29612":2131,"_20544":55103,"_5":14097,"_26932":54901,"_2867":55104},[],"Check the VA logs and the failed-events queue; fix the signer.",{"_3381":2208,"_29612":2131,"_20544":55106,"_5":14097,"_26932":54901,"_2867":55107},[],"A verifier rejects the CRL because of the issuer.",{"_3381":2209,"_29612":2131,"_20544":55109,"_5":14097,"_26932":54901,"_2867":55110},[],"Several CAs share an SKI.",{"_3381":2210,"_29612":2131,"_20544":55112,"_5":14097,"_26932":54901,"_2867":55113},[],"See CAs that share a key.",{"_3381":2211,"_29612":2131,"_20544":55115,"_5":14097,"_26932":54905,"_2867":55116},[],"The CA view lets you inspect and download the available list. Compare version, issuer and timestamps with the copy downloaded from the public endpoint. The CA's VA settings also let you select the CRL signer: the certificate picker only offers certificates that have a private key and carry the `CRLSign` key usage. If a configured signer's certificate cannot be resolved, the interface shows `Unknown Certificate (Serial: X)` or `Certificate details unavailable (Serial: X)`. Diagnose differences using PKI troubleshooting.",{"_3381":2212,"_29612":2131,"_20544":55118,"_5":14097,"_26932":54909,"_2867":55119},[],"RFC 5280: X.509 and CRL profile.",{"_3381":2213,"_29612":2131,"_20544":55121,"_5":14097,"_26932":54909,"_2867":55122},[],"OpenSSL: openssl-crl.",{"_3381":2214,"_29612":2131,"_20544":55124,"_5":14097,"_26932":54909,"_2867":55125},[],"OpenSSL: openssl-verify.",{"_3381":2215,"_29612":2131,"_20544":55127,"_5":14097,"_26932":54909,"_2867":55128},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_3381":2216,"_29612":2131,"_20544":55130,"_5":14097,"_26932":54909,"_2867":55131},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3381":2217,"_29612":2217,"_5":14455,"_2867":55133,"_29965":55134,"_20544":55135,"_26932":2217},"Keys and cryptographic engines",[48231,49699,53708,53709],[],{"_3381":2218,"_29612":2217,"_20544":55137,"_5":14097,"_26932":2217,"_2867":55138},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_3381":2219,"_29612":2217,"_5":29962,"_20544":55140,"_26932":55141,"_2867":55142},[],"/docs/pr-preview/pr-53/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_3381":2220,"_29612":2217,"_5":29962,"_20544":55144,"_26932":55145,"_2867":55146},[],"/docs/pr-preview/pr-53/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_3381":2221,"_29612":2217,"_5":29962,"_20544":55148,"_26932":55149,"_2867":55150},[],"/docs/pr-preview/pr-53/platform/pki/key-management#file-system","File System",{"_3381":2222,"_29612":2217,"_5":29962,"_20544":55152,"_26932":55153,"_2867":55154},[],"/docs/pr-preview/pr-53/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3381":2223,"_29612":2217,"_5":29962,"_20544":55156,"_26932":55157,"_2867":55158},[],"/docs/pr-preview/pr-53/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3381":2224,"_29612":2217,"_5":29962,"_20544":55160,"_26932":55161,"_2867":55162},[],"/docs/pr-preview/pr-53/platform/pki/key-management#aws-kms","AWS KMS",{"_3381":2225,"_29612":2217,"_5":29962,"_20544":55164,"_26932":55165,"_2867":55166},[],"/docs/pr-preview/pr-53/platform/pki/key-management#pkcs11","PKCS#11",{"_3381":2226,"_29612":2217,"_5":29962,"_20544":55168,"_26932":55169,"_2867":55170},[],"/docs/pr-preview/pr-53/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_3381":2227,"_29612":2217,"_5":29962,"_20544":55172,"_26932":55173,"_2867":55174},[],"/docs/pr-preview/pr-53/platform/pki/key-management#key-inventory","Key inventory",{"_3381":2228,"_29612":2217,"_5":29962,"_20544":55176,"_26932":55177,"_2867":55178},[],"/docs/pr-preview/pr-53/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_3381":2229,"_29612":2217,"_5":29962,"_20544":55180,"_26932":55181,"_2867":55182},[],"/docs/pr-preview/pr-53/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_3381":2230,"_29612":2217,"_5":29962,"_20544":55184,"_26932":55185,"_2867":55186},[],"/docs/pr-preview/pr-53/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_3381":2231,"_29612":2217,"_5":29962,"_20544":55188,"_26932":55189,"_2867":55190},[],"/docs/pr-preview/pr-53/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_3381":2232,"_29612":2217,"_5":29962,"_20544":55192,"_26932":55193,"_2867":55194},[],"/docs/pr-preview/pr-53/platform/pki/key-management#view-details","View details",{"_3381":2233,"_29612":2217,"_5":29962,"_20544":55196,"_26932":55197,"_2867":55198},[],"/docs/pr-preview/pr-53/platform/pki/key-management#sign-and-verify","Sign and verify",{"_3381":2234,"_29612":2217,"_5":29962,"_20544":55200,"_26932":55201,"_2867":55202},[],"/docs/pr-preview/pr-53/platform/pki/key-management#sign","Sign",{"_3381":2235,"_29612":2217,"_5":29962,"_20544":55204,"_26932":55205,"_2867":55206},[],"/docs/pr-preview/pr-53/platform/pki/key-management#verify","Verify",{"_3381":2236,"_29612":2217,"_5":29962,"_20544":55208,"_26932":55209,"_2867":55210},[],"/docs/pr-preview/pr-53/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_3381":2237,"_29612":2217,"_5":29962,"_20544":55212,"_26932":55213,"_2867":55214},[],"/docs/pr-preview/pr-53/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_3381":2238,"_29612":2217,"_5":29962,"_20544":55216,"_26932":55217,"_2867":55218},[],"/docs/pr-preview/pr-53/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_3381":2239,"_29612":2217,"_20544":55220,"_5":14097,"_26932":2217,"_2867":55221},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_3381":2240,"_29612":2217,"_20544":55223,"_5":14097,"_26932":2217,"_2867":55224},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_3381":2241,"_29612":2217,"_20544":55226,"_5":14097,"_26932":55141,"_2867":55227},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_3381":2242,"_29612":2217,"_20544":55229,"_5":14097,"_26932":55141,"_2867":55230},[],"In practice, it lets you:",{"_3381":2243,"_29612":2217,"_20544":55232,"_5":14097,"_26932":55141,"_2867":55233},[],"Generate new key pairs from Lamassu IoT.",{"_3381":2244,"_29612":2217,"_20544":55235,"_5":14097,"_26932":55141,"_2867":55236},[],"Import keys created externally.",{"_3381":2245,"_29612":2217,"_20544":55238,"_5":14097,"_26932":55141,"_2867":55239},[],"Delegate custody and cryptographic operations to external engines.",{"_3381":2246,"_29612":2217,"_20544":55241,"_5":14097,"_26932":55141,"_2867":55242},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_3381":2247,"_29612":2217,"_20544":55244,"_5":14097,"_26932":55145,"_2867":55245},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_3381":2248,"_29612":2217,"_20544":55247,"_5":14097,"_26932":55145,"_2867":55248},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_3381":2249,"_29612":2217,"_20544":55250,"_5":14097,"_26932":55145,"_2867":55251},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_3381":2250,"_29612":2217,"_20544":55253,"_5":14097,"_26932":55149,"_2867":55254},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_3381":2251,"_29612":2217,"_20544":55256,"_5":14097,"_26932":55153,"_2867":55257},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_3381":2252,"_29612":2217,"_20544":55259,"_5":14097,"_26932":55153,"_2867":55260},[],"The adapter reaches Vault over its configured HTTP(S) endpoint. The Vault server certificate is verified against the system trust store; a Vault signed by a private CA is trusted by adding its CA certificate to the engine's `ca_cert_file` (PEM-encoded). `insecure_skip_verify=true` disables verification and is a last resort; agree the transport settings with the deployment owner.",{"_3381":2253,"_29612":2217,"_20544":55262,"_5":14097,"_26932":55157,"_2867":55263},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_3381":2254,"_29612":2217,"_20544":55265,"_5":14097,"_26932":55161,"_2867":55266},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_3381":2255,"_29612":2217,"_20544":55268,"_5":14097,"_26932":55165,"_2867":55269},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_3381":2256,"_29612":2217,"_20544":55271,"_5":14097,"_26932":55169,"_2867":55272},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_3381":2257,"_29612":2217,"_20544":55274,"_5":14097,"_26932":55169,"_2867":55275},[],"Lamassu shows the enabled engines in the console.",{"_3381":2258,"_29612":2217,"_20544":55277,"_5":14097,"_26932":55169,"_2867":55278},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_3381":2259,"_29612":2217,"_20544":55280,"_5":14097,"_26932":55169,"_2867":55281},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_3381":2260,"_29612":2217,"_20544":55283,"_5":14097,"_26932":55173,"_2867":55284},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_3381":2261,"_29612":2217,"_20544":55286,"_5":14097,"_26932":55173,"_2867":55287},[],"The table includes the following fields:",{"_3381":2262,"_29612":2217,"_20544":55289,"_5":14097,"_26932":55173,"_2867":55290},[],"**Name**: descriptive name of the key.",{"_3381":2263,"_29612":2217,"_20544":55292,"_5":14097,"_26932":55173,"_2867":55293},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_3381":2264,"_29612":2217,"_20544":55295,"_5":14097,"_26932":55173,"_2867":55296},[],"**Strength**: visual indicator of cryptographic strength.",{"_3381":2265,"_29612":2217,"_20544":55298,"_5":14097,"_26932":55173,"_2867":55299},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_3381":2266,"_29612":2217,"_20544":55301,"_5":14097,"_26932":55173,"_2867":55302},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_3381":2267,"_29612":2217,"_20544":55304,"_5":14097,"_26932":55173,"_2867":55305},[],"**Aliases**: alternative names associated with the key.",{"_3381":2268,"_29612":2217,"_20544":55307,"_5":14097,"_26932":55173,"_2867":55308},[],"**Tags**: labels for classification and search.",{"_3381":2269,"_29612":2217,"_20544":55310,"_5":14097,"_26932":55173,"_2867":55311},[],"**Related Entities**: certificates or other entities linked to that key.",{"_3381":2270,"_29612":2217,"_20544":55313,"_5":14097,"_26932":55173,"_2867":55314},[],"From this view you also reach the most common actions:",{"_3381":2271,"_29612":2217,"_20544":55316,"_5":14097,"_26932":55173,"_2867":55317},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_3381":2272,"_29612":2217,"_20544":55319,"_5":14097,"_26932":55173,"_2867":55320},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_3381":2273,"_29612":2217,"_20544":55322,"_5":14097,"_26932":55173,"_2867":55323},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_3381":2274,"_29612":2217,"_20544":55325,"_5":14097,"_26932":55173,"_2867":55326},[],"**Delete Key** to remove the key from the system.",{"_3381":2275,"_29612":2217,"_20544":55328,"_5":14097,"_26932":55177,"_2867":55329},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_3381":2276,"_29612":2217,"_20544":55331,"_5":14097,"_26932":55181,"_2867":55332},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_3381":2277,"_29612":2217,"_20544":55334,"_5":14097,"_26932":55181,"_2867":55335},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_3381":2278,"_29612":2217,"_20544":55337,"_5":14097,"_26932":55181,"_2867":55338},[],"**Key Name**: unique and descriptive name.",{"_3381":2279,"_29612":2217,"_20544":55340,"_5":14097,"_26932":55181,"_2867":55341},[],"**Crypto Engine**: engine that will keep the key.",{"_3381":2280,"_29612":2217,"_20544":55343,"_5":14097,"_26932":55181,"_2867":55344},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_3381":2281,"_29612":2217,"_20544":55346,"_5":14097,"_26932":55181,"_2867":55347},[],"**Tags**: metadata to classify the key.",{"_3381":2282,"_29612":2217,"_20544":55349,"_5":14097,"_26932":55181,"_2867":55350},[],"**Metadata**: additional information for advanced uses.",{"_3381":2283,"_29612":2217,"_20544":55352,"_5":14097,"_26932":55185,"_2867":55353},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_3381":2284,"_29612":2217,"_20544":55355,"_5":14097,"_26932":55185,"_2867":55356},[],"When you have an exportable private key and the destination engine supports import.",{"_3381":2285,"_29612":2217,"_20544":55358,"_5":14097,"_26932":55185,"_2867":55359},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_3381":2286,"_29612":2217,"_20544":55361,"_5":14097,"_26932":55185,"_2867":55362},[],"When Lamassu must operate with a root of trust created by a third party.",{"_3381":2287,"_29612":2217,"_20544":55364,"_5":14097,"_26932":55185,"_2867":55365},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_3381":2288,"_29612":2217,"_20544":55367,"_5":14097,"_26932":55185,"_2867":55368},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_3381":2289,"_29612":2217,"_20544":55370,"_5":14097,"_26932":55185,"_2867":55371},[],"**Crypto Engine**: engine that will keep the imported key.",{"_3381":2290,"_29612":2217,"_20544":55373,"_5":14097,"_26932":55185,"_2867":55374},[],"**Tags**: labels for organization and search.",{"_3381":2291,"_29612":2217,"_20544":55376,"_5":14097,"_26932":55185,"_2867":55377},[],"**Metadata**: additional optional information.",{"_3381":2292,"_29612":2217,"_20544":55379,"_5":14097,"_26932":55185,"_2867":55380},[],"**Private Key (PEM)**: private key in PEM format.",{"_3381":2293,"_29612":2217,"_20544":55382,"_5":14097,"_26932":55185,"_2867":55383},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_3381":2294,"_29612":2217,"_20544":55385,"_5":14097,"_26932":55189,"_2867":55386},[],"Each registered key has a detail view and several operational actions.",{"_3381":2295,"_29612":2217,"_20544":55388,"_5":14097,"_26932":55193,"_2867":55389},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_3381":2296,"_29612":2217,"_20544":55391,"_5":14097,"_26932":55193,"_2867":55392},[],"The **Overview** tab shows, among others, these fields:",{"_3381":2297,"_29612":2217,"_20544":55394,"_5":14097,"_26932":55193,"_2867":55395},[],"**Key Name**: descriptive name.",{"_3381":2298,"_29612":2217,"_20544":55397,"_5":14097,"_26932":55193,"_2867":55398},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_3381":2299,"_29612":2217,"_20544":55400,"_5":14097,"_26932":55193,"_2867":55401},[],"**Tags**: associated labels.",{"_3381":2300,"_29612":2217,"_20544":55403,"_5":14097,"_26932":55193,"_2867":55404},[],"**Aliases**: alternative names.",{"_3381":2301,"_29612":2217,"_20544":55406,"_5":14097,"_26932":55193,"_2867":55407},[],"**Crypto Engine**: engine where the key resides.",{"_3381":2302,"_29612":2217,"_20544":55409,"_5":14097,"_26932":55193,"_2867":55410},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_3381":2303,"_29612":2217,"_20544":55412,"_5":14097,"_26932":55193,"_2867":55413},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_3381":2304,"_29612":2217,"_20544":55415,"_5":14097,"_26932":55193,"_2867":55416},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_3381":2305,"_29612":2217,"_20544":55418,"_5":14097,"_26932":55197,"_2867":55419},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_3381":2306,"_29612":2217,"_20544":55421,"_5":14097,"_26932":55197,"_2867":55422},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_3381":2307,"_29612":2217,"_20544":55424,"_5":14097,"_26932":55197,"_2867":55425},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_3381":2308,"_29612":2217,"_20544":55427,"_5":14097,"_26932":55201,"_2867":55428},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_3381":2309,"_29612":2217,"_20544":55430,"_5":14097,"_26932":55201,"_2867":55431},[],"Main fields:",{"_3381":2310,"_29612":2217,"_20544":55433,"_5":14097,"_26932":55201,"_2867":55434},[],"**Algorithm**: signing algorithm available for the key type.",{"_3381":2311,"_29612":2217,"_20544":55436,"_5":14097,"_26932":55201,"_2867":55437},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_3381":2312,"_29612":2217,"_20544":55439,"_5":14097,"_26932":55201,"_2867":55440},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_3381":2313,"_29612":2217,"_20544":55442,"_5":14097,"_26932":55201,"_2867":55443},[],"**Message**: content to sign.",{"_3381":2314,"_29612":2217,"_20544":55445,"_5":14097,"_26932":55201,"_2867":55446},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_3381":2315,"_29612":2217,"_20544":55448,"_5":14097,"_26932":55205,"_2867":55449},[],"This tab checks whether a signature corresponds to the associated public key.",{"_3381":2316,"_29612":2217,"_20544":55451,"_5":14097,"_26932":55205,"_2867":55431},[],{"_3381":2317,"_29612":2217,"_20544":55453,"_5":14097,"_26932":55205,"_2867":55454},[],"**Algorithm**: must match the algorithm used for the signature.",{"_3381":2318,"_29612":2217,"_20544":55456,"_5":14097,"_26932":55205,"_2867":55457},[],"**Message Type**: `Raw` or `Digest`.",{"_3381":2319,"_29612":2217,"_20544":55459,"_5":14097,"_26932":55205,"_2867":55460},[],"**Payload Encoding**: encoding of the message.",{"_3381":2320,"_29612":2217,"_20544":55462,"_5":14097,"_26932":55205,"_2867":55463},[],"**Message**: original message or hash.",{"_3381":2321,"_29612":2217,"_20544":55465,"_5":14097,"_26932":55205,"_2867":55466},[],"**Signature**: signature to check.",{"_3381":2322,"_29612":2217,"_20544":55468,"_5":14097,"_26932":55205,"_2867":55469},[],"**Result**: indicator of the validation result.",{"_3381":2323,"_29612":2217,"_20544":55471,"_5":14097,"_26932":55209,"_2867":55472},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_3381":2324,"_29612":2217,"_20544":55474,"_5":14097,"_26932":55209,"_2867":55475},[],"This flow is useful for:",{"_3381":2325,"_29612":2217,"_20544":55477,"_5":14097,"_26932":55209,"_2867":55478},[],"Requesting certificates from an external CA.",{"_3381":2326,"_29612":2217,"_20544":55480,"_5":14097,"_26932":55209,"_2867":55481},[],"Renewing an identity while keeping the same key.",{"_3381":2327,"_29612":2217,"_20544":55483,"_5":14097,"_26932":55209,"_2867":55484},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_3381":2328,"_29612":2217,"_20544":55486,"_5":14097,"_26932":55209,"_2867":55487},[],"**Common Name (CN)**: main name of the identity.",{"_3381":2329,"_29612":2217,"_20544":55489,"_5":14097,"_26932":55209,"_2867":55490},[],"**Organization (O)**: organization or company.",{"_3381":2330,"_29612":2217,"_20544":55492,"_5":14097,"_26932":55209,"_2867":55493},[],"**Organizational Unit (OU)**: department or unit.",{"_3381":2331,"_29612":2217,"_20544":55495,"_5":14097,"_26932":55209,"_2867":55496},[],"**Country (C)**: two-letter country code.",{"_3381":2332,"_29612":2217,"_20544":55498,"_5":14097,"_26932":55209,"_2867":55499},[],"**State / Province (ST)**: state or province.",{"_3381":2333,"_29612":2217,"_20544":55501,"_5":14097,"_26932":55209,"_2867":55502},[],"**Locality (L)**: city or locality.",{"_3381":2334,"_29612":2217,"_20544":55504,"_5":14097,"_26932":55209,"_2867":55505},[],"**Email Address**: contact email.",{"_3381":2335,"_29612":2217,"_20544":55507,"_5":14097,"_26932":55209,"_2867":55508},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_3381":2336,"_29612":2217,"_20544":55510,"_5":14097,"_26932":55209,"_2867":55511},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_3381":2337,"_29612":2217,"_20544":55513,"_5":14097,"_26932":55213,"_2867":55514},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_3381":2338,"_29612":2217,"_20544":55516,"_5":14097,"_26932":55213,"_2867":55517},[],"It requires the module, token and permissions of the corresponding provider. Check that the Lamassu identifier matches the object accessible from that module. Module configuration belongs to the client environment or Deployment.",{"_3381":2339,"_29612":2217,"_20544":55519,"_5":14097,"_26932":55217,"_2867":55520},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_3381":2340,"_29612":2217,"_20544":55522,"_5":14097,"_26932":55217,"_2867":55523},[],"The KMS refuses to delete a key that certificates still reference. Deleting a CA releases the references from its own current certificate and linked reissued certificates, then attempts to delete the key. If other certificates still reference the key, such as another CA sharing it, the KMS keeps it. Revoking certificates issued by the deleted CA does not release their own key references. Legacy references retained by the upgrade migration are described in the upgrade guide.",{"_3381":2341,"_29612":2341,"_5":14455,"_2867":55525,"_29965":55526,"_20544":55527,"_26932":2341},"Online validation with OCSP",[48231,49699,53708,54341],[],{"_3381":2342,"_29612":2341,"_20544":55529,"_5":14097,"_26932":2341,"_2867":55530},[],"Query signed status and verify the responder’s response.",{"_3381":2343,"_29612":2341,"_5":29962,"_20544":55532,"_26932":55533,"_2867":55534},[],"/docs/pr-preview/pr-53/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_3381":2344,"_29612":2341,"_5":29962,"_20544":55536,"_26932":55537,"_2867":55538},[],"/docs/pr-preview/pr-53/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_3381":2345,"_29612":2341,"_5":29962,"_20544":55540,"_26932":55541,"_2867":55542},[],"/docs/pr-preview/pr-53/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_3381":2346,"_29612":2341,"_5":29962,"_20544":55544,"_26932":55545,"_2867":55546},[],"/docs/pr-preview/pr-53/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_3381":2347,"_29612":2341,"_5":29962,"_20544":55548,"_26932":55549,"_2867":55550},[],"/docs/pr-preview/pr-53/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_3381":2348,"_29612":2341,"_5":29962,"_20544":55552,"_26932":55553,"_2867":54910},[],"/docs/pr-preview/pr-53/platform/pki/ocsp#references",{"_3381":2349,"_29612":2341,"_20544":55555,"_5":14097,"_26932":2341,"_2867":55556},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_3381":2350,"_29612":2341,"_20544":55558,"_5":14097,"_26932":55533,"_2867":55559},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_3381":2351,"_29612":2341,"_20544":55561,"_5":14097,"_26932":55533,"_2867":55562},[],"Record status",{"_3381":2352,"_29612":2341,"_20544":55564,"_5":14097,"_26932":55533,"_2867":55565},[],"Signed response",{"_3381":2353,"_29612":2341,"_20544":55567,"_5":14097,"_26932":55533,"_2867":52879},[],{"_3381":2354,"_29612":2341,"_20544":55569,"_5":14097,"_26932":55533,"_2867":55570},[],"`Good`.",{"_3381":2355,"_29612":2341,"_20544":55572,"_5":14097,"_26932":55533,"_2867":52896},[],{"_3381":2356,"_29612":2341,"_20544":55574,"_5":14097,"_26932":55533,"_2867":55575},[],"`Revoked`, with revocation reason and timestamp.",{"_3381":2357,"_29612":2341,"_20544":55577,"_5":14097,"_26932":55533,"_2867":55578},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_3381":2358,"_29612":2341,"_20544":55580,"_5":14097,"_26932":55533,"_2867":55581},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_3381":2359,"_29612":2341,"_20544":55583,"_5":14097,"_26932":55533,"_2867":55584},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_3381":2360,"_29612":2341,"_20544":55586,"_5":14097,"_26932":55533,"_2867":55587},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_3381":2361,"_29612":2341,"_20544":55589,"_5":14097,"_26932":55533,"_2867":55590},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_3381":2362,"_29612":2341,"_20544":55592,"_5":14097,"_26932":55537,"_2867":55593},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_3381":2363,"_29612":2341,"_20544":55595,"_5":14097,"_26932":55537,"_2867":55596},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_3381":2364,"_29612":2341,"_20544":55598,"_5":14097,"_26932":55541,"_2867":55599},[],"The service accepts:",{"_3381":2365,"_29612":2341,"_20544":55601,"_5":14097,"_26932":55541,"_2867":51466},[],{"_3381":2366,"_29612":2341,"_20544":55603,"_5":14097,"_26932":55541,"_2867":55604},[],"VA service path",{"_3381":2367,"_29612":2341,"_20544":55606,"_5":14097,"_26932":55541,"_2867":55607},[],"Format",{"_3381":2368,"_29612":2341,"_20544":55609,"_5":14097,"_26932":55541,"_2867":55610},[],"`POST`",{"_3381":2369,"_29612":2341,"_20544":55612,"_5":14097,"_26932":55541,"_2867":55613},[],"`/ocsp`",{"_3381":2370,"_29612":2341,"_20544":55615,"_5":14097,"_26932":55541,"_2867":55616},[],"DER request, `Content-Type: application/ocsp-request`.",{"_3381":2371,"_29612":2341,"_20544":55618,"_5":14097,"_26932":55541,"_2867":55039},[],{"_3381":2372,"_29612":2341,"_20544":55620,"_5":14097,"_26932":55541,"_2867":55621},[],"`/ocsp/{ocsp_request}`",{"_3381":2373,"_29612":2341,"_20544":55623,"_5":14097,"_26932":55541,"_2867":55624},[],"DER request encoded using padded URL Base64.",{"_3381":2374,"_29612":2341,"_20544":55626,"_5":14097,"_26932":55541,"_2867":55627},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_3381":2375,"_29612":2341,"_20544":55629,"_5":14097,"_26932":55545,"_2867":55630},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_3381":2376,"_29612":2341,"_20544":55632,"_5":14097,"_26932":55545,"_2867":55633},[],"Generate the request:",{"_3381":2377,"_29612":2341,"_20544":55635,"_5":14097,"_26932":55545,"_2867":55636},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_3381":2378,"_29612":2341,"_20544":55638,"_5":14097,"_26932":55545,"_2867":55639},[],"Replace the example URL with the inspected endpoint:",{"_3381":2379,"_29612":2341,"_20544":55641,"_5":14097,"_26932":55545,"_2867":55642},[],"Verify the returned DER:",{"_3381":2380,"_29612":2341,"_20544":55644,"_5":14097,"_26932":55545,"_2867":55645},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_3381":2381,"_29612":2341,"_20544":55647,"_5":14097,"_26932":55549,"_2867":55648},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_3381":2382,"_29612":2341,"_20544":55650,"_5":14097,"_26932":55549,"_2867":55651},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_3381":2383,"_29612":2341,"_20544":55653,"_5":14097,"_26932":55553,"_2867":55654},[],"RFC 6960: OCSP.",{"_3381":2384,"_29612":2341,"_20544":55656,"_5":14097,"_26932":55553,"_2867":55657},[],"OpenSSL: openssl-ocsp.",{"_3381":2385,"_29612":2341,"_20544":55659,"_5":14097,"_26932":55553,"_2867":55660},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_3381":2386,"_29612":2341,"_20544":55662,"_5":14097,"_26932":55553,"_2867":55131},[],{"_3381":2387,"_29612":2387,"_5":14455,"_2867":53708,"_29965":55664,"_20544":55665,"_26932":2387},[48231,49699,53708],[],{"_3381":2388,"_29612":2387,"_20544":55667,"_5":14097,"_26932":2387,"_2867":55668},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_3381":2389,"_29612":2387,"_5":29962,"_20544":55670,"_26932":55671,"_2867":53020},[],"/docs/pr-preview/pr-53/platform/pki/overview#start-here",{"_3381":2390,"_29612":2387,"_5":29962,"_20544":55673,"_26932":55674,"_2867":55675},[],"/docs/pr-preview/pr-53/platform/pki/overview#what-you-need","What you need",{"_3381":2391,"_29612":2387,"_5":29962,"_20544":55677,"_26932":55678,"_2867":53552},[],"/docs/pr-preview/pr-53/platform/pki/overview#core-capabilities",{"_3381":2392,"_29612":2387,"_5":29962,"_20544":55680,"_26932":55681,"_2867":53556},[],"/docs/pr-preview/pr-53/platform/pki/overview#build-your-trust-hierarchy",{"_3381":2393,"_29612":2387,"_5":29962,"_20544":55683,"_26932":55684,"_2867":53560},[],"/docs/pr-preview/pr-53/platform/pki/overview#protect-cryptographic-keys",{"_3381":2394,"_29612":2387,"_5":29962,"_20544":55686,"_26932":55687,"_2867":53564},[],"/docs/pr-preview/pr-53/platform/pki/overview#issue-and-control-certificates",{"_3381":2395,"_29612":2387,"_5":29962,"_20544":55689,"_26932":55690,"_2867":53572},[],"/docs/pr-preview/pr-53/platform/pki/overview#publish-validation-status",{"_3381":2396,"_29612":2387,"_5":29962,"_20544":55692,"_26932":55693,"_2867":55694},[],"/docs/pr-preview/pr-53/platform/pki/overview#how-to-check-the-result","How to check the result",{"_3381":2397,"_29612":2387,"_5":29962,"_20544":55696,"_26932":55697,"_2867":54508},[],"/docs/pr-preview/pr-53/platform/pki/overview#continue",{"_3381":2398,"_29612":2387,"_20544":55699,"_5":14097,"_26932":2387,"_2867":55700},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_3381":2399,"_29612":2387,"_20544":55702,"_5":14097,"_26932":55671,"_2867":55703},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_3381":2400,"_29612":2387,"_20544":55705,"_5":14097,"_26932":55671,"_2867":55706},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_3381":2401,"_29612":2387,"_20544":55708,"_5":14097,"_26932":55674,"_2867":55709},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_3381":2402,"_29612":2387,"_20544":55711,"_5":14097,"_26932":55674,"_2867":55712},[],"An available cryptographic engine to keep the authority's key.",{"_3381":2403,"_29612":2387,"_20544":55714,"_5":14097,"_26932":55674,"_2867":55715},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_3381":2404,"_29612":2387,"_20544":55717,"_5":14097,"_26932":55674,"_2867":55718},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_3381":2405,"_29612":2387,"_20544":55720,"_5":14097,"_26932":55674,"_2867":55721},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_3381":2406,"_29612":2387,"_20544":55723,"_5":14097,"_26932":55681,"_2867":55724},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_3381":2407,"_29612":2387,"_20544":55726,"_5":14097,"_26932":55684,"_2867":55727},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_3381":2408,"_29612":2387,"_20544":55729,"_5":14097,"_26932":55687,"_2867":55730},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_3381":2409,"_29612":2387,"_20544":55732,"_5":14097,"_26932":55690,"_2867":55733},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_3381":2410,"_29612":2387,"_20544":55735,"_5":14097,"_26932":55693,"_2867":55736},[],"An active certificate in the console is one part of the check. Also verify that:",{"_3381":2411,"_29612":2387,"_20544":55738,"_5":14097,"_26932":55693,"_2867":55739},[],"its subject and extensions identify the expected client;",{"_3381":2412,"_29612":2387,"_20544":55741,"_5":14097,"_26932":55693,"_2867":55742},[],"its public key matches the client's private key;",{"_3381":2413,"_29612":2387,"_20544":55744,"_5":14097,"_26932":55693,"_2867":55745},[],"its chain reaches a root trusted by the consumer;",{"_3381":2414,"_29612":2387,"_20544":55747,"_5":14097,"_26932":55693,"_2867":55748},[],"its dates and usages allow the operation;",{"_3381":2415,"_29612":2387,"_20544":55750,"_5":14097,"_26932":55693,"_2867":55751},[],"the consumer applies revocation checks and authorization.",{"_3381":2416,"_29612":2387,"_20544":55753,"_5":14097,"_26932":55693,"_2867":55754},[],"The issuance path includes the first independent checks.",{"_3381":2417,"_29612":2387,"_20544":55756,"_5":14097,"_26932":55697,"_2867":55757},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3381":2418,"_29612":2387,"_20544":55759,"_5":14097,"_26932":55697,"_2867":55760},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3381":2419,"_29612":2387,"_20544":55762,"_5":14097,"_26932":55697,"_2867":55763},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3381":2420,"_29612":2420,"_5":14455,"_2867":55765,"_29965":55766,"_20544":55767,"_26932":2420},"Create your first CA",[48231,49699,53708,53145],[],{"_3381":2421,"_29612":2420,"_20544":55769,"_5":14097,"_26932":2420,"_2867":55770},[],"Create an evaluation root and check its certificate before issuing.",{"_3381":2422,"_29612":2420,"_5":29962,"_20544":55772,"_26932":55773,"_2867":48241},[],"/docs/pr-preview/pr-53/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_3381":2423,"_29612":2420,"_5":29962,"_20544":55775,"_26932":55776,"_2867":55777},[],"/docs/pr-preview/pr-53/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard-toc","Open the creation wizard [!toc]",{"_3381":2424,"_29612":2420,"_5":29962,"_20544":55779,"_26932":55780,"_2867":55781},[],"/docs/pr-preview/pr-53/platform/pki/quickstarts/create-certificate-authority#select-the-key-toc","Select the key [!toc]",{"_3381":2425,"_29612":2420,"_5":29962,"_20544":55783,"_26932":55784,"_2867":55785},[],"/docs/pr-preview/pr-53/platform/pki/quickstarts/create-certificate-authority#define-the-authority-toc","Define the authority [!toc]",{"_3381":2426,"_29612":2420,"_5":29962,"_20544":55787,"_26932":55788,"_2867":55789},[],"/docs/pr-preview/pr-53/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca-toc","Review and create the CA [!toc]",{"_3381":2427,"_29612":2420,"_5":29962,"_20544":55791,"_26932":55792,"_2867":55793},[],"/docs/pr-preview/pr-53/platform/pki/quickstarts/create-certificate-authority#verify-the-result-toc","Verify the result [!toc]",{"_3381":2428,"_29612":2420,"_5":29962,"_20544":55795,"_26932":55796,"_2867":55797},[],"/docs/pr-preview/pr-53/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_3381":2429,"_29612":2420,"_5":29962,"_20544":55799,"_26932":55800,"_2867":53402},[],"/docs/pr-preview/pr-53/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_3381":2430,"_29612":2420,"_5":29962,"_20544":55802,"_26932":55803,"_2867":48265},[],"/docs/pr-preview/pr-53/platform/pki/quickstarts/create-certificate-authority#next-step",{"_3381":2431,"_29612":2420,"_20544":55805,"_5":14097,"_26932":2420,"_2867":55806},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_3381":2432,"_29612":2420,"_20544":55808,"_5":14097,"_26932":55773,"_2867":55809},[],"Console access and permission to create keys and authorities.",{"_3381":2433,"_29612":2420,"_20544":55811,"_5":14097,"_26932":55773,"_2867":55812},[],"An available cryptographic engine that supports the chosen algorithm.",{"_3381":2434,"_29612":2420,"_20544":55814,"_5":14097,"_26932":55773,"_2867":55815},[],"OpenSSL 3.x to check the downloaded certificate.",{"_3381":2435,"_29612":2420,"_20544":55817,"_5":14097,"_26932":55773,"_2867":55818},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_3381":2436,"_29612":2420,"_20544":55820,"_5":14097,"_26932":55776,"_2867":55821},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_3381":2437,"_29612":2420,"_20544":55823,"_5":14097,"_26932":55776,"_2867":55824},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_3381":2438,"_29612":2420,"_20544":55826,"_5":14097,"_26932":55780,"_2867":55827},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_3381":2439,"_29612":2420,"_20544":55829,"_5":14097,"_26932":55780,"_2867":55830},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_3381":2440,"_29612":2420,"_20544":55832,"_5":14097,"_26932":55784,"_2867":55833},[],"Select **Root CA** and complete:",{"_3381":2441,"_29612":2420,"_20544":55835,"_5":14097,"_26932":55784,"_2867":55836},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_3381":2442,"_29612":2420,"_20544":55838,"_5":14097,"_26932":55784,"_2867":55839},[],"**Subject**: organization and country details for your evaluation.",{"_3381":2443,"_29612":2420,"_20544":55841,"_5":14097,"_26932":55784,"_2867":55842},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_3381":2444,"_29612":2420,"_20544":55844,"_5":14097,"_26932":55784,"_2867":55845},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_3381":2445,"_29612":2420,"_20544":55847,"_5":14097,"_26932":55784,"_2867":55848},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_3381":2446,"_29612":2420,"_20544":55850,"_5":14097,"_26932":55788,"_2867":55851},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_3381":2447,"_29612":2420,"_20544":55853,"_5":14097,"_26932":55792,"_2867":55854},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_3381":2448,"_29612":2420,"_20544":55856,"_5":14097,"_26932":55792,"_2867":55857},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_3381":2449,"_29612":2420,"_20544":55859,"_5":14097,"_26932":55796,"_2867":55860},[],"Run from the directory where you saved `ca.pem`:",{"_3381":2450,"_29612":2420,"_20544":55862,"_5":14097,"_26932":55796,"_2867":55863},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_3381":2451,"_29612":2420,"_20544":55865,"_5":14097,"_26932":55796,"_2867":55866},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_3381":2452,"_29612":2420,"_20544":55868,"_5":14097,"_26932":55800,"_2867":55869},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_3381":2453,"_29612":2420,"_20544":55871,"_5":14097,"_26932":55800,"_2867":55872},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_3381":2454,"_29612":2420,"_20544":55874,"_5":14097,"_26932":55800,"_2867":55875},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_3381":2455,"_29612":2420,"_20544":55877,"_5":14097,"_26932":55800,"_2867":55878},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_3381":2456,"_29612":2420,"_20544":55880,"_5":14097,"_26932":55803,"_2867":55881},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_3381":2457,"_29612":2457,"_5":14455,"_2867":55883,"_29965":55884,"_20544":55885,"_26932":2457},"Issue and verify a certificate",[48231,49699,53708,53145],[],{"_3381":2458,"_29612":2457,"_20544":55887,"_5":14097,"_26932":2457,"_2867":55888},[],"Issue a client certificate and check content, chain and key correspondence.",{"_3381":2459,"_29612":2457,"_5":29962,"_20544":55890,"_26932":55891,"_2867":48241},[],"/docs/pr-preview/pr-53/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_3381":2460,"_29612":2457,"_5":29962,"_20544":55893,"_26932":55894,"_2867":55895},[],"/docs/pr-preview/pr-53/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_3381":2461,"_29612":2457,"_5":29962,"_20544":55897,"_26932":55898,"_2867":55899},[],"/docs/pr-preview/pr-53/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_3381":2462,"_29612":2457,"_5":29962,"_20544":55901,"_26932":55902,"_2867":55903},[],"/docs/pr-preview/pr-53/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_3381":2463,"_29612":2457,"_5":29962,"_20544":55905,"_26932":55906,"_2867":55907},[],"/docs/pr-preview/pr-53/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_3381":2464,"_29612":2457,"_5":29962,"_20544":55909,"_26932":55910,"_2867":55911},[],"/docs/pr-preview/pr-53/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_3381":2465,"_29612":2457,"_5":29962,"_20544":55913,"_26932":55914,"_2867":55915},[],"/docs/pr-preview/pr-53/platform/pki/quickstarts/issue-certificate#verify-the-result","Verify the result",{"_3381":2466,"_29612":2457,"_5":29962,"_20544":55917,"_26932":55918,"_2867":55919},[],"/docs/pr-preview/pr-53/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_3381":2467,"_29612":2457,"_5":29962,"_20544":55921,"_26932":55922,"_2867":55923},[],"/docs/pr-preview/pr-53/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_3381":2468,"_29612":2457,"_5":29962,"_20544":55925,"_26932":55926,"_2867":55927},[],"/docs/pr-preview/pr-53/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_3381":2469,"_29612":2457,"_5":29962,"_20544":55929,"_26932":55930,"_2867":53402},[],"/docs/pr-preview/pr-53/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_3381":2470,"_29612":2457,"_5":29962,"_20544":55932,"_26932":55933,"_2867":48265},[],"/docs/pr-preview/pr-53/platform/pki/quickstarts/issue-certificate#next-step",{"_3381":2471,"_29612":2457,"_20544":55935,"_5":14097,"_26932":2457,"_2867":55936},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_3381":2472,"_29612":2457,"_20544":55938,"_5":14097,"_26932":55891,"_2867":55939},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_3381":2473,"_29612":2457,"_20544":55941,"_5":14097,"_26932":55891,"_2867":55942},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_3381":2474,"_29612":2457,"_20544":55944,"_5":14097,"_26932":55891,"_2867":55945},[],"OpenSSL 3.x and a working directory with restricted access.",{"_3381":2475,"_29612":2457,"_20544":55947,"_5":14097,"_26932":55891,"_2867":55948},[],"A client identifier: here we use `device-001`.",{"_3381":2476,"_29612":2457,"_20544":55950,"_5":14097,"_26932":55891,"_2867":55951},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_3381":2477,"_29612":2457,"_20544":55953,"_5":14097,"_26932":55894,"_2867":55954},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_3381":2478,"_29612":2457,"_20544":55956,"_5":14097,"_26932":55898,"_2867":55957},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_3381":2479,"_29612":2457,"_20544":55959,"_5":14097,"_26932":55898,"_2867":55960},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_3381":2480,"_29612":2457,"_20544":55962,"_5":14097,"_26932":55902,"_2867":55963},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_3381":2481,"_29612":2457,"_20544":55965,"_5":14097,"_26932":55902,"_2867":55966},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_3381":2482,"_29612":2457,"_20544":55968,"_5":14097,"_26932":55906,"_2867":55969},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_3381":2483,"_29612":2457,"_20544":55971,"_5":14097,"_26932":55906,"_2867":55972},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_3381":2484,"_29612":2457,"_20544":55974,"_5":14097,"_26932":55910,"_2867":55975},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_3381":2485,"_29612":2457,"_20544":55977,"_5":14097,"_26932":55914,"_2867":55978},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_3381":2486,"_29612":2457,"_20544":55980,"_5":14097,"_26932":55918,"_2867":55981},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_3381":2487,"_29612":2457,"_20544":55983,"_5":14097,"_26932":55922,"_2867":55984},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_3381":2488,"_29612":2457,"_20544":55986,"_5":14097,"_26932":55922,"_2867":55987},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_3381":2489,"_29612":2457,"_20544":55989,"_5":14097,"_26932":55922,"_2867":55990},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_3381":2490,"_29612":2457,"_20544":55992,"_5":14097,"_26932":55926,"_2867":55993},[],"In Bash, compare the two public-key digests:",{"_3381":2491,"_29612":2457,"_20544":55995,"_5":14097,"_26932":55926,"_2867":55996},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_3381":2492,"_29612":2457,"_20544":55998,"_5":14097,"_26932":55926,"_2867":55999},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_3381":2493,"_29612":2457,"_20544":56001,"_5":14097,"_26932":55930,"_2867":53486},[],{"_3381":2494,"_29612":2457,"_20544":56003,"_5":14097,"_26932":55930,"_2867":56004},[],"What to review",{"_3381":2495,"_29612":2457,"_20544":56006,"_5":14097,"_26932":55930,"_2867":56007},[],"The CA rejects issuance",{"_3381":2496,"_29612":2457,"_20544":56009,"_5":14097,"_26932":55930,"_2867":56010},[],"Permissions, CA state and key, algorithm and profile.",{"_3381":2497,"_29612":2457,"_20544":56012,"_5":14097,"_26932":55930,"_2867":56013},[],"Different subject or usages",{"_3381":2498,"_29612":2457,"_20544":56015,"_5":14097,"_26932":55930,"_2867":56016},[],"Applied profile and requested values.",{"_3381":2499,"_29612":2457,"_20544":56018,"_5":14097,"_26932":55930,"_2867":56019},[],"Issuer cannot be found",{"_3381":2500,"_29612":2457,"_20544":56021,"_5":14097,"_26932":55930,"_2867":56022},[],"Downloaded CA and required intermediate chain.",{"_3381":2501,"_29612":2457,"_20544":56024,"_5":14097,"_26932":55930,"_2867":56025},[],"Validity fails",{"_3381":2502,"_29612":2457,"_20544":56027,"_5":14097,"_26932":55930,"_2867":56028},[],"Certificate and CA dates, and the computer's clock.",{"_3381":2503,"_29612":2457,"_20544":56030,"_5":14097,"_26932":55930,"_2867":56031},[],"Public-key digests differ",{"_3381":2504,"_29612":2457,"_20544":56033,"_5":14097,"_26932":55930,"_2867":56034},[],"Certificate and key files from the same issuance.",{"_3381":2505,"_29612":2457,"_20544":56036,"_5":14097,"_26932":55930,"_2867":56037},[],"See PKI diagnostics to narrow an issuance failure.",{"_3381":2506,"_29612":2457,"_20544":56039,"_5":14097,"_26932":55933,"_2867":56040},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_3381":2507,"_29612":2457,"_20544":56042,"_5":14097,"_26932":55933,"_2867":56043},[],"Manage certificates for inspection, status and revocation.",{"_3381":2508,"_29612":2457,"_20544":56045,"_5":14097,"_26932":55933,"_2867":56046},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_3381":2509,"_29612":2457,"_20544":56048,"_5":14097,"_26932":55933,"_2867":56049},[],"Prepare EST for the device to request its next identities.",{"_3381":2510,"_29612":2457,"_20544":56051,"_5":14097,"_26932":55933,"_2867":56052},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_3381":2511,"_29612":2511,"_5":14455,"_2867":56054,"_29965":56055,"_20544":56056,"_26932":2511},"PKI getting started",[48231,49699,53708,53145],[],{"_3381":2512,"_29612":2511,"_20544":56058,"_5":14097,"_26932":2511,"_2867":56059},[],"Create a CA, issue a client certificate and check its chain and key.",{"_3381":2513,"_29612":2511,"_5":29962,"_20544":56061,"_26932":56062,"_2867":48241},[],"/docs/pr-preview/pr-53/platform/pki/quickstarts/overview#before-you-begin",{"_3381":2514,"_29612":2511,"_5":29962,"_20544":56064,"_26932":56065,"_2867":56066},[],"/docs/pr-preview/pr-53/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_3381":2515,"_29612":2511,"_5":29962,"_20544":56068,"_26932":56069,"_2867":53337},[],"/docs/pr-preview/pr-53/platform/pki/quickstarts/overview#expected-result",{"_3381":2516,"_29612":2511,"_5":29962,"_20544":56071,"_26932":56072,"_2867":56073},[],"/docs/pr-preview/pr-53/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_3381":2517,"_29612":2511,"_20544":56075,"_5":14097,"_26932":2511,"_2867":56076},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_3381":2518,"_29612":2511,"_20544":56078,"_5":14097,"_26932":56062,"_2867":56079},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_3381":2519,"_29612":2511,"_20544":56081,"_5":14097,"_26932":56062,"_2867":56082},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_3381":2520,"_29612":2511,"_20544":56084,"_5":14097,"_26932":56062,"_2867":56085},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_3381":2521,"_29612":2511,"_20544":56087,"_5":14097,"_26932":56062,"_2867":56088},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_3381":2522,"_29612":2511,"_20544":56090,"_5":14097,"_26932":56062,"_2867":56091},[],"A working directory with restricted access for the downloaded key.",{"_3381":2523,"_29612":2511,"_20544":56093,"_5":14097,"_26932":56065,"_2867":56094},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3381":2524,"_29612":2511,"_20544":56096,"_5":14097,"_26932":56065,"_2867":56097},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3381":2525,"_29612":2511,"_20544":56099,"_5":14097,"_26932":56065,"_2867":56100},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_3381":2526,"_29612":2511,"_20544":56102,"_5":14097,"_26932":56065,"_2867":56103},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_3381":2527,"_29612":2511,"_20544":56105,"_5":14097,"_26932":56069,"_2867":56106},[],"File or resource",{"_3381":2528,"_29612":2511,"_20544":56108,"_5":14097,"_26932":56069,"_2867":53334},[],{"_3381":2529,"_29612":2511,"_20544":56110,"_5":14097,"_26932":56069,"_2867":56111},[],"Active root CA and `ca.pem`",{"_3381":2530,"_29612":2511,"_20544":56113,"_5":14097,"_26932":56069,"_2867":56114},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_3381":2531,"_29612":2511,"_20544":56116,"_5":14097,"_26932":56069,"_2867":56117},[],"End-entity certificate and `device.crt`",{"_3381":2532,"_29612":2511,"_20544":56119,"_5":14097,"_26932":56069,"_2867":56120},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_3381":2533,"_29612":2511,"_20544":56122,"_5":14097,"_26932":56069,"_2867":56123},[],"Private key `device.key`",{"_3381":2534,"_29612":2511,"_20544":56125,"_5":14097,"_26932":56069,"_2867":56126},[],"Its public key matches the one included in `device.crt`.",{"_3381":2535,"_29612":2511,"_20544":56128,"_5":14097,"_26932":56069,"_2867":56129},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_3381":2536,"_29612":2511,"_20544":56131,"_5":14097,"_26932":56072,"_2867":56132},[],"To operate certificates, continue with Certificates and Validation.",{"_3381":2537,"_29612":2511,"_20544":56134,"_5":14097,"_26932":56072,"_2867":56135},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_3381":2538,"_29612":2511,"_20544":56137,"_5":14097,"_26932":56072,"_2867":56138},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_3381":2539,"_29612":2539,"_5":14455,"_2867":56140,"_29965":56141,"_20544":56142,"_26932":2539},"PKI troubleshooting",[48231,49699,53708,52280],[],{"_3381":2540,"_29612":2539,"_20544":56144,"_5":14097,"_26932":2539,"_2867":56145},[],"Diagnose certificate issuance, OCSP and CRL.",{"_3381":2541,"_29612":2539,"_5":29962,"_20544":56147,"_26932":56148,"_2867":56149},[],"/docs/pr-preview/pr-53/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_3381":2542,"_29612":2539,"_5":29962,"_20544":56151,"_26932":56152,"_2867":56153},[],"/docs/pr-preview/pr-53/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_3381":2543,"_29612":2539,"_5":29962,"_20544":56155,"_26932":56156,"_2867":56157},[],"/docs/pr-preview/pr-53/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_3381":2544,"_29612":2539,"_20544":56159,"_5":14097,"_26932":2539,"_2867":56160},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_3381":2545,"_29612":2539,"_20544":56162,"_5":14097,"_26932":2539,"_2867":56163},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_3381":2546,"_29612":2539,"_20544":56165,"_5":14097,"_26932":56148,"_2867":53334},[],{"_3381":2547,"_29612":2539,"_20544":56167,"_5":14097,"_26932":56148,"_2867":56168},[],"What to inspect",{"_3381":2548,"_29612":2539,"_20544":56170,"_5":14097,"_26932":56148,"_2867":48265},[],{"_3381":2549,"_29612":2539,"_20544":56172,"_5":14097,"_26932":56148,"_2867":52547},[],{"_3381":2550,"_29612":2539,"_20544":56174,"_5":14097,"_26932":56148,"_2867":56175},[],"Exists, is active and has usable dates.",{"_3381":2551,"_29612":2539,"_20544":56177,"_5":14097,"_26932":56148,"_2867":56178},[],"Authorities.",{"_3381":2552,"_29612":2539,"_20544":56180,"_5":14097,"_26932":56148,"_2867":56181},[],"Key",{"_3381":2553,"_29612":2539,"_20544":56183,"_5":14097,"_26932":56148,"_2867":56184},[],"The record has a usable private key and the engine can sign.",{"_3381":2554,"_29612":2539,"_20544":56186,"_5":14097,"_26932":56148,"_2867":56187},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_3381":2555,"_29612":2539,"_20544":56189,"_5":14097,"_26932":56148,"_2867":56190},[],"CSR",{"_3381":2556,"_29612":2539,"_20544":56192,"_5":14097,"_26932":56148,"_2867":56193},[],"Correct PEM and verifiable signature.",{"_3381":2557,"_29612":2539,"_20544":56195,"_5":14097,"_26932":56148,"_2867":56196},[],"`openssl req -in request.csr -noout -verify -text`.",{"_3381":2558,"_29612":2539,"_20544":56198,"_5":14097,"_26932":56148,"_2867":56199},[],"Profile",{"_3381":2559,"_29612":2539,"_20544":56201,"_5":14097,"_26932":56148,"_2867":56202},[],"Selected source, existing ID, allowed algorithm and size.",{"_3381":2560,"_29612":2539,"_20544":56204,"_5":14097,"_26932":56148,"_2867":56205},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_3381":2561,"_29612":2539,"_20544":56207,"_5":14097,"_26932":56148,"_2867":53486},[],{"_3381":2562,"_29612":2539,"_20544":56209,"_5":14097,"_26932":56148,"_2867":56210},[],"Appropriate subject, SAN, usages and dates.",{"_3381":2563,"_29612":2539,"_20544":56212,"_5":14097,"_26932":56148,"_2867":56213},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_3381":2564,"_29612":2539,"_20544":56215,"_5":14097,"_26932":56148,"_2867":56216},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_3381":2565,"_29612":2539,"_20544":56218,"_5":14097,"_26932":56148,"_2867":56219},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation.",{"_3381":2566,"_29612":2539,"_20544":56221,"_5":14097,"_26932":56152,"_2867":56222},[],"Check each boundary independently:",{"_3381":2567,"_29612":2539,"_20544":56224,"_5":14097,"_26932":56152,"_2867":56225},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_3381":2568,"_29612":2539,"_20544":56227,"_5":14097,"_26932":56152,"_2867":56228},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_3381":2569,"_29612":2539,"_20544":56230,"_5":14097,"_26932":56152,"_2867":56231},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_3381":2570,"_29612":2539,"_20544":56233,"_5":14097,"_26932":56152,"_2867":56234},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_3381":2571,"_29612":2539,"_20544":56236,"_5":14097,"_26932":56152,"_2867":56237},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_3381":2572,"_29612":2539,"_20544":56239,"_5":14097,"_26932":56152,"_2867":56240},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_3381":2573,"_29612":2539,"_20544":56242,"_5":14097,"_26932":56156,"_2867":56243},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_3381":2574,"_29612":2539,"_20544":56245,"_5":14097,"_26932":56156,"_2867":56246},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_3381":2575,"_29612":2575,"_5":14455,"_2867":56248,"_29965":56249,"_20544":56250,"_26932":2575},"Security",[48231],[],{"_3381":2576,"_29612":2575,"_20544":56252,"_5":14097,"_26932":2575,"_2867":56253},[],"How to report a security vulnerability in Lamassu privately, what to include in a report and which releases receive security fixes.",{"_3381":2577,"_29612":2575,"_5":29962,"_20544":56255,"_26932":56256,"_2867":56257},[],"/docs/pr-preview/pr-53/security#report-a-vulnerability","Report a vulnerability",{"_3381":2578,"_29612":2575,"_5":29962,"_20544":56259,"_26932":56260,"_2867":56261},[],"/docs/pr-preview/pr-53/security#what-to-include-in-a-report","What to include in a report",{"_3381":2579,"_29612":2575,"_5":29962,"_20544":56263,"_26932":56264,"_2867":56265},[],"/docs/pr-preview/pr-53/security#supported-versions","Supported versions",{"_3381":2580,"_29612":2575,"_5":29962,"_20544":56267,"_26932":56268,"_2867":56269},[],"/docs/pr-preview/pr-53/security#responsible-disclosure","Responsible disclosure",{"_3381":2581,"_29612":2575,"_20544":56271,"_5":14097,"_26932":2575,"_2867":56272},[],"Found a security vulnerability in lamassuiot, lamassu-dashboard, or lamassu-helm? This page explains how to report it privately, what to include in your report and which releases receive security fixes.",{"_3381":2582,"_29612":2575,"_20544":56274,"_5":14097,"_26932":56256,"_2867":56275},[],"Do not report security vulnerabilities through public GitHub issues, discussions, or pull requests. Public reports disclose the problem before maintainers can fix it.",{"_3381":2583,"_29612":2575,"_20544":56277,"_5":14097,"_26932":56256,"_2867":56278},[],"Instead, report privately using GitHub Security Advisories for the affected repository:",{"_3381":2584,"_29612":2575,"_20544":56280,"_5":14097,"_26932":56256,"_2867":14722},[],{"_3381":2585,"_29612":2575,"_20544":56282,"_5":14097,"_26932":56256,"_2867":14668},[],{"_3381":2586,"_29612":2575,"_20544":56284,"_5":14097,"_26932":56256,"_2867":14715},[],{"_3381":2587,"_29612":2575,"_20544":56286,"_5":14097,"_26932":56256,"_2867":56287},[],"This lets maintainers assess and address the issue before it is publicly disclosed.",{"_3381":2588,"_29612":2575,"_20544":56289,"_5":14097,"_26932":56256,"_2867":56290},[],"If private vulnerability reporting is not enabled for that repository, report the vulnerability privately to lamassuiot\\@lksnext.com before disclosing any details publicly.",{"_3381":2589,"_29612":2575,"_20544":56292,"_5":14097,"_26932":56260,"_2867":56293},[],"Describe the vulnerability, its potential impact, and steps to reproduce it using non-sensitive, redacted examples.",{"_3381":2590,"_29612":2575,"_20544":56295,"_5":14097,"_26932":56260,"_2867":56296},[],"Do not include in the report:",{"_3381":2591,"_29612":2575,"_20544":56298,"_5":14097,"_26932":56260,"_2867":56299},[],"Credentials, tokens, or private keys",{"_3381":2592,"_29612":2575,"_20544":56301,"_5":14097,"_26932":56260,"_2867":56302},[],"Customer data or customer-identifiable information",{"_3381":2593,"_29612":2575,"_20544":56304,"_5":14097,"_26932":56260,"_2867":56305},[],"Confidential architecture or internal infrastructure details",{"_3381":2594,"_29612":2575,"_20544":56307,"_5":14097,"_26932":56264,"_2867":56308},[],"Only the latest stable release receives security support. Support for a stable release ends when the next stable release is published. Older releases and pre-releases are not supported.",{"_3381":2595,"_29612":2575,"_20544":56310,"_5":14097,"_26932":56264,"_2867":56311},[],"For upgrade guidance, see Upgrades.",{"_3381":2596,"_29612":2575,"_20544":56313,"_5":14097,"_26932":56268,"_2867":56314},[],"Give maintainers reasonable time to investigate and address a reported vulnerability before any public disclosure.",{"_3381":2597,"_29612":2575,"_20544":56316,"_5":14097,"_26932":56268,"_2867":56317},[],"Avoid privacy violations, data destruction, and service disruption while researching a vulnerability.",{"_3381":2598,"_29612":2575,"_20544":56319,"_5":14097,"_26932":56268,"_2867":56320},[],"Only interact with accounts or data you own, or for which you have explicit permission.",{"_3381":2599,"_29612":2575,"_20544":56322,"_5":14097,"_26932":56268,"_2867":56323},[],"Maintainers acknowledge reports in a timely manner and keep you informed of remediation progress.",{"_3381":2600,"_29612":2575,"_20544":56325,"_5":14097,"_26932":56268,"_2867":56326},[],"This policy covers the source code, configuration, and CI/CD workflows of the lamassuiot, lamassu-dashboard, and lamassu-helm repositories.",{"_3381":2601,"_29612":2601,"_5":14455,"_2867":56328,"_29965":56329,"_20544":56331,"_26932":2601},"3.8.0 to 4.0.0",[48231,56330],"Upgrades",[],{"_3381":2602,"_29612":2601,"_20544":56333,"_5":14097,"_26932":2601,"_2867":56334},[],"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result.",{"_3381":2603,"_29612":2601,"_5":29962,"_20544":56336,"_26932":56337,"_2867":56338},[],"/docs/pr-preview/pr-53/upgrades/3-8-0-to-4-0-0#architecture-changes","Architecture changes",{"_3381":2604,"_29612":2601,"_5":29962,"_20544":56340,"_26932":56341,"_2867":56342},[],"/docs/pr-preview/pr-53/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_3381":2605,"_29612":2601,"_5":29962,"_20544":56344,"_26932":56345,"_2867":56346},[],"/docs/pr-preview/pr-53/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_3381":2606,"_29612":2601,"_5":29962,"_20544":56348,"_26932":56349,"_2867":56350},[],"/docs/pr-preview/pr-53/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_3381":2607,"_29612":2601,"_5":29962,"_20544":56352,"_26932":56353,"_2867":56354},[],"/docs/pr-preview/pr-53/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_3381":2608,"_29612":2601,"_5":29962,"_20544":56356,"_26932":56357,"_2867":56358},[],"/docs/pr-preview/pr-53/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_3381":2609,"_29612":2601,"_5":29962,"_20544":56360,"_26932":56361,"_2867":56362},[],"/docs/pr-preview/pr-53/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_3381":2610,"_29612":2601,"_5":29962,"_20544":56364,"_26932":56365,"_2867":56366},[],"/docs/pr-preview/pr-53/upgrades/3-8-0-to-4-0-0#helm-chart-and-values","Helm chart and values",{"_3381":2611,"_29612":2601,"_5":29962,"_20544":56368,"_26932":56369,"_2867":56370},[],"/docs/pr-preview/pr-53/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_3381":2612,"_29612":2601,"_5":29962,"_20544":56372,"_26932":56373,"_2867":56374},[],"/docs/pr-preview/pr-53/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_3381":2613,"_29612":2601,"_5":29962,"_20544":56376,"_26932":56377,"_2867":56378},[],"/docs/pr-preview/pr-53/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_3381":2614,"_29612":2601,"_5":29962,"_20544":56380,"_26932":56381,"_2867":56382},[],"/docs/pr-preview/pr-53/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_3381":2615,"_29612":2601,"_5":29962,"_20544":56384,"_26932":56385,"_2867":56386},[],"/docs/pr-preview/pr-53/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_3381":2616,"_29612":2601,"_5":29962,"_20544":56388,"_26932":56389,"_2867":56390},[],"/docs/pr-preview/pr-53/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_3381":2617,"_29612":2601,"_5":29962,"_20544":56392,"_26932":56393,"_2867":56394},[],"/docs/pr-preview/pr-53/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_3381":2618,"_29612":2601,"_5":29962,"_20544":56396,"_26932":56397,"_2867":56398},[],"/docs/pr-preview/pr-53/upgrades/3-8-0-to-4-0-0#data-and-storage","Data and storage",{"_3381":2619,"_29612":2601,"_5":29962,"_20544":56400,"_26932":56401,"_2867":56402},[],"/docs/pr-preview/pr-53/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_3381":2620,"_29612":2601,"_5":29962,"_20544":56404,"_26932":56405,"_2867":56406},[],"/docs/pr-preview/pr-53/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","SQLite storage removed",{"_3381":2621,"_29612":2601,"_5":29962,"_20544":56408,"_26932":56409,"_2867":56410},[],"/docs/pr-preview/pr-53/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_3381":2622,"_29612":2601,"_5":29962,"_20544":56412,"_26932":56413,"_2867":56414},[],"/docs/pr-preview/pr-53/upgrades/3-8-0-to-4-0-0#references-between-certificates-keys-and-va-roles","References between certificates, keys and VA roles",{"_3381":2623,"_29612":2601,"_5":29962,"_20544":56416,"_26932":56417,"_2867":56418},[],"/docs/pr-preview/pr-53/upgrades/3-8-0-to-4-0-0#apis-and-stored-configuration","APIs and stored configuration",{"_3381":2624,"_29612":2601,"_5":29962,"_20544":56420,"_26932":56421,"_2867":56422},[],"/docs/pr-preview/pr-53/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_3381":2625,"_29612":2601,"_5":29962,"_20544":56424,"_26932":56425,"_2867":56426},[],"/docs/pr-preview/pr-53/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_3381":2626,"_29612":2601,"_5":29962,"_20544":56428,"_26932":56429,"_2867":56430},[],"/docs/pr-preview/pr-53/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_3381":2627,"_29612":2601,"_5":29962,"_20544":56432,"_26932":56433,"_2867":56434},[],"/docs/pr-preview/pr-53/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_3381":2628,"_29612":2601,"_5":29962,"_20544":56436,"_26932":56437,"_2867":56438},[],"/docs/pr-preview/pr-53/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_3381":2629,"_29612":2601,"_5":29962,"_20544":56440,"_26932":56441,"_2867":56442},[],"/docs/pr-preview/pr-53/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_3381":2630,"_29612":2601,"_5":29962,"_20544":56444,"_26932":56445,"_2867":56446},[],"/docs/pr-preview/pr-53/upgrades/3-8-0-to-4-0-0#va-role-signer-field","VA role signer field",{"_3381":2631,"_29612":2601,"_5":29962,"_20544":56448,"_26932":56449,"_2867":56450},[],"/docs/pr-preview/pr-53/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_3381":2632,"_29612":2601,"_5":29962,"_20544":56452,"_26932":56453,"_2867":56454},[],"/docs/pr-preview/pr-53/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_3381":2633,"_29612":2601,"_5":29962,"_20544":56456,"_26932":56457,"_2867":56458},[],"/docs/pr-preview/pr-53/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_3381":2634,"_29612":2601,"_5":29962,"_20544":56460,"_26932":56461,"_2867":56462},[],"/docs/pr-preview/pr-53/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_3381":2635,"_29612":2601,"_5":29962,"_20544":56464,"_26932":56465,"_2867":56466},[],"/docs/pr-preview/pr-53/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_3381":2636,"_29612":2601,"_5":29962,"_20544":56468,"_26932":56469,"_2867":56470},[],"/docs/pr-preview/pr-53/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_3381":2637,"_29612":2601,"_5":29962,"_20544":56472,"_26932":56473,"_2867":56474},[],"/docs/pr-preview/pr-53/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_3381":2638,"_29612":2601,"_5":29962,"_20544":56476,"_26932":56477,"_2867":52280},[],"/docs/pr-preview/pr-53/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_3381":2639,"_29612":2601,"_5":29962,"_20544":56479,"_26932":56480,"_2867":56481},[],"/docs/pr-preview/pr-53/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_3381":2640,"_29612":2601,"_5":29962,"_20544":56483,"_26932":56484,"_2867":56485},[],"/docs/pr-preview/pr-53/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_3381":2641,"_29612":2601,"_20544":56487,"_5":14097,"_26932":2601,"_2867":56488},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_3381":2642,"_29612":2601,"_20544":56490,"_5":14097,"_26932":2601,"_2867":56491},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_3381":2643,"_29612":2601,"_20544":56493,"_5":14097,"_26932":2601,"_2867":56494},[],"Architecture changes: what is different in 4.0.0 and what the upgrade migrates on its own.",{"_3381":2644,"_29612":2601,"_20544":56496,"_5":14097,"_26932":2601,"_2867":56497},[],"Breaking changes: every change that can break a 3.8.0 deployment, who it affects and what to do.",{"_3381":2645,"_29612":2601,"_20544":56499,"_5":14097,"_26932":2601,"_2867":56500},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_3381":2646,"_29612":2601,"_20544":56502,"_5":14097,"_26932":2601,"_2867":56503},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_3381":2647,"_29612":2601,"_20544":56505,"_5":14097,"_26932":2601,"_2867":56506},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_3381":2648,"_29612":2601,"_20544":56508,"_5":14097,"_26932":56341,"_2867":56509},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_3381":2649,"_29612":2601,"_20544":56511,"_5":14097,"_26932":56341,"_2867":56512},[],"PostgreSQL is now the only storage engine. SQLite support is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0.",{"_3381":2650,"_29612":2601,"_20544":56514,"_5":14097,"_26932":56345,"_2867":56515},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_3381":2651,"_29612":2601,"_20544":56517,"_5":14097,"_26932":56345,"_2867":56518},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and VA roles. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_3381":2652,"_29612":2601,"_20544":56520,"_5":14097,"_26932":56349,"_2867":56521},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. The events endpoint can also stream events over Server-Sent Events (SSE); to fan events out across service instances, each Device Manager instance binds its own durable AMQP queue.",{"_3381":2653,"_29612":2601,"_20544":56523,"_5":14097,"_26932":56353,"_2867":56524},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_3381":2654,"_29612":2601,"_20544":56526,"_5":14097,"_26932":56353,"_2867":56527},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_3381":2655,"_29612":2601,"_20544":56529,"_5":14097,"_26932":56353,"_2867":56530},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_3381":2656,"_29612":2601,"_20544":56532,"_5":14097,"_26932":56353,"_2867":56533},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_3381":2657,"_29612":2601,"_20544":56535,"_5":14097,"_26932":56353,"_2867":56536},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_3381":2658,"_29612":2601,"_20544":56538,"_5":14097,"_26932":56357,"_2867":56539},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_3381":2659,"_29612":2601,"_20544":56541,"_5":14097,"_26932":56357,"_2867":56542},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_3381":2660,"_29612":2601,"_20544":56544,"_5":14097,"_26932":56357,"_2867":56545},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_3381":2661,"_29612":2601,"_20544":56547,"_5":14097,"_26932":56357,"_2867":56548},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_3381":2662,"_29612":2601,"_20544":56550,"_5":14097,"_26932":56357,"_2867":56551},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_3381":2663,"_29612":2601,"_20544":56553,"_5":14097,"_26932":56361,"_2867":56554},[],"Change",{"_3381":2664,"_29612":2601,"_20544":56556,"_5":14097,"_26932":56361,"_2867":56557},[],"Who is affected",{"_3381":2665,"_29612":2601,"_20544":56559,"_5":14097,"_26932":56361,"_2867":56560},[],"Severity",{"_3381":2666,"_29612":2601,"_20544":56562,"_5":14097,"_26932":56361,"_2867":55068},[],{"_3381":2667,"_29612":2601,"_20544":56564,"_5":14097,"_26932":56361,"_2867":56370},[],{"_3381":2668,"_29612":2601,"_20544":56566,"_5":14097,"_26932":56361,"_2867":56567},[],"Helm releases with a filesystem KMS engine or local VA CRL storage",{"_3381":2669,"_29612":2601,"_20544":56569,"_5":14097,"_26932":56361,"_2867":56570},[],"High: KMS and VA start on empty volumes",{"_3381":2670,"_29612":2601,"_20544":56572,"_5":14097,"_26932":56361,"_2867":56573},[],"Copy the data into the new volumes",{"_3381":2671,"_29612":2601,"_20544":56575,"_5":14097,"_26932":56361,"_2867":56374},[],{"_3381":2672,"_29612":2601,"_20544":56577,"_5":14097,"_26932":56361,"_2867":56578},[],"Every Helm release",{"_3381":2673,"_29612":2601,"_20544":56580,"_5":14097,"_26932":56361,"_2867":56581},[],"High: `helm upgrade` fails",{"_3381":2674,"_29612":2601,"_20544":56583,"_5":14097,"_26932":56361,"_2867":56584},[],"Remove or rename legacy keys",{"_3381":2675,"_29612":2601,"_20544":56586,"_5":14097,"_26932":56361,"_2867":56378},[],{"_3381":2676,"_29612":2601,"_20544":56588,"_5":14097,"_26932":56361,"_2867":56589},[],"Every deployment",{"_3381":2677,"_29612":2601,"_20544":56591,"_5":14097,"_26932":56361,"_2867":56592},[],"High: without a bootstrap principal there is no administrator",{"_3381":2678,"_29612":2601,"_20544":56594,"_5":14097,"_26932":56361,"_2867":56595},[],"Configure `services.authz`",{"_3381":2679,"_29612":2601,"_20544":56597,"_5":14097,"_26932":56361,"_2867":56382},[],{"_3381":2680,"_29612":2601,"_20544":56599,"_5":14097,"_26932":56361,"_2867":56578},[],{"_3381":2681,"_29612":2601,"_20544":56601,"_5":14097,"_26932":56361,"_2867":56602},[],"High: `helm upgrade` fails on the old keys",{"_3381":2682,"_29612":2601,"_20544":56604,"_5":14097,"_26932":56361,"_2867":56605},[],"Move JWKS and roles into `services.authz`",{"_3381":2683,"_29612":2601,"_20544":56607,"_5":14097,"_26932":56361,"_2867":56402},[],{"_3381":2684,"_29612":2601,"_20544":56609,"_5":14097,"_26932":56361,"_2867":56610},[],"3.8.0 deployments with per-service databases",{"_3381":2685,"_29612":2601,"_20544":56612,"_5":14097,"_26932":56361,"_2867":56613},[],"High: services find no data, or a migration aborts",{"_3381":2686,"_29612":2601,"_20544":56615,"_5":14097,"_26932":56361,"_2867":56616},[],"Clean duplicate CA IDs and empty `engine_id` values first; move data manually outside Helm",{"_3381":2687,"_29612":2601,"_20544":56618,"_5":14097,"_26932":56361,"_2867":56406},[],{"_3381":2688,"_29612":2601,"_20544":56620,"_5":14097,"_26932":56361,"_2867":56621},[],"Deployments on SQLite, `couch_db` or `dynamo_db`",{"_3381":2689,"_29612":2601,"_20544":56623,"_5":14097,"_26932":56361,"_2867":56624},[],"High: the backend no longer starts with them",{"_3381":2690,"_29612":2601,"_20544":56626,"_5":14097,"_26932":56361,"_2867":56627},[],"Move to PostgreSQL before upgrading",{"_3381":2691,"_29612":2601,"_20544":56629,"_5":14097,"_26932":56361,"_2867":56630},[],"Webhooks with file references",{"_3381":2692,"_29612":2601,"_20544":56632,"_5":14097,"_26932":56361,"_2867":56633},[],"DMSs whose webhook mTLS certificate or key were file paths",{"_3381":2693,"_29612":2601,"_20544":56635,"_5":14097,"_26932":56361,"_2867":56636},[],"High: enrollments calling the webhook fail",{"_3381":2694,"_29612":2601,"_20544":56638,"_5":14097,"_26932":56361,"_2867":56639},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_3381":2695,"_29612":2601,"_20544":56641,"_5":14097,"_26932":56361,"_2867":56386},[],{"_3381":2696,"_29612":2601,"_20544":56643,"_5":14097,"_26932":56361,"_2867":56644},[],"Releases with per-service identity overrides or mounted key material",{"_3381":2697,"_29612":2601,"_20544":56646,"_5":14097,"_26932":56361,"_2867":56647},[],"Medium: services cannot read their files",{"_3381":2698,"_29612":2601,"_20544":56649,"_5":14097,"_26932":56361,"_2867":56650},[],"Remove the overrides and fix volume ownership",{"_3381":2699,"_29612":2601,"_20544":56652,"_5":14097,"_26932":56361,"_2867":56390},[],{"_3381":2700,"_29612":2601,"_20544":56654,"_5":14097,"_26932":56361,"_2867":56655},[],"Releases that set `amqp.tls`",{"_3381":2701,"_29612":2601,"_20544":56657,"_5":14097,"_26932":56361,"_2867":56658},[],"Medium: clients connect to the wrong port",{"_3381":2702,"_29612":2601,"_20544":56660,"_5":14097,"_26932":56361,"_2867":56661},[],"Point `amqp.port` at the TLS listener, or disable TLS",{"_3381":2703,"_29612":2601,"_20544":56663,"_5":14097,"_26932":56361,"_2867":56410},[],{"_3381":2704,"_29612":2601,"_20544":56665,"_5":14097,"_26932":56361,"_2867":56666},[],"Installations whose CA keys predate the KMS",{"_3381":2705,"_29612":2601,"_20544":56668,"_5":14097,"_26932":56361,"_2867":56669},[],"Medium: CA keys stay unmanaged",{"_3381":2706,"_29612":2601,"_20544":56671,"_5":14097,"_26932":56361,"_2867":56672},[],"Run the CA-to-KMS migration",{"_3381":2707,"_29612":2601,"_20544":56674,"_5":14097,"_26932":56361,"_2867":56675},[],"Receiver certificate verification",{"_3381":2708,"_29612":2601,"_20544":56677,"_5":14097,"_26932":56361,"_2867":56678},[],"DMSs whose webhook had `validate_server_cert: false`",{"_3381":2709,"_29612":2601,"_20544":56680,"_5":14097,"_26932":56361,"_2867":56681},[],"Medium: credentials go to an unverified receiver",{"_3381":2710,"_29612":2601,"_20544":56683,"_5":14097,"_26932":56361,"_2867":56684},[],"Set `insecure_skip_verify` to `false`",{"_3381":2711,"_29612":2601,"_20544":56686,"_5":14097,"_26932":56361,"_2867":56426},[],{"_3381":2712,"_29612":2601,"_20544":56688,"_5":14097,"_26932":56361,"_2867":56689},[],"Scripts and consoles that edit DMSs through the API",{"_3381":2713,"_29612":2601,"_20544":56691,"_5":14097,"_26932":56361,"_2867":56692},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_3381":2714,"_29612":2601,"_20544":56694,"_5":14097,"_26932":56361,"_2867":56695},[],"Read the DMS before editing and use the new field",{"_3381":2715,"_29612":2601,"_20544":56697,"_5":14097,"_26932":56361,"_2867":56446},[],{"_3381":2716,"_29612":2601,"_20544":56699,"_5":14097,"_26932":56361,"_2867":56700},[],"Clients that create or update VA roles through the API",{"_3381":2717,"_29612":2601,"_20544":56702,"_5":14097,"_26932":56361,"_2867":56703},[],"Medium: requests with the old field return an error",{"_3381":2718,"_29612":2601,"_20544":56705,"_5":14097,"_26932":56361,"_2867":56706},[],"Replace `crl_options.subject_key_id_signer` with the required `crl_options.signer_certificate_serial_number`",{"_3381":2719,"_29612":2601,"_20544":56708,"_5":14097,"_26932":56361,"_2867":56442},[],{"_3381":2720,"_29612":2601,"_20544":56710,"_5":14097,"_26932":56361,"_2867":56711},[],"Consumers that read the device `events` field",{"_3381":2721,"_29612":2601,"_20544":56713,"_5":14097,"_26932":56361,"_2867":56714},[],"Medium: the field disappears",{"_3381":2722,"_29612":2601,"_20544":56716,"_5":14097,"_26932":56361,"_2867":56717},[],"Use the new event endpoints",{"_3381":2723,"_29612":2601,"_20544":56719,"_5":14097,"_26932":56361,"_2867":56394},[],{"_3381":2724,"_29612":2601,"_20544":56721,"_5":14097,"_26932":56361,"_2867":56722},[],"Releases that override `toolbox`, `services.connectors`, ports, probes or scheduling",{"_3381":2725,"_29612":2601,"_20544":56724,"_5":14097,"_26932":56361,"_2867":56725},[],"Low to medium: validation errors or changed defaults",{"_3381":2726,"_29612":2601,"_20544":56727,"_5":14097,"_26932":56361,"_2867":56728},[],"Update the values file",{"_3381":2727,"_29612":2601,"_20544":56730,"_5":14097,"_26932":56361,"_2867":56434},[],{"_3381":2728,"_29612":2601,"_20544":56732,"_5":14097,"_26932":56361,"_2867":56733},[],"Clients that send the DMS ID in the update body",{"_3381":2729,"_29612":2601,"_20544":56735,"_5":14097,"_26932":56361,"_2867":56736},[],"Low: the ID in the URL wins",{"_3381":2730,"_29612":2601,"_20544":56738,"_5":14097,"_26932":56361,"_2867":56739},[],"Send the ID in the URL",{"_3381":2731,"_29612":2601,"_20544":56741,"_5":14097,"_26932":56361,"_2867":56438},[],{"_3381":2732,"_29612":2601,"_20544":56743,"_5":14097,"_26932":56361,"_2867":56744},[],"Consumers that match on certificate `type`",{"_3381":2733,"_29612":2601,"_20544":56746,"_5":14097,"_26932":56361,"_2867":56747},[],"Low: two values are renamed",{"_3381":2734,"_29612":2601,"_20544":56749,"_5":14097,"_26932":56361,"_2867":56750},[],"Adapt consumers",{"_3381":2735,"_29612":2601,"_20544":56752,"_5":14097,"_26932":56361,"_2867":56430},[],{"_3381":2736,"_29612":2601,"_20544":56754,"_5":14097,"_26932":56361,"_2867":56755},[],"Any DMS",{"_3381":2737,"_29612":2601,"_20544":56757,"_5":14097,"_26932":56361,"_2867":56758},[],"Low: informational",{"_3381":2738,"_29612":2601,"_20544":56760,"_5":14097,"_26932":56361,"_2867":56761},[],"Read both blocks before editing",{"_3381":2739,"_29612":2601,"_20544":56763,"_5":14097,"_26932":56369,"_2867":56764},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_3381":2740,"_29612":2601,"_20544":56766,"_5":14097,"_26932":56369,"_2867":56767},[],"Step 4 of the migration guide copies the data.",{"_3381":2741,"_29612":2601,"_20544":56769,"_5":14097,"_26932":56373,"_2867":56770},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_3381":2742,"_29612":2601,"_20544":56772,"_5":14097,"_26932":56377,"_2867":56773},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_3381":2743,"_29612":2601,"_20544":56775,"_5":14097,"_26932":56381,"_2867":56776},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_3381":2744,"_29612":2601,"_20544":56778,"_5":14097,"_26932":56385,"_2867":56779},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_3381":2745,"_29612":2601,"_20544":56781,"_5":14097,"_26932":56385,"_2867":56782},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_3381":2746,"_29612":2601,"_20544":56784,"_5":14097,"_26932":56389,"_2867":56785},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_3381":2747,"_29612":2601,"_20544":56787,"_5":14097,"_26932":56393,"_2867":56788},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_3381":2748,"_29612":2601,"_20544":56790,"_5":14097,"_26932":56393,"_2867":56791},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_3381":2749,"_29612":2601,"_20544":56793,"_5":14097,"_26932":56393,"_2867":56794},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_3381":2750,"_29612":2601,"_20544":56796,"_5":14097,"_26932":56393,"_2867":56797},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_3381":2751,"_29612":2601,"_20544":56799,"_5":14097,"_26932":56393,"_2867":56800},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_3381":2752,"_29612":2601,"_20544":56802,"_5":14097,"_26932":56393,"_2867":56803},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_3381":2753,"_29612":2601,"_20544":56805,"_5":14097,"_26932":56401,"_2867":56806},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_3381":2754,"_29612":2601,"_20544":56808,"_5":14097,"_26932":56401,"_2867":56809},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_3381":2755,"_29612":2601,"_20544":56811,"_5":14097,"_26932":56401,"_2867":56812},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_3381":2756,"_29612":2601,"_20544":56814,"_5":14097,"_26932":56401,"_2867":56815},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_3381":2757,"_29612":2601,"_20544":56817,"_5":14097,"_26932":56401,"_2867":56818},[],"The same KMS migration deletes, with a `NOTICE`, aliases that equal an existing key ID, because identifiers now resolve as a key ID before an alias. Affected aliases are dropped, not redirected.",{"_3381":2758,"_29612":2601,"_20544":56820,"_5":14097,"_26932":56405,"_2867":56821},[],"The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_3381":2759,"_29612":2601,"_20544":56823,"_5":14097,"_26932":56409,"_2867":56824},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_3381":2760,"_29612":2601,"_20544":56826,"_5":14097,"_26932":56409,"_2867":56827},[],"The `key_id` is the certificate's `subject_key_id` (SHA-256 of the public key).",{"_3381":2761,"_29612":2601,"_20544":56829,"_5":14097,"_26932":56409,"_2867":56830},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_3381":2762,"_29612":2601,"_20544":56832,"_5":14097,"_26932":56409,"_2867":56833},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_3381":2763,"_29612":2601,"_20544":56835,"_5":14097,"_26932":56409,"_2867":56836},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_3381":2764,"_29612":2601,"_20544":56838,"_5":14097,"_26932":56409,"_2867":56839},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_3381":2765,"_29612":2601,"_20544":56841,"_5":14097,"_26932":56409,"_2867":56842},[],"Once legacy keys are registered, starting the KMS with the backend configuration option `crypto_engines.migrate_keys_format` renames keys whose name is not the public-key SHA-256 digest, keeps the old name as an alias and moves certificate references along. It is safe to re-run and can be disabled afterwards.",{"_3381":2766,"_29612":2601,"_20544":56844,"_5":14097,"_26932":56413,"_2867":56845},[],"Certificates now reference their KMS key, and VA roles reference their signer certificate, so a key or certificate in use cannot be deleted. The KMS migration drops the legacy `lamassu.io/kms/binded-resources` key metadata. Before 4.0.0, deleting a CA could remove its key while leaving key references in its retained certificate records. The CA migration registers those missing keys in the KMS with only their public key to satisfy the retained references. These entries cannot be deleted while the retained certificates reference them; they do not restore the private key. In 4.0.0, deleting a CA releases the references from its own current certificate and linked reissued certificates before attempting to delete the key; other certificates that still reference it prevent deletion.",{"_3381":2767,"_29612":2601,"_20544":56847,"_5":14097,"_26932":56421,"_2867":56848},[],"Stored webhook configs are rewritten to the current layout and their fields renamed:",{"_3381":2768,"_29612":2601,"_20544":56850,"_5":14097,"_26932":56421,"_2867":56851},[],"Field in 3.8.0",{"_3381":2769,"_29612":2601,"_20544":56853,"_5":14097,"_26932":56421,"_2867":56854},[],"Field in 4.0.0",{"_3381":2770,"_29612":2601,"_20544":56856,"_5":14097,"_26932":56421,"_2867":56857},[],"`validate_server_cert`",{"_3381":2771,"_29612":2601,"_20544":56859,"_5":14097,"_26932":56421,"_2867":56860},[],"`insecure_skip_verify` (value negated)",{"_3381":2772,"_29612":2601,"_20544":56862,"_5":14097,"_26932":56421,"_2867":56863},[],"`oidc`",{"_3381":2773,"_29612":2601,"_20544":56865,"_5":14097,"_26932":56421,"_2867":56866},[],"`jwt_options`",{"_3381":2774,"_29612":2601,"_20544":56868,"_5":14097,"_26932":56421,"_2867":56869},[],"`apikey`",{"_3381":2775,"_29612":2601,"_20544":56871,"_5":14097,"_26932":56421,"_2867":56872},[],"`apikey_options`",{"_3381":2776,"_29612":2601,"_20544":56874,"_5":14097,"_26932":56421,"_2867":56875},[],"`mtls`",{"_3381":2777,"_29612":2601,"_20544":56877,"_5":14097,"_26932":56421,"_2867":56878},[],"`mtls_options`",{"_3381":2778,"_29612":2601,"_20544":56880,"_5":14097,"_26932":56421,"_2867":56881},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. Two cases do need it.",{"_3381":2779,"_29612":2601,"_20544":56883,"_5":14097,"_26932":56421,"_2867":56884},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_3381":2780,"_29612":2601,"_20544":56886,"_5":14097,"_26932":56421,"_2867":56887},[],"**Receiver certificate verification.** A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_3381":2781,"_29612":2601,"_20544":56889,"_5":14097,"_26932":56425,"_2867":56890},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3381":2782,"_29612":2601,"_20544":56892,"_5":14097,"_26932":56425,"_2867":56893},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_3381":2783,"_29612":2601,"_20544":56895,"_5":14097,"_26932":56425,"_2867":56896},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_3381":2784,"_29612":2601,"_20544":56898,"_5":14097,"_26932":56429,"_2867":56899},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but read both blocks before editing a DMS so that you do not modify one while believing you are editing the other. The console exposes independent editors for both blocks; the DMS guide describes their fields, and you can also edit them through the DMS API.",{"_3381":2785,"_29612":2601,"_20544":56901,"_5":14097,"_26932":56433,"_2867":56902},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_3381":2786,"_29612":2601,"_20544":56904,"_5":14097,"_26932":56437,"_2867":56905},[],"Stored certificate type values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Adapt consumers that read or match on those values.",{"_3381":2787,"_29612":2601,"_20544":56907,"_5":14097,"_26932":56441,"_2867":56908},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_3381":2788,"_29612":2601,"_20544":56910,"_5":14097,"_26932":56441,"_2867":56911},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_3381":2789,"_29612":2601,"_20544":56913,"_5":14097,"_26932":56441,"_2867":56914},[],"`POST /v1/devices/:id/events` creates an event.",{"_3381":2790,"_29612":2601,"_20544":56916,"_5":14097,"_26932":56441,"_2867":56917},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Each Device Manager instance binds a durable AMQP queue named after its service ID, `device-manager-sse-<uuid>`. Queues from crashed or replaced instances linger until removed, so configure an expiration or cleanup policy on the broker.",{"_3381":2791,"_29612":2601,"_20544":56919,"_5":14097,"_26932":56445,"_2867":56920},[],"`crl_options.subject_key_id_signer` is replaced by the required `crl_options.signer_certificate_serial_number`, the serial number of the existing certificate that signs the CRL. A new role's initial value is the CA's current certificate serial number. Requests that still carry `subject_key_id_signer` return an error. Custom authorization policies that filter on the old field must be updated: the filter `crl_subject_key_id_signer` is renamed to `crl_signer_certificate_serial_number` and takes serial-number values.",{"_3381":2792,"_29612":2601,"_20544":56922,"_5":14097,"_26932":56449,"_2867":56923},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_3381":2793,"_29612":2601,"_20544":56925,"_5":14097,"_26932":56453,"_2867":56926},[],"Take a verifiable backup of PostgreSQL and schedule downtime. The upgrade moves every service's data into `pki`.",{"_3381":2794,"_29612":2601,"_20544":56928,"_5":14097,"_26932":56453,"_2867":56929},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_3381":2795,"_29612":2601,"_20544":56931,"_5":14097,"_26932":56453,"_2867":56932},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_3381":2796,"_29612":2601,"_20544":56934,"_5":14097,"_26932":56453,"_2867":56935},[],"Record the names of your local-storage PVCs:",{"_3381":2797,"_29612":2601,"_20544":56937,"_5":14097,"_26932":56453,"_2867":56938},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_3381":2798,"_29612":2601,"_20544":56940,"_5":14097,"_26932":56457,"_2867":56941},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_3381":2799,"_29612":2601,"_20544":56943,"_5":14097,"_26932":56457,"_2867":56944},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_3381":2800,"_29612":2601,"_20544":56946,"_5":14097,"_26932":56457,"_2867":56947},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is read; the connection always uses the global `postgres.hostname`, `postgres.port`, `postgres.username` and `postgres.password` values.",{"_3381":2801,"_29612":2601,"_20544":56949,"_5":14097,"_26932":56457,"_2867":56950},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_3381":2802,"_29612":2601,"_20544":56952,"_5":14097,"_26932":56457,"_2867":56953},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_3381":2803,"_29612":2601,"_20544":56955,"_5":14097,"_26932":56457,"_2867":56956},[],"**Rename `toolbox` to `connectivityTest`:**",{"_3381":2804,"_29612":2601,"_20544":56958,"_5":14097,"_26932":56457,"_2867":56959},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3381":2805,"_29612":2601,"_20544":56961,"_5":14097,"_26932":56457,"_2867":56962},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_3381":2806,"_29612":2601,"_20544":56964,"_5":14097,"_26932":56457,"_2867":56965},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_3381":2807,"_29612":2601,"_20544":56967,"_5":14097,"_26932":56457,"_2867":56968},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_3381":2808,"_29612":2601,"_20544":56970,"_5":14097,"_26932":56457,"_2867":56971},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_3381":2809,"_29612":2601,"_20544":56973,"_5":14097,"_26932":56457,"_2867":56974},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown.",{"_3381":2810,"_29612":2601,"_20544":56976,"_5":14097,"_26932":56461,"_2867":56977},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_3381":2811,"_29612":2601,"_20544":56979,"_5":14097,"_26932":56461,"_2867":56980},[],"If the deployment uses local KMS or VA storage, those pods fail until you complete step 4, so `--wait` cannot succeed: Helm waits for them to become ready, times out, exits with an error and marks the release `failed`. The hooks have already run by then, and every manifest, including the new StatefulSets and their PVCs, has been applied. Helm does not roll anything back without `--atomic`. Continue with step 4, then re-run the same `helm upgrade` command so it completes and Helm records the release as `deployed`. Both hooks are idempotent, so they are safe to run again.",{"_3381":2812,"_29612":2601,"_20544":56982,"_5":14097,"_26932":56465,"_2867":56983},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_3381":2813,"_29612":2601,"_20544":56985,"_5":14097,"_26932":56465,"_2867":56986},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_3381":2814,"_29612":2601,"_20544":56988,"_5":14097,"_26932":56465,"_2867":56989},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If `claims_ok` prints `ABORT`, the block stops before listing the claims: either a StatefulSet lookup failed, or a new claim resolves to the 3.8.0 claim. In the second case the copy would verify against itself and the final cleanup would delete the live volume. The chart always appends `-kms` and `-va` to the release-scoped name, so a collision means the claims are not what this guide expects; investigate before going on. Item 3 runs the same check and refuses to create the helper pod, so nothing touches the volumes. The check returns instead of calling `exit`, which would close your shell and lose the variables set so far. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_3381":2815,"_29612":2601,"_20544":56991,"_5":14097,"_26932":56465,"_2867":56992},[],"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:",{"_3381":2816,"_29612":2601,"_20544":56994,"_5":14097,"_26932":56465,"_2867":56995},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_3381":2817,"_29612":2601,"_20544":56997,"_5":14097,"_26932":56465,"_2867":56998},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_3381":2818,"_29612":2601,"_20544":57000,"_5":14097,"_26932":56465,"_2867":57001},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_3381":2819,"_29612":2601,"_20544":57003,"_5":14097,"_26932":56465,"_2867":57004},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_3381":2820,"_29612":2601,"_20544":57006,"_5":14097,"_26932":56465,"_2867":57007},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_3381":2821,"_29612":2601,"_20544":57009,"_5":14097,"_26932":56465,"_2867":57010},[],"**Remove the helper and restore the recorded replica counts:**",{"_3381":2822,"_29612":2601,"_20544":57012,"_5":14097,"_26932":56465,"_2867":57013},[],"**Re-run the step 3 `helm upgrade` command.** The KMS and VA pods now start against the copied data, so `--wait` succeeds and the release moves from `failed` to `deployed`.",{"_3381":2823,"_29612":2601,"_20544":57015,"_5":14097,"_26932":56469,"_2867":57016},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_3381":2824,"_29612":2601,"_20544":57018,"_5":14097,"_26932":56469,"_2867":57019},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_3381":2825,"_29612":2601,"_20544":57021,"_5":14097,"_26932":56473,"_2867":57022},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_3381":2826,"_29612":2601,"_20544":57024,"_5":14097,"_26932":56473,"_2867":57025},[],"Run the migrations in the required order, one schema at a time: `kms` first, then the `ca-to-kms-migration` tool (needed only for legacy deployments whose CA keys are named by SKI), then `ca`, then `va`. The `devicemanager`, `dmsmanager` and `alerts` schemas are independent and can be migrated in any order. With Helm, the chart's pre-install job applies the schemas in the correct order automatically.",{"_3381":2827,"_29612":2601,"_20544":57027,"_5":14097,"_26932":56473,"_2867":57028},[],"The schemas reference each other, so the PostgreSQL role running the migrations needs cross-schema privileges: the `ca` schema needs `USAGE` on `kms` plus `SELECT`, `REFERENCES` and `INSERT` on `kms.kms_keys`, and the `va` schema needs `USAGE` on `ca` plus `SELECT` and `REFERENCES` on `ca.certificates` and `SELECT` on `ca.ca_certificates`. If your services connect with a different user than the one that ran the migrations, grant that user `SELECT` on `ca.certificates_view` after the migrations.",{"_3381":2828,"_29612":2601,"_20544":57030,"_5":14097,"_26932":56473,"_2867":57031},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_3381":2829,"_29612":2601,"_20544":57033,"_5":14097,"_26932":56473,"_2867":57034},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_3381":2830,"_29612":2601,"_20544":57036,"_5":14097,"_26932":56473,"_2867":57037},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository.",{"_3381":2831,"_29612":2601,"_20544":57039,"_5":14097,"_26932":56473,"_2867":57040},[],"Both tools' READMEs document the 4.0.0 `pki` layout and match this page: `goose-lamassu` uses `dbname=pki` examples and does not validate the database name, and the `ca-to-kms-migration` README describes the single `pki` database and the migration order.",{"_3381":2832,"_29612":2601,"_20544":57042,"_5":14097,"_26932":56477,"_2867":57043},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_3381":2833,"_29612":2601,"_20544":57045,"_5":14097,"_26932":56477,"_2867":57046},[],"**`helm upgrade --wait` times out and `helm status` reports the release as `failed`.** With local KMS or VA storage this is expected on the first run: the new pods cannot become ready before their data is copied. The hooks ran and the manifests and PVCs were applied, so complete step 4 and re-run the same `helm upgrade` command. If other pods are also not ready, check their logs, because something else is wrong.",{"_3381":2834,"_29612":2601,"_20544":57048,"_5":14097,"_26932":56477,"_2867":57049},[],"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait.",{"_3381":2835,"_29612":2601,"_20544":57051,"_5":14097,"_26932":56477,"_2867":57052},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_3381":2836,"_29612":2601,"_20544":57054,"_5":14097,"_26932":56477,"_2867":57055},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted on duplicate CA IDs or missing `engine_id` values. Check the job logs, fix the privileges or the data, and re-run the upgrade.",{"_3381":2837,"_29612":2601,"_20544":57057,"_5":14097,"_26932":56477,"_2867":57058},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_3381":2838,"_29612":2601,"_20544":57060,"_5":14097,"_26932":56477,"_2867":57061},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_3381":2839,"_29612":2601,"_20544":57063,"_5":14097,"_26932":56477,"_2867":57064},[],"**A migration aborts with `kms schema not found`.** The schemas must be migrated in order: run the `kms` schema migration before the `ca` schema migration.",{"_3381":2840,"_29612":2601,"_20544":57066,"_5":14097,"_26932":56477,"_2867":57067},[],"**A migration aborts with `ca schema not found`.** Run the `ca` schema migration before the `va` schema migration.",{"_3381":2841,"_29612":2601,"_20544":57069,"_5":14097,"_26932":56477,"_2867":57070},[],"**The VA migration fails with `cannot resolve signer certificate for VA role ... N candidates`.** The migration cannot uniquely identify a signer certificate from the SKI stored on the role. Review the SKI and candidate certificates reported in the error; correct the pre-migration data with a verified backup and rerun the migration. The new `signer_certificate_serial_number` field is created during that migration, so it cannot be set through the VA API while the migration is failing.",{"_3381":2842,"_29612":2601,"_20544":57072,"_5":14097,"_26932":56477,"_2867":57073},[],"**A migration or service fails with `permission denied for table ...`.** The PostgreSQL role is missing the cross-schema privileges listed in Deployments without Helm; this includes `certificates_view` when the post-migration `GRANT SELECT` was skipped. Grant the missing privileges and re-run.",{"_3381":2843,"_29612":2601,"_20544":57075,"_5":14097,"_26932":56480,"_2867":57076},[],"After the upgrade, check in this order:",{"_3381":2844,"_29612":2601,"_20544":57078,"_5":14097,"_26932":56480,"_2867":57079},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations and the foreign-key migrations that run per schema in the required order.",{"_3381":2845,"_29612":2601,"_20544":57081,"_5":14097,"_26932":56480,"_2867":57082},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_3381":2846,"_29612":2601,"_20544":57084,"_5":14097,"_26932":56480,"_2867":57085},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_3381":2847,"_29612":2601,"_20544":57087,"_5":14097,"_26932":56480,"_2867":57088},[],"**Existing CRLs are served.** `GET /crl/<ca-ski>` on VA returns a previously issued CRL, and new CRLs are issued.",{"_3381":2848,"_29612":2601,"_20544":57090,"_5":14097,"_26932":56480,"_2867":57091},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS.",{"_3381":2849,"_29612":2601,"_20544":57093,"_5":14097,"_26932":56480,"_2867":57094},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_3381":2850,"_29612":2601,"_20544":57096,"_5":14097,"_26932":56480,"_2867":57097},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_3381":2851,"_29612":2601,"_20544":57099,"_5":14097,"_26932":56480,"_2867":57100},[],"**AMQP.** The backend connects to the broker with the expected TLS settings, and the cleanup policy for SSE queues is in place.",{"_3381":2852,"_29612":2601,"_20544":57102,"_5":14097,"_26932":56480,"_2867":57103},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_3381":2853,"_29612":2601,"_20544":57105,"_5":14097,"_26932":56480,"_2867":57106},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_3381":2854,"_29612":2601,"_20544":57108,"_5":14097,"_26932":56480,"_2867":57109},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_3381":2855,"_29612":2601,"_20544":57111,"_5":14097,"_26932":56480,"_2867":57112},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_3381":2856,"_29612":2601,"_20544":57114,"_5":14097,"_26932":56480,"_2867":57115},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_3381":2857,"_29612":2601,"_20544":57117,"_5":14097,"_26932":56480,"_2867":57118},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_3381":2858,"_29612":2601,"_20544":57120,"_5":14097,"_26932":56484,"_2867":57121},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy. These are the fixed 3.8.0 names recorded in step 1; before deleting, confirm that neither is mounted by a running pod, for example with `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, where `Used By` must be `<none>`:",{"_3381":2859,"_29612":2601,"_20544":57123,"_5":14097,"_26932":56484,"_2867":57124},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_3381":2860,"_29612":2601,"_20544":57126,"_5":14097,"_26932":56484,"_2867":57127},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3381":2861,"_29612":2601,"_20544":57129,"_5":14097,"_26932":56484,"_2867":57130},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_3381":2862,"_29612":2601,"_20544":57132,"_5":14097,"_26932":56484,"_2867":57133},[],"<Card title=\"Configure a DMS\" description=\"Enrollment, re-enrollment and webhook settings.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />","sorting",{"_57136":57137,"_57138":57139,"_57140":57141,"_57142":57143,"_17800":2902,"_68549":2902},"language","english","sortableProperties",[2867,29612,5,26932],"sortablePropertiesWithTypes",{"_2867":24548,"_29612":24548,"_5":24548,"_26932":24548},"sorts",{"_2867":57144,"_29612":59996,"_5":62847,"_26932":65698},{"_4540":57145,"_57146":57147,"_5":24548},{"_14179":3555,"_14560":24134,"_14579":4683,"_28621":3342,"_14566":19780,"_19498":7303,"_14200":5040,"_14207":5039,"_28563":7043,"_28972":4343,"_28993":5864,"_28597":3383,"_33926":5821,"_28700":7338,"_29037":7346,"_33933":3100,"_33936":6898,"_33939":5442,"_33942":3907,"_29444":4660,"_33947":9401,"_33949":3556,"_29474":5836,"_14575":12215,"_33953":13016,"_33956":5827,"_33958":6055,"_29021":6607,"_29439":6831,"_29487":3621,"_33963":2952,"_33965":3245,"_33967":3923,"_28717":2966,"_33970":6110,"_33972":7380,"_33974":10591,"_33976":3571,"_33978":12617,"_28634":11489,"_33981":3011,"_33983":6081,"_28628":14054,"_29058":19974,"_33987":7370,"_33989":7035,"_33992":2977,"_28674":6513,"_33996":2978,"