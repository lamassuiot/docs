06124,"_26298":106125,"_2652":106126},[],"/docs/pr-preview/pr-53/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_3154":63956,"_27801":63953,"_5":28141,"_19254":106128,"_26298":106129,"_2652":106130},[],"/docs/pr-preview/pr-53/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_3154":63957,"_27801":63953,"_5":28141,"_19254":106132,"_26298":106133,"_2652":106134},[],"/docs/pr-preview/pr-53/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3154":63958,"_27801":63953,"_5":28141,"_19254":106136,"_26298":106137,"_2652":106138},[],"/docs/pr-preview/pr-53/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3154":63959,"_27801":63953,"_5":28141,"_19254":106140,"_26298":106141,"_2652":106142},[],"/docs/pr-preview/pr-53/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3154":63960,"_27801":63953,"_5":28141,"_19254":106144,"_26298":106145,"_2652":106146},[],"/docs/pr-preview/pr-53/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3154":63961,"_27801":63953,"_5":28141,"_19254":106148,"_26298":106149,"_2652":106150},[],"/docs/pr-preview/pr-53/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3154":63962,"_27801":63953,"_19254":106152,"_5":13218,"_26298":63953,"_2652":106153},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3154":63963,"_27801":63953,"_19254":106155,"_5":13218,"_26298":106125,"_2652":106156},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3154":63964,"_27801":63953,"_19254":106158,"_5":13218,"_26298":106125,"_2652":106159},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3154":63965,"_27801":63953,"_19254":106161,"_5":13218,"_26298":106125,"_2652":106162},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3154":63966,"_27801":63953,"_19254":106164,"_5":13218,"_26298":106129,"_2652":106165},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3154":63967,"_27801":63953,"_19254":106167,"_5":13218,"_26298":106129,"_2652":106168},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3154":63968,"_27801":63953,"_19254":106170,"_5":13218,"_26298":106129,"_2652":106171},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3154":63969,"_27801":63953,"_19254":106173,"_5":13218,"_26298":106133,"_2652":106174},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3154":63970,"_27801":63953,"_19254":106176,"_5":13218,"_26298":106137,"_2652":106177},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3154":63971,"_27801":63953,"_19254":106179,"_5":13218,"_26298":106141,"_2652":106180},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3154":63972,"_27801":63953,"_19254":106182,"_5":13218,"_26298":106145,"_2652":106183},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3154":63973,"_27801":63953,"_19254":106185,"_5":13218,"_26298":106149,"_2652":106186},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3154":63974,"_27801":63974,"_5":13544,"_2652":106188,"_28144":106189,"_19254":106190,"_26298":63974},"Despliega Lamassu",[45131,106117],[],{"_3154":63975,"_27801":63974,"_19254":106192,"_5":13218,"_26298":63974,"_2652":106193},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3154":63976,"_27801":63974,"_5":28141,"_19254":106195,"_26298":106196,"_2652":106197},[],"/docs/pr-preview/pr-53/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3154":63977,"_27801":63974,"_5":28141,"_19254":106199,"_26298":106200,"_2652":106201},[],"/docs/pr-preview/pr-53/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3154":63978,"_27801":63974,"_5":28141,"_19254":106203,"_26298":106204,"_2652":106205},[],"/docs/pr-preview/pr-53/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3154":63979,"_27801":63974,"_19254":106207,"_5":13218,"_26298":63974,"_2652":106208},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3154":63980,"_27801":63974,"_19254":106210,"_5":13218,"_26298":106196,"_2652":106211},[],"Modelo",{"_3154":63981,"_27801":63974,"_19254":106213,"_5":13218,"_26298":106196,"_2652":106214},[],"Recomendado para",{"_3154":63982,"_27801":63974,"_19254":106216,"_5":13218,"_26298":106196,"_2652":106217},[],"Quién opera la infraestructura",{"_3154":63983,"_27801":63974,"_19254":106219,"_5":13218,"_26298":106196,"_2652":106220},[],"Punto de partida",{"_3154":63984,"_27801":63974,"_19254":106222,"_5":13218,"_26298":106196,"_2652":45238},[],{"_3154":63985,"_27801":63974,"_19254":106224,"_5":13218,"_26298":106196,"_2652":106225},[],"Producción, entornos regulados y despliegues personalizados",{"_3154":63986,"_27801":63974,"_19254":106227,"_5":13218,"_26298":106196,"_2652":106228},[],"Tu equipo",{"_3154":63987,"_27801":63974,"_19254":106230,"_5":13218,"_26298":106196,"_2652":106231},[],"Helm o Fastlane",{"_3154":63988,"_27801":63974,"_19254":106233,"_5":13218,"_26298":106196,"_2652":45250},[],{"_3154":63989,"_27801":63974,"_19254":106235,"_5":13218,"_26298":106196,"_2652":106236},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3154":63990,"_27801":63974,"_19254":106238,"_5":13218,"_26298":106196,"_2652":106228},[],{"_3154":63991,"_27801":63974,"_19254":106240,"_5":13218,"_26298":106196,"_2652":106241},[],"Imagen preconfigurada en EC2",{"_3154":63992,"_27801":63974,"_19254":106243,"_5":13218,"_26298":106196,"_2652":45261},[],{"_3154":63993,"_27801":63974,"_19254":106245,"_5":13218,"_26298":106196,"_2652":106246},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3154":63994,"_27801":63974,"_19254":106248,"_5":13218,"_26298":106196,"_2652":45267},[],{"_3154":63995,"_27801":63974,"_19254":106250,"_5":13218,"_26298":106196,"_2652":106251},[],"Suscripción gestionada",{"_3154":63996,"_27801":63974,"_19254":106253,"_5":13218,"_26298":106196,"_2652":106254},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3154":63997,"_27801":63974,"_19254":106256,"_5":13218,"_26298":106196,"_2652":106257},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3154":63998,"_27801":63974,"_19254":106259,"_5":13218,"_26298":106196,"_2652":106260},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3154":63999,"_27801":63974,"_19254":106262,"_5":13218,"_26298":106200,"_2652":106263},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3154":64000,"_27801":63974,"_19254":106265,"_5":13218,"_26298":106204,"_2652":106266},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3154":64001,"_27801":64001,"_5":13544,"_2652":106268,"_28144":106269,"_19254":106270,"_26298":64001},"Utiliza Lamassu como SaaS",[45131,106117,106118],[],{"_3154":64002,"_27801":64001,"_19254":106272,"_5":13218,"_26298":64001,"_2652":106273},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3154":64003,"_27801":64001,"_5":28141,"_19254":106275,"_26298":106276,"_2652":106277},[],"/docs/pr-preview/pr-53/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3154":64004,"_27801":64001,"_5":28141,"_19254":106279,"_26298":106280,"_2652":106281},[],"/docs/pr-preview/pr-53/es/deployment/saas#planes","Planes",{"_3154":64005,"_27801":64001,"_5":28141,"_19254":106283,"_26298":106284,"_2652":106285},[],"/docs/pr-preview/pr-53/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3154":64006,"_27801":64001,"_19254":106287,"_5":13218,"_26298":64001,"_2652":106288},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3154":64007,"_27801":64001,"_19254":106290,"_5":13218,"_26298":106276,"_2652":106291},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3154":64008,"_27801":64001,"_19254":106293,"_5":13218,"_26298":106276,"_2652":106294},[],"Copias de seguridad automáticas.",{"_3154":64009,"_27801":64001,"_19254":106296,"_5":13218,"_26298":106276,"_2652":106297},[],"Actualizaciones de versión.",{"_3154":64010,"_27801":64001,"_19254":106299,"_5":13218,"_26298":106276,"_2652":106300},[],"Soporte técnico y SLA según el plan contratado.",{"_3154":64011,"_27801":64001,"_19254":106302,"_5":13218,"_26298":106280,"_2652":45322},[],{"_3154":64012,"_27801":64001,"_19254":106304,"_5":13218,"_26298":106280,"_2652":106305},[],"Dispositivos",{"_3154":64013,"_27801":64001,"_19254":106307,"_5":13218,"_26298":106280,"_2652":106308},[],"Soporte",{"_3154":64014,"_27801":64001,"_19254":106310,"_5":13218,"_26298":106280,"_2652":45331},[],{"_3154":64015,"_27801":64001,"_19254":106312,"_5":13218,"_26298":106280,"_2652":45334},[],{"_3154":64016,"_27801":64001,"_19254":106314,"_5":13218,"_26298":106280,"_2652":106315},[],"Hasta 1.000",{"_3154":64017,"_27801":64001,"_19254":106317,"_5":13218,"_26298":106280,"_2652":45340},[],{"_3154":64018,"_27801":64001,"_19254":106319,"_5":13218,"_26298":106280,"_2652":106320},[],"99,5 %",{"_3154":64019,"_27801":64001,"_19254":106322,"_5":13218,"_26298":106280,"_2652":45346},[],{"_3154":64020,"_27801":64001,"_19254":106324,"_5":13218,"_26298":106280,"_2652":106325},[],"Hasta 10.000",{"_3154":64021,"_27801":64001,"_19254":106327,"_5":13218,"_26298":106280,"_2652":106328},[],"Email y chat",{"_3154":64022,"_27801":64001,"_19254":106330,"_5":13218,"_26298":106280,"_2652":106331},[],"99,9 %",{"_3154":64023,"_27801":64001,"_19254":106333,"_5":13218,"_26298":106280,"_2652":45358},[],{"_3154":64024,"_27801":64001,"_19254":106335,"_5":13218,"_26298":106280,"_2652":106336},[],"Ilimitados",{"_3154":64025,"_27801":64001,"_19254":106338,"_5":13218,"_26298":106280,"_2652":106339},[],"Dedicado",{"_3154":64026,"_27801":64001,"_19254":106341,"_5":13218,"_26298":106280,"_2652":106342},[],"99,99 %",{"_3154":64027,"_27801":64001,"_19254":106344,"_5":13218,"_26298":106284,"_2652":106345},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3154":64028,"_27801":64001,"_19254":106347,"_5":13218,"_26298":106284,"_2652":106348},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3154":64029,"_27801":64029,"_5":13544,"_2652":45375,"_28144":106350,"_19254":106352,"_26298":64029},[45131,106117,106351],"Kubernetes autogestionado",[],{"_3154":64030,"_27801":64029,"_19254":106354,"_5":13218,"_26298":64029,"_2652":106355},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3154":64031,"_27801":64029,"_5":28141,"_19254":106357,"_26298":106358,"_2652":106359},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3154":64032,"_27801":64029,"_5":28141,"_19254":106361,"_26298":106362,"_2652":106363},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3154":64033,"_27801":64029,"_5":28141,"_19254":106365,"_26298":106366,"_2652":106367},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3154":64034,"_27801":64029,"_5":28141,"_19254":106369,"_26298":106370,"_2652":106371},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3154":64035,"_27801":64029,"_5":28141,"_19254":106373,"_26298":106374,"_2652":106375},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3154":64036,"_27801":64029,"_5":28141,"_19254":106377,"_26298":106378,"_2652":106379},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3154":64037,"_27801":64029,"_5":28141,"_19254":106381,"_26298":106382,"_2652":106383},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3154":64038,"_27801":64029,"_5":28141,"_19254":106385,"_26298":106386,"_2652":106387},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3154":64039,"_27801":64029,"_5":28141,"_19254":106389,"_26298":106390,"_2652":106391},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3154":64040,"_27801":64029,"_5":28141,"_19254":106393,"_26298":106394,"_2652":106395},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3154":64041,"_27801":64029,"_5":28141,"_19254":106397,"_26298":106398,"_2652":106399},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3154":64042,"_27801":64029,"_19254":106401,"_5":13218,"_26298":106358,"_2652":106402},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3154":64043,"_27801":64029,"_19254":106404,"_5":13218,"_26298":106358,"_2652":106405},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3154":64044,"_27801":64029,"_19254":106407,"_5":13218,"_26298":106362,"_2652":106408},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3154":64045,"_27801":64029,"_19254":106410,"_5":13218,"_26298":106362,"_2652":106411},[],"Fastlane instala o configura",{"_3154":64046,"_27801":64029,"_19254":106413,"_5":13218,"_26298":106362,"_2652":106414},[],"Tú sigues proporcionando",{"_3154":64047,"_27801":64029,"_19254":106416,"_5":13218,"_26298":106362,"_2652":106417},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3154":64048,"_27801":64029,"_19254":106419,"_5":13218,"_26298":106362,"_2652":106420},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3154":64049,"_27801":64029,"_19254":106422,"_5":13218,"_26298":106362,"_2652":106423},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3154":64050,"_27801":64029,"_19254":106425,"_5":13218,"_26298":106362,"_2652":106426},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3154":64051,"_27801":64029,"_19254":106428,"_5":13218,"_26298":106362,"_2652":106429},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_3154":64052,"_27801":64029,"_19254":106431,"_5":13218,"_26298":106362,"_2652":106432},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3154":64053,"_27801":64029,"_19254":106434,"_5":13218,"_26298":106362,"_2652":106435},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3154":64054,"_27801":64029,"_19254":106437,"_5":13218,"_26298":106362,"_2652":106438},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3154":64055,"_27801":64029,"_19254":106440,"_5":13218,"_26298":106362,"_2652":106441},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3154":64056,"_27801":64029,"_19254":106443,"_5":13218,"_26298":106366,"_2652":106444},[],"Necesitas:",{"_3154":64057,"_27801":64029,"_19254":106446,"_5":13218,"_26298":106366,"_2652":106447},[],"un clúster Kubernetes existente",{"_3154":64058,"_27801":64029,"_19254":106449,"_5":13218,"_26298":106366,"_2652":106450},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3154":64059,"_27801":64029,"_19254":106452,"_5":13218,"_26298":106366,"_2652":45477},[],{"_3154":64060,"_27801":64029,"_19254":106454,"_5":13218,"_26298":106366,"_2652":21800},[],{"_3154":64061,"_27801":64029,"_19254":106456,"_5":13218,"_26298":106366,"_2652":106457},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3154":64062,"_27801":64029,"_19254":106459,"_5":13218,"_26298":106366,"_2652":106460},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3154":64063,"_27801":64029,"_19254":106462,"_5":13218,"_26298":106366,"_2652":106463},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3154":64064,"_27801":64029,"_19254":106465,"_5":13218,"_26298":106366,"_2652":106466},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3154":64065,"_27801":64029,"_19254":106468,"_5":13218,"_26298":106366,"_2652":106469},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3154":64066,"_27801":64029,"_19254":106471,"_5":13218,"_26298":106370,"_2652":106472},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3154":64067,"_27801":64029,"_19254":106474,"_5":13218,"_26298":106370,"_2652":106475},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3154":64068,"_27801":64029,"_19254":106477,"_5":13218,"_26298":106374,"_2652":106478},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3154":64069,"_27801":64029,"_19254":106480,"_5":13218,"_26298":106374,"_2652":106481},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3154":64070,"_27801":64029,"_19254":106483,"_5":13218,"_26298":106374,"_2652":106484},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3154":64071,"_27801":64029,"_19254":106486,"_5":13218,"_26298":106374,"_2652":106487},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3154":64072,"_27801":64029,"_19254":106489,"_5":13218,"_26298":106378,"_2652":106490},[],"Opción",{"_3154":64073,"_27801":64029,"_19254":106492,"_5":13218,"_26298":106378,"_2652":106493},[],"Valor predeterminado",{"_3154":64074,"_27801":64029,"_19254":106495,"_5":13218,"_26298":106378,"_2652":106496},[],"Propósito",{"_3154":64075,"_27801":64029,"_19254":106498,"_5":13218,"_26298":106378,"_2652":45524},[],{"_3154":64076,"_27801":64029,"_19254":106500,"_5":13218,"_26298":106378,"_2652":45527},[],{"_3154":64077,"_27801":64029,"_19254":106502,"_5":13218,"_26298":106378,"_2652":106503},[],"Muestra la ayuda",{"_3154":64078,"_27801":64029,"_19254":106505,"_5":13218,"_26298":106378,"_2652":45533},[],{"_3154":64079,"_27801":64029,"_19254":106507,"_5":13218,"_26298":106378,"_2652":106508},[],"contexto actual",{"_3154":64080,"_27801":64029,"_19254":106510,"_5":13218,"_26298":106378,"_2652":106511},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3154":64081,"_27801":64029,"_19254":106513,"_5":13218,"_26298":106378,"_2652":45542},[],{"_3154":64082,"_27801":64029,"_19254":106515,"_5":13218,"_26298":106378,"_2652":5919},[],{"_3154":64083,"_27801":64029,"_19254":106517,"_5":13218,"_26298":106378,"_2652":106518},[],"Omite prompts y genera credenciales para las dependencias",{"_3154":64084,"_27801":64029,"_19254":106520,"_5":13218,"_26298":106378,"_2652":45550},[],{"_3154":64085,"_27801":64029,"_19254":106522,"_5":13218,"_26298":106378,"_2652":45553},[],{"_3154":64086,"_27801":64029,"_19254":106524,"_5":13218,"_26298":106378,"_2652":106525},[],"Namespace de la instalación",{"_3154":64087,"_27801":64029,"_19254":106527,"_5":13218,"_26298":106378,"_2652":45559},[],{"_3154":64088,"_27801":64029,"_19254":106529,"_5":13218,"_26298":106378,"_2652":45562},[],{"_3154":64089,"_27801":64029,"_19254":106531,"_5":13218,"_26298":106378,"_2652":106532},[],"Dominio usado por la UI, OIDC y el certificado",{"_3154":64090,"_27801":64029,"_19254":106534,"_5":13218,"_26298":106378,"_2652":45568},[],{"_3154":64091,"_27801":64029,"_19254":106536,"_5":13218,"_26298":106378,"_2652":13843},[],{"_3154":64092,"_27801":64029,"_19254":106538,"_5":13218,"_26298":106378,"_2652":106539},[],"Versión del chart de Lamassu",{"_3154":64093,"_27801":64029,"_19254":106541,"_5":13218,"_26298":106378,"_2652":45576},[],{"_3154":64094,"_27801":64029,"_19254":106543,"_5":13218,"_26298":106378,"_2652":45579},[],{"_3154":64095,"_27801":64029,"_19254":106545,"_5":13218,"_26298":106378,"_2652":106546},[],"Puerto del listener HTTPS",{"_3154":64096,"_27801":64029,"_19254":106548,"_5":13218,"_26298":106378,"_2652":45585},[],{"_3154":64097,"_27801":64029,"_19254":106550,"_5":13218,"_26298":106378,"_2652":45588},[],{"_3154":64098,"_27801":64029,"_19254":106552,"_5":13218,"_26298":106378,"_2652":106553},[],"Puerto del listener HTTP",{"_3154":64099,"_27801":64029,"_19254":106555,"_5":13218,"_26298":106378,"_2652":45594},[],{"_3154":64100,"_27801":64029,"_19254":106557,"_5":13218,"_26298":106378,"_2652":45527},[],{"_3154":64101,"_27801":64029,"_19254":106559,"_5":13218,"_26298":106378,"_2652":106560},[],"Certificado PEM para TLS downstream",{"_3154":64102,"_27801":64029,"_19254":106562,"_5":13218,"_26298":106378,"_2652":45602},[],{"_3154":64103,"_27801":64029,"_19254":106564,"_5":13218,"_26298":106378,"_2652":45527},[],{"_3154":64104,"_27801":64029,"_19254":106566,"_5":13218,"_26298":106378,"_2652":106567},[],"Clave privada PEM para TLS downstream",{"_3154":64105,"_27801":64029,"_19254":106569,"_5":13218,"_26298":106378,"_2652":45610},[],{"_3154":64106,"_27801":64029,"_19254":106571,"_5":13218,"_26298":106378,"_2652":106572},[],"chart del repositorio",{"_3154":64107,"_27801":64029,"_19254":106574,"_5":13218,"_26298":106378,"_2652":106575},[],"Usa un chart local de Lamassu sin empaquetar",{"_3154":64108,"_27801":64029,"_19254":106577,"_5":13218,"_26298":106378,"_2652":45619},[],{"_3154":64109,"_27801":64029,"_19254":106579,"_5":13218,"_26298":106378,"_2652":106580},[],"detección automática",{"_3154":64110,"_27801":64029,"_19254":106582,"_5":13218,"_26298":106378,"_2652":106583},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3154":64111,"_27801":64029,"_19254":106585,"_5":13218,"_26298":106378,"_2652":45627},[],{"_3154":64112,"_27801":64029,"_19254":106587,"_5":13218,"_26298":106378,"_2652":5919},[],{"_3154":64113,"_27801":64029,"_19254":106589,"_5":13218,"_26298":106378,"_2652":106590},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3154":64114,"_27801":64029,"_19254":106592,"_5":13218,"_26298":106378,"_2652":45635},[],{"_3154":64115,"_27801":64029,"_19254":106594,"_5":13218,"_26298":106378,"_2652":5919},[],{"_3154":64116,"_27801":64029,"_19254":106596,"_5":13218,"_26298":106378,"_2652":106597},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3154":64117,"_27801":64029,"_19254":106599,"_5":13218,"_26298":106378,"_2652":45643},[],{"_3154":64118,"_27801":64029,"_19254":106601,"_5":13218,"_26298":106378,"_2652":5919},[],{"_3154":64119,"_27801":64029,"_19254":106603,"_5":13218,"_26298":106378,"_2652":106604},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3154":64120,"_27801":64029,"_19254":106606,"_5":13218,"_26298":106378,"_2652":45651},[],{"_3154":64121,"_27801":64029,"_19254":106608,"_5":13218,"_26298":106378,"_2652":5919},[],{"_3154":64122,"_27801":64029,"_19254":106610,"_5":13218,"_26298":106378,"_2652":106611},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3154":64123,"_27801":64029,"_19254":106613,"_5":13218,"_26298":106378,"_2652":45659},[],{"_3154":64124,"_27801":64029,"_19254":106615,"_5":13218,"_26298":106378,"_2652":45662},[],{"_3154":64125,"_27801":64029,"_19254":106617,"_5":13218,"_26298":106378,"_2652":106618},[],"Usa otro chart local de SoftHSM",{"_3154":64126,"_27801":64029,"_19254":106620,"_5":13218,"_26298":106378,"_2652":106621},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3154":64127,"_27801":64029,"_19254":106623,"_5":13218,"_26298":106382,"_2652":106624},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3154":64128,"_27801":64029,"_19254":106626,"_5":13218,"_26298":106382,"_2652":106627},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3154":64129,"_27801":64029,"_19254":106629,"_5":13218,"_26298":106382,"_2652":106630},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3154":64130,"_27801":64029,"_19254":106632,"_5":13218,"_26298":106382,"_2652":106633},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3154":64131,"_27801":64029,"_19254":106635,"_5":13218,"_26298":106382,"_2652":106636},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3154":64132,"_27801":64029,"_19254":106638,"_5":13218,"_26298":106382,"_2652":106639},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3154":64133,"_27801":64029,"_19254":106641,"_5":13218,"_26298":106386,"_2652":45689},[],{"_3154":64134,"_27801":64029,"_19254":106643,"_5":13218,"_26298":106386,"_2652":106644},[],"valida las herramientas locales y el clúster seleccionado",{"_3154":64135,"_27801":64029,"_19254":106646,"_5":13218,"_26298":106386,"_2652":106647},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3154":64136,"_27801":64029,"_19254":106649,"_5":13218,"_26298":106386,"_2652":106650},[],"crea el namespace",{"_3154":64137,"_27801":64029,"_19254":106652,"_5":13218,"_26298":106386,"_2652":106653},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3154":64138,"_27801":64029,"_19254":106655,"_5":13218,"_26298":106386,"_2652":106656},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3154":64139,"_27801":64029,"_19254":106658,"_5":13218,"_26298":106386,"_2652":106659},[],"instala RabbitMQ",{"_3154":64140,"_27801":64029,"_19254":106661,"_5":13218,"_26298":106386,"_2652":106662},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3154":64141,"_27801":64029,"_19254":106664,"_5":13218,"_26298":106386,"_2652":106665},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_3154":64142,"_27801":64029,"_19254":106667,"_5":13218,"_26298":106386,"_2652":106668},[],"carga datos de ejemplo opcionalmente",{"_3154":64143,"_27801":64029,"_19254":106670,"_5":13218,"_26298":106386,"_2652":106671},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3154":64144,"_27801":64029,"_19254":106673,"_5":13218,"_26298":106390,"_2652":106674},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3154":64145,"_27801":64029,"_19254":106676,"_5":13218,"_26298":106390,"_2652":106677},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3154":64146,"_27801":64029,"_19254":106679,"_5":13218,"_26298":106394,"_2652":106680},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3154":64147,"_27801":64029,"_19254":106682,"_5":13218,"_26298":106394,"_2652":106683},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_3154":64148,"_27801":64029,"_19254":106685,"_5":13218,"_26298":106394,"_2652":106686},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3154":64149,"_27801":64029,"_19254":106688,"_5":13218,"_26298":106398,"_2652":106689},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3154":64150,"_27801":64150,"_5":13544,"_2652":106691,"_28144":106692,"_19254":106693,"_26298":64150},"Instala con Helm",[45131,106117,106351],[],{"_3154":64151,"_27801":64150,"_19254":106695,"_5":13218,"_26298":64150,"_2652":106696},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3154":64152,"_27801":64150,"_5":28141,"_19254":106698,"_26298":106699,"_2652":106700},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3154":64153,"_27801":64150,"_5":28141,"_19254":106702,"_26298":106703,"_2652":106367},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3154":64154,"_27801":64150,"_5":28141,"_19254":106705,"_26298":106706,"_2652":106707},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3154":64155,"_27801":64150,"_5":28141,"_19254":106709,"_26298":106710,"_2652":106711},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3154":64156,"_27801":64150,"_5":28141,"_19254":106713,"_26298":106714,"_2652":106715},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3154":64157,"_27801":64150,"_5":28141,"_19254":106717,"_26298":106718,"_2652":106719},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3154":64158,"_27801":64150,"_5":28141,"_19254":106721,"_26298":106722,"_2652":106723},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3154":64159,"_27801":64150,"_5":28141,"_19254":106725,"_26298":106726,"_2652":106727},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3154":64160,"_27801":64150,"_5":28141,"_19254":106729,"_26298":106730,"_2652":106731},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3154":64161,"_27801":64150,"_19254":106733,"_5":13218,"_26298":106699,"_2652":106734},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3154":64162,"_27801":64150,"_19254":106736,"_5":13218,"_26298":106703,"_2652":106737},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3154":64163,"_27801":64150,"_19254":106739,"_5":13218,"_26298":106703,"_2652":106740},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3154":64164,"_27801":64150,"_19254":106742,"_5":13218,"_26298":106703,"_2652":106743},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3154":64165,"_27801":64150,"_19254":106745,"_5":13218,"_26298":106703,"_2652":106746},[],"un broker RabbitMQ accesible y sus credenciales",{"_3154":64166,"_27801":64150,"_19254":106748,"_5":13218,"_26298":106703,"_2652":106749},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3154":64167,"_27801":64150,"_19254":106751,"_5":13218,"_26298":106703,"_2652":106752},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3154":64168,"_27801":64150,"_19254":106754,"_5":13218,"_26298":106703,"_2652":106755},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3154":64169,"_27801":64150,"_19254":106757,"_5":13218,"_26298":106703,"_2652":106758},[],"una StorageClass y un diseño de tráfico externo",{"_3154":64170,"_27801":64150,"_19254":106760,"_5":13218,"_26298":106703,"_2652":106761},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3154":64171,"_27801":64150,"_19254":106763,"_5":13218,"_26298":106703,"_2652":106764},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3154":64172,"_27801":64150,"_19254":106766,"_5":13218,"_26298":106703,"_2652":106767},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3154":64173,"_27801":64150,"_19254":106769,"_5":13218,"_26298":106706,"_2652":106770},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3154":64174,"_27801":64150,"_19254":106772,"_5":13218,"_26298":106706,"_2652":106773},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3154":64175,"_27801":64150,"_19254":106775,"_5":13218,"_26298":106706,"_2652":106776},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_3154":64176,"_27801":64150,"_19254":106778,"_5":13218,"_26298":106710,"_2652":106779},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3154":64177,"_27801":64150,"_19254":106781,"_5":13218,"_26298":106710,"_2652":106782},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3154":64178,"_27801":64150,"_19254":106784,"_5":13218,"_26298":106710,"_2652":106785},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3154":64179,"_27801":64150,"_19254":106787,"_5":13218,"_26298":106714,"_2652":106788},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_3154":64180,"_27801":64150,"_19254":106790,"_5":13218,"_26298":106718,"_2652":106791},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3154":64181,"_27801":64150,"_19254":106793,"_5":13218,"_26298":106718,"_2652":106794},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3154":64182,"_27801":64150,"_19254":106796,"_5":13218,"_26298":106718,"_2652":106797},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3154":64183,"_27801":64150,"_19254":106799,"_5":13218,"_26298":106718,"_2652":106800},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3154":64184,"_27801":64150,"_19254":106802,"_5":13218,"_26298":106722,"_2652":106803},[],"Para instalar un checkout local:",{"_3154":64185,"_27801":64150,"_19254":106805,"_5":13218,"_26298":106726,"_2652":106806},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3154":64186,"_27801":64150,"_19254":106808,"_5":13218,"_26298":106726,"_2652":106809},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3154":64187,"_27801":64150,"_19254":106811,"_5":13218,"_26298":106730,"_2652":106812},[],"Antes de pasar a producción, revisa:",{"_3154":64188,"_27801":64150,"_19254":106814,"_5":13218,"_26298":106730,"_2652":106815},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3154":64189,"_27801":64150,"_19254":106817,"_5":13218,"_26298":106730,"_2652":106818},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3154":64190,"_27801":64150,"_19254":106820,"_5":13218,"_26298":106730,"_2652":106821},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3154":64191,"_27801":64150,"_19254":106823,"_5":13218,"_26298":106730,"_2652":106824},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3154":64192,"_27801":64150,"_19254":106826,"_5":13218,"_26298":106730,"_2652":106827},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3154":64193,"_27801":64150,"_19254":106829,"_5":13218,"_26298":106730,"_2652":106830},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3154":64194,"_27801":64150,"_19254":106832,"_5":13218,"_26298":106730,"_2652":106833},[],"SMTP, observabilidad y entrega de alertas",{"_3154":64195,"_27801":64150,"_19254":106835,"_5":13218,"_26298":106730,"_2652":106836},[],"las guías de actualización entre versiones y las notas de `charts/lamassu/CHANGELOG/` antes de cada upgrade",{"_3154":64196,"_27801":64150,"_19254":106838,"_5":13218,"_26298":106730,"_2652":106839},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3154":64197,"_27801":64197,"_5":13544,"_2652":106841,"_28144":106842,"_19254":106843,"_26298":64197},"Expón el Gateway",[45131,106117,106351],[],{"_3154":64198,"_27801":64197,"_19254":106845,"_5":13218,"_26298":64197,"_2652":106846},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3154":64199,"_27801":64197,"_5":28141,"_19254":106848,"_26298":106849,"_2652":106850},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3154":64200,"_27801":64197,"_5":28141,"_19254":106852,"_26298":106853,"_2652":106854},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3154":64201,"_27801":64197,"_5":28141,"_19254":106856,"_26298":106857,"_2652":106858},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3154":64202,"_27801":64197,"_5":28141,"_19254":106860,"_26298":106861,"_2652":45910},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/networking#k3s",{"_3154":64203,"_27801":64197,"_5":28141,"_19254":106863,"_26298":106864,"_2652":106865},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3154":64204,"_27801":64197,"_5":28141,"_19254":106867,"_26298":106868,"_2652":106869},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3154":64205,"_27801":64197,"_5":28141,"_19254":106871,"_26298":106872,"_2652":106873},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3154":64206,"_27801":64197,"_5":28141,"_19254":106875,"_26298":106876,"_2652":106877},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3154":64207,"_27801":64197,"_5":28141,"_19254":106879,"_26298":106880,"_2652":106881},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3154":64208,"_27801":64197,"_19254":106883,"_5":13218,"_26298":106849,"_2652":106884},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3154":64209,"_27801":64197,"_19254":106886,"_5":13218,"_26298":106849,"_2652":106887},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3154":64210,"_27801":64197,"_19254":106889,"_5":13218,"_26298":106853,"_2652":106890},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3154":64211,"_27801":64197,"_19254":106892,"_5":13218,"_26298":106853,"_2652":106893},[],"Defínelo únicamente cuando:",{"_3154":64212,"_27801":64197,"_19254":106895,"_5":13218,"_26298":106853,"_2652":106896},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3154":64213,"_27801":64197,"_19254":106898,"_5":13218,"_26298":106853,"_2652":106899},[],"esa dirección está asignada a este Gateway",{"_3154":64214,"_27801":64197,"_19254":106901,"_5":13218,"_26298":106853,"_2652":106902},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3154":64215,"_27801":64197,"_19254":106904,"_5":13218,"_26298":106853,"_2652":106905},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3154":64216,"_27801":64197,"_19254":106907,"_5":13218,"_26298":106853,"_2652":106908},[],"No confundas estos valores:",{"_3154":64217,"_27801":64197,"_19254":106910,"_5":13218,"_26298":106853,"_2652":106911},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3154":64218,"_27801":64197,"_19254":106913,"_5":13218,"_26298":106853,"_2652":106914},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3154":64219,"_27801":64197,"_19254":106916,"_5":13218,"_26298":106853,"_2652":106917},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3154":64220,"_27801":64197,"_19254":106919,"_5":13218,"_26298":106857,"_2652":106920},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3154":64221,"_27801":64197,"_19254":106922,"_5":13218,"_26298":106857,"_2652":106923},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3154":64222,"_27801":64197,"_19254":106925,"_5":13218,"_26298":106861,"_2652":106926},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3154":64223,"_27801":64197,"_19254":106928,"_5":13218,"_26298":106861,"_2652":106929},[],"Para el diseño recomendado:",{"_3154":64224,"_27801":64197,"_19254":106931,"_5":13218,"_26298":106861,"_2652":106932},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3154":64225,"_27801":64197,"_19254":106934,"_5":13218,"_26298":106861,"_2652":106935},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3154":64226,"_27801":64197,"_19254":106937,"_5":13218,"_26298":106861,"_2652":106938},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3154":64227,"_27801":64197,"_19254":106940,"_5":13218,"_26298":106861,"_2652":106941},[],"Apunta DNS a la dirección accesible de la VM.",{"_3154":64228,"_27801":64197,"_19254":106943,"_5":13218,"_26298":106861,"_2652":106944},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3154":64229,"_27801":64197,"_19254":106946,"_5":13218,"_26298":106864,"_2652":106947},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3154":64230,"_27801":64197,"_19254":106949,"_5":13218,"_26298":106868,"_2652":106950},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3154":64231,"_27801":64197,"_19254":106952,"_5":13218,"_26298":106868,"_2652":106953},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3154":64232,"_27801":64197,"_19254":106955,"_5":13218,"_26298":106872,"_2652":106956},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3154":64233,"_27801":64197,"_19254":106958,"_5":13218,"_26298":106872,"_2652":106959},[],"Requisito",{"_3154":64234,"_27801":64197,"_19254":106961,"_5":13218,"_26298":106872,"_2652":106962},[],"Diseño recomendado",{"_3154":64235,"_27801":64197,"_19254":106964,"_5":13218,"_26298":106872,"_2652":106965},[],"Consecuencia",{"_3154":64236,"_27801":64197,"_19254":106967,"_5":13218,"_26298":106872,"_2652":106968},[],"Varias URL o servicios de Lamassu",{"_3154":64237,"_27801":64197,"_19254":106970,"_5":13218,"_26298":106872,"_2652":106971},[],"Un Gateway con varias rutas",{"_3154":64238,"_27801":64197,"_19254":106973,"_5":13218,"_26298":106872,"_2652":106974},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3154":64239,"_27801":64197,"_19254":106976,"_5":13218,"_26298":106872,"_2652":106977},[],"Gateways independientes e IP externas distintas",{"_3154":64240,"_27801":64197,"_19254":106979,"_5":13218,"_26298":106872,"_2652":106980},[],"Una VIP por Gateway",{"_3154":64241,"_27801":64197,"_19254":106982,"_5":13218,"_26298":106872,"_2652":106983},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3154":64242,"_27801":64197,"_19254":106985,"_5":13218,"_26298":106872,"_2652":106986},[],"Gateways independientes, un nodo y una IP",{"_3154":64243,"_27801":64197,"_19254":106988,"_5":13218,"_26298":106872,"_2652":106989},[],"Puertos externos diferentes",{"_3154":64244,"_27801":64197,"_19254":106991,"_5":13218,"_26298":106872,"_2652":106992},[],"Los clientes deben indicar puertos no estándar",{"_3154":64245,"_27801":64197,"_19254":106994,"_5":13218,"_26298":106872,"_2652":106995},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3154":64246,"_27801":64197,"_19254":106997,"_5":13218,"_26298":106872,"_2652":106998},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3154":64247,"_27801":64197,"_19254":107000,"_5":13218,"_26298":106872,"_2652":107001},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3154":64248,"_27801":64197,"_19254":107003,"_5":13218,"_26298":106872,"_2652":107004},[],"Recursos Gateway separados pero proxy compartido",{"_3154":64249,"_27801":64197,"_19254":107006,"_5":13218,"_26298":106872,"_2652":107007},[],"Modo merged Gateway de Envoy",{"_3154":64250,"_27801":64197,"_19254":107009,"_5":13218,"_26298":106872,"_2652":107010},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3154":64251,"_27801":64197,"_19254":107012,"_5":13218,"_26298":106872,"_2652":107013},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3154":64252,"_27801":64197,"_19254":107015,"_5":13218,"_26298":106872,"_2652":107016},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3154":64253,"_27801":64197,"_19254":107018,"_5":13218,"_26298":106872,"_2652":107019},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3154":64254,"_27801":64197,"_19254":107021,"_5":13218,"_26298":106872,"_2652":107022},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3154":64255,"_27801":64197,"_19254":107024,"_5":13218,"_26298":106876,"_2652":107025},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3154":64256,"_27801":64197,"_19254":107027,"_5":13218,"_26298":106876,"_2652":107028},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3154":64257,"_27801":64197,"_19254":107030,"_5":13218,"_26298":106876,"_2652":107031},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3154":64258,"_27801":64197,"_19254":107033,"_5":13218,"_26298":106876,"_2652":107034},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3154":64259,"_27801":64197,"_19254":107036,"_5":13218,"_26298":106876,"_2652":107037},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3154":64260,"_27801":64197,"_19254":107039,"_5":13218,"_26298":106880,"_2652":107040},[],"Comprueba, en orden:",{"_3154":64261,"_27801":64197,"_19254":107042,"_5":13218,"_26298":106880,"_2652":107043},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3154":64262,"_27801":64197,"_19254":107045,"_5":13218,"_26298":106880,"_2652":107046},[],"Su estado contiene la dirección esperada.",{"_3154":64263,"_27801":64197,"_19254":107048,"_5":13218,"_26298":106880,"_2652":107049},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3154":64264,"_27801":64197,"_19254":107051,"_5":13218,"_26298":106880,"_2652":107052},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3154":64265,"_27801":64197,"_19254":107054,"_5":13218,"_26298":106880,"_2652":107055},[],"DNS resuelve al endpoint accesible externamente.",{"_3154":64266,"_27801":64197,"_19254":107057,"_5":13218,"_26298":106880,"_2652":107058},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3154":64267,"_27801":64197,"_19254":107060,"_5":13218,"_26298":106880,"_2652":107061},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3154":64268,"_27801":64268,"_5":13544,"_2652":45238,"_28144":107063,"_19254":107064,"_26298":64268},[45131,106117,106351],[],{"_3154":64269,"_27801":64268,"_19254":107066,"_5":13218,"_26298":64268,"_2652":107067},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3154":64270,"_27801":64268,"_5":28141,"_19254":107069,"_26298":107070,"_2652":107071},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3154":64271,"_27801":64268,"_5":28141,"_19254":107073,"_26298":107074,"_2652":107075},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3154":64272,"_27801":64268,"_5":28141,"_19254":107077,"_26298":107078,"_2652":107079},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3154":64273,"_27801":64268,"_5":28141,"_19254":107081,"_26298":107082,"_2652":107083},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3154":64274,"_27801":64268,"_5":28141,"_19254":107085,"_26298":107086,"_2652":107087},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3154":64275,"_27801":64268,"_5":28141,"_19254":107089,"_26298":107090,"_2652":107091},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3154":64276,"_27801":64268,"_19254":107093,"_5":13218,"_26298":107070,"_2652":107094},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3154":64277,"_27801":64268,"_19254":107096,"_5":13218,"_26298":107074,"_2652":107097},[],"Flujo",{"_3154":64278,"_27801":64268,"_19254":107099,"_5":13218,"_26298":107074,"_2652":107100},[],"Úsalo para",{"_3154":64279,"_27801":64268,"_19254":107102,"_5":13218,"_26298":107074,"_2652":107103},[],"Qué instala",{"_3154":64280,"_27801":64268,"_19254":107105,"_5":13218,"_26298":107074,"_2652":46155},[],{"_3154":64281,"_27801":64268,"_19254":107107,"_5":13218,"_26298":107074,"_2652":107108},[],"Producción y entornos controlados",{"_3154":64282,"_27801":64268,"_19254":107110,"_5":13218,"_26298":107074,"_2652":107111},[],"Servicios de Lamassu y recursos de Gateway API",{"_3154":64283,"_27801":64268,"_19254":107113,"_5":13218,"_26298":107074,"_2652":45375},[],{"_3154":64284,"_27801":64268,"_19254":107115,"_5":13218,"_26298":107074,"_2652":107116},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3154":64285,"_27801":64268,"_19254":107118,"_5":13218,"_26298":107074,"_2652":107119},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3154":64286,"_27801":64268,"_19254":107121,"_5":13218,"_26298":107078,"_2652":107122},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3154":64287,"_27801":64268,"_19254":107124,"_5":13218,"_26298":107078,"_2652":107125},[],"Área",{"_3154":64288,"_27801":64268,"_19254":107127,"_5":13218,"_26298":107078,"_2652":107128},[],"El chart de Lamassu proporciona",{"_3154":64289,"_27801":64268,"_19254":107130,"_5":13218,"_26298":107078,"_2652":107131},[],"Tú proporcionas",{"_3154":64290,"_27801":64268,"_19254":107133,"_5":13218,"_26298":107078,"_2652":107134},[],"Aplicaciones Lamassu",{"_3154":64291,"_27801":64268,"_19254":107136,"_5":13218,"_26298":107078,"_2652":107137},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3154":64292,"_27801":64268,"_19254":107139,"_5":13218,"_26298":107078,"_2652":107140},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3154":64293,"_27801":64268,"_19254":107142,"_5":13218,"_26298":107078,"_2652":107143},[],"Datos PostgreSQL",{"_3154":64294,"_27801":64268,"_19254":107145,"_5":13218,"_26298":107078,"_2652":107146},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3154":64295,"_27801":64268,"_19254":107148,"_5":13218,"_26298":107078,"_2652":107149},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3154":64296,"_27801":64268,"_19254":107151,"_5":13218,"_26298":107078,"_2652":107152},[],"Mensajería",{"_3154":64297,"_27801":64268,"_19254":107154,"_5":13218,"_26298":107078,"_2652":107155},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu",{"_3154":64298,"_27801":64268,"_19254":107157,"_5":13218,"_26298":107078,"_2652":107158},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3154":64299,"_27801":64268,"_19254":107160,"_5":13218,"_26298":107078,"_2652":107161},[],"Identidad",{"_3154":64300,"_27801":64268,"_19254":107163,"_5":13218,"_26298":107078,"_2652":107164},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3154":64301,"_27801":64268,"_19254":107166,"_5":13218,"_26298":107078,"_2652":107167},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3154":64302,"_27801":64268,"_19254":107169,"_5":13218,"_26298":107078,"_2652":107170},[],"Enrutamiento externo",{"_3154":64303,"_27801":64268,"_19254":107172,"_5":13218,"_26298":107078,"_2652":107173},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3154":64304,"_27801":64268,"_19254":107175,"_5":13218,"_26298":107078,"_2652":107176},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3154":64305,"_27801":64268,"_19254":107178,"_5":13218,"_26298":107078,"_2652":46229},[],{"_3154":64306,"_27801":64268,"_19254":107180,"_5":13218,"_26298":107078,"_2652":107181},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_3154":64307,"_27801":64268,"_19254":107183,"_5":13218,"_26298":107078,"_2652":107184},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3154":64308,"_27801":64268,"_19254":107186,"_5":13218,"_26298":107078,"_2652":107187},[],"Datos persistentes de la aplicación",{"_3154":64309,"_27801":64268,"_19254":107189,"_5":13218,"_26298":107078,"_2652":107190},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3154":64310,"_27801":64268,"_19254":107192,"_5":13218,"_26298":107078,"_2652":107193},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3154":64311,"_27801":64268,"_19254":107195,"_5":13218,"_26298":107078,"_2652":107196},[],"Integraciones opcionales",{"_3154":64312,"_27801":64268,"_19254":107198,"_5":13218,"_26298":107078,"_2652":107199},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3154":64313,"_27801":64268,"_19254":107201,"_5":13218,"_26298":107078,"_2652":107202},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3154":64314,"_27801":64268,"_19254":107204,"_5":13218,"_26298":107078,"_2652":107205},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3154":64315,"_27801":64268,"_19254":107207,"_5":13218,"_26298":107078,"_2652":107208},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3154":64316,"_27801":64268,"_19254":107210,"_5":13218,"_26298":107082,"_2652":107211},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3154":64317,"_27801":64268,"_19254":107213,"_5":13218,"_26298":107082,"_2652":107214},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3154":64318,"_27801":64268,"_19254":107216,"_5":13218,"_26298":107086,"_2652":107217},[],"Kubernetes 1.24 o posterior",{"_3154":64319,"_27801":64268,"_19254":107219,"_5":13218,"_26298":107086,"_2652":107220},[],"Helm 3.2 o posterior",{"_3154":64320,"_27801":64268,"_19254":107222,"_5":13218,"_26298":107086,"_2652":107223},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3154":64321,"_27801":64268,"_19254":107225,"_5":13218,"_26298":107086,"_2652":107226},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_3154":64322,"_27801":64268,"_19254":107228,"_5":13218,"_26298":107086,"_2652":107229},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3154":64323,"_27801":64268,"_19254":107231,"_5":13218,"_26298":107086,"_2652":107232},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3154":64324,"_27801":64268,"_19254":107234,"_5":13218,"_26298":107086,"_2652":107235},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3154":64325,"_27801":64268,"_19254":107237,"_5":13218,"_26298":107090,"_2652":107238},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3154":64326,"_27801":64268,"_19254":107240,"_5":13218,"_26298":107090,"_2652":107241},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3154":64327,"_27801":64268,"_19254":107243,"_5":13218,"_26298":107090,"_2652":107244},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3154":64328,"_27801":64268,"_19254":107246,"_5":13218,"_26298":107090,"_2652":107247},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3154":64329,"_27801":64329,"_5":13544,"_2652":107249,"_28144":107250,"_19254":107252,"_26298":64329},"Resolución de problemas de despliegue",[45131,106117,107251],"Operación",[],{"_3154":64330,"_27801":64329,"_19254":107254,"_5":13218,"_26298":64329,"_2652":107255},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3154":64331,"_27801":64329,"_5":28141,"_19254":107257,"_26298":107258,"_2652":107259},[],"/docs/pr-preview/pr-53/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3154":64332,"_27801":64329,"_5":28141,"_19254":107261,"_26298":107262,"_2652":107263},[],"/docs/pr-preview/pr-53/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3154":64333,"_27801":64329,"_5":28141,"_19254":107265,"_26298":107266,"_2652":107267},[],"/docs/pr-preview/pr-53/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3154":64334,"_27801":64329,"_5":28141,"_19254":107269,"_26298":107270,"_2652":107271},[],"/docs/pr-preview/pr-53/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3154":64335,"_27801":64329,"_5":28141,"_19254":107273,"_26298":107274,"_2652":107275},[],"/docs/pr-preview/pr-53/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3154":64336,"_27801":64329,"_5":28141,"_19254":107277,"_26298":107278,"_2652":107279},[],"/docs/pr-preview/pr-53/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3154":64337,"_27801":64329,"_5":28141,"_19254":107281,"_26298":107282,"_2652":107283},[],"/docs/pr-preview/pr-53/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3154":64338,"_27801":64329,"_5":28141,"_19254":107285,"_26298":107286,"_2652":107287},[],"/docs/pr-preview/pr-53/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3154":64339,"_27801":64329,"_5":28141,"_19254":107289,"_26298":107290,"_2652":107291},[],"/docs/pr-preview/pr-53/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3154":64340,"_27801":64329,"_5":28141,"_19254":107293,"_26298":107294,"_2652":107295},[],"/docs/pr-preview/pr-53/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3154":64341,"_27801":64329,"_5":28141,"_19254":107297,"_26298":107298,"_2652":107299},[],"/docs/pr-preview/pr-53/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3154":64342,"_27801":64329,"_5":28141,"_19254":107301,"_26298":107302,"_2652":107303},[],"/docs/pr-preview/pr-53/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3154":64343,"_27801":64329,"_19254":107305,"_5":13218,"_26298":64329,"_2652":107306},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3154":64344,"_27801":64329,"_19254":107308,"_5":13218,"_26298":107262,"_2652":107309},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3154":64345,"_27801":64329,"_19254":107311,"_5":13218,"_26298":107266,"_2652":107312},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3154":64346,"_27801":64329,"_19254":107314,"_5":13218,"_26298":107270,"_2652":107315},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3154":64347,"_27801":64329,"_19254":107317,"_5":13218,"_26298":107274,"_2652":107318},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3154":64348,"_27801":64329,"_19254":107320,"_5":13218,"_26298":107278,"_2652":107321},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3154":64349,"_27801":64329,"_19254":107323,"_5":13218,"_26298":107282,"_2652":107324},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3154":64350,"_27801":64329,"_19254":107326,"_5":13218,"_26298":107282,"_2652":107327},[],"Ejecuta también la prueba de conectividad del chart:",{"_3154":64351,"_27801":64329,"_19254":107329,"_5":13218,"_26298":107282,"_2652":107330},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3154":64352,"_27801":64329,"_19254":107332,"_5":13218,"_26298":107282,"_2652":107333},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3154":64353,"_27801":64329,"_19254":107335,"_5":13218,"_26298":107286,"_2652":107336},[],"Si recibes un 401:",{"_3154":64354,"_27801":64329,"_19254":107338,"_5":13218,"_26298":107286,"_2652":107339},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3154":64355,"_27801":64329,"_19254":107341,"_5":13218,"_26298":107286,"_2652":107342},[],"verifica emisor, audiencia y expiración del token;",{"_3154":64356,"_27801":64329,"_19254":107344,"_5":13218,"_26298":107286,"_2652":107345},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3154":64357,"_27801":64329,"_19254":107347,"_5":13218,"_26298":107286,"_2652":107348},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3154":64358,"_27801":64329,"_19254":107350,"_5":13218,"_26298":107286,"_2652":107351},[],"Si el login termina pero las APIs devuelven 403:",{"_3154":64359,"_27801":64329,"_19254":107353,"_5":13218,"_26298":107286,"_2652":107354},[],"inspecciona los claims reales del token;",{"_3154":64360,"_27801":64329,"_19254":107356,"_5":13218,"_26298":107286,"_2652":107357},[],"confirma que coinciden con un principal activo;",{"_3154":64361,"_27801":64329,"_19254":107359,"_5":13218,"_26298":107286,"_2652":107360},[],"revisa las políticas concedidas al principal;",{"_3154":64362,"_27801":64329,"_19254":107362,"_5":13218,"_26298":107286,"_2652":107363},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3154":64363,"_27801":64329,"_19254":107365,"_5":13218,"_26298":107286,"_2652":107366},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3154":64364,"_27801":64329,"_19254":107368,"_5":13218,"_26298":107290,"_2652":107369},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3154":64365,"_27801":64329,"_19254":107371,"_5":13218,"_26298":107290,"_2652":107372},[],"Localiza el pod y Service de authz.",{"_3154":64366,"_27801":64329,"_19254":107374,"_5":13218,"_26298":107290,"_2652":107375},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3154":64367,"_27801":64329,"_19254":107377,"_5":13218,"_26298":107290,"_2652":107378},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3154":64368,"_27801":64329,"_19254":107380,"_5":13218,"_26298":107290,"_2652":107381},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3154":64369,"_27801":64329,"_19254":107383,"_5":13218,"_26298":107290,"_2652":107384},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3154":64370,"_27801":64329,"_19254":107386,"_5":13218,"_26298":107294,"_2652":107387},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3154":64371,"_27801":64329,"_19254":107389,"_5":13218,"_26298":107294,"_2652":107390},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3154":64372,"_27801":64329,"_19254":107392,"_5":13218,"_26298":107294,"_2652":107393},[],"volumen persistente sin enlazar;",{"_3154":64373,"_27801":64329,"_19254":107395,"_5":13218,"_26298":107294,"_2652":107396},[],"imagen inaccesible o política de pull incorrecta;",{"_3154":64374,"_27801":64329,"_19254":107398,"_5":13218,"_26298":107294,"_2652":107399},[],"configuración inválida del motor criptográfico;",{"_3154":64375,"_27801":64329,"_19254":107401,"_5":13218,"_26298":107294,"_2652":107402},[],"límites de CPU o memoria demasiado bajos;",{"_3154":64376,"_27801":64329,"_19254":107404,"_5":13218,"_26298":107294,"_2652":107405},[],"migración previa incompleta.",{"_3154":64377,"_27801":64329,"_19254":107407,"_5":13218,"_26298":107294,"_2652":107408},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3154":64378,"_27801":64329,"_19254":107410,"_5":13218,"_26298":107294,"_2652":107411},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3154":64379,"_27801":64329,"_19254":107413,"_5":13218,"_26298":107298,"_2652":107414},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3154":64380,"_27801":64329,"_19254":107416,"_5":13218,"_26298":107298,"_2652":107417},[],"verifica que esté habilitado en el servicio emisor;",{"_3154":64381,"_27801":64329,"_19254":107419,"_5":13218,"_26298":107298,"_2652":107420},[],"comprueba conectividad y credenciales AMQP;",{"_3154":64382,"_27801":64329,"_19254":107422,"_5":13218,"_26298":107298,"_2652":107423},[],"revisa exchange, routing key, colas y consumidores;",{"_3154":64383,"_27801":64329,"_19254":107425,"_5":13218,"_26298":107298,"_2652":107426},[],"inspecciona dead-letter queues;",{"_3154":64384,"_27801":64329,"_19254":107428,"_5":13218,"_26298":107298,"_2652":107429},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3154":64385,"_27801":64329,"_19254":107431,"_5":13218,"_26298":107298,"_2652":107432},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3154":64386,"_27801":64329,"_19254":107434,"_5":13218,"_26298":107302,"_2652":107435},[],"El chart puede habilitar instrumentación OpenTelemetry. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, authz, servicio y dependencia.",{"_3154":64387,"_27801":64329,"_19254":107437,"_5":13218,"_26298":107302,"_2652":107438},[],"Antes de cerrar una incidencia, guarda:",{"_3154":64388,"_27801":64329,"_19254":107440,"_5":13218,"_26298":107302,"_2652":107441},[],"causa confirmada;",{"_3154":64389,"_27801":64329,"_19254":107443,"_5":13218,"_26298":107302,"_2652":107444},[],"alcance temporal y recursos afectados;",{"_3154":64390,"_27801":64329,"_19254":107446,"_5":13218,"_26298":107302,"_2652":107447},[],"comandos o consultas utilizados;",{"_3154":64391,"_27801":64329,"_19254":107449,"_5":13218,"_26298":107302,"_2652":107450},[],"cambio aplicado y forma de revertirlo;",{"_3154":64392,"_27801":64329,"_19254":107452,"_5":13218,"_26298":107302,"_2652":107453},[],"validación desde un consumidor;",{"_3154":64393,"_27801":64329,"_19254":107455,"_5":13218,"_26298":107302,"_2652":107456},[],"acción preventiva y propietario.",{"_3154":64394,"_27801":64394,"_5":13544,"_2652":107458,"_28144":107459,"_19254":107462,"_26298":64394},"Control de acceso",[45131,107460,107461],"Plataforma","Administración",[],{"_3154":64395,"_27801":64394,"_19254":107464,"_5":13218,"_26298":64394,"_2652":107465},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3154":64396,"_27801":64394,"_5":28141,"_19254":107467,"_26298":107468,"_2652":107469},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3154":64397,"_27801":64394,"_5":28141,"_19254":107471,"_26298":107472,"_2652":107473},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3154":64398,"_27801":64394,"_5":28141,"_19254":107475,"_26298":107476,"_2652":107477},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3154":64399,"_27801":64394,"_5":28141,"_19254":107479,"_26298":107480,"_2652":107481},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3154":64400,"_27801":64394,"_5":28141,"_19254":107483,"_26298":107484,"_2652":107485},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3154":64401,"_27801":64394,"_5":28141,"_19254":107487,"_26298":107488,"_2652":107489},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3154":64402,"_27801":64394,"_5":28141,"_19254":107491,"_26298":107492,"_2652":107493},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3154":64403,"_27801":64394,"_5":28141,"_19254":107495,"_26298":107496,"_2652":107497},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3154":64404,"_27801":64394,"_5":28141,"_19254":107499,"_26298":107500,"_2652":107501},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3154":64405,"_27801":64394,"_5":28141,"_19254":107503,"_26298":107504,"_2652":107505},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3154":64406,"_27801":64394,"_5":28141,"_19254":107507,"_26298":107508,"_2652":107509},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3154":64407,"_27801":64394,"_5":28141,"_19254":107511,"_26298":107512,"_2652":107513},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3154":64408,"_27801":64394,"_5":28141,"_19254":107515,"_26298":107516,"_2652":107517},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3154":64409,"_27801":64394,"_5":28141,"_19254":107519,"_26298":107520,"_2652":107521},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3154":64410,"_27801":64394,"_5":28141,"_19254":107523,"_26298":107524,"_2652":107525},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3154":64411,"_27801":64394,"_5":28141,"_19254":107527,"_26298":107528,"_2652":106719},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3154":64412,"_27801":64394,"_5":28141,"_19254":107530,"_26298":107531,"_2652":107532},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3154":64413,"_27801":64394,"_5":28141,"_19254":107534,"_26298":107535,"_2652":107536},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_3154":64414,"_27801":64394,"_5":28141,"_19254":107538,"_26298":107539,"_2652":107540},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3154":64415,"_27801":64394,"_5":28141,"_19254":107542,"_26298":107543,"_2652":107544},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3154":64416,"_27801":64394,"_5":28141,"_19254":107546,"_26298":107547,"_2652":107548},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3154":64417,"_27801":64394,"_5":28141,"_19254":107550,"_26298":107551,"_2652":107552},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3154":64418,"_27801":64394,"_5":28141,"_19254":107554,"_26298":107555,"_2652":107556},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3154":64419,"_27801":64394,"_5":28141,"_19254":107558,"_26298":107559,"_2652":107560},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3154":64420,"_27801":64394,"_5":28141,"_19254":107562,"_26298":107563,"_2652":107564},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3154":64421,"_27801":64394,"_5":28141,"_19254":107566,"_26298":107567,"_2652":107568},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3154":64422,"_27801":64394,"_5":28141,"_19254":107570,"_26298":107571,"_2652":107572},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3154":64423,"_27801":64394,"_5":28141,"_19254":107574,"_26298":107575,"_2652":107576},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3154":64424,"_27801":64394,"_5":28141,"_19254":107578,"_26298":107579,"_2652":107580},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3154":64425,"_27801":64394,"_5":28141,"_19254":107582,"_26298":107583,"_2652":107584},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3154":64426,"_27801":64394,"_5":28141,"_19254":107586,"_26298":107587,"_2652":107588},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3154":64427,"_27801":64394,"_19254":107590,"_5":13218,"_26298":64394,"_2652":107591},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3154":64428,"_27801":64394,"_19254":107593,"_5":13218,"_26298":64394,"_2652":107594},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3154":64429,"_27801":64394,"_19254":107596,"_5":13218,"_26298":64394,"_2652":107597},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3154":64430,"_27801":64394,"_19254":107599,"_5":13218,"_26298":107468,"_2652":107600},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3154":64431,"_27801":64394,"_19254":107602,"_5":13218,"_26298":107468,"_2652":107603},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3154":64432,"_27801":64394,"_19254":107605,"_5":13218,"_26298":107468,"_2652":107606},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3154":64433,"_27801":64394,"_19254":107608,"_5":13218,"_26298":107468,"_2652":107609},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3154":64434,"_27801":64394,"_19254":107611,"_5":13218,"_26298":107468,"_2652":107612},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3154":64435,"_27801":64394,"_19254":107614,"_5":13218,"_26298":107468,"_2652":107615},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3154":64436,"_27801":64394,"_19254":107617,"_5":13218,"_26298":107472,"_2652":107618},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3154":64437,"_27801":64394,"_19254":107620,"_5":13218,"_26298":107472,"_2652":107621},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3154":64438,"_27801":64394,"_19254":107623,"_5":13218,"_26298":107476,"_2652":107624},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3154":64439,"_27801":64394,"_19254":107626,"_5":13218,"_26298":107476,"_2652":107627},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3154":64440,"_27801":64394,"_19254":107629,"_5":13218,"_26298":107476,"_2652":107630},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3154":64441,"_27801":64394,"_19254":107632,"_5":13218,"_26298":107476,"_2652":107633},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3154":64442,"_27801":64394,"_19254":107635,"_5":13218,"_26298":107476,"_2652":107636},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3154":64443,"_27801":64394,"_19254":107638,"_5":13218,"_26298":107476,"_2652":107639},[],"Carga por separado las políticas concedidas a cada principal.",{"_3154":64444,"_27801":64394,"_19254":107641,"_5":13218,"_26298":107476,"_2652":107642},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3154":64445,"_27801":64394,"_19254":107644,"_5":13218,"_26298":107476,"_2652":107645},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3154":64446,"_27801":64394,"_19254":107647,"_5":13218,"_26298":107476,"_2652":107648},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3154":64447,"_27801":64394,"_19254":107650,"_5":13218,"_26298":107476,"_2652":107651},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3154":64448,"_27801":64394,"_19254":107653,"_5":13218,"_26298":107476,"_2652":107654},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad.",{"_3154":64449,"_27801":64394,"_19254":107656,"_5":13218,"_26298":107476,"_2652":107657},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3154":64450,"_27801":64394,"_19254":107659,"_5":13218,"_26298":107480,"_2652":107660},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3154":64451,"_27801":64394,"_19254":107662,"_5":13218,"_26298":107480,"_2652":107663},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3154":64452,"_27801":64394,"_19254":107665,"_5":13218,"_26298":107480,"_2652":107666},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3154":64453,"_27801":64394,"_19254":107668,"_5":13218,"_26298":107480,"_2652":107669},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3154":64454,"_27801":64394,"_19254":107671,"_5":13218,"_26298":107480,"_2652":107672},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3154":64455,"_27801":64394,"_19254":107674,"_5":13218,"_26298":107480,"_2652":107675},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3154":64456,"_27801":64394,"_19254":107677,"_5":13218,"_26298":107480,"_2652":107678},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3154":64457,"_27801":64394,"_19254":107680,"_5":13218,"_26298":107480,"_2652":107681},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3154":64458,"_27801":64394,"_19254":107683,"_5":13218,"_26298":107484,"_2652":107684},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3154":64459,"_27801":64394,"_19254":107686,"_5":13218,"_26298":107484,"_2652":107687},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3154":64460,"_27801":64394,"_19254":107689,"_5":13218,"_26298":107484,"_2652":107690},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3154":64461,"_27801":64394,"_19254":107692,"_5":13218,"_26298":107484,"_2652":107693},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3154":64462,"_27801":64394,"_19254":107695,"_5":13218,"_26298":107484,"_2652":107696},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3154":64463,"_27801":64394,"_19254":107698,"_5":13218,"_26298":107484,"_2652":107699},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3154":64464,"_27801":64394,"_19254":107701,"_5":13218,"_26298":107484,"_2652":107702},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3154":64465,"_27801":64394,"_19254":107704,"_5":13218,"_26298":107484,"_2652":107705},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3154":64466,"_27801":64394,"_19254":107707,"_5":13218,"_26298":107484,"_2652":107708},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3154":64467,"_27801":64394,"_19254":107710,"_5":13218,"_26298":107484,"_2652":107711},[],"Las acciones se dividen en dos grupos:",{"_3154":64468,"_27801":64394,"_19254":107713,"_5":13218,"_26298":107484,"_2652":107714},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3154":64469,"_27801":64394,"_19254":107716,"_5":13218,"_26298":107484,"_2652":107717},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3154":64470,"_27801":64394,"_19254":107719,"_5":13218,"_26298":107484,"_2652":107720},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3154":64471,"_27801":64394,"_19254":107722,"_5":13218,"_26298":107488,"_2652":107723},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3154":64472,"_27801":64394,"_19254":107725,"_5":13218,"_26298":107488,"_2652":107726},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3154":64473,"_27801":64394,"_19254":107728,"_5":13218,"_26298":107488,"_2652":107729},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3154":64474,"_27801":64394,"_19254":107731,"_5":13218,"_26298":107492,"_2652":107732},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3154":64475,"_27801":64394,"_19254":107734,"_5":13218,"_26298":107492,"_2652":107735},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3154":64476,"_27801":64394,"_19254":107737,"_5":13218,"_26298":107492,"_2652":107738},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3154":64477,"_27801":64394,"_19254":107740,"_5":13218,"_26298":107492,"_2652":107741},[],"Los operadores implementados son:",{"_3154":64478,"_27801":64394,"_19254":107743,"_5":13218,"_26298":107492,"_2652":107744},[],"`equals`, para igualdad exacta;",{"_3154":64479,"_27801":64394,"_19254":107746,"_5":13218,"_26298":107492,"_2652":107747},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3154":64480,"_27801":64394,"_19254":107749,"_5":13218,"_26298":107492,"_2652":107750},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3154":64481,"_27801":64394,"_19254":107752,"_5":13218,"_26298":107492,"_2652":107753},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3154":64482,"_27801":64394,"_19254":107755,"_5":13218,"_26298":107496,"_2652":107756},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3154":64483,"_27801":64394,"_19254":107758,"_5":13218,"_26298":107496,"_2652":107759},[],"Los modos disponibles son:",{"_3154":64484,"_27801":64394,"_19254":107761,"_5":13218,"_26298":107496,"_2652":107762},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3154":64485,"_27801":64394,"_19254":107764,"_5":13218,"_26298":107496,"_2652":107765},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3154":64486,"_27801":64394,"_19254":107767,"_5":13218,"_26298":107496,"_2652":107768},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3154":64487,"_27801":64394,"_19254":107770,"_5":13218,"_26298":107496,"_2652":107771},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3154":64488,"_27801":64394,"_19254":107773,"_5":13218,"_26298":107496,"_2652":107774},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3154":64489,"_27801":64394,"_19254":107776,"_5":13218,"_26298":107496,"_2652":107777},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3154":64490,"_27801":64394,"_19254":107779,"_5":13218,"_26298":107500,"_2652":107780},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3154":64491,"_27801":64394,"_19254":107782,"_5":13218,"_26298":107500,"_2652":107783},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3154":64492,"_27801":64394,"_19254":107785,"_5":13218,"_26298":107500,"_2652":107786},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3154":64493,"_27801":64394,"_19254":107788,"_5":13218,"_26298":107500,"_2652":107789},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3154":64494,"_27801":64394,"_19254":107791,"_5":13218,"_26298":107508,"_2652":107792},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3154":64495,"_27801":64394,"_19254":107794,"_5":13218,"_26298":107508,"_2652":107795},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3154":64496,"_27801":64394,"_19254":107797,"_5":13218,"_26298":107512,"_2652":107798},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora y la de un dispositivo con su DMS. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3154":64497,"_27801":64394,"_19254":107800,"_5":13218,"_26298":107512,"_2652":107801},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3154":64498,"_27801":64394,"_19254":107803,"_5":13218,"_26298":107516,"_2652":107804},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3154":64499,"_27801":64394,"_19254":107806,"_5":13218,"_26298":107516,"_2652":107807},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3154":64500,"_27801":64394,"_19254":107809,"_5":13218,"_26298":107516,"_2652":107810},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3154":64501,"_27801":64394,"_19254":107812,"_5":13218,"_26298":107520,"_2652":107813},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3154":64502,"_27801":64394,"_19254":107815,"_5":13218,"_26298":107520,"_2652":107816},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3154":64503,"_27801":64394,"_19254":107818,"_5":13218,"_26298":107520,"_2652":107819},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3154":64504,"_27801":64394,"_19254":107821,"_5":13218,"_26298":107520,"_2652":107822},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3154":64505,"_27801":64394,"_19254":107824,"_5":13218,"_26298":107520,"_2652":107825},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3154":64506,"_27801":64394,"_19254":107827,"_5":13218,"_26298":107520,"_2652":107828},[],"Ten en cuenta que:",{"_3154":64507,"_27801":64394,"_19254":107830,"_5":13218,"_26298":107520,"_2652":107831},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3154":64508,"_27801":64394,"_19254":107833,"_5":13218,"_26298":107520,"_2652":107834},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3154":64509,"_27801":64394,"_19254":107836,"_5":13218,"_26298":107520,"_2652":107837},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3154":64510,"_27801":64394,"_19254":107839,"_5":13218,"_26298":107524,"_2652":107840},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3154":64511,"_27801":64394,"_19254":107842,"_5":13218,"_26298":107524,"_2652":107843},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3154":64512,"_27801":64394,"_19254":107845,"_5":13218,"_26298":107524,"_2652":107846},[],"acceso completo y de solo lectura a KMS;",{"_3154":64513,"_27801":64394,"_19254":107848,"_5":13218,"_26298":107524,"_2652":107849},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3154":64514,"_27801":64394,"_19254":107851,"_5":13218,"_26298":107524,"_2652":107852},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3154":64515,"_27801":64394,"_19254":107854,"_5":13218,"_26298":107524,"_2652":107855},[],"acceso a la interfaz;",{"_3154":64516,"_27801":64394,"_19254":107857,"_5":13218,"_26298":107524,"_2652":107858},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3154":64517,"_27801":64394,"_19254":107860,"_5":13218,"_26298":107524,"_2652":107861},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3154":64518,"_27801":64394,"_19254":107863,"_5":13218,"_26298":107524,"_2652":107864},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3154":64519,"_27801":64394,"_19254":107866,"_5":13218,"_26298":107528,"_2652":107867},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3154":64520,"_27801":64394,"_19254":107869,"_5":13218,"_26298":107528,"_2652":107870},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3154":64521,"_27801":64394,"_19254":107872,"_5":13218,"_26298":107528,"_2652":107873},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3154":64522,"_27801":64394,"_19254":107875,"_5":13218,"_26298":107531,"_2652":107876},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3154":64523,"_27801":64394,"_19254":107878,"_5":13218,"_26298":107535,"_2652":107879},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_3154":64524,"_27801":64394,"_19254":107881,"_5":13218,"_26298":107535,"_2652":107882},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_3154":64525,"_27801":64394,"_19254":107884,"_5":13218,"_26298":107539,"_2652":107885},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3154":64526,"_27801":64394,"_19254":107887,"_5":13218,"_26298":107543,"_2652":107888},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3154":64527,"_27801":64394,"_19254":107890,"_5":13218,"_26298":107547,"_2652":107891},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3154":64528,"_27801":64394,"_19254":107893,"_5":13218,"_26298":107551,"_2652":107894},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3154":64529,"_27801":64394,"_19254":107896,"_5":13218,"_26298":107551,"_2652":107897},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3154":64530,"_27801":64394,"_19254":107899,"_5":13218,"_26298":107555,"_2652":107900},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3154":64531,"_27801":64394,"_19254":107902,"_5":13218,"_26298":107555,"_2652":107903},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3154":64532,"_27801":64394,"_19254":107905,"_5":13218,"_26298":107555,"_2652":107906},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3154":64533,"_27801":64394,"_19254":107908,"_5":13218,"_26298":107555,"_2652":107909},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3154":64534,"_27801":64394,"_19254":107911,"_5":13218,"_26298":107555,"_2652":107912},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3154":64535,"_27801":64394,"_19254":107914,"_5":13218,"_26298":107555,"_2652":107915},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3154":64536,"_27801":64394,"_19254":107917,"_5":13218,"_26298":107555,"_2652":107918},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3154":64537,"_27801":64394,"_19254":107920,"_5":13218,"_26298":107555,"_2652":107921},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3154":64538,"_27801":64394,"_19254":107923,"_5":13218,"_26298":107559,"_2652":107924},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3154":64539,"_27801":64394,"_19254":107926,"_5":13218,"_26298":107559,"_2652":107927},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3154":64540,"_27801":64394,"_19254":107929,"_5":13218,"_26298":107559,"_2652":107930},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3154":64541,"_27801":64394,"_19254":107932,"_5":13218,"_26298":107563,"_2652":107933},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3154":64542,"_27801":64394,"_19254":107935,"_5":13218,"_26298":107563,"_2652":107936},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3154":64543,"_27801":64394,"_19254":107938,"_5":13218,"_26298":107563,"_2652":107939},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3154":64544,"_27801":64394,"_19254":107941,"_5":13218,"_26298":107563,"_2652":107942},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3154":64545,"_27801":64394,"_19254":107944,"_5":13218,"_26298":107563,"_2652":107945},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3154":64546,"_27801":64394,"_19254":107947,"_5":13218,"_26298":107563,"_2652":107948},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3154":64547,"_27801":64394,"_19254":107950,"_5":13218,"_26298":107563,"_2652":107951},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3154":64548,"_27801":64394,"_19254":107953,"_5":13218,"_26298":107563,"_2652":107954},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3154":64549,"_27801":64394,"_19254":107956,"_5":13218,"_26298":107571,"_2652":107957},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3154":64550,"_27801":64394,"_19254":107959,"_5":13218,"_26298":107575,"_2652":107960},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3154":64551,"_27801":64394,"_19254":107962,"_5":13218,"_26298":107575,"_2652":107963},[],"que exista un principal activo del tipo correcto;",{"_3154":64552,"_27801":64394,"_19254":107965,"_5":13218,"_26298":107575,"_2652":107966},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3154":64553,"_27801":64394,"_19254":107968,"_5":13218,"_26298":107575,"_2652":107969},[],"que todas las condiciones del principal se cumplan;",{"_3154":64554,"_27801":64394,"_19254":107971,"_5":13218,"_26298":107575,"_2652":107972},[],"que el principal tenga concedida la política esperada;",{"_3154":64555,"_27801":64394,"_19254":107974,"_5":13218,"_26298":107575,"_2652":107975},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3154":64556,"_27801":64394,"_19254":107977,"_5":13218,"_26298":107575,"_2652":107978},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3154":64557,"_27801":64394,"_19254":107980,"_5":13218,"_26298":107575,"_2652":107981},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con la instrumentación OpenTelemetry habilitada, cada decisión genera además un span —`engine.CheckHTTP` en el camino del Gateway— cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente, de forma que puedas correlacionar la denegación con la traza del Gateway.",{"_3154":64558,"_27801":64394,"_19254":107983,"_5":13218,"_26298":107579,"_2652":107984},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3154":64559,"_27801":64394,"_19254":107986,"_5":13218,"_26298":107583,"_2652":107987},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3154":64560,"_27801":64394,"_19254":107989,"_5":13218,"_26298":107587,"_2652":107990},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3154":64561,"_27801":64394,"_19254":107992,"_5":13218,"_26298":107587,"_2652":107993},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3154":64562,"_27801":64562,"_5":13544,"_2652":107995,"_28144":107996,"_19254":107997,"_26298":64562},"Alertas y suscripciones",[45131,107460,107461],[],{"_3154":64563,"_27801":64562,"_19254":107999,"_5":13218,"_26298":64562,"_2652":108000},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3154":64564,"_27801":64562,"_5":28141,"_19254":108002,"_26298":108003,"_2652":108004},[],"/docs/pr-preview/pr-53/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3154":64565,"_27801":64562,"_5":28141,"_19254":108006,"_26298":108007,"_2652":108008},[],"/docs/pr-preview/pr-53/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3154":64566,"_27801":64562,"_5":28141,"_19254":108010,"_26298":108011,"_2652":108012},[],"/docs/pr-preview/pr-53/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3154":64567,"_27801":64562,"_5":28141,"_19254":108014,"_26298":108015,"_2652":108016},[],"/docs/pr-preview/pr-53/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3154":64568,"_27801":64562,"_5":28141,"_19254":108018,"_26298":108019,"_2652":108020},[],"/docs/pr-preview/pr-53/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3154":64569,"_27801":64562,"_5":28141,"_19254":108022,"_26298":108023,"_2652":108024},[],"/docs/pr-preview/pr-53/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3154":64570,"_27801":64562,"_5":28141,"_19254":108026,"_26298":108027,"_2652":108028},[],"/docs/pr-preview/pr-53/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3154":64571,"_27801":64562,"_5":28141,"_19254":108030,"_26298":108031,"_2652":108032},[],"/docs/pr-preview/pr-53/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3154":64572,"_27801":64562,"_5":28141,"_19254":108034,"_26298":108035,"_2652":108036},[],"/docs/pr-preview/pr-53/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3154":64573,"_27801":64562,"_5":28141,"_19254":108038,"_26298":108039,"_2652":108040},[],"/docs/pr-preview/pr-53/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3154":64574,"_27801":64562,"_19254":108042,"_5":13218,"_26298":64562,"_2652":108043},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3154":64575,"_27801":64562,"_19254":108045,"_5":13218,"_26298":108003,"_2652":108046},[],"Un servicio publica un evento de dominio.",{"_3154":64576,"_27801":64562,"_19254":108048,"_5":13218,"_26298":108003,"_2652":108049},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3154":64577,"_27801":64562,"_19254":108051,"_5":13218,"_26298":108003,"_2652":108052},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3154":64578,"_27801":64562,"_19254":108054,"_5":13218,"_26298":108003,"_2652":108055},[],"Lamassu entrega el evento al canal configurado.",{"_3154":64579,"_27801":64562,"_19254":108057,"_5":13218,"_26298":108003,"_2652":108058},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3154":64580,"_27801":64562,"_19254":108060,"_5":13218,"_26298":108007,"_2652":108061},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3154":64581,"_27801":64562,"_19254":108063,"_5":13218,"_26298":108007,"_2652":108064},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3154":64582,"_27801":64562,"_19254":108066,"_5":13218,"_26298":108007,"_2652":108067},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3154":64583,"_27801":64562,"_19254":108069,"_5":13218,"_26298":108007,"_2652":108070},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3154":64584,"_27801":64562,"_19254":108072,"_5":13218,"_26298":108007,"_2652":108073},[],"`apikey_options` necesita `header` y `key`.",{"_3154":64585,"_27801":64562,"_19254":108075,"_5":13218,"_26298":108007,"_2652":108076},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3154":64586,"_27801":64562,"_19254":108078,"_5":13218,"_26298":108007,"_2652":108079},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3154":64587,"_27801":64562,"_19254":108081,"_5":13218,"_26298":108007,"_2652":108082},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3154":64588,"_27801":64562,"_19254":108084,"_5":13218,"_26298":108015,"_2652":108085},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3154":64589,"_27801":64562,"_19254":108087,"_5":13218,"_26298":108019,"_2652":108088},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3154":64590,"_27801":64562,"_19254":108090,"_5":13218,"_26298":108023,"_2652":108091},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3154":64591,"_27801":64562,"_19254":108093,"_5":13218,"_26298":108023,"_2652":108094},[],"**None** notifica todas las instancias del evento.",{"_3154":64592,"_27801":64562,"_19254":108096,"_5":13218,"_26298":108023,"_2652":108097},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3154":64593,"_27801":64562,"_19254":108099,"_5":13218,"_26298":108023,"_2652":108100},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3154":64594,"_27801":64562,"_19254":108102,"_5":13218,"_26298":108023,"_2652":108103},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3154":64595,"_27801":64562,"_19254":108105,"_5":13218,"_26298":108023,"_2652":108106},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3154":64596,"_27801":64562,"_19254":108108,"_5":13218,"_26298":108027,"_2652":108109},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3154":64597,"_27801":64562,"_19254":108111,"_5":13218,"_26298":108031,"_2652":108112},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3154":64598,"_27801":64562,"_19254":108114,"_5":13218,"_26298":108031,"_2652":108115},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3154":64599,"_27801":64562,"_19254":108117,"_5":13218,"_26298":108031,"_2652":108118},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3154":64600,"_27801":64562,"_19254":108120,"_5":13218,"_26298":108031,"_2652":108121},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3154":64601,"_27801":64562,"_19254":108123,"_5":13218,"_26298":108031,"_2652":108124},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3154":64602,"_27801":64562,"_19254":108126,"_5":13218,"_26298":108031,"_2652":108127},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3154":64603,"_27801":64562,"_19254":108129,"_5":13218,"_26298":108031,"_2652":108130},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3154":64604,"_27801":64562,"_19254":108132,"_5":13218,"_26298":108031,"_2652":108133},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3154":64605,"_27801":64562,"_19254":108135,"_5":13218,"_26298":108035,"_2652":108136},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3154":64606,"_27801":64562,"_19254":108138,"_5":13218,"_26298":108039,"_2652":108139},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3154":64607,"_27801":64562,"_19254":108141,"_5":13218,"_26298":108039,"_2652":108142},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3154":64608,"_27801":64562,"_19254":108144,"_5":13218,"_26298":108039,"_2652":108145},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3154":64609,"_27801":64562,"_19254":108147,"_5":13218,"_26298":108039,"_2652":108148},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3154":64610,"_27801":64562,"_19254":108150,"_5":13218,"_26298":108039,"_2652":108151},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3154":64611,"_27801":64562,"_19254":108153,"_5":13218,"_26298":108039,"_2652":108154},[],"**Validación:** `va.role.crl.create`.",{"_3154":64612,"_27801":64562,"_19254":108156,"_5":13218,"_26298":108039,"_2652":108157},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3154":64613,"_27801":64562,"_19254":108159,"_5":13218,"_26298":108039,"_2652":108160},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3154":64614,"_27801":64614,"_5":13544,"_2652":108162,"_28144":108163,"_19254":108164,"_26298":64614},"Registros de auditoría",[45131,107460,107461],[],{"_3154":64615,"_27801":64614,"_19254":108166,"_5":13218,"_26298":64614,"_2652":108167},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3154":64616,"_27801":64614,"_5":28141,"_19254":108169,"_26298":108170,"_2652":108171},[],"/docs/pr-preview/pr-53/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3154":64617,"_27801":64614,"_5":28141,"_19254":108173,"_26298":108174,"_2652":108175},[],"/docs/pr-preview/pr-53/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3154":64618,"_27801":64614,"_5":28141,"_19254":108177,"_26298":108178,"_2652":108179},[],"/docs/pr-preview/pr-53/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3154":64619,"_27801":64614,"_5":28141,"_19254":108181,"_26298":108182,"_2652":108183},[],"/docs/pr-preview/pr-53/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3154":64620,"_27801":64614,"_5":28141,"_19254":108185,"_26298":108186,"_2652":108187},[],"/docs/pr-preview/pr-53/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3154":64621,"_27801":64614,"_5":28141,"_19254":108189,"_26298":108190,"_2652":108191},[],"/docs/pr-preview/pr-53/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3154":64622,"_27801":64614,"_5":28141,"_19254":108193,"_26298":108194,"_2652":108195},[],"/docs/pr-preview/pr-53/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3154":64623,"_27801":64614,"_5":28141,"_19254":108197,"_26298":108198,"_2652":108199},[],"/docs/pr-preview/pr-53/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3154":64624,"_27801":64614,"_5":28141,"_19254":108201,"_26298":108202,"_2652":108203},[],"/docs/pr-preview/pr-53/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3154":64625,"_27801":64614,"_5":28141,"_19254":108205,"_26298":108206,"_2652":108207},[],"/docs/pr-preview/pr-53/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3154":64626,"_27801":64614,"_5":28141,"_19254":108209,"_26298":108210,"_2652":108211},[],"/docs/pr-preview/pr-53/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3154":64627,"_27801":64614,"_19254":108213,"_5":13218,"_26298":64614,"_2652":108214},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3154":64628,"_27801":64614,"_19254":108216,"_5":13218,"_26298":108170,"_2652":108217},[],"El cuerpo de auditoría incluye:",{"_3154":64629,"_27801":64614,"_19254":108219,"_5":13218,"_26298":108170,"_2652":108220},[],"input: datos recibidos por la operación;",{"_3154":64630,"_27801":64614,"_19254":108222,"_5":13218,"_26298":108170,"_2652":108223},[],"has\\_error: indica si el servicio devolvió un error;",{"_3154":64631,"_27801":64614,"_19254":108225,"_5":13218,"_26298":108170,"_2652":108226},[],"output: resultado producido o mensaje de error;",{"_3154":64632,"_27801":64614,"_19254":108228,"_5":13218,"_26298":108170,"_2652":108229},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3154":64633,"_27801":64614,"_19254":108231,"_5":13218,"_26298":108170,"_2652":108232},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3154":64634,"_27801":64614,"_19254":108234,"_5":13218,"_26298":108170,"_2652":108235},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3154":64635,"_27801":64614,"_19254":108237,"_5":13218,"_26298":108174,"_2652":108238},[],"El backend aplica auditoría a mutaciones de:",{"_3154":64636,"_27801":64614,"_19254":108240,"_5":13218,"_26298":108174,"_2652":108241},[],"autoridades, certificados y perfiles de emisión;",{"_3154":64637,"_27801":64614,"_19254":108243,"_5":13218,"_26298":108174,"_2652":108244},[],"claves y motores KMS;",{"_3154":64638,"_27801":64614,"_19254":108246,"_5":13218,"_26298":108174,"_2652":108247},[],"dispositivos e identidades;",{"_3154":64639,"_27801":64614,"_19254":108249,"_5":13218,"_26298":108174,"_2652":108250},[],"DMS y operaciones de enrolamiento;",{"_3154":64640,"_27801":64614,"_19254":108252,"_5":13218,"_26298":108174,"_2652":108253},[],"funciones de validación y CRL;",{"_3154":64641,"_27801":64614,"_19254":108255,"_5":13218,"_26298":108174,"_2652":108256},[],"principales, políticas y concesiones de autorización.",{"_3154":64642,"_27801":64614,"_19254":108258,"_5":13218,"_26298":108174,"_2652":108259},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3154":64643,"_27801":64614,"_19254":108261,"_5":13218,"_26298":108178,"_2652":108262},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3154":64644,"_27801":64614,"_19254":108264,"_5":13218,"_26298":108178,"_2652":108265},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3154":64645,"_27801":64614,"_19254":108267,"_5":13218,"_26298":108178,"_2652":108268},[],"Diseña el consumidor para:",{"_3154":64646,"_27801":64614,"_19254":108270,"_5":13218,"_26298":108178,"_2652":108271},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3154":64647,"_27801":64614,"_19254":108273,"_5":13218,"_26298":108178,"_2652":108274},[],"conservar el CloudEvent completo sin modificar;",{"_3154":64648,"_27801":64614,"_19254":108276,"_5":13218,"_26298":108178,"_2652":108277},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3154":64649,"_27801":64614,"_19254":108279,"_5":13218,"_26298":108178,"_2652":108280},[],"cifrar en tránsito y en reposo;",{"_3154":64650,"_27801":64614,"_19254":108282,"_5":13218,"_26298":108178,"_2652":108283},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3154":64651,"_27801":64614,"_19254":108285,"_5":13218,"_26298":108178,"_2652":108286},[],"aplicar una política explícita de retención y legal hold;",{"_3154":64652,"_27801":64614,"_19254":108288,"_5":13218,"_26298":108178,"_2652":108289},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3154":64653,"_27801":64614,"_19254":108291,"_5":13218,"_26298":108182,"_2652":108292},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3154":64654,"_27801":64614,"_19254":108294,"_5":13218,"_26298":108182,"_2652":108295},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3154":64655,"_27801":64614,"_19254":108297,"_5":13218,"_26298":108190,"_2652":108298},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3154":64656,"_27801":64614,"_19254":108300,"_5":13218,"_26298":108194,"_2652":108301},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3154":64657,"_27801":64614,"_19254":108303,"_5":13218,"_26298":108198,"_2652":108304},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3154":64658,"_27801":64614,"_19254":108306,"_5":13218,"_26298":108202,"_2652":108307},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3154":64659,"_27801":64614,"_19254":108309,"_5":13218,"_26298":108206,"_2652":108310},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3154":64660,"_27801":64614,"_19254":108312,"_5":13218,"_26298":108210,"_2652":108313},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3154":64661,"_27801":64614,"_19254":108315,"_5":13218,"_26298":108210,"_2652":108316},[],"aparece un evento de auditoría correcto;",{"_3154":64662,"_27801":64614,"_19254":108318,"_5":13218,"_26298":108210,"_2652":108319},[],"el principal coincide con la identidad utilizada;",{"_3154":64663,"_27801":64614,"_19254":108321,"_5":13218,"_26298":108210,"_2652":108322},[],"el consumidor lo persiste una sola vez;",{"_3154":64664,"_27801":64614,"_19254":108324,"_5":13218,"_26298":108210,"_2652":108325},[],"puede recuperarse por recurso, actor y periodo;",{"_3154":64665,"_27801":64614,"_19254":108327,"_5":13218,"_26298":108210,"_2652":108328},[],"una interrupción del consumidor produce una alerta.",{"_3154":64666,"_27801":64614,"_19254":108330,"_5":13218,"_26298":108210,"_2652":108331},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3154":64667,"_27801":64667,"_5":13544,"_2652":108333,"_28144":108334,"_19254":108335,"_26298":64667},"Arquitectura de la plataforma",[45131,107460],[],{"_3154":64668,"_27801":64667,"_19254":108337,"_5":13218,"_26298":64667,"_2652":108338},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3154":64669,"_27801":64667,"_5":28141,"_19254":108340,"_26298":108341,"_2652":108342},[],"/docs/pr-preview/pr-53/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3154":64670,"_27801":64667,"_5":28141,"_19254":108344,"_26298":108345,"_2652":108346},[],"/docs/pr-preview/pr-53/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3154":64671,"_27801":64667,"_5":28141,"_19254":108348,"_26298":108349,"_2652":108350},[],"/docs/pr-preview/pr-53/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3154":64672,"_27801":64667,"_5":28141,"_19254":108352,"_26298":108353,"_2652":108354},[],"/docs/pr-preview/pr-53/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3154":64673,"_27801":64667,"_5":28141,"_19254":108356,"_26298":108357,"_2652":108358},[],"/docs/pr-preview/pr-53/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3154":64674,"_27801":64667,"_19254":108360,"_5":13218,"_26298":64667,"_2652":108361},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3154":64675,"_27801":64667,"_19254":108363,"_5":13218,"_26298":64667,"_2652":108364},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3154":64676,"_27801":64667,"_19254":108366,"_5":13218,"_26298":108341,"_2652":108367},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3154":64677,"_27801":64667,"_19254":108369,"_5":13218,"_26298":108345,"_2652":108370},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3154":64678,"_27801":64667,"_19254":108372,"_5":13218,"_26298":108349,"_2652":108373},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3154":64679,"_27801":64667,"_19254":108375,"_5":13218,"_26298":108353,"_2652":108376},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3154":64680,"_27801":64667,"_19254":108378,"_5":13218,"_26298":108357,"_2652":108379},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3154":64681,"_27801":64681,"_5":13544,"_2652":108381,"_28144":108382,"_19254":108383,"_26298":64681},"Cómo funciona Lamassu",[45131,107460],[],{"_3154":64682,"_27801":64681,"_19254":108385,"_5":13218,"_26298":64681,"_2652":108386},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3154":64683,"_27801":64681,"_5":28141,"_19254":108388,"_26298":108389,"_2652":108390},[],"/docs/pr-preview/pr-53/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3154":64684,"_27801":64681,"_5":28141,"_19254":108392,"_26298":108393,"_2652":108394},[],"/docs/pr-preview/pr-53/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3154":64685,"_27801":64681,"_19254":108396,"_5":13218,"_26298":64681,"_2652":108397},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3154":64686,"_27801":64681,"_19254":108399,"_5":13218,"_26298":108389,"_2652":108400},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3154":64687,"_27801":64681,"_19254":108402,"_5":13218,"_26298":108389,"_2652":108403},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3154":64688,"_27801":64681,"_19254":108405,"_5":13218,"_26298":108389,"_2652":108406},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3154":64689,"_27801":64681,"_19254":108408,"_5":13218,"_26298":108389,"_2652":108409},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3154":64690,"_27801":64681,"_19254":108411,"_5":13218,"_26298":108389,"_2652":108412},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3154":64691,"_27801":64681,"_19254":108414,"_5":13218,"_26298":108393,"_2652":108415},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3154":64692,"_27801":64681,"_19254":108417,"_5":13218,"_26298":108393,"_2652":108418},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3154":64693,"_27801":64681,"_19254":108420,"_5":13218,"_26298":108393,"_2652":108421},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3154":64694,"_27801":64681,"_19254":108423,"_5":13218,"_26298":108393,"_2652":108424},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3154":64695,"_27801":64681,"_19254":108426,"_5":13218,"_26298":108393,"_2652":108427},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3154":64696,"_27801":64681,"_19254":108429,"_5":13218,"_26298":108393,"_2652":108430},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3154":64697,"_27801":64681,"_19254":108432,"_5":13218,"_26298":108393,"_2652":108433},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3154":64698,"_27801":64698,"_5":13544,"_2652":108435,"_28144":108436,"_19254":108437,"_26298":64698},"Dispositivos e identidades",[45131,107460,47488,108435],[],{"_3154":64699,"_27801":64698,"_19254":108439,"_5":13218,"_26298":64698,"_2652":108440},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3154":64700,"_27801":64698,"_5":28141,"_19254":108442,"_26298":108443,"_2652":108444},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3154":64701,"_27801":64698,"_5":28141,"_19254":108446,"_26298":108447,"_2652":108448},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3154":64702,"_27801":64698,"_5":28141,"_19254":108450,"_26298":108451,"_2652":108452},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3154":64703,"_27801":64698,"_5":28141,"_19254":108454,"_26298":108455,"_2652":108456},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3154":64704,"_27801":64698,"_5":28141,"_19254":108458,"_26298":108459,"_2652":108460},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3154":64705,"_27801":64698,"_5":28141,"_19254":108462,"_26298":108463,"_2652":108464},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3154":64706,"_27801":64698,"_5":28141,"_19254":108466,"_26298":108467,"_2652":108468},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3154":64707,"_27801":64698,"_5":28141,"_19254":108470,"_26298":108471,"_2652":108472},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3154":64708,"_27801":64698,"_5":28141,"_19254":108474,"_26298":108475,"_2652":108476},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3154":64709,"_27801":64698,"_5":28141,"_19254":108478,"_26298":108479,"_2652":108480},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3154":64710,"_27801":64698,"_5":28141,"_19254":108482,"_26298":108483,"_2652":108484},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3154":64711,"_27801":64698,"_19254":108486,"_5":13218,"_26298":64698,"_2652":108487},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3154":64712,"_27801":64698,"_19254":108489,"_5":13218,"_26298":64698,"_2652":108490},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3154":64713,"_27801":64698,"_19254":108492,"_5":13218,"_26298":108443,"_2652":108493},[],"Vista operativa",{"_3154":64714,"_27801":64698,"_19254":108495,"_5":13218,"_26298":108443,"_2652":108496},[],"Interpretación",{"_3154":64715,"_27801":64698,"_19254":108498,"_5":13218,"_26298":108443,"_2652":47551},[],{"_3154":64716,"_27801":64698,"_19254":108500,"_5":13218,"_26298":108443,"_2652":108501},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3154":64717,"_27801":64698,"_19254":108503,"_5":13218,"_26298":108443,"_2652":47557},[],{"_3154":64718,"_27801":64698,"_19254":108505,"_5":13218,"_26298":108443,"_2652":108506},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3154":64719,"_27801":64698,"_19254":108508,"_5":13218,"_26298":108443,"_2652":47563},[],{"_3154":64720,"_27801":64698,"_19254":108510,"_5":13218,"_26298":108443,"_2652":108511},[],"La identidad está en la ventana operativa de renovación.",{"_3154":64721,"_27801":64698,"_19254":108513,"_5":13218,"_26298":108443,"_2652":47569},[],{"_3154":64722,"_27801":64698,"_19254":108515,"_5":13218,"_26298":108443,"_2652":108516},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3154":64723,"_27801":64698,"_19254":108518,"_5":13218,"_26298":108443,"_2652":47575},[],{"_3154":64724,"_27801":64698,"_19254":108520,"_5":13218,"_26298":108443,"_2652":108521},[],"La identidad ha vencido.",{"_3154":64725,"_27801":64698,"_19254":108523,"_5":13218,"_26298":108443,"_2652":47581},[],{"_3154":64726,"_27801":64698,"_19254":108525,"_5":13218,"_26298":108443,"_2652":108526},[],"La identidad está marcada como revocada.",{"_3154":64727,"_27801":64698,"_19254":108528,"_5":13218,"_26298":108443,"_2652":47587},[],{"_3154":64728,"_27801":64698,"_19254":108530,"_5":13218,"_26298":108443,"_2652":108531},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3154":64729,"_27801":64698,"_19254":108533,"_5":13218,"_26298":108443,"_2652":108534},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3154":64730,"_27801":64698,"_19254":108536,"_5":13218,"_26298":108447,"_2652":108537},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3154":64731,"_27801":64698,"_19254":108539,"_5":13218,"_26298":108447,"_2652":108540},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3154":64732,"_27801":64698,"_19254":108542,"_5":13218,"_26298":108447,"_2652":108543},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3154":64733,"_27801":64698,"_19254":108545,"_5":13218,"_26298":108447,"_2652":108546},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3154":64734,"_27801":64698,"_19254":108548,"_5":13218,"_26298":108451,"_2652":108549},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3154":64735,"_27801":64698,"_19254":108551,"_5":13218,"_26298":108455,"_2652":108552},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3154":64736,"_27801":64698,"_19254":108554,"_5":13218,"_26298":108459,"_2652":108555},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3154":64737,"_27801":64698,"_19254":108557,"_5":13218,"_26298":108463,"_2652":108558},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3154":64738,"_27801":64698,"_19254":108560,"_5":13218,"_26298":108467,"_2652":108561},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3154":64739,"_27801":64698,"_19254":108563,"_5":13218,"_26298":108467,"_2652":108564},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3154":64740,"_27801":64698,"_19254":108566,"_5":13218,"_26298":108471,"_2652":108567},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3154":64741,"_27801":64698,"_19254":108569,"_5":13218,"_26298":108471,"_2652":108570},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3154":64742,"_27801":64698,"_19254":108572,"_5":13218,"_26298":108471,"_2652":108573},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3154":64743,"_27801":64698,"_19254":108575,"_5":13218,"_26298":108471,"_2652":108576},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3154":64744,"_27801":64698,"_19254":108578,"_5":13218,"_26298":108471,"_2652":108579},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3154":64745,"_27801":64698,"_19254":108581,"_5":13218,"_26298":108471,"_2652":108582},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3154":64746,"_27801":64698,"_19254":108584,"_5":13218,"_26298":108475,"_2652":108585},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3154":64747,"_27801":64698,"_19254":108587,"_5":13218,"_26298":108475,"_2652":108588},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3154":64748,"_27801":64698,"_19254":108590,"_5":13218,"_26298":108479,"_2652":108591},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3154":64749,"_27801":64698,"_19254":108593,"_5":13218,"_26298":108479,"_2652":108594},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3154":64750,"_27801":64698,"_19254":108596,"_5":13218,"_26298":108479,"_2652":108597},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3154":64751,"_27801":64698,"_19254":108599,"_5":13218,"_26298":108479,"_2652":108600},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3154":64752,"_27801":64698,"_19254":108602,"_5":13218,"_26298":108483,"_2652":108603},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3154":64753,"_27801":64698,"_19254":108605,"_5":13218,"_26298":108483,"_2652":108606},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3154":64754,"_27801":64754,"_5":13544,"_2652":108608,"_28144":108609,"_19254":108611,"_26298":64754},"Identidad inicial y autenticación",[45131,107460,47488,108435,108610],"Enrolamiento con PKI",[],{"_3154":64755,"_27801":64754,"_19254":108613,"_5":13218,"_26298":64754,"_2652":108614},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_3154":64756,"_27801":64754,"_5":28141,"_19254":108616,"_26298":108617,"_2652":108618},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3154":64757,"_27801":64754,"_5":28141,"_19254":108620,"_26298":108621,"_2652":108622},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3154":64758,"_27801":64754,"_5":28141,"_19254":108624,"_26298":108625,"_2652":108626},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_3154":64759,"_27801":64754,"_5":28141,"_19254":108628,"_26298":108629,"_2652":108630},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3154":64760,"_27801":64754,"_5":28141,"_19254":108632,"_26298":108633,"_2652":108634},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3154":64761,"_27801":64754,"_19254":108636,"_5":13218,"_26298":64754,"_2652":108637},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3154":64762,"_27801":64754,"_19254":108639,"_5":13218,"_26298":108617,"_2652":108640},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3154":64763,"_27801":64754,"_19254":108642,"_5":13218,"_26298":108617,"_2652":108643},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3154":64764,"_27801":64754,"_19254":108645,"_5":13218,"_26298":108621,"_2652":108646},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3154":64765,"_27801":64754,"_19254":108648,"_5":13218,"_26298":108621,"_2652":108649},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3154":64766,"_27801":64754,"_19254":108651,"_5":13218,"_26298":108621,"_2652":108652},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3154":64767,"_27801":64754,"_19254":108654,"_5":13218,"_26298":108625,"_2652":108655},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3154":64768,"_27801":64754,"_19254":108657,"_5":13218,"_26298":108625,"_2652":108658},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3154":64769,"_27801":64754,"_19254":108660,"_5":13218,"_26298":108629,"_2652":108661},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3154":64770,"_27801":64754,"_19254":108663,"_5":13218,"_26298":108629,"_2652":108664},[],"Ejemplo de cuerpo:",{"_3154":64771,"_27801":64754,"_19254":108666,"_5":13218,"_26298":108629,"_2652":108667},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3154":64772,"_27801":64754,"_19254":108669,"_5":13218,"_26298":108629,"_2652":108670},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3154":64773,"_27801":64754,"_19254":108672,"_5":13218,"_26298":108629,"_2652":108673},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3154":64774,"_27801":64754,"_19254":108675,"_5":13218,"_26298":108629,"_2652":108676},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3154":64775,"_27801":64754,"_19254":108678,"_5":13218,"_26298":108633,"_2652":108679},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_3154":64776,"_27801":64754,"_19254":108681,"_5":13218,"_26298":108633,"_2652":108682},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3154":64777,"_27801":64777,"_5":13544,"_2652":108684,"_28144":108685,"_19254":108686,"_26298":64777},"Configura y opera el DMS",[45131,107460,47488,108435,108610],[],{"_3154":64778,"_27801":64777,"_19254":108688,"_5":13218,"_26298":64777,"_2652":108689},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3154":64779,"_27801":64777,"_5":28141,"_19254":108691,"_26298":108692,"_2652":106126},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3154":64780,"_27801":64777,"_5":28141,"_19254":108694,"_26298":108695,"_2652":108696},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3154":64781,"_27801":64777,"_5":28141,"_19254":108698,"_26298":108699,"_2652":108700},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3154":64782,"_27801":64777,"_5":28141,"_19254":108702,"_26298":108703,"_2652":108704},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3154":64783,"_27801":64777,"_5":28141,"_19254":108706,"_26298":108707,"_2652":108708},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3154":64784,"_27801":64777,"_5":28141,"_19254":108710,"_26298":108711,"_2652":108712},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3154":64785,"_27801":64777,"_5":28141,"_19254":108714,"_26298":108715,"_2652":108716},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3154":64786,"_27801":64777,"_5":28141,"_19254":108718,"_26298":108719,"_2652":108720},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_3154":64787,"_27801":64777,"_5":28141,"_19254":108722,"_26298":108723,"_2652":47783},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_3154":64788,"_27801":64777,"_5":28141,"_19254":108725,"_26298":108726,"_2652":47787},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_3154":64789,"_27801":64777,"_5":28141,"_19254":108728,"_26298":108729,"_2652":108730},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_3154":64790,"_27801":64777,"_5":28141,"_19254":108732,"_26298":108733,"_2652":108734},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3154":64791,"_27801":64777,"_5":28141,"_19254":108736,"_26298":108737,"_2652":108738},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_3154":64792,"_27801":64777,"_5":28141,"_19254":108740,"_26298":108741,"_2652":108742},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3154":64793,"_27801":64777,"_5":28141,"_19254":108744,"_26298":108745,"_2652":47807},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_3154":64794,"_27801":64777,"_5":28141,"_19254":108747,"_26298":108748,"_2652":108749},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_3154":64795,"_27801":64777,"_5":28141,"_19254":108751,"_26298":108752,"_2652":108753},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3154":64796,"_27801":64777,"_5":28141,"_19254":108755,"_26298":108756,"_2652":108757},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3154":64797,"_27801":64777,"_19254":108759,"_5":13218,"_26298":64777,"_2652":108760},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3154":64798,"_27801":64777,"_19254":108762,"_5":13218,"_26298":108692,"_2652":108763},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3154":64799,"_27801":64777,"_19254":108765,"_5":13218,"_26298":108692,"_2652":108766},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3154":64800,"_27801":64777,"_19254":108768,"_5":13218,"_26298":108699,"_2652":108769},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3154":64801,"_27801":64777,"_19254":108771,"_5":13218,"_26298":108703,"_2652":108772},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3154":64802,"_27801":64777,"_19254":108774,"_5":13218,"_26298":108707,"_2652":108775},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3154":64803,"_27801":64777,"_19254":108777,"_5":13218,"_26298":108711,"_2652":108778},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3154":64804,"_27801":64777,"_19254":108780,"_5":13218,"_26298":108715,"_2652":108781},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3154":64805,"_27801":64777,"_19254":108783,"_5":13218,"_26298":108723,"_2652":108784},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_3154":64806,"_27801":64777,"_19254":108786,"_5":13218,"_26298":108723,"_2652":108787},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3154":64807,"_27801":64777,"_19254":108789,"_5":13218,"_26298":108726,"_2652":108790},[],"Campo de `settings.enrollment_settings`",{"_3154":64808,"_27801":64777,"_19254":108792,"_5":13218,"_26298":108726,"_2652":108793},[],"Decisión",{"_3154":64809,"_27801":64777,"_19254":108795,"_5":13218,"_26298":108726,"_2652":47858},[],{"_3154":64810,"_27801":64777,"_19254":108797,"_5":13218,"_26298":108726,"_2652":108798},[],"`EST_RFC7030` para estas operaciones.",{"_3154":64811,"_27801":64777,"_19254":108800,"_5":13218,"_26298":108726,"_2652":47864},[],{"_3154":64812,"_27801":64777,"_19254":108802,"_5":13218,"_26298":108726,"_2652":108803},[],"ID de la CA que firmará.",{"_3154":64813,"_27801":64777,"_19254":108805,"_5":13218,"_26298":108726,"_2652":47870},[],{"_3154":64814,"_27801":64777,"_19254":108807,"_5":13218,"_26298":108726,"_2652":108808},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3154":64815,"_27801":64777,"_19254":108810,"_5":13218,"_26298":108726,"_2652":47876},[],{"_3154":64816,"_27801":64777,"_19254":108812,"_5":13218,"_26298":108726,"_2652":108813},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3154":64817,"_27801":64777,"_19254":108815,"_5":13218,"_26298":108726,"_2652":47882},[],{"_3154":64818,"_27801":64777,"_19254":108817,"_5":13218,"_26298":108726,"_2652":108818},[],"Uno de los cuatro modos de autenticación.",{"_3154":64819,"_27801":64777,"_19254":108820,"_5":13218,"_26298":108726,"_2652":108821},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3154":64820,"_27801":64777,"_19254":108823,"_5":13218,"_26298":108729,"_2652":108824},[],"Los bloques son independientes:",{"_3154":64821,"_27801":64777,"_19254":108826,"_5":13218,"_26298":108729,"_2652":108827},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3154":64822,"_27801":64777,"_19254":108829,"_5":13218,"_26298":108729,"_2652":108830},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3154":64823,"_27801":64777,"_19254":108832,"_5":13218,"_26298":108729,"_2652":47900},[],{"_3154":64824,"_27801":64777,"_19254":108834,"_5":13218,"_26298":108729,"_2652":108835},[],"Control aplicado en la operación configurada",{"_3154":64825,"_27801":64777,"_19254":108837,"_5":13218,"_26298":108729,"_2652":47906},[],{"_3154":64826,"_27801":64777,"_19254":108839,"_5":13218,"_26298":108729,"_2652":108840},[],"Validación del certificado presentado.",{"_3154":64827,"_27801":64777,"_19254":108842,"_5":13218,"_26298":108729,"_2652":47912},[],{"_3154":64828,"_27801":64777,"_19254":108844,"_5":13218,"_26298":108729,"_2652":108845},[],"Autorización del webhook configurado.",{"_3154":64829,"_27801":64777,"_19254":108847,"_5":13218,"_26298":108729,"_2652":47918},[],{"_3154":64830,"_27801":64777,"_19254":108849,"_5":13218,"_26298":108729,"_2652":108850},[],"Validación del certificado y, después, aprobación del webhook.",{"_3154":64831,"_27801":64777,"_19254":108852,"_5":13218,"_26298":108729,"_2652":47924},[],{"_3154":64832,"_27801":64777,"_19254":108854,"_5":13218,"_26298":108729,"_2652":108855},[],"Sin autenticación del solicitante por el DMS.",{"_3154":64833,"_27801":64777,"_19254":108857,"_5":13218,"_26298":108729,"_2652":108858},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3154":64834,"_27801":64777,"_19254":108860,"_5":13218,"_26298":108729,"_2652":108861},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3154":64835,"_27801":64777,"_19254":108863,"_5":13218,"_26298":108729,"_2652":108864},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`.",{"_3154":64836,"_27801":64777,"_19254":108866,"_5":13218,"_26298":108729,"_2652":108867},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3154":64837,"_27801":64777,"_19254":108869,"_5":13218,"_26298":108733,"_2652":108870},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3154":64838,"_27801":64777,"_19254":108872,"_5":13218,"_26298":108733,"_2652":108873},[],"Campo de `external_webhook_settings`",{"_3154":64839,"_27801":64777,"_19254":108875,"_5":13218,"_26298":108733,"_2652":108793},[],{"_3154":64840,"_27801":64777,"_19254":108877,"_5":13218,"_26298":108733,"_2652":47950},[],{"_3154":64841,"_27801":64777,"_19254":108879,"_5":13218,"_26298":108733,"_2652":108880},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3154":64842,"_27801":64777,"_19254":108882,"_5":13218,"_26298":108733,"_2652":47956},[],{"_3154":64843,"_27801":64777,"_19254":108884,"_5":13218,"_26298":108733,"_2652":108885},[],"`POST` o `PUT`; `POST` por defecto.",{"_3154":64844,"_27801":64777,"_19254":108887,"_5":13218,"_26298":108733,"_2652":47962},[],{"_3154":64845,"_27801":64777,"_19254":108889,"_5":13218,"_26298":108733,"_2652":108890},[],"Etiqueta usada en los logs del servicio.",{"_3154":64846,"_27801":64777,"_19254":108892,"_5":13218,"_26298":108733,"_2652":47968},[],{"_3154":64847,"_27801":64777,"_19254":108894,"_5":13218,"_26298":108733,"_2652":108895},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3154":64848,"_27801":64777,"_19254":108897,"_5":13218,"_26298":108733,"_2652":47974},[],{"_3154":64849,"_27801":64777,"_19254":108899,"_5":13218,"_26298":108733,"_2652":108900},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3154":64850,"_27801":64777,"_19254":108902,"_5":13218,"_26298":108733,"_2652":47980},[],{"_3154":64851,"_27801":64777,"_19254":108904,"_5":13218,"_26298":108733,"_2652":108905},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3154":64852,"_27801":64777,"_19254":108907,"_5":13218,"_26298":108733,"_2652":47986},[],{"_3154":64853,"_27801":64777,"_19254":108909,"_5":13218,"_26298":108733,"_2652":108910},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3154":64854,"_27801":64777,"_19254":108912,"_5":13218,"_26298":108733,"_2652":47992},[],{"_3154":64855,"_27801":64777,"_19254":108914,"_5":13218,"_26298":108733,"_2652":108915},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3154":64856,"_27801":64777,"_19254":108917,"_5":13218,"_26298":108733,"_2652":47998},[],{"_3154":64857,"_27801":64777,"_19254":108919,"_5":13218,"_26298":108733,"_2652":108920},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3154":64858,"_27801":64777,"_19254":108922,"_5":13218,"_26298":108733,"_2652":108923},[],"Reglas de esa configuración:",{"_3154":64859,"_27801":64777,"_19254":108925,"_5":13218,"_26298":108733,"_2652":108926},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3154":64860,"_27801":64777,"_19254":108928,"_5":13218,"_26298":108733,"_2652":108929},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3154":64861,"_27801":64777,"_19254":108931,"_5":13218,"_26298":108733,"_2652":108932},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3154":64862,"_27801":64777,"_19254":108934,"_5":13218,"_26298":108733,"_2652":108935},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3154":64863,"_27801":64777,"_19254":108937,"_5":13218,"_26298":108733,"_2652":108938},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3154":64864,"_27801":64777,"_19254":108940,"_5":13218,"_26298":108733,"_2652":108941},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3154":64865,"_27801":64777,"_19254":108943,"_5":13218,"_26298":108733,"_2652":108944},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar, y si la consola de tu versión no expone la configuración independiente, utiliza la API DMS.",{"_3154":64866,"_27801":64777,"_19254":108946,"_5":13218,"_26298":108733,"_2652":108947},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3154":64867,"_27801":64777,"_19254":108949,"_5":13218,"_26298":108733,"_2652":108950},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3154":64868,"_27801":64777,"_19254":108952,"_5":13218,"_26298":108737,"_2652":108953},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3154":64869,"_27801":64777,"_19254":108955,"_5":13218,"_26298":108741,"_2652":108956},[],"Campo de `settings.reenrollment_settings`",{"_3154":64870,"_27801":64777,"_19254":108958,"_5":13218,"_26298":108741,"_2652":108959},[],"Función",{"_3154":64871,"_27801":64777,"_19254":108961,"_5":13218,"_26298":108741,"_2652":48042},[],{"_3154":64872,"_27801":64777,"_19254":108963,"_5":13218,"_26298":108741,"_2652":108964},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3154":64873,"_27801":64777,"_19254":108966,"_5":13218,"_26298":108741,"_2652":48048},[],{"_3154":64874,"_27801":64777,"_19254":108968,"_5":13218,"_26298":108741,"_2652":108969},[],"Umbral operativo preventivo de monitorización.",{"_3154":64875,"_27801":64777,"_19254":108971,"_5":13218,"_26298":108741,"_2652":48054},[],{"_3154":64876,"_27801":64777,"_19254":108973,"_5":13218,"_26298":108741,"_2652":108974},[],"Umbral operativo crítico de monitorización.",{"_3154":64877,"_27801":64777,"_19254":108976,"_5":13218,"_26298":108741,"_2652":48060},[],{"_3154":64878,"_27801":64777,"_19254":108978,"_5":13218,"_26298":108741,"_2652":108979},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3154":64879,"_27801":64777,"_19254":108981,"_5":13218,"_26298":108741,"_2652":48066},[],{"_3154":64880,"_27801":64777,"_19254":108983,"_5":13218,"_26298":108741,"_2652":108984},[],"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3154":64881,"_27801":64777,"_19254":108986,"_5":13218,"_26298":108741,"_2652":48072},[],{"_3154":64882,"_27801":64777,"_19254":108988,"_5":13218,"_26298":108741,"_2652":108989},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3154":64883,"_27801":64777,"_19254":108991,"_5":13218,"_26298":108741,"_2652":108992},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_3154":64884,"_27801":64777,"_19254":108994,"_5":13218,"_26298":108745,"_2652":108995},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_3154":64885,"_27801":64777,"_19254":108997,"_5":13218,"_26298":108748,"_2652":106490},[],{"_3154":64886,"_27801":64777,"_19254":108999,"_5":13218,"_26298":108748,"_2652":109000},[],"Qué publica",{"_3154":64887,"_27801":64777,"_19254":109002,"_5":13218,"_26298":108748,"_2652":48089},[],{"_3154":64888,"_27801":64777,"_19254":109004,"_5":13218,"_26298":108748,"_2652":109005},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3154":64889,"_27801":64777,"_19254":109007,"_5":13218,"_26298":108748,"_2652":48095},[],{"_3154":64890,"_27801":64777,"_19254":109009,"_5":13218,"_26298":108748,"_2652":109010},[],"Certificado de la CA emisora seleccionada.",{"_3154":64891,"_27801":64777,"_19254":109012,"_5":13218,"_26298":108748,"_2652":48101},[],{"_3154":64892,"_27801":64777,"_19254":109014,"_5":13218,"_26298":108748,"_2652":109015},[],"Certificados de las CAs elegidas explícitamente.",{"_3154":64893,"_27801":64777,"_19254":109017,"_5":13218,"_26298":108748,"_2652":109018},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_3154":64894,"_27801":64777,"_19254":109020,"_5":13218,"_26298":108752,"_2652":109021},[],"**Edit** cambia nombre, ajustes y metadatos. La actualización del backend sustituye esos bloques completos; al usar la API, lee el DMS antes de enviar una edición para no perder campos.",{"_3154":64895,"_27801":64777,"_19254":109023,"_5":13218,"_26298":108752,"_2652":109024},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3154":64896,"_27801":64777,"_19254":109026,"_5":13218,"_26298":108752,"_2652":109027},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3154":64897,"_27801":64777,"_19254":109029,"_5":13218,"_26298":108756,"_2652":109030},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3154":64898,"_27801":64898,"_5":13544,"_2652":109032,"_28144":109033,"_19254":109034,"_26298":64898},"Integra el cliente EST",[45131,107460,47488,108435,108610],[],{"_3154":64899,"_27801":64898,"_19254":109036,"_5":13218,"_26298":64898,"_2652":109037},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_3154":64900,"_27801":64898,"_5":28141,"_19254":109039,"_26298":109040,"_2652":106126},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_3154":64901,"_27801":64898,"_5":28141,"_19254":109042,"_26298":109043,"_2652":109044},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_3154":64902,"_27801":64898,"_5":28141,"_19254":109046,"_26298":109047,"_2652":109048},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_3154":64903,"_27801":64898,"_5":28141,"_19254":109050,"_26298":109051,"_2652":109052},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_3154":64904,"_27801":64898,"_5":28141,"_19254":109054,"_26298":109055,"_2652":109056},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_3154":64905,"_27801":64898,"_5":28141,"_19254":109058,"_26298":109059,"_2652":109060},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_3154":64906,"_27801":64898,"_19254":109062,"_5":13218,"_26298":64898,"_2652":109063},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_3154":64907,"_27801":64898,"_19254":109065,"_5":13218,"_26298":109040,"_2652":109066},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3154":64908,"_27801":64898,"_19254":109068,"_5":13218,"_26298":109040,"_2652":109069},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3154":64909,"_27801":64898,"_19254":109071,"_5":13218,"_26298":109040,"_2652":109072},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3154":64910,"_27801":64898,"_19254":109074,"_5":13218,"_26298":109043,"_2652":109075},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_3154":64911,"_27801":64898,"_19254":109077,"_5":13218,"_26298":109043,"_2652":109078},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3154":64912,"_27801":64898,"_19254":109080,"_5":13218,"_26298":109047,"_2652":109081},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3154":64913,"_27801":64898,"_19254":109083,"_5":13218,"_26298":109047,"_2652":109084},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3154":64914,"_27801":64898,"_19254":109086,"_5":13218,"_26298":109051,"_2652":109087},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3154":64915,"_27801":64898,"_19254":109089,"_5":13218,"_26298":109051,"_2652":109090},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3154":64916,"_27801":64898,"_19254":109092,"_5":13218,"_26298":109055,"_2652":109093},[],"Para el caso de una raíz que emite directamente:",{"_3154":64917,"_27801":64898,"_19254":109095,"_5":13218,"_26298":109055,"_2652":109096},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3154":64918,"_27801":64898,"_19254":109098,"_5":13218,"_26298":109055,"_2652":109099},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3154":64919,"_27801":64898,"_19254":109101,"_5":13218,"_26298":109059,"_2652":109102},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_3154":64920,"_27801":64920,"_5":13544,"_2652":109104,"_28144":109105,"_19254":109106,"_26298":64920},"Referencia EST",[45131,107460,47488,108435,108610],[],{"_3154":64921,"_27801":64920,"_19254":109108,"_5":13218,"_26298":64920,"_2652":109109},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_3154":64922,"_27801":64920,"_5":28141,"_19254":109111,"_26298":109112,"_2652":109113},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_3154":64923,"_27801":64920,"_5":28141,"_19254":109115,"_26298":109116,"_2652":20919},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3154":64924,"_27801":64920,"_5":28141,"_19254":109118,"_26298":109119,"_2652":24021},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3154":64925,"_27801":64920,"_5":28141,"_19254":109121,"_26298":109122,"_2652":24028},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3154":64926,"_27801":64920,"_5":28141,"_19254":109124,"_26298":109125,"_2652":23362},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3154":64927,"_27801":64920,"_5":28141,"_19254":109127,"_26298":109128,"_2652":109129},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_3154":64928,"_27801":64920,"_5":28141,"_19254":109131,"_26298":109132,"_2652":109133},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_3154":64929,"_27801":64920,"_5":28141,"_19254":109135,"_26298":109136,"_2652":109137},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_3154":64930,"_27801":64920,"_19254":109139,"_5":13218,"_26298":64920,"_2652":109140},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_3154":64931,"_27801":64920,"_19254":109142,"_5":13218,"_26298":109112,"_2652":109143},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3154":64932,"_27801":64920,"_19254":109145,"_5":13218,"_26298":109112,"_2652":107251},[],{"_3154":64933,"_27801":64920,"_19254":109147,"_5":13218,"_26298":109112,"_2652":109148},[],"Método",{"_3154":64934,"_27801":64920,"_19254":109150,"_5":13218,"_26298":109112,"_2652":109151},[],"Autenticación y condición",{"_3154":64935,"_27801":64920,"_19254":109153,"_5":13218,"_26298":109112,"_2652":48244},[],{"_3154":64936,"_27801":64920,"_19254":109155,"_5":13218,"_26298":109112,"_2652":48247},[],{"_3154":64937,"_27801":64920,"_19254":109157,"_5":13218,"_26298":109112,"_2652":109158},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3154":64938,"_27801":64920,"_19254":109160,"_5":13218,"_26298":109112,"_2652":48253},[],{"_3154":64939,"_27801":64920,"_19254":109162,"_5":13218,"_26298":109112,"_2652":48256},[],{"_3154":64940,"_27801":64920,"_19254":109164,"_5":13218,"_26298":109112,"_2652":109165},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3154":64941,"_27801":64920,"_19254":109167,"_5":13218,"_26298":109112,"_2652":48262},[],{"_3154":64942,"_27801":64920,"_19254":109169,"_5":13218,"_26298":109112,"_2652":48256},[],{"_3154":64943,"_27801":64920,"_19254":109171,"_5":13218,"_26298":109112,"_2652":109172},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3154":64944,"_27801":64920,"_19254":109174,"_5":13218,"_26298":109112,"_2652":48270},[],{"_3154":64945,"_27801":64920,"_19254":109176,"_5":13218,"_26298":109112,"_2652":48256},[],{"_3154":64946,"_27801":64920,"_19254":109178,"_5":13218,"_26298":109112,"_2652":109179},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_3154":64947,"_27801":64920,"_19254":109181,"_5":13218,"_26298":109112,"_2652":109182},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3154":64948,"_27801":64920,"_19254":109184,"_5":13218,"_26298":109116,"_2652":109185},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_3154":64949,"_27801":64920,"_19254":109187,"_5":13218,"_26298":109116,"_2652":109188},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_3154":64950,"_27801":64920,"_19254":109190,"_5":13218,"_26298":109119,"_2652":109191},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_3154":64951,"_27801":64920,"_19254":109193,"_5":13218,"_26298":109119,"_2652":109194},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_3154":64952,"_27801":64920,"_19254":109196,"_5":13218,"_26298":109122,"_2652":109197},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_3154":64953,"_27801":64920,"_19254":109199,"_5":13218,"_26298":109122,"_2652":109200},[],"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_3154":64954,"_27801":64920,"_19254":109202,"_5":13218,"_26298":109125,"_2652":109203},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_3154":64955,"_27801":64920,"_19254":109205,"_5":13218,"_26298":109125,"_2652":109206},[],"El código admite RSA y ECDSA, y el valor `bits` del ajuste de clave del DMS significa algo distinto en cada caso. En ECDSA selecciona la curva: 224, 256, 384 o 521 corresponden a P-224, P-256, P-384 y P-521, y un tamaño no reconocido produce fallback a P-256, así que elige explícitamente un tamaño compatible y comprueba la clave resultante. En RSA se usa directamente como tamaño del módulo; la consola ofrece 2048, 3072 y 4096 bits. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_3154":64956,"_27801":64920,"_19254":109208,"_5":13218,"_26298":109128,"_2652":109209},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3154":64957,"_27801":64920,"_19254":109211,"_5":13218,"_26298":109128,"_2652":109212},[],"Parte",{"_3154":64958,"_27801":64920,"_19254":109214,"_5":13218,"_26298":109128,"_2652":109215},[],"Contenido tras decodificar su Base64",{"_3154":64959,"_27801":64920,"_19254":109217,"_5":13218,"_26298":109128,"_2652":48314},[],{"_3154":64960,"_27801":64920,"_19254":109219,"_5":13218,"_26298":109128,"_2652":109220},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3154":64961,"_27801":64920,"_19254":109222,"_5":13218,"_26298":109128,"_2652":48320},[],{"_3154":64962,"_27801":64920,"_19254":109224,"_5":13218,"_26298":109128,"_2652":109225},[],"PKCS#7 DER con el certificado emitido.",{"_3154":64963,"_27801":64920,"_19254":109227,"_5":13218,"_26298":109128,"_2652":109228},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3154":64964,"_27801":64920,"_19254":109230,"_5":13218,"_26298":109132,"_2652":109231},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3154":64965,"_27801":64920,"_19254":109233,"_5":13218,"_26298":109132,"_2652":109234},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_3154":64966,"_27801":64920,"_19254":109236,"_5":13218,"_26298":109132,"_2652":109237},[],"Convierte y comprueba el resultado:",{"_3154":64967,"_27801":64920,"_19254":109239,"_5":13218,"_26298":109132,"_2652":109240},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_3154":64968,"_27801":64920,"_19254":109242,"_5":13218,"_26298":109136,"_2652":109243},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3154":64969,"_27801":64920,"_19254":109245,"_5":13218,"_26298":109136,"_2652":109246},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3154":64970,"_27801":64970,"_5":13544,"_2652":108610,"_28144":109248,"_19254":109249,"_26298":64970},[45131,107460,47488,108435,108610],[],{"_3154":64971,"_27801":64970,"_19254":109251,"_5":13218,"_26298":64970,"_2652":109252},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_3154":64972,"_27801":64970,"_5":28141,"_19254":109254,"_26298":109255,"_2652":109256},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3154":64973,"_27801":64970,"_5":28141,"_19254":109258,"_26298":109259,"_2652":109260},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3154":64974,"_27801":64970,"_5":28141,"_19254":109262,"_26298":109263,"_2652":109264},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3154":64975,"_27801":64970,"_5":28141,"_19254":109266,"_26298":109267,"_2652":109268},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_3154":64976,"_27801":64970,"_19254":109270,"_5":13218,"_26298":64970,"_2652":109271},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3154":64977,"_27801":64970,"_19254":109273,"_5":13218,"_26298":109255,"_2652":109274},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3154":64978,"_27801":64970,"_19254":109276,"_5":13218,"_26298":109255,"_2652":109277},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3154":64979,"_27801":64970,"_19254":109279,"_5":13218,"_26298":109255,"_2652":109280},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3154":64980,"_27801":64970,"_19254":109282,"_5":13218,"_26298":109255,"_2652":109283},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3154":64981,"_27801":64970,"_19254":109285,"_5":13218,"_26298":109255,"_2652":109286},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3154":64982,"_27801":64970,"_19254":109288,"_5":13218,"_26298":109255,"_2652":109289},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3154":64983,"_27801":64970,"_19254":109291,"_5":13218,"_26298":109259,"_2652":109292},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3154":64984,"_27801":64970,"_19254":109294,"_5":13218,"_26298":109259,"_2652":109295},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3154":64985,"_27801":64970,"_19254":109297,"_5":13218,"_26298":109259,"_2652":109298},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3154":64986,"_27801":64970,"_19254":109300,"_5":13218,"_26298":109259,"_2652":109301},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3154":64987,"_27801":64970,"_19254":109303,"_5":13218,"_26298":109263,"_2652":109304},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3154":64988,"_27801":64970,"_19254":109306,"_5":13218,"_26298":109263,"_2652":109307},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3154":64989,"_27801":64970,"_19254":109309,"_5":13218,"_26298":109263,"_2652":109310},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3154":64990,"_27801":64970,"_19254":109312,"_5":13218,"_26298":109263,"_2652":109313},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3154":64991,"_27801":64970,"_19254":109315,"_5":13218,"_26298":109267,"_2652":109316},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_3154":64992,"_27801":64970,"_19254":109318,"_5":13218,"_26298":109267,"_2652":109319},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3154":64993,"_27801":64993,"_5":13544,"_2652":109321,"_28144":109322,"_19254":109323,"_26298":64993},"Estrategias de aprovisionamiento",[45131,107460,47488,108435,108610],[],{"_3154":64994,"_27801":64993,"_19254":109325,"_5":13218,"_26298":64993,"_2652":109326},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3154":64995,"_27801":64993,"_5":28141,"_19254":109328,"_26298":109329,"_2652":109330},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3154":64996,"_27801":64993,"_5":28141,"_19254":109332,"_26298":109333,"_2652":109334},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3154":64997,"_27801":64993,"_5":28141,"_19254":109336,"_26298":109337,"_2652":109338},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3154":64998,"_27801":64993,"_5":28141,"_19254":109340,"_26298":109341,"_2652":109342},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3154":64999,"_27801":64993,"_5":28141,"_19254":109344,"_26298":109345,"_2652":109346},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3154":65000,"_27801":64993,"_19254":109348,"_5":13218,"_26298":64993,"_2652":109349},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3154":65001,"_27801":64993,"_19254":109351,"_5":13218,"_26298":109329,"_2652":109352},[],"Recorrido",{"_3154":65002,"_27801":64993,"_19254":109354,"_5":13218,"_26298":109329,"_2652":109355},[],"Cuándo existe el dispositivo",{"_3154":65003,"_27801":64993,"_19254":109357,"_5":13218,"_26298":109329,"_2652":109358},[],"Qué compruebas",{"_3154":65004,"_27801":64993,"_19254":109360,"_5":13218,"_26298":109329,"_2652":109361},[],"Asignación manual",{"_3154":65005,"_27801":64993,"_19254":109363,"_5":13218,"_26298":109329,"_2652":109364},[],"El operador lo crea antes de asociar un certificado.",{"_3154":65006,"_27801":64993,"_19254":109366,"_5":13218,"_26298":109329,"_2652":109367},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3154":65007,"_27801":64993,"_19254":109369,"_5":13218,"_26298":109329,"_2652":109370},[],"EST con `JITP`",{"_3154":65008,"_27801":64993,"_19254":109372,"_5":13218,"_26298":109329,"_2652":109373},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3154":65009,"_27801":64993,"_19254":109375,"_5":13218,"_26298":109329,"_2652":109376},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3154":65010,"_27801":64993,"_19254":109378,"_5":13218,"_26298":109329,"_2652":109379},[],"EST con `PRE_REGISTRATION`",{"_3154":65011,"_27801":64993,"_19254":109381,"_5":13218,"_26298":109329,"_2652":109382},[],"Debe existir antes de `/simpleenroll`.",{"_3154":65012,"_27801":64993,"_19254":109384,"_5":13218,"_26298":109329,"_2652":109385},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3154":65013,"_27801":64993,"_19254":109387,"_5":13218,"_26298":109329,"_2652":109388},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3154":65014,"_27801":64993,"_19254":109390,"_5":13218,"_26298":109329,"_2652":109391},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3154":65015,"_27801":64993,"_19254":109393,"_5":13218,"_26298":109333,"_2652":109394},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3154":65016,"_27801":64993,"_19254":109396,"_5":13218,"_26298":109333,"_2652":109397},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3154":65017,"_27801":64993,"_19254":109399,"_5":13218,"_26298":109333,"_2652":109400},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3154":65018,"_27801":64993,"_19254":109402,"_5":13218,"_26298":109337,"_2652":109403},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3154":65019,"_27801":64993,"_19254":109405,"_5":13218,"_26298":109337,"_2652":109406},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3154":65020,"_27801":64993,"_19254":109408,"_5":13218,"_26298":109337,"_2652":109409},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3154":65021,"_27801":64993,"_19254":109411,"_5":13218,"_26298":109337,"_2652":109412},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3154":65022,"_27801":64993,"_19254":109414,"_5":13218,"_26298":109337,"_2652":109415},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3154":65023,"_27801":64993,"_19254":109417,"_5":13218,"_26298":109337,"_2652":109418},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3154":65024,"_27801":64993,"_19254":109420,"_5":13218,"_26298":109341,"_2652":106490},[],{"_3154":65025,"_27801":64993,"_19254":109422,"_5":13218,"_26298":109341,"_2652":109423},[],"Material que atraviesa EST",{"_3154":65026,"_27801":64993,"_19254":109425,"_5":13218,"_26298":109341,"_2652":109426},[],"Clave generada por el dispositivo",{"_3154":65027,"_27801":64993,"_19254":109428,"_5":13218,"_26298":109341,"_2652":109429},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3154":65028,"_27801":64993,"_19254":109431,"_5":13218,"_26298":109341,"_2652":109432},[],"Clave ya disponible en el dispositivo",{"_3154":65029,"_27801":64993,"_19254":109434,"_5":13218,"_26298":109341,"_2652":109435},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3154":65030,"_27801":64993,"_19254":109437,"_5":13218,"_26298":109341,"_2652":47807},[],{"_3154":65031,"_27801":64993,"_19254":109439,"_5":13218,"_26298":109341,"_2652":109440},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3154":65032,"_27801":64993,"_19254":109442,"_5":13218,"_26298":109341,"_2652":109443},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3154":65033,"_27801":64993,"_19254":109445,"_5":13218,"_26298":109345,"_2652":109446},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3154":65034,"_27801":65034,"_5":13544,"_2652":109448,"_28144":109449,"_19254":109450,"_26298":65034},"Renovación y recuperación",[45131,107460,47488,108435,108610],[],{"_3154":65035,"_27801":65034,"_19254":109452,"_5":13218,"_26298":65034,"_2652":109453},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_3154":65036,"_27801":65034,"_5":28141,"_19254":109455,"_26298":109456,"_2652":109457},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_3154":65037,"_27801":65034,"_5":28141,"_19254":109459,"_26298":109460,"_2652":109461},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_3154":65038,"_27801":65034,"_5":28141,"_19254":109463,"_26298":109464,"_2652":109465},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_3154":65039,"_27801":65034,"_5":28141,"_19254":109467,"_26298":109468,"_2652":109469},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_3154":65040,"_27801":65034,"_5":28141,"_19254":109471,"_26298":109472,"_2652":109473},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_3154":65041,"_27801":65034,"_19254":109475,"_5":13218,"_26298":65034,"_2652":109476},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_3154":65042,"_27801":65034,"_19254":109478,"_5":13218,"_26298":109456,"_2652":109479},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3154":65043,"_27801":65034,"_19254":109481,"_5":13218,"_26298":109456,"_2652":109482},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3154":65044,"_27801":65034,"_19254":109484,"_5":13218,"_26298":109456,"_2652":109485},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3154":65045,"_27801":65034,"_19254":109487,"_5":13218,"_26298":109456,"_2652":109488},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3154":65046,"_27801":65034,"_19254":109490,"_5":13218,"_26298":109460,"_2652":109491},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3154":65047,"_27801":65034,"_19254":109493,"_5":13218,"_26298":109460,"_2652":109494},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3154":65048,"_27801":65034,"_19254":109496,"_5":13218,"_26298":109464,"_2652":109497},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3154":65049,"_27801":65034,"_19254":109499,"_5":13218,"_26298":109464,"_2652":109500},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3154":65050,"_27801":65034,"_19254":109502,"_5":13218,"_26298":109464,"_2652":109503},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3154":65051,"_27801":65034,"_19254":109505,"_5":13218,"_26298":109468,"_2652":109506},[],"Situación",{"_3154":65052,"_27801":65034,"_19254":109508,"_5":13218,"_26298":109468,"_2652":109509},[],"Procedimiento",{"_3154":65053,"_27801":65034,"_19254":109511,"_5":13218,"_26298":109468,"_2652":109512},[],"Certificado vigente, fuera de ventana",{"_3154":65054,"_27801":65034,"_19254":109514,"_5":13218,"_26298":109468,"_2652":109515},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3154":65055,"_27801":65034,"_19254":109517,"_5":13218,"_26298":109468,"_2652":109518},[],"Certificado vencido, clave disponible",{"_3154":65056,"_27801":65034,"_19254":109520,"_5":13218,"_26298":109468,"_2652":109521},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3154":65057,"_27801":65034,"_19254":109523,"_5":13218,"_26298":109468,"_2652":109524},[],"Renovación por webhook o `NO_AUTH`",{"_3154":65058,"_27801":65034,"_19254":109526,"_5":13218,"_26298":109468,"_2652":109527},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3154":65059,"_27801":65034,"_19254":109529,"_5":13218,"_26298":109468,"_2652":109530},[],"Clave perdida o inaccesible",{"_3154":65060,"_27801":65034,"_19254":109532,"_5":13218,"_26298":109468,"_2652":109533},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3154":65061,"_27801":65034,"_19254":109535,"_5":13218,"_26298":109468,"_2652":109536},[],"Identidad actual revocada",{"_3154":65062,"_27801":65034,"_19254":109538,"_5":13218,"_26298":109468,"_2652":109539},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3154":65063,"_27801":65034,"_19254":109541,"_5":13218,"_26298":109468,"_2652":109542},[],"Dispositivo sin identidad",{"_3154":65064,"_27801":65034,"_19254":109544,"_5":13218,"_26298":109468,"_2652":109545},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3154":65065,"_27801":65034,"_19254":109547,"_5":13218,"_26298":109468,"_2652":109548},[],"Dispositivo retirado",{"_3154":65066,"_27801":65034,"_19254":109550,"_5":13218,"_26298":109468,"_2652":109551},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3154":65067,"_27801":65034,"_19254":109553,"_5":13218,"_26298":109468,"_2652":109554},[],"Timeout, HTTP 500 o fallo de instalación",{"_3154":65068,"_27801":65034,"_19254":109556,"_5":13218,"_26298":109468,"_2652":109557},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3154":65069,"_27801":65034,"_19254":109559,"_5":13218,"_26298":109472,"_2652":109560},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3154":65070,"_27801":65034,"_19254":109562,"_5":13218,"_26298":109472,"_2652":109563},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3154":65071,"_27801":65071,"_5":13544,"_2652":109565,"_28144":109566,"_19254":109567,"_26298":65071},"Diagnóstico de enrolamiento",[45131,107460,47488,108435,108610],[],{"_3154":65072,"_27801":65071,"_19254":109569,"_5":13218,"_26298":65071,"_2652":109570},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3154":65073,"_27801":65071,"_5":28141,"_19254":109572,"_26298":109573,"_2652":109574},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3154":65074,"_27801":65071,"_5":28141,"_19254":109576,"_26298":109577,"_2652":109578},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3154":65075,"_27801":65071,"_5":28141,"_19254":109580,"_26298":109581,"_2652":109137},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_3154":65076,"_27801":65071,"_5":28141,"_19254":109583,"_26298":109584,"_2652":109585},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3154":65077,"_27801":65071,"_19254":109587,"_5":13218,"_26298":65071,"_2652":109588},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3154":65078,"_27801":65071,"_19254":109590,"_5":13218,"_26298":109577,"_2652":109591},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3154":65079,"_27801":65071,"_19254":109593,"_5":13218,"_26298":109577,"_2652":109594},[],"Síntoma o mensaje",{"_3154":65080,"_27801":65071,"_19254":109596,"_5":13218,"_26298":109577,"_2652":109597},[],"Qué revisar",{"_3154":65081,"_27801":65071,"_19254":109599,"_5":13218,"_26298":109577,"_2652":109600},[],"curl rechaza TLS, nombre o emisor",{"_3154":65082,"_27801":65071,"_19254":109602,"_5":13218,"_26298":109577,"_2652":109603},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3154":65083,"_27801":65071,"_19254":109605,"_5":13218,"_26298":109577,"_2652":109606},[],"404 o APS ausente",{"_3154":65084,"_27801":65071,"_19254":109608,"_5":13218,"_26298":109577,"_2652":109609},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3154":65085,"_27801":65071,"_19254":109611,"_5":13218,"_26298":109577,"_2652":109612},[],"400, error de CSR o formato",{"_3154":65086,"_27801":65071,"_19254":109614,"_5":13218,"_26298":109577,"_2652":109615},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3154":65087,"_27801":65071,"_19254":109617,"_5":13218,"_26298":109577,"_2652":109618},[],"Credencial ausente o certificado no válido",{"_3154":65088,"_27801":65071,"_19254":109620,"_5":13218,"_26298":109577,"_2652":109621},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3154":65089,"_27801":65071,"_19254":109623,"_5":13218,"_26298":109577,"_2652":109624},[],"Webhook deniega, expira o responde sin autorización",{"_3154":65090,"_27801":65071,"_19254":109626,"_5":13218,"_26298":109577,"_2652":109627},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3154":65091,"_27801":65071,"_19254":109629,"_5":13218,"_26298":109577,"_2652":48727},[],{"_3154":65092,"_27801":65071,"_19254":109631,"_5":13218,"_26298":109577,"_2652":109632},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3154":65093,"_27801":65071,"_19254":109634,"_5":13218,"_26298":109577,"_2652":48733},[],{"_3154":65094,"_27801":65071,"_19254":109636,"_5":13218,"_26298":109577,"_2652":109637},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3154":65095,"_27801":65071,"_19254":109639,"_5":13218,"_26298":109577,"_2652":48739},[],{"_3154":65096,"_27801":65071,"_19254":109641,"_5":13218,"_26298":109577,"_2652":109642},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3154":65097,"_27801":65071,"_19254":109644,"_5":13218,"_26298":109577,"_2652":48745},[],{"_3154":65098,"_27801":65071,"_19254":109646,"_5":13218,"_26298":109577,"_2652":109647},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3154":65099,"_27801":65071,"_19254":109649,"_5":13218,"_26298":109577,"_2652":48751},[],{"_3154":65100,"_27801":65071,"_19254":109651,"_5":13218,"_26298":109577,"_2652":109652},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3154":65101,"_27801":65071,"_19254":109654,"_5":13218,"_26298":109577,"_2652":109655},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3154":65102,"_27801":65071,"_19254":109657,"_5":13218,"_26298":109577,"_2652":109658},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3154":65103,"_27801":65071,"_19254":109660,"_5":13218,"_26298":109577,"_2652":109661},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3154":65104,"_27801":65071,"_19254":109663,"_5":13218,"_26298":109577,"_2652":109664},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3154":65105,"_27801":65071,"_19254":109666,"_5":13218,"_26298":109577,"_2652":48769},[],{"_3154":65106,"_27801":65071,"_19254":109668,"_5":13218,"_26298":109577,"_2652":109669},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3154":65107,"_27801":65071,"_19254":109671,"_5":13218,"_26298":109577,"_2652":48775},[],{"_3154":65108,"_27801":65071,"_19254":109673,"_5":13218,"_26298":109577,"_2652":109674},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3154":65109,"_27801":65071,"_19254":109676,"_5":13218,"_26298":109577,"_2652":109677},[],"DMS propietario distinto",{"_3154":65110,"_27801":65071,"_19254":109679,"_5":13218,"_26298":109577,"_2652":109680},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3154":65111,"_27801":65071,"_19254":109682,"_5":13218,"_26298":109577,"_2652":48787},[],{"_3154":65112,"_27801":65071,"_19254":109684,"_5":13218,"_26298":109577,"_2652":109685},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3154":65113,"_27801":65071,"_19254":109687,"_5":13218,"_26298":109577,"_2652":48793},[],{"_3154":65114,"_27801":65071,"_19254":109689,"_5":13218,"_26298":109577,"_2652":109690},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3154":65115,"_27801":65071,"_19254":109692,"_5":13218,"_26298":109577,"_2652":109693},[],"Certificado actual revocado",{"_3154":65116,"_27801":65071,"_19254":109695,"_5":13218,"_26298":109577,"_2652":109696},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3154":65117,"_27801":65071,"_19254":109698,"_5":13218,"_26298":109577,"_2652":109699},[],"Error de CA, perfil o firma",{"_3154":65118,"_27801":65071,"_19254":109701,"_5":13218,"_26298":109577,"_2652":109702},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3154":65119,"_27801":65071,"_19254":109704,"_5":13218,"_26298":109577,"_2652":109705},[],"HTTP 200 sin conexión del dispositivo",{"_3154":65120,"_27801":65071,"_19254":109707,"_5":13218,"_26298":109577,"_2652":109708},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3154":65121,"_27801":65071,"_19254":109710,"_5":13218,"_26298":109577,"_2652":109711},[],"Timeout o error después de emitir",{"_3154":65122,"_27801":65071,"_19254":109713,"_5":13218,"_26298":109577,"_2652":109714},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3154":65123,"_27801":65071,"_19254":109716,"_5":13218,"_26298":109581,"_2652":109717},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3154":65124,"_27801":65071,"_19254":109719,"_5":13218,"_26298":109581,"_2652":109720},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_3154":65125,"_27801":65071,"_19254":109722,"_5":13218,"_26298":109584,"_2652":109723},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3154":65126,"_27801":65071,"_19254":109725,"_5":13218,"_26298":109584,"_2652":109726},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3154":65127,"_27801":65071,"_19254":109728,"_5":13218,"_26298":109584,"_2652":109729},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3154":65128,"_27801":65071,"_19254":109731,"_5":13218,"_26298":109584,"_2652":109732},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3154":65129,"_27801":65071,"_19254":109734,"_5":13218,"_26298":109584,"_2652":109735},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3154":65130,"_27801":65071,"_19254":109737,"_5":13218,"_26298":109584,"_2652":109738},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3154":65131,"_27801":65071,"_19254":109740,"_5":13218,"_26298":109584,"_2652":109741},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3154":65132,"_27801":65132,"_5":13544,"_2652":109743,"_28144":109744,"_19254":109745,"_26298":65132},"Distribución y actualización de confianza",[45131,107460,47488,108435,108610],[],{"_3154":65133,"_27801":65132,"_19254":109747,"_5":13218,"_26298":65132,"_2652":109748},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_3154":65134,"_27801":65132,"_5":28141,"_19254":109750,"_26298":109751,"_2652":109752},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_3154":65135,"_27801":65132,"_5":28141,"_19254":109754,"_26298":109755,"_2652":109756},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_3154":65136,"_27801":65132,"_5":28141,"_19254":109758,"_26298":109759,"_2652":109760},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_3154":65137,"_27801":65132,"_5":28141,"_19254":109762,"_26298":109763,"_2652":109764},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_3154":65138,"_27801":65132,"_5":28141,"_19254":109766,"_26298":109767,"_2652":109768},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_3154":65139,"_27801":65132,"_19254":109770,"_5":13218,"_26298":65132,"_2652":109771},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_3154":65140,"_27801":65132,"_19254":109773,"_5":13218,"_26298":109751,"_2652":109774},[],"Relación",{"_3154":65141,"_27801":65132,"_19254":109776,"_5":13218,"_26298":109751,"_2652":109777},[],"Material que prepara el responsable",{"_3154":65142,"_27801":65132,"_19254":109779,"_5":13218,"_26298":109751,"_2652":109780},[],"Dispositivo → servidor EST",{"_3154":65143,"_27801":65132,"_19254":109782,"_5":13218,"_26298":109751,"_2652":109783},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_3154":65144,"_27801":65132,"_19254":109785,"_5":13218,"_26298":109751,"_2652":109786},[],"DMS → solicitante",{"_3154":65145,"_27801":65132,"_19254":109788,"_5":13218,"_26298":109751,"_2652":109789},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_3154":65146,"_27801":65132,"_19254":109791,"_5":13218,"_26298":109751,"_2652":109792},[],"Consumidor → dispositivo",{"_3154":65147,"_27801":65132,"_19254":109794,"_5":13218,"_26298":109751,"_2652":109795},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_3154":65148,"_27801":65132,"_19254":109797,"_5":13218,"_26298":109751,"_2652":109798},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_3154":65149,"_27801":65132,"_19254":109800,"_5":13218,"_26298":109755,"_2652":109801},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3154":65150,"_27801":65132,"_19254":109803,"_5":13218,"_26298":109755,"_2652":109804},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3154":65151,"_27801":65132,"_19254":109806,"_5":13218,"_26298":109759,"_2652":109807},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_3154":65152,"_27801":65132,"_19254":109809,"_5":13218,"_26298":109759,"_2652":109810},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_3154":65153,"_27801":65132,"_19254":109812,"_5":13218,"_26298":109759,"_2652":109813},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_3154":65154,"_27801":65132,"_19254":109815,"_5":13218,"_26298":109759,"_2652":109816},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_3154":65155,"_27801":65132,"_19254":109818,"_5":13218,"_26298":109759,"_2652":109819},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_3154":65156,"_27801":65132,"_19254":109821,"_5":13218,"_26298":109759,"_2652":109822},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_3154":65157,"_27801":65132,"_19254":109824,"_5":13218,"_26298":109763,"_2652":109825},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_3154":65158,"_27801":65132,"_19254":109827,"_5":13218,"_26298":109763,"_2652":109828},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_3154":65159,"_27801":65132,"_19254":109830,"_5":13218,"_26298":109763,"_2652":109831},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_3154":65160,"_27801":65132,"_19254":109833,"_5":13218,"_26298":109767,"_2652":109834},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_3154":65161,"_27801":65161,"_5":13544,"_2652":48942,"_28144":109836,"_19254":109838,"_26298":65161},[45131,107460,47488,108435,109837],"Integraciones",[],{"_3154":65162,"_27801":65161,"_19254":109840,"_5":13218,"_26298":65161,"_2652":109841},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3154":65163,"_27801":65161,"_5":28141,"_19254":109843,"_26298":109844,"_2652":109845},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3154":65164,"_27801":65161,"_5":28141,"_19254":109847,"_26298":109848,"_2652":109849},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3154":65165,"_27801":65161,"_5":28141,"_19254":109851,"_26298":109852,"_2652":109853},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3154":65166,"_27801":65161,"_5":28141,"_19254":109855,"_26298":109856,"_2652":109857},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3154":65167,"_27801":65161,"_5":28141,"_19254":109859,"_26298":109860,"_2652":109861},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3154":65168,"_27801":65161,"_5":28141,"_19254":109863,"_26298":109864,"_2652":109865},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3154":65169,"_27801":65161,"_5":28141,"_19254":109867,"_26298":109868,"_2652":48976},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3154":65170,"_27801":65161,"_5":28141,"_19254":109870,"_26298":109871,"_2652":48980},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3154":65171,"_27801":65161,"_5":28141,"_19254":109873,"_26298":109874,"_2652":109875},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3154":65172,"_27801":65161,"_5":28141,"_19254":109877,"_26298":109878,"_2652":109879},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3154":65173,"_27801":65161,"_5":28141,"_19254":109881,"_26298":109882,"_2652":109883},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3154":65174,"_27801":65161,"_5":28141,"_19254":109885,"_26298":109886,"_2652":109887},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3154":65175,"_27801":65161,"_5":28141,"_19254":109889,"_26298":109890,"_2652":109891},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3154":65176,"_27801":65161,"_5":28141,"_19254":109893,"_26298":109894,"_2652":109895},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3154":65177,"_27801":65161,"_5":28141,"_19254":109897,"_26298":109898,"_2652":109899},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3154":65178,"_27801":65161,"_5":28141,"_19254":109901,"_26298":109902,"_2652":109903},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3154":65179,"_27801":65161,"_5":28141,"_19254":109905,"_26298":109906,"_2652":109907},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3154":65180,"_27801":65161,"_5":28141,"_19254":109909,"_26298":109910,"_2652":109911},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3154":65181,"_27801":65161,"_5":28141,"_19254":109913,"_26298":109914,"_2652":109915},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3154":65182,"_27801":65161,"_5":28141,"_19254":109917,"_26298":109918,"_2652":109919},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3154":65183,"_27801":65161,"_19254":109921,"_5":13218,"_26298":65161,"_2652":109922},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3154":65184,"_27801":65161,"_19254":109924,"_5":13218,"_26298":65161,"_2652":109925},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3154":65185,"_27801":65161,"_19254":109927,"_5":13218,"_26298":65161,"_2652":109928},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3154":65186,"_27801":65161,"_19254":109930,"_5":13218,"_26298":109844,"_2652":109931},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3154":65187,"_27801":65161,"_19254":109933,"_5":13218,"_26298":109844,"_2652":109934},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3154":65188,"_27801":65161,"_19254":109936,"_5":13218,"_26298":109844,"_2652":109937},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3154":65189,"_27801":65161,"_19254":109939,"_5":13218,"_26298":109844,"_2652":109940},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3154":65190,"_27801":65161,"_19254":109942,"_5":13218,"_26298":109848,"_2652":109943},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3154":65191,"_27801":65161,"_19254":109945,"_5":13218,"_26298":109852,"_2652":109946},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3154":65192,"_27801":65161,"_19254":109948,"_5":13218,"_26298":109852,"_2652":109949},[],"Acción IAM",{"_3154":65193,"_27801":65161,"_19254":109951,"_5":13218,"_26298":109852,"_2652":106496},[],{"_3154":65194,"_27801":65161,"_19254":109953,"_5":13218,"_26298":109852,"_2652":49063},[],{"_3154":65195,"_27801":65161,"_19254":109955,"_5":13218,"_26298":109852,"_2652":109956},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3154":65196,"_27801":65161,"_19254":109958,"_5":13218,"_26298":109852,"_2652":49069},[],{"_3154":65197,"_27801":65161,"_19254":109960,"_5":13218,"_26298":109852,"_2652":109961},[],"Registrar la CA en AWS IoT",{"_3154":65198,"_27801":65161,"_19254":109963,"_5":13218,"_26298":109852,"_2652":49075},[],{"_3154":65199,"_27801":65161,"_19254":109965,"_5":13218,"_26298":109852,"_2652":109966},[],"Consultar el estado del registro de la CA",{"_3154":65200,"_27801":65161,"_19254":109968,"_5":13218,"_26298":109852,"_2652":49081},[],{"_3154":65201,"_27801":65161,"_19254":109970,"_5":13218,"_26298":109852,"_2652":109971},[],"Crear o actualizar Things en IoT Core",{"_3154":65202,"_27801":65161,"_19254":109973,"_5":13218,"_26298":109852,"_2652":49087},[],{"_3154":65203,"_27801":65161,"_19254":109975,"_5":13218,"_26298":109852,"_2652":109976},[],"Aprovisionar Things mediante plantilla",{"_3154":65204,"_27801":65161,"_19254":109978,"_5":13218,"_26298":109852,"_2652":49093},[],{"_3154":65205,"_27801":65161,"_19254":109980,"_5":13218,"_26298":109852,"_2652":109981},[],"Registrar certificados de dispositivo",{"_3154":65206,"_27801":65161,"_19254":109983,"_5":13218,"_26298":109852,"_2652":49099},[],{"_3154":65207,"_27801":65161,"_19254":109985,"_5":13218,"_26298":109852,"_2652":109986},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3154":65208,"_27801":65161,"_19254":109988,"_5":13218,"_26298":109852,"_2652":49105},[],{"_3154":65209,"_27801":65161,"_19254":109990,"_5":13218,"_26298":109852,"_2652":109991},[],"Crear y adjuntar políticas IoT",{"_3154":65210,"_27801":65161,"_19254":109993,"_5":13218,"_26298":109852,"_2652":49111},[],{"_3154":65211,"_27801":65161,"_19254":109995,"_5":13218,"_26298":109852,"_2652":109996},[],"Gestionar grupos de Things",{"_3154":65212,"_27801":65161,"_19254":109998,"_5":13218,"_26298":109852,"_2652":49117},[],{"_3154":65213,"_27801":65161,"_19254":110000,"_5":13218,"_26298":109852,"_2652":110001},[],"Crear plantillas JITP",{"_3154":65214,"_27801":65161,"_19254":110003,"_5":13218,"_26298":109852,"_2652":49123},[],{"_3154":65215,"_27801":65161,"_19254":110005,"_5":13218,"_26298":109852,"_2652":110006},[],"Leer y escribir el Device Shadow",{"_3154":65216,"_27801":65161,"_19254":110008,"_5":13218,"_26298":109852,"_2652":110009},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3154":65217,"_27801":65161,"_19254":110011,"_5":13218,"_26298":109856,"_2652":110012},[],"Parámetro",{"_3154":65218,"_27801":65161,"_19254":110014,"_5":13218,"_26298":109856,"_2652":110015},[],"Tipo",{"_3154":65219,"_27801":65161,"_19254":110017,"_5":13218,"_26298":109856,"_2652":110018},[],"Requerido",{"_3154":65220,"_27801":65161,"_19254":110020,"_5":13218,"_26298":109856,"_2652":110021},[],"Descripción",{"_3154":65221,"_27801":65161,"_19254":110023,"_5":13218,"_26298":109856,"_2652":49144},[],{"_3154":65222,"_27801":65161,"_19254":110025,"_5":13218,"_26298":109856,"_2652":23039},[],{"_3154":65223,"_27801":65161,"_19254":110027,"_5":13218,"_26298":109856,"_2652":110028},[],"Sí",{"_3154":65224,"_27801":65161,"_19254":110030,"_5":13218,"_26298":109856,"_2652":110031},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3154":65225,"_27801":65161,"_19254":110033,"_5":13218,"_26298":109856,"_2652":49155},[],{"_3154":65226,"_27801":65161,"_19254":110035,"_5":13218,"_26298":109856,"_2652":23039},[],{"_3154":65227,"_27801":65161,"_19254":110037,"_5":13218,"_26298":109856,"_2652":110028},[],{"_3154":65228,"_27801":65161,"_19254":110039,"_5":13218,"_26298":109856,"_2652":110040},[],"Región AWS donde opera el conector.",{"_3154":65229,"_27801":65161,"_19254":110042,"_5":13218,"_26298":109856,"_2652":49165},[],{"_3154":65230,"_27801":65161,"_19254":110044,"_5":13218,"_26298":109856,"_2652":23039},[],{"_3154":65231,"_27801":65161,"_19254":110046,"_5":13218,"_26298":109856,"_2652":110028},[],{"_3154":65232,"_27801":65161,"_19254":110048,"_5":13218,"_26298":109856,"_2652":110049},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3154":65233,"_27801":65161,"_19254":110051,"_5":13218,"_26298":109856,"_2652":49175},[],{"_3154":65234,"_27801":65161,"_19254":110053,"_5":13218,"_26298":109856,"_2652":23039},[],{"_3154":65235,"_27801":65161,"_19254":110055,"_5":13218,"_26298":109856,"_2652":110056},[],"Solo con `auth_method=static`",{"_3154":65236,"_27801":65161,"_19254":110058,"_5":13218,"_26298":109856,"_2652":110059},[],"Clave de acceso AWS.",{"_3154":65237,"_27801":65161,"_19254":110061,"_5":13218,"_26298":109856,"_2652":49186},[],{"_3154":65238,"_27801":65161,"_19254":110063,"_5":13218,"_26298":109856,"_2652":23039},[],{"_3154":65239,"_27801":65161,"_19254":110065,"_5":13218,"_26298":109856,"_2652":110056},[],{"_3154":65240,"_27801":65161,"_19254":110067,"_5":13218,"_26298":109856,"_2652":110068},[],"Clave secreta AWS.",{"_3154":65241,"_27801":65161,"_19254":110070,"_5":13218,"_26298":109856,"_2652":49196},[],{"_3154":65242,"_27801":65161,"_19254":110072,"_5":13218,"_26298":109856,"_2652":23039},[],{"_3154":65243,"_27801":65161,"_19254":110074,"_5":13218,"_26298":109856,"_2652":49201},[],{"_3154":65244,"_27801":65161,"_19254":110076,"_5":13218,"_26298":109856,"_2652":110077},[],"Token de sesión (con `auth_method=static`).",{"_3154":65245,"_27801":65161,"_19254":110079,"_5":13218,"_26298":109856,"_2652":49207},[],{"_3154":65246,"_27801":65161,"_19254":110081,"_5":13218,"_26298":109856,"_2652":23039},[],{"_3154":65247,"_27801":65161,"_19254":110083,"_5":13218,"_26298":109856,"_2652":110084},[],"Solo con `auth_method=role`",{"_3154":65248,"_27801":65161,"_19254":110086,"_5":13218,"_26298":109856,"_2652":110087},[],"ARN del rol a asumir.",{"_3154":65249,"_27801":65161,"_19254":110089,"_5":13218,"_26298":109856,"_2652":49218},[],{"_3154":65250,"_27801":65161,"_19254":110091,"_5":13218,"_26298":109856,"_2652":23039},[],{"_3154":65251,"_27801":65161,"_19254":110093,"_5":13218,"_26298":109856,"_2652":49201},[],{"_3154":65252,"_27801":65161,"_19254":110095,"_5":13218,"_26298":109856,"_2652":110096},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3154":65253,"_27801":65161,"_19254":110098,"_5":13218,"_26298":109856,"_2652":49228},[],{"_3154":65254,"_27801":65161,"_19254":110100,"_5":13218,"_26298":109856,"_2652":16231},[],{"_3154":65255,"_27801":65161,"_19254":110102,"_5":13218,"_26298":109856,"_2652":110028},[],{"_3154":65256,"_27801":65161,"_19254":110104,"_5":13218,"_26298":109856,"_2652":110105},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3154":65257,"_27801":65161,"_19254":110107,"_5":13218,"_26298":109856,"_2652":49238},[],{"_3154":65258,"_27801":65161,"_19254":110109,"_5":13218,"_26298":109856,"_2652":23039},[],{"_3154":65259,"_27801":65161,"_19254":110111,"_5":13218,"_26298":109856,"_2652":110028},[],{"_3154":65260,"_27801":65161,"_19254":110113,"_5":13218,"_26298":109856,"_2652":110114},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3154":65261,"_27801":65161,"_19254":110116,"_5":13218,"_26298":109856,"_2652":49248},[],{"_3154":65262,"_27801":65161,"_19254":110118,"_5":13218,"_26298":109856,"_2652":23039},[],{"_3154":65263,"_27801":65161,"_19254":110120,"_5":13218,"_26298":109856,"_2652":110028},[],{"_3154":65264,"_27801":65161,"_19254":110122,"_5":13218,"_26298":109856,"_2652":110123},[],"URL HTTP del Device Manager de Lamassu.",{"_3154":65265,"_27801":65161,"_19254":110125,"_5":13218,"_26298":109856,"_2652":49258},[],{"_3154":65266,"_27801":65161,"_19254":110127,"_5":13218,"_26298":109856,"_2652":23039},[],{"_3154":65267,"_27801":65161,"_19254":110129,"_5":13218,"_26298":109856,"_2652":110028},[],{"_3154":65268,"_27801":65161,"_19254":110131,"_5":13218,"_26298":109856,"_2652":110132},[],"URL HTTP del servicio de CA de Lamassu.",{"_3154":65269,"_27801":65161,"_19254":110134,"_5":13218,"_26298":109860,"_2652":110135},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3154":65270,"_27801":65161,"_19254":110137,"_5":13218,"_26298":109864,"_2652":110138},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3154":65271,"_27801":65161,"_19254":110140,"_5":13218,"_26298":109864,"_2652":110141},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3154":65272,"_27801":65161,"_19254":110143,"_5":13218,"_26298":109868,"_2652":110144},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3154":65273,"_27801":65161,"_19254":110146,"_5":13218,"_26298":109868,"_2652":110147},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3154":65274,"_27801":65161,"_19254":110149,"_5":13218,"_26298":109868,"_2652":110150},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3154":65275,"_27801":65161,"_19254":110152,"_5":13218,"_26298":109868,"_2652":110153},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3154":65276,"_27801":65161,"_19254":110155,"_5":13218,"_26298":109868,"_2652":110156},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3154":65277,"_27801":65161,"_19254":110158,"_5":13218,"_26298":109868,"_2652":110159},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3154":65278,"_27801":65161,"_19254":110161,"_5":13218,"_26298":109871,"_2652":110162},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3154":65279,"_27801":65161,"_19254":110164,"_5":13218,"_26298":109874,"_2652":110165},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3154":65280,"_27801":65161,"_19254":110167,"_5":13218,"_26298":109874,"_2652":110168},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3154":65281,"_27801":65161,"_19254":110170,"_5":13218,"_26298":109878,"_2652":110171},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3154":65282,"_27801":65161,"_19254":110173,"_5":13218,"_26298":109882,"_2652":110174},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3154":65283,"_27801":65161,"_19254":110176,"_5":13218,"_26298":109882,"_2652":110177},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3154":65284,"_27801":65161,"_19254":110179,"_5":13218,"_26298":109882,"_2652":110180},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3154":65285,"_27801":65161,"_19254":110182,"_5":13218,"_26298":109882,"_2652":110183},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3154":65286,"_27801":65161,"_19254":110185,"_5":13218,"_26298":109882,"_2652":110186},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3154":65287,"_27801":65161,"_19254":110188,"_5":13218,"_26298":109882,"_2652":110189},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3154":65288,"_27801":65161,"_19254":110191,"_5":13218,"_26298":109886,"_2652":110192},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. Esta plantilla se crea o actualiza en el momento en que el DMS se crea o actualiza en Lamassu - no en el momento del enrolamiento del dispositivo. A partir de ese momento, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3154":65289,"_27801":65161,"_19254":110194,"_5":13218,"_26298":109886,"_2652":110195},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3154":65290,"_27801":65161,"_19254":110197,"_5":13218,"_26298":109886,"_2652":110198},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3154":65291,"_27801":65161,"_19254":110200,"_5":13218,"_26298":109890,"_2652":110201},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3154":65292,"_27801":65161,"_19254":110203,"_5":13218,"_26298":109890,"_2652":110204},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3154":65293,"_27801":65161,"_19254":110206,"_5":13218,"_26298":109890,"_2652":110207},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3154":65294,"_27801":65161,"_19254":110209,"_5":13218,"_26298":109894,"_2652":110210},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3154":65295,"_27801":65161,"_19254":110212,"_5":13218,"_26298":109894,"_2652":110213},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3154":65296,"_27801":65161,"_19254":110215,"_5":13218,"_26298":109894,"_2652":110216},[],"Para que el flujo JITP funcione correctamente:",{"_3154":65297,"_27801":65161,"_19254":110218,"_5":13218,"_26298":109894,"_2652":110219},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3154":65298,"_27801":65161,"_19254":110221,"_5":13218,"_26298":109894,"_2652":110222},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3154":65299,"_27801":65161,"_19254":110224,"_5":13218,"_26298":109894,"_2652":110225},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3154":65300,"_27801":65161,"_19254":110227,"_5":13218,"_26298":109894,"_2652":110228},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3154":65301,"_27801":65161,"_19254":110230,"_5":13218,"_26298":109898,"_2652":110231},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3154":65302,"_27801":65161,"_19254":110233,"_5":13218,"_26298":109898,"_2652":110234},[],"Estado en Lamassu",{"_3154":65303,"_27801":65161,"_19254":110236,"_5":13218,"_26298":109898,"_2652":110237},[],"Razón de revocación",{"_3154":65304,"_27801":65161,"_19254":110239,"_5":13218,"_26298":109898,"_2652":110240},[],"Estado en AWS IoT Core",{"_3154":65305,"_27801":65161,"_19254":110242,"_5":13218,"_26298":109898,"_2652":49379},[],{"_3154":65306,"_27801":65161,"_19254":110244,"_5":13218,"_26298":109898,"_2652":110245},[],"Ninguna",{"_3154":65307,"_27801":65161,"_19254":110247,"_5":13218,"_26298":109898,"_2652":49385},[],{"_3154":65308,"_27801":65161,"_19254":110249,"_5":13218,"_26298":109898,"_2652":49388},[],{"_3154":65309,"_27801":65161,"_19254":110251,"_5":13218,"_26298":109898,"_2652":49391},[],{"_3154":65310,"_27801":65161,"_19254":110253,"_5":13218,"_26298":109898,"_2652":49394},[],{"_3154":65311,"_27801":65161,"_19254":110255,"_5":13218,"_26298":109898,"_2652":49388},[],{"_3154":65312,"_27801":65161,"_19254":110257,"_5":13218,"_26298":109898,"_2652":110258},[],"Cualquier otra razón",{"_3154":65313,"_27801":65161,"_19254":110260,"_5":13218,"_26298":109898,"_2652":49402},[],{"_3154":65314,"_27801":65161,"_19254":110262,"_5":13218,"_26298":109898,"_2652":110263},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3154":65315,"_27801":65161,"_19254":110265,"_5":13218,"_26298":109902,"_2652":110266},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3154":65316,"_27801":65161,"_19254":110268,"_5":13218,"_26298":109902,"_2652":110269},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3154":65317,"_27801":65161,"_19254":110271,"_5":13218,"_26298":109902,"_2652":110272},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3154":65318,"_27801":65161,"_19254":110274,"_5":13218,"_26298":109906,"_2652":110275},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3154":65319,"_27801":65161,"_19254":110277,"_5":13218,"_26298":109906,"_2652":110278},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3154":65320,"_27801":65161,"_19254":110280,"_5":13218,"_26298":109910,"_2652":110281},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3154":65321,"_27801":65161,"_19254":110283,"_5":13218,"_26298":109910,"_2652":110284},[],"Existen dos tipos de acciones:",{"_3154":65322,"_27801":65161,"_19254":110286,"_5":13218,"_26298":109910,"_2652":110287},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3154":65323,"_27801":65161,"_19254":110289,"_5":13218,"_26298":109910,"_2652":110290},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3154":65324,"_27801":65161,"_19254":110292,"_5":13218,"_26298":109910,"_2652":110293},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3154":65325,"_27801":65161,"_19254":110295,"_5":13218,"_26298":109914,"_2652":110296},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3154":65326,"_27801":65161,"_19254":110298,"_5":13218,"_26298":109914,"_2652":110299},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3154":65327,"_27801":65161,"_19254":110301,"_5":13218,"_26298":109914,"_2652":110302},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3154":65328,"_27801":65161,"_19254":110304,"_5":13218,"_26298":109918,"_2652":110305},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3154":65329,"_27801":65161,"_19254":110307,"_5":13218,"_26298":109918,"_2652":110308},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3154":65330,"_27801":65161,"_19254":110310,"_5":13218,"_26298":109918,"_2652":110311},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3154":65331,"_27801":65161,"_19254":110313,"_5":13218,"_26298":109918,"_2652":110314},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3154":65332,"_27801":65161,"_19254":110316,"_5":13218,"_26298":109918,"_2652":110317},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3154":65333,"_27801":65161,"_19254":110319,"_5":13218,"_26298":109918,"_2652":110320},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3154":65334,"_27801":65161,"_19254":110322,"_5":13218,"_26298":109918,"_2652":110323},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3154":65335,"_27801":65161,"_19254":110325,"_5":13218,"_26298":109918,"_2652":110326},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3154":65336,"_27801":65161,"_19254":110328,"_5":13218,"_26298":109918,"_2652":110329},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3154":65337,"_27801":65161,"_19254":110331,"_5":13218,"_26298":109918,"_2652":110332},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3154":65338,"_27801":65161,"_19254":110334,"_5":13218,"_26298":109918,"_2652":110335},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3154":65339,"_27801":65161,"_19254":110337,"_5":13218,"_26298":109918,"_2652":110338},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3154":65340,"_27801":65161,"_19254":110340,"_5":13218,"_26298":109918,"_2652":110341},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3154":65341,"_27801":65161,"_19254":110343,"_5":13218,"_26298":109918,"_2652":110344},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3154":65342,"_27801":65161,"_19254":110346,"_5":13218,"_26298":109918,"_2652":110347},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3154":65343,"_27801":65161,"_19254":110349,"_5":13218,"_26298":109918,"_2652":110350},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3154":65344,"_27801":65161,"_19254":110352,"_5":13218,"_26298":109918,"_2652":110353},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3154":65345,"_27801":65161,"_19254":110355,"_5":13218,"_26298":109918,"_2652":110356},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3154":65346,"_27801":65161,"_19254":110358,"_5":13218,"_26298":109918,"_2652":110359},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3154":65347,"_27801":65161,"_19254":110361,"_5":13218,"_26298":109918,"_2652":110362},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3154":65348,"_27801":65161,"_19254":110364,"_5":13218,"_26298":109918,"_2652":110365},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3154":65349,"_27801":65349,"_5":13544,"_2652":47488,"_28144":110367,"_19254":110368,"_26298":65349},[45131,107460,47488],[],{"_3154":65350,"_27801":65349,"_19254":110370,"_5":13218,"_26298":65349,"_2652":110371},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3154":65351,"_27801":65349,"_5":28141,"_19254":110373,"_26298":110374,"_2652":110375},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3154":65352,"_27801":65349,"_5":28141,"_19254":110377,"_26298":110378,"_2652":108435},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3154":65353,"_27801":65349,"_5":28141,"_19254":110380,"_26298":110381,"_2652":108610},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3154":65354,"_27801":65349,"_5":28141,"_19254":110383,"_26298":110384,"_2652":109837},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/overview#integraciones",{"_3154":65355,"_27801":65349,"_5":28141,"_19254":110386,"_26298":110387,"_2652":110388},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3154":65356,"_27801":65349,"_19254":110390,"_5":13218,"_26298":65349,"_2652":110391},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3154":65357,"_27801":65349,"_19254":110393,"_5":13218,"_26298":110374,"_2652":110394},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3154":65358,"_27801":65349,"_19254":110396,"_5":13218,"_26298":110374,"_2652":110397},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3154":65359,"_27801":65349,"_19254":110399,"_5":13218,"_26298":110378,"_2652":110400},[],"Recurso",{"_3154":65360,"_27801":65349,"_19254":110402,"_5":13218,"_26298":110378,"_2652":110403},[],"Qué representa",{"_3154":65361,"_27801":65349,"_19254":110405,"_5":13218,"_26298":110378,"_2652":110406},[],"**Dispositivo**",{"_3154":65362,"_27801":65349,"_19254":110408,"_5":13218,"_26298":110378,"_2652":110409},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3154":65363,"_27801":65349,"_19254":110411,"_5":13218,"_26298":110378,"_2652":110412},[],"**Identidad**",{"_3154":65364,"_27801":65349,"_19254":110414,"_5":13218,"_26298":110378,"_2652":110415},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3154":65365,"_27801":65349,"_19254":110417,"_5":13218,"_26298":110378,"_2652":49560},[],{"_3154":65366,"_27801":65349,"_19254":110419,"_5":13218,"_26298":110378,"_2652":110420},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3154":65367,"_27801":65349,"_19254":110422,"_5":13218,"_26298":110378,"_2652":110423},[],"**Flota**",{"_3154":65368,"_27801":65349,"_19254":110425,"_5":13218,"_26298":110378,"_2652":110426},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3154":65369,"_27801":65349,"_19254":110428,"_5":13218,"_26298":110378,"_2652":110429},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3154":65370,"_27801":65349,"_19254":110431,"_5":13218,"_26298":110378,"_2652":110432},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3154":65371,"_27801":65349,"_19254":110434,"_5":13218,"_26298":110381,"_2652":110435},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3154":65372,"_27801":65349,"_19254":110437,"_5":13218,"_26298":110381,"_2652":110438},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3154":65373,"_27801":65349,"_19254":110440,"_5":13218,"_26298":110381,"_2652":110441},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3154":65374,"_27801":65349,"_19254":110443,"_5":13218,"_26298":110381,"_2652":110444},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3154":65375,"_27801":65349,"_19254":110446,"_5":13218,"_26298":110381,"_2652":110447},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3154":65376,"_27801":65349,"_19254":110449,"_5":13218,"_26298":110381,"_2652":110450},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3154":65377,"_27801":65349,"_19254":110452,"_5":13218,"_26298":110381,"_2652":110453},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3154":65378,"_27801":65349,"_19254":110455,"_5":13218,"_26298":110381,"_2652":110456},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3154":65379,"_27801":65349,"_19254":110458,"_5":13218,"_26298":110384,"_2652":110459},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3154":65380,"_27801":65349,"_19254":110461,"_5":13218,"_26298":110384,"_2652":110462},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3154":65381,"_27801":65349,"_19254":110464,"_5":13218,"_26298":110387,"_2652":110465},[],"Participante",{"_3154":65382,"_27801":65349,"_19254":110467,"_5":13218,"_26298":110387,"_2652":110468},[],"Responsabilidad",{"_3154":65383,"_27801":65349,"_19254":110470,"_5":13218,"_26298":110387,"_2652":110471},[],"Administrador PKI",{"_3154":65384,"_27801":65349,"_19254":110473,"_5":13218,"_26298":110387,"_2652":110474},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3154":65385,"_27801":65349,"_19254":110476,"_5":13218,"_26298":110387,"_2652":110477},[],"Administrador del aprovisionamiento",{"_3154":65386,"_27801":65349,"_19254":110479,"_5":13218,"_26298":110387,"_2652":110480},[],"DMS, admisión, autenticación por operación e inventario.",{"_3154":65387,"_27801":65349,"_19254":110482,"_5":13218,"_26298":110387,"_2652":110483},[],"Integrador del dispositivo",{"_3154":65388,"_27801":65349,"_19254":110485,"_5":13218,"_26298":110387,"_2652":110486},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3154":65389,"_27801":65349,"_19254":110488,"_5":13218,"_26298":110387,"_2652":110489},[],"Integrador del consumidor",{"_3154":65390,"_27801":65349,"_19254":110491,"_5":13218,"_26298":110387,"_2652":110492},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3154":65391,"_27801":65349,"_19254":110494,"_5":13218,"_26298":110387,"_2652":110495},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3154":65392,"_27801":65392,"_5":13544,"_2652":110497,"_28144":110498,"_19254":110500,"_26298":65392},"Enrola y conecta tu primer dispositivo",[45131,107460,47488,110499],"Primeros pasos",[],{"_3154":65393,"_27801":65392,"_19254":110502,"_5":13218,"_26298":65392,"_2652":110503},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3154":65394,"_27801":65392,"_5":28141,"_19254":110505,"_26298":110506,"_2652":106126},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3154":65395,"_27801":65392,"_5":28141,"_19254":110508,"_26298":110509,"_2652":110510},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3154":65396,"_27801":65392,"_5":28141,"_19254":110512,"_26298":110513,"_2652":110514},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3154":65397,"_27801":65392,"_5":28141,"_19254":110516,"_26298":110517,"_2652":110518},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3154":65398,"_27801":65392,"_5":28141,"_19254":110520,"_26298":110521,"_2652":110522},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3154":65399,"_27801":65392,"_5":28141,"_19254":110524,"_26298":110525,"_2652":110526},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3154":65400,"_27801":65392,"_5":28141,"_19254":110528,"_26298":110529,"_2652":110530},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3154":65401,"_27801":65392,"_5":28141,"_19254":110532,"_26298":110533,"_2652":110534},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3154":65402,"_27801":65392,"_19254":110536,"_5":13218,"_26298":65392,"_2652":110537},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3154":65403,"_27801":65392,"_19254":110539,"_5":13218,"_26298":110506,"_2652":110540},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3154":65404,"_27801":65392,"_19254":110542,"_5":13218,"_26298":110506,"_2652":110543},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3154":65405,"_27801":65392,"_19254":110545,"_5":13218,"_26298":110506,"_2652":110546},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3154":65406,"_27801":65392,"_19254":110548,"_5":13218,"_26298":110506,"_2652":110549},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3154":65407,"_27801":65392,"_19254":110551,"_5":13218,"_26298":110506,"_2652":110552},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3154":65408,"_27801":65392,"_19254":110554,"_5":13218,"_26298":110509,"_2652":110555},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3154":65409,"_27801":65392,"_19254":110557,"_5":13218,"_26298":110509,"_2652":110558},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3154":65410,"_27801":65392,"_19254":110560,"_5":13218,"_26298":110513,"_2652":110561},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3154":65411,"_27801":65392,"_19254":110563,"_5":13218,"_26298":110513,"_2652":110564},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3154":65412,"_27801":65392,"_19254":110566,"_5":13218,"_26298":110513,"_2652":110567},[],"Ajuste",{"_3154":65413,"_27801":65392,"_19254":110569,"_5":13218,"_26298":110513,"_2652":110570},[],"Valor de evaluación",{"_3154":65414,"_27801":65392,"_19254":110572,"_5":13218,"_26298":110513,"_2652":49716},[],{"_3154":65415,"_27801":65392,"_19254":110574,"_5":13218,"_26298":110513,"_2652":110575},[],"Raíz emisora de `device-root.pem`.",{"_3154":65416,"_27801":65392,"_19254":110577,"_5":13218,"_26298":110513,"_2652":108738},[],{"_3154":65417,"_27801":65392,"_19254":110579,"_5":13218,"_26298":110513,"_2652":110580},[],"Perfil final de 1 hora que acabas de preparar.",{"_3154":65418,"_27801":65392,"_19254":110582,"_5":13218,"_26298":110513,"_2652":49727},[],{"_3154":65419,"_27801":65392,"_19254":110584,"_5":13218,"_26298":110513,"_2652":49730},[],{"_3154":65420,"_27801":65392,"_19254":110586,"_5":13218,"_26298":110513,"_2652":49733},[],{"_3154":65421,"_27801":65392,"_19254":110588,"_5":13218,"_26298":110513,"_2652":110589},[],"Habilitado.",{"_3154":65422,"_27801":65392,"_19254":110591,"_5":13218,"_26298":110513,"_2652":49739},[],{"_3154":65423,"_27801":65392,"_19254":110593,"_5":13218,"_26298":110513,"_2652":110594},[],"Deshabilitado; el ID debe ser nuevo.",{"_3154":65424,"_27801":65392,"_19254":110596,"_5":13218,"_26298":110513,"_2652":110597},[],"Autenticación inicial",{"_3154":65425,"_27801":65392,"_19254":110599,"_5":13218,"_26298":110513,"_2652":110600},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3154":65426,"_27801":65392,"_19254":110602,"_5":13218,"_26298":110513,"_2652":110603},[],"Autenticación de renovación",{"_3154":65427,"_27801":65392,"_19254":110605,"_5":13218,"_26298":110513,"_2652":110606},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3154":65428,"_27801":65392,"_19254":110608,"_5":13218,"_26298":110513,"_2652":49757},[],{"_3154":65429,"_27801":65392,"_19254":110610,"_5":13218,"_26298":110513,"_2652":110611},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_3154":65430,"_27801":65392,"_19254":110613,"_5":13218,"_26298":110513,"_2652":49763},[],{"_3154":65431,"_27801":65392,"_19254":110615,"_5":13218,"_26298":110513,"_2652":110616},[],"1 hora.",{"_3154":65432,"_27801":65392,"_19254":110618,"_5":13218,"_26298":110513,"_2652":49769},[],{"_3154":65433,"_27801":65392,"_19254":110620,"_5":13218,"_26298":110513,"_2652":110621},[],"30 minutos / 10 minutos.",{"_3154":65434,"_27801":65392,"_19254":110623,"_5":13218,"_26298":110513,"_2652":49775},[],{"_3154":65435,"_27801":65392,"_19254":110625,"_5":13218,"_26298":110513,"_2652":110626},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3154":65436,"_27801":65392,"_19254":110628,"_5":13218,"_26298":110513,"_2652":47807},[],{"_3154":65437,"_27801":65392,"_19254":110630,"_5":13218,"_26298":110513,"_2652":110631},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3154":65438,"_27801":65392,"_19254":110633,"_5":13218,"_26298":110513,"_2652":49786},[],{"_3154":65439,"_27801":65392,"_19254":110635,"_5":13218,"_26298":110513,"_2652":110636},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3154":65440,"_27801":65392,"_19254":110638,"_5":13218,"_26298":110513,"_2652":110639},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. Si tu consola no expone el bloque independiente, configura y comprueba el recurso mediante la API DMS y la guía DMS.",{"_3154":65441,"_27801":65392,"_19254":110641,"_5":13218,"_26298":110517,"_2652":110642},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3154":65442,"_27801":65392,"_19254":110644,"_5":13218,"_26298":110517,"_2652":110645},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3154":65443,"_27801":65392,"_19254":110647,"_5":13218,"_26298":110521,"_2652":110648},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3154":65444,"_27801":65392,"_19254":110650,"_5":13218,"_26298":110521,"_2652":110651},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3154":65445,"_27801":65392,"_19254":110653,"_5":13218,"_26298":110521,"_2652":110654},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3154":65446,"_27801":65392,"_19254":110656,"_5":13218,"_26298":110525,"_2652":110657},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3154":65447,"_27801":65392,"_19254":110659,"_5":13218,"_26298":110525,"_2652":110660},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3154":65448,"_27801":65392,"_19254":110662,"_5":13218,"_26298":110529,"_2652":110663},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3154":65449,"_27801":65392,"_19254":110665,"_5":13218,"_26298":110529,"_2652":110666},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3154":65450,"_27801":65392,"_19254":110668,"_5":13218,"_26298":110529,"_2652":110669},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3154":65451,"_27801":65392,"_19254":110671,"_5":13218,"_26298":110529,"_2652":110672},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3154":65452,"_27801":65392,"_19254":110674,"_5":13218,"_26298":110529,"_2652":110675},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3154":65453,"_27801":65392,"_19254":110677,"_5":13218,"_26298":110533,"_2652":110678},[],"Comprobación",{"_3154":65454,"_27801":65392,"_19254":110680,"_5":13218,"_26298":110533,"_2652":110681},[],"Resultado esperado",{"_3154":65455,"_27801":65392,"_19254":110683,"_5":13218,"_26298":110533,"_2652":110684},[],"Registro",{"_3154":65456,"_27801":65392,"_19254":110686,"_5":13218,"_26298":110533,"_2652":110687},[],"ID creado automáticamente y DMS correcto.",{"_3154":65457,"_27801":65392,"_19254":110689,"_5":13218,"_26298":110533,"_2652":110690},[],"Certificado",{"_3154":65458,"_27801":65392,"_19254":110692,"_5":13218,"_26298":110533,"_2652":110693},[],"CN, perfil, serie y clave verificados.",{"_3154":65459,"_27801":65392,"_19254":110695,"_5":13218,"_26298":110533,"_2652":110696},[],"Inventario",{"_3154":65460,"_27801":65392,"_19254":110698,"_5":13218,"_26298":110533,"_2652":110699},[],"Serie recibida visible como identidad actual y en el historial.",{"_3154":65461,"_27801":65392,"_19254":110701,"_5":13218,"_26298":110533,"_2652":110702},[],"Consumidor",{"_3154":65462,"_27801":65392,"_19254":110704,"_5":13218,"_26298":110533,"_2652":110705},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3154":65463,"_27801":65392,"_19254":110707,"_5":13218,"_26298":110533,"_2652":110708},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3154":65464,"_27801":65392,"_19254":110710,"_5":13218,"_26298":110533,"_2652":110711},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3154":65465,"_27801":65465,"_5":13544,"_2652":108452,"_28144":110713,"_19254":110714,"_26298":65465},[45131,107460,47488,110499],[],{"_3154":65466,"_27801":65465,"_19254":110716,"_5":13218,"_26298":65465,"_2652":110717},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3154":65467,"_27801":65465,"_5":28141,"_19254":110719,"_26298":110720,"_2652":106126},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3154":65468,"_27801":65465,"_5":28141,"_19254":110722,"_26298":110723,"_2652":110724},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3154":65469,"_27801":65465,"_5":28141,"_19254":110726,"_26298":110727,"_2652":110728},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3154":65470,"_27801":65465,"_5":28141,"_19254":110730,"_26298":110731,"_2652":110732},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3154":65471,"_27801":65465,"_5":28141,"_19254":110734,"_26298":110735,"_2652":110736},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3154":65472,"_27801":65465,"_5":28141,"_19254":110738,"_26298":110739,"_2652":110740},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3154":65473,"_27801":65465,"_5":28141,"_19254":110742,"_26298":110743,"_2652":110681},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3154":65474,"_27801":65465,"_5":28141,"_19254":110745,"_26298":110746,"_2652":110747},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3154":65475,"_27801":65465,"_5":28141,"_19254":110749,"_26298":110750,"_2652":110751},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3154":65476,"_27801":65465,"_19254":110753,"_5":13218,"_26298":65465,"_2652":110754},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3154":65477,"_27801":65465,"_19254":110756,"_5":13218,"_26298":65465,"_2652":110757},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3154":65478,"_27801":65465,"_19254":110759,"_5":13218,"_26298":110720,"_2652":110760},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3154":65479,"_27801":65465,"_19254":110762,"_5":13218,"_26298":110720,"_2652":110763},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3154":65480,"_27801":65465,"_19254":110765,"_5":13218,"_26298":110720,"_2652":110766},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3154":65481,"_27801":65465,"_19254":110768,"_5":13218,"_26298":110720,"_2652":110769},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3154":65482,"_27801":65465,"_19254":110771,"_5":13218,"_26298":110723,"_2652":110772},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3154":65483,"_27801":65465,"_19254":110774,"_5":13218,"_26298":110723,"_2652":110775},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3154":65484,"_27801":65465,"_19254":110777,"_5":13218,"_26298":110723,"_2652":110778},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3154":65485,"_27801":65465,"_19254":110780,"_5":13218,"_26298":110723,"_2652":110781},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3154":65486,"_27801":65465,"_19254":110783,"_5":13218,"_26298":110723,"_2652":110784},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_3154":65487,"_27801":65465,"_19254":110786,"_5":13218,"_26298":110723,"_2652":110787},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3154":65488,"_27801":65465,"_19254":110789,"_5":13218,"_26298":110723,"_2652":110790},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3154":65489,"_27801":65465,"_19254":110792,"_5":13218,"_26298":110723,"_2652":110793},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3154":65490,"_27801":65465,"_19254":110795,"_5":13218,"_26298":110727,"_2652":110796},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3154":65491,"_27801":65465,"_19254":110798,"_5":13218,"_26298":110727,"_2652":49952},[],{"_3154":65492,"_27801":65465,"_19254":110800,"_5":13218,"_26298":110727,"_2652":110801},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3154":65493,"_27801":65465,"_19254":110803,"_5":13218,"_26298":110727,"_2652":110804},[],"**Icon** y **Tags**: clasificación opcional.",{"_3154":65494,"_27801":65465,"_19254":110806,"_5":13218,"_26298":110727,"_2652":110807},[],"Confirma el registro.",{"_3154":65495,"_27801":65465,"_19254":110809,"_5":13218,"_26298":110731,"_2652":110810},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3154":65496,"_27801":65465,"_19254":110812,"_5":13218,"_26298":110731,"_2652":110813},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3154":65497,"_27801":65465,"_19254":110815,"_5":13218,"_26298":110735,"_2652":110816},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3154":65498,"_27801":65465,"_19254":110818,"_5":13218,"_26298":110735,"_2652":110819},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3154":65499,"_27801":65465,"_19254":110821,"_5":13218,"_26298":110739,"_2652":110822},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3154":65500,"_27801":65465,"_19254":110824,"_5":13218,"_26298":110739,"_2652":110825},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3154":65501,"_27801":65465,"_19254":110827,"_5":13218,"_26298":110743,"_2652":110678},[],{"_3154":65502,"_27801":65465,"_19254":110829,"_5":13218,"_26298":110743,"_2652":110830},[],"Resultado",{"_3154":65503,"_27801":65465,"_19254":110832,"_5":13218,"_26298":110743,"_2652":110833},[],"Dispositivo",{"_3154":65504,"_27801":65465,"_19254":110835,"_5":13218,"_26298":110743,"_2652":110836},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3154":65505,"_27801":65465,"_19254":110838,"_5":13218,"_26298":110743,"_2652":110839},[],"Identidad actual",{"_3154":65506,"_27801":65465,"_19254":110841,"_5":13218,"_26298":110743,"_2652":110842},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3154":65507,"_27801":65465,"_19254":110844,"_5":13218,"_26298":110743,"_2652":110845},[],"Historial",{"_3154":65508,"_27801":65465,"_19254":110847,"_5":13218,"_26298":110743,"_2652":110848},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3154":65509,"_27801":65465,"_19254":110850,"_5":13218,"_26298":110743,"_2652":110851},[],"Clave y certificado",{"_3154":65510,"_27801":65465,"_19254":110853,"_5":13218,"_26298":110743,"_2652":110854},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3154":65511,"_27801":65465,"_19254":110856,"_5":13218,"_26298":110746,"_2652":110857},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3154":65512,"_27801":65465,"_19254":110859,"_5":13218,"_26298":110746,"_2652":110860},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3154":65513,"_27801":65465,"_19254":110862,"_5":13218,"_26298":110746,"_2652":110863},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3154":65514,"_27801":65465,"_19254":110865,"_5":13218,"_26298":110746,"_2652":110866},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3154":65515,"_27801":65465,"_19254":110868,"_5":13218,"_26298":110750,"_2652":110869},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3154":65516,"_27801":65465,"_19254":110871,"_5":13218,"_26298":110750,"_2652":110872},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3154":65517,"_27801":65465,"_19254":110874,"_5":13218,"_26298":110750,"_2652":110875},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3154":65518,"_27801":65518,"_5":13544,"_2652":110877,"_28144":110878,"_19254":110879,"_26298":65518},"Plataforma Lamassu IoT",[45131,107460],[],{"_3154":65519,"_27801":65518,"_19254":110881,"_5":13218,"_26298":65518,"_2652":110882},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3154":65520,"_27801":65518,"_5":28141,"_19254":110884,"_26298":110885,"_2652":110375},[],"/docs/pr-preview/pr-53/es/platform/overview#empieza-aquí",{"_3154":65521,"_27801":65518,"_5":28141,"_19254":110887,"_26298":110888,"_2652":110889},[],"/docs/pr-preview/pr-53/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3154":65522,"_27801":65518,"_5":28141,"_19254":110891,"_26298":110892,"_2652":110893},[],"/docs/pr-preview/pr-53/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3154":65523,"_27801":65518,"_5":28141,"_19254":110895,"_26298":110896,"_2652":110897},[],"/docs/pr-preview/pr-53/es/platform/overview#capacidades-principales","Capacidades principales",{"_3154":65524,"_27801":65518,"_5":28141,"_19254":110899,"_26298":110900,"_2652":110901},[],"/docs/pr-preview/pr-53/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3154":65525,"_27801":65518,"_5":28141,"_19254":110903,"_26298":110904,"_2652":110905},[],"/docs/pr-preview/pr-53/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3154":65526,"_27801":65518,"_5":28141,"_19254":110907,"_26298":110908,"_2652":110909},[],"/docs/pr-preview/pr-53/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3154":65527,"_27801":65518,"_5":28141,"_19254":110911,"_26298":110912,"_2652":110913},[],"/docs/pr-preview/pr-53/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3154":65528,"_27801":65518,"_5":28141,"_19254":110915,"_26298":110916,"_2652":110917},[],"/docs/pr-preview/pr-53/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3154":65529,"_27801":65518,"_5":28141,"_19254":110919,"_26298":110920,"_2652":110921},[],"/docs/pr-preview/pr-53/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3154":65530,"_27801":65518,"_5":28141,"_19254":110923,"_26298":110924,"_2652":110925},[],"/docs/pr-preview/pr-53/es/platform/overview#referencia-operativa","Referencia operativa",{"_3154":65531,"_27801":65518,"_19254":110927,"_5":13218,"_26298":65518,"_2652":110928},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3154":65532,"_27801":65518,"_19254":110930,"_5":13218,"_26298":110885,"_2652":110931},[],"Elige el resultado que necesitas obtener:",{"_3154":65533,"_27801":65518,"_19254":110933,"_5":13218,"_26298":110885,"_2652":110934},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3154":65534,"_27801":65518,"_19254":110936,"_5":13218,"_26298":110885,"_2652":110937},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3154":65535,"_27801":65518,"_19254":110939,"_5":13218,"_26298":110885,"_2652":110940},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3154":65536,"_27801":65518,"_19254":110942,"_5":13218,"_26298":110888,"_2652":110943},[],"Bloque",{"_3154":65537,"_27801":65518,"_19254":110945,"_5":13218,"_26298":110888,"_2652":110946},[],"Qué gestionas",{"_3154":65538,"_27801":65518,"_19254":110948,"_5":13218,"_26298":110888,"_2652":110949},[],"Punto de entrada",{"_3154":65539,"_27801":65518,"_19254":110951,"_5":13218,"_26298":110888,"_2652":50106},[],{"_3154":65540,"_27801":65518,"_19254":110953,"_5":13218,"_26298":110888,"_2652":110954},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3154":65541,"_27801":65518,"_19254":110956,"_5":13218,"_26298":110888,"_2652":110957},[],"Visión general de PKI",{"_3154":65542,"_27801":65518,"_19254":110959,"_5":13218,"_26298":110888,"_2652":50115},[],{"_3154":65543,"_27801":65518,"_19254":110961,"_5":13218,"_26298":110888,"_2652":110962},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3154":65544,"_27801":65518,"_19254":110964,"_5":13218,"_26298":110888,"_2652":110965},[],"Visión general de IoT Fleets",{"_3154":65545,"_27801":65518,"_19254":110967,"_5":13218,"_26298":110888,"_2652":110968},[],"**Administración**",{"_3154":65546,"_27801":65518,"_19254":110970,"_5":13218,"_26298":110888,"_2652":110971},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3154":65547,"_27801":65518,"_19254":110973,"_5":13218,"_26298":110888,"_2652":107458},[],{"_3154":65548,"_27801":65518,"_19254":110975,"_5":13218,"_26298":110888,"_2652":110976},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3154":65549,"_27801":65518,"_19254":110978,"_5":13218,"_26298":110892,"_2652":110979},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3154":65550,"_27801":65518,"_19254":110981,"_5":13218,"_26298":110892,"_2652":110982},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3154":65551,"_27801":65518,"_19254":110984,"_5":13218,"_26298":110892,"_2652":110985},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3154":65552,"_27801":65518,"_19254":110987,"_5":13218,"_26298":110892,"_2652":110988},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3154":65553,"_27801":65518,"_19254":110990,"_5":13218,"_26298":110892,"_2652":110991},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3154":65554,"_27801":65518,"_19254":110993,"_5":13218,"_26298":110892,"_2652":110994},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3154":65555,"_27801":65518,"_19254":110996,"_5":13218,"_26298":110900,"_2652":110997},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3154":65556,"_27801":65518,"_19254":110999,"_5":13218,"_26298":110904,"_2652":111000},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3154":65557,"_27801":65518,"_19254":111002,"_5":13218,"_26298":110908,"_2652":111003},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3154":65558,"_27801":65518,"_19254":111005,"_5":13218,"_26298":110912,"_2652":111006},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3154":65559,"_27801":65518,"_19254":111008,"_5":13218,"_26298":110916,"_2652":111009},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3154":65560,"_27801":65518,"_19254":111011,"_5":13218,"_26298":110920,"_2652":111012},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3154":65561,"_27801":65518,"_19254":111014,"_5":13218,"_26298":110924,"_2652":110468},[],{"_3154":65562,"_27801":65518,"_19254":111016,"_5":13218,"_26298":110924,"_2652":111017},[],"Qué prepara o comprueba",{"_3154":65563,"_27801":65518,"_19254":111019,"_5":13218,"_26298":110924,"_2652":110471},[],{"_3154":65564,"_27801":65518,"_19254":111021,"_5":13218,"_26298":110924,"_2652":111022},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3154":65565,"_27801":65518,"_19254":111024,"_5":13218,"_26298":110924,"_2652":111025},[],"Administrador de la flota",{"_3154":65566,"_27801":65518,"_19254":111027,"_5":13218,"_26298":110924,"_2652":111028},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3154":65567,"_27801":65518,"_19254":111030,"_5":13218,"_26298":110924,"_2652":110483},[],{"_3154":65568,"_27801":65518,"_19254":111032,"_5":13218,"_26298":110924,"_2652":111033},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3154":65569,"_27801":65518,"_19254":111035,"_5":13218,"_26298":110924,"_2652":110489},[],{"_3154":65570,"_27801":65518,"_19254":111037,"_5":13218,"_26298":110924,"_2652":111038},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3154":65571,"_27801":65518,"_19254":111040,"_5":13218,"_26298":110924,"_2652":111041},[],"Operador de infraestructura",{"_3154":65572,"_27801":65518,"_19254":111043,"_5":13218,"_26298":110924,"_2652":111044},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3154":65573,"_27801":65518,"_19254":111046,"_5":13218,"_26298":110924,"_2652":111047},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3154":65574,"_27801":65574,"_5":13544,"_2652":111049,"_28144":111050,"_19254":111052,"_26298":65574},"Jerarquía y rotación de CAs",[45131,107460,50207,111051],"Claves, autoridades y certificados",[],{"_3154":65575,"_27801":65574,"_19254":111054,"_5":13218,"_26298":65574,"_2652":111055},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3154":65576,"_27801":65574,"_5":28141,"_19254":111057,"_26298":111058,"_2652":111059},[],"/docs/pr-preview/pr-53/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3154":65577,"_27801":65574,"_5":28141,"_19254":111061,"_26298":111062,"_2652":111063},[],"/docs/pr-preview/pr-53/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3154":65578,"_27801":65574,"_5":28141,"_19254":111065,"_26298":111066,"_2652":111067},[],"/docs/pr-preview/pr-53/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3154":65579,"_27801":65574,"_5":28141,"_19254":111069,"_26298":111070,"_2652":111071},[],"/docs/pr-preview/pr-53/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3154":65580,"_27801":65574,"_5":28141,"_19254":111073,"_26298":111074,"_2652":111075},[],"/docs/pr-preview/pr-53/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3154":65581,"_27801":65574,"_5":28141,"_19254":111077,"_26298":111078,"_2652":111079},[],"/docs/pr-preview/pr-53/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3154":65582,"_27801":65574,"_5":28141,"_19254":111081,"_26298":111082,"_2652":111083},[],"/docs/pr-preview/pr-53/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3154":65583,"_27801":65574,"_5":28141,"_19254":111085,"_26298":111086,"_2652":111087},[],"/docs/pr-preview/pr-53/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3154":65584,"_27801":65574,"_5":28141,"_19254":111089,"_26298":111090,"_2652":111091},[],"/docs/pr-preview/pr-53/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3154":65585,"_27801":65574,"_5":28141,"_19254":111093,"_26298":111094,"_2652":111095},[],"/docs/pr-preview/pr-53/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3154":65586,"_27801":65574,"_5":28141,"_19254":111097,"_26298":111098,"_2652":111099},[],"/docs/pr-preview/pr-53/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3154":65587,"_27801":65574,"_5":28141,"_19254":111101,"_26298":111102,"_2652":111103},[],"/docs/pr-preview/pr-53/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3154":65588,"_27801":65574,"_19254":111105,"_5":13218,"_26298":65574,"_2652":111106},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3154":65589,"_27801":65574,"_19254":111108,"_5":13218,"_26298":65574,"_2652":111109},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3154":65590,"_27801":65574,"_19254":111111,"_5":13218,"_26298":111058,"_2652":111112},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3154":65591,"_27801":65574,"_19254":111114,"_5":13218,"_26298":111058,"_2652":111115},[],"entorno, como producción y preproducción;",{"_3154":65592,"_27801":65574,"_19254":111117,"_5":13218,"_26298":111058,"_2652":111118},[],"propietario o equipo operador;",{"_3154":65593,"_27801":65574,"_19254":111120,"_5":13218,"_26298":111058,"_2652":111121},[],"familia de dispositivos o proceso de fabricación;",{"_3154":65594,"_27801":65574,"_19254":111123,"_5":13218,"_26298":111058,"_2652":111124},[],"región o requisito regulatorio;",{"_3154":65595,"_27801":65574,"_19254":111126,"_5":13218,"_26298":111058,"_2652":111127},[],"motor criptográfico o política de clave;",{"_3154":65596,"_27801":65574,"_19254":111129,"_5":13218,"_26298":111058,"_2652":111130},[],"ventana de mantenimiento y ritmo de renovación.",{"_3154":65597,"_27801":65574,"_19254":111132,"_5":13218,"_26298":111058,"_2652":111133},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3154":65598,"_27801":65574,"_19254":111135,"_5":13218,"_26298":111058,"_2652":111136},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3154":65599,"_27801":65574,"_19254":111138,"_5":13218,"_26298":111062,"_2652":111139},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3154":65600,"_27801":65574,"_19254":111141,"_5":13218,"_26298":111062,"_2652":111142},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3154":65601,"_27801":65574,"_19254":111144,"_5":13218,"_26298":111062,"_2652":111145},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_3154":65602,"_27801":65574,"_19254":111147,"_5":13218,"_26298":111066,"_2652":111148},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3154":65603,"_27801":65574,"_19254":111150,"_5":13218,"_26298":111066,"_2652":111151},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3154":65604,"_27801":65574,"_19254":111153,"_5":13218,"_26298":111066,"_2652":111154},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3154":65605,"_27801":65574,"_19254":111156,"_5":13218,"_26298":111066,"_2652":111157},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3154":65606,"_27801":65574,"_19254":111159,"_5":13218,"_26298":111074,"_2652":111160},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3154":65607,"_27801":65574,"_19254":111162,"_5":13218,"_26298":111078,"_2652":111163},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3154":65608,"_27801":65574,"_19254":111165,"_5":13218,"_26298":111082,"_2652":111166},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3154":65609,"_27801":65574,"_19254":111168,"_5":13218,"_26298":111086,"_2652":111169},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_3154":65610,"_27801":65574,"_19254":111171,"_5":13218,"_26298":111090,"_2652":111172},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3154":65611,"_27801":65574,"_19254":111174,"_5":13218,"_26298":111094,"_2652":111175},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_3154":65612,"_27801":65574,"_19254":111177,"_5":13218,"_26298":111098,"_2652":111178},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3154":65613,"_27801":65574,"_19254":111180,"_5":13218,"_26298":111098,"_2652":111181},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3154":65614,"_27801":65574,"_19254":111183,"_5":13218,"_26298":111098,"_2652":111184},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_3154":65615,"_27801":65574,"_19254":111186,"_5":13218,"_26298":111098,"_2652":111187},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3154":65616,"_27801":65574,"_19254":111189,"_5":13218,"_26298":111102,"_2652":111190},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3154":65617,"_27801":65574,"_19254":111192,"_5":13218,"_26298":111102,"_2652":111193},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3154":65618,"_27801":65574,"_19254":111195,"_5":13218,"_26298":111102,"_2652":111196},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3154":65619,"_27801":65574,"_19254":111198,"_5":13218,"_26298":111102,"_2652":111199},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3154":65620,"_27801":65574,"_19254":111201,"_5":13218,"_26298":111102,"_2652":111202},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3154":65621,"_27801":65574,"_19254":111204,"_5":13218,"_26298":111102,"_2652":111205},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3154":65622,"_27801":65574,"_19254":111207,"_5":13218,"_26298":111102,"_2652":111208},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3154":65623,"_27801":65623,"_5":13544,"_2652":111210,"_28144":111211,"_19254":111212,"_26298":65623},"Autoridades de certificación",[45131,107460,50207,111051],[],{"_3154":65624,"_27801":65623,"_19254":111214,"_5":13218,"_26298":65623,"_2652":111215},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3154":65625,"_27801":65623,"_5":28141,"_19254":111217,"_26298":111218,"_2652":111219},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3154":65626,"_27801":65623,"_5":28141,"_19254":111221,"_26298":111222,"_2652":111223},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3154":65627,"_27801":65623,"_5":28141,"_19254":111225,"_26298":111226,"_2652":106126},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3154":65628,"_27801":65623,"_5":28141,"_19254":111228,"_26298":111229,"_2652":111230},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3154":65629,"_27801":65623,"_5":28141,"_19254":111232,"_26298":111233,"_2652":111234},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3154":65630,"_27801":65623,"_5":28141,"_19254":111236,"_26298":111237,"_2652":111238},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3154":65631,"_27801":65623,"_5":28141,"_19254":111240,"_26298":111241,"_2652":111242},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3154":65632,"_27801":65623,"_5":28141,"_19254":111244,"_26298":111245,"_2652":111246},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3154":65633,"_27801":65623,"_5":28141,"_19254":111248,"_26298":111249,"_2652":111250},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3154":65634,"_27801":65623,"_5":28141,"_19254":111252,"_26298":111253,"_2652":111254},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3154":65635,"_27801":65623,"_5":28141,"_19254":111256,"_26298":111257,"_2652":111258},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3154":65636,"_27801":65623,"_5":28141,"_19254":111260,"_26298":111261,"_2652":111262},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3154":65637,"_27801":65623,"_5":28141,"_19254":111264,"_26298":111265,"_2652":111266},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3154":65638,"_27801":65623,"_5":28141,"_19254":111268,"_26298":111269,"_2652":111270},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3154":65639,"_27801":65623,"_5":28141,"_19254":111272,"_26298":111273,"_2652":111274},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3154":65640,"_27801":65623,"_5":28141,"_19254":111276,"_26298":111277,"_2652":111278},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3154":65641,"_27801":65623,"_5":28141,"_19254":111280,"_26298":111281,"_2652":111282},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3154":65642,"_27801":65623,"_5":28141,"_19254":111284,"_26298":111285,"_2652":111286},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3154":65643,"_27801":65623,"_5":28141,"_19254":111288,"_26298":111289,"_2652":111290},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3154":65644,"_27801":65623,"_5":28141,"_19254":111292,"_26298":111293,"_2652":111294},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3154":65645,"_27801":65623,"_5":28141,"_19254":111296,"_26298":111297,"_2652":111298},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3154":65646,"_27801":65623,"_5":28141,"_19254":111300,"_26298":111301,"_2652":111302},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3154":65647,"_27801":65623,"_19254":111304,"_5":13218,"_26298":65623,"_2652":111305},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3154":65648,"_27801":65623,"_19254":111307,"_5":13218,"_26298":65623,"_2652":111308},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3154":65649,"_27801":65623,"_19254":111310,"_5":13218,"_26298":65623,"_2652":111311},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3154":65650,"_27801":65623,"_19254":111313,"_5":13218,"_26298":111218,"_2652":111314},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3154":65651,"_27801":65623,"_19254":111316,"_5":13218,"_26298":111218,"_2652":111317},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3154":65652,"_27801":65623,"_19254":111319,"_5":13218,"_26298":111218,"_2652":111320},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3154":65653,"_27801":65623,"_19254":111322,"_5":13218,"_26298":111218,"_2652":111323},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3154":65654,"_27801":65623,"_19254":111325,"_5":13218,"_26298":111218,"_2652":111326},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3154":65655,"_27801":65623,"_19254":111328,"_5":13218,"_26298":111226,"_2652":111329},[],"Decide si la CA será raíz o intermedia.",{"_3154":65656,"_27801":65623,"_19254":111331,"_5":13218,"_26298":111226,"_2652":111332},[],"Elige el motor que custodiará la clave.",{"_3154":65657,"_27801":65623,"_19254":111334,"_5":13218,"_26298":111226,"_2652":111335},[],"Define una validez superior a la de los certificados que emitirá.",{"_3154":65658,"_27801":65623,"_19254":111337,"_5":13218,"_26298":111226,"_2652":111338},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3154":65659,"_27801":65623,"_19254":111340,"_5":13218,"_26298":111229,"_2652":111341},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3154":65660,"_27801":65623,"_19254":111343,"_5":13218,"_26298":111233,"_2652":111344},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3154":65661,"_27801":65623,"_19254":111346,"_5":13218,"_26298":111233,"_2652":111347},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3154":65662,"_27801":65623,"_19254":111349,"_5":13218,"_26298":111237,"_2652":111350},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3154":65663,"_27801":65623,"_19254":111352,"_5":13218,"_26298":111241,"_2652":111353},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3154":65664,"_27801":65623,"_19254":111355,"_5":13218,"_26298":111241,"_2652":111356},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3154":65665,"_27801":65623,"_19254":111358,"_5":13218,"_26298":111241,"_2652":111359},[],"`ST`: estado o provincia.",{"_3154":65666,"_27801":65623,"_19254":111361,"_5":13218,"_26298":111241,"_2652":111362},[],"`L`: localidad.",{"_3154":65667,"_27801":65623,"_19254":111364,"_5":13218,"_26298":111241,"_2652":111365},[],"`O`: organización.",{"_3154":65668,"_27801":65623,"_19254":111367,"_5":13218,"_26298":111241,"_2652":111368},[],"`OU`: unidad organizativa.",{"_3154":65669,"_27801":65623,"_19254":111370,"_5":13218,"_26298":111241,"_2652":111371},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3154":65670,"_27801":65623,"_19254":111373,"_5":13218,"_26298":111245,"_2652":111374},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3154":65671,"_27801":65623,"_19254":111376,"_5":13218,"_26298":111245,"_2652":111377},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3154":65672,"_27801":65623,"_19254":111379,"_5":13218,"_26298":111249,"_2652":111380},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3154":65673,"_27801":65623,"_19254":111382,"_5":13218,"_26298":111249,"_2652":111383},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3154":65674,"_27801":65623,"_19254":111385,"_5":13218,"_26298":111253,"_2652":111386},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3154":65675,"_27801":65623,"_19254":111388,"_5":13218,"_26298":111253,"_2652":111389},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3154":65676,"_27801":65623,"_19254":111391,"_5":13218,"_26298":111257,"_2652":111392},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3154":65677,"_27801":65623,"_19254":111394,"_5":13218,"_26298":111261,"_2652":111395},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3154":65678,"_27801":65623,"_19254":111397,"_5":13218,"_26298":111265,"_2652":111398},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3154":65679,"_27801":65623,"_19254":111400,"_5":13218,"_26298":111269,"_2652":111401},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3154":65680,"_27801":65623,"_19254":111403,"_5":13218,"_26298":111273,"_2652":111404},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3154":65681,"_27801":65623,"_19254":111406,"_5":13218,"_26298":111273,"_2652":111407},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3154":65682,"_27801":65623,"_19254":111409,"_5":13218,"_26298":111277,"_2652":111410},[],"Abre una CA desde el inventario para consultar:",{"_3154":65683,"_27801":65623,"_19254":111412,"_5":13218,"_26298":111277,"_2652":111413},[],"Estado y periodo de validez.",{"_3154":65684,"_27801":65623,"_19254":111415,"_5":13218,"_26298":111277,"_2652":111416},[],"Certificado y cadena en formato PEM.",{"_3154":65685,"_27801":65623,"_19254":111418,"_5":13218,"_26298":111277,"_2652":111419},[],"Número de certificados activos, expirados y revocados.",{"_3154":65686,"_27801":65623,"_19254":111421,"_5":13218,"_26298":111277,"_2652":111422},[],"Certificados emitidos en **Issued Certificates**.",{"_3154":65687,"_27801":65623,"_19254":111424,"_5":13218,"_26298":111277,"_2652":111425},[],"CRL vinculada a la autoridad.",{"_3154":65688,"_27801":65623,"_19254":111427,"_5":13218,"_26298":111277,"_2652":111428},[],"Metadatos y motor criptográfico asociado.",{"_3154":65689,"_27801":65623,"_19254":111430,"_5":13218,"_26298":111277,"_2652":111431},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3154":65690,"_27801":65623,"_19254":111433,"_5":13218,"_26298":111281,"_2652":111434},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3154":65691,"_27801":65623,"_19254":111436,"_5":13218,"_26298":111281,"_2652":111437},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3154":65692,"_27801":65623,"_19254":111439,"_5":13218,"_26298":111281,"_2652":111440},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3154":65693,"_27801":65623,"_19254":111442,"_5":13218,"_26298":111281,"_2652":111443},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3154":65694,"_27801":65623,"_19254":111445,"_5":13218,"_26298":111285,"_2652":111446},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_3154":65695,"_27801":65623,"_19254":111448,"_5":13218,"_26298":111289,"_2652":111449},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3154":65696,"_27801":65623,"_19254":111451,"_5":13218,"_26298":111293,"_2652":111452},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3154":65697,"_27801":65623,"_19254":111454,"_5":13218,"_26298":111297,"_2652":111455},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3154":65698,"_27801":65623,"_19254":111457,"_5":13218,"_26298":111301,"_2652":111458},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3154":65699,"_27801":65623,"_19254":111460,"_5":13218,"_26298":111301,"_2652":111461},[],"La eliminación permanente solo está disponible después de revocar. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3154":65700,"_27801":65700,"_5":13544,"_2652":111463,"_28144":111464,"_19254":111465,"_26298":65700},"Perfiles de certificado",[45131,107460,50207,111051],[],{"_3154":65701,"_27801":65700,"_19254":111467,"_5":13218,"_26298":65700,"_2652":111468},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3154":65702,"_27801":65700,"_5":28141,"_19254":111470,"_26298":111471,"_2652":111472},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3154":65703,"_27801":65700,"_5":28141,"_19254":111474,"_26298":111475,"_2652":111476},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-profiles#validez","Validez",{"_3154":65704,"_27801":65700,"_5":28141,"_19254":111478,"_26298":111479,"_2652":111480},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3154":65705,"_27801":65700,"_5":28141,"_19254":111482,"_26298":111483,"_2652":111484},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3154":65706,"_27801":65700,"_5":28141,"_19254":111486,"_26298":111487,"_2652":111488},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3154":65707,"_27801":65700,"_5":28141,"_19254":111490,"_26298":111491,"_2652":111492},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3154":65708,"_27801":65700,"_5":28141,"_19254":111494,"_26298":111495,"_2652":111496},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3154":65709,"_27801":65700,"_5":28141,"_19254":111498,"_26298":111499,"_2652":111500},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3154":65710,"_27801":65700,"_5":28141,"_19254":111502,"_26298":111503,"_2652":111504},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3154":65711,"_27801":65700,"_5":28141,"_19254":111506,"_26298":111507,"_2652":111508},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3154":65712,"_27801":65700,"_5":28141,"_19254":111510,"_26298":111511,"_2652":111512},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3154":65713,"_27801":65700,"_5":28141,"_19254":111514,"_26298":111515,"_2652":111516},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3154":65714,"_27801":65700,"_5":28141,"_19254":111518,"_26298":111519,"_2652":111520},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3154":65715,"_27801":65700,"_5":28141,"_19254":111522,"_26298":111523,"_2652":111524},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3154":65716,"_27801":65700,"_5":28141,"_19254":111526,"_26298":111527,"_2652":111528},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3154":65717,"_27801":65700,"_5":28141,"_19254":111530,"_26298":111531,"_2652":111532},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3154":65718,"_27801":65700,"_19254":111534,"_5":13218,"_26298":65700,"_2652":111535},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3154":65719,"_27801":65700,"_19254":111537,"_5":13218,"_26298":65700,"_2652":111538},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3154":65720,"_27801":65700,"_19254":111540,"_5":13218,"_26298":111475,"_2652":111541},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3154":65721,"_27801":65700,"_19254":111543,"_5":13218,"_26298":111475,"_2652":111544},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3154":65722,"_27801":65700,"_19254":111546,"_5":13218,"_26298":111479,"_2652":111547},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Actívalo solo en perfiles destinados a crear o reemitir CAs subordinadas.",{"_3154":65723,"_27801":65700,"_19254":111549,"_5":13218,"_26298":111483,"_2652":111550},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3154":65724,"_27801":65700,"_19254":111552,"_5":13218,"_26298":111483,"_2652":111553},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3154":65725,"_27801":65700,"_19254":111555,"_5":13218,"_26298":111483,"_2652":111556},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3154":65726,"_27801":65700,"_19254":111558,"_5":13218,"_26298":111487,"_2652":111559},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3154":65727,"_27801":65700,"_19254":111561,"_5":13218,"_26298":111491,"_2652":111562},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3154":65728,"_27801":65700,"_19254":111564,"_5":13218,"_26298":111491,"_2652":111565},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3154":65729,"_27801":65700,"_19254":111567,"_5":13218,"_26298":111495,"_2652":111568},[],"La aplicación criptográfica puede:",{"_3154":65730,"_27801":65700,"_19254":111570,"_5":13218,"_26298":111495,"_2652":111571},[],"permitir o bloquear claves RSA;",{"_3154":65731,"_27801":65700,"_19254":111573,"_5":13218,"_26298":111495,"_2652":111574},[],"limitar los tamaños RSA admitidos;",{"_3154":65732,"_27801":65700,"_19254":111576,"_5":13218,"_26298":111495,"_2652":111577},[],"permitir o bloquear claves ECDSA;",{"_3154":65733,"_27801":65700,"_19254":111579,"_5":13218,"_26298":111495,"_2652":111580},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3154":65734,"_27801":65700,"_19254":111582,"_5":13218,"_26298":111495,"_2652":111583},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3154":65735,"_27801":65700,"_19254":111585,"_5":13218,"_26298":111499,"_2652":111586},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3154":65736,"_27801":65700,"_19254":111588,"_5":13218,"_26298":111499,"_2652":107251},[],{"_3154":65737,"_27801":65700,"_19254":111590,"_5":13218,"_26298":111499,"_2652":111591},[],"Primera opción",{"_3154":65738,"_27801":65700,"_19254":111593,"_5":13218,"_26298":111499,"_2652":111594},[],"Segunda opción",{"_3154":65739,"_27801":65700,"_19254":111596,"_5":13218,"_26298":111499,"_2652":111597},[],"Si no hay ninguna",{"_3154":65740,"_27801":65700,"_19254":111599,"_5":13218,"_26298":111499,"_2652":111600},[],"Firma directa con una CA",{"_3154":65741,"_27801":65700,"_19254":111602,"_5":13218,"_26298":111499,"_2652":111603},[],"`issuance_profile` incluido en la solicitud",{"_3154":65742,"_27801":65700,"_19254":111605,"_5":13218,"_26298":111499,"_2652":111606},[],"`issuance_profile_id` de la solicitud",{"_3154":65743,"_27801":65700,"_19254":111608,"_5":13218,"_26298":111499,"_2652":111609},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3154":65744,"_27801":65700,"_19254":111611,"_5":13218,"_26298":111499,"_2652":111612},[],"Emisión mediante DMS",{"_3154":65745,"_27801":65700,"_19254":111614,"_5":13218,"_26298":111499,"_2652":50772},[],{"_3154":65746,"_27801":65700,"_19254":111616,"_5":13218,"_26298":111499,"_2652":111617},[],"`settings.issuance_profile` incluido en el DMS",{"_3154":65747,"_27801":65700,"_19254":111619,"_5":13218,"_26298":111499,"_2652":111620},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3154":65748,"_27801":65700,"_19254":111622,"_5":13218,"_26298":111499,"_2652":111623},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3154":65749,"_27801":65700,"_19254":111625,"_5":13218,"_26298":111499,"_2652":111626},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3154":65750,"_27801":65700,"_19254":111628,"_5":13218,"_26298":111507,"_2652":111629},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3154":65751,"_27801":65700,"_19254":111631,"_5":13218,"_26298":111511,"_2652":111632},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3154":65752,"_27801":65700,"_19254":111634,"_5":13218,"_26298":111515,"_2652":111635},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3154":65753,"_27801":65700,"_19254":111637,"_5":13218,"_26298":111519,"_2652":111638},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3154":65754,"_27801":65700,"_19254":111640,"_5":13218,"_26298":111523,"_2652":111641},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3154":65755,"_27801":65700,"_19254":111643,"_5":13218,"_26298":111523,"_2652":111644},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3154":65756,"_27801":65700,"_19254":111646,"_5":13218,"_26298":111527,"_2652":111647},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3154":65757,"_27801":65700,"_19254":111649,"_5":13218,"_26298":111527,"_2652":111650},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3154":65758,"_27801":65700,"_19254":111652,"_5":13218,"_26298":111527,"_2652":111653},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3154":65759,"_27801":65700,"_19254":111655,"_5":13218,"_26298":111527,"_2652":111656},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3154":65760,"_27801":65700,"_19254":111658,"_5":13218,"_26298":111531,"_2652":111659},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3154":65761,"_27801":65700,"_19254":111661,"_5":13218,"_26298":111531,"_2652":111662},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3154":65762,"_27801":65762,"_5":13544,"_2652":111664,"_28144":111665,"_19254":111667,"_26298":65762},"Validación de certificados",[45131,107460,50207,111666],"Validación",[],{"_3154":65763,"_27801":65762,"_19254":111669,"_5":13218,"_26298":65762,"_2652":111670},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3154":65764,"_27801":65762,"_5":28141,"_19254":111672,"_26298":111673,"_2652":111674},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3154":65765,"_27801":65762,"_5":28141,"_19254":111676,"_26298":111677,"_2652":111678},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3154":65766,"_27801":65762,"_5":28141,"_19254":111680,"_26298":111681,"_2652":111682},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3154":65767,"_27801":65762,"_19254":111684,"_5":13218,"_26298":65762,"_2652":111685},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3154":65768,"_27801":65762,"_19254":111687,"_5":13218,"_26298":111673,"_2652":111688},[],"Verifica estos criterios juntos:",{"_3154":65769,"_27801":65762,"_19254":111690,"_5":13218,"_26298":111673,"_2652":110678},[],{"_3154":65770,"_27801":65762,"_19254":111692,"_5":13218,"_26298":111673,"_2652":111693},[],"Resultado necesario",{"_3154":65771,"_27801":65762,"_19254":111695,"_5":13218,"_26298":111673,"_2652":111696},[],"Cadena y firma",{"_3154":65772,"_27801":65762,"_19254":111698,"_5":13218,"_26298":111673,"_2652":111699},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3154":65773,"_27801":65762,"_19254":111701,"_5":13218,"_26298":111673,"_2652":111702},[],"Fechas",{"_3154":65774,"_27801":65762,"_19254":111704,"_5":13218,"_26298":111673,"_2652":111705},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3154":65775,"_27801":65762,"_19254":111707,"_5":13218,"_26298":111673,"_2652":107161},[],{"_3154":65776,"_27801":65762,"_19254":111709,"_5":13218,"_26298":111673,"_2652":111710},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3154":65777,"_27801":65762,"_19254":111712,"_5":13218,"_26298":111673,"_2652":111713},[],"Uso",{"_3154":65778,"_27801":65762,"_19254":111715,"_5":13218,"_26298":111673,"_2652":111716},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3154":65779,"_27801":65762,"_19254":111718,"_5":13218,"_26298":111673,"_2652":111719},[],"Revocación",{"_3154":65780,"_27801":65762,"_19254":111721,"_5":13218,"_26298":111673,"_2652":111722},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3154":65781,"_27801":65762,"_19254":111724,"_5":13218,"_26298":111673,"_2652":111725},[],"Autorización",{"_3154":65782,"_27801":65762,"_19254":111727,"_5":13218,"_26298":111673,"_2652":111728},[],"La aplicación permite la acción a esa identidad.",{"_3154":65783,"_27801":65762,"_19254":111730,"_5":13218,"_26298":111673,"_2652":111731},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3154":65784,"_27801":65762,"_19254":111733,"_5":13218,"_26298":111677,"_2652":111734},[],"Mecanismo",{"_3154":65785,"_27801":65762,"_19254":111736,"_5":13218,"_26298":111677,"_2652":111737},[],"Cuándo utilizarlo",{"_3154":65786,"_27801":65762,"_19254":111739,"_5":13218,"_26298":111677,"_2652":111740},[],"Qué debes mantener",{"_3154":65787,"_27801":65762,"_19254":111742,"_5":13218,"_26298":111677,"_2652":50900},[],{"_3154":65788,"_27801":65762,"_19254":111744,"_5":13218,"_26298":111677,"_2652":111745},[],"Consulta del estado de un certificado concreto.",{"_3154":65789,"_27801":65762,"_19254":111747,"_5":13218,"_26298":111677,"_2652":111748},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3154":65790,"_27801":65762,"_19254":111750,"_5":13218,"_26298":111677,"_2652":50909},[],{"_3154":65791,"_27801":65762,"_19254":111752,"_5":13218,"_26298":111677,"_2652":111753},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3154":65792,"_27801":65762,"_19254":111755,"_5":13218,"_26298":111677,"_2652":111756},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3154":65793,"_27801":65762,"_19254":111758,"_5":13218,"_26298":111677,"_2652":111759},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3154":65794,"_27801":65762,"_19254":111761,"_5":13218,"_26298":111677,"_2652":111762},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3154":65795,"_27801":65762,"_19254":111764,"_5":13218,"_26298":111681,"_2652":111765},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3154":65796,"_27801":65762,"_19254":111767,"_5":13218,"_26298":111681,"_2652":111768},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3154":65797,"_27801":65762,"_19254":111770,"_5":13218,"_26298":111681,"_2652":111771},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3154":65798,"_27801":65762,"_19254":111773,"_5":13218,"_26298":111681,"_2652":111774},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3154":65799,"_27801":65762,"_19254":111776,"_5":13218,"_26298":111681,"_2652":111777},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3154":65800,"_27801":65762,"_19254":111779,"_5":13218,"_26298":111681,"_2652":111780},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3154":65801,"_27801":65762,"_19254":111782,"_5":13218,"_26298":111681,"_2652":111783},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3154":65802,"_27801":65762,"_19254":111785,"_5":13218,"_26298":111681,"_2652":111786},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3154":65803,"_27801":65762,"_19254":111788,"_5":13218,"_26298":111681,"_2652":111789},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3154":65804,"_27801":65804,"_5":13544,"_2652":111791,"_28144":111792,"_19254":111793,"_26298":65804},"Certificados",[45131,107460,50207,111051],[],{"_3154":65805,"_27801":65804,"_19254":111795,"_5":13218,"_26298":65804,"_2652":111796},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3154":65806,"_27801":65804,"_5":28141,"_19254":111798,"_26298":111799,"_2652":111800},[],"/docs/pr-preview/pr-53/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3154":65807,"_27801":65804,"_5":28141,"_19254":111802,"_26298":111803,"_2652":111804},[],"/docs/pr-preview/pr-53/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3154":65808,"_27801":65804,"_5":28141,"_19254":111806,"_26298":111807,"_2652":111808},[],"/docs/pr-preview/pr-53/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3154":65809,"_27801":65804,"_5":28141,"_19254":111810,"_26298":111811,"_2652":111812},[],"/docs/pr-preview/pr-53/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3154":65810,"_27801":65804,"_5":28141,"_19254":111814,"_26298":111815,"_2652":111816},[],"/docs/pr-preview/pr-53/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3154":65811,"_27801":65804,"_5":28141,"_19254":111818,"_26298":111819,"_2652":111820},[],"/docs/pr-preview/pr-53/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3154":65812,"_27801":65804,"_5":28141,"_19254":111822,"_26298":111823,"_2652":111824},[],"/docs/pr-preview/pr-53/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3154":65813,"_27801":65804,"_5":28141,"_19254":111826,"_26298":111827,"_2652":111828},[],"/docs/pr-preview/pr-53/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3154":65814,"_27801":65804,"_5":28141,"_19254":111830,"_26298":111831,"_2652":111832},[],"/docs/pr-preview/pr-53/es/platform/pki/certificates#continúa","Continúa",{"_3154":65815,"_27801":65804,"_19254":111834,"_5":13218,"_26298":65804,"_2652":111835},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3154":65816,"_27801":65804,"_19254":111837,"_5":13218,"_26298":111799,"_2652":111838},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Un certificado no contiene su clave privada, así que las superficies de clave privada responden qué certificados tienen su clave custodiada en el KMS de Lamassu:",{"_3154":65817,"_27801":65804,"_19254":111840,"_5":13218,"_26298":111799,"_2652":111841},[],"El filtro avanzado **Private Key**, disponible en la página Certificates y en la pestaña **Issued Certificates** de una CA, limita la lista a **All Certificates**, **With Private Key** o **Without Private Key**.",{"_3154":65818,"_27801":65804,"_19254":111843,"_5":13218,"_26298":111799,"_2652":111844},[],"La columna ordenable **Private Key** — visible por defecto y oculta en pantallas estrechas — marca con una marca de verificación verde la clave custodiada en el KMS y muestra `-` en los demás casos.",{"_3154":65819,"_27801":65804,"_19254":111846,"_5":13218,"_26298":111799,"_2652":111847},[],"En los detalles del certificado, la pestaña **Information** muestra una fila **Private Key** en la sección Key & Signature: cuando la clave está localizable en el KMS la fila muestra el identificador de la clave en el KMS como un enlace (tooltip: **Open private key in KMS**); en caso contrario, la insignia **Present** o **Not available**.",{"_3154":65820,"_27801":65804,"_19254":111849,"_5":13218,"_26298":111799,"_2652":111850},[],"Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_3154":65821,"_27801":65804,"_19254":111852,"_5":13218,"_26298":111799,"_2652":111853},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3154":65822,"_27801":65804,"_19254":111855,"_5":13218,"_26298":111803,"_2652":111856},[],"Descarga el PEM e inspecciónalo:",{"_3154":65823,"_27801":65804,"_19254":111858,"_5":13218,"_26298":111803,"_2652":111859},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3154":65824,"_27801":65804,"_19254":111861,"_5":13218,"_26298":111807,"_2652":111862},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3154":65825,"_27801":65804,"_19254":111864,"_5":13218,"_26298":111807,"_2652":111865},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3154":65826,"_27801":65804,"_19254":111867,"_5":13218,"_26298":111807,"_2652":111868},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3154":65827,"_27801":65804,"_19254":111870,"_5":13218,"_26298":111807,"_2652":111871},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3154":65828,"_27801":65804,"_19254":111873,"_5":13218,"_26298":111807,"_2652":111874},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3154":65829,"_27801":65804,"_19254":111876,"_5":13218,"_26298":111807,"_2652":111877},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3154":65830,"_27801":65804,"_19254":111879,"_5":13218,"_26298":111807,"_2652":111880},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3154":65831,"_27801":65804,"_19254":111882,"_5":13218,"_26298":111811,"_2652":111883},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3154":65832,"_27801":65804,"_19254":111885,"_5":13218,"_26298":111815,"_2652":111886},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3154":65833,"_27801":65804,"_19254":111888,"_5":13218,"_26298":111819,"_2652":111889},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3154":65834,"_27801":65804,"_19254":111891,"_5":13218,"_26298":111823,"_2652":111892},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3154":65835,"_27801":65804,"_19254":111894,"_5":13218,"_26298":111823,"_2652":111895},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3154":65836,"_27801":65804,"_19254":111897,"_5":13218,"_26298":111823,"_2652":111898},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3154":65837,"_27801":65804,"_19254":111900,"_5":13218,"_26298":111827,"_2652":111901},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3154":65838,"_27801":65804,"_19254":111903,"_5":13218,"_26298":111827,"_2652":111904},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3154":65839,"_27801":65804,"_19254":111906,"_5":13218,"_26298":111827,"_2652":111907},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_3154":65840,"_27801":65804,"_19254":111909,"_5":13218,"_26298":111831,"_2652":111910},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3154":65841,"_27801":65804,"_19254":111912,"_5":13218,"_26298":111831,"_2652":111913},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3154":65842,"_27801":65842,"_5":13544,"_2652":111915,"_28144":111916,"_19254":111918,"_26298":65842},"Ciclo de vida de un certificado",[45131,107460,50207,111917],"Conceptos",[],{"_3154":65843,"_27801":65842,"_19254":111920,"_5":13218,"_26298":65842,"_2652":111921},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3154":65844,"_27801":65842,"_5":28141,"_19254":111923,"_26298":111924,"_2652":111925},[],"/docs/pr-preview/pr-53/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3154":65845,"_27801":65842,"_5":28141,"_19254":111927,"_26298":111928,"_2652":111929},[],"/docs/pr-preview/pr-53/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3154":65846,"_27801":65842,"_5":28141,"_19254":111931,"_26298":111932,"_2652":111933},[],"/docs/pr-preview/pr-53/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3154":65847,"_27801":65842,"_5":28141,"_19254":111935,"_26298":111936,"_2652":111937},[],"/docs/pr-preview/pr-53/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3154":65848,"_27801":65842,"_5":28141,"_19254":111939,"_26298":111940,"_2652":111941},[],"/docs/pr-preview/pr-53/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3154":65849,"_27801":65842,"_5":28141,"_19254":111943,"_26298":111944,"_2652":111945},[],"/docs/pr-preview/pr-53/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3154":65850,"_27801":65842,"_5":28141,"_19254":111947,"_26298":111948,"_2652":111949},[],"/docs/pr-preview/pr-53/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado","Estados del certificado",{"_3154":65851,"_27801":65842,"_5":28141,"_19254":111951,"_26298":111952,"_2652":111953},[],"/docs/pr-preview/pr-53/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3154":65852,"_27801":65842,"_5":28141,"_19254":111955,"_26298":111956,"_2652":111957},[],"/docs/pr-preview/pr-53/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3154":65853,"_27801":65842,"_5":28141,"_19254":111959,"_26298":111960,"_2652":111961},[],"/docs/pr-preview/pr-53/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3154":65854,"_27801":65842,"_19254":111963,"_5":13218,"_26298":65842,"_2652":111964},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3154":65855,"_27801":65842,"_19254":111966,"_5":13218,"_26298":111928,"_2652":111967},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3154":65856,"_27801":65842,"_19254":111969,"_5":13218,"_26298":111932,"_2652":111970},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3154":65857,"_27801":65842,"_19254":111972,"_5":13218,"_26298":111936,"_2652":111973},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3154":65858,"_27801":65842,"_19254":111975,"_5":13218,"_26298":111940,"_2652":111976},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3154":65859,"_27801":65842,"_19254":111978,"_5":13218,"_26298":111944,"_2652":111979},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3154":65860,"_27801":65842,"_19254":111981,"_5":13218,"_26298":111948,"_2652":111982},[],"Lamassu persiste cuatro estados X.509:",{"_3154":65861,"_27801":65842,"_19254":111984,"_5":13218,"_26298":111948,"_2652":111985},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3154":65862,"_27801":65842,"_19254":111987,"_5":13218,"_26298":111948,"_2652":111988},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3154":65863,"_27801":65842,"_19254":111990,"_5":13218,"_26298":111948,"_2652":111991},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3154":65864,"_27801":65842,"_19254":111993,"_5":13218,"_26298":111948,"_2652":111994},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3154":65865,"_27801":65842,"_19254":111996,"_5":13218,"_26298":111948,"_2652":111997},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3154":65866,"_27801":65842,"_19254":111999,"_5":13218,"_26298":111952,"_2652":112000},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3154":65867,"_27801":65842,"_19254":112002,"_5":13218,"_26298":111952,"_2652":112003},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3154":65868,"_27801":65842,"_19254":112005,"_5":13218,"_26298":111952,"_2652":112006},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3154":65869,"_27801":65842,"_19254":112008,"_5":13218,"_26298":111956,"_2652":112009},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3154":65870,"_27801":65842,"_19254":112011,"_5":13218,"_26298":111956,"_2652":112012},[],"Antes de confirmar:",{"_3154":65871,"_27801":65842,"_19254":112014,"_5":13218,"_26298":111956,"_2652":112015},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3154":65872,"_27801":65842,"_19254":112017,"_5":13218,"_26298":111956,"_2652":112018},[],"Distribuye la nueva cadena de confianza.",{"_3154":65873,"_27801":65842,"_19254":112020,"_5":13218,"_26298":111956,"_2652":112021},[],"Reemite las identidades necesarias.",{"_3154":65874,"_27801":65842,"_19254":112023,"_5":13218,"_26298":111956,"_2652":112024},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3154":65875,"_27801":65842,"_19254":112026,"_5":13218,"_26298":111956,"_2652":112027},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3154":65876,"_27801":65842,"_19254":112029,"_5":13218,"_26298":111956,"_2652":112030},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3154":65877,"_27801":65842,"_19254":112032,"_5":13218,"_26298":111960,"_2652":112033},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3154":65878,"_27801":65842,"_19254":112035,"_5":13218,"_26298":111960,"_2652":112036},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3154":65879,"_27801":65842,"_19254":112038,"_5":13218,"_26298":111960,"_2652":112039},[],"Cambios de estado y razones de revocación.",{"_3154":65880,"_27801":65842,"_19254":112041,"_5":13218,"_26298":111960,"_2652":112042},[],"Publicación y vigencia de OCSP y CRLs.",{"_3154":65881,"_27801":65842,"_19254":112044,"_5":13218,"_26298":111960,"_2652":112045},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3154":65882,"_27801":65842,"_19254":112047,"_5":13218,"_26298":111960,"_2652":112048},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3154":65883,"_27801":65883,"_5":13544,"_2652":112050,"_28144":112051,"_19254":112052,"_26298":65883},"Modelo de confianza",[45131,107460,50207,111917],[],{"_3154":65884,"_27801":65883,"_19254":112054,"_5":13218,"_26298":65883,"_2652":112055},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3154":65885,"_27801":65883,"_5":28141,"_19254":112057,"_26298":112058,"_2652":112059},[],"/docs/pr-preview/pr-53/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3154":65886,"_27801":65883,"_5":28141,"_19254":112061,"_26298":112062,"_2652":112063},[],"/docs/pr-preview/pr-53/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3154":65887,"_27801":65883,"_5":28141,"_19254":112065,"_26298":112066,"_2652":112067},[],"/docs/pr-preview/pr-53/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3154":65888,"_27801":65883,"_5":28141,"_19254":112069,"_26298":112070,"_2652":112071},[],"/docs/pr-preview/pr-53/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3154":65889,"_27801":65883,"_5":28141,"_19254":112073,"_26298":112074,"_2652":112075},[],"/docs/pr-preview/pr-53/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3154":65890,"_27801":65883,"_5":28141,"_19254":112077,"_26298":112078,"_2652":112079},[],"/docs/pr-preview/pr-53/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3154":65891,"_27801":65883,"_5":28141,"_19254":112081,"_26298":112082,"_2652":112083},[],"/docs/pr-preview/pr-53/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3154":65892,"_27801":65883,"_5":28141,"_19254":112085,"_26298":112086,"_2652":112087},[],"/docs/pr-preview/pr-53/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3154":65893,"_27801":65883,"_5":28141,"_19254":112089,"_26298":112090,"_2652":112091},[],"/docs/pr-preview/pr-53/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3154":65894,"_27801":65883,"_5":28141,"_19254":112093,"_26298":112094,"_2652":112095},[],"/docs/pr-preview/pr-53/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3154":65895,"_27801":65883,"_19254":112097,"_5":13218,"_26298":65883,"_2652":112098},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3154":65896,"_27801":65883,"_19254":112100,"_5":13218,"_26298":112062,"_2652":112101},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3154":65897,"_27801":65883,"_19254":112103,"_5":13218,"_26298":112066,"_2652":112104},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3154":65898,"_27801":65883,"_19254":112106,"_5":13218,"_26298":112070,"_2652":112107},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3154":65899,"_27801":65883,"_19254":112109,"_5":13218,"_26298":112074,"_2652":112110},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3154":65900,"_27801":65883,"_19254":112112,"_5":13218,"_26298":112078,"_2652":112113},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3154":65901,"_27801":65883,"_19254":112115,"_5":13218,"_26298":112078,"_2652":112116},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3154":65902,"_27801":65883,"_19254":112118,"_5":13218,"_26298":112078,"_2652":112119},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3154":65903,"_27801":65883,"_19254":112121,"_5":13218,"_26298":112078,"_2652":112122},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3154":65904,"_27801":65883,"_19254":112124,"_5":13218,"_26298":112078,"_2652":112125},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3154":65905,"_27801":65883,"_19254":112127,"_5":13218,"_26298":112078,"_2652":112128},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3154":65906,"_27801":65883,"_19254":112130,"_5":13218,"_26298":112082,"_2652":112131},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3154":65907,"_27801":65883,"_19254":112133,"_5":13218,"_26298":112082,"_2652":112134},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3154":65908,"_27801":65883,"_19254":112136,"_5":13218,"_26298":112082,"_2652":112137},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_3154":65909,"_27801":65883,"_19254":112139,"_5":13218,"_26298":112082,"_2652":112140},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3154":65910,"_27801":65883,"_19254":112142,"_5":13218,"_26298":112082,"_2652":112143},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3154":65911,"_27801":65883,"_19254":112145,"_5":13218,"_26298":112086,"_2652":112146},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3154":65912,"_27801":65883,"_19254":112148,"_5":13218,"_26298":112086,"_2652":112149},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3154":65913,"_27801":65883,"_19254":112151,"_5":13218,"_26298":112086,"_2652":112152},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3154":65914,"_27801":65883,"_19254":112154,"_5":13218,"_26298":112086,"_2652":112155},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3154":65915,"_27801":65883,"_19254":112157,"_5":13218,"_26298":112086,"_2652":112158},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3154":65916,"_27801":65883,"_19254":112160,"_5":13218,"_26298":112086,"_2652":112161},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3154":65917,"_27801":65883,"_19254":112163,"_5":13218,"_26298":112086,"_2652":112164},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_3154":65918,"_27801":65883,"_19254":112166,"_5":13218,"_26298":112090,"_2652":112167},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3154":65919,"_27801":65883,"_19254":112169,"_5":13218,"_26298":112094,"_2652":112170},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3154":65920,"_27801":65883,"_19254":112172,"_5":13218,"_26298":112094,"_2652":112173},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3154":65921,"_27801":65883,"_19254":112175,"_5":13218,"_26298":112094,"_2652":112176},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3154":65922,"_27801":65883,"_19254":112178,"_5":13218,"_26298":112094,"_2652":112179},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3154":65923,"_27801":65883,"_19254":112181,"_5":13218,"_26298":112094,"_2652":112182},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3154":65924,"_27801":65883,"_19254":112184,"_5":13218,"_26298":112094,"_2652":112185},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3154":65925,"_27801":65883,"_19254":112187,"_5":13218,"_26298":112094,"_2652":112188},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3154":65926,"_27801":65926,"_5":13544,"_2652":112190,"_28144":112191,"_19254":112192,"_26298":65926},"Listas de revocación (CRL)",[45131,107460,50207,111666],[],{"_3154":65927,"_27801":65926,"_19254":112194,"_5":13218,"_26298":65926,"_2652":112195},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3154":65928,"_27801":65926,"_5":28141,"_19254":112197,"_26298":112198,"_2652":112199},[],"/docs/pr-preview/pr-53/es/platform/pki/crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_3154":65929,"_27801":65926,"_5":28141,"_19254":112201,"_26298":112202,"_2652":112203},[],"/docs/pr-preview/pr-53/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3154":65930,"_27801":65926,"_5":28141,"_19254":112205,"_26298":112206,"_2652":112207},[],"/docs/pr-preview/pr-53/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3154":65931,"_27801":65926,"_5":28141,"_19254":112209,"_26298":112210,"_2652":112211},[],"/docs/pr-preview/pr-53/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3154":65932,"_27801":65926,"_5":28141,"_19254":112213,"_26298":112214,"_2652":112215},[],"/docs/pr-preview/pr-53/es/platform/pki/crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_3154":65933,"_27801":65926,"_5":28141,"_19254":112217,"_26298":112218,"_2652":112219},[],"/docs/pr-preview/pr-53/es/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_3154":65934,"_27801":65926,"_5":28141,"_19254":112221,"_26298":112222,"_2652":112223},[],"/docs/pr-preview/pr-53/es/platform/pki/crl#referencias","Referencias",{"_3154":65935,"_27801":65926,"_19254":112225,"_5":13218,"_26298":65926,"_2652":112226},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su SKI y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3154":65936,"_27801":65926,"_19254":112228,"_5":13218,"_26298":112198,"_2652":112229},[],"El rol VA guarda la configuración y los metadatos de la última lista publicada para el SKI de una CA. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3154":65937,"_27801":65926,"_19254":112231,"_5":13218,"_26298":112198,"_2652":112232},[],"Campo de `crl_options`",{"_3154":65938,"_27801":65926,"_19254":112234,"_5":13218,"_26298":112198,"_2652":108959},[],{"_3154":65939,"_27801":65926,"_19254":112236,"_5":13218,"_26298":112198,"_2652":112237},[],"Valor inicial del backend",{"_3154":65940,"_27801":65926,"_19254":112239,"_5":13218,"_26298":112198,"_2652":51399},[],{"_3154":65941,"_27801":65926,"_19254":112241,"_5":13218,"_26298":112198,"_2652":112242},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3154":65942,"_27801":65926,"_19254":112244,"_5":13218,"_26298":112198,"_2652":112245},[],"7 días.",{"_3154":65943,"_27801":65926,"_19254":112247,"_5":13218,"_26298":112198,"_2652":51408},[],{"_3154":65944,"_27801":65926,"_19254":112249,"_5":13218,"_26298":112198,"_2652":112250},[],"Plazo desde la publicación que activa la renovación programada.",{"_3154":65945,"_27801":65926,"_19254":112252,"_5":13218,"_26298":112198,"_2652":112253},[],"6 días y 23 horas.",{"_3154":65946,"_27801":65926,"_19254":112255,"_5":13218,"_26298":112198,"_2652":51417},[],{"_3154":65947,"_27801":65926,"_19254":112257,"_5":13218,"_26298":112198,"_2652":112258},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3154":65948,"_27801":65926,"_19254":112260,"_5":13218,"_26298":112198,"_2652":51423},[],{"_3154":65949,"_27801":65926,"_19254":112262,"_5":13218,"_26298":112198,"_2652":51426},[],{"_3154":65950,"_27801":65926,"_19254":112264,"_5":13218,"_26298":112198,"_2652":112265},[],"Número de serie del certificado cuya clave firma la CRL.",{"_3154":65951,"_27801":65926,"_19254":112267,"_5":13218,"_26298":112198,"_2652":112268},[],"El certificado de la propia CA (campo sin asignar).",{"_3154":65952,"_27801":65926,"_19254":112270,"_5":13218,"_26298":112198,"_2652":112271},[],"El firmante es el certificado cuya clave firma la CRL. La consola envía `signer_certificate_serial_number` — el número de serie del certificado que seleccionas — y lee el valor guardado en la configuración del rol; cuando el campo no está asignado, el firmante predeterminado es el certificado de la propia CA. No interpretes un firmante distinto del predeterminado como soporte verificado de una CA delegada: el selector solo limita qué certificados pueden elegirse, y esta página no gestiona la delegación entre autoridades emisoras.",{"_3154":65953,"_27801":65926,"_19254":112273,"_5":13218,"_26298":112198,"_2652":112274},[],"`latest_crl` contiene versión, inicio y fin de validez. Las versiones se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/{subject_key_id}/{version}.crl`; el endpoint público entrega DER.",{"_3154":65954,"_27801":65926,"_19254":112276,"_5":13218,"_26298":112202,"_2652":112277},[],"El trabajo programado solicita otra lista cuando se alcanza `refresh_interval` o cuando la lista está próxima a vencer según el periodo de vigilancia configurado. Esto depende de que el trabajo, almacenamiento y firma funcionen; no garantiza renovación ante un fallo del servicio.",{"_3154":65955,"_27801":65926,"_19254":112279,"_5":13218,"_26298":112202,"_2652":112280},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3154":65956,"_27801":65926,"_19254":112282,"_5":13218,"_26298":112202,"_2652":112283},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3154":65957,"_27801":65926,"_19254":112285,"_5":13218,"_26298":112206,"_2652":112286},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3154":65958,"_27801":65926,"_19254":112288,"_5":13218,"_26298":112206,"_2652":112289},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3154":65959,"_27801":65926,"_19254":112291,"_5":13218,"_26298":112210,"_2652":112292},[],"El servicio VA expone `GET /crl/{subject_key_id}` sin autorización de gestión. Usa el SKI de la **CA emisora**, no el SKI del certificado final ni su número de serie. Inspecciona primero el CDP del certificado:",{"_3154":65960,"_27801":65926,"_19254":112294,"_5":13218,"_26298":112210,"_2652":112295},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3154":65961,"_27801":65926,"_19254":112297,"_5":13218,"_26298":112210,"_2652":112298},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3154":65962,"_27801":65926,"_19254":112300,"_5":13218,"_26298":112210,"_2652":112301},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3154":65963,"_27801":65926,"_19254":112303,"_5":13218,"_26298":112210,"_2652":112304},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3154":65964,"_27801":65926,"_19254":112306,"_5":13218,"_26298":112214,"_2652":112307},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3154":65965,"_27801":65926,"_19254":112309,"_5":13218,"_26298":112214,"_2652":109148},[],{"_3154":65966,"_27801":65926,"_19254":112311,"_5":13218,"_26298":112214,"_2652":112312},[],"Path relativo",{"_3154":65967,"_27801":65926,"_19254":112314,"_5":13218,"_26298":112214,"_2652":107251},[],{"_3154":65968,"_27801":65926,"_19254":112316,"_5":13218,"_26298":112214,"_2652":51481},[],{"_3154":65969,"_27801":65926,"_19254":112318,"_5":13218,"_26298":112214,"_2652":51484},[],{"_3154":65970,"_27801":65926,"_19254":112320,"_5":13218,"_26298":112214,"_2652":112321},[],"Consultar `crl_options` y `latest_crl`.",{"_3154":65971,"_27801":65926,"_19254":112323,"_5":13218,"_26298":112214,"_2652":51490},[],{"_3154":65972,"_27801":65926,"_19254":112325,"_5":13218,"_26298":112214,"_2652":51484},[],{"_3154":65973,"_27801":65926,"_19254":112327,"_5":13218,"_26298":112214,"_2652":112328},[],"Sustituir la configuración de CRL.",{"_3154":65974,"_27801":65926,"_19254":112330,"_5":13218,"_26298":112214,"_2652":112331},[],"Necesitas autenticación y permisos de lectura o actualización del rol. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato: el backend sustituye `crl_options`; no fusiona campos omitidos.",{"_3154":65975,"_27801":65926,"_19254":112333,"_5":13218,"_26298":112214,"_2652":112334},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar el rol no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3154":65976,"_27801":65926,"_19254":112336,"_5":13218,"_26298":112218,"_2652":112337},[],"La vista de la CA permite inspeccionar y descargar la lista disponible. Compara versión, emisor y tiempos con la copia descargada desde el endpoint público. Los ajustes VA de la CA también permiten seleccionar el firmante de la CRL: el selector de certificados solo ofrece certificados que tienen clave privada y el uso de clave `CRLSign`. Si el certificado de un firmante configurado no puede resolverse, la interfaz muestra `Unknown Certificate (Serial: X)` o `Certificate details unavailable (Serial: X)`. Para diagnosticar una diferencia, sigue Diagnóstico PKI.",{"_3154":65977,"_27801":65926,"_19254":112339,"_5":13218,"_26298":112222,"_2652":112340},[],"RFC 5280: perfil X.509 y CRL.",{"_3154":65978,"_27801":65926,"_19254":112342,"_5":13218,"_26298":112222,"_2652":51510},[],{"_3154":65979,"_27801":65926,"_19254":112344,"_5":13218,"_26298":112222,"_2652":51513},[],{"_3154":65980,"_27801":65926,"_19254":112346,"_5":13218,"_26298":112222,"_2652":112347},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3154":65981,"_27801":65926,"_19254":112349,"_5":13218,"_26298":112222,"_2652":112350},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3154":65982,"_27801":65982,"_5":13544,"_2652":112352,"_28144":112353,"_19254":112354,"_26298":65982},"Claves y motores criptográficos",[45131,107460,50207,111051],[],{"_3154":65983,"_27801":65982,"_19254":112356,"_5":13218,"_26298":65982,"_2652":112357},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3154":65984,"_27801":65982,"_5":28141,"_19254":112359,"_26298":112360,"_2652":112361},[],"/docs/pr-preview/pr-53/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3154":65985,"_27801":65982,"_5":28141,"_19254":112363,"_26298":112364,"_2652":112365},[],"/docs/pr-preview/pr-53/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3154":65986,"_27801":65982,"_5":28141,"_19254":112367,"_26298":112368,"_2652":51538},[],"/docs/pr-preview/pr-53/es/platform/pki/key-management#file-system",{"_3154":65987,"_27801":65982,"_5":28141,"_19254":112370,"_26298":112371,"_2652":51542},[],"/docs/pr-preview/pr-53/es/platform/pki/key-management#hashicorp-vault",{"_3154":65988,"_27801":65982,"_5":28141,"_19254":112373,"_26298":112374,"_2652":51546},[],"/docs/pr-preview/pr-53/es/platform/pki/key-management#aws-secrets-manager",{"_3154":65989,"_27801":65982,"_5":28141,"_19254":112376,"_26298":112377,"_2652":51550},[],"/docs/pr-preview/pr-53/es/platform/pki/key-management#aws-kms",{"_3154":65990,"_27801":65982,"_5":28141,"_19254":112379,"_26298":112380,"_2652":51554},[],"/docs/pr-preview/pr-53/es/platform/pki/key-management#pkcs11",{"_3154":65991,"_27801":65982,"_5":28141,"_19254":112382,"_26298":112383,"_2652":51558},[],"/docs/pr-preview/pr-53/es/platform/pki/key-management#azure-key-vault",{"_3154":65992,"_27801":65982,"_5":28141,"_19254":112385,"_26298":112386,"_2652":112387},[],"/docs/pr-preview/pr-53/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3154":65993,"_27801":65982,"_5":28141,"_19254":112389,"_26298":112390,"_2652":112391},[],"/docs/pr-preview/pr-53/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3154":65994,"_27801":65982,"_5":28141,"_19254":112393,"_26298":112394,"_2652":112395},[],"/docs/pr-preview/pr-53/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3154":65995,"_27801":65982,"_5":28141,"_19254":112397,"_26298":112398,"_2652":112399},[],"/docs/pr-preview/pr-53/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3154":65996,"_27801":65982,"_5":28141,"_19254":112401,"_26298":112402,"_2652":112403},[],"/docs/pr-preview/pr-53/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3154":65997,"_27801":65982,"_5":28141,"_19254":112405,"_26298":112406,"_2652":112407},[],"/docs/pr-preview/pr-53/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3154":65998,"_27801":65982,"_5":28141,"_19254":112409,"_26298":112410,"_2652":112411},[],"/docs/pr-preview/pr-53/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3154":65999,"_27801":65982,"_5":28141,"_19254":112413,"_26298":112414,"_2652":51590},[],"/docs/pr-preview/pr-53/es/platform/pki/key-management#sign",{"_3154":66000,"_27801":65982,"_5":28141,"_19254":112416,"_26298":112417,"_2652":51594},[],"/docs/pr-preview/pr-53/es/platform/pki/key-management#verify",{"_3154":66001,"_27801":65982,"_5":28141,"_19254":112419,"_26298":112420,"_2652":112421},[],"/docs/pr-preview/pr-53/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3154":66002,"_27801":65982,"_5":28141,"_19254":112423,"_26298":112424,"_2652":112425},[],"/docs/pr-preview/pr-53/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3154":66003,"_27801":65982,"_5":28141,"_19254":112427,"_26298":112428,"_2652":112429},[],"/docs/pr-preview/pr-53/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3154":66004,"_27801":65982,"_19254":112431,"_5":13218,"_26298":65982,"_2652":112432},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3154":66005,"_27801":65982,"_19254":112434,"_5":13218,"_26298":65982,"_2652":112435},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3154":66006,"_27801":65982,"_19254":112437,"_5":13218,"_26298":112360,"_2652":112438},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3154":66007,"_27801":65982,"_19254":112440,"_5":13218,"_26298":112360,"_2652":112441},[],"En la práctica, permite:",{"_3154":66008,"_27801":65982,"_19254":112443,"_5":13218,"_26298":112360,"_2652":112444},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3154":66009,"_27801":65982,"_19254":112446,"_5":13218,"_26298":112360,"_2652":112447},[],"Importar claves creadas externamente.",{"_3154":66010,"_27801":65982,"_19254":112449,"_5":13218,"_26298":112360,"_2652":112450},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3154":66011,"_27801":65982,"_19254":112452,"_5":13218,"_26298":112360,"_2652":112453},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3154":66012,"_27801":65982,"_19254":112455,"_5":13218,"_26298":112364,"_2652":112456},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3154":66013,"_27801":65982,"_19254":112458,"_5":13218,"_26298":112364,"_2652":112459},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3154":66014,"_27801":65982,"_19254":112461,"_5":13218,"_26298":112364,"_2652":112462},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3154":66015,"_27801":65982,"_19254":112464,"_5":13218,"_26298":112368,"_2652":112465},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3154":66016,"_27801":65982,"_19254":112467,"_5":13218,"_26298":112371,"_2652":112468},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3154":66017,"_27801":65982,"_19254":112470,"_5":13218,"_26298":112374,"_2652":112471},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3154":66018,"_27801":65982,"_19254":112473,"_5":13218,"_26298":112377,"_2652":112474},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3154":66019,"_27801":65982,"_19254":112476,"_5":13218,"_26298":112380,"_2652":112477},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3154":66020,"_27801":65982,"_19254":112479,"_5":13218,"_26298":112383,"_2652":112480},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3154":66021,"_27801":65982,"_19254":112482,"_5":13218,"_26298":112383,"_2652":112483},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3154":66022,"_27801":65982,"_19254":112485,"_5":13218,"_26298":112383,"_2652":112486},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3154":66023,"_27801":65982,"_19254":112488,"_5":13218,"_26298":112383,"_2652":112489},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3154":66024,"_27801":65982,"_19254":112491,"_5":13218,"_26298":112386,"_2652":112492},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3154":66025,"_27801":65982,"_19254":112494,"_5":13218,"_26298":112386,"_2652":112495},[],"La tabla incluye los siguientes campos:",{"_3154":66026,"_27801":65982,"_19254":112497,"_5":13218,"_26298":112386,"_2652":112498},[],"**Name**: nombre descriptivo de la clave.",{"_3154":66027,"_27801":65982,"_19254":112500,"_5":13218,"_26298":112386,"_2652":112501},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3154":66028,"_27801":65982,"_19254":112503,"_5":13218,"_26298":112386,"_2652":112504},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3154":66029,"_27801":65982,"_19254":112506,"_5":13218,"_26298":112386,"_2652":112507},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3154":66030,"_27801":65982,"_19254":112509,"_5":13218,"_26298":112386,"_2652":112510},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3154":66031,"_27801":65982,"_19254":112512,"_5":13218,"_26298":112386,"_2652":112513},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3154":66032,"_27801":65982,"_19254":112515,"_5":13218,"_26298":112386,"_2652":112516},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3154":66033,"_27801":65982,"_19254":112518,"_5":13218,"_26298":112386,"_2652":112519},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3154":66034,"_27801":65982,"_19254":112521,"_5":13218,"_26298":112386,"_2652":112522},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3154":66035,"_27801":65982,"_19254":112524,"_5":13218,"_26298":112386,"_2652":112525},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3154":66036,"_27801":65982,"_19254":112527,"_5":13218,"_26298":112386,"_2652":112528},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3154":66037,"_27801":65982,"_19254":112530,"_5":13218,"_26298":112386,"_2652":112531},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3154":66038,"_27801":65982,"_19254":112533,"_5":13218,"_26298":112386,"_2652":112534},[],"**Delete Key** para eliminar la clave del sistema.",{"_3154":66039,"_27801":65982,"_19254":112536,"_5":13218,"_26298":112390,"_2652":112537},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3154":66040,"_27801":65982,"_19254":112539,"_5":13218,"_26298":112394,"_2652":112540},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3154":66041,"_27801":65982,"_19254":112542,"_5":13218,"_26298":112394,"_2652":112543},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3154":66042,"_27801":65982,"_19254":112545,"_5":13218,"_26298":112394,"_2652":112546},[],"**Key Name**: nombre único y descriptivo.",{"_3154":66043,"_27801":65982,"_19254":112548,"_5":13218,"_26298":112394,"_2652":112549},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3154":66044,"_27801":65982,"_19254":112551,"_5":13218,"_26298":112394,"_2652":112552},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3154":66045,"_27801":65982,"_19254":112554,"_5":13218,"_26298":112394,"_2652":112555},[],"**Tags**: metadatos para clasificar la clave.",{"_3154":66046,"_27801":65982,"_19254":112557,"_5":13218,"_26298":112394,"_2652":112558},[],"**Metadata**: información adicional para usos avanzados.",{"_3154":66047,"_27801":65982,"_19254":112560,"_5":13218,"_26298":112398,"_2652":112561},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3154":66048,"_27801":65982,"_19254":112563,"_5":13218,"_26298":112398,"_2652":112564},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3154":66049,"_27801":65982,"_19254":112566,"_5":13218,"_26298":112398,"_2652":112567},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3154":66050,"_27801":65982,"_19254":112569,"_5":13218,"_26298":112398,"_2652":112570},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3154":66051,"_27801":65982,"_19254":112572,"_5":13218,"_26298":112398,"_2652":112573},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3154":66052,"_27801":65982,"_19254":112575,"_5":13218,"_26298":112398,"_2652":112576},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3154":66053,"_27801":65982,"_19254":112578,"_5":13218,"_26298":112398,"_2652":112579},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3154":66054,"_27801":65982,"_19254":112581,"_5":13218,"_26298":112398,"_2652":112582},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3154":66055,"_27801":65982,"_19254":112584,"_5":13218,"_26298":112398,"_2652":112585},[],"**Metadata**: información adicional opcional.",{"_3154":66056,"_27801":65982,"_19254":112587,"_5":13218,"_26298":112398,"_2652":112588},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3154":66057,"_27801":65982,"_19254":112590,"_5":13218,"_26298":112398,"_2652":112591},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3154":66058,"_27801":65982,"_19254":112593,"_5":13218,"_26298":112402,"_2652":112594},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3154":66059,"_27801":65982,"_19254":112596,"_5":13218,"_26298":112406,"_2652":112597},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3154":66060,"_27801":65982,"_19254":112599,"_5":13218,"_26298":112406,"_2652":112600},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3154":66061,"_27801":65982,"_19254":112602,"_5":13218,"_26298":112406,"_2652":112603},[],"**Key Name**: nombre descriptivo.",{"_3154":66062,"_27801":65982,"_19254":112605,"_5":13218,"_26298":112406,"_2652":112606},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3154":66063,"_27801":65982,"_19254":112608,"_5":13218,"_26298":112406,"_2652":112609},[],"**Tags**: etiquetas asociadas.",{"_3154":66064,"_27801":65982,"_19254":112611,"_5":13218,"_26298":112406,"_2652":112612},[],"**Aliases**: nombres alternativos.",{"_3154":66065,"_27801":65982,"_19254":112614,"_5":13218,"_26298":112406,"_2652":112615},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3154":66066,"_27801":65982,"_19254":112617,"_5":13218,"_26298":112406,"_2652":112618},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3154":66067,"_27801":65982,"_19254":112620,"_5":13218,"_26298":112406,"_2652":112621},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3154":66068,"_27801":65982,"_19254":112623,"_5":13218,"_26298":112406,"_2652":112624},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3154":66069,"_27801":65982,"_19254":112626,"_5":13218,"_26298":112410,"_2652":112627},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3154":66070,"_27801":65982,"_19254":112629,"_5":13218,"_26298":112410,"_2652":112630},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3154":66071,"_27801":65982,"_19254":112632,"_5":13218,"_26298":112410,"_2652":112633},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3154":66072,"_27801":65982,"_19254":112635,"_5":13218,"_26298":112414,"_2652":112636},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3154":66073,"_27801":65982,"_19254":112638,"_5":13218,"_26298":112414,"_2652":112639},[],"Campos principales:",{"_3154":66074,"_27801":65982,"_19254":112641,"_5":13218,"_26298":112414,"_2652":112642},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3154":66075,"_27801":65982,"_19254":112644,"_5":13218,"_26298":112414,"_2652":112645},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3154":66076,"_27801":65982,"_19254":112647,"_5":13218,"_26298":112414,"_2652":112648},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3154":66077,"_27801":65982,"_19254":112650,"_5":13218,"_26298":112414,"_2652":112651},[],"**Message**: contenido que se va a firmar.",{"_3154":66078,"_27801":65982,"_19254":112653,"_5":13218,"_26298":112414,"_2652":112654},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3154":66079,"_27801":65982,"_19254":112656,"_5":13218,"_26298":112417,"_2652":112657},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3154":66080,"_27801":65982,"_19254":112659,"_5":13218,"_26298":112417,"_2652":112639},[],{"_3154":66081,"_27801":65982,"_19254":112661,"_5":13218,"_26298":112417,"_2652":112662},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3154":66082,"_27801":65982,"_19254":112664,"_5":13218,"_26298":112417,"_2652":112665},[],"**Message Type**: `Raw` o `Digest`.",{"_3154":66083,"_27801":65982,"_19254":112667,"_5":13218,"_26298":112417,"_2652":112668},[],"**Payload Encoding**: codificación del mensaje.",{"_3154":66084,"_27801":65982,"_19254":112670,"_5":13218,"_26298":112417,"_2652":112671},[],"**Message**: mensaje original o hash.",{"_3154":66085,"_27801":65982,"_19254":112673,"_5":13218,"_26298":112417,"_2652":112674},[],"**Signature**: firma que se desea comprobar.",{"_3154":66086,"_27801":65982,"_19254":112676,"_5":13218,"_26298":112417,"_2652":112677},[],"**Result**: indicador del resultado de la validación.",{"_3154":66087,"_27801":65982,"_19254":112679,"_5":13218,"_26298":112420,"_2652":112680},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3154":66088,"_27801":65982,"_19254":112682,"_5":13218,"_26298":112420,"_2652":112683},[],"Este flujo es útil para:",{"_3154":66089,"_27801":65982,"_19254":112685,"_5":13218,"_26298":112420,"_2652":112686},[],"Solicitar certificados a una CA externa.",{"_3154":66090,"_27801":65982,"_19254":112688,"_5":13218,"_26298":112420,"_2652":112689},[],"Renovar una identidad manteniendo la misma clave.",{"_3154":66091,"_27801":65982,"_19254":112691,"_5":13218,"_26298":112420,"_2652":112692},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3154":66092,"_27801":65982,"_19254":112694,"_5":13218,"_26298":112420,"_2652":112695},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3154":66093,"_27801":65982,"_19254":112697,"_5":13218,"_26298":112420,"_2652":112698},[],"**Organization (O)**: organización o empresa.",{"_3154":66094,"_27801":65982,"_19254":112700,"_5":13218,"_26298":112420,"_2652":112701},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3154":66095,"_27801":65982,"_19254":112703,"_5":13218,"_26298":112420,"_2652":112704},[],"**Country (C)**: código de país de dos letras.",{"_3154":66096,"_27801":65982,"_19254":112706,"_5":13218,"_26298":112420,"_2652":112707},[],"**State / Province (ST)**: estado o provincia.",{"_3154":66097,"_27801":65982,"_19254":112709,"_5":13218,"_26298":112420,"_2652":112710},[],"**Locality (L)**: ciudad o localidad.",{"_3154":66098,"_27801":65982,"_19254":112712,"_5":13218,"_26298":112420,"_2652":112713},[],"**Email Address**: correo de contacto.",{"_3154":66099,"_27801":65982,"_19254":112715,"_5":13218,"_26298":112420,"_2652":112716},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3154":66100,"_27801":65982,"_19254":112718,"_5":13218,"_26298":112420,"_2652":112719},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3154":66101,"_27801":65982,"_19254":112721,"_5":13218,"_26298":112424,"_2652":112722},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3154":66102,"_27801":65982,"_19254":112724,"_5":13218,"_26298":112424,"_2652":51902},[],{"_3154":66103,"_27801":65982,"_19254":112726,"_5":13218,"_26298":112428,"_2652":112727},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3154":66104,"_27801":66104,"_5":13544,"_2652":112729,"_28144":112730,"_19254":112731,"_26298":66104},"Validación online con OCSP",[45131,107460,50207,111666],[],{"_3154":66105,"_27801":66104,"_19254":112733,"_5":13218,"_26298":66104,"_2652":112734},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3154":66106,"_27801":66104,"_5":28141,"_19254":112736,"_26298":112737,"_2652":112738},[],"/docs/pr-preview/pr-53/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3154":66107,"_27801":66104,"_5":28141,"_19254":112740,"_26298":112741,"_2652":112742},[],"/docs/pr-preview/pr-53/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3154":66108,"_27801":66104,"_5":28141,"_19254":112744,"_26298":112745,"_2652":112746},[],"/docs/pr-preview/pr-53/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3154":66109,"_27801":66104,"_5":28141,"_19254":112748,"_26298":112749,"_2652":112750},[],"/docs/pr-preview/pr-53/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3154":66110,"_27801":66104,"_5":28141,"_19254":112752,"_26298":112753,"_2652":112754},[],"/docs/pr-preview/pr-53/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3154":66111,"_27801":66104,"_5":28141,"_19254":112756,"_26298":112757,"_2652":112223},[],"/docs/pr-preview/pr-53/es/platform/pki/ocsp#referencias",{"_3154":66112,"_27801":66104,"_19254":112759,"_5":13218,"_26298":66104,"_2652":112760},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3154":66113,"_27801":66104,"_19254":112762,"_5":13218,"_26298":112737,"_2652":112763},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3154":66114,"_27801":66104,"_19254":112765,"_5":13218,"_26298":112737,"_2652":112766},[],"Estado del registro",{"_3154":66115,"_27801":66104,"_19254":112768,"_5":13218,"_26298":112737,"_2652":112769},[],"Respuesta firmada",{"_3154":66116,"_27801":66104,"_19254":112771,"_5":13218,"_26298":112737,"_2652":49385},[],{"_3154":66117,"_27801":66104,"_19254":112773,"_5":13218,"_26298":112737,"_2652":51952},[],{"_3154":66118,"_27801":66104,"_19254":112775,"_5":13218,"_26298":112737,"_2652":49402},[],{"_3154":66119,"_27801":66104,"_19254":112777,"_5":13218,"_26298":112737,"_2652":112778},[],"`Revoked`, con razón y fecha de revocación.",{"_3154":66120,"_27801":66104,"_19254":112780,"_5":13218,"_26298":112737,"_2652":112781},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3154":66121,"_27801":66104,"_19254":112783,"_5":13218,"_26298":112737,"_2652":112784},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3154":66122,"_27801":66104,"_19254":112786,"_5":13218,"_26298":112737,"_2652":112787},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3154":66123,"_27801":66104,"_19254":112789,"_5":13218,"_26298":112737,"_2652":112790},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3154":66124,"_27801":66104,"_19254":112792,"_5":13218,"_26298":112737,"_2652":112793},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3154":66125,"_27801":66104,"_19254":112795,"_5":13218,"_26298":112741,"_2652":112796},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3154":66126,"_27801":66104,"_19254":112798,"_5":13218,"_26298":112741,"_2652":112799},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3154":66127,"_27801":66104,"_19254":112801,"_5":13218,"_26298":112745,"_2652":112802},[],"El servicio acepta:",{"_3154":66128,"_27801":66104,"_19254":112804,"_5":13218,"_26298":112745,"_2652":109148},[],{"_3154":66129,"_27801":66104,"_19254":112806,"_5":13218,"_26298":112745,"_2652":112807},[],"Ruta del servicio VA",{"_3154":66130,"_27801":66104,"_19254":112809,"_5":13218,"_26298":112745,"_2652":112810},[],"Formato",{"_3154":66131,"_27801":66104,"_19254":112812,"_5":13218,"_26298":112745,"_2652":51992},[],{"_3154":66132,"_27801":66104,"_19254":112814,"_5":13218,"_26298":112745,"_2652":51995},[],{"_3154":66133,"_27801":66104,"_19254":112816,"_5":13218,"_26298":112745,"_2652":112817},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3154":66134,"_27801":66104,"_19254":112819,"_5":13218,"_26298":112745,"_2652":51481},[],{"_3154":66135,"_27801":66104,"_19254":112821,"_5":13218,"_26298":112745,"_2652":52003},[],{"_3154":66136,"_27801":66104,"_19254":112823,"_5":13218,"_26298":112745,"_2652":112824},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3154":66137,"_27801":66104,"_19254":112826,"_5":13218,"_26298":112745,"_2652":112827},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3154":66138,"_27801":66104,"_19254":112829,"_5":13218,"_26298":112749,"_2652":112830},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3154":66139,"_27801":66104,"_19254":112832,"_5":13218,"_26298":112749,"_2652":112833},[],"Genera la solicitud:",{"_3154":66140,"_27801":66104,"_19254":112835,"_5":13218,"_26298":112749,"_2652":112836},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3154":66141,"_27801":66104,"_19254":112838,"_5":13218,"_26298":112749,"_2652":112839},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3154":66142,"_27801":66104,"_19254":112841,"_5":13218,"_26298":112749,"_2652":112842},[],"Verifica el DER recibido:",{"_3154":66143,"_27801":66104,"_19254":112844,"_5":13218,"_26298":112749,"_2652":112845},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3154":66144,"_27801":66104,"_19254":112847,"_5":13218,"_26298":112753,"_2652":112848},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3154":66145,"_27801":66104,"_19254":112850,"_5":13218,"_26298":112753,"_2652":112851},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3154":66146,"_27801":66104,"_19254":112853,"_5":13218,"_26298":112757,"_2652":52036},[],{"_3154":66147,"_27801":66104,"_19254":112855,"_5":13218,"_26298":112757,"_2652":52039},[],{"_3154":66148,"_27801":66104,"_19254":112857,"_5":13218,"_26298":112757,"_2652":112858},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3154":66149,"_27801":66104,"_19254":112860,"_5":13218,"_26298":112757,"_2652":112350},[],{"_3154":66150,"_27801":66150,"_5":13544,"_2652":50207,"_28144":112862,"_19254":112863,"_26298":66150},[45131,107460,50207],[],{"_3154":66151,"_27801":66150,"_19254":112865,"_5":13218,"_26298":66150,"_2652":112866},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3154":66152,"_27801":66150,"_5":28141,"_19254":112868,"_26298":112869,"_2652":110375},[],"/docs/pr-preview/pr-53/es/platform/pki/overview#empieza-aquí",{"_3154":66153,"_27801":66150,"_5":28141,"_19254":112871,"_26298":112872,"_2652":112873},[],"/docs/pr-preview/pr-53/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3154":66154,"_27801":66150,"_5":28141,"_19254":112875,"_26298":112876,"_2652":110897},[],"/docs/pr-preview/pr-53/es/platform/pki/overview#capacidades-principales",{"_3154":66155,"_27801":66150,"_5":28141,"_19254":112878,"_26298":112879,"_2652":110901},[],"/docs/pr-preview/pr-53/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3154":66156,"_27801":66150,"_5":28141,"_19254":112881,"_26298":112882,"_2652":110905},[],"/docs/pr-preview/pr-53/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3154":66157,"_27801":66150,"_5":28141,"_19254":112884,"_26298":112885,"_2652":110909},[],"/docs/pr-preview/pr-53/es/platform/pki/overview#emite-y-controla-certificados",{"_3154":66158,"_27801":66150,"_5":28141,"_19254":112887,"_26298":112888,"_2652":110917},[],"/docs/pr-preview/pr-53/es/platform/pki/overview#publica-el-estado-de-validación",{"_3154":66159,"_27801":66150,"_5":28141,"_19254":112890,"_26298":112891,"_2652":112892},[],"/docs/pr-preview/pr-53/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3154":66160,"_27801":66150,"_5":28141,"_19254":112894,"_26298":112895,"_2652":111832},[],"/docs/pr-preview/pr-53/es/platform/pki/overview#continúa",{"_3154":66161,"_27801":66150,"_19254":112897,"_5":13218,"_26298":66150,"_2652":112898},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3154":66162,"_27801":66150,"_19254":112900,"_5":13218,"_26298":112869,"_2652":112901},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3154":66163,"_27801":66150,"_19254":112903,"_5":13218,"_26298":112869,"_2652":112904},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3154":66164,"_27801":66150,"_19254":112906,"_5":13218,"_26298":112872,"_2652":112907},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3154":66165,"_27801":66150,"_19254":112909,"_5":13218,"_26298":112872,"_2652":112910},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3154":66166,"_27801":66150,"_19254":112912,"_5":13218,"_26298":112872,"_2652":112913},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3154":66167,"_27801":66150,"_19254":112915,"_5":13218,"_26298":112872,"_2652":112916},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3154":66168,"_27801":66150,"_19254":112918,"_5":13218,"_26298":112872,"_2652":112919},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3154":66169,"_27801":66150,"_19254":112921,"_5":13218,"_26298":112879,"_2652":112922},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3154":66170,"_27801":66150,"_19254":112924,"_5":13218,"_26298":112882,"_2652":112925},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3154":66171,"_27801":66150,"_19254":112927,"_5":13218,"_26298":112885,"_2652":112928},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3154":66172,"_27801":66150,"_19254":112930,"_5":13218,"_26298":112888,"_2652":112931},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3154":66173,"_27801":66150,"_19254":112933,"_5":13218,"_26298":112891,"_2652":112934},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3154":66174,"_27801":66150,"_19254":112936,"_5":13218,"_26298":112891,"_2652":112937},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3154":66175,"_27801":66150,"_19254":112939,"_5":13218,"_26298":112891,"_2652":112940},[],"su clave pública corresponda a la clave privada del cliente;",{"_3154":66176,"_27801":66150,"_19254":112942,"_5":13218,"_26298":112891,"_2652":112943},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3154":66177,"_27801":66150,"_19254":112945,"_5":13218,"_26298":112891,"_2652":112946},[],"sus fechas y usos permitan la operación;",{"_3154":66178,"_27801":66150,"_19254":112948,"_5":13218,"_26298":112891,"_2652":112949},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3154":66179,"_27801":66150,"_19254":112951,"_5":13218,"_26298":112891,"_2652":112952},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3154":66180,"_27801":66150,"_19254":112954,"_5":13218,"_26298":112895,"_2652":112955},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3154":66181,"_27801":66150,"_19254":112957,"_5":13218,"_26298":112895,"_2652":112958},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3154":66182,"_27801":66150,"_19254":112960,"_5":13218,"_26298":112895,"_2652":112961},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3154":66183,"_27801":66183,"_5":13544,"_2652":112963,"_28144":112964,"_19254":112965,"_26298":66183},"Crea tu primera CA",[45131,107460,50207,110499],[],{"_3154":66184,"_27801":66183,"_19254":112967,"_5":13218,"_26298":66183,"_2652":112968},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3154":66185,"_27801":66183,"_5":28141,"_19254":112970,"_26298":112971,"_2652":106126},[],"/docs/pr-preview/pr-53/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3154":66186,"_27801":66183,"_5":28141,"_19254":112973,"_26298":112974,"_2652":112975},[],"/docs/pr-preview/pr-53/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación","Abre el asistente de creación",{"_3154":66187,"_27801":66183,"_5":28141,"_19254":112977,"_26298":112978,"_2652":112979},[],"/docs/pr-preview/pr-53/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave","Selecciona la clave",{"_3154":66188,"_27801":66183,"_5":28141,"_19254":112981,"_26298":112982,"_2652":112983},[],"/docs/pr-preview/pr-53/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad","Define la autoridad",{"_3154":66189,"_27801":66183,"_5":28141,"_19254":112985,"_26298":112986,"_2652":112987},[],"/docs/pr-preview/pr-53/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca","Revisa y crea la CA",{"_3154":66190,"_27801":66183,"_5":28141,"_19254":112989,"_26298":112990,"_2652":112991},[],"/docs/pr-preview/pr-53/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado","Verifica el resultado",{"_3154":66191,"_27801":66183,"_5":28141,"_19254":112993,"_26298":112994,"_2652":112995},[],"/docs/pr-preview/pr-53/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3154":66192,"_27801":66183,"_5":28141,"_19254":112997,"_26298":112998,"_2652":110747},[],"/docs/pr-preview/pr-53/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3154":66193,"_27801":66183,"_5":28141,"_19254":113000,"_26298":113001,"_2652":106150},[],"/docs/pr-preview/pr-53/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3154":66194,"_27801":66183,"_19254":113003,"_5":13218,"_26298":66183,"_2652":113004},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3154":66195,"_27801":66183,"_19254":113006,"_5":13218,"_26298":112971,"_2652":113007},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3154":66196,"_27801":66183,"_19254":113009,"_5":13218,"_26298":112971,"_2652":113010},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3154":66197,"_27801":66183,"_19254":113012,"_5":13218,"_26298":112971,"_2652":113013},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3154":66198,"_27801":66183,"_19254":113015,"_5":13218,"_26298":112971,"_2652":113016},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3154":66199,"_27801":66183,"_19254":113018,"_5":13218,"_26298":112974,"_2652":113019},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_3154":66200,"_27801":66183,"_19254":113021,"_5":13218,"_26298":112974,"_2652":113022},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_3154":66201,"_27801":66183,"_19254":113024,"_5":13218,"_26298":112978,"_2652":113025},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_3154":66202,"_27801":66183,"_19254":113027,"_5":13218,"_26298":112978,"_2652":113028},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_3154":66203,"_27801":66183,"_19254":113030,"_5":13218,"_26298":112982,"_2652":113031},[],"Selecciona **Root CA** y completa:",{"_3154":66204,"_27801":66183,"_19254":113033,"_5":13218,"_26298":112982,"_2652":52218},[],{"_3154":66205,"_27801":66183,"_19254":113035,"_5":13218,"_26298":112982,"_2652":113036},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_3154":66206,"_27801":66183,"_19254":113038,"_5":13218,"_26298":112982,"_2652":113039},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_3154":66207,"_27801":66183,"_19254":113041,"_5":13218,"_26298":112982,"_2652":113042},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_3154":66208,"_27801":66183,"_19254":113044,"_5":13218,"_26298":112982,"_2652":113045},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_3154":66209,"_27801":66183,"_19254":113047,"_5":13218,"_26298":112986,"_2652":113048},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_3154":66210,"_27801":66183,"_19254":113050,"_5":13218,"_26298":112990,"_2652":113051},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_3154":66211,"_27801":66183,"_19254":113053,"_5":13218,"_26298":112990,"_2652":113054},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_3154":66212,"_27801":66183,"_19254":113056,"_5":13218,"_26298":112994,"_2652":113057},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3154":66213,"_27801":66183,"_19254":113059,"_5":13218,"_26298":112994,"_2652":113060},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3154":66214,"_27801":66183,"_19254":113062,"_5":13218,"_26298":112994,"_2652":113063},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3154":66215,"_27801":66183,"_19254":113065,"_5":13218,"_26298":112998,"_2652":113066},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3154":66216,"_27801":66183,"_19254":113068,"_5":13218,"_26298":112998,"_2652":113069},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3154":66217,"_27801":66183,"_19254":113071,"_5":13218,"_26298":112998,"_2652":113072},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3154":66218,"_27801":66183,"_19254":113074,"_5":13218,"_26298":112998,"_2652":113075},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3154":66219,"_27801":66183,"_19254":113077,"_5":13218,"_26298":113001,"_2652":113078},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3154":66220,"_27801":66220,"_5":13544,"_2652":113080,"_28144":113081,"_19254":113082,"_26298":66220},"Emite y verifica un certificado",[45131,107460,50207,110499],[],{"_3154":66221,"_27801":66220,"_19254":113084,"_5":13218,"_26298":66220,"_2652":113085},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3154":66222,"_27801":66220,"_5":28141,"_19254":113087,"_26298":113088,"_2652":106126},[],"/docs/pr-preview/pr-53/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3154":66223,"_27801":66220,"_5":28141,"_19254":113090,"_26298":113091,"_2652":113092},[],"/docs/pr-preview/pr-53/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3154":66224,"_27801":66220,"_5":28141,"_19254":113094,"_26298":113095,"_2652":113096},[],"/docs/pr-preview/pr-53/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3154":66225,"_27801":66220,"_5":28141,"_19254":113098,"_26298":113099,"_2652":113100},[],"/docs/pr-preview/pr-53/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3154":66226,"_27801":66220,"_5":28141,"_19254":113102,"_26298":113103,"_2652":113104},[],"/docs/pr-preview/pr-53/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3154":66227,"_27801":66220,"_5":28141,"_19254":113106,"_26298":113107,"_2652":113108},[],"/docs/pr-preview/pr-53/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3154":66228,"_27801":66220,"_5":28141,"_19254":113110,"_26298":113111,"_2652":112991},[],"/docs/pr-preview/pr-53/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado",{"_3154":66229,"_27801":66220,"_5":28141,"_19254":113113,"_26298":113114,"_2652":113115},[],"/docs/pr-preview/pr-53/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3154":66230,"_27801":66220,"_5":28141,"_19254":113117,"_26298":113118,"_2652":113119},[],"/docs/pr-preview/pr-53/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3154":66231,"_27801":66220,"_5":28141,"_19254":113121,"_26298":113122,"_2652":113123},[],"/docs/pr-preview/pr-53/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3154":66232,"_27801":66220,"_5":28141,"_19254":113125,"_26298":113126,"_2652":110747},[],"/docs/pr-preview/pr-53/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3154":66233,"_27801":66220,"_5":28141,"_19254":113128,"_26298":113129,"_2652":106150},[],"/docs/pr-preview/pr-53/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3154":66234,"_27801":66220,"_19254":113131,"_5":13218,"_26298":66220,"_2652":113132},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3154":66235,"_27801":66220,"_19254":113134,"_5":13218,"_26298":113088,"_2652":113135},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3154":66236,"_27801":66220,"_19254":113137,"_5":13218,"_26298":113088,"_2652":113138},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3154":66237,"_27801":66220,"_19254":113140,"_5":13218,"_26298":113088,"_2652":113141},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3154":66238,"_27801":66220,"_19254":113143,"_5":13218,"_26298":113088,"_2652":113144},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3154":66239,"_27801":66220,"_19254":113146,"_5":13218,"_26298":113088,"_2652":113147},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3154":66240,"_27801":66220,"_19254":113149,"_5":13218,"_26298":113091,"_2652":113150},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3154":66241,"_27801":66220,"_19254":113152,"_5":13218,"_26298":113095,"_2652":113153},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3154":66242,"_27801":66220,"_19254":113155,"_5":13218,"_26298":113095,"_2652":113156},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3154":66243,"_27801":66220,"_19254":113158,"_5":13218,"_26298":113099,"_2652":113159},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3154":66244,"_27801":66220,"_19254":113161,"_5":13218,"_26298":113099,"_2652":113162},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3154":66245,"_27801":66220,"_19254":113164,"_5":13218,"_26298":113103,"_2652":113165},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3154":66246,"_27801":66220,"_19254":113167,"_5":13218,"_26298":113103,"_2652":113168},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3154":66247,"_27801":66220,"_19254":113170,"_5":13218,"_26298":113107,"_2652":113171},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3154":66248,"_27801":66220,"_19254":113173,"_5":13218,"_26298":113111,"_2652":113174},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3154":66249,"_27801":66220,"_19254":113176,"_5":13218,"_26298":113114,"_2652":113177},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3154":66250,"_27801":66220,"_19254":113179,"_5":13218,"_26298":113118,"_2652":113180},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3154":66251,"_27801":66220,"_19254":113182,"_5":13218,"_26298":113118,"_2652":113183},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3154":66252,"_27801":66220,"_19254":113185,"_5":13218,"_26298":113118,"_2652":113186},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3154":66253,"_27801":66220,"_19254":113188,"_5":13218,"_26298":113122,"_2652":113189},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3154":66254,"_27801":66220,"_19254":113191,"_5":13218,"_26298":113122,"_2652":113192},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3154":66255,"_27801":66220,"_19254":113194,"_5":13218,"_26298":113122,"_2652":113195},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3154":66256,"_27801":66220,"_19254":113197,"_5":13218,"_26298":113126,"_2652":110830},[],{"_3154":66257,"_27801":66220,"_19254":113199,"_5":13218,"_26298":113126,"_2652":109597},[],{"_3154":66258,"_27801":66220,"_19254":113201,"_5":13218,"_26298":113126,"_2652":113202},[],"La CA rechaza la emisión",{"_3154":66259,"_27801":66220,"_19254":113204,"_5":13218,"_26298":113126,"_2652":113205},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3154":66260,"_27801":66220,"_19254":113207,"_5":13218,"_26298":113126,"_2652":113208},[],"Sujeto o usos diferentes",{"_3154":66261,"_27801":66220,"_19254":113210,"_5":13218,"_26298":113126,"_2652":113211},[],"Perfil aplicado y valores solicitados.",{"_3154":66262,"_27801":66220,"_19254":113213,"_5":13218,"_26298":113126,"_2652":113214},[],"No se encuentra el emisor",{"_3154":66263,"_27801":66220,"_19254":113216,"_5":13218,"_26298":113126,"_2652":113217},[],"CA descargada y cadena intermedia necesaria.",{"_3154":66264,"_27801":66220,"_19254":113219,"_5":13218,"_26298":113126,"_2652":113220},[],"Falla la vigencia",{"_3154":66265,"_27801":66220,"_19254":113222,"_5":13218,"_26298":113126,"_2652":113223},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3154":66266,"_27801":66220,"_19254":113225,"_5":13218,"_26298":113126,"_2652":113226},[],"Los resúmenes de clave difieren",{"_3154":66267,"_27801":66220,"_19254":113228,"_5":13218,"_26298":113126,"_2652":113229},[],"Archivos de certificado y clave de la misma emisión.",{"_3154":66268,"_27801":66220,"_19254":113231,"_5":13218,"_26298":113126,"_2652":113232},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3154":66269,"_27801":66220,"_19254":113234,"_5":13218,"_26298":113129,"_2652":113235},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3154":66270,"_27801":66220,"_19254":113237,"_5":13218,"_26298":113129,"_2652":113238},[],"Gestionar certificados para inspección, estado y revocación.",{"_3154":66271,"_27801":66220,"_19254":113240,"_5":13218,"_26298":113129,"_2652":113241},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3154":66272,"_27801":66220,"_19254":113243,"_5":13218,"_26298":113129,"_2652":113244},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3154":66273,"_27801":66220,"_19254":113246,"_5":13218,"_26298":113129,"_2652":113247},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3154":66274,"_27801":66274,"_5":13544,"_2652":113249,"_28144":113250,"_19254":113251,"_26298":66274},"Primeros pasos de PKI",[45131,107460,50207,110499],[],{"_3154":66275,"_27801":66274,"_19254":113253,"_5":13218,"_26298":66274,"_2652":113254},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3154":66276,"_27801":66274,"_5":28141,"_19254":113256,"_26298":113257,"_2652":106126},[],"/docs/pr-preview/pr-53/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3154":66277,"_27801":66274,"_5":28141,"_19254":113259,"_26298":113260,"_2652":113261},[],"/docs/pr-preview/pr-53/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3154":66278,"_27801":66274,"_5":28141,"_19254":113263,"_26298":113264,"_2652":110681},[],"/docs/pr-preview/pr-53/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3154":66279,"_27801":66274,"_5":28141,"_19254":113266,"_26298":113267,"_2652":113268},[],"/docs/pr-preview/pr-53/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3154":66280,"_27801":66274,"_19254":113270,"_5":13218,"_26298":66274,"_2652":113271},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3154":66281,"_27801":66274,"_19254":113273,"_5":13218,"_26298":113257,"_2652":113274},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3154":66282,"_27801":66274,"_19254":113276,"_5":13218,"_26298":113257,"_2652":113277},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3154":66283,"_27801":66274,"_19254":113279,"_5":13218,"_26298":113257,"_2652":113280},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3154":66284,"_27801":66274,"_19254":113282,"_5":13218,"_26298":113257,"_2652":113283},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3154":66285,"_27801":66274,"_19254":113285,"_5":13218,"_26298":113257,"_2652":113286},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3154":66286,"_27801":66274,"_19254":113288,"_5":13218,"_26298":113260,"_2652":113289},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3154":66287,"_27801":66274,"_19254":113291,"_5":13218,"_26298":113260,"_2652":113292},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3154":66288,"_27801":66274,"_19254":113294,"_5":13218,"_26298":113260,"_2652":113295},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3154":66289,"_27801":66274,"_19254":113297,"_5":13218,"_26298":113260,"_2652":113298},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3154":66290,"_27801":66274,"_19254":113300,"_5":13218,"_26298":113264,"_2652":113301},[],"Archivo o recurso",{"_3154":66291,"_27801":66274,"_19254":113303,"_5":13218,"_26298":113264,"_2652":110678},[],{"_3154":66292,"_27801":66274,"_19254":113305,"_5":13218,"_26298":113264,"_2652":113306},[],"CA raíz activa y `ca.pem`",{"_3154":66293,"_27801":66274,"_19254":113308,"_5":13218,"_26298":113264,"_2652":113309},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3154":66294,"_27801":66274,"_19254":113311,"_5":13218,"_26298":113264,"_2652":113312},[],"Certificado final y `device.crt`",{"_3154":66295,"_27801":66274,"_19254":113314,"_5":13218,"_26298":113264,"_2652":113315},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3154":66296,"_27801":66274,"_19254":113317,"_5":13218,"_26298":113264,"_2652":113318},[],"Clave privada `device.key`",{"_3154":66297,"_27801":66274,"_19254":113320,"_5":13218,"_26298":113264,"_2652":113321},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3154":66298,"_27801":66274,"_19254":113323,"_5":13218,"_26298":113264,"_2652":113324},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3154":66299,"_27801":66274,"_19254":113326,"_5":13218,"_26298":113267,"_2652":113327},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3154":66300,"_27801":66274,"_19254":113329,"_5":13218,"_26298":113267,"_2652":113330},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3154":66301,"_27801":66274,"_19254":113332,"_5":13218,"_26298":113267,"_2652":113333},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3154":66302,"_27801":66302,"_5":13544,"_2652":113335,"_28144":113336,"_19254":113338,"_26298":66302},"Resolución de problemas PKI",[45131,107460,50207,113337],"Resolución de problemas",[],{"_3154":66303,"_27801":66302,"_19254":113340,"_5":13218,"_26298":66302,"_2652":113341},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3154":66304,"_27801":66302,"_5":28141,"_19254":113343,"_26298":113344,"_2652":113345},[],"/docs/pr-preview/pr-53/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3154":66305,"_27801":66302,"_5":28141,"_19254":113347,"_26298":113348,"_2652":113349},[],"/docs/pr-preview/pr-53/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3154":66306,"_27801":66302,"_5":28141,"_19254":113351,"_26298":113352,"_2652":113353},[],"/docs/pr-preview/pr-53/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3154":66307,"_27801":66302,"_19254":113355,"_5":13218,"_26298":66302,"_2652":113356},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3154":66308,"_27801":66302,"_19254":113358,"_5":13218,"_26298":66302,"_2652":113359},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3154":66309,"_27801":66302,"_19254":113361,"_5":13218,"_26298":113344,"_2652":110678},[],{"_3154":66310,"_27801":66302,"_19254":113363,"_5":13218,"_26298":113344,"_2652":109597},[],{"_3154":66311,"_27801":66302,"_19254":113365,"_5":13218,"_26298":113344,"_2652":106150},[],{"_3154":66312,"_27801":66302,"_19254":113367,"_5":13218,"_26298":113344,"_2652":52554},[],{"_3154":66313,"_27801":66302,"_19254":113369,"_5":13218,"_26298":113344,"_2652":113370},[],"Existe, está activa y sus fechas son utilizables.",{"_3154":66314,"_27801":66302,"_19254":113372,"_5":13218,"_26298":113344,"_2652":113373},[],"Autoridades.",{"_3154":66315,"_27801":66302,"_19254":113375,"_5":13218,"_26298":113344,"_2652":113376},[],"Clave",{"_3154":66316,"_27801":66302,"_19254":113378,"_5":13218,"_26298":113344,"_2652":113379},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3154":66317,"_27801":66302,"_19254":113381,"_5":13218,"_26298":113344,"_2652":113382},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3154":66318,"_27801":66302,"_19254":113384,"_5":13218,"_26298":113344,"_2652":52572},[],{"_3154":66319,"_27801":66302,"_19254":113386,"_5":13218,"_26298":113344,"_2652":113387},[],"PEM correcto y firma verificable.",{"_3154":66320,"_27801":66302,"_19254":113389,"_5":13218,"_26298":113344,"_2652":52578},[],{"_3154":66321,"_27801":66302,"_19254":113391,"_5":13218,"_26298":113344,"_2652":113392},[],"Perfil",{"_3154":66322,"_27801":66302,"_19254":113394,"_5":13218,"_26298":113344,"_2652":113395},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3154":66323,"_27801":66302,"_19254":113397,"_5":13218,"_26298":113344,"_2652":113398},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3154":66324,"_27801":66302,"_19254":113400,"_5":13218,"_26298":113344,"_2652":110830},[],{"_3154":66325,"_27801":66302,"_19254":113402,"_5":13218,"_26298":113344,"_2652":113403},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3154":66326,"_27801":66302,"_19254":113405,"_5":13218,"_26298":113344,"_2652":113406},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3154":66327,"_27801":66302,"_19254":113408,"_5":13218,"_26298":113344,"_2652":113409},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3154":66328,"_27801":66302,"_19254":113411,"_5":13218,"_26298":113344,"_2652":113412},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3154":66329,"_27801":66302,"_19254":113414,"_5":13218,"_26298":113348,"_2652":113415},[],"Revisa cada frontera por separado:",{"_3154":66330,"_27801":66302,"_19254":113417,"_5":13218,"_26298":113348,"_2652":113418},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3154":66331,"_27801":66302,"_19254":113420,"_5":13218,"_26298":113348,"_2652":113421},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3154":66332,"_27801":66302,"_19254":113423,"_5":13218,"_26298":113348,"_2652":113424},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3154":66333,"_27801":66302,"_19254":113426,"_5":13218,"_26298":113348,"_2652":113427},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3154":66334,"_27801":66302,"_19254":113429,"_5":13218,"_26298":113348,"_2652":113430},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3154":66335,"_27801":66302,"_19254":113432,"_5":13218,"_26298":113348,"_2652":113433},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_3154":66336,"_27801":66302,"_19254":113435,"_5":13218,"_26298":113352,"_2652":113436},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3154":66337,"_27801":66302,"_19254":113438,"_5":13218,"_26298":113352,"_2652":113439},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3154":66338,"_27801":66338,"_5":13544,"_2652":113441,"_28144":113442,"_19254":113444,"_26298":66338},"3.8.0 a 4.0.0",[45131,113443],"Actualizaciones",[],{"_3154":66339,"_27801":66338,"_19254":113446,"_5":13218,"_26298":66338,"_2652":113447},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3154":66340,"_27801":66338,"_5":28141,"_19254":113449,"_26298":113450,"_2652":113451},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_3154":66341,"_27801":66338,"_5":28141,"_19254":113453,"_26298":113454,"_2652":113455},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3154":66342,"_27801":66338,"_5":28141,"_19254":113457,"_26298":113458,"_2652":113459},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3154":66343,"_27801":66338,"_5":28141,"_19254":113461,"_26298":113462,"_2652":113463},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3154":66344,"_27801":66338,"_5":28141,"_19254":113465,"_26298":113466,"_2652":113467},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3154":66345,"_27801":66338,"_5":28141,"_19254":113469,"_26298":113470,"_2652":113471},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3154":66346,"_27801":66338,"_5":28141,"_19254":113473,"_26298":113474,"_2652":52664},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3154":66347,"_27801":66338,"_5":28141,"_19254":113476,"_26298":113477,"_2652":113478},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_3154":66348,"_27801":66338,"_5":28141,"_19254":113480,"_26298":113481,"_2652":113482},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3154":66349,"_27801":66338,"_5":28141,"_19254":113484,"_26298":113485,"_2652":113486},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3154":66350,"_27801":66338,"_5":28141,"_19254":113488,"_26298":113489,"_2652":113490},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3154":66351,"_27801":66338,"_5":28141,"_19254":113492,"_26298":113493,"_2652":113494},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3154":66352,"_27801":66338,"_5":28141,"_19254":113496,"_26298":113497,"_2652":113498},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3154":66353,"_27801":66338,"_5":28141,"_19254":113500,"_26298":113501,"_2652":113502},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3154":66354,"_27801":66338,"_5":28141,"_19254":113504,"_26298":113505,"_2652":113506},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3154":66355,"_27801":66338,"_5":28141,"_19254":113508,"_26298":113509,"_2652":113510},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_3154":66356,"_27801":66338,"_5":28141,"_19254":113512,"_26298":113513,"_2652":113514},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3154":66357,"_27801":66338,"_5":28141,"_19254":113516,"_26298":113517,"_2652":113518},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3154":66358,"_27801":66338,"_5":28141,"_19254":113520,"_26298":113521,"_2652":113522},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3154":66359,"_27801":66338,"_5":28141,"_19254":113524,"_26298":113525,"_2652":113526},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_3154":66360,"_27801":66338,"_5":28141,"_19254":113528,"_26298":113529,"_2652":113530},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3154":66361,"_27801":66338,"_5":28141,"_19254":113532,"_26298":113533,"_2652":113534},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3154":66362,"_27801":66338,"_5":28141,"_19254":113536,"_26298":113537,"_2652":113538},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3154":66363,"_27801":66338,"_5":28141,"_19254":113540,"_26298":113541,"_2652":113542},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3154":66364,"_27801":66338,"_5":28141,"_19254":113544,"_26298":113545,"_2652":113546},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3154":66365,"_27801":66338,"_5":28141,"_19254":113548,"_26298":113549,"_2652":113550},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3154":66366,"_27801":66338,"_5":28141,"_19254":113552,"_26298":113553,"_2652":113554},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3154":66367,"_27801":66338,"_5":28141,"_19254":113556,"_26298":113557,"_2652":113558},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3154":66368,"_27801":66338,"_5":28141,"_19254":113560,"_26298":113561,"_2652":113562},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3154":66369,"_27801":66338,"_5":28141,"_19254":113564,"_26298":113565,"_2652":113566},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3154":66370,"_27801":66338,"_5":28141,"_19254":113568,"_26298":113569,"_2652":113570},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3154":66371,"_27801":66338,"_5":28141,"_19254":113572,"_26298":113573,"_2652":113574},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3154":66372,"_27801":66338,"_5":28141,"_19254":113576,"_26298":113577,"_2652":113578},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3154":66373,"_27801":66338,"_5":28141,"_19254":113580,"_26298":113581,"_2652":109919},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3154":66374,"_27801":66338,"_5":28141,"_19254":113583,"_26298":113584,"_2652":113585},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3154":66375,"_27801":66338,"_5":28141,"_19254":113587,"_26298":113588,"_2652":113589},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3154":66376,"_27801":66338,"_19254":113591,"_5":13218,"_26298":66338,"_2652":113592},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3154":66377,"_27801":66338,"_19254":113594,"_5":13218,"_26298":66338,"_2652":113595},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3154":66378,"_27801":66338,"_19254":113597,"_5":13218,"_26298":66338,"_2652":113598},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_3154":66379,"_27801":66338,"_19254":113600,"_5":13218,"_26298":66338,"_2652":113601},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_3154":66380,"_27801":66338,"_19254":113603,"_5":13218,"_26298":66338,"_2652":113604},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3154":66381,"_27801":66338,"_19254":113606,"_5":13218,"_26298":66338,"_2652":113607},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3154":66382,"_27801":66338,"_19254":113609,"_5":13218,"_26298":66338,"_2652":113610},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3154":66383,"_27801":66338,"_19254":113612,"_5":13218,"_26298":113454,"_2652":113613},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3154":66384,"_27801":66338,"_19254":113615,"_5":13218,"_26298":113454,"_2652":113616},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_3154":66385,"_27801":66338,"_19254":113618,"_5":13218,"_26298":113458,"_2652":113619},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3154":66386,"_27801":66338,"_19254":113621,"_5":13218,"_26298":113458,"_2652":113622},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y roles de la VA. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3154":66387,"_27801":66338,"_19254":113624,"_5":13218,"_26298":113462,"_2652":113625},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera.",{"_3154":66388,"_27801":66338,"_19254":113627,"_5":13218,"_26298":113466,"_2652":113628},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3154":66389,"_27801":66338,"_19254":113630,"_5":13218,"_26298":113466,"_2652":113631},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3154":66390,"_27801":66338,"_19254":113633,"_5":13218,"_26298":113466,"_2652":113634},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_3154":66391,"_27801":66338,"_19254":113636,"_5":13218,"_26298":113466,"_2652":113637},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3154":66392,"_27801":66338,"_19254":113639,"_5":13218,"_26298":113466,"_2652":113640},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3154":66393,"_27801":66338,"_19254":113642,"_5":13218,"_26298":113470,"_2652":113643},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3154":66394,"_27801":66338,"_19254":113645,"_5":13218,"_26298":113470,"_2652":113646},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3154":66395,"_27801":66338,"_19254":113648,"_5":13218,"_26298":113470,"_2652":113649},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3154":66396,"_27801":66338,"_19254":113651,"_5":13218,"_26298":113470,"_2652":113652},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3154":66397,"_27801":66338,"_19254":113654,"_5":13218,"_26298":113470,"_2652":113655},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3154":66398,"_27801":66338,"_19254":113657,"_5":13218,"_26298":113474,"_2652":113658},[],"Cambio",{"_3154":66399,"_27801":66338,"_19254":113660,"_5":13218,"_26298":113474,"_2652":113661},[],"A quién afecta",{"_3154":66400,"_27801":66338,"_19254":113663,"_5":13218,"_26298":113474,"_2652":113664},[],"Gravedad",{"_3154":66401,"_27801":66338,"_19254":113666,"_5":13218,"_26298":113474,"_2652":113667},[],"Acción",{"_3154":66402,"_27801":66338,"_19254":113669,"_5":13218,"_26298":113474,"_2652":113482},[],{"_3154":66403,"_27801":66338,"_19254":113671,"_5":13218,"_26298":113474,"_2652":113672},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_3154":66404,"_27801":66338,"_19254":113674,"_5":13218,"_26298":113474,"_2652":113675},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_3154":66405,"_27801":66338,"_19254":113677,"_5":13218,"_26298":113474,"_2652":113678},[],"Copiar los datos a los volúmenes nuevos",{"_3154":66406,"_27801":66338,"_19254":113680,"_5":13218,"_26298":113474,"_2652":113486},[],{"_3154":66407,"_27801":66338,"_19254":113682,"_5":13218,"_26298":113474,"_2652":113683},[],"Todas las releases de Helm",{"_3154":66408,"_27801":66338,"_19254":113685,"_5":13218,"_26298":113474,"_2652":113686},[],"Alta: `helm upgrade` falla",{"_3154":66409,"_27801":66338,"_19254":113688,"_5":13218,"_26298":113474,"_2652":113689},[],"Eliminar o renombrar las claves heredadas",{"_3154":66410,"_27801":66338,"_19254":113691,"_5":13218,"_26298":113474,"_2652":113490},[],{"_3154":66411,"_27801":66338,"_19254":113693,"_5":13218,"_26298":113474,"_2652":113694},[],"Todos los despliegues",{"_3154":66412,"_27801":66338,"_19254":113696,"_5":13218,"_26298":113474,"_2652":113697},[],"Alta: sin principal de bootstrap no hay administrador",{"_3154":66413,"_27801":66338,"_19254":113699,"_5":13218,"_26298":113474,"_2652":113700},[],"Configurar `services.authz`",{"_3154":66414,"_27801":66338,"_19254":113702,"_5":13218,"_26298":113474,"_2652":113494},[],{"_3154":66415,"_27801":66338,"_19254":113704,"_5":13218,"_26298":113474,"_2652":113683},[],{"_3154":66416,"_27801":66338,"_19254":113706,"_5":13218,"_26298":113474,"_2652":113707},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_3154":66417,"_27801":66338,"_19254":113709,"_5":13218,"_26298":113474,"_2652":113710},[],"Mover JWKS y roles a `services.authz`",{"_3154":66418,"_27801":66338,"_19254":113712,"_5":13218,"_26298":113474,"_2652":113514},[],{"_3154":66419,"_27801":66338,"_19254":113714,"_5":13218,"_26298":113474,"_2652":113715},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_3154":66420,"_27801":66338,"_19254":113717,"_5":13218,"_26298":113474,"_2652":113718},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_3154":66421,"_27801":66338,"_19254":113720,"_5":13218,"_26298":113474,"_2652":113721},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_3154":66422,"_27801":66338,"_19254":113723,"_5":13218,"_26298":113474,"_2652":113518},[],{"_3154":66423,"_27801":66338,"_19254":113725,"_5":13218,"_26298":113474,"_2652":113726},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_3154":66424,"_27801":66338,"_19254":113728,"_5":13218,"_26298":113474,"_2652":113729},[],"Alta: el backend ya no arranca con ellos",{"_3154":66425,"_27801":66338,"_19254":113731,"_5":13218,"_26298":113474,"_2652":113732},[],"Pasar a PostgreSQL antes de actualizar",{"_3154":66426,"_27801":66338,"_19254":113734,"_5":13218,"_26298":113474,"_2652":113735},[],"Webhooks con referencias a archivos",{"_3154":66427,"_27801":66338,"_19254":113737,"_5":13218,"_26298":113474,"_2652":113738},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3154":66428,"_27801":66338,"_19254":113740,"_5":13218,"_26298":113474,"_2652":113741},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_3154":66429,"_27801":66338,"_19254":113743,"_5":13218,"_26298":113474,"_2652":113744},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3154":66430,"_27801":66338,"_19254":113746,"_5":13218,"_26298":113474,"_2652":113498},[],{"_3154":66431,"_27801":66338,"_19254":113748,"_5":13218,"_26298":113474,"_2652":113749},[],"Releases con identidades por servicio o material de claves montado",{"_3154":66432,"_27801":66338,"_19254":113751,"_5":13218,"_26298":113474,"_2652":113752},[],"Media: los servicios no pueden leer sus archivos",{"_3154":66433,"_27801":66338,"_19254":113754,"_5":13218,"_26298":113474,"_2652":113755},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_3154":66434,"_27801":66338,"_19254":113757,"_5":13218,"_26298":113474,"_2652":113502},[],{"_3154":66435,"_27801":66338,"_19254":113759,"_5":13218,"_26298":113474,"_2652":113760},[],"Releases que definen `amqp.tls`",{"_3154":66436,"_27801":66338,"_19254":113762,"_5":13218,"_26298":113474,"_2652":113763},[],"Media: los clientes se conectan al puerto equivocado",{"_3154":66437,"_27801":66338,"_19254":113765,"_5":13218,"_26298":113474,"_2652":113766},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_3154":66438,"_27801":66338,"_19254":113768,"_5":13218,"_26298":113474,"_2652":113522},[],{"_3154":66439,"_27801":66338,"_19254":113770,"_5":13218,"_26298":113474,"_2652":113771},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3154":66440,"_27801":66338,"_19254":113773,"_5":13218,"_26298":113474,"_2652":113774},[],"Media: las claves de CA quedan sin gestionar",{"_3154":66441,"_27801":66338,"_19254":113776,"_5":13218,"_26298":113474,"_2652":113777},[],"Ejecutar la migración de CA a KMS",{"_3154":66442,"_27801":66338,"_19254":113779,"_5":13218,"_26298":113474,"_2652":113780},[],"Verificación del certificado del receptor",{"_3154":66443,"_27801":66338,"_19254":113782,"_5":13218,"_26298":113474,"_2652":113783},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_3154":66444,"_27801":66338,"_19254":113785,"_5":13218,"_26298":113474,"_2652":113786},[],"Media: las credenciales viajan a un receptor sin verificar",{"_3154":66445,"_27801":66338,"_19254":113788,"_5":13218,"_26298":113474,"_2652":113789},[],"Poner `insecure_skip_verify` a `false`",{"_3154":66446,"_27801":66338,"_19254":113791,"_5":13218,"_26298":113474,"_2652":113534},[],{"_3154":66447,"_27801":66338,"_19254":113793,"_5":13218,"_26298":113474,"_2652":113794},[],"Scripts y consolas que editan DMS por API",{"_3154":66448,"_27801":66338,"_19254":113796,"_5":13218,"_26298":113474,"_2652":113797},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3154":66449,"_27801":66338,"_19254":113799,"_5":13218,"_26298":113474,"_2652":113800},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3154":66450,"_27801":66338,"_19254":113802,"_5":13218,"_26298":113474,"_2652":113550},[],{"_3154":66451,"_27801":66338,"_19254":113804,"_5":13218,"_26298":113474,"_2652":113805},[],"Consumidores que leen el campo `events` del dispositivo",{"_3154":66452,"_27801":66338,"_19254":113807,"_5":13218,"_26298":113474,"_2652":113808},[],"Media: el campo desaparece",{"_3154":66453,"_27801":66338,"_19254":113810,"_5":13218,"_26298":113474,"_2652":113811},[],"Usar los nuevos endpoints de eventos",{"_3154":66454,"_27801":66338,"_19254":113813,"_5":13218,"_26298":113474,"_2652":113506},[],{"_3154":66455,"_27801":66338,"_19254":113815,"_5":13218,"_26298":113474,"_2652":113816},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_3154":66456,"_27801":66338,"_19254":113818,"_5":13218,"_26298":113474,"_2652":113819},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_3154":66457,"_27801":66338,"_19254":113821,"_5":13218,"_26298":113474,"_2652":113822},[],"Actualizar el archivo de values",{"_3154":66458,"_27801":66338,"_19254":113824,"_5":13218,"_26298":113474,"_2652":113542},[],{"_3154":66459,"_27801":66338,"_19254":113826,"_5":13218,"_26298":113474,"_2652":113827},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3154":66460,"_27801":66338,"_19254":113829,"_5":13218,"_26298":113474,"_2652":113830},[],"Baja: prevalece el ID de la URL",{"_3154":66461,"_27801":66338,"_19254":113832,"_5":13218,"_26298":113474,"_2652":113833},[],"Enviar el ID en la URL",{"_3154":66462,"_27801":66338,"_19254":113835,"_5":13218,"_26298":113474,"_2652":113546},[],{"_3154":66463,"_27801":66338,"_19254":113837,"_5":13218,"_26298":113474,"_2652":113838},[],"Consumidores que comparan el `type` del certificado",{"_3154":66464,"_27801":66338,"_19254":113840,"_5":13218,"_26298":113474,"_2652":113841},[],"Baja: dos valores cambian de nombre",{"_3154":66465,"_27801":66338,"_19254":113843,"_5":13218,"_26298":113474,"_2652":113844},[],"Adaptar los consumidores",{"_3154":66466,"_27801":66338,"_19254":113846,"_5":13218,"_26298":113474,"_2652":113538},[],{"_3154":66467,"_27801":66338,"_19254":113848,"_5":13218,"_26298":113474,"_2652":113849},[],"Cualquier DMS",{"_3154":66468,"_27801":66338,"_19254":113851,"_5":13218,"_26298":113474,"_2652":113852},[],"Baja: solo informativo",{"_3154":66469,"_27801":66338,"_19254":113854,"_5":13218,"_26298":113474,"_2652":113855},[],"Revisar ambos bloques antes de editar",{"_3154":66470,"_27801":66338,"_19254":113857,"_5":13218,"_26298":113481,"_2652":113858},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3154":66471,"_27801":66338,"_19254":113860,"_5":13218,"_26298":113481,"_2652":113861},[],"El paso 4 de la guía de migración copia los datos.",{"_3154":66472,"_27801":66338,"_19254":113863,"_5":13218,"_26298":113485,"_2652":113864},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3154":66473,"_27801":66338,"_19254":113866,"_5":13218,"_26298":113489,"_2652":113867},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3154":66474,"_27801":66338,"_19254":113869,"_5":13218,"_26298":113493,"_2652":113870},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3154":66475,"_27801":66338,"_19254":113872,"_5":13218,"_26298":113497,"_2652":113873},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3154":66476,"_27801":66338,"_19254":113875,"_5":13218,"_26298":113497,"_2652":113876},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3154":66477,"_27801":66338,"_19254":113878,"_5":13218,"_26298":113501,"_2652":113879},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3154":66478,"_27801":66338,"_19254":113881,"_5":13218,"_26298":113505,"_2652":113882},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3154":66479,"_27801":66338,"_19254":113884,"_5":13218,"_26298":113505,"_2652":113885},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3154":66480,"_27801":66338,"_19254":113887,"_5":13218,"_26298":113505,"_2652":113888},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3154":66481,"_27801":66338,"_19254":113890,"_5":13218,"_26298":113505,"_2652":113891},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3154":66482,"_27801":66338,"_19254":113893,"_5":13218,"_26298":113505,"_2652":113894},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3154":66483,"_27801":66338,"_19254":113896,"_5":13218,"_26298":113505,"_2652":113897},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3154":66484,"_27801":66338,"_19254":113899,"_5":13218,"_26298":113513,"_2652":113900},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3154":66485,"_27801":66338,"_19254":113902,"_5":13218,"_26298":113513,"_2652":113903},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3154":66486,"_27801":66338,"_19254":113905,"_5":13218,"_26298":113513,"_2652":113906},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3154":66487,"_27801":66338,"_19254":113908,"_5":13218,"_26298":113513,"_2652":113909},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3154":66488,"_27801":66338,"_19254":113911,"_5":13218,"_26298":113513,"_2652":113912},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_3154":66489,"_27801":66338,"_19254":113914,"_5":13218,"_26298":113517,"_2652":113915},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3154":66490,"_27801":66338,"_19254":113917,"_5":13218,"_26298":113521,"_2652":113918},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3154":66491,"_27801":66338,"_19254":113920,"_5":13218,"_26298":113521,"_2652":113921},[],"El `key_id` es el `subject_key_id` del certificado (SHA-256 de la clave pública).",{"_3154":66492,"_27801":66338,"_19254":113923,"_5":13218,"_26298":113521,"_2652":113924},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3154":66493,"_27801":66338,"_19254":113926,"_5":13218,"_26298":113521,"_2652":113927},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3154":66494,"_27801":66338,"_19254":113929,"_5":13218,"_26298":113521,"_2652":113930},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3154":66495,"_27801":66338,"_19254":113932,"_5":13218,"_26298":113521,"_2652":113933},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3154":66496,"_27801":66338,"_19254":113935,"_5":13218,"_26298":113529,"_2652":113936},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_3154":66497,"_27801":66338,"_19254":113938,"_5":13218,"_26298":113529,"_2652":113939},[],"Campo en 3.8.0",{"_3154":66498,"_27801":66338,"_19254":113941,"_5":13218,"_26298":113529,"_2652":113942},[],"Campo en 4.0.0",{"_3154":66499,"_27801":66338,"_19254":113944,"_5":13218,"_26298":113529,"_2652":53135},[],{"_3154":66500,"_27801":66338,"_19254":113946,"_5":13218,"_26298":113529,"_2652":113947},[],"`insecure_skip_verify` (con el valor negado)",{"_3154":66501,"_27801":66338,"_19254":113949,"_5":13218,"_26298":113529,"_2652":53141},[],{"_3154":66502,"_27801":66338,"_19254":113951,"_5":13218,"_26298":113529,"_2652":53144},[],{"_3154":66503,"_27801":66338,"_19254":113953,"_5":13218,"_26298":113529,"_2652":53147},[],{"_3154":66504,"_27801":66338,"_19254":113955,"_5":13218,"_26298":113529,"_2652":53150},[],{"_3154":66505,"_27801":66338,"_19254":113957,"_5":13218,"_26298":113529,"_2652":53153},[],{"_3154":66506,"_27801":66338,"_19254":113959,"_5":13218,"_26298":113529,"_2652":53156},[],{"_3154":66507,"_27801":66338,"_19254":113961,"_5":13218,"_26298":113529,"_2652":113962},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_3154":66508,"_27801":66338,"_19254":113964,"_5":13218,"_26298":113529,"_2652":113965},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3154":66509,"_27801":66338,"_19254":113967,"_5":13218,"_26298":113529,"_2652":113968},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3154":66510,"_27801":66338,"_19254":113970,"_5":13218,"_26298":113533,"_2652":113971},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3154":66511,"_27801":66338,"_19254":113973,"_5":13218,"_26298":113533,"_2652":113974},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3154":66512,"_27801":66338,"_19254":113976,"_5":13218,"_26298":113533,"_2652":113977},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3154":66513,"_27801":66338,"_19254":113979,"_5":13218,"_26298":113537,"_2652":113980},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. Si la versión de la consola no expone los ajustes independientes, edítalos mediante la API DMS.",{"_3154":66514,"_27801":66338,"_19254":113982,"_5":13218,"_26298":113541,"_2652":113983},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3154":66515,"_27801":66338,"_19254":113985,"_5":13218,"_26298":113545,"_2652":113986},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_3154":66516,"_27801":66338,"_19254":113988,"_5":13218,"_26298":113549,"_2652":113989},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3154":66517,"_27801":66338,"_19254":113991,"_5":13218,"_26298":113549,"_2652":113992},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3154":66518,"_27801":66338,"_19254":113994,"_5":13218,"_26298":113549,"_2652":113995},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3154":66519,"_27801":66338,"_19254":113997,"_5":13218,"_26298":113549,"_2652":113998},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza.",{"_3154":66520,"_27801":66338,"_19254":114000,"_5":13218,"_26298":113553,"_2652":114001},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3154":66521,"_27801":66338,"_19254":114003,"_5":13218,"_26298":113557,"_2652":114004},[],"Haz una copia de seguridad verificable de PostgreSQL y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`.",{"_3154":66522,"_27801":66338,"_19254":114006,"_5":13218,"_26298":113557,"_2652":114007},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3154":66523,"_27801":66338,"_19254":114009,"_5":13218,"_26298":113557,"_2652":114010},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3154":66524,"_27801":66338,"_19254":114012,"_5":13218,"_26298":113557,"_2652":114013},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3154":66525,"_27801":66338,"_19254":114015,"_5":13218,"_26298":113557,"_2652":114016},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3154":66526,"_27801":66338,"_19254":114018,"_5":13218,"_26298":113561,"_2652":114019},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3154":66527,"_27801":66338,"_19254":114021,"_5":13218,"_26298":113561,"_2652":114022},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3154":66528,"_27801":66338,"_19254":114024,"_5":13218,"_26298":113561,"_2652":114025},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se lee el campo `database` de cada entrada; la conexión usa siempre los values globales `postgres.hostname`, `postgres.port`, `postgres.username` y `postgres.password`.",{"_3154":66529,"_27801":66338,"_19254":114027,"_5":13218,"_26298":113561,"_2652":114028},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3154":66530,"_27801":66338,"_19254":114030,"_5":13218,"_26298":113561,"_2652":114031},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3154":66531,"_27801":66338,"_19254":114033,"_5":13218,"_26298":113561,"_2652":114034},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3154":66532,"_27801":66338,"_19254":114036,"_5":13218,"_26298":113561,"_2652":114037},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3154":66533,"_27801":66338,"_19254":114039,"_5":13218,"_26298":113561,"_2652":114040},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3154":66534,"_27801":66338,"_19254":114042,"_5":13218,"_26298":113561,"_2652":114043},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3154":66535,"_27801":66338,"_19254":114045,"_5":13218,"_26298":113561,"_2652":114046},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3154":66536,"_27801":66338,"_19254":114048,"_5":13218,"_26298":113561,"_2652":114049},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3154":66537,"_27801":66338,"_19254":114051,"_5":13218,"_26298":113561,"_2652":114052},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida.",{"_3154":66538,"_27801":66338,"_19254":114054,"_5":13218,"_26298":113565,"_2652":114055},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_3154":66539,"_27801":66338,"_19254":114057,"_5":13218,"_26298":113565,"_2652":114058},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_3154":66540,"_27801":66338,"_19254":114060,"_5":13218,"_26298":113569,"_2652":114061},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3154":66541,"_27801":66338,"_19254":114063,"_5":13218,"_26298":113569,"_2652":114064},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3154":66542,"_27801":66338,"_19254":114066,"_5":13218,"_26298":113569,"_2652":114067},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3154":66543,"_27801":66338,"_19254":114069,"_5":13218,"_26298":113569,"_2652":114070},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_3154":66544,"_27801":66338,"_19254":114072,"_5":13218,"_26298":113569,"_2652":114073},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3154":66545,"_27801":66338,"_19254":114075,"_5":13218,"_26298":113569,"_2652":114076},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3154":66546,"_27801":66338,"_19254":114078,"_5":13218,"_26298":113569,"_2652":114079},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3154":66547,"_27801":66338,"_19254":114081,"_5":13218,"_26298":113569,"_2652":114082},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3154":66548,"_27801":66338,"_19254":114084,"_5":13218,"_26298":113569,"_2652":114085},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3154":66549,"_27801":66338,"_19254":114087,"_5":13218,"_26298":113569,"_2652":114088},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3154":66550,"_27801":66338,"_19254":114090,"_5":13218,"_26298":113569,"_2652":114091},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_3154":66551,"_27801":66338,"_19254":114093,"_5":13218,"_26298":113573,"_2652":114094},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3154":66552,"_27801":66338,"_19254":114096,"_5":13218,"_26298":113573,"_2652":114097},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3154":66553,"_27801":66338,"_19254":114099,"_5":13218,"_26298":113577,"_2652":114100},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3154":66554,"_27801":66338,"_19254":114102,"_5":13218,"_26298":113577,"_2652":114103},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3154":66555,"_27801":66338,"_19254":114105,"_5":13218,"_26298":113577,"_2652":114106},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3154":66556,"_27801":66338,"_19254":114108,"_5":13218,"_26298":113577,"_2652":114109},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_3154":66557,"_27801":66338,"_19254":114111,"_5":13218,"_26298":113577,"_2652":114112},[],"El README de `goose-lamassu` aún muestra ejemplos por base de datos (`dbname=ca`, `dbname=kms`) y afirma que la herramienta valida el nombre de la base de datos, y el README de `ca-to-kms-migration` sigue describiendo el modelo de dos bases anterior a 4.0.0. Sigue la forma con `dbname=pki` de esta página en lugar de sus ejemplos.",{"_3154":66558,"_27801":66338,"_19254":114114,"_5":13218,"_26298":113581,"_2652":114115},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3154":66559,"_27801":66338,"_19254":114117,"_5":13218,"_26298":113581,"_2652":114118},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_3154":66560,"_27801":66338,"_19254":114120,"_5":13218,"_26298":113581,"_2652":114121},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_3154":66561,"_27801":66338,"_19254":114123,"_5":13218,"_26298":113581,"_2652":114124},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3154":66562,"_27801":66338,"_19254":114126,"_5":13218,"_26298":113581,"_2652":114127},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó por IDs de CA duplicados o por valores de `engine_id` vacíos. Revisa los logs del job, corrige los permisos o los datos y vuelve a ejecutar la actualización.",{"_3154":66563,"_27801":66338,"_19254":114129,"_5":13218,"_26298":113581,"_2652":114130},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3154":66564,"_27801":66338,"_19254":114132,"_5":13218,"_26298":113581,"_2652":114133},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3154":66565,"_27801":66338,"_19254":114135,"_5":13218,"_26298":113584,"_2652":114136},[],"Tras la actualización, comprueba en este orden:",{"_3154":66566,"_27801":66338,"_19254":114138,"_5":13218,"_26298":113584,"_2652":114139},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS.",{"_3154":66567,"_27801":66338,"_19254":114141,"_5":13218,"_26298":113584,"_2652":114142},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3154":66568,"_27801":66338,"_19254":114144,"_5":13218,"_26298":113584,"_2652":114145},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3154":66569,"_27801":66338,"_19254":114147,"_5":13218,"_26298":113584,"_2652":114148},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-ski>` sobre la VA devuelve una CRL emitida anteriormente, y se emiten CRLs nuevas.",{"_3154":66570,"_27801":66338,"_19254":114150,"_5":13218,"_26298":113584,"_2652":114151},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS.",{"_3154":66571,"_27801":66338,"_19254":114153,"_5":13218,"_26298":113584,"_2652":114154},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3154":66572,"_27801":66338,"_19254":114156,"_5":13218,"_26298":113584,"_2652":114157},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3154":66573,"_27801":66338,"_19254":114159,"_5":13218,"_26298":113584,"_2652":114160},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha.",{"_3154":66574,"_27801":66338,"_19254":114162,"_5":13218,"_26298":113584,"_2652":114163},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3154":66575,"_27801":66338,"_19254":114165,"_5":13218,"_26298":113584,"_2652":114166},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3154":66576,"_27801":66338,"_19254":114168,"_5":13218,"_26298":113584,"_2652":114169},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3154":66577,"_27801":66338,"_19254":114171,"_5":13218,"_26298":113584,"_2652":114172},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3154":66578,"_27801":66338,"_19254":114174,"_5":13218,"_26298":113584,"_2652":114175},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3154":66579,"_27801":66338,"_19254":114177,"_5":13218,"_26298":113584,"_2652":114178},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3154":66580,"_27801":66338,"_19254":114180,"_5":13218,"_26298":113588,"_2652":114181},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_3154":66581,"_27801":66338,"_19254":114183,"_5":13218,"_26298":113588,"_2652":114184},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3154":66582,"_27801":66338,"_19254":114186,"_5":13218,"_26298":113588,"_2652":114187},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3154":66583,"_27801":66338,"_19254":114189,"_5":13218,"_26298":113588,"_2652":114190},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_3154":66584,"_27801":66338,"_19254":114192,"_5":13218,"_26298":113588,"_2652":114193},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_53393":114195,"_53395":114196,"_53397":114197,"_53399":114198,"_16779":2674,"_63946":2674},"spanish",[2652,27801,5,26298],{"_2652":23039,"_27801":23039,"_5":23039,"_26298":23039},{"_2652":114199,"_27801":116834,"_5":119469,"_26298":122104},{"_4238":114200,"_53403":114201,"_5":23039},{"_13273":8119,"_13648":23368,"_13667":5402,"_11914":9350,"_13654":9944,"_18267":3324,"_13294":6927,"_13301":3810,"_26855":6972,"_27246":6032,"_27267":6799,"_26873":5238,"_31908":2761,"_27278":3096,"_27307":2701,"_31915":6769,"_31918":3816,"_31921":5974,"_31924":2919,"_27654":3027,"_31929":11969,"_31931":4142,"_27684":5296,"_13663":6318,"_31935":14525,"_31938":3882,"_31940":4041,"_27296":3920,"_27649":9288,"_27708":7673,"_31945":3352,"_31947":13237,"_31949":6406,"_31951":3291,"_31953":6324,"_31955":3693,"_31957":3003,"_31959":5954,"_31961":10123,"_26925":6363,"_31964":6403,"_31966":8790,"_26919":19367,"_31969":14501,"_31971":6845,"_31973":6479,"_31976":5871,"_26965":17846,"_31980":6984,"_26846":15436,"_31983":16567,"_26878":5868,"_27859":6371,"_31987":5299,"_31990":3332,"_13657":5589,"_31993":5395,"_31995":2742,"_31998":4222,"_32000":10695,"_32002":18709,"_32004":4624,"_32006":8310,"_18270":3656,"_32009":19183,"_32011":9584,"_26899":13269,"_27290":4214,"_32015":14495,"_32017":12972,"_320