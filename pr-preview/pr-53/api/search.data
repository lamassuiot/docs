87":122146,"_39489":122149,"_39491":122152,"_39493":122155,"_39495":122158,"_39497":122161,"_39499":122164,"_39501":122167,"_39503":122170,"_39506":122173,"_39508":122176,"_39510":122179,"_39513":122182,"_39515":122185,"_39517":122188,"_39519":122191,"_39521":122194,"_39523":122197,"_39525":122200,"_39527":122203,"_39529":122206,"_39531":122209,"_39533":122212,"_39535":122215,"_39537":122218,"_39539":122221,"_39541":122224,"_39543":122227,"_39545":122230,"_39547":122233,"_39549":122236,"_39551":122239,"_39553":122242,"_39555":122245,"_39557":122248,"_39559":122251,"_39561":122254,"_39563":122257,"_39565":122260,"_39567":122263,"_39569":122266,"_39571":122269,"_39573":122272,"_39575":122275,"_39577":122278,"_39579":122281,"_39581":122284,"_39583":122287,"_39585":122290,"_39587":122293,"_39589":122296,"_39591":122299,"_39593":122302,"_39595":122305,"_39597":122308,"_39599":122311,"_39602":122314,"_39604":122317,"_39606":122320},{"_3379":68533,"_29619":68533,"_5":14457,"_2865":113629,"_29972":113630,"_20556":113633,"_26939":68533},"Despliega desde AWS Marketplace",[48223,113631,113632],"Despliegue","Otros modelos",[],{"_3379":68534,"_29619":68533,"_20556":113635,"_5":14099,"_26939":68533,"_2865":113636},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_3379":68535,"_29619":68533,"_5":29969,"_20556":113638,"_26939":113639,"_2865":113640},[],"/docs/pr-preview/pr-53/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_3379":68536,"_29619":68533,"_5":29969,"_20556":113642,"_26939":113643,"_2865":113644},[],"/docs/pr-preview/pr-53/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_3379":68537,"_29619":68533,"_5":29969,"_20556":113646,"_26939":113647,"_2865":113648},[],"/docs/pr-preview/pr-53/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3379":68538,"_29619":68533,"_5":29969,"_20556":113650,"_26939":113651,"_2865":113652},[],"/docs/pr-preview/pr-53/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3379":68539,"_29619":68533,"_5":29969,"_20556":113654,"_26939":113655,"_2865":113656},[],"/docs/pr-preview/pr-53/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3379":68540,"_29619":68533,"_5":29969,"_20556":113658,"_26939":113659,"_2865":113660},[],"/docs/pr-preview/pr-53/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3379":68541,"_29619":68533,"_5":29969,"_20556":113662,"_26939":113663,"_2865":113664},[],"/docs/pr-preview/pr-53/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3379":68542,"_29619":68533,"_20556":113666,"_5":14099,"_26939":68533,"_2865":113667},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3379":68543,"_29619":68533,"_20556":113669,"_5":14099,"_26939":113639,"_2865":113670},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3379":68544,"_29619":68533,"_20556":113672,"_5":14099,"_26939":113639,"_2865":113673},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3379":68545,"_29619":68533,"_20556":113675,"_5":14099,"_26939":113639,"_2865":113676},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3379":68546,"_29619":68533,"_20556":113678,"_5":14099,"_26939":113643,"_2865":113679},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3379":68547,"_29619":68533,"_20556":113681,"_5":14099,"_26939":113643,"_2865":113682},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3379":68548,"_29619":68533,"_20556":113684,"_5":14099,"_26939":113643,"_2865":113685},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3379":68549,"_29619":68533,"_20556":113687,"_5":14099,"_26939":113647,"_2865":113688},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3379":68550,"_29619":68533,"_20556":113690,"_5":14099,"_26939":113651,"_2865":113691},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3379":68551,"_29619":68533,"_20556":113693,"_5":14099,"_26939":113655,"_2865":113694},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3379":68552,"_29619":68533,"_20556":113696,"_5":14099,"_26939":113659,"_2865":113697},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3379":68553,"_29619":68533,"_20556":113699,"_5":14099,"_26939":113663,"_2865":113700},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3379":68554,"_29619":68554,"_5":14457,"_2865":113702,"_29972":113703,"_20556":113704,"_26939":68554},"Despliega Lamassu",[48223,113631],[],{"_3379":68555,"_29619":68554,"_20556":113706,"_5":14099,"_26939":68554,"_2865":113707},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3379":68556,"_29619":68554,"_5":29969,"_20556":113709,"_26939":113710,"_2865":113711},[],"/docs/pr-preview/pr-53/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3379":68557,"_29619":68554,"_5":29969,"_20556":113713,"_26939":113714,"_2865":113715},[],"/docs/pr-preview/pr-53/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3379":68558,"_29619":68554,"_5":29969,"_20556":113717,"_26939":113718,"_2865":113719},[],"/docs/pr-preview/pr-53/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3379":68559,"_29619":68554,"_20556":113721,"_5":14099,"_26939":68554,"_2865":113722},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3379":68560,"_29619":68554,"_20556":113724,"_5":14099,"_26939":113710,"_2865":113725},[],"Modelo",{"_3379":68561,"_29619":68554,"_20556":113727,"_5":14099,"_26939":113710,"_2865":113728},[],"Recomendado para",{"_3379":68562,"_29619":68554,"_20556":113730,"_5":14099,"_26939":113710,"_2865":113731},[],"Quién opera la infraestructura",{"_3379":68563,"_29619":68554,"_20556":113733,"_5":14099,"_26939":113710,"_2865":113734},[],"Punto de partida",{"_3379":68564,"_29619":68554,"_20556":113736,"_5":14099,"_26939":113710,"_2865":48330},[],{"_3379":68565,"_29619":68554,"_20556":113738,"_5":14099,"_26939":113710,"_2865":113739},[],"Producción, entornos regulados y despliegues personalizados",{"_3379":68566,"_29619":68554,"_20556":113741,"_5":14099,"_26939":113710,"_2865":113742},[],"Tu equipo",{"_3379":68567,"_29619":68554,"_20556":113744,"_5":14099,"_26939":113710,"_2865":113745},[],"Helm o Fastlane",{"_3379":68568,"_29619":68554,"_20556":113747,"_5":14099,"_26939":113710,"_2865":48342},[],{"_3379":68569,"_29619":68554,"_20556":113749,"_5":14099,"_26939":113710,"_2865":113750},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3379":68570,"_29619":68554,"_20556":113752,"_5":14099,"_26939":113710,"_2865":113742},[],{"_3379":68571,"_29619":68554,"_20556":113754,"_5":14099,"_26939":113710,"_2865":113755},[],"Imagen preconfigurada en EC2",{"_3379":68572,"_29619":68554,"_20556":113757,"_5":14099,"_26939":113710,"_2865":48353},[],{"_3379":68573,"_29619":68554,"_20556":113759,"_5":14099,"_26939":113710,"_2865":113760},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3379":68574,"_29619":68554,"_20556":113762,"_5":14099,"_26939":113710,"_2865":48359},[],{"_3379":68575,"_29619":68554,"_20556":113764,"_5":14099,"_26939":113710,"_2865":113765},[],"Suscripción gestionada",{"_3379":68576,"_29619":68554,"_20556":113767,"_5":14099,"_26939":113710,"_2865":113768},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3379":68577,"_29619":68554,"_20556":113770,"_5":14099,"_26939":113710,"_2865":113771},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3379":68578,"_29619":68554,"_20556":113773,"_5":14099,"_26939":113710,"_2865":113774},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3379":68579,"_29619":68554,"_20556":113776,"_5":14099,"_26939":113714,"_2865":113777},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3379":68580,"_29619":68554,"_20556":113779,"_5":14099,"_26939":113718,"_2865":113780},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3379":68581,"_29619":68581,"_5":14457,"_2865":113782,"_29972":113783,"_20556":113784,"_26939":68581},"Utiliza Lamassu como SaaS",[48223,113631,113632],[],{"_3379":68582,"_29619":68581,"_20556":113786,"_5":14099,"_26939":68581,"_2865":113787},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3379":68583,"_29619":68581,"_5":29969,"_20556":113789,"_26939":113790,"_2865":113791},[],"/docs/pr-preview/pr-53/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3379":68584,"_29619":68581,"_5":29969,"_20556":113793,"_26939":113794,"_2865":113795},[],"/docs/pr-preview/pr-53/es/deployment/saas#planes","Planes",{"_3379":68585,"_29619":68581,"_5":29969,"_20556":113797,"_26939":113798,"_2865":113799},[],"/docs/pr-preview/pr-53/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3379":68586,"_29619":68581,"_20556":113801,"_5":14099,"_26939":68581,"_2865":113802},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3379":68587,"_29619":68581,"_20556":113804,"_5":14099,"_26939":113790,"_2865":113805},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3379":68588,"_29619":68581,"_20556":113807,"_5":14099,"_26939":113790,"_2865":113808},[],"Copias de seguridad automáticas.",{"_3379":68589,"_29619":68581,"_20556":113810,"_5":14099,"_26939":113790,"_2865":113811},[],"Actualizaciones de versión.",{"_3379":68590,"_29619":68581,"_20556":113813,"_5":14099,"_26939":113790,"_2865":113814},[],"Soporte técnico y SLA según el plan contratado.",{"_3379":68591,"_29619":68581,"_20556":113816,"_5":14099,"_26939":113794,"_2865":48414},[],{"_3379":68592,"_29619":68581,"_20556":113818,"_5":14099,"_26939":113794,"_2865":113819},[],"Dispositivos",{"_3379":68593,"_29619":68581,"_20556":113821,"_5":14099,"_26939":113794,"_2865":113822},[],"Soporte",{"_3379":68594,"_29619":68581,"_20556":113824,"_5":14099,"_26939":113794,"_2865":48423},[],{"_3379":68595,"_29619":68581,"_20556":113826,"_5":14099,"_26939":113794,"_2865":48426},[],{"_3379":68596,"_29619":68581,"_20556":113828,"_5":14099,"_26939":113794,"_2865":113829},[],"Hasta 1.000",{"_3379":68597,"_29619":68581,"_20556":113831,"_5":14099,"_26939":113794,"_2865":48432},[],{"_3379":68598,"_29619":68581,"_20556":113833,"_5":14099,"_26939":113794,"_2865":113834},[],"99,5 %",{"_3379":68599,"_29619":68581,"_20556":113836,"_5":14099,"_26939":113794,"_2865":48438},[],{"_3379":68600,"_29619":68581,"_20556":113838,"_5":14099,"_26939":113794,"_2865":113839},[],"Hasta 10.000",{"_3379":68601,"_29619":68581,"_20556":113841,"_5":14099,"_26939":113794,"_2865":113842},[],"Email y chat",{"_3379":68602,"_29619":68581,"_20556":113844,"_5":14099,"_26939":113794,"_2865":113845},[],"99,9 %",{"_3379":68603,"_29619":68581,"_20556":113847,"_5":14099,"_26939":113794,"_2865":48450},[],{"_3379":68604,"_29619":68581,"_20556":113849,"_5":14099,"_26939":113794,"_2865":113850},[],"Ilimitados",{"_3379":68605,"_29619":68581,"_20556":113852,"_5":14099,"_26939":113794,"_2865":113853},[],"Dedicado",{"_3379":68606,"_29619":68581,"_20556":113855,"_5":14099,"_26939":113794,"_2865":113856},[],"99,99 %",{"_3379":68607,"_29619":68581,"_20556":113858,"_5":14099,"_26939":113798,"_2865":113859},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3379":68608,"_29619":68581,"_20556":113861,"_5":14099,"_26939":113798,"_2865":113862},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3379":68609,"_29619":68609,"_5":14457,"_2865":48467,"_29972":113864,"_20556":113866,"_26939":68609},[48223,113631,113865],"Kubernetes autogestionado",[],{"_3379":68610,"_29619":68609,"_20556":113868,"_5":14099,"_26939":68609,"_2865":113869},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3379":68611,"_29619":68609,"_5":29969,"_20556":113871,"_26939":113872,"_2865":113873},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3379":68612,"_29619":68609,"_5":29969,"_20556":113875,"_26939":113876,"_2865":113877},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3379":68613,"_29619":68609,"_5":29969,"_20556":113879,"_26939":113880,"_2865":113881},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3379":68614,"_29619":68609,"_5":29969,"_20556":113883,"_26939":113884,"_2865":113885},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3379":68615,"_29619":68609,"_5":29969,"_20556":113887,"_26939":113888,"_2865":113889},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3379":68616,"_29619":68609,"_5":29969,"_20556":113891,"_26939":113892,"_2865":113893},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3379":68617,"_29619":68609,"_5":29969,"_20556":113895,"_26939":113896,"_2865":113897},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3379":68618,"_29619":68609,"_5":29969,"_20556":113899,"_26939":113900,"_2865":113901},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3379":68619,"_29619":68609,"_5":29969,"_20556":113903,"_26939":113904,"_2865":113905},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3379":68620,"_29619":68609,"_5":29969,"_20556":113907,"_26939":113908,"_2865":113909},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3379":68621,"_29619":68609,"_5":29969,"_20556":113911,"_26939":113912,"_2865":113913},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3379":68622,"_29619":68609,"_20556":113915,"_5":14099,"_26939":113872,"_2865":113916},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3379":68623,"_29619":68609,"_20556":113918,"_5":14099,"_26939":113872,"_2865":113919},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3379":68624,"_29619":68609,"_20556":113921,"_5":14099,"_26939":113876,"_2865":113922},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3379":68625,"_29619":68609,"_20556":113924,"_5":14099,"_26939":113876,"_2865":113925},[],"Fastlane instala o configura",{"_3379":68626,"_29619":68609,"_20556":113927,"_5":14099,"_26939":113876,"_2865":113928},[],"Tú sigues proporcionando",{"_3379":68627,"_29619":68609,"_20556":113930,"_5":14099,"_26939":113876,"_2865":113931},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3379":68628,"_29619":68609,"_20556":113933,"_5":14099,"_26939":113876,"_2865":113934},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3379":68629,"_29619":68609,"_20556":113936,"_5":14099,"_26939":113876,"_2865":113937},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3379":68630,"_29619":68609,"_20556":113939,"_5":14099,"_26939":113876,"_2865":113940},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3379":68631,"_29619":68609,"_20556":113942,"_5":14099,"_26939":113876,"_2865":113943},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_3379":68632,"_29619":68609,"_20556":113945,"_5":14099,"_26939":113876,"_2865":113946},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3379":68633,"_29619":68609,"_20556":113948,"_5":14099,"_26939":113876,"_2865":113949},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3379":68634,"_29619":68609,"_20556":113951,"_5":14099,"_26939":113876,"_2865":113952},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3379":68635,"_29619":68609,"_20556":113954,"_5":14099,"_26939":113876,"_2865":113955},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3379":68636,"_29619":68609,"_20556":113957,"_5":14099,"_26939":113880,"_2865":113958},[],"Necesitas:",{"_3379":68637,"_29619":68609,"_20556":113960,"_5":14099,"_26939":113880,"_2865":113961},[],"un clúster Kubernetes existente",{"_3379":68638,"_29619":68609,"_20556":113963,"_5":14099,"_26939":113880,"_2865":113964},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3379":68639,"_29619":68609,"_20556":113966,"_5":14099,"_26939":113880,"_2865":48569},[],{"_3379":68640,"_29619":68609,"_20556":113968,"_5":14099,"_26939":113880,"_2865":23237},[],{"_3379":68641,"_29619":68609,"_20556":113970,"_5":14099,"_26939":113880,"_2865":113971},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3379":68642,"_29619":68609,"_20556":113973,"_5":14099,"_26939":113880,"_2865":113974},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3379":68643,"_29619":68609,"_20556":113976,"_5":14099,"_26939":113880,"_2865":113977},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3379":68644,"_29619":68609,"_20556":113979,"_5":14099,"_26939":113880,"_2865":113980},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3379":68645,"_29619":68609,"_20556":113982,"_5":14099,"_26939":113880,"_2865":113983},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3379":68646,"_29619":68609,"_20556":113985,"_5":14099,"_26939":113884,"_2865":113986},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3379":68647,"_29619":68609,"_20556":113988,"_5":14099,"_26939":113884,"_2865":113989},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3379":68648,"_29619":68609,"_20556":113991,"_5":14099,"_26939":113888,"_2865":113992},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3379":68649,"_29619":68609,"_20556":113994,"_5":14099,"_26939":113888,"_2865":113995},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3379":68650,"_29619":68609,"_20556":113997,"_5":14099,"_26939":113888,"_2865":113998},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3379":68651,"_29619":68609,"_20556":114000,"_5":14099,"_26939":113888,"_2865":114001},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3379":68652,"_29619":68609,"_20556":114003,"_5":14099,"_26939":113892,"_2865":114004},[],"Opción",{"_3379":68653,"_29619":68609,"_20556":114006,"_5":14099,"_26939":113892,"_2865":114007},[],"Valor predeterminado",{"_3379":68654,"_29619":68609,"_20556":114009,"_5":14099,"_26939":113892,"_2865":114010},[],"Propósito",{"_3379":68655,"_29619":68609,"_20556":114012,"_5":14099,"_26939":113892,"_2865":48616},[],{"_3379":68656,"_29619":68609,"_20556":114014,"_5":14099,"_26939":113892,"_2865":48619},[],{"_3379":68657,"_29619":68609,"_20556":114016,"_5":14099,"_26939":113892,"_2865":114017},[],"Muestra la ayuda",{"_3379":68658,"_29619":68609,"_20556":114019,"_5":14099,"_26939":113892,"_2865":48625},[],{"_3379":68659,"_29619":68609,"_20556":114021,"_5":14099,"_26939":113892,"_2865":114022},[],"contexto actual",{"_3379":68660,"_29619":68609,"_20556":114024,"_5":14099,"_26939":113892,"_2865":114025},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3379":68661,"_29619":68609,"_20556":114027,"_5":14099,"_26939":113892,"_2865":48634},[],{"_3379":68662,"_29619":68609,"_20556":114029,"_5":14099,"_26939":113892,"_2865":6393},[],{"_3379":68663,"_29619":68609,"_20556":114031,"_5":14099,"_26939":113892,"_2865":114032},[],"Omite prompts y genera credenciales para las dependencias",{"_3379":68664,"_29619":68609,"_20556":114034,"_5":14099,"_26939":113892,"_2865":48642},[],{"_3379":68665,"_29619":68609,"_20556":114036,"_5":14099,"_26939":113892,"_2865":48645},[],{"_3379":68666,"_29619":68609,"_20556":114038,"_5":14099,"_26939":113892,"_2865":114039},[],"Namespace de la instalación",{"_3379":68667,"_29619":68609,"_20556":114041,"_5":14099,"_26939":113892,"_2865":48651},[],{"_3379":68668,"_29619":68609,"_20556":114043,"_5":14099,"_26939":113892,"_2865":48654},[],{"_3379":68669,"_29619":68609,"_20556":114045,"_5":14099,"_26939":113892,"_2865":114046},[],"Dominio usado por la UI, OIDC y el certificado",{"_3379":68670,"_29619":68609,"_20556":114048,"_5":14099,"_26939":113892,"_2865":48660},[],{"_3379":68671,"_29619":68609,"_20556":114050,"_5":14099,"_26939":113892,"_2865":14791},[],{"_3379":68672,"_29619":68609,"_20556":114052,"_5":14099,"_26939":113892,"_2865":114053},[],"Versión del chart de Lamassu",{"_3379":68673,"_29619":68609,"_20556":114055,"_5":14099,"_26939":113892,"_2865":48668},[],{"_3379":68674,"_29619":68609,"_20556":114057,"_5":14099,"_26939":113892,"_2865":48671},[],{"_3379":68675,"_29619":68609,"_20556":114059,"_5":14099,"_26939":113892,"_2865":114060},[],"Puerto del listener HTTPS",{"_3379":68676,"_29619":68609,"_20556":114062,"_5":14099,"_26939":113892,"_2865":48677},[],{"_3379":68677,"_29619":68609,"_20556":114064,"_5":14099,"_26939":113892,"_2865":48680},[],{"_3379":68678,"_29619":68609,"_20556":114066,"_5":14099,"_26939":113892,"_2865":114067},[],"Puerto del listener HTTP",{"_3379":68679,"_29619":68609,"_20556":114069,"_5":14099,"_26939":113892,"_2865":48686},[],{"_3379":68680,"_29619":68609,"_20556":114071,"_5":14099,"_26939":113892,"_2865":48619},[],{"_3379":68681,"_29619":68609,"_20556":114073,"_5":14099,"_26939":113892,"_2865":114074},[],"Certificado PEM para TLS downstream",{"_3379":68682,"_29619":68609,"_20556":114076,"_5":14099,"_26939":113892,"_2865":48694},[],{"_3379":68683,"_29619":68609,"_20556":114078,"_5":14099,"_26939":113892,"_2865":48619},[],{"_3379":68684,"_29619":68609,"_20556":114080,"_5":14099,"_26939":113892,"_2865":114081},[],"Clave privada PEM para TLS downstream",{"_3379":68685,"_29619":68609,"_20556":114083,"_5":14099,"_26939":113892,"_2865":48702},[],{"_3379":68686,"_29619":68609,"_20556":114085,"_5":14099,"_26939":113892,"_2865":114086},[],"chart del repositorio",{"_3379":68687,"_29619":68609,"_20556":114088,"_5":14099,"_26939":113892,"_2865":114089},[],"Usa un chart local de Lamassu sin empaquetar",{"_3379":68688,"_29619":68609,"_20556":114091,"_5":14099,"_26939":113892,"_2865":48711},[],{"_3379":68689,"_29619":68609,"_20556":114093,"_5":14099,"_26939":113892,"_2865":114094},[],"detección automática",{"_3379":68690,"_29619":68609,"_20556":114096,"_5":14099,"_26939":113892,"_2865":114097},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3379":68691,"_29619":68609,"_20556":114099,"_5":14099,"_26939":113892,"_2865":48719},[],{"_3379":68692,"_29619":68609,"_20556":114101,"_5":14099,"_26939":113892,"_2865":6393},[],{"_3379":68693,"_29619":68609,"_20556":114103,"_5":14099,"_26939":113892,"_2865":114104},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3379":68694,"_29619":68609,"_20556":114106,"_5":14099,"_26939":113892,"_2865":48727},[],{"_3379":68695,"_29619":68609,"_20556":114108,"_5":14099,"_26939":113892,"_2865":6393},[],{"_3379":68696,"_29619":68609,"_20556":114110,"_5":14099,"_26939":113892,"_2865":114111},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3379":68697,"_29619":68609,"_20556":114113,"_5":14099,"_26939":113892,"_2865":48735},[],{"_3379":68698,"_29619":68609,"_20556":114115,"_5":14099,"_26939":113892,"_2865":6393},[],{"_3379":68699,"_29619":68609,"_20556":114117,"_5":14099,"_26939":113892,"_2865":114118},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3379":68700,"_29619":68609,"_20556":114120,"_5":14099,"_26939":113892,"_2865":48743},[],{"_3379":68701,"_29619":68609,"_20556":114122,"_5":14099,"_26939":113892,"_2865":6393},[],{"_3379":68702,"_29619":68609,"_20556":114124,"_5":14099,"_26939":113892,"_2865":114125},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3379":68703,"_29619":68609,"_20556":114127,"_5":14099,"_26939":113892,"_2865":48751},[],{"_3379":68704,"_29619":68609,"_20556":114129,"_5":14099,"_26939":113892,"_2865":48754},[],{"_3379":68705,"_29619":68609,"_20556":114131,"_5":14099,"_26939":113892,"_2865":114132},[],"Usa otro chart local de SoftHSM",{"_3379":68706,"_29619":68609,"_20556":114134,"_5":14099,"_26939":113892,"_2865":114135},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3379":68707,"_29619":68609,"_20556":114137,"_5":14099,"_26939":113896,"_2865":114138},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3379":68708,"_29619":68609,"_20556":114140,"_5":14099,"_26939":113896,"_2865":114141},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3379":68709,"_29619":68609,"_20556":114143,"_5":14099,"_26939":113896,"_2865":114144},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3379":68710,"_29619":68609,"_20556":114146,"_5":14099,"_26939":113896,"_2865":114147},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3379":68711,"_29619":68609,"_20556":114149,"_5":14099,"_26939":113896,"_2865":114150},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3379":68712,"_29619":68609,"_20556":114152,"_5":14099,"_26939":113896,"_2865":114153},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3379":68713,"_29619":68609,"_20556":114155,"_5":14099,"_26939":113900,"_2865":48781},[],{"_3379":68714,"_29619":68609,"_20556":114157,"_5":14099,"_26939":113900,"_2865":114158},[],"valida las herramientas locales y el clúster seleccionado",{"_3379":68715,"_29619":68609,"_20556":114160,"_5":14099,"_26939":113900,"_2865":114161},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3379":68716,"_29619":68609,"_20556":114163,"_5":14099,"_26939":113900,"_2865":114164},[],"crea el namespace",{"_3379":68717,"_29619":68609,"_20556":114166,"_5":14099,"_26939":113900,"_2865":114167},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3379":68718,"_29619":68609,"_20556":114169,"_5":14099,"_26939":113900,"_2865":114170},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3379":68719,"_29619":68609,"_20556":114172,"_5":14099,"_26939":113900,"_2865":114173},[],"instala RabbitMQ",{"_3379":68720,"_29619":68609,"_20556":114175,"_5":14099,"_26939":113900,"_2865":114176},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3379":68721,"_29619":68609,"_20556":114178,"_5":14099,"_26939":113900,"_2865":114179},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_3379":68722,"_29619":68609,"_20556":114181,"_5":14099,"_26939":113900,"_2865":114182},[],"carga datos de ejemplo opcionalmente",{"_3379":68723,"_29619":68609,"_20556":114184,"_5":14099,"_26939":113900,"_2865":114185},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3379":68724,"_29619":68609,"_20556":114187,"_5":14099,"_26939":113904,"_2865":114188},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3379":68725,"_29619":68609,"_20556":114190,"_5":14099,"_26939":113904,"_2865":114191},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3379":68726,"_29619":68609,"_20556":114193,"_5":14099,"_26939":113908,"_2865":114194},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3379":68727,"_29619":68609,"_20556":114196,"_5":14099,"_26939":113908,"_2865":114197},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_3379":68728,"_29619":68609,"_20556":114199,"_5":14099,"_26939":113908,"_2865":114200},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3379":68729,"_29619":68609,"_20556":114202,"_5":14099,"_26939":113912,"_2865":114203},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3379":68730,"_29619":68730,"_5":14457,"_2865":114205,"_29972":114206,"_20556":114207,"_26939":68730},"Instala con Helm",[48223,113631,113865],[],{"_3379":68731,"_29619":68730,"_20556":114209,"_5":14099,"_26939":68730,"_2865":114210},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3379":68732,"_29619":68730,"_5":29969,"_20556":114212,"_26939":114213,"_2865":114214},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3379":68733,"_29619":68730,"_5":29969,"_20556":114216,"_26939":114217,"_2865":113881},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3379":68734,"_29619":68730,"_5":29969,"_20556":114219,"_26939":114220,"_2865":114221},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3379":68735,"_29619":68730,"_5":29969,"_20556":114223,"_26939":114224,"_2865":114225},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3379":68736,"_29619":68730,"_5":29969,"_20556":114227,"_26939":114228,"_2865":114229},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3379":68737,"_29619":68730,"_5":29969,"_20556":114231,"_26939":114232,"_2865":114233},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/helm#tls-de-amqp-amqps","TLS de AMQP (AMQPS)",{"_3379":68738,"_29619":68730,"_5":29969,"_20556":114235,"_26939":114236,"_2865":114237},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3379":68739,"_29619":68730,"_5":29969,"_20556":114239,"_26939":114240,"_2865":114241},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3379":68740,"_29619":68730,"_5":29969,"_20556":114243,"_26939":114244,"_2865":114245},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3379":68741,"_29619":68730,"_5":29969,"_20556":114247,"_26939":114248,"_2865":114249},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/helm#actualiza-lamassu","Actualiza Lamassu",{"_3379":68742,"_29619":68730,"_5":29969,"_20556":114251,"_26939":114252,"_2865":114253},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3379":68743,"_29619":68730,"_20556":114255,"_5":14099,"_26939":114213,"_2865":114256},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3379":68744,"_29619":68730,"_20556":114258,"_5":14099,"_26939":114217,"_2865":114259},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3379":68745,"_29619":68730,"_20556":114261,"_5":14099,"_26939":114217,"_2865":114262},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3379":68746,"_29619":68730,"_20556":114264,"_5":14099,"_26939":114217,"_2865":114265},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3379":68747,"_29619":68730,"_20556":114267,"_5":14099,"_26939":114217,"_2865":114268},[],"un broker RabbitMQ accesible y sus credenciales",{"_3379":68748,"_29619":68730,"_20556":114270,"_5":14099,"_26939":114217,"_2865":114271},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3379":68749,"_29619":68730,"_20556":114273,"_5":14099,"_26939":114217,"_2865":114274},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3379":68750,"_29619":68730,"_20556":114276,"_5":14099,"_26939":114217,"_2865":114277},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3379":68751,"_29619":68730,"_20556":114279,"_5":14099,"_26939":114217,"_2865":114280},[],"una StorageClass y un diseño de tráfico externo",{"_3379":68752,"_29619":68730,"_20556":114282,"_5":14099,"_26939":114217,"_2865":114283},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3379":68753,"_29619":68730,"_20556":114285,"_5":14099,"_26939":114217,"_2865":114286},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3379":68754,"_29619":68730,"_20556":114288,"_5":14099,"_26939":114217,"_2865":114289},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3379":68755,"_29619":68730,"_20556":114291,"_5":14099,"_26939":114220,"_2865":114292},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3379":68756,"_29619":68730,"_20556":114294,"_5":14099,"_26939":114220,"_2865":114295},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3379":68757,"_29619":68730,"_20556":114297,"_5":14099,"_26939":114220,"_2865":114298},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_3379":68758,"_29619":68730,"_20556":114300,"_5":14099,"_26939":114224,"_2865":114301},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3379":68759,"_29619":68730,"_20556":114303,"_5":14099,"_26939":114224,"_2865":114304},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3379":68760,"_29619":68730,"_20556":114306,"_5":14099,"_26939":114224,"_2865":114307},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3379":68761,"_29619":68730,"_20556":114309,"_5":14099,"_26939":114224,"_2865":114310},[],"Si tu archivo de valores aún contiene los ajustes heredados de validación JWT del Gateway — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` o `auth.authorization.roles.admin` — elimínalos. La guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documenta su eliminación sin alias de compatibilidad, y `values.schema.json` rechaza los bloques residuales en lugar de ignorarlos silenciosamente. Los reemplazos son `services.authz.jwkUrl` y `services.authz.bootstrap`, que ya aparecen en el ejemplo anterior.",{"_3379":68762,"_29619":68730,"_20556":114312,"_5":14099,"_26939":114228,"_2865":114313},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_3379":68763,"_29619":68730,"_20556":114315,"_5":14099,"_26939":114232,"_2865":114316},[],"`amqp.tls: true` selecciona AMQPS en todos los bloques de configuración del bus de eventos. El puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS, así que define `amqp.port` con el listener TLS del broker, normalmente `5671`.",{"_3379":68764,"_29619":68730,"_20556":114318,"_5":14099,"_26939":114232,"_2865":114319},[],"Sin un Secret de CA configurado, los clientes del bus de eventos usan las CA de confianza del sistema. Para confiar en una CA privada, crea un Secret en el namespace del release con el certificado de la CA en formato PEM y define `amqp.ca.secretName` (y `amqp.ca.certificateKey` si la clave de datos no es `ca.crt`).",{"_3379":68765,"_29619":68730,"_20556":114321,"_5":14099,"_26939":114232,"_2865":114322},[],"Para brokers que exijan TLS mutuo, crea un Secret con el certificado de cliente y su clave privada y define `amqp.client.secretName` (con `amqp.client.certificateKey` y `amqp.client.privateKeyKey` si las claves de datos no son `tls.crt` y `tls.key`).",{"_3379":68766,"_29619":68730,"_20556":114324,"_5":14099,"_26939":114232,"_2865":114325},[],"El chart monta los Secrets configurados en modo de solo lectura en todas las cargas de trabajo que consumen AMQP: el certificado de la CA en `/etc/lamassu/amqp/ca` y el certificado y la clave de cliente en `/etc/lamassu/amqp/client`. Los nombres de los archivos montados son siempre `ca.crt`, `tls.crt` y `tls.key` — los valores `certificateKey` y `privateKeyKey` renombran solo las claves de datos del Secret, nunca las rutas en disco. La clave privada del cliente se monta con permisos restrictivos (`defaultMode: 0440`; el volumen de la CA usa `0444`), que funcionan porque el chart añade `fsGroup` al security context del pod cuando `amqp.client.secretName` está definido — usa el `runAsGroup` del contenedor (por defecto `65532`) cuando `fsGroup` no está ya definido.",{"_3379":68767,"_29619":68730,"_20556":114327,"_5":14099,"_26939":114232,"_2865":114328},[],"Ambas opciones de Secret exigen `amqp.tls: true`: `values.schema.json` rechaza un `secretName` no vacío cuando `tls` es false, rechaza claves desconocidas y rechaza nombres de clave de datos fuera de `^[A-Za-z0-9._-]+$`. El Secret referenciado debe existir en el namespace del release o los pods consumidores no llegan a arrancar.",{"_3379":68768,"_29619":68730,"_20556":114330,"_5":14099,"_26939":114232,"_2865":114331},[],"El cliente AMQP carga los certificados al arrancar, así que reinicia los pods consumidores tras actualizar cualquiera de los dos Secrets. Cambiar cualquier valor de `amqp` reinicia las cargas de trabajo consumidoras mediante la anotación `checksum/config`, pero cambiar solo el contenido de un Secret no desencadena un rollout.",{"_3379":68769,"_29619":68730,"_20556":114333,"_5":14099,"_26939":114232,"_2865":114334},[],"Según la guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: en 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos usaban AMQP en claro; desde 4.0.0, `amqp.tls: true` los cambia a AMQPS. Define `amqp.port` con el listener TLS del broker antes del upgrade, o usa `amqp.tls: false` para mantener AMQP en claro. `amqp.tls: false` envía las credenciales del broker y todo el tráfico del bus de eventos en claro.",{"_3379":68770,"_29619":68730,"_20556":114336,"_5":14099,"_26939":114236,"_2865":114337},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3379":68771,"_29619":68730,"_20556":114339,"_5":14099,"_26939":114236,"_2865":114340},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3379":68772,"_29619":68730,"_20556":114342,"_5":14099,"_26939":114236,"_2865":114343},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3379":68773,"_29619":68730,"_20556":114345,"_5":14099,"_26939":114236,"_2865":114346},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3379":68774,"_29619":68730,"_20556":114348,"_5":14099,"_26939":114240,"_2865":114349},[],"Para instalar un checkout local:",{"_3379":68775,"_29619":68730,"_20556":114351,"_5":14099,"_26939":114244,"_2865":114352},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3379":68776,"_29619":68730,"_20556":114354,"_5":14099,"_26939":114244,"_2865":114355},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3379":68777,"_29619":68730,"_20556":114357,"_5":14099,"_26939":114248,"_2865":114358},[],"Los pasos de upgrade específicos de cada versión se mantienen en `charts/lamassu/CHANGELOG/` dentro del repositorio Helm. El chart también incluye un job de pre-upgrade opcional que migra las claves privadas de CA existentes al motor KMS configurado para el release. Está desactivado por defecto (`migrations.caToKms.enabled: false`) y solo es necesario cuando actualizas desde una versión anterior a 3.7.0.",{"_3379":68778,"_29619":68730,"_20556":114360,"_5":14099,"_26939":114248,"_2865":114361},[],"Mientras el flag esté activo, cada `helm upgrade` crea el job `<chart fullname>-ca-to-kms-migration` (`lamassu-ca-to-kms-migration` para el release `lamassu`); una instalación nueva no lo crea. Su hook weight es `-10`, por lo que se ejecuta antes de los otros hooks de pre-upgrade: la configuración de bootstrap de autorización (peso `-4`) y el job de migración de base de datos (peso `-3`).",{"_3379":68779,"_29619":68730,"_20556":114363,"_5":14099,"_26939":114248,"_2865":114364},[],"El job consume la misma configuración del servicio KMS que el chart renderiza en el ConfigMap de KMS, incluidos los motores de `services.kms.cryptoEngines`, y ejecuta la imagen de la herramienta de migración definida en `migrations.caToKms.image`. La monta en modo read-only en `/etc/lamassuiot/config.yml` desde la clave `config` del ConfigMap, así que configura el motor de destino en tus valores antes del upgrade que realiza la migración.",{"_3379":68780,"_29619":68730,"_20556":114366,"_5":14099,"_26939":114248,"_2865":114367},[],"El job resuelve su configuración mediante un volumen proyectado con dos fuentes opcionales: el ConfigMap `<chart fullname>-kms-config`, cuyo nombre incorpora el release (`lamassu-kms-config` para el release `lamassu`, `prod-lamassu-kms-config` para el release `prod`), y el ConfigMap legacy `kms-config`, sin el nombre del release, creado por versiones anteriores del chart. La configuración legacy mantiene la autoridad mientras siga presente y el job usa el ConfigMap del release una vez el legacy desaparece. Ambas fuentes son opcionales, por lo que un ConfigMap ausente nunca deja el pod del upgrade en `ContainerCreating`.",{"_3379":68781,"_29619":68730,"_20556":114369,"_5":14099,"_26939":114248,"_2865":114370},[],"Mantén `migrations.caToKms.enabled: true` en el upgrade que realiza la migración y elimina después el flag de tus valores una vez completada la migración; su valor por defecto es `false`.",{"_3379":68782,"_29619":68730,"_20556":114372,"_5":14099,"_26939":114252,"_2865":114373},[],"Antes de pasar a producción, revisa:",{"_3379":68783,"_29619":68730,"_20556":114375,"_5":14099,"_26939":114252,"_2865":114376},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3379":68784,"_29619":68730,"_20556":114378,"_5":14099,"_26939":114252,"_2865":114379},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3379":68785,"_29619":68730,"_20556":114381,"_5":14099,"_26939":114252,"_2865":114382},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3379":68786,"_29619":68730,"_20556":114384,"_5":14099,"_26939":114252,"_2865":114385},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3379":68787,"_29619":68730,"_20556":114387,"_5":14099,"_26939":114252,"_2865":114388},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3379":68788,"_29619":68730,"_20556":114390,"_5":14099,"_26939":114252,"_2865":114391},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3379":68789,"_29619":68730,"_20556":114393,"_5":14099,"_26939":114252,"_2865":114394},[],"SMTP, observabilidad y entrega de alertas",{"_3379":68790,"_29619":68730,"_20556":114396,"_5":14099,"_26939":114252,"_2865":114397},[],"las guías de actualización entre versiones y las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade, incluido el hook opcional de migración CA-to-KMS descrito arriba",{"_3379":68791,"_29619":68730,"_20556":114399,"_5":14099,"_26939":114252,"_2865":114400},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3379":68792,"_29619":68792,"_5":14457,"_2865":114402,"_29972":114403,"_20556":114404,"_26939":68792},"Expón el Gateway",[48223,113631,113865],[],{"_3379":68793,"_29619":68792,"_20556":114406,"_5":14099,"_26939":68792,"_2865":114407},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3379":68794,"_29619":68792,"_5":29969,"_20556":114409,"_26939":114410,"_2865":114411},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3379":68795,"_29619":68792,"_5":29969,"_20556":114413,"_26939":114414,"_2865":114415},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3379":68796,"_29619":68792,"_5":29969,"_20556":114417,"_26939":114418,"_2865":114419},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3379":68797,"_29619":68792,"_5":29969,"_20556":114421,"_26939":114422,"_2865":49049},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/networking#k3s",{"_3379":68798,"_29619":68792,"_5":29969,"_20556":114424,"_26939":114425,"_2865":114426},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3379":68799,"_29619":68792,"_5":29969,"_20556":114428,"_26939":114429,"_2865":114430},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3379":68800,"_29619":68792,"_5":29969,"_20556":114432,"_26939":114433,"_2865":114434},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3379":68801,"_29619":68792,"_5":29969,"_20556":114436,"_26939":114437,"_2865":114438},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3379":68802,"_29619":68792,"_5":29969,"_20556":114440,"_26939":114441,"_2865":114442},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/networking#proxy-de-salida","Proxy de salida",{"_3379":68803,"_29619":68792,"_5":29969,"_20556":114444,"_26939":114445,"_2865":114446},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3379":68804,"_29619":68792,"_20556":114448,"_5":14099,"_26939":114410,"_2865":114449},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3379":68805,"_29619":68792,"_20556":114451,"_5":14099,"_26939":114410,"_2865":114452},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3379":68806,"_29619":68792,"_20556":114454,"_5":14099,"_26939":114414,"_2865":114455},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3379":68807,"_29619":68792,"_20556":114457,"_5":14099,"_26939":114414,"_2865":114458},[],"Defínelo únicamente cuando:",{"_3379":68808,"_29619":68792,"_20556":114460,"_5":14099,"_26939":114414,"_2865":114461},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3379":68809,"_29619":68792,"_20556":114463,"_5":14099,"_26939":114414,"_2865":114464},[],"esa dirección está asignada a este Gateway",{"_3379":68810,"_29619":68792,"_20556":114466,"_5":14099,"_26939":114414,"_2865":114467},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3379":68811,"_29619":68792,"_20556":114469,"_5":14099,"_26939":114414,"_2865":114470},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3379":68812,"_29619":68792,"_20556":114472,"_5":14099,"_26939":114414,"_2865":114473},[],"No confundas estos valores:",{"_3379":68813,"_29619":68792,"_20556":114475,"_5":14099,"_26939":114414,"_2865":114476},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3379":68814,"_29619":68792,"_20556":114478,"_5":14099,"_26939":114414,"_2865":114479},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3379":68815,"_29619":68792,"_20556":114481,"_5":14099,"_26939":114414,"_2865":114482},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3379":68816,"_29619":68792,"_20556":114484,"_5":14099,"_26939":114418,"_2865":114485},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3379":68817,"_29619":68792,"_20556":114487,"_5":14099,"_26939":114418,"_2865":114488},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3379":68818,"_29619":68792,"_20556":114490,"_5":14099,"_26939":114422,"_2865":114491},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3379":68819,"_29619":68792,"_20556":114493,"_5":14099,"_26939":114422,"_2865":114494},[],"Para el diseño recomendado:",{"_3379":68820,"_29619":68792,"_20556":114496,"_5":14099,"_26939":114422,"_2865":114497},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3379":68821,"_29619":68792,"_20556":114499,"_5":14099,"_26939":114422,"_2865":114500},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3379":68822,"_29619":68792,"_20556":114502,"_5":14099,"_26939":114422,"_2865":114503},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3379":68823,"_29619":68792,"_20556":114505,"_5":14099,"_26939":114422,"_2865":114506},[],"Apunta DNS a la dirección accesible de la VM.",{"_3379":68824,"_29619":68792,"_20556":114508,"_5":14099,"_26939":114422,"_2865":114509},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3379":68825,"_29619":68792,"_20556":114511,"_5":14099,"_26939":114425,"_2865":114512},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3379":68826,"_29619":68792,"_20556":114514,"_5":14099,"_26939":114429,"_2865":114515},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3379":68827,"_29619":68792,"_20556":114517,"_5":14099,"_26939":114429,"_2865":114518},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3379":68828,"_29619":68792,"_20556":114520,"_5":14099,"_26939":114433,"_2865":114521},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3379":68829,"_29619":68792,"_20556":114523,"_5":14099,"_26939":114433,"_2865":114524},[],"Requisito",{"_3379":68830,"_29619":68792,"_20556":114526,"_5":14099,"_26939":114433,"_2865":114527},[],"Diseño recomendado",{"_3379":68831,"_29619":68792,"_20556":114529,"_5":14099,"_26939":114433,"_2865":114530},[],"Consecuencia",{"_3379":68832,"_29619":68792,"_20556":114532,"_5":14099,"_26939":114433,"_2865":114533},[],"Varias URL o servicios de Lamassu",{"_3379":68833,"_29619":68792,"_20556":114535,"_5":14099,"_26939":114433,"_2865":114536},[],"Un Gateway con varias rutas",{"_3379":68834,"_29619":68792,"_20556":114538,"_5":14099,"_26939":114433,"_2865":114539},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3379":68835,"_29619":68792,"_20556":114541,"_5":14099,"_26939":114433,"_2865":114542},[],"Gateways independientes e IP externas distintas",{"_3379":68836,"_29619":68792,"_20556":114544,"_5":14099,"_26939":114433,"_2865":114545},[],"Una VIP por Gateway",{"_3379":68837,"_29619":68792,"_20556":114547,"_5":14099,"_26939":114433,"_2865":114548},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3379":68838,"_29619":68792,"_20556":114550,"_5":14099,"_26939":114433,"_2865":114551},[],"Gateways independientes, un nodo y una IP",{"_3379":68839,"_29619":68792,"_20556":114553,"_5":14099,"_26939":114433,"_2865":114554},[],"Puertos externos diferentes",{"_3379":68840,"_29619":68792,"_20556":114556,"_5":14099,"_26939":114433,"_2865":114557},[],"Los clientes deben indicar puertos no estándar",{"_3379":68841,"_29619":68792,"_20556":114559,"_5":14099,"_26939":114433,"_2865":114560},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3379":68842,"_29619":68792,"_20556":114562,"_5":14099,"_26939":114433,"_2865":114563},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3379":68843,"_29619":68792,"_20556":114565,"_5":14099,"_26939":114433,"_2865":114566},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3379":68844,"_29619":68792,"_20556":114568,"_5":14099,"_26939":114433,"_2865":114569},[],"Recursos Gateway separados pero proxy compartido",{"_3379":68845,"_29619":68792,"_20556":114571,"_5":14099,"_26939":114433,"_2865":114572},[],"Modo merged Gateway de Envoy",{"_3379":68846,"_29619":68792,"_20556":114574,"_5":14099,"_26939":114433,"_2865":114575},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3379":68847,"_29619":68792,"_20556":114577,"_5":14099,"_26939":114433,"_2865":114578},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3379":68848,"_29619":68792,"_20556":114580,"_5":14099,"_26939":114433,"_2865":114581},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3379":68849,"_29619":68792,"_20556":114583,"_5":14099,"_26939":114433,"_2865":114584},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3379":68850,"_29619":68792,"_20556":114586,"_5":14099,"_26939":114433,"_2865":114587},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3379":68851,"_29619":68792,"_20556":114589,"_5":14099,"_26939":114437,"_2865":114590},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3379":68852,"_29619":68792,"_20556":114592,"_5":14099,"_26939":114437,"_2865":114593},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3379":68853,"_29619":68792,"_20556":114595,"_5":14099,"_26939":114437,"_2865":114596},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3379":68854,"_29619":68792,"_20556":114598,"_5":14099,"_26939":114437,"_2865":114599},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3379":68855,"_29619":68792,"_20556":114601,"_5":14099,"_26939":114437,"_2865":114602},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3379":68856,"_29619":68792,"_20556":114604,"_5":14099,"_26939":114441,"_2865":114605},[],"Los clientes internos de Lamassu — la conexión con el motor de Vault, las llamadas entre servicios y los webhooks salientes — respetan las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY`. La excepción es el conector del motor de autorización: usa su propio transporte y no consulta estas variables de proxy. Si tu despliegue enruta el tráfico de salida por un proxy, incluye los nombres de servicio internos del clúster en `NO_PROXY` (por ejemplo `.svc,.cluster.local`) para que el tráfico interno permanezca dentro del clúster. El tráfico de loopback nunca se envía por un proxy.",{"_3379":68857,"_29619":68792,"_20556":114607,"_5":14099,"_26939":114441,"_2865":114608},[],"El transporte predeterminado de estos clientes acota el timeout de conexión (30 segundos), el handshake TLS (10 segundos) y la reutilización de conexiones inactivas (90 segundos), de modo que una dependencia inalcanzable falla rápido en lugar de bloquearse; estos valores son los predeterminados del transporte de Go, no configuración de Lamassu. HTTP/2 se negocia cuando el otro extremo lo soporta. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada.",{"_3379":68858,"_29619":68792,"_20556":114610,"_5":14099,"_26939":114445,"_2865":114611},[],"Comprueba, en orden:",{"_3379":68859,"_29619":68792,"_20556":114613,"_5":14099,"_26939":114445,"_2865":114614},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3379":68860,"_29619":68792,"_20556":114616,"_5":14099,"_26939":114445,"_2865":114617},[],"Su estado contiene la dirección esperada.",{"_3379":68861,"_29619":68792,"_20556":114619,"_5":14099,"_26939":114445,"_2865":114620},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3379":68862,"_29619":68792,"_20556":114622,"_5":14099,"_26939":114445,"_2865":114623},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3379":68863,"_29619":68792,"_20556":114625,"_5":14099,"_26939":114445,"_2865":114626},[],"DNS resuelve al endpoint accesible externamente.",{"_3379":68864,"_29619":68792,"_20556":114628,"_5":14099,"_26939":114445,"_2865":114629},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3379":68865,"_29619":68792,"_20556":114631,"_5":14099,"_26939":114445,"_2865":114632},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3379":68866,"_29619":68866,"_5":14457,"_2865":48330,"_29972":114634,"_20556":114635,"_26939":68866},[48223,113631,113865],[],{"_3379":68867,"_29619":68866,"_20556":114637,"_5":14099,"_26939":68866,"_2865":114638},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3379":68868,"_29619":68866,"_5":29969,"_20556":114640,"_26939":114641,"_2865":114642},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3379":68869,"_29619":68866,"_5":29969,"_20556":114644,"_26939":114645,"_2865":114646},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3379":68870,"_29619":68866,"_5":29969,"_20556":114648,"_26939":114649,"_2865":114650},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3379":68871,"_29619":68866,"_5":29969,"_20556":114652,"_26939":114653,"_2865":114654},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3379":68872,"_29619":68866,"_5":29969,"_20556":114656,"_26939":114657,"_2865":114658},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3379":68873,"_29619":68866,"_5":29969,"_20556":114660,"_26939":114661,"_2865":114662},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3379":68874,"_29619":68866,"_20556":114664,"_5":14099,"_26939":114641,"_2865":114665},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3379":68875,"_29619":68866,"_20556":114667,"_5":14099,"_26939":114645,"_2865":114668},[],"Flujo",{"_3379":68876,"_29619":68866,"_20556":114670,"_5":14099,"_26939":114645,"_2865":114671},[],"Úsalo para",{"_3379":68877,"_29619":68866,"_20556":114673,"_5":14099,"_26939":114645,"_2865":114674},[],"Qué instala",{"_3379":68878,"_29619":68866,"_20556":114676,"_5":14099,"_26939":114645,"_2865":49304},[],{"_3379":68879,"_29619":68866,"_20556":114678,"_5":14099,"_26939":114645,"_2865":114679},[],"Producción y entornos controlados",{"_3379":68880,"_29619":68866,"_20556":114681,"_5":14099,"_26939":114645,"_2865":114682},[],"Servicios de Lamassu y recursos de Gateway API",{"_3379":68881,"_29619":68866,"_20556":114684,"_5":14099,"_26939":114645,"_2865":48467},[],{"_3379":68882,"_29619":68866,"_20556":114686,"_5":14099,"_26939":114645,"_2865":114687},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3379":68883,"_29619":68866,"_20556":114689,"_5":14099,"_26939":114645,"_2865":114690},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3379":68884,"_29619":68866,"_20556":114692,"_5":14099,"_26939":114649,"_2865":114693},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3379":68885,"_29619":68866,"_20556":114695,"_5":14099,"_26939":114649,"_2865":114696},[],"Área",{"_3379":68886,"_29619":68866,"_20556":114698,"_5":14099,"_26939":114649,"_2865":114699},[],"El chart de Lamassu proporciona",{"_3379":68887,"_29619":68866,"_20556":114701,"_5":14099,"_26939":114649,"_2865":114702},[],"Tú proporcionas",{"_3379":68888,"_29619":68866,"_20556":114704,"_5":14099,"_26939":114649,"_2865":114705},[],"Aplicaciones Lamassu",{"_3379":68889,"_29619":68866,"_20556":114707,"_5":14099,"_26939":114649,"_2865":114708},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3379":68890,"_29619":68866,"_20556":114710,"_5":14099,"_26939":114649,"_2865":114711},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3379":68891,"_29619":68866,"_20556":114713,"_5":14099,"_26939":114649,"_2865":114714},[],"Datos PostgreSQL",{"_3379":68892,"_29619":68866,"_20556":114716,"_5":14099,"_26939":114649,"_2865":114717},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3379":68893,"_29619":68866,"_20556":114719,"_5":14099,"_26939":114649,"_2865":114720},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3379":68894,"_29619":68866,"_20556":114722,"_5":14099,"_26939":114649,"_2865":114723},[],"Mensajería",{"_3379":68895,"_29619":68866,"_20556":114725,"_5":14099,"_26939":114649,"_2865":114726},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu; la conexión puede usar AMQPS, con una CA privada y un certificado de cliente opcionales, definidos mediante valores del chart",{"_3379":68896,"_29619":68866,"_20556":114728,"_5":14099,"_26939":114649,"_2865":114729},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3379":68897,"_29619":68866,"_20556":114731,"_5":14099,"_26939":114649,"_2865":114732},[],"Identidad",{"_3379":68898,"_29619":68866,"_20556":114734,"_5":14099,"_26939":114649,"_2865":114735},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3379":68899,"_29619":68866,"_20556":114737,"_5":14099,"_26939":114649,"_2865":114738},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3379":68900,"_29619":68866,"_20556":114740,"_5":14099,"_26939":114649,"_2865":114741},[],"Enrutamiento externo",{"_3379":68901,"_29619":68866,"_20556":114743,"_5":14099,"_26939":114649,"_2865":114744},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3379":68902,"_29619":68866,"_20556":114746,"_5":14099,"_26939":114649,"_2865":114747},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3379":68903,"_29619":68866,"_20556":114749,"_5":14099,"_26939":114649,"_2865":49378},[],{"_3379":68904,"_29619":68866,"_20556":114751,"_5":14099,"_26939":114649,"_2865":114752},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_3379":68905,"_29619":68866,"_20556":114754,"_5":14099,"_26939":114649,"_2865":114755},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3379":68906,"_29619":68866,"_20556":114757,"_5":14099,"_26939":114649,"_2865":114758},[],"Datos persistentes de la aplicación",{"_3379":68907,"_29619":68866,"_20556":114760,"_5":14099,"_26939":114649,"_2865":114761},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3379":68908,"_29619":68866,"_20556":114763,"_5":14099,"_26939":114649,"_2865":114764},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3379":68909,"_29619":68866,"_20556":114766,"_5":14099,"_26939":114649,"_2865":114767},[],"Integraciones opcionales",{"_3379":68910,"_29619":68866,"_20556":114769,"_5":14099,"_26939":114649,"_2865":114770},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3379":68911,"_29619":68866,"_20556":114772,"_5":14099,"_26939":114649,"_2865":114773},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3379":68912,"_29619":68866,"_20556":114775,"_5":14099,"_26939":114649,"_2865":114776},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3379":68913,"_29619":68866,"_20556":114778,"_5":14099,"_26939":114649,"_2865":114779},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3379":68914,"_29619":68866,"_20556":114781,"_5":14099,"_26939":114653,"_2865":114782},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3379":68915,"_29619":68866,"_20556":114784,"_5":14099,"_26939":114653,"_2865":114785},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3379":68916,"_29619":68866,"_20556":114787,"_5":14099,"_26939":114657,"_2865":114788},[],"Kubernetes 1.24 o posterior",{"_3379":68917,"_29619":68866,"_20556":114790,"_5":14099,"_26939":114657,"_2865":114791},[],"Helm 3.2 o posterior",{"_3379":68918,"_29619":68866,"_20556":114793,"_5":14099,"_26939":114657,"_2865":114794},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3379":68919,"_29619":68866,"_20556":114796,"_5":14099,"_26939":114657,"_2865":114797},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_3379":68920,"_29619":68866,"_20556":114799,"_5":14099,"_26939":114657,"_2865":114800},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3379":68921,"_29619":68866,"_20556":114802,"_5":14099,"_26939":114657,"_2865":114803},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3379":68922,"_29619":68866,"_20556":114805,"_5":14099,"_26939":114657,"_2865":114806},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3379":68923,"_29619":68866,"_20556":114808,"_5":14099,"_26939":114661,"_2865":114809},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3379":68924,"_29619":68866,"_20556":114811,"_5":14099,"_26939":114661,"_2865":114812},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3379":68925,"_29619":68866,"_20556":114814,"_5":14099,"_26939":114661,"_2865":114815},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3379":68926,"_29619":68866,"_20556":114817,"_5":14099,"_26939":114661,"_2865":114818},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3379":68927,"_29619":68927,"_5":14457,"_2865":114820,"_29972":114821,"_20556":114823,"_26939":68927},"Resolución de problemas de despliegue",[48223,113631,114822],"Operación",[],{"_3379":68928,"_29619":68927,"_20556":114825,"_5":14099,"_26939":68927,"_2865":114826},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3379":68929,"_29619":68927,"_5":29969,"_20556":114828,"_26939":114829,"_2865":114830},[],"/docs/pr-preview/pr-53/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3379":68930,"_29619":68927,"_5":29969,"_20556":114832,"_26939":114833,"_2865":114834},[],"/docs/pr-preview/pr-53/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3379":68931,"_29619":68927,"_5":29969,"_20556":114836,"_26939":114837,"_2865":114838},[],"/docs/pr-preview/pr-53/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3379":68932,"_29619":68927,"_5":29969,"_20556":114840,"_26939":114841,"_2865":114842},[],"/docs/pr-preview/pr-53/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3379":68933,"_29619":68927,"_5":29969,"_20556":114844,"_26939":114845,"_2865":114846},[],"/docs/pr-preview/pr-53/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3379":68934,"_29619":68927,"_5":29969,"_20556":114848,"_26939":114849,"_2865":114850},[],"/docs/pr-preview/pr-53/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3379":68935,"_29619":68927,"_5":29969,"_20556":114852,"_26939":114853,"_2865":114854},[],"/docs/pr-preview/pr-53/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3379":68936,"_29619":68927,"_5":29969,"_20556":114856,"_26939":114857,"_2865":114858},[],"/docs/pr-preview/pr-53/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3379":68937,"_29619":68927,"_5":29969,"_20556":114860,"_26939":114861,"_2865":114862},[],"/docs/pr-preview/pr-53/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3379":68938,"_29619":68927,"_5":29969,"_20556":114864,"_26939":114865,"_2865":114866},[],"/docs/pr-preview/pr-53/es/deployment/troubleshooting#errores-500-de-la-api","Errores 500 de la API",{"_3379":68939,"_29619":68927,"_5":29969,"_20556":114868,"_26939":114869,"_2865":114870},[],"/docs/pr-preview/pr-53/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3379":68940,"_29619":68927,"_5":29969,"_20556":114872,"_26939":114873,"_2865":114874},[],"/docs/pr-preview/pr-53/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3379":68941,"_29619":68927,"_5":29969,"_20556":114876,"_26939":114877,"_2865":114878},[],"/docs/pr-preview/pr-53/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3379":68942,"_29619":68927,"_20556":114880,"_5":14099,"_26939":68927,"_2865":114881},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3379":68943,"_29619":68927,"_20556":114883,"_5":14099,"_26939":114833,"_2865":114884},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3379":68944,"_29619":68927,"_20556":114886,"_5":14099,"_26939":114837,"_2865":114887},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3379":68945,"_29619":68927,"_20556":114889,"_5":14099,"_26939":114841,"_2865":114890},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3379":68946,"_29619":68927,"_20556":114892,"_5":14099,"_26939":114845,"_2865":114893},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3379":68947,"_29619":68927,"_20556":114895,"_5":14099,"_26939":114849,"_2865":114896},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3379":68948,"_29619":68927,"_20556":114898,"_5":14099,"_26939":114853,"_2865":114899},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3379":68949,"_29619":68927,"_20556":114901,"_5":14099,"_26939":114853,"_2865":114902},[],"Ejecuta también la prueba de conectividad del chart:",{"_3379":68950,"_29619":68927,"_20556":114904,"_5":14099,"_26939":114853,"_2865":114905},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3379":68951,"_29619":68927,"_20556":114907,"_5":14099,"_26939":114853,"_2865":114908},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3379":68952,"_29619":68927,"_20556":114910,"_5":14099,"_26939":114857,"_2865":114911},[],"Si recibes un 401:",{"_3379":68953,"_29619":68927,"_20556":114913,"_5":14099,"_26939":114857,"_2865":114914},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3379":68954,"_29619":68927,"_20556":114916,"_5":14099,"_26939":114857,"_2865":114917},[],"verifica emisor, audiencia y expiración del token;",{"_3379":68955,"_29619":68927,"_20556":114919,"_5":14099,"_26939":114857,"_2865":114920},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3379":68956,"_29619":68927,"_20556":114922,"_5":14099,"_26939":114857,"_2865":114923},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3379":68957,"_29619":68927,"_20556":114925,"_5":14099,"_26939":114857,"_2865":114926},[],"Si el login termina pero las APIs devuelven 403:",{"_3379":68958,"_29619":68927,"_20556":114928,"_5":14099,"_26939":114857,"_2865":114929},[],"inspecciona los claims reales del token;",{"_3379":68959,"_29619":68927,"_20556":114931,"_5":14099,"_26939":114857,"_2865":114932},[],"confirma que coinciden con un principal activo;",{"_3379":68960,"_29619":68927,"_20556":114934,"_5":14099,"_26939":114857,"_2865":114935},[],"revisa las políticas concedidas al principal;",{"_3379":68961,"_29619":68927,"_20556":114937,"_5":14099,"_26939":114857,"_2865":114938},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3379":68962,"_29619":68927,"_20556":114940,"_5":14099,"_26939":114857,"_2865":114941},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3379":68963,"_29619":68927,"_20556":114943,"_5":14099,"_26939":114861,"_2865":114944},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3379":68964,"_29619":68927,"_20556":114946,"_5":14099,"_26939":114861,"_2865":114947},[],"Localiza el pod y Service de authz.",{"_3379":68965,"_29619":68927,"_20556":114949,"_5":14099,"_26939":114861,"_2865":114950},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3379":68966,"_29619":68927,"_20556":114952,"_5":14099,"_26939":114861,"_2865":114953},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3379":68967,"_29619":68927,"_20556":114955,"_5":14099,"_26939":114861,"_2865":114956},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3379":68968,"_29619":68927,"_20556":114958,"_5":14099,"_26939":114861,"_2865":114959},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3379":68969,"_29619":68927,"_20556":114961,"_5":14099,"_26939":114865,"_2865":114962},[],"Un 500 indica un fallo interno, como una base de datos no disponible. El cuerpo `{\"err\": ...}` incluye hoy el texto del error interno, que puede contener nombres de esquema, tabla y restricción y, en fallos de conexión, el host y el usuario de la base de datos (no la contraseña). Localiza la causa en el log del servicio con la hora de la petición, y no reenvíes el cuerpo a terceros ni lo muestres a usuarios finales. Es un defecto conocido de divulgación de información: está previsto devolver un mensaje genérico en los 500 y dejar el detalle solo en el log del servicio (seguimiento en lamassuiot#814). El conector de autorización también devuelve el error interno, en el campo `details.error`. Algunos errores de petición, como un tamaño de clave que el motor no admite, se devuelven también como 500.",{"_3379":68970,"_29619":68927,"_20556":114964,"_5":14099,"_26939":114869,"_2865":114965},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3379":68971,"_29619":68927,"_20556":114967,"_5":14099,"_26939":114869,"_2865":114968},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3379":68972,"_29619":68927,"_20556":114970,"_5":14099,"_26939":114869,"_2865":114971},[],"un Secret de CA o de certificado de cliente de AMQP inexistente referenciado por `amqp.ca.secretName` o `amqp.client.secretName`;",{"_3379":68973,"_29619":68927,"_20556":114973,"_5":14099,"_26939":114869,"_2865":114974},[],"volumen persistente sin enlazar;",{"_3379":68974,"_29619":68927,"_20556":114976,"_5":14099,"_26939":114869,"_2865":114977},[],"imagen inaccesible o política de pull incorrecta;",{"_3379":68975,"_29619":68927,"_20556":114979,"_5":14099,"_26939":114869,"_2865":114980},[],"configuración inválida del motor criptográfico;",{"_3379":68976,"_29619":68927,"_20556":114982,"_5":14099,"_26939":114869,"_2865":114983},[],"límites de CPU o memoria demasiado bajos;",{"_3379":68977,"_29619":68927,"_20556":114985,"_5":14099,"_26939":114869,"_2865":114986},[],"migración previa incompleta.",{"_3379":68978,"_29619":68927,"_20556":114988,"_5":14099,"_26939":114869,"_2865":114989},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3379":68979,"_29619":68927,"_20556":114991,"_5":14099,"_26939":114869,"_2865":114992},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3379":68980,"_29619":68927,"_20556":114994,"_5":14099,"_26939":114869,"_2865":114995},[],"Las llamadas internas ahora fallan rápido en lugar de bloquearse para los clientes cubiertos por Proxy de salida: los intentos de conexión agotan el tiempo tras 30 segundos y los handshakes TLS tras 10 segundos. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada. Si un proxy de salida gestiona el tráfico de salida del clúster, comprueba las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY` del pod e incluye los nombres de servicio internos en `NO_PROXY`.",{"_3379":68981,"_29619":68927,"_20556":114997,"_5":14099,"_26939":114873,"_2865":114998},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3379":68982,"_29619":68927,"_20556":115000,"_5":14099,"_26939":114873,"_2865":115001},[],"verifica que esté habilitado en el servicio emisor;",{"_3379":68983,"_29619":68927,"_20556":115003,"_5":14099,"_26939":114873,"_2865":115004},[],"comprueba conectividad y credenciales AMQP;",{"_3379":68984,"_29619":68927,"_20556":115006,"_5":14099,"_26939":114873,"_2865":115007},[],"revisa exchange, routing key, colas y consumidores;",{"_3379":68985,"_29619":68927,"_20556":115009,"_5":14099,"_26939":114873,"_2865":115010},[],"inspecciona dead-letter queues;",{"_3379":68986,"_29619":68927,"_20556":115012,"_5":14099,"_26939":114873,"_2865":115013},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3379":68987,"_29619":68927,"_20556":115015,"_5":14099,"_26939":114873,"_2865":115016},[],"Si `amqp.tls` está habilitado, revisa también la parte TLS:",{"_3379":68988,"_29619":68927,"_20556":115018,"_5":14099,"_26939":114873,"_2865":115019},[],"confirma que el listener del broker hable AMQPS en el puerto configurado — el puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS;",{"_3379":68989,"_29619":68927,"_20556":115021,"_5":14099,"_26939":114873,"_2865":115022},[],"si defines `amqp.ca.secretName`, confirma que el Secret exista en el namespace del release y que su clave de datos coincida con `amqp.ca.certificateKey` (por defecto `ca.crt`); si no defines `amqp.ca.secretName`, los clientes confían en las CA del sistema;",{"_3379":68990,"_29619":68927,"_20556":115024,"_5":14099,"_26939":114873,"_2865":115025},[],"recuerda que un Secret referenciado inexistente impide arrancar los pods consumidores;",{"_3379":68991,"_29619":68927,"_20556":115027,"_5":14099,"_26939":114873,"_2865":115028},[],"tras actualizar el Secret de la CA o del certificado de cliente, reinicia los pods consumidores: el cliente AMQP carga los certificados al arrancar.",{"_3379":68992,"_29619":68927,"_20556":115030,"_5":14099,"_26939":114873,"_2865":115031},[],"Consulta TLS de AMQP (AMQPS) para la configuración completa.",{"_3379":68993,"_29619":68927,"_20556":115033,"_5":14099,"_26939":114873,"_2865":115034},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3379":68994,"_29619":68927,"_20556":115036,"_5":14099,"_26939":114877,"_2865":115037},[],"El chart puede habilitar la instrumentación OpenTelemetry para los servicios que la admiten, incluido authz; no configura OpenTelemetry para el AWS Connector, wfx ni la UI. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, servicio y dependencia.",{"_3379":68995,"_29619":68927,"_20556":115039,"_5":14099,"_26939":114877,"_2865":115040},[],"Antes de cerrar una incidencia, guarda:",{"_3379":68996,"_29619":68927,"_20556":115042,"_5":14099,"_26939":114877,"_2865":115043},[],"causa confirmada;",{"_3379":68997,"_29619":68927,"_20556":115045,"_5":14099,"_26939":114877,"_2865":115046},[],"alcance temporal y recursos afectados;",{"_3379":68998,"_29619":68927,"_20556":115048,"_5":14099,"_26939":114877,"_2865":115049},[],"comandos o consultas utilizados;",{"_3379":68999,"_29619":68927,"_20556":115051,"_5":14099,"_26939":114877,"_2865":115052},[],"cambio aplicado y forma de revertirlo;",{"_3379":69000,"_29619":68927,"_20556":115054,"_5":14099,"_26939":114877,"_2865":115055},[],"validación desde un consumidor;",{"_3379":69001,"_29619":68927,"_20556":115057,"_5":14099,"_26939":114877,"_2865":115058},[],"acción preventiva y propietario.",{"_3379":69002,"_29619":69002,"_5":14457,"_2865":115060,"_29972":115061,"_20556":115064,"_26939":69002},"Control de acceso",[48223,115062,115063],"Plataforma","Administración",[],{"_3379":69003,"_29619":69002,"_20556":115066,"_5":14099,"_26939":69002,"_2865":115067},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3379":69004,"_29619":69002,"_5":29969,"_20556":115069,"_26939":115070,"_2865":115071},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3379":69005,"_29619":69002,"_5":29969,"_20556":115073,"_26939":115074,"_2865":115075},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3379":69006,"_29619":69002,"_5":29969,"_20556":115077,"_26939":115078,"_2865":115079},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3379":69007,"_29619":69002,"_5":29969,"_20556":115081,"_26939":115082,"_2865":115083},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3379":69008,"_29619":69002,"_5":29969,"_20556":115085,"_26939":115086,"_2865":115087},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3379":69009,"_29619":69002,"_5":29969,"_20556":115089,"_26939":115090,"_2865":115091},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3379":69010,"_29619":69002,"_5":29969,"_20556":115093,"_26939":115094,"_2865":115095},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3379":69011,"_29619":69002,"_5":29969,"_20556":115097,"_26939":115098,"_2865":115099},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3379":69012,"_29619":69002,"_5":29969,"_20556":115101,"_26939":115102,"_2865":115103},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3379":69013,"_29619":69002,"_5":29969,"_20556":115105,"_26939":115106,"_2865":115107},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3379":69014,"_29619":69002,"_5":29969,"_20556":115109,"_26939":115110,"_2865":115111},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3379":69015,"_29619":69002,"_5":29969,"_20556":115113,"_26939":115114,"_2865":115115},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3379":69016,"_29619":69002,"_5":29969,"_20556":115117,"_26939":115118,"_2865":115119},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3379":69017,"_29619":69002,"_5":29969,"_20556":115121,"_26939":115122,"_2865":115123},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3379":69018,"_29619":69002,"_5":29969,"_20556":115125,"_26939":115126,"_2865":115127},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3379":69019,"_29619":69002,"_5":29969,"_20556":115129,"_26939":115130,"_2865":114237},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3379":69020,"_29619":69002,"_5":29969,"_20556":115132,"_26939":115133,"_2865":115134},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3379":69021,"_29619":69002,"_5":29969,"_20556":115136,"_26939":115137,"_2865":115138},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_3379":69022,"_29619":69002,"_5":29969,"_20556":115140,"_26939":115141,"_2865":115142},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3379":69023,"_29619":69002,"_5":29969,"_20556":115144,"_26939":115145,"_2865":115146},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3379":69024,"_29619":69002,"_5":29969,"_20556":115148,"_26939":115149,"_2865":115150},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3379":69025,"_29619":69002,"_5":29969,"_20556":115152,"_26939":115153,"_2865":115154},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3379":69026,"_29619":69002,"_5":29969,"_20556":115156,"_26939":115157,"_2865":115158},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3379":69027,"_29619":69002,"_5":29969,"_20556":115160,"_26939":115161,"_2865":115162},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3379":69028,"_29619":69002,"_5":29969,"_20556":115164,"_26939":115165,"_2865":115166},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3379":69029,"_29619":69002,"_5":29969,"_20556":115168,"_26939":115169,"_2865":115170},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3379":69030,"_29619":69002,"_5":29969,"_20556":115172,"_26939":115173,"_2865":115174},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3379":69031,"_29619":69002,"_5":29969,"_20556":115176,"_26939":115177,"_2865":115178},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3379":69032,"_29619":69002,"_5":29969,"_20556":115180,"_26939":115181,"_2865":115182},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3379":69033,"_29619":69002,"_5":29969,"_20556":115184,"_26939":115185,"_2865":115186},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3379":69034,"_29619":69002,"_5":29969,"_20556":115188,"_26939":115189,"_2865":115190},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3379":69035,"_29619":69002,"_20556":115192,"_5":14099,"_26939":69002,"_2865":115193},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3379":69036,"_29619":69002,"_20556":115195,"_5":14099,"_26939":69002,"_2865":115196},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3379":69037,"_29619":69002,"_20556":115198,"_5":14099,"_26939":69002,"_2865":115199},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3379":69038,"_29619":69002,"_20556":115201,"_5":14099,"_26939":115070,"_2865":115202},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3379":69039,"_29619":69002,"_20556":115204,"_5":14099,"_26939":115070,"_2865":115205},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3379":69040,"_29619":69002,"_20556":115207,"_5":14099,"_26939":115070,"_2865":115208},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3379":69041,"_29619":69002,"_20556":115210,"_5":14099,"_26939":115070,"_2865":115211},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3379":69042,"_29619":69002,"_20556":115213,"_5":14099,"_26939":115070,"_2865":115214},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3379":69043,"_29619":69002,"_20556":115216,"_5":14099,"_26939":115070,"_2865":115217},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3379":69044,"_29619":69002,"_20556":115219,"_5":14099,"_26939":115074,"_2865":115220},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3379":69045,"_29619":69002,"_20556":115222,"_5":14099,"_26939":115074,"_2865":115223},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3379":69046,"_29619":69002,"_20556":115225,"_5":14099,"_26939":115078,"_2865":115226},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3379":69047,"_29619":69002,"_20556":115228,"_5":14099,"_26939":115078,"_2865":115229},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3379":69048,"_29619":69002,"_20556":115231,"_5":14099,"_26939":115078,"_2865":115232},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3379":69049,"_29619":69002,"_20556":115234,"_5":14099,"_26939":115078,"_2865":115235},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3379":69050,"_29619":69002,"_20556":115237,"_5":14099,"_26939":115078,"_2865":115238},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3379":69051,"_29619":69002,"_20556":115240,"_5":14099,"_26939":115078,"_2865":115241},[],"Carga por separado las políticas concedidas a cada principal.",{"_3379":69052,"_29619":69002,"_20556":115243,"_5":14099,"_26939":115078,"_2865":115244},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3379":69053,"_29619":69002,"_20556":115246,"_5":14099,"_26939":115078,"_2865":115247},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3379":69054,"_29619":69002,"_20556":115249,"_5":14099,"_26939":115078,"_2865":115250},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3379":69055,"_29619":69002,"_20556":115252,"_5":14099,"_26939":115078,"_2865":115253},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3379":69056,"_29619":69002,"_20556":115255,"_5":14099,"_26939":115078,"_2865":115256},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad.",{"_3379":69057,"_29619":69002,"_20556":115258,"_5":14099,"_26939":115078,"_2865":115259},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3379":69058,"_29619":69002,"_20556":115261,"_5":14099,"_26939":115082,"_2865":115262},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3379":69059,"_29619":69002,"_20556":115264,"_5":14099,"_26939":115082,"_2865":115265},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3379":69060,"_29619":69002,"_20556":115267,"_5":14099,"_26939":115082,"_2865":115268},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3379":69061,"_29619":69002,"_20556":115270,"_5":14099,"_26939":115082,"_2865":115271},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3379":69062,"_29619":69002,"_20556":115273,"_5":14099,"_26939":115082,"_2865":115274},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3379":69063,"_29619":69002,"_20556":115276,"_5":14099,"_26939":115082,"_2865":115277},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3379":69064,"_29619":69002,"_20556":115279,"_5":14099,"_26939":115082,"_2865":115280},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3379":69065,"_29619":69002,"_20556":115282,"_5":14099,"_26939":115082,"_2865":115283},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3379":69066,"_29619":69002,"_20556":115285,"_5":14099,"_26939":115086,"_2865":115286},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3379":69067,"_29619":69002,"_20556":115288,"_5":14099,"_26939":115086,"_2865":115289},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3379":69068,"_29619":69002,"_20556":115291,"_5":14099,"_26939":115086,"_2865":115292},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3379":69069,"_29619":69002,"_20556":115294,"_5":14099,"_26939":115086,"_2865":115295},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3379":69070,"_29619":69002,"_20556":115297,"_5":14099,"_26939":115086,"_2865":115298},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3379":69071,"_29619":69002,"_20556":115300,"_5":14099,"_26939":115086,"_2865":115301},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3379":69072,"_29619":69002,"_20556":115303,"_5":14099,"_26939":115086,"_2865":115304},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3379":69073,"_29619":69002,"_20556":115306,"_5":14099,"_26939":115086,"_2865":115307},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3379":69074,"_29619":69002,"_20556":115309,"_5":14099,"_26939":115086,"_2865":115310},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3379":69075,"_29619":69002,"_20556":115312,"_5":14099,"_26939":115086,"_2865":115313},[],"Las acciones se dividen en dos grupos:",{"_3379":69076,"_29619":69002,"_20556":115315,"_5":14099,"_26939":115086,"_2865":115316},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3379":69077,"_29619":69002,"_20556":115318,"_5":14099,"_26939":115086,"_2865":115319},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3379":69078,"_29619":69002,"_20556":115321,"_5":14099,"_26939":115086,"_2865":115322},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3379":69079,"_29619":69002,"_20556":115324,"_5":14099,"_26939":115090,"_2865":115325},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3379":69080,"_29619":69002,"_20556":115327,"_5":14099,"_26939":115090,"_2865":115328},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3379":69081,"_29619":69002,"_20556":115330,"_5":14099,"_26939":115090,"_2865":115331},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3379":69082,"_29619":69002,"_20556":115333,"_5":14099,"_26939":115094,"_2865":115334},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3379":69083,"_29619":69002,"_20556":115336,"_5":14099,"_26939":115094,"_2865":115337},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3379":69084,"_29619":69002,"_20556":115339,"_5":14099,"_26939":115094,"_2865":115340},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3379":69085,"_29619":69002,"_20556":115342,"_5":14099,"_26939":115094,"_2865":115343},[],"Los operadores implementados son:",{"_3379":69086,"_29619":69002,"_20556":115345,"_5":14099,"_26939":115094,"_2865":115346},[],"`equals`, para igualdad exacta;",{"_3379":69087,"_29619":69002,"_20556":115348,"_5":14099,"_26939":115094,"_2865":115349},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3379":69088,"_29619":69002,"_20556":115351,"_5":14099,"_26939":115094,"_2865":115352},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3379":69089,"_29619":69002,"_20556":115354,"_5":14099,"_26939":115094,"_2865":115355},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3379":69090,"_29619":69002,"_20556":115357,"_5":14099,"_26939":115098,"_2865":115358},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3379":69091,"_29619":69002,"_20556":115360,"_5":14099,"_26939":115098,"_2865":115361},[],"Los modos disponibles son:",{"_3379":69092,"_29619":69002,"_20556":115363,"_5":14099,"_26939":115098,"_2865":115364},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3379":69093,"_29619":69002,"_20556":115366,"_5":14099,"_26939":115098,"_2865":115367},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3379":69094,"_29619":69002,"_20556":115369,"_5":14099,"_26939":115098,"_2865":115370},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3379":69095,"_29619":69002,"_20556":115372,"_5":14099,"_26939":115098,"_2865":115373},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3379":69096,"_29619":69002,"_20556":115375,"_5":14099,"_26939":115098,"_2865":115376},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3379":69097,"_29619":69002,"_20556":115378,"_5":14099,"_26939":115098,"_2865":115379},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3379":69098,"_29619":69002,"_20556":115381,"_5":14099,"_26939":115102,"_2865":115382},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3379":69099,"_29619":69002,"_20556":115384,"_5":14099,"_26939":115102,"_2865":115385},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3379":69100,"_29619":69002,"_20556":115387,"_5":14099,"_26939":115102,"_2865":115388},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3379":69101,"_29619":69002,"_20556":115390,"_5":14099,"_26939":115102,"_2865":115391},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3379":69102,"_29619":69002,"_20556":115393,"_5":14099,"_26939":115110,"_2865":115394},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3379":69103,"_29619":69002,"_20556":115396,"_5":14099,"_26939":115110,"_2865":115397},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3379":69104,"_29619":69002,"_20556":115399,"_5":14099,"_26939":115114,"_2865":115400},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora y la de un dispositivo con su DMS. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3379":69105,"_29619":69002,"_20556":115402,"_5":14099,"_26939":115114,"_2865":115403},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3379":69106,"_29619":69002,"_20556":115405,"_5":14099,"_26939":115118,"_2865":115406},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3379":69107,"_29619":69002,"_20556":115408,"_5":14099,"_26939":115118,"_2865":115409},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3379":69108,"_29619":69002,"_20556":115411,"_5":14099,"_26939":115118,"_2865":115412},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3379":69109,"_29619":69002,"_20556":115414,"_5":14099,"_26939":115122,"_2865":115415},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3379":69110,"_29619":69002,"_20556":115417,"_5":14099,"_26939":115122,"_2865":115418},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3379":69111,"_29619":69002,"_20556":115420,"_5":14099,"_26939":115122,"_2865":115421},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3379":69112,"_29619":69002,"_20556":115423,"_5":14099,"_26939":115122,"_2865":115424},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3379":69113,"_29619":69002,"_20556":115426,"_5":14099,"_26939":115122,"_2865":115427},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3379":69114,"_29619":69002,"_20556":115429,"_5":14099,"_26939":115122,"_2865":115430},[],"Ten en cuenta que:",{"_3379":69115,"_29619":69002,"_20556":115432,"_5":14099,"_26939":115122,"_2865":115433},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3379":69116,"_29619":69002,"_20556":115435,"_5":14099,"_26939":115122,"_2865":115436},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3379":69117,"_29619":69002,"_20556":115438,"_5":14099,"_26939":115122,"_2865":115439},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3379":69118,"_29619":69002,"_20556":115441,"_5":14099,"_26939":115126,"_2865":115442},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3379":69119,"_29619":69002,"_20556":115444,"_5":14099,"_26939":115126,"_2865":115445},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3379":69120,"_29619":69002,"_20556":115447,"_5":14099,"_26939":115126,"_2865":115448},[],"acceso completo y de solo lectura a KMS;",{"_3379":69121,"_29619":69002,"_20556":115450,"_5":14099,"_26939":115126,"_2865":115451},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3379":69122,"_29619":69002,"_20556":115453,"_5":14099,"_26939":115126,"_2865":115454},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3379":69123,"_29619":69002,"_20556":115456,"_5":14099,"_26939":115126,"_2865":115457},[],"acceso a la interfaz;",{"_3379":69124,"_29619":69002,"_20556":115459,"_5":14099,"_26939":115126,"_2865":115460},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3379":69125,"_29619":69002,"_20556":115462,"_5":14099,"_26939":115126,"_2865":115463},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3379":69126,"_29619":69002,"_20556":115465,"_5":14099,"_26939":115126,"_2865":115466},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3379":69127,"_29619":69002,"_20556":115468,"_5":14099,"_26939":115130,"_2865":115469},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3379":69128,"_29619":69002,"_20556":115471,"_5":14099,"_26939":115130,"_2865":115472},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3379":69129,"_29619":69002,"_20556":115474,"_5":14099,"_26939":115130,"_2865":115475},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3379":69130,"_29619":69002,"_20556":115477,"_5":14099,"_26939":115133,"_2865":115478},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3379":69131,"_29619":69002,"_20556":115480,"_5":14099,"_26939":115137,"_2865":115481},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_3379":69132,"_29619":69002,"_20556":115483,"_5":14099,"_26939":115137,"_2865":115484},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_3379":69133,"_29619":69002,"_20556":115486,"_5":14099,"_26939":115141,"_2865":115487},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3379":69134,"_29619":69002,"_20556":115489,"_5":14099,"_26939":115145,"_2865":115490},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3379":69135,"_29619":69002,"_20556":115492,"_5":14099,"_26939":115149,"_2865":115493},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3379":69136,"_29619":69002,"_20556":115495,"_5":14099,"_26939":115153,"_2865":115496},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3379":69137,"_29619":69002,"_20556":115498,"_5":14099,"_26939":115153,"_2865":115499},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3379":69138,"_29619":69002,"_20556":115501,"_5":14099,"_26939":115157,"_2865":115502},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3379":69139,"_29619":69002,"_20556":115504,"_5":14099,"_26939":115157,"_2865":115505},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3379":69140,"_29619":69002,"_20556":115507,"_5":14099,"_26939":115157,"_2865":115508},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3379":69141,"_29619":69002,"_20556":115510,"_5":14099,"_26939":115157,"_2865":115511},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3379":69142,"_29619":69002,"_20556":115513,"_5":14099,"_26939":115157,"_2865":115514},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3379":69143,"_29619":69002,"_20556":115516,"_5":14099,"_26939":115157,"_2865":115517},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3379":69144,"_29619":69002,"_20556":115519,"_5":14099,"_26939":115157,"_2865":115520},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3379":69145,"_29619":69002,"_20556":115522,"_5":14099,"_26939":115157,"_2865":115523},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3379":69146,"_29619":69002,"_20556":115525,"_5":14099,"_26939":115161,"_2865":115526},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3379":69147,"_29619":69002,"_20556":115528,"_5":14099,"_26939":115161,"_2865":115529},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3379":69148,"_29619":69002,"_20556":115531,"_5":14099,"_26939":115161,"_2865":115532},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3379":69149,"_29619":69002,"_20556":115534,"_5":14099,"_26939":115165,"_2865":115535},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3379":69150,"_29619":69002,"_20556":115537,"_5":14099,"_26939":115165,"_2865":115538},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3379":69151,"_29619":69002,"_20556":115540,"_5":14099,"_26939":115165,"_2865":115541},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3379":69152,"_29619":69002,"_20556":115543,"_5":14099,"_26939":115165,"_2865":115544},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3379":69153,"_29619":69002,"_20556":115546,"_5":14099,"_26939":115165,"_2865":115547},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3379":69154,"_29619":69002,"_20556":115549,"_5":14099,"_26939":115165,"_2865":115550},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3379":69155,"_29619":69002,"_20556":115552,"_5":14099,"_26939":115165,"_2865":115553},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3379":69156,"_29619":69002,"_20556":115555,"_5":14099,"_26939":115165,"_2865":115556},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3379":69157,"_29619":69002,"_20556":115558,"_5":14099,"_26939":115173,"_2865":115559},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3379":69158,"_29619":69002,"_20556":115561,"_5":14099,"_26939":115177,"_2865":115562},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3379":69159,"_29619":69002,"_20556":115564,"_5":14099,"_26939":115177,"_2865":115565},[],"que exista un principal activo del tipo correcto;",{"_3379":69160,"_29619":69002,"_20556":115567,"_5":14099,"_26939":115177,"_2865":115568},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3379":69161,"_29619":69002,"_20556":115570,"_5":14099,"_26939":115177,"_2865":115571},[],"que todas las condiciones del principal se cumplan;",{"_3379":69162,"_29619":69002,"_20556":115573,"_5":14099,"_26939":115177,"_2865":115574},[],"que el principal tenga concedida la política esperada;",{"_3379":69163,"_29619":69002,"_20556":115576,"_5":14099,"_26939":115177,"_2865":115577},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3379":69164,"_29619":69002,"_20556":115579,"_5":14099,"_26939":115177,"_2865":115580},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3379":69165,"_29619":69002,"_20556":115582,"_5":14099,"_26939":115177,"_2865":115583},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con las trazas OpenTelemetry habilitadas, una solicitud que llega al motor de políticas genera un span `engine.CheckHTTPRequest` cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente. Para correlacionarlo con la traza del Gateway, el contexto de traza debe propagarse hasta authz.",{"_3379":69166,"_29619":69002,"_20556":115585,"_5":14099,"_26939":115181,"_2865":115586},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3379":69167,"_29619":69002,"_20556":115588,"_5":14099,"_26939":115185,"_2865":115589},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3379":69168,"_29619":69002,"_20556":115591,"_5":14099,"_26939":115189,"_2865":115592},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3379":69169,"_29619":69002,"_20556":115594,"_5":14099,"_26939":115189,"_2865":115595},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3379":69170,"_29619":69170,"_5":14457,"_2865":115597,"_29972":115598,"_20556":115599,"_26939":69170},"Alertas y suscripciones",[48223,115062,115063],[],{"_3379":69171,"_29619":69170,"_20556":115601,"_5":14099,"_26939":69170,"_2865":115602},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3379":69172,"_29619":69170,"_5":29969,"_20556":115604,"_26939":115605,"_2865":115606},[],"/docs/pr-preview/pr-53/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3379":69173,"_29619":69170,"_5":29969,"_20556":115608,"_26939":115609,"_2865":115610},[],"/docs/pr-preview/pr-53/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3379":69174,"_29619":69170,"_5":29969,"_20556":115612,"_26939":115613,"_2865":115614},[],"/docs/pr-preview/pr-53/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3379":69175,"_29619":69170,"_5":29969,"_20556":115616,"_26939":115617,"_2865":115618},[],"/docs/pr-preview/pr-53/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3379":69176,"_29619":69170,"_5":29969,"_20556":115620,"_26939":115621,"_2865":115622},[],"/docs/pr-preview/pr-53/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3379":69177,"_29619":69170,"_5":29969,"_20556":115624,"_26939":115625,"_2865":115626},[],"/docs/pr-preview/pr-53/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3379":69178,"_29619":69170,"_5":29969,"_20556":115628,"_26939":115629,"_2865":115630},[],"/docs/pr-preview/pr-53/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3379":69179,"_29619":69170,"_5":29969,"_20556":115632,"_26939":115633,"_2865":115634},[],"/docs/pr-preview/pr-53/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","Configura el cliente HTTP del webhook",{"_3379":69180,"_29619":69170,"_5":29969,"_20556":115636,"_26939":115637,"_2865":115638},[],"/docs/pr-preview/pr-53/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3379":69181,"_29619":69170,"_5":29969,"_20556":115640,"_26939":115641,"_2865":115642},[],"/docs/pr-preview/pr-53/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3379":69182,"_29619":69170,"_5":29969,"_20556":115644,"_26939":115645,"_2865":115646},[],"/docs/pr-preview/pr-53/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3379":69183,"_29619":69170,"_20556":115648,"_5":14099,"_26939":69170,"_2865":115649},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3379":69184,"_29619":69170,"_20556":115651,"_5":14099,"_26939":115605,"_2865":115652},[],"Un servicio publica un evento de dominio.",{"_3379":69185,"_29619":69170,"_20556":115654,"_5":14099,"_26939":115605,"_2865":115655},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3379":69186,"_29619":69170,"_20556":115657,"_5":14099,"_26939":115605,"_2865":115658},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3379":69187,"_29619":69170,"_20556":115660,"_5":14099,"_26939":115605,"_2865":115661},[],"Lamassu entrega el evento al canal configurado.",{"_3379":69188,"_29619":69170,"_20556":115663,"_5":14099,"_26939":115605,"_2865":115664},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3379":69189,"_29619":69170,"_20556":115666,"_5":14099,"_26939":115609,"_2865":115667},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3379":69190,"_29619":69170,"_20556":115669,"_5":14099,"_26939":115609,"_2865":115670},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3379":69191,"_29619":69170,"_20556":115672,"_5":14099,"_26939":115609,"_2865":115673},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3379":69192,"_29619":69170,"_20556":115675,"_5":14099,"_26939":115609,"_2865":115676},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3379":69193,"_29619":69170,"_20556":115678,"_5":14099,"_26939":115609,"_2865":115679},[],"`apikey_options` necesita `header` y `key`.",{"_3379":69194,"_29619":69170,"_20556":115681,"_5":14099,"_26939":115609,"_2865":115682},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3379":69195,"_29619":69170,"_20556":115684,"_5":14099,"_26939":115609,"_2865":115685},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3379":69196,"_29619":69170,"_20556":115687,"_5":14099,"_26939":115609,"_2865":115688},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3379":69197,"_29619":69170,"_20556":115690,"_5":14099,"_26939":115617,"_2865":115691},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3379":69198,"_29619":69170,"_20556":115693,"_5":14099,"_26939":115621,"_2865":115694},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3379":69199,"_29619":69170,"_20556":115696,"_5":14099,"_26939":115625,"_2865":115697},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3379":69200,"_29619":69170,"_20556":115699,"_5":14099,"_26939":115625,"_2865":115700},[],"**None** notifica todas las instancias del evento.",{"_3379":69201,"_29619":69170,"_20556":115702,"_5":14099,"_26939":115625,"_2865":115703},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3379":69202,"_29619":69170,"_20556":115705,"_5":14099,"_26939":115625,"_2865":115706},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3379":69203,"_29619":69170,"_20556":115708,"_5":14099,"_26939":115625,"_2865":115709},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3379":69204,"_29619":69170,"_20556":115711,"_5":14099,"_26939":115625,"_2865":115712},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3379":69205,"_29619":69170,"_20556":115714,"_5":14099,"_26939":115625,"_2865":115715},[],"La consola evalúa el filtro contra el JSON del editor **Input Event**, que está prellenado con el último evento, e indica si coincide. Para los filtros JSON Path y JavaScript, muestra **The filter matches this Cloud Event** o **The filter does not match this Cloud Event**. Las expresiones JSON Path se evalúan sobre el Cloud Event completo, así que el valor por defecto, `$.data`, selecciona el campo `data` del evento, y la expresión debe empezar por `$`.",{"_3379":69206,"_29619":69170,"_20556":115717,"_5":14099,"_26939":115629,"_2865":115718},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3379":69207,"_29619":69170,"_20556":115720,"_5":14099,"_26939":115633,"_2865":115721},[],"Los canales Webhook y Microsoft Teams muestran esta configuración en el formulario de suscripción, en el paso del canal, y de nuevo al editar una suscripción; Email no la utiliza. Los campos se corresponden con el bloque opcional `http_client` descrito arriba:",{"_3379":69208,"_29619":69170,"_20556":115723,"_5":14099,"_26939":115633,"_2865":115724},[],"**Log Level** selecciona `debug`, `info`, `warn` o `error`; `info` es el valor por defecto.",{"_3379":69209,"_29619":69170,"_20556":115726,"_5":14099,"_26939":115633,"_2865":115727},[],"**Call Timeout** es de 10 segundos por defecto. La consola rechaza un valor superior a 30 segundos con `Webhook timeout must be at most 30s.`; la API ajusta ese mismo valor al tope en lugar de rechazarlo (ver Las llamadas están limitadas).",{"_3379":69210,"_29619":69170,"_20556":115729,"_5":14099,"_26939":115633,"_2865":115730},[],"No hay interruptor de verificación TLS para estos canales, porque el servicio siempre verifica el certificado del receptor (ver TLS siempre se verifica).",{"_3379":69211,"_29619":69170,"_20556":115732,"_5":14099,"_26939":115633,"_2865":115733},[],"**HTTP Authentication** selecciona `No Authentication` (por defecto), `API Key` (valor de la API key y Header Name, `X-API-Key` por defecto), `OIDC Client Credentials` (Client ID, Client Secret y Well-Known URL) o `Mutual TLS` (Client Certificate y Client Private Key pegados como PEM). Una clave privada guardada permanece oculta hasta que seleccionas **Show**.",{"_3379":69212,"_29619":69170,"_20556":115735,"_5":14099,"_26939":115633,"_2865":115736},[],"Una URL `http://` muestra en la consola la advertencia `Unencrypted HTTP connection` (ver la llamada Credenciales sobre http\\:// más abajo).",{"_3379":69213,"_29619":69170,"_20556":115738,"_5":14099,"_26939":115633,"_2865":115739},[],"Los campos se validan en línea con las mismas reglas de entrega: la URL del webhook y la Well-Known URL de OIDC deben ser URLs absolutas `http` o `https`, una cabecera API-key no puede usar un nombre reservado y el certificado y la clave mTLS deben ser contenido PEM, no rutas de ficheros.",{"_3379":69214,"_29619":69170,"_20556":115741,"_5":14099,"_26939":115633,"_2865":115742},[],"El resumen del paso de confirmación muestra la autenticación como `None`, `OIDC client credentials`, `API key` o `Mutual TLS`. Los detalles de la suscripción muestran la autenticación, el nombre de la cabecera API-key (nunca el valor), la URL del emisor OIDC, mTLS como `Configured` y una fila fija `TLS verification: Verified`. La API key, el client secret y la clave privada no se muestran en los detalles de la suscripción.",{"_3379":69215,"_29619":69170,"_20556":115744,"_5":14099,"_26939":115637,"_2865":115745},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3379":69216,"_29619":69170,"_20556":115747,"_5":14099,"_26939":115637,"_2865":115748},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3379":69217,"_29619":69170,"_20556":115750,"_5":14099,"_26939":115637,"_2865":115751},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3379":69218,"_29619":69170,"_20556":115753,"_5":14099,"_26939":115637,"_2865":115754},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3379":69219,"_29619":69170,"_20556":115756,"_5":14099,"_26939":115637,"_2865":115757},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3379":69220,"_29619":69170,"_20556":115759,"_5":14099,"_26939":115637,"_2865":115760},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3379":69221,"_29619":69170,"_20556":115762,"_5":14099,"_26939":115637,"_2865":115763},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3379":69222,"_29619":69170,"_20556":115765,"_5":14099,"_26939":115637,"_2865":115766},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3379":69223,"_29619":69170,"_20556":115768,"_5":14099,"_26939":115641,"_2865":115769},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3379":69224,"_29619":69170,"_20556":115771,"_5":14099,"_26939":115641,"_2865":115772},[],"Las suscripciones creadas con versiones anteriores de la consola pueden guardar el destino del webhook en `url` y `method` en lugar de `webhook_url` y `webhook_method`. El servicio entrega solo a través de `webhook_url` y `webhook_method`, así que una suscripción así no entrega aunque los detalles de la suscripción muestren el destino guardado. Abre la suscripción y vuelve a guardarla: el formulario de edición precarga el destino guardado, y al guardar se reescribe la configuración del canal con el formato actual.",{"_3379":69225,"_29619":69170,"_20556":115774,"_5":14099,"_26939":115645,"_2865":115775},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3379":69226,"_29619":69170,"_20556":115777,"_5":14099,"_26939":115645,"_2865":115778},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3379":69227,"_29619":69170,"_20556":115780,"_5":14099,"_26939":115645,"_2865":115781},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3379":69228,"_29619":69170,"_20556":115783,"_5":14099,"_26939":115645,"_2865":115784},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3379":69229,"_29619":69170,"_20556":115786,"_5":14099,"_26939":115645,"_2865":115787},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3379":69230,"_29619":69170,"_20556":115789,"_5":14099,"_26939":115645,"_2865":115790},[],"**Validación:** `va.role.crl.create`.",{"_3379":69231,"_29619":69170,"_20556":115792,"_5":14099,"_26939":115645,"_2865":115793},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3379":69232,"_29619":69170,"_20556":115795,"_5":14099,"_26939":115645,"_2865":115796},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3379":69233,"_29619":69233,"_5":14457,"_2865":115798,"_29972":115799,"_20556":115800,"_26939":69233},"Registros de auditoría",[48223,115062,115063],[],{"_3379":69234,"_29619":69233,"_20556":115802,"_5":14099,"_26939":69233,"_2865":115803},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3379":69235,"_29619":69233,"_5":29969,"_20556":115805,"_26939":115806,"_2865":115807},[],"/docs/pr-preview/pr-53/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3379":69236,"_29619":69233,"_5":29969,"_20556":115809,"_26939":115810,"_2865":115811},[],"/docs/pr-preview/pr-53/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3379":69237,"_29619":69233,"_5":29969,"_20556":115813,"_26939":115814,"_2865":115815},[],"/docs/pr-preview/pr-53/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3379":69238,"_29619":69233,"_5":29969,"_20556":115817,"_26939":115818,"_2865":115819},[],"/docs/pr-preview/pr-53/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3379":69239,"_29619":69233,"_5":29969,"_20556":115821,"_26939":115822,"_2865":115823},[],"/docs/pr-preview/pr-53/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3379":69240,"_29619":69233,"_5":29969,"_20556":115825,"_26939":115826,"_2865":115827},[],"/docs/pr-preview/pr-53/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3379":69241,"_29619":69233,"_5":29969,"_20556":115829,"_26939":115830,"_2865":115831},[],"/docs/pr-preview/pr-53/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3379":69242,"_29619":69233,"_5":29969,"_20556":115833,"_26939":115834,"_2865":115835},[],"/docs/pr-preview/pr-53/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3379":69243,"_29619":69233,"_5":29969,"_20556":115837,"_26939":115838,"_2865":115839},[],"/docs/pr-preview/pr-53/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3379":69244,"_29619":69233,"_5":29969,"_20556":115841,"_26939":115842,"_2865":115843},[],"/docs/pr-preview/pr-53/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3379":69245,"_29619":69233,"_5":29969,"_20556":115845,"_26939":115846,"_2865":115847},[],"/docs/pr-preview/pr-53/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3379":69246,"_29619":69233,"_20556":115849,"_5":14099,"_26939":69233,"_2865":115850},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3379":69247,"_29619":69233,"_20556":115852,"_5":14099,"_26939":115806,"_2865":115853},[],"El cuerpo de auditoría incluye:",{"_3379":69248,"_29619":69233,"_20556":115855,"_5":14099,"_26939":115806,"_2865":115856},[],"input: datos recibidos por la operación;",{"_3379":69249,"_29619":69233,"_20556":115858,"_5":14099,"_26939":115806,"_2865":115859},[],"has\\_error: indica si el servicio devolvió un error;",{"_3379":69250,"_29619":69233,"_20556":115861,"_5":14099,"_26939":115806,"_2865":115862},[],"output: resultado producido o mensaje de error;",{"_3379":69251,"_29619":69233,"_20556":115864,"_5":14099,"_26939":115806,"_2865":115865},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3379":69252,"_29619":69233,"_20556":115867,"_5":14099,"_26939":115806,"_2865":115868},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3379":69253,"_29619":69233,"_20556":115870,"_5":14099,"_26939":115806,"_2865":115871},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3379":69254,"_29619":69233,"_20556":115873,"_5":14099,"_26939":115810,"_2865":115874},[],"El backend aplica auditoría a mutaciones de:",{"_3379":69255,"_29619":69233,"_20556":115876,"_5":14099,"_26939":115810,"_2865":115877},[],"autoridades, certificados y perfiles de emisión;",{"_3379":69256,"_29619":69233,"_20556":115879,"_5":14099,"_26939":115810,"_2865":115880},[],"claves y motores KMS;",{"_3379":69257,"_29619":69233,"_20556":115882,"_5":14099,"_26939":115810,"_2865":115883},[],"dispositivos e identidades;",{"_3379":69258,"_29619":69233,"_20556":115885,"_5":14099,"_26939":115810,"_2865":115886},[],"DMS y operaciones de enrolamiento;",{"_3379":69259,"_29619":69233,"_20556":115888,"_5":14099,"_26939":115810,"_2865":115889},[],"funciones de validación y CRL;",{"_3379":69260,"_29619":69233,"_20556":115891,"_5":14099,"_26939":115810,"_2865":115892},[],"principales, políticas y concesiones de autorización.",{"_3379":69261,"_29619":69233,"_20556":115894,"_5":14099,"_26939":115810,"_2865":115895},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3379":69262,"_29619":69233,"_20556":115897,"_5":14099,"_26939":115814,"_2865":115898},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3379":69263,"_29619":69233,"_20556":115900,"_5":14099,"_26939":115814,"_2865":115901},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3379":69264,"_29619":69233,"_20556":115903,"_5":14099,"_26939":115814,"_2865":115904},[],"Diseña el consumidor para:",{"_3379":69265,"_29619":69233,"_20556":115906,"_5":14099,"_26939":115814,"_2865":115907},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3379":69266,"_29619":69233,"_20556":115909,"_5":14099,"_26939":115814,"_2865":115910},[],"conservar el CloudEvent completo sin modificar;",{"_3379":69267,"_29619":69233,"_20556":115912,"_5":14099,"_26939":115814,"_2865":115913},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3379":69268,"_29619":69233,"_20556":115915,"_5":14099,"_26939":115814,"_2865":115916},[],"cifrar en tránsito y en reposo;",{"_3379":69269,"_29619":69233,"_20556":115918,"_5":14099,"_26939":115814,"_2865":115919},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3379":69270,"_29619":69233,"_20556":115921,"_5":14099,"_26939":115814,"_2865":115922},[],"aplicar una política explícita de retención y legal hold;",{"_3379":69271,"_29619":69233,"_20556":115924,"_5":14099,"_26939":115814,"_2865":115925},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3379":69272,"_29619":69233,"_20556":115927,"_5":14099,"_26939":115818,"_2865":115928},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3379":69273,"_29619":69233,"_20556":115930,"_5":14099,"_26939":115818,"_2865":115931},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3379":69274,"_29619":69233,"_20556":115933,"_5":14099,"_26939":115826,"_2865":115934},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3379":69275,"_29619":69233,"_20556":115936,"_5":14099,"_26939":115830,"_2865":115937},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3379":69276,"_29619":69233,"_20556":115939,"_5":14099,"_26939":115834,"_2865":115940},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3379":69277,"_29619":69233,"_20556":115942,"_5":14099,"_26939":115838,"_2865":115943},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3379":69278,"_29619":69233,"_20556":115945,"_5":14099,"_26939":115842,"_2865":115946},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3379":69279,"_29619":69233,"_20556":115948,"_5":14099,"_26939":115846,"_2865":115949},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3379":69280,"_29619":69233,"_20556":115951,"_5":14099,"_26939":115846,"_2865":115952},[],"aparece un evento de auditoría correcto;",{"_3379":69281,"_29619":69233,"_20556":115954,"_5":14099,"_26939":115846,"_2865":115955},[],"el principal coincide con la identidad utilizada;",{"_3379":69282,"_29619":69233,"_20556":115957,"_5":14099,"_26939":115846,"_2865":115958},[],"el consumidor lo persiste una sola vez;",{"_3379":69283,"_29619":69233,"_20556":115960,"_5":14099,"_26939":115846,"_2865":115961},[],"puede recuperarse por recurso, actor y periodo;",{"_3379":69284,"_29619":69233,"_20556":115963,"_5":14099,"_26939":115846,"_2865":115964},[],"una interrupción del consumidor produce una alerta.",{"_3379":69285,"_29619":69233,"_20556":115966,"_5":14099,"_26939":115846,"_2865":115967},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3379":69286,"_29619":69286,"_5":14457,"_2865":115969,"_29972":115970,"_20556":115971,"_26939":69286},"Arquitectura de la plataforma",[48223,115062],[],{"_3379":69287,"_29619":69286,"_20556":115973,"_5":14099,"_26939":69286,"_2865":115974},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3379":69288,"_29619":69286,"_5":29969,"_20556":115976,"_26939":115977,"_2865":115978},[],"/docs/pr-preview/pr-53/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3379":69289,"_29619":69286,"_5":29969,"_20556":115980,"_26939":115981,"_2865":115982},[],"/docs/pr-preview/pr-53/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3379":69290,"_29619":69286,"_5":29969,"_20556":115984,"_26939":115985,"_2865":115986},[],"/docs/pr-preview/pr-53/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3379":69291,"_29619":69286,"_5":29969,"_20556":115988,"_26939":115989,"_2865":115990},[],"/docs/pr-preview/pr-53/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3379":69292,"_29619":69286,"_5":29969,"_20556":115992,"_26939":115993,"_2865":115994},[],"/docs/pr-preview/pr-53/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3379":69293,"_29619":69286,"_20556":115996,"_5":14099,"_26939":69286,"_2865":115997},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3379":69294,"_29619":69286,"_20556":115999,"_5":14099,"_26939":69286,"_2865":116000},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3379":69295,"_29619":69286,"_20556":116002,"_5":14099,"_26939":115977,"_2865":116003},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3379":69296,"_29619":69286,"_20556":116005,"_5":14099,"_26939":115981,"_2865":116006},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3379":69297,"_29619":69286,"_20556":116008,"_5":14099,"_26939":115985,"_2865":116009},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3379":69298,"_29619":69286,"_20556":116011,"_5":14099,"_26939":115989,"_2865":116012},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3379":69299,"_29619":69286,"_20556":116014,"_5":14099,"_26939":115993,"_2865":116015},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3379":69300,"_29619":69300,"_5":14457,"_2865":116017,"_29972":116018,"_20556":116019,"_26939":69300},"Cómo funciona Lamassu",[48223,115062],[],{"_3379":69301,"_29619":69300,"_20556":116021,"_5":14099,"_26939":69300,"_2865":116022},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3379":69302,"_29619":69300,"_5":29969,"_20556":116024,"_26939":116025,"_2865":116026},[],"/docs/pr-preview/pr-53/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3379":69303,"_29619":69300,"_5":29969,"_20556":116028,"_26939":116029,"_2865":116030},[],"/docs/pr-preview/pr-53/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3379":69304,"_29619":69300,"_20556":116032,"_5":14099,"_26939":69300,"_2865":116033},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3379":69305,"_29619":69300,"_20556":116035,"_5":14099,"_26939":116025,"_2865":116036},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3379":69306,"_29619":69300,"_20556":116038,"_5":14099,"_26939":116025,"_2865":116039},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3379":69307,"_29619":69300,"_20556":116041,"_5":14099,"_26939":116025,"_2865":116042},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3379":69308,"_29619":69300,"_20556":116044,"_5":14099,"_26939":116025,"_2865":116045},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3379":69309,"_29619":69300,"_20556":116047,"_5":14099,"_26939":116025,"_2865":116048},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3379":69310,"_29619":69300,"_20556":116050,"_5":14099,"_26939":116029,"_2865":116051},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3379":69311,"_29619":69300,"_20556":116053,"_5":14099,"_26939":116029,"_2865":116054},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3379":69312,"_29619":69300,"_20556":116056,"_5":14099,"_26939":116029,"_2865":116057},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3379":69313,"_29619":69300,"_20556":116059,"_5":14099,"_26939":116029,"_2865":116060},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3379":69314,"_29619":69300,"_20556":116062,"_5":14099,"_26939":116029,"_2865":116063},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3379":69315,"_29619":69300,"_20556":116065,"_5":14099,"_26939":116029,"_2865":116066},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3379":69316,"_29619":69300,"_20556":116068,"_5":14099,"_26939":116029,"_2865":116069},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3379":69317,"_29619":69317,"_5":14457,"_2865":116071,"_29972":116072,"_20556":116073,"_26939":69317},"Dispositivos e identidades",[48223,115062,50702,116071],[],{"_3379":69318,"_29619":69317,"_20556":116075,"_5":14099,"_26939":69317,"_2865":116076},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3379":69319,"_29619":69317,"_5":29969,"_20556":116078,"_26939":116079,"_2865":116080},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3379":69320,"_29619":69317,"_5":29969,"_20556":116082,"_26939":116083,"_2865":116084},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3379":69321,"_29619":69317,"_5":29969,"_20556":116086,"_26939":116087,"_2865":116088},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3379":69322,"_29619":69317,"_5":29969,"_20556":116090,"_26939":116091,"_2865":116092},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3379":69323,"_29619":69317,"_5":29969,"_20556":116094,"_26939":116095,"_2865":116096},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3379":69324,"_29619":69317,"_5":29969,"_20556":116098,"_26939":116099,"_2865":116100},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3379":69325,"_29619":69317,"_5":29969,"_20556":116102,"_26939":116103,"_2865":116104},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3379":69326,"_29619":69317,"_5":29969,"_20556":116106,"_26939":116107,"_2865":116108},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3379":69327,"_29619":69317,"_5":29969,"_20556":116110,"_26939":116111,"_2865":116112},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3379":69328,"_29619":69317,"_5":29969,"_20556":116114,"_26939":116115,"_2865":116116},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3379":69329,"_29619":69317,"_5":29969,"_20556":116118,"_26939":116119,"_2865":116120},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3379":69330,"_29619":69317,"_20556":116122,"_5":14099,"_26939":69317,"_2865":116123},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3379":69331,"_29619":69317,"_20556":116125,"_5":14099,"_26939":69317,"_2865":116126},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3379":69332,"_29619":69317,"_20556":116128,"_5":14099,"_26939":116079,"_2865":116129},[],"Vista operativa",{"_3379":69333,"_29619":69317,"_20556":116131,"_5":14099,"_26939":116079,"_2865":116132},[],"Interpretación",{"_3379":69334,"_29619":69317,"_20556":116134,"_5":14099,"_26939":116079,"_2865":50765},[],{"_3379":69335,"_29619":69317,"_20556":116136,"_5":14099,"_26939":116079,"_2865":116137},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3379":69336,"_29619":69317,"_20556":116139,"_5":14099,"_26939":116079,"_2865":50771},[],{"_3379":69337,"_29619":69317,"_20556":116141,"_5":14099,"_26939":116079,"_2865":116142},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3379":69338,"_29619":69317,"_20556":116144,"_5":14099,"_26939":116079,"_2865":50777},[],{"_3379":69339,"_29619":69317,"_20556":116146,"_5":14099,"_26939":116079,"_2865":116147},[],"La identidad está en la ventana operativa de renovación.",{"_3379":69340,"_29619":69317,"_20556":116149,"_5":14099,"_26939":116079,"_2865":50783},[],{"_3379":69341,"_29619":69317,"_20556":116151,"_5":14099,"_26939":116079,"_2865":116152},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3379":69342,"_29619":69317,"_20556":116154,"_5":14099,"_26939":116079,"_2865":50789},[],{"_3379":69343,"_29619":69317,"_20556":116156,"_5":14099,"_26939":116079,"_2865":116157},[],"La identidad ha vencido.",{"_3379":69344,"_29619":69317,"_20556":116159,"_5":14099,"_26939":116079,"_2865":50795},[],{"_3379":69345,"_29619":69317,"_20556":116161,"_5":14099,"_26939":116079,"_2865":116162},[],"La identidad está marcada como revocada.",{"_3379":69346,"_29619":69317,"_20556":116164,"_5":14099,"_26939":116079,"_2865":50801},[],{"_3379":69347,"_29619":69317,"_20556":116166,"_5":14099,"_26939":116079,"_2865":116167},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3379":69348,"_29619":69317,"_20556":116169,"_5":14099,"_26939":116079,"_2865":116170},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3379":69349,"_29619":69317,"_20556":116172,"_5":14099,"_26939":116083,"_2865":116173},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3379":69350,"_29619":69317,"_20556":116175,"_5":14099,"_26939":116083,"_2865":116176},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3379":69351,"_29619":69317,"_20556":116178,"_5":14099,"_26939":116083,"_2865":116179},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3379":69352,"_29619":69317,"_20556":116181,"_5":14099,"_26939":116083,"_2865":116182},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3379":69353,"_29619":69317,"_20556":116184,"_5":14099,"_26939":116087,"_2865":116185},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3379":69354,"_29619":69317,"_20556":116187,"_5":14099,"_26939":116091,"_2865":116188},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3379":69355,"_29619":69317,"_20556":116190,"_5":14099,"_26939":116095,"_2865":116191},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3379":69356,"_29619":69317,"_20556":116193,"_5":14099,"_26939":116099,"_2865":116194},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3379":69357,"_29619":69317,"_20556":116196,"_5":14099,"_26939":116103,"_2865":116197},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3379":69358,"_29619":69317,"_20556":116199,"_5":14099,"_26939":116103,"_2865":116200},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3379":69359,"_29619":69317,"_20556":116202,"_5":14099,"_26939":116107,"_2865":116203},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3379":69360,"_29619":69317,"_20556":116205,"_5":14099,"_26939":116107,"_2865":116206},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3379":69361,"_29619":69317,"_20556":116208,"_5":14099,"_26939":116107,"_2865":116209},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3379":69362,"_29619":69317,"_20556":116211,"_5":14099,"_26939":116107,"_2865":116212},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3379":69363,"_29619":69317,"_20556":116214,"_5":14099,"_26939":116107,"_2865":116215},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3379":69364,"_29619":69317,"_20556":116217,"_5":14099,"_26939":116107,"_2865":116218},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3379":69365,"_29619":69317,"_20556":116220,"_5":14099,"_26939":116111,"_2865":116221},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3379":69366,"_29619":69317,"_20556":116223,"_5":14099,"_26939":116111,"_2865":116224},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3379":69367,"_29619":69317,"_20556":116226,"_5":14099,"_26939":116115,"_2865":116227},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3379":69368,"_29619":69317,"_20556":116229,"_5":14099,"_26939":116115,"_2865":116230},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3379":69369,"_29619":69317,"_20556":116232,"_5":14099,"_26939":116115,"_2865":116233},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3379":69370,"_29619":69317,"_20556":116235,"_5":14099,"_26939":116115,"_2865":116236},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3379":69371,"_29619":69317,"_20556":116238,"_5":14099,"_26939":116119,"_2865":116239},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3379":69372,"_29619":69317,"_20556":116241,"_5":14099,"_26939":116119,"_2865":116242},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3379":69373,"_29619":69373,"_5":14457,"_2865":116244,"_29972":116245,"_20556":116247,"_26939":69373},"Identidad inicial y autenticación",[48223,115062,50702,116071,116246],"Enrolamiento con PKI",[],{"_3379":69374,"_29619":69373,"_20556":116249,"_5":14099,"_26939":69373,"_2865":116250},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_3379":69375,"_29619":69373,"_5":29969,"_20556":116252,"_26939":116253,"_2865":116254},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3379":69376,"_29619":69373,"_5":29969,"_20556":116256,"_26939":116257,"_2865":116258},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3379":69377,"_29619":69373,"_5":29969,"_20556":116260,"_26939":116261,"_2865":116262},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_3379":69378,"_29619":69373,"_5":29969,"_20556":116264,"_26939":116265,"_2865":116266},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3379":69379,"_29619":69373,"_5":29969,"_20556":116268,"_26939":116269,"_2865":116270},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3379":69380,"_29619":69373,"_20556":116272,"_5":14099,"_26939":69373,"_2865":116273},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3379":69381,"_29619":69373,"_20556":116275,"_5":14099,"_26939":116253,"_2865":116276},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3379":69382,"_29619":69373,"_20556":116278,"_5":14099,"_26939":116253,"_2865":116279},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3379":69383,"_29619":69373,"_20556":116281,"_5":14099,"_26939":116257,"_2865":116282},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3379":69384,"_29619":69373,"_20556":116284,"_5":14099,"_26939":116257,"_2865":116285},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3379":69385,"_29619":69373,"_20556":116287,"_5":14099,"_26939":116257,"_2865":116288},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3379":69386,"_29619":69373,"_20556":116290,"_5":14099,"_26939":116261,"_2865":116291},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3379":69387,"_29619":69373,"_20556":116293,"_5":14099,"_26939":116261,"_2865":116294},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3379":69388,"_29619":69373,"_20556":116296,"_5":14099,"_26939":116265,"_2865":116297},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3379":69389,"_29619":69373,"_20556":116299,"_5":14099,"_26939":116265,"_2865":116300},[],"Ejemplo de cuerpo:",{"_3379":69390,"_29619":69373,"_20556":116302,"_5":14099,"_26939":116265,"_2865":116303},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3379":69391,"_29619":69373,"_20556":116305,"_5":14099,"_26939":116265,"_2865":116306},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3379":69392,"_29619":69373,"_20556":116308,"_5":14099,"_26939":116265,"_2865":116309},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3379":69393,"_29619":69373,"_20556":116311,"_5":14099,"_26939":116265,"_2865":116312},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3379":69394,"_29619":69373,"_20556":116314,"_5":14099,"_26939":116269,"_2865":116315},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_3379":69395,"_29619":69373,"_20556":116317,"_5":14099,"_26939":116269,"_2865":116318},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3379":69396,"_29619":69396,"_5":14457,"_2865":116320,"_29972":116321,"_20556":116322,"_26939":69396},"Configura y opera el DMS",[48223,115062,50702,116071,116246],[],{"_3379":69397,"_29619":69396,"_20556":116324,"_5":14099,"_26939":69396,"_2865":116325},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3379":69398,"_29619":69396,"_5":29969,"_20556":116327,"_26939":116328,"_2865":113640},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3379":69399,"_29619":69396,"_5":29969,"_20556":116330,"_26939":116331,"_2865":116332},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3379":69400,"_29619":69396,"_5":29969,"_20556":116334,"_26939":116335,"_2865":116336},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3379":69401,"_29619":69396,"_5":29969,"_20556":116338,"_26939":116339,"_2865":116340},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3379":69402,"_29619":69396,"_5":29969,"_20556":116342,"_26939":116343,"_2865":116344},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3379":69403,"_29619":69396,"_5":29969,"_20556":116346,"_26939":116347,"_2865":116348},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3379":69404,"_29619":69396,"_5":29969,"_20556":116350,"_26939":116351,"_2865":116352},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3379":69405,"_29619":69396,"_5":29969,"_20556":116354,"_26939":116355,"_2865":116356},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_3379":69406,"_29619":69396,"_5":29969,"_20556":116358,"_26939":116359,"_2865":50997},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_3379":69407,"_29619":69396,"_5":29969,"_20556":116361,"_26939":116362,"_2865":51001},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_3379":69408,"_29619":69396,"_5":29969,"_20556":116364,"_26939":116365,"_2865":116366},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_3379":69409,"_29619":69396,"_5":29969,"_20556":116368,"_26939":116369,"_2865":116370},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3379":69410,"_29619":69396,"_5":29969,"_20556":116372,"_26939":116373,"_2865":116374},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_3379":69411,"_29619":69396,"_5":29969,"_20556":116376,"_26939":116377,"_2865":116378},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3379":69412,"_29619":69396,"_5":29969,"_20556":116380,"_26939":116381,"_2865":51021},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_3379":69413,"_29619":69396,"_5":29969,"_20556":116383,"_26939":116384,"_2865":116385},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_3379":69414,"_29619":69396,"_5":29969,"_20556":116387,"_26939":116388,"_2865":116389},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3379":69415,"_29619":69396,"_5":29969,"_20556":116391,"_26939":116392,"_2865":116393},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3379":69416,"_29619":69396,"_20556":116395,"_5":14099,"_26939":69396,"_2865":116396},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3379":69417,"_29619":69396,"_20556":116398,"_5":14099,"_26939":116328,"_2865":116399},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3379":69418,"_29619":69396,"_20556":116401,"_5":14099,"_26939":116328,"_2865":116402},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3379":69419,"_29619":69396,"_20556":116404,"_5":14099,"_26939":116335,"_2865":116405},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3379":69420,"_29619":69396,"_20556":116407,"_5":14099,"_26939":116339,"_2865":116408},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3379":69421,"_29619":69396,"_20556":116410,"_5":14099,"_26939":116343,"_2865":116411},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3379":69422,"_29619":69396,"_20556":116413,"_5":14099,"_26939":116347,"_2865":116414},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3379":69423,"_29619":69396,"_20556":116416,"_5":14099,"_26939":116351,"_2865":116417},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3379":69424,"_29619":69396,"_20556":116419,"_5":14099,"_26939":116359,"_2865":116420},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_3379":69425,"_29619":69396,"_20556":116422,"_5":14099,"_26939":116359,"_2865":116423},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3379":69426,"_29619":69396,"_20556":116425,"_5":14099,"_26939":116362,"_2865":116426},[],"Campo de `settings.enrollment_settings`",{"_3379":69427,"_29619":69396,"_20556":116428,"_5":14099,"_26939":116362,"_2865":116429},[],"Decisión",{"_3379":69428,"_29619":69396,"_20556":116431,"_5":14099,"_26939":116362,"_2865":51072},[],{"_3379":69429,"_29619":69396,"_20556":116433,"_5":14099,"_26939":116362,"_2865":116434},[],"`EST_RFC7030` para estas operaciones.",{"_3379":69430,"_29619":69396,"_20556":116436,"_5":14099,"_26939":116362,"_2865":51078},[],{"_3379":69431,"_29619":69396,"_20556":116438,"_5":14099,"_26939":116362,"_2865":116439},[],"ID de la CA que firmará.",{"_3379":69432,"_29619":69396,"_20556":116441,"_5":14099,"_26939":116362,"_2865":51084},[],{"_3379":69433,"_29619":69396,"_20556":116443,"_5":14099,"_26939":116362,"_2865":116444},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3379":69434,"_29619":69396,"_20556":116446,"_5":14099,"_26939":116362,"_2865":51090},[],{"_3379":69435,"_29619":69396,"_20556":116448,"_5":14099,"_26939":116362,"_2865":116449},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3379":69436,"_29619":69396,"_20556":116451,"_5":14099,"_26939":116362,"_2865":51096},[],{"_3379":69437,"_29619":69396,"_20556":116453,"_5":14099,"_26939":116362,"_2865":116454},[],"Uno de los cuatro modos de autenticación.",{"_3379":69438,"_29619":69396,"_20556":116456,"_5":14099,"_26939":116362,"_2865":116457},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3379":69439,"_29619":69396,"_20556":116459,"_5":14099,"_26939":116365,"_2865":116460},[],"Los bloques son independientes:",{"_3379":69440,"_29619":69396,"_20556":116462,"_5":14099,"_26939":116365,"_2865":116463},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3379":69441,"_29619":69396,"_20556":116465,"_5":14099,"_26939":116365,"_2865":116466},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3379":69442,"_29619":69396,"_20556":116468,"_5":14099,"_26939":116365,"_2865":51114},[],{"_3379":69443,"_29619":69396,"_20556":116470,"_5":14099,"_26939":116365,"_2865":116471},[],"Control aplicado en la operación configurada",{"_3379":69444,"_29619":69396,"_20556":116473,"_5":14099,"_26939":116365,"_2865":51120},[],{"_3379":69445,"_29619":69396,"_20556":116475,"_5":14099,"_26939":116365,"_2865":116476},[],"Validación del certificado presentado.",{"_3379":69446,"_29619":69396,"_20556":116478,"_5":14099,"_26939":116365,"_2865":51126},[],{"_3379":69447,"_29619":69396,"_20556":116480,"_5":14099,"_26939":116365,"_2865":116481},[],"Autorización del webhook configurado.",{"_3379":69448,"_29619":69396,"_20556":116483,"_5":14099,"_26939":116365,"_2865":51132},[],{"_3379":69449,"_29619":69396,"_20556":116485,"_5":14099,"_26939":116365,"_2865":116486},[],"Validación del certificado y, después, aprobación del webhook.",{"_3379":69450,"_29619":69396,"_20556":116488,"_5":14099,"_26939":116365,"_2865":51138},[],{"_3379":69451,"_29619":69396,"_20556":116490,"_5":14099,"_26939":116365,"_2865":116491},[],"Sin autenticación del solicitante por el DMS.",{"_3379":69452,"_29619":69396,"_20556":116493,"_5":14099,"_26939":116365,"_2865":116494},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3379":69453,"_29619":69396,"_20556":116496,"_5":14099,"_26939":116365,"_2865":116497},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3379":69454,"_29619":69396,"_20556":116499,"_5":14099,"_26939":116365,"_2865":116500},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`.",{"_3379":69455,"_29619":69396,"_20556":116502,"_5":14099,"_26939":116365,"_2865":116503},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3379":69456,"_29619":69396,"_20556":116505,"_5":14099,"_26939":116369,"_2865":116506},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3379":69457,"_29619":69396,"_20556":116508,"_5":14099,"_26939":116369,"_2865":116509},[],"Campo de `external_webhook_settings`",{"_3379":69458,"_29619":69396,"_20556":116511,"_5":14099,"_26939":116369,"_2865":116429},[],{"_3379":69459,"_29619":69396,"_20556":116513,"_5":14099,"_26939":116369,"_2865":51164},[],{"_3379":69460,"_29619":69396,"_20556":116515,"_5":14099,"_26939":116369,"_2865":116516},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3379":69461,"_29619":69396,"_20556":116518,"_5":14099,"_26939":116369,"_2865":51170},[],{"_3379":69462,"_29619":69396,"_20556":116520,"_5":14099,"_26939":116369,"_2865":116521},[],"`POST` o `PUT`; `POST` por defecto.",{"_3379":69463,"_29619":69396,"_20556":116523,"_5":14099,"_26939":116369,"_2865":51176},[],{"_3379":69464,"_29619":69396,"_20556":116525,"_5":14099,"_26939":116369,"_2865":116526},[],"Etiqueta usada en los logs del servicio.",{"_3379":69465,"_29619":69396,"_20556":116528,"_5":14099,"_26939":116369,"_2865":51182},[],{"_3379":69466,"_29619":69396,"_20556":116530,"_5":14099,"_26939":116369,"_2865":116531},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3379":69467,"_29619":69396,"_20556":116533,"_5":14099,"_26939":116369,"_2865":51188},[],{"_3379":69468,"_29619":69396,"_20556":116535,"_5":14099,"_26939":116369,"_2865":116536},[],"Nivel de log de la llamada del webhook: `debug`, `info`, `warn` o `error`; `info` por defecto.",{"_3379":69469,"_29619":69396,"_20556":116538,"_5":14099,"_26939":116369,"_2865":51194},[],{"_3379":69470,"_29619":69396,"_20556":116540,"_5":14099,"_26939":116369,"_2865":116541},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3379":69471,"_29619":69396,"_20556":116543,"_5":14099,"_26939":116369,"_2865":51200},[],{"_3379":69472,"_29619":69396,"_20556":116545,"_5":14099,"_26939":116369,"_2865":116546},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3379":69473,"_29619":69396,"_20556":116548,"_5":14099,"_26939":116369,"_2865":51206},[],{"_3379":69474,"_29619":69396,"_20556":116550,"_5":14099,"_26939":116369,"_2865":116551},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3379":69475,"_29619":69396,"_20556":116553,"_5":14099,"_26939":116369,"_2865":51212},[],{"_3379":69476,"_29619":69396,"_20556":116555,"_5":14099,"_26939":116369,"_2865":116556},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3379":69477,"_29619":69396,"_20556":116558,"_5":14099,"_26939":116369,"_2865":51218},[],{"_3379":69478,"_29619":69396,"_20556":116560,"_5":14099,"_26939":116369,"_2865":116561},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3379":69479,"_29619":69396,"_20556":116563,"_5":14099,"_26939":116369,"_2865":116564},[],"Reglas de esa configuración:",{"_3379":69480,"_29619":69396,"_20556":116566,"_5":14099,"_26939":116369,"_2865":116567},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3379":69481,"_29619":69396,"_20556":116569,"_5":14099,"_26939":116369,"_2865":116570},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3379":69482,"_29619":69396,"_20556":116572,"_5":14099,"_26939":116369,"_2865":116573},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3379":69483,"_29619":69396,"_20556":116575,"_5":14099,"_26939":116369,"_2865":116576},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3379":69484,"_29619":69396,"_20556":116578,"_5":14099,"_26939":116369,"_2865":116579},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3379":69485,"_29619":69396,"_20556":116581,"_5":14099,"_26939":116369,"_2865":116582},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3379":69486,"_29619":69396,"_20556":116584,"_5":14099,"_26939":116369,"_2865":116585},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento, con los mismos campos Log Level, Call Timeout, HTTP Authentication y credenciales que los canales webhook, además de un interruptor **Skip TLS Verification** (desactivado por defecto, así que la verificación permanece activa; la consola avisa cuando lo activas).",{"_3379":69487,"_29619":69396,"_20556":116587,"_5":14099,"_26939":116369,"_2865":116588},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Para corregirlo en la consola, abre el DMS, sustituye cualquier valor de ruta de fichero por contenido PEM — el editor rechaza las rutas de fichero con un error en el propio campo — y guarda. Al guardar se reescribe `external_webhook_settings.config` con las claves actuales, y la consola lee tanto el PEM sin codificar como el codificado en Base64 de las configuraciones migradas, y almacena el material codificado en Base64. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3379":69488,"_29619":69396,"_20556":116590,"_5":14099,"_26939":116369,"_2865":116591},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3379":69489,"_29619":69396,"_20556":116593,"_5":14099,"_26939":116373,"_2865":116594},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3379":69490,"_29619":69396,"_20556":116596,"_5":14099,"_26939":116377,"_2865":116597},[],"Campo de `settings.reenrollment_settings`",{"_3379":69491,"_29619":69396,"_20556":116599,"_5":14099,"_26939":116377,"_2865":116600},[],"Función",{"_3379":69492,"_29619":69396,"_20556":116602,"_5":14099,"_26939":116377,"_2865":51262},[],{"_3379":69493,"_29619":69396,"_20556":116604,"_5":14099,"_26939":116377,"_2865":116605},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3379":69494,"_29619":69396,"_20556":116607,"_5":14099,"_26939":116377,"_2865":51268},[],{"_3379":69495,"_29619":69396,"_20556":116609,"_5":14099,"_26939":116377,"_2865":116610},[],"Umbral operativo preventivo de monitorización.",{"_3379":69496,"_29619":69396,"_20556":116612,"_5":14099,"_26939":116377,"_2865":51274},[],{"_3379":69497,"_29619":69396,"_20556":116614,"_5":14099,"_26939":116377,"_2865":116615},[],"Umbral operativo crítico de monitorización.",{"_3379":69498,"_29619":69396,"_20556":116617,"_5":14099,"_26939":116377,"_2865":51280},[],{"_3379":69499,"_29619":69396,"_20556":116619,"_5":14099,"_26939":116377,"_2865":116620},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3379":69500,"_29619":69396,"_20556":116622,"_5":14099,"_26939":116377,"_2865":51286},[],{"_3379":69501,"_29619":69396,"_20556":116624,"_5":14099,"_26939":116377,"_2865":116625},[],"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3379":69502,"_29619":69396,"_20556":116627,"_5":14099,"_26939":116377,"_2865":51292},[],{"_3379":69503,"_29619":69396,"_20556":116629,"_5":14099,"_26939":116377,"_2865":116630},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3379":69504,"_29619":69396,"_20556":116632,"_5":14099,"_26939":116377,"_2865":116633},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_3379":69505,"_29619":69396,"_20556":116635,"_5":14099,"_26939":116381,"_2865":116636},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_3379":69506,"_29619":69396,"_20556":116638,"_5":14099,"_26939":116384,"_2865":114004},[],{"_3379":69507,"_29619":69396,"_20556":116640,"_5":14099,"_26939":116384,"_2865":116641},[],"Qué publica",{"_3379":69508,"_29619":69396,"_20556":116643,"_5":14099,"_26939":116384,"_2865":51309},[],{"_3379":69509,"_29619":69396,"_20556":116645,"_5":14099,"_26939":116384,"_2865":116646},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3379":69510,"_29619":69396,"_20556":116648,"_5":14099,"_26939":116384,"_2865":51315},[],{"_3379":69511,"_29619":69396,"_20556":116650,"_5":14099,"_26939":116384,"_2865":116651},[],"Certificado de la CA emisora seleccionada.",{"_3379":69512,"_29619":69396,"_20556":116653,"_5":14099,"_26939":116384,"_2865":51321},[],{"_3379":69513,"_29619":69396,"_20556":116655,"_5":14099,"_26939":116384,"_2865":116656},[],"Certificados de las CAs elegidas explícitamente.",{"_3379":69514,"_29619":69396,"_20556":116658,"_5":14099,"_26939":116384,"_2865":116659},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_3379":69515,"_29619":69396,"_20556":116661,"_5":14099,"_26939":116388,"_2865":116662},[],"**Edit** cambia nombre, ajustes y metadatos. Las actualizaciones se realizan mediante la API de DMS. `PUT /v1/dms/{id}` siempre actúa sobre el DMS identificado en la ruta de la URL: el cuerpo no lleva campo `id`, y cualquier `id` o `creation_ts` que contenga se ignora silenciosamente; la autorización se evalúa contra ese mismo identificador de la ruta. El cuerpo debe incluir un `name` no vacío y un objeto `settings`; si falta alguno, la respuesta es HTTP 400 y el DMS almacenado no se modifica. `name` y `settings` se sustituyen siempre por completo, así que lee el DMS antes de enviar una edición por API para no perder campos. `metadata` es opcional: si se omite o se envía `null`, se conservan los metadatos almacenados; un objeto suministrado los sustituye por completo; `{}` los borra (una consulta GET posterior devuelve un objeto vacío, no `null`). Los cuerpos al estilo antiguo que transportan el DMS completo siguen funcionando mientras incluyan `name` y `settings`; los campos desconocidos se ignoran. La actualización rechaza un `name` vacío con HTTP 400: un DMS cuyo nombre almacenado quedó vacío por una actualización anterior debe renombrarse antes de que cualquier cliente lo vuelva a leer y reenviar, incluida la escritura de vuelta del conector de AWS IoT en modo JITP. Si el objeto no incluye la clave del conector de AWS IoT (`lamassu.io/iot/{connector_id}`), el conector ignora los eventos siguientes del DMS.",{"_3379":69516,"_29619":69396,"_20556":116664,"_5":14099,"_26939":116388,"_2865":116665},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3379":69517,"_29619":69396,"_20556":116667,"_5":14099,"_26939":116388,"_2865":116668},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3379":69518,"_29619":69396,"_20556":116670,"_5":14099,"_26939":116392,"_2865":116671},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3379":69519,"_29619":69519,"_5":14457,"_2865":116673,"_29972":116674,"_20556":116675,"_26939":69519},"Integra el cliente EST",[48223,115062,50702,116071,116246],[],{"_3379":69520,"_29619":69519,"_20556":116677,"_5":14099,"_26939":69519,"_2865":116678},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_3379":69521,"_29619":69519,"_5":29969,"_20556":116680,"_26939":116681,"_2865":113640},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_3379":69522,"_29619":69519,"_5":29969,"_20556":116683,"_26939":116684,"_2865":116685},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_3379":69523,"_29619":69519,"_5":29969,"_20556":116687,"_26939":116688,"_2865":116689},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_3379":69524,"_29619":69519,"_5":29969,"_20556":116691,"_26939":116692,"_2865":116693},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_3379":69525,"_29619":69519,"_5":29969,"_20556":116695,"_26939":116696,"_2865":116697},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_3379":69526,"_29619":69519,"_5":29969,"_20556":116699,"_26939":116700,"_2865":116701},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_3379":69527,"_29619":69519,"_20556":116703,"_5":14099,"_26939":69519,"_2865":116704},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_3379":69528,"_29619":69519,"_20556":116706,"_5":14099,"_26939":116681,"_2865":116707},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3379":69529,"_29619":69519,"_20556":116709,"_5":14099,"_26939":116681,"_2865":116710},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3379":69530,"_29619":69519,"_20556":116712,"_5":14099,"_26939":116681,"_2865":116713},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3379":69531,"_29619":69519,"_20556":116715,"_5":14099,"_26939":116684,"_2865":116716},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_3379":69532,"_29619":69519,"_20556":116718,"_5":14099,"_26939":116684,"_2865":116719},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3379":69533,"_29619":69519,"_20556":116721,"_5":14099,"_26939":116688,"_2865":116722},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3379":69534,"_29619":69519,"_20556":116724,"_5":14099,"_26939":116688,"_2865":116725},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3379":69535,"_29619":69519,"_20556":116727,"_5":14099,"_26939":116692,"_2865":116728},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3379":69536,"_29619":69519,"_20556":116730,"_5":14099,"_26939":116692,"_2865":116731},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3379":69537,"_29619":69519,"_20556":116733,"_5":14099,"_26939":116696,"_2865":116734},[],"Para el caso de una raíz que emite directamente:",{"_3379":69538,"_29619":69519,"_20556":116736,"_5":14099,"_26939":116696,"_2865":116737},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3379":69539,"_29619":69519,"_20556":116739,"_5":14099,"_26939":116696,"_2865":116740},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3379":69540,"_29619":69519,"_20556":116742,"_5":14099,"_26939":116700,"_2865":116743},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_3379":69541,"_29619":69541,"_5":14457,"_2865":116745,"_29972":116746,"_20556":116747,"_26939":69541},"Referencia EST",[48223,115062,50702,116071,116246],[],{"_3379":69542,"_29619":69541,"_20556":116749,"_5":14099,"_26939":69541,"_2865":116750},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_3379":69543,"_29619":69541,"_5":29969,"_20556":116752,"_26939":116753,"_2865":116754},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_3379":69544,"_29619":69541,"_5":29969,"_20556":116756,"_26939":116757,"_2865":22284},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3379":69545,"_29619":69541,"_5":29969,"_20556":116759,"_26939":116760,"_2865":25575},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3379":69546,"_29619":69541,"_5":29969,"_20556":116762,"_26939":116763,"_2865":25582},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3379":69547,"_29619":69541,"_5":29969,"_20556":116765,"_26939":116766,"_2865":24904},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3379":69548,"_29619":69541,"_5":29969,"_20556":116768,"_26939":116769,"_2865":116770},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_3379":69549,"_29619":69541,"_5":29969,"_20556":116772,"_26939":116773,"_2865":116774},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_3379":69550,"_29619":69541,"_5":29969,"_20556":116776,"_26939":116777,"_2865":116778},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_3379":69551,"_29619":69541,"_20556":116780,"_5":14099,"_26939":69541,"_2865":116781},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_3379":69552,"_29619":69541,"_20556":116783,"_5":14099,"_26939":116753,"_2865":116784},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3379":69553,"_29619":69541,"_20556":116786,"_5":14099,"_26939":116753,"_2865":114822},[],{"_3379":69554,"_29619":69541,"_20556":116788,"_5":14099,"_26939":116753,"_2865":116789},[],"Método",{"_3379":69555,"_29619":69541,"_20556":116791,"_5":14099,"_26939":116753,"_2865":116792},[],"Autenticación y condición",{"_3379":69556,"_29619":69541,"_20556":116794,"_5":14099,"_26939":116753,"_2865":51464},[],{"_3379":69557,"_29619":69541,"_20556":116796,"_5":14099,"_26939":116753,"_2865":51467},[],{"_3379":69558,"_29619":69541,"_20556":116798,"_5":14099,"_26939":116753,"_2865":116799},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3379":69559,"_29619":69541,"_20556":116801,"_5":14099,"_26939":116753,"_2865":51473},[],{"_3379":69560,"_29619":69541,"_20556":116803,"_5":14099,"_26939":116753,"_2865":51476},[],{"_3379":69561,"_29619":69541,"_20556":116805,"_5":14099,"_26939":116753,"_2865":116806},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3379":69562,"_29619":69541,"_20556":116808,"_5":14099,"_26939":116753,"_2865":51482},[],{"_3379":69563,"_29619":69541,"_20556":116810,"_5":14099,"_26939":116753,"_2865":51476},[],{"_3379":69564,"_29619":69541,"_20556":116812,"_5":14099,"_26939":116753,"_2865":116813},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3379":69565,"_29619":69541,"_20556":116815,"_5":14099,"_26939":116753,"_2865":51490},[],{"_3379":69566,"_29619":69541,"_20556":116817,"_5":14099,"_26939":116753,"_2865":51476},[],{"_3379":69567,"_29619":69541,"_20556":116819,"_5":14099,"_26939":116753,"_2865":116820},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_3379":69568,"_29619":69541,"_20556":116822,"_5":14099,"_26939":116753,"_2865":116823},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3379":69569,"_29619":69541,"_20556":116825,"_5":14099,"_26939":116757,"_2865":116826},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_3379":69570,"_29619":69541,"_20556":116828,"_5":14099,"_26939":116757,"_2865":116829},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_3379":69571,"_29619":69541,"_20556":116831,"_5":14099,"_26939":116760,"_2865":116832},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_3379":69572,"_29619":69541,"_20556":116834,"_5":14099,"_26939":116760,"_2865":116835},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_3379":69573,"_29619":69541,"_20556":116837,"_5":14099,"_26939":116763,"_2865":116838},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_3379":69574,"_29619":69541,"_20556":116840,"_5":14099,"_26939":116763,"_2865":116841},[],"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_3379":69575,"_29619":69541,"_20556":116843,"_5":14099,"_26939":116766,"_2865":116844},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_3379":69576,"_29619":69541,"_20556":116846,"_5":14099,"_26939":116766,"_2865":116847},[],"El código admite RSA y ECDSA, y el valor `bits` del ajuste de clave del DMS significa algo distinto en cada caso. En ECDSA selecciona la curva: 224, 256, 384 o 521 corresponden a P-224, P-256, P-384 y P-521, y un tamaño no reconocido produce fallback a P-256, así que elige explícitamente un tamaño compatible y comprueba la clave resultante. En RSA se usa directamente como tamaño del módulo; la consola ofrece 2048, 3072 y 4096 bits. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_3379":69577,"_29619":69541,"_20556":116849,"_5":14099,"_26939":116769,"_2865":116850},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3379":69578,"_29619":69541,"_20556":116852,"_5":14099,"_26939":116769,"_2865":116853},[],"Parte",{"_3379":69579,"_29619":69541,"_20556":116855,"_5":14099,"_26939":116769,"_2865":116856},[],"Contenido tras decodificar su Base64",{"_3379":69580,"_29619":69541,"_20556":116858,"_5":14099,"_26939":116769,"_2865":51534},[],{"_3379":69581,"_29619":69541,"_20556":116860,"_5":14099,"_26939":116769,"_2865":116861},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3379":69582,"_29619":69541,"_20556":116863,"_5":14099,"_26939":116769,"_2865":51540},[],{"_3379":69583,"_29619":69541,"_20556":116865,"_5":14099,"_26939":116769,"_2865":116866},[],"PKCS#7 DER con el certificado emitido.",{"_3379":69584,"_29619":69541,"_20556":116868,"_5":14099,"_26939":116769,"_2865":116869},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3379":69585,"_29619":69541,"_20556":116871,"_5":14099,"_26939":116773,"_2865":116872},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3379":69586,"_29619":69541,"_20556":116874,"_5":14099,"_26939":116773,"_2865":116875},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_3379":69587,"_29619":69541,"_20556":116877,"_5":14099,"_26939":116773,"_2865":116878},[],"Convierte y comprueba el resultado:",{"_3379":69588,"_29619":69541,"_20556":116880,"_5":14099,"_26939":116773,"_2865":116881},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_3379":69589,"_29619":69541,"_20556":116883,"_5":14099,"_26939":116777,"_2865":116884},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3379":69590,"_29619":69541,"_20556":116886,"_5":14099,"_26939":116777,"_2865":116887},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3379":69591,"_29619":69591,"_5":14457,"_2865":116246,"_29972":116889,"_20556":116890,"_26939":69591},[48223,115062,50702,116071,116246],[],{"_3379":69592,"_29619":69591,"_20556":116892,"_5":14099,"_26939":69591,"_2865":116893},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_3379":69593,"_29619":69591,"_5":29969,"_20556":116895,"_26939":116896,"_2865":116897},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3379":69594,"_29619":69591,"_5":29969,"_20556":116899,"_26939":116900,"_2865":116901},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3379":69595,"_29619":69591,"_5":29969,"_20556":116903,"_26939":116904,"_2865":116905},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3379":69596,"_29619":69591,"_5":29969,"_20556":116907,"_26939":116908,"_2865":116909},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_3379":69597,"_29619":69591,"_20556":116911,"_5":14099,"_26939":69591,"_2865":116912},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3379":69598,"_29619":69591,"_20556":116914,"_5":14099,"_26939":116896,"_2865":116915},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3379":69599,"_29619":69591,"_20556":116917,"_5":14099,"_26939":116896,"_2865":116918},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3379":69600,"_29619":69591,"_20556":116920,"_5":14099,"_26939":116896,"_2865":116921},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3379":69601,"_29619":69591,"_20556":116923,"_5":14099,"_26939":116896,"_2865":116924},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3379":69602,"_29619":69591,"_20556":116926,"_5":14099,"_26939":116896,"_2865":116927},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3379":69603,"_29619":69591,"_20556":116929,"_5":14099,"_26939":116896,"_2865":116930},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3379":69604,"_29619":69591,"_20556":116932,"_5":14099,"_26939":116900,"_2865":116933},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3379":69605,"_29619":69591,"_20556":116935,"_5":14099,"_26939":116900,"_2865":116936},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3379":69606,"_29619":69591,"_20556":116938,"_5":14099,"_26939":116900,"_2865":116939},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3379":69607,"_29619":69591,"_20556":116941,"_5":14099,"_26939":116900,"_2865":116942},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3379":69608,"_29619":69591,"_20556":116944,"_5":14099,"_26939":116904,"_2865":116945},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3379":69609,"_29619":69591,"_20556":116947,"_5":14099,"_26939":116904,"_2865":116948},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3379":69610,"_29619":69591,"_20556":116950,"_5":14099,"_26939":116904,"_2865":116951},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3379":69611,"_29619":69591,"_20556":116953,"_5":14099,"_26939":116904,"_2865":116954},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3379":69612,"_29619":69591,"_20556":116956,"_5":14099,"_26939":116908,"_2865":116957},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_3379":69613,"_29619":69591,"_20556":116959,"_5":14099,"_26939":116908,"_2865":116960},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3379":69614,"_29619":69614,"_5":14457,"_2865":116962,"_29972":116963,"_20556":116964,"_26939":69614},"Estrategias de aprovisionamiento",[48223,115062,50702,116071,116246],[],{"_3379":69615,"_29619":69614,"_20556":116966,"_5":14099,"_26939":69614,"_2865":116967},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3379":69616,"_29619":69614,"_5":29969,"_20556":116969,"_26939":116970,"_2865":116971},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3379":69617,"_29619":69614,"_5":29969,"_20556":116973,"_26939":116974,"_2865":116975},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3379":69618,"_29619":69614,"_5":29969,"_20556":116977,"_26939":116978,"_2865":116979},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3379":69619,"_29619":69614,"_5":29969,"_20556":116981,"_26939":116982,"_2865":116983},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3379":69620,"_29619":69614,"_5":29969,"_20556":116985,"_26939":116986,"_2865":116987},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3379":69621,"_29619":69614,"_20556":116989,"_5":14099,"_26939":69614,"_2865":116990},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3379":69622,"_29619":69614,"_20556":116992,"_5":14099,"_26939":116970,"_2865":116993},[],"Recorrido",{"_3379":69623,"_29619":69614,"_20556":116995,"_5":14099,"_26939":116970,"_2865":116996},[],"Cuándo existe el dispositivo",{"_3379":69624,"_29619":69614,"_20556":116998,"_5":14099,"_26939":116970,"_2865":116999},[],"Qué compruebas",{"_3379":69625,"_29619":69614,"_20556":117001,"_5":14099,"_26939":116970,"_2865":117002},[],"Asignación manual",{"_3379":69626,"_29619":69614,"_20556":117004,"_5":14099,"_26939":116970,"_2865":117005},[],"El operador lo crea antes de asociar un certificado.",{"_3379":69627,"_29619":69614,"_20556":117007,"_5":14099,"_26939":116970,"_2865":117008},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3379":69628,"_29619":69614,"_20556":117010,"_5":14099,"_26939":116970,"_2865":117011},[],"EST con `JITP`",{"_3379":69629,"_29619":69614,"_20556":117013,"_5":14099,"_26939":116970,"_2865":117014},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3379":69630,"_29619":69614,"_20556":117016,"_5":14099,"_26939":116970,"_2865":117017},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3379":69631,"_29619":69614,"_20556":117019,"_5":14099,"_26939":116970,"_2865":117020},[],"EST con `PRE_REGISTRATION`",{"_3379":69632,"_29619":69614,"_20556":117022,"_5":14099,"_26939":116970,"_2865":117023},[],"Debe existir antes de `/simpleenroll`.",{"_3379":69633,"_29619":69614,"_20556":117025,"_5":14099,"_26939":116970,"_2865":117026},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3379":69634,"_29619":69614,"_20556":117028,"_5":14099,"_26939":116970,"_2865":117029},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3379":69635,"_29619":69614,"_20556":117031,"_5":14099,"_26939":116970,"_2865":117032},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3379":69636,"_29619":69614,"_20556":117034,"_5":14099,"_26939":116974,"_2865":117035},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3379":69637,"_29619":69614,"_20556":117037,"_5":14099,"_26939":116974,"_2865":117038},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3379":69638,"_29619":69614,"_20556":117040,"_5":14099,"_26939":116974,"_2865":117041},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3379":69639,"_29619":69614,"_20556":117043,"_5":14099,"_26939":116978,"_2865":117044},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3379":69640,"_29619":69614,"_20556":117046,"_5":14099,"_26939":116978,"_2865":117047},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3379":69641,"_29619":69614,"_20556":117049,"_5":14099,"_26939":116978,"_2865":117050},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3379":69642,"_29619":69614,"_20556":117052,"_5":14099,"_26939":116978,"_2865":117053},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3379":69643,"_29619":69614,"_20556":117055,"_5":14099,"_26939":116978,"_2865":117056},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3379":69644,"_29619":69614,"_20556":117058,"_5":14099,"_26939":116978,"_2865":117059},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3379":69645,"_29619":69614,"_20556":117061,"_5":14099,"_26939":116982,"_2865":114004},[],{"_3379":69646,"_29619":69614,"_20556":117063,"_5":14099,"_26939":116982,"_2865":117064},[],"Material que atraviesa EST",{"_3379":69647,"_29619":69614,"_20556":117066,"_5":14099,"_26939":116982,"_2865":117067},[],"Clave generada por el dispositivo",{"_3379":69648,"_29619":69614,"_20556":117069,"_5":14099,"_26939":116982,"_2865":117070},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3379":69649,"_29619":69614,"_20556":117072,"_5":14099,"_26939":116982,"_2865":117073},[],"Clave ya disponible en el dispositivo",{"_3379":69650,"_29619":69614,"_20556":117075,"_5":14099,"_26939":116982,"_2865":117076},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3379":69651,"_29619":69614,"_20556":117078,"_5":14099,"_26939":116982,"_2865":51021},[],{"_3379":69652,"_29619":69614,"_20556":117080,"_5":14099,"_26939":116982,"_2865":117081},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3379":69653,"_29619":69614,"_20556":117083,"_5":14099,"_26939":116982,"_2865":117084},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3379":69654,"_29619":69614,"_20556":117086,"_5":14099,"_26939":116986,"_2865":117087},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3379":69655,"_29619":69655,"_5":14457,"_2865":117089,"_29972":117090,"_20556":117091,"_26939":69655},"Renovación y recuperación",[48223,115062,50702,116071,116246],[],{"_3379":69656,"_29619":69655,"_20556":117093,"_5":14099,"_26939":69655,"_2865":117094},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_3379":69657,"_29619":69655,"_5":29969,"_20556":117096,"_26939":117097,"_2865":117098},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_3379":69658,"_29619":69655,"_5":29969,"_20556":117100,"_26939":117101,"_2865":117102},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_3379":69659,"_29619":69655,"_5":29969,"_20556":117104,"_26939":117105,"_2865":117106},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_3379":69660,"_29619":69655,"_5":29969,"_20556":117108,"_26939":117109,"_2865":117110},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_3379":69661,"_29619":69655,"_5":29969,"_20556":117112,"_26939":117113,"_2865":117114},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_3379":69662,"_29619":69655,"_20556":117116,"_5":14099,"_26939":69655,"_2865":117117},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_3379":69663,"_29619":69655,"_20556":117119,"_5":14099,"_26939":117097,"_2865":117120},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3379":69664,"_29619":69655,"_20556":117122,"_5":14099,"_26939":117097,"_2865":117123},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3379":69665,"_29619":69655,"_20556":117125,"_5":14099,"_26939":117097,"_2865":117126},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3379":69666,"_29619":69655,"_20556":117128,"_5":14099,"_26939":117097,"_2865":117129},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3379":69667,"_29619":69655,"_20556":117131,"_5":14099,"_26939":117101,"_2865":117132},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3379":69668,"_29619":69655,"_20556":117134,"_5":14099,"_26939":117101,"_2865":117135},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3379":69669,"_29619":69655,"_20556":117137,"_5":14099,"_26939":117105,"_2865":117138},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3379":69670,"_29619":69655,"_20556":117140,"_5":14099,"_26939":117105,"_2865":117141},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3379":69671,"_29619":69655,"_20556":117143,"_5":14099,"_26939":117105,"_2865":117144},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3379":69672,"_29619":69655,"_20556":117146,"_5":14099,"_26939":117109,"_2865":117147},[],"Situación",{"_3379":69673,"_29619":69655,"_20556":117149,"_5":14099,"_26939":117109,"_2865":117150},[],"Procedimiento",{"_3379":69674,"_29619":69655,"_20556":117152,"_5":14099,"_26939":117109,"_2865":117153},[],"Certificado vigente, fuera de ventana",{"_3379":69675,"_29619":69655,"_20556":117155,"_5":14099,"_26939":117109,"_2865":117156},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3379":69676,"_29619":69655,"_20556":117158,"_5":14099,"_26939":117109,"_2865":117159},[],"Certificado vencido, clave disponible",{"_3379":69677,"_29619":69655,"_20556":117161,"_5":14099,"_26939":117109,"_2865":117162},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3379":69678,"_29619":69655,"_20556":117164,"_5":14099,"_26939":117109,"_2865":117165},[],"Renovación por webhook o `NO_AUTH`",{"_3379":69679,"_29619":69655,"_20556":117167,"_5":14099,"_26939":117109,"_2865":117168},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3379":69680,"_29619":69655,"_20556":117170,"_5":14099,"_26939":117109,"_2865":117171},[],"Clave perdida o inaccesible",{"_3379":69681,"_29619":69655,"_20556":117173,"_5":14099,"_26939":117109,"_2865":117174},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3379":69682,"_29619":69655,"_20556":117176,"_5":14099,"_26939":117109,"_2865":117177},[],"Identidad actual revocada",{"_3379":69683,"_29619":69655,"_20556":117179,"_5":14099,"_26939":117109,"_2865":117180},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3379":69684,"_29619":69655,"_20556":117182,"_5":14099,"_26939":117109,"_2865":117183},[],"Dispositivo sin identidad",{"_3379":69685,"_29619":69655,"_20556":117185,"_5":14099,"_26939":117109,"_2865":117186},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3379":69686,"_29619":69655,"_20556":117188,"_5":14099,"_26939":117109,"_2865":117189},[],"Dispositivo retirado",{"_3379":69687,"_29619":69655,"_20556":117191,"_5":14099,"_26939":117109,"_2865":117192},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3379":69688,"_29619":69655,"_20556":117194,"_5":14099,"_26939":117109,"_2865":117195},[],"Timeout, HTTP 500 o fallo de instalación",{"_3379":69689,"_29619":69655,"_20556":117197,"_5":14099,"_26939":117109,"_2865":117198},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3379":69690,"_29619":69655,"_20556":117200,"_5":14099,"_26939":117113,"_2865":117201},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3379":69691,"_29619":69655,"_20556":117203,"_5":14099,"_26939":117113,"_2865":117204},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3379":69692,"_29619":69692,"_5":14457,"_2865":117206,"_29972":117207,"_20556":117208,"_26939":69692},"Diagnóstico de enrolamiento",[48223,115062,50702,116071,116246],[],{"_3379":69693,"_29619":69692,"_20556":117210,"_5":14099,"_26939":69692,"_2865":117211},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3379":69694,"_29619":69692,"_5":29969,"_20556":117213,"_26939":117214,"_2865":117215},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3379":69695,"_29619":69692,"_5":29969,"_20556":117217,"_26939":117218,"_2865":117219},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3379":69696,"_29619":69692,"_5":29969,"_20556":117221,"_26939":117222,"_2865":116778},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_3379":69697,"_29619":69692,"_5":29969,"_20556":117224,"_26939":117225,"_2865":117226},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3379":69698,"_29619":69692,"_20556":117228,"_5":14099,"_26939":69692,"_2865":117229},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3379":69699,"_29619":69692,"_20556":117231,"_5":14099,"_26939":117218,"_2865":117232},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3379":69700,"_29619":69692,"_20556":117234,"_5":14099,"_26939":117218,"_2865":117235},[],"Síntoma o mensaje",{"_3379":69701,"_29619":69692,"_20556":117237,"_5":14099,"_26939":117218,"_2865":117238},[],"Qué revisar",{"_3379":69702,"_29619":69692,"_20556":117240,"_5":14099,"_26939":117218,"_2865":117241},[],"curl rechaza TLS, nombre o emisor",{"_3379":69703,"_29619":69692,"_20556":117243,"_5":14099,"_26939":117218,"_2865":117244},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3379":69704,"_29619":69692,"_20556":117246,"_5":14099,"_26939":117218,"_2865":117247},[],"404 o APS ausente",{"_3379":69705,"_29619":69692,"_20556":117249,"_5":14099,"_26939":117218,"_2865":117250},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3379":69706,"_29619":69692,"_20556":117252,"_5":14099,"_26939":117218,"_2865":117253},[],"400, error de CSR o formato",{"_3379":69707,"_29619":69692,"_20556":117255,"_5":14099,"_26939":117218,"_2865":117256},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3379":69708,"_29619":69692,"_20556":117258,"_5":14099,"_26939":117218,"_2865":117259},[],"Credencial ausente o certificado no válido",{"_3379":69709,"_29619":69692,"_20556":117261,"_5":14099,"_26939":117218,"_2865":117262},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3379":69710,"_29619":69692,"_20556":117264,"_5":14099,"_26939":117218,"_2865":117265},[],"Webhook deniega, expira o responde sin autorización",{"_3379":69711,"_29619":69692,"_20556":117267,"_5":14099,"_26939":117218,"_2865":117268},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3379":69712,"_29619":69692,"_20556":117270,"_5":14099,"_26939":117218,"_2865":51947},[],{"_3379":69713,"_29619":69692,"_20556":117272,"_5":14099,"_26939":117218,"_2865":117273},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3379":69714,"_29619":69692,"_20556":117275,"_5":14099,"_26939":117218,"_2865":51953},[],{"_3379":69715,"_29619":69692,"_20556":117277,"_5":14099,"_26939":117218,"_2865":117278},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3379":69716,"_29619":69692,"_20556":117280,"_5":14099,"_26939":117218,"_2865":51959},[],{"_3379":69717,"_29619":69692,"_20556":117282,"_5":14099,"_26939":117218,"_2865":117283},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3379":69718,"_29619":69692,"_20556":117285,"_5":14099,"_26939":117218,"_2865":51965},[],{"_3379":69719,"_29619":69692,"_20556":117287,"_5":14099,"_26939":117218,"_2865":117288},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3379":69720,"_29619":69692,"_20556":117290,"_5":14099,"_26939":117218,"_2865":51971},[],{"_3379":69721,"_29619":69692,"_20556":117292,"_5":14099,"_26939":117218,"_2865":117293},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3379":69722,"_29619":69692,"_20556":117295,"_5":14099,"_26939":117218,"_2865":117296},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3379":69723,"_29619":69692,"_20556":117298,"_5":14099,"_26939":117218,"_2865":117299},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3379":69724,"_29619":69692,"_20556":117301,"_5":14099,"_26939":117218,"_2865":117302},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3379":69725,"_29619":69692,"_20556":117304,"_5":14099,"_26939":117218,"_2865":117305},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3379":69726,"_29619":69692,"_20556":117307,"_5":14099,"_26939":117218,"_2865":51989},[],{"_3379":69727,"_29619":69692,"_20556":117309,"_5":14099,"_26939":117218,"_2865":117310},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3379":69728,"_29619":69692,"_20556":117312,"_5":14099,"_26939":117218,"_2865":51995},[],{"_3379":69729,"_29619":69692,"_20556":117314,"_5":14099,"_26939":117218,"_2865":117315},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3379":69730,"_29619":69692,"_20556":117317,"_5":14099,"_26939":117218,"_2865":117318},[],"DMS propietario distinto",{"_3379":69731,"_29619":69692,"_20556":117320,"_5":14099,"_26939":117218,"_2865":117321},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3379":69732,"_29619":69692,"_20556":117323,"_5":14099,"_26939":117218,"_2865":52007},[],{"_3379":69733,"_29619":69692,"_20556":117325,"_5":14099,"_26939":117218,"_2865":117326},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3379":69734,"_29619":69692,"_20556":117328,"_5":14099,"_26939":117218,"_2865":52013},[],{"_3379":69735,"_29619":69692,"_20556":117330,"_5":14099,"_26939":117218,"_2865":117331},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3379":69736,"_29619":69692,"_20556":117333,"_5":14099,"_26939":117218,"_2865":117334},[],"Certificado actual revocado",{"_3379":69737,"_29619":69692,"_20556":117336,"_5":14099,"_26939":117218,"_2865":117337},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3379":69738,"_29619":69692,"_20556":117339,"_5":14099,"_26939":117218,"_2865":117340},[],"Error de CA, perfil o firma",{"_3379":69739,"_29619":69692,"_20556":117342,"_5":14099,"_26939":117218,"_2865":117343},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3379":69740,"_29619":69692,"_20556":117345,"_5":14099,"_26939":117218,"_2865":117346},[],"HTTP 200 sin conexión del dispositivo",{"_3379":69741,"_29619":69692,"_20556":117348,"_5":14099,"_26939":117218,"_2865":117349},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3379":69742,"_29619":69692,"_20556":117351,"_5":14099,"_26939":117218,"_2865":117352},[],"Timeout o error después de emitir",{"_3379":69743,"_29619":69692,"_20556":117354,"_5":14099,"_26939":117218,"_2865":117355},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3379":69744,"_29619":69692,"_20556":117357,"_5":14099,"_26939":117222,"_2865":117358},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3379":69745,"_29619":69692,"_20556":117360,"_5":14099,"_26939":117222,"_2865":117361},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_3379":69746,"_29619":69692,"_20556":117363,"_5":14099,"_26939":117225,"_2865":117364},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3379":69747,"_29619":69692,"_20556":117366,"_5":14099,"_26939":117225,"_2865":117367},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3379":69748,"_29619":69692,"_20556":117369,"_5":14099,"_26939":117225,"_2865":117370},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3379":69749,"_29619":69692,"_20556":117372,"_5":14099,"_26939":117225,"_2865":117373},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3379":69750,"_29619":69692,"_20556":117375,"_5":14099,"_26939":117225,"_2865":117376},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3379":69751,"_29619":69692,"_20556":117378,"_5":14099,"_26939":117225,"_2865":117379},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3379":69752,"_29619":69692,"_20556":117381,"_5":14099,"_26939":117225,"_2865":117382},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3379":69753,"_29619":69753,"_5":14457,"_2865":117384,"_29972":117385,"_20556":117386,"_26939":69753},"Distribución y actualización de confianza",[48223,115062,50702,116071,116246],[],{"_3379":69754,"_29619":69753,"_20556":117388,"_5":14099,"_26939":69753,"_2865":117389},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_3379":69755,"_29619":69753,"_5":29969,"_20556":117391,"_26939":117392,"_2865":117393},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_3379":69756,"_29619":69753,"_5":29969,"_20556":117395,"_26939":117396,"_2865":117397},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_3379":69757,"_29619":69753,"_5":29969,"_20556":117399,"_26939":117400,"_2865":117401},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_3379":69758,"_29619":69753,"_5":29969,"_20556":117403,"_26939":117404,"_2865":117405},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_3379":69759,"_29619":69753,"_5":29969,"_20556":117407,"_26939":117408,"_2865":117409},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_3379":69760,"_29619":69753,"_20556":117411,"_5":14099,"_26939":69753,"_2865":117412},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_3379":69761,"_29619":69753,"_20556":117414,"_5":14099,"_26939":117392,"_2865":117415},[],"Relación",{"_3379":69762,"_29619":69753,"_20556":117417,"_5":14099,"_26939":117392,"_2865":117418},[],"Material que prepara el responsable",{"_3379":69763,"_29619":69753,"_20556":117420,"_5":14099,"_26939":117392,"_2865":117421},[],"Dispositivo → servidor EST",{"_3379":69764,"_29619":69753,"_20556":117423,"_5":14099,"_26939":117392,"_2865":117424},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_3379":69765,"_29619":69753,"_20556":117426,"_5":14099,"_26939":117392,"_2865":117427},[],"DMS → solicitante",{"_3379":69766,"_29619":69753,"_20556":117429,"_5":14099,"_26939":117392,"_2865":117430},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_3379":69767,"_29619":69753,"_20556":117432,"_5":14099,"_26939":117392,"_2865":117433},[],"Consumidor → dispositivo",{"_3379":69768,"_29619":69753,"_20556":117435,"_5":14099,"_26939":117392,"_2865":117436},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_3379":69769,"_29619":69753,"_20556":117438,"_5":14099,"_26939":117392,"_2865":117439},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_3379":69770,"_29619":69753,"_20556":117441,"_5":14099,"_26939":117396,"_2865":117442},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3379":69771,"_29619":69753,"_20556":117444,"_5":14099,"_26939":117396,"_2865":117445},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3379":69772,"_29619":69753,"_20556":117447,"_5":14099,"_26939":117400,"_2865":117448},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_3379":69773,"_29619":69753,"_20556":117450,"_5":14099,"_26939":117400,"_2865":117451},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_3379":69774,"_29619":69753,"_20556":117453,"_5":14099,"_26939":117400,"_2865":117454},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_3379":69775,"_29619":69753,"_20556":117456,"_5":14099,"_26939":117400,"_2865":117457},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_3379":69776,"_29619":69753,"_20556":117459,"_5":14099,"_26939":117400,"_2865":117460},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_3379":69777,"_29619":69753,"_20556":117462,"_5":14099,"_26939":117400,"_2865":117463},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_3379":69778,"_29619":69753,"_20556":117465,"_5":14099,"_26939":117404,"_2865":117466},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_3379":69779,"_29619":69753,"_20556":117468,"_5":14099,"_26939":117404,"_2865":117469},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_3379":69780,"_29619":69753,"_20556":117471,"_5":14099,"_26939":117404,"_2865":117472},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_3379":69781,"_29619":69753,"_20556":117474,"_5":14099,"_26939":117408,"_2865":117475},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_3379":69782,"_29619":69782,"_5":14457,"_2865":52162,"_29972":117477,"_20556":117479,"_26939":69782},[48223,115062,50702,116071,117478],"Integraciones",[],{"_3379":69783,"_29619":69782,"_20556":117481,"_5":14099,"_26939":69782,"_2865":117482},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3379":69784,"_29619":69782,"_5":29969,"_20556":117484,"_26939":117485,"_2865":117486},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3379":69785,"_29619":69782,"_5":29969,"_20556":117488,"_26939":117489,"_2865":117490},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3379":69786,"_29619":69782,"_5":29969,"_20556":117492,"_26939":117493,"_2865":117494},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3379":69787,"_29619":69782,"_5":29969,"_20556":117496,"_26939":117497,"_2865":117498},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3379":69788,"_29619":69782,"_5":29969,"_20556":117500,"_26939":117501,"_2865":117502},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","Eventos y recursos de AWS",{"_3379":69789,"_29619":69782,"_5":29969,"_20556":117504,"_26939":117505,"_2865":117506},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3379":69790,"_29619":69782,"_5":29969,"_20556":117508,"_26939":117509,"_2865":117510},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3379":69791,"_29619":69782,"_5":29969,"_20556":117512,"_26939":117513,"_2865":117514},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","Estados del registro de la CA",{"_3379":69792,"_29619":69782,"_5":29969,"_20556":117516,"_26939":117517,"_2865":52204},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3379":69793,"_29619":69782,"_5":29969,"_20556":117519,"_26939":117520,"_2865":52208},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3379":69794,"_29619":69782,"_5":29969,"_20556":117522,"_26939":117523,"_2865":117524},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3379":69795,"_29619":69782,"_5":29969,"_20556":117526,"_26939":117527,"_2865":117528},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3379":69796,"_29619":69782,"_5":29969,"_20556":117530,"_26939":117531,"_2865":117532},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3379":69797,"_29619":69782,"_5":29969,"_20556":117534,"_26939":117535,"_2865":117536},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3379":69798,"_29619":69782,"_5":29969,"_20556":117538,"_26939":117539,"_2865":117540},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","Estados del modo de registro del DMS",{"_3379":69799,"_29619":69782,"_5":29969,"_20556":117542,"_26939":117543,"_2865":117544},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3379":69800,"_29619":69782,"_5":29969,"_20556":117546,"_26939":117547,"_2865":117548},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","Ciclo de vida del Thing",{"_3379":69801,"_29619":69782,"_5":29969,"_20556":117550,"_26939":117551,"_2865":117552},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3379":69802,"_29619":69782,"_5":29969,"_20556":117554,"_26939":117555,"_2865":117556},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3379":69803,"_29619":69782,"_5":29969,"_20556":117558,"_26939":117559,"_2865":117560},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","Estados del certificado",{"_3379":69804,"_29619":69782,"_5":29969,"_20556":117562,"_26939":117563,"_2865":117564},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3379":69805,"_29619":69782,"_5":29969,"_20556":117566,"_26939":117567,"_2865":117568},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3379":69806,"_29619":69782,"_5":29969,"_20556":117570,"_26939":117571,"_2865":117572},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3379":69807,"_29619":69782,"_5":29969,"_20556":117574,"_26939":117575,"_2865":117576},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3379":69808,"_29619":69782,"_5":29969,"_20556":117578,"_26939":117579,"_2865":117580},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3379":69809,"_29619":69782,"_20556":117582,"_5":14099,"_26939":69782,"_2865":117583},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3379":69810,"_29619":69782,"_20556":117585,"_5":14099,"_26939":69782,"_2865":117586},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3379":69811,"_29619":69782,"_20556":117588,"_5":14099,"_26939":69782,"_2865":117589},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3379":69812,"_29619":69782,"_20556":117591,"_5":14099,"_26939":117485,"_2865":117592},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3379":69813,"_29619":69782,"_20556":117594,"_5":14099,"_26939":117485,"_2865":117595},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3379":69814,"_29619":69782,"_20556":117597,"_5":14099,"_26939":117485,"_2865":117598},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3379":69815,"_29619":69782,"_20556":117600,"_5":14099,"_26939":117485,"_2865":117601},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3379":69816,"_29619":69782,"_20556":117603,"_5":14099,"_26939":117489,"_2865":117604},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3379":69817,"_29619":69782,"_20556":117606,"_5":14099,"_26939":117493,"_2865":117607},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3379":69818,"_29619":69782,"_20556":117609,"_5":14099,"_26939":117493,"_2865":117610},[],"Acción IAM",{"_3379":69819,"_29619":69782,"_20556":117612,"_5":14099,"_26939":117493,"_2865":114010},[],{"_3379":69820,"_29619":69782,"_20556":117614,"_5":14099,"_26939":117493,"_2865":52303},[],{"_3379":69821,"_29619":69782,"_20556":117616,"_5":14099,"_26939":117493,"_2865":117617},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3379":69822,"_29619":69782,"_20556":117619,"_5":14099,"_26939":117493,"_2865":52309},[],{"_3379":69823,"_29619":69782,"_20556":117621,"_5":14099,"_26939":117493,"_2865":117622},[],"Registrar la CA en AWS IoT",{"_3379":69824,"_29619":69782,"_20556":117624,"_5":14099,"_26939":117493,"_2865":52315},[],{"_3379":69825,"_29619":69782,"_20556":117626,"_5":14099,"_26939":117493,"_2865":117627},[],"Consultar el estado del registro de la CA",{"_3379":69826,"_29619":69782,"_20556":117629,"_5":14099,"_26939":117493,"_2865":52321},[],{"_3379":69827,"_29619":69782,"_20556":117631,"_5":14099,"_26939":117493,"_2865":117632},[],"Crear o actualizar Things en IoT Core",{"_3379":69828,"_29619":69782,"_20556":117634,"_5":14099,"_26939":117493,"_2865":52327},[],{"_3379":69829,"_29619":69782,"_20556":117636,"_5":14099,"_26939":117493,"_2865":117637},[],"Aprovisionar Things mediante plantilla",{"_3379":69830,"_29619":69782,"_20556":117639,"_5":14099,"_26939":117493,"_2865":52333},[],{"_3379":69831,"_29619":69782,"_20556":117641,"_5":14099,"_26939":117493,"_2865":117642},[],"Registrar certificados de dispositivo",{"_3379":69832,"_29619":69782,"_20556":117644,"_5":14099,"_26939":117493,"_2865":52339},[],{"_3379":69833,"_29619":69782,"_20556":117646,"_5":14099,"_26939":117493,"_2865":117647},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3379":69834,"_29619":69782,"_20556":117649,"_5":14099,"_26939":117493,"_2865":52345},[],{"_3379":69835,"_29619":69782,"_20556":117651,"_5":14099,"_26939":117493,"_2865":117652},[],"Crear y adjuntar políticas IoT",{"_3379":69836,"_29619":69782,"_20556":117654,"_5":14099,"_26939":117493,"_2865":52351},[],{"_3379":69837,"_29619":69782,"_20556":117656,"_5":14099,"_26939":117493,"_2865":117657},[],"Gestionar grupos de Things",{"_3379":69838,"_29619":69782,"_20556":117659,"_5":14099,"_26939":117493,"_2865":52357},[],{"_3379":69839,"_29619":69782,"_20556":117661,"_5":14099,"_26939":117493,"_2865":117662},[],"Crear plantillas JITP",{"_3379":69840,"_29619":69782,"_20556":117664,"_5":14099,"_26939":117493,"_2865":52363},[],{"_3379":69841,"_29619":69782,"_20556":117666,"_5":14099,"_26939":117493,"_2865":117667},[],"Leer y escribir el Device Shadow",{"_3379":69842,"_29619":69782,"_20556":117669,"_5":14099,"_26939":117493,"_2865":117670},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3379":69843,"_29619":69782,"_20556":117672,"_5":14099,"_26939":117497,"_2865":117673},[],"Parámetro",{"_3379":69844,"_29619":69782,"_20556":117675,"_5":14099,"_26939":117497,"_2865":117676},[],"Tipo",{"_3379":69845,"_29619":69782,"_20556":117678,"_5":14099,"_26939":117497,"_2865":117679},[],"Requerido",{"_3379":69846,"_29619":69782,"_20556":117681,"_5":14099,"_26939":117497,"_2865":117682},[],"Descripción",{"_3379":69847,"_29619":69782,"_20556":117684,"_5":14099,"_26939":117497,"_2865":52384},[],{"_3379":69848,"_29619":69782,"_20556":117686,"_5":14099,"_26939":117497,"_2865":24560},[],{"_3379":69849,"_29619":69782,"_20556":117688,"_5":14099,"_26939":117497,"_2865":117689},[],"Sí",{"_3379":69850,"_29619":69782,"_20556":117691,"_5":14099,"_26939":117497,"_2865":117692},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3379":69851,"_29619":69782,"_20556":117694,"_5":14099,"_26939":117497,"_2865":52395},[],{"_3379":69852,"_29619":69782,"_20556":117696,"_5":14099,"_26939":117497,"_2865":24560},[],{"_3379":69853,"_29619":69782,"_20556":117698,"_5":14099,"_26939":117497,"_2865":117689},[],{"_3379":69854,"_29619":69782,"_20556":117700,"_5":14099,"_26939":117497,"_2865":117701},[],"Región AWS donde opera el conector.",{"_3379":69855,"_29619":69782,"_20556":117703,"_5":14099,"_26939":117497,"_2865":52405},[],{"_3379":69856,"_29619":69782,"_20556":117705,"_5":14099,"_26939":117497,"_2865":24560},[],{"_3379":69857,"_29619":69782,"_20556":117707,"_5":14099,"_26939":117497,"_2865":117689},[],{"_3379":69858,"_29619":69782,"_20556":117709,"_5":14099,"_26939":117497,"_2865":117710},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3379":69859,"_29619":69782,"_20556":117712,"_5":14099,"_26939":117497,"_2865":52415},[],{"_3379":69860,"_29619":69782,"_20556":117714,"_5":14099,"_26939":117497,"_2865":24560},[],{"_3379":69861,"_29619":69782,"_20556":117716,"_5":14099,"_26939":117497,"_2865":117717},[],"Solo con `auth_method=static`",{"_3379":69862,"_29619":69782,"_20556":117719,"_5":14099,"_26939":117497,"_2865":117720},[],"Clave de acceso AWS.",{"_3379":69863,"_29619":69782,"_20556":117722,"_5":14099,"_26939":117497,"_2865":52426},[],{"_3379":69864,"_29619":69782,"_20556":117724,"_5":14099,"_26939":117497,"_2865":24560},[],{"_3379":69865,"_29619":69782,"_20556":117726,"_5":14099,"_26939":117497,"_2865":117717},[],{"_3379":69866,"_29619":69782,"_20556":117728,"_5":14099,"_26939":117497,"_2865":117729},[],"Clave secreta AWS.",{"_3379":69867,"_29619":69782,"_20556":117731,"_5":14099,"_26939":117497,"_2865":52436},[],{"_3379":69868,"_29619":69782,"_20556":117733,"_5":14099,"_26939":117497,"_2865":24560},[],{"_3379":69869,"_29619":69782,"_20556":117735,"_5":14099,"_26939":117497,"_2865":52441},[],{"_3379":69870,"_29619":69782,"_20556":117737,"_5":14099,"_26939":117497,"_2865":117738},[],"Token de sesión (con `auth_method=static`).",{"_3379":69871,"_29619":69782,"_20556":117740,"_5":14099,"_26939":117497,"_2865":52447},[],{"_3379":69872,"_29619":69782,"_20556":117742,"_5":14099,"_26939":117497,"_2865":24560},[],{"_3379":69873,"_29619":69782,"_20556":117744,"_5":14099,"_26939":117497,"_2865":117745},[],"Solo con `auth_method=role`",{"_3379":69874,"_29619":69782,"_20556":117747,"_5":14099,"_26939":117497,"_2865":117748},[],"ARN del rol a asumir.",{"_3379":69875,"_29619":69782,"_20556":117750,"_5":14099,"_26939":117497,"_2865":52458},[],{"_3379":69876,"_29619":69782,"_20556":117752,"_5":14099,"_26939":117497,"_2865":24560},[],{"_3379":69877,"_29619":69782,"_20556":117754,"_5":14099,"_26939":117497,"_2865":52441},[],{"_3379":69878,"_29619":69782,"_20556":117756,"_5":14099,"_26939":117497,"_2865":117757},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3379":69879,"_29619":69782,"_20556":117759,"_5":14099,"_26939":117497,"_2865":52468},[],{"_3379":69880,"_29619":69782,"_20556":117761,"_5":14099,"_26939":117497,"_2865":87685},[],{"_3379":69881,"_29619":69782,"_20556":117763,"_5":14099,"_26939":117497,"_2865":117689},[],{"_3379":69882,"_29619":69782,"_20556":117765,"_5":14099,"_26939":117497,"_2865":117766},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3379":69883,"_29619":69782,"_20556":117768,"_5":14099,"_26939":117497,"_2865":52478},[],{"_3379":69884,"_29619":69782,"_20556":117770,"_5":14099,"_26939":117497,"_2865":24560},[],{"_3379":69885,"_29619":69782,"_20556":117772,"_5":14099,"_26939":117497,"_2865":117689},[],{"_3379":69886,"_29619":69782,"_20556":117774,"_5":14099,"_26939":117497,"_2865":117775},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3379":69887,"_29619":69782,"_20556":117777,"_5":14099,"_26939":117497,"_2865":52488},[],{"_3379":69888,"_29619":69782,"_20556":117779,"_5":14099,"_26939":117497,"_2865":24560},[],{"_3379":69889,"_29619":69782,"_20556":117781,"_5":14099,"_26939":117497,"_2865":117689},[],{"_3379":69890,"_29619":69782,"_20556":117783,"_5":14099,"_26939":117497,"_2865":117784},[],"URL HTTP del Device Manager de Lamassu.",{"_3379":69891,"_29619":69782,"_20556":117786,"_5":14099,"_26939":117497,"_2865":52498},[],{"_3379":69892,"_29619":69782,"_20556":117788,"_5":14099,"_26939":117497,"_2865":24560},[],{"_3379":69893,"_29619":69782,"_20556":117790,"_5":14099,"_26939":117497,"_2865":117689},[],{"_3379":69894,"_29619":69782,"_20556":117792,"_5":14099,"_26939":117497,"_2865":117793},[],"URL HTTP del servicio de CA de Lamassu.",{"_3379":69895,"_29619":69782,"_20556":117795,"_5":14099,"_26939":117501,"_2865":117796},[],"El conector gestiona el lado AWS de cuatro tipos de recursos: CAs, plantillas de aprovisionamiento de DMS (JITP), certificados de dispositivo y Things. Esta sección mapea los eventos del bus que consume el conector a los recursos de AWS que toca y a las llamadas AWS que ejecuta cada flujo. La máquina de estados de cada recurso está junto a su explicación detallada; la última columna enlaza a ella. Los recursos de AWS se referencian con la notación `IoTCore/<recurso>`.",{"_3379":69896,"_29619":69782,"_20556":117798,"_5":14099,"_26939":117501,"_2865":117799},[],"La columna **Tipo de CloudEvent** lista el nombre del evento en el bus interno de Lamassu; la columna **Acciones IAM** lista las operaciones exactas del SDK de AWS que invoca cada flujo, para que los permisos necesarios se deriven directamente de esta tabla.",{"_3379":69897,"_29619":69782,"_20556":117801,"_5":14099,"_26939":117501,"_2865":117802},[],"Tipo de CloudEvent",{"_3379":69898,"_29619":69782,"_20556":117804,"_5":14099,"_26939":117501,"_2865":117805},[],"Recurso en Lamassu",{"_3379":69899,"_29619":69782,"_20556":117807,"_5":14099,"_26939":117501,"_2865":117808},[],"Recurso AWS",{"_3379":69900,"_29619":69782,"_20556":117810,"_5":14099,"_26939":117501,"_2865":117811},[],"Acciones IAM",{"_3379":69901,"_29619":69782,"_20556":117813,"_5":14099,"_26939":117501,"_2865":117814},[],"Llamadas AWS y efecto",{"_3379":69902,"_29619":69782,"_20556":117816,"_5":14099,"_26939":117501,"_2865":117817},[],"Dónde en esta página",{"_3379":69903,"_29619":69782,"_20556":117819,"_5":14099,"_26939":117501,"_2865":52532},[],{"_3379":69904,"_29619":69782,"_20556":117821,"_5":14099,"_26939":117501,"_2865":52535},[],{"_3379":69905,"_29619":69782,"_20556":117823,"_5":14099,"_26939":117501,"_2865":52538},[],{"_3379":69906,"_29619":69782,"_20556":117825,"_5":14099,"_26939":117501,"_2865":52541},[],{"_3379":69907,"_29619":69782,"_20556":117827,"_5":14099,"_26939":117501,"_2865":117828},[],"Carga la CA en el estado del conector; una escritura de `registration.status = REQUESTED` dispara el flujo de registro (Primary con certificado de verificación, o SNI-only) y escribe `SUCCEEDED` o `FAILED` en los metadatos de la CA.",{"_3379":69908,"_29619":69782,"_20556":117830,"_5":14099,"_26939":117501,"_2865":117514},[],{"_3379":69909,"_29619":69782,"_20556":117832,"_5":14099,"_26939":117501,"_2865":52549},[],{"_3379":69910,"_29619":69782,"_20556":117834,"_5":14099,"_26939":117501,"_2865":52552},[],{"_3379":69911,"_29619":69782,"_20556":117836,"_5":14099,"_26939":117501,"_2865":52555},[],{"_3379":69912,"_29619":69782,"_20556":117838,"_5":14099,"_26939":117501,"_2865":52558},[],{"_3379":69913,"_29619":69782,"_20556":117840,"_5":14099,"_26939":117501,"_2865":117841},[],"En modo `jitp`, intenta crear la plantilla de aprovisionamiento y la adjunta a la CA registrada. No idempotente: una edición `PUT /v1/dms/{id}` reintenta la creación y acaba en `lamassu-dlq` tras 3 reintentos. Idempotente para `none` y `auto` (solo configuración).",{"_3379":69914,"_29619":69782,"_20556":117843,"_5":14099,"_26939":117501,"_2865":117540},[],{"_3379":69915,"_29619":69782,"_20556":117845,"_5":14099,"_26939":117501,"_2865":52566},[],{"_3379":69916,"_29619":69782,"_20556":117847,"_5":14099,"_26939":117501,"_2865":117848},[],"Dispositivo",{"_3379":69917,"_29619":69782,"_20556":117850,"_5":14099,"_26939":117501,"_2865":52572},[],{"_3379":69918,"_29619":69782,"_20556":117852,"_5":14099,"_26939":117501,"_2865":52575},[],{"_3379":69919,"_29619":69782,"_20556":117854,"_5":14099,"_26939":117501,"_2865":117855},[],"En modo `auto`: crea/actualiza políticas, asegura los grupos de Things, revoca principals obsoletos y aprovisiona el Thing vía `iot:RegisterThing`. En modo `jitp`: no hay llamadas AWS; AWS ejecuta la plantilla JITP en la primera conexión.",{"_3379":69920,"_29619":69782,"_20556":117857,"_5":14099,"_26939":117501,"_2865":117548},[],{"_3379":69921,"_29619":69782,"_20556":117859,"_5":14099,"_26939":117501,"_2865":52583},[],{"_3379":69922,"_29619":69782,"_20556":117861,"_5":14099,"_26939":117501,"_2865":117862},[],"Certificado",{"_3379":69923,"_29619":69782,"_20556":117864,"_5":14099,"_26939":117501,"_2865":52589},[],{"_3379":69924,"_29619":69782,"_20556":117866,"_5":14099,"_26939":117501,"_2865":117867},[],"`iot:UpdateCertificate`, `iot:Connect` (plano de datos)",{"_3379":69925,"_29619":69782,"_20556":117869,"_5":14099,"_26939":117501,"_2865":117870},[],"Mapea el estado a AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), llama a `iot:UpdateCertificate` y fuerza una desconexión MQTT al revocar.",{"_3379":69926,"_29619":69782,"_20556":117872,"_5":14099,"_26939":117501,"_2865":117560},[],{"_3379":69927,"_29619":69782,"_20556":117874,"_5":14099,"_26939":117501,"_2865":52600},[],{"_3379":69928,"_29619":69782,"_20556":117876,"_5":14099,"_26939":117501,"_2865":117877},[],"Certificado / Dispositivo",{"_3379":69929,"_29619":69782,"_20556":117879,"_5":14099,"_26939":117501,"_2865":52606},[],{"_3379":69930,"_29619":69782,"_20556":117881,"_5":14099,"_26939":117501,"_2865":48619},[],{"_3379":69931,"_29619":69782,"_20556":117883,"_5":14099,"_26939":117501,"_2865":117884},[],"Refresca el estado interno; el conector ignora los eventos cuyo campo CloudEvent `source` coincide con su propia URI para evitar bucles autodisparados.",{"_3379":69932,"_29619":69782,"_20556":117886,"_5":14099,"_26939":117501,"_2865":117568},[],{"_3379":69933,"_29619":69782,"_20556":117888,"_5":14099,"_26939":117505,"_2865":117889},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3379":69934,"_29619":69782,"_20556":117891,"_5":14099,"_26939":117509,"_2865":117892},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3379":69935,"_29619":69782,"_20556":117894,"_5":14099,"_26939":117509,"_2865":117895},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3379":69936,"_29619":69782,"_20556":117897,"_5":14099,"_26939":117513,"_2865":117898},[],"El flujo de registro de la CA se gobierna por el campo `registration.status` de los metadatos del conector en la CA:",{"_3379":69937,"_29619":69782,"_20556":117900,"_5":14099,"_26939":117513,"_2865":117901},[],"Transición",{"_3379":69938,"_29619":69782,"_20556":117903,"_5":14099,"_26939":117513,"_2865":117904},[],"Llamadas AWS",{"_3379":69939,"_29619":69782,"_20556":117906,"_5":14099,"_26939":117513,"_2865":117907},[],"`NoRegistrada` → `Solicitada`",{"_3379":69940,"_29619":69782,"_20556":117909,"_5":14099,"_26939":117513,"_2865":117910},[],"ninguna (solo escritura de metadatos)",{"_3379":69941,"_29619":69782,"_20556":117912,"_5":14099,"_26939":117513,"_2865":117913},[],"`Solicitada` → `Registrando`",{"_3379":69942,"_29619":69782,"_20556":117915,"_5":14099,"_26939":117513,"_2865":117916},[],"`iot:GetRegistrationCode` (solo Primary Account)",{"_3379":69943,"_29619":69782,"_20556":117918,"_5":14099,"_26939":117513,"_2865":117919},[],"`Registrando` → `Completada`",{"_3379":69944,"_29619":69782,"_20556":117921,"_5":14099,"_26939":117513,"_2865":117922},[],"`iot:RegisterCACertificate` (Primary: prueba de posesión con clave efímera; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3379":69945,"_29619":69782,"_20556":117924,"_5":14099,"_26939":117513,"_2865":117925},[],"`Registrando` → `Fallida`",{"_3379":69946,"_29619":69782,"_20556":117927,"_5":14099,"_26939":117513,"_2865":117928},[],"`iot:RegisterCACertificate` fallida; el detalle del error se escribe en los metadatos de la CA",{"_3379":69947,"_29619":69782,"_20556":117930,"_5":14099,"_26939":117513,"_2865":117931},[],"`Fallida` / `Completada` → `Solicitada`",{"_3379":69948,"_29619":69782,"_20556":117933,"_5":14099,"_26939":117513,"_2865":117934},[],"ninguna (una nueva escritura `REQUESTED` reejecuta el flujo)",{"_3379":69949,"_29619":69782,"_20556":117936,"_5":14099,"_26939":117517,"_2865":117937},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3379":69950,"_29619":69782,"_20556":117939,"_5":14099,"_26939":117517,"_2865":117940},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3379":69951,"_29619":69782,"_20556":117942,"_5":14099,"_26939":117517,"_2865":117943},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3379":69952,"_29619":69782,"_20556":117945,"_5":14099,"_26939":117517,"_2865":117946},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3379":69953,"_29619":69782,"_20556":117948,"_5":14099,"_26939":117517,"_2865":117949},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3379":69954,"_29619":69782,"_20556":117951,"_5":14099,"_26939":117517,"_2865":117952},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3379":69955,"_29619":69782,"_20556":117954,"_5":14099,"_26939":117520,"_2865":117955},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3379":69956,"_29619":69782,"_20556":117957,"_5":14099,"_26939":117523,"_2865":117958},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3379":69957,"_29619":69782,"_20556":117960,"_5":14099,"_26939":117523,"_2865":117961},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3379":69958,"_29619":69782,"_20556":117963,"_5":14099,"_26939":117527,"_2865":117964},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3379":69959,"_29619":69782,"_20556":117966,"_5":14099,"_26939":117531,"_2865":117967},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3379":69960,"_29619":69782,"_20556":117969,"_5":14099,"_26939":117531,"_2865":117970},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3379":69961,"_29619":69782,"_20556":117972,"_5":14099,"_26939":117531,"_2865":117973},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3379":69962,"_29619":69782,"_20556":117975,"_5":14099,"_26939":117531,"_2865":117976},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3379":69963,"_29619":69782,"_20556":117978,"_5":14099,"_26939":117531,"_2865":117979},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3379":69964,"_29619":69782,"_20556":117981,"_5":14099,"_26939":117531,"_2865":117982},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3379":69965,"_29619":69782,"_20556":117984,"_5":14099,"_26939":117535,"_2865":117985},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. El conector intenta crear esta plantilla cuando el DMS se crea y de nuevo en cada edición completa del DMS (`PUT /v1/dms/{id}`) - no en el momento del enrolamiento del dispositivo. El intento no es idempotente: cuando ya existe una plantilla nombrada con el ID del DMS, la llamada de creación falla, el evento se reintenta tres veces y acaba en la cola de mensajes fallidos `lamassu-dlq` (ver Solución de problemas). La plantilla se crea una sola vez; las ediciones posteriores nunca actualizan su contenido. Una actualización del DMS que omite `metadata` o envía `null` conserva los metadatos almacenados, así que la clave del conector `lamassu.io/iot/{connector_id}` sigue presente y el intento se sigue disparando. Un cuerpo que suministra un objeto `metadata` sustituye por completo los metadatos almacenados: si ese objeto no lleva la clave del conector, la clave se elimina y el conector omite silenciosamente los eventos futuros del DMS. Una vez adjuntada la plantilla, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3379":69966,"_29619":69782,"_20556":117987,"_5":14099,"_26939":117535,"_2865":117988},[],"El conector crea la plantilla, nombrada con el ID del DMS, una sola vez. Cada edición posterior del DMS que conserve la clave del conector intenta crearla de nuevo y falla, porque el conector no actualiza plantillas existentes. Los cambios posteriores en `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` o en los grupos y políticas que la plantilla referencia deben aplicarse a mano en AWS IoT Core.",{"_3379":69967,"_29619":69782,"_20556":117990,"_5":14099,"_26939":117535,"_2865":117991},[],"El evento fallido se reintenta y termina en `lamassu-dlq`. Los grupos y las políticas se registran antes del fallo, pero se omiten la asignación de la plantilla a la CA registrada, la escritura del ARN en el DMS y la actualización de las shadows al cambiar `ManagedCAs`.",{"_3379":69968,"_29619":69782,"_20556":117993,"_5":14099,"_26939":117535,"_2865":117994},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3379":69969,"_29619":69782,"_20556":117996,"_5":14099,"_26939":117535,"_2865":117997},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3379":69970,"_29619":69782,"_20556":117999,"_5":14099,"_26939":117539,"_2865":118000},[],"El `registration_mode` del DMS determina qué hace el conector en el lado AWS cuando el DMS se crea o se edita por completo:",{"_3379":69971,"_29619":69782,"_20556":118002,"_5":14099,"_26939":117539,"_2865":117901},[],{"_3379":69972,"_29619":69782,"_20556":118004,"_5":14099,"_26939":117539,"_2865":117904},[],{"_3379":69973,"_29619":69782,"_20556":118006,"_5":14099,"_26939":117539,"_2865":118007},[],"`SinConfigurar` → `None` / `Auto`",{"_3379":69974,"_29619":69782,"_20556":118009,"_5":14099,"_26939":117539,"_2865":118010},[],"ninguna (solo configuración)",{"_3379":69975,"_29619":69782,"_20556":118012,"_5":14099,"_26939":117539,"_2865":52743},[],{"_3379":69976,"_29619":69782,"_20556":118014,"_5":14099,"_26939":117539,"_2865":118010},[],{"_3379":69977,"_29619":69782,"_20556":118016,"_5":14099,"_26939":117539,"_2865":118017},[],"Cualquiera → `Jitp`",{"_3379":69978,"_29619":69782,"_20556":118019,"_5":14099,"_26939":117539,"_2865":118020},[],"`iot:CreateProvisioningTemplate` (no idempotente: falla si la plantilla ya existe; tras 3 reintentos el evento acaba en `lamassu-dlq`)",{"_3379":69979,"_29619":69782,"_20556":118022,"_5":14099,"_26939":117539,"_2865":52754},[],{"_3379":69980,"_29619":69782,"_20556":118024,"_5":14099,"_26939":117539,"_2865":118025},[],"ninguna (la plantilla permanece en la cuenta AWS)",{"_3379":69981,"_29619":69782,"_20556":118027,"_5":14099,"_26939":117543,"_2865":118028},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3379":69982,"_29619":69782,"_20556":118030,"_5":14099,"_26939":117543,"_2865":118031},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3379":69983,"_29619":69782,"_20556":118033,"_5":14099,"_26939":117543,"_2865":118034},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3379":69984,"_29619":69782,"_20556":118036,"_5":14099,"_26939":117547,"_2865":118037},[],"Los Things solo existen en modo `auto`; en modo `jitp` AWS crea el Thing por sí mismo cuando el dispositivo se conecta por primera vez. El nombre del Thing es siempre el CN del certificado del dispositivo:",{"_3379":69985,"_29619":69782,"_20556":118039,"_5":14099,"_26939":117547,"_2865":117901},[],{"_3379":69986,"_29619":69782,"_20556":118041,"_5":14099,"_26939":117547,"_2865":117904},[],{"_3379":69987,"_29619":69782,"_20556":118043,"_5":14099,"_26939":117547,"_2865":118044},[],"`Ausente` → `Aprovisionado`",{"_3379":69988,"_29619":69782,"_20556":118046,"_5":14099,"_26939":117547,"_2865":118047},[],"políticas creadas/actualizadas, grupos de Things asegurados, `iot:RegisterThing` (crea el Thing, registra el certificado, adjunta políticas)",{"_3379":69989,"_29619":69782,"_20556":118049,"_5":14099,"_26939":117547,"_2865":118050},[],"`Aprovisionado` → `Aprovisionado` (re-enrolamiento)",{"_3379":69990,"_29619":69782,"_20556":118052,"_5":14099,"_26939":117547,"_2865":118053},[],"principals obsoletos marcados como `REVOKED`, nueva ejecución de `iot:RegisterThing`; el nuevo ARN del certificado sustituye al anterior en los metadatos de Lamassu",{"_3379":69991,"_29619":69782,"_20556":118055,"_5":14099,"_26939":117547,"_2865":118056},[],"En modo `jitp` el conector no hace llamadas de aprovisionamiento: AWS ejecuta la plantilla JITP en la primera conexión del dispositivo y crea el Thing, registra el certificado y lo activa por su cuenta.",{"_3379":69992,"_29619":69782,"_20556":118058,"_5":14099,"_26939":117551,"_2865":118059},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3379":69993,"_29619":69782,"_20556":118061,"_5":14099,"_26939":117551,"_2865":118062},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3379":69994,"_29619":69782,"_20556":118064,"_5":14099,"_26939":117551,"_2865":118065},[],"Para que el flujo JITP funcione correctamente:",{"_3379":69995,"_29619":69782,"_20556":118067,"_5":14099,"_26939":117551,"_2865":118068},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3379":69996,"_29619":69782,"_20556":118070,"_5":14099,"_26939":117551,"_2865":118071},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3379":69997,"_29619":69782,"_20556":118073,"_5":14099,"_26939":117551,"_2865":118074},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3379":69998,"_29619":69782,"_20556":118076,"_5":14099,"_26939":117551,"_2865":118077},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3379":69999,"_29619":69782,"_20556":118079,"_5":14099,"_26939":117555,"_2865":118080},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3379":70000,"_29619":69782,"_20556":118082,"_5":14099,"_26939":117555,"_2865":118083},[],"Estado en Lamassu",{"_3379":70001,"_29619":69782,"_20556":118085,"_5":14099,"_26939":117555,"_2865":118086},[],"Razón de revocación",{"_3379":70002,"_29619":69782,"_20556":118088,"_5":14099,"_26939":117555,"_2865":118089},[],"Estado en AWS IoT Core",{"_3379":70003,"_29619":69782,"_20556":118091,"_5":14099,"_26939":117555,"_2865":52824},[],{"_3379":70004,"_29619":69782,"_20556":118093,"_5":14099,"_26939":117555,"_2865":118094},[],"Ninguna",{"_3379":70005,"_29619":69782,"_20556":118096,"_5":14099,"_26939":117555,"_2865":52830},[],{"_3379":70006,"_29619":69782,"_20556":118098,"_5":14099,"_26939":117555,"_2865":52833},[],{"_3379":70007,"_29619":69782,"_20556":118100,"_5":14099,"_26939":117555,"_2865":52836},[],{"_3379":70008,"_29619":69782,"_20556":118102,"_5":14099,"_26939":117555,"_2865":52839},[],{"_3379":70009,"_29619":69782,"_20556":118104,"_5":14099,"_26939":117555,"_2865":52833},[],{"_3379":70010,"_29619":69782,"_20556":118106,"_5":14099,"_26939":117555,"_2865":118107},[],"Cualquier otra razón",{"_3379":70011,"_29619":69782,"_20556":118109,"_5":14099,"_26939":117555,"_2865":52847},[],{"_3379":70012,"_29619":69782,"_20556":118111,"_5":14099,"_26939":117555,"_2865":118112},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3379":70013,"_29619":69782,"_20556":118114,"_5":14099,"_26939":117559,"_2865":118115},[],"Los certificados con la clave de metadatos del conector sincronizan su estado; los aprovisionados vía JITP no tienen clave de metadatos y quedan fuera de esta máquina:",{"_3379":70014,"_29619":69782,"_20556":118117,"_5":14099,"_26939":117559,"_2865":117901},[],{"_3379":70015,"_29619":69782,"_20556":118119,"_5":14099,"_26939":117559,"_2865":117904},[],{"_3379":70016,"_29619":69782,"_20556":118121,"_5":14099,"_26939":117559,"_2865":118122},[],"`NoSincronizado` → `Active`",{"_3379":70017,"_29619":69782,"_20556":118124,"_5":14099,"_26939":117559,"_2865":52339},[],{"_3379":70018,"_29619":69782,"_20556":118126,"_5":14099,"_26939":117559,"_2865":52865},[],{"_3379":70019,"_29619":69782,"_20556":118128,"_5":14099,"_26939":117559,"_2865":118129},[],"`iot:UpdateCertificate` + desconexión MQTT forzada",{"_3379":70020,"_29619":69782,"_20556":118131,"_5":14099,"_26939":117559,"_2865":52871},[],{"_3379":70021,"_29619":69782,"_20556":118133,"_5":14099,"_26939":117559,"_2865":118129},[],{"_3379":70022,"_29619":69782,"_20556":118135,"_5":14099,"_26939":117559,"_2865":52876},[],{"_3379":70023,"_29619":69782,"_20556":118137,"_5":14099,"_26939":117559,"_2865":52339},[],{"_3379":70024,"_29619":69782,"_20556":118139,"_5":14099,"_26939":117559,"_2865":52881},[],{"_3379":70025,"_29619":69782,"_20556":118141,"_5":14099,"_26939":117559,"_2865":118142},[],"ninguna (estos estados no se sincronizan con AWS)",{"_3379":70026,"_29619":69782,"_20556":118144,"_5":14099,"_26939":117563,"_2865":118145},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3379":70027,"_29619":69782,"_20556":118147,"_5":14099,"_26939":117563,"_2865":118148},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3379":70028,"_29619":69782,"_20556":118150,"_5":14099,"_26939":117563,"_2865":118151},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3379":70029,"_29619":69782,"_20556":118153,"_5":14099,"_26939":117567,"_2865":118154},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3379":70030,"_29619":69782,"_20556":118156,"_5":14099,"_26939":117567,"_2865":118157},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3379":70031,"_29619":69782,"_20556":118159,"_5":14099,"_26939":117571,"_2865":118160},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3379":70032,"_29619":69782,"_20556":118162,"_5":14099,"_26939":117571,"_2865":118163},[],"Existen dos tipos de acciones:",{"_3379":70033,"_29619":69782,"_20556":118165,"_5":14099,"_26939":117571,"_2865":118166},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3379":70034,"_29619":69782,"_20556":118168,"_5":14099,"_26939":117571,"_2865":118169},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3379":70035,"_29619":69782,"_20556":118171,"_5":14099,"_26939":117571,"_2865":118172},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3379":70036,"_29619":69782,"_20556":118174,"_5":14099,"_26939":117575,"_2865":118175},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3379":70037,"_29619":69782,"_20556":118177,"_5":14099,"_26939":117575,"_2865":118178},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3379":70038,"_29619":69782,"_20556":118180,"_5":14099,"_26939":117575,"_2865":118181},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3379":70039,"_29619":69782,"_20556":118183,"_5":14099,"_26939":117579,"_2865":118184},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3379":70040,"_29619":69782,"_20556":118186,"_5":14099,"_26939":117579,"_2865":118187},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3379":70041,"_29619":69782,"_20556":118189,"_5":14099,"_26939":117579,"_2865":118190},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3379":70042,"_29619":69782,"_20556":118192,"_5":14099,"_26939":117579,"_2865":118193},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3379":70043,"_29619":69782,"_20556":118195,"_5":14099,"_26939":117579,"_2865":118196},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3379":70044,"_29619":69782,"_20556":118198,"_5":14099,"_26939":117579,"_2865":118199},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3379":70045,"_29619":69782,"_20556":118201,"_5":14099,"_26939":117579,"_2865":118202},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3379":70046,"_29619":69782,"_20556":118204,"_5":14099,"_26939":117579,"_2865":118205},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3379":70047,"_29619":69782,"_20556":118207,"_5":14099,"_26939":117579,"_2865":118208},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3379":70048,"_29619":69782,"_20556":118210,"_5":14099,"_26939":117579,"_2865":118211},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3379":70049,"_29619":69782,"_20556":118213,"_5":14099,"_26939":117579,"_2865":118214},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3379":70050,"_29619":69782,"_20556":118216,"_5":14099,"_26939":117579,"_2865":118217},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3379":70051,"_29619":69782,"_20556":118219,"_5":14099,"_26939":117579,"_2865":118220},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3379":70052,"_29619":69782,"_20556":118222,"_5":14099,"_26939":117579,"_2865":118223},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3379":70053,"_29619":69782,"_20556":118225,"_5":14099,"_26939":117579,"_2865":118226},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3379":70054,"_29619":69782,"_20556":118228,"_5":14099,"_26939":117579,"_2865":118229},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3379":70055,"_29619":69782,"_20556":118231,"_5":14099,"_26939":117579,"_2865":118232},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3379":70056,"_29619":69782,"_20556":118234,"_5":14099,"_26939":117579,"_2865":118235},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3379":70057,"_29619":69782,"_20556":118237,"_5":14099,"_26939":117579,"_2865":118238},[],"**Síntoma:** Tras editar un DMS en modo `jitp`, aparecen mensajes de actualización del DMS en `lamassu-dlq`, o los cambios de configuración JITP no tienen efecto en AWS.",{"_3379":70058,"_29619":69782,"_20556":118240,"_5":14099,"_26939":117579,"_2865":118241},[],"**Causa:** Cada edición completa del DMS (`PUT /v1/dms/{id}`) dispara un nuevo intento de `CreateProvisioningTemplate` para la plantilla nombrada con el ID del DMS, y la llamada no es idempotente: cuando la plantilla ya existe, falla, el evento se reintenta tres veces y acaba en `lamassu-dlq`. Se omiten los pasos posteriores del conector.",{"_3379":70059,"_29619":69782,"_20556":118243,"_5":14099,"_26939":117579,"_2865":118244},[],"**Resolución:** Comprobar que la plantilla nombrada con el ID del DMS existe en AWS IoT Core y que el enrolamiento JITP funciona. Si se cambió la configuración JITP, aplicarla a mano en la plantilla de AWS.",{"_3379":70060,"_29619":69782,"_20556":118246,"_5":14099,"_26939":117579,"_2865":118247},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3379":70061,"_29619":69782,"_20556":118249,"_5":14099,"_26939":117579,"_2865":118250},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3379":70062,"_29619":69782,"_20556":118252,"_5":14099,"_26939":117579,"_2865":118253},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3379":70063,"_29619":70063,"_5":14457,"_2865":50702,"_29972":118255,"_20556":118256,"_26939":70063},[48223,115062,50702],[],{"_3379":70064,"_29619":70063,"_20556":118258,"_5":14099,"_26939":70063,"_2865":118259},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3379":70065,"_29619":70063,"_5":29969,"_20556":118261,"_26939":118262,"_2865":118263},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3379":70066,"_29619":70063,"_5":29969,"_20556":118265,"_26939":118266,"_2865":116071},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3379":70067,"_29619":70063,"_5":29969,"_20556":118268,"_26939":118269,"_2865":116246},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3379":70068,"_29619":70063,"_5":29969,"_20556":118271,"_26939":118272,"_2865":117478},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/overview#integraciones",{"_3379":70069,"_29619":70063,"_5":29969,"_20556":118274,"_26939":118275,"_2865":118276},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3379":70070,"_29619":70063,"_20556":118278,"_5":14099,"_26939":70063,"_2865":118279},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3379":70071,"_29619":70063,"_20556":118281,"_5":14099,"_26939":118262,"_2865":118282},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3379":70072,"_29619":70063,"_20556":118284,"_5":14099,"_26939":118262,"_2865":118285},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3379":70073,"_29619":70063,"_20556":118287,"_5":14099,"_26939":118266,"_2865":118288},[],"Recurso",{"_3379":70074,"_29619":70063,"_20556":118290,"_5":14099,"_26939":118266,"_2865":118291},[],"Qué representa",{"_3379":70075,"_29619":70063,"_20556":118293,"_5":14099,"_26939":118266,"_2865":118294},[],"**Dispositivo**",{"_3379":70076,"_29619":70063,"_20556":118296,"_5":14099,"_26939":118266,"_2865":118297},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3379":70077,"_29619":70063,"_20556":118299,"_5":14099,"_26939":118266,"_2865":118300},[],"**Identidad**",{"_3379":70078,"_29619":70063,"_20556":118302,"_5":14099,"_26939":118266,"_2865":118303},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3379":70079,"_29619":70063,"_20556":118305,"_5":14099,"_26939":118266,"_2865":53048},[],{"_3379":70080,"_29619":70063,"_20556":118307,"_5":14099,"_26939":118266,"_2865":118308},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3379":70081,"_29619":70063,"_20556":118310,"_5":14099,"_26939":118266,"_2865":118311},[],"**Flota**",{"_3379":70082,"_29619":70063,"_20556":118313,"_5":14099,"_26939":118266,"_2865":118314},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3379":70083,"_29619":70063,"_20556":118316,"_5":14099,"_26939":118266,"_2865":118317},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3379":70084,"_29619":70063,"_20556":118319,"_5":14099,"_26939":118266,"_2865":118320},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3379":70085,"_29619":70063,"_20556":118322,"_5":14099,"_26939":118269,"_2865":118323},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3379":70086,"_29619":70063,"_20556":118325,"_5":14099,"_26939":118269,"_2865":118326},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3379":70087,"_29619":70063,"_20556":118328,"_5":14099,"_26939":118269,"_2865":118329},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3379":70088,"_29619":70063,"_20556":118331,"_5":14099,"_26939":118269,"_2865":118332},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3379":70089,"_29619":70063,"_20556":118334,"_5":14099,"_26939":118269,"_2865":118335},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3379":70090,"_29619":70063,"_20556":118337,"_5":14099,"_26939":118269,"_2865":118338},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3379":70091,"_29619":70063,"_20556":118340,"_5":14099,"_26939":118269,"_2865":118341},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3379":70092,"_29619":70063,"_20556":118343,"_5":14099,"_26939":118269,"_2865":118344},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3379":70093,"_29619":70063,"_20556":118346,"_5":14099,"_26939":118272,"_2865":118347},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3379":70094,"_29619":70063,"_20556":118349,"_5":14099,"_26939":118272,"_2865":118350},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3379":70095,"_29619":70063,"_20556":118352,"_5":14099,"_26939":118275,"_2865":118353},[],"Participante",{"_3379":70096,"_29619":70063,"_20556":118355,"_5":14099,"_26939":118275,"_2865":118356},[],"Responsabilidad",{"_3379":70097,"_29619":70063,"_20556":118358,"_5":14099,"_26939":118275,"_2865":118359},[],"Administrador PKI",{"_3379":70098,"_29619":70063,"_20556":118361,"_5":14099,"_26939":118275,"_2865":118362},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3379":70099,"_29619":70063,"_20556":118364,"_5":14099,"_26939":118275,"_2865":118365},[],"Administrador del aprovisionamiento",{"_3379":70100,"_29619":70063,"_20556":118367,"_5":14099,"_26939":118275,"_2865":118368},[],"DMS, admisión, autenticación por operación e inventario.",{"_3379":70101,"_29619":70063,"_20556":118370,"_5":14099,"_26939":118275,"_2865":118371},[],"Integrador del dispositivo",{"_3379":70102,"_29619":70063,"_20556":118373,"_5":14099,"_26939":118275,"_2865":118374},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3379":70103,"_29619":70063,"_20556":118376,"_5":14099,"_26939":118275,"_2865":118377},[],"Integrador del consumidor",{"_3379":70104,"_29619":70063,"_20556":118379,"_5":14099,"_26939":118275,"_2865":118380},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3379":70105,"_29619":70063,"_20556":118382,"_5":14099,"_26939":118275,"_2865":118383},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3379":70106,"_29619":70106,"_5":14457,"_2865":118385,"_29972":118386,"_20556":118388,"_26939":70106},"Enrola y conecta tu primer dispositivo",[48223,115062,50702,118387],"Primeros pasos",[],{"_3379":70107,"_29619":70106,"_20556":118390,"_5":14099,"_26939":70106,"_2865":118391},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3379":70108,"_29619":70106,"_5":29969,"_20556":118393,"_26939":118394,"_2865":113640},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3379":70109,"_29619":70106,"_5":29969,"_20556":118396,"_26939":118397,"_2865":118398},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3379":70110,"_29619":70106,"_5":29969,"_20556":118400,"_26939":118401,"_2865":118402},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3379":70111,"_29619":70106,"_5":29969,"_20556":118404,"_26939":118405,"_2865":118406},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3379":70112,"_29619":70106,"_5":29969,"_20556":118408,"_26939":118409,"_2865":118410},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3379":70113,"_29619":70106,"_5":29969,"_20556":118412,"_26939":118413,"_2865":118414},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3379":70114,"_29619":70106,"_5":29969,"_20556":118416,"_26939":118417,"_2865":118418},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3379":70115,"_29619":70106,"_5":29969,"_20556":118420,"_26939":118421,"_2865":118422},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3379":70116,"_29619":70106,"_20556":118424,"_5":14099,"_26939":70106,"_2865":118425},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3379":70117,"_29619":70106,"_20556":118427,"_5":14099,"_26939":118394,"_2865":118428},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3379":70118,"_29619":70106,"_20556":118430,"_5":14099,"_26939":118394,"_2865":118431},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3379":70119,"_29619":70106,"_20556":118433,"_5":14099,"_26939":118394,"_2865":118434},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3379":70120,"_29619":70106,"_20556":118436,"_5":14099,"_26939":118394,"_2865":118437},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3379":70121,"_29619":70106,"_20556":118439,"_5":14099,"_26939":118394,"_2865":118440},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3379":70122,"_29619":70106,"_20556":118442,"_5":14099,"_26939":118397,"_2865":118443},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3379":70123,"_29619":70106,"_20556":118445,"_5":14099,"_26939":118397,"_2865":118446},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3379":70124,"_29619":70106,"_20556":118448,"_5":14099,"_26939":118401,"_2865":118449},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3379":70125,"_29619":70106,"_20556":118451,"_5":14099,"_26939":118401,"_2865":118452},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3379":70126,"_29619":70106,"_20556":118454,"_5":14099,"_26939":118401,"_2865":118455},[],"Ajuste",{"_3379":70127,"_29619":70106,"_20556":118457,"_5":14099,"_26939":118401,"_2865":118458},[],"Valor de evaluación",{"_3379":70128,"_29619":70106,"_20556":118460,"_5":14099,"_26939":118401,"_2865":53204},[],{"_3379":70129,"_29619":70106,"_20556":118462,"_5":14099,"_26939":118401,"_2865":118463},[],"Raíz emisora de `device-root.pem`.",{"_3379":70130,"_29619":70106,"_20556":118465,"_5":14099,"_26939":118401,"_2865":116374},[],{"_3379":70131,"_29619":70106,"_20556":118467,"_5":14099,"_26939":118401,"_2865":118468},[],"Perfil final de 1 hora que acabas de preparar.",{"_3379":70132,"_29619":70106,"_20556":118470,"_5":14099,"_26939":118401,"_2865":53215},[],{"_3379":70133,"_29619":70106,"_20556":118472,"_5":14099,"_26939":118401,"_2865":53218},[],{"_3379":70134,"_29619":70106,"_20556":118474,"_5":14099,"_26939":118401,"_2865":53221},[],{"_3379":70135,"_29619":70106,"_20556":118476,"_5":14099,"_26939":118401,"_2865":118477},[],"Habilitado.",{"_3379":70136,"_29619":70106,"_20556":118479,"_5":14099,"_26939":118401,"_2865":53227},[],{"_3379":70137,"_29619":70106,"_20556":118481,"_5":14099,"_26939":118401,"_2865":118482},[],"Deshabilitado; el ID debe ser nuevo.",{"_3379":70138,"_29619":70106,"_20556":118484,"_5":14099,"_26939":118401,"_2865":118485},[],"Autenticación inicial",{"_3379":70139,"_29619":70106,"_20556":118487,"_5":14099,"_26939":118401,"_2865":118488},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3379":70140,"_29619":70106,"_20556":118490,"_5":14099,"_26939":118401,"_2865":118491},[],"Autenticación de renovación",{"_3379":70141,"_29619":70106,"_20556":118493,"_5":14099,"_26939":118401,"_2865":118494},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3379":70142,"_29619":70106,"_20556":118496,"_5":14099,"_26939":118401,"_2865":53245},[],{"_3379":70143,"_29619":70106,"_20556":118498,"_5":14099,"_26939":118401,"_2865":118499},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_3379":70144,"_29619":70106,"_20556":118501,"_5":14099,"_26939":118401,"_2865":53251},[],{"_3379":70145,"_29619":70106,"_20556":118503,"_5":14099,"_26939":118401,"_2865":118504},[],"1 hora.",{"_3379":70146,"_29619":70106,"_20556":118506,"_5":14099,"_26939":118401,"_2865":53257},[],{"_3379":70147,"_29619":70106,"_20556":118508,"_5":14099,"_26939":118401,"_2865":118509},[],"30 minutos / 10 minutos.",{"_3379":70148,"_29619":70106,"_20556":118511,"_5":14099,"_26939":118401,"_2865":53263},[],{"_3379":70149,"_29619":70106,"_20556":118513,"_5":14099,"_26939":118401,"_2865":118514},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3379":70150,"_29619":70106,"_20556":118516,"_5":14099,"_26939":118401,"_2865":51021},[],{"_3379":70151,"_29619":70106,"_20556":118518,"_5":14099,"_26939":118401,"_2865":118519},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3379":70152,"_29619":70106,"_20556":118521,"_5":14099,"_26939":118401,"_2865":53274},[],{"_3379":70153,"_29619":70106,"_20556":118523,"_5":14099,"_26939":118401,"_2865":118524},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3379":70154,"_29619":70106,"_20556":118526,"_5":14099,"_26939":118401,"_2865":118527},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento; la guía DMS describe sus campos, y también puedes comprobar el recurso mediante la API DMS.",{"_3379":70155,"_29619":70106,"_20556":118529,"_5":14099,"_26939":118405,"_2865":118530},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3379":70156,"_29619":70106,"_20556":118532,"_5":14099,"_26939":118405,"_2865":118533},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3379":70157,"_29619":70106,"_20556":118535,"_5":14099,"_26939":118409,"_2865":118536},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3379":70158,"_29619":70106,"_20556":118538,"_5":14099,"_26939":118409,"_2865":118539},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3379":70159,"_29619":70106,"_20556":118541,"_5":14099,"_26939":118409,"_2865":118542},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3379":70160,"_29619":70106,"_20556":118544,"_5":14099,"_26939":118413,"_2865":118545},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3379":70161,"_29619":70106,"_20556":118547,"_5":14099,"_26939":118413,"_2865":118548},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3379":70162,"_29619":70106,"_20556":118550,"_5":14099,"_26939":118417,"_2865":118551},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3379":70163,"_29619":70106,"_20556":118553,"_5":14099,"_26939":118417,"_2865":118554},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3379":70164,"_29619":70106,"_20556":118556,"_5":14099,"_26939":118417,"_2865":118557},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3379":70165,"_29619":70106,"_20556":118559,"_5":14099,"_26939":118417,"_2865":118560},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3379":70166,"_29619":70106,"_20556":118562,"_5":14099,"_26939":118417,"_2865":118563},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3379":70167,"_29619":70106,"_20556":118565,"_5":14099,"_26939":118421,"_2865":118566},[],"Comprobación",{"_3379":70168,"_29619":70106,"_20556":118568,"_5":14099,"_26939":118421,"_2865":118569},[],"Resultado esperado",{"_3379":70169,"_29619":70106,"_20556":118571,"_5":14099,"_26939":118421,"_2865":118572},[],"Registro",{"_3379":70170,"_29619":70106,"_20556":118574,"_5":14099,"_26939":118421,"_2865":118575},[],"ID creado automáticamente y DMS correcto.",{"_3379":70171,"_29619":70106,"_20556":118577,"_5":14099,"_26939":118421,"_2865":117862},[],{"_3379":70172,"_29619":70106,"_20556":118579,"_5":14099,"_26939":118421,"_2865":118580},[],"CN, perfil, serie y clave verificados.",{"_3379":70173,"_29619":70106,"_20556":118582,"_5":14099,"_26939":118421,"_2865":118583},[],"Inventario",{"_3379":70174,"_29619":70106,"_20556":118585,"_5":14099,"_26939":118421,"_2865":118586},[],"Serie recibida visible como identidad actual y en el historial.",{"_3379":70175,"_29619":70106,"_20556":118588,"_5":14099,"_26939":118421,"_2865":118589},[],"Consumidor",{"_3379":70176,"_29619":70106,"_20556":118591,"_5":14099,"_26939":118421,"_2865":118592},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3379":70177,"_29619":70106,"_20556":118594,"_5":14099,"_26939":118421,"_2865":118595},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3379":70178,"_29619":70106,"_20556":118597,"_5":14099,"_26939":118421,"_2865":118598},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3379":70179,"_29619":70179,"_5":14457,"_2865":116088,"_29972":118600,"_20556":118601,"_26939":70179},[48223,115062,50702,118387],[],{"_3379":70180,"_29619":70179,"_20556":118603,"_5":14099,"_26939":70179,"_2865":118604},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3379":70181,"_29619":70179,"_5":29969,"_20556":118606,"_26939":118607,"_2865":113640},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3379":70182,"_29619":70179,"_5":29969,"_20556":118609,"_26939":118610,"_2865":118611},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3379":70183,"_29619":70179,"_5":29969,"_20556":118613,"_26939":118614,"_2865":118615},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3379":70184,"_29619":70179,"_5":29969,"_20556":118617,"_26939":118618,"_2865":118619},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3379":70185,"_29619":70179,"_5":29969,"_20556":118621,"_26939":118622,"_2865":118623},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3379":70186,"_29619":70179,"_5":29969,"_20556":118625,"_26939":118626,"_2865":118627},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3379":70187,"_29619":70179,"_5":29969,"_20556":118629,"_26939":118630,"_2865":118569},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3379":70188,"_29619":70179,"_5":29969,"_20556":118632,"_26939":118633,"_2865":118634},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3379":70189,"_29619":70179,"_5":29969,"_20556":118636,"_26939":118637,"_2865":118638},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3379":70190,"_29619":70179,"_20556":118640,"_5":14099,"_26939":70179,"_2865":118641},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3379":70191,"_29619":70179,"_20556":118643,"_5":14099,"_26939":70179,"_2865":118644},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3379":70192,"_29619":70179,"_20556":118646,"_5":14099,"_26939":118607,"_2865":118647},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3379":70193,"_29619":70179,"_20556":118649,"_5":14099,"_26939":118607,"_2865":118650},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3379":70194,"_29619":70179,"_20556":118652,"_5":14099,"_26939":118607,"_2865":118653},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3379":70195,"_29619":70179,"_20556":118655,"_5":14099,"_26939":118607,"_2865":118656},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3379":70196,"_29619":70179,"_20556":118658,"_5":14099,"_26939":118610,"_2865":118659},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3379":70197,"_29619":70179,"_20556":118661,"_5":14099,"_26939":118610,"_2865":118662},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3379":70198,"_29619":70179,"_20556":118664,"_5":14099,"_26939":118610,"_2865":118665},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3379":70199,"_29619":70179,"_20556":118667,"_5":14099,"_26939":118610,"_2865":118668},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3379":70200,"_29619":70179,"_20556":118670,"_5":14099,"_26939":118610,"_2865":118671},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_3379":70201,"_29619":70179,"_20556":118673,"_5":14099,"_26939":118610,"_2865":118674},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3379":70202,"_29619":70179,"_20556":118676,"_5":14099,"_26939":118610,"_2865":118677},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3379":70203,"_29619":70179,"_20556":118679,"_5":14099,"_26939":118610,"_2865":118680},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3379":70204,"_29619":70179,"_20556":118682,"_5":14099,"_26939":118614,"_2865":118683},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3379":70205,"_29619":70179,"_20556":118685,"_5":14099,"_26939":118614,"_2865":53439},[],{"_3379":70206,"_29619":70179,"_20556":118687,"_5":14099,"_26939":118614,"_2865":118688},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3379":70207,"_29619":70179,"_20556":118690,"_5":14099,"_26939":118614,"_2865":118691},[],"**Icon** y **Tags**: clasificación opcional.",{"_3379":70208,"_29619":70179,"_20556":118693,"_5":14099,"_26939":118614,"_2865":118694},[],"Confirma el registro.",{"_3379":70209,"_29619":70179,"_20556":118696,"_5":14099,"_26939":118618,"_2865":118697},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3379":70210,"_29619":70179,"_20556":118699,"_5":14099,"_26939":118618,"_2865":118700},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3379":70211,"_29619":70179,"_20556":118702,"_5":14099,"_26939":118622,"_2865":118703},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3379":70212,"_29619":70179,"_20556":118705,"_5":14099,"_26939":118622,"_2865":118706},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3379":70213,"_29619":70179,"_20556":118708,"_5":14099,"_26939":118626,"_2865":118709},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3379":70214,"_29619":70179,"_20556":118711,"_5":14099,"_26939":118626,"_2865":118712},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3379":70215,"_29619":70179,"_20556":118714,"_5":14099,"_26939":118630,"_2865":118566},[],{"_3379":70216,"_29619":70179,"_20556":118716,"_5":14099,"_26939":118630,"_2865":118717},[],"Resultado",{"_3379":70217,"_29619":70179,"_20556":118719,"_5":14099,"_26939":118630,"_2865":117848},[],{"_3379":70218,"_29619":70179,"_20556":118721,"_5":14099,"_26939":118630,"_2865":118722},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3379":70219,"_29619":70179,"_20556":118724,"_5":14099,"_26939":118630,"_2865":118725},[],"Identidad actual",{"_3379":70220,"_29619":70179,"_20556":118727,"_5":14099,"_26939":118630,"_2865":118728},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3379":70221,"_29619":70179,"_20556":118730,"_5":14099,"_26939":118630,"_2865":118731},[],"Historial",{"_3379":70222,"_29619":70179,"_20556":118733,"_5":14099,"_26939":118630,"_2865":118734},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3379":70223,"_29619":70179,"_20556":118736,"_5":14099,"_26939":118630,"_2865":118737},[],"Clave y certificado",{"_3379":70224,"_29619":70179,"_20556":118739,"_5":14099,"_26939":118630,"_2865":118740},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3379":70225,"_29619":70179,"_20556":118742,"_5":14099,"_26939":118633,"_2865":118743},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3379":70226,"_29619":70179,"_20556":118745,"_5":14099,"_26939":118633,"_2865":118746},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3379":70227,"_29619":70179,"_20556":118748,"_5":14099,"_26939":118633,"_2865":118749},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3379":70228,"_29619":70179,"_20556":118751,"_5":14099,"_26939":118633,"_2865":118752},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3379":70229,"_29619":70179,"_20556":118754,"_5":14099,"_26939":118637,"_2865":118755},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3379":70230,"_29619":70179,"_20556":118757,"_5":14099,"_26939":118637,"_2865":118758},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3379":70231,"_29619":70179,"_20556":118760,"_5":14099,"_26939":118637,"_2865":118761},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3379":70232,"_29619":70232,"_5":14457,"_2865":118763,"_29972":118764,"_20556":118765,"_26939":70232},"Plataforma Lamassu IoT",[48223,115062],[],{"_3379":70233,"_29619":70232,"_20556":118767,"_5":14099,"_26939":70232,"_2865":118768},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3379":70234,"_29619":70232,"_5":29969,"_20556":118770,"_26939":118771,"_2865":118263},[],"/docs/pr-preview/pr-53/es/platform/overview#empieza-aquí",{"_3379":70235,"_29619":70232,"_5":29969,"_20556":118773,"_26939":118774,"_2865":118775},[],"/docs/pr-preview/pr-53/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3379":70236,"_29619":70232,"_5":29969,"_20556":118777,"_26939":118778,"_2865":118779},[],"/docs/pr-preview/pr-53/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3379":70237,"_29619":70232,"_5":29969,"_20556":118781,"_26939":118782,"_2865":118783},[],"/docs/pr-preview/pr-53/es/platform/overview#capacidades-principales","Capacidades principales",{"_3379":70238,"_29619":70232,"_5":29969,"_20556":118785,"_26939":118786,"_2865":118787},[],"/docs/pr-preview/pr-53/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3379":70239,"_29619":70232,"_5":29969,"_20556":118789,"_26939":118790,"_2865":118791},[],"/docs/pr-preview/pr-53/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3379":70240,"_29619":70232,"_5":29969,"_20556":118793,"_26939":118794,"_2865":118795},[],"/docs/pr-preview/pr-53/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3379":70241,"_29619":70232,"_5":29969,"_20556":118797,"_26939":118798,"_2865":118799},[],"/docs/pr-preview/pr-53/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3379":70242,"_29619":70232,"_5":29969,"_20556":118801,"_26939":118802,"_2865":118803},[],"/docs/pr-preview/pr-53/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3379":70243,"_29619":70232,"_5":29969,"_20556":118805,"_26939":118806,"_2865":118807},[],"/docs/pr-preview/pr-53/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3379":70244,"_29619":70232,"_5":29969,"_20556":118809,"_26939":118810,"_2865":118811},[],"/docs/pr-preview/pr-53/es/platform/overview#referencia-operativa","Referencia operativa",{"_3379":70245,"_29619":70232,"_20556":118813,"_5":14099,"_26939":70232,"_2865":118814},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3379":70246,"_29619":70232,"_20556":118816,"_5":14099,"_26939":118771,"_2865":118817},[],"Elige el resultado que necesitas obtener:",{"_3379":70247,"_29619":70232,"_20556":118819,"_5":14099,"_26939":118771,"_2865":118820},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3379":70248,"_29619":70232,"_20556":118822,"_5":14099,"_26939":118771,"_2865":118823},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3379":70249,"_29619":70232,"_20556":118825,"_5":14099,"_26939":118771,"_2865":118826},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3379":70250,"_29619":70232,"_20556":118828,"_5":14099,"_26939":118774,"_2865":118829},[],"Bloque",{"_3379":70251,"_29619":70232,"_20556":118831,"_5":14099,"_26939":118774,"_2865":118832},[],"Qué gestionas",{"_3379":70252,"_29619":70232,"_20556":118834,"_5":14099,"_26939":118774,"_2865":118835},[],"Punto de entrada",{"_3379":70253,"_29619":70232,"_20556":118837,"_5":14099,"_26939":118774,"_2865":53592},[],{"_3379":70254,"_29619":70232,"_20556":118839,"_5":14099,"_26939":118774,"_2865":118840},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3379":70255,"_29619":70232,"_20556":118842,"_5":14099,"_26939":118774,"_2865":118843},[],"Visión general de PKI",{"_3379":70256,"_29619":70232,"_20556":118845,"_5":14099,"_26939":118774,"_2865":53601},[],{"_3379":70257,"_29619":70232,"_20556":118847,"_5":14099,"_26939":118774,"_2865":118848},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3379":70258,"_29619":70232,"_20556":118850,"_5":14099,"_26939":118774,"_2865":118851},[],"Visión general de IoT Fleets",{"_3379":70259,"_29619":70232,"_20556":118853,"_5":14099,"_26939":118774,"_2865":118854},[],"**Administración**",{"_3379":70260,"_29619":70232,"_20556":118856,"_5":14099,"_26939":118774,"_2865":118857},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3379":70261,"_29619":70232,"_20556":118859,"_5":14099,"_26939":118774,"_2865":115060},[],{"_3379":70262,"_29619":70232,"_20556":118861,"_5":14099,"_26939":118774,"_2865":118862},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3379":70263,"_29619":70232,"_20556":118864,"_5":14099,"_26939":118778,"_2865":118865},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3379":70264,"_29619":70232,"_20556":118867,"_5":14099,"_26939":118778,"_2865":118868},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3379":70265,"_29619":70232,"_20556":118870,"_5":14099,"_26939":118778,"_2865":118871},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3379":70266,"_29619":70232,"_20556":118873,"_5":14099,"_26939":118778,"_2865":118874},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3379":70267,"_29619":70232,"_20556":118876,"_5":14099,"_26939":118778,"_2865":118877},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3379":70268,"_29619":70232,"_20556":118879,"_5":14099,"_26939":118778,"_2865":118880},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3379":70269,"_29619":70232,"_20556":118882,"_5":14099,"_26939":118786,"_2865":118883},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3379":70270,"_29619":70232,"_20556":118885,"_5":14099,"_26939":118790,"_2865":118886},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3379":70271,"_29619":70232,"_20556":118888,"_5":14099,"_26939":118794,"_2865":118889},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3379":70272,"_29619":70232,"_20556":118891,"_5":14099,"_26939":118798,"_2865":118892},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3379":70273,"_29619":70232,"_20556":118894,"_5":14099,"_26939":118802,"_2865":118895},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3379":70274,"_29619":70232,"_20556":118897,"_5":14099,"_26939":118806,"_2865":118898},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3379":70275,"_29619":70232,"_20556":118900,"_5":14099,"_26939":118810,"_2865":118356},[],{"_3379":70276,"_29619":70232,"_20556":118902,"_5":14099,"_26939":118810,"_2865":118903},[],"Qué prepara o comprueba",{"_3379":70277,"_29619":70232,"_20556":118905,"_5":14099,"_26939":118810,"_2865":118359},[],{"_3379":70278,"_29619":70232,"_20556":118907,"_5":14099,"_26939":118810,"_2865":118908},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3379":70279,"_29619":70232,"_20556":118910,"_5":14099,"_26939":118810,"_2865":118911},[],"Administrador de la flota",{"_3379":70280,"_29619":70232,"_20556":118913,"_5":14099,"_26939":118810,"_2865":118914},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3379":70281,"_29619":70232,"_20556":118916,"_5":14099,"_26939":118810,"_2865":118371},[],{"_3379":70282,"_29619":70232,"_20556":118918,"_5":14099,"_26939":118810,"_2865":118919},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3379":70283,"_29619":70232,"_20556":118921,"_5":14099,"_26939":118810,"_2865":118377},[],{"_3379":70284,"_29619":70232,"_20556":118923,"_5":14099,"_26939":118810,"_2865":118924},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3379":70285,"_29619":70232,"_20556":118926,"_5":14099,"_26939":118810,"_2865":118927},[],"Operador de infraestructura",{"_3379":70286,"_29619":70232,"_20556":118929,"_5":14099,"_26939":118810,"_2865":118930},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3379":70287,"_29619":70232,"_20556":118932,"_5":14099,"_26939":118810,"_2865":118933},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3379":70288,"_29619":70288,"_5":14457,"_2865":118935,"_29972":118936,"_20556":118938,"_26939":70288},"Jerarquía y rotación de CAs",[48223,115062,53693,118937],"Claves, autoridades y certificados",[],{"_3379":70289,"_29619":70288,"_20556":118940,"_5":14099,"_26939":70288,"_2865":118941},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3379":70290,"_29619":70288,"_5":29969,"_20556":118943,"_26939":118944,"_2865":118945},[],"/docs/pr-preview/pr-53/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3379":70291,"_29619":70288,"_5":29969,"_20556":118947,"_26939":118948,"_2865":118949},[],"/docs/pr-preview/pr-53/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3379":70292,"_29619":70288,"_5":29969,"_20556":118951,"_26939":118952,"_2865":118953},[],"/docs/pr-preview/pr-53/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3379":70293,"_29619":70288,"_5":29969,"_20556":118955,"_26939":118956,"_2865":118957},[],"/docs/pr-preview/pr-53/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3379":70294,"_29619":70288,"_5":29969,"_20556":118959,"_26939":118960,"_2865":118961},[],"/docs/pr-preview/pr-53/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3379":70295,"_29619":70288,"_5":29969,"_20556":118963,"_26939":118964,"_2865":118965},[],"/docs/pr-preview/pr-53/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3379":70296,"_29619":70288,"_5":29969,"_20556":118967,"_26939":118968,"_2865":118969},[],"/docs/pr-preview/pr-53/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3379":70297,"_29619":70288,"_5":29969,"_20556":118971,"_26939":118972,"_2865":118973},[],"/docs/pr-preview/pr-53/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3379":70298,"_29619":70288,"_5":29969,"_20556":118975,"_26939":118976,"_2865":118977},[],"/docs/pr-preview/pr-53/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3379":70299,"_29619":70288,"_5":29969,"_20556":118979,"_26939":118980,"_2865":118981},[],"/docs/pr-preview/pr-53/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3379":70300,"_29619":70288,"_5":29969,"_20556":118983,"_26939":118984,"_2865":118985},[],"/docs/pr-preview/pr-53/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3379":70301,"_29619":70288,"_5":29969,"_20556":118987,"_26939":118988,"_2865":118989},[],"/docs/pr-preview/pr-53/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3379":70302,"_29619":70288,"_20556":118991,"_5":14099,"_26939":70288,"_2865":118992},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3379":70303,"_29619":70288,"_20556":118994,"_5":14099,"_26939":70288,"_2865":118995},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3379":70304,"_29619":70288,"_20556":118997,"_5":14099,"_26939":118944,"_2865":118998},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3379":70305,"_29619":70288,"_20556":119000,"_5":14099,"_26939":118944,"_2865":119001},[],"entorno, como producción y preproducción;",{"_3379":70306,"_29619":70288,"_20556":119003,"_5":14099,"_26939":118944,"_2865":119004},[],"propietario o equipo operador;",{"_3379":70307,"_29619":70288,"_20556":119006,"_5":14099,"_26939":118944,"_2865":119007},[],"familia de dispositivos o proceso de fabricación;",{"_3379":70308,"_29619":70288,"_20556":119009,"_5":14099,"_26939":118944,"_2865":119010},[],"región o requisito regulatorio;",{"_3379":70309,"_29619":70288,"_20556":119012,"_5":14099,"_26939":118944,"_2865":119013},[],"motor criptográfico o política de clave;",{"_3379":70310,"_29619":70288,"_20556":119015,"_5":14099,"_26939":118944,"_2865":119016},[],"ventana de mantenimiento y ritmo de renovación.",{"_3379":70311,"_29619":70288,"_20556":119018,"_5":14099,"_26939":118944,"_2865":119019},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3379":70312,"_29619":70288,"_20556":119021,"_5":14099,"_26939":118944,"_2865":119022},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3379":70313,"_29619":70288,"_20556":119024,"_5":14099,"_26939":118948,"_2865":119025},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3379":70314,"_29619":70288,"_20556":119027,"_5":14099,"_26939":118948,"_2865":119028},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3379":70315,"_29619":70288,"_20556":119030,"_5":14099,"_26939":118948,"_2865":119031},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_3379":70316,"_29619":70288,"_20556":119033,"_5":14099,"_26939":118952,"_2865":119034},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3379":70317,"_29619":70288,"_20556":119036,"_5":14099,"_26939":118952,"_2865":119037},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3379":70318,"_29619":70288,"_20556":119039,"_5":14099,"_26939":118952,"_2865":119040},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3379":70319,"_29619":70288,"_20556":119042,"_5":14099,"_26939":118952,"_2865":119043},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3379":70320,"_29619":70288,"_20556":119045,"_5":14099,"_26939":118960,"_2865":119046},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3379":70321,"_29619":70288,"_20556":119048,"_5":14099,"_26939":118964,"_2865":119049},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3379":70322,"_29619":70288,"_20556":119051,"_5":14099,"_26939":118968,"_2865":119052},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3379":70323,"_29619":70288,"_20556":119054,"_5":14099,"_26939":118972,"_2865":119055},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_3379":70324,"_29619":70288,"_20556":119057,"_5":14099,"_26939":118976,"_2865":119058},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3379":70325,"_29619":70288,"_20556":119060,"_5":14099,"_26939":118980,"_2865":119061},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_3379":70326,"_29619":70288,"_20556":119063,"_5":14099,"_26939":118984,"_2865":119064},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3379":70327,"_29619":70288,"_20556":119066,"_5":14099,"_26939":118984,"_2865":119067},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3379":70328,"_29619":70288,"_20556":119069,"_5":14099,"_26939":118984,"_2865":119070},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_3379":70329,"_29619":70288,"_20556":119072,"_5":14099,"_26939":118984,"_2865":119073},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3379":70330,"_29619":70288,"_20556":119075,"_5":14099,"_26939":118988,"_2865":119076},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3379":70331,"_29619":70288,"_20556":119078,"_5":14099,"_26939":118988,"_2865":119079},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3379":70332,"_29619":70288,"_20556":119081,"_5":14099,"_26939":118988,"_2865":119082},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3379":70333,"_29619":70288,"_20556":119084,"_5":14099,"_26939":118988,"_2865":119085},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3379":70334,"_29619":70288,"_20556":119087,"_5":14099,"_26939":118988,"_2865":119088},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3379":70335,"_29619":70288,"_20556":119090,"_5":14099,"_26939":118988,"_2865":119091},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3379":70336,"_29619":70288,"_20556":119093,"_5":14099,"_26939":118988,"_2865":119094},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3379":70337,"_29619":70337,"_5":14457,"_2865":119096,"_29972":119097,"_20556":119098,"_26939":70337},"Autoridades de certificación",[48223,115062,53693,118937],[],{"_3379":70338,"_29619":70337,"_20556":119100,"_5":14099,"_26939":70337,"_2865":119101},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3379":70339,"_29619":70337,"_5":29969,"_20556":119103,"_26939":119104,"_2865":119105},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3379":70340,"_29619":70337,"_5":29969,"_20556":119107,"_26939":119108,"_2865":119109},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3379":70341,"_29619":70337,"_5":29969,"_20556":119111,"_26939":119112,"_2865":113640},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3379":70342,"_29619":70337,"_5":29969,"_20556":119114,"_26939":119115,"_2865":119116},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3379":70343,"_29619":70337,"_5":29969,"_20556":119118,"_26939":119119,"_2865":119120},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3379":70344,"_29619":70337,"_5":29969,"_20556":119122,"_26939":119123,"_2865":119124},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3379":70345,"_29619":70337,"_5":29969,"_20556":119126,"_26939":119127,"_2865":119128},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3379":70346,"_29619":70337,"_5":29969,"_20556":119130,"_26939":119131,"_2865":119132},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3379":70347,"_29619":70337,"_5":29969,"_20556":119134,"_26939":119135,"_2865":119136},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3379":70348,"_29619":70337,"_5":29969,"_20556":119138,"_26939":119139,"_2865":119140},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3379":70349,"_29619":70337,"_5":29969,"_20556":119142,"_26939":119143,"_2865":119144},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3379":70350,"_29619":70337,"_5":29969,"_20556":119146,"_26939":119147,"_2865":119148},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3379":70351,"_29619":70337,"_5":29969,"_20556":119150,"_26939":119151,"_2865":119152},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3379":70352,"_29619":70337,"_5":29969,"_20556":119154,"_26939":119155,"_2865":119156},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3379":70353,"_29619":70337,"_5":29969,"_20556":119158,"_26939":119159,"_2865":119160},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3379":70354,"_29619":70337,"_5":29969,"_20556":119162,"_26939":119163,"_2865":119164},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3379":70355,"_29619":70337,"_5":29969,"_20556":119166,"_26939":119167,"_2865":119168},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3379":70356,"_29619":70337,"_5":29969,"_20556":119170,"_26939":119171,"_2865":119172},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3379":70357,"_29619":70337,"_5":29969,"_20556":119174,"_26939":119175,"_2865":119176},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3379":70358,"_29619":70337,"_5":29969,"_20556":119178,"_26939":119179,"_2865":119180},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3379":70359,"_29619":70337,"_5":29969,"_20556":119182,"_26939":119183,"_2865":119184},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3379":70360,"_29619":70337,"_5":29969,"_20556":119186,"_26939":119187,"_2865":119188},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3379":70361,"_29619":70337,"_5":29969,"_20556":119190,"_26939":119191,"_2865":119192},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-authorities#elimina-una-ca","Elimina una CA",{"_3379":70362,"_29619":70337,"_20556":119194,"_5":14099,"_26939":70337,"_2865":119195},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3379":70363,"_29619":70337,"_20556":119197,"_5":14099,"_26939":70337,"_2865":119198},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3379":70364,"_29619":70337,"_20556":119200,"_5":14099,"_26939":70337,"_2865":119201},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3379":70365,"_29619":70337,"_20556":119203,"_5":14099,"_26939":119104,"_2865":119204},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3379":70366,"_29619":70337,"_20556":119206,"_5":14099,"_26939":119104,"_2865":119207},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3379":70367,"_29619":70337,"_20556":119209,"_5":14099,"_26939":119104,"_2865":119210},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3379":70368,"_29619":70337,"_20556":119212,"_5":14099,"_26939":119104,"_2865":119213},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3379":70369,"_29619":70337,"_20556":119215,"_5":14099,"_26939":119104,"_2865":119216},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3379":70370,"_29619":70337,"_20556":119218,"_5":14099,"_26939":119112,"_2865":119219},[],"Decide si la CA será raíz o intermedia.",{"_3379":70371,"_29619":70337,"_20556":119221,"_5":14099,"_26939":119112,"_2865":119222},[],"Elige el motor que custodiará la clave.",{"_3379":70372,"_29619":70337,"_20556":119224,"_5":14099,"_26939":119112,"_2865":119225},[],"Define una validez superior a la de los certificados que emitirá.",{"_3379":70373,"_29619":70337,"_20556":119227,"_5":14099,"_26939":119112,"_2865":119228},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3379":70374,"_29619":70337,"_20556":119230,"_5":14099,"_26939":119115,"_2865":119231},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3379":70375,"_29619":70337,"_20556":119233,"_5":14099,"_26939":119119,"_2865":119234},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3379":70376,"_29619":70337,"_20556":119236,"_5":14099,"_26939":119119,"_2865":119237},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3379":70377,"_29619":70337,"_20556":119239,"_5":14099,"_26939":119123,"_2865":119240},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3379":70378,"_29619":70337,"_20556":119242,"_5":14099,"_26939":119127,"_2865":119243},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3379":70379,"_29619":70337,"_20556":119245,"_5":14099,"_26939":119127,"_2865":119246},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3379":70380,"_29619":70337,"_20556":119248,"_5":14099,"_26939":119127,"_2865":119249},[],"`ST`: estado o provincia.",{"_3379":70381,"_29619":70337,"_20556":119251,"_5":14099,"_26939":119127,"_2865":119252},[],"`L`: localidad.",{"_3379":70382,"_29619":70337,"_20556":119254,"_5":14099,"_26939":119127,"_2865":119255},[],"`O`: organización.",{"_3379":70383,"_29619":70337,"_20556":119257,"_5":14099,"_26939":119127,"_2865":119258},[],"`OU`: unidad organizativa.",{"_3379":70384,"_29619":70337,"_20556":119260,"_5":14099,"_26939":119127,"_2865":119261},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3379":70385,"_29619":70337,"_20556":119263,"_5":14099,"_26939":119131,"_2865":119264},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3379":70386,"_29619":70337,"_20556":119266,"_5":14099,"_26939":119131,"_2865":119267},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3379":70387,"_29619":70337,"_20556":119269,"_5":14099,"_26939":119135,"_2865":119270},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3379":70388,"_29619":70337,"_20556":119272,"_5":14099,"_26939":119135,"_2865":119273},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3379":70389,"_29619":70337,"_20556":119275,"_5":14099,"_26939":119139,"_2865":119276},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3379":70390,"_29619":70337,"_20556":119278,"_5":14099,"_26939":119139,"_2865":119279},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3379":70391,"_29619":70337,"_20556":119281,"_5":14099,"_26939":119143,"_2865":119282},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma (incluido `cRLSign`, sin el cual la CA no puede publicar su CRL) y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3379":70392,"_29619":70337,"_20556":119284,"_5":14099,"_26939":119143,"_2865":119285},[],"El backend rechaza una importación cuyo certificado carece de la restricción básica de CA (`basicConstraints cA flag is not set`), cuyo número de serie coincide con el de un certificado almacenado con contenido distinto, o cuyo certificado idéntico ya pertenece a una CA existente. El registro de certificado de una CA eliminada se conserva y puede reutilizarse al reimportar el mismo certificado, incluido su estado anterior. Reimportar otro certificado con ese número de serie se rechaza; comprueba el certificado y su estado tras reimportarlo.",{"_3379":70393,"_29619":70337,"_20556":119287,"_5":14099,"_26939":119143,"_2865":119288},[],"Eliminar una CA libera las referencias a la clave de su propio certificado actual y de sus certificados reemitidos vinculados, pero conserva esos registros para la CRL y el OCSP de su emisor. Después intenta eliminar la clave; el KMS la conserva si otros certificados todavía la referencian, como los de otra CA que comparte la clave. Revocar los certificados emitidos por la CA eliminada no libera sus propias referencias a claves.",{"_3379":70394,"_29619":70337,"_20556":119290,"_5":14099,"_26939":119147,"_2865":119291},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3379":70395,"_29619":70337,"_20556":119293,"_5":14099,"_26939":119151,"_2865":119294},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3379":70396,"_29619":70337,"_20556":119296,"_5":14099,"_26939":119155,"_2865":119297},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3379":70397,"_29619":70337,"_20556":119299,"_5":14099,"_26939":119159,"_2865":119300},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3379":70398,"_29619":70337,"_20556":119302,"_5":14099,"_26939":119159,"_2865":119303},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3379":70399,"_29619":70337,"_20556":119305,"_5":14099,"_26939":119163,"_2865":119306},[],"Abre una CA desde el inventario para consultar:",{"_3379":70400,"_29619":70337,"_20556":119308,"_5":14099,"_26939":119163,"_2865":119309},[],"Estado y periodo de validez.",{"_3379":70401,"_29619":70337,"_20556":119311,"_5":14099,"_26939":119163,"_2865":119312},[],"Certificado y cadena en formato PEM.",{"_3379":70402,"_29619":70337,"_20556":119314,"_5":14099,"_26939":119163,"_2865":119315},[],"Número de certificados activos, expirados y revocados.",{"_3379":70403,"_29619":70337,"_20556":119317,"_5":14099,"_26939":119163,"_2865":119318},[],"Certificados emitidos en **Issued Certificates**.",{"_3379":70404,"_29619":70337,"_20556":119320,"_5":14099,"_26939":119163,"_2865":119321},[],"CRL vinculada a la autoridad.",{"_3379":70405,"_29619":70337,"_20556":119323,"_5":14099,"_26939":119163,"_2865":119324},[],"Metadatos y motor criptográfico asociado.",{"_3379":70406,"_29619":70337,"_20556":119326,"_5":14099,"_26939":119163,"_2865":119327},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3379":70407,"_29619":70337,"_20556":119329,"_5":14099,"_26939":119167,"_2865":119330},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3379":70408,"_29619":70337,"_20556":119332,"_5":14099,"_26939":119167,"_2865":119333},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3379":70409,"_29619":70337,"_20556":119335,"_5":14099,"_26939":119167,"_2865":119336},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3379":70410,"_29619":70337,"_20556":119338,"_5":14099,"_26939":119167,"_2865":119339},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3379":70411,"_29619":70337,"_20556":119341,"_5":14099,"_26939":119171,"_2865":119342},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_3379":70412,"_29619":70337,"_20556":119344,"_5":14099,"_26939":119175,"_2865":119345},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3379":70413,"_29619":70337,"_20556":119347,"_5":14099,"_26939":119179,"_2865":119348},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3379":70414,"_29619":70337,"_20556":119350,"_5":14099,"_26939":119183,"_2865":119351},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3379":70415,"_29619":70337,"_20556":119353,"_5":14099,"_26939":119187,"_2865":119354},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3379":70416,"_29619":70337,"_20556":119356,"_5":14099,"_26939":119191,"_2865":119357},[],"La eliminación permanente solo está disponible con la CA revocada o caducada; una CA importada sin clave puede eliminarse en cualquier estado. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3379":70417,"_29619":70337,"_20556":119359,"_5":14099,"_26939":119191,"_2865":119360},[],"El rol VA de la CA se conserva. Si no queda otra CA con el mismo SKI, deja de ser editable (consulta CRL), así que ajusta antes su validez y su firmante. La clave de la CA se libera, pero el KMS la conserva mientras otros certificados la referencien.",{"_3379":70418,"_29619":70337,"_20556":119362,"_5":14099,"_26939":119191,"_2865":119363},[],"Lamassu conserva el registro del certificado de una CA eliminada. Si se importa de nuevo ese mismo certificado, la importación termina bien y reutiliza el registro: actualiza el tipo, el emisor y la clave, pero conserva el estado, así que la CA reaparece con el que tenía al eliminarse (normalmente revocada o caducada). Un certificado distinto con el mismo número de serie se rechaza con error 400, y un certificado que ya pertenece a una CA existente, con error 409. Para no heredar el estado anterior, usa un certificado con otro número de serie y comprueba el resultado tras importar. Si el certificado nuevo usa la misma clave, comparte el SKI con el rol VA retenido de la CA eliminada, cuyo firmante es el certificado antiguo: comprueba que la CRL se genera y, si no es así, asigna con `PUT` un firmante de la CA nueva (consulta CRL).",{"_3379":70419,"_29619":70419,"_5":14457,"_2865":119365,"_29972":119366,"_20556":119367,"_26939":70419},"Perfiles de certificado",[48223,115062,53693,118937],[],{"_3379":70420,"_29619":70419,"_20556":119369,"_5":14099,"_26939":70419,"_2865":119370},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3379":70421,"_29619":70419,"_5":29969,"_20556":119372,"_26939":119373,"_2865":119374},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3379":70422,"_29619":70419,"_5":29969,"_20556":119376,"_26939":119377,"_2865":119378},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-profiles#validez","Validez",{"_3379":70423,"_29619":70419,"_5":29969,"_20556":119380,"_26939":119381,"_2865":119382},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3379":70424,"_29619":70419,"_5":29969,"_20556":119384,"_26939":119385,"_2865":119386},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3379":70425,"_29619":70419,"_5":29969,"_20556":119388,"_26939":119389,"_2865":119390},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3379":70426,"_29619":70419,"_5":29969,"_20556":119392,"_26939":119393,"_2865":119394},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3379":70427,"_29619":70419,"_5":29969,"_20556":119396,"_26939":119397,"_2865":119398},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3379":70428,"_29619":70419,"_5":29969,"_20556":119400,"_26939":119401,"_2865":119402},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3379":70429,"_29619":70419,"_5":29969,"_20556":119404,"_26939":119405,"_2865":119406},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3379":70430,"_29619":70419,"_5":29969,"_20556":119408,"_26939":119409,"_2865":119410},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3379":70431,"_29619":70419,"_5":29969,"_20556":119412,"_26939":119413,"_2865":119414},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3379":70432,"_29619":70419,"_5":29969,"_20556":119416,"_26939":119417,"_2865":119418},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3379":70433,"_29619":70419,"_5":29969,"_20556":119420,"_26939":119421,"_2865":119422},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3379":70434,"_29619":70419,"_5":29969,"_20556":119424,"_26939":119425,"_2865":119426},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3379":70435,"_29619":70419,"_5":29969,"_20556":119428,"_26939":119429,"_2865":119430},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3379":70436,"_29619":70419,"_5":29969,"_20556":119432,"_26939":119433,"_2865":119434},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3379":70437,"_29619":70419,"_20556":119436,"_5":14099,"_26939":70419,"_2865":119437},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3379":70438,"_29619":70419,"_20556":119439,"_5":14099,"_26939":70419,"_2865":119440},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3379":70439,"_29619":70419,"_20556":119442,"_5":14099,"_26939":119377,"_2865":119443},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3379":70440,"_29619":70419,"_20556":119445,"_5":14099,"_26939":119377,"_2865":119446},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3379":70441,"_29619":70419,"_20556":119448,"_5":14099,"_26939":119381,"_2865":119449},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Actívalo solo en perfiles destinados a crear o reemitir CAs subordinadas.",{"_3379":70442,"_29619":70419,"_20556":119451,"_5":14099,"_26939":119385,"_2865":119452},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3379":70443,"_29619":70419,"_20556":119454,"_5":14099,"_26939":119385,"_2865":119455},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3379":70444,"_29619":70419,"_20556":119457,"_5":14099,"_26939":119385,"_2865":119458},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3379":70445,"_29619":70419,"_20556":119460,"_5":14099,"_26939":119389,"_2865":119461},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3379":70446,"_29619":70419,"_20556":119463,"_5":14099,"_26939":119393,"_2865":119464},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3379":70447,"_29619":70419,"_20556":119466,"_5":14099,"_26939":119393,"_2865":119467},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3379":70448,"_29619":70419,"_20556":119469,"_5":14099,"_26939":119397,"_2865":119470},[],"La aplicación criptográfica puede:",{"_3379":70449,"_29619":70419,"_20556":119472,"_5":14099,"_26939":119397,"_2865":119473},[],"permitir o bloquear claves RSA;",{"_3379":70450,"_29619":70419,"_20556":119475,"_5":14099,"_26939":119397,"_2865":119476},[],"limitar los tamaños RSA admitidos;",{"_3379":70451,"_29619":70419,"_20556":119478,"_5":14099,"_26939":119397,"_2865":119479},[],"permitir o bloquear claves ECDSA;",{"_3379":70452,"_29619":70419,"_20556":119481,"_5":14099,"_26939":119397,"_2865":119482},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3379":70453,"_29619":70419,"_20556":119484,"_5":14099,"_26939":119397,"_2865":119485},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3379":70454,"_29619":70419,"_20556":119487,"_5":14099,"_26939":119401,"_2865":119488},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3379":70455,"_29619":70419,"_20556":119490,"_5":14099,"_26939":119401,"_2865":114822},[],{"_3379":70456,"_29619":70419,"_20556":119492,"_5":14099,"_26939":119401,"_2865":119493},[],"Primera opción",{"_3379":70457,"_29619":70419,"_20556":119495,"_5":14099,"_26939":119401,"_2865":119496},[],"Segunda opción",{"_3379":70458,"_29619":70419,"_20556":119498,"_5":14099,"_26939":119401,"_2865":119499},[],"Si no hay ninguna",{"_3379":70459,"_29619":70419,"_20556":119501,"_5":14099,"_26939":119401,"_2865":119502},[],"Firma directa con una CA",{"_3379":70460,"_29619":70419,"_20556":119504,"_5":14099,"_26939":119401,"_2865":119505},[],"`issuance_profile` incluido en la solicitud",{"_3379":70461,"_29619":70419,"_20556":119507,"_5":14099,"_26939":119401,"_2865":119508},[],"`issuance_profile_id` de la solicitud",{"_3379":70462,"_29619":70419,"_20556":119510,"_5":14099,"_26939":119401,"_2865":119511},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3379":70463,"_29619":70419,"_20556":119513,"_5":14099,"_26939":119401,"_2865":119514},[],"Emisión mediante DMS",{"_3379":70464,"_29619":70419,"_20556":119516,"_5":14099,"_26939":119401,"_2865":54274},[],{"_3379":70465,"_29619":70419,"_20556":119518,"_5":14099,"_26939":119401,"_2865":119519},[],"`settings.issuance_profile` incluido en el DMS",{"_3379":70466,"_29619":70419,"_20556":119521,"_5":14099,"_26939":119401,"_2865":119522},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3379":70467,"_29619":70419,"_20556":119524,"_5":14099,"_26939":119401,"_2865":119525},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3379":70468,"_29619":70419,"_20556":119527,"_5":14099,"_26939":119401,"_2865":119528},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3379":70469,"_29619":70419,"_20556":119530,"_5":14099,"_26939":119409,"_2865":119531},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3379":70470,"_29619":70419,"_20556":119533,"_5":14099,"_26939":119413,"_2865":119534},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3379":70471,"_29619":70419,"_20556":119536,"_5":14099,"_26939":119417,"_2865":119537},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3379":70472,"_29619":70419,"_20556":119539,"_5":14099,"_26939":119421,"_2865":119540},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3379":70473,"_29619":70419,"_20556":119542,"_5":14099,"_26939":119425,"_2865":119543},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3379":70474,"_29619":70419,"_20556":119545,"_5":14099,"_26939":119425,"_2865":119546},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3379":70475,"_29619":70419,"_20556":119548,"_5":14099,"_26939":119429,"_2865":119549},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3379":70476,"_29619":70419,"_20556":119551,"_5":14099,"_26939":119429,"_2865":119552},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3379":70477,"_29619":70419,"_20556":119554,"_5":14099,"_26939":119429,"_2865":119555},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3379":70478,"_29619":70419,"_20556":119557,"_5":14099,"_26939":119429,"_2865":119558},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3379":70479,"_29619":70419,"_20556":119560,"_5":14099,"_26939":119433,"_2865":119561},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3379":70480,"_29619":70419,"_20556":119563,"_5":14099,"_26939":119433,"_2865":119564},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3379":70481,"_29619":70481,"_5":14457,"_2865":119566,"_29972":119567,"_20556":119569,"_26939":70481},"Validación de certificados",[48223,115062,53693,119568],"Validación",[],{"_3379":70482,"_29619":70481,"_20556":119571,"_5":14099,"_26939":70481,"_2865":119572},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3379":70483,"_29619":70481,"_5":29969,"_20556":119574,"_26939":119575,"_2865":119576},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3379":70484,"_29619":70481,"_5":29969,"_20556":119578,"_26939":119579,"_2865":119580},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3379":70485,"_29619":70481,"_5":29969,"_20556":119582,"_26939":119583,"_2865":119584},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3379":70486,"_29619":70481,"_20556":119586,"_5":14099,"_26939":70481,"_2865":119587},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3379":70487,"_29619":70481,"_20556":119589,"_5":14099,"_26939":119575,"_2865":119590},[],"Verifica estos criterios juntos:",{"_3379":70488,"_29619":70481,"_20556":119592,"_5":14099,"_26939":119575,"_2865":118566},[],{"_3379":70489,"_29619":70481,"_20556":119594,"_5":14099,"_26939":119575,"_2865":119595},[],"Resultado necesario",{"_3379":70490,"_29619":70481,"_20556":119597,"_5":14099,"_26939":119575,"_2865":119598},[],"Cadena y firma",{"_3379":70491,"_29619":70481,"_20556":119600,"_5":14099,"_26939":119575,"_2865":119601},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3379":70492,"_29619":70481,"_20556":119603,"_5":14099,"_26939":119575,"_2865":119604},[],"Fechas",{"_3379":70493,"_29619":70481,"_20556":119606,"_5":14099,"_26939":119575,"_2865":119607},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3379":70494,"_29619":70481,"_20556":119609,"_5":14099,"_26939":119575,"_2865":114732},[],{"_3379":70495,"_29619":70481,"_20556":119611,"_5":14099,"_26939":119575,"_2865":119612},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3379":70496,"_29619":70481,"_20556":119614,"_5":14099,"_26939":119575,"_2865":119615},[],"Uso",{"_3379":70497,"_29619":70481,"_20556":119617,"_5":14099,"_26939":119575,"_2865":119618},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3379":70498,"_29619":70481,"_20556":119620,"_5":14099,"_26939":119575,"_2865":119621},[],"Revocación",{"_3379":70499,"_29619":70481,"_20556":119623,"_5":14099,"_26939":119575,"_2865":119624},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3379":70500,"_29619":70481,"_20556":119626,"_5":14099,"_26939":119575,"_2865":119627},[],"Autorización",{"_3379":70501,"_29619":70481,"_20556":119629,"_5":14099,"_26939":119575,"_2865":119630},[],"La aplicación permite la acción a esa identidad.",{"_3379":70502,"_29619":70481,"_20556":119632,"_5":14099,"_26939":119575,"_2865":119633},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3379":70503,"_29619":70481,"_20556":119635,"_5":14099,"_26939":119579,"_2865":119636},[],"Mecanismo",{"_3379":70504,"_29619":70481,"_20556":119638,"_5":14099,"_26939":119579,"_2865":119639},[],"Cuándo utilizarlo",{"_3379":70505,"_29619":70481,"_20556":119641,"_5":14099,"_26939":119579,"_2865":119642},[],"Qué debes mantener",{"_3379":70506,"_29619":70481,"_20556":119644,"_5":14099,"_26939":119579,"_2865":54402},[],{"_3379":70507,"_29619":70481,"_20556":119646,"_5":14099,"_26939":119579,"_2865":119647},[],"Consulta del estado de un certificado concreto.",{"_3379":70508,"_29619":70481,"_20556":119649,"_5":14099,"_26939":119579,"_2865":119650},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3379":70509,"_29619":70481,"_20556":119652,"_5":14099,"_26939":119579,"_2865":54411},[],{"_3379":70510,"_29619":70481,"_20556":119654,"_5":14099,"_26939":119579,"_2865":119655},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3379":70511,"_29619":70481,"_20556":119657,"_5":14099,"_26939":119579,"_2865":119658},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3379":70512,"_29619":70481,"_20556":119660,"_5":14099,"_26939":119579,"_2865":119661},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3379":70513,"_29619":70481,"_20556":119663,"_5":14099,"_26939":119579,"_2865":119664},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3379":70514,"_29619":70481,"_20556":119666,"_5":14099,"_26939":119583,"_2865":119667},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3379":70515,"_29619":70481,"_20556":119669,"_5":14099,"_26939":119583,"_2865":119670},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3379":70516,"_29619":70481,"_20556":119672,"_5":14099,"_26939":119583,"_2865":119673},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3379":70517,"_29619":70481,"_20556":119675,"_5":14099,"_26939":119583,"_2865":119676},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3379":70518,"_29619":70481,"_20556":119678,"_5":14099,"_26939":119583,"_2865":119679},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3379":70519,"_29619":70481,"_20556":119681,"_5":14099,"_26939":119583,"_2865":119682},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3379":70520,"_29619":70481,"_20556":119684,"_5":14099,"_26939":119583,"_2865":119685},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3379":70521,"_29619":70481,"_20556":119687,"_5":14099,"_26939":119583,"_2865":119688},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3379":70522,"_29619":70481,"_20556":119690,"_5":14099,"_26939":119583,"_2865":119691},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3379":70523,"_29619":70523,"_5":14457,"_2865":119693,"_29972":119694,"_20556":119695,"_26939":70523},"Certificados",[48223,115062,53693,118937],[],{"_3379":70524,"_29619":70523,"_20556":119697,"_5":14099,"_26939":70523,"_2865":119698},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3379":70525,"_29619":70523,"_5":29969,"_20556":119700,"_26939":119701,"_2865":119702},[],"/docs/pr-preview/pr-53/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3379":70526,"_29619":70523,"_5":29969,"_20556":119704,"_26939":119705,"_2865":119706},[],"/docs/pr-preview/pr-53/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3379":70527,"_29619":70523,"_5":29969,"_20556":119708,"_26939":119709,"_2865":119710},[],"/docs/pr-preview/pr-53/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3379":70528,"_29619":70523,"_5":29969,"_20556":119712,"_26939":119713,"_2865":119714},[],"/docs/pr-preview/pr-53/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3379":70529,"_29619":70523,"_5":29969,"_20556":119716,"_26939":119717,"_2865":119718},[],"/docs/pr-preview/pr-53/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3379":70530,"_29619":70523,"_5":29969,"_20556":119720,"_26939":119721,"_2865":119722},[],"/docs/pr-preview/pr-53/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3379":70531,"_29619":70523,"_5":29969,"_20556":119724,"_26939":119725,"_2865":119726},[],"/docs/pr-preview/pr-53/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3379":70532,"_29619":70523,"_5":29969,"_20556":119728,"_26939":119729,"_2865":119730},[],"/docs/pr-preview/pr-53/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3379":70533,"_29619":70523,"_5":29969,"_20556":119732,"_26939":119733,"_2865":119734},[],"/docs/pr-preview/pr-53/es/platform/pki/certificates#continúa","Continúa",{"_3379":70534,"_29619":70523,"_20556":119736,"_5":14099,"_26939":70523,"_2865":119737},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3379":70535,"_29619":70523,"_20556":119739,"_5":14099,"_26939":119701,"_2865":119740},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Un certificado no contiene su clave privada, así que las superficies de clave privada responden qué certificados tienen su clave custodiada en el KMS de Lamassu:",{"_3379":70536,"_29619":70523,"_20556":119742,"_5":14099,"_26939":119701,"_2865":119743},[],"El filtro avanzado **Private Key**, disponible en la página Certificates y en la pestaña **Issued Certificates** de una CA, limita la lista a **All Certificates**, **With Private Key** o **Without Private Key**.",{"_3379":70537,"_29619":70523,"_20556":119745,"_5":14099,"_26939":119701,"_2865":119746},[],"La columna ordenable **Private Key** — visible por defecto y oculta en pantallas estrechas — marca con una marca de verificación verde la clave custodiada en el KMS y muestra `-` en los demás casos.",{"_3379":70538,"_29619":70523,"_20556":119748,"_5":14099,"_26939":119701,"_2865":119749},[],"En los detalles del certificado, la pestaña **Information** muestra una fila **Private Key** en la sección **Key & Signature**. Cuando el certificado indica que tiene clave privada y están disponibles los identificadores de la clave y del motor del KMS, la fila enlaza a la clave (tooltip: **Open private key in KMS**). En caso contrario, muestra **Present** si el certificado indica que tiene clave privada o **Not available** si no lo indica. Esto no determina si existe una clave fuera de Lamassu.",{"_3379":70539,"_29619":70523,"_20556":119751,"_5":14099,"_26939":119701,"_2865":119752},[],"Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_3379":70540,"_29619":70523,"_20556":119754,"_5":14099,"_26939":119701,"_2865":119755},[],"Los detalles del certificado incluyen la referencia a la clave (`key_id`) y si la clave privada está gestionada (`has_private_key`); las listas de certificados pueden filtrarse por `has_private_key`.",{"_3379":70541,"_29619":70523,"_20556":119757,"_5":14099,"_26939":119701,"_2865":119758},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3379":70542,"_29619":70523,"_20556":119760,"_5":14099,"_26939":119705,"_2865":119761},[],"Descarga el PEM e inspecciónalo:",{"_3379":70543,"_29619":70523,"_20556":119763,"_5":14099,"_26939":119705,"_2865":119764},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3379":70544,"_29619":70523,"_20556":119766,"_5":14099,"_26939":119709,"_2865":119767},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3379":70545,"_29619":70523,"_20556":119769,"_5":14099,"_26939":119709,"_2865":119770},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3379":70546,"_29619":70523,"_20556":119772,"_5":14099,"_26939":119709,"_2865":119773},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3379":70547,"_29619":70523,"_20556":119775,"_5":14099,"_26939":119709,"_2865":119776},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3379":70548,"_29619":70523,"_20556":119778,"_5":14099,"_26939":119709,"_2865":119779},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3379":70549,"_29619":70523,"_20556":119781,"_5":14099,"_26939":119709,"_2865":119782},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3379":70550,"_29619":70523,"_20556":119784,"_5":14099,"_26939":119709,"_2865":119785},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3379":70551,"_29619":70523,"_20556":119787,"_5":14099,"_26939":119713,"_2865":119788},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3379":70552,"_29619":70523,"_20556":119790,"_5":14099,"_26939":119717,"_2865":119791},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3379":70553,"_29619":70523,"_20556":119793,"_5":14099,"_26939":119721,"_2865":119794},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3379":70554,"_29619":70523,"_20556":119796,"_5":14099,"_26939":119725,"_2865":119797},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3379":70555,"_29619":70523,"_20556":119799,"_5":14099,"_26939":119725,"_2865":119800},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3379":70556,"_29619":70523,"_20556":119802,"_5":14099,"_26939":119725,"_2865":119803},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3379":70557,"_29619":70523,"_20556":119805,"_5":14099,"_26939":119729,"_2865":119806},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3379":70558,"_29619":70523,"_20556":119808,"_5":14099,"_26939":119729,"_2865":119809},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3379":70559,"_29619":70523,"_20556":119811,"_5":14099,"_26939":119729,"_2865":119812},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_3379":70560,"_29619":70523,"_20556":119814,"_5":14099,"_26939":119733,"_2865":119815},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3379":70561,"_29619":70523,"_20556":119817,"_5":14099,"_26939":119733,"_2865":119818},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3379":70562,"_29619":70562,"_5":14457,"_2865":119820,"_29972":119821,"_20556":119823,"_26939":70562},"Ciclo de vida de un certificado",[48223,115062,53693,119822],"Conceptos",[],{"_3379":70563,"_29619":70562,"_20556":119825,"_5":14099,"_26939":70562,"_2865":119826},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3379":70564,"_29619":70562,"_5":29969,"_20556":119828,"_26939":119829,"_2865":119830},[],"/docs/pr-preview/pr-53/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3379":70565,"_29619":70562,"_5":29969,"_20556":119832,"_26939":119833,"_2865":119834},[],"/docs/pr-preview/pr-53/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3379":70566,"_29619":70562,"_5":29969,"_20556":119836,"_26939":119837,"_2865":119838},[],"/docs/pr-preview/pr-53/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3379":70567,"_29619":70562,"_5":29969,"_20556":119840,"_26939":119841,"_2865":119842},[],"/docs/pr-preview/pr-53/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3379":70568,"_29619":70562,"_5":29969,"_20556":119844,"_26939":119845,"_2865":119846},[],"/docs/pr-preview/pr-53/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3379":70569,"_29619":70562,"_5":29969,"_20556":119848,"_26939":119849,"_2865":119850},[],"/docs/pr-preview/pr-53/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3379":70570,"_29619":70562,"_5":29969,"_20556":119852,"_26939":119853,"_2865":117560},[],"/docs/pr-preview/pr-53/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado",{"_3379":70571,"_29619":70562,"_5":29969,"_20556":119855,"_26939":119856,"_2865":119857},[],"/docs/pr-preview/pr-53/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3379":70572,"_29619":70562,"_5":29969,"_20556":119859,"_26939":119860,"_2865":119861},[],"/docs/pr-preview/pr-53/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3379":70573,"_29619":70562,"_5":29969,"_20556":119863,"_26939":119864,"_2865":119865},[],"/docs/pr-preview/pr-53/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3379":70574,"_29619":70562,"_20556":119867,"_5":14099,"_26939":70562,"_2865":119868},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3379":70575,"_29619":70562,"_20556":119870,"_5":14099,"_26939":119833,"_2865":119871},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3379":70576,"_29619":70562,"_20556":119873,"_5":14099,"_26939":119837,"_2865":119874},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3379":70577,"_29619":70562,"_20556":119876,"_5":14099,"_26939":119841,"_2865":119877},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3379":70578,"_29619":70562,"_20556":119879,"_5":14099,"_26939":119845,"_2865":119880},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3379":70579,"_29619":70562,"_20556":119882,"_5":14099,"_26939":119849,"_2865":119883},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3379":70580,"_29619":70562,"_20556":119885,"_5":14099,"_26939":119853,"_2865":119886},[],"Lamassu persiste cuatro estados X.509:",{"_3379":70581,"_29619":70562,"_20556":119888,"_5":14099,"_26939":119853,"_2865":119889},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3379":70582,"_29619":70562,"_20556":119891,"_5":14099,"_26939":119853,"_2865":119892},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3379":70583,"_29619":70562,"_20556":119894,"_5":14099,"_26939":119853,"_2865":119895},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3379":70584,"_29619":70562,"_20556":119897,"_5":14099,"_26939":119853,"_2865":119898},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3379":70585,"_29619":70562,"_20556":119900,"_5":14099,"_26939":119853,"_2865":119901},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3379":70586,"_29619":70562,"_20556":119903,"_5":14099,"_26939":119856,"_2865":119904},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3379":70587,"_29619":70562,"_20556":119906,"_5":14099,"_26939":119856,"_2865":119907},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3379":70588,"_29619":70562,"_20556":119909,"_5":14099,"_26939":119856,"_2865":119910},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3379":70589,"_29619":70562,"_20556":119912,"_5":14099,"_26939":119860,"_2865":119913},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3379":70590,"_29619":70562,"_20556":119915,"_5":14099,"_26939":119860,"_2865":119916},[],"Antes de confirmar:",{"_3379":70591,"_29619":70562,"_20556":119918,"_5":14099,"_26939":119860,"_2865":119919},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3379":70592,"_29619":70562,"_20556":119921,"_5":14099,"_26939":119860,"_2865":119922},[],"Distribuye la nueva cadena de confianza.",{"_3379":70593,"_29619":70562,"_20556":119924,"_5":14099,"_26939":119860,"_2865":119925},[],"Reemite las identidades necesarias.",{"_3379":70594,"_29619":70562,"_20556":119927,"_5":14099,"_26939":119860,"_2865":119928},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3379":70595,"_29619":70562,"_20556":119930,"_5":14099,"_26939":119860,"_2865":119931},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3379":70596,"_29619":70562,"_20556":119933,"_5":14099,"_26939":119860,"_2865":119934},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3379":70597,"_29619":70562,"_20556":119936,"_5":14099,"_26939":119864,"_2865":119937},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3379":70598,"_29619":70562,"_20556":119939,"_5":14099,"_26939":119864,"_2865":119940},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3379":70599,"_29619":70562,"_20556":119942,"_5":14099,"_26939":119864,"_2865":119943},[],"Cambios de estado y razones de revocación.",{"_3379":70600,"_29619":70562,"_20556":119945,"_5":14099,"_26939":119864,"_2865":119946},[],"Publicación y vigencia de OCSP y CRLs.",{"_3379":70601,"_29619":70562,"_20556":119948,"_5":14099,"_26939":119864,"_2865":119949},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3379":70602,"_29619":70562,"_20556":119951,"_5":14099,"_26939":119864,"_2865":119952},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3379":70603,"_29619":70603,"_5":14457,"_2865":119954,"_29972":119955,"_20556":119956,"_26939":70603},"Modelo de confianza",[48223,115062,53693,119822],[],{"_3379":70604,"_29619":70603,"_20556":119958,"_5":14099,"_26939":70603,"_2865":119959},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3379":70605,"_29619":70603,"_5":29969,"_20556":119961,"_26939":119962,"_2865":119963},[],"/docs/pr-preview/pr-53/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3379":70606,"_29619":70603,"_5":29969,"_20556":119965,"_26939":119966,"_2865":119967},[],"/docs/pr-preview/pr-53/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3379":70607,"_29619":70603,"_5":29969,"_20556":119969,"_26939":119970,"_2865":119971},[],"/docs/pr-preview/pr-53/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3379":70608,"_29619":70603,"_5":29969,"_20556":119973,"_26939":119974,"_2865":119975},[],"/docs/pr-preview/pr-53/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3379":70609,"_29619":70603,"_5":29969,"_20556":119977,"_26939":119978,"_2865":119979},[],"/docs/pr-preview/pr-53/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3379":70610,"_29619":70603,"_5":29969,"_20556":119981,"_26939":119982,"_2865":119983},[],"/docs/pr-preview/pr-53/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3379":70611,"_29619":70603,"_5":29969,"_20556":119985,"_26939":119986,"_2865":119987},[],"/docs/pr-preview/pr-53/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3379":70612,"_29619":70603,"_5":29969,"_20556":119989,"_26939":119990,"_2865":119991},[],"/docs/pr-preview/pr-53/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3379":70613,"_29619":70603,"_5":29969,"_20556":119993,"_26939":119994,"_2865":119995},[],"/docs/pr-preview/pr-53/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3379":70614,"_29619":70603,"_5":29969,"_20556":119997,"_26939":119998,"_2865":119999},[],"/docs/pr-preview/pr-53/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3379":70615,"_29619":70603,"_20556":120001,"_5":14099,"_26939":70603,"_2865":120002},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3379":70616,"_29619":70603,"_20556":120004,"_5":14099,"_26939":119966,"_2865":120005},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3379":70617,"_29619":70603,"_20556":120007,"_5":14099,"_26939":119970,"_2865":120008},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3379":70618,"_29619":70603,"_20556":120010,"_5":14099,"_26939":119974,"_2865":120011},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3379":70619,"_29619":70603,"_20556":120013,"_5":14099,"_26939":119978,"_2865":120014},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3379":70620,"_29619":70603,"_20556":120016,"_5":14099,"_26939":119982,"_2865":120017},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3379":70621,"_29619":70603,"_20556":120019,"_5":14099,"_26939":119982,"_2865":120020},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3379":70622,"_29619":70603,"_20556":120022,"_5":14099,"_26939":119982,"_2865":120023},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3379":70623,"_29619":70603,"_20556":120025,"_5":14099,"_26939":119982,"_2865":120026},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3379":70624,"_29619":70603,"_20556":120028,"_5":14099,"_26939":119982,"_2865":120029},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3379":70625,"_29619":70603,"_20556":120031,"_5":14099,"_26939":119982,"_2865":120032},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3379":70626,"_29619":70603,"_20556":120034,"_5":14099,"_26939":119986,"_2865":120035},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3379":70627,"_29619":70603,"_20556":120037,"_5":14099,"_26939":119986,"_2865":120038},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3379":70628,"_29619":70603,"_20556":120040,"_5":14099,"_26939":119986,"_2865":120041},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_3379":70629,"_29619":70603,"_20556":120043,"_5":14099,"_26939":119986,"_2865":120044},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3379":70630,"_29619":70603,"_20556":120046,"_5":14099,"_26939":119986,"_2865":120047},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3379":70631,"_29619":70603,"_20556":120049,"_5":14099,"_26939":119990,"_2865":120050},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3379":70632,"_29619":70603,"_20556":120052,"_5":14099,"_26939":119990,"_2865":120053},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3379":70633,"_29619":70603,"_20556":120055,"_5":14099,"_26939":119990,"_2865":120056},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3379":70634,"_29619":70603,"_20556":120058,"_5":14099,"_26939":119990,"_2865":120059},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3379":70635,"_29619":70603,"_20556":120061,"_5":14099,"_26939":119990,"_2865":120062},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3379":70636,"_29619":70603,"_20556":120064,"_5":14099,"_26939":119990,"_2865":120065},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3379":70637,"_29619":70603,"_20556":120067,"_5":14099,"_26939":119990,"_2865":120068},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_3379":70638,"_29619":70603,"_20556":120070,"_5":14099,"_26939":119994,"_2865":120071},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3379":70639,"_29619":70603,"_20556":120073,"_5":14099,"_26939":119998,"_2865":120074},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3379":70640,"_29619":70603,"_20556":120076,"_5":14099,"_26939":119998,"_2865":120077},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3379":70641,"_29619":70603,"_20556":120079,"_5":14099,"_26939":119998,"_2865":120080},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3379":70642,"_29619":70603,"_20556":120082,"_5":14099,"_26939":119998,"_2865":120083},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3379":70643,"_29619":70603,"_20556":120085,"_5":14099,"_26939":119998,"_2865":120086},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3379":70644,"_29619":70603,"_20556":120088,"_5":14099,"_26939":119998,"_2865":120089},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3379":70645,"_29619":70603,"_20556":120091,"_5":14099,"_26939":119998,"_2865":120092},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3379":70646,"_29619":70646,"_5":14457,"_2865":120094,"_29972":120095,"_20556":120096,"_26939":70646},"Listas de revocación (CRL)",[48223,115062,53693,119568],[],{"_3379":70647,"_29619":70646,"_20556":120098,"_5":14099,"_26939":70646,"_2865":120099},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3379":70648,"_29619":70646,"_5":29969,"_20556":120101,"_26939":120102,"_2865":120103},[],"/docs/pr-preview/pr-53/es/platform/pki/crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_3379":70649,"_29619":70646,"_5":29969,"_20556":120105,"_26939":120106,"_2865":120107},[],"/docs/pr-preview/pr-53/es/platform/pki/crl#cas-que-comparten-clave","CAs que comparten clave",{"_3379":70650,"_29619":70646,"_5":29969,"_20556":120109,"_26939":120110,"_2865":120111},[],"/docs/pr-preview/pr-53/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3379":70651,"_29619":70646,"_5":29969,"_20556":120113,"_26939":120114,"_2865":120115},[],"/docs/pr-preview/pr-53/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3379":70652,"_29619":70646,"_5":29969,"_20556":120117,"_26939":120118,"_2865":120119},[],"/docs/pr-preview/pr-53/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3379":70653,"_29619":70646,"_5":29969,"_20556":120121,"_26939":120122,"_2865":120123},[],"/docs/pr-preview/pr-53/es/platform/pki/crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_3379":70654,"_29619":70646,"_5":29969,"_20556":120125,"_26939":120126,"_2865":120127},[],"/docs/pr-preview/pr-53/es/platform/pki/crl#errores-frecuentes-del-rol-va","Errores frecuentes del rol VA",{"_3379":70655,"_29619":70646,"_5":29969,"_20556":120129,"_26939":120130,"_2865":120131},[],"/docs/pr-preview/pr-53/es/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_3379":70656,"_29619":70646,"_5":29969,"_20556":120133,"_26939":120134,"_2865":120135},[],"/docs/pr-preview/pr-53/es/platform/pki/crl#referencias","Referencias",{"_3379":70657,"_29619":70646,"_20556":120137,"_5":14099,"_26939":70646,"_2865":120138},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su SKI y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3379":70658,"_29619":70646,"_20556":120140,"_5":14099,"_26939":120102,"_2865":120141},[],"El rol VA guarda la configuración y los metadatos de la última lista publicada para el SKI de una CA. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3379":70659,"_29619":70646,"_20556":120143,"_5":14099,"_26939":120102,"_2865":120144},[],"Campo de `crl_options`",{"_3379":70660,"_29619":70646,"_20556":120146,"_5":14099,"_26939":120102,"_2865":116600},[],{"_3379":70661,"_29619":70646,"_20556":120148,"_5":14099,"_26939":120102,"_2865":120149},[],"Valor inicial del backend",{"_3379":70662,"_29619":70646,"_20556":120151,"_5":14099,"_26939":120102,"_2865":54912},[],{"_3379":70663,"_29619":70646,"_20556":120153,"_5":14099,"_26939":120102,"_2865":120154},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3379":70664,"_29619":70646,"_20556":120156,"_5":14099,"_26939":120102,"_2865":120157},[],"7 días.",{"_3379":70665,"_29619":70646,"_20556":120159,"_5":14099,"_26939":120102,"_2865":54921},[],{"_3379":70666,"_29619":70646,"_20556":120161,"_5":14099,"_26939":120102,"_2865":120162},[],"Se guarda y se devuelve por la API, pero la VA no lo utiliza: la renovación programada no depende de él (consulta Regeneración periódica y automática).",{"_3379":70667,"_29619":70646,"_20556":120164,"_5":14099,"_26939":120102,"_2865":120165},[],"6 días y 23 horas.",{"_3379":70668,"_29619":70646,"_20556":120167,"_5":14099,"_26939":120102,"_2865":54930},[],{"_3379":70669,"_29619":70646,"_20556":120169,"_5":14099,"_26939":120102,"_2865":120170},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3379":70670,"_29619":70646,"_20556":120172,"_5":14099,"_26939":120102,"_2865":54936},[],{"_3379":70671,"_29619":70646,"_20556":120174,"_5":14099,"_26939":120102,"_2865":54939},[],{"_3379":70672,"_29619":70646,"_20556":120176,"_5":14099,"_26939":120102,"_2865":120177},[],"Número de serie del certificado existente que firma la CRL.",{"_3379":70673,"_29619":70646,"_20556":120179,"_5":14099,"_26939":120102,"_2865":120180},[],"Número de serie del certificado actual de la CA.",{"_3379":70674,"_29619":70646,"_20556":120182,"_5":14099,"_26939":120102,"_2865":120183},[],"El firmante debe ser un certificado existente con el uso `cRLSign`, el mismo sujeto y la misma clave pública que la CA. Quedan incluidos los certificados anteriores a una reemisión. No se admite un firmante delegado: un certificado con el sujeto de la CA pero con otra clave se rechaza.",{"_3379":70675,"_29619":70646,"_20556":120185,"_5":14099,"_26939":120102,"_2865":120186},[],"Al reemitir una CA, el rol sigue apuntando al certificado anterior. Las CRL siguen siendo válidas porque ambos certificados comparten sujeto y clave, pero el certificado anterior no puede eliminarse mientras el rol lo use. Para retirarlo, actualiza el firmante del rol.",{"_3379":70676,"_29619":70646,"_20556":120188,"_5":14099,"_26939":120102,"_2865":120189},[],"Al eliminar una CA, su rol VA se conserva y no puede borrarse por API. Si no queda ninguna otra CA con el mismo SKI, el rol puede consultarse pero cualquier `PUT` devuelve 404, y el trabajo de renovación registra un aviso en cada ciclo porque ya no encuentra la CA. La API no ofrece salida; solo se corrige editando la base de datos. Si queda otra CA con ese SKI, el rol sigue siendo editable (consulta CAs que comparten clave). Ajusta validez y firmante antes de eliminar la CA.",{"_3379":70677,"_29619":70646,"_20556":120191,"_5":14099,"_26939":120102,"_2865":120192},[],"Una CA cuyo certificado no tiene `cRLSign` no puede generar su CRL ni editar su rol (error 400). Desde 4.0 la VA exige este uso. Comprueba antes de importar con `openssl x509 -noout -ext keyUsage` y, si falta, obtén un certificado de la misma CA y clave que lo incluya y asígnalo como firmante con `PUT`. Tras reemitir una CA, comprueba también el uso de clave del certificado nuevo: puede no conservar los usos del original.",{"_3379":70678,"_29619":70646,"_20556":120194,"_5":14099,"_26939":120102,"_2865":120195},[],"El `PUT` valida siempre el firmante, aunque la petición no lo cambie. Si el firmante guardado ya no es válido, no se puede modificar ningún campo del rol, ni siquiera la validez, hasta asignar uno válido.",{"_3379":70679,"_29619":70646,"_20556":120197,"_5":14099,"_26939":120102,"_2865":120198},[],"Compartir una clave entre CA puede impedir la validación de las CRL. Consulta CAs que comparten clave.",{"_3379":70680,"_29619":70646,"_20556":120200,"_5":14099,"_26939":120102,"_2865":120201},[],"`latest_crl` contiene versión, inicio y fin de validez. Las versiones se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/{subject_key_id}/{version}.crl`; el endpoint público entrega DER.",{"_3379":70681,"_29619":70646,"_20556":120203,"_5":14099,"_26939":120106,"_2865":120204},[],"La VA identifica cada CRL por el SKI de la CA, y el SKI se deriva de su clave. Dos CAs con la misma clave tienen el mismo SKI y comparten un único rol VA y una única CRL. Ocurre al crear una CA sobre una clave ya existente del KMS, o al importar una CA cuyo certificado declara un SKI en uso. Lamassu toma el SKI del certificado importado tal cual y no comprueba que corresponda a su clave pública. El rol lo crea la primera CA y las demás lo conservan.",{"_3379":70682,"_29619":70646,"_20556":120206,"_5":14099,"_26939":120106,"_2865":120207},[],"Los certificados de todas ellas apuntan a `/crl/{ski}`, pero la lista publicada tiene como emisor a la primera CA y solo incluye sus revocaciones. Un verificador compara el emisor de la CRL con el del certificado que valida (RFC 5280, §6.3.2) y rechaza la lista si no coinciden. Según su política, el certificado queda bloqueado (*hard-fail*) o se acepta aunque esté revocado (*soft-fail*). Las revocaciones de las CAs secundarias no aparecen en ninguna lista.",{"_3379":70683,"_29619":70646,"_20556":120209,"_5":14099,"_26939":120106,"_2865":120210},[],"Si la primera CA se elimina, la generación de CRL de la restante falla porque el firmante configurado ya no corresponde a una CA con ese nombre. Hasta que se actualice el firmante del rol a un certificado de la CA restante, se sigue sirviendo la última lista publicada hasta que venza (7 días por defecto).",{"_3379":70684,"_29619":70646,"_20556":120212,"_5":14099,"_26939":120106,"_2865":120213},[],"Antes de actualizar, revisa las CAs que comparten clave. Para detectar el problema, compara el SKI de las CAs en el inventario: dos con el mismo SKI están afectadas. Para resolverlo, crea una CA con clave propia y reemite sus certificados; los ya emitidos conservan la URL antigua y no se corrigen hasta reemitirlos. Una CA importada con un SKI ya en uso no sustituye a la existente como emisora de la CRL, porque el emisor se resuelve a partir del firmante del rol. Sin embargo, sus propios certificados apuntan a esa misma URL y sus revocaciones no se publican. Hasta que Lamassu rechace estas importaciones, limita el permiso de importar CAs como control provisional; cubre solo la vía de importación. Crear una CA con &#x2A;*Create New CA (Existing Key)** sobre una clave KMS que otra CA ya usa produce la misma colisión, así que tampoco reutilices claves entre CAs. Una CRL por CA y el rechazo de importaciones cuyo SKI colisiona con el de una CA existente están planteados en lamassuiot#834, y ninguno está implementado todavía.",{"_3379":70685,"_29619":70646,"_20556":120215,"_5":14099,"_26939":120110,"_2865":120216},[],"El trabajo programado de la VA revisa todos los roles en cada ejecución y solicita otra lista cuando a `latest_crl` le queda menos validez que el intervalo entre ejecuciones. La frecuencia se configura en Helm con `services.va.job.crl.frequency` (por defecto `0 * * * *`) y admite una duración (`1h`) o una expresión cron. Una expresión cron se convierte en un intervalo constante igual al tiempo que falta para su siguiente disparo cuando arranca el servicio, así que no se alinea con el reloj. `refresh_interval` no interviene. Mantén `validity` claramente por encima del intervalo: con una validez menor, la lista se regenera en cada ciclo.",{"_3379":70686,"_29619":70646,"_20556":120218,"_5":14099,"_26939":120110,"_2865":120219},[],"Si la generación falla (por ejemplo, por un rol sin CA o un firmante inválido), el trabajo registra el aviso `something went wrong while calculating CRL for CA <ski>` y lo reintenta en el ciclo siguiente. No hay otra vía de renovación hasta corregir la causa, y la última lista publicada se sigue sirviendo hasta vencer. Todo ello depende de que el trabajo, el almacenamiento y la firma funcionen.",{"_3379":70687,"_29619":70646,"_20556":120221,"_5":14099,"_26939":120110,"_2865":120222},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores: si falla (rol inexistente, firmante inválido), el evento se reintenta y, agotados los reintentos, pasa a la cola de eventos fallidos. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3379":70688,"_29619":70646,"_20556":120224,"_5":14099,"_26939":120110,"_2865":120225},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3379":70689,"_29619":70646,"_20556":120227,"_5":14099,"_26939":120114,"_2865":120228},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3379":70690,"_29619":70646,"_20556":120230,"_5":14099,"_26939":120114,"_2865":120231},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3379":70691,"_29619":70646,"_20556":120233,"_5":14099,"_26939":120118,"_2865":120234},[],"El servicio VA expone `GET /crl/{subject_key_id}` sin autorización de gestión. Usa el SKI de la **CA emisora**, no el SKI del certificado final ni su número de serie. Inspecciona primero el CDP del certificado:",{"_3379":70692,"_29619":70646,"_20556":120236,"_5":14099,"_26939":120118,"_2865":120237},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3379":70693,"_29619":70646,"_20556":120239,"_5":14099,"_26939":120118,"_2865":120240},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Un certificado firmante aceptado tiene el mismo sujeto y la misma clave pública que la CA, por lo que esta comprobación de firma también funciona cuando el rol apunta a un certificado anterior de esa CA y clave. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3379":70694,"_29619":70646,"_20556":120242,"_5":14099,"_26939":120118,"_2865":120243},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3379":70695,"_29619":70646,"_20556":120245,"_5":14099,"_26939":120118,"_2865":120246},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3379":70696,"_29619":70646,"_20556":120248,"_5":14099,"_26939":120122,"_2865":120249},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3379":70697,"_29619":70646,"_20556":120251,"_5":14099,"_26939":120122,"_2865":116789},[],{"_3379":70698,"_29619":70646,"_20556":120253,"_5":14099,"_26939":120122,"_2865":120254},[],"Path relativo",{"_3379":70699,"_29619":70646,"_20556":120256,"_5":14099,"_26939":120122,"_2865":114822},[],{"_3379":70700,"_29619":70646,"_20556":120258,"_5":14099,"_26939":120122,"_2865":55024},[],{"_3379":70701,"_29619":70646,"_20556":120260,"_5":14099,"_26939":120122,"_2865":55027},[],{"_3379":70702,"_29619":70646,"_20556":120262,"_5":14099,"_26939":120122,"_2865":120263},[],"Consultar `crl_options` y `latest_crl`.",{"_3379":70703,"_29619":70646,"_20556":120265,"_5":14099,"_26939":120122,"_2865":55033},[],{"_3379":70704,"_29619":70646,"_20556":120267,"_5":14099,"_26939":120122,"_2865":55027},[],{"_3379":70705,"_29619":70646,"_20556":120269,"_5":14099,"_26939":120122,"_2865":120270},[],"Sustituir la configuración de CRL.",{"_3379":70706,"_29619":70646,"_20556":120272,"_5":14099,"_26939":120122,"_2865":120273},[],"Necesitas autenticación y permisos de lectura o actualización del rol. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato: el backend sustituye `crl_options`; no fusiona campos omitidos.",{"_3379":70707,"_29619":70646,"_20556":120275,"_5":14099,"_26939":120122,"_2865":120276},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar el rol no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3379":70708,"_29619":70646,"_20556":120278,"_5":14099,"_26939":120126,"_2865":120279},[],"Síntoma",{"_3379":70709,"_29619":70646,"_20556":120281,"_5":14099,"_26939":120126,"_2865":120282},[],"Causa",{"_3379":70710,"_29619":70646,"_20556":120284,"_5":14099,"_26939":120126,"_2865":120285},[],"Acción",{"_3379":70711,"_29619":70646,"_20556":120287,"_5":14099,"_26939":120126,"_2865":120288},[],"`PUT /v1/roles/{ca-ski}` devuelve 404 y `GET` devuelve 200.",{"_3379":70712,"_29619":70646,"_20556":120290,"_5":14099,"_26939":120126,"_2865":120291},[],"Se eliminó la CA del rol y no queda otra con el mismo SKI.",{"_3379":70713,"_29619":70646,"_20556":120293,"_5":14099,"_26939":120126,"_2865":120294},[],"No hay salida por API; requiere intervención en la base de datos. Evítalo ajustando el rol antes de eliminar la CA.",{"_3379":70714,"_29619":70646,"_20556":120296,"_5":14099,"_26939":120126,"_2865":120297},[],"`PUT` devuelve 400.",{"_3379":70715,"_29619":70646,"_20556":120299,"_5":14099,"_26939":120126,"_2865":120300},[],"El firmante no tiene `cRLSign`, o su sujeto y su clave no coinciden con ninguna CA de ese SKI (por ejemplo, tras eliminar la primera de dos CAs que comparten clave).",{"_3379":70716,"_29619":70646,"_20556":120302,"_5":14099,"_26939":120126,"_2865":120303},[],"Asigna con `PUT` el número de serie de un certificado válido de la CA restante.",{"_3379":70717,"_29619":70646,"_20556":120305,"_5":14099,"_26939":120126,"_2865":120306},[],"`PUT` devuelve 400 desde un cliente de 3.x.",{"_3379":70718,"_29619":70646,"_20556":120308,"_5":14099,"_26939":120126,"_2865":120309},[],"`crl_options.subject_key_id_signer` se sustituyó por `signer_certificate_serial_number`, que es obligatorio.",{"_3379":70719,"_29619":70646,"_20556":120311,"_5":14099,"_26939":120126,"_2865":120312},[],"Actualiza el cliente para enviar el campo nuevo.",{"_3379":70720,"_29619":70646,"_20556":120314,"_5":14099,"_26939":120126,"_2865":120315},[],"La CRL no cambia tras revocar un certificado.",{"_3379":70721,"_29619":70646,"_20556":120317,"_5":14099,"_26939":120126,"_2865":120318},[],"`regenerate_on_revoke` es `false`, o el evento falló por falta de rol o por un firmante inválido.",{"_3379":70722,"_29619":70646,"_20556":120320,"_5":14099,"_26939":120126,"_2865":120321},[],"Revisa los logs de la VA y la cola de eventos fallidos; corrige el firmante.",{"_3379":70723,"_29619":70646,"_20556":120323,"_5":14099,"_26939":120126,"_2865":120324},[],"Un verificador rechaza la CRL por el emisor.",{"_3379":70724,"_29619":70646,"_20556":120326,"_5":14099,"_26939":120126,"_2865":120327},[],"Varias CAs comparten SKI.",{"_3379":70725,"_29619":70646,"_20556":120329,"_5":14099,"_26939":120126,"_2865":120330},[],"Consulta CAs que comparten clave.",{"_3379":70726,"_29619":70646,"_20556":120332,"_5":14099,"_26939":120130,"_2865":120333},[],"La vista de la CA permite inspeccionar y descargar la lista disponible. Compara versión, emisor y tiempos con la copia descargada desde el endpoint público. Los ajustes VA de la CA también permiten seleccionar el firmante de la CRL: el selector de certificados solo ofrece certificados que tienen clave privada y el uso de clave `cRLSign`. Si el certificado de un firmante configurado no puede resolverse, la interfaz muestra `Unknown Certificate (Serial: X)` o `Certificate details unavailable (Serial: X)`. Para diagnosticar una diferencia, sigue Diagnóstico PKI.",{"_3379":70727,"_29619":70646,"_20556":120335,"_5":14099,"_26939":120134,"_2865":120336},[],"RFC 5280: perfil X.509 y CRL.",{"_3379":70728,"_29619":70646,"_20556":120338,"_5":14099,"_26939":120134,"_2865":55107},[],{"_3379":70729,"_29619":70646,"_20556":120340,"_5":14099,"_26939":120134,"_2865":55110},[],{"_3379":70730,"_29619":70646,"_20556":120342,"_5":14099,"_26939":120134,"_2865":120343},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3379":70731,"_29619":70646,"_20556":120345,"_5":14099,"_26939":120134,"_2865":120346},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3379":70732,"_29619":70732,"_5":14457,"_2865":120348,"_29972":120349,"_20556":120350,"_26939":70732},"Claves y motores criptográficos",[48223,115062,53693,118937],[],{"_3379":70733,"_29619":70732,"_20556":120352,"_5":14099,"_26939":70732,"_2865":120353},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3379":70734,"_29619":70732,"_5":29969,"_20556":120355,"_26939":120356,"_2865":120357},[],"/docs/pr-preview/pr-53/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3379":70735,"_29619":70732,"_5":29969,"_20556":120359,"_26939":120360,"_2865":120361},[],"/docs/pr-preview/pr-53/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3379":70736,"_29619":70732,"_5":29969,"_20556":120363,"_26939":120364,"_2865":55135},[],"/docs/pr-preview/pr-53/es/platform/pki/key-management#file-system",{"_3379":70737,"_29619":70732,"_5":29969,"_20556":120366,"_26939":120367,"_2865":55139},[],"/docs/pr-preview/pr-53/es/platform/pki/key-management#hashicorp-vault",{"_3379":70738,"_29619":70732,"_5":29969,"_20556":120369,"_26939":120370,"_2865":55143},[],"/docs/pr-preview/pr-53/es/platform/pki/key-management#aws-secrets-manager",{"_3379":70739,"_29619":70732,"_5":29969,"_20556":120372,"_26939":120373,"_2865":55147},[],"/docs/pr-preview/pr-53/es/platform/pki/key-management#aws-kms",{"_3379":70740,"_29619":70732,"_5":29969,"_20556":120375,"_26939":120376,"_2865":55151},[],"/docs/pr-preview/pr-53/es/platform/pki/key-management#pkcs11",{"_3379":70741,"_29619":70732,"_5":29969,"_20556":120378,"_26939":120379,"_2865":55155},[],"/docs/pr-preview/pr-53/es/platform/pki/key-management#azure-key-vault",{"_3379":70742,"_29619":70732,"_5":29969,"_20556":120381,"_26939":120382,"_2865":120383},[],"/docs/pr-preview/pr-53/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3379":70743,"_29619":70732,"_5":29969,"_20556":120385,"_26939":120386,"_2865":120387},[],"/docs/pr-preview/pr-53/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3379":70744,"_29619":70732,"_5":29969,"_20556":120389,"_26939":120390,"_2865":120391},[],"/docs/pr-preview/pr-53/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3379":70745,"_29619":70732,"_5":29969,"_20556":120393,"_26939":120394,"_2865":120395},[],"/docs/pr-preview/pr-53/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3379":70746,"_29619":70732,"_5":29969,"_20556":120397,"_26939":120398,"_2865":120399},[],"/docs/pr-preview/pr-53/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3379":70747,"_29619":70732,"_5":29969,"_20556":120401,"_26939":120402,"_2865":120403},[],"/docs/pr-preview/pr-53/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3379":70748,"_29619":70732,"_5":29969,"_20556":120405,"_26939":120406,"_2865":120407},[],"/docs/pr-preview/pr-53/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3379":70749,"_29619":70732,"_5":29969,"_20556":120409,"_26939":120410,"_2865":55187},[],"/docs/pr-preview/pr-53/es/platform/pki/key-management#sign",{"_3379":70750,"_29619":70732,"_5":29969,"_20556":120412,"_26939":120413,"_2865":55191},[],"/docs/pr-preview/pr-53/es/platform/pki/key-management#verify",{"_3379":70751,"_29619":70732,"_5":29969,"_20556":120415,"_26939":120416,"_2865":120417},[],"/docs/pr-preview/pr-53/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3379":70752,"_29619":70732,"_5":29969,"_20556":120419,"_26939":120420,"_2865":120421},[],"/docs/pr-preview/pr-53/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3379":70753,"_29619":70732,"_5":29969,"_20556":120423,"_26939":120424,"_2865":120425},[],"/docs/pr-preview/pr-53/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3379":70754,"_29619":70732,"_20556":120427,"_5":14099,"_26939":70732,"_2865":120428},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3379":70755,"_29619":70732,"_20556":120430,"_5":14099,"_26939":70732,"_2865":120431},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3379":70756,"_29619":70732,"_20556":120433,"_5":14099,"_26939":120356,"_2865":120434},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3379":70757,"_29619":70732,"_20556":120436,"_5":14099,"_26939":120356,"_2865":120437},[],"En la práctica, permite:",{"_3379":70758,"_29619":70732,"_20556":120439,"_5":14099,"_26939":120356,"_2865":120440},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3379":70759,"_29619":70732,"_20556":120442,"_5":14099,"_26939":120356,"_2865":120443},[],"Importar claves creadas externamente.",{"_3379":70760,"_29619":70732,"_20556":120445,"_5":14099,"_26939":120356,"_2865":120446},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3379":70761,"_29619":70732,"_20556":120448,"_5":14099,"_26939":120356,"_2865":120449},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3379":70762,"_29619":70732,"_20556":120451,"_5":14099,"_26939":120360,"_2865":120452},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3379":70763,"_29619":70732,"_20556":120454,"_5":14099,"_26939":120360,"_2865":120455},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3379":70764,"_29619":70732,"_20556":120457,"_5":14099,"_26939":120360,"_2865":120458},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3379":70765,"_29619":70732,"_20556":120460,"_5":14099,"_26939":120364,"_2865":120461},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3379":70766,"_29619":70732,"_20556":120463,"_5":14099,"_26939":120367,"_2865":120464},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3379":70767,"_29619":70732,"_20556":120466,"_5":14099,"_26939":120367,"_2865":120467},[],"El adaptador se comunica con Vault a través de su endpoint HTTP(S) configurado. El certificado del servidor de Vault se verifica contra el almacén de confianza del sistema; para confiar en un Vault con certificado emitido por una CA privada, añade ese certificado de CA al `ca_cert_file` del motor (codificado en PEM). `insecure_skip_verify=true` desactiva la verificación y es un último recurso; acuerda los ajustes de transporte con el responsable de Despliegue.",{"_3379":70768,"_29619":70732,"_20556":120469,"_5":14099,"_26939":120370,"_2865":120470},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3379":70769,"_29619":70732,"_20556":120472,"_5":14099,"_26939":120373,"_2865":120473},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3379":70770,"_29619":70732,"_20556":120475,"_5":14099,"_26939":120376,"_2865":120476},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3379":70771,"_29619":70732,"_20556":120478,"_5":14099,"_26939":120379,"_2865":120479},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3379":70772,"_29619":70732,"_20556":120481,"_5":14099,"_26939":120379,"_2865":120482},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3379":70773,"_29619":70732,"_20556":120484,"_5":14099,"_26939":120379,"_2865":120485},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3379":70774,"_29619":70732,"_20556":120487,"_5":14099,"_26939":120379,"_2865":120488},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3379":70775,"_29619":70732,"_20556":120490,"_5":14099,"_26939":120382,"_2865":120491},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3379":70776,"_29619":70732,"_20556":120493,"_5":14099,"_26939":120382,"_2865":120494},[],"La tabla incluye los siguientes campos:",{"_3379":70777,"_29619":70732,"_20556":120496,"_5":14099,"_26939":120382,"_2865":120497},[],"**Name**: nombre descriptivo de la clave.",{"_3379":70778,"_29619":70732,"_20556":120499,"_5":14099,"_26939":120382,"_2865":120500},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3379":70779,"_29619":70732,"_20556":120502,"_5":14099,"_26939":120382,"_2865":120503},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3379":70780,"_29619":70732,"_20556":120505,"_5":14099,"_26939":120382,"_2865":120506},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3379":70781,"_29619":70732,"_20556":120508,"_5":14099,"_26939":120382,"_2865":120509},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3379":70782,"_29619":70732,"_20556":120511,"_5":14099,"_26939":120382,"_2865":120512},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3379":70783,"_29619":70732,"_20556":120514,"_5":14099,"_26939":120382,"_2865":120515},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3379":70784,"_29619":70732,"_20556":120517,"_5":14099,"_26939":120382,"_2865":120518},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3379":70785,"_29619":70732,"_20556":120520,"_5":14099,"_26939":120382,"_2865":120521},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3379":70786,"_29619":70732,"_20556":120523,"_5":14099,"_26939":120382,"_2865":120524},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3379":70787,"_29619":70732,"_20556":120526,"_5":14099,"_26939":120382,"_2865":120527},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3379":70788,"_29619":70732,"_20556":120529,"_5":14099,"_26939":120382,"_2865":120530},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3379":70789,"_29619":70732,"_20556":120532,"_5":14099,"_26939":120382,"_2865":120533},[],"**Delete Key** para eliminar la clave del sistema.",{"_3379":70790,"_29619":70732,"_20556":120535,"_5":14099,"_26939":120386,"_2865":120536},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3379":70791,"_29619":70732,"_20556":120538,"_5":14099,"_26939":120390,"_2865":120539},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3379":70792,"_29619":70732,"_20556":120541,"_5":14099,"_26939":120390,"_2865":120542},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3379":70793,"_29619":70732,"_20556":120544,"_5":14099,"_26939":120390,"_2865":120545},[],"**Key Name**: nombre único y descriptivo.",{"_3379":70794,"_29619":70732,"_20556":120547,"_5":14099,"_26939":120390,"_2865":120548},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3379":70795,"_29619":70732,"_20556":120550,"_5":14099,"_26939":120390,"_2865":120551},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3379":70796,"_29619":70732,"_20556":120553,"_5":14099,"_26939":120390,"_2865":120554},[],"**Tags**: metadatos para clasificar la clave.",{"_3379":70797,"_29619":70732,"_20556":120556,"_5":14099,"_26939":120390,"_2865":120557},[],"**Metadata**: información adicional para usos avanzados.",{"_3379":70798,"_29619":70732,"_20556":120559,"_5":14099,"_26939":120394,"_2865":120560},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3379":70799,"_29619":70732,"_20556":120562,"_5":14099,"_26939":120394,"_2865":120563},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3379":70800,"_29619":70732,"_20556":120565,"_5":14099,"_26939":120394,"_2865":120566},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3379":70801,"_29619":70732,"_20556":120568,"_5":14099,"_26939":120394,"_2865":120569},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3379":70802,"_29619":70732,"_20556":120571,"_5":14099,"_26939":120394,"_2865":120572},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3379":70803,"_29619":70732,"_20556":120574,"_5":14099,"_26939":120394,"_2865":120575},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3379":70804,"_29619":70732,"_20556":120577,"_5":14099,"_26939":120394,"_2865":120578},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3379":70805,"_29619":70732,"_20556":120580,"_5":14099,"_26939":120394,"_2865":120581},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3379":70806,"_29619":70732,"_20556":120583,"_5":14099,"_26939":120394,"_2865":120584},[],"**Metadata**: información adicional opcional.",{"_3379":70807,"_29619":70732,"_20556":120586,"_5":14099,"_26939":120394,"_2865":120587},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3379":70808,"_29619":70732,"_20556":120589,"_5":14099,"_26939":120394,"_2865":120590},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3379":70809,"_29619":70732,"_20556":120592,"_5":14099,"_26939":120398,"_2865":120593},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3379":70810,"_29619":70732,"_20556":120595,"_5":14099,"_26939":120402,"_2865":120596},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3379":70811,"_29619":70732,"_20556":120598,"_5":14099,"_26939":120402,"_2865":120599},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3379":70812,"_29619":70732,"_20556":120601,"_5":14099,"_26939":120402,"_2865":120602},[],"**Key Name**: nombre descriptivo.",{"_3379":70813,"_29619":70732,"_20556":120604,"_5":14099,"_26939":120402,"_2865":120605},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3379":70814,"_29619":70732,"_20556":120607,"_5":14099,"_26939":120402,"_2865":120608},[],"**Tags**: etiquetas asociadas.",{"_3379":70815,"_29619":70732,"_20556":120610,"_5":14099,"_26939":120402,"_2865":120611},[],"**Aliases**: nombres alternativos.",{"_3379":70816,"_29619":70732,"_20556":120613,"_5":14099,"_26939":120402,"_2865":120614},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3379":70817,"_29619":70732,"_20556":120616,"_5":14099,"_26939":120402,"_2865":120617},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3379":70818,"_29619":70732,"_20556":120619,"_5":14099,"_26939":120402,"_2865":120620},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3379":70819,"_29619":70732,"_20556":120622,"_5":14099,"_26939":120402,"_2865":120623},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3379":70820,"_29619":70732,"_20556":120625,"_5":14099,"_26939":120406,"_2865":120626},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3379":70821,"_29619":70732,"_20556":120628,"_5":14099,"_26939":120406,"_2865":120629},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3379":70822,"_29619":70732,"_20556":120631,"_5":14099,"_26939":120406,"_2865":120632},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3379":70823,"_29619":70732,"_20556":120634,"_5":14099,"_26939":120410,"_2865":120635},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3379":70824,"_29619":70732,"_20556":120637,"_5":14099,"_26939":120410,"_2865":120638},[],"Campos principales:",{"_3379":70825,"_29619":70732,"_20556":120640,"_5":14099,"_26939":120410,"_2865":120641},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3379":70826,"_29619":70732,"_20556":120643,"_5":14099,"_26939":120410,"_2865":120644},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3379":70827,"_29619":70732,"_20556":120646,"_5":14099,"_26939":120410,"_2865":120647},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3379":70828,"_29619":70732,"_20556":120649,"_5":14099,"_26939":120410,"_2865":120650},[],"**Message**: contenido que se va a firmar.",{"_3379":70829,"_29619":70732,"_20556":120652,"_5":14099,"_26939":120410,"_2865":120653},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3379":70830,"_29619":70732,"_20556":120655,"_5":14099,"_26939":120413,"_2865":120656},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3379":70831,"_29619":70732,"_20556":120658,"_5":14099,"_26939":120413,"_2865":120638},[],{"_3379":70832,"_29619":70732,"_20556":120660,"_5":14099,"_26939":120413,"_2865":120661},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3379":70833,"_29619":70732,"_20556":120663,"_5":14099,"_26939":120413,"_2865":120664},[],"**Message Type**: `Raw` o `Digest`.",{"_3379":70834,"_29619":70732,"_20556":120666,"_5":14099,"_26939":120413,"_2865":120667},[],"**Payload Encoding**: codificación del mensaje.",{"_3379":70835,"_29619":70732,"_20556":120669,"_5":14099,"_26939":120413,"_2865":120670},[],"**Message**: mensaje original o hash.",{"_3379":70836,"_29619":70732,"_20556":120672,"_5":14099,"_26939":120413,"_2865":120673},[],"**Signature**: firma que se desea comprobar.",{"_3379":70837,"_29619":70732,"_20556":120675,"_5":14099,"_26939":120413,"_2865":120676},[],"**Result**: indicador del resultado de la validación.",{"_3379":70838,"_29619":70732,"_20556":120678,"_5":14099,"_26939":120416,"_2865":120679},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3379":70839,"_29619":70732,"_20556":120681,"_5":14099,"_26939":120416,"_2865":120682},[],"Este flujo es útil para:",{"_3379":70840,"_29619":70732,"_20556":120684,"_5":14099,"_26939":120416,"_2865":120685},[],"Solicitar certificados a una CA externa.",{"_3379":70841,"_29619":70732,"_20556":120687,"_5":14099,"_26939":120416,"_2865":120688},[],"Renovar una identidad manteniendo la misma clave.",{"_3379":70842,"_29619":70732,"_20556":120690,"_5":14099,"_26939":120416,"_2865":120691},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3379":70843,"_29619":70732,"_20556":120693,"_5":14099,"_26939":120416,"_2865":120694},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3379":70844,"_29619":70732,"_20556":120696,"_5":14099,"_26939":120416,"_2865":120697},[],"**Organization (O)**: organización o empresa.",{"_3379":70845,"_29619":70732,"_20556":120699,"_5":14099,"_26939":120416,"_2865":120700},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3379":70846,"_29619":70732,"_20556":120702,"_5":14099,"_26939":120416,"_2865":120703},[],"**Country (C)**: código de país de dos letras.",{"_3379":70847,"_29619":70732,"_20556":120705,"_5":14099,"_26939":120416,"_2865":120706},[],"**State / Province (ST)**: estado o provincia.",{"_3379":70848,"_29619":70732,"_20556":120708,"_5":14099,"_26939":120416,"_2865":120709},[],"**Locality (L)**: ciudad o localidad.",{"_3379":70849,"_29619":70732,"_20556":120711,"_5":14099,"_26939":120416,"_2865":120712},[],"**Email Address**: correo de contacto.",{"_3379":70850,"_29619":70732,"_20556":120714,"_5":14099,"_26939":120416,"_2865":120715},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3379":70851,"_29619":70732,"_20556":120717,"_5":14099,"_26939":120416,"_2865":120718},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3379":70852,"_29619":70732,"_20556":120720,"_5":14099,"_26939":120420,"_2865":120721},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3379":70853,"_29619":70732,"_20556":120723,"_5":14099,"_26939":120420,"_2865":120724},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3379":70854,"_29619":70732,"_20556":120726,"_5":14099,"_26939":120424,"_2865":120727},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3379":70855,"_29619":70732,"_20556":120729,"_5":14099,"_26939":120424,"_2865":120730},[],"El KMS se niega a eliminar una clave que todavía está referenciada por certificados. Eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados, y después intenta eliminar la clave. Si otros certificados todavía la referencian, como los de otra CA que la comparte, el KMS la conserva. Revocar los certificados emitidos por la CA eliminada no libera sus propias referencias a claves. La guía de actualización describe las referencias heredadas que conserva la migración.",{"_3379":70856,"_29619":70856,"_5":14457,"_2865":120732,"_29972":120733,"_20556":120734,"_26939":70856},"Validación online con OCSP",[48223,115062,53693,119568],[],{"_3379":70857,"_29619":70856,"_20556":120736,"_5":14099,"_26939":70856,"_2865":120737},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3379":70858,"_29619":70856,"_5":29969,"_20556":120739,"_26939":120740,"_2865":120741},[],"/docs/pr-preview/pr-53/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3379":70859,"_29619":70856,"_5":29969,"_20556":120743,"_26939":120744,"_2865":120745},[],"/docs/pr-preview/pr-53/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3379":70860,"_29619":70856,"_5":29969,"_20556":120747,"_26939":120748,"_2865":120749},[],"/docs/pr-preview/pr-53/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3379":70861,"_29619":70856,"_5":29969,"_20556":120751,"_26939":120752,"_2865":120753},[],"/docs/pr-preview/pr-53/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3379":70862,"_29619":70856,"_5":29969,"_20556":120755,"_26939":120756,"_2865":120757},[],"/docs/pr-preview/pr-53/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3379":70863,"_29619":70856,"_5":29969,"_20556":120759,"_26939":120760,"_2865":120135},[],"/docs/pr-preview/pr-53/es/platform/pki/ocsp#referencias",{"_3379":70864,"_29619":70856,"_20556":120762,"_5":14099,"_26939":70856,"_2865":120763},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3379":70865,"_29619":70856,"_20556":120765,"_5":14099,"_26939":120740,"_2865":120766},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3379":70866,"_29619":70856,"_20556":120768,"_5":14099,"_26939":120740,"_2865":120769},[],"Estado del registro",{"_3379":70867,"_29619":70856,"_20556":120771,"_5":14099,"_26939":120740,"_2865":120772},[],"Respuesta firmada",{"_3379":70868,"_29619":70856,"_20556":120774,"_5":14099,"_26939":120740,"_2865":52830},[],{"_3379":70869,"_29619":70856,"_20556":120776,"_5":14099,"_26939":120740,"_2865":55555},[],{"_3379":70870,"_29619":70856,"_20556":120778,"_5":14099,"_26939":120740,"_2865":52847},[],{"_3379":70871,"_29619":70856,"_20556":120780,"_5":14099,"_26939":120740,"_2865":120781},[],"`Revoked`, con razón y fecha de revocación.",{"_3379":70872,"_29619":70856,"_20556":120783,"_5":14099,"_26939":120740,"_2865":120784},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3379":70873,"_29619":70856,"_20556":120786,"_5":14099,"_26939":120740,"_2865":120787},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3379":70874,"_29619":70856,"_20556":120789,"_5":14099,"_26939":120740,"_2865":120790},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3379":70875,"_29619":70856,"_20556":120792,"_5":14099,"_26939":120740,"_2865":120793},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3379":70876,"_29619":70856,"_20556":120795,"_5":14099,"_26939":120740,"_2865":120796},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3379":70877,"_29619":70856,"_20556":120798,"_5":14099,"_26939":120744,"_2865":120799},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3379":70878,"_29619":70856,"_20556":120801,"_5":14099,"_26939":120744,"_2865":120802},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3379":70879,"_29619":70856,"_20556":120804,"_5":14099,"_26939":120748,"_2865":120805},[],"El servicio acepta:",{"_3379":70880,"_29619":70856,"_20556":120807,"_5":14099,"_26939":120748,"_2865":116789},[],{"_3379":70881,"_29619":70856,"_20556":120809,"_5":14099,"_26939":120748,"_2865":120810},[],"Ruta del servicio VA",{"_3379":70882,"_29619":70856,"_20556":120812,"_5":14099,"_26939":120748,"_2865":120813},[],"Formato",{"_3379":70883,"_29619":70856,"_20556":120815,"_5":14099,"_26939":120748,"_2865":55595},[],{"_3379":70884,"_29619":70856,"_20556":120817,"_5":14099,"_26939":120748,"_2865":55598},[],{"_3379":70885,"_29619":70856,"_20556":120819,"_5":14099,"_26939":120748,"_2865":120820},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3379":70886,"_29619":70856,"_20556":120822,"_5":14099,"_26939":120748,"_2865":55024},[],{"_3379":70887,"_29619":70856,"_20556":120824,"_5":14099,"_26939":120748,"_2865":55606},[],{"_3379":70888,"_29619":70856,"_20556":120826,"_5":14099,"_26939":120748,"_2865":120827},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3379":70889,"_29619":70856,"_20556":120829,"_5":14099,"_26939":120748,"_2865":120830},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3379":70890,"_29619":70856,"_20556":120832,"_5":14099,"_26939":120752,"_2865":120833},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3379":70891,"_29619":70856,"_20556":120835,"_5":14099,"_26939":120752,"_2865":120836},[],"Genera la solicitud:",{"_3379":70892,"_29619":70856,"_20556":120838,"_5":14099,"_26939":120752,"_2865":120839},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3379":70893,"_29619":70856,"_20556":120841,"_5":14099,"_26939":120752,"_2865":120842},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3379":70894,"_29619":70856,"_20556":120844,"_5":14099,"_26939":120752,"_2865":120845},[],"Verifica el DER recibido:",{"_3379":70895,"_29619":70856,"_20556":120847,"_5":14099,"_26939":120752,"_2865":120848},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3379":70896,"_29619":70856,"_20556":120850,"_5":14099,"_26939":120756,"_2865":120851},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3379":70897,"_29619":70856,"_20556":120853,"_5":14099,"_26939":120756,"_2865":120854},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3379":70898,"_29619":70856,"_20556":120856,"_5":14099,"_26939":120760,"_2865":55639},[],{"_3379":70899,"_29619":70856,"_20556":120858,"_5":14099,"_26939":120760,"_2865":55642},[],{"_3379":70900,"_29619":70856,"_20556":120860,"_5":14099,"_26939":120760,"_2865":120861},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3379":70901,"_29619":70856,"_20556":120863,"_5":14099,"_26939":120760,"_2865":120346},[],{"_3379":70902,"_29619":70902,"_5":14457,"_2865":53693,"_29972":120865,"_20556":120866,"_26939":70902},[48223,115062,53693],[],{"_3379":70903,"_29619":70902,"_20556":120868,"_5":14099,"_26939":70902,"_2865":120869},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3379":70904,"_29619":70902,"_5":29969,"_20556":120871,"_26939":120872,"_2865":118263},[],"/docs/pr-preview/pr-53/es/platform/pki/overview#empieza-aquí",{"_3379":70905,"_29619":70902,"_5":29969,"_20556":120874,"_26939":120875,"_2865":120876},[],"/docs/pr-preview/pr-53/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3379":70906,"_29619":70902,"_5":29969,"_20556":120878,"_26939":120879,"_2865":118783},[],"/docs/pr-preview/pr-53/es/platform/pki/overview#capacidades-principales",{"_3379":70907,"_29619":70902,"_5":29969,"_20556":120881,"_26939":120882,"_2865":118787},[],"/docs/pr-preview/pr-53/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3379":70908,"_29619":70902,"_5":29969,"_20556":120884,"_26939":120885,"_2865":118791},[],"/docs/pr-preview/pr-53/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3379":70909,"_29619":70902,"_5":29969,"_20556":120887,"_26939":120888,"_2865":118795},[],"/docs/pr-preview/pr-53/es/platform/pki/overview#emite-y-controla-certificados",{"_3379":70910,"_29619":70902,"_5":29969,"_20556":120890,"_26939":120891,"_2865":118803},[],"/docs/pr-preview/pr-53/es/platform/pki/overview#publica-el-estado-de-validación",{"_3379":70911,"_29619":70902,"_5":29969,"_20556":120893,"_26939":120894,"_2865":120895},[],"/docs/pr-preview/pr-53/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3379":70912,"_29619":70902,"_5":29969,"_20556":120897,"_26939":120898,"_2865":119734},[],"/docs/pr-preview/pr-53/es/platform/pki/overview#continúa",{"_3379":70913,"_29619":70902,"_20556":120900,"_5":14099,"_26939":70902,"_2865":120901},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3379":70914,"_29619":70902,"_20556":120903,"_5":14099,"_26939":120872,"_2865":120904},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3379":70915,"_29619":70902,"_20556":120906,"_5":14099,"_26939":120872,"_2865":120907},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3379":70916,"_29619":70902,"_20556":120909,"_5":14099,"_26939":120875,"_2865":120910},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3379":70917,"_29619":70902,"_20556":120912,"_5":14099,"_26939":120875,"_2865":120913},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3379":70918,"_29619":70902,"_20556":120915,"_5":14099,"_26939":120875,"_2865":120916},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3379":70919,"_29619":70902,"_20556":120918,"_5":14099,"_26939":120875,"_2865":120919},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3379":70920,"_29619":70902,"_20556":120921,"_5":14099,"_26939":120875,"_2865":120922},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3379":70921,"_29619":70902,"_20556":120924,"_5":14099,"_26939":120882,"_2865":120925},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3379":70922,"_29619":70902,"_20556":120927,"_5":14099,"_26939":120885,"_2865":120928},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3379":70923,"_29619":70902,"_20556":120930,"_5":14099,"_26939":120888,"_2865":120931},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3379":70924,"_29619":70902,"_20556":120933,"_5":14099,"_26939":120891,"_2865":120934},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3379":70925,"_29619":70902,"_20556":120936,"_5":14099,"_26939":120894,"_2865":120937},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3379":70926,"_29619":70902,"_20556":120939,"_5":14099,"_26939":120894,"_2865":120940},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3379":70927,"_29619":70902,"_20556":120942,"_5":14099,"_26939":120894,"_2865":120943},[],"su clave pública corresponda a la clave privada del cliente;",{"_3379":70928,"_29619":70902,"_20556":120945,"_5":14099,"_26939":120894,"_2865":120946},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3379":70929,"_29619":70902,"_20556":120948,"_5":14099,"_26939":120894,"_2865":120949},[],"sus fechas y usos permitan la operación;",{"_3379":70930,"_29619":70902,"_20556":120951,"_5":14099,"_26939":120894,"_2865":120952},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3379":70931,"_29619":70902,"_20556":120954,"_5":14099,"_26939":120894,"_2865":120955},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3379":70932,"_29619":70902,"_20556":120957,"_5":14099,"_26939":120898,"_2865":120958},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3379":70933,"_29619":70902,"_20556":120960,"_5":14099,"_26939":120898,"_2865":120961},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3379":70934,"_29619":70902,"_20556":120963,"_5":14099,"_26939":120898,"_2865":120964},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3379":70935,"_29619":70935,"_5":14457,"_2865":120966,"_29972":120967,"_20556":120968,"_26939":70935},"Crea tu primera CA",[48223,115062,53693,118387],[],{"_3379":70936,"_29619":70935,"_20556":120970,"_5":14099,"_26939":70935,"_2865":120971},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3379":70937,"_29619":70935,"_5":29969,"_20556":120973,"_26939":120974,"_2865":113640},[],"/docs/pr-preview/pr-53/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3379":70938,"_29619":70935,"_5":29969,"_20556":120976,"_26939":120977,"_2865":120978},[],"/docs/pr-preview/pr-53/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación-toc","Abre el asistente de creación [!toc]",{"_3379":70939,"_29619":70935,"_5":29969,"_20556":120980,"_26939":120981,"_2865":120982},[],"/docs/pr-preview/pr-53/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave-toc","Selecciona la clave [!toc]",{"_3379":70940,"_29619":70935,"_5":29969,"_20556":120984,"_26939":120985,"_2865":120986},[],"/docs/pr-preview/pr-53/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad-toc","Define la autoridad [!toc]",{"_3379":70941,"_29619":70935,"_5":29969,"_20556":120988,"_26939":120989,"_2865":120990},[],"/docs/pr-preview/pr-53/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca-toc","Revisa y crea la CA [!toc]",{"_3379":70942,"_29619":70935,"_5":29969,"_20556":120992,"_26939":120993,"_2865":120994},[],"/docs/pr-preview/pr-53/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado-toc","Verifica el resultado [!toc]",{"_3379":70943,"_29619":70935,"_5":29969,"_20556":120996,"_26939":120997,"_2865":120998},[],"/docs/pr-preview/pr-53/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3379":70944,"_29619":70935,"_5":29969,"_20556":121000,"_26939":121001,"_2865":118634},[],"/docs/pr-preview/pr-53/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3379":70945,"_29619":70935,"_5":29969,"_20556":121003,"_26939":121004,"_2865":113664},[],"/docs/pr-preview/pr-53/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3379":70946,"_29619":70935,"_20556":121006,"_5":14099,"_26939":70935,"_2865":121007},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3379":70947,"_29619":70935,"_20556":121009,"_5":14099,"_26939":120974,"_2865":121010},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3379":70948,"_29619":70935,"_20556":121012,"_5":14099,"_26939":120974,"_2865":121013},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3379":70949,"_29619":70935,"_20556":121015,"_5":14099,"_26939":120974,"_2865":121016},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3379":70950,"_29619":70935,"_20556":121018,"_5":14099,"_26939":120974,"_2865":121019},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3379":70951,"_29619":70935,"_20556":121021,"_5":14099,"_26939":120977,"_2865":121022},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_3379":70952,"_29619":70935,"_20556":121024,"_5":14099,"_26939":120977,"_2865":121025},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_3379":70953,"_29619":70935,"_20556":121027,"_5":14099,"_26939":120981,"_2865":121028},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_3379":70954,"_29619":70935,"_20556":121030,"_5":14099,"_26939":120981,"_2865":121031},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_3379":70955,"_29619":70935,"_20556":121033,"_5":14099,"_26939":120985,"_2865":121034},[],"Selecciona **Root CA** y completa:",{"_3379":70956,"_29619":70935,"_20556":121036,"_5":14099,"_26939":120985,"_2865":55821},[],{"_3379":70957,"_29619":70935,"_20556":121038,"_5":14099,"_26939":120985,"_2865":121039},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_3379":70958,"_29619":70935,"_20556":121041,"_5":14099,"_26939":120985,"_2865":121042},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_3379":70959,"_29619":70935,"_20556":121044,"_5":14099,"_26939":120985,"_2865":121045},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_3379":70960,"_29619":70935,"_20556":121047,"_5":14099,"_26939":120985,"_2865":121048},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_3379":70961,"_29619":70935,"_20556":121050,"_5":14099,"_26939":120989,"_2865":121051},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_3379":70962,"_29619":70935,"_20556":121053,"_5":14099,"_26939":120993,"_2865":121054},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_3379":70963,"_29619":70935,"_20556":121056,"_5":14099,"_26939":120993,"_2865":121057},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_3379":70964,"_29619":70935,"_20556":121059,"_5":14099,"_26939":120997,"_2865":121060},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3379":70965,"_29619":70935,"_20556":121062,"_5":14099,"_26939":120997,"_2865":121063},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3379":70966,"_29619":70935,"_20556":121065,"_5":14099,"_26939":120997,"_2865":121066},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3379":70967,"_29619":70935,"_20556":121068,"_5":14099,"_26939":121001,"_2865":121069},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3379":70968,"_29619":70935,"_20556":121071,"_5":14099,"_26939":121001,"_2865":121072},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3379":70969,"_29619":70935,"_20556":121074,"_5":14099,"_26939":121001,"_2865":121075},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3379":70970,"_29619":70935,"_20556":121077,"_5":14099,"_26939":121001,"_2865":121078},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3379":70971,"_29619":70935,"_20556":121080,"_5":14099,"_26939":121004,"_2865":121081},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3379":70972,"_29619":70972,"_5":14457,"_2865":121083,"_29972":121084,"_20556":121085,"_26939":70972},"Emite y verifica un certificado",[48223,115062,53693,118387],[],{"_3379":70973,"_29619":70972,"_20556":121087,"_5":14099,"_26939":70972,"_2865":121088},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3379":70974,"_29619":70972,"_5":29969,"_20556":121090,"_26939":121091,"_2865":113640},[],"/docs/pr-preview/pr-53/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3379":70975,"_29619":70972,"_5":29969,"_20556":121093,"_26939":121094,"_2865":121095},[],"/docs/pr-preview/pr-53/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3379":70976,"_29619":70972,"_5":29969,"_20556":121097,"_26939":121098,"_2865":121099},[],"/docs/pr-preview/pr-53/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3379":70977,"_29619":70972,"_5":29969,"_20556":121101,"_26939":121102,"_2865":121103},[],"/docs/pr-preview/pr-53/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3379":70978,"_29619":70972,"_5":29969,"_20556":121105,"_26939":121106,"_2865":121107},[],"/docs/pr-preview/pr-53/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3379":70979,"_29619":70972,"_5":29969,"_20556":121109,"_26939":121110,"_2865":121111},[],"/docs/pr-preview/pr-53/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3379":70980,"_29619":70972,"_5":29969,"_20556":121113,"_26939":121114,"_2865":121115},[],"/docs/pr-preview/pr-53/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado","Verifica el resultado",{"_3379":70981,"_29619":70972,"_5":29969,"_20556":121117,"_26939":121118,"_2865":121119},[],"/docs/pr-preview/pr-53/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3379":70982,"_29619":70972,"_5":29969,"_20556":121121,"_26939":121122,"_2865":121123},[],"/docs/pr-preview/pr-53/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3379":70983,"_29619":70972,"_5":29969,"_20556":121125,"_26939":121126,"_2865":121127},[],"/docs/pr-preview/pr-53/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3379":70984,"_29619":70972,"_5":29969,"_20556":121129,"_26939":121130,"_2865":118634},[],"/docs/pr-preview/pr-53/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3379":70985,"_29619":70972,"_5":29969,"_20556":121132,"_26939":121133,"_2865":113664},[],"/docs/pr-preview/pr-53/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3379":70986,"_29619":70972,"_20556":121135,"_5":14099,"_26939":70972,"_2865":121136},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3379":70987,"_29619":70972,"_20556":121138,"_5":14099,"_26939":121091,"_2865":121139},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3379":70988,"_29619":70972,"_20556":121141,"_5":14099,"_26939":121091,"_2865":121142},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3379":70989,"_29619":70972,"_20556":121144,"_5":14099,"_26939":121091,"_2865":121145},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3379":70990,"_29619":70972,"_20556":121147,"_5":14099,"_26939":121091,"_2865":121148},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3379":70991,"_29619":70972,"_20556":121150,"_5":14099,"_26939":121091,"_2865":121151},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3379":70992,"_29619":70972,"_20556":121153,"_5":14099,"_26939":121094,"_2865":121154},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3379":70993,"_29619":70972,"_20556":121156,"_5":14099,"_26939":121098,"_2865":121157},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3379":70994,"_29619":70972,"_20556":121159,"_5":14099,"_26939":121098,"_2865":121160},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3379":70995,"_29619":70972,"_20556":121162,"_5":14099,"_26939":121102,"_2865":121163},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3379":70996,"_29619":70972,"_20556":121165,"_5":14099,"_26939":121102,"_2865":121166},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3379":70997,"_29619":70972,"_20556":121168,"_5":14099,"_26939":121106,"_2865":121169},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3379":70998,"_29619":70972,"_20556":121171,"_5":14099,"_26939":121106,"_2865":121172},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3379":70999,"_29619":70972,"_20556":121174,"_5":14099,"_26939":121110,"_2865":121175},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3379":71000,"_29619":70972,"_20556":121177,"_5":14099,"_26939":121114,"_2865":121178},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3379":71001,"_29619":70972,"_20556":121180,"_5":14099,"_26939":121118,"_2865":121181},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3379":71002,"_29619":70972,"_20556":121183,"_5":14099,"_26939":121122,"_2865":121184},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3379":71003,"_29619":70972,"_20556":121186,"_5":14099,"_26939":121122,"_2865":121187},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3379":71004,"_29619":70972,"_20556":121189,"_5":14099,"_26939":121122,"_2865":121190},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3379":71005,"_29619":70972,"_20556":121192,"_5":14099,"_26939":121126,"_2865":121193},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3379":71006,"_29619":70972,"_20556":121195,"_5":14099,"_26939":121126,"_2865":121196},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3379":71007,"_29619":70972,"_20556":121198,"_5":14099,"_26939":121126,"_2865":121199},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3379":71008,"_29619":70972,"_20556":121201,"_5":14099,"_26939":121130,"_2865":118717},[],{"_3379":71009,"_29619":70972,"_20556":121203,"_5":14099,"_26939":121130,"_2865":117238},[],{"_3379":71010,"_29619":70972,"_20556":121205,"_5":14099,"_26939":121130,"_2865":121206},[],"La CA rechaza la emisión",{"_3379":71011,"_29619":70972,"_20556":121208,"_5":14099,"_26939":121130,"_2865":121209},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3379":71012,"_29619":70972,"_20556":121211,"_5":14099,"_26939":121130,"_2865":121212},[],"Sujeto o usos diferentes",{"_3379":71013,"_29619":70972,"_20556":121214,"_5":14099,"_26939":121130,"_2865":121215},[],"Perfil aplicado y valores solicitados.",{"_3379":71014,"_29619":70972,"_20556":121217,"_5":14099,"_26939":121130,"_2865":121218},[],"No se encuentra el emisor",{"_3379":71015,"_29619":70972,"_20556":121220,"_5":14099,"_26939":121130,"_2865":121221},[],"CA descargada y cadena intermedia necesaria.",{"_3379":71016,"_29619":70972,"_20556":121223,"_5":14099,"_26939":121130,"_2865":121224},[],"Falla la vigencia",{"_3379":71017,"_29619":70972,"_20556":121226,"_5":14099,"_26939":121130,"_2865":121227},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3379":71018,"_29619":70972,"_20556":121229,"_5":14099,"_26939":121130,"_2865":121230},[],"Los resúmenes de clave difieren",{"_3379":71019,"_29619":70972,"_20556":121232,"_5":14099,"_26939":121130,"_2865":121233},[],"Archivos de certificado y clave de la misma emisión.",{"_3379":71020,"_29619":70972,"_20556":121235,"_5":14099,"_26939":121130,"_2865":121236},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3379":71021,"_29619":70972,"_20556":121238,"_5":14099,"_26939":121133,"_2865":121239},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3379":71022,"_29619":70972,"_20556":121241,"_5":14099,"_26939":121133,"_2865":121242},[],"Gestionar certificados para inspección, estado y revocación.",{"_3379":71023,"_29619":70972,"_20556":121244,"_5":14099,"_26939":121133,"_2865":121245},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3379":71024,"_29619":70972,"_20556":121247,"_5":14099,"_26939":121133,"_2865":121248},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3379":71025,"_29619":70972,"_20556":121250,"_5":14099,"_26939":121133,"_2865":121251},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3379":71026,"_29619":71026,"_5":14457,"_2865":121253,"_29972":121254,"_20556":121255,"_26939":71026},"Primeros pasos de PKI",[48223,115062,53693,118387],[],{"_3379":71027,"_29619":71026,"_20556":121257,"_5":14099,"_26939":71026,"_2865":121258},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3379":71028,"_29619":71026,"_5":29969,"_20556":121260,"_26939":121261,"_2865":113640},[],"/docs/pr-preview/pr-53/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3379":71029,"_29619":71026,"_5":29969,"_20556":121263,"_26939":121264,"_2865":121265},[],"/docs/pr-preview/pr-53/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3379":71030,"_29619":71026,"_5":29969,"_20556":121267,"_26939":121268,"_2865":118569},[],"/docs/pr-preview/pr-53/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3379":71031,"_29619":71026,"_5":29969,"_20556":121270,"_26939":121271,"_2865":121272},[],"/docs/pr-preview/pr-53/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3379":71032,"_29619":71026,"_20556":121274,"_5":14099,"_26939":71026,"_2865":121275},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3379":71033,"_29619":71026,"_20556":121277,"_5":14099,"_26939":121261,"_2865":121278},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3379":71034,"_29619":71026,"_20556":121280,"_5":14099,"_26939":121261,"_2865":121281},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3379":71035,"_29619":71026,"_20556":121283,"_5":14099,"_26939":121261,"_2865":121284},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3379":71036,"_29619":71026,"_20556":121286,"_5":14099,"_26939":121261,"_2865":121287},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3379":71037,"_29619":71026,"_20556":121289,"_5":14099,"_26939":121261,"_2865":121290},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3379":71038,"_29619":71026,"_20556":121292,"_5":14099,"_26939":121264,"_2865":121293},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3379":71039,"_29619":71026,"_20556":121295,"_5":14099,"_26939":121264,"_2865":121296},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3379":71040,"_29619":71026,"_20556":121298,"_5":14099,"_26939":121264,"_2865":121299},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3379":71041,"_29619":71026,"_20556":121301,"_5":14099,"_26939":121264,"_2865":121302},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3379":71042,"_29619":71026,"_20556":121304,"_5":14099,"_26939":121268,"_2865":121305},[],"Archivo o recurso",{"_3379":71043,"_29619":71026,"_20556":121307,"_5":14099,"_26939":121268,"_2865":118566},[],{"_3379":71044,"_29619":71026,"_20556":121309,"_5":14099,"_26939":121268,"_2865":121310},[],"CA raíz activa y `ca.pem`",{"_3379":71045,"_29619":71026,"_20556":121312,"_5":14099,"_26939":121268,"_2865":121313},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3379":71046,"_29619":71026,"_20556":121315,"_5":14099,"_26939":121268,"_2865":121316},[],"Certificado final y `device.crt`",{"_3379":71047,"_29619":71026,"_20556":121318,"_5":14099,"_26939":121268,"_2865":121319},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3379":71048,"_29619":71026,"_20556":121321,"_5":14099,"_26939":121268,"_2865":121322},[],"Clave privada `device.key`",{"_3379":71049,"_29619":71026,"_20556":121324,"_5":14099,"_26939":121268,"_2865":121325},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3379":71050,"_29619":71026,"_20556":121327,"_5":14099,"_26939":121268,"_2865":121328},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3379":71051,"_29619":71026,"_20556":121330,"_5":14099,"_26939":121271,"_2865":121331},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3379":71052,"_29619":71026,"_20556":121333,"_5":14099,"_26939":121271,"_2865":121334},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3379":71053,"_29619":71026,"_20556":121336,"_5":14099,"_26939":121271,"_2865":121337},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3379":71054,"_29619":71054,"_5":14457,"_2865":121339,"_29972":121340,"_20556":121342,"_26939":71054},"Resolución de problemas PKI",[48223,115062,53693,121341],"Resolución de problemas",[],{"_3379":71055,"_29619":71054,"_20556":121344,"_5":14099,"_26939":71054,"_2865":121345},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3379":71056,"_29619":71054,"_5":29969,"_20556":121347,"_26939":121348,"_2865":121349},[],"/docs/pr-preview/pr-53/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3379":71057,"_29619":71054,"_5":29969,"_20556":121351,"_26939":121352,"_2865":121353},[],"/docs/pr-preview/pr-53/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3379":71058,"_29619":71054,"_5":29969,"_20556":121355,"_26939":121356,"_2865":121357},[],"/docs/pr-preview/pr-53/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3379":71059,"_29619":71054,"_20556":121359,"_5":14099,"_26939":71054,"_2865":121360},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3379":71060,"_29619":71054,"_20556":121362,"_5":14099,"_26939":71054,"_2865":121363},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3379":71061,"_29619":71054,"_20556":121365,"_5":14099,"_26939":121348,"_2865":118566},[],{"_3379":71062,"_29619":71054,"_20556":121367,"_5":14099,"_26939":121348,"_2865":117238},[],{"_3379":71063,"_29619":71054,"_20556":121369,"_5":14099,"_26939":121348,"_2865":113664},[],{"_3379":71064,"_29619":71054,"_20556":121371,"_5":14099,"_26939":121348,"_2865":52535},[],{"_3379":71065,"_29619":71054,"_20556":121373,"_5":14099,"_26939":121348,"_2865":121374},[],"Existe, está activa y sus fechas son utilizables.",{"_3379":71066,"_29619":71054,"_20556":121376,"_5":14099,"_26939":121348,"_2865":121377},[],"Autoridades.",{"_3379":71067,"_29619":71054,"_20556":121379,"_5":14099,"_26939":121348,"_2865":121380},[],"Clave",{"_3379":71068,"_29619":71054,"_20556":121382,"_5":14099,"_26939":121348,"_2865":121383},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3379":71069,"_29619":71054,"_20556":121385,"_5":14099,"_26939":121348,"_2865":121386},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3379":71070,"_29619":71054,"_20556":121388,"_5":14099,"_26939":121348,"_2865":56175},[],{"_3379":71071,"_29619":71054,"_20556":121390,"_5":14099,"_26939":121348,"_2865":121391},[],"PEM correcto y firma verificable.",{"_3379":71072,"_29619":71054,"_20556":121393,"_5":14099,"_26939":121348,"_2865":56181},[],{"_3379":71073,"_29619":71054,"_20556":121395,"_5":14099,"_26939":121348,"_2865":121396},[],"Perfil",{"_3379":71074,"_29619":71054,"_20556":121398,"_5":14099,"_26939":121348,"_2865":121399},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3379":71075,"_29619":71054,"_20556":121401,"_5":14099,"_26939":121348,"_2865":121402},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3379":71076,"_29619":71054,"_20556":121404,"_5":14099,"_26939":121348,"_2865":118717},[],{"_3379":71077,"_29619":71054,"_20556":121406,"_5":14099,"_26939":121348,"_2865":121407},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3379":71078,"_29619":71054,"_20556":121409,"_5":14099,"_26939":121348,"_2865":121410},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3379":71079,"_29619":71054,"_20556":121412,"_5":14099,"_26939":121348,"_2865":121413},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3379":71080,"_29619":71054,"_20556":121415,"_5":14099,"_26939":121348,"_2865":121416},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3379":71081,"_29619":71054,"_20556":121418,"_5":14099,"_26939":121352,"_2865":121419},[],"Revisa cada frontera por separado:",{"_3379":71082,"_29619":71054,"_20556":121421,"_5":14099,"_26939":121352,"_2865":121422},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3379":71083,"_29619":71054,"_20556":121424,"_5":14099,"_26939":121352,"_2865":121425},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3379":71084,"_29619":71054,"_20556":121427,"_5":14099,"_26939":121352,"_2865":121428},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3379":71085,"_29619":71054,"_20556":121430,"_5":14099,"_26939":121352,"_2865":121431},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3379":71086,"_29619":71054,"_20556":121433,"_5":14099,"_26939":121352,"_2865":121434},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3379":71087,"_29619":71054,"_20556":121436,"_5":14099,"_26939":121352,"_2865":121437},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_3379":71088,"_29619":71054,"_20556":121439,"_5":14099,"_26939":121356,"_2865":121440},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3379":71089,"_29619":71054,"_20556":121442,"_5":14099,"_26939":121356,"_2865":121443},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3379":71090,"_29619":71090,"_5":14457,"_2865":121445,"_29972":121446,"_20556":121447,"_26939":71090},"Seguridad",[48223],[],{"_3379":71091,"_29619":71090,"_20556":121449,"_5":14099,"_26939":71090,"_2865":121450},[],"Cómo reportar de forma privada una vulnerabilidad de seguridad en Lamassu, qué incluir en el reporte y qué releases reciben correcciones de seguridad.",{"_3379":71092,"_29619":71090,"_5":29969,"_20556":121452,"_26939":121453,"_2865":121454},[],"/docs/pr-preview/pr-53/es/security#cómo-reportar-una-vulnerabilidad","Cómo reportar una vulnerabilidad",{"_3379":71093,"_29619":71090,"_5":29969,"_20556":121456,"_26939":121457,"_2865":121458},[],"/docs/pr-preview/pr-53/es/security#qué-incluir-en-un-reporte","Qué incluir en un reporte",{"_3379":71094,"_29619":71090,"_5":29969,"_20556":121460,"_26939":121461,"_2865":121462},[],"/docs/pr-preview/pr-53/es/security#versiones-soportadas","Versiones soportadas",{"_3379":71095,"_29619":71090,"_5":29969,"_20556":121464,"_26939":121465,"_2865":121466},[],"/docs/pr-preview/pr-53/es/security#divulgación-responsable","Divulgación responsable",{"_3379":71096,"_29619":71090,"_20556":121468,"_5":14099,"_26939":71090,"_2865":121469},[],"¿Has encontrado una vulnerabilidad de seguridad en lamassuiot, lamassu-dashboard o lamassu-helm? Esta página explica cómo reportarla de forma privada, qué incluir en tu reporte y qué releases reciben correcciones de seguridad.",{"_3379":71097,"_29619":71090,"_20556":121471,"_5":14099,"_26939":121453,"_2865":121472},[],"No reportes vulnerabilidades de seguridad mediante issues, discusiones o pull requests públicos de GitHub. Un reporte público divulga el problema antes de que los mantenedores puedan corregirlo.",{"_3379":71098,"_29619":71090,"_20556":121474,"_5":14099,"_26939":121453,"_2865":121475},[],"En su lugar, reporta de forma privada mediante GitHub Security Advisories para el repositorio afectado:",{"_3379":71099,"_29619":71090,"_20556":121477,"_5":14099,"_26939":121453,"_2865":14724},[],{"_3379":71100,"_29619":71090,"_20556":121479,"_5":14099,"_26939":121453,"_2865":14670},[],{"_3379":71101,"_29619":71090,"_20556":121481,"_5":14099,"_26939":121453,"_2865":14717},[],{"_3379":71102,"_29619":71090,"_20556":121483,"_5":14099,"_26939":121453,"_2865":121484},[],"Así los mantenedores pueden evaluar y resolver el problema antes de que se publique.",{"_3379":71103,"_29619":71090,"_20556":121486,"_5":14099,"_26939":121453,"_2865":121487},[],"Si el reporte privado de vulnerabilidades no está habilitado en ese repositorio, reporta la vulnerabilidad de forma privada a lamassuiot\\@lksnext.com antes de divulgar cualquier detalle públicamente.",{"_3379":71104,"_29619":71090,"_20556":121489,"_5":14099,"_26939":121457,"_2865":121490},[],"Describe la vulnerabilidad, su impacto potencial y los pasos para reproducirla usando ejemplos no sensibles y anonimizados.",{"_3379":71105,"_29619":71090,"_20556":121492,"_5":14099,"_26939":121457,"_2865":121493},[],"No incluyas en el reporte:",{"_3379":71106,"_29619":71090,"_20556":121495,"_5":14099,"_26939":121457,"_2865":121496},[],"Credenciales, tokens o claves privadas",{"_3379":71107,"_29619":71090,"_20556":121498,"_5":14099,"_26939":121457,"_2865":121499},[],"Datos de clientes o información identificable de clientes",{"_3379":71108,"_29619":71090,"_20556":121501,"_5":14099,"_26939":121457,"_2865":121502},[],"Detalles confidenciales de arquitectura o de infraestructura interna",{"_3379":71109,"_29619":71090,"_20556":121504,"_5":14099,"_26939":121461,"_2865":121505},[],"Solo el último release estable recibe soporte de seguridad. El soporte de un release estable termina cuando se publica el siguiente release estable. Los releases anteriores y los pre-releases no tienen soporte.",{"_3379":71110,"_29619":71090,"_20556":121507,"_5":14099,"_26939":121461,"_2865":121508},[],"Para saber cómo actualizar, consulta Actualizaciones.",{"_3379":71111,"_29619":71090,"_20556":121510,"_5":14099,"_26939":121465,"_2865":121511},[],"Da a los mantenedores un tiempo razonable para investigar y resolver la vulnerabilidad reportada antes de cualquier divulgación pública.",{"_3379":71112,"_29619":71090,"_20556":121513,"_5":14099,"_26939":121465,"_2865":121514},[],"Evita violaciones de privacidad, destrucción de datos e interrupciones de servicio mientras investigas la vulnerabilidad.",{"_3379":71113,"_29619":71090,"_20556":121516,"_5":14099,"_26939":121465,"_2865":121517},[],"Interactúa solo con cuentas o datos que sean tuyos o sobre los que tengas permiso explícito.",{"_3379":71114,"_29619":71090,"_20556":121519,"_5":14099,"_26939":121465,"_2865":121520},[],"Los mantenedores reconocen los reportes en un tiempo razonable y te mantienen informado del progreso de la remediación.",{"_3379":71115,"_29619":71090,"_20556":121522,"_5":14099,"_26939":121465,"_2865":121523},[],"Esta política cubre el código fuente, la configuración y los flujos de CI/CD de los repositorios lamassuiot, lamassu-dashboard y lamassu-helm.",{"_3379":71116,"_29619":71116,"_5":14457,"_2865":121525,"_29972":121526,"_20556":121528,"_26939":71116},"3.8.0 a 4.0.0",[48223,121527],"Actualizaciones",[],{"_3379":71117,"_29619":71116,"_20556":121530,"_5":14099,"_26939":71116,"_2865":121531},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3379":71118,"_29619":71116,"_5":29969,"_20556":121533,"_26939":121534,"_2865":121535},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_3379":71119,"_29619":71116,"_5":29969,"_20556":121537,"_26939":121538,"_2865":121539},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3379":71120,"_29619":71116,"_5":29969,"_20556":121541,"_26939":121542,"_2865":121543},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3379":71121,"_29619":71116,"_5":29969,"_20556":121545,"_26939":121546,"_2865":121547},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3379":71122,"_29619":71116,"_5":29969,"_20556":121549,"_26939":121550,"_2865":121551},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3379":71123,"_29619":71116,"_5":29969,"_20556":121553,"_26939":121554,"_2865":121555},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3379":71124,"_29619":71116,"_5":29969,"_20556":121557,"_26939":121558,"_2865":56347},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3379":71125,"_29619":71116,"_5":29969,"_20556":121560,"_26939":121561,"_2865":121562},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_3379":71126,"_29619":71116,"_5":29969,"_20556":121564,"_26939":121565,"_2865":121566},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3379":71127,"_29619":71116,"_5":29969,"_20556":121568,"_26939":121569,"_2865":121570},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3379":71128,"_29619":71116,"_5":29969,"_20556":121572,"_26939":121573,"_2865":121574},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3379":71129,"_29619":71116,"_5":29969,"_20556":121576,"_26939":121577,"_2865":121578},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3379":71130,"_29619":71116,"_5":29969,"_20556":121580,"_26939":121581,"_2865":121582},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3379":71131,"_29619":71116,"_5":29969,"_20556":121584,"_26939":121585,"_2865":121586},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3379":71132,"_29619":71116,"_5":29969,"_20556":121588,"_26939":121589,"_2865":121590},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3379":71133,"_29619":71116,"_5":29969,"_20556":121592,"_26939":121593,"_2865":121594},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_3379":71134,"_29619":71116,"_5":29969,"_20556":121596,"_26939":121597,"_2865":121598},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3379":71135,"_29619":71116,"_5":29969,"_20556":121600,"_26939":121601,"_2865":121602},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3379":71136,"_29619":71116,"_5":29969,"_20556":121604,"_26939":121605,"_2865":121606},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3379":71137,"_29619":71116,"_5":29969,"_20556":121608,"_26939":121609,"_2865":121610},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#referencias-entre-certificados-claves-y-roles-va","Referencias entre certificados, claves y roles VA",{"_3379":71138,"_29619":71116,"_5":29969,"_20556":121612,"_26939":121613,"_2865":121614},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_3379":71139,"_29619":71116,"_5":29969,"_20556":121616,"_26939":121617,"_2865":121618},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3379":71140,"_29619":71116,"_5":29969,"_20556":121620,"_26939":121621,"_2865":121622},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3379":71141,"_29619":71116,"_5":29969,"_20556":121624,"_26939":121625,"_2865":121626},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3379":71142,"_29619":71116,"_5":29969,"_20556":121628,"_26939":121629,"_2865":121630},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3379":71143,"_29619":71116,"_5":29969,"_20556":121632,"_26939":121633,"_2865":121634},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3379":71144,"_29619":71116,"_5":29969,"_20556":121636,"_26939":121637,"_2865":121638},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3379":71145,"_29619":71116,"_5":29969,"_20556":121640,"_26939":121641,"_2865":121642},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#campo-firmante-del-rol-va","Campo firmante del rol VA",{"_3379":71146,"_29619":71116,"_5":29969,"_20556":121644,"_26939":121645,"_2865":121646},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3379":71147,"_29619":71116,"_5":29969,"_20556":121648,"_26939":121649,"_2865":121650},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3379":71148,"_29619":71116,"_5":29969,"_20556":121652,"_26939":121653,"_2865":121654},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3379":71149,"_29619":71116,"_5":29969,"_20556":121656,"_26939":121657,"_2865":121658},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3379":71150,"_29619":71116,"_5":29969,"_20556":121660,"_26939":121661,"_2865":121662},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3379":71151,"_29619":71116,"_5":29969,"_20556":121664,"_26939":121665,"_2865":121666},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3379":71152,"_29619":71116,"_5":29969,"_20556":121668,"_26939":121669,"_2865":121670},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3379":71153,"_29619":71116,"_5":29969,"_20556":121672,"_26939":121673,"_2865":117580},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3379":71154,"_29619":71116,"_5":29969,"_20556":121675,"_26939":121676,"_2865":121677},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3379":71155,"_29619":71116,"_5":29969,"_20556":121679,"_26939":121680,"_2865":121681},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3379":71156,"_29619":71116,"_20556":121683,"_5":14099,"_26939":71116,"_2865":121684},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3379":71157,"_29619":71116,"_20556":121686,"_5":14099,"_26939":71116,"_2865":121687},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3379":71158,"_29619":71116,"_20556":121689,"_5":14099,"_26939":71116,"_2865":121690},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_3379":71159,"_29619":71116,"_20556":121692,"_5":14099,"_26939":71116,"_2865":121693},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_3379":71160,"_29619":71116,"_20556":121695,"_5":14099,"_26939":71116,"_2865":121696},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3379":71161,"_29619":71116,"_20556":121698,"_5":14099,"_26939":71116,"_2865":121699},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3379":71162,"_29619":71116,"_20556":121701,"_5":14099,"_26939":71116,"_2865":121702},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3379":71163,"_29619":71116,"_20556":121704,"_5":14099,"_26939":121538,"_2865":121705},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3379":71164,"_29619":71116,"_20556":121707,"_5":14099,"_26939":121538,"_2865":121708},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_3379":71165,"_29619":71116,"_20556":121710,"_5":14099,"_26939":121542,"_2865":121711},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3379":71166,"_29619":71116,"_20556":121713,"_5":14099,"_26939":121542,"_2865":121714},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y roles de la VA. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3379":71167,"_29619":71116,"_20556":121716,"_5":14099,"_26939":121546,"_2865":121717},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera.",{"_3379":71168,"_29619":71116,"_20556":121719,"_5":14099,"_26939":121550,"_2865":121720},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3379":71169,"_29619":71116,"_20556":121722,"_5":14099,"_26939":121550,"_2865":121723},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3379":71170,"_29619":71116,"_20556":121725,"_5":14099,"_26939":121550,"_2865":121726},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_3379":71171,"_29619":71116,"_20556":121728,"_5":14099,"_26939":121550,"_2865":121729},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3379":71172,"_29619":71116,"_20556":121731,"_5":14099,"_26939":121550,"_2865":121732},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3379":71173,"_29619":71116,"_20556":121734,"_5":14099,"_26939":121554,"_2865":121735},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3379":71174,"_29619":71116,"_20556":121737,"_5":14099,"_26939":121554,"_2865":121738},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3379":71175,"_29619":71116,"_20556":121740,"_5":14099,"_26939":121554,"_2865":121741},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3379":71176,"_29619":71116,"_20556":121743,"_5":14099,"_26939":121554,"_2865":121744},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3379":71177,"_29619":71116,"_20556":121746,"_5":14099,"_26939":121554,"_2865":121747},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3379":71178,"_29619":71116,"_20556":121749,"_5":14099,"_26939":121558,"_2865":121750},[],"Cambio",{"_3379":71179,"_29619":71116,"_20556":121752,"_5":14099,"_26939":121558,"_2865":121753},[],"A quién afecta",{"_3379":71180,"_29619":71116,"_20556":121755,"_5":14099,"_26939":121558,"_2865":121756},[],"Gravedad",{"_3379":71181,"_29619":71116,"_20556":121758,"_5":14099,"_26939":121558,"_2865":120285},[],{"_3379":71182,"_29619":71116,"_20556":121760,"_5":14099,"_26939":121558,"_2865":121566},[],{"_3379":71183,"_29619":71116,"_20556":121762,"_5":14099,"_26939":121558,"_2865":121763},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_3379":71184,"_29619":71116,"_20556":121765,"_5":14099,"_26939":121558,"_2865":121766},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_3379":71185,"_29619":71116,"_20556":121768,"_5":14099,"_26939":121558,"_2865":121769},[],"Copiar los datos a los volúmenes nuevos",{"_3379":71186,"_29619":71116,"_20556":121771,"_5":14099,"_26939":121558,"_2865":121570},[],{"_3379":71187,"_29619":71116,"_20556":121773,"_5":14099,"_26939":121558,"_2865":121774},[],"Todas las releases de Helm",{"_3379":71188,"_29619":71116,"_20556":121776,"_5":14099,"_26939":121558,"_2865":121777},[],"Alta: `helm upgrade` falla",{"_3379":71189,"_29619":71116,"_20556":121779,"_5":14099,"_26939":121558,"_2865":121780},[],"Eliminar o renombrar las claves heredadas",{"_3379":71190,"_29619":71116,"_20556":121782,"_5":14099,"_26939":121558,"_2865":121574},[],{"_3379":71191,"_29619":71116,"_20556":121784,"_5":14099,"_26939":121558,"_2865":121785},[],"Todos los despliegues",{"_3379":71192,"_29619":71116,"_20556":121787,"_5":14099,"_26939":121558,"_2865":121788},[],"Alta: sin principal de bootstrap no hay administrador",{"_3379":71193,"_29619":71116,"_20556":121790,"_5":14099,"_26939":121558,"_2865":121791},[],"Configurar `services.authz`",{"_3379":71194,"_29619":71116,"_20556":121793,"_5":14099,"_26939":121558,"_2865":121578},[],{"_3379":71195,"_29619":71116,"_20556":121795,"_5":14099,"_26939":121558,"_2865":121774},[],{"_3379":71196,"_29619":71116,"_20556":121797,"_5":14099,"_26939":121558,"_2865":121798},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_3379":71197,"_29619":71116,"_20556":121800,"_5":14099,"_26939":121558,"_2865":121801},[],"Mover JWKS y roles a `services.authz`",{"_3379":71198,"_29619":71116,"_20556":121803,"_5":14099,"_26939":121558,"_2865":121598},[],{"_3379":71199,"_29619":71116,"_20556":121805,"_5":14099,"_26939":121558,"_2865":121806},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_3379":71200,"_29619":71116,"_20556":121808,"_5":14099,"_26939":121558,"_2865":121809},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_3379":71201,"_29619":71116,"_20556":121811,"_5":14099,"_26939":121558,"_2865":121812},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_3379":71202,"_29619":71116,"_20556":121814,"_5":14099,"_26939":121558,"_2865":121602},[],{"_3379":71203,"_29619":71116,"_20556":121816,"_5":14099,"_26939":121558,"_2865":121817},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_3379":71204,"_29619":71116,"_20556":121819,"_5":14099,"_26939":121558,"_2865":121820},[],"Alta: el backend ya no arranca con ellos",{"_3379":71205,"_29619":71116,"_20556":121822,"_5":14099,"_26939":121558,"_2865":121823},[],"Pasar a PostgreSQL antes de actualizar",{"_3379":71206,"_29619":71116,"_20556":121825,"_5":14099,"_26939":121558,"_2865":121826},[],"Webhooks con referencias a archivos",{"_3379":71207,"_29619":71116,"_20556":121828,"_5":14099,"_26939":121558,"_2865":121829},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3379":71208,"_29619":71116,"_20556":121831,"_5":14099,"_26939":121558,"_2865":121832},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_3379":71209,"_29619":71116,"_20556":121834,"_5":14099,"_26939":121558,"_2865":121835},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3379":71210,"_29619":71116,"_20556":121837,"_5":14099,"_26939":121558,"_2865":121582},[],{"_3379":71211,"_29619":71116,"_20556":121839,"_5":14099,"_26939":121558,"_2865":121840},[],"Releases con identidades por servicio o material de claves montado",{"_3379":71212,"_29619":71116,"_20556":121842,"_5":14099,"_26939":121558,"_2865":121843},[],"Media: los servicios no pueden leer sus archivos",{"_3379":71213,"_29619":71116,"_20556":121845,"_5":14099,"_26939":121558,"_2865":121846},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_3379":71214,"_29619":71116,"_20556":121848,"_5":14099,"_26939":121558,"_2865":121586},[],{"_3379":71215,"_29619":71116,"_20556":121850,"_5":14099,"_26939":121558,"_2865":121851},[],"Releases que definen `amqp.tls`",{"_3379":71216,"_29619":71116,"_20556":121853,"_5":14099,"_26939":121558,"_2865":121854},[],"Media: los clientes se conectan al puerto equivocado",{"_3379":71217,"_29619":71116,"_20556":121856,"_5":14099,"_26939":121558,"_2865":121857},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_3379":71218,"_29619":71116,"_20556":121859,"_5":14099,"_26939":121558,"_2865":121606},[],{"_3379":71219,"_29619":71116,"_20556":121861,"_5":14099,"_26939":121558,"_2865":121862},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3379":71220,"_29619":71116,"_20556":121864,"_5":14099,"_26939":121558,"_2865":121865},[],"Media: las claves de CA quedan sin gestionar",{"_3379":71221,"_29619":71116,"_20556":121867,"_5":14099,"_26939":121558,"_2865":121868},[],"Ejecutar la migración de CA a KMS",{"_3379":71222,"_29619":71116,"_20556":121870,"_5":14099,"_26939":121558,"_2865":121871},[],"Verificación del certificado del receptor",{"_3379":71223,"_29619":71116,"_20556":121873,"_5":14099,"_26939":121558,"_2865":121874},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_3379":71224,"_29619":71116,"_20556":121876,"_5":14099,"_26939":121558,"_2865":121877},[],"Media: las credenciales viajan a un receptor sin verificar",{"_3379":71225,"_29619":71116,"_20556":121879,"_5":14099,"_26939":121558,"_2865":121880},[],"Poner `insecure_skip_verify` a `false`",{"_3379":71226,"_29619":71116,"_20556":121882,"_5":14099,"_26939":121558,"_2865":121622},[],{"_3379":71227,"_29619":71116,"_20556":121884,"_5":14099,"_26939":121558,"_2865":121885},[],"Scripts y consolas que editan DMS por API",{"_3379":71228,"_29619":71116,"_20556":121887,"_5":14099,"_26939":121558,"_2865":121888},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3379":71229,"_29619":71116,"_20556":121890,"_5":14099,"_26939":121558,"_2865":121891},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3379":71230,"_29619":71116,"_20556":121893,"_5":14099,"_26939":121558,"_2865":121642},[],{"_3379":71231,"_29619":71116,"_20556":121895,"_5":14099,"_26939":121558,"_2865":121896},[],"Clientes que crean o actualizan roles VA por API",{"_3379":71232,"_29619":71116,"_20556":121898,"_5":14099,"_26939":121558,"_2865":121899},[],"Media: las peticiones con el campo antiguo devuelven un error",{"_3379":71233,"_29619":71116,"_20556":121901,"_5":14099,"_26939":121558,"_2865":121902},[],"Sustituir `crl_options.subject_key_id_signer` por el obligatorio `crl_options.signer_certificate_serial_number`",{"_3379":71234,"_29619":71116,"_20556":121904,"_5":14099,"_26939":121558,"_2865":121638},[],{"_3379":71235,"_29619":71116,"_20556":121906,"_5":14099,"_26939":121558,"_2865":121907},[],"Consumidores que leen el campo `events` del dispositivo",{"_3379":71236,"_29619":71116,"_20556":121909,"_5":14099,"_26939":121558,"_2865":121910},[],"Media: el campo desaparece",{"_3379":71237,"_29619":71116,"_20556":121912,"_5":14099,"_26939":121558,"_2865":121913},[],"Usar los nuevos endpoints de eventos",{"_3379":71238,"_29619":71116,"_20556":121915,"_5":14099,"_26939":121558,"_2865":121590},[],{"_3379":71239,"_29619":71116,"_20556":121917,"_5":14099,"_26939":121558,"_2865":121918},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_3379":71240,"_29619":71116,"_20556":121920,"_5":14099,"_26939":121558,"_2865":121921},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_3379":71241,"_29619":71116,"_20556":121923,"_5":14099,"_26939":121558,"_2865":121924},[],"Actualizar el archivo de values",{"_3379":71242,"_29619":71116,"_20556":121926,"_5":14099,"_26939":121558,"_2865":121630},[],{"_3379":71243,"_29619":71116,"_20556":121928,"_5":14099,"_26939":121558,"_2865":121929},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3379":71244,"_29619":71116,"_20556":121931,"_5":14099,"_26939":121558,"_2865":121932},[],"Baja: prevalece el ID de la URL",{"_3379":71245,"_29619":71116,"_20556":121934,"_5":14099,"_26939":121558,"_2865":121935},[],"Enviar el ID en la URL",{"_3379":71246,"_29619":71116,"_20556":121937,"_5":14099,"_26939":121558,"_2865":121634},[],{"_3379":71247,"_29619":71116,"_20556":121939,"_5":14099,"_26939":121558,"_2865":121940},[],"Consumidores que comparan el `type` del certificado",{"_3379":71248,"_29619":71116,"_20556":121942,"_5":14099,"_26939":121558,"_2865":121943},[],"Baja: dos valores cambian de nombre",{"_3379":71249,"_29619":71116,"_20556":121945,"_5":14099,"_26939":121558,"_2865":121946},[],"Adaptar los consumidores",{"_3379":71250,"_29619":71116,"_20556":121948,"_5":14099,"_26939":121558,"_2865":121626},[],{"_3379":71251,"_29619":71116,"_20556":121950,"_5":14099,"_26939":121558,"_2865":121951},[],"Cualquier DMS",{"_3379":71252,"_29619":71116,"_20556":121953,"_5":14099,"_26939":121558,"_2865":121954},[],"Baja: solo informativo",{"_3379":71253,"_29619":71116,"_20556":121956,"_5":14099,"_26939":121558,"_2865":121957},[],"Revisar ambos bloques antes de editar",{"_3379":71254,"_29619":71116,"_20556":121959,"_5":14099,"_26939":121565,"_2865":121960},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3379":71255,"_29619":71116,"_20556":121962,"_5":14099,"_26939":121565,"_2865":121963},[],"El paso 4 de la guía de migración copia los datos.",{"_3379":71256,"_29619":71116,"_20556":121965,"_5":14099,"_26939":121569,"_2865":121966},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3379":71257,"_29619":71116,"_20556":121968,"_5":14099,"_26939":121573,"_2865":121969},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3379":71258,"_29619":71116,"_20556":121971,"_5":14099,"_26939":121577,"_2865":121972},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3379":71259,"_29619":71116,"_20556":121974,"_5":14099,"_26939":121581,"_2865":121975},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3379":71260,"_29619":71116,"_20556":121977,"_5":14099,"_26939":121581,"_2865":121978},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3379":71261,"_29619":71116,"_20556":121980,"_5":14099,"_26939":121585,"_2865":121981},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3379":71262,"_29619":71116,"_20556":121983,"_5":14099,"_26939":121589,"_2865":121984},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3379":71263,"_29619":71116,"_20556":121986,"_5":14099,"_26939":121589,"_2865":121987},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3379":71264,"_29619":71116,"_20556":121989,"_5":14099,"_26939":121589,"_2865":121990},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3379":71265,"_29619":71116,"_20556":121992,"_5":14099,"_26939":121589,"_2865":121993},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3379":71266,"_29619":71116,"_20556":121995,"_5":14099,"_26939":121589,"_2865":121996},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3379":71267,"_29619":71116,"_20556":121998,"_5":14099,"_26939":121589,"_2865":121999},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3379":71268,"_29619":71116,"_20556":122001,"_5":14099,"_26939":121597,"_2865":122002},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3379":71269,"_29619":71116,"_20556":122004,"_5":14099,"_26939":121597,"_2865":122005},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3379":71270,"_29619":71116,"_20556":122007,"_5":14099,"_26939":121597,"_2865":122008},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3379":71271,"_29619":71116,"_20556":122010,"_5":14099,"_26939":121597,"_2865":122011},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3379":71272,"_29619":71116,"_20556":122013,"_5":14099,"_26939":121597,"_2865":122014},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_3379":71273,"_29619":71116,"_20556":122016,"_5":14099,"_26939":121601,"_2865":122017},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3379":71274,"_29619":71116,"_20556":122019,"_5":14099,"_26939":121605,"_2865":122020},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3379":71275,"_29619":71116,"_20556":122022,"_5":14099,"_26939":121605,"_2865":122023},[],"El `key_id` es el `subject_key_id` del certificado (SHA-256 de la clave pública).",{"_3379":71276,"_29619":71116,"_20556":122025,"_5":14099,"_26939":121605,"_2865":122026},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3379":71277,"_29619":71116,"_20556":122028,"_5":14099,"_26939":121605,"_2865":122029},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3379":71278,"_29619":71116,"_20556":122031,"_5":14099,"_26939":121605,"_2865":122032},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3379":71279,"_29619":71116,"_20556":122034,"_5":14099,"_26939":121605,"_2865":122035},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3379":71280,"_29619":71116,"_20556":122037,"_5":14099,"_26939":121605,"_2865":122038},[],"Una vez registradas las claves heredadas, arrancar el KMS con la opción de configuración del backend `crypto_engines.migrate_keys_format` renombra las claves cuyo nombre no es el digest SHA-256 de la clave pública, conserva el nombre antiguo como alias y traslada consigo las referencias de certificados. Es seguro volver a ejecutarla y puede desactivarse después.",{"_3379":71281,"_29619":71116,"_20556":122040,"_5":14099,"_26939":121609,"_2865":122041},[],"Los certificados referencian ahora su clave del KMS, y los roles VA referencian su certificado firmante, de modo que no se puede eliminar una clave o un certificado en uso. La migración del KMS descarta los metadatos de clave heredados `lamassu.io/kms/binded-resources`. Antes de 4.0.0, eliminar una CA podía borrar su clave y dejar referencias a ella en los registros de certificado conservados. La migración de CA registra esas claves ausentes en el KMS solo con su clave pública para satisfacer las referencias conservadas. Estas entradas no pueden eliminarse mientras los certificados conservados las referencien; no recuperan la clave privada. En 4.0.0, eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados antes de intentar eliminar la clave; los demás certificados que todavía la referencien impiden su eliminación.",{"_3379":71282,"_29619":71116,"_20556":122043,"_5":14099,"_26939":121617,"_2865":122044},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_3379":71283,"_29619":71116,"_20556":122046,"_5":14099,"_26939":121617,"_2865":122047},[],"Campo en 3.8.0",{"_3379":71284,"_29619":71116,"_20556":122049,"_5":14099,"_26939":121617,"_2865":122050},[],"Campo en 4.0.0",{"_3379":71285,"_29619":71116,"_20556":122052,"_5":14099,"_26939":121617,"_2865":56842},[],{"_3379":71286,"_29619":71116,"_20556":122054,"_5":14099,"_26939":121617,"_2865":122055},[],"`insecure_skip_verify` (con el valor negado)",{"_3379":71287,"_29619":71116,"_20556":122057,"_5":14099,"_26939":121617,"_2865":56848},[],{"_3379":71288,"_29619":71116,"_20556":122059,"_5":14099,"_26939":121617,"_2865":56851},[],{"_3379":71289,"_29619":71116,"_20556":122061,"_5":14099,"_26939":121617,"_2865":56854},[],{"_3379":71290,"_29619":71116,"_20556":122063,"_5":14099,"_26939":121617,"_2865":56857},[],{"_3379":71291,"_29619":71116,"_20556":122065,"_5":14099,"_26939":121617,"_2865":56860},[],{"_3379":71292,"_29619":71116,"_20556":122067,"_5":14099,"_26939":121617,"_2865":56863},[],{"_3379":71293,"_29619":71116,"_20556":122069,"_5":14099,"_26939":121617,"_2865":122070},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_3379":71294,"_29619":71116,"_20556":122072,"_5":14099,"_26939":121617,"_2865":122073},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3379":71295,"_29619":71116,"_20556":122075,"_5":14099,"_26939":121617,"_2865":122076},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3379":71296,"_29619":71116,"_20556":122078,"_5":14099,"_26939":121621,"_2865":122079},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3379":71297,"_29619":71116,"_20556":122081,"_5":14099,"_26939":121621,"_2865":122082},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3379":71298,"_29619":71116,"_20556":122084,"_5":14099,"_26939":121621,"_2865":122085},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3379":71299,"_29619":71116,"_20556":122087,"_5":14099,"_26939":121625,"_2865":122088},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. La consola expone editores independientes para ambos bloques; la guía de DMS describe sus campos, y también puedes editarlos mediante la API DMS.",{"_3379":71300,"_29619":71116,"_20556":122090,"_5":14099,"_26939":121629,"_2865":122091},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3379":71301,"_29619":71116,"_20556":122093,"_5":14099,"_26939":121633,"_2865":122094},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_3379":71302,"_29619":71116,"_20556":122096,"_5":14099,"_26939":121637,"_2865":122097},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3379":71303,"_29619":71116,"_20556":122099,"_5":14099,"_26939":121637,"_2865":122100},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3379":71304,"_29619":71116,"_20556":122102,"_5":14099,"_26939":121637,"_2865":122103},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3379":71305,"_29619":71116,"_20556":122105,"_5":14099,"_26939":121637,"_2865":122106},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza.",{"_3379":71306,"_29619":71116,"_20556":122108,"_5":14099,"_26939":121641,"_2865":122109},[],"`crl_options.subject_key_id_signer` se sustituye por el obligatorio `crl_options.signer_certificate_serial_number`, el número de serie del certificado existente que firma la CRL. El valor inicial de un rol nuevo es el número de serie del certificado actual de la CA. Las peticiones que aún contienen `subject_key_id_signer` devuelven un error. Las políticas de autorización personalizadas que filtran por el campo antiguo deben actualizarse: el filtro `crl_subject_key_id_signer` se renombra a `crl_signer_certificate_serial_number` y toma valores de número de serie.",{"_3379":71307,"_29619":71116,"_20556":122111,"_5":14099,"_26939":121645,"_2865":122112},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3379":71308,"_29619":71116,"_20556":122114,"_5":14099,"_26939":121649,"_2865":122115},[],"Haz una copia de seguridad verificable de PostgreSQL y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`.",{"_3379":71309,"_29619":71116,"_20556":122117,"_5":14099,"_26939":121649,"_2865":122118},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3379":71310,"_29619":71116,"_20556":122120,"_5":14099,"_26939":121649,"_2865":122121},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3379":71311,"_29619":71116,"_20556":122123,"_5":14099,"_26939":121649,"_2865":122124},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3379":71312,"_29619":71116,"_20556":122126,"_5":14099,"_26939":121649,"_2865":122127},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3379":71313,"_29619":71116,"_20556":122129,"_5":14099,"_26939":121653,"_2865":122130},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3379":71314,"_29619":71116,"_20556":122132,"_5":14099,"_26939":121653,"_2865":122133},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3379":71315,"_29619":71116,"_20556":122135,"_5":14099,"_26939":121653,"_2865":122136},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se lee el campo `database` de cada entrada; la conexión usa siempre los values globales `postgres.hostname`, `postgres.port`, `postgres.username` y `postgres.password`.",{"_3379":71316,"_29619":71116,"_20556":122138,"_5":14099,"_26939":121653,"_2865":122139},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3379":71317,"_29619":71116,"_20556":122141,"_5":14099,"_26939":121653,"_2865":122142},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3379":71318,"_29619":71116,"_20556":122144,"_5":14099,"_26939":121653,"_2865":122145},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3379":71319,"_29619":71116,"_20556":122147,"_5":14099,"_26939":121653,"_2865":122148},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3379":71320,"_29619":71116,"_20556":122150,"_5":14099,"_26939":121653,"_2865":122151},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3379":71321,"_29619":71116,"_20556":122153,"_5":14099,"_26939":121653,"_2865":122154},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3379":71322,"_29619":71116,"_20556":122156,"_5":14099,"_26939":121653,"_2865":122157},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3379":71323,"_29619":71116,"_20556":122159,"_5":14099,"_26939":121653,"_2865":122160},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3379":71324,"_29619":71116,"_20556":122162,"_5":14099,"_26939":121653,"_2865":122163},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida.",{"_3379":71325,"_29619":71116,"_20556":122165,"_5":14099,"_26939":121657,"_2865":122166},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_3379":71326,"_29619":71116,"_20556":122168,"_5":14099,"_26939":121657,"_2865":122169},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_3379":71327,"_29619":71116,"_20556":122171,"_5":14099,"_26939":121661,"_2865":122172},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3379":71328,"_29619":71116,"_20556":122174,"_5":14099,"_26939":121661,"_2865":122175},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3379":71329,"_29619":71116,"_20556":122177,"_5":14099,"_26939":121661,"_2865":122178},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3379":71330,"_29619":71116,"_20556":122180,"_5":14099,"_26939":121661,"_2865":122181},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_3379":71331,"_29619":71116,"_20556":122183,"_5":14099,"_26939":121661,"_2865":122184},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3379":71332,"_29619":71116,"_20556":122186,"_5":14099,"_26939":121661,"_2865":122187},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3379":71333,"_29619":71116,"_20556":122189,"_5":14099,"_26939":121661,"_2865":122190},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3379":71334,"_29619":71116,"_20556":122192,"_5":14099,"_26939":121661,"_2865":122193},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3379":71335,"_29619":71116,"_20556":122195,"_5":14099,"_26939":121661,"_2865":122196},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3379":71336,"_29619":71116,"_20556":122198,"_5":14099,"_26939":121661,"_2865":122199},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3379":71337,"_29619":71116,"_20556":122201,"_5":14099,"_26939":121661,"_2865":122202},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_3379":71338,"_29619":71116,"_20556":122204,"_5":14099,"_26939":121665,"_2865":122205},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3379":71339,"_29619":71116,"_20556":122207,"_5":14099,"_26939":121665,"_2865":122208},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3379":71340,"_29619":71116,"_20556":122210,"_5":14099,"_26939":121669,"_2865":122211},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3379":71341,"_29619":71116,"_20556":122213,"_5":14099,"_26939":121669,"_2865":122214},[],"Ejecuta las migraciones en el orden obligatorio, un esquema cada vez: primero `kms`, después la herramienta `ca-to-kms-migration` (necesaria solo en despliegues heredados cuyas claves de CA se nombran por SKI), luego `ca` y por último `va`. Los esquemas `devicemanager`, `dmsmanager` y `alerts` son independientes y pueden migrarse en cualquier orden. Con Helm, el job de preinstalación del chart aplica los esquemas en el orden correcto automáticamente.",{"_3379":71342,"_29619":71116,"_20556":122216,"_5":14099,"_26939":121669,"_2865":122217},[],"Los esquemas se referencian entre sí, así que el rol de PostgreSQL que ejecuta las migraciones necesita privilegios entre esquemas: el esquema `ca` necesita `USAGE` sobre `kms` más `SELECT`, `REFERENCES` e `INSERT` sobre `kms.kms_keys`, y el esquema `va` necesita `USAGE` sobre `ca` más `SELECT` y `REFERENCES` sobre `ca.certificates` y `SELECT` sobre `ca.ca_certificates`. Si tus servicios se conectan con un usuario distinto del que ejecutó las migraciones, concédele tras las migraciones `SELECT` sobre `ca.certificates_view`.",{"_3379":71343,"_29619":71116,"_20556":122219,"_5":14099,"_26939":121669,"_2865":122220},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3379":71344,"_29619":71116,"_20556":122222,"_5":14099,"_26939":121669,"_2865":122223},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3379":71345,"_29619":71116,"_20556":122225,"_5":14099,"_26939":121669,"_2865":122226},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_3379":71346,"_29619":71116,"_20556":122228,"_5":14099,"_26939":121669,"_2865":122229},[],"Los README de ambas herramientas documentan el formato de 4.0.0 con la base `pki` y coinciden con esta página: `goose-lamassu` usa ejemplos con `dbname=pki` y no valida el nombre de la base de datos, y el README de `ca-to-kms-migration` describe la base única `pki` y el orden de migración.",{"_3379":71347,"_29619":71116,"_20556":122231,"_5":14099,"_26939":121673,"_2865":122232},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3379":71348,"_29619":71116,"_20556":122234,"_5":14099,"_26939":121673,"_2865":122235},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_3379":71349,"_29619":71116,"_20556":122237,"_5":14099,"_26939":121673,"_2865":122238},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_3379":71350,"_29619":71116,"_20556":122240,"_5":14099,"_26939":121673,"_2865":122241},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3379":71351,"_29619":71116,"_20556":122243,"_5":14099,"_26939":121673,"_2865":122244},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó por IDs de CA duplicados o por valores de `engine_id` vacíos. Revisa los logs del job, corrige los permisos o los datos y vuelve a ejecutar la actualización.",{"_3379":71352,"_29619":71116,"_20556":122246,"_5":14099,"_26939":121673,"_2865":122247},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3379":71353,"_29619":71116,"_20556":122249,"_5":14099,"_26939":121673,"_2865":122250},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3379":71354,"_29619":71116,"_20556":122252,"_5":14099,"_26939":121673,"_2865":122253},[],"**Una migración aborta con `kms schema not found`.** Los esquemas deben migrarse en orden: ejecuta la migración del esquema `kms` antes que la del esquema `ca`.",{"_3379":71355,"_29619":71116,"_20556":122255,"_5":14099,"_26939":121673,"_2865":122256},[],"**Una migración aborta con `ca schema not found`.** Ejecuta la migración del esquema `ca` antes que la del esquema `va`.",{"_3379":71356,"_29619":71116,"_20556":122258,"_5":14099,"_26939":121673,"_2865":122259},[],"**La migración de VA falla con `cannot resolve signer certificate for VA role ... N candidates`.** La migración no puede identificar un certificado firmante de forma única a partir del SKI guardado en el rol. Revisa el SKI y los certificados candidatos indicados en el error; corrige los datos anteriores a la migración con una copia de seguridad verificada y vuelve a ejecutar la migración. El nuevo campo `signer_certificate_serial_number` se crea durante esa migración, por lo que no se puede configurar mediante la API de VA mientras esta falla.",{"_3379":71357,"_29619":71116,"_20556":122261,"_5":14099,"_26939":121673,"_2865":122262},[],"**Una migración o un servicio falla con `permission denied for table ...`.** Al rol de PostgreSQL le faltan los privilegios entre esquemas listados en Despliegues sin Helm; incluye `certificates_view` cuando se omitió el `GRANT SELECT` posterior a la migración. Concede los privilegios que falten y vuelve a ejecutar.",{"_3379":71358,"_29619":71116,"_20556":122264,"_5":14099,"_26939":121676,"_2865":122265},[],"Tras la actualización, comprueba en este orden:",{"_3379":71359,"_29619":71116,"_20556":122267,"_5":14099,"_26939":121676,"_2865":122268},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS, y las migraciones de claves foráneas que se ejecutan por esquema en el orden obligatorio.",{"_3379":71360,"_29619":71116,"_20556":122270,"_5":14099,"_26939":121676,"_2865":122271},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3379":71361,"_29619":71116,"_20556":122273,"_5":14099,"_26939":121676,"_2865":122274},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3379":71362,"_29619":71116,"_20556":122276,"_5":14099,"_26939":121676,"_2865":122277},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-ski>` sobre la VA devuelve una CRL emitida anteriormente, y se emiten CRLs nuevas.",{"_3379":71363,"_29619":71116,"_20556":122279,"_5":14099,"_26939":121676,"_2865":122280},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS.",{"_3379":71364,"_29619":71116,"_20556":122282,"_5":14099,"_26939":121676,"_2865":122283},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3379":71365,"_29619":71116,"_20556":122285,"_5":14099,"_26939":121676,"_2865":122286},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3379":71366,"_29619":71116,"_20556":122288,"_5":14099,"_26939":121676,"_2865":122289},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha.",{"_3379":71367,"_29619":71116,"_20556":122291,"_5":14099,"_26939":121676,"_2865":122292},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3379":71368,"_29619":71116,"_20556":122294,"_5":14099,"_26939":121676,"_2865":122295},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3379":71369,"_29619":71116,"_20556":122297,"_5":14099,"_26939":121676,"_2865":122298},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3379":71370,"_29619":71116,"_20556":122300,"_5":14099,"_26939":121676,"_2865":122301},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3379":71371,"_29619":71116,"_20556":122303,"_5":14099,"_26939":121676,"_2865":122304},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3379":71372,"_29619":71116,"_20556":122306,"_5":14099,"_26939":121676,"_2865":122307},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3379":71373,"_29619":71116,"_20556":122309,"_5":14099,"_26939":121680,"_2865":122310},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_3379":71374,"_29619":71116,"_20556":122312,"_5":14099,"_26939":121680,"_2865":122313},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3379":71375,"_29619":71116,"_20556":122315,"_5":14099,"_26939":121680,"_2865":122316},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3379":71376,"_29619":71116,"_20556":122318,"_5":14099,"_26939":121680,"_2865":122319},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_3379":71377,"_29619":71116,"_20556":122321,"_5":14099,"_26939":121680,"_2865":122322},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_57121":122324,"_57123":122325,"_57125":122326,"_57127":122327,"_17802":2900,"_68526":2900},"spanish",[2865,29619,5,26939],{"_2865":24560,"_29619":24560,"_5":24560,"_26939":24560},{"_2865":122328,"_29619":125176,"_5":128024,"_26939":130872},{"_4543":122329,"_57131":122330,"_5":24560},{"_14181":12921,"_14562":4446,"_14581":5830,"_28628":10286,"_14568":3963,"_19510":3334,"_14202":15521,"_14209":5865,"_28570":13019,"_28979":6819,"_29000":4447,"_28604":6879,"_33927":6154,"_28707":19968,"_29044":9670,"_33934":29147,"_33937":3902,"_33940":9367,"_33943":24907,"_29451":3251,"_33948":14023,"_33950":9816,"_29481":17303,"_14577":6901,"_33954":7338,"_33957":5849,"_33959":5880,"_29028":5778,"_29446":9918,"_29494":4665,"_33964":5882,"_33966":2940,"_33968":7323,"_28724":3309,"_33971":3243,"_33973":4221,"_33975":24375,"_33977":6876,"_33979":5041,"_28641":4748,"_33982":6910,"_33984":9407,"_28635":8358,"_29065":10213,"_33988":3049,"_33990":13890,"_33993":8848,"_28681":7402,"_33997":6205,"_28561":20775,"_34000":7324,"_28609":2945,"_29678":6869,"_34004":5711,"_34007":3171,"_14571":16968,"_34010":5822,"_34012":19973,"_34015":6086,"_34017":3172,"_34019":7501,"_34021":5372,"_34023":2957,"_19513":5416,"_34026":6113,"_34028":3598,"_28582":6847,"_29022":3616,"_34032":11393,"_34034":4066,"_34036":3208,"_29511":3246,"_34039":5008,"_34041":6777,"_34043":5003,"_29605":3601,"_29081":7423,"_34047":8672,"_34049":7406,"_28619":3861,"_34052