"_37039":53220,"_37041":53223,"_37043":53226,"_37045":53229,"_37047":53232,"_37049":53235,"_37051":53238,"_37053":53241,"_37055":53244,"_37057":53247,"_37059":53250,"_37061":53253,"_37064":53256,"_37066":53259,"_37068":53262,"_37071":53265,"_37073":53268,"_37075":53271,"_37077":53274,"_37080":53277,"_37082":53280,"_37084":53283,"_37086":53286,"_37088":53289,"_37090":53292,"_37092":53295,"_37094":53298,"_37096":53301,"_37098":53304,"_37100":53307,"_37102":53310,"_37104":53313,"_37107":53316,"_37109":53319,"_37111":53322,"_37113":53325,"_37115":53328,"_37117":53331,"_37119":53334,"_37121":53337,"_37123":53340,"_37125":53343,"_37127":53346,"_37129":53349,"_37131":53352,"_37133":53355,"_37135":53358,"_37137":53361,"_37139":53364,"_37141":53367,"_37143":53370,"_37145":53373,"_37147":53376,"_37150":53379,"_37152":53382,"_37154":53385,"_37156":53388},{"_3154":15,"_27801":15,"_5":13544,"_2652":45129,"_28144":45130,"_19254":45134,"_26298":15},"Deploy from AWS Marketplace",[45131,45132,45133],"Docs","Deployment","Other models",[],{"_3154":16,"_27801":15,"_19254":45136,"_5":13218,"_26298":15,"_2652":45137},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_3154":17,"_27801":15,"_5":28141,"_19254":45139,"_26298":45140,"_2652":45141},[],"/docs/pr-preview/pr-53/deployment/aws-marketplace#before-you-begin","Before you begin",{"_3154":18,"_27801":15,"_5":28141,"_19254":45143,"_26298":45144,"_2652":45145},[],"/docs/pr-preview/pr-53/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_3154":19,"_27801":15,"_5":28141,"_19254":45147,"_26298":45148,"_2652":45149},[],"/docs/pr-preview/pr-53/deployment/aws-marketplace#open-the-offer","Open the offer",{"_3154":20,"_27801":15,"_5":28141,"_19254":45151,"_26298":45152,"_2652":45153},[],"/docs/pr-preview/pr-53/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_3154":21,"_27801":15,"_5":28141,"_19254":45155,"_26298":45156,"_2652":45157},[],"/docs/pr-preview/pr-53/deployment/aws-marketplace#limit-network-access","Limit network access",{"_3154":22,"_27801":15,"_5":28141,"_19254":45159,"_26298":45160,"_2652":45161},[],"/docs/pr-preview/pr-53/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_3154":23,"_27801":15,"_5":28141,"_19254":45163,"_26298":45164,"_2652":45165},[],"/docs/pr-preview/pr-53/deployment/aws-marketplace#next-step","Next step",{"_3154":24,"_27801":15,"_19254":45167,"_5":13218,"_26298":15,"_2652":45168},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_3154":25,"_27801":15,"_19254":45170,"_5":13218,"_26298":45140,"_2652":45171},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_3154":26,"_27801":15,"_19254":45173,"_5":13218,"_26298":45140,"_2652":45174},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_3154":27,"_27801":15,"_19254":45176,"_5":13218,"_26298":45140,"_2652":45177},[],"A security group allowing the necessary endpoints.",{"_3154":28,"_27801":15,"_19254":45179,"_5":13218,"_26298":45144,"_2652":45180},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_3154":29,"_27801":15,"_19254":45182,"_5":13218,"_26298":45144,"_2652":45183},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_3154":30,"_27801":15,"_19254":45185,"_5":13218,"_26298":45144,"_2652":45186},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_3154":31,"_27801":15,"_19254":45188,"_5":13218,"_26298":45148,"_2652":45189},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_3154":32,"_27801":15,"_19254":45191,"_5":13218,"_26298":45152,"_2652":45192},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_3154":33,"_27801":15,"_19254":45194,"_5":13218,"_26298":45156,"_2652":45195},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_3154":34,"_27801":15,"_19254":45197,"_5":13218,"_26298":45160,"_2652":45198},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_3154":35,"_27801":15,"_19254":45200,"_5":13218,"_26298":45164,"_2652":45201},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_3154":36,"_27801":36,"_5":13544,"_2652":45203,"_28144":45204,"_19254":45205,"_26298":36},"Deploy Lamassu",[45131,45132],[],{"_3154":37,"_27801":36,"_19254":45207,"_5":13218,"_26298":36,"_2652":45208},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_3154":38,"_27801":36,"_5":28141,"_19254":45210,"_26298":45211,"_2652":45212},[],"/docs/pr-preview/pr-53/deployment/overview#choose-a-model","Choose a model",{"_3154":39,"_27801":36,"_5":28141,"_19254":45214,"_26298":45215,"_2652":45216},[],"/docs/pr-preview/pr-53/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_3154":40,"_27801":36,"_5":28141,"_19254":45218,"_26298":45219,"_2652":45220},[],"/docs/pr-preview/pr-53/deployment/overview#after-deployment","After deployment",{"_3154":41,"_27801":36,"_19254":45222,"_5":13218,"_26298":36,"_2652":45223},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_3154":42,"_27801":36,"_19254":45225,"_5":13218,"_26298":45211,"_2652":45226},[],"Model",{"_3154":43,"_27801":36,"_19254":45228,"_5":13218,"_26298":45211,"_2652":45229},[],"Recommended for",{"_3154":44,"_27801":36,"_19254":45231,"_5":13218,"_26298":45211,"_2652":45232},[],"Who operates the infrastructure",{"_3154":45,"_27801":36,"_19254":45234,"_5":13218,"_26298":45211,"_2652":45235},[],"Starting point",{"_3154":46,"_27801":36,"_19254":45237,"_5":13218,"_26298":45211,"_2652":45238},[],"Kubernetes self-managed",{"_3154":47,"_27801":36,"_19254":45240,"_5":13218,"_26298":45211,"_2652":45241},[],"Production, regulated environments and custom deployments",{"_3154":48,"_27801":36,"_19254":45243,"_5":13218,"_26298":45211,"_2652":45244},[],"Your team",{"_3154":49,"_27801":36,"_19254":45246,"_5":13218,"_26298":45211,"_2652":45247},[],"Helm or Fastlane",{"_3154":50,"_27801":36,"_19254":45249,"_5":13218,"_26298":45211,"_2652":45250},[],"AWS Marketplace",{"_3154":51,"_27801":36,"_19254":45252,"_5":13218,"_26298":45211,"_2652":45253},[],"Evaluation or a dedicated deployment inside an AWS account",{"_3154":52,"_27801":36,"_19254":45255,"_5":13218,"_26298":45211,"_2652":45244},[],{"_3154":53,"_27801":36,"_19254":45257,"_5":13218,"_26298":45211,"_2652":45258},[],"Preconfigured image on EC2",{"_3154":54,"_27801":36,"_19254":45260,"_5":13218,"_26298":45211,"_2652":45261},[],"SaaS",{"_3154":55,"_27801":36,"_19254":45263,"_5":13218,"_26298":45211,"_2652":45264},[],"Teams that want to use the platform without operating it",{"_3154":56,"_27801":36,"_19254":45266,"_5":13218,"_26298":45211,"_2652":45267},[],"Lamassu",{"_3154":57,"_27801":36,"_19254":45269,"_5":13218,"_26298":45211,"_2652":45270},[],"Managed subscription",{"_3154":58,"_27801":36,"_19254":45272,"_5":13218,"_26298":45211,"_2652":45273},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3154":59,"_27801":36,"_19254":45275,"_5":13218,"_26298":45211,"_2652":45276},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3154":60,"_27801":36,"_19254":45278,"_5":13218,"_26298":45211,"_2652":45279},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_3154":61,"_27801":36,"_19254":45281,"_5":13218,"_26298":45215,"_2652":45282},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_3154":62,"_27801":36,"_19254":45284,"_5":13218,"_26298":45219,"_2652":45285},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_3154":63,"_27801":63,"_5":13544,"_2652":45287,"_28144":45288,"_19254":45289,"_26298":63},"Use Lamassu as SaaS",[45131,45132,45133],[],{"_3154":64,"_27801":63,"_19254":45291,"_5":13218,"_26298":63,"_2652":45292},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_3154":65,"_27801":63,"_5":28141,"_19254":45294,"_26298":45295,"_2652":45296},[],"/docs/pr-preview/pr-53/deployment/saas#what-the-service-manages","What the service manages",{"_3154":66,"_27801":63,"_5":28141,"_19254":45298,"_26298":45299,"_2652":45300},[],"/docs/pr-preview/pr-53/deployment/saas#plans","Plans",{"_3154":67,"_27801":63,"_5":28141,"_19254":45302,"_26298":45303,"_2652":45304},[],"/docs/pr-preview/pr-53/deployment/saas#request-access","Request access",{"_3154":68,"_27801":63,"_19254":45306,"_5":13218,"_26298":63,"_2652":45307},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_3154":69,"_27801":63,"_19254":45309,"_5":13218,"_26298":45295,"_2652":45310},[],"Platform availability and maintenance.",{"_3154":70,"_27801":63,"_19254":45312,"_5":13218,"_26298":45295,"_2652":45313},[],"Automatic backups.",{"_3154":71,"_27801":63,"_19254":45315,"_5":13218,"_26298":45295,"_2652":45316},[],"Version upgrades.",{"_3154":72,"_27801":63,"_19254":45318,"_5":13218,"_26298":45295,"_2652":45319},[],"Technical support and SLA according to your plan.",{"_3154":73,"_27801":63,"_19254":45321,"_5":13218,"_26298":45299,"_2652":45322},[],"Plan",{"_3154":74,"_27801":63,"_19254":45324,"_5":13218,"_26298":45299,"_2652":45325},[],"Devices",{"_3154":75,"_27801":63,"_19254":45327,"_5":13218,"_26298":45299,"_2652":45328},[],"Support",{"_3154":76,"_27801":63,"_19254":45330,"_5":13218,"_26298":45299,"_2652":45331},[],"SLA",{"_3154":77,"_27801":63,"_19254":45333,"_5":13218,"_26298":45299,"_2652":45334},[],"Starter",{"_3154":78,"_27801":63,"_19254":45336,"_5":13218,"_26298":45299,"_2652":45337},[],"Up to 1,000",{"_3154":79,"_27801":63,"_19254":45339,"_5":13218,"_26298":45299,"_2652":45340},[],"Email",{"_3154":80,"_27801":63,"_19254":45342,"_5":13218,"_26298":45299,"_2652":45343},[],"99.5 %",{"_3154":81,"_27801":63,"_19254":45345,"_5":13218,"_26298":45299,"_2652":45346},[],"Professional",{"_3154":82,"_27801":63,"_19254":45348,"_5":13218,"_26298":45299,"_2652":45349},[],"Up to 10,000",{"_3154":83,"_27801":63,"_19254":45351,"_5":13218,"_26298":45299,"_2652":45352},[],"Email and chat",{"_3154":84,"_27801":63,"_19254":45354,"_5":13218,"_26298":45299,"_2652":45355},[],"99.9 %",{"_3154":85,"_27801":63,"_19254":45357,"_5":13218,"_26298":45299,"_2652":45358},[],"Enterprise",{"_3154":86,"_27801":63,"_19254":45360,"_5":13218,"_26298":45299,"_2652":45361},[],"Unlimited",{"_3154":87,"_27801":63,"_19254":45363,"_5":13218,"_26298":45299,"_2652":45364},[],"Dedicated",{"_3154":88,"_27801":63,"_19254":45366,"_5":13218,"_26298":45299,"_2652":45367},[],"99.99 %",{"_3154":89,"_27801":63,"_19254":45369,"_5":13218,"_26298":45303,"_2652":45370},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_3154":90,"_27801":63,"_19254":45372,"_5":13218,"_26298":45303,"_2652":45373},[],"When you receive your instance's credentials, continue with Get started.",{"_3154":91,"_27801":91,"_5":13544,"_2652":45375,"_28144":45376,"_19254":45377,"_26298":91},"Fastlane",[45131,45132,45238],[],{"_3154":92,"_27801":91,"_19254":45379,"_5":13218,"_26298":91,"_2652":45380},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_3154":93,"_27801":91,"_5":28141,"_19254":45382,"_26298":45383,"_2652":45384},[],"/docs/pr-preview/pr-53/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_3154":94,"_27801":91,"_5":28141,"_19254":45386,"_26298":45387,"_2652":45388},[],"/docs/pr-preview/pr-53/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_3154":95,"_27801":91,"_5":28141,"_19254":45390,"_26298":45391,"_2652":45141},[],"/docs/pr-preview/pr-53/deployment/self-hosted/fastlane#before-you-begin",{"_3154":96,"_27801":91,"_5":28141,"_19254":45393,"_26298":45394,"_2652":45395},[],"/docs/pr-preview/pr-53/deployment/self-hosted/fastlane#quick-start","Quick start",{"_3154":97,"_27801":91,"_5":28141,"_19254":45397,"_26298":45398,"_2652":45399},[],"/docs/pr-preview/pr-53/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_3154":98,"_27801":91,"_5":28141,"_19254":45401,"_26298":45402,"_2652":45403},[],"/docs/pr-preview/pr-53/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_3154":99,"_27801":91,"_5":28141,"_19254":45405,"_26298":45406,"_2652":45407},[],"/docs/pr-preview/pr-53/deployment/self-hosted/fastlane#development-mode","Development mode",{"_3154":100,"_27801":91,"_5":28141,"_19254":45409,"_26298":45410,"_2652":45411},[],"/docs/pr-preview/pr-53/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_3154":101,"_27801":91,"_5":28141,"_19254":45413,"_26298":45414,"_2652":45415},[],"/docs/pr-preview/pr-53/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_3154":102,"_27801":91,"_5":28141,"_19254":45417,"_26298":45418,"_2652":45419},[],"/docs/pr-preview/pr-53/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_3154":103,"_27801":91,"_5":28141,"_19254":45421,"_26298":45422,"_2652":45423},[],"/docs/pr-preview/pr-53/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_3154":104,"_27801":91,"_19254":45425,"_5":13218,"_26298":45383,"_2652":45426},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_3154":105,"_27801":91,"_19254":45428,"_5":13218,"_26298":45383,"_2652":45429},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_3154":106,"_27801":91,"_19254":45431,"_5":13218,"_26298":45387,"_2652":45432},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_3154":107,"_27801":91,"_19254":45434,"_5":13218,"_26298":45387,"_2652":45435},[],"Fastlane installs or configures",{"_3154":108,"_27801":91,"_19254":45437,"_5":13218,"_26298":45387,"_2652":45438},[],"You still provide",{"_3154":109,"_27801":91,"_19254":45440,"_5":13218,"_26298":45387,"_2652":45441},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_3154":110,"_27801":91,"_19254":45443,"_5":13218,"_26298":45387,"_2652":45444},[],"The Kubernetes cluster, nodes and persistent storage",{"_3154":111,"_27801":91,"_19254":45446,"_5":13218,"_26298":45387,"_2652":45447},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_3154":112,"_27801":91,"_19254":45449,"_5":13218,"_26298":45387,"_2652":45450},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_3154":113,"_27801":91,"_19254":45452,"_5":13218,"_26298":45387,"_2652":45453},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_3154":114,"_27801":91,"_19254":45455,"_5":13218,"_26298":45387,"_2652":45456},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_3154":115,"_27801":91,"_19254":45458,"_5":13218,"_26298":45387,"_2652":45459},[],"Optional observability and lab HSM components",{"_3154":116,"_27801":91,"_19254":45461,"_5":13218,"_26298":45387,"_2652":45462},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_3154":117,"_27801":91,"_19254":45464,"_5":13218,"_26298":45387,"_2652":45465},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_3154":118,"_27801":91,"_19254":45467,"_5":13218,"_26298":45391,"_2652":45468},[],"You need:",{"_3154":119,"_27801":91,"_19254":45470,"_5":13218,"_26298":45391,"_2652":45471},[],"an existing Kubernetes cluster",{"_3154":120,"_27801":91,"_19254":45473,"_5":13218,"_26298":45391,"_2652":45474},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_3154":121,"_27801":91,"_19254":45476,"_5":13218,"_26298":45391,"_2652":45477},[],"`yq`",{"_3154":122,"_27801":91,"_19254":45479,"_5":13218,"_26298":45391,"_2652":21800},[],{"_3154":123,"_27801":91,"_19254":45481,"_5":13218,"_26298":45391,"_2652":45482},[],"`jq` only when using `--sample-data` or `--development`",{"_3154":124,"_27801":91,"_19254":45484,"_5":13218,"_26298":45391,"_2652":45485},[],"`ssh-keygen` only when using `--with-hsm`",{"_3154":125,"_27801":91,"_19254":45487,"_5":13218,"_26298":45391,"_2652":45488},[],"free external ports 80 and 443 on a single-node K3s host",{"_3154":126,"_27801":91,"_19254":45490,"_5":13218,"_26298":45391,"_2652":45491},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_3154":127,"_27801":91,"_19254":45493,"_5":13218,"_26298":45391,"_2652":45494},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_3154":128,"_27801":91,"_19254":45496,"_5":13218,"_26298":45394,"_2652":45497},[],"Run the script from a clone of the Helm repository:",{"_3154":129,"_27801":91,"_19254":45499,"_5":13218,"_26298":45394,"_2652":45500},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_3154":130,"_27801":91,"_19254":45502,"_5":13218,"_26298":45398,"_2652":45503},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_3154":131,"_27801":91,"_19254":45505,"_5":13218,"_26298":45398,"_2652":45506},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_3154":132,"_27801":91,"_19254":45508,"_5":13218,"_26298":45398,"_2652":45509},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_3154":133,"_27801":91,"_19254":45511,"_5":13218,"_26298":45398,"_2652":45512},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_3154":134,"_27801":91,"_19254":45514,"_5":13218,"_26298":45402,"_2652":45515},[],"Option",{"_3154":135,"_27801":91,"_19254":45517,"_5":13218,"_26298":45402,"_2652":45518},[],"Default",{"_3154":136,"_27801":91,"_19254":45520,"_5":13218,"_26298":45402,"_2652":45521},[],"Purpose",{"_3154":137,"_27801":91,"_19254":45523,"_5":13218,"_26298":45402,"_2652":45524},[],"`-h`, `--help`",{"_3154":138,"_27801":91,"_19254":45526,"_5":13218,"_26298":45402,"_2652":45527},[],"—",{"_3154":139,"_27801":91,"_19254":45529,"_5":13218,"_26298":45402,"_2652":45530},[],"Show help",{"_3154":140,"_27801":91,"_19254":45532,"_5":13218,"_26298":45402,"_2652":45533},[],"`-c`, `--context`",{"_3154":141,"_27801":91,"_19254":45535,"_5":13218,"_26298":45402,"_2652":45536},[],"current context",{"_3154":142,"_27801":91,"_19254":45538,"_5":13218,"_26298":45402,"_2652":45539},[],"Select the kubeconfig context for kubectl and Helm",{"_3154":143,"_27801":91,"_19254":45541,"_5":13218,"_26298":45402,"_2652":45542},[],"`-n`, `--non-interactive`",{"_3154":144,"_27801":91,"_19254":45544,"_5":13218,"_26298":45402,"_2652":5919},[],{"_3154":145,"_27801":91,"_19254":45546,"_5":13218,"_26298":45402,"_2652":45547},[],"Skip prompts and generate dependency credentials",{"_3154":146,"_27801":91,"_19254":45549,"_5":13218,"_26298":45402,"_2652":45550},[],"`-ns`, `--namespace`",{"_3154":147,"_27801":91,"_19254":45552,"_5":13218,"_26298":45402,"_2652":45553},[],"`lamassu-dev`",{"_3154":148,"_27801":91,"_19254":45555,"_5":13218,"_26298":45402,"_2652":45556},[],"Namespace for the installation",{"_3154":149,"_27801":91,"_19254":45558,"_5":13218,"_26298":45402,"_2652":45559},[],"`-d`, `--domain`",{"_3154":150,"_27801":91,"_19254":45561,"_5":13218,"_26298":45402,"_2652":45562},[],"`dev.lamassu.io`",{"_3154":151,"_27801":91,"_19254":45564,"_5":13218,"_26298":45402,"_2652":45565},[],"Domain used by the UI, OIDC and certificate",{"_3154":152,"_27801":91,"_19254":45567,"_5":13218,"_26298":45402,"_2652":45568},[],"`-v`, `--version`",{"_3154":153,"_27801":91,"_19254":45570,"_5":13218,"_26298":45402,"_2652":13843},[],{"_3154":154,"_27801":91,"_19254":45572,"_5":13218,"_26298":45402,"_2652":45573},[],"Lamassu chart version",{"_3154":155,"_27801":91,"_19254":45575,"_5":13218,"_26298":45402,"_2652":45576},[],"`--https-port`",{"_3154":156,"_27801":91,"_19254":45578,"_5":13218,"_26298":45402,"_2652":45579},[],"`443`",{"_3154":157,"_27801":91,"_19254":45581,"_5":13218,"_26298":45402,"_2652":45582},[],"Gateway HTTPS listener port",{"_3154":158,"_27801":91,"_19254":45584,"_5":13218,"_26298":45402,"_2652":45585},[],"`--http-port`",{"_3154":159,"_27801":91,"_19254":45587,"_5":13218,"_26298":45402,"_2652":45588},[],"`80`",{"_3154":160,"_27801":91,"_19254":45590,"_5":13218,"_26298":45402,"_2652":45591},[],"Gateway HTTP listener port",{"_3154":161,"_27801":91,"_19254":45593,"_5":13218,"_26298":45402,"_2652":45594},[],"`--tls-crt`",{"_3154":162,"_27801":91,"_19254":45596,"_5":13218,"_26298":45402,"_2652":45527},[],{"_3154":163,"_27801":91,"_19254":45598,"_5":13218,"_26298":45402,"_2652":45599},[],"PEM certificate for downstream TLS",{"_3154":164,"_27801":91,"_19254":45601,"_5":13218,"_26298":45402,"_2652":45602},[],"`--tls-key`",{"_3154":165,"_27801":91,"_19254":45604,"_5":13218,"_26298":45402,"_2652":45527},[],{"_3154":166,"_27801":91,"_19254":45606,"_5":13218,"_26298":45402,"_2652":45607},[],"PEM private key for downstream TLS",{"_3154":167,"_27801":91,"_19254":45609,"_5":13218,"_26298":45402,"_2652":45610},[],"`-l`, `--local-chart-path`",{"_3154":168,"_27801":91,"_19254":45612,"_5":13218,"_26298":45402,"_2652":45613},[],"repository chart",{"_3154":169,"_27801":91,"_19254":45615,"_5":13218,"_26298":45402,"_2652":45616},[],"Use an unpacked local Lamassu chart",{"_3154":170,"_27801":91,"_19254":45618,"_5":13218,"_26298":45402,"_2652":45619},[],"`-ip`, `--gateway-ip`",{"_3154":171,"_27801":91,"_19254":45621,"_5":13218,"_26298":45402,"_2652":7969},[],{"_3154":172,"_27801":91,"_19254":45623,"_5":13218,"_26298":45402,"_2652":45624},[],"Override the address written to `gateway.addresses`",{"_3154":173,"_27801":91,"_19254":45626,"_5":13218,"_26298":45402,"_2652":45627},[],"`--otel`",{"_3154":174,"_27801":91,"_19254":45629,"_5":13218,"_26298":45402,"_2652":5919},[],{"_3154":175,"_27801":91,"_19254":45631,"_5":13218,"_26298":45402,"_2652":45632},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_3154":176,"_27801":91,"_19254":45634,"_5":13218,"_26298":45402,"_2652":45635},[],"`--development`",{"_3154":177,"_27801":91,"_19254":45637,"_5":13218,"_26298":45402,"_2652":5919},[],{"_3154":178,"_27801":91,"_19254":45639,"_5":13218,"_26298":45402,"_2652":45640},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_3154":179,"_27801":91,"_19254":45642,"_5":13218,"_26298":45402,"_2652":45643},[],"`--sample-data`",{"_3154":180,"_27801":91,"_19254":45645,"_5":13218,"_26298":45402,"_2652":5919},[],{"_3154":181,"_27801":91,"_19254":45647,"_5":13218,"_26298":45402,"_2652":45648},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_3154":182,"_27801":91,"_19254":45650,"_5":13218,"_26298":45402,"_2652":45651},[],"`--with-hsm`",{"_3154":183,"_27801":91,"_19254":45653,"_5":13218,"_26298":45402,"_2652":5919},[],{"_3154":184,"_27801":91,"_19254":45655,"_5":13218,"_26298":45402,"_2652":45656},[],"Install lab HSM components and configure KMS for PKCS#11",{"_3154":185,"_27801":91,"_19254":45658,"_5":13218,"_26298":45402,"_2652":45659},[],"`--softhsm-chart-path`",{"_3154":186,"_27801":91,"_19254":45661,"_5":13218,"_26298":45402,"_2652":45662},[],"`./charts/softhsm`",{"_3154":187,"_27801":91,"_19254":45664,"_5":13218,"_26298":45402,"_2652":45665},[],"Use a different local SoftHSM chart",{"_3154":188,"_27801":91,"_19254":45667,"_5":13218,"_26298":45402,"_2652":45668},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_3154":189,"_27801":91,"_19254":45670,"_5":13218,"_26298":45406,"_2652":45671},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_3154":190,"_27801":91,"_19254":45673,"_5":13218,"_26298":45406,"_2652":45674},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_3154":191,"_27801":91,"_19254":45676,"_5":13218,"_26298":45406,"_2652":45677},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_3154":192,"_27801":91,"_19254":45679,"_5":13218,"_26298":45406,"_2652":45680},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_3154":193,"_27801":91,"_19254":45682,"_5":13218,"_26298":45406,"_2652":45683},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_3154":194,"_27801":91,"_19254":45685,"_5":13218,"_26298":45406,"_2652":45686},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_3154":195,"_27801":91,"_19254":45688,"_5":13218,"_26298":45410,"_2652":45689},[],"Fastlane:",{"_3154":196,"_27801":91,"_19254":45691,"_5":13218,"_26298":45410,"_2652":45692},[],"validates local tools and the selected cluster",{"_3154":197,"_27801":91,"_19254":45694,"_5":13218,"_26298":45410,"_2652":45695},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_3154":198,"_27801":91,"_19254":45697,"_5":13218,"_26298":45410,"_2652":45698},[],"creates the namespace",{"_3154":199,"_27801":91,"_19254":45700,"_5":13218,"_26298":45410,"_2652":45701},[],"installs PostgreSQL and creates the required databases",{"_3154":200,"_27801":91,"_19254":45703,"_5":13218,"_26298":45410,"_2652":45704},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_3154":201,"_27801":91,"_19254":45706,"_5":13218,"_26298":45410,"_2652":45707},[],"installs RabbitMQ",{"_3154":202,"_27801":91,"_19254":45709,"_5":13218,"_26298":45410,"_2652":45710},[],"optionally installs observability and lab HSM components",{"_3154":203,"_27801":91,"_19254":45712,"_5":13218,"_26298":45410,"_2652":45713},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_3154":204,"_27801":91,"_19254":45715,"_5":13218,"_26298":45410,"_2652":45716},[],"optionally loads sample data",{"_3154":205,"_27801":91,"_19254":45718,"_5":13218,"_26298":45410,"_2652":45719},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_3154":206,"_27801":91,"_19254":45721,"_5":13218,"_26298":45414,"_2652":45722},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_3154":207,"_27801":91,"_19254":45724,"_5":13218,"_26298":45414,"_2652":45725},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_3154":208,"_27801":91,"_19254":45727,"_5":13218,"_26298":45418,"_2652":45728},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_3154":209,"_27801":91,"_19254":45730,"_5":13218,"_26298":45418,"_2652":45731},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_3154":210,"_27801":91,"_19254":45733,"_5":13218,"_26298":45418,"_2652":45734},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_3154":211,"_27801":91,"_19254":45736,"_5":13218,"_26298":45422,"_2652":45737},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_3154":212,"_27801":212,"_5":13544,"_2652":45739,"_28144":45740,"_19254":45741,"_26298":212},"Install with Helm",[45131,45132,45238],[],{"_3154":213,"_27801":212,"_19254":45743,"_5":13218,"_26298":212,"_2652":45744},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_3154":214,"_27801":212,"_5":28141,"_19254":45746,"_26298":45747,"_2652":45748},[],"/docs/pr-preview/pr-53/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_3154":215,"_27801":212,"_5":28141,"_19254":45750,"_26298":45751,"_2652":45141},[],"/docs/pr-preview/pr-53/deployment/self-hosted/helm#before-you-begin",{"_3154":216,"_27801":212,"_5":28141,"_19254":45753,"_26298":45754,"_2652":45755},[],"/docs/pr-preview/pr-53/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_3154":217,"_27801":212,"_5":28141,"_19254":45757,"_26298":45758,"_2652":45759},[],"/docs/pr-preview/pr-53/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_3154":218,"_27801":212,"_5":28141,"_19254":45761,"_26298":45762,"_2652":45763},[],"/docs/pr-preview/pr-53/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_3154":219,"_27801":212,"_5":28141,"_19254":45765,"_26298":45766,"_2652":45767},[],"/docs/pr-preview/pr-53/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_3154":220,"_27801":212,"_5":28141,"_19254":45769,"_26298":45770,"_2652":45771},[],"/docs/pr-preview/pr-53/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_3154":221,"_27801":212,"_5":28141,"_19254":45773,"_26298":45774,"_2652":45775},[],"/docs/pr-preview/pr-53/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_3154":222,"_27801":212,"_5":28141,"_19254":45777,"_26298":45778,"_2652":45779},[],"/docs/pr-preview/pr-53/deployment/self-hosted/helm#production-decisions","Production decisions",{"_3154":223,"_27801":212,"_19254":45781,"_5":13218,"_26298":45747,"_2652":45782},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_3154":224,"_27801":212,"_19254":45784,"_5":13218,"_26298":45751,"_2652":45785},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_3154":225,"_27801":212,"_19254":45787,"_5":13218,"_26298":45751,"_2652":45788},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_3154":226,"_27801":212,"_19254":45790,"_5":13218,"_26298":45751,"_2652":45791},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_3154":227,"_27801":212,"_19254":45793,"_5":13218,"_26298":45751,"_2652":45794},[],"a reachable RabbitMQ broker and credentials",{"_3154":228,"_27801":212,"_19254":45796,"_5":13218,"_26298":45751,"_2652":45797},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_3154":229,"_27801":212,"_19254":45799,"_5":13218,"_26298":45751,"_2652":45800},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_3154":230,"_27801":212,"_19254":45802,"_5":13218,"_26298":45751,"_2652":45803},[],"cert-manager 1.14+ (only for the default `tls.type: certManager` mode); for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_3154":231,"_27801":212,"_19254":45805,"_5":13218,"_26298":45751,"_2652":45806},[],"a StorageClass and an external traffic design",{"_3154":232,"_27801":212,"_19254":45808,"_5":13218,"_26298":45751,"_2652":45809},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_3154":233,"_27801":212,"_19254":45811,"_5":13218,"_26298":45751,"_2652":45812},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_3154":234,"_27801":212,"_19254":45814,"_5":13218,"_26298":45751,"_2652":45815},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_3154":235,"_27801":212,"_19254":45817,"_5":13218,"_26298":45754,"_2652":45818},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_3154":236,"_27801":212,"_19254":45820,"_5":13218,"_26298":45754,"_2652":45821},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_3154":237,"_27801":212,"_19254":45823,"_5":13218,"_26298":45754,"_2652":45824},[],"Install cert-manager separately before Lamassu, but only for the default `tls.type: certManager` mode. In that mode the chart renders its self-signed Issuer and CA Certificate resources regardless of whether `tls.certManagerOptions.clusterIssuer` is set, so cert-manager stays a prerequisite. With `tls.type: external`, the chart renders no cert-manager resources and the Gateway terminates TLS with an existing Secret you provide instead.",{"_3154":238,"_27801":212,"_19254":45826,"_5":13218,"_26298":45758,"_2652":45827},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_3154":239,"_27801":212,"_19254":45829,"_5":13218,"_26298":45758,"_2652":45830},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_3154":240,"_27801":212,"_19254":45832,"_5":13218,"_26298":45758,"_2652":45833},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_3154":241,"_27801":212,"_19254":45835,"_5":13218,"_26298":45762,"_2652":45836},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it. The Secret must already exist before installing: in `external` mode the chart renders no cert-manager resources and never creates this Secret.",{"_3154":242,"_27801":212,"_19254":45838,"_5":13218,"_26298":45766,"_2652":45839},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_3154":243,"_27801":212,"_19254":45841,"_5":13218,"_26298":45766,"_2652":45842},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_3154":244,"_27801":212,"_19254":45844,"_5":13218,"_26298":45766,"_2652":45845},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_3154":245,"_27801":212,"_19254":45847,"_5":13218,"_26298":45766,"_2652":45848},[],"See Access control for the principal and policy model.",{"_3154":246,"_27801":212,"_19254":45850,"_5":13218,"_26298":45770,"_2652":45851},[],"To install a local checkout instead:",{"_3154":247,"_27801":212,"_19254":45853,"_5":13218,"_26298":45774,"_2652":45854},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_3154":248,"_27801":212,"_19254":45856,"_5":13218,"_26298":45774,"_2652":45857},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_3154":249,"_27801":212,"_19254":45859,"_5":13218,"_26298":45778,"_2652":45860},[],"Before going live, review:",{"_3154":250,"_27801":212,"_19254":45862,"_5":13218,"_26298":45778,"_2652":45863},[],"backup and recovery for PostgreSQL and persistent volumes",{"_3154":251,"_27801":212,"_19254":45865,"_5":13218,"_26298":45778,"_2652":45866},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_3154":252,"_27801":212,"_19254":45868,"_5":13218,"_26298":45778,"_2652":45869},[],"shared VA storage before increasing VA replicas",{"_3154":253,"_27801":212,"_19254":45871,"_5":13218,"_26298":45778,"_2652":45872},[],"managed OIDC roles and removal of evaluation credentials",{"_3154":254,"_27801":212,"_19254":45874,"_5":13218,"_26298":45778,"_2652":45875},[],"a trusted TLS issuer or externally managed certificate",{"_3154":255,"_27801":212,"_19254":45877,"_5":13218,"_26298":45778,"_2652":45878},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_3154":256,"_27801":212,"_19254":45880,"_5":13218,"_26298":45778,"_2652":45881},[],"SMTP, observability and alert delivery",{"_3154":257,"_27801":212,"_19254":45883,"_5":13218,"_26298":45778,"_2652":45884},[],"the version upgrade guides and the notes in `charts/lamassu/CHANGELOG/` before every upgrade",{"_3154":258,"_27801":212,"_19254":45886,"_5":13218,"_26298":45778,"_2652":45887},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_3154":259,"_27801":259,"_5":13544,"_2652":45889,"_28144":45890,"_19254":45891,"_26298":259},"Expose the Gateway",[45131,45132,45238],[],{"_3154":260,"_27801":259,"_19254":45893,"_5":13218,"_26298":259,"_2652":45894},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_3154":261,"_27801":259,"_5":28141,"_19254":45896,"_26298":45897,"_2652":45898},[],"/docs/pr-preview/pr-53/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_3154":262,"_27801":259,"_5":28141,"_19254":45900,"_26298":45901,"_2652":45902},[],"/docs/pr-preview/pr-53/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_3154":263,"_27801":259,"_5":28141,"_19254":45904,"_26298":45905,"_2652":45906},[],"/docs/pr-preview/pr-53/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_3154":264,"_27801":259,"_5":28141,"_19254":45908,"_26298":45909,"_2652":45910},[],"/docs/pr-preview/pr-53/deployment/self-hosted/networking#k3s","K3s",{"_3154":265,"_27801":259,"_5":28141,"_19254":45912,"_26298":45913,"_2652":45914},[],"/docs/pr-preview/pr-53/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_3154":266,"_27801":259,"_5":28141,"_19254":45916,"_26298":45917,"_2652":45918},[],"/docs/pr-preview/pr-53/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_3154":267,"_27801":259,"_5":28141,"_19254":45920,"_26298":45921,"_2652":45922},[],"/docs/pr-preview/pr-53/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_3154":268,"_27801":259,"_5":28141,"_19254":45924,"_26298":45925,"_2652":45926},[],"/docs/pr-preview/pr-53/deployment/self-hosted/networking#decision-guide","Decision guide",{"_3154":269,"_27801":259,"_5":28141,"_19254":45928,"_26298":45929,"_2652":45930},[],"/docs/pr-preview/pr-53/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_3154":270,"_27801":259,"_19254":45932,"_5":13218,"_26298":45897,"_2652":45933},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_3154":271,"_27801":259,"_19254":45935,"_5":13218,"_26298":45897,"_2652":45936},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_3154":272,"_27801":259,"_19254":45938,"_5":13218,"_26298":45901,"_2652":45939},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_3154":273,"_27801":259,"_19254":45941,"_5":13218,"_26298":45901,"_2652":45942},[],"Set it only when:",{"_3154":274,"_27801":259,"_19254":45944,"_5":13218,"_26298":45901,"_2652":45945},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_3154":275,"_27801":259,"_19254":45947,"_5":13218,"_26298":45901,"_2652":45948},[],"that address is allocated to this Gateway",{"_3154":276,"_27801":259,"_19254":45950,"_5":13218,"_26298":45901,"_2652":45951},[],"the surrounding network already routes traffic for it to the cluster",{"_3154":277,"_27801":259,"_19254":45953,"_5":13218,"_26298":45901,"_2652":45954},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_3154":278,"_27801":259,"_19254":45956,"_5":13218,"_26298":45901,"_2652":45957},[],"Keep these two settings separate:",{"_3154":279,"_27801":259,"_19254":45959,"_5":13218,"_26298":45901,"_2652":45960},[],"`gateway.addresses` requests an address for the Gateway.",{"_3154":280,"_27801":259,"_19254":45962,"_5":13218,"_26298":45901,"_2652":45963},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_3154":281,"_27801":259,"_19254":45965,"_5":13218,"_26298":45901,"_2652":45966},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_3154":282,"_27801":259,"_19254":45968,"_5":13218,"_26298":45905,"_2652":45969},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_3154":283,"_27801":259,"_19254":45971,"_5":13218,"_26298":45905,"_2652":45972},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_3154":284,"_27801":259,"_19254":45974,"_5":13218,"_26298":45909,"_2652":45975},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_3154":285,"_27801":259,"_19254":45977,"_5":13218,"_26298":45909,"_2652":45978},[],"For the recommended design:",{"_3154":286,"_27801":259,"_19254":45980,"_5":13218,"_26298":45909,"_2652":45981},[],"Use only one externally exposed Lamassu Gateway.",{"_3154":287,"_27801":259,"_19254":45983,"_5":13218,"_26298":45909,"_2652":45984},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_3154":288,"_27801":259,"_19254":45986,"_5":13218,"_26298":45909,"_2652":45987},[],"Allow those ports through the VM firewall and any upstream security group.",{"_3154":289,"_27801":259,"_19254":45989,"_5":13218,"_26298":45909,"_2652":45990},[],"Point DNS at the VM's reachable address.",{"_3154":290,"_27801":259,"_19254":45992,"_5":13218,"_26298":45909,"_2652":45993},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_3154":291,"_27801":259,"_19254":45995,"_5":13218,"_26298":45913,"_2652":45996},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_3154":292,"_27801":259,"_19254":45998,"_5":13218,"_26298":45917,"_2652":45999},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_3154":293,"_27801":259,"_19254":46001,"_5":13218,"_26298":45917,"_2652":46002},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_3154":294,"_27801":259,"_19254":46004,"_5":13218,"_26298":45921,"_2652":46005},[],"First decide whether you need three independent data planes or only three hostnames.",{"_3154":295,"_27801":259,"_19254":46007,"_5":13218,"_26298":45921,"_2652":46008},[],"Requirement",{"_3154":296,"_27801":259,"_19254":46010,"_5":13218,"_26298":45921,"_2652":46011},[],"Recommended design",{"_3154":297,"_27801":259,"_19254":46013,"_5":13218,"_26298":45921,"_2652":46014},[],"Consequence",{"_3154":298,"_27801":259,"_19254":46016,"_5":13218,"_26298":45921,"_2652":46017},[],"Several Lamassu URLs or services",{"_3154":299,"_27801":259,"_19254":46019,"_5":13218,"_26298":45921,"_2652":46020},[],"One Gateway with multiple routes",{"_3154":300,"_27801":259,"_19254":46022,"_5":13218,"_26298":45921,"_2652":46023},[],"One IP and one proxy fleet; this is the chart default",{"_3154":301,"_27801":259,"_19254":46025,"_5":13218,"_26298":45921,"_2652":46026},[],"Independent Gateways and separate external IPs",{"_3154":302,"_27801":259,"_19254":46028,"_5":13218,"_26298":45921,"_2652":46029},[],"One VIP per Gateway",{"_3154":303,"_27801":259,"_19254":46031,"_5":13218,"_26298":45921,"_2652":46032},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_3154":304,"_27801":259,"_19254":46034,"_5":13218,"_26298":45921,"_2652":46035},[],"Independent Gateways on one node and one IP",{"_3154":305,"_27801":259,"_19254":46037,"_5":13218,"_26298":45921,"_2652":46038},[],"Use different external ports",{"_3154":306,"_27801":259,"_19254":46040,"_5":13218,"_26298":45921,"_2652":46041},[],"Clients must include non-standard ports",{"_3154":307,"_27801":259,"_19254":46043,"_5":13218,"_26298":45921,"_2652":46044},[],"Separate TLS/mTLS termination behind one IP",{"_3154":308,"_27801":259,"_19254":46046,"_5":13218,"_26298":45921,"_2652":46047},[],"Front-door SNI routing to internal Gateways",{"_3154":309,"_27801":259,"_19254":46049,"_5":13218,"_26298":45921,"_2652":46050},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_3154":310,"_27801":259,"_19254":46052,"_5":13218,"_26298":45921,"_2652":46053},[],"Separate Gateway resources but shared proxy infrastructure",{"_3154":311,"_27801":259,"_19254":46055,"_5":13218,"_26298":45921,"_2652":46056},[],"Envoy merged-Gateway mode",{"_3154":312,"_27801":259,"_19254":46058,"_5":13218,"_26298":45921,"_2652":46059},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_3154":313,"_27801":259,"_19254":46061,"_5":13218,"_26298":45921,"_2652":46062},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_3154":314,"_27801":259,"_19254":46064,"_5":13218,"_26298":45921,"_2652":46065},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_3154":315,"_27801":259,"_19254":46067,"_5":13218,"_26298":45921,"_2652":46068},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_3154":316,"_27801":259,"_19254":46070,"_5":13218,"_26298":45921,"_2652":46071},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_3154":317,"_27801":259,"_19254":46073,"_5":13218,"_26298":45925,"_2652":46074},[],"If one Gateway can own TLS and routing, use the chart default.",{"_3154":318,"_27801":259,"_19254":46076,"_5":13218,"_26298":45925,"_2652":46077},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_3154":319,"_27801":259,"_19254":46079,"_5":13218,"_26298":45925,"_2652":46080},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_3154":320,"_27801":259,"_19254":46082,"_5":13218,"_26298":45925,"_2652":46083},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_3154":321,"_27801":259,"_19254":46085,"_5":13218,"_26298":45925,"_2652":46086},[],"If none of those are possible, use different external ports or change the external network design.",{"_3154":322,"_27801":259,"_19254":46088,"_5":13218,"_26298":45929,"_2652":46089},[],"Check, in order:",{"_3154":323,"_27801":259,"_19254":46091,"_5":13218,"_26298":45929,"_2652":46092},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_3154":324,"_27801":259,"_19254":46094,"_5":13218,"_26298":45929,"_2652":46095},[],"Its status contains the expected address.",{"_3154":325,"_27801":259,"_19254":46097,"_5":13218,"_26298":45929,"_2652":46098},[],"The generated `LoadBalancer` Service has a usable external address.",{"_3154":326,"_27801":259,"_19254":46100,"_5":13218,"_26298":45929,"_2652":46101},[],"Port 443 reaches that address from the client network.",{"_3154":327,"_27801":259,"_19254":46103,"_5":13218,"_26298":45929,"_2652":46104},[],"DNS resolves to the externally reachable endpoint.",{"_3154":328,"_27801":259,"_19254":46106,"_5":13218,"_26298":45929,"_2652":46107},[],"The certificate contains the DNS name or IP used by the client.",{"_3154":329,"_27801":259,"_19254":46109,"_5":13218,"_26298":45929,"_2652":46110},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_3154":330,"_27801":330,"_5":13544,"_2652":45238,"_28144":46112,"_19254":46113,"_26298":330},[45131,45132,45238],[],{"_3154":331,"_27801":330,"_19254":46115,"_5":13218,"_26298":330,"_2652":46116},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_3154":332,"_27801":330,"_5":28141,"_19254":46118,"_26298":46119,"_2652":46120},[],"/docs/pr-preview/pr-53/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_3154":333,"_27801":330,"_5":28141,"_19254":46122,"_26298":46123,"_2652":46124},[],"/docs/pr-preview/pr-53/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_3154":334,"_27801":330,"_5":28141,"_19254":46126,"_26298":46127,"_2652":46128},[],"/docs/pr-preview/pr-53/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_3154":335,"_27801":330,"_5":28141,"_19254":46130,"_26298":46131,"_2652":46132},[],"/docs/pr-preview/pr-53/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_3154":336,"_27801":330,"_5":28141,"_19254":46134,"_26298":46135,"_2652":46136},[],"/docs/pr-preview/pr-53/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_3154":337,"_27801":330,"_5":28141,"_19254":46138,"_26298":46139,"_2652":46140},[],"/docs/pr-preview/pr-53/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_3154":338,"_27801":330,"_19254":46142,"_5":13218,"_26298":46119,"_2652":46143},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_3154":339,"_27801":330,"_19254":46145,"_5":13218,"_26298":46123,"_2652":46146},[],"Workflow",{"_3154":340,"_27801":330,"_19254":46148,"_5":13218,"_26298":46123,"_2652":46149},[],"Use it for",{"_3154":341,"_27801":330,"_19254":46151,"_5":13218,"_26298":46123,"_2652":46152},[],"What it installs",{"_3154":342,"_27801":330,"_19254":46154,"_5":13218,"_26298":46123,"_2652":46155},[],"Helm",{"_3154":343,"_27801":330,"_19254":46157,"_5":13218,"_26298":46123,"_2652":46158},[],"Production and controlled environments",{"_3154":344,"_27801":330,"_19254":46160,"_5":13218,"_26298":46123,"_2652":46161},[],"Lamassu services and Gateway API resources",{"_3154":345,"_27801":330,"_19254":46163,"_5":13218,"_26298":46123,"_2652":45375},[],{"_3154":346,"_27801":330,"_19254":46165,"_5":13218,"_26298":46123,"_2652":46166},[],"Evaluation, demos, CI and small lab clusters",{"_3154":347,"_27801":330,"_19254":46168,"_5":13218,"_26298":46123,"_2652":46169},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_3154":348,"_27801":330,"_19254":46171,"_5":13218,"_26298":46127,"_2652":46172},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_3154":349,"_27801":330,"_19254":46174,"_5":13218,"_26298":46127,"_2652":46175},[],"Area",{"_3154":350,"_27801":330,"_19254":46177,"_5":13218,"_26298":46127,"_2652":46178},[],"The Lamassu chart provides",{"_3154":351,"_27801":330,"_19254":46180,"_5":13218,"_26298":46127,"_2652":46181},[],"You provide",{"_3154":352,"_27801":330,"_19254":46183,"_5":13218,"_26298":46127,"_2652":46184},[],"Lamassu applications",{"_3154":353,"_27801":330,"_19254":46186,"_5":13218,"_26298":46127,"_2652":46187},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_3154":354,"_27801":330,"_19254":46189,"_5":13218,"_26298":46127,"_2652":46190},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_3154":355,"_27801":330,"_19254":46192,"_5":13218,"_26298":46127,"_2652":46193},[],"PostgreSQL data",{"_3154":356,"_27801":330,"_19254":46195,"_5":13218,"_26298":46127,"_2652":46196},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_3154":357,"_27801":330,"_19254":46198,"_5":13218,"_26298":46127,"_2652":46199},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_3154":358,"_27801":330,"_19254":46201,"_5":13218,"_26298":46127,"_2652":46202},[],"Messaging",{"_3154":359,"_27801":330,"_19254":46204,"_5":13218,"_26298":46127,"_2652":46205},[],"RabbitMQ connection configuration for the Lamassu services",{"_3154":360,"_27801":330,"_19254":46207,"_5":13218,"_26298":46127,"_2652":46208},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_3154":361,"_27801":330,"_19254":46210,"_5":13218,"_26298":46127,"_2652":46211},[],"Identity",{"_3154":362,"_27801":330,"_19254":46213,"_5":13218,"_26298":46127,"_2652":46214},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_3154":363,"_27801":330,"_19254":46216,"_5":13218,"_26298":46127,"_2652":46217},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_3154":364,"_27801":330,"_19254":46219,"_5":13218,"_26298":46127,"_2652":46220},[],"External routing",{"_3154":365,"_27801":330,"_19254":46222,"_5":13218,"_26298":46127,"_2652":46223},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_3154":366,"_27801":330,"_19254":46225,"_5":13218,"_26298":46127,"_2652":46226},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_3154":367,"_27801":330,"_19254":46228,"_5":13218,"_26298":46127,"_2652":46229},[],"TLS",{"_3154":368,"_27801":330,"_19254":46231,"_5":13218,"_26298":46127,"_2652":46232},[],"In the default `tls.type: certManager` mode, cert-manager `Issuer` and CA `Certificate` resources and a chart-managed downstream `Certificate`; in the `tls.type: external` mode, a reference to your TLS Secret",{"_3154":369,"_27801":330,"_19254":46234,"_5":13218,"_26298":46127,"_2652":46235},[],"cert-manager only for the default `tls.type: certManager` mode; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_3154":370,"_27801":330,"_19254":46237,"_5":13218,"_26298":46127,"_2652":46238},[],"Persistent application data",{"_3154":371,"_27801":330,"_19254":46240,"_5":13218,"_26298":46127,"_2652":46241},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_3154":372,"_27801":330,"_19254":46243,"_5":13218,"_26298":46127,"_2652":46244},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_3154":373,"_27801":330,"_19254":46246,"_5":13218,"_26298":46127,"_2652":46247},[],"Optional integrations",{"_3154":374,"_27801":330,"_19254":46249,"_5":13218,"_26298":46127,"_2652":46250},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_3154":375,"_27801":330,"_19254":46252,"_5":13218,"_26298":46127,"_2652":46253},[],"The observability backends, cloud credentials and production HSM or external key service",{"_3154":376,"_27801":330,"_19254":46255,"_5":13218,"_26298":46127,"_2652":46256},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_3154":377,"_27801":330,"_19254":46258,"_5":13218,"_26298":46127,"_2652":46259},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_3154":378,"_27801":330,"_19254":46261,"_5":13218,"_26298":46131,"_2652":46262},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_3154":379,"_27801":330,"_19254":46264,"_5":13218,"_26298":46131,"_2652":46265},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_3154":380,"_27801":330,"_19254":46267,"_5":13218,"_26298":46135,"_2652":46268},[],"Kubernetes 1.24 or newer",{"_3154":381,"_27801":330,"_19254":46270,"_5":13218,"_26298":46135,"_2652":46271},[],"Helm 3.2 or newer",{"_3154":382,"_27801":330,"_19254":46273,"_5":13218,"_26298":46135,"_2652":46274},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_3154":383,"_27801":330,"_19254":46276,"_5":13218,"_26298":46135,"_2652":46277},[],"cert-manager 1.14 or newer; required only for the default `tls.type: certManager` TLS mode, not for `tls.type: external`",{"_3154":384,"_27801":330,"_19254":46279,"_5":13218,"_26298":46135,"_2652":46280},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_3154":385,"_27801":330,"_19254":46282,"_5":13218,"_26298":46135,"_2652":46283},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_3154":386,"_27801":330,"_19254":46285,"_5":13218,"_26298":46135,"_2652":46286},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_3154":387,"_27801":330,"_19254":46288,"_5":13218,"_26298":46139,"_2652":46289},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3154":388,"_27801":330,"_19254":46291,"_5":13218,"_26298":46139,"_2652":46292},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3154":389,"_27801":330,"_19254":46294,"_5":13218,"_26298":46139,"_2652":46295},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3154":390,"_27801":330,"_19254":46297,"_5":13218,"_26298":46139,"_2652":46298},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3154":391,"_27801":391,"_5":13544,"_2652":46300,"_28144":46301,"_19254":46303,"_26298":391},"Deployment troubleshooting",[45131,45132,46302],"Operations",[],{"_3154":392,"_27801":391,"_19254":46305,"_5":13218,"_26298":391,"_2652":46306},[],"Diagnose access, service health and infrastructure dependencies.",{"_3154":393,"_27801":391,"_5":28141,"_19254":46308,"_26298":46309,"_2652":46310},[],"/docs/pr-preview/pr-53/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_3154":394,"_27801":391,"_5":28141,"_19254":46312,"_26298":46313,"_2652":46314},[],"/docs/pr-preview/pr-53/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_3154":395,"_27801":391,"_5":28141,"_19254":46316,"_26298":46317,"_2652":46318},[],"/docs/pr-preview/pr-53/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_3154":396,"_27801":391,"_5":28141,"_19254":46320,"_26298":46321,"_2652":46322},[],"/docs/pr-preview/pr-53/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_3154":397,"_27801":391,"_5":28141,"_19254":46324,"_26298":46325,"_2652":46326},[],"/docs/pr-preview/pr-53/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_3154":398,"_27801":391,"_5":28141,"_19254":46328,"_26298":46329,"_2652":46330},[],"/docs/pr-preview/pr-53/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_3154":399,"_27801":391,"_5":28141,"_19254":46332,"_26298":46333,"_2652":46334},[],"/docs/pr-preview/pr-53/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_3154":400,"_27801":391,"_5":28141,"_19254":46336,"_26298":46337,"_2652":46338},[],"/docs/pr-preview/pr-53/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_3154":401,"_27801":391,"_5":28141,"_19254":46340,"_26298":46341,"_2652":46342},[],"/docs/pr-preview/pr-53/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_3154":402,"_27801":391,"_5":28141,"_19254":46344,"_26298":46345,"_2652":46346},[],"/docs/pr-preview/pr-53/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_3154":403,"_27801":391,"_5":28141,"_19254":46348,"_26298":46349,"_2652":46350},[],"/docs/pr-preview/pr-53/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_3154":404,"_27801":391,"_5":28141,"_19254":46352,"_26298":46353,"_2652":46354},[],"/docs/pr-preview/pr-53/deployment/troubleshooting#observability","Observability",{"_3154":405,"_27801":391,"_19254":46356,"_5":13218,"_26298":391,"_2652":46357},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_3154":406,"_27801":391,"_19254":46359,"_5":13218,"_26298":46313,"_2652":46360},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_3154":407,"_27801":391,"_19254":46362,"_5":13218,"_26298":46317,"_2652":46363},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_3154":408,"_27801":391,"_19254":46365,"_5":13218,"_26298":46321,"_2652":46366},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_3154":409,"_27801":391,"_19254":46368,"_5":13218,"_26298":46325,"_2652":46369},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_3154":410,"_27801":391,"_19254":46371,"_5":13218,"_26298":46329,"_2652":46372},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_3154":411,"_27801":391,"_19254":46374,"_5":13218,"_26298":46333,"_2652":46375},[],"Replace the placeholders with your real release, namespace and deployment.",{"_3154":412,"_27801":391,"_19254":46377,"_5":13218,"_26298":46333,"_2652":46378},[],"Also run the chart's connectivity test:",{"_3154":413,"_27801":391,"_19254":46380,"_5":13218,"_26298":46333,"_2652":46381},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_3154":414,"_27801":391,"_19254":46383,"_5":13218,"_26298":46333,"_2652":46384},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_3154":415,"_27801":391,"_19254":46386,"_5":13218,"_26298":46337,"_2652":46387},[],"If you receive a 401:",{"_3154":416,"_27801":391,"_19254":46389,"_5":13218,"_26298":46337,"_2652":46390},[],"check that the UI's OIDC authority is reachable from the browser;",{"_3154":417,"_27801":391,"_19254":46392,"_5":13218,"_26298":46337,"_2652":46393},[],"verify issuer, audience and expiration of the token;",{"_3154":418,"_27801":391,"_19254":46395,"_5":13218,"_26298":46337,"_2652":46396},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_3154":419,"_27801":391,"_19254":46398,"_5":13218,"_26298":46337,"_2652":46399},[],"check that the provider's public and internal routes point to the same realm.",{"_3154":420,"_27801":391,"_19254":46401,"_5":13218,"_26298":46337,"_2652":46402},[],"If login succeeds but the APIs return 403:",{"_3154":421,"_27801":391,"_19254":46404,"_5":13218,"_26298":46337,"_2652":46405},[],"inspect the token's real claims;",{"_3154":422,"_27801":391,"_19254":46407,"_5":13218,"_26298":46337,"_2652":46408},[],"confirm they match an active principal;",{"_3154":423,"_27801":391,"_19254":46410,"_5":13218,"_26298":46337,"_2652":46411},[],"review the policies granted to that principal;",{"_3154":424,"_27801":391,"_19254":46413,"_5":13218,"_26298":46337,"_2652":46414},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_3154":425,"_27801":391,"_19254":46416,"_5":13218,"_26298":46337,"_2652":46417},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_3154":426,"_27801":391,"_19254":46419,"_5":13218,"_26298":46341,"_2652":46420},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_3154":427,"_27801":391,"_19254":46422,"_5":13218,"_26298":46341,"_2652":46423},[],"Locate the authz pod and Service.",{"_3154":428,"_27801":391,"_19254":46425,"_5":13218,"_26298":46341,"_2652":46426},[],"Check /health, logs and its database connection.",{"_3154":429,"_27801":391,"_19254":46428,"_5":13218,"_26298":46341,"_2652":46429},[],"Verify the DNS and port configured in externalAuthorization.",{"_3154":430,"_27801":391,"_19254":46431,"_5":13218,"_26298":46341,"_2652":46432},[],"Check the check route is /v1/ext\\_authz/check.",{"_3154":431,"_27801":391,"_19254":46434,"_5":13218,"_26298":46341,"_2652":46435},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_3154":432,"_27801":391,"_19254":46437,"_5":13218,"_26298":46345,"_2652":46438},[],"Review kubectl describe pod first. Common causes are:",{"_3154":433,"_27801":391,"_19254":46440,"_5":13218,"_26298":46345,"_2652":46441},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_3154":434,"_27801":391,"_19254":46443,"_5":13218,"_26298":46345,"_2652":46444},[],"unbound persistent volume;",{"_3154":435,"_27801":391,"_19254":46446,"_5":13218,"_26298":46345,"_2652":46447},[],"inaccessible image or incorrect pull policy;",{"_3154":436,"_27801":391,"_19254":46449,"_5":13218,"_26298":46345,"_2652":46450},[],"invalid cryptographic engine configuration;",{"_3154":437,"_27801":391,"_19254":46452,"_5":13218,"_26298":46345,"_2652":46453},[],"CPU or memory limits set too low;",{"_3154":438,"_27801":391,"_19254":46455,"_5":13218,"_26298":46345,"_2652":46456},[],"an incomplete prior migration.",{"_3154":439,"_27801":391,"_19254":46458,"_5":13218,"_26298":46345,"_2652":46459},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_3154":440,"_27801":391,"_19254":46461,"_5":13218,"_26298":46345,"_2652":46462},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_3154":441,"_27801":391,"_19254":46464,"_5":13218,"_26298":46349,"_2652":46465},[],"Domain and audit events depend on the bus publisher:",{"_3154":442,"_27801":391,"_19254":46467,"_5":13218,"_26298":46349,"_2652":46468},[],"verify it is enabled in the emitting service;",{"_3154":443,"_27801":391,"_19254":46470,"_5":13218,"_26298":46349,"_2652":46471},[],"check AMQP connectivity and credentials;",{"_3154":444,"_27801":391,"_19254":46473,"_5":13218,"_26298":46349,"_2652":46474},[],"review exchange, routing key, queues and consumers;",{"_3154":445,"_27801":391,"_19254":46476,"_5":13218,"_26298":46349,"_2652":46477},[],"inspect dead-letter queues;",{"_3154":446,"_27801":391,"_19254":46479,"_5":13218,"_26298":46349,"_2652":46480},[],"alert on orphan durable queues and backlog growth.",{"_3154":447,"_27801":391,"_19254":46482,"_5":13218,"_26298":46349,"_2652":46483},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_3154":448,"_27801":391,"_19254":46485,"_5":13218,"_26298":46353,"_2652":46486},[],"The chart can enable OpenTelemetry instrumentation. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, authz, service and dependency.",{"_3154":449,"_27801":391,"_19254":46488,"_5":13218,"_26298":46353,"_2652":46489},[],"Before closing an incident, record:",{"_3154":450,"_27801":391,"_19254":46491,"_5":13218,"_26298":46353,"_2652":46492},[],"the confirmed cause;",{"_3154":451,"_27801":391,"_19254":46494,"_5":13218,"_26298":46353,"_2652":46495},[],"the time scope and affected resources;",{"_3154":452,"_27801":391,"_19254":46497,"_5":13218,"_26298":46353,"_2652":46498},[],"the commands or queries used;",{"_3154":453,"_27801":391,"_19254":46500,"_5":13218,"_26298":46353,"_2652":46501},[],"the applied change and how to revert it;",{"_3154":454,"_27801":391,"_19254":46503,"_5":13218,"_26298":46353,"_2652":46504},[],"validation from a consumer;",{"_3154":455,"_27801":391,"_19254":46506,"_5":13218,"_26298":46353,"_2652":46507},[],"the preventive action and its owner.",{"_3154":456,"_27801":456,"_5":13544,"_2652":46509,"_28144":46510,"_19254":46513,"_26298":456},"Access control",[45131,46511,46512],"Platform","Administration",[],{"_3154":457,"_27801":456,"_19254":46515,"_5":13218,"_26298":456,"_2652":46516},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_3154":458,"_27801":456,"_5":28141,"_19254":46518,"_26298":46519,"_2652":46520},[],"/docs/pr-preview/pr-53/platform/administration/access-control#essential-concepts","Essential concepts",{"_3154":459,"_27801":456,"_5":28141,"_19254":46522,"_26298":46523,"_2652":46524},[],"/docs/pr-preview/pr-53/platform/administration/access-control#two-decision-systems","Two decision systems",{"_3154":460,"_27801":456,"_5":28141,"_19254":46526,"_26298":46527,"_2652":46528},[],"/docs/pr-preview/pr-53/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_3154":461,"_27801":456,"_5":28141,"_19254":46530,"_26298":46531,"_2652":46532},[],"/docs/pr-preview/pr-53/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_3154":462,"_27801":456,"_5":28141,"_19254":46534,"_26298":46535,"_2652":46536},[],"/docs/pr-preview/pr-53/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_3154":463,"_27801":456,"_5":28141,"_19254":46538,"_26298":46539,"_2652":46540},[],"/docs/pr-preview/pr-53/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_3154":464,"_27801":456,"_5":28141,"_19254":46542,"_26298":46543,"_2652":46544},[],"/docs/pr-preview/pr-53/platform/administration/access-control#oidc-principals","OIDC principals",{"_3154":465,"_27801":456,"_5":28141,"_19254":46546,"_26298":46547,"_2652":46548},[],"/docs/pr-preview/pr-53/platform/administration/access-control#x509-principals","X.509 principals",{"_3154":466,"_27801":456,"_5":28141,"_19254":46550,"_26298":46551,"_2652":46552},[],"/docs/pr-preview/pr-53/platform/administration/access-control#when-several-principals-match","When several principals match",{"_3154":467,"_27801":456,"_5":28141,"_19254":46554,"_26298":46555,"_2652":46556},[],"/docs/pr-preview/pr-53/platform/administration/access-control#how-policies-express-access","How policies express access",{"_3154":468,"_27801":456,"_5":28141,"_19254":46558,"_26298":46559,"_2652":46560},[],"/docs/pr-preview/pr-53/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_3154":469,"_27801":456,"_5":28141,"_19254":46562,"_26298":46563,"_2652":46564},[],"/docs/pr-preview/pr-53/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_3154":470,"_27801":456,"_5":28141,"_19254":46566,"_26298":46567,"_2652":46568},[],"/docs/pr-preview/pr-53/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_3154":471,"_27801":456,"_5":28141,"_19254":46570,"_26298":46571,"_2652":46572},[],"/docs/pr-preview/pr-53/platform/administration/access-control#http-rules","HTTP rules",{"_3154":472,"_27801":456,"_5":28141,"_19254":46574,"_26298":46575,"_2652":46576},[],"/docs/pr-preview/pr-53/platform/administration/access-control#included-policies","Included policies",{"_3154":473,"_27801":456,"_5":28141,"_19254":46578,"_26298":46579,"_2652":45767},[],"/docs/pr-preview/pr-53/platform/administration/access-control#provision-the-first-administrator",{"_3154":474,"_27801":456,"_5":28141,"_19254":46581,"_26298":46582,"_2652":46583},[],"/docs/pr-preview/pr-53/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_3154":475,"_27801":456,"_5":28141,"_19254":46585,"_26298":46586,"_2652":46587},[],"/docs/pr-preview/pr-53/platform/administration/access-control#configure-token-validation","Configure token validation",{"_3154":476,"_27801":456,"_5":28141,"_19254":46589,"_26298":46590,"_2652":46591},[],"/docs/pr-preview/pr-53/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_3154":477,"_27801":456,"_5":28141,"_19254":46593,"_26298":46594,"_2652":46595},[],"/docs/pr-preview/pr-53/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_3154":478,"_27801":456,"_5":28141,"_19254":46597,"_26298":46598,"_2652":46599},[],"/docs/pr-preview/pr-53/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_3154":479,"_27801":456,"_5":28141,"_19254":46601,"_26298":46602,"_2652":46603},[],"/docs/pr-preview/pr-53/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_3154":480,"_27801":456,"_5":28141,"_19254":46605,"_26298":46606,"_2652":46607},[],"/docs/pr-preview/pr-53/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_3154":481,"_27801":456,"_5":28141,"_19254":46609,"_26298":46610,"_2652":46611},[],"/docs/pr-preview/pr-53/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_3154":482,"_27801":456,"_5":28141,"_19254":46613,"_26298":46614,"_2652":46615},[],"/docs/pr-preview/pr-53/platform/administration/access-control#operational-checklist","Operational checklist",{"_3154":483,"_27801":456,"_5":28141,"_19254":46617,"_26298":46618,"_2652":46619},[],"/docs/pr-preview/pr-53/platform/administration/access-control#diagnostics","Diagnostics",{"_3154":484,"_27801":456,"_5":28141,"_19254":46621,"_26298":46622,"_2652":46623},[],"/docs/pr-preview/pr-53/platform/administration/access-control#the-response-is-401","The response is 401",{"_3154":485,"_27801":456,"_5":28141,"_19254":46625,"_26298":46626,"_2652":46627},[],"/docs/pr-preview/pr-53/platform/administration/access-control#the-response-is-403","The response is 403",{"_3154":486,"_27801":456,"_5":28141,"_19254":46629,"_26298":46630,"_2652":46631},[],"/docs/pr-preview/pr-53/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_3154":487,"_27801":456,"_5":28141,"_19254":46633,"_26298":46634,"_2652":46635},[],"/docs/pr-preview/pr-53/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_3154":488,"_27801":456,"_5":28141,"_19254":46637,"_26298":46638,"_2652":46639},[],"/docs/pr-preview/pr-53/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_3154":489,"_27801":456,"_19254":46641,"_5":13218,"_26298":456,"_2652":46642},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_3154":490,"_27801":456,"_19254":46644,"_5":13218,"_26298":456,"_2652":46645},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_3154":491,"_27801":456,"_19254":46647,"_5":13218,"_26298":456,"_2652":46648},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_3154":492,"_27801":456,"_19254":46650,"_5":13218,"_26298":46519,"_2652":46651},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_3154":493,"_27801":456,"_19254":46653,"_5":13218,"_26298":46519,"_2652":46654},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_3154":494,"_27801":456,"_19254":46656,"_5":13218,"_26298":46519,"_2652":46657},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_3154":495,"_27801":456,"_19254":46659,"_5":13218,"_26298":46519,"_2652":46660},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_3154":496,"_27801":456,"_19254":46662,"_5":13218,"_26298":46519,"_2652":46663},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_3154":497,"_27801":456,"_19254":46665,"_5":13218,"_26298":46519,"_2652":46666},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_3154":498,"_27801":456,"_19254":46668,"_5":13218,"_26298":46523,"_2652":46669},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_3154":499,"_27801":456,"_19254":46671,"_5":13218,"_26298":46523,"_2652":46672},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_3154":500,"_27801":456,"_19254":46674,"_5":13218,"_26298":46527,"_2652":46675},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_3154":501,"_27801":456,"_19254":46677,"_5":13218,"_26298":46527,"_2652":46678},[],"The decision is made **before forwarding the request to the service**:",{"_3154":502,"_27801":456,"_19254":46680,"_5":13218,"_26298":46527,"_2652":46681},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_3154":503,"_27801":456,"_19254":46683,"_5":13218,"_26298":46527,"_2652":46684},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_3154":504,"_27801":456,"_19254":46686,"_5":13218,"_26298":46527,"_2652":46687},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_3154":505,"_27801":456,"_19254":46689,"_5":13218,"_26298":46527,"_2652":46690},[],"It separately loads the policies granted to each principal.",{"_3154":506,"_27801":456,"_19254":46692,"_5":13218,"_26298":46527,"_2652":46693},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_3154":507,"_27801":456,"_19254":46695,"_5":13218,"_26298":46527,"_2652":46696},[],"`authz` looks for an HTTP rule granting that action.",{"_3154":508,"_27801":456,"_19254":46698,"_5":13218,"_26298":46527,"_2652":46699},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_3154":509,"_27801":456,"_19254":46701,"_5":13218,"_26298":46527,"_2652":46702},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_3154":510,"_27801":456,"_19254":46704,"_5":13218,"_26298":46527,"_2652":46705},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context.",{"_3154":511,"_27801":456,"_19254":46707,"_5":13218,"_26298":46527,"_2652":46708},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_3154":512,"_27801":456,"_19254":46710,"_5":13218,"_26298":46531,"_2652":46711},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_3154":513,"_27801":456,"_19254":46713,"_5":13218,"_26298":46531,"_2652":46714},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_3154":514,"_27801":456,"_19254":46716,"_5":13218,"_26298":46531,"_2652":46717},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_3154":515,"_27801":456,"_19254":46719,"_5":13218,"_26298":46531,"_2652":46720},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_3154":516,"_27801":456,"_19254":46722,"_5":13218,"_26298":46531,"_2652":46723},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_3154":517,"_27801":456,"_19254":46725,"_5":13218,"_26298":46531,"_2652":46726},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_3154":518,"_27801":456,"_19254":46728,"_5":13218,"_26298":46531,"_2652":46729},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_3154":519,"_27801":456,"_19254":46731,"_5":13218,"_26298":46531,"_2652":46732},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_3154":520,"_27801":456,"_19254":46734,"_5":13218,"_26298":46535,"_2652":46735},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_3154":521,"_27801":456,"_19254":46737,"_5":13218,"_26298":46535,"_2652":46738},[],"The decision is made with the domain operation context:",{"_3154":522,"_27801":456,"_19254":46740,"_5":13218,"_26298":46535,"_2652":46741},[],"The middleware extracts the credential and resolves the matching principals.",{"_3154":523,"_27801":456,"_19254":46743,"_5":13218,"_26298":46535,"_2652":46744},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_3154":524,"_27801":456,"_19254":46746,"_5":13218,"_26298":46535,"_2652":46747},[],"`authz` gathers the entity rules of the granted policies.",{"_3154":525,"_27801":456,"_19254":46749,"_5":13218,"_26298":46535,"_2652":46750},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_3154":526,"_27801":456,"_19254":46752,"_5":13218,"_26298":46535,"_2652":46753},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_3154":527,"_27801":456,"_19254":46755,"_5":13218,"_26298":46535,"_2652":46756},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_3154":528,"_27801":456,"_19254":46758,"_5":13218,"_26298":46535,"_2652":46759},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_3154":529,"_27801":456,"_19254":46761,"_5":13218,"_26298":46535,"_2652":46762},[],"Actions fall into two groups:",{"_3154":530,"_27801":456,"_19254":46764,"_5":13218,"_26298":46535,"_2652":46765},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_3154":531,"_27801":456,"_19254":46767,"_5":13218,"_26298":46535,"_2652":46768},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_3154":532,"_27801":456,"_19254":46770,"_5":13218,"_26298":46535,"_2652":46771},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_3154":533,"_27801":456,"_19254":46773,"_5":13218,"_26298":46539,"_2652":46774},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_3154":534,"_27801":456,"_19254":46776,"_5":13218,"_26298":46539,"_2652":46777},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_3154":535,"_27801":456,"_19254":46779,"_5":13218,"_26298":46539,"_2652":46780},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_3154":536,"_27801":456,"_19254":46782,"_5":13218,"_26298":46543,"_2652":46783},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_3154":537,"_27801":456,"_19254":46785,"_5":13218,"_26298":46543,"_2652":46786},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_3154":538,"_27801":456,"_19254":46788,"_5":13218,"_26298":46543,"_2652":46789},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_3154":539,"_27801":456,"_19254":46791,"_5":13218,"_26298":46543,"_2652":46792},[],"The implemented operators are:",{"_3154":540,"_27801":456,"_19254":46794,"_5":13218,"_26298":46543,"_2652":46795},[],"`equals`, for exact equality;",{"_3154":541,"_27801":456,"_19254":46797,"_5":13218,"_26298":46543,"_2652":46798},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_3154":542,"_27801":456,"_19254":46800,"_5":13218,"_26298":46543,"_2652":46801},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_3154":543,"_27801":456,"_19254":46803,"_5":13218,"_26298":46543,"_2652":46804},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_3154":544,"_27801":456,"_19254":46806,"_5":13218,"_26298":46547,"_2652":46807},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_3154":545,"_27801":456,"_19254":46809,"_5":13218,"_26298":46547,"_2652":46810},[],"The available modes are:",{"_3154":546,"_27801":456,"_19254":46812,"_5":13218,"_26298":46547,"_2652":46813},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_3154":547,"_27801":456,"_19254":46815,"_5":13218,"_26298":46547,"_2652":46816},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_3154":548,"_27801":456,"_19254":46818,"_5":13218,"_26298":46547,"_2652":46819},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_3154":549,"_27801":456,"_19254":46821,"_5":13218,"_26298":46547,"_2652":46822},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_3154":550,"_27801":456,"_19254":46824,"_5":13218,"_26298":46547,"_2652":46825},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_3154":551,"_27801":456,"_19254":46827,"_5":13218,"_26298":46547,"_2652":46828},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_3154":552,"_27801":456,"_19254":46830,"_5":13218,"_26298":46551,"_2652":46831},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_3154":553,"_27801":456,"_19254":46833,"_5":13218,"_26298":46551,"_2652":46834},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_3154":554,"_27801":456,"_19254":46836,"_5":13218,"_26298":46551,"_2652":46837},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_3154":555,"_27801":456,"_19254":46839,"_5":13218,"_26298":46551,"_2652":46840},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_3154":556,"_27801":456,"_19254":46842,"_5":13218,"_26298":46559,"_2652":46843},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_3154":557,"_27801":456,"_19254":46845,"_5":13218,"_26298":46559,"_2652":46846},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_3154":558,"_27801":456,"_19254":46848,"_5":13218,"_26298":46563,"_2652":46849},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA and of a device to its DMS. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_3154":559,"_27801":456,"_19254":46851,"_5":13218,"_26298":46563,"_2652":46852},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_3154":560,"_27801":456,"_19254":46854,"_5":13218,"_26298":46567,"_2652":46855},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_3154":561,"_27801":456,"_19254":46857,"_5":13218,"_26298":46567,"_2652":46858},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_3154":562,"_27801":456,"_19254":46860,"_5":13218,"_26298":46567,"_2652":46861},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_3154":563,"_27801":456,"_19254":46863,"_5":13218,"_26298":46571,"_2652":46864},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_3154":564,"_27801":456,"_19254":46866,"_5":13218,"_26298":46571,"_2652":46867},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_3154":565,"_27801":456,"_19254":46869,"_5":13218,"_26298":46571,"_2652":46870},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_3154":566,"_27801":456,"_19254":46872,"_5":13218,"_26298":46571,"_2652":46873},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_3154":567,"_27801":456,"_19254":46875,"_5":13218,"_26298":46571,"_2652":46876},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_3154":568,"_27801":456,"_19254":46878,"_5":13218,"_26298":46571,"_2652":46879},[],"Note that:",{"_3154":569,"_27801":456,"_19254":46881,"_5":13218,"_26298":46571,"_2652":46882},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_3154":570,"_27801":456,"_19254":46884,"_5":13218,"_26298":46571,"_2652":46885},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_3154":571,"_27801":456,"_19254":46887,"_5":13218,"_26298":46571,"_2652":46888},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_3154":572,"_27801":456,"_19254":46890,"_5":13218,"_26298":46575,"_2652":46891},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_3154":573,"_27801":456,"_19254":46893,"_5":13218,"_26298":46575,"_2652":46894},[],"full and read-only access to certificates and authorities;",{"_3154":574,"_27801":456,"_19254":46896,"_5":13218,"_26298":46575,"_2652":46897},[],"full and read-only access to the KMS;",{"_3154":575,"_27801":456,"_19254":46899,"_5":13218,"_26298":46575,"_2652":46900},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_3154":576,"_27801":456,"_19254":46902,"_5":13218,"_26298":46575,"_2652":46903},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_3154":577,"_27801":456,"_19254":46905,"_5":13218,"_26298":46575,"_2652":46906},[],"console access;",{"_3154":578,"_27801":456,"_19254":46908,"_5":13218,"_26298":46575,"_2652":46909},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_3154":579,"_27801":456,"_19254":46911,"_5":13218,"_26298":46575,"_2652":46912},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_3154":580,"_27801":456,"_19254":46914,"_5":13218,"_26298":46575,"_2652":46915},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_3154":581,"_27801":456,"_19254":46917,"_5":13218,"_26298":46579,"_2652":46918},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_3154":582,"_27801":456,"_19254":46920,"_5":13218,"_26298":46579,"_2652":46921},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_3154":583,"_27801":456,"_19254":46923,"_5":13218,"_26298":46579,"_2652":46924},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_3154":584,"_27801":456,"_19254":46926,"_5":13218,"_26298":46582,"_2652":46927},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_3154":585,"_27801":456,"_19254":46929,"_5":13218,"_26298":46586,"_2652":46930},[],"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`.",{"_3154":586,"_27801":456,"_19254":46932,"_5":13218,"_26298":46586,"_2652":46933},[],"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0.",{"_3154":587,"_27801":456,"_19254":46935,"_5":13218,"_26298":46590,"_2652":46936},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_3154":588,"_27801":456,"_19254":46938,"_5":13218,"_26298":46594,"_2652":46939},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_3154":589,"_27801":456,"_19254":46941,"_5":13218,"_26298":46598,"_2652":46942},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_3154":590,"_27801":456,"_19254":46944,"_5":13218,"_26298":46602,"_2652":46945},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_3154":591,"_27801":456,"_19254":46947,"_5":13218,"_26298":46602,"_2652":46948},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_3154":592,"_27801":456,"_19254":46950,"_5":13218,"_26298":46606,"_2652":46951},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_3154":593,"_27801":456,"_19254":46953,"_5":13218,"_26298":46606,"_2652":46954},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_3154":594,"_27801":456,"_19254":46956,"_5":13218,"_26298":46606,"_2652":46957},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_3154":595,"_27801":456,"_19254":46959,"_5":13218,"_26298":46606,"_2652":46960},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_3154":596,"_27801":456,"_19254":46962,"_5":13218,"_26298":46606,"_2652":46963},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_3154":597,"_27801":456,"_19254":46965,"_5":13218,"_26298":46606,"_2652":46966},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_3154":598,"_27801":456,"_19254":46968,"_5":13218,"_26298":46606,"_2652":46969},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_3154":599,"_27801":456,"_19254":46971,"_5":13218,"_26298":46606,"_2652":46972},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_3154":600,"_27801":456,"_19254":46974,"_5":13218,"_26298":46610,"_2652":46975},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_3154":601,"_27801":456,"_19254":46977,"_5":13218,"_26298":46610,"_2652":46978},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_3154":602,"_27801":456,"_19254":46980,"_5":13218,"_26298":46610,"_2652":46981},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_3154":603,"_27801":456,"_19254":46983,"_5":13218,"_26298":46614,"_2652":46984},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_3154":604,"_27801":456,"_19254":46986,"_5":13218,"_26298":46614,"_2652":46987},[],"Use groups or stable roles for people and independent identities for automations.",{"_3154":605,"_27801":456,"_19254":46989,"_5":13218,"_26298":46614,"_2652":46990},[],"Keep at least two recovery administrators and test their access periodically.",{"_3154":606,"_27801":456,"_19254":46992,"_5":13218,"_26298":46614,"_2652":46993},[],"Review active principals, their matches and their grants after IdP changes.",{"_3154":607,"_27801":456,"_19254":46995,"_5":13218,"_26298":46614,"_2652":46996},[],"Search for wildcards in policies before upgrading Lamassu.",{"_3154":608,"_27801":456,"_19254":46998,"_5":13218,"_26298":46614,"_2652":46999},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_3154":609,"_27801":456,"_19254":47001,"_5":13218,"_26298":46614,"_2652":47002},[],"Always test one allowed and one denied operation for each role.",{"_3154":610,"_27801":456,"_19254":47004,"_5":13218,"_26298":46614,"_2652":47005},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_3154":611,"_27801":456,"_19254":47007,"_5":13218,"_26298":46622,"_2652":47008},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_3154":612,"_27801":456,"_19254":47010,"_5":13218,"_26298":46626,"_2652":47011},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_3154":613,"_27801":456,"_19254":47013,"_5":13218,"_26298":46626,"_2652":47014},[],"that an active principal of the correct type exists;",{"_3154":614,"_27801":456,"_19254":47016,"_5":13218,"_26298":46626,"_2652":47017},[],"that the claim paths and values match the real token exactly;",{"_3154":615,"_27801":456,"_19254":47019,"_5":13218,"_26298":46626,"_2652":47020},[],"that all of the principal's conditions hold;",{"_3154":616,"_27801":456,"_19254":47022,"_5":13218,"_26298":46626,"_2652":47023},[],"that the principal has the expected policy granted;",{"_3154":617,"_27801":456,"_19254":47025,"_5":13218,"_26298":46626,"_2652":47026},[],"that the policy includes the action and the requested resource type or route;",{"_3154":618,"_27801":456,"_19254":47028,"_5":13218,"_26298":46626,"_2652":47029},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_3154":619,"_27801":456,"_19254":47031,"_5":13218,"_26298":46626,"_2652":47032},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry instrumentation enabled, each decision also produces a span — `engine.CheckHTTP` on the Gateway path — whose attributes record `authz.allowed`, the matched policy and the matched principal, so you can correlate the denial with the Gateway trace.",{"_3154":620,"_27801":456,"_19254":47034,"_5":13218,"_26298":46630,"_2652":47035},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_3154":621,"_27801":456,"_19254":47037,"_5":13218,"_26298":46634,"_2652":47038},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_3154":622,"_27801":456,"_19254":47040,"_5":13218,"_26298":46638,"_2652":47041},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_3154":623,"_27801":456,"_19254":47043,"_5":13218,"_26298":46638,"_2652":47044},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_3154":624,"_27801":624,"_5":13544,"_2652":47046,"_28144":47047,"_19254":47048,"_26298":624},"Alerts and subscriptions",[45131,46511,46512],[],{"_3154":625,"_27801":624,"_19254":47050,"_5":13218,"_26298":624,"_2652":47051},[],"Send PKI events to people and external systems.",{"_3154":626,"_27801":624,"_5":28141,"_19254":47053,"_26298":47054,"_2652":47055},[],"/docs/pr-preview/pr-53/platform/administration/alerts#how-it-works","How it works",{"_3154":627,"_27801":624,"_5":28141,"_19254":47057,"_26298":47058,"_2652":47059},[],"/docs/pr-preview/pr-53/platform/administration/alerts#available-channels","Available channels",{"_3154":628,"_27801":624,"_5":28141,"_19254":47061,"_26298":47062,"_2652":47063},[],"/docs/pr-preview/pr-53/platform/administration/alerts#create-a-subscription","Create a subscription",{"_3154":629,"_27801":624,"_5":28141,"_19254":47065,"_26298":47066,"_2652":47067},[],"/docs/pr-preview/pr-53/platform/administration/alerts#choose-the-event","Choose the event",{"_3154":630,"_27801":624,"_5":28141,"_19254":47069,"_26298":47070,"_2652":47071},[],"/docs/pr-preview/pr-53/platform/administration/alerts#configure-the-destination","Configure the destination",{"_3154":631,"_27801":624,"_5":28141,"_19254":47073,"_26298":47074,"_2652":47075},[],"/docs/pr-preview/pr-53/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_3154":632,"_27801":624,"_5":28141,"_19254":47077,"_26298":47078,"_2652":47079},[],"/docs/pr-preview/pr-53/platform/administration/alerts#review-and-activate","Review and activate",{"_3154":633,"_27801":624,"_5":28141,"_19254":47081,"_26298":47082,"_2652":47083},[],"/docs/pr-preview/pr-53/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_3154":634,"_27801":624,"_5":28141,"_19254":47085,"_26298":47086,"_2652":47087},[],"/docs/pr-preview/pr-53/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_3154":635,"_27801":624,"_5":28141,"_19254":47089,"_26298":47090,"_2652":47091},[],"/docs/pr-preview/pr-53/platform/administration/alerts#event-families","Event families",{"_3154":636,"_27801":624,"_19254":47093,"_5":13218,"_26298":624,"_2652":47094},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_3154":637,"_27801":624,"_19254":47096,"_5":13218,"_26298":47054,"_2652":47097},[],"A service publishes a domain event.",{"_3154":638,"_27801":624,"_19254":47099,"_5":13218,"_26298":47054,"_2652":47100},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_3154":639,"_27801":624,"_19254":47102,"_5":13218,"_26298":47054,"_2652":47103},[],"Each subscription's filter decides whether it should be notified.",{"_3154":640,"_27801":624,"_19254":47105,"_5":13218,"_26298":47054,"_2652":47106},[],"Lamassu delivers the event to the configured channel.",{"_3154":641,"_27801":624,"_19254":47108,"_5":13218,"_26298":47054,"_2652":47109},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_3154":642,"_27801":624,"_19254":47111,"_5":13218,"_26298":47058,"_2652":47112},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_3154":643,"_27801":624,"_19254":47114,"_5":13218,"_26298":47058,"_2652":47115},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_3154":644,"_27801":624,"_19254":47117,"_5":13218,"_26298":47058,"_2652":47118},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_3154":645,"_27801":624,"_19254":47120,"_5":13218,"_26298":47058,"_2652":47121},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_3154":646,"_27801":624,"_19254":47123,"_5":13218,"_26298":47058,"_2652":47124},[],"`apikey_options` requires `header` and `key`.",{"_3154":647,"_27801":624,"_19254":47126,"_5":13218,"_26298":47058,"_2652":47127},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3154":648,"_27801":624,"_19254":47129,"_5":13218,"_26298":47058,"_2652":47130},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_3154":649,"_27801":624,"_19254":47132,"_5":13218,"_26298":47058,"_2652":47133},[],"The alerts API reference documents the full `http_client` schema.",{"_3154":650,"_27801":624,"_19254":47135,"_5":13218,"_26298":47066,"_2652":47136},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_3154":651,"_27801":624,"_19254":47138,"_5":13218,"_26298":47070,"_2652":47139},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_3154":652,"_27801":624,"_19254":47141,"_5":13218,"_26298":47074,"_2652":47142},[],"Add a filter if you don't want to receive every instance of the event.",{"_3154":653,"_27801":624,"_19254":47144,"_5":13218,"_26298":47074,"_2652":47145},[],"**None** notifies all instances of the event.",{"_3154":654,"_27801":624,"_19254":47147,"_5":13218,"_26298":47074,"_2652":47148},[],"**JSON Path** evaluates one or more specific fields.",{"_3154":655,"_27801":624,"_19254":47150,"_5":13218,"_26298":47074,"_2652":47151},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_3154":656,"_27801":624,"_19254":47153,"_5":13218,"_26298":47074,"_2652":47154},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_3154":657,"_27801":624,"_19254":47156,"_5":13218,"_26298":47074,"_2652":47157},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_3154":658,"_27801":624,"_19254":47159,"_5":13218,"_26298":47078,"_2652":47160},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_3154":659,"_27801":624,"_19254":47162,"_5":13218,"_26298":47082,"_2652":47163},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_3154":660,"_27801":624,"_19254":47165,"_5":13218,"_26298":47082,"_2652":47166},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_3154":661,"_27801":624,"_19254":47168,"_5":13218,"_26298":47082,"_2652":47169},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_3154":662,"_27801":624,"_19254":47171,"_5":13218,"_26298":47082,"_2652":47172},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_3154":663,"_27801":624,"_19254":47174,"_5":13218,"_26298":47082,"_2652":47175},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_3154":664,"_27801":624,"_19254":47177,"_5":13218,"_26298":47082,"_2652":47178},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_3154":665,"_27801":624,"_19254":47180,"_5":13218,"_26298":47082,"_2652":47181},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_3154":666,"_27801":624,"_19254":47183,"_5":13218,"_26298":47082,"_2652":47184},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_3154":667,"_27801":624,"_19254":47186,"_5":13218,"_26298":47086,"_2652":47187},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_3154":668,"_27801":624,"_19254":47189,"_5":13218,"_26298":47090,"_2652":47190},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_3154":669,"_27801":624,"_19254":47192,"_5":13218,"_26298":47090,"_2652":47193},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_3154":670,"_27801":624,"_19254":47195,"_5":13218,"_26298":47090,"_2652":47196},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_3154":671,"_27801":624,"_19254":47198,"_5":13218,"_26298":47090,"_2652":47199},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_3154":672,"_27801":624,"_19254":47201,"_5":13218,"_26298":47090,"_2652":47202},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_3154":673,"_27801":624,"_19254":47204,"_5":13218,"_26298":47090,"_2652":47205},[],"**Validation:** `va.role.crl.create`.",{"_3154":674,"_27801":624,"_19254":47207,"_5":13218,"_26298":47090,"_2652":47208},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_3154":675,"_27801":624,"_19254":47210,"_5":13218,"_26298":47090,"_2652":47211},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_3154":676,"_27801":676,"_5":13544,"_2652":47213,"_28144":47214,"_19254":47215,"_26298":676},"Audit logs",[45131,46511,46512],[],{"_3154":677,"_27801":676,"_19254":47217,"_5":13218,"_26298":676,"_2652":47218},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_3154":678,"_27801":676,"_5":28141,"_19254":47220,"_26298":47221,"_2652":47222},[],"/docs/pr-preview/pr-53/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_3154":679,"_27801":676,"_5":28141,"_19254":47224,"_26298":47225,"_2652":47226},[],"/docs/pr-preview/pr-53/platform/administration/audit-logs#coverage","Coverage",{"_3154":680,"_27801":676,"_5":28141,"_19254":47228,"_26298":47229,"_2652":47230},[],"/docs/pr-preview/pr-53/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_3154":681,"_27801":676,"_5":28141,"_19254":47232,"_26298":47233,"_2652":47234},[],"/docs/pr-preview/pr-53/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_3154":682,"_27801":676,"_5":28141,"_19254":47236,"_26298":47237,"_2652":47238},[],"/docs/pr-preview/pr-53/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_3154":683,"_27801":676,"_5":28141,"_19254":47240,"_26298":47241,"_2652":47242},[],"/docs/pr-preview/pr-53/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_3154":684,"_27801":676,"_5":28141,"_19254":47244,"_26298":47245,"_2652":47246},[],"/docs/pr-preview/pr-53/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_3154":685,"_27801":676,"_5":28141,"_19254":47248,"_26298":47249,"_2652":47250},[],"/docs/pr-preview/pr-53/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_3154":686,"_27801":676,"_5":28141,"_19254":47252,"_26298":47253,"_2652":47254},[],"/docs/pr-preview/pr-53/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_3154":687,"_27801":676,"_5":28141,"_19254":47256,"_26298":47257,"_2652":47258},[],"/docs/pr-preview/pr-53/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_3154":688,"_27801":676,"_5":28141,"_19254":47260,"_26298":47261,"_2652":47262},[],"/docs/pr-preview/pr-53/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_3154":689,"_27801":676,"_19254":47264,"_5":13218,"_26298":676,"_2652":47265},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_3154":690,"_27801":676,"_19254":47267,"_5":13218,"_26298":47221,"_2652":47268},[],"The audit body includes:",{"_3154":691,"_27801":676,"_19254":47270,"_5":13218,"_26298":47221,"_2652":47271},[],"input: data received by the operation;",{"_3154":692,"_27801":676,"_19254":47273,"_5":13218,"_26298":47221,"_2652":47274},[],"has\\_error: whether the service returned an error;",{"_3154":693,"_27801":676,"_19254":47276,"_5":13218,"_26298":47221,"_2652":47277},[],"output: produced result or error message;",{"_3154":694,"_27801":676,"_19254":47279,"_5":13218,"_26298":47221,"_2652":47280},[],"principals: identifiers of the principals that matched the request.",{"_3154":695,"_27801":676,"_19254":47282,"_5":13218,"_26298":47221,"_2652":47283},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_3154":696,"_27801":676,"_19254":47285,"_5":13218,"_26298":47221,"_2652":47286},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_3154":697,"_27801":676,"_19254":47288,"_5":13218,"_26298":47225,"_2652":47289},[],"The backend applies auditing to mutations of:",{"_3154":698,"_27801":676,"_19254":47291,"_5":13218,"_26298":47225,"_2652":47292},[],"authorities, certificates and issuance profiles;",{"_3154":699,"_27801":676,"_19254":47294,"_5":13218,"_26298":47225,"_2652":47295},[],"keys and KMS engines;",{"_3154":700,"_27801":676,"_19254":47297,"_5":13218,"_26298":47225,"_2652":47298},[],"devices and identities;",{"_3154":701,"_27801":676,"_19254":47300,"_5":13218,"_26298":47225,"_2652":47301},[],"DMSs and enrollment operations;",{"_3154":702,"_27801":676,"_19254":47303,"_5":13218,"_26298":47225,"_2652":47304},[],"validation functions and CRL;",{"_3154":703,"_27801":676,"_19254":47306,"_5":13218,"_26298":47225,"_2652":47307},[],"principals, policies and authorization grants.",{"_3154":704,"_27801":676,"_19254":47309,"_5":13218,"_26298":47225,"_2652":47310},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_3154":705,"_27801":676,"_19254":47312,"_5":13218,"_26298":47229,"_2652":47313},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_3154":706,"_27801":676,"_19254":47315,"_5":13218,"_26298":47229,"_2652":47316},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_3154":707,"_27801":676,"_19254":47318,"_5":13218,"_26298":47229,"_2652":47319},[],"Design the consumer to:",{"_3154":708,"_27801":676,"_19254":47321,"_5":13218,"_26298":47229,"_2652":47322},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_3154":709,"_27801":676,"_19254":47324,"_5":13218,"_26298":47229,"_2652":47325},[],"keep the complete CloudEvent unmodified;",{"_3154":710,"_27801":676,"_19254":47327,"_5":13218,"_26298":47229,"_2652":47328},[],"record the ingestion time and detect duplicates by ID;",{"_3154":711,"_27801":676,"_19254":47330,"_5":13218,"_26298":47229,"_2652":47331},[],"encrypt in transit and at rest;",{"_3154":712,"_27801":676,"_19254":47333,"_5":13218,"_26298":47229,"_2652":47334},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_3154":713,"_27801":676,"_19254":47336,"_5":13218,"_26298":47229,"_2652":47337},[],"apply an explicit retention and legal hold policy;",{"_3154":714,"_27801":676,"_19254":47339,"_5":13218,"_26298":47229,"_2652":47340},[],"alert if it stops consuming or the pending queue grows.",{"_3154":715,"_27801":676,"_19254":47342,"_5":13218,"_26298":47233,"_2652":47343},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_3154":716,"_27801":676,"_19254":47345,"_5":13218,"_26298":47233,"_2652":47346},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_3154":717,"_27801":676,"_19254":47348,"_5":13218,"_26298":47241,"_2652":47349},[],"Start from the reported time and normalize every source to UTC.",{"_3154":718,"_27801":676,"_19254":47351,"_5":13218,"_26298":47245,"_2652":47352},[],"Filter by event type, service source and resource identifier.",{"_3154":719,"_27801":676,"_19254":47354,"_5":13218,"_26298":47249,"_2652":47355},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_3154":720,"_27801":676,"_19254":47357,"_5":13218,"_26298":47253,"_2652":47358},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_3154":721,"_27801":676,"_19254":47360,"_5":13218,"_26298":47257,"_2652":47361},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_3154":722,"_27801":676,"_19254":47363,"_5":13218,"_26298":47261,"_2652":47364},[],"Generate a controlled mutation in a test environment and check that:",{"_3154":723,"_27801":676,"_19254":47366,"_5":13218,"_26298":47261,"_2652":47367},[],"a successful audit event appears;",{"_3154":724,"_27801":676,"_19254":47369,"_5":13218,"_26298":47261,"_2652":47370},[],"the principal matches the identity used;",{"_3154":725,"_27801":676,"_19254":47372,"_5":13218,"_26298":47261,"_2652":47373},[],"the consumer persists it exactly once;",{"_3154":726,"_27801":676,"_19254":47375,"_5":13218,"_26298":47261,"_2652":47376},[],"it can be retrieved by resource, actor and period;",{"_3154":727,"_27801":676,"_19254":47378,"_5":13218,"_26298":47261,"_2652":47379},[],"a consumer outage raises an alert.",{"_3154":728,"_27801":676,"_19254":47381,"_5":13218,"_26298":47261,"_2652":47382},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_3154":729,"_27801":729,"_5":13544,"_2652":47384,"_28144":47385,"_19254":47386,"_26298":729},"Platform architecture",[45131,46511],[],{"_3154":730,"_27801":729,"_19254":47388,"_5":13218,"_26298":729,"_2652":47389},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_3154":731,"_27801":729,"_5":28141,"_19254":47391,"_26298":47392,"_2652":47393},[],"/docs/pr-preview/pr-53/platform/concepts/architecture#control-plane","Control plane",{"_3154":732,"_27801":729,"_5":28141,"_19254":47395,"_26298":47396,"_2652":47397},[],"/docs/pr-preview/pr-53/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_3154":733,"_27801":729,"_5":28141,"_19254":47399,"_26298":47400,"_2652":47401},[],"/docs/pr-preview/pr-53/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_3154":734,"_27801":729,"_5":28141,"_19254":47403,"_26298":47404,"_2652":47405},[],"/docs/pr-preview/pr-53/platform/concepts/architecture#status-and-validation","Status and validation",{"_3154":735,"_27801":729,"_5":28141,"_19254":47407,"_26298":47408,"_2652":47409},[],"/docs/pr-preview/pr-53/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_3154":736,"_27801":729,"_19254":47411,"_5":13218,"_26298":729,"_2652":47412},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_3154":737,"_27801":729,"_19254":47414,"_5":13218,"_26298":729,"_2652":47415},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_3154":738,"_27801":729,"_19254":47417,"_5":13218,"_26298":47392,"_2652":47418},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_3154":739,"_27801":729,"_19254":47420,"_5":13218,"_26298":47396,"_2652":47421},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_3154":740,"_27801":729,"_19254":47423,"_5":13218,"_26298":47400,"_2652":47424},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_3154":741,"_27801":729,"_19254":47426,"_5":13218,"_26298":47404,"_2652":47427},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_3154":742,"_27801":729,"_19254":47429,"_5":13218,"_26298":47408,"_2652":47430},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_3154":743,"_27801":743,"_5":13544,"_2652":47432,"_28144":47433,"_19254":47434,"_26298":743},"How Lamassu works",[45131,46511],[],{"_3154":744,"_27801":743,"_19254":47436,"_5":13218,"_26298":743,"_2652":47437},[],"The mental model of trust, keys, certificates and devices.",{"_3154":745,"_27801":743,"_5":28141,"_19254":47439,"_26298":47440,"_2652":47441},[],"/docs/pr-preview/pr-53/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_3154":746,"_27801":743,"_5":28141,"_19254":47443,"_26298":47444,"_2652":47445},[],"/docs/pr-preview/pr-53/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_3154":747,"_27801":743,"_19254":47447,"_5":13218,"_26298":743,"_2652":47448},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_3154":748,"_27801":743,"_19254":47450,"_5":13218,"_26298":47440,"_2652":47451},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_3154":749,"_27801":743,"_19254":47453,"_5":13218,"_26298":47440,"_2652":47454},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_3154":750,"_27801":743,"_19254":47456,"_5":13218,"_26298":47440,"_2652":47457},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_3154":751,"_27801":743,"_19254":47459,"_5":13218,"_26298":47440,"_2652":47460},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_3154":752,"_27801":743,"_19254":47462,"_5":13218,"_26298":47440,"_2652":47463},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_3154":753,"_27801":743,"_19254":47465,"_5":13218,"_26298":47444,"_2652":47466},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_3154":754,"_27801":743,"_19254":47468,"_5":13218,"_26298":47444,"_2652":47469},[],"A DMS relates that CA to an enrollment policy.",{"_3154":755,"_27801":743,"_19254":47471,"_5":13218,"_26298":47444,"_2652":47472},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_3154":756,"_27801":743,"_19254":47474,"_5":13218,"_26298":47444,"_2652":47475},[],"Lamassu keeps the inventory, history and status of the identity.",{"_3154":757,"_27801":743,"_19254":47477,"_5":13218,"_26298":47444,"_2652":47478},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_3154":758,"_27801":743,"_19254":47480,"_5":13218,"_26298":47444,"_2652":47481},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_3154":759,"_27801":743,"_19254":47483,"_5":13218,"_26298":47444,"_2652":47484},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3154":760,"_27801":760,"_5":13544,"_2652":47486,"_28144":47487,"_19254":47489,"_26298":760},"Devices and identities",[45131,46511,47488,47486],"IoT Fleets",[],{"_3154":761,"_27801":760,"_19254":47491,"_5":13218,"_26298":760,"_2652":47492},[],"Register, inspect and retire devices while checking their current identity and history.",{"_3154":762,"_27801":760,"_5":28141,"_19254":47494,"_26298":47495,"_2652":47496},[],"/docs/pr-preview/pr-53/platform/iot-fleets/device-management#device-states","Device states",{"_3154":763,"_27801":760,"_5":28141,"_19254":47498,"_26298":47499,"_2652":47500},[],"/docs/pr-preview/pr-53/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_3154":764,"_27801":760,"_5":28141,"_19254":47502,"_26298":47503,"_2652":47504},[],"/docs/pr-preview/pr-53/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_3154":765,"_27801":760,"_5":28141,"_19254":47506,"_26298":47507,"_2652":47508},[],"/docs/pr-preview/pr-53/platform/iot-fleets/device-management#create-the-device","Create the device",{"_3154":766,"_27801":760,"_5":28141,"_19254":47510,"_26298":47511,"_2652":47512},[],"/docs/pr-preview/pr-53/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_3154":767,"_27801":760,"_5":28141,"_19254":47514,"_26298":47515,"_2652":47516},[],"/docs/pr-preview/pr-53/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_3154":768,"_27801":760,"_5":28141,"_19254":47518,"_26298":47519,"_2652":47520},[],"/docs/pr-preview/pr-53/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_3154":769,"_27801":760,"_5":28141,"_19254":47522,"_26298":47523,"_2652":47524},[],"/docs/pr-preview/pr-53/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_3154":770,"_27801":760,"_5":28141,"_19254":47526,"_26298":47527,"_2652":47528},[],"/docs/pr-preview/pr-53/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_3154":771,"_27801":760,"_5":28141,"_19254":47530,"_26298":47531,"_2652":47532},[],"/docs/pr-preview/pr-53/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_3154":772,"_27801":760,"_5":28141,"_19254":47534,"_26298":47535,"_2652":47536},[],"/docs/pr-preview/pr-53/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_3154":773,"_27801":760,"_19254":47538,"_5":13218,"_26298":760,"_2652":47539},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_3154":774,"_27801":760,"_19254":47541,"_5":13218,"_26298":760,"_2652":47542},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_3154":775,"_27801":760,"_19254":47544,"_5":13218,"_26298":47495,"_2652":47545},[],"Operational view",{"_3154":776,"_27801":760,"_19254":47547,"_5":13218,"_26298":47495,"_2652":47548},[],"Meaning",{"_3154":777,"_27801":760,"_19254":47550,"_5":13218,"_26298":47495,"_2652":47551},[],"**No Identity**",{"_3154":778,"_27801":760,"_19254":47553,"_5":13218,"_26298":47495,"_2652":47554},[],"A record exists without an associated identity.",{"_3154":779,"_27801":760,"_19254":47556,"_5":13218,"_26298":47495,"_2652":47557},[],"**Active**",{"_3154":780,"_27801":760,"_19254":47559,"_5":13218,"_26298":47495,"_2652":47560},[],"The slot is active; also check certificate dates, status and usages.",{"_3154":781,"_27801":760,"_19254":47562,"_5":13218,"_26298":47495,"_2652":47563},[],"**Renewal Pending**",{"_3154":782,"_27801":760,"_19254":47565,"_5":13218,"_26298":47495,"_2652":47566},[],"The identity is in the operational renewal window.",{"_3154":783,"_27801":760,"_19254":47568,"_5":13218,"_26298":47495,"_2652":47569},[],"**Expiring Soon**",{"_3154":784,"_27801":760,"_19254":47571,"_5":13218,"_26298":47495,"_2652":47572},[],"Expiration is approaching according to configured thresholds.",{"_3154":785,"_27801":760,"_19254":47574,"_5":13218,"_26298":47495,"_2652":47575},[],"**Expired**",{"_3154":786,"_27801":760,"_19254":47577,"_5":13218,"_26298":47495,"_2652":47578},[],"The identity has expired.",{"_3154":787,"_27801":760,"_19254":47580,"_5":13218,"_26298":47495,"_2652":47581},[],"**Revoked**",{"_3154":788,"_27801":760,"_19254":47583,"_5":13218,"_26298":47495,"_2652":47584},[],"The identity is marked revoked.",{"_3154":789,"_27801":760,"_19254":47586,"_5":13218,"_26298":47495,"_2652":47587},[],"**Decommissioned**",{"_3154":790,"_27801":760,"_19254":47589,"_5":13218,"_26298":47495,"_2652":47590},[],"The record is retired and ordinary updates do not restore operation.",{"_3154":791,"_27801":760,"_19254":47592,"_5":13218,"_26298":47495,"_2652":47593},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_3154":792,"_27801":760,"_19254":47595,"_5":13218,"_26298":47499,"_2652":47596},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_3154":793,"_27801":760,"_19254":47598,"_5":13218,"_26298":47499,"_2652":47599},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_3154":794,"_27801":760,"_19254":47601,"_5":13218,"_26298":47499,"_2652":47602},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_3154":795,"_27801":760,"_19254":47604,"_5":13218,"_26298":47499,"_2652":47605},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_3154":796,"_27801":760,"_19254":47607,"_5":13218,"_26298":47503,"_2652":47608},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_3154":797,"_27801":760,"_19254":47610,"_5":13218,"_26298":47507,"_2652":47611},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_3154":798,"_27801":760,"_19254":47613,"_5":13218,"_26298":47511,"_2652":47614},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_3154":799,"_27801":760,"_19254":47616,"_5":13218,"_26298":47515,"_2652":47617},[],"Add model, environment or location tags and an icon according to your inventory.",{"_3154":800,"_27801":760,"_19254":47619,"_5":13218,"_26298":47519,"_2652":47620},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_3154":801,"_27801":760,"_19254":47622,"_5":13218,"_26298":47519,"_2652":47623},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_3154":802,"_27801":760,"_19254":47625,"_5":13218,"_26298":47523,"_2652":47626},[],"From **No Identity**, use **Assign Identity**:",{"_3154":803,"_27801":760,"_19254":47628,"_5":13218,"_26298":47523,"_2652":47629},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_3154":804,"_27801":760,"_19254":47631,"_5":13218,"_26298":47523,"_2652":47632},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_3154":805,"_27801":760,"_19254":47634,"_5":13218,"_26298":47523,"_2652":47635},[],"Confirm and read the serial, active version and history again.",{"_3154":806,"_27801":760,"_19254":47637,"_5":13218,"_26298":47523,"_2652":47638},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_3154":807,"_27801":760,"_19254":47640,"_5":13218,"_26298":47523,"_2652":47641},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_3154":808,"_27801":760,"_19254":47643,"_5":13218,"_26298":47527,"_2652":47644},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_3154":809,"_27801":760,"_19254":47646,"_5":13218,"_26298":47527,"_2652":47647},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_3154":810,"_27801":760,"_19254":47649,"_5":13218,"_26298":47531,"_2652":47650},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_3154":811,"_27801":760,"_19254":47652,"_5":13218,"_26298":47531,"_2652":47653},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_3154":812,"_27801":760,"_19254":47655,"_5":13218,"_26298":47531,"_2652":47656},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_3154":813,"_27801":760,"_19254":47658,"_5":13218,"_26298":47531,"_2652":47659},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_3154":814,"_27801":760,"_19254":47661,"_5":13218,"_26298":47535,"_2652":47662},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3154":815,"_27801":760,"_19254":47664,"_5":13218,"_26298":47535,"_2652":47665},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3154":816,"_27801":816,"_5":13544,"_2652":47667,"_28144":47668,"_19254":47670,"_26298":816},"Bootstrap identity and authentication",[45131,46511,47488,47486,47669],"Enrollment with PKI",[],{"_3154":817,"_27801":816,"_19254":47672,"_5":13218,"_26298":816,"_2652":47673},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_3154":818,"_27801":816,"_5":28141,"_19254":47675,"_26298":47676,"_2652":47677},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_3154":819,"_27801":816,"_5":28141,"_19254":47679,"_26298":47680,"_2652":47681},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_3154":820,"_27801":816,"_5":28141,"_19254":47683,"_26298":47684,"_2652":47685},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_3154":821,"_27801":816,"_5":28141,"_19254":47687,"_26298":47688,"_2652":47689},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_3154":822,"_27801":816,"_5":28141,"_19254":47691,"_26298":47692,"_2652":47693},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_3154":823,"_27801":816,"_19254":47695,"_5":13218,"_26298":816,"_2652":47696},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_3154":824,"_27801":816,"_19254":47698,"_5":13218,"_26298":47676,"_2652":47699},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_3154":825,"_27801":816,"_19254":47701,"_5":13218,"_26298":47676,"_2652":47702},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_3154":826,"_27801":816,"_19254":47704,"_5":13218,"_26298":47680,"_2652":47705},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_3154":827,"_27801":816,"_19254":47707,"_5":13218,"_26298":47680,"_2652":47708},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_3154":828,"_27801":816,"_19254":47710,"_5":13218,"_26298":47680,"_2652":47711},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_3154":829,"_27801":816,"_19254":47713,"_5":13218,"_26298":47684,"_2652":47714},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_3154":830,"_27801":816,"_19254":47716,"_5":13218,"_26298":47684,"_2652":47717},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_3154":831,"_27801":816,"_19254":47719,"_5":13218,"_26298":47688,"_2652":47720},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_3154":832,"_27801":816,"_19254":47722,"_5":13218,"_26298":47688,"_2652":47723},[],"Example body:",{"_3154":833,"_27801":816,"_19254":47725,"_5":13218,"_26298":47688,"_2652":47726},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_3154":834,"_27801":816,"_19254":47728,"_5":13218,"_26298":47688,"_2652":47729},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_3154":835,"_27801":816,"_19254":47731,"_5":13218,"_26298":47688,"_2652":47732},[],"Continuation requires a successful HTTP response and JSON:",{"_3154":836,"_27801":816,"_19254":47734,"_5":13218,"_26298":47688,"_2652":47735},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_3154":837,"_27801":816,"_19254":47737,"_5":13218,"_26298":47692,"_2652":47738},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_3154":838,"_27801":816,"_19254":47740,"_5":13218,"_26298":47692,"_2652":47741},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_3154":839,"_27801":839,"_5":13544,"_2652":47743,"_28144":47744,"_19254":47745,"_26298":839},"Configure and operate the DMS",[45131,46511,47488,47486,47669],[],{"_3154":840,"_27801":839,"_19254":47747,"_5":13218,"_26298":839,"_2652":47748},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_3154":841,"_27801":839,"_5":28141,"_19254":47750,"_26298":47751,"_2652":45141},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/dms#before-you-begin",{"_3154":842,"_27801":839,"_5":28141,"_19254":47753,"_26298":47754,"_2652":47755},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_3154":843,"_27801":839,"_5":28141,"_19254":47757,"_26298":47758,"_2652":47759},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_3154":844,"_27801":839,"_5":28141,"_19254":47761,"_26298":47762,"_2652":47763},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_3154":845,"_27801":839,"_5":28141,"_19254":47765,"_26298":47766,"_2652":47767},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_3154":846,"_27801":839,"_5":28141,"_19254":47769,"_26298":47770,"_2652":47771},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_3154":847,"_27801":839,"_5":28141,"_19254":47773,"_26298":47774,"_2652":47775},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_3154":848,"_27801":839,"_5":28141,"_19254":47777,"_26298":47778,"_2652":47779},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_3154":849,"_27801":839,"_5":28141,"_19254":47781,"_26298":47782,"_2652":47783},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_3154":850,"_27801":839,"_5":28141,"_19254":47785,"_26298":47786,"_2652":47787},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_3154":851,"_27801":839,"_5":28141,"_19254":47789,"_26298":47790,"_2652":47791},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_3154":852,"_27801":839,"_5":28141,"_19254":47793,"_26298":47794,"_2652":47795},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_3154":853,"_27801":839,"_5":28141,"_19254":47797,"_26298":47798,"_2652":47799},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_3154":854,"_27801":839,"_5":28141,"_19254":47801,"_26298":47802,"_2652":47803},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_3154":855,"_27801":839,"_5":28141,"_19254":47805,"_26298":47806,"_2652":47807},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_3154":856,"_27801":839,"_5":28141,"_19254":47809,"_26298":47810,"_2652":47811},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_3154":857,"_27801":839,"_5":28141,"_19254":47813,"_26298":47814,"_2652":47815},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_3154":858,"_27801":839,"_5":28141,"_19254":47817,"_26298":47818,"_2652":47819},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_3154":859,"_27801":839,"_19254":47821,"_5":13218,"_26298":839,"_2652":47822},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_3154":860,"_27801":839,"_19254":47824,"_5":13218,"_26298":47751,"_2652":47825},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_3154":861,"_27801":839,"_19254":47827,"_5":13218,"_26298":47751,"_2652":47828},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_3154":862,"_27801":839,"_19254":47830,"_5":13218,"_26298":47758,"_2652":47831},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_3154":863,"_27801":839,"_19254":47833,"_5":13218,"_26298":47762,"_2652":47834},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_3154":864,"_27801":839,"_19254":47836,"_5":13218,"_26298":47766,"_2652":47837},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_3154":865,"_27801":839,"_19254":47839,"_5":13218,"_26298":47770,"_2652":47840},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_3154":866,"_27801":839,"_19254":47842,"_5":13218,"_26298":47774,"_2652":47843},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_3154":867,"_27801":839,"_19254":47845,"_5":13218,"_26298":47782,"_2652":47846},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_3154":868,"_27801":839,"_19254":47848,"_5":13218,"_26298":47782,"_2652":47849},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_3154":869,"_27801":839,"_19254":47851,"_5":13218,"_26298":47786,"_2652":47852},[],"`settings.enrollment_settings` field",{"_3154":870,"_27801":839,"_19254":47854,"_5":13218,"_26298":47786,"_2652":47855},[],"Decision",{"_3154":871,"_27801":839,"_19254":47857,"_5":13218,"_26298":47786,"_2652":47858},[],"`protocol`",{"_3154":872,"_27801":839,"_19254":47860,"_5":13218,"_26298":47786,"_2652":47861},[],"`EST_RFC7030` for these operations.",{"_3154":873,"_27801":839,"_19254":47863,"_5":13218,"_26298":47786,"_2652":47864},[],"`enrollment_ca`",{"_3154":874,"_27801":839,"_19254":47866,"_5":13218,"_26298":47786,"_2652":47867},[],"ID of the signing CA.",{"_3154":875,"_27801":839,"_19254":47869,"_5":13218,"_26298":47786,"_2652":47870},[],"`verify_csr_signature`",{"_3154":876,"_27801":839,"_19254":47872,"_5":13218,"_26298":47786,"_2652":47873},[],"Keep `true` to verify CSR key possession.",{"_3154":877,"_27801":839,"_19254":47875,"_5":13218,"_26298":47786,"_2652":47876},[],"`enable_replaceable_enrollment`",{"_3154":878,"_27801":839,"_19254":47878,"_5":13218,"_26298":47786,"_2652":47879},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_3154":879,"_27801":839,"_19254":47881,"_5":13218,"_26298":47786,"_2652":47882},[],"`est_rfc7030_settings.auth_mode`",{"_3154":880,"_27801":839,"_19254":47884,"_5":13218,"_26298":47786,"_2652":47885},[],"One of the four authentication modes.",{"_3154":881,"_27801":839,"_19254":47887,"_5":13218,"_26298":47786,"_2652":47888},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_3154":882,"_27801":839,"_19254":47890,"_5":13218,"_26298":47790,"_2652":47891},[],"The blocks are independent:",{"_3154":883,"_27801":839,"_19254":47893,"_5":13218,"_26298":47790,"_2652":47894},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_3154":884,"_27801":839,"_19254":47896,"_5":13218,"_26298":47790,"_2652":47897},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_3154":885,"_27801":839,"_19254":47899,"_5":13218,"_26298":47790,"_2652":47900},[],"`auth_mode`",{"_3154":886,"_27801":839,"_19254":47902,"_5":13218,"_26298":47790,"_2652":47903},[],"Control applied in the configured operation",{"_3154":887,"_27801":839,"_19254":47905,"_5":13218,"_26298":47790,"_2652":47906},[],"`CLIENT_CERTIFICATE`",{"_3154":888,"_27801":839,"_19254":47908,"_5":13218,"_26298":47790,"_2652":47909},[],"Presented certificate validation.",{"_3154":889,"_27801":839,"_19254":47911,"_5":13218,"_26298":47790,"_2652":47912},[],"`EXTERNAL_WEBHOOK`",{"_3154":890,"_27801":839,"_19254":47914,"_5":13218,"_26298":47790,"_2652":47915},[],"Configured webhook authorization.",{"_3154":891,"_27801":839,"_19254":47917,"_5":13218,"_26298":47790,"_2652":47918},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3154":892,"_27801":839,"_19254":47920,"_5":13218,"_26298":47790,"_2652":47921},[],"Certificate validation followed by webhook approval.",{"_3154":893,"_27801":839,"_19254":47923,"_5":13218,"_26298":47790,"_2652":47924},[],"`NO_AUTH`",{"_3154":894,"_27801":839,"_19254":47926,"_5":13218,"_26298":47790,"_2652":47927},[],"No DMS requester authentication.",{"_3154":895,"_27801":839,"_19254":47929,"_5":13218,"_26298":47790,"_2652":47930},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_3154":896,"_27801":839,"_19254":47932,"_5":13218,"_26298":47790,"_2652":47933},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_3154":897,"_27801":839,"_19254":47935,"_5":13218,"_26298":47790,"_2652":47936},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs. That list is optional because the enrollment CA is always trusted for re-enrollment, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`.",{"_3154":898,"_27801":839,"_19254":47938,"_5":13218,"_26298":47790,"_2652":47939},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_3154":899,"_27801":839,"_19254":47941,"_5":13218,"_26298":47794,"_2652":47942},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_3154":900,"_27801":839,"_19254":47944,"_5":13218,"_26298":47794,"_2652":47945},[],"`external_webhook_settings` field",{"_3154":901,"_27801":839,"_19254":47947,"_5":13218,"_26298":47794,"_2652":47855},[],{"_3154":902,"_27801":839,"_19254":47949,"_5":13218,"_26298":47794,"_2652":47950},[],"`url`",{"_3154":903,"_27801":839,"_19254":47952,"_5":13218,"_26298":47794,"_2652":47953},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_3154":904,"_27801":839,"_19254":47955,"_5":13218,"_26298":47794,"_2652":47956},[],"`method`",{"_3154":905,"_27801":839,"_19254":47958,"_5":13218,"_26298":47794,"_2652":47959},[],"`POST` or `PUT`; `POST` by default.",{"_3154":906,"_27801":839,"_19254":47961,"_5":13218,"_26298":47794,"_2652":47962},[],"`name`",{"_3154":907,"_27801":839,"_19254":47964,"_5":13218,"_26298":47794,"_2652":47965},[],"Label used in service logs.",{"_3154":908,"_27801":839,"_19254":47967,"_5":13218,"_26298":47794,"_2652":47968},[],"`config.auth_mode`",{"_3154":909,"_27801":839,"_19254":47970,"_5":13218,"_26298":47794,"_2652":47971},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_3154":910,"_27801":839,"_19254":47973,"_5":13218,"_26298":47794,"_2652":47974},[],"`config.apikey_options`",{"_3154":911,"_27801":839,"_19254":47976,"_5":13218,"_26298":47794,"_2652":47977},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_3154":912,"_27801":839,"_19254":47979,"_5":13218,"_26298":47794,"_2652":47980},[],"`config.jwt_options`",{"_3154":913,"_27801":839,"_19254":47982,"_5":13218,"_26298":47794,"_2652":47983},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3154":914,"_27801":839,"_19254":47985,"_5":13218,"_26298":47794,"_2652":47986},[],"`config.mtls_options`",{"_3154":915,"_27801":839,"_19254":47988,"_5":13218,"_26298":47794,"_2652":47989},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_3154":916,"_27801":839,"_19254":47991,"_5":13218,"_26298":47794,"_2652":47992},[],"`config.insecure_skip_verify`",{"_3154":917,"_27801":839,"_19254":47994,"_5":13218,"_26298":47794,"_2652":47995},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_3154":918,"_27801":839,"_19254":47997,"_5":13218,"_26298":47794,"_2652":47998},[],"`config.call_timeout`",{"_3154":919,"_27801":839,"_19254":48000,"_5":13218,"_26298":47794,"_2652":48001},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_3154":920,"_27801":839,"_19254":48003,"_5":13218,"_26298":47794,"_2652":48004},[],"Rules for that configuration:",{"_3154":921,"_27801":839,"_19254":48006,"_5":13218,"_26298":47794,"_2652":48007},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_3154":922,"_27801":839,"_19254":48009,"_5":13218,"_26298":47794,"_2652":48010},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_3154":923,"_27801":839,"_19254":48012,"_5":13218,"_26298":47794,"_2652":48013},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_3154":924,"_27801":839,"_19254":48015,"_5":13218,"_26298":47794,"_2652":48016},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_3154":925,"_27801":839,"_19254":48018,"_5":13218,"_26298":47794,"_2652":48019},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_3154":926,"_27801":839,"_19254":48021,"_5":13218,"_26298":47794,"_2652":48022},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_3154":927,"_27801":839,"_19254":48024,"_5":13218,"_26298":47794,"_2652":48025},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing, and if your version's console does not expose independent settings, use the DMS API.",{"_3154":928,"_27801":839,"_19254":48027,"_5":13218,"_26298":47794,"_2652":48028},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_3154":929,"_27801":839,"_19254":48030,"_5":13218,"_26298":47794,"_2652":48031},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_3154":930,"_27801":839,"_19254":48033,"_5":13218,"_26298":47798,"_2652":48034},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_3154":931,"_27801":839,"_19254":48036,"_5":13218,"_26298":47802,"_2652":48037},[],"`settings.reenrollment_settings` field",{"_3154":932,"_27801":839,"_19254":48039,"_5":13218,"_26298":47802,"_2652":45521},[],{"_3154":933,"_27801":839,"_19254":48041,"_5":13218,"_26298":47802,"_2652":48042},[],"`reenrollment_delta`",{"_3154":934,"_27801":839,"_19254":48044,"_5":13218,"_26298":47802,"_2652":48045},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_3154":935,"_27801":839,"_19254":48047,"_5":13218,"_26298":47802,"_2652":48048},[],"`preventive_delta`",{"_3154":936,"_27801":839,"_19254":48050,"_5":13218,"_26298":47802,"_2652":48051},[],"Preventive operational monitoring threshold.",{"_3154":937,"_27801":839,"_19254":48053,"_5":13218,"_26298":47802,"_2652":48054},[],"`critical_delta`",{"_3154":938,"_27801":839,"_19254":48056,"_5":13218,"_26298":47802,"_2652":48057},[],"Critical operational monitoring threshold.",{"_3154":939,"_27801":839,"_19254":48059,"_5":13218,"_26298":47802,"_2652":48060},[],"`enable_expired_renewal`",{"_3154":940,"_27801":839,"_19254":48062,"_5":13218,"_26298":47802,"_2652":48063},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_3154":941,"_27801":839,"_19254":48065,"_5":13218,"_26298":47802,"_2652":48066},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_3154":942,"_27801":839,"_19254":48068,"_5":13218,"_26298":47802,"_2652":48069},[],"Re-enrollment validation CAs for the renewal mTLS credential, tried after the enrollment CA; optional, because the enrollment CA is always trusted. Typically populated during CA rotation while old-CA cohorts renew.",{"_3154":943,"_27801":839,"_19254":48071,"_5":13218,"_26298":47802,"_2652":48072},[],"`revoke_on_reenrollment`",{"_3154":944,"_27801":839,"_19254":48074,"_5":13218,"_26298":47802,"_2652":48075},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_3154":945,"_27801":839,"_19254":48077,"_5":13218,"_26298":47802,"_2652":48078},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_3154":946,"_27801":839,"_19254":48080,"_5":13218,"_26298":47806,"_2652":48081},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. The console exposes it through an **Enable server-side key generation** switch and a **Key type** selection: `ECDSA` P-256, P-384 or P-521, or `RSA` with 2048, 3072 or 4096 bits; the defaults are P-256 for `ECDSA` and 4096 bit for `RSA`. Algorithm and size come from its `key` field, stored as `{type,bits}` where P-256, P-384 and P-521 map to `bits` 256, 384 and 521; `key` is omitted when disabled. The profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_3154":947,"_27801":839,"_19254":48083,"_5":13218,"_26298":47810,"_2652":45515},[],{"_3154":948,"_27801":839,"_19254":48085,"_5":13218,"_26298":47810,"_2652":48086},[],"Published material",{"_3154":949,"_27801":839,"_19254":48088,"_5":13218,"_26298":47810,"_2652":48089},[],"**Include Lamassu System CA**",{"_3154":950,"_27801":839,"_19254":48091,"_5":13218,"_26298":47810,"_2652":48092},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_3154":951,"_27801":839,"_19254":48094,"_5":13218,"_26298":47810,"_2652":48095},[],"**Include Enrollment CA**",{"_3154":952,"_27801":839,"_19254":48097,"_5":13218,"_26298":47810,"_2652":48098},[],"Selected issuing CA certificate.",{"_3154":953,"_27801":839,"_19254":48100,"_5":13218,"_26298":47810,"_2652":48101},[],"**Managed CAs**",{"_3154":954,"_27801":839,"_19254":48103,"_5":13218,"_26298":47810,"_2652":48104},[],"Explicitly selected CA certificates.",{"_3154":955,"_27801":839,"_19254":48106,"_5":13218,"_26298":47810,"_2652":48107},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_3154":956,"_27801":839,"_19254":48109,"_5":13218,"_26298":47814,"_2652":48110},[],"**Edit** changes name, settings and metadata. Backend updates replace these complete blocks; read the DMS before sending API edits to avoid losing fields.",{"_3154":957,"_27801":839,"_19254":48112,"_5":13218,"_26298":47814,"_2652":48113},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_3154":958,"_27801":839,"_19254":48115,"_5":13218,"_26298":47814,"_2652":48116},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_3154":959,"_27801":839,"_19254":48118,"_5":13218,"_26298":47818,"_2652":48119},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_3154":960,"_27801":960,"_5":13544,"_2652":48121,"_28144":48122,"_19254":48123,"_26298":960},"Integrate the EST client",[45131,46511,47488,47486,47669],[],{"_3154":961,"_27801":960,"_19254":48125,"_5":13218,"_26298":960,"_2652":48126},[],"Prepare trust, send a CSR and check the identity you receive.",{"_3154":962,"_27801":960,"_5":28141,"_19254":48128,"_26298":48129,"_2652":45141},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_3154":963,"_27801":960,"_5":28141,"_19254":48131,"_26298":48132,"_2652":48133},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_3154":964,"_27801":960,"_5":28141,"_19254":48135,"_26298":48136,"_2652":48137},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_3154":965,"_27801":960,"_5":28141,"_19254":48139,"_26298":48140,"_2652":48141},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_3154":966,"_27801":960,"_5":28141,"_19254":48143,"_26298":48144,"_2652":48145},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_3154":967,"_27801":960,"_5":28141,"_19254":48147,"_26298":48148,"_2652":48149},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_3154":968,"_27801":960,"_19254":48151,"_5":13218,"_26298":960,"_2652":48152},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_3154":969,"_27801":960,"_19254":48154,"_5":13218,"_26298":48129,"_2652":48155},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_3154":970,"_27801":960,"_19254":48157,"_5":13218,"_26298":48129,"_2652":48158},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_3154":971,"_27801":960,"_19254":48160,"_5":13218,"_26298":48129,"_2652":48161},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_3154":972,"_27801":960,"_19254":48163,"_5":13218,"_26298":48132,"_2652":48164},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_3154":973,"_27801":960,"_19254":48166,"_5":13218,"_26298":48132,"_2652":48167},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_3154":974,"_27801":960,"_19254":48169,"_5":13218,"_26298":48136,"_2652":48170},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_3154":975,"_27801":960,"_19254":48172,"_5":13218,"_26298":48136,"_2652":48173},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_3154":976,"_27801":960,"_19254":48175,"_5":13218,"_26298":48140,"_2652":48176},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_3154":977,"_27801":960,"_19254":48178,"_5":13218,"_26298":48140,"_2652":48179},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_3154":978,"_27801":960,"_19254":48181,"_5":13218,"_26298":48144,"_2652":48182},[],"For a root that issues directly:",{"_3154":979,"_27801":960,"_19254":48184,"_5":13218,"_26298":48144,"_2652":48185},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_3154":980,"_27801":960,"_19254":48187,"_5":13218,"_26298":48144,"_2652":48188},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_3154":981,"_27801":960,"_19254":48190,"_5":13218,"_26298":48148,"_2652":48191},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_3154":982,"_27801":982,"_5":13544,"_2652":48193,"_28144":48194,"_19254":48195,"_26298":982},"EST reference",[45131,46511,47488,47486,47669],[],{"_3154":983,"_27801":982,"_19254":48197,"_5":13218,"_26298":982,"_2652":48198},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_3154":984,"_27801":982,"_5":28141,"_19254":48200,"_26298":48201,"_2652":48202},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_3154":985,"_27801":982,"_5":28141,"_19254":48204,"_26298":48205,"_2652":20919},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3154":986,"_27801":982,"_5":28141,"_19254":48207,"_26298":48208,"_2652":24021},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3154":987,"_27801":982,"_5":28141,"_19254":48210,"_26298":48211,"_2652":24028},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3154":988,"_27801":982,"_5":28141,"_19254":48213,"_26298":48214,"_2652":23362},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3154":989,"_27801":982,"_5":28141,"_19254":48216,"_26298":48217,"_2652":48218},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_3154":990,"_27801":982,"_5":28141,"_19254":48220,"_26298":48221,"_2652":48222},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_3154":991,"_27801":982,"_5":28141,"_19254":48224,"_26298":48225,"_2652":48226},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_3154":992,"_27801":982,"_19254":48228,"_5":13218,"_26298":982,"_2652":48229},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_3154":993,"_27801":982,"_19254":48231,"_5":13218,"_26298":48201,"_2652":48232},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_3154":994,"_27801":982,"_19254":48234,"_5":13218,"_26298":48201,"_2652":48235},[],"Operation",{"_3154":995,"_27801":982,"_19254":48237,"_5":13218,"_26298":48201,"_2652":48238},[],"Method",{"_3154":996,"_27801":982,"_19254":48240,"_5":13218,"_26298":48201,"_2652":48241},[],"Authentication and condition",{"_3154":997,"_27801":982,"_19254":48243,"_5":13218,"_26298":48201,"_2652":48244},[],"`/cacerts`",{"_3154":998,"_27801":982,"_19254":48246,"_5":13218,"_26298":48201,"_2652":48247},[],"GET",{"_3154":999,"_27801":982,"_19254":48249,"_5":13218,"_26298":48201,"_2652":48250},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_3154":1000,"_27801":982,"_19254":48252,"_5":13218,"_26298":48201,"_2652":48253},[],"`/simpleenroll`",{"_3154":1001,"_27801":982,"_19254":48255,"_5":13218,"_26298":48201,"_2652":48256},[],"POST",{"_3154":1002,"_27801":982,"_19254":48258,"_5":13218,"_26298":48201,"_2652":48259},[],"Initial authentication and DMS registration/replacement policy.",{"_3154":1003,"_27801":982,"_19254":48261,"_5":13218,"_26298":48201,"_2652":48262},[],"`/simplereenroll`",{"_3154":1004,"_27801":982,"_19254":48264,"_5":13218,"_26298":48201,"_2652":48256},[],{"_3154":1005,"_27801":982,"_19254":48266,"_5":13218,"_26298":48201,"_2652":48267},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_3154":1006,"_27801":982,"_19254":48269,"_5":13218,"_26298":48201,"_2652":48270},[],"`/serverkeygen`",{"_3154":1007,"_27801":982,"_19254":48272,"_5":13218,"_26298":48201,"_2652":48256},[],{"_3154":1008,"_27801":982,"_19254":48274,"_5":13218,"_26298":48201,"_2652":48275},[],"Initial authentication and admission; server generation enabled.",{"_3154":1009,"_27801":982,"_19254":48277,"_5":13218,"_26298":48201,"_2652":48278},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_3154":1010,"_27801":982,"_19254":48280,"_5":13218,"_26298":48205,"_2652":48281},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_3154":1011,"_27801":982,"_19254":48283,"_5":13218,"_26298":48205,"_2652":48284},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_3154":1012,"_27801":982,"_19254":48286,"_5":13218,"_26298":48208,"_2652":48287},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_3154":1013,"_27801":982,"_19254":48289,"_5":13218,"_26298":48208,"_2652":48290},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_3154":1014,"_27801":982,"_19254":48292,"_5":13218,"_26298":48211,"_2652":48293},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_3154":1015,"_27801":982,"_19254":48295,"_5":13218,"_26298":48211,"_2652":48296},[],"In mTLS mode, the enrollment CA always validates the re-enrollment credential; certificates from other issuers are accepted only if they are listed as validation CAs in the re-enrollment block. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_3154":1016,"_27801":982,"_19254":48298,"_5":13218,"_26298":48214,"_2652":48299},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_3154":1017,"_27801":982,"_19254":48301,"_5":13218,"_26298":48214,"_2652":48302},[],"The code supports RSA and ECDSA, and the `bits` value of the DMS key setting means something different for each. For ECDSA it selects the curve: 224, 256, 384 or 521 map to P-224, P-256, P-384 and P-521, and an unrecognized size falls back to P-256, so explicitly select a compatible size and check the resulting key. For RSA it is used directly as the modulus size; the console offers 2048, 3072 and 4096 bits. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_3154":1018,"_27801":982,"_19254":48304,"_5":13218,"_26298":48217,"_2652":48305},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_3154":1019,"_27801":982,"_19254":48307,"_5":13218,"_26298":48217,"_2652":48308},[],"Part",{"_3154":1020,"_27801":982,"_19254":48310,"_5":13218,"_26298":48217,"_2652":48311},[],"Content after decoding its Base64",{"_3154":1021,"_27801":982,"_19254":48313,"_5":13218,"_26298":48217,"_2652":48314},[],"`application/pkcs8`",{"_3154":1022,"_27801":982,"_19254":48316,"_5":13218,"_26298":48217,"_2652":48317},[],"Unencrypted DER PKCS#8 private key.",{"_3154":1023,"_27801":982,"_19254":48319,"_5":13218,"_26298":48217,"_2652":48320},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_3154":1024,"_27801":982,"_19254":48322,"_5":13218,"_26298":48217,"_2652":48323},[],"DER PKCS#7 containing the issued certificate.",{"_3154":1025,"_27801":982,"_19254":48325,"_5":13218,"_26298":48217,"_2652":48326},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_3154":1026,"_27801":982,"_19254":48328,"_5":13218,"_26298":48221,"_2652":48329},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_3154":1027,"_27801":982,"_19254":48331,"_5":13218,"_26298":48221,"_2652":48332},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_3154":1028,"_27801":982,"_19254":48334,"_5":13218,"_26298":48221,"_2652":48335},[],"Convert and check the result:",{"_3154":1029,"_27801":982,"_19254":48337,"_5":13218,"_26298":48221,"_2652":48338},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_3154":1030,"_27801":982,"_19254":48340,"_5":13218,"_26298":48225,"_2652":48341},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_3154":1031,"_27801":982,"_19254":48343,"_5":13218,"_26298":48225,"_2652":48344},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_3154":1032,"_27801":1032,"_5":13544,"_2652":47669,"_28144":48346,"_19254":48347,"_26298":1032},[45131,46511,47488,47486,47669],[],{"_3154":1033,"_27801":1032,"_19254":48349,"_5":13218,"_26298":1032,"_2652":48350},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_3154":1034,"_27801":1032,"_5":28141,"_19254":48352,"_26298":48353,"_2652":48354},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_3154":1035,"_27801":1032,"_5":28141,"_19254":48356,"_26298":48357,"_2652":48358},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_3154":1036,"_27801":1032,"_5":28141,"_19254":48360,"_26298":48361,"_2652":48362},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_3154":1037,"_27801":1032,"_5":28141,"_19254":48364,"_26298":48365,"_2652":48366},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_3154":1038,"_27801":1032,"_19254":48368,"_5":13218,"_26298":1032,"_2652":48369},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_3154":1039,"_27801":1032,"_19254":48371,"_5":13218,"_26298":48353,"_2652":48372},[],"The administrator prepares the CA, issuance profile and DMS.",{"_3154":1040,"_27801":1032,"_19254":48374,"_5":13218,"_26298":48353,"_2652":48375},[],"The integrator installs initial EST server trust and an admission credential.",{"_3154":1041,"_27801":1032,"_19254":48377,"_5":13218,"_26298":48353,"_2652":48378},[],"The client requests an identity for its `Device ID` through EST.",{"_3154":1042,"_27801":1032,"_19254":48380,"_5":13218,"_26298":48353,"_2652":48381},[],"Certificate, device binding and key/certificate installation are checked.",{"_3154":1043,"_27801":1032,"_19254":48383,"_5":13218,"_26298":48353,"_2652":48384},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_3154":1044,"_27801":1032,"_19254":48386,"_5":13218,"_26298":48353,"_2652":48387},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_3154":1045,"_27801":1032,"_19254":48389,"_5":13218,"_26298":48357,"_2652":48390},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3154":1046,"_27801":1032,"_19254":48392,"_5":13218,"_26298":48357,"_2652":48393},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3154":1047,"_27801":1032,"_19254":48395,"_5":13218,"_26298":48357,"_2652":48396},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3154":1048,"_27801":1032,"_19254":48398,"_5":13218,"_26298":48357,"_2652":48399},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3154":1049,"_27801":1032,"_19254":48401,"_5":13218,"_26298":48361,"_2652":48402},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3154":1050,"_27801":1032,"_19254":48404,"_5":13218,"_26298":48361,"_2652":48405},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3154":1051,"_27801":1032,"_19254":48407,"_5":13218,"_26298":48361,"_2652":48408},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3154":1052,"_27801":1032,"_19254":48410,"_5":13218,"_26298":48361,"_2652":48411},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3154":1053,"_27801":1032,"_19254":48413,"_5":13218,"_26298":48365,"_2652":48414},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_3154":1054,"_27801":1032,"_19254":48416,"_5":13218,"_26298":48365,"_2652":48417},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_3154":1055,"_27801":1055,"_5":13544,"_2652":48419,"_28144":48420,"_19254":48421,"_26298":1055},"Provisioning strategies",[45131,46511,47488,47486,47669],[],{"_3154":1056,"_27801":1055,"_19254":48423,"_5":13218,"_26298":1055,"_2652":48424},[],"Choose device registration, identity authorization and key generation.",{"_3154":1057,"_27801":1055,"_5":28141,"_19254":48426,"_26298":48427,"_2652":48428},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_3154":1058,"_27801":1055,"_5":28141,"_19254":48430,"_26298":48431,"_2652":48432},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_3154":1059,"_27801":1055,"_5":28141,"_19254":48434,"_26298":48435,"_2652":48436},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_3154":1060,"_27801":1055,"_5":28141,"_19254":48438,"_26298":48439,"_2652":48440},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_3154":1061,"_27801":1055,"_5":28141,"_19254":48442,"_26298":48443,"_2652":48444},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_3154":1062,"_27801":1055,"_19254":48446,"_5":13218,"_26298":1055,"_2652":48447},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_3154":1063,"_27801":1055,"_19254":48449,"_5":13218,"_26298":48427,"_2652":48450},[],"Path",{"_3154":1064,"_27801":1055,"_19254":48452,"_5":13218,"_26298":48427,"_2652":48453},[],"When the device exists",{"_3154":1065,"_27801":1055,"_19254":48455,"_5":13218,"_26298":48427,"_2652":48456},[],"What to check",{"_3154":1066,"_27801":1055,"_19254":48458,"_5":13218,"_26298":48427,"_2652":48459},[],"Manual assignment",{"_3154":1067,"_27801":1055,"_19254":48461,"_5":13218,"_26298":48427,"_2652":48462},[],"An operator creates it before associating a certificate.",{"_3154":1068,"_27801":1055,"_19254":48464,"_5":13218,"_26298":48427,"_2652":48465},[],"ID, owning DMS, certificate CN and bound serial.",{"_3154":1069,"_27801":1055,"_19254":48467,"_5":13218,"_26298":48427,"_2652":48468},[],"EST with `JITP`",{"_3154":1070,"_27801":1055,"_19254":48470,"_5":13218,"_26298":48427,"_2652":48471},[],"Created for an unknown CN during `/simpleenroll`.",{"_3154":1071,"_27801":1055,"_19254":48473,"_5":13218,"_26298":48427,"_2652":48474},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_3154":1072,"_27801":1055,"_19254":48476,"_5":13218,"_26298":48427,"_2652":48477},[],"EST with `PRE_REGISTRATION`",{"_3154":1073,"_27801":1055,"_19254":48479,"_5":13218,"_26298":48427,"_2652":48480},[],"Must exist before `/simpleenroll`.",{"_3154":1074,"_27801":1055,"_19254":48482,"_5":13218,"_26298":48427,"_2652":48483},[],"Approved record, same DMS and replacement conditions for your version.",{"_3154":1075,"_27801":1055,"_19254":48485,"_5":13218,"_26298":48427,"_2652":48486},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_3154":1076,"_27801":1055,"_19254":48488,"_5":13218,"_26298":48427,"_2652":48489},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_3154":1077,"_27801":1055,"_19254":48491,"_5":13218,"_26298":48431,"_2652":48492},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_3154":1078,"_27801":1055,"_19254":48494,"_5":13218,"_26298":48431,"_2652":48495},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_3154":1079,"_27801":1055,"_19254":48497,"_5":13218,"_26298":48431,"_2652":48498},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_3154":1080,"_27801":1055,"_19254":48500,"_5":13218,"_26298":48435,"_2652":48501},[],"Decide initial enrollment and re-enrollment separately:",{"_3154":1081,"_27801":1055,"_19254":48503,"_5":13218,"_26298":48435,"_2652":48504},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_3154":1082,"_27801":1055,"_19254":48506,"_5":13218,"_26298":48435,"_2652":48507},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_3154":1083,"_27801":1055,"_19254":48509,"_5":13218,"_26298":48435,"_2652":48510},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_3154":1084,"_27801":1055,"_19254":48512,"_5":13218,"_26298":48435,"_2652":48513},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_3154":1085,"_27801":1055,"_19254":48515,"_5":13218,"_26298":48435,"_2652":48516},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_3154":1086,"_27801":1055,"_19254":48518,"_5":13218,"_26298":48439,"_2652":45515},[],{"_3154":1087,"_27801":1055,"_19254":48520,"_5":13218,"_26298":48439,"_2652":48521},[],"Material crossing EST",{"_3154":1088,"_27801":1055,"_19254":48523,"_5":13218,"_26298":48439,"_2652":48524},[],"Device-generated key",{"_3154":1089,"_27801":1055,"_19254":48526,"_5":13218,"_26298":48439,"_2652":48527},[],"Public CSR and certificate; the key stays on the client.",{"_3154":1090,"_27801":1055,"_19254":48529,"_5":13218,"_26298":48439,"_2652":48530},[],"Existing device key",{"_3154":1091,"_27801":1055,"_19254":48532,"_5":13218,"_26298":48439,"_2652":48533},[],"CSR signed with that key and a new certificate.",{"_3154":1092,"_27801":1055,"_19254":48535,"_5":13218,"_26298":48439,"_2652":47807},[],{"_3154":1093,"_27801":1055,"_19254":48537,"_5":13218,"_26298":48439,"_2652":48538},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_3154":1094,"_27801":1055,"_19254":48540,"_5":13218,"_26298":48439,"_2652":48541},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_3154":1095,"_27801":1055,"_19254":48543,"_5":13218,"_26298":48443,"_2652":48544},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_3154":1096,"_27801":1096,"_5":13544,"_2652":48546,"_28144":48547,"_19254":48548,"_26298":1096},"Renewal and recovery",[45131,46511,47488,47486,47669],[],{"_3154":1097,"_27801":1096,"_19254":48550,"_5":13218,"_26298":1096,"_2652":48551},[],"Renew without losing the identity and recover devices according to their actual state.",{"_3154":1098,"_27801":1096,"_5":28141,"_19254":48553,"_26298":48554,"_2652":48555},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_3154":1099,"_27801":1096,"_5":28141,"_19254":48557,"_26298":48558,"_2652":48559},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_3154":1100,"_27801":1096,"_5":28141,"_19254":48561,"_26298":48562,"_2652":48563},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_3154":1101,"_27801":1096,"_5":28141,"_19254":48565,"_26298":48566,"_2652":48567},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_3154":1102,"_27801":1096,"_5":28141,"_19254":48569,"_26298":48570,"_2652":48571},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_3154":1103,"_27801":1096,"_19254":48573,"_5":13218,"_26298":1096,"_2652":48574},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_3154":1104,"_27801":1096,"_19254":48576,"_5":13218,"_26298":48554,"_2652":48577},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_3154":1105,"_27801":1096,"_19254":48579,"_5":13218,"_26298":48554,"_2652":48580},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_3154":1106,"_27801":1096,"_19254":48582,"_5":13218,"_26298":48554,"_2652":48583},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_3154":1107,"_27801":1096,"_19254":48585,"_5":13218,"_26298":48554,"_2652":48586},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_3154":1108,"_27801":1096,"_19254":48588,"_5":13218,"_26298":48558,"_2652":48589},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_3154":1109,"_27801":1096,"_19254":48591,"_5":13218,"_26298":48558,"_2652":48592},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_3154":1110,"_27801":1096,"_19254":48594,"_5":13218,"_26298":48562,"_2652":48595},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_3154":1111,"_27801":1096,"_19254":48597,"_5":13218,"_26298":48562,"_2652":48598},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_3154":1112,"_27801":1096,"_19254":48600,"_5":13218,"_26298":48562,"_2652":48601},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_3154":1113,"_27801":1096,"_19254":48603,"_5":13218,"_26298":48566,"_2652":48604},[],"Situation",{"_3154":1114,"_27801":1096,"_19254":48606,"_5":13218,"_26298":48566,"_2652":48607},[],"Procedure",{"_3154":1115,"_27801":1096,"_19254":48609,"_5":13218,"_26298":48566,"_2652":48610},[],"Valid certificate, outside the window",{"_3154":1116,"_27801":1096,"_19254":48612,"_5":13218,"_26298":48566,"_2652":48613},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_3154":1117,"_27801":1096,"_19254":48615,"_5":13218,"_26298":48566,"_2652":48616},[],"Expired certificate, key available",{"_3154":1118,"_27801":1096,"_19254":48618,"_5":13218,"_26298":48566,"_2652":48619},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_3154":1119,"_27801":1096,"_19254":48621,"_5":13218,"_26298":48566,"_2652":48622},[],"Renewal through webhook or `NO_AUTH`",{"_3154":1120,"_27801":1096,"_19254":48624,"_5":13218,"_26298":48566,"_2652":48625},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_3154":1121,"_27801":1096,"_19254":48627,"_5":13218,"_26298":48566,"_2652":48628},[],"Lost or inaccessible key",{"_3154":1122,"_27801":1096,"_19254":48630,"_5":13218,"_26298":48566,"_2652":48631},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_3154":1123,"_27801":1096,"_19254":48633,"_5":13218,"_26298":48566,"_2652":48634},[],"Current identity revoked",{"_3154":1124,"_27801":1096,"_19254":48636,"_5":13218,"_26298":48566,"_2652":48637},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_3154":1125,"_27801":1096,"_19254":48639,"_5":13218,"_26298":48566,"_2652":48640},[],"Device without an identity",{"_3154":1126,"_27801":1096,"_19254":48642,"_5":13218,"_26298":48566,"_2652":48643},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_3154":1127,"_27801":1096,"_19254":48645,"_5":13218,"_26298":48566,"_2652":48646},[],"Retired device",{"_3154":1128,"_27801":1096,"_19254":48648,"_5":13218,"_26298":48566,"_2652":48649},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_3154":1129,"_27801":1096,"_19254":48651,"_5":13218,"_26298":48566,"_2652":48652},[],"Timeout, HTTP 500 or installation failure",{"_3154":1130,"_27801":1096,"_19254":48654,"_5":13218,"_26298":48566,"_2652":48655},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_3154":1131,"_27801":1096,"_19254":48657,"_5":13218,"_26298":48570,"_2652":48658},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_3154":1132,"_27801":1096,"_19254":48660,"_5":13218,"_26298":48570,"_2652":48661},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_3154":1133,"_27801":1133,"_5":13544,"_2652":48663,"_28144":48664,"_19254":48665,"_26298":1133},"Enrollment troubleshooting",[45131,46511,47488,47486,47669],[],{"_3154":1134,"_27801":1133,"_19254":48667,"_5":13218,"_26298":1133,"_2652":48668},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_3154":1135,"_27801":1133,"_5":28141,"_19254":48670,"_26298":48671,"_2652":48672},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_3154":1136,"_27801":1133,"_5":28141,"_19254":48674,"_26298":48675,"_2652":48676},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_3154":1137,"_27801":1133,"_5":28141,"_19254":48678,"_26298":48679,"_2652":48226},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_3154":1138,"_27801":1133,"_5":28141,"_19254":48681,"_26298":48682,"_2652":48683},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_3154":1139,"_27801":1133,"_19254":48685,"_5":13218,"_26298":1133,"_2652":48686},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_3154":1140,"_27801":1133,"_19254":48688,"_5":13218,"_26298":48675,"_2652":48689},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_3154":1141,"_27801":1133,"_19254":48691,"_5":13218,"_26298":48675,"_2652":48692},[],"Symptom or message",{"_3154":1142,"_27801":1133,"_19254":48694,"_5":13218,"_26298":48675,"_2652":48456},[],{"_3154":1143,"_27801":1133,"_19254":48696,"_5":13218,"_26298":48675,"_2652":48697},[],"curl rejects TLS, name or issuer",{"_3154":1144,"_27801":1133,"_19254":48699,"_5":13218,"_26298":48675,"_2652":48700},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_3154":1145,"_27801":1133,"_19254":48702,"_5":13218,"_26298":48675,"_2652":48703},[],"404 or missing APS",{"_3154":1146,"_27801":1133,"_19254":48705,"_5":13218,"_26298":48675,"_2652":48706},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_3154":1147,"_27801":1133,"_19254":48708,"_5":13218,"_26298":48675,"_2652":48709},[],"400, CSR or format error",{"_3154":1148,"_27801":1133,"_19254":48711,"_5":13218,"_26298":48675,"_2652":48712},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_3154":1149,"_27801":1133,"_19254":48714,"_5":13218,"_26298":48675,"_2652":48715},[],"Missing credential or invalid certificate",{"_3154":1150,"_27801":1133,"_19254":48717,"_5":13218,"_26298":48675,"_2652":48718},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_3154":1151,"_27801":1133,"_19254":48720,"_5":13218,"_26298":48675,"_2652":48721},[],"Webhook denies, times out or responds without authorization",{"_3154":1152,"_27801":1133,"_19254":48723,"_5":13218,"_26298":48675,"_2652":48724},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_3154":1153,"_27801":1133,"_19254":48726,"_5":13218,"_26298":48675,"_2652":48727},[],"`unexpected status code: <n>: redirects are not followed`",{"_3154":1154,"_27801":1133,"_19254":48729,"_5":13218,"_26298":48675,"_2652":48730},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_3154":1155,"_27801":1133,"_19254":48732,"_5":13218,"_26298":48675,"_2652":48733},[],"`webhook response exceeds 1048576 bytes`",{"_3154":1156,"_27801":1133,"_19254":48735,"_5":13218,"_26298":48675,"_2652":48736},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_3154":1157,"_27801":1133,"_19254":48738,"_5":13218,"_26298":48675,"_2652":48739},[],"`webhook config must not reference files`",{"_3154":1158,"_27801":1133,"_19254":48741,"_5":13218,"_26298":48675,"_2652":48742},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_3154":1159,"_27801":1133,"_19254":48744,"_5":13218,"_26298":48675,"_2652":48745},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_3154":1160,"_27801":1133,"_19254":48747,"_5":13218,"_26298":48675,"_2652":48748},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_3154":1161,"_27801":1133,"_19254":48750,"_5":13218,"_26298":48675,"_2652":48751},[],"`webhook mTLS certificate and key are invalid: …`",{"_3154":1162,"_27801":1133,"_19254":48753,"_5":13218,"_26298":48675,"_2652":48754},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_3154":1163,"_27801":1133,"_19254":48756,"_5":13218,"_26298":48675,"_2652":48757},[],"400 `struct validation error` creating or updating a DMS",{"_3154":1164,"_27801":1133,"_19254":48759,"_5":13218,"_26298":48675,"_2652":48760},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_3154":1165,"_27801":1133,"_19254":48762,"_5":13218,"_26298":48675,"_2652":48763},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_3154":1166,"_27801":1133,"_19254":48765,"_5":13218,"_26298":48675,"_2652":48766},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_3154":1167,"_27801":1133,"_19254":48768,"_5":13218,"_26298":48675,"_2652":48769},[],"`device not preregistered`",{"_3154":1168,"_27801":1133,"_19254":48771,"_5":13218,"_26298":48675,"_2652":48772},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_3154":1169,"_27801":1133,"_19254":48774,"_5":13218,"_26298":48675,"_2652":48775},[],"`forbiddenNewEnrollment`",{"_3154":1170,"_27801":1133,"_19254":48777,"_5":13218,"_26298":48675,"_2652":48778},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_3154":1171,"_27801":1133,"_19254":48780,"_5":13218,"_26298":48675,"_2652":48781},[],"Different owning DMS",{"_3154":1172,"_27801":1133,"_19254":48783,"_5":13218,"_26298":48675,"_2652":48784},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_3154":1173,"_27801":1133,"_19254":48786,"_5":13218,"_26298":48675,"_2652":48787},[],"`invalid RawSubject bytes`",{"_3154":1174,"_27801":1133,"_19254":48789,"_5":13218,"_26298":48675,"_2652":48790},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_3154":1175,"_27801":1133,"_19254":48792,"_5":13218,"_26298":48675,"_2652":48793},[],"`invalid reenroll window`",{"_3154":1176,"_27801":1133,"_19254":48795,"_5":13218,"_26298":48675,"_2652":48796},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_3154":1177,"_27801":1133,"_19254":48798,"_5":13218,"_26298":48675,"_2652":48799},[],"Current certificate revoked",{"_3154":1178,"_27801":1133,"_19254":48801,"_5":13218,"_26298":48675,"_2652":48802},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_3154":1179,"_27801":1133,"_19254":48804,"_5":13218,"_26298":48675,"_2652":48805},[],"CA, profile or signing error",{"_3154":1180,"_27801":1133,"_19254":48807,"_5":13218,"_26298":48675,"_2652":48808},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_3154":1181,"_27801":1133,"_19254":48810,"_5":13218,"_26298":48675,"_2652":48811},[],"HTTP 200 without a device connection",{"_3154":1182,"_27801":1133,"_19254":48813,"_5":13218,"_26298":48675,"_2652":48814},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_3154":1183,"_27801":1133,"_19254":48816,"_5":13218,"_26298":48675,"_2652":48817},[],"Timeout or error after issuance",{"_3154":1184,"_27801":1133,"_19254":48819,"_5":13218,"_26298":48675,"_2652":48820},[],"New certificates, current slot and previous identity's state before retrying.",{"_3154":1185,"_27801":1133,"_19254":48822,"_5":13218,"_26298":48679,"_2652":48823},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_3154":1186,"_27801":1133,"_19254":48825,"_5":13218,"_26298":48679,"_2652":48826},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_3154":1187,"_27801":1133,"_19254":48828,"_5":13218,"_26298":48682,"_2652":48829},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_3154":1188,"_27801":1133,"_19254":48831,"_5":13218,"_26298":48682,"_2652":48832},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_3154":1189,"_27801":1133,"_19254":48834,"_5":13218,"_26298":48682,"_2652":48835},[],"Verify the CSR locally and relate its CN to the inventory.",{"_3154":1190,"_27801":1133,"_19254":48837,"_5":13218,"_26298":48682,"_2652":48838},[],"Make one request, save headers/body and query the device and certificates.",{"_3154":1191,"_27801":1133,"_19254":48840,"_5":13218,"_26298":48682,"_2652":48841},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_3154":1192,"_27801":1133,"_19254":48843,"_5":13218,"_26298":48682,"_2652":48844},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_3154":1193,"_27801":1133,"_19254":48846,"_5":13218,"_26298":48682,"_2652":48847},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_3154":1194,"_27801":1194,"_5":13544,"_2652":48849,"_28144":48850,"_19254":48851,"_26298":1194},"Trust distribution and updates",[45131,46511,47488,47486,47669],[],{"_3154":1195,"_27801":1194,"_19254":48853,"_5":13218,"_26298":1194,"_2652":48854},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_3154":1196,"_27801":1194,"_5":28141,"_19254":48856,"_26298":48857,"_2652":48858},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_3154":1197,"_27801":1194,"_5":28141,"_19254":48860,"_26298":48861,"_2652":48862},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_3154":1198,"_27801":1194,"_5":28141,"_19254":48864,"_26298":48865,"_2652":48866},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_3154":1199,"_27801":1194,"_5":28141,"_19254":48868,"_26298":48869,"_2652":48870},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_3154":1200,"_27801":1194,"_5":28141,"_19254":48872,"_26298":48873,"_2652":48874},[],"/docs/pr-preview/pr-53/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_3154":1201,"_27801":1194,"_19254":48876,"_5":13218,"_26298":1194,"_2652":48877},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_3154":1202,"_27801":1194,"_19254":48879,"_5":13218,"_26298":48857,"_2652":48880},[],"Relationship",{"_3154":1203,"_27801":1194,"_19254":48882,"_5":13218,"_26298":48857,"_2652":48883},[],"Material prepared by its owner",{"_3154":1204,"_27801":1194,"_19254":48885,"_5":13218,"_26298":48857,"_2652":48886},[],"Device → EST server",{"_3154":1205,"_27801":1194,"_19254":48888,"_5":13218,"_26298":48857,"_2652":48889},[],"Previously verified server root, chain or pin and TLS name.",{"_3154":1206,"_27801":1194,"_19254":48891,"_5":13218,"_26298":48857,"_2652":48892},[],"DMS → requester",{"_3154":1207,"_27801":1194,"_19254":48894,"_5":13218,"_26298":48857,"_2652":48895},[],"CAs and rules authorizing initial or renewal credentials.",{"_3154":1208,"_27801":1194,"_19254":48897,"_5":13218,"_26298":48857,"_2652":48898},[],"Consumer → device",{"_3154":1209,"_27801":1194,"_19254":48900,"_5":13218,"_26298":48857,"_2652":48901},[],"Operational identity roots, intermediates, validation and permissions.",{"_3154":1210,"_27801":1194,"_19254":48903,"_5":13218,"_26298":48857,"_2652":48904},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_3154":1211,"_27801":1194,"_19254":48906,"_5":13218,"_26298":48861,"_2652":48907},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_3154":1212,"_27801":1194,"_19254":48909,"_5":13218,"_26298":48861,"_2652":48910},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_3154":1213,"_27801":1194,"_19254":48912,"_5":13218,"_26298":48865,"_2652":48913},[],"Keep initial EST server trust separate from identity consumer trust.",{"_3154":1214,"_27801":1194,"_19254":48915,"_5":13218,"_26298":48865,"_2652":48916},[],"Select policy-approved roots as anchors.",{"_3154":1215,"_27801":1194,"_19254":48918,"_5":13218,"_26298":48865,"_2652":48919},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_3154":1216,"_27801":1194,"_19254":48921,"_5":13218,"_26298":48865,"_2652":48922},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_3154":1217,"_27801":1194,"_19254":48924,"_5":13218,"_26298":48865,"_2652":48925},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_3154":1218,"_27801":1194,"_19254":48927,"_5":13218,"_26298":48865,"_2652":48928},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_3154":1219,"_27801":1194,"_19254":48930,"_5":13218,"_26298":48869,"_2652":48931},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_3154":1220,"_27801":1194,"_19254":48933,"_5":13218,"_26298":48869,"_2652":48934},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. That list is optional because the enrollment CA always validates re-enrollment credentials, but when switching the enrollment CA, add the previous issuance CA to it so old-CA identities keep re-enrolling during overlap. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_3154":1221,"_27801":1194,"_19254":48936,"_5":13218,"_26298":48869,"_2652":48937},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_3154":1222,"_27801":1194,"_19254":48939,"_5":13218,"_26298":48873,"_2652":48940},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_3154":1223,"_27801":1223,"_5":13544,"_2652":48942,"_28144":48943,"_19254":48945,"_26298":1223},"AWS IoT Core",[45131,46511,47488,47486,48944],"Integrations",[],{"_3154":1224,"_27801":1223,"_19254":48947,"_5":13218,"_26298":1223,"_2652":48948},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_3154":1225,"_27801":1223,"_5":28141,"_19254":48950,"_26298":48951,"_2652":48952},[],"/docs/pr-preview/pr-53/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_3154":1226,"_27801":1223,"_5":28141,"_19254":48954,"_26298":48955,"_2652":48956},[],"/docs/pr-preview/pr-53/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_3154":1227,"_27801":1223,"_5":28141,"_19254":48958,"_26298":48959,"_2652":48960},[],"/docs/pr-preview/pr-53/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_3154":1228,"_27801":1223,"_5":28141,"_19254":48962,"_26298":48963,"_2652":48964},[],"/docs/pr-preview/pr-53/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_3154":1229,"_27801":1223,"_5":28141,"_19254":48966,"_26298":48967,"_2652":48968},[],"/docs/pr-preview/pr-53/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_3154":1230,"_27801":1223,"_5":28141,"_19254":48970,"_26298":48971,"_2652":48972},[],"/docs/pr-preview/pr-53/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_3154":1231,"_27801":1223,"_5":28141,"_19254":48974,"_26298":48975,"_2652":48976},[],"/docs/pr-preview/pr-53/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_3154":1232,"_27801":1223,"_5":28141,"_19254":48978,"_26298":48979,"_2652":48980},[],"/docs/pr-preview/pr-53/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3154":1233,"_27801":1223,"_5":28141,"_19254":48982,"_26298":48983,"_2652":48984},[],"/docs/pr-preview/pr-53/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_3154":1234,"_27801":1223,"_5":28141,"_19254":48986,"_26298":48987,"_2652":48988},[],"/docs/pr-preview/pr-53/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_3154":1235,"_27801":1223,"_5":28141,"_19254":48990,"_26298":48991,"_2652":48992},[],"/docs/pr-preview/pr-53/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_3154":1236,"_27801":1223,"_5":28141,"_19254":48994,"_26298":48995,"_2652":48996},[],"/docs/pr-preview/pr-53/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_3154":1237,"_27801":1223,"_5":28141,"_19254":48998,"_26298":48999,"_2652":49000},[],"/docs/pr-preview/pr-53/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_3154":1238,"_27801":1223,"_5":28141,"_19254":49002,"_26298":49003,"_2652":49004},[],"/docs/pr-preview/pr-53/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_3154":1239,"_27801":1223,"_5":28141,"_19254":49006,"_26298":49007,"_2652":49008},[],"/docs/pr-preview/pr-53/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_3154":1240,"_27801":1223,"_5":28141,"_19254":49010,"_26298":49011,"_2652":49012},[],"/docs/pr-preview/pr-53/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_3154":1241,"_27801":1223,"_5":28141,"_19254":49014,"_26298":49015,"_2652":49016},[],"/docs/pr-preview/pr-53/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_3154":1242,"_27801":1223,"_5":28141,"_19254":49018,"_26298":49019,"_2652":49020},[],"/docs/pr-preview/pr-53/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_3154":1243,"_27801":1223,"_5":28141,"_19254":49022,"_26298":49023,"_2652":49024},[],"/docs/pr-preview/pr-53/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_3154":1244,"_27801":1223,"_5":28141,"_19254":49026,"_26298":49027,"_2652":49028},[],"/docs/pr-preview/pr-53/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_3154":1245,"_27801":1223,"_19254":49030,"_5":13218,"_26298":1223,"_2652":49031},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_3154":1246,"_27801":1223,"_19254":49033,"_5":13218,"_26298":1223,"_2652":49034},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_3154":1247,"_27801":1223,"_19254":49036,"_5":13218,"_26298":1223,"_2652":49037},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_3154":1248,"_27801":1223,"_19254":49039,"_5":13218,"_26298":48951,"_2652":49040},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_3154":1249,"_27801":1223,"_19254":49042,"_5":13218,"_26298":48951,"_2652":49043},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_3154":1250,"_27801":1223,"_19254":49045,"_5":13218,"_26298":48951,"_2652":49046},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_3154":1251,"_27801":1223,"_19254":49048,"_5":13218,"_26298":48951,"_2652":49049},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_3154":1252,"_27801":1223,"_19254":49051,"_5":13218,"_26298":48955,"_2652":49052},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_3154":1253,"_27801":1223,"_19254":49054,"_5":13218,"_26298":48959,"_2652":49055},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_3154":1254,"_27801":1223,"_19254":49057,"_5":13218,"_26298":48959,"_2652":49058},[],"IAM action",{"_3154":1255,"_27801":1223,"_19254":49060,"_5":13218,"_26298":48959,"_2652":45521},[],{"_3154":1256,"_27801":1223,"_19254":49062,"_5":13218,"_26298":48959,"_2652":49063},[],"`iot:GetRegistrationCode`",{"_3154":1257,"_27801":1223,"_19254":49065,"_5":13218,"_26298":48959,"_2652":49066},[],"Obtain the verification code for CA registration in the Primary Account",{"_3154":1258,"_27801":1223,"_19254":49068,"_5":13218,"_26298":48959,"_2652":49069},[],"`iot:RegisterCACertificate`",{"_3154":1259,"_27801":1223,"_19254":49071,"_5":13218,"_26298":48959,"_2652":49072},[],"Register the CA in AWS IoT",{"_3154":1260,"_27801":1223,"_19254":49074,"_5":13218,"_26298":48959,"_2652":49075},[],"`iot:DescribeCACertificate`",{"_3154":1261,"_27801":1223,"_19254":49077,"_5":13218,"_26298":48959,"_2652":49078},[],"Check the CA registration status",{"_3154":1262,"_27801":1223,"_19254":49080,"_5":13218,"_26298":48959,"_2652":49081},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3154":1263,"_27801":1223,"_19254":49083,"_5":13218,"_26298":48959,"_2652":49084},[],"Create or update Things in IoT Core",{"_3154":1264,"_27801":1223,"_19254":49086,"_5":13218,"_26298":48959,"_2652":49087},[],"`iot:RegisterThing`",{"_3154":1265,"_27801":1223,"_19254":49089,"_5":13218,"_26298":48959,"_2652":49090},[],"Provision Things through a template",{"_3154":1266,"_27801":1223,"_19254":49092,"_5":13218,"_26298":48959,"_2652":49093},[],"`iot:RegisterCertificate`",{"_3154":1267,"_27801":1223,"_19254":49095,"_5":13218,"_26298":48959,"_2652":49096},[],"Register device certificates",{"_3154":1268,"_27801":1223,"_19254":49098,"_5":13218,"_26298":48959,"_2652":49099},[],"`iot:UpdateCertificate`",{"_3154":1269,"_27801":1223,"_19254":49101,"_5":13218,"_26298":48959,"_2652":49102},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_3154":1270,"_27801":1223,"_19254":49104,"_5":13218,"_26298":48959,"_2652":49105},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3154":1271,"_27801":1223,"_19254":49107,"_5":13218,"_26298":48959,"_2652":49108},[],"Create and attach IoT policies",{"_3154":1272,"_27801":1223,"_19254":49110,"_5":13218,"_26298":48959,"_2652":49111},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3154":1273,"_27801":1223,"_19254":49113,"_5":13218,"_26298":48959,"_2652":49114},[],"Manage Thing groups",{"_3154":1274,"_27801":1223,"_19254":49116,"_5":13218,"_26298":48959,"_2652":49117},[],"`iot:CreateProvisioningTemplate`",{"_3154":1275,"_27801":1223,"_19254":49119,"_5":13218,"_26298":48959,"_2652":49120},[],"Create JITP templates",{"_3154":1276,"_27801":1223,"_19254":49122,"_5":13218,"_26298":48959,"_2652":49123},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3154":1277,"_27801":1223,"_19254":49125,"_5":13218,"_26298":48959,"_2652":49126},[],"Read and write the Device Shadow",{"_3154":1278,"_27801":1223,"_19254":49128,"_5":13218,"_26298":48959,"_2652":49129},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_3154":1279,"_27801":1223,"_19254":49131,"_5":13218,"_26298":48963,"_2652":49132},[],"Parameter",{"_3154":1280,"_27801":1223,"_19254":49134,"_5":13218,"_26298":48963,"_2652":49135},[],"Type",{"_3154":1281,"_27801":1223,"_19254":49137,"_5":13218,"_26298":48963,"_2652":49138},[],"Required",{"_3154":1282,"_27801":1223,"_19254":49140,"_5":13218,"_26298":48963,"_2652":49141},[],"Description",{"_3154":1283,"_27801":1223,"_19254":49143,"_5":13218,"_26298":48963,"_2652":49144},[],"`connector_id`",{"_3154":1284,"_27801":1223,"_19254":49146,"_5":13218,"_26298":48963,"_2652":23039},[],{"_3154":1285,"_27801":1223,"_19254":49148,"_5":13218,"_26298":48963,"_2652":49149},[],"Yes",{"_3154":1286,"_27801":1223,"_19254":49151,"_5":13218,"_26298":48963,"_2652":49152},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_3154":1287,"_27801":1223,"_19254":49154,"_5":13218,"_26298":48963,"_2652":49155},[],"`aws_config.region`",{"_3154":1288,"_27801":1223,"_19254":49157,"_5":13218,"_26298":48963,"_2652":23039},[],{"_3154":1289,"_27801":1223,"_19254":49159,"_5":13218,"_26298":48963,"_2652":49149},[],{"_3154":1290,"_27801":1223,"_19254":49161,"_5":13218,"_26298":48963,"_2652":49162},[],"AWS region where the connector operates.",{"_3154":1291,"_27801":1223,"_19254":49164,"_5":13218,"_26298":48963,"_2652":49165},[],"`aws_config.auth_method`",{"_3154":1292,"_27801":1223,"_19254":49167,"_5":13218,"_26298":48963,"_2652":23039},[],{"_3154":1293,"_27801":1223,"_19254":49169,"_5":13218,"_26298":48963,"_2652":49149},[],{"_3154":1294,"_27801":1223,"_19254":49171,"_5":13218,"_26298":48963,"_2652":49172},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_3154":1295,"_27801":1223,"_19254":49174,"_5":13218,"_26298":48963,"_2652":49175},[],"`aws_config.access_key_id`",{"_3154":1296,"_27801":1223,"_19254":49177,"_5":13218,"_26298":48963,"_2652":23039},[],{"_3154":1297,"_27801":1223,"_19254":49179,"_5":13218,"_26298":48963,"_2652":49180},[],"Only with `auth_method=static`",{"_3154":1298,"_27801":1223,"_19254":49182,"_5":13218,"_26298":48963,"_2652":49183},[],"AWS access key.",{"_3154":1299,"_27801":1223,"_19254":49185,"_5":13218,"_26298":48963,"_2652":49186},[],"`aws_config.secret_access_key`",{"_3154":1300,"_27801":1223,"_19254":49188,"_5":13218,"_26298":48963,"_2652":23039},[],{"_3154":1301,"_27801":1223,"_19254":49190,"_5":13218,"_26298":48963,"_2652":49180},[],{"_3154":1302,"_27801":1223,"_19254":49192,"_5":13218,"_26298":48963,"_2652":49193},[],"AWS secret key.",{"_3154":1303,"_27801":1223,"_19254":49195,"_5":13218,"_26298":48963,"_2652":49196},[],"`aws_config.session_token`",{"_3154":1304,"_27801":1223,"_19254":49198,"_5":13218,"_26298":48963,"_2652":23039},[],{"_3154":1305,"_27801":1223,"_19254":49200,"_5":13218,"_26298":48963,"_2652":49201},[],"No",{"_3154":1306,"_27801":1223,"_19254":49203,"_5":13218,"_26298":48963,"_2652":49204},[],"Session token (with `auth_method=static`).",{"_3154":1307,"_27801":1223,"_19254":49206,"_5":13218,"_26298":48963,"_2652":49207},[],"`aws_config.role_arn`",{"_3154":1308,"_27801":1223,"_19254":49209,"_5":13218,"_26298":48963,"_2652":23039},[],{"_3154":1309,"_27801":1223,"_19254":49211,"_5":13218,"_26298":48963,"_2652":49212},[],"Only with `auth_method=role`",{"_3154":1310,"_27801":1223,"_19254":49214,"_5":13218,"_26298":48963,"_2652":49215},[],"ARN of the role to assume.",{"_3154":1311,"_27801":1223,"_19254":49217,"_5":13218,"_26298":48963,"_2652":49218},[],"`aws_config.endpoint_url`",{"_3154":1312,"_27801":1223,"_19254":49220,"_5":13218,"_26298":48963,"_2652":23039},[],{"_3154":1313,"_27801":1223,"_19254":49222,"_5":13218,"_26298":48963,"_2652":49201},[],{"_3154":1314,"_27801":1223,"_19254":49224,"_5":13218,"_26298":48963,"_2652":49225},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_3154":1315,"_27801":1223,"_19254":49227,"_5":13218,"_26298":48963,"_2652":49228},[],"`subscriber_event_bus`",{"_3154":1316,"_27801":1223,"_19254":49230,"_5":13218,"_26298":48963,"_2652":16220},[],{"_3154":1317,"_27801":1223,"_19254":49232,"_5":13218,"_26298":48963,"_2652":49149},[],{"_3154":1318,"_27801":1223,"_19254":49234,"_5":13218,"_26298":48963,"_2652":49235},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_3154":1319,"_27801":1223,"_19254":49237,"_5":13218,"_26298":48963,"_2652":49238},[],"`dms_manager_client`",{"_3154":1320,"_27801":1223,"_19254":49240,"_5":13218,"_26298":48963,"_2652":23039},[],{"_3154":1321,"_27801":1223,"_19254":49242,"_5":13218,"_26298":48963,"_2652":49149},[],{"_3154":1322,"_27801":1223,"_19254":49244,"_5":13218,"_26298":48963,"_2652":49245},[],"HTTP URL of Lamassu's DMS Manager service.",{"_3154":1323,"_27801":1223,"_19254":49247,"_5":13218,"_26298":48963,"_2652":49248},[],"`device_manager_client`",{"_3154":1324,"_27801":1223,"_19254":49250,"_5":13218,"_26298":48963,"_2652":23039},[],{"_3154":1325,"_27801":1223,"_19254":49252,"_5":13218,"_26298":48963,"_2652":49149},[],{"_3154":1326,"_27801":1223,"_19254":49254,"_5":13218,"_26298":48963,"_2652":49255},[],"HTTP URL of Lamassu's Device Manager.",{"_3154":1327,"_27801":1223,"_19254":49257,"_5":13218,"_26298":48963,"_2652":49258},[],"`ca_client`",{"_3154":1328,"_27801":1223,"_19254":49260,"_5":13218,"_26298":48963,"_2652":23039},[],{"_3154":1329,"_27801":1223,"_19254":49262,"_5":13218,"_26298":48963,"_2652":49149},[],{"_3154":1330,"_27801":1223,"_19254":49264,"_5":13218,"_26298":48963,"_2652":49265},[],"HTTP URL of Lamassu's CA service.",{"_3154":1331,"_27801":1223,"_19254":49267,"_5":13218,"_26298":48967,"_2652":49268},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_3154":1332,"_27801":1223,"_19254":49270,"_5":13218,"_26298":48971,"_2652":49271},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_3154":1333,"_27801":1223,"_19254":49273,"_5":13218,"_26298":48971,"_2652":49274},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_3154":1334,"_27801":1223,"_19254":49276,"_5":13218,"_26298":48975,"_2652":49277},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_3154":1335,"_27801":1223,"_19254":49279,"_5":13218,"_26298":48975,"_2652":49280},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_3154":1336,"_27801":1223,"_19254":49282,"_5":13218,"_26298":48975,"_2652":49283},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_3154":1337,"_27801":1223,"_19254":49285,"_5":13218,"_26298":48975,"_2652":49286},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_3154":1338,"_27801":1223,"_19254":49288,"_5":13218,"_26298":48975,"_2652":49289},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_3154":1339,"_27801":1223,"_19254":49291,"_5":13218,"_26298":48975,"_2652":49292},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_3154":1340,"_27801":1223,"_19254":49294,"_5":13218,"_26298":48979,"_2652":49295},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_3154":1341,"_27801":1223,"_19254":49297,"_5":13218,"_26298":48983,"_2652":49298},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_3154":1342,"_27801":1223,"_19254":49300,"_5":13218,"_26298":48983,"_2652":49301},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_3154":1343,"_27801":1223,"_19254":49303,"_5":13218,"_26298":48987,"_2652":49304},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_3154":1344,"_27801":1223,"_19254":49306,"_5":13218,"_26298":48991,"_2652":49307},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_3154":1345,"_27801":1223,"_19254":49309,"_5":13218,"_26298":48991,"_2652":49310},[],"Creates or updates the IoT policies configured in the DMS.",{"_3154":1346,"_27801":1223,"_19254":49312,"_5":13218,"_26298":48991,"_2652":49313},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_3154":1347,"_27801":1223,"_19254":49315,"_5":13218,"_26298":48991,"_2652":49316},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_3154":1348,"_27801":1223,"_19254":49318,"_5":13218,"_26298":48991,"_2652":49319},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_3154":1349,"_27801":1223,"_19254":49321,"_5":13218,"_26298":48991,"_2652":49322},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_3154":1350,"_27801":1223,"_19254":49324,"_5":13218,"_26298":48991,"_2652":49325},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_3154":1351,"_27801":1223,"_19254":49327,"_5":13218,"_26298":48995,"_2652":49328},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. This template is created or updated at the moment the DMS is created or updated in Lamassu — not at device enrollment time. From then on, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_3154":1352,"_27801":1223,"_19254":49330,"_5":13218,"_26298":48995,"_2652":49331},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_3154":1353,"_27801":1223,"_19254":49333,"_5":13218,"_26298":48995,"_2652":49334},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_3154":1354,"_27801":1223,"_19254":49336,"_5":13218,"_26298":48999,"_2652":49337},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_3154":1355,"_27801":1223,"_19254":49339,"_5":13218,"_26298":48999,"_2652":49340},[],"The full flow from the device's perspective is:",{"_3154":1356,"_27801":1223,"_19254":49342,"_5":13218,"_26298":48999,"_2652":49343},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_3154":1357,"_27801":1223,"_19254":49345,"_5":13218,"_26298":49003,"_2652":49346},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_3154":1358,"_27801":1223,"_19254":49348,"_5":13218,"_26298":49003,"_2652":49349},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_3154":1359,"_27801":1223,"_19254":49351,"_5":13218,"_26298":49003,"_2652":49352},[],"For the JITP flow to work correctly:",{"_3154":1360,"_27801":1223,"_19254":49354,"_5":13218,"_26298":49003,"_2652":49355},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_3154":1361,"_27801":1223,"_19254":49357,"_5":13218,"_26298":49003,"_2652":49358},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_3154":1362,"_27801":1223,"_19254":49360,"_5":13218,"_26298":49003,"_2652":49361},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_3154":1363,"_27801":1223,"_19254":49363,"_5":13218,"_26298":49003,"_2652":49364},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_3154":1364,"_27801":1223,"_19254":49366,"_5":13218,"_26298":49007,"_2652":49367},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_3154":1365,"_27801":1223,"_19254":49369,"_5":13218,"_26298":49007,"_2652":49370},[],"Status in Lamassu",{"_3154":1366,"_27801":1223,"_19254":49372,"_5":13218,"_26298":49007,"_2652":49373},[],"Revocation reason",{"_3154":1367,"_27801":1223,"_19254":49375,"_5":13218,"_26298":49007,"_2652":49376},[],"Status in AWS IoT Core",{"_3154":1368,"_27801":1223,"_19254":49378,"_5":13218,"_26298":49007,"_2652":49379},[],"`Active`",{"_3154":1369,"_27801":1223,"_19254":49381,"_5":13218,"_26298":49007,"_2652":49382},[],"None",{"_3154":1370,"_27801":1223,"_19254":49384,"_5":13218,"_26298":49007,"_2652":49385},[],"`ACTIVE`",{"_3154":1371,"_27801":1223,"_19254":49387,"_5":13218,"_26298":49007,"_2652":49388},[],"`Revoked`",{"_3154":1372,"_27801":1223,"_19254":49390,"_5":13218,"_26298":49007,"_2652":49391},[],"`certificateHold`",{"_3154":1373,"_27801":1223,"_19254":49393,"_5":13218,"_26298":49007,"_2652":49394},[],"`INACTIVE`",{"_3154":1374,"_27801":1223,"_19254":49396,"_5":13218,"_26298":49007,"_2652":49388},[],{"_3154":1375,"_27801":1223,"_19254":49398,"_5":13218,"_26298":49007,"_2652":49399},[],"Any other reason",{"_3154":1376,"_27801":1223,"_19254":49401,"_5":13218,"_26298":49007,"_2652":49402},[],"`REVOKED`",{"_3154":1377,"_27801":1223,"_19254":49404,"_5":13218,"_26298":49007,"_2652":49405},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_3154":1378,"_27801":1223,"_19254":49407,"_5":13218,"_26298":49011,"_2652":49408},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_3154":1379,"_27801":1223,"_19254":49410,"_5":13218,"_26298":49011,"_2652":49411},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_3154":1380,"_27801":1223,"_19254":49413,"_5":13218,"_26298":49011,"_2652":49414},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_3154":1381,"_27801":1223,"_19254":49416,"_5":13218,"_26298":49015,"_2652":49417},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_3154":1382,"_27801":1223,"_19254":49419,"_5":13218,"_26298":49015,"_2652":49420},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_3154":1383,"_27801":1223,"_19254":49422,"_5":13218,"_26298":49019,"_2652":49423},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_3154":1384,"_27801":1223,"_19254":49425,"_5":13218,"_26298":49019,"_2652":49426},[],"There are two action types:",{"_3154":1385,"_27801":1223,"_19254":49428,"_5":13218,"_26298":49019,"_2652":49429},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_3154":1386,"_27801":1223,"_19254":49431,"_5":13218,"_26298":49019,"_2652":49432},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_3154":1387,"_27801":1223,"_19254":49434,"_5":13218,"_26298":49019,"_2652":49435},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_3154":1388,"_27801":1223,"_19254":49437,"_5":13218,"_26298":49023,"_2652":49438},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_3154":1389,"_27801":1223,"_19254":49440,"_5":13218,"_26298":49023,"_2652":49441},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_3154":1390,"_27801":1223,"_19254":49443,"_5":13218,"_26298":49023,"_2652":49444},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_3154":1391,"_27801":1223,"_19254":49446,"_5":13218,"_26298":49027,"_2652":49447},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_3154":1392,"_27801":1223,"_19254":49449,"_5":13218,"_26298":49027,"_2652":49450},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_3154":1393,"_27801":1223,"_19254":49452,"_5":13218,"_26298":49027,"_2652":49453},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_3154":1394,"_27801":1223,"_19254":49455,"_5":13218,"_26298":49027,"_2652":49456},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_3154":1395,"_27801":1223,"_19254":49458,"_5":13218,"_26298":49027,"_2652":49459},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_3154":1396,"_27801":1223,"_19254":49461,"_5":13218,"_26298":49027,"_2652":49462},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_3154":1397,"_27801":1223,"_19254":49464,"_5":13218,"_26298":49027,"_2652":49465},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_3154":1398,"_27801":1223,"_19254":49467,"_5":13218,"_26298":49027,"_2652":49468},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_3154":1399,"_27801":1223,"_19254":49470,"_5":13218,"_26298":49027,"_2652":49471},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_3154":1400,"_27801":1223,"_19254":49473,"_5":13218,"_26298":49027,"_2652":49474},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_3154":1401,"_27801":1223,"_19254":49476,"_5":13218,"_26298":49027,"_2652":49477},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_3154":1402,"_27801":1223,"_19254":49479,"_5":13218,"_26298":49027,"_2652":49480},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_3154":1403,"_27801":1223,"_19254":49482,"_5":13218,"_26298":49027,"_2652":49483},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_3154":1404,"_27801":1223,"_19254":49485,"_5":13218,"_26298":49027,"_2652":49486},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_3154":1405,"_27801":1223,"_19254":49488,"_5":13218,"_26298":49027,"_2652":49489},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_3154":1406,"_27801":1223,"_19254":49491,"_5":13218,"_26298":49027,"_2652":49492},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_3154":1407,"_27801":1223,"_19254":49494,"_5":13218,"_26298":49027,"_2652":49495},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_3154":1408,"_27801":1223,"_19254":49497,"_5":13218,"_26298":49027,"_2652":49498},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_3154":1409,"_27801":1223,"_19254":49500,"_5":13218,"_26298":49027,"_2652":49501},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3154":1410,"_27801":1223,"_19254":49503,"_5":13218,"_26298":49027,"_2652":49504},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3154":1411,"_27801":1223,"_19254":49506,"_5":13218,"_26298":49027,"_2652":49507},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_3154":1412,"_27801":1412,"_5":13544,"_2652":47488,"_28144":49509,"_19254":49510,"_26298":1412},[45131,46511,47488],[],{"_3154":1413,"_27801":1412,"_19254":49512,"_5":13218,"_26298":1412,"_2652":49513},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_3154":1414,"_27801":1412,"_5":28141,"_19254":49515,"_26298":49516,"_2652":49517},[],"/docs/pr-preview/pr-53/platform/iot-fleets/overview#start-here","Start here",{"_3154":1415,"_27801":1412,"_5":28141,"_19254":49519,"_26298":49520,"_2652":47486},[],"/docs/pr-preview/pr-53/platform/iot-fleets/overview#devices-and-identities",{"_3154":1416,"_27801":1412,"_5":28141,"_19254":49522,"_26298":49523,"_2652":47669},[],"/docs/pr-preview/pr-53/platform/iot-fleets/overview#enrollment-with-pki",{"_3154":1417,"_27801":1412,"_5":28141,"_19254":49525,"_26298":49526,"_2652":48944},[],"/docs/pr-preview/pr-53/platform/iot-fleets/overview#integrations",{"_3154":1418,"_27801":1412,"_5":28141,"_19254":49528,"_26298":49529,"_2652":49530},[],"/docs/pr-preview/pr-53/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_3154":1419,"_27801":1412,"_19254":49532,"_5":13218,"_26298":1412,"_2652":49533},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_3154":1420,"_27801":1412,"_19254":49535,"_5":13218,"_26298":49516,"_2652":49536},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_3154":1421,"_27801":1412,"_19254":49538,"_5":13218,"_26298":49516,"_2652":49539},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_3154":1422,"_27801":1412,"_19254":49541,"_5":13218,"_26298":49520,"_2652":49542},[],"Resource",{"_3154":1423,"_27801":1412,"_19254":49544,"_5":13218,"_26298":49520,"_2652":49545},[],"What it represents",{"_3154":1424,"_27801":1412,"_19254":49547,"_5":13218,"_26298":49520,"_2652":49548},[],"**Device**",{"_3154":1425,"_27801":1412,"_19254":49550,"_5":13218,"_26298":49520,"_2652":49551},[],"An inventory entry with an identifier, owning DMS and classification.",{"_3154":1426,"_27801":1412,"_19254":49553,"_5":13218,"_26298":49520,"_2652":49554},[],"**Identity**",{"_3154":1427,"_27801":1412,"_19254":49556,"_5":13218,"_26298":49520,"_2652":49557},[],"The device's association with its certificates: an active version and a history.",{"_3154":1428,"_27801":1412,"_19254":49559,"_5":13218,"_26298":49520,"_2652":49560},[],"**DMS**",{"_3154":1429,"_27801":1412,"_19254":49562,"_5":13218,"_26298":49520,"_2652":49563},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_3154":1430,"_27801":1412,"_19254":49565,"_5":13218,"_26298":49520,"_2652":49566},[],"**Fleet**",{"_3154":1431,"_27801":1412,"_19254":49568,"_5":13218,"_26298":49520,"_2652":49569},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_3154":1432,"_27801":1412,"_19254":49571,"_5":13218,"_26298":49520,"_2652":49572},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_3154":1433,"_27801":1412,"_19254":49574,"_5":13218,"_26298":49520,"_2652":49575},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_3154":1434,"_27801":1412,"_19254":49577,"_5":13218,"_26298":49523,"_2652":49578},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_3154":1435,"_27801":1412,"_19254":49580,"_5":13218,"_26298":49523,"_2652":49581},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_3154":1436,"_27801":1412,"_19254":49583,"_5":13218,"_26298":49523,"_2652":49584},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_3154":1437,"_27801":1412,"_19254":49586,"_5":13218,"_26298":49523,"_2652":49587},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_3154":1438,"_27801":1412,"_19254":49589,"_5":13218,"_26298":49523,"_2652":49590},[],"**Result:** request the certificate, install it and check its association with the device.",{"_3154":1439,"_27801":1412,"_19254":49592,"_5":13218,"_26298":49523,"_2652":49593},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_3154":1440,"_27801":1412,"_19254":49595,"_5":13218,"_26298":49523,"_2652":49596},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3154":1441,"_27801":1412,"_19254":49598,"_5":13218,"_26298":49523,"_2652":49599},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3154":1442,"_27801":1412,"_19254":49601,"_5":13218,"_26298":49526,"_2652":49602},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_3154":1443,"_27801":1412,"_19254":49604,"_5":13218,"_26298":49526,"_2652":49605},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_3154":1444,"_27801":1412,"_19254":49607,"_5":13218,"_26298":49529,"_2652":49608},[],"Participant",{"_3154":1445,"_27801":1412,"_19254":49610,"_5":13218,"_26298":49529,"_2652":49611},[],"Responsibility",{"_3154":1446,"_27801":1412,"_19254":49613,"_5":13218,"_26298":49529,"_2652":49614},[],"PKI administrator",{"_3154":1447,"_27801":1412,"_19254":49616,"_5":13218,"_26298":49529,"_2652":49617},[],"CA, issuance profile, chain and revocation publication.",{"_3154":1448,"_27801":1412,"_19254":49619,"_5":13218,"_26298":49529,"_2652":49620},[],"Provisioning administrator",{"_3154":1449,"_27801":1412,"_19254":49622,"_5":13218,"_26298":49529,"_2652":49623},[],"DMS, admission, authentication per operation and inventory.",{"_3154":1450,"_27801":1412,"_19254":49625,"_5":13218,"_26298":49529,"_2652":49626},[],"Device integrator",{"_3154":1451,"_27801":1412,"_19254":49628,"_5":13218,"_26298":49529,"_2652":49629},[],"Initial credential, key, EST client, trust and certificate installation.",{"_3154":1452,"_27801":1412,"_19254":49631,"_5":13218,"_26298":49529,"_2652":49632},[],"Consumer integrator",{"_3154":1453,"_27801":1412,"_19254":49634,"_5":13218,"_26298":49529,"_2652":49635},[],"Trusted issuers, validation and device permissions in the destination.",{"_3154":1454,"_27801":1412,"_19254":49637,"_5":13218,"_26298":49529,"_2652":49638},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_3154":1455,"_27801":1455,"_5":13544,"_2652":49640,"_28144":49641,"_19254":49643,"_26298":1455},"Enroll and connect your first device",[45131,46511,47488,49642],"Getting started",[],{"_3154":1456,"_27801":1455,"_19254":49645,"_5":13218,"_26298":1455,"_2652":49646},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_3154":1457,"_27801":1455,"_5":28141,"_19254":49648,"_26298":49649,"_2652":45141},[],"/docs/pr-preview/pr-53/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_3154":1458,"_27801":1455,"_5":28141,"_19254":49651,"_26298":49652,"_2652":49653},[],"/docs/pr-preview/pr-53/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_3154":1459,"_27801":1455,"_5":28141,"_19254":49655,"_26298":49656,"_2652":49657},[],"/docs/pr-preview/pr-53/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_3154":1460,"_27801":1455,"_5":28141,"_19254":49659,"_26298":49660,"_2652":49661},[],"/docs/pr-preview/pr-53/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_3154":1461,"_27801":1455,"_5":28141,"_19254":49663,"_26298":49664,"_2652":49665},[],"/docs/pr-preview/pr-53/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_3154":1462,"_27801":1455,"_5":28141,"_19254":49667,"_26298":49668,"_2652":49669},[],"/docs/pr-preview/pr-53/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_3154":1463,"_27801":1455,"_5":28141,"_19254":49671,"_26298":49672,"_2652":49673},[],"/docs/pr-preview/pr-53/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_3154":1464,"_27801":1455,"_5":28141,"_19254":49675,"_26298":49676,"_2652":49677},[],"/docs/pr-preview/pr-53/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_3154":1465,"_27801":1455,"_19254":49679,"_5":13218,"_26298":1455,"_2652":49680},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_3154":1466,"_27801":1455,"_19254":49682,"_5":13218,"_26298":49649,"_2652":49683},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_3154":1467,"_27801":1455,"_19254":49685,"_5":13218,"_26298":49649,"_2652":49686},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_3154":1468,"_27801":1455,"_19254":49688,"_5":13218,"_26298":49649,"_2652":49689},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_3154":1469,"_27801":1455,"_19254":49691,"_5":13218,"_26298":49649,"_2652":49692},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_3154":1470,"_27801":1455,"_19254":49694,"_5":13218,"_26298":49649,"_2652":49695},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_3154":1471,"_27801":1455,"_19254":49697,"_5":13218,"_26298":49652,"_2652":49698},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_3154":1472,"_27801":1455,"_19254":49700,"_5":13218,"_26298":49652,"_2652":49701},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_3154":1473,"_27801":1455,"_19254":49703,"_5":13218,"_26298":49656,"_2652":49704},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_3154":1474,"_27801":1455,"_19254":49706,"_5":13218,"_26298":49656,"_2652":49707},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_3154":1475,"_27801":1455,"_19254":49709,"_5":13218,"_26298":49656,"_2652":49710},[],"Setting",{"_3154":1476,"_27801":1455,"_19254":49712,"_5":13218,"_26298":49656,"_2652":49713},[],"Evaluation value",{"_3154":1477,"_27801":1455,"_19254":49715,"_5":13218,"_26298":49656,"_2652":49716},[],"Enrollment CA",{"_3154":1478,"_27801":1455,"_19254":49718,"_5":13218,"_26298":49656,"_2652":49719},[],"Issuing root from `device-root.pem`.",{"_3154":1479,"_27801":1455,"_19254":49721,"_5":13218,"_26298":49656,"_2652":47799},[],{"_3154":1480,"_27801":1455,"_19254":49723,"_5":13218,"_26298":49656,"_2652":49724},[],"The 1-hour leaf profile you just prepared.",{"_3154":1481,"_27801":1455,"_19254":49726,"_5":13218,"_26298":49656,"_2652":49727},[],"Protocol / Registration Mode",{"_3154":1482,"_27801":1455,"_19254":49729,"_5":13218,"_26298":49656,"_2652":49730},[],"`EST_RFC7030` / `JITP`.",{"_3154":1483,"_27801":1455,"_19254":49732,"_5":13218,"_26298":49656,"_2652":49733},[],"Verify CSR Signature",{"_3154":1484,"_27801":1455,"_19254":49735,"_5":13218,"_26298":49656,"_2652":49736},[],"Enabled.",{"_3154":1485,"_27801":1455,"_19254":49738,"_5":13218,"_26298":49656,"_2652":49739},[],"Enable Replaceable Enrollment",{"_3154":1486,"_27801":1455,"_19254":49741,"_5":13218,"_26298":49656,"_2652":49742},[],"Disabled; the ID must be new.",{"_3154":1487,"_27801":1455,"_19254":49744,"_5":13218,"_26298":49656,"_2652":49745},[],"Initial authentication",{"_3154":1488,"_27801":1455,"_19254":49747,"_5":13218,"_26298":49656,"_2652":49748},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_3154":1489,"_27801":1455,"_19254":49750,"_5":13218,"_26298":49656,"_2652":49751},[],"Renewal authentication",{"_3154":1490,"_27801":1455,"_19254":49753,"_5":13218,"_26298":49656,"_2652":49754},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_3154":1491,"_27801":1455,"_19254":49756,"_5":13218,"_26298":49656,"_2652":49757},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_3154":1492,"_27801":1455,"_19254":49759,"_5":13218,"_26298":49656,"_2652":49760},[],"Not needed for this direct issuance; the Enrollment CA is always trusted for re-enrollment / disabled.",{"_3154":1493,"_27801":1455,"_19254":49762,"_5":13218,"_26298":49656,"_2652":49763},[],"Re-enrollment Delta",{"_3154":1494,"_27801":1455,"_19254":49765,"_5":13218,"_26298":49656,"_2652":49766},[],"1 hour.",{"_3154":1495,"_27801":1455,"_19254":49768,"_5":13218,"_26298":49656,"_2652":49769},[],"Preventive / Critical Delta",{"_3154":1496,"_27801":1455,"_19254":49771,"_5":13218,"_26298":49656,"_2652":49772},[],"30 minutes / 10 minutes.",{"_3154":1497,"_27801":1455,"_19254":49774,"_5":13218,"_26298":49656,"_2652":49775},[],"Revoke on Re-enrollment",{"_3154":1498,"_27801":1455,"_19254":49777,"_5":13218,"_26298":49656,"_2652":49778},[],"Disabled to test the successor before retiring the previous identity.",{"_3154":1499,"_27801":1455,"_19254":49780,"_5":13218,"_26298":49656,"_2652":47807},[],{"_3154":1500,"_27801":1455,"_19254":49782,"_5":13218,"_26298":49656,"_2652":49783},[],"Disabled; the operational key is generated in the client.",{"_3154":1501,"_27801":1455,"_19254":49785,"_5":13218,"_26298":49656,"_2652":49786},[],"CA Distribution",{"_3154":1502,"_27801":1455,"_19254":49788,"_5":13218,"_26298":49656,"_2652":49789},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_3154":1503,"_27801":1455,"_19254":49791,"_5":13218,"_26298":49656,"_2652":49792},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. If your console does not expose the independent block, configure and check the resource through the DMS API and DMS guide.",{"_3154":1504,"_27801":1455,"_19254":49794,"_5":13218,"_26298":49660,"_2652":49795},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_3154":1505,"_27801":1455,"_19254":49797,"_5":13218,"_26298":49660,"_2652":49798},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_3154":1506,"_27801":1455,"_19254":49800,"_5":13218,"_26298":49664,"_2652":49801},[],"Generate a new key and CSR with the selected identifier:",{"_3154":1507,"_27801":1455,"_19254":49803,"_5":13218,"_26298":49664,"_2652":49804},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_3154":1508,"_27801":1455,"_19254":49806,"_5":13218,"_26298":49664,"_2652":49807},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_3154":1509,"_27801":1455,"_19254":49809,"_5":13218,"_26298":49668,"_2652":49810},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_3154":1510,"_27801":1455,"_19254":49812,"_5":13218,"_26298":49668,"_2652":49813},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_3154":1511,"_27801":1455,"_19254":49815,"_5":13218,"_26298":49672,"_2652":49816},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_3154":1512,"_27801":1455,"_19254":49818,"_5":13218,"_26298":49672,"_2652":49819},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_3154":1513,"_27801":1455,"_19254":49821,"_5":13218,"_26298":49672,"_2652":49822},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_3154":1514,"_27801":1455,"_19254":49824,"_5":13218,"_26298":49672,"_2652":49825},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_3154":1515,"_27801":1455,"_19254":49827,"_5":13218,"_26298":49672,"_2652":49828},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_3154":1516,"_27801":1455,"_19254":49830,"_5":13218,"_26298":49676,"_2652":49831},[],"Check",{"_3154":1517,"_27801":1455,"_19254":49833,"_5":13218,"_26298":49676,"_2652":49834},[],"Expected result",{"_3154":1518,"_27801":1455,"_19254":49836,"_5":13218,"_26298":49676,"_2652":49837},[],"Registration",{"_3154":1519,"_27801":1455,"_19254":49839,"_5":13218,"_26298":49676,"_2652":49840},[],"ID created automatically and correct DMS.",{"_3154":1520,"_27801":1455,"_19254":49842,"_5":13218,"_26298":49676,"_2652":49843},[],"Certificate",{"_3154":1521,"_27801":1455,"_19254":49845,"_5":13218,"_26298":49676,"_2652":49846},[],"CN, profile, serial and key verified.",{"_3154":1522,"_27801":1455,"_19254":49848,"_5":13218,"_26298":49676,"_2652":49849},[],"Inventory",{"_3154":1523,"_27801":1455,"_19254":49851,"_5":13218,"_26298":49676,"_2652":49852},[],"Received serial visible as the current identity and in history.",{"_3154":1524,"_27801":1455,"_19254":49854,"_5":13218,"_26298":49676,"_2652":49855},[],"Consumer",{"_3154":1525,"_27801":1455,"_19254":49857,"_5":13218,"_26298":49676,"_2652":49858},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_3154":1526,"_27801":1455,"_19254":49860,"_5":13218,"_26298":49676,"_2652":49861},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_3154":1527,"_27801":1455,"_19254":49863,"_5":13218,"_26298":49676,"_2652":49864},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_3154":1528,"_27801":1528,"_5":13544,"_2652":47504,"_28144":49866,"_19254":49867,"_26298":1528},[45131,46511,47488,49642],[],{"_3154":1529,"_27801":1528,"_19254":49869,"_5":13218,"_26298":1528,"_2652":49870},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_3154":1530,"_27801":1528,"_5":28141,"_19254":49872,"_26298":49873,"_2652":45141},[],"/docs/pr-preview/pr-53/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_3154":1531,"_27801":1528,"_5":28141,"_19254":49875,"_26298":49876,"_2652":49877},[],"/docs/pr-preview/pr-53/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_3154":1532,"_27801":1528,"_5":28141,"_19254":49879,"_26298":49880,"_2652":49881},[],"/docs/pr-preview/pr-53/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_3154":1533,"_27801":1528,"_5":28141,"_19254":49883,"_26298":49884,"_2652":49885},[],"/docs/pr-preview/pr-53/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_3154":1534,"_27801":1528,"_5":28141,"_19254":49887,"_26298":49888,"_2652":49889},[],"/docs/pr-preview/pr-53/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_3154":1535,"_27801":1528,"_5":28141,"_19254":49891,"_26298":49892,"_2652":49893},[],"/docs/pr-preview/pr-53/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_3154":1536,"_27801":1528,"_5":28141,"_19254":49895,"_26298":49896,"_2652":49834},[],"/docs/pr-preview/pr-53/platform/iot-fleets/quickstarts/register-device#expected-result",{"_3154":1537,"_27801":1528,"_5":28141,"_19254":49898,"_26298":49899,"_2652":49900},[],"/docs/pr-preview/pr-53/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_3154":1538,"_27801":1528,"_5":28141,"_19254":49902,"_26298":49903,"_2652":49904},[],"/docs/pr-preview/pr-53/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_3154":1539,"_27801":1528,"_19254":49906,"_5":13218,"_26298":1528,"_2652":49907},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_3154":1540,"_27801":1528,"_19254":49909,"_5":13218,"_26298":1528,"_2652":49910},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_3154":1541,"_27801":1528,"_19254":49912,"_5":13218,"_26298":49873,"_2652":49913},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_3154":1542,"_27801":1528,"_19254":49915,"_5":13218,"_26298":49873,"_2652":49916},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_3154":1543,"_27801":1528,"_19254":49918,"_5":13218,"_26298":49873,"_2652":49919},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_3154":1544,"_27801":1528,"_19254":49921,"_5":13218,"_26298":49873,"_2652":49922},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_3154":1545,"_27801":1528,"_19254":49924,"_5":13218,"_26298":49876,"_2652":49925},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_3154":1546,"_27801":1528,"_19254":49927,"_5":13218,"_26298":49876,"_2652":49928},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_3154":1547,"_27801":1528,"_19254":49930,"_5":13218,"_26298":49876,"_2652":49931},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_3154":1548,"_27801":1528,"_19254":49933,"_5":13218,"_26298":49876,"_2652":49934},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_3154":1549,"_27801":1528,"_19254":49936,"_5":13218,"_26298":49876,"_2652":49937},[],"In the authentication section, enable **Require client certificate** and leave **Call external webhook** off. Under **Require client certificate**, add the CA whose initial certificates you will accept to **Validation CAs**; for this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and leave **Enable server-side key generation** off if you will not use it.",{"_3154":1550,"_27801":1528,"_19254":49939,"_5":13218,"_26298":49876,"_2652":49940},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_3154":1551,"_27801":1528,"_19254":49942,"_5":13218,"_26298":49876,"_2652":49943},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_3154":1552,"_27801":1528,"_19254":49945,"_5":13218,"_26298":49876,"_2652":49946},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_3154":1553,"_27801":1528,"_19254":49948,"_5":13218,"_26298":49880,"_2652":49949},[],"Open **Managed Devices** and the registration action. Complete:",{"_3154":1554,"_27801":1528,"_19254":49951,"_5":13218,"_26298":49880,"_2652":49952},[],"**Device ID**: `device-001`.",{"_3154":1555,"_27801":1528,"_19254":49954,"_5":13218,"_26298":49880,"_2652":49955},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_3154":1556,"_27801":1528,"_19254":49957,"_5":13218,"_26298":49880,"_2652":49958},[],"**Icon** and **Tags**: optional classification.",{"_3154":1557,"_27801":1528,"_19254":49960,"_5":13218,"_26298":49880,"_2652":49961},[],"Confirm registration.",{"_3154":1558,"_27801":1528,"_19254":49963,"_5":13218,"_26298":49884,"_2652":49964},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_3154":1559,"_27801":1528,"_19254":49966,"_5":13218,"_26298":49884,"_2652":49967},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_3154":1560,"_27801":1528,"_19254":49969,"_5":13218,"_26298":49888,"_2652":49970},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_3154":1561,"_27801":1528,"_19254":49972,"_5":13218,"_26298":49888,"_2652":49973},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_3154":1562,"_27801":1528,"_19254":49975,"_5":13218,"_26298":49892,"_2652":49976},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_3154":1563,"_27801":1528,"_19254":49978,"_5":13218,"_26298":49892,"_2652":49979},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_3154":1564,"_27801":1528,"_19254":49981,"_5":13218,"_26298":49896,"_2652":49831},[],{"_3154":1565,"_27801":1528,"_19254":49983,"_5":13218,"_26298":49896,"_2652":49984},[],"Result",{"_3154":1566,"_27801":1528,"_19254":49986,"_5":13218,"_26298":49896,"_2652":49987},[],"Device",{"_3154":1567,"_27801":1528,"_19254":49989,"_5":13218,"_26298":49896,"_2652":49990},[],"`device-001` appears in inventory with the expected DMS.",{"_3154":1568,"_27801":1528,"_19254":49992,"_5":13218,"_26298":49896,"_2652":49993},[],"Current identity",{"_3154":1569,"_27801":1528,"_19254":49995,"_5":13218,"_26298":49896,"_2652":49996},[],"The associated certificate matches the one you verified in PKI.",{"_3154":1570,"_27801":1528,"_19254":49998,"_5":13218,"_26298":49896,"_2652":49999},[],"History",{"_3154":1571,"_27801":1528,"_19254":50001,"_5":13218,"_26298":49896,"_2652":50002},[],"The associated issuance appears with its serial number and dates.",{"_3154":1572,"_27801":1528,"_19254":50004,"_5":13218,"_26298":49896,"_2652":50005},[],"Key and certificate",{"_3154":1573,"_27801":1528,"_19254":50007,"_5":13218,"_26298":49896,"_2652":50008},[],"You have the verified pair ready to install on the device.",{"_3154":1574,"_27801":1528,"_19254":50010,"_5":13218,"_26298":49899,"_2652":50011},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_3154":1575,"_27801":1528,"_19254":50013,"_5":13218,"_26298":49899,"_2652":50014},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_3154":1576,"_27801":1528,"_19254":50016,"_5":13218,"_26298":49899,"_2652":50017},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_3154":1577,"_27801":1528,"_19254":50019,"_5":13218,"_26298":49899,"_2652":50020},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_3154":1578,"_27801":1528,"_19254":50022,"_5":13218,"_26298":49903,"_2652":50023},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_3154":1579,"_27801":1528,"_19254":50025,"_5":13218,"_26298":49903,"_2652":50026},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_3154":1580,"_27801":1528,"_19254":50028,"_5":13218,"_26298":49903,"_2652":50029},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_3154":1581,"_27801":1581,"_5":13544,"_2652":50031,"_28144":50032,"_19254":50033,"_26298":1581},"Lamassu IoT Platform",[45131,46511],[],{"_3154":1582,"_27801":1581,"_19254":50035,"_5":13218,"_26298":1581,"_2652":50036},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_3154":1583,"_27801":1581,"_5":28141,"_19254":50038,"_26298":50039,"_2652":49517},[],"/docs/pr-preview/pr-53/platform/overview#start-here",{"_3154":1584,"_27801":1581,"_5":28141,"_19254":50041,"_26298":50042,"_2652":50043},[],"/docs/pr-preview/pr-53/platform/overview#choose-your-path","Choose your path",{"_3154":1585,"_27801":1581,"_5":28141,"_19254":50045,"_26298":50046,"_2652":50047},[],"/docs/pr-preview/pr-53/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_3154":1586,"_27801":1581,"_5":28141,"_19254":50049,"_26298":50050,"_2652":50051},[],"/docs/pr-preview/pr-53/platform/overview#core-capabilities","Core capabilities",{"_3154":1587,"_27801":1581,"_5":28141,"_19254":50053,"_26298":50054,"_2652":50055},[],"/docs/pr-preview/pr-53/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_3154":1588,"_27801":1581,"_5":28141,"_19254":50057,"_26298":50058,"_2652":50059},[],"/docs/pr-preview/pr-53/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_3154":1589,"_27801":1581,"_5":28141,"_19254":50061,"_26298":50062,"_2652":50063},[],"/docs/pr-preview/pr-53/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_3154":1590,"_27801":1581,"_5":28141,"_19254":50065,"_26298":50066,"_2652":50067},[],"/docs/pr-preview/pr-53/platform/overview#automate-device-identities","Automate device identities",{"_3154":1591,"_27801":1581,"_5":28141,"_19254":50069,"_26298":50070,"_2652":50071},[],"/docs/pr-preview/pr-53/platform/overview#publish-validation-status","Publish validation status",{"_3154":1592,"_27801":1581,"_5":28141,"_19254":50073,"_26298":50074,"_2652":50075},[],"/docs/pr-preview/pr-53/platform/overview#react-to-events","React to events",{"_3154":1593,"_27801":1581,"_5":28141,"_19254":50077,"_26298":50078,"_2652":50079},[],"/docs/pr-preview/pr-53/platform/overview#operational-reference","Operational reference",{"_3154":1594,"_27801":1581,"_19254":50081,"_5":13218,"_26298":1581,"_2652":50082},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_3154":1595,"_27801":1581,"_19254":50084,"_5":13218,"_26298":50039,"_2652":50085},[],"Choose the result you need:",{"_3154":1596,"_27801":1581,"_19254":50087,"_5":13218,"_26298":50039,"_2652":50088},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3154":1597,"_27801":1581,"_19254":50090,"_5":13218,"_26298":50039,"_2652":50091},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3154":1598,"_27801":1581,"_19254":50093,"_5":13218,"_26298":50039,"_2652":50094},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_3154":1599,"_27801":1581,"_19254":50096,"_5":13218,"_26298":50042,"_2652":50097},[],"Section",{"_3154":1600,"_27801":1581,"_19254":50099,"_5":13218,"_26298":50042,"_2652":50100},[],"What you manage",{"_3154":1601,"_27801":1581,"_19254":50102,"_5":13218,"_26298":50042,"_2652":50103},[],"Entry point",{"_3154":1602,"_27801":1581,"_19254":50105,"_5":13218,"_26298":50042,"_2652":50106},[],"**PKI**",{"_3154":1603,"_27801":1581,"_19254":50108,"_5":13218,"_26298":50042,"_2652":50109},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_3154":1604,"_27801":1581,"_19254":50111,"_5":13218,"_26298":50042,"_2652":50112},[],"PKI overview",{"_3154":1605,"_27801":1581,"_19254":50114,"_5":13218,"_26298":50042,"_2652":50115},[],"**IoT Fleets**",{"_3154":1606,"_27801":1581,"_19254":50117,"_5":13218,"_26298":50042,"_2652":50118},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_3154":1607,"_27801":1581,"_19254":50120,"_5":13218,"_26298":50042,"_2652":50121},[],"IoT Fleets overview",{"_3154":1608,"_27801":1581,"_19254":50123,"_5":13218,"_26298":50042,"_2652":50124},[],"**Administration**",{"_3154":1609,"_27801":1581,"_19254":50126,"_5":13218,"_26298":50042,"_2652":50127},[],"Operator permissions, audit and event subscriptions.",{"_3154":1610,"_27801":1581,"_19254":50129,"_5":13218,"_26298":50042,"_2652":46509},[],{"_3154":1611,"_27801":1581,"_19254":50131,"_5":13218,"_26298":50042,"_2652":50132},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_3154":1612,"_27801":1581,"_19254":50134,"_5":13218,"_26298":50046,"_2652":50135},[],"An identity's journey connects four responsibilities:",{"_3154":1613,"_27801":1581,"_19254":50137,"_5":13218,"_26298":50046,"_2652":50138},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_3154":1614,"_27801":1581,"_19254":50140,"_5":13218,"_26298":50046,"_2652":50141},[],"The provisioning administrator configures the DMS and initial trust.",{"_3154":1615,"_27801":1581,"_19254":50143,"_5":13218,"_26298":50046,"_2652":50144},[],"The device client requests a certificate and installs it with the matching key.",{"_3154":1616,"_27801":1581,"_19254":50146,"_5":13218,"_26298":50046,"_2652":50147},[],"The consumer validates the identity and applies its access permissions.",{"_3154":1617,"_27801":1581,"_19254":50149,"_5":13218,"_26298":50046,"_2652":50150},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_3154":1618,"_27801":1581,"_19254":50152,"_5":13218,"_26298":50054,"_2652":50153},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_3154":1619,"_27801":1581,"_19254":50155,"_5":13218,"_26298":50058,"_2652":50156},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_3154":1620,"_27801":1581,"_19254":50158,"_5":13218,"_26298":50062,"_2652":50159},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_3154":1621,"_27801":1581,"_19254":50161,"_5":13218,"_26298":50066,"_2652":50162},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_3154":1622,"_27801":1581,"_19254":50164,"_5":13218,"_26298":50070,"_2652":50165},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_3154":1623,"_27801":1581,"_19254":50167,"_5":13218,"_26298":50074,"_2652":50168},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_3154":1624,"_27801":1581,"_19254":50170,"_5":13218,"_26298":50078,"_2652":49611},[],{"_3154":1625,"_27801":1581,"_19254":50172,"_5":13218,"_26298":50078,"_2652":50173},[],"What it prepares or checks",{"_3154":1626,"_27801":1581,"_19254":50175,"_5":13218,"_26298":50078,"_2652":49614},[],{"_3154":1627,"_27801":1581,"_19254":50177,"_5":13218,"_26298":50078,"_2652":50178},[],"Key custody, CA hierarchy, profiles and validation.",{"_3154":1628,"_27801":1581,"_19254":50180,"_5":13218,"_26298":50078,"_2652":50181},[],"Fleet administrator",{"_3154":1629,"_27801":1581,"_19254":50183,"_5":13218,"_26298":50078,"_2652":50184},[],"DMS, device admission, renewal policy and inventory.",{"_3154":1630,"_27801":1581,"_19254":50186,"_5":13218,"_26298":50078,"_2652":49626},[],{"_3154":1631,"_27801":1581,"_19254":50188,"_5":13218,"_26298":50078,"_2652":50189},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_3154":1632,"_27801":1581,"_19254":50191,"_5":13218,"_26298":50078,"_2652":49632},[],{"_3154":1633,"_27801":1581,"_19254":50193,"_5":13218,"_26298":50078,"_2652":50194},[],"Issuer trust, certificate validation and permissions in the destination.",{"_3154":1634,"_27801":1581,"_19254":50196,"_5":13218,"_26298":50078,"_2652":50197},[],"Infrastructure operator",{"_3154":1635,"_27801":1581,"_19254":50199,"_5":13218,"_26298":50078,"_2652":50200},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_3154":1636,"_27801":1581,"_19254":50202,"_5":13218,"_26298":50078,"_2652":50203},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_3154":1637,"_27801":1637,"_5":13544,"_2652":50205,"_28144":50206,"_19254":50209,"_26298":1637},"CA hierarchy and rotation",[45131,46511,50207,50208],"PKI","Keys, authorities and certificates",[],{"_3154":1638,"_27801":1637,"_19254":50211,"_5":13218,"_26298":1637,"_2652":50212},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_3154":1639,"_27801":1637,"_5":28141,"_19254":50214,"_26298":50215,"_2652":50216},[],"/docs/pr-preview/pr-53/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_3154":1640,"_27801":1637,"_5":28141,"_19254":50218,"_26298":50219,"_2652":50220},[],"/docs/pr-preview/pr-53/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_3154":1641,"_27801":1637,"_5":28141,"_19254":50222,"_26298":50223,"_2652":50224},[],"/docs/pr-preview/pr-53/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_3154":1642,"_27801":1637,"_5":28141,"_19254":50226,"_26298":50227,"_2652":50228},[],"/docs/pr-preview/pr-53/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_3154":1643,"_27801":1637,"_5":28141,"_19254":50230,"_26298":50231,"_2652":50232},[],"/docs/pr-preview/pr-53/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_3154":1644,"_27801":1637,"_5":28141,"_19254":50234,"_26298":50235,"_2652":50236},[],"/docs/pr-preview/pr-53/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_3154":1645,"_27801":1637,"_5":28141,"_19254":50238,"_26298":50239,"_2652":50240},[],"/docs/pr-preview/pr-53/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_3154":1646,"_27801":1637,"_5":28141,"_19254":50242,"_26298":50243,"_2652":50244},[],"/docs/pr-preview/pr-53/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_3154":1647,"_27801":1637,"_5":28141,"_19254":50246,"_26298":50247,"_2652":50248},[],"/docs/pr-preview/pr-53/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_3154":1648,"_27801":1637,"_5":28141,"_19254":50250,"_26298":50251,"_2652":50252},[],"/docs/pr-preview/pr-53/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_3154":1649,"_27801":1637,"_5":28141,"_19254":50254,"_26298":50255,"_2652":50256},[],"/docs/pr-preview/pr-53/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_3154":1650,"_27801":1637,"_5":28141,"_19254":50258,"_26298":50259,"_2652":50260},[],"/docs/pr-preview/pr-53/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_3154":1651,"_27801":1637,"_19254":50262,"_5":13218,"_26298":1637,"_2652":50263},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_3154":1652,"_27801":1637,"_19254":50265,"_5":13218,"_26298":1637,"_2652":50266},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_3154":1653,"_27801":1637,"_19254":50268,"_5":13218,"_26298":50215,"_2652":50269},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_3154":1654,"_27801":1637,"_19254":50271,"_5":13218,"_26298":50215,"_2652":50272},[],"environment, such as production and preproduction;",{"_3154":1655,"_27801":1637,"_19254":50274,"_5":13218,"_26298":50215,"_2652":50275},[],"owner or operating team;",{"_3154":1656,"_27801":1637,"_19254":50277,"_5":13218,"_26298":50215,"_2652":50278},[],"device family or manufacturing process;",{"_3154":1657,"_27801":1637,"_19254":50280,"_5":13218,"_26298":50215,"_2652":50281},[],"region or regulatory requirement;",{"_3154":1658,"_27801":1637,"_19254":50283,"_5":13218,"_26298":50215,"_2652":50284},[],"cryptographic engine or key policy;",{"_3154":1659,"_27801":1637,"_19254":50286,"_5":13218,"_26298":50215,"_2652":50287},[],"maintenance window and renewal cadence.",{"_3154":1660,"_27801":1637,"_19254":50289,"_5":13218,"_26298":50215,"_2652":50290},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_3154":1661,"_27801":1637,"_19254":50292,"_5":13218,"_26298":50215,"_2652":50293},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_3154":1662,"_27801":1637,"_19254":50295,"_5":13218,"_26298":50219,"_2652":50296},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_3154":1663,"_27801":1637,"_19254":50298,"_5":13218,"_26298":50219,"_2652":50299},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_3154":1664,"_27801":1637,"_19254":50301,"_5":13218,"_26298":50219,"_2652":50302},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_3154":1665,"_27801":1637,"_19254":50304,"_5":13218,"_26298":50223,"_2652":50305},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_3154":1666,"_27801":1637,"_19254":50307,"_5":13218,"_26298":50223,"_2652":50308},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_3154":1667,"_27801":1637,"_19254":50310,"_5":13218,"_26298":50223,"_2652":50311},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_3154":1668,"_27801":1637,"_19254":50313,"_5":13218,"_26298":50223,"_2652":50314},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_3154":1669,"_27801":1637,"_19254":50316,"_5":13218,"_26298":50231,"_2652":50317},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_3154":1670,"_27801":1637,"_19254":50319,"_5":13218,"_26298":50235,"_2652":50320},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_3154":1671,"_27801":1637,"_19254":50322,"_5":13218,"_26298":50239,"_2652":50323},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_3154":1672,"_27801":1637,"_19254":50325,"_5":13218,"_26298":50243,"_2652":50326},[],"Update the enrollment CA and profile of the DMSs. While old-CA cohorts still renew, add the previous enrollment CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`): the new enrollment CA is trusted automatically, but the old one was the enrollment CA and appears in no re-enrollment trust list, so without that entry its certificates can no longer renew. The DMS guide documents the setting.",{"_3154":1673,"_27801":1637,"_19254":50328,"_5":13218,"_26298":50247,"_2652":50329},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_3154":1674,"_27801":1637,"_19254":50331,"_5":13218,"_26298":50251,"_2652":50332},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance, from the re-enrollment validation CAs and from the distributed CAs. Revoke it if policy requires it.",{"_3154":1675,"_27801":1637,"_19254":50334,"_5":13218,"_26298":50255,"_2652":50335},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_3154":1676,"_27801":1637,"_19254":50337,"_5":13218,"_26298":50255,"_2652":50338},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_3154":1677,"_27801":1637,"_19254":50340,"_5":13218,"_26298":50255,"_2652":50341},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_3154":1678,"_27801":1637,"_19254":50343,"_5":13218,"_26298":50255,"_2652":50344},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_3154":1679,"_27801":1637,"_19254":50346,"_5":13218,"_26298":50259,"_2652":50347},[],"The new chain ends in an anchor installed by the consumer.",{"_3154":1680,"_27801":1637,"_19254":50349,"_5":13218,"_26298":50259,"_2652":50350},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_3154":1681,"_27801":1637,"_19254":50352,"_5":13218,"_26298":50259,"_2652":50353},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_3154":1682,"_27801":1637,"_19254":50355,"_5":13218,"_26298":50259,"_2652":50356},[],"Re-enrollment accepts the old identity during the planned period.",{"_3154":1683,"_27801":1637,"_19254":50358,"_5":13218,"_26298":50259,"_2652":50359},[],"OCSP and CRL respond for the authorities that remain active.",{"_3154":1684,"_27801":1637,"_19254":50361,"_5":13218,"_26298":50259,"_2652":50362},[],"No DMS is left accidentally issuing from the old CA.",{"_3154":1685,"_27801":1637,"_19254":50364,"_5":13218,"_26298":50259,"_2652":50365},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_3154":1686,"_27801":1686,"_5":13544,"_2652":50367,"_28144":50368,"_19254":50369,"_26298":1686},"Certification authorities",[45131,46511,50207,50208],[],{"_3154":1687,"_27801":1686,"_19254":50371,"_5":13218,"_26298":1686,"_2652":50372},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_3154":1688,"_27801":1686,"_5":28141,"_19254":50374,"_26298":50375,"_2652":50376},[],"/docs/pr-preview/pr-53/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_3154":1689,"_27801":1686,"_5":28141,"_19254":50378,"_26298":50379,"_2652":50380},[],"/docs/pr-preview/pr-53/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_3154":1690,"_27801":1686,"_5":28141,"_19254":50382,"_26298":50383,"_2652":45141},[],"/docs/pr-preview/pr-53/platform/pki/certificate-authorities#before-you-begin",{"_3154":1691,"_27801":1686,"_5":28141,"_19254":50385,"_26298":50386,"_2652":50387},[],"/docs/pr-preview/pr-53/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_3154":1692,"_27801":1686,"_5":28141,"_19254":50389,"_26298":50390,"_2652":50391},[],"/docs/pr-preview/pr-53/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_3154":1693,"_27801":1686,"_5":28141,"_19254":50393,"_26298":50394,"_2652":50395},[],"/docs/pr-preview/pr-53/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_3154":1694,"_27801":1686,"_5":28141,"_19254":50397,"_26298":50398,"_2652":50399},[],"/docs/pr-preview/pr-53/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_3154":1695,"_27801":1686,"_5":28141,"_19254":50401,"_26298":50402,"_2652":50403},[],"/docs/pr-preview/pr-53/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_3154":1696,"_27801":1686,"_5":28141,"_19254":50405,"_26298":50406,"_2652":50407},[],"/docs/pr-preview/pr-53/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_3154":1697,"_27801":1686,"_5":28141,"_19254":50409,"_26298":50410,"_2652":50411},[],"/docs/pr-preview/pr-53/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_3154":1698,"_27801":1686,"_5":28141,"_19254":50413,"_26298":50414,"_2652":50415},[],"/docs/pr-preview/pr-53/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_3154":1699,"_27801":1686,"_5":28141,"_19254":50417,"_26298":50418,"_2652":50419},[],"/docs/pr-preview/pr-53/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_3154":1700,"_27801":1686,"_5":28141,"_19254":50421,"_26298":50422,"_2652":50423},[],"/docs/pr-preview/pr-53/platform/pki/certificate-authorities#load-the-material","Load the material",{"_3154":1701,"_27801":1686,"_5":28141,"_19254":50425,"_26298":50426,"_2652":50427},[],"/docs/pr-preview/pr-53/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_3154":1702,"_27801":1686,"_5":28141,"_19254":50429,"_26298":50430,"_2652":50431},[],"/docs/pr-preview/pr-53/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_3154":1703,"_27801":1686,"_5":28141,"_19254":50433,"_26298":50434,"_2652":50435},[],"/docs/pr-preview/pr-53/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_3154":1704,"_27801":1686,"_5":28141,"_19254":50437,"_26298":50438,"_2652":50439},[],"/docs/pr-preview/pr-53/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_3154":1705,"_27801":1686,"_5":28141,"_19254":50441,"_26298":50442,"_2652":50443},[],"/docs/pr-preview/pr-53/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_3154":1706,"_27801":1686,"_5":28141,"_19254":50445,"_26298":50446,"_2652":50447},[],"/docs/pr-preview/pr-53/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_3154":1707,"_27801":1686,"_5":28141,"_19254":50449,"_26298":50450,"_2652":50451},[],"/docs/pr-preview/pr-53/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_3154":1708,"_27801":1686,"_5":28141,"_19254":50453,"_26298":50454,"_2652":50455},[],"/docs/pr-preview/pr-53/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_3154":1709,"_27801":1686,"_5":28141,"_19254":50457,"_26298":50458,"_2652":50459},[],"/docs/pr-preview/pr-53/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_3154":1710,"_27801":1686,"_19254":50461,"_5":13218,"_26298":1686,"_2652":50462},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_3154":1711,"_27801":1686,"_19254":50464,"_5":13218,"_26298":1686,"_2652":50465},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_3154":1712,"_27801":1686,"_19254":50467,"_5":13218,"_26298":1686,"_2652":50468},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_3154":1713,"_27801":1686,"_19254":50470,"_5":13218,"_26298":50375,"_2652":50471},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_3154":1714,"_27801":1686,"_19254":50473,"_5":13218,"_26298":50375,"_2652":50474},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_3154":1715,"_27801":1686,"_19254":50476,"_5":13218,"_26298":50375,"_2652":50477},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_3154":1716,"_27801":1686,"_19254":50479,"_5":13218,"_26298":50375,"_2652":50480},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_3154":1717,"_27801":1686,"_19254":50482,"_5":13218,"_26298":50375,"_2652":50483},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_3154":1718,"_27801":1686,"_19254":50485,"_5":13218,"_26298":50383,"_2652":50486},[],"Decide whether the CA will be a root or an intermediate.",{"_3154":1719,"_27801":1686,"_19254":50488,"_5":13218,"_26298":50383,"_2652":50489},[],"Choose the engine that will keep the key.",{"_3154":1720,"_27801":1686,"_19254":50491,"_5":13218,"_26298":50383,"_2652":50492},[],"Define a validity longer than that of the certificates it will issue.",{"_3154":1721,"_27801":1686,"_19254":50494,"_5":13218,"_26298":50383,"_2652":50495},[],"For an intermediate CA, make sure the parent CA is active.",{"_3154":1722,"_27801":1686,"_19254":50497,"_5":13218,"_26298":50386,"_2652":50498},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_3154":1723,"_27801":1686,"_19254":50500,"_5":13218,"_26298":50390,"_2652":50501},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_3154":1724,"_27801":1686,"_19254":50503,"_5":13218,"_26298":50390,"_2652":50504},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_3154":1725,"_27801":1686,"_19254":50506,"_5":13218,"_26298":50394,"_2652":50507},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_3154":1726,"_27801":1686,"_19254":50509,"_5":13218,"_26298":50398,"_2652":50510},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_3154":1727,"_27801":1686,"_19254":50512,"_5":13218,"_26298":50398,"_2652":50513},[],"`C`: two-letter ISO 3166-1 country code.",{"_3154":1728,"_27801":1686,"_19254":50515,"_5":13218,"_26298":50398,"_2652":50516},[],"`ST`: state or province.",{"_3154":1729,"_27801":1686,"_19254":50518,"_5":13218,"_26298":50398,"_2652":50519},[],"`L`: locality.",{"_3154":1730,"_27801":1686,"_19254":50521,"_5":13218,"_26298":50398,"_2652":50522},[],"`O`: organization.",{"_3154":1731,"_27801":1686,"_19254":50524,"_5":13218,"_26298":50398,"_2652":50525},[],"`OU`: organizational unit.",{"_3154":1732,"_27801":1686,"_19254":50527,"_5":13218,"_26298":50398,"_2652":50528},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_3154":1733,"_27801":1686,"_19254":50530,"_5":13218,"_26298":50402,"_2652":50531},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_3154":1734,"_27801":1686,"_19254":50533,"_5":13218,"_26298":50402,"_2652":50534},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_3154":1735,"_27801":1686,"_19254":50536,"_5":13218,"_26298":50406,"_2652":50537},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_3154":1736,"_27801":1686,"_19254":50539,"_5":13218,"_26298":50406,"_2652":50540},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_3154":1737,"_27801":1686,"_19254":50542,"_5":13218,"_26298":50410,"_2652":50543},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_3154":1738,"_27801":1686,"_19254":50545,"_5":13218,"_26298":50410,"_2652":50546},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_3154":1739,"_27801":1686,"_19254":50548,"_5":13218,"_26298":50414,"_2652":50549},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_3154":1740,"_27801":1686,"_19254":50551,"_5":13218,"_26298":50418,"_2652":50552},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_3154":1741,"_27801":1686,"_19254":50554,"_5":13218,"_26298":50422,"_2652":50555},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_3154":1742,"_27801":1686,"_19254":50557,"_5":13218,"_26298":50426,"_2652":50558},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_3154":1743,"_27801":1686,"_19254":50560,"_5":13218,"_26298":50430,"_2652":50561},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_3154":1744,"_27801":1686,"_19254":50563,"_5":13218,"_26298":50430,"_2652":50564},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_3154":1745,"_27801":1686,"_19254":50566,"_5":13218,"_26298":50434,"_2652":50567},[],"Open a CA from the inventory to review:",{"_3154":1746,"_27801":1686,"_19254":50569,"_5":13218,"_26298":50434,"_2652":50570},[],"Status and validity period.",{"_3154":1747,"_27801":1686,"_19254":50572,"_5":13218,"_26298":50434,"_2652":50573},[],"Certificate and chain in PEM format.",{"_3154":1748,"_27801":1686,"_19254":50575,"_5":13218,"_26298":50434,"_2652":50576},[],"Number of active, expired and revoked certificates.",{"_3154":1749,"_27801":1686,"_19254":50578,"_5":13218,"_26298":50434,"_2652":50579},[],"Certificates issued in **Issued Certificates**.",{"_3154":1750,"_27801":1686,"_19254":50581,"_5":13218,"_26298":50434,"_2652":50582},[],"The CRL linked to the authority.",{"_3154":1751,"_27801":1686,"_19254":50584,"_5":13218,"_26298":50434,"_2652":50585},[],"Metadata and the associated cryptographic engine.",{"_3154":1752,"_27801":1686,"_19254":50587,"_5":13218,"_26298":50434,"_2652":50588},[],"You can filter the inventory by name, status and CA type.",{"_3154":1753,"_27801":1686,"_19254":50590,"_5":13218,"_26298":50438,"_2652":50591},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_3154":1754,"_27801":1686,"_19254":50593,"_5":13218,"_26298":50438,"_2652":50594},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_3154":1755,"_27801":1686,"_19254":50596,"_5":13218,"_26298":50438,"_2652":50597},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_3154":1756,"_27801":1686,"_19254":50599,"_5":13218,"_26298":50438,"_2652":50600},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_3154":1757,"_27801":1686,"_19254":50602,"_5":13218,"_26298":50442,"_2652":50603},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_3154":1758,"_27801":1686,"_19254":50605,"_5":13218,"_26298":50446,"_2652":50606},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_3154":1759,"_27801":1686,"_19254":50608,"_5":13218,"_26298":50450,"_2652":50609},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_3154":1760,"_27801":1686,"_19254":50611,"_5":13218,"_26298":50454,"_2652":50612},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_3154":1761,"_27801":1686,"_19254":50614,"_5":13218,"_26298":50458,"_2652":50615},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_3154":1762,"_27801":1686,"_19254":50617,"_5":13218,"_26298":50458,"_2652":50618},[],"Permanent deletion is only available after revoking. Delete the record only when your retention and audit policy allows it.",{"_3154":1763,"_27801":1763,"_5":13544,"_2652":50620,"_28144":50621,"_19254":50622,"_26298":1763},"Certificate profiles",[45131,46511,50207,50208],[],{"_3154":1764,"_27801":1763,"_19254":50624,"_5":13218,"_26298":1763,"_2652":50625},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_3154":1765,"_27801":1763,"_5":28141,"_19254":50627,"_26298":50628,"_2652":50629},[],"/docs/pr-preview/pr-53/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_3154":1766,"_27801":1763,"_5":28141,"_19254":50631,"_26298":50632,"_2652":50633},[],"/docs/pr-preview/pr-53/platform/pki/certificate-profiles#validity","Validity",{"_3154":1767,"_27801":1763,"_5":28141,"_19254":50635,"_26298":50636,"_2652":50637},[],"/docs/pr-preview/pr-53/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_3154":1768,"_27801":1763,"_5":28141,"_19254":50639,"_26298":50640,"_2652":50641},[],"/docs/pr-preview/pr-53/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_3154":1769,"_27801":1763,"_5":28141,"_19254":50643,"_26298":50644,"_2652":50645},[],"/docs/pr-preview/pr-53/platform/pki/certificate-profiles#subject","Subject",{"_3154":1770,"_27801":1763,"_5":28141,"_19254":50647,"_26298":50648,"_2652":50649},[],"/docs/pr-preview/pr-53/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_3154":1771,"_27801":1763,"_5":28141,"_19254":50651,"_26298":50652,"_2652":50653},[],"/docs/pr-preview/pr-53/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_3154":1772,"_27801":1763,"_5":28141,"_19254":50655,"_26298":50656,"_2652":50657},[],"/docs/pr-preview/pr-53/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_3154":1773,"_27801":1763,"_5":28141,"_19254":50659,"_26298":50660,"_2652":50661},[],"/docs/pr-preview/pr-53/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_3154":1774,"_27801":1763,"_5":28141,"_19254":50663,"_26298":50664,"_2652":50665},[],"/docs/pr-preview/pr-53/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_3154":1775,"_27801":1763,"_5":28141,"_19254":50667,"_26298":50668,"_2652":50669},[],"/docs/pr-preview/pr-53/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_3154":1776,"_27801":1763,"_5":28141,"_19254":50671,"_26298":50672,"_2652":50673},[],"/docs/pr-preview/pr-53/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_3154":1777,"_27801":1763,"_5":28141,"_19254":50675,"_26298":50676,"_2652":50677},[],"/docs/pr-preview/pr-53/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_3154":1778,"_27801":1763,"_5":28141,"_19254":50679,"_26298":50680,"_2652":50681},[],"/docs/pr-preview/pr-53/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_3154":1779,"_27801":1763,"_5":28141,"_19254":50683,"_26298":50684,"_2652":50685},[],"/docs/pr-preview/pr-53/platform/pki/certificate-profiles#design-examples","Design examples",{"_3154":1780,"_27801":1763,"_5":28141,"_19254":50687,"_26298":50688,"_2652":50689},[],"/docs/pr-preview/pr-53/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_3154":1781,"_27801":1763,"_19254":50691,"_5":13218,"_26298":1763,"_2652":50692},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_3154":1782,"_27801":1763,"_19254":50694,"_5":13218,"_26298":1763,"_2652":50695},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_3154":1783,"_27801":1763,"_19254":50697,"_5":13218,"_26298":50632,"_2652":50698},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_3154":1784,"_27801":1763,"_19254":50700,"_5":13218,"_26298":50632,"_2652":50701},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_3154":1785,"_27801":1763,"_19254":50703,"_5":13218,"_26298":50636,"_2652":50704},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Enable it only in profiles intended to create or reissue subordinate CAs.",{"_3154":1786,"_27801":1763,"_19254":50706,"_5":13218,"_26298":50640,"_2652":50707},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_3154":1787,"_27801":1763,"_19254":50709,"_5":13218,"_26298":50640,"_2652":50710},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_3154":1788,"_27801":1763,"_19254":50712,"_5":13218,"_26298":50640,"_2652":50713},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_3154":1789,"_27801":1763,"_19254":50715,"_5":13218,"_26298":50644,"_2652":50716},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_3154":1790,"_27801":1763,"_19254":50718,"_5":13218,"_26298":50648,"_2652":50719},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_3154":1791,"_27801":1763,"_19254":50721,"_5":13218,"_26298":50648,"_2652":50722},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_3154":1792,"_27801":1763,"_19254":50724,"_5":13218,"_26298":50652,"_2652":50725},[],"The cryptographic enforcement can:",{"_3154":1793,"_27801":1763,"_19254":50727,"_5":13218,"_26298":50652,"_2652":50728},[],"allow or block RSA keys;",{"_3154":1794,"_27801":1763,"_19254":50730,"_5":13218,"_26298":50652,"_2652":50731},[],"limit the supported RSA sizes;",{"_3154":1795,"_27801":1763,"_19254":50733,"_5":13218,"_26298":50652,"_2652":50734},[],"allow or block ECDSA keys;",{"_3154":1796,"_27801":1763,"_19254":50736,"_5":13218,"_26298":50652,"_2652":50737},[],"limit the supported ECDSA sizes or curves.",{"_3154":1797,"_27801":1763,"_19254":50739,"_5":13218,"_26298":50652,"_2652":50740},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_3154":1798,"_27801":1763,"_19254":50742,"_5":13218,"_26298":50656,"_2652":50743},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_3154":1799,"_27801":1763,"_19254":50745,"_5":13218,"_26298":50656,"_2652":48235},[],{"_3154":1800,"_27801":1763,"_19254":50747,"_5":13218,"_26298":50656,"_2652":50748},[],"First choice",{"_3154":1801,"_27801":1763,"_19254":50750,"_5":13218,"_26298":50656,"_2652":50751},[],"Second choice",{"_3154":1802,"_27801":1763,"_19254":50753,"_5":13218,"_26298":50656,"_2652":50754},[],"If neither is supplied",{"_3154":1803,"_27801":1763,"_19254":50756,"_5":13218,"_26298":50656,"_2652":50757},[],"Direct signing with a CA",{"_3154":1804,"_27801":1763,"_19254":50759,"_5":13218,"_26298":50656,"_2652":50760},[],"`issuance_profile` embedded in the request",{"_3154":1805,"_27801":1763,"_19254":50762,"_5":13218,"_26298":50656,"_2652":50763},[],"Request `issuance_profile_id`",{"_3154":1806,"_27801":1763,"_19254":50765,"_5":13218,"_26298":50656,"_2652":50766},[],"CA default profile (`profile_id`).",{"_3154":1807,"_27801":1763,"_19254":50768,"_5":13218,"_26298":50656,"_2652":50769},[],"Issuance through a DMS",{"_3154":1808,"_27801":1763,"_19254":50771,"_5":13218,"_26298":50656,"_2652":50772},[],"`settings.issuance_profile_id`",{"_3154":1809,"_27801":1763,"_19254":50774,"_5":13218,"_26298":50656,"_2652":50775},[],"`settings.issuance_profile` embedded in the DMS",{"_3154":1810,"_27801":1763,"_19254":50777,"_5":13218,"_26298":50656,"_2652":50778},[],"Enrollment CA default profile.",{"_3154":1811,"_27801":1763,"_19254":50780,"_5":13218,"_26298":50656,"_2652":50781},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_3154":1812,"_27801":1763,"_19254":50783,"_5":13218,"_26298":50656,"_2652":50784},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_3154":1813,"_27801":1763,"_19254":50786,"_5":13218,"_26298":50664,"_2652":50787},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_3154":1814,"_27801":1763,"_19254":50789,"_5":13218,"_26298":50668,"_2652":50790},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_3154":1815,"_27801":1763,"_19254":50792,"_5":13218,"_26298":50672,"_2652":50793},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_3154":1816,"_27801":1763,"_19254":50795,"_5":13218,"_26298":50676,"_2652":50796},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_3154":1817,"_27801":1763,"_19254":50798,"_5":13218,"_26298":50680,"_2652":50799},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_3154":1818,"_27801":1763,"_19254":50801,"_5":13218,"_26298":50680,"_2652":50802},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_3154":1819,"_27801":1763,"_19254":50804,"_5":13218,"_26298":50684,"_2652":50805},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_3154":1820,"_27801":1763,"_19254":50807,"_5":13218,"_26298":50684,"_2652":50808},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_3154":1821,"_27801":1763,"_19254":50810,"_5":13218,"_26298":50684,"_2652":50811},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_3154":1822,"_27801":1763,"_19254":50813,"_5":13218,"_26298":50684,"_2652":50814},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_3154":1823,"_27801":1763,"_19254":50816,"_5":13218,"_26298":50688,"_2652":50817},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_3154":1824,"_27801":1763,"_19254":50819,"_5":13218,"_26298":50688,"_2652":50820},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_3154":1825,"_27801":1825,"_5":13544,"_2652":50822,"_28144":50823,"_19254":50825,"_26298":1825},"Certificate validation",[45131,46511,50207,50824],"Validation",[],{"_3154":1826,"_27801":1825,"_19254":50827,"_5":13218,"_26298":1825,"_2652":50828},[],"Check chain, identity, purpose and revocation from the consumer.",{"_3154":1827,"_27801":1825,"_5":28141,"_19254":50830,"_26298":50831,"_2652":50832},[],"/docs/pr-preview/pr-53/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_3154":1828,"_27801":1825,"_5":28141,"_19254":50834,"_26298":50835,"_2652":50836},[],"/docs/pr-preview/pr-53/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_3154":1829,"_27801":1825,"_5":28141,"_19254":50838,"_26298":50839,"_2652":50840},[],"/docs/pr-preview/pr-53/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_3154":1830,"_27801":1825,"_19254":50842,"_5":13218,"_26298":1825,"_2652":50843},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_3154":1831,"_27801":1825,"_19254":50845,"_5":13218,"_26298":50831,"_2652":50846},[],"Verify these criteria together:",{"_3154":1832,"_27801":1825,"_19254":50848,"_5":13218,"_26298":50831,"_2652":49831},[],{"_3154":1833,"_27801":1825,"_19254":50850,"_5":13218,"_26298":50831,"_2652":50851},[],"Required result",{"_3154":1834,"_27801":1825,"_19254":50853,"_5":13218,"_26298":50831,"_2652":50854},[],"Chain and signature",{"_3154":1835,"_27801":1825,"_19254":50856,"_5":13218,"_26298":50831,"_2652":50857},[],"Valid chain to a root deliberately installed in the consumer.",{"_3154":1836,"_27801":1825,"_19254":50859,"_5":13218,"_26298":50831,"_2652":50860},[],"Dates",{"_3154":1837,"_27801":1825,"_19254":50862,"_5":13218,"_26298":50831,"_2652":50863},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_3154":1838,"_27801":1825,"_19254":50865,"_5":13218,"_26298":50831,"_2652":46211},[],{"_3154":1839,"_27801":1825,"_19254":50867,"_5":13218,"_26298":50831,"_2652":50868},[],"Name, SAN or identifier matches the expected peer.",{"_3154":1840,"_27801":1825,"_19254":50870,"_5":13218,"_26298":50831,"_2652":45521},[],{"_3154":1841,"_27801":1825,"_19254":50872,"_5":13218,"_26298":50831,"_2652":50873},[],"KU, EKU and constraints permit the specific operation.",{"_3154":1842,"_27801":1825,"_19254":50875,"_5":13218,"_26298":50831,"_2652":50876},[],"Revocation",{"_3154":1843,"_27801":1825,"_19254":50878,"_5":13218,"_26298":50831,"_2652":50879},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_3154":1844,"_27801":1825,"_19254":50881,"_5":13218,"_26298":50831,"_2652":50882},[],"Authorization",{"_3154":1845,"_27801":1825,"_19254":50884,"_5":13218,"_26298":50831,"_2652":50885},[],"The application permits that identity to perform the action.",{"_3154":1846,"_27801":1825,"_19254":50887,"_5":13218,"_26298":50831,"_2652":50888},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_3154":1847,"_27801":1825,"_19254":50890,"_5":13218,"_26298":50835,"_2652":50891},[],"Mechanism",{"_3154":1848,"_27801":1825,"_19254":50893,"_5":13218,"_26298":50835,"_2652":50894},[],"When to use it",{"_3154":1849,"_27801":1825,"_19254":50896,"_5":13218,"_26298":50835,"_2652":50897},[],"What you must maintain",{"_3154":1850,"_27801":1825,"_19254":50899,"_5":13218,"_26298":50835,"_2652":50900},[],"OCSP",{"_3154":1851,"_27801":1825,"_19254":50902,"_5":13218,"_26298":50835,"_2652":50903},[],"Status query for a specific certificate.",{"_3154":1852,"_27801":1825,"_19254":50905,"_5":13218,"_26298":50835,"_2652":50906},[],"Responder access, signature verification and cache/freshness policy.",{"_3154":1853,"_27801":1825,"_19254":50908,"_5":13218,"_26298":50835,"_2652":50909},[],"CRL",{"_3154":1854,"_27801":1825,"_19254":50911,"_5":13218,"_26298":50835,"_2652":50912},[],"Local checks for many certificates or offline operation.",{"_3154":1855,"_27801":1825,"_19254":50914,"_5":13218,"_26298":50835,"_2652":50915},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_3154":1856,"_27801":1825,"_19254":50917,"_5":13218,"_26298":50835,"_2652":50918},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_3154":1857,"_27801":1825,"_19254":50920,"_5":13218,"_26298":50835,"_2652":50921},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_3154":1858,"_27801":1825,"_19254":50923,"_5":13218,"_26298":50839,"_2652":50924},[],"Accept a current, authorized certificate with a known chain.",{"_3154":1859,"_27801":1825,"_19254":50926,"_5":13218,"_26298":50839,"_2652":50927},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_3154":1860,"_27801":1825,"_19254":50929,"_5":13218,"_26298":50839,"_2652":50930},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_3154":1861,"_27801":1825,"_19254":50932,"_5":13218,"_26298":50839,"_2652":50933},[],"Check that a new connection with that identity is rejected.",{"_3154":1862,"_27801":1825,"_19254":50935,"_5":13218,"_26298":50839,"_2652":50936},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_3154":1863,"_27801":1825,"_19254":50938,"_5":13218,"_26298":50839,"_2652":50939},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_3154":1864,"_27801":1825,"_19254":50941,"_5":13218,"_26298":50839,"_2652":50942},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_3154":1865,"_27801":1825,"_19254":50944,"_5":13218,"_26298":50839,"_2652":50945},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_3154":1866,"_27801":1825,"_19254":50947,"_5":13218,"_26298":50839,"_2652":50948},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_3154":1867,"_27801":1867,"_5":13544,"_2652":50950,"_28144":50951,"_19254":50952,"_26298":1867},"Certificates",[45131,46511,50207,50208],[],{"_3154":1868,"_27801":1867,"_19254":50954,"_5":13218,"_26298":1867,"_2652":50955},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_3154":1869,"_27801":1867,"_5":28141,"_19254":50957,"_26298":50958,"_2652":50959},[],"/docs/pr-preview/pr-53/platform/pki/certificates#find-a-certificate","Find a certificate",{"_3154":1870,"_27801":1867,"_5":28141,"_19254":50961,"_26298":50962,"_2652":50963},[],"/docs/pr-preview/pr-53/platform/pki/certificates#download-the-certificate","Download the certificate",{"_3154":1871,"_27801":1867,"_5":28141,"_19254":50965,"_26298":50966,"_2652":50967},[],"/docs/pr-preview/pr-53/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_3154":1872,"_27801":1867,"_5":28141,"_19254":50969,"_26298":50970,"_2652":50971},[],"/docs/pr-preview/pr-53/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_3154":1873,"_27801":1867,"_5":28141,"_19254":50973,"_26298":50974,"_2652":50975},[],"/docs/pr-preview/pr-53/platform/pki/certificates#open-the-action","Open the action",{"_3154":1874,"_27801":1867,"_5":28141,"_19254":50977,"_26298":50978,"_2652":50979},[],"/docs/pr-preview/pr-53/platform/pki/certificates#choose-a-reason","Choose a reason",{"_3154":1875,"_27801":1867,"_5":28141,"_19254":50981,"_26298":50982,"_2652":50983},[],"/docs/pr-preview/pr-53/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_3154":1876,"_27801":1867,"_5":28141,"_19254":50985,"_26298":50986,"_2652":50987},[],"/docs/pr-preview/pr-53/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_3154":1877,"_27801":1867,"_5":28141,"_19254":50989,"_26298":50990,"_2652":50991},[],"/docs/pr-preview/pr-53/platform/pki/certificates#continue","Continue",{"_3154":1878,"_27801":1867,"_19254":50993,"_5":13218,"_26298":1867,"_2652":50994},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_3154":1879,"_27801":1867,"_19254":50996,"_5":13218,"_26298":50958,"_2652":50997},[],"Filter by `Common Name`, serial, status and issuer. A certificate does not contain its private key, so the private-key surfaces answer which certificates have their key held in Lamassu's KMS:",{"_3154":1880,"_27801":1867,"_19254":50999,"_5":13218,"_26298":50958,"_2652":51000},[],"The advanced **Private Key** filter, available on the Certificates page and on a CA's **Issued Certificates** tab, narrows the list to **All Certificates**, **With Private Key** or **Without Private Key**.",{"_3154":1881,"_27801":1867,"_19254":51002,"_5":13218,"_26298":50958,"_2652":51003},[],"The sortable **Private Key** column — shown by default, hidden on narrow screens — marks a key held in the KMS with a green check mark and otherwise shows `-`.",{"_3154":1882,"_27801":1867,"_19254":51005,"_5":13218,"_26298":50958,"_2652":51006},[],"In certificate details, the **Information** tab shows a **Private Key** row in the Key & Signature section: when the key is locatable in the KMS the row shows the KMS key ID as a link (tooltip: **Open private key in KMS**), otherwise it shows a **Present** or **Not available** badge.",{"_3154":1883,"_27801":1867,"_19254":51008,"_5":13218,"_26298":50958,"_2652":51009},[],"Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_3154":1884,"_27801":1867,"_19254":51011,"_5":13218,"_26298":50958,"_2652":51012},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_3154":1885,"_27801":1867,"_19254":51014,"_5":13218,"_26298":50962,"_2652":51015},[],"Download the PEM and inspect it:",{"_3154":1886,"_27801":1867,"_19254":51017,"_5":13218,"_26298":50962,"_2652":51018},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_3154":1887,"_27801":1867,"_19254":51020,"_5":13218,"_26298":50966,"_2652":51021},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_3154":1888,"_27801":1867,"_19254":51023,"_5":13218,"_26298":50966,"_2652":51024},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_3154":1889,"_27801":1867,"_19254":51026,"_5":13218,"_26298":50966,"_2652":51027},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_3154":1890,"_27801":1867,"_19254":51029,"_5":13218,"_26298":50966,"_2652":51030},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_3154":1891,"_27801":1867,"_19254":51032,"_5":13218,"_26298":50966,"_2652":51033},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_3154":1892,"_27801":1867,"_19254":51035,"_5":13218,"_26298":50966,"_2652":51036},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_3154":1893,"_27801":1867,"_19254":51038,"_5":13218,"_26298":50966,"_2652":51039},[],"For browser key generation, follow Issue your first certificate.",{"_3154":1894,"_27801":1867,"_19254":51041,"_5":13218,"_26298":50970,"_2652":51042},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_3154":1895,"_27801":1867,"_19254":51044,"_5":13218,"_26298":50974,"_2652":51045},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_3154":1896,"_27801":1867,"_19254":51047,"_5":13218,"_26298":50978,"_2652":51048},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_3154":1897,"_27801":1867,"_19254":51050,"_5":13218,"_26298":50982,"_2652":51051},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_3154":1898,"_27801":1867,"_19254":51053,"_5":13218,"_26298":50982,"_2652":51054},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_3154":1899,"_27801":1867,"_19254":51056,"_5":13218,"_26298":50982,"_2652":51057},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_3154":1900,"_27801":1867,"_19254":51059,"_5":13218,"_26298":50986,"_2652":51060},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_3154":1901,"_27801":1867,"_19254":51062,"_5":13218,"_26298":50986,"_2652":51063},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_3154":1902,"_27801":1867,"_19254":51065,"_5":13218,"_26298":50986,"_2652":51066},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_3154":1903,"_27801":1867,"_19254":51068,"_5":13218,"_26298":50990,"_2652":51069},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_3154":1904,"_27801":1867,"_19254":51071,"_5":13218,"_26298":50990,"_2652":51072},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_3154":1905,"_27801":1905,"_5":13544,"_2652":51074,"_28144":51075,"_19254":51077,"_26298":1905},"Certificate lifecycle",[45131,46511,50207,51076],"Concepts",[],{"_3154":1906,"_27801":1905,"_19254":51079,"_5":13218,"_26298":1905,"_2652":51080},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_3154":1907,"_27801":1905,"_5":28141,"_19254":51082,"_26298":51083,"_2652":51084},[],"/docs/pr-preview/pr-53/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_3154":1908,"_27801":1905,"_5":28141,"_19254":51086,"_26298":51087,"_2652":51088},[],"/docs/pr-preview/pr-53/platform/pki/concepts/certificate-lifecycle#request","Request",{"_3154":1909,"_27801":1905,"_5":28141,"_19254":51090,"_26298":51091,"_2652":51092},[],"/docs/pr-preview/pr-53/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_3154":1910,"_27801":1905,"_5":28141,"_19254":51094,"_26298":51095,"_2652":51096},[],"/docs/pr-preview/pr-53/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_3154":1911,"_27801":1905,"_5":28141,"_19254":51098,"_26298":51099,"_2652":51100},[],"/docs/pr-preview/pr-53/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_3154":1912,"_27801":1905,"_5":28141,"_19254":51102,"_26298":51103,"_2652":51104},[],"/docs/pr-preview/pr-53/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_3154":1913,"_27801":1905,"_5":28141,"_19254":51106,"_26298":51107,"_2652":51108},[],"/docs/pr-preview/pr-53/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_3154":1914,"_27801":1905,"_5":28141,"_19254":51110,"_26298":51111,"_2652":51112},[],"/docs/pr-preview/pr-53/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_3154":1915,"_27801":1905,"_5":28141,"_19254":51114,"_26298":51115,"_2652":51116},[],"/docs/pr-preview/pr-53/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_3154":1916,"_27801":1905,"_5":28141,"_19254":51118,"_26298":51119,"_2652":51120},[],"/docs/pr-preview/pr-53/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_3154":1917,"_27801":1905,"_19254":51122,"_5":13218,"_26298":1905,"_2652":51123},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_3154":1918,"_27801":1905,"_19254":51125,"_5":13218,"_26298":51087,"_2652":51126},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_3154":1919,"_27801":1905,"_19254":51128,"_5":13218,"_26298":51091,"_2652":51129},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_3154":1920,"_27801":1905,"_19254":51131,"_5":13218,"_26298":51095,"_2652":51132},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_3154":1921,"_27801":1905,"_19254":51134,"_5":13218,"_26298":51099,"_2652":51135},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_3154":1922,"_27801":1905,"_19254":51137,"_5":13218,"_26298":51103,"_2652":51138},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_3154":1923,"_27801":1905,"_19254":51140,"_5":13218,"_26298":51107,"_2652":51141},[],"Lamassu persists four X.509 states:",{"_3154":1924,"_27801":1905,"_19254":51143,"_5":13218,"_26298":51107,"_2652":51144},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_3154":1925,"_27801":1905,"_19254":51146,"_5":13218,"_26298":51107,"_2652":51147},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_3154":1926,"_27801":1905,"_19254":51149,"_5":13218,"_26298":51107,"_2652":51150},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_3154":1927,"_27801":1905,"_19254":51152,"_5":13218,"_26298":51107,"_2652":51153},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_3154":1928,"_27801":1905,"_19254":51155,"_5":13218,"_26298":51107,"_2652":51156},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_3154":1929,"_27801":1905,"_19254":51158,"_5":13218,"_26298":51111,"_2652":51159},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_3154":1930,"_27801":1905,"_19254":51161,"_5":13218,"_26298":51111,"_2652":51162},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_3154":1931,"_27801":1905,"_19254":51164,"_5":13218,"_26298":51111,"_2652":51165},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_3154":1932,"_27801":1905,"_19254":51167,"_5":13218,"_26298":51115,"_2652":51168},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_3154":1933,"_27801":1905,"_19254":51170,"_5":13218,"_26298":51115,"_2652":51171},[],"Before confirming:",{"_3154":1934,"_27801":1905,"_19254":51173,"_5":13218,"_26298":51115,"_2652":51174},[],"Identify DMSs, devices and services that trust that chain.",{"_3154":1935,"_27801":1905,"_19254":51176,"_5":13218,"_26298":51115,"_2652":51177},[],"Distribute the new chain of trust.",{"_3154":1936,"_27801":1905,"_19254":51179,"_5":13218,"_26298":51115,"_2652":51180},[],"Reissue the necessary identities.",{"_3154":1937,"_27801":1905,"_19254":51182,"_5":13218,"_26298":51115,"_2652":51183},[],"Check OCSP and CRL from a real consumer.",{"_3154":1938,"_27801":1905,"_19254":51185,"_5":13218,"_26298":51115,"_2652":51186},[],"Revoke the old CA once no legitimate traffic remains.",{"_3154":1939,"_27801":1905,"_19254":51188,"_5":13218,"_26298":51115,"_2652":51189},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_3154":1940,"_27801":1905,"_19254":51191,"_5":13218,"_26298":51119,"_2652":51192},[],"Certificates entering the preventive or critical renewal window.",{"_3154":1941,"_27801":1905,"_19254":51194,"_5":13218,"_26298":51119,"_2652":51195},[],"Repeated enrollment or re-enrollment failures.",{"_3154":1942,"_27801":1905,"_19254":51197,"_5":13218,"_26298":51119,"_2652":51198},[],"Status changes and revocation reasons.",{"_3154":1943,"_27801":1905,"_19254":51200,"_5":13218,"_26298":51119,"_2652":51201},[],"OCSP and CRL publication and validity.",{"_3154":1944,"_27801":1905,"_19254":51203,"_5":13218,"_26298":51119,"_2652":51204},[],"Dependencies still presenting a replaced certificate.",{"_3154":1945,"_27801":1905,"_19254":51206,"_5":13218,"_26298":51119,"_2652":51207},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_3154":1946,"_27801":1946,"_5":13544,"_2652":51209,"_28144":51210,"_19254":51211,"_26298":1946},"Trust model",[45131,46511,50207,51076],[],{"_3154":1947,"_27801":1946,"_19254":51213,"_5":13218,"_26298":1946,"_2652":51214},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_3154":1948,"_27801":1946,"_5":28141,"_19254":51216,"_26298":51217,"_2652":51218},[],"/docs/pr-preview/pr-53/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_3154":1949,"_27801":1946,"_5":28141,"_19254":51220,"_26298":51221,"_2652":51222},[],"/docs/pr-preview/pr-53/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_3154":1950,"_27801":1946,"_5":28141,"_19254":51224,"_26298":51225,"_2652":51226},[],"/docs/pr-preview/pr-53/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_3154":1951,"_27801":1946,"_5":28141,"_19254":51228,"_26298":51229,"_2652":51230},[],"/docs/pr-preview/pr-53/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_3154":1952,"_27801":1946,"_5":28141,"_19254":51232,"_26298":51233,"_2652":51234},[],"/docs/pr-preview/pr-53/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_3154":1953,"_27801":1946,"_5":28141,"_19254":51236,"_26298":51237,"_2652":51238},[],"/docs/pr-preview/pr-53/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_3154":1954,"_27801":1946,"_5":28141,"_19254":51240,"_26298":51241,"_2652":51242},[],"/docs/pr-preview/pr-53/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_3154":1955,"_27801":1946,"_5":28141,"_19254":51244,"_26298":51245,"_2652":51246},[],"/docs/pr-preview/pr-53/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_3154":1956,"_27801":1946,"_5":28141,"_19254":51248,"_26298":51249,"_2652":51250},[],"/docs/pr-preview/pr-53/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_3154":1957,"_27801":1946,"_5":28141,"_19254":51252,"_26298":51253,"_2652":51254},[],"/docs/pr-preview/pr-53/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_3154":1958,"_27801":1946,"_19254":51256,"_5":13218,"_26298":1946,"_2652":51257},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_3154":1959,"_27801":1946,"_19254":51259,"_5":13218,"_26298":51221,"_2652":51260},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_3154":1960,"_27801":1946,"_19254":51262,"_5":13218,"_26298":51225,"_2652":51263},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_3154":1961,"_27801":1946,"_19254":51265,"_5":13218,"_26298":51229,"_2652":51266},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_3154":1962,"_27801":1946,"_19254":51268,"_5":13218,"_26298":51233,"_2652":51269},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_3154":1963,"_27801":1946,"_19254":51271,"_5":13218,"_26298":51237,"_2652":51272},[],"The device proves it can enroll according to the DMS policy.",{"_3154":1964,"_27801":1946,"_19254":51274,"_5":13218,"_26298":51237,"_2652":51275},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_3154":1965,"_27801":1946,"_19254":51277,"_5":13218,"_26298":51237,"_2652":51278},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_3154":1966,"_27801":1946,"_19254":51280,"_5":13218,"_26298":51237,"_2652":51281},[],"The device installs the certificate and the chain it needs.",{"_3154":1967,"_27801":1946,"_19254":51283,"_5":13218,"_26298":51237,"_2652":51284},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_3154":1968,"_27801":1946,"_19254":51286,"_5":13218,"_26298":51237,"_2652":51287},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_3154":1969,"_27801":1946,"_19254":51289,"_5":13218,"_26298":51241,"_2652":51290},[],"A DMS relates three sets that are worth designing separately:",{"_3154":1970,"_27801":1946,"_19254":51292,"_5":13218,"_26298":51241,"_2652":51293},[],"**Enrollment CA:** signs the new identities.",{"_3154":1971,"_27801":1946,"_19254":51295,"_5":13218,"_26298":51241,"_2652":51296},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, the enrollment CA is always trusted and Lamassu then tries the validation CAs configured in the re-enrollment block; those are optional.",{"_3154":1972,"_27801":1946,"_19254":51298,"_5":13218,"_26298":51241,"_2652":51299},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_3154":1973,"_27801":1946,"_19254":51301,"_5":13218,"_26298":51241,"_2652":51302},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_3154":1974,"_27801":1946,"_19254":51304,"_5":13218,"_26298":51245,"_2652":51305},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_3154":1975,"_27801":1946,"_19254":51307,"_5":13218,"_26298":51245,"_2652":51308},[],"that the current date is between `Not Before` and `Not After`;",{"_3154":1976,"_27801":1946,"_19254":51310,"_5":13218,"_26298":51245,"_2652":51311},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_3154":1977,"_27801":1946,"_19254":51313,"_5":13218,"_26298":51245,"_2652":51314},[],"that names, SANs and subject match the expected identity;",{"_3154":1978,"_27801":1946,"_19254":51316,"_5":13218,"_26298":51245,"_2652":51317},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_3154":1979,"_27801":1946,"_19254":51319,"_5":13218,"_26298":51245,"_2652":51320},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_3154":1980,"_27801":1946,"_19254":51322,"_5":13218,"_26298":51245,"_2652":51323},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_3154":1981,"_27801":1946,"_19254":51325,"_5":13218,"_26298":51249,"_2652":51326},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_3154":1982,"_27801":1946,"_19254":51328,"_5":13218,"_26298":51253,"_2652":51329},[],"Keep the root out of daily operations, or with very restricted access.",{"_3154":1983,"_27801":1946,"_19254":51331,"_5":13218,"_26298":51253,"_2652":51332},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_3154":1984,"_27801":1946,"_19254":51334,"_5":13218,"_26298":51253,"_2652":51335},[],"Assign explicit profiles to every use case.",{"_3154":1985,"_27801":1946,"_19254":51337,"_5":13218,"_26298":51253,"_2652":51338},[],"Distribute the new trust before starting a rotation.",{"_3154":1986,"_27801":1946,"_19254":51340,"_5":13218,"_26298":51253,"_2652":51341},[],"Keep enough overlap to renew a disconnected fleet.",{"_3154":1987,"_27801":1946,"_19254":51343,"_5":13218,"_26298":51253,"_2652":51344},[],"Validate from the consuming system, not only from the Lamassu console.",{"_3154":1988,"_27801":1946,"_19254":51346,"_5":13218,"_26298":51253,"_2652":51347},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_3154":1989,"_27801":1989,"_5":13544,"_2652":51349,"_28144":51350,"_19254":51351,"_26298":1989},"Revocation lists (CRL)",[45131,46511,50207,50824],[],{"_3154":1990,"_27801":1989,"_19254":51353,"_5":13218,"_26298":1989,"_2652":51354},[],"Generate and distribute signed lists to validate certificates offline.",{"_3154":1991,"_27801":1989,"_5":28141,"_19254":51356,"_26298":51357,"_2652":51358},[],"/docs/pr-preview/pr-53/platform/pki/crl#va-role-and-per-ca-configuration","VA role and per-CA configuration",{"_3154":1992,"_27801":1989,"_5":28141,"_19254":51360,"_26298":51361,"_2652":51362},[],"/docs/pr-preview/pr-53/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_3154":1993,"_27801":1989,"_5":28141,"_19254":51364,"_26298":51365,"_2652":51366},[],"/docs/pr-preview/pr-53/platform/pki/crl#crl-contents","CRL contents",{"_3154":1994,"_27801":1989,"_5":28141,"_19254":51368,"_26298":51369,"_2652":51370},[],"/docs/pr-preview/pr-53/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_3154":1995,"_27801":1989,"_5":28141,"_19254":51372,"_26298":51373,"_2652":51374},[],"/docs/pr-preview/pr-53/platform/pki/crl#va-role-management-api","VA role management API",{"_3154":1996,"_27801":1989,"_5":28141,"_19254":51376,"_26298":51377,"_2652":51378},[],"/docs/pr-preview/pr-53/platform/pki/crl#from-the-interface","From the interface",{"_3154":1997,"_27801":1989,"_5":28141,"_19254":51380,"_26298":51381,"_2652":51382},[],"/docs/pr-preview/pr-53/platform/pki/crl#references","References",{"_3154":1998,"_27801":1989,"_19254":51384,"_5":13218,"_26298":1989,"_2652":51385},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its SKI and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_3154":1999,"_27801":1989,"_19254":51387,"_5":13218,"_26298":51357,"_2652":51388},[],"The VA role stores configuration and metadata for the latest list published for a CA’s SKI. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_3154":2000,"_27801":1989,"_19254":51390,"_5":13218,"_26298":51357,"_2652":51391},[],"`crl_options` field",{"_3154":2001,"_27801":1989,"_19254":51393,"_5":13218,"_26298":51357,"_2652":45521},[],{"_3154":2002,"_27801":1989,"_19254":51395,"_5":13218,"_26298":51357,"_2652":51396},[],"Backend initial value",{"_3154":2003,"_27801":1989,"_19254":51398,"_5":13218,"_26298":51357,"_2652":51399},[],"`validity`",{"_3154":2004,"_27801":1989,"_19254":51401,"_5":13218,"_26298":51357,"_2652":51402},[],"Time from `thisUpdate` to `nextUpdate`.",{"_3154":2005,"_27801":1989,"_19254":51404,"_5":13218,"_26298":51357,"_2652":51405},[],"7 days.",{"_3154":2006,"_27801":1989,"_19254":51407,"_5":13218,"_26298":51357,"_2652":51408},[],"`refresh_interval`",{"_3154":2007,"_27801":1989,"_19254":51410,"_5":13218,"_26298":51357,"_2652":51411},[],"Time since publication that triggers scheduled renewal.",{"_3154":2008,"_27801":1989,"_19254":51413,"_5":13218,"_26298":51357,"_2652":51414},[],"6 days and 23 hours.",{"_3154":2009,"_27801":1989,"_19254":51416,"_5":13218,"_26298":51357,"_2652":51417},[],"`regenerate_on_revoke`",{"_3154":2010,"_27801":1989,"_19254":51419,"_5":13218,"_26298":51357,"_2652":51420},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_3154":2011,"_27801":1989,"_19254":51422,"_5":13218,"_26298":51357,"_2652":51423},[],"`true`.",{"_3154":2012,"_27801":1989,"_19254":51425,"_5":13218,"_26298":51357,"_2652":51426},[],"`signer_certificate_serial_number`",{"_3154":2013,"_27801":1989,"_19254":51428,"_5":13218,"_26298":51357,"_2652":51429},[],"Serial number of the certificate whose key signs the CRL.",{"_3154":2014,"_27801":1989,"_19254":51431,"_5":13218,"_26298":51357,"_2652":51432},[],"The CA's own certificate (field unset).",{"_3154":2015,"_27801":1989,"_19254":51434,"_5":13218,"_26298":51357,"_2652":51435},[],"The signer is the certificate whose key signs the CRL. The console sends `signer_certificate_serial_number` — the serial number of the certificate you select — and reads the saved value back from the role configuration; when the field is unset, the default signer is the CA's own certificate. Do not interpret a non-default signer as verified support for a delegated CA: the picker only limits which certificates can be selected, and this page does not manage issuer delegation.",{"_3154":2016,"_27801":1989,"_19254":51437,"_5":13218,"_26298":51357,"_2652":51438},[],"`latest_crl` contains version, validity start and end. Versions are kept as PEM in object storage at `pki/va/crl/{subject_key_id}/{version}.crl`; the public endpoint returns DER.",{"_3154":2017,"_27801":1989,"_19254":51440,"_5":13218,"_26298":51361,"_2652":51441},[],"The scheduled job requests another list when `refresh_interval` is reached or when the list approaches expiration within the configured watch period. This depends on working jobs, storage and signing; it does not guarantee renewal during a service failure.",{"_3154":2018,"_27801":1989,"_19254":51443,"_5":13218,"_26298":51361,"_2652":51444},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_3154":2019,"_27801":1989,"_19254":51446,"_5":13218,"_26298":51361,"_2652":51447},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_3154":2020,"_27801":1989,"_19254":51449,"_5":13218,"_26298":51365,"_2652":51450},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_3154":2021,"_27801":1989,"_19254":51452,"_5":13218,"_26298":51365,"_2652":51453},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_3154":2022,"_27801":1989,"_19254":51455,"_5":13218,"_26298":51369,"_2652":51456},[],"The VA service exposes `GET /crl/{subject_key_id}` without management authorization. Use the **issuing CA’s** SKI, not the end-entity certificate’s SKI or serial. First inspect the certificate’s CDP:",{"_3154":2023,"_27801":1989,"_19254":51458,"_5":13218,"_26298":51369,"_2652":51459},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_3154":2024,"_27801":1989,"_19254":51461,"_5":13218,"_26298":51369,"_2652":51462},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_3154":2025,"_27801":1989,"_19254":51464,"_5":13218,"_26298":51369,"_2652":51465},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_3154":2026,"_27801":1989,"_19254":51467,"_5":13218,"_26298":51369,"_2652":51468},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_3154":2027,"_27801":1989,"_19254":51470,"_5":13218,"_26298":51373,"_2652":51471},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_3154":2028,"_27801":1989,"_19254":51473,"_5":13218,"_26298":51373,"_2652":48238},[],{"_3154":2029,"_27801":1989,"_19254":51475,"_5":13218,"_26298":51373,"_2652":51476},[],"Relative path",{"_3154":2030,"_27801":1989,"_19254":51478,"_5":13218,"_26298":51373,"_2652":48235},[],{"_3154":2031,"_27801":1989,"_19254":51480,"_5":13218,"_26298":51373,"_2652":51481},[],"`GET`",{"_3154":2032,"_27801":1989,"_19254":51483,"_5":13218,"_26298":51373,"_2652":51484},[],"`/v1/roles/{ca-ski}`",{"_3154":2033,"_27801":1989,"_19254":51486,"_5":13218,"_26298":51373,"_2652":51487},[],"Read `crl_options` and `latest_crl`.",{"_3154":2034,"_27801":1989,"_19254":51489,"_5":13218,"_26298":51373,"_2652":51490},[],"`PUT`",{"_3154":2035,"_27801":1989,"_19254":51492,"_5":13218,"_26298":51373,"_2652":51484},[],{"_3154":2036,"_27801":1989,"_19254":51494,"_5":13218,"_26298":51373,"_2652":51495},[],"Replace CRL configuration.",{"_3154":2037,"_27801":1989,"_19254":51497,"_5":13218,"_26298":51373,"_2652":51498},[],"You need authentication and role read or update permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract: the backend replaces `crl_options`; it does not merge omitted fields.",{"_3154":2038,"_27801":1989,"_19254":51500,"_5":13218,"_26298":51373,"_2652":51501},[],"After a change, check saved configuration and the next list actually published. Updating the role alone does not establish regeneration or client acceptance.",{"_3154":2039,"_27801":1989,"_19254":51503,"_5":13218,"_26298":51377,"_2652":51504},[],"The CA view lets you inspect and download the available list. Compare version, issuer and timestamps with the copy downloaded from the public endpoint. The CA's VA settings also let you select the CRL signer: the certificate picker only offers certificates that have a private key and carry the `CRLSign` key usage. If a configured signer's certificate cannot be resolved, the interface shows `Unknown Certificate (Serial: X)` or `Certificate details unavailable (Serial: X)`. Diagnose differences using PKI troubleshooting.",{"_3154":2040,"_27801":1989,"_19254":51506,"_5":13218,"_26298":51381,"_2652":51507},[],"RFC 5280: X.509 and CRL profile.",{"_3154":2041,"_27801":1989,"_19254":51509,"_5":13218,"_26298":51381,"_2652":51510},[],"OpenSSL: openssl-crl.",{"_3154":2042,"_27801":1989,"_19254":51512,"_5":13218,"_26298":51381,"_2652":51513},[],"OpenSSL: openssl-verify.",{"_3154":2043,"_27801":1989,"_19254":51515,"_5":13218,"_26298":51381,"_2652":51516},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_3154":2044,"_27801":1989,"_19254":51518,"_5":13218,"_26298":51381,"_2652":51519},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3154":2045,"_27801":2045,"_5":13544,"_2652":51521,"_28144":51522,"_19254":51523,"_26298":2045},"Keys and cryptographic engines",[45131,46511,50207,50208],[],{"_3154":2046,"_27801":2045,"_19254":51525,"_5":13218,"_26298":2045,"_2652":51526},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_3154":2047,"_27801":2045,"_5":28141,"_19254":51528,"_26298":51529,"_2652":51530},[],"/docs/pr-preview/pr-53/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_3154":2048,"_27801":2045,"_5":28141,"_19254":51532,"_26298":51533,"_2652":51534},[],"/docs/pr-preview/pr-53/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_3154":2049,"_27801":2045,"_5":28141,"_19254":51536,"_26298":51537,"_2652":51538},[],"/docs/pr-preview/pr-53/platform/pki/key-management#file-system","File System",{"_3154":2050,"_27801":2045,"_5":28141,"_19254":51540,"_26298":51541,"_2652":51542},[],"/docs/pr-preview/pr-53/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3154":2051,"_27801":2045,"_5":28141,"_19254":51544,"_26298":51545,"_2652":51546},[],"/docs/pr-preview/pr-53/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3154":2052,"_27801":2045,"_5":28141,"_19254":51548,"_26298":51549,"_2652":51550},[],"/docs/pr-preview/pr-53/platform/pki/key-management#aws-kms","AWS KMS",{"_3154":2053,"_27801":2045,"_5":28141,"_19254":51552,"_26298":51553,"_2652":51554},[],"/docs/pr-preview/pr-53/platform/pki/key-management#pkcs11","PKCS#11",{"_3154":2054,"_27801":2045,"_5":28141,"_19254":51556,"_26298":51557,"_2652":51558},[],"/docs/pr-preview/pr-53/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_3154":2055,"_27801":2045,"_5":28141,"_19254":51560,"_26298":51561,"_2652":51562},[],"/docs/pr-preview/pr-53/platform/pki/key-management#key-inventory","Key inventory",{"_3154":2056,"_27801":2045,"_5":28141,"_19254":51564,"_26298":51565,"_2652":51566},[],"/docs/pr-preview/pr-53/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_3154":2057,"_27801":2045,"_5":28141,"_19254":51568,"_26298":51569,"_2652":51570},[],"/docs/pr-preview/pr-53/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_3154":2058,"_27801":2045,"_5":28141,"_19254":51572,"_26298":51573,"_2652":51574},[],"/docs/pr-preview/pr-53/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_3154":2059,"_27801":2045,"_5":28141,"_19254":51576,"_26298":51577,"_2652":51578},[],"/docs/pr-preview/pr-53/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_3154":2060,"_27801":2045,"_5":28141,"_19254":51580,"_26298":51581,"_2652":51582},[],"/docs/pr-preview/pr-53/platform/pki/key-management#view-details","View details",{"_3154":2061,"_27801":2045,"_5":28141,"_19254":51584,"_26298":51585,"_2652":51586},[],"/docs/pr-preview/pr-53/platform/pki/key-management#sign-and-verify","Sign and verify",{"_3154":2062,"_27801":2045,"_5":28141,"_19254":51588,"_26298":51589,"_2652":51590},[],"/docs/pr-preview/pr-53/platform/pki/key-management#sign","Sign",{"_3154":2063,"_27801":2045,"_5":28141,"_19254":51592,"_26298":51593,"_2652":51594},[],"/docs/pr-preview/pr-53/platform/pki/key-management#verify","Verify",{"_3154":2064,"_27801":2045,"_5":28141,"_19254":51596,"_26298":51597,"_2652":51598},[],"/docs/pr-preview/pr-53/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_3154":2065,"_27801":2045,"_5":28141,"_19254":51600,"_26298":51601,"_2652":51602},[],"/docs/pr-preview/pr-53/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_3154":2066,"_27801":2045,"_5":28141,"_19254":51604,"_26298":51605,"_2652":51606},[],"/docs/pr-preview/pr-53/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_3154":2067,"_27801":2045,"_19254":51608,"_5":13218,"_26298":2045,"_2652":51609},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_3154":2068,"_27801":2045,"_19254":51611,"_5":13218,"_26298":2045,"_2652":51612},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_3154":2069,"_27801":2045,"_19254":51614,"_5":13218,"_26298":51529,"_2652":51615},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_3154":2070,"_27801":2045,"_19254":51617,"_5":13218,"_26298":51529,"_2652":51618},[],"In practice, it lets you:",{"_3154":2071,"_27801":2045,"_19254":51620,"_5":13218,"_26298":51529,"_2652":51621},[],"Generate new key pairs from Lamassu IoT.",{"_3154":2072,"_27801":2045,"_19254":51623,"_5":13218,"_26298":51529,"_2652":51624},[],"Import keys created externally.",{"_3154":2073,"_27801":2045,"_19254":51626,"_5":13218,"_26298":51529,"_2652":51627},[],"Delegate custody and cryptographic operations to external engines.",{"_3154":2074,"_27801":2045,"_19254":51629,"_5":13218,"_26298":51529,"_2652":51630},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_3154":2075,"_27801":2045,"_19254":51632,"_5":13218,"_26298":51533,"_2652":51633},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_3154":2076,"_27801":2045,"_19254":51635,"_5":13218,"_26298":51533,"_2652":51636},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_3154":2077,"_27801":2045,"_19254":51638,"_5":13218,"_26298":51533,"_2652":51639},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_3154":2078,"_27801":2045,"_19254":51641,"_5":13218,"_26298":51537,"_2652":51642},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_3154":2079,"_27801":2045,"_19254":51644,"_5":13218,"_26298":51541,"_2652":51645},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_3154":2080,"_27801":2045,"_19254":51647,"_5":13218,"_26298":51545,"_2652":51648},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_3154":2081,"_27801":2045,"_19254":51650,"_5":13218,"_26298":51549,"_2652":51651},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_3154":2082,"_27801":2045,"_19254":51653,"_5":13218,"_26298":51553,"_2652":51654},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_3154":2083,"_27801":2045,"_19254":51656,"_5":13218,"_26298":51557,"_2652":51657},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_3154":2084,"_27801":2045,"_19254":51659,"_5":13218,"_26298":51557,"_2652":51660},[],"Lamassu shows the enabled engines in the console.",{"_3154":2085,"_27801":2045,"_19254":51662,"_5":13218,"_26298":51557,"_2652":51663},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_3154":2086,"_27801":2045,"_19254":51665,"_5":13218,"_26298":51557,"_2652":51666},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_3154":2087,"_27801":2045,"_19254":51668,"_5":13218,"_26298":51561,"_2652":51669},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_3154":2088,"_27801":2045,"_19254":51671,"_5":13218,"_26298":51561,"_2652":51672},[],"The table includes the following fields:",{"_3154":2089,"_27801":2045,"_19254":51674,"_5":13218,"_26298":51561,"_2652":51675},[],"**Name**: descriptive name of the key.",{"_3154":2090,"_27801":2045,"_19254":51677,"_5":13218,"_26298":51561,"_2652":51678},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_3154":2091,"_27801":2045,"_19254":51680,"_5":13218,"_26298":51561,"_2652":51681},[],"**Strength**: visual indicator of cryptographic strength.",{"_3154":2092,"_27801":2045,"_19254":51683,"_5":13218,"_26298":51561,"_2652":51684},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_3154":2093,"_27801":2045,"_19254":51686,"_5":13218,"_26298":51561,"_2652":51687},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_3154":2094,"_27801":2045,"_19254":51689,"_5":13218,"_26298":51561,"_2652":51690},[],"**Aliases**: alternative names associated with the key.",{"_3154":2095,"_27801":2045,"_19254":51692,"_5":13218,"_26298":51561,"_2652":51693},[],"**Tags**: labels for classification and search.",{"_3154":2096,"_27801":2045,"_19254":51695,"_5":13218,"_26298":51561,"_2652":51696},[],"**Related Entities**: certificates or other entities linked to that key.",{"_3154":2097,"_27801":2045,"_19254":51698,"_5":13218,"_26298":51561,"_2652":51699},[],"From this view you also reach the most common actions:",{"_3154":2098,"_27801":2045,"_19254":51701,"_5":13218,"_26298":51561,"_2652":51702},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_3154":2099,"_27801":2045,"_19254":51704,"_5":13218,"_26298":51561,"_2652":51705},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_3154":2100,"_27801":2045,"_19254":51707,"_5":13218,"_26298":51561,"_2652":51708},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_3154":2101,"_27801":2045,"_19254":51710,"_5":13218,"_26298":51561,"_2652":51711},[],"**Delete Key** to remove the key from the system.",{"_3154":2102,"_27801":2045,"_19254":51713,"_5":13218,"_26298":51565,"_2652":51714},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_3154":2103,"_27801":2045,"_19254":51716,"_5":13218,"_26298":51569,"_2652":51717},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_3154":2104,"_27801":2045,"_19254":51719,"_5":13218,"_26298":51569,"_2652":51720},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_3154":2105,"_27801":2045,"_19254":51722,"_5":13218,"_26298":51569,"_2652":51723},[],"**Key Name**: unique and descriptive name.",{"_3154":2106,"_27801":2045,"_19254":51725,"_5":13218,"_26298":51569,"_2652":51726},[],"**Crypto Engine**: engine that will keep the key.",{"_3154":2107,"_27801":2045,"_19254":51728,"_5":13218,"_26298":51569,"_2652":51729},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_3154":2108,"_27801":2045,"_19254":51731,"_5":13218,"_26298":51569,"_2652":51732},[],"**Tags**: metadata to classify the key.",{"_3154":2109,"_27801":2045,"_19254":51734,"_5":13218,"_26298":51569,"_2652":51735},[],"**Metadata**: additional information for advanced uses.",{"_3154":2110,"_27801":2045,"_19254":51737,"_5":13218,"_26298":51573,"_2652":51738},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_3154":2111,"_27801":2045,"_19254":51740,"_5":13218,"_26298":51573,"_2652":51741},[],"When you have an exportable private key and the destination engine supports import.",{"_3154":2112,"_27801":2045,"_19254":51743,"_5":13218,"_26298":51573,"_2652":51744},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_3154":2113,"_27801":2045,"_19254":51746,"_5":13218,"_26298":51573,"_2652":51747},[],"When Lamassu must operate with a root of trust created by a third party.",{"_3154":2114,"_27801":2045,"_19254":51749,"_5":13218,"_26298":51573,"_2652":51750},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_3154":2115,"_27801":2045,"_19254":51752,"_5":13218,"_26298":51573,"_2652":51753},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_3154":2116,"_27801":2045,"_19254":51755,"_5":13218,"_26298":51573,"_2652":51756},[],"**Crypto Engine**: engine that will keep the imported key.",{"_3154":2117,"_27801":2045,"_19254":51758,"_5":13218,"_26298":51573,"_2652":51759},[],"**Tags**: labels for organization and search.",{"_3154":2118,"_27801":2045,"_19254":51761,"_5":13218,"_26298":51573,"_2652":51762},[],"**Metadata**: additional optional information.",{"_3154":2119,"_27801":2045,"_19254":51764,"_5":13218,"_26298":51573,"_2652":51765},[],"**Private Key (PEM)**: private key in PEM format.",{"_3154":2120,"_27801":2045,"_19254":51767,"_5":13218,"_26298":51573,"_2652":51768},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_3154":2121,"_27801":2045,"_19254":51770,"_5":13218,"_26298":51577,"_2652":51771},[],"Each registered key has a detail view and several operational actions.",{"_3154":2122,"_27801":2045,"_19254":51773,"_5":13218,"_26298":51581,"_2652":51774},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_3154":2123,"_27801":2045,"_19254":51776,"_5":13218,"_26298":51581,"_2652":51777},[],"The **Overview** tab shows, among others, these fields:",{"_3154":2124,"_27801":2045,"_19254":51779,"_5":13218,"_26298":51581,"_2652":51780},[],"**Key Name**: descriptive name.",{"_3154":2125,"_27801":2045,"_19254":51782,"_5":13218,"_26298":51581,"_2652":51783},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_3154":2126,"_27801":2045,"_19254":51785,"_5":13218,"_26298":51581,"_2652":51786},[],"**Tags**: associated labels.",{"_3154":2127,"_27801":2045,"_19254":51788,"_5":13218,"_26298":51581,"_2652":51789},[],"**Aliases**: alternative names.",{"_3154":2128,"_27801":2045,"_19254":51791,"_5":13218,"_26298":51581,"_2652":51792},[],"**Crypto Engine**: engine where the key resides.",{"_3154":2129,"_27801":2045,"_19254":51794,"_5":13218,"_26298":51581,"_2652":51795},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_3154":2130,"_27801":2045,"_19254":51797,"_5":13218,"_26298":51581,"_2652":51798},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_3154":2131,"_27801":2045,"_19254":51800,"_5":13218,"_26298":51581,"_2652":51801},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_3154":2132,"_27801":2045,"_19254":51803,"_5":13218,"_26298":51585,"_2652":51804},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_3154":2133,"_27801":2045,"_19254":51806,"_5":13218,"_26298":51585,"_2652":51807},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_3154":2134,"_27801":2045,"_19254":51809,"_5":13218,"_26298":51585,"_2652":51810},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_3154":2135,"_27801":2045,"_19254":51812,"_5":13218,"_26298":51589,"_2652":51813},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_3154":2136,"_27801":2045,"_19254":51815,"_5":13218,"_26298":51589,"_2652":51816},[],"Main fields:",{"_3154":2137,"_27801":2045,"_19254":51818,"_5":13218,"_26298":51589,"_2652":51819},[],"**Algorithm**: signing algorithm available for the key type.",{"_3154":2138,"_27801":2045,"_19254":51821,"_5":13218,"_26298":51589,"_2652":51822},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_3154":2139,"_27801":2045,"_19254":51824,"_5":13218,"_26298":51589,"_2652":51825},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_3154":2140,"_27801":2045,"_19254":51827,"_5":13218,"_26298":51589,"_2652":51828},[],"**Message**: content to sign.",{"_3154":2141,"_27801":2045,"_19254":51830,"_5":13218,"_26298":51589,"_2652":51831},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_3154":2142,"_27801":2045,"_19254":51833,"_5":13218,"_26298":51593,"_2652":51834},[],"This tab checks whether a signature corresponds to the associated public key.",{"_3154":2143,"_27801":2045,"_19254":51836,"_5":13218,"_26298":51593,"_2652":51816},[],{"_3154":2144,"_27801":2045,"_19254":51838,"_5":13218,"_26298":51593,"_2652":51839},[],"**Algorithm**: must match the algorithm used for the signature.",{"_3154":2145,"_27801":2045,"_19254":51841,"_5":13218,"_26298":51593,"_2652":51842},[],"**Message Type**: `Raw` or `Digest`.",{"_3154":2146,"_27801":2045,"_19254":51844,"_5":13218,"_26298":51593,"_2652":51845},[],"**Payload Encoding**: encoding of the message.",{"_3154":2147,"_27801":2045,"_19254":51847,"_5":13218,"_26298":51593,"_2652":51848},[],"**Message**: original message or hash.",{"_3154":2148,"_27801":2045,"_19254":51850,"_5":13218,"_26298":51593,"_2652":51851},[],"**Signature**: signature to check.",{"_3154":2149,"_27801":2045,"_19254":51853,"_5":13218,"_26298":51593,"_2652":51854},[],"**Result**: indicator of the validation result.",{"_3154":2150,"_27801":2045,"_19254":51856,"_5":13218,"_26298":51597,"_2652":51857},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_3154":2151,"_27801":2045,"_19254":51859,"_5":13218,"_26298":51597,"_2652":51860},[],"This flow is useful for:",{"_3154":2152,"_27801":2045,"_19254":51862,"_5":13218,"_26298":51597,"_2652":51863},[],"Requesting certificates from an external CA.",{"_3154":2153,"_27801":2045,"_19254":51865,"_5":13218,"_26298":51597,"_2652":51866},[],"Renewing an identity while keeping the same key.",{"_3154":2154,"_27801":2045,"_19254":51868,"_5":13218,"_26298":51597,"_2652":51869},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_3154":2155,"_27801":2045,"_19254":51871,"_5":13218,"_26298":51597,"_2652":51872},[],"**Common Name (CN)**: main name of the identity.",{"_3154":2156,"_27801":2045,"_19254":51874,"_5":13218,"_26298":51597,"_2652":51875},[],"**Organization (O)**: organization or company.",{"_3154":2157,"_27801":2045,"_19254":51877,"_5":13218,"_26298":51597,"_2652":51878},[],"**Organizational Unit (OU)**: department or unit.",{"_3154":2158,"_27801":2045,"_19254":51880,"_5":13218,"_26298":51597,"_2652":51881},[],"**Country (C)**: two-letter country code.",{"_3154":2159,"_27801":2045,"_19254":51883,"_5":13218,"_26298":51597,"_2652":51884},[],"**State / Province (ST)**: state or province.",{"_3154":2160,"_27801":2045,"_19254":51886,"_5":13218,"_26298":51597,"_2652":51887},[],"**Locality (L)**: city or locality.",{"_3154":2161,"_27801":2045,"_19254":51889,"_5":13218,"_26298":51597,"_2652":51890},[],"**Email Address**: contact email.",{"_3154":2162,"_27801":2045,"_19254":51892,"_5":13218,"_26298":51597,"_2652":51893},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_3154":2163,"_27801":2045,"_19254":51895,"_5":13218,"_26298":51597,"_2652":51896},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_3154":2164,"_27801":2045,"_19254":51898,"_5":13218,"_26298":51601,"_2652":51899},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_3154":2165,"_27801":2045,"_19254":51901,"_5":13218,"_26298":51601,"_2652":51902},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3154":2166,"_27801":2045,"_19254":51904,"_5":13218,"_26298":51605,"_2652":51905},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_3154":2167,"_27801":2167,"_5":13544,"_2652":51907,"_28144":51908,"_19254":51909,"_26298":2167},"Online validation with OCSP",[45131,46511,50207,50824],[],{"_3154":2168,"_27801":2167,"_19254":51911,"_5":13218,"_26298":2167,"_2652":51912},[],"Query signed status and verify the responder’s response.",{"_3154":2169,"_27801":2167,"_5":28141,"_19254":51914,"_26298":51915,"_2652":51916},[],"/docs/pr-preview/pr-53/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_3154":2170,"_27801":2167,"_5":28141,"_19254":51918,"_26298":51919,"_2652":51920},[],"/docs/pr-preview/pr-53/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_3154":2171,"_27801":2167,"_5":28141,"_19254":51922,"_26298":51923,"_2652":51924},[],"/docs/pr-preview/pr-53/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_3154":2172,"_27801":2167,"_5":28141,"_19254":51926,"_26298":51927,"_2652":51928},[],"/docs/pr-preview/pr-53/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_3154":2173,"_27801":2167,"_5":28141,"_19254":51930,"_26298":51931,"_2652":51932},[],"/docs/pr-preview/pr-53/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_3154":2174,"_27801":2167,"_5":28141,"_19254":51934,"_26298":51935,"_2652":51382},[],"/docs/pr-preview/pr-53/platform/pki/ocsp#references",{"_3154":2175,"_27801":2167,"_19254":51937,"_5":13218,"_26298":2167,"_2652":51938},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_3154":2176,"_27801":2167,"_19254":51940,"_5":13218,"_26298":51915,"_2652":51941},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_3154":2177,"_27801":2167,"_19254":51943,"_5":13218,"_26298":51915,"_2652":51944},[],"Record status",{"_3154":2178,"_27801":2167,"_19254":51946,"_5":13218,"_26298":51915,"_2652":51947},[],"Signed response",{"_3154":2179,"_27801":2167,"_19254":51949,"_5":13218,"_26298":51915,"_2652":49385},[],{"_3154":2180,"_27801":2167,"_19254":51951,"_5":13218,"_26298":51915,"_2652":51952},[],"`Good`.",{"_3154":2181,"_27801":2167,"_19254":51954,"_5":13218,"_26298":51915,"_2652":49402},[],{"_3154":2182,"_27801":2167,"_19254":51956,"_5":13218,"_26298":51915,"_2652":51957},[],"`Revoked`, with revocation reason and timestamp.",{"_3154":2183,"_27801":2167,"_19254":51959,"_5":13218,"_26298":51915,"_2652":51960},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_3154":2184,"_27801":2167,"_19254":51962,"_5":13218,"_26298":51915,"_2652":51963},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_3154":2185,"_27801":2167,"_19254":51965,"_5":13218,"_26298":51915,"_2652":51966},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_3154":2186,"_27801":2167,"_19254":51968,"_5":13218,"_26298":51915,"_2652":51969},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_3154":2187,"_27801":2167,"_19254":51971,"_5":13218,"_26298":51915,"_2652":51972},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_3154":2188,"_27801":2167,"_19254":51974,"_5":13218,"_26298":51919,"_2652":51975},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_3154":2189,"_27801":2167,"_19254":51977,"_5":13218,"_26298":51919,"_2652":51978},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_3154":2190,"_27801":2167,"_19254":51980,"_5":13218,"_26298":51923,"_2652":51981},[],"The service accepts:",{"_3154":2191,"_27801":2167,"_19254":51983,"_5":13218,"_26298":51923,"_2652":48238},[],{"_3154":2192,"_27801":2167,"_19254":51985,"_5":13218,"_26298":51923,"_2652":51986},[],"VA service path",{"_3154":2193,"_27801":2167,"_19254":51988,"_5":13218,"_26298":51923,"_2652":51989},[],"Format",{"_3154":2194,"_27801":2167,"_19254":51991,"_5":13218,"_26298":51923,"_2652":51992},[],"`POST`",{"_3154":2195,"_27801":2167,"_19254":51994,"_5":13218,"_26298":51923,"_2652":51995},[],"`/ocsp`",{"_3154":2196,"_27801":2167,"_19254":51997,"_5":13218,"_26298":51923,"_2652":51998},[],"DER request, `Content-Type: application/ocsp-request`.",{"_3154":2197,"_27801":2167,"_19254":52000,"_5":13218,"_26298":51923,"_2652":51481},[],{"_3154":2198,"_27801":2167,"_19254":52002,"_5":13218,"_26298":51923,"_2652":52003},[],"`/ocsp/{ocsp_request}`",{"_3154":2199,"_27801":2167,"_19254":52005,"_5":13218,"_26298":51923,"_2652":52006},[],"DER request encoded using padded URL Base64.",{"_3154":2200,"_27801":2167,"_19254":52008,"_5":13218,"_26298":51923,"_2652":52009},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_3154":2201,"_27801":2167,"_19254":52011,"_5":13218,"_26298":51927,"_2652":52012},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_3154":2202,"_27801":2167,"_19254":52014,"_5":13218,"_26298":51927,"_2652":52015},[],"Generate the request:",{"_3154":2203,"_27801":2167,"_19254":52017,"_5":13218,"_26298":51927,"_2652":52018},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_3154":2204,"_27801":2167,"_19254":52020,"_5":13218,"_26298":51927,"_2652":52021},[],"Replace the example URL with the inspected endpoint:",{"_3154":2205,"_27801":2167,"_19254":52023,"_5":13218,"_26298":51927,"_2652":52024},[],"Verify the returned DER:",{"_3154":2206,"_27801":2167,"_19254":52026,"_5":13218,"_26298":51927,"_2652":52027},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_3154":2207,"_27801":2167,"_19254":52029,"_5":13218,"_26298":51931,"_2652":52030},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_3154":2208,"_27801":2167,"_19254":52032,"_5":13218,"_26298":51931,"_2652":52033},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_3154":2209,"_27801":2167,"_19254":52035,"_5":13218,"_26298":51935,"_2652":52036},[],"RFC 6960: OCSP.",{"_3154":2210,"_27801":2167,"_19254":52038,"_5":13218,"_26298":51935,"_2652":52039},[],"OpenSSL: openssl-ocsp.",{"_3154":2211,"_27801":2167,"_19254":52041,"_5":13218,"_26298":51935,"_2652":52042},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_3154":2212,"_27801":2167,"_19254":52044,"_5":13218,"_26298":51935,"_2652":51519},[],{"_3154":2213,"_27801":2213,"_5":13544,"_2652":50207,"_28144":52046,"_19254":52047,"_26298":2213},[45131,46511,50207],[],{"_3154":2214,"_27801":2213,"_19254":52049,"_5":13218,"_26298":2213,"_2652":52050},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_3154":2215,"_27801":2213,"_5":28141,"_19254":52052,"_26298":52053,"_2652":49517},[],"/docs/pr-preview/pr-53/platform/pki/overview#start-here",{"_3154":2216,"_27801":2213,"_5":28141,"_19254":52055,"_26298":52056,"_2652":52057},[],"/docs/pr-preview/pr-53/platform/pki/overview#what-you-need","What you need",{"_3154":2217,"_27801":2213,"_5":28141,"_19254":52059,"_26298":52060,"_2652":50051},[],"/docs/pr-preview/pr-53/platform/pki/overview#core-capabilities",{"_3154":2218,"_27801":2213,"_5":28141,"_19254":52062,"_26298":52063,"_2652":50055},[],"/docs/pr-preview/pr-53/platform/pki/overview#build-your-trust-hierarchy",{"_3154":2219,"_27801":2213,"_5":28141,"_19254":52065,"_26298":52066,"_2652":50059},[],"/docs/pr-preview/pr-53/platform/pki/overview#protect-cryptographic-keys",{"_3154":2220,"_27801":2213,"_5":28141,"_19254":52068,"_26298":52069,"_2652":50063},[],"/docs/pr-preview/pr-53/platform/pki/overview#issue-and-control-certificates",{"_3154":2221,"_27801":2213,"_5":28141,"_19254":52071,"_26298":52072,"_2652":50071},[],"/docs/pr-preview/pr-53/platform/pki/overview#publish-validation-status",{"_3154":2222,"_27801":2213,"_5":28141,"_19254":52074,"_26298":52075,"_2652":52076},[],"/docs/pr-preview/pr-53/platform/pki/overview#how-to-check-the-result","How to check the result",{"_3154":2223,"_27801":2213,"_5":28141,"_19254":52078,"_26298":52079,"_2652":50991},[],"/docs/pr-preview/pr-53/platform/pki/overview#continue",{"_3154":2224,"_27801":2213,"_19254":52081,"_5":13218,"_26298":2213,"_2652":52082},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_3154":2225,"_27801":2213,"_19254":52084,"_5":13218,"_26298":52053,"_2652":52085},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_3154":2226,"_27801":2213,"_19254":52087,"_5":13218,"_26298":52053,"_2652":52088},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_3154":2227,"_27801":2213,"_19254":52090,"_5":13218,"_26298":52056,"_2652":52091},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_3154":2228,"_27801":2213,"_19254":52093,"_5":13218,"_26298":52056,"_2652":52094},[],"An available cryptographic engine to keep the authority's key.",{"_3154":2229,"_27801":2213,"_19254":52096,"_5":13218,"_26298":52056,"_2652":52097},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_3154":2230,"_27801":2213,"_19254":52099,"_5":13218,"_26298":52056,"_2652":52100},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_3154":2231,"_27801":2213,"_19254":52102,"_5":13218,"_26298":52056,"_2652":52103},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_3154":2232,"_27801":2213,"_19254":52105,"_5":13218,"_26298":52063,"_2652":52106},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_3154":2233,"_27801":2213,"_19254":52108,"_5":13218,"_26298":52066,"_2652":52109},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_3154":2234,"_27801":2213,"_19254":52111,"_5":13218,"_26298":52069,"_2652":52112},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_3154":2235,"_27801":2213,"_19254":52114,"_5":13218,"_26298":52072,"_2652":52115},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_3154":2236,"_27801":2213,"_19254":52117,"_5":13218,"_26298":52075,"_2652":52118},[],"An active certificate in the console is one part of the check. Also verify that:",{"_3154":2237,"_27801":2213,"_19254":52120,"_5":13218,"_26298":52075,"_2652":52121},[],"its subject and extensions identify the expected client;",{"_3154":2238,"_27801":2213,"_19254":52123,"_5":13218,"_26298":52075,"_2652":52124},[],"its public key matches the client's private key;",{"_3154":2239,"_27801":2213,"_19254":52126,"_5":13218,"_26298":52075,"_2652":52127},[],"its chain reaches a root trusted by the consumer;",{"_3154":2240,"_27801":2213,"_19254":52129,"_5":13218,"_26298":52075,"_2652":52130},[],"its dates and usages allow the operation;",{"_3154":2241,"_27801":2213,"_19254":52132,"_5":13218,"_26298":52075,"_2652":52133},[],"the consumer applies revocation checks and authorization.",{"_3154":2242,"_27801":2213,"_19254":52135,"_5":13218,"_26298":52075,"_2652":52136},[],"The issuance path includes the first independent checks.",{"_3154":2243,"_27801":2213,"_19254":52138,"_5":13218,"_26298":52079,"_2652":52139},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3154":2244,"_27801":2213,"_19254":52141,"_5":13218,"_26298":52079,"_2652":52142},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3154":2245,"_27801":2213,"_19254":52144,"_5":13218,"_26298":52079,"_2652":52145},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3154":2246,"_27801":2246,"_5":13544,"_2652":52147,"_28144":52148,"_19254":52149,"_26298":2246},"Create your first CA",[45131,46511,50207,49642],[],{"_3154":2247,"_27801":2246,"_19254":52151,"_5":13218,"_26298":2246,"_2652":52152},[],"Create an evaluation root and check its certificate before issuing.",{"_3154":2248,"_27801":2246,"_5":28141,"_19254":52154,"_26298":52155,"_2652":45141},[],"/docs/pr-preview/pr-53/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_3154":2249,"_27801":2246,"_5":28141,"_19254":52157,"_26298":52158,"_2652":52159},[],"/docs/pr-preview/pr-53/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard","Open the creation wizard",{"_3154":2250,"_27801":2246,"_5":28141,"_19254":52161,"_26298":52162,"_2652":52163},[],"/docs/pr-preview/pr-53/platform/pki/quickstarts/create-certificate-authority#select-the-key","Select the key",{"_3154":2251,"_27801":2246,"_5":28141,"_19254":52165,"_26298":52166,"_2652":52167},[],"/docs/pr-preview/pr-53/platform/pki/quickstarts/create-certificate-authority#define-the-authority","Define the authority",{"_3154":2252,"_27801":2246,"_5":28141,"_19254":52169,"_26298":52170,"_2652":52171},[],"/docs/pr-preview/pr-53/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca","Review and create the CA",{"_3154":2253,"_27801":2246,"_5":28141,"_19254":52173,"_26298":52174,"_2652":52175},[],"/docs/pr-preview/pr-53/platform/pki/quickstarts/create-certificate-authority#verify-the-result","Verify the result",{"_3154":2254,"_27801":2246,"_5":28141,"_19254":52177,"_26298":52178,"_2652":52179},[],"/docs/pr-preview/pr-53/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_3154":2255,"_27801":2246,"_5":28141,"_19254":52181,"_26298":52182,"_2652":49900},[],"/docs/pr-preview/pr-53/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_3154":2256,"_27801":2246,"_5":28141,"_19254":52184,"_26298":52185,"_2652":45165},[],"/docs/pr-preview/pr-53/platform/pki/quickstarts/create-certificate-authority#next-step",{"_3154":2257,"_27801":2246,"_19254":52187,"_5":13218,"_26298":2246,"_2652":52188},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_3154":2258,"_27801":2246,"_19254":52190,"_5":13218,"_26298":52155,"_2652":52191},[],"Console access and permission to create keys and authorities.",{"_3154":2259,"_27801":2246,"_19254":52193,"_5":13218,"_26298":52155,"_2652":52194},[],"An available cryptographic engine that supports the chosen algorithm.",{"_3154":2260,"_27801":2246,"_19254":52196,"_5":13218,"_26298":52155,"_2652":52197},[],"OpenSSL 3.x to check the downloaded certificate.",{"_3154":2261,"_27801":2246,"_19254":52199,"_5":13218,"_26298":52155,"_2652":52200},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_3154":2262,"_27801":2246,"_19254":52202,"_5":13218,"_26298":52158,"_2652":52203},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_3154":2263,"_27801":2246,"_19254":52205,"_5":13218,"_26298":52158,"_2652":52206},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_3154":2264,"_27801":2246,"_19254":52208,"_5":13218,"_26298":52162,"_2652":52209},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_3154":2265,"_27801":2246,"_19254":52211,"_5":13218,"_26298":52162,"_2652":52212},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_3154":2266,"_27801":2246,"_19254":52214,"_5":13218,"_26298":52166,"_2652":52215},[],"Select **Root CA** and complete:",{"_3154":2267,"_27801":2246,"_19254":52217,"_5":13218,"_26298":52166,"_2652":52218},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_3154":2268,"_27801":2246,"_19254":52220,"_5":13218,"_26298":52166,"_2652":52221},[],"**Subject**: organization and country details for your evaluation.",{"_3154":2269,"_27801":2246,"_19254":52223,"_5":13218,"_26298":52166,"_2652":52224},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_3154":2270,"_27801":2246,"_19254":52226,"_5":13218,"_26298":52166,"_2652":52227},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_3154":2271,"_27801":2246,"_19254":52229,"_5":13218,"_26298":52166,"_2652":52230},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_3154":2272,"_27801":2246,"_19254":52232,"_5":13218,"_26298":52170,"_2652":52233},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_3154":2273,"_27801":2246,"_19254":52235,"_5":13218,"_26298":52174,"_2652":52236},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_3154":2274,"_27801":2246,"_19254":52238,"_5":13218,"_26298":52174,"_2652":52239},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_3154":2275,"_27801":2246,"_19254":52241,"_5":13218,"_26298":52178,"_2652":52242},[],"Run from the directory where you saved `ca.pem`:",{"_3154":2276,"_27801":2246,"_19254":52244,"_5":13218,"_26298":52178,"_2652":52245},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_3154":2277,"_27801":2246,"_19254":52247,"_5":13218,"_26298":52178,"_2652":52248},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_3154":2278,"_27801":2246,"_19254":52250,"_5":13218,"_26298":52182,"_2652":52251},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_3154":2279,"_27801":2246,"_19254":52253,"_5":13218,"_26298":52182,"_2652":52254},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_3154":2280,"_27801":2246,"_19254":52256,"_5":13218,"_26298":52182,"_2652":52257},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_3154":2281,"_27801":2246,"_19254":52259,"_5":13218,"_26298":52182,"_2652":52260},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_3154":2282,"_27801":2246,"_19254":52262,"_5":13218,"_26298":52185,"_2652":52263},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_3154":2283,"_27801":2283,"_5":13544,"_2652":52265,"_28144":52266,"_19254":52267,"_26298":2283},"Issue and verify a certificate",[45131,46511,50207,49642],[],{"_3154":2284,"_27801":2283,"_19254":52269,"_5":13218,"_26298":2283,"_2652":52270},[],"Issue a client certificate and check content, chain and key correspondence.",{"_3154":2285,"_27801":2283,"_5":28141,"_19254":52272,"_26298":52273,"_2652":45141},[],"/docs/pr-preview/pr-53/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_3154":2286,"_27801":2283,"_5":28141,"_19254":52275,"_26298":52276,"_2652":52277},[],"/docs/pr-preview/pr-53/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_3154":2287,"_27801":2283,"_5":28141,"_19254":52279,"_26298":52280,"_2652":52281},[],"/docs/pr-preview/pr-53/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_3154":2288,"_27801":2283,"_5":28141,"_19254":52283,"_26298":52284,"_2652":52285},[],"/docs/pr-preview/pr-53/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_3154":2289,"_27801":2283,"_5":28141,"_19254":52287,"_26298":52288,"_2652":52289},[],"/docs/pr-preview/pr-53/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_3154":2290,"_27801":2283,"_5":28141,"_19254":52291,"_26298":52292,"_2652":52293},[],"/docs/pr-preview/pr-53/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_3154":2291,"_27801":2283,"_5":28141,"_19254":52295,"_26298":52296,"_2652":52175},[],"/docs/pr-preview/pr-53/platform/pki/quickstarts/issue-certificate#verify-the-result",{"_3154":2292,"_27801":2283,"_5":28141,"_19254":52298,"_26298":52299,"_2652":52300},[],"/docs/pr-preview/pr-53/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_3154":2293,"_27801":2283,"_5":28141,"_19254":52302,"_26298":52303,"_2652":52304},[],"/docs/pr-preview/pr-53/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_3154":2294,"_27801":2283,"_5":28141,"_19254":52306,"_26298":52307,"_2652":52308},[],"/docs/pr-preview/pr-53/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_3154":2295,"_27801":2283,"_5":28141,"_19254":52310,"_26298":52311,"_2652":49900},[],"/docs/pr-preview/pr-53/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_3154":2296,"_27801":2283,"_5":28141,"_19254":52313,"_26298":52314,"_2652":45165},[],"/docs/pr-preview/pr-53/platform/pki/quickstarts/issue-certificate#next-step",{"_3154":2297,"_27801":2283,"_19254":52316,"_5":13218,"_26298":2283,"_2652":52317},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_3154":2298,"_27801":2283,"_19254":52319,"_5":13218,"_26298":52273,"_2652":52320},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_3154":2299,"_27801":2283,"_19254":52322,"_5":13218,"_26298":52273,"_2652":52323},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_3154":2300,"_27801":2283,"_19254":52325,"_5":13218,"_26298":52273,"_2652":52326},[],"OpenSSL 3.x and a working directory with restricted access.",{"_3154":2301,"_27801":2283,"_19254":52328,"_5":13218,"_26298":52273,"_2652":52329},[],"A client identifier: here we use `device-001`.",{"_3154":2302,"_27801":2283,"_19254":52331,"_5":13218,"_26298":52273,"_2652":52332},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_3154":2303,"_27801":2283,"_19254":52334,"_5":13218,"_26298":52276,"_2652":52335},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_3154":2304,"_27801":2283,"_19254":52337,"_5":13218,"_26298":52280,"_2652":52338},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_3154":2305,"_27801":2283,"_19254":52340,"_5":13218,"_26298":52280,"_2652":52341},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_3154":2306,"_27801":2283,"_19254":52343,"_5":13218,"_26298":52284,"_2652":52344},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_3154":2307,"_27801":2283,"_19254":52346,"_5":13218,"_26298":52284,"_2652":52347},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_3154":2308,"_27801":2283,"_19254":52349,"_5":13218,"_26298":52288,"_2652":52350},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_3154":2309,"_27801":2283,"_19254":52352,"_5":13218,"_26298":52288,"_2652":52353},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_3154":2310,"_27801":2283,"_19254":52355,"_5":13218,"_26298":52292,"_2652":52356},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_3154":2311,"_27801":2283,"_19254":52358,"_5":13218,"_26298":52296,"_2652":52359},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_3154":2312,"_27801":2283,"_19254":52361,"_5":13218,"_26298":52299,"_2652":52362},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_3154":2313,"_27801":2283,"_19254":52364,"_5":13218,"_26298":52303,"_2652":52365},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_3154":2314,"_27801":2283,"_19254":52367,"_5":13218,"_26298":52303,"_2652":52368},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_3154":2315,"_27801":2283,"_19254":52370,"_5":13218,"_26298":52303,"_2652":52371},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_3154":2316,"_27801":2283,"_19254":52373,"_5":13218,"_26298":52307,"_2652":52374},[],"In Bash, compare the two public-key digests:",{"_3154":2317,"_27801":2283,"_19254":52376,"_5":13218,"_26298":52307,"_2652":52377},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_3154":2318,"_27801":2283,"_19254":52379,"_5":13218,"_26298":52307,"_2652":52380},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_3154":2319,"_27801":2283,"_19254":52382,"_5":13218,"_26298":52311,"_2652":49984},[],{"_3154":2320,"_27801":2283,"_19254":52384,"_5":13218,"_26298":52311,"_2652":52385},[],"What to review",{"_3154":2321,"_27801":2283,"_19254":52387,"_5":13218,"_26298":52311,"_2652":52388},[],"The CA rejects issuance",{"_3154":2322,"_27801":2283,"_19254":52390,"_5":13218,"_26298":52311,"_2652":52391},[],"Permissions, CA state and key, algorithm and profile.",{"_3154":2323,"_27801":2283,"_19254":52393,"_5":13218,"_26298":52311,"_2652":52394},[],"Different subject or usages",{"_3154":2324,"_27801":2283,"_19254":52396,"_5":13218,"_26298":52311,"_2652":52397},[],"Applied profile and requested values.",{"_3154":2325,"_27801":2283,"_19254":52399,"_5":13218,"_26298":52311,"_2652":52400},[],"Issuer cannot be found",{"_3154":2326,"_27801":2283,"_19254":52402,"_5":13218,"_26298":52311,"_2652":52403},[],"Downloaded CA and required intermediate chain.",{"_3154":2327,"_27801":2283,"_19254":52405,"_5":13218,"_26298":52311,"_2652":52406},[],"Validity fails",{"_3154":2328,"_27801":2283,"_19254":52408,"_5":13218,"_26298":52311,"_2652":52409},[],"Certificate and CA dates, and the computer's clock.",{"_3154":2329,"_27801":2283,"_19254":52411,"_5":13218,"_26298":52311,"_2652":52412},[],"Public-key digests differ",{"_3154":2330,"_27801":2283,"_19254":52414,"_5":13218,"_26298":52311,"_2652":52415},[],"Certificate and key files from the same issuance.",{"_3154":2331,"_27801":2283,"_19254":52417,"_5":13218,"_26298":52311,"_2652":52418},[],"See PKI diagnostics to narrow an issuance failure.",{"_3154":2332,"_27801":2283,"_19254":52420,"_5":13218,"_26298":52314,"_2652":52421},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_3154":2333,"_27801":2283,"_19254":52423,"_5":13218,"_26298":52314,"_2652":52424},[],"Manage certificates for inspection, status and revocation.",{"_3154":2334,"_27801":2283,"_19254":52426,"_5":13218,"_26298":52314,"_2652":52427},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_3154":2335,"_27801":2283,"_19254":52429,"_5":13218,"_26298":52314,"_2652":52430},[],"Prepare EST for the device to request its next identities.",{"_3154":2336,"_27801":2283,"_19254":52432,"_5":13218,"_26298":52314,"_2652":52433},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_3154":2337,"_27801":2337,"_5":13544,"_2652":52435,"_28144":52436,"_19254":52437,"_26298":2337},"PKI getting started",[45131,46511,50207,49642],[],{"_3154":2338,"_27801":2337,"_19254":52439,"_5":13218,"_26298":2337,"_2652":52440},[],"Create a CA, issue a client certificate and check its chain and key.",{"_3154":2339,"_27801":2337,"_5":28141,"_19254":52442,"_26298":52443,"_2652":45141},[],"/docs/pr-preview/pr-53/platform/pki/quickstarts/overview#before-you-begin",{"_3154":2340,"_27801":2337,"_5":28141,"_19254":52445,"_26298":52446,"_2652":52447},[],"/docs/pr-preview/pr-53/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_3154":2341,"_27801":2337,"_5":28141,"_19254":52449,"_26298":52450,"_2652":49834},[],"/docs/pr-preview/pr-53/platform/pki/quickstarts/overview#expected-result",{"_3154":2342,"_27801":2337,"_5":28141,"_19254":52452,"_26298":52453,"_2652":52454},[],"/docs/pr-preview/pr-53/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_3154":2343,"_27801":2337,"_19254":52456,"_5":13218,"_26298":2337,"_2652":52457},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_3154":2344,"_27801":2337,"_19254":52459,"_5":13218,"_26298":52443,"_2652":52460},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_3154":2345,"_27801":2337,"_19254":52462,"_5":13218,"_26298":52443,"_2652":52463},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_3154":2346,"_27801":2337,"_19254":52465,"_5":13218,"_26298":52443,"_2652":52466},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_3154":2347,"_27801":2337,"_19254":52468,"_5":13218,"_26298":52443,"_2652":52469},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_3154":2348,"_27801":2337,"_19254":52471,"_5":13218,"_26298":52443,"_2652":52472},[],"A working directory with restricted access for the downloaded key.",{"_3154":2349,"_27801":2337,"_19254":52474,"_5":13218,"_26298":52446,"_2652":52475},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3154":2350,"_27801":2337,"_19254":52477,"_5":13218,"_26298":52446,"_2652":52478},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3154":2351,"_27801":2337,"_19254":52480,"_5":13218,"_26298":52446,"_2652":52481},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_3154":2352,"_27801":2337,"_19254":52483,"_5":13218,"_26298":52446,"_2652":52484},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_3154":2353,"_27801":2337,"_19254":52486,"_5":13218,"_26298":52450,"_2652":52487},[],"File or resource",{"_3154":2354,"_27801":2337,"_19254":52489,"_5":13218,"_26298":52450,"_2652":49831},[],{"_3154":2355,"_27801":2337,"_19254":52491,"_5":13218,"_26298":52450,"_2652":52492},[],"Active root CA and `ca.pem`",{"_3154":2356,"_27801":2337,"_19254":52494,"_5":13218,"_26298":52450,"_2652":52495},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_3154":2357,"_27801":2337,"_19254":52497,"_5":13218,"_26298":52450,"_2652":52498},[],"End-entity certificate and `device.crt`",{"_3154":2358,"_27801":2337,"_19254":52500,"_5":13218,"_26298":52450,"_2652":52501},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_3154":2359,"_27801":2337,"_19254":52503,"_5":13218,"_26298":52450,"_2652":52504},[],"Private key `device.key`",{"_3154":2360,"_27801":2337,"_19254":52506,"_5":13218,"_26298":52450,"_2652":52507},[],"Its public key matches the one included in `device.crt`.",{"_3154":2361,"_27801":2337,"_19254":52509,"_5":13218,"_26298":52450,"_2652":52510},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_3154":2362,"_27801":2337,"_19254":52512,"_5":13218,"_26298":52453,"_2652":52513},[],"To operate certificates, continue with Certificates and Validation.",{"_3154":2363,"_27801":2337,"_19254":52515,"_5":13218,"_26298":52453,"_2652":52516},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_3154":2364,"_27801":2337,"_19254":52518,"_5":13218,"_26298":52453,"_2652":52519},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_3154":2365,"_27801":2365,"_5":13544,"_2652":52521,"_28144":52522,"_19254":52523,"_26298":2365},"PKI troubleshooting",[45131,46511,50207,49028],[],{"_3154":2366,"_27801":2365,"_19254":52525,"_5":13218,"_26298":2365,"_2652":52526},[],"Diagnose certificate issuance, OCSP and CRL.",{"_3154":2367,"_27801":2365,"_5":28141,"_19254":52528,"_26298":52529,"_2652":52530},[],"/docs/pr-preview/pr-53/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_3154":2368,"_27801":2365,"_5":28141,"_19254":52532,"_26298":52533,"_2652":52534},[],"/docs/pr-preview/pr-53/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_3154":2369,"_27801":2365,"_5":28141,"_19254":52536,"_26298":52537,"_2652":52538},[],"/docs/pr-preview/pr-53/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_3154":2370,"_27801":2365,"_19254":52540,"_5":13218,"_26298":2365,"_2652":52541},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_3154":2371,"_27801":2365,"_19254":52543,"_5":13218,"_26298":2365,"_2652":52544},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_3154":2372,"_27801":2365,"_19254":52546,"_5":13218,"_26298":52529,"_2652":49831},[],{"_3154":2373,"_27801":2365,"_19254":52548,"_5":13218,"_26298":52529,"_2652":52549},[],"What to inspect",{"_3154":2374,"_27801":2365,"_19254":52551,"_5":13218,"_26298":52529,"_2652":45165},[],{"_3154":2375,"_27801":2365,"_19254":52553,"_5":13218,"_26298":52529,"_2652":52554},[],"CA",{"_3154":2376,"_27801":2365,"_19254":52556,"_5":13218,"_26298":52529,"_2652":52557},[],"Exists, is active and has usable dates.",{"_3154":2377,"_27801":2365,"_19254":52559,"_5":13218,"_26298":52529,"_2652":52560},[],"Authorities.",{"_3154":2378,"_27801":2365,"_19254":52562,"_5":13218,"_26298":52529,"_2652":52563},[],"Key",{"_3154":2379,"_27801":2365,"_19254":52565,"_5":13218,"_26298":52529,"_2652":52566},[],"The record has a usable private key and the engine can sign.",{"_3154":2380,"_27801":2365,"_19254":52568,"_5":13218,"_26298":52529,"_2652":52569},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_3154":2381,"_27801":2365,"_19254":52571,"_5":13218,"_26298":52529,"_2652":52572},[],"CSR",{"_3154":2382,"_27801":2365,"_19254":52574,"_5":13218,"_26298":52529,"_2652":52575},[],"Correct PEM and verifiable signature.",{"_3154":2383,"_27801":2365,"_19254":52577,"_5":13218,"_26298":52529,"_2652":52578},[],"`openssl req -in request.csr -noout -verify -text`.",{"_3154":2384,"_27801":2365,"_19254":52580,"_5":13218,"_26298":52529,"_2652":52581},[],"Profile",{"_3154":2385,"_27801":2365,"_19254":52583,"_5":13218,"_26298":52529,"_2652":52584},[],"Selected source, existing ID, allowed algorithm and size.",{"_3154":2386,"_27801":2365,"_19254":52586,"_5":13218,"_26298":52529,"_2652":52587},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_3154":2387,"_27801":2365,"_19254":52589,"_5":13218,"_26298":52529,"_2652":49984},[],{"_3154":2388,"_27801":2365,"_19254":52591,"_5":13218,"_26298":52529,"_2652":52592},[],"Appropriate subject, SAN, usages and dates.",{"_3154":2389,"_27801":2365,"_19254":52594,"_5":13218,"_26298":52529,"_2652":52595},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_3154":2390,"_27801":2365,"_19254":52597,"_5":13218,"_26298":52529,"_2652":52598},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_3154":2391,"_27801":2365,"_19254":52600,"_5":13218,"_26298":52529,"_2652":52601},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation.",{"_3154":2392,"_27801":2365,"_19254":52603,"_5":13218,"_26298":52533,"_2652":52604},[],"Check each boundary independently:",{"_3154":2393,"_27801":2365,"_19254":52606,"_5":13218,"_26298":52533,"_2652":52607},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_3154":2394,"_27801":2365,"_19254":52609,"_5":13218,"_26298":52533,"_2652":52610},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_3154":2395,"_27801":2365,"_19254":52612,"_5":13218,"_26298":52533,"_2652":52613},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_3154":2396,"_27801":2365,"_19254":52615,"_5":13218,"_26298":52533,"_2652":52616},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_3154":2397,"_27801":2365,"_19254":52618,"_5":13218,"_26298":52533,"_2652":52619},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_3154":2398,"_27801":2365,"_19254":52621,"_5":13218,"_26298":52533,"_2652":52622},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_3154":2399,"_27801":2365,"_19254":52624,"_5":13218,"_26298":52537,"_2652":52625},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_3154":2400,"_27801":2365,"_19254":52627,"_5":13218,"_26298":52537,"_2652":52628},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_3154":2401,"_27801":2401,"_5":13544,"_2652":52630,"_28144":52631,"_19254":52633,"_26298":2401},"3.8.0 to 4.0.0",[45131,52632],"Upgrades",[],{"_3154":2402,"_27801":2401,"_19254":52635,"_5":13218,"_26298":2401,"_2652":52636},[],"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result.",{"_3154":2403,"_27801":2401,"_5":28141,"_19254":52638,"_26298":52639,"_2652":52640},[],"/docs/pr-preview/pr-53/upgrades/3-8-0-to-4-0-0#architecture-changes","Architecture changes",{"_3154":2404,"_27801":2401,"_5":28141,"_19254":52642,"_26298":52643,"_2652":52644},[],"/docs/pr-preview/pr-53/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_3154":2405,"_27801":2401,"_5":28141,"_19254":52646,"_26298":52647,"_2652":52648},[],"/docs/pr-preview/pr-53/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_3154":2406,"_27801":2401,"_5":28141,"_19254":52650,"_26298":52651,"_2652":52652},[],"/docs/pr-preview/pr-53/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_3154":2407,"_27801":2401,"_5":28141,"_19254":52654,"_26298":52655,"_2652":52656},[],"/docs/pr-preview/pr-53/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_3154":2408,"_27801":2401,"_5":28141,"_19254":52658,"_26298":52659,"_2652":52660},[],"/docs/pr-preview/pr-53/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_3154":2409,"_27801":2401,"_5":28141,"_19254":52662,"_26298":52663,"_2652":52664},[],"/docs/pr-preview/pr-53/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_3154":2410,"_27801":2401,"_5":28141,"_19254":52666,"_26298":52667,"_2652":52668},[],"/docs/pr-preview/pr-53/upgrades/3-8-0-to-4-0-0#helm-chart-and-values","Helm chart and values",{"_3154":2411,"_27801":2401,"_5":28141,"_19254":52670,"_26298":52671,"_2652":52672},[],"/docs/pr-preview/pr-53/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_3154":2412,"_27801":2401,"_5":28141,"_19254":52674,"_26298":52675,"_2652":52676},[],"/docs/pr-preview/pr-53/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_3154":2413,"_27801":2401,"_5":28141,"_19254":52678,"_26298":52679,"_2652":52680},[],"/docs/pr-preview/pr-53/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_3154":2414,"_27801":2401,"_5":28141,"_19254":52682,"_26298":52683,"_2652":52684},[],"/docs/pr-preview/pr-53/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_3154":2415,"_27801":2401,"_5":28141,"_19254":52686,"_26298":52687,"_2652":52688},[],"/docs/pr-preview/pr-53/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_3154":2416,"_27801":2401,"_5":28141,"_19254":52690,"_26298":52691,"_2652":52692},[],"/docs/pr-preview/pr-53/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_3154":2417,"_27801":2401,"_5":28141,"_19254":52694,"_26298":52695,"_2652":52696},[],"/docs/pr-preview/pr-53/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_3154":2418,"_27801":2401,"_5":28141,"_19254":52698,"_26298":52699,"_2652":52700},[],"/docs/pr-preview/pr-53/upgrades/3-8-0-to-4-0-0#data-and-storage","Data and storage",{"_3154":2419,"_27801":2401,"_5":28141,"_19254":52702,"_26298":52703,"_2652":52704},[],"/docs/pr-preview/pr-53/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_3154":2420,"_27801":2401,"_5":28141,"_19254":52706,"_26298":52707,"_2652":52708},[],"/docs/pr-preview/pr-53/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","SQLite storage removed",{"_3154":2421,"_27801":2401,"_5":28141,"_19254":52710,"_26298":52711,"_2652":52712},[],"/docs/pr-preview/pr-53/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_3154":2422,"_27801":2401,"_5":28141,"_19254":52714,"_26298":52715,"_2652":52716},[],"/docs/pr-preview/pr-53/upgrades/3-8-0-to-4-0-0#apis-and-stored-configuration","APIs and stored configuration",{"_3154":2423,"_27801":2401,"_5":28141,"_19254":52718,"_26298":52719,"_2652":52720},[],"/docs/pr-preview/pr-53/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_3154":2424,"_27801":2401,"_5":28141,"_19254":52722,"_26298":52723,"_2652":52724},[],"/docs/pr-preview/pr-53/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_3154":2425,"_27801":2401,"_5":28141,"_19254":52726,"_26298":52727,"_2652":52728},[],"/docs/pr-preview/pr-53/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_3154":2426,"_27801":2401,"_5":28141,"_19254":52730,"_26298":52731,"_2652":52732},[],"/docs/pr-preview/pr-53/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_3154":2427,"_27801":2401,"_5":28141,"_19254":52734,"_26298":52735,"_2652":52736},[],"/docs/pr-preview/pr-53/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_3154":2428,"_27801":2401,"_5":28141,"_19254":52738,"_26298":52739,"_2652":52740},[],"/docs/pr-preview/pr-53/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_3154":2429,"_27801":2401,"_5":28141,"_19254":52742,"_26298":52743,"_2652":52744},[],"/docs/pr-preview/pr-53/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_3154":2430,"_27801":2401,"_5":28141,"_19254":52746,"_26298":52747,"_2652":52748},[],"/docs/pr-preview/pr-53/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_3154":2431,"_27801":2401,"_5":28141,"_19254":52750,"_26298":52751,"_2652":52752},[],"/docs/pr-preview/pr-53/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_3154":2432,"_27801":2401,"_5":28141,"_19254":52754,"_26298":52755,"_2652":52756},[],"/docs/pr-preview/pr-53/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_3154":2433,"_27801":2401,"_5":28141,"_19254":52758,"_26298":52759,"_2652":52760},[],"/docs/pr-preview/pr-53/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_3154":2434,"_27801":2401,"_5":28141,"_19254":52762,"_26298":52763,"_2652":52764},[],"/docs/pr-preview/pr-53/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_3154":2435,"_27801":2401,"_5":28141,"_19254":52766,"_26298":52767,"_2652":52768},[],"/docs/pr-preview/pr-53/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_3154":2436,"_27801":2401,"_5":28141,"_19254":52770,"_26298":52771,"_2652":49028},[],"/docs/pr-preview/pr-53/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_3154":2437,"_27801":2401,"_5":28141,"_19254":52773,"_26298":52774,"_2652":52775},[],"/docs/pr-preview/pr-53/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_3154":2438,"_27801":2401,"_5":28141,"_19254":52777,"_26298":52778,"_2652":52779},[],"/docs/pr-preview/pr-53/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_3154":2439,"_27801":2401,"_19254":52781,"_5":13218,"_26298":2401,"_2652":52782},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_3154":2440,"_27801":2401,"_19254":52784,"_5":13218,"_26298":2401,"_2652":52785},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_3154":2441,"_27801":2401,"_19254":52787,"_5":13218,"_26298":2401,"_2652":52788},[],"Architecture changes: what is different in 4.0.0 and what the upgrade migrates on its own.",{"_3154":2442,"_27801":2401,"_19254":52790,"_5":13218,"_26298":2401,"_2652":52791},[],"Breaking changes: every change that can break a 3.8.0 deployment, who it affects and what to do.",{"_3154":2443,"_27801":2401,"_19254":52793,"_5":13218,"_26298":2401,"_2652":52794},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_3154":2444,"_27801":2401,"_19254":52796,"_5":13218,"_26298":2401,"_2652":52797},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_3154":2445,"_27801":2401,"_19254":52799,"_5":13218,"_26298":2401,"_2652":52800},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_3154":2446,"_27801":2401,"_19254":52802,"_5":13218,"_26298":52643,"_2652":52803},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_3154":2447,"_27801":2401,"_19254":52805,"_5":13218,"_26298":52643,"_2652":52806},[],"PostgreSQL is now the only storage engine. SQLite support is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0.",{"_3154":2448,"_27801":2401,"_19254":52808,"_5":13218,"_26298":52647,"_2652":52809},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_3154":2449,"_27801":2401,"_19254":52811,"_5":13218,"_26298":52647,"_2652":52812},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and VA roles. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_3154":2450,"_27801":2401,"_19254":52814,"_5":13218,"_26298":52651,"_2652":52815},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. The events endpoint can also stream events over Server-Sent Events (SSE); to fan events out across service instances, each Device Manager instance binds its own durable AMQP queue.",{"_3154":2451,"_27801":2401,"_19254":52817,"_5":13218,"_26298":52655,"_2652":52818},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_3154":2452,"_27801":2401,"_19254":52820,"_5":13218,"_26298":52655,"_2652":52821},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_3154":2453,"_27801":2401,"_19254":52823,"_5":13218,"_26298":52655,"_2652":52824},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_3154":2454,"_27801":2401,"_19254":52826,"_5":13218,"_26298":52655,"_2652":52827},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_3154":2455,"_27801":2401,"_19254":52829,"_5":13218,"_26298":52655,"_2652":52830},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_3154":2456,"_27801":2401,"_19254":52832,"_5":13218,"_26298":52659,"_2652":52833},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_3154":2457,"_27801":2401,"_19254":52835,"_5":13218,"_26298":52659,"_2652":52836},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_3154":2458,"_27801":2401,"_19254":52838,"_5":13218,"_26298":52659,"_2652":52839},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_3154":2459,"_27801":2401,"_19254":52841,"_5":13218,"_26298":52659,"_2652":52842},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_3154":2460,"_27801":2401,"_19254":52844,"_5":13218,"_26298":52659,"_2652":52845},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_3154":2461,"_27801":2401,"_19254":52847,"_5":13218,"_26298":52663,"_2652":52848},[],"Change",{"_3154":2462,"_27801":2401,"_19254":52850,"_5":13218,"_26298":52663,"_2652":52851},[],"Who is affected",{"_3154":2463,"_27801":2401,"_19254":52853,"_5":13218,"_26298":52663,"_2652":52854},[],"Severity",{"_3154":2464,"_27801":2401,"_19254":52856,"_5":13218,"_26298":52663,"_2652":52857},[],"Action",{"_3154":2465,"_27801":2401,"_19254":52859,"_5":13218,"_26298":52663,"_2652":52672},[],{"_3154":2466,"_27801":2401,"_19254":52861,"_5":13218,"_26298":52663,"_2652":52862},[],"Helm releases with a filesystem KMS engine or local VA CRL storage",{"_3154":2467,"_27801":2401,"_19254":52864,"_5":13218,"_26298":52663,"_2652":52865},[],"High: KMS and VA start on empty volumes",{"_3154":2468,"_27801":2401,"_19254":52867,"_5":13218,"_26298":52663,"_2652":52868},[],"Copy the data into the new volumes",{"_3154":2469,"_27801":2401,"_19254":52870,"_5":13218,"_26298":52663,"_2652":52676},[],{"_3154":2470,"_27801":2401,"_19254":52872,"_5":13218,"_26298":52663,"_2652":52873},[],"Every Helm release",{"_3154":2471,"_27801":2401,"_19254":52875,"_5":13218,"_26298":52663,"_2652":52876},[],"High: `helm upgrade` fails",{"_3154":2472,"_27801":2401,"_19254":52878,"_5":13218,"_26298":52663,"_2652":52879},[],"Remove or rename legacy keys",{"_3154":2473,"_27801":2401,"_19254":52881,"_5":13218,"_26298":52663,"_2652":52680},[],{"_3154":2474,"_27801":2401,"_19254":52883,"_5":13218,"_26298":52663,"_2652":52884},[],"Every deployment",{"_3154":2475,"_27801":2401,"_19254":52886,"_5":13218,"_26298":52663,"_2652":52887},[],"High: without a bootstrap principal there is no administrator",{"_3154":2476,"_27801":2401,"_19254":52889,"_5":13218,"_26298":52663,"_2652":52890},[],"Configure `services.authz`",{"_3154":2477,"_27801":2401,"_19254":52892,"_5":13218,"_26298":52663,"_2652":52684},[],{"_3154":2478,"_27801":2401,"_19254":52894,"_5":13218,"_26298":52663,"_2652":52873},[],{"_3154":2479,"_27801":2401,"_19254":52896,"_5":13218,"_26298":52663,"_2652":52897},[],"High: `helm upgrade` fails on the old keys",{"_3154":2480,"_27801":2401,"_19254":52899,"_5":13218,"_26298":52663,"_2652":52900},[],"Move JWKS and roles into `services.authz`",{"_3154":2481,"_27801":2401,"_19254":52902,"_5":13218,"_26298":52663,"_2652":52704},[],{"_3154":2482,"_27801":2401,"_19254":52904,"_5":13218,"_26298":52663,"_2652":52905},[],"3.8.0 deployments with per-service databases",{"_3154":2483,"_27801":2401,"_19254":52907,"_5":13218,"_26298":52663,"_2652":52908},[],"High: services find no data, or a migration aborts",{"_3154":2484,"_27801":2401,"_19254":52910,"_5":13218,"_26298":52663,"_2652":52911},[],"Clean duplicate CA IDs and empty `engine_id` values first; move data manually outside Helm",{"_3154":2485,"_27801":2401,"_19254":52913,"_5":13218,"_26298":52663,"_2652":52708},[],{"_3154":2486,"_27801":2401,"_19254":52915,"_5":13218,"_26298":52663,"_2652":52916},[],"Deployments on SQLite, `couch_db` or `dynamo_db`",{"_3154":2487,"_27801":2401,"_19254":52918,"_5":13218,"_26298":52663,"_2652":52919},[],"High: the backend no longer starts with them",{"_3154":2488,"_27801":2401,"_19254":52921,"_5":13218,"_26298":52663,"_2652":52922},[],"Move to PostgreSQL before upgrading",{"_3154":2489,"_27801":2401,"_19254":52924,"_5":13218,"_26298":52663,"_2652":52925},[],"Webhooks with file references",{"_3154":2490,"_27801":2401,"_19254":52927,"_5":13218,"_26298":52663,"_2652":52928},[],"DMSs whose webhook mTLS certificate or key were file paths",{"_3154":2491,"_27801":2401,"_19254":52930,"_5":13218,"_26298":52663,"_2652":52931},[],"High: enrollments calling the webhook fail",{"_3154":2492,"_27801":2401,"_19254":52933,"_5":13218,"_26298":52663,"_2652":52934},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_3154":2493,"_27801":2401,"_19254":52936,"_5":13218,"_26298":52663,"_2652":52688},[],{"_3154":2494,"_27801":2401,"_19254":52938,"_5":13218,"_26298":52663,"_2652":52939},[],"Releases with per-service identity overrides or mounted key material",{"_3154":2495,"_27801":2401,"_19254":52941,"_5":13218,"_26298":52663,"_2652":52942},[],"Medium: services cannot read their files",{"_3154":2496,"_27801":2401,"_19254":52944,"_5":13218,"_26298":52663,"_2652":52945},[],"Remove the overrides and fix volume ownership",{"_3154":2497,"_27801":2401,"_19254":52947,"_5":13218,"_26298":52663,"_2652":52692},[],{"_3154":2498,"_27801":2401,"_19254":52949,"_5":13218,"_26298":52663,"_2652":52950},[],"Releases that set `amqp.tls`",{"_3154":2499,"_27801":2401,"_19254":52952,"_5":13218,"_26298":52663,"_2652":52953},[],"Medium: clients connect to the wrong port",{"_3154":2500,"_27801":2401,"_19254":52955,"_5":13218,"_26298":52663,"_2652":52956},[],"Point `amqp.port` at the TLS listener, or disable TLS",{"_3154":2501,"_27801":2401,"_19254":52958,"_5":13218,"_26298":52663,"_2652":52712},[],{"_3154":2502,"_27801":2401,"_19254":52960,"_5":13218,"_26298":52663,"_2652":52961},[],"Installations whose CA keys predate the KMS",{"_3154":2503,"_27801":2401,"_19254":52963,"_5":13218,"_26298":52663,"_2652":52964},[],"Medium: CA keys stay unmanaged",{"_3154":2504,"_27801":2401,"_19254":52966,"_5":13218,"_26298":52663,"_2652":52967},[],"Run the CA-to-KMS migration",{"_3154":2505,"_27801":2401,"_19254":52969,"_5":13218,"_26298":52663,"_2652":52970},[],"Receiver certificate verification",{"_3154":2506,"_27801":2401,"_19254":52972,"_5":13218,"_26298":52663,"_2652":52973},[],"DMSs whose webhook had `validate_server_cert: false`",{"_3154":2507,"_27801":2401,"_19254":52975,"_5":13218,"_26298":52663,"_2652":52976},[],"Medium: credentials go to an unverified receiver",{"_3154":2508,"_27801":2401,"_19254":52978,"_5":13218,"_26298":52663,"_2652":52979},[],"Set `insecure_skip_verify` to `false`",{"_3154":2509,"_27801":2401,"_19254":52981,"_5":13218,"_26298":52663,"_2652":52724},[],{"_3154":2510,"_27801":2401,"_19254":52983,"_5":13218,"_26298":52663,"_2652":52984},[],"Scripts and consoles that edit DMSs through the API",{"_3154":2511,"_27801":2401,"_19254":52986,"_5":13218,"_26298":52663,"_2652":52987},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_3154":2512,"_27801":2401,"_19254":52989,"_5":13218,"_26298":52663,"_2652":52990},[],"Read the DMS before editing and use the new field",{"_3154":2513,"_27801":2401,"_19254":52992,"_5":13218,"_26298":52663,"_2652":52740},[],{"_3154":2514,"_27801":2401,"_19254":52994,"_5":13218,"_26298":52663,"_2652":52995},[],"Consumers that read the device `events` field",{"_3154":2515,"_27801":2401,"_19254":52997,"_5":13218,"_26298":52663,"_2652":52998},[],"Medium: the field disappears",{"_3154":2516,"_27801":2401,"_19254":53000,"_5":13218,"_26298":52663,"_2652":53001},[],"Use the new event endpoints",{"_3154":2517,"_27801":2401,"_19254":53003,"_5":13218,"_26298":52663,"_2652":52696},[],{"_3154":2518,"_27801":2401,"_19254":53005,"_5":13218,"_26298":52663,"_2652":53006},[],"Releases that override `toolbox`, `services.connectors`, ports, probes or scheduling",{"_3154":2519,"_27801":2401,"_19254":53008,"_5":13218,"_26298":52663,"_2652":53009},[],"Low to medium: validation errors or changed defaults",{"_3154":2520,"_27801":2401,"_19254":53011,"_5":13218,"_26298":52663,"_2652":53012},[],"Update the values file",{"_3154":2521,"_27801":2401,"_19254":53014,"_5":13218,"_26298":52663,"_2652":52732},[],{"_3154":2522,"_27801":2401,"_19254":53016,"_5":13218,"_26298":52663,"_2652":53017},[],"Clients that send the DMS ID in the update body",{"_3154":2523,"_27801":2401,"_19254":53019,"_5":13218,"_26298":52663,"_2652":53020},[],"Low: the ID in the URL wins",{"_3154":2524,"_27801":2401,"_19254":53022,"_5":13218,"_26298":52663,"_2652":53023},[],"Send the ID in the URL",{"_3154":2525,"_27801":2401,"_19254":53025,"_5":13218,"_26298":52663,"_2652":52736},[],{"_3154":2526,"_27801":2401,"_19254":53027,"_5":13218,"_26298":52663,"_2652":53028},[],"Consumers that match on certificate `type`",{"_3154":2527,"_27801":2401,"_19254":53030,"_5":13218,"_26298":52663,"_2652":53031},[],"Low: two values are renamed",{"_3154":2528,"_27801":2401,"_19254":53033,"_5":13218,"_26298":52663,"_2652":53034},[],"Adapt consumers",{"_3154":2529,"_27801":2401,"_19254":53036,"_5":13218,"_26298":52663,"_2652":52728},[],{"_3154":2530,"_27801":2401,"_19254":53038,"_5":13218,"_26298":52663,"_2652":53039},[],"Any DMS",{"_3154":2531,"_27801":2401,"_19254":53041,"_5":13218,"_26298":52663,"_2652":53042},[],"Low: informational",{"_3154":2532,"_27801":2401,"_19254":53044,"_5":13218,"_26298":52663,"_2652":53045},[],"Read both blocks before editing",{"_3154":2533,"_27801":2401,"_19254":53047,"_5":13218,"_26298":52671,"_2652":53048},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_3154":2534,"_27801":2401,"_19254":53050,"_5":13218,"_26298":52671,"_2652":53051},[],"Step 4 of the migration guide copies the data.",{"_3154":2535,"_27801":2401,"_19254":53053,"_5":13218,"_26298":52675,"_2652":53054},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_3154":2536,"_27801":2401,"_19254":53056,"_5":13218,"_26298":52679,"_2652":53057},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_3154":2537,"_27801":2401,"_19254":53059,"_5":13218,"_26298":52683,"_2652":53060},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_3154":2538,"_27801":2401,"_19254":53062,"_5":13218,"_26298":52687,"_2652":53063},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_3154":2539,"_27801":2401,"_19254":53065,"_5":13218,"_26298":52687,"_2652":53066},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_3154":2540,"_27801":2401,"_19254":53068,"_5":13218,"_26298":52691,"_2652":53069},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_3154":2541,"_27801":2401,"_19254":53071,"_5":13218,"_26298":52695,"_2652":53072},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_3154":2542,"_27801":2401,"_19254":53074,"_5":13218,"_26298":52695,"_2652":53075},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_3154":2543,"_27801":2401,"_19254":53077,"_5":13218,"_26298":52695,"_2652":53078},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_3154":2544,"_27801":2401,"_19254":53080,"_5":13218,"_26298":52695,"_2652":53081},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_3154":2545,"_27801":2401,"_19254":53083,"_5":13218,"_26298":52695,"_2652":53084},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_3154":2546,"_27801":2401,"_19254":53086,"_5":13218,"_26298":52695,"_2652":53087},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_3154":2547,"_27801":2401,"_19254":53089,"_5":13218,"_26298":52703,"_2652":53090},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_3154":2548,"_27801":2401,"_19254":53092,"_5":13218,"_26298":52703,"_2652":53093},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_3154":2549,"_27801":2401,"_19254":53095,"_5":13218,"_26298":52703,"_2652":53096},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_3154":2550,"_27801":2401,"_19254":53098,"_5":13218,"_26298":52703,"_2652":53099},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_3154":2551,"_27801":2401,"_19254":53101,"_5":13218,"_26298":52703,"_2652":53102},[],"The same KMS migration deletes, with a `NOTICE`, aliases that equal an existing key ID, because identifiers now resolve as a key ID before an alias. Affected aliases are dropped, not redirected.",{"_3154":2552,"_27801":2401,"_19254":53104,"_5":13218,"_26298":52707,"_2652":53105},[],"The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_3154":2553,"_27801":2401,"_19254":53107,"_5":13218,"_26298":52711,"_2652":53108},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_3154":2554,"_27801":2401,"_19254":53110,"_5":13218,"_26298":52711,"_2652":53111},[],"The `key_id` is the certificate's `subject_key_id` (SHA-256 of the public key).",{"_3154":2555,"_27801":2401,"_19254":53113,"_5":13218,"_26298":52711,"_2652":53114},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_3154":2556,"_27801":2401,"_19254":53116,"_5":13218,"_26298":52711,"_2652":53117},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_3154":2557,"_27801":2401,"_19254":53119,"_5":13218,"_26298":52711,"_2652":53120},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_3154":2558,"_27801":2401,"_19254":53122,"_5":13218,"_26298":52711,"_2652":53123},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_3154":2559,"_27801":2401,"_19254":53125,"_5":13218,"_26298":52719,"_2652":53126},[],"Stored webhook configs are rewritten to the current layout and their fields renamed:",{"_3154":2560,"_27801":2401,"_19254":53128,"_5":13218,"_26298":52719,"_2652":53129},[],"Field in 3.8.0",{"_3154":2561,"_27801":2401,"_19254":53131,"_5":13218,"_26298":52719,"_2652":53132},[],"Field in 4.0.0",{"_3154":2562,"_27801":2401,"_19254":53134,"_5":13218,"_26298":52719,"_2652":53135},[],"`validate_server_cert`",{"_3154":2563,"_27801":2401,"_19254":53137,"_5":13218,"_26298":52719,"_2652":53138},[],"`insecure_skip_verify` (value negated)",{"_3154":2564,"_27801":2401,"_19254":53140,"_5":13218,"_26298":52719,"_2652":53141},[],"`oidc`",{"_3154":2565,"_27801":2401,"_19254":53143,"_5":13218,"_26298":52719,"_2652":53144},[],"`jwt_options`",{"_3154":2566,"_27801":2401,"_19254":53146,"_5":13218,"_26298":52719,"_2652":53147},[],"`apikey`",{"_3154":2567,"_27801":2401,"_19254":53149,"_5":13218,"_26298":52719,"_2652":53150},[],"`apikey_options`",{"_3154":2568,"_27801":2401,"_19254":53152,"_5":13218,"_26298":52719,"_2652":53153},[],"`mtls`",{"_3154":2569,"_27801":2401,"_19254":53155,"_5":13218,"_26298":52719,"_2652":53156},[],"`mtls_options`",{"_3154":2570,"_27801":2401,"_19254":53158,"_5":13218,"_26298":52719,"_2652":53159},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. Two cases do need it.",{"_3154":2571,"_27801":2401,"_19254":53161,"_5":13218,"_26298":52719,"_2652":53162},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_3154":2572,"_27801":2401,"_19254":53164,"_5":13218,"_26298":52719,"_2652":53165},[],"**Receiver certificate verification.** A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_3154":2573,"_27801":2401,"_19254":53167,"_5":13218,"_26298":52723,"_2652":53168},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3154":2574,"_27801":2401,"_19254":53170,"_5":13218,"_26298":52723,"_2652":53171},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_3154":2575,"_27801":2401,"_19254":53173,"_5":13218,"_26298":52723,"_2652":53174},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_3154":2576,"_27801":2401,"_19254":53176,"_5":13218,"_26298":52727,"_2652":53177},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but read both blocks before editing a DMS so that you do not modify one while believing you are editing the other. If the console version does not expose independent settings, edit them through the DMS API.",{"_3154":2577,"_27801":2401,"_19254":53179,"_5":13218,"_26298":52731,"_2652":53180},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_3154":2578,"_27801":2401,"_19254":53182,"_5":13218,"_26298":52735,"_2652":53183},[],"Stored certificate type values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Adapt consumers that read or match on those values.",{"_3154":2579,"_27801":2401,"_19254":53185,"_5":13218,"_26298":52739,"_2652":53186},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_3154":2580,"_27801":2401,"_19254":53188,"_5":13218,"_26298":52739,"_2652":53189},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_3154":2581,"_27801":2401,"_19254":53191,"_5":13218,"_26298":52739,"_2652":53192},[],"`POST /v1/devices/:id/events` creates an event.",{"_3154":2582,"_27801":2401,"_19254":53194,"_5":13218,"_26298":52739,"_2652":53195},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Each Device Manager instance binds a durable AMQP queue named after its service ID, `device-manager-sse-<uuid>`. Queues from crashed or replaced instances linger until removed, so configure an expiration or cleanup policy on the broker.",{"_3154":2583,"_27801":2401,"_19254":53197,"_5":13218,"_26298":52743,"_2652":53198},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_3154":2584,"_27801":2401,"_19254":53200,"_5":13218,"_26298":52747,"_2652":53201},[],"Take a verifiable backup of PostgreSQL and schedule downtime. The upgrade moves every service's data into `pki`.",{"_3154":2585,"_27801":2401,"_19254":53203,"_5":13218,"_26298":52747,"_2652":53204},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_3154":2586,"_27801":2401,"_19254":53206,"_5":13218,"_26298":52747,"_2652":53207},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_3154":2587,"_27801":2401,"_19254":53209,"_5":13218,"_26298":52747,"_2652":53210},[],"Record the names of your local-storage PVCs:",{"_3154":2588,"_27801":2401,"_19254":53212,"_5":13218,"_26298":52747,"_2652":53213},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_3154":2589,"_27801":2401,"_19254":53215,"_5":13218,"_26298":52751,"_2652":53216},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_3154":2590,"_27801":2401,"_19254":53218,"_5":13218,"_26298":52751,"_2652":53219},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_3154":2591,"_27801":2401,"_19254":53221,"_5":13218,"_26298":52751,"_2652":53222},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is read; the connection always uses the global `postgres.hostname`, `postgres.port`, `postgres.username` and `postgres.password` values.",{"_3154":2592,"_27801":2401,"_19254":53224,"_5":13218,"_26298":52751,"_2652":53225},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_3154":2593,"_27801":2401,"_19254":53227,"_5":13218,"_26298":52751,"_2652":53228},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_3154":2594,"_27801":2401,"_19254":53230,"_5":13218,"_26298":52751,"_2652":53231},[],"**Rename `toolbox` to `connectivityTest`:**",{"_3154":2595,"_27801":2401,"_19254":53233,"_5":13218,"_26298":52751,"_2652":53234},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3154":2596,"_27801":2401,"_19254":53236,"_5":13218,"_26298":52751,"_2652":53237},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_3154":2597,"_27801":2401,"_19254":53239,"_5":13218,"_26298":52751,"_2652":53240},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_3154":2598,"_27801":2401,"_19254":53242,"_5":13218,"_26298":52751,"_2652":53243},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_3154":2599,"_27801":2401,"_19254":53245,"_5":13218,"_26298":52751,"_2652":53246},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_3154":2600,"_27801":2401,"_19254":53248,"_5":13218,"_26298":52751,"_2652":53249},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown.",{"_3154":2601,"_27801":2401,"_19254":53251,"_5":13218,"_26298":52755,"_2652":53252},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_3154":2602,"_27801":2401,"_19254":53254,"_5":13218,"_26298":52755,"_2652":53255},[],"If the deployment uses local KMS or VA storage, those pods fail until you complete step 4, so `--wait` cannot succeed: Helm waits for them to become ready, times out, exits with an error and marks the release `failed`. The hooks have already run by then, and every manifest, including the new StatefulSets and their PVCs, has been applied. Helm does not roll anything back without `--atomic`. Continue with step 4, then re-run the same `helm upgrade` command so it completes and Helm records the release as `deployed`. Both hooks are idempotent, so they are safe to run again.",{"_3154":2603,"_27801":2401,"_19254":53257,"_5":13218,"_26298":52759,"_2652":53258},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_3154":2604,"_27801":2401,"_19254":53260,"_5":13218,"_26298":52759,"_2652":53261},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_3154":2605,"_27801":2401,"_19254":53263,"_5":13218,"_26298":52759,"_2652":53264},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If `claims_ok` prints `ABORT`, the block stops before listing the claims: either a StatefulSet lookup failed, or a new claim resolves to the 3.8.0 claim. In the second case the copy would verify against itself and the final cleanup would delete the live volume. The chart always appends `-kms` and `-va` to the release-scoped name, so a collision means the claims are not what this guide expects; investigate before going on. Item 3 runs the same check and refuses to create the helper pod, so nothing touches the volumes. The check returns instead of calling `exit`, which would close your shell and lose the variables set so far. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_3154":2606,"_27801":2401,"_19254":53266,"_5":13218,"_26298":52759,"_2652":53267},[],"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:",{"_3154":2607,"_27801":2401,"_19254":53269,"_5":13218,"_26298":52759,"_2652":53270},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_3154":2608,"_27801":2401,"_19254":53272,"_5":13218,"_26298":52759,"_2652":53273},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_3154":2609,"_27801":2401,"_19254":53275,"_5":13218,"_26298":52759,"_2652":53276},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_3154":2610,"_27801":2401,"_19254":53278,"_5":13218,"_26298":52759,"_2652":53279},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_3154":2611,"_27801":2401,"_19254":53281,"_5":13218,"_26298":52759,"_2652":53282},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_3154":2612,"_27801":2401,"_19254":53284,"_5":13218,"_26298":52759,"_2652":53285},[],"**Remove the helper and restore the recorded replica counts:**",{"_3154":2613,"_27801":2401,"_19254":53287,"_5":13218,"_26298":52759,"_2652":53288},[],"**Re-run the step 3 `helm upgrade` command.** The KMS and VA pods now start against the copied data, so `--wait` succeeds and the release moves from `failed` to `deployed`.",{"_3154":2614,"_27801":2401,"_19254":53290,"_5":13218,"_26298":52763,"_2652":53291},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_3154":2615,"_27801":2401,"_19254":53293,"_5":13218,"_26298":52763,"_2652":53294},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_3154":2616,"_27801":2401,"_19254":53296,"_5":13218,"_26298":52767,"_2652":53297},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_3154":2617,"_27801":2401,"_19254":53299,"_5":13218,"_26298":52767,"_2652":53300},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_3154":2618,"_27801":2401,"_19254":53302,"_5":13218,"_26298":52767,"_2652":53303},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_3154":2619,"_27801":2401,"_19254":53305,"_5":13218,"_26298":52767,"_2652":53306},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository.",{"_3154":2620,"_27801":2401,"_19254":53308,"_5":13218,"_26298":52767,"_2652":53309},[],"The `goose-lamassu` README still shows per-database examples (`dbname=ca`, `dbname=kms`) and claims the tool validates the database name, and the `ca-to-kms-migration` README still describes the pre-4.0.0 two-database layout. Follow the `dbname=pki` form on this page instead of their examples.",{"_3154":2621,"_27801":2401,"_19254":53311,"_5":13218,"_26298":52771,"_2652":53312},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_3154":2622,"_27801":2401,"_19254":53314,"_5":13218,"_26298":52771,"_2652":53315},[],"**`helm upgrade --wait` times out and `helm status` reports the release as `failed`.** With local KMS or VA storage this is expected on the first run: the new pods cannot become ready before their data is copied. The hooks ran and the manifests and PVCs were applied, so complete step 4 and re-run the same `helm upgrade` command. If other pods are also not ready, check their logs, because something else is wrong.",{"_3154":2623,"_27801":2401,"_19254":53317,"_5":13218,"_26298":52771,"_2652":53318},[],"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait.",{"_3154":2624,"_27801":2401,"_19254":53320,"_5":13218,"_26298":52771,"_2652":53321},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_3154":2625,"_27801":2401,"_19254":53323,"_5":13218,"_26298":52771,"_2652":53324},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted on duplicate CA IDs or missing `engine_id` values. Check the job logs, fix the privileges or the data, and re-run the upgrade.",{"_3154":2626,"_27801":2401,"_19254":53326,"_5":13218,"_26298":52771,"_2652":53327},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_3154":2627,"_27801":2401,"_19254":53329,"_5":13218,"_26298":52771,"_2652":53330},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_3154":2628,"_27801":2401,"_19254":53332,"_5":13218,"_26298":52774,"_2652":53333},[],"After the upgrade, check in this order:",{"_3154":2629,"_27801":2401,"_19254":53335,"_5":13218,"_26298":52774,"_2652":53336},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations.",{"_3154":2630,"_27801":2401,"_19254":53338,"_5":13218,"_26298":52774,"_2652":53339},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_3154":2631,"_27801":2401,"_19254":53341,"_5":13218,"_26298":52774,"_2652":53342},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_3154":2632,"_27801":2401,"_19254":53344,"_5":13218,"_26298":52774,"_2652":53345},[],"**Existing CRLs are served.** `GET /crl/<ca-ski>` on VA returns a previously issued CRL, and new CRLs are issued.",{"_3154":2633,"_27801":2401,"_19254":53347,"_5":13218,"_26298":52774,"_2652":53348},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS.",{"_3154":2634,"_27801":2401,"_19254":53350,"_5":13218,"_26298":52774,"_2652":53351},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_3154":2635,"_27801":2401,"_19254":53353,"_5":13218,"_26298":52774,"_2652":53354},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_3154":2636,"_27801":2401,"_19254":53356,"_5":13218,"_26298":52774,"_2652":53357},[],"**AMQP.** The backend connects to the broker with the expected TLS settings, and the cleanup policy for SSE queues is in place.",{"_3154":2637,"_27801":2401,"_19254":53359,"_5":13218,"_26298":52774,"_2652":53360},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_3154":2638,"_27801":2401,"_19254":53362,"_5":13218,"_26298":52774,"_2652":53363},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_3154":2639,"_27801":2401,"_19254":53365,"_5":13218,"_26298":52774,"_2652":53366},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_3154":2640,"_27801":2401,"_19254":53368,"_5":13218,"_26298":52774,"_2652":53369},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_3154":2641,"_27801":2401,"_19254":53371,"_5":13218,"_26298":52774,"_2652":53372},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_3154":2642,"_27801":2401,"_19254":53374,"_5":13218,"_26298":52774,"_2652":53375},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_3154":2643,"_27801":2401,"_19254":53377,"_5":13218,"_26298":52778,"_2652":53378},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy. These are the fixed 3.8.0 names recorded in step 1; before deleting, confirm that neither is mounted by a running pod, for example with `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, where `Used By` must be `<none>`:",{"_3154":2644,"_27801":2401,"_19254":53380,"_5":13218,"_26298":52778,"_2652":53381},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_3154":2645,"_27801":2401,"_19254":53383,"_5":13218,"_26298":52778,"_2652":53384},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3154":2646,"_27801":2401,"_19254":53386,"_5":13218,"_26298":52778,"_2652":53387},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_3154":2647,"_27801":2401,"_19254":53389,"_5":13218,"_26298":52778,"_2652":53390},[],"<Card title=\"Configure a DMS\" description=\"Enrollment, re-enrollment and webhook settings.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />","sorting",{"_53393":53394,"_53395":53396,"_53397":53398,"_53399":53400,"_16779":2674,"_63946":2674},"language","english","sortableProperties",[2652,27801,5,26298],"sortablePropertiesWithTypes",{"_2652":23039,"_27801":23039,"_5":23039,"_26298":23039},"sorts",{"_2652":53401,"_27801":56038,"_5":58674,"_26298":61310},{"_4238":53402,"_53403":53404,"_5":23039},{"_13273":23366,"_13648":10406,"_13667":6860,"_11914":3241,"_13654":6793,"_18267":11441,"_13294":4707,"_13301":4706,"_26855":3043,"_27246":4385,"_27267":6627,"_26873":5285,"_31908":3783,"_27278":7601,"_27307":3265,"_31915":5379,"_31918":2974,"_31921":4144,"_31924":4946,"_27654":5456,"_31929":22323,"_31931":5512,"_27684":19636,"_13663":2917,"_31935":10947,"_31938":4374,"_31940":4365,"_27296":8583,"_27649":8681,"_27708":11138,"_31945":16566,"_31947":6324,"_31949":7324,"_31951":2749,"_31953":19183,"_31955":3939,"_31957":6000,"_31959":3343,"_31961":3409,"_26925":4435,"_31964":4355,"_31966":10122,"_26919":3037,"_31969":4293,"_31971":3726,"_31973":2830,"_31976":11241,"_26965":3126,"_31980":2760,"_26846":12918,"_31983":3830,"_26878":3660,"_27859":11103,"_31987":5972,"_31990":4615,"_13657":6298,"_31993":4015,"_31995":6956,"_31998":5444,"_32000":5293,"_32002":7445,"_32004":4804,"_32006":6157,"_18270":21129,"_32009":15887,"_32011":5910,"_26899":13904,"_27290":8043,"_32015":8787,"_32017":3435,"_32019":4313,"_27714":2759,"_32022":2935,"_32024":6526,"_32026":7892,"_27781":4559,"_27323":6787,"_32030":8012,"_32032":6877,"_26888":4543,"_32035":5566,"_32037":5302,"_32039":29