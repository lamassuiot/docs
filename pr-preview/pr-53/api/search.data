60,"_29612":68556,"_5":29962,"_20544":113669,"_26932":113670,"_2867":113671},[],"/docs/pr-preview/pr-53/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3381":68561,"_29612":68556,"_5":29962,"_20544":113673,"_26932":113674,"_2867":113675},[],"/docs/pr-preview/pr-53/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3381":68562,"_29612":68556,"_5":29962,"_20544":113677,"_26932":113678,"_2867":113679},[],"/docs/pr-preview/pr-53/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3381":68563,"_29612":68556,"_5":29962,"_20544":113681,"_26932":113682,"_2867":113683},[],"/docs/pr-preview/pr-53/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3381":68564,"_29612":68556,"_5":29962,"_20544":113685,"_26932":113686,"_2867":113687},[],"/docs/pr-preview/pr-53/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3381":68565,"_29612":68556,"_20544":113689,"_5":14097,"_26932":68556,"_2867":113690},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3381":68566,"_29612":68556,"_20544":113692,"_5":14097,"_26932":113662,"_2867":113693},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3381":68567,"_29612":68556,"_20544":113695,"_5":14097,"_26932":113662,"_2867":113696},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3381":68568,"_29612":68556,"_20544":113698,"_5":14097,"_26932":113662,"_2867":113699},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3381":68569,"_29612":68556,"_20544":113701,"_5":14097,"_26932":113666,"_2867":113702},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3381":68570,"_29612":68556,"_20544":113704,"_5":14097,"_26932":113666,"_2867":113705},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3381":68571,"_29612":68556,"_20544":113707,"_5":14097,"_26932":113666,"_2867":113708},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3381":68572,"_29612":68556,"_20544":113710,"_5":14097,"_26932":113670,"_2867":113711},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3381":68573,"_29612":68556,"_20544":113713,"_5":14097,"_26932":113674,"_2867":113714},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3381":68574,"_29612":68556,"_20544":113716,"_5":14097,"_26932":113678,"_2867":113717},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3381":68575,"_29612":68556,"_20544":113719,"_5":14097,"_26932":113682,"_2867":113720},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3381":68576,"_29612":68556,"_20544":113722,"_5":14097,"_26932":113686,"_2867":113723},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3381":68577,"_29612":68577,"_5":14455,"_2867":113725,"_29965":113726,"_20544":113727,"_26932":68577},"Despliega Lamassu",[48231,113654],[],{"_3381":68578,"_29612":68577,"_20544":113729,"_5":14097,"_26932":68577,"_2867":113730},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3381":68579,"_29612":68577,"_5":29962,"_20544":113732,"_26932":113733,"_2867":113734},[],"/docs/pr-preview/pr-53/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3381":68580,"_29612":68577,"_5":29962,"_20544":113736,"_26932":113737,"_2867":113738},[],"/docs/pr-preview/pr-53/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3381":68581,"_29612":68577,"_5":29962,"_20544":113740,"_26932":113741,"_2867":113742},[],"/docs/pr-preview/pr-53/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3381":68582,"_29612":68577,"_20544":113744,"_5":14097,"_26932":68577,"_2867":113745},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3381":68583,"_29612":68577,"_20544":113747,"_5":14097,"_26932":113733,"_2867":113748},[],"Modelo",{"_3381":68584,"_29612":68577,"_20544":113750,"_5":14097,"_26932":113733,"_2867":113751},[],"Recomendado para",{"_3381":68585,"_29612":68577,"_20544":113753,"_5":14097,"_26932":113733,"_2867":113754},[],"Quién opera la infraestructura",{"_3381":68586,"_29612":68577,"_20544":113756,"_5":14097,"_26932":113733,"_2867":113757},[],"Punto de partida",{"_3381":68587,"_29612":68577,"_20544":113759,"_5":14097,"_26932":113733,"_2867":48338},[],{"_3381":68588,"_29612":68577,"_20544":113761,"_5":14097,"_26932":113733,"_2867":113762},[],"Producción, entornos regulados y despliegues personalizados",{"_3381":68589,"_29612":68577,"_20544":113764,"_5":14097,"_26932":113733,"_2867":113765},[],"Tu equipo",{"_3381":68590,"_29612":68577,"_20544":113767,"_5":14097,"_26932":113733,"_2867":113768},[],"Helm o Fastlane",{"_3381":68591,"_29612":68577,"_20544":113770,"_5":14097,"_26932":113733,"_2867":48350},[],{"_3381":68592,"_29612":68577,"_20544":113772,"_5":14097,"_26932":113733,"_2867":113773},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3381":68593,"_29612":68577,"_20544":113775,"_5":14097,"_26932":113733,"_2867":113765},[],{"_3381":68594,"_29612":68577,"_20544":113777,"_5":14097,"_26932":113733,"_2867":113778},[],"Imagen preconfigurada en EC2",{"_3381":68595,"_29612":68577,"_20544":113780,"_5":14097,"_26932":113733,"_2867":48361},[],{"_3381":68596,"_29612":68577,"_20544":113782,"_5":14097,"_26932":113733,"_2867":113783},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3381":68597,"_29612":68577,"_20544":113785,"_5":14097,"_26932":113733,"_2867":48367},[],{"_3381":68598,"_29612":68577,"_20544":113787,"_5":14097,"_26932":113733,"_2867":113788},[],"Suscripción gestionada",{"_3381":68599,"_29612":68577,"_20544":113790,"_5":14097,"_26932":113733,"_2867":113791},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3381":68600,"_29612":68577,"_20544":113793,"_5":14097,"_26932":113733,"_2867":113794},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3381":68601,"_29612":68577,"_20544":113796,"_5":14097,"_26932":113733,"_2867":113797},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3381":68602,"_29612":68577,"_20544":113799,"_5":14097,"_26932":113737,"_2867":113800},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3381":68603,"_29612":68577,"_20544":113802,"_5":14097,"_26932":113741,"_2867":113803},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3381":68604,"_29612":68604,"_5":14455,"_2867":113805,"_29965":113806,"_20544":113807,"_26932":68604},"Utiliza Lamassu como SaaS",[48231,113654,113655],[],{"_3381":68605,"_29612":68604,"_20544":113809,"_5":14097,"_26932":68604,"_2867":113810},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3381":68606,"_29612":68604,"_5":29962,"_20544":113812,"_26932":113813,"_2867":113814},[],"/docs/pr-preview/pr-53/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3381":68607,"_29612":68604,"_5":29962,"_20544":113816,"_26932":113817,"_2867":113818},[],"/docs/pr-preview/pr-53/es/deployment/saas#planes","Planes",{"_3381":68608,"_29612":68604,"_5":29962,"_20544":113820,"_26932":113821,"_2867":113822},[],"/docs/pr-preview/pr-53/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3381":68609,"_29612":68604,"_20544":113824,"_5":14097,"_26932":68604,"_2867":113825},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3381":68610,"_29612":68604,"_20544":113827,"_5":14097,"_26932":113813,"_2867":113828},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3381":68611,"_29612":68604,"_20544":113830,"_5":14097,"_26932":113813,"_2867":113831},[],"Copias de seguridad automáticas.",{"_3381":68612,"_29612":68604,"_20544":113833,"_5":14097,"_26932":113813,"_2867":113834},[],"Actualizaciones de versión.",{"_3381":68613,"_29612":68604,"_20544":113836,"_5":14097,"_26932":113813,"_2867":113837},[],"Soporte técnico y SLA según el plan contratado.",{"_3381":68614,"_29612":68604,"_20544":113839,"_5":14097,"_26932":113817,"_2867":48422},[],{"_3381":68615,"_29612":68604,"_20544":113841,"_5":14097,"_26932":113817,"_2867":113842},[],"Dispositivos",{"_3381":68616,"_29612":68604,"_20544":113844,"_5":14097,"_26932":113817,"_2867":113845},[],"Soporte",{"_3381":68617,"_29612":68604,"_20544":113847,"_5":14097,"_26932":113817,"_2867":48431},[],{"_3381":68618,"_29612":68604,"_20544":113849,"_5":14097,"_26932":113817,"_2867":48434},[],{"_3381":68619,"_29612":68604,"_20544":113851,"_5":14097,"_26932":113817,"_2867":113852},[],"Hasta 1.000",{"_3381":68620,"_29612":68604,"_20544":113854,"_5":14097,"_26932":113817,"_2867":48440},[],{"_3381":68621,"_29612":68604,"_20544":113856,"_5":14097,"_26932":113817,"_2867":113857},[],"99,5 %",{"_3381":68622,"_29612":68604,"_20544":113859,"_5":14097,"_26932":113817,"_2867":48446},[],{"_3381":68623,"_29612":68604,"_20544":113861,"_5":14097,"_26932":113817,"_2867":113862},[],"Hasta 10.000",{"_3381":68624,"_29612":68604,"_20544":113864,"_5":14097,"_26932":113817,"_2867":113865},[],"Email y chat",{"_3381":68625,"_29612":68604,"_20544":113867,"_5":14097,"_26932":113817,"_2867":113868},[],"99,9 %",{"_3381":68626,"_29612":68604,"_20544":113870,"_5":14097,"_26932":113817,"_2867":48458},[],{"_3381":68627,"_29612":68604,"_20544":113872,"_5":14097,"_26932":113817,"_2867":113873},[],"Ilimitados",{"_3381":68628,"_29612":68604,"_20544":113875,"_5":14097,"_26932":113817,"_2867":113876},[],"Dedicado",{"_3381":68629,"_29612":68604,"_20544":113878,"_5":14097,"_26932":113817,"_2867":113879},[],"99,99 %",{"_3381":68630,"_29612":68604,"_20544":113881,"_5":14097,"_26932":113821,"_2867":113882},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3381":68631,"_29612":68604,"_20544":113884,"_5":14097,"_26932":113821,"_2867":113885},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3381":68632,"_29612":68632,"_5":14455,"_2867":48475,"_29965":113887,"_20544":113889,"_26932":68632},[48231,113654,113888],"Kubernetes autogestionado",[],{"_3381":68633,"_29612":68632,"_20544":113891,"_5":14097,"_26932":68632,"_2867":113892},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3381":68634,"_29612":68632,"_5":29962,"_20544":113894,"_26932":113895,"_2867":113896},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3381":68635,"_29612":68632,"_5":29962,"_20544":113898,"_26932":113899,"_2867":113900},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3381":68636,"_29612":68632,"_5":29962,"_20544":113902,"_26932":113903,"_2867":113904},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3381":68637,"_29612":68632,"_5":29962,"_20544":113906,"_26932":113907,"_2867":113908},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3381":68638,"_29612":68632,"_5":29962,"_20544":113910,"_26932":113911,"_2867":113912},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3381":68639,"_29612":68632,"_5":29962,"_20544":113914,"_26932":113915,"_2867":113916},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3381":68640,"_29612":68632,"_5":29962,"_20544":113918,"_26932":113919,"_2867":113920},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3381":68641,"_29612":68632,"_5":29962,"_20544":113922,"_26932":113923,"_2867":113924},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3381":68642,"_29612":68632,"_5":29962,"_20544":113926,"_26932":113927,"_2867":113928},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3381":68643,"_29612":68632,"_5":29962,"_20544":113930,"_26932":113931,"_2867":113932},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3381":68644,"_29612":68632,"_5":29962,"_20544":113934,"_26932":113935,"_2867":113936},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3381":68645,"_29612":68632,"_20544":113938,"_5":14097,"_26932":113895,"_2867":113939},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3381":68646,"_29612":68632,"_20544":113941,"_5":14097,"_26932":113895,"_2867":113942},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3381":68647,"_29612":68632,"_20544":113944,"_5":14097,"_26932":113899,"_2867":113945},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3381":68648,"_29612":68632,"_20544":113947,"_5":14097,"_26932":113899,"_2867":113948},[],"Fastlane instala o configura",{"_3381":68649,"_29612":68632,"_20544":113950,"_5":14097,"_26932":113899,"_2867":113951},[],"Tú sigues proporcionando",{"_3381":68650,"_29612":68632,"_20544":113953,"_5":14097,"_26932":113899,"_2867":113954},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3381":68651,"_29612":68632,"_20544":113956,"_5":14097,"_26932":113899,"_2867":113957},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3381":68652,"_29612":68632,"_20544":113959,"_5":14097,"_26932":113899,"_2867":113960},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3381":68653,"_29612":68632,"_20544":113962,"_5":14097,"_26932":113899,"_2867":113963},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3381":68654,"_29612":68632,"_20544":113965,"_5":14097,"_26932":113899,"_2867":113966},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_3381":68655,"_29612":68632,"_20544":113968,"_5":14097,"_26932":113899,"_2867":113969},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3381":68656,"_29612":68632,"_20544":113971,"_5":14097,"_26932":113899,"_2867":113972},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3381":68657,"_29612":68632,"_20544":113974,"_5":14097,"_26932":113899,"_2867":113975},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3381":68658,"_29612":68632,"_20544":113977,"_5":14097,"_26932":113899,"_2867":113978},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3381":68659,"_29612":68632,"_20544":113980,"_5":14097,"_26932":113903,"_2867":113981},[],"Necesitas:",{"_3381":68660,"_29612":68632,"_20544":113983,"_5":14097,"_26932":113903,"_2867":113984},[],"un clúster Kubernetes existente",{"_3381":68661,"_29612":68632,"_20544":113986,"_5":14097,"_26932":113903,"_2867":113987},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3381":68662,"_29612":68632,"_20544":113989,"_5":14097,"_26932":113903,"_2867":48577},[],{"_3381":68663,"_29612":68632,"_20544":113991,"_5":14097,"_26932":113903,"_2867":23225},[],{"_3381":68664,"_29612":68632,"_20544":113993,"_5":14097,"_26932":113903,"_2867":113994},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3381":68665,"_29612":68632,"_20544":113996,"_5":14097,"_26932":113903,"_2867":113997},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3381":68666,"_29612":68632,"_20544":113999,"_5":14097,"_26932":113903,"_2867":114000},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3381":68667,"_29612":68632,"_20544":114002,"_5":14097,"_26932":113903,"_2867":114003},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3381":68668,"_29612":68632,"_20544":114005,"_5":14097,"_26932":113903,"_2867":114006},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3381":68669,"_29612":68632,"_20544":114008,"_5":14097,"_26932":113907,"_2867":114009},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3381":68670,"_29612":68632,"_20544":114011,"_5":14097,"_26932":113907,"_2867":114012},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3381":68671,"_29612":68632,"_20544":114014,"_5":14097,"_26932":113911,"_2867":114015},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3381":68672,"_29612":68632,"_20544":114017,"_5":14097,"_26932":113911,"_2867":114018},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3381":68673,"_29612":68632,"_20544":114020,"_5":14097,"_26932":113911,"_2867":114021},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3381":68674,"_29612":68632,"_20544":114023,"_5":14097,"_26932":113911,"_2867":114024},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3381":68675,"_29612":68632,"_20544":114026,"_5":14097,"_26932":113915,"_2867":114027},[],"Opción",{"_3381":68676,"_29612":68632,"_20544":114029,"_5":14097,"_26932":113915,"_2867":114030},[],"Valor predeterminado",{"_3381":68677,"_29612":68632,"_20544":114032,"_5":14097,"_26932":113915,"_2867":114033},[],"Propósito",{"_3381":68678,"_29612":68632,"_20544":114035,"_5":14097,"_26932":113915,"_2867":48624},[],{"_3381":68679,"_29612":68632,"_20544":114037,"_5":14097,"_26932":113915,"_2867":48627},[],{"_3381":68680,"_29612":68632,"_20544":114039,"_5":14097,"_26932":113915,"_2867":114040},[],"Muestra la ayuda",{"_3381":68681,"_29612":68632,"_20544":114042,"_5":14097,"_26932":113915,"_2867":48633},[],{"_3381":68682,"_29612":68632,"_20544":114044,"_5":14097,"_26932":113915,"_2867":114045},[],"contexto actual",{"_3381":68683,"_29612":68632,"_20544":114047,"_5":14097,"_26932":113915,"_2867":114048},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3381":68684,"_29612":68632,"_20544":114050,"_5":14097,"_26932":113915,"_2867":48642},[],{"_3381":68685,"_29612":68632,"_20544":114052,"_5":14097,"_26932":113915,"_2867":6391},[],{"_3381":68686,"_29612":68632,"_20544":114054,"_5":14097,"_26932":113915,"_2867":114055},[],"Omite prompts y genera credenciales para las dependencias",{"_3381":68687,"_29612":68632,"_20544":114057,"_5":14097,"_26932":113915,"_2867":48650},[],{"_3381":68688,"_29612":68632,"_20544":114059,"_5":14097,"_26932":113915,"_2867":48653},[],{"_3381":68689,"_29612":68632,"_20544":114061,"_5":14097,"_26932":113915,"_2867":114062},[],"Namespace de la instalación",{"_3381":68690,"_29612":68632,"_20544":114064,"_5":14097,"_26932":113915,"_2867":48659},[],{"_3381":68691,"_29612":68632,"_20544":114066,"_5":14097,"_26932":113915,"_2867":48662},[],{"_3381":68692,"_29612":68632,"_20544":114068,"_5":14097,"_26932":113915,"_2867":114069},[],"Dominio usado por la UI, OIDC y el certificado",{"_3381":68693,"_29612":68632,"_20544":114071,"_5":14097,"_26932":113915,"_2867":48668},[],{"_3381":68694,"_29612":68632,"_20544":114073,"_5":14097,"_26932":113915,"_2867":14789},[],{"_3381":68695,"_29612":68632,"_20544":114075,"_5":14097,"_26932":113915,"_2867":114076},[],"Versión del chart de Lamassu",{"_3381":68696,"_29612":68632,"_20544":114078,"_5":14097,"_26932":113915,"_2867":48676},[],{"_3381":68697,"_29612":68632,"_20544":114080,"_5":14097,"_26932":113915,"_2867":48679},[],{"_3381":68698,"_29612":68632,"_20544":114082,"_5":14097,"_26932":113915,"_2867":114083},[],"Puerto del listener HTTPS",{"_3381":68699,"_29612":68632,"_20544":114085,"_5":14097,"_26932":113915,"_2867":48685},[],{"_3381":68700,"_29612":68632,"_20544":114087,"_5":14097,"_26932":113915,"_2867":48688},[],{"_3381":68701,"_29612":68632,"_20544":114089,"_5":14097,"_26932":113915,"_2867":114090},[],"Puerto del listener HTTP",{"_3381":68702,"_29612":68632,"_20544":114092,"_5":14097,"_26932":113915,"_2867":48694},[],{"_3381":68703,"_29612":68632,"_20544":114094,"_5":14097,"_26932":113915,"_2867":48627},[],{"_3381":68704,"_29612":68632,"_20544":114096,"_5":14097,"_26932":113915,"_2867":114097},[],"Certificado PEM para TLS downstream",{"_3381":68705,"_29612":68632,"_20544":114099,"_5":14097,"_26932":113915,"_2867":48702},[],{"_3381":68706,"_29612":68632,"_20544":114101,"_5":14097,"_26932":113915,"_2867":48627},[],{"_3381":68707,"_29612":68632,"_20544":114103,"_5":14097,"_26932":113915,"_2867":114104},[],"Clave privada PEM para TLS downstream",{"_3381":68708,"_29612":68632,"_20544":114106,"_5":14097,"_26932":113915,"_2867":48710},[],{"_3381":68709,"_29612":68632,"_20544":114108,"_5":14097,"_26932":113915,"_2867":114109},[],"chart del repositorio",{"_3381":68710,"_29612":68632,"_20544":114111,"_5":14097,"_26932":113915,"_2867":114112},[],"Usa un chart local de Lamassu sin empaquetar",{"_3381":68711,"_29612":68632,"_20544":114114,"_5":14097,"_26932":113915,"_2867":48719},[],{"_3381":68712,"_29612":68632,"_20544":114116,"_5":14097,"_26932":113915,"_2867":114117},[],"detección automática",{"_3381":68713,"_29612":68632,"_20544":114119,"_5":14097,"_26932":113915,"_2867":114120},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3381":68714,"_29612":68632,"_20544":114122,"_5":14097,"_26932":113915,"_2867":48727},[],{"_3381":68715,"_29612":68632,"_20544":114124,"_5":14097,"_26932":113915,"_2867":6391},[],{"_3381":68716,"_29612":68632,"_20544":114126,"_5":14097,"_26932":113915,"_2867":114127},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3381":68717,"_29612":68632,"_20544":114129,"_5":14097,"_26932":113915,"_2867":48735},[],{"_3381":68718,"_29612":68632,"_20544":114131,"_5":14097,"_26932":113915,"_2867":6391},[],{"_3381":68719,"_29612":68632,"_20544":114133,"_5":14097,"_26932":113915,"_2867":114134},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3381":68720,"_29612":68632,"_20544":114136,"_5":14097,"_26932":113915,"_2867":48743},[],{"_3381":68721,"_29612":68632,"_20544":114138,"_5":14097,"_26932":113915,"_2867":6391},[],{"_3381":68722,"_29612":68632,"_20544":114140,"_5":14097,"_26932":113915,"_2867":114141},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3381":68723,"_29612":68632,"_20544":114143,"_5":14097,"_26932":113915,"_2867":48751},[],{"_3381":68724,"_29612":68632,"_20544":114145,"_5":14097,"_26932":113915,"_2867":6391},[],{"_3381":68725,"_29612":68632,"_20544":114147,"_5":14097,"_26932":113915,"_2867":114148},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3381":68726,"_29612":68632,"_20544":114150,"_5":14097,"_26932":113915,"_2867":48759},[],{"_3381":68727,"_29612":68632,"_20544":114152,"_5":14097,"_26932":113915,"_2867":48762},[],{"_3381":68728,"_29612":68632,"_20544":114154,"_5":14097,"_26932":113915,"_2867":114155},[],"Usa otro chart local de SoftHSM",{"_3381":68729,"_29612":68632,"_20544":114157,"_5":14097,"_26932":113915,"_2867":114158},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3381":68730,"_29612":68632,"_20544":114160,"_5":14097,"_26932":113919,"_2867":114161},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3381":68731,"_29612":68632,"_20544":114163,"_5":14097,"_26932":113919,"_2867":114164},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3381":68732,"_29612":68632,"_20544":114166,"_5":14097,"_26932":113919,"_2867":114167},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3381":68733,"_29612":68632,"_20544":114169,"_5":14097,"_26932":113919,"_2867":114170},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3381":68734,"_29612":68632,"_20544":114172,"_5":14097,"_26932":113919,"_2867":114173},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3381":68735,"_29612":68632,"_20544":114175,"_5":14097,"_26932":113919,"_2867":114176},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3381":68736,"_29612":68632,"_20544":114178,"_5":14097,"_26932":113923,"_2867":48789},[],{"_3381":68737,"_29612":68632,"_20544":114180,"_5":14097,"_26932":113923,"_2867":114181},[],"valida las herramientas locales y el clúster seleccionado",{"_3381":68738,"_29612":68632,"_20544":114183,"_5":14097,"_26932":113923,"_2867":114184},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3381":68739,"_29612":68632,"_20544":114186,"_5":14097,"_26932":113923,"_2867":114187},[],"crea el namespace",{"_3381":68740,"_29612":68632,"_20544":114189,"_5":14097,"_26932":113923,"_2867":114190},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3381":68741,"_29612":68632,"_20544":114192,"_5":14097,"_26932":113923,"_2867":114193},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3381":68742,"_29612":68632,"_20544":114195,"_5":14097,"_26932":113923,"_2867":114196},[],"instala RabbitMQ",{"_3381":68743,"_29612":68632,"_20544":114198,"_5":14097,"_26932":113923,"_2867":114199},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3381":68744,"_29612":68632,"_20544":114201,"_5":14097,"_26932":113923,"_2867":114202},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_3381":68745,"_29612":68632,"_20544":114204,"_5":14097,"_26932":113923,"_2867":114205},[],"carga datos de ejemplo opcionalmente",{"_3381":68746,"_29612":68632,"_20544":114207,"_5":14097,"_26932":113923,"_2867":114208},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3381":68747,"_29612":68632,"_20544":114210,"_5":14097,"_26932":113927,"_2867":114211},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3381":68748,"_29612":68632,"_20544":114213,"_5":14097,"_26932":113927,"_2867":114214},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3381":68749,"_29612":68632,"_20544":114216,"_5":14097,"_26932":113931,"_2867":114217},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3381":68750,"_29612":68632,"_20544":114219,"_5":14097,"_26932":113931,"_2867":114220},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_3381":68751,"_29612":68632,"_20544":114222,"_5":14097,"_26932":113931,"_2867":114223},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3381":68752,"_29612":68632,"_20544":114225,"_5":14097,"_26932":113935,"_2867":114226},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3381":68753,"_29612":68753,"_5":14455,"_2867":114228,"_29965":114229,"_20544":114230,"_26932":68753},"Instala con Helm",[48231,113654,113888],[],{"_3381":68754,"_29612":68753,"_20544":114232,"_5":14097,"_26932":68753,"_2867":114233},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3381":68755,"_29612":68753,"_5":29962,"_20544":114235,"_26932":114236,"_2867":114237},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3381":68756,"_29612":68753,"_5":29962,"_20544":114239,"_26932":114240,"_2867":113904},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3381":68757,"_29612":68753,"_5":29962,"_20544":114242,"_26932":114243,"_2867":114244},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3381":68758,"_29612":68753,"_5":29962,"_20544":114246,"_26932":114247,"_2867":114248},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3381":68759,"_29612":68753,"_5":29962,"_20544":114250,"_26932":114251,"_2867":114252},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3381":68760,"_29612":68753,"_5":29962,"_20544":114254,"_26932":114255,"_2867":114256},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/helm#tls-de-amqp-amqps","TLS de AMQP (AMQPS)",{"_3381":68761,"_29612":68753,"_5":29962,"_20544":114258,"_26932":114259,"_2867":114260},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3381":68762,"_29612":68753,"_5":29962,"_20544":114262,"_26932":114263,"_2867":114264},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3381":68763,"_29612":68753,"_5":29962,"_20544":114266,"_26932":114267,"_2867":114268},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3381":68764,"_29612":68753,"_5":29962,"_20544":114270,"_26932":114271,"_2867":114272},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/helm#actualiza-lamassu","Actualiza Lamassu",{"_3381":68765,"_29612":68753,"_5":29962,"_20544":114274,"_26932":114275,"_2867":114276},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3381":68766,"_29612":68753,"_20544":114278,"_5":14097,"_26932":114236,"_2867":114279},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3381":68767,"_29612":68753,"_20544":114281,"_5":14097,"_26932":114240,"_2867":114282},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3381":68768,"_29612":68753,"_20544":114284,"_5":14097,"_26932":114240,"_2867":114285},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3381":68769,"_29612":68753,"_20544":114287,"_5":14097,"_26932":114240,"_2867":114288},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3381":68770,"_29612":68753,"_20544":114290,"_5":14097,"_26932":114240,"_2867":114291},[],"un broker RabbitMQ accesible y sus credenciales",{"_3381":68771,"_29612":68753,"_20544":114293,"_5":14097,"_26932":114240,"_2867":114294},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3381":68772,"_29612":68753,"_20544":114296,"_5":14097,"_26932":114240,"_2867":114297},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3381":68773,"_29612":68753,"_20544":114299,"_5":14097,"_26932":114240,"_2867":114300},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3381":68774,"_29612":68753,"_20544":114302,"_5":14097,"_26932":114240,"_2867":114303},[],"una StorageClass y un diseño de tráfico externo",{"_3381":68775,"_29612":68753,"_20544":114305,"_5":14097,"_26932":114240,"_2867":114306},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3381":68776,"_29612":68753,"_20544":114308,"_5":14097,"_26932":114240,"_2867":114309},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3381":68777,"_29612":68753,"_20544":114311,"_5":14097,"_26932":114240,"_2867":114312},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3381":68778,"_29612":68753,"_20544":114314,"_5":14097,"_26932":114243,"_2867":114315},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3381":68779,"_29612":68753,"_20544":114317,"_5":14097,"_26932":114243,"_2867":114318},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3381":68780,"_29612":68753,"_20544":114320,"_5":14097,"_26932":114243,"_2867":114321},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_3381":68781,"_29612":68753,"_20544":114323,"_5":14097,"_26932":114247,"_2867":114324},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3381":68782,"_29612":68753,"_20544":114326,"_5":14097,"_26932":114247,"_2867":114327},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3381":68783,"_29612":68753,"_20544":114329,"_5":14097,"_26932":114247,"_2867":114330},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3381":68784,"_29612":68753,"_20544":114332,"_5":14097,"_26932":114247,"_2867":114333},[],"Si tu archivo de valores aún contiene los ajustes heredados de validación JWT del Gateway — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` o `auth.authorization.roles.admin` — elimínalos. La guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documenta su eliminación sin alias de compatibilidad, y `values.schema.json` rechaza los bloques residuales en lugar de ignorarlos silenciosamente. Los reemplazos son `services.authz.jwkUrl` y `services.authz.bootstrap`, que ya aparecen en el ejemplo anterior.",{"_3381":68785,"_29612":68753,"_20544":114335,"_5":14097,"_26932":114251,"_2867":114336},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_3381":68786,"_29612":68753,"_20544":114338,"_5":14097,"_26932":114255,"_2867":114339},[],"`amqp.tls: true` selecciona AMQPS en todos los bloques de configuración del bus de eventos. El puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS, así que define `amqp.port` con el listener TLS del broker, normalmente `5671`.",{"_3381":68787,"_29612":68753,"_20544":114341,"_5":14097,"_26932":114255,"_2867":114342},[],"Sin un Secret de CA configurado, los clientes del bus de eventos usan las CA de confianza del sistema. Para confiar en una CA privada, crea un Secret en el namespace del release con el certificado de la CA en formato PEM y define `amqp.ca.secretName` (y `amqp.ca.certificateKey` si la clave de datos no es `ca.crt`).",{"_3381":68788,"_29612":68753,"_20544":114344,"_5":14097,"_26932":114255,"_2867":114345},[],"Para brokers que exijan TLS mutuo, crea un Secret con el certificado de cliente y su clave privada y define `amqp.client.secretName` (con `amqp.client.certificateKey` y `amqp.client.privateKeyKey` si las claves de datos no son `tls.crt` y `tls.key`).",{"_3381":68789,"_29612":68753,"_20544":114347,"_5":14097,"_26932":114255,"_2867":114348},[],"El chart monta los Secrets configurados en modo de solo lectura en todas las cargas de trabajo que consumen AMQP: el certificado de la CA en `/etc/lamassu/amqp/ca` y el certificado y la clave de cliente en `/etc/lamassu/amqp/client`. Los nombres de los archivos montados son siempre `ca.crt`, `tls.crt` y `tls.key` — los valores `certificateKey` y `privateKeyKey` renombran solo las claves de datos del Secret, nunca las rutas en disco. La clave privada del cliente se monta con permisos restrictivos (`defaultMode: 0440`; el volumen de la CA usa `0444`), que funcionan porque el chart añade `fsGroup` al security context del pod cuando `amqp.client.secretName` está definido — usa el `runAsGroup` del contenedor (por defecto `65532`) cuando `fsGroup` no está ya definido.",{"_3381":68790,"_29612":68753,"_20544":114350,"_5":14097,"_26932":114255,"_2867":114351},[],"Ambas opciones de Secret exigen `amqp.tls: true`: `values.schema.json` rechaza un `secretName` no vacío cuando `tls` es false, rechaza claves desconocidas y rechaza nombres de clave de datos fuera de `^[A-Za-z0-9._-]+$`. El Secret referenciado debe existir en el namespace del release o los pods consumidores no llegan a arrancar.",{"_3381":68791,"_29612":68753,"_20544":114353,"_5":14097,"_26932":114255,"_2867":114354},[],"El cliente AMQP carga los certificados al arrancar, así que reinicia los pods consumidores tras actualizar cualquiera de los dos Secrets. Cambiar cualquier valor de `amqp` reinicia las cargas de trabajo consumidoras mediante la anotación `checksum/config`, pero cambiar solo el contenido de un Secret no desencadena un rollout.",{"_3381":68792,"_29612":68753,"_20544":114356,"_5":14097,"_26932":114255,"_2867":114357},[],"Según la guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: en 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos usaban AMQP en claro; desde 4.0.0, `amqp.tls: true` los cambia a AMQPS. Define `amqp.port` con el listener TLS del broker antes del upgrade, o usa `amqp.tls: false` para mantener AMQP en claro. `amqp.tls: false` envía las credenciales del broker y todo el tráfico del bus de eventos en claro.",{"_3381":68793,"_29612":68753,"_20544":114359,"_5":14097,"_26932":114259,"_2867":114360},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3381":68794,"_29612":68753,"_20544":114362,"_5":14097,"_26932":114259,"_2867":114363},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3381":68795,"_29612":68753,"_20544":114365,"_5":14097,"_26932":114259,"_2867":114366},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3381":68796,"_29612":68753,"_20544":114368,"_5":14097,"_26932":114259,"_2867":114369},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3381":68797,"_29612":68753,"_20544":114371,"_5":14097,"_26932":114263,"_2867":114372},[],"Para instalar un checkout local:",{"_3381":68798,"_29612":68753,"_20544":114374,"_5":14097,"_26932":114267,"_2867":114375},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3381":68799,"_29612":68753,"_20544":114377,"_5":14097,"_26932":114267,"_2867":114378},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3381":68800,"_29612":68753,"_20544":114380,"_5":14097,"_26932":114271,"_2867":114381},[],"Los pasos de upgrade específicos de cada versión se mantienen en `charts/lamassu/CHANGELOG/` dentro del repositorio Helm. El chart también incluye un job de pre-upgrade opcional que migra las claves privadas de CA existentes al motor KMS configurado para el release. Está desactivado por defecto (`migrations.caToKms.enabled: false`) y solo es necesario cuando actualizas desde una versión anterior a 3.7.0.",{"_3381":68801,"_29612":68753,"_20544":114383,"_5":14097,"_26932":114271,"_2867":114384},[],"Mientras el flag esté activo, cada `helm upgrade` crea el job `<chart fullname>-ca-to-kms-migration` (`lamassu-ca-to-kms-migration` para el release `lamassu`); una instalación nueva no lo crea. Su hook weight es `-10`, por lo que se ejecuta antes de los otros hooks de pre-upgrade: la configuración de bootstrap de autorización (peso `-4`) y el job de migración de base de datos (peso `-3`).",{"_3381":68802,"_29612":68753,"_20544":114386,"_5":14097,"_26932":114271,"_2867":114387},[],"El job consume la misma configuración del servicio KMS que el chart renderiza en el ConfigMap de KMS, incluidos los motores de `services.kms.cryptoEngines`, y ejecuta la imagen de la herramienta de migración definida en `migrations.caToKms.image`. La monta en modo read-only en `/etc/lamassuiot/config.yml` desde la clave `config` del ConfigMap, así que configura el motor de destino en tus valores antes del upgrade que realiza la migración.",{"_3381":68803,"_29612":68753,"_20544":114389,"_5":14097,"_26932":114271,"_2867":114390},[],"El job resuelve su configuración mediante un volumen proyectado con dos fuentes opcionales: el ConfigMap `<chart fullname>-kms-config`, cuyo nombre incorpora el release (`lamassu-kms-config` para el release `lamassu`, `prod-lamassu-kms-config` para el release `prod`), y el ConfigMap legacy `kms-config`, sin el nombre del release, creado por versiones anteriores del chart. La configuración legacy mantiene la autoridad mientras siga presente y el job usa el ConfigMap del release una vez el legacy desaparece. Ambas fuentes son opcionales, por lo que un ConfigMap ausente nunca deja el pod del upgrade en `ContainerCreating`.",{"_3381":68804,"_29612":68753,"_20544":114392,"_5":14097,"_26932":114271,"_2867":114393},[],"Mantén `migrations.caToKms.enabled: true` en el upgrade que realiza la migración y elimina después el flag de tus valores una vez completada la migración; su valor por defecto es `false`.",{"_3381":68805,"_29612":68753,"_20544":114395,"_5":14097,"_26932":114275,"_2867":114396},[],"Antes de pasar a producción, revisa:",{"_3381":68806,"_29612":68753,"_20544":114398,"_5":14097,"_26932":114275,"_2867":114399},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3381":68807,"_29612":68753,"_20544":114401,"_5":14097,"_26932":114275,"_2867":114402},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3381":68808,"_29612":68753,"_20544":114404,"_5":14097,"_26932":114275,"_2867":114405},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3381":68809,"_29612":68753,"_20544":114407,"_5":14097,"_26932":114275,"_2867":114408},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3381":68810,"_29612":68753,"_20544":114410,"_5":14097,"_26932":114275,"_2867":114411},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3381":68811,"_29612":68753,"_20544":114413,"_5":14097,"_26932":114275,"_2867":114414},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3381":68812,"_29612":68753,"_20544":114416,"_5":14097,"_26932":114275,"_2867":114417},[],"SMTP, observabilidad y entrega de alertas",{"_3381":68813,"_29612":68753,"_20544":114419,"_5":14097,"_26932":114275,"_2867":114420},[],"las guías de actualización entre versiones y las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade, incluido el hook opcional de migración CA-to-KMS descrito arriba",{"_3381":68814,"_29612":68753,"_20544":114422,"_5":14097,"_26932":114275,"_2867":114423},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3381":68815,"_29612":68815,"_5":14455,"_2867":114425,"_29965":114426,"_20544":114427,"_26932":68815},"Expón el Gateway",[48231,113654,113888],[],{"_3381":68816,"_29612":68815,"_20544":114429,"_5":14097,"_26932":68815,"_2867":114430},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3381":68817,"_29612":68815,"_5":29962,"_20544":114432,"_26932":114433,"_2867":114434},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3381":68818,"_29612":68815,"_5":29962,"_20544":114436,"_26932":114437,"_2867":114438},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3381":68819,"_29612":68815,"_5":29962,"_20544":114440,"_26932":114441,"_2867":114442},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3381":68820,"_29612":68815,"_5":29962,"_20544":114444,"_26932":114445,"_2867":49057},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/networking#k3s",{"_3381":68821,"_29612":68815,"_5":29962,"_20544":114447,"_26932":114448,"_2867":114449},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3381":68822,"_29612":68815,"_5":29962,"_20544":114451,"_26932":114452,"_2867":114453},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3381":68823,"_29612":68815,"_5":29962,"_20544":114455,"_26932":114456,"_2867":114457},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3381":68824,"_29612":68815,"_5":29962,"_20544":114459,"_26932":114460,"_2867":114461},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3381":68825,"_29612":68815,"_5":29962,"_20544":114463,"_26932":114464,"_2867":114465},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/networking#proxy-de-salida","Proxy de salida",{"_3381":68826,"_29612":68815,"_5":29962,"_20544":114467,"_26932":114468,"_2867":114469},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3381":68827,"_29612":68815,"_20544":114471,"_5":14097,"_26932":114433,"_2867":114472},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3381":68828,"_29612":68815,"_20544":114474,"_5":14097,"_26932":114433,"_2867":114475},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3381":68829,"_29612":68815,"_20544":114477,"_5":14097,"_26932":114437,"_2867":114478},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3381":68830,"_29612":68815,"_20544":114480,"_5":14097,"_26932":114437,"_2867":114481},[],"Defínelo únicamente cuando:",{"_3381":68831,"_29612":68815,"_20544":114483,"_5":14097,"_26932":114437,"_2867":114484},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3381":68832,"_29612":68815,"_20544":114486,"_5":14097,"_26932":114437,"_2867":114487},[],"esa dirección está asignada a este Gateway",{"_3381":68833,"_29612":68815,"_20544":114489,"_5":14097,"_26932":114437,"_2867":114490},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3381":68834,"_29612":68815,"_20544":114492,"_5":14097,"_26932":114437,"_2867":114493},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3381":68835,"_29612":68815,"_20544":114495,"_5":14097,"_26932":114437,"_2867":114496},[],"No confundas estos valores:",{"_3381":68836,"_29612":68815,"_20544":114498,"_5":14097,"_26932":114437,"_2867":114499},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3381":68837,"_29612":68815,"_20544":114501,"_5":14097,"_26932":114437,"_2867":114502},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3381":68838,"_29612":68815,"_20544":114504,"_5":14097,"_26932":114437,"_2867":114505},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3381":68839,"_29612":68815,"_20544":114507,"_5":14097,"_26932":114441,"_2867":114508},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3381":68840,"_29612":68815,"_20544":114510,"_5":14097,"_26932":114441,"_2867":114511},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3381":68841,"_29612":68815,"_20544":114513,"_5":14097,"_26932":114445,"_2867":114514},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3381":68842,"_29612":68815,"_20544":114516,"_5":14097,"_26932":114445,"_2867":114517},[],"Para el diseño recomendado:",{"_3381":68843,"_29612":68815,"_20544":114519,"_5":14097,"_26932":114445,"_2867":114520},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3381":68844,"_29612":68815,"_20544":114522,"_5":14097,"_26932":114445,"_2867":114523},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3381":68845,"_29612":68815,"_20544":114525,"_5":14097,"_26932":114445,"_2867":114526},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3381":68846,"_29612":68815,"_20544":114528,"_5":14097,"_26932":114445,"_2867":114529},[],"Apunta DNS a la dirección accesible de la VM.",{"_3381":68847,"_29612":68815,"_20544":114531,"_5":14097,"_26932":114445,"_2867":114532},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3381":68848,"_29612":68815,"_20544":114534,"_5":14097,"_26932":114448,"_2867":114535},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3381":68849,"_29612":68815,"_20544":114537,"_5":14097,"_26932":114452,"_2867":114538},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3381":68850,"_29612":68815,"_20544":114540,"_5":14097,"_26932":114452,"_2867":114541},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3381":68851,"_29612":68815,"_20544":114543,"_5":14097,"_26932":114456,"_2867":114544},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3381":68852,"_29612":68815,"_20544":114546,"_5":14097,"_26932":114456,"_2867":114547},[],"Requisito",{"_3381":68853,"_29612":68815,"_20544":114549,"_5":14097,"_26932":114456,"_2867":114550},[],"Diseño recomendado",{"_3381":68854,"_29612":68815,"_20544":114552,"_5":14097,"_26932":114456,"_2867":114553},[],"Consecuencia",{"_3381":68855,"_29612":68815,"_20544":114555,"_5":14097,"_26932":114456,"_2867":114556},[],"Varias URL o servicios de Lamassu",{"_3381":68856,"_29612":68815,"_20544":114558,"_5":14097,"_26932":114456,"_2867":114559},[],"Un Gateway con varias rutas",{"_3381":68857,"_29612":68815,"_20544":114561,"_5":14097,"_26932":114456,"_2867":114562},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3381":68858,"_29612":68815,"_20544":114564,"_5":14097,"_26932":114456,"_2867":114565},[],"Gateways independientes e IP externas distintas",{"_3381":68859,"_29612":68815,"_20544":114567,"_5":14097,"_26932":114456,"_2867":114568},[],"Una VIP por Gateway",{"_3381":68860,"_29612":68815,"_20544":114570,"_5":14097,"_26932":114456,"_2867":114571},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3381":68861,"_29612":68815,"_20544":114573,"_5":14097,"_26932":114456,"_2867":114574},[],"Gateways independientes, un nodo y una IP",{"_3381":68862,"_29612":68815,"_20544":114576,"_5":14097,"_26932":114456,"_2867":114577},[],"Puertos externos diferentes",{"_3381":68863,"_29612":68815,"_20544":114579,"_5":14097,"_26932":114456,"_2867":114580},[],"Los clientes deben indicar puertos no estándar",{"_3381":68864,"_29612":68815,"_20544":114582,"_5":14097,"_26932":114456,"_2867":114583},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3381":68865,"_29612":68815,"_20544":114585,"_5":14097,"_26932":114456,"_2867":114586},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3381":68866,"_29612":68815,"_20544":114588,"_5":14097,"_26932":114456,"_2867":114589},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3381":68867,"_29612":68815,"_20544":114591,"_5":14097,"_26932":114456,"_2867":114592},[],"Recursos Gateway separados pero proxy compartido",{"_3381":68868,"_29612":68815,"_20544":114594,"_5":14097,"_26932":114456,"_2867":114595},[],"Modo merged Gateway de Envoy",{"_3381":68869,"_29612":68815,"_20544":114597,"_5":14097,"_26932":114456,"_2867":114598},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3381":68870,"_29612":68815,"_20544":114600,"_5":14097,"_26932":114456,"_2867":114601},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3381":68871,"_29612":68815,"_20544":114603,"_5":14097,"_26932":114456,"_2867":114604},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3381":68872,"_29612":68815,"_20544":114606,"_5":14097,"_26932":114456,"_2867":114607},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3381":68873,"_29612":68815,"_20544":114609,"_5":14097,"_26932":114456,"_2867":114610},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3381":68874,"_29612":68815,"_20544":114612,"_5":14097,"_26932":114460,"_2867":114613},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3381":68875,"_29612":68815,"_20544":114615,"_5":14097,"_26932":114460,"_2867":114616},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3381":68876,"_29612":68815,"_20544":114618,"_5":14097,"_26932":114460,"_2867":114619},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3381":68877,"_29612":68815,"_20544":114621,"_5":14097,"_26932":114460,"_2867":114622},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3381":68878,"_29612":68815,"_20544":114624,"_5":14097,"_26932":114460,"_2867":114625},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3381":68879,"_29612":68815,"_20544":114627,"_5":14097,"_26932":114464,"_2867":114628},[],"Los clientes internos de Lamassu — la conexión con el motor de Vault, las llamadas entre servicios y los webhooks salientes — respetan las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY`. La excepción es el conector del motor de autorización: usa su propio transporte y no consulta estas variables de proxy. Si tu despliegue enruta el tráfico de salida por un proxy, incluye los nombres de servicio internos del clúster en `NO_PROXY` (por ejemplo `.svc,.cluster.local`) para que el tráfico interno permanezca dentro del clúster. El tráfico de loopback nunca se envía por un proxy.",{"_3381":68880,"_29612":68815,"_20544":114630,"_5":14097,"_26932":114464,"_2867":114631},[],"El transporte predeterminado de estos clientes acota el timeout de conexión (30 segundos), el handshake TLS (10 segundos) y la reutilización de conexiones inactivas (90 segundos), de modo que una dependencia inalcanzable falla rápido en lugar de bloquearse; estos valores son los predeterminados del transporte de Go, no configuración de Lamassu. HTTP/2 se negocia cuando el otro extremo lo soporta. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada.",{"_3381":68881,"_29612":68815,"_20544":114633,"_5":14097,"_26932":114468,"_2867":114634},[],"Comprueba, en orden:",{"_3381":68882,"_29612":68815,"_20544":114636,"_5":14097,"_26932":114468,"_2867":114637},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3381":68883,"_29612":68815,"_20544":114639,"_5":14097,"_26932":114468,"_2867":114640},[],"Su estado contiene la dirección esperada.",{"_3381":68884,"_29612":68815,"_20544":114642,"_5":14097,"_26932":114468,"_2867":114643},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3381":68885,"_29612":68815,"_20544":114645,"_5":14097,"_26932":114468,"_2867":114646},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3381":68886,"_29612":68815,"_20544":114648,"_5":14097,"_26932":114468,"_2867":114649},[],"DNS resuelve al endpoint accesible externamente.",{"_3381":68887,"_29612":68815,"_20544":114651,"_5":14097,"_26932":114468,"_2867":114652},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3381":68888,"_29612":68815,"_20544":114654,"_5":14097,"_26932":114468,"_2867":114655},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3381":68889,"_29612":68889,"_5":14455,"_2867":48338,"_29965":114657,"_20544":114658,"_26932":68889},[48231,113654,113888],[],{"_3381":68890,"_29612":68889,"_20544":114660,"_5":14097,"_26932":68889,"_2867":114661},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3381":68891,"_29612":68889,"_5":29962,"_20544":114663,"_26932":114664,"_2867":114665},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3381":68892,"_29612":68889,"_5":29962,"_20544":114667,"_26932":114668,"_2867":114669},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3381":68893,"_29612":68889,"_5":29962,"_20544":114671,"_26932":114672,"_2867":114673},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3381":68894,"_29612":68889,"_5":29962,"_20544":114675,"_26932":114676,"_2867":114677},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3381":68895,"_29612":68889,"_5":29962,"_20544":114679,"_26932":114680,"_2867":114681},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3381":68896,"_29612":68889,"_5":29962,"_20544":114683,"_26932":114684,"_2867":114685},[],"/docs/pr-preview/pr-53/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3381":68897,"_29612":68889,"_20544":114687,"_5":14097,"_26932":114664,"_2867":114688},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3381":68898,"_29612":68889,"_20544":114690,"_5":14097,"_26932":114668,"_2867":114691},[],"Flujo",{"_3381":68899,"_29612":68889,"_20544":114693,"_5":14097,"_26932":114668,"_2867":114694},[],"Úsalo para",{"_3381":68900,"_29612":68889,"_20544":114696,"_5":14097,"_26932":114668,"_2867":114697},[],"Qué instala",{"_3381":68901,"_29612":68889,"_20544":114699,"_5":14097,"_26932":114668,"_2867":49312},[],{"_3381":68902,"_29612":68889,"_20544":114701,"_5":14097,"_26932":114668,"_2867":114702},[],"Producción y entornos controlados",{"_3381":68903,"_29612":68889,"_20544":114704,"_5":14097,"_26932":114668,"_2867":114705},[],"Servicios de Lamassu y recursos de Gateway API",{"_3381":68904,"_29612":68889,"_20544":114707,"_5":14097,"_26932":114668,"_2867":48475},[],{"_3381":68905,"_29612":68889,"_20544":114709,"_5":14097,"_26932":114668,"_2867":114710},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3381":68906,"_29612":68889,"_20544":114712,"_5":14097,"_26932":114668,"_2867":114713},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3381":68907,"_29612":68889,"_20544":114715,"_5":14097,"_26932":114672,"_2867":114716},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3381":68908,"_29612":68889,"_20544":114718,"_5":14097,"_26932":114672,"_2867":114719},[],"Área",{"_3381":68909,"_29612":68889,"_20544":114721,"_5":14097,"_26932":114672,"_2867":114722},[],"El chart de Lamassu proporciona",{"_3381":68910,"_29612":68889,"_20544":114724,"_5":14097,"_26932":114672,"_2867":114725},[],"Tú proporcionas",{"_3381":68911,"_29612":68889,"_20544":114727,"_5":14097,"_26932":114672,"_2867":114728},[],"Aplicaciones Lamassu",{"_3381":68912,"_29612":68889,"_20544":114730,"_5":14097,"_26932":114672,"_2867":114731},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3381":68913,"_29612":68889,"_20544":114733,"_5":14097,"_26932":114672,"_2867":114734},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3381":68914,"_29612":68889,"_20544":114736,"_5":14097,"_26932":114672,"_2867":114737},[],"Datos PostgreSQL",{"_3381":68915,"_29612":68889,"_20544":114739,"_5":14097,"_26932":114672,"_2867":114740},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3381":68916,"_29612":68889,"_20544":114742,"_5":14097,"_26932":114672,"_2867":114743},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3381":68917,"_29612":68889,"_20544":114745,"_5":14097,"_26932":114672,"_2867":114746},[],"Mensajería",{"_3381":68918,"_29612":68889,"_20544":114748,"_5":14097,"_26932":114672,"_2867":114749},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu; la conexión puede usar AMQPS, con una CA privada y un certificado de cliente opcionales, definidos mediante valores del chart",{"_3381":68919,"_29612":68889,"_20544":114751,"_5":14097,"_26932":114672,"_2867":114752},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3381":68920,"_29612":68889,"_20544":114754,"_5":14097,"_26932":114672,"_2867":114755},[],"Identidad",{"_3381":68921,"_29612":68889,"_20544":114757,"_5":14097,"_26932":114672,"_2867":114758},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3381":68922,"_29612":68889,"_20544":114760,"_5":14097,"_26932":114672,"_2867":114761},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3381":68923,"_29612":68889,"_20544":114763,"_5":14097,"_26932":114672,"_2867":114764},[],"Enrutamiento externo",{"_3381":68924,"_29612":68889,"_20544":114766,"_5":14097,"_26932":114672,"_2867":114767},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3381":68925,"_29612":68889,"_20544":114769,"_5":14097,"_26932":114672,"_2867":114770},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3381":68926,"_29612":68889,"_20544":114772,"_5":14097,"_26932":114672,"_2867":49386},[],{"_3381":68927,"_29612":68889,"_20544":114774,"_5":14097,"_26932":114672,"_2867":114775},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_3381":68928,"_29612":68889,"_20544":114777,"_5":14097,"_26932":114672,"_2867":114778},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3381":68929,"_29612":68889,"_20544":114780,"_5":14097,"_26932":114672,"_2867":114781},[],"Datos persistentes de la aplicación",{"_3381":68930,"_29612":68889,"_20544":114783,"_5":14097,"_26932":114672,"_2867":114784},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3381":68931,"_29612":68889,"_20544":114786,"_5":14097,"_26932":114672,"_2867":114787},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3381":68932,"_29612":68889,"_20544":114789,"_5":14097,"_26932":114672,"_2867":114790},[],"Integraciones opcionales",{"_3381":68933,"_29612":68889,"_20544":114792,"_5":14097,"_26932":114672,"_2867":114793},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3381":68934,"_29612":68889,"_20544":114795,"_5":14097,"_26932":114672,"_2867":114796},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3381":68935,"_29612":68889,"_20544":114798,"_5":14097,"_26932":114672,"_2867":114799},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3381":68936,"_29612":68889,"_20544":114801,"_5":14097,"_26932":114672,"_2867":114802},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3381":68937,"_29612":68889,"_20544":114804,"_5":14097,"_26932":114676,"_2867":114805},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3381":68938,"_29612":68889,"_20544":114807,"_5":14097,"_26932":114676,"_2867":114808},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3381":68939,"_29612":68889,"_20544":114810,"_5":14097,"_26932":114680,"_2867":114811},[],"Kubernetes 1.24 o posterior",{"_3381":68940,"_29612":68889,"_20544":114813,"_5":14097,"_26932":114680,"_2867":114814},[],"Helm 3.2 o posterior",{"_3381":68941,"_29612":68889,"_20544":114816,"_5":14097,"_26932":114680,"_2867":114817},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3381":68942,"_29612":68889,"_20544":114819,"_5":14097,"_26932":114680,"_2867":114820},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_3381":68943,"_29612":68889,"_20544":114822,"_5":14097,"_26932":114680,"_2867":114823},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3381":68944,"_29612":68889,"_20544":114825,"_5":14097,"_26932":114680,"_2867":114826},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3381":68945,"_29612":68889,"_20544":114828,"_5":14097,"_26932":114680,"_2867":114829},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3381":68946,"_29612":68889,"_20544":114831,"_5":14097,"_26932":114684,"_2867":114832},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3381":68947,"_29612":68889,"_20544":114834,"_5":14097,"_26932":114684,"_2867":114835},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3381":68948,"_29612":68889,"_20544":114837,"_5":14097,"_26932":114684,"_2867":114838},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3381":68949,"_29612":68889,"_20544":114840,"_5":14097,"_26932":114684,"_2867":114841},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3381":68950,"_29612":68950,"_5":14455,"_2867":114843,"_29965":114844,"_20544":114846,"_26932":68950},"Resolución de problemas de despliegue",[48231,113654,114845],"Operación",[],{"_3381":68951,"_29612":68950,"_20544":114848,"_5":14097,"_26932":68950,"_2867":114849},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3381":68952,"_29612":68950,"_5":29962,"_20544":114851,"_26932":114852,"_2867":114853},[],"/docs/pr-preview/pr-53/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3381":68953,"_29612":68950,"_5":29962,"_20544":114855,"_26932":114856,"_2867":114857},[],"/docs/pr-preview/pr-53/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3381":68954,"_29612":68950,"_5":29962,"_20544":114859,"_26932":114860,"_2867":114861},[],"/docs/pr-preview/pr-53/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3381":68955,"_29612":68950,"_5":29962,"_20544":114863,"_26932":114864,"_2867":114865},[],"/docs/pr-preview/pr-53/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3381":68956,"_29612":68950,"_5":29962,"_20544":114867,"_26932":114868,"_2867":114869},[],"/docs/pr-preview/pr-53/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3381":68957,"_29612":68950,"_5":29962,"_20544":114871,"_26932":114872,"_2867":114873},[],"/docs/pr-preview/pr-53/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3381":68958,"_29612":68950,"_5":29962,"_20544":114875,"_26932":114876,"_2867":114877},[],"/docs/pr-preview/pr-53/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3381":68959,"_29612":68950,"_5":29962,"_20544":114879,"_26932":114880,"_2867":114881},[],"/docs/pr-preview/pr-53/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3381":68960,"_29612":68950,"_5":29962,"_20544":114883,"_26932":114884,"_2867":114885},[],"/docs/pr-preview/pr-53/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3381":68961,"_29612":68950,"_5":29962,"_20544":114887,"_26932":114888,"_2867":114889},[],"/docs/pr-preview/pr-53/es/deployment/troubleshooting#errores-500-de-la-api","Errores 500 de la API",{"_3381":68962,"_29612":68950,"_5":29962,"_20544":114891,"_26932":114892,"_2867":114893},[],"/docs/pr-preview/pr-53/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3381":68963,"_29612":68950,"_5":29962,"_20544":114895,"_26932":114896,"_2867":114897},[],"/docs/pr-preview/pr-53/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3381":68964,"_29612":68950,"_5":29962,"_20544":114899,"_26932":114900,"_2867":114901},[],"/docs/pr-preview/pr-53/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3381":68965,"_29612":68950,"_20544":114903,"_5":14097,"_26932":68950,"_2867":114904},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3381":68966,"_29612":68950,"_20544":114906,"_5":14097,"_26932":114856,"_2867":114907},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3381":68967,"_29612":68950,"_20544":114909,"_5":14097,"_26932":114860,"_2867":114910},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3381":68968,"_29612":68950,"_20544":114912,"_5":14097,"_26932":114864,"_2867":114913},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3381":68969,"_29612":68950,"_20544":114915,"_5":14097,"_26932":114868,"_2867":114916},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3381":68970,"_29612":68950,"_20544":114918,"_5":14097,"_26932":114872,"_2867":114919},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3381":68971,"_29612":68950,"_20544":114921,"_5":14097,"_26932":114876,"_2867":114922},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3381":68972,"_29612":68950,"_20544":114924,"_5":14097,"_26932":114876,"_2867":114925},[],"Ejecuta también la prueba de conectividad del chart:",{"_3381":68973,"_29612":68950,"_20544":114927,"_5":14097,"_26932":114876,"_2867":114928},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3381":68974,"_29612":68950,"_20544":114930,"_5":14097,"_26932":114876,"_2867":114931},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3381":68975,"_29612":68950,"_20544":114933,"_5":14097,"_26932":114880,"_2867":114934},[],"Si recibes un 401:",{"_3381":68976,"_29612":68950,"_20544":114936,"_5":14097,"_26932":114880,"_2867":114937},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3381":68977,"_29612":68950,"_20544":114939,"_5":14097,"_26932":114880,"_2867":114940},[],"verifica emisor, audiencia y expiración del token;",{"_3381":68978,"_29612":68950,"_20544":114942,"_5":14097,"_26932":114880,"_2867":114943},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3381":68979,"_29612":68950,"_20544":114945,"_5":14097,"_26932":114880,"_2867":114946},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3381":68980,"_29612":68950,"_20544":114948,"_5":14097,"_26932":114880,"_2867":114949},[],"Si el login termina pero las APIs devuelven 403:",{"_3381":68981,"_29612":68950,"_20544":114951,"_5":14097,"_26932":114880,"_2867":114952},[],"inspecciona los claims reales del token;",{"_3381":68982,"_29612":68950,"_20544":114954,"_5":14097,"_26932":114880,"_2867":114955},[],"confirma que coinciden con un principal activo;",{"_3381":68983,"_29612":68950,"_20544":114957,"_5":14097,"_26932":114880,"_2867":114958},[],"revisa las políticas concedidas al principal;",{"_3381":68984,"_29612":68950,"_20544":114960,"_5":14097,"_26932":114880,"_2867":114961},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3381":68985,"_29612":68950,"_20544":114963,"_5":14097,"_26932":114880,"_2867":114964},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3381":68986,"_29612":68950,"_20544":114966,"_5":14097,"_26932":114884,"_2867":114967},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3381":68987,"_29612":68950,"_20544":114969,"_5":14097,"_26932":114884,"_2867":114970},[],"Localiza el pod y Service de authz.",{"_3381":68988,"_29612":68950,"_20544":114972,"_5":14097,"_26932":114884,"_2867":114973},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3381":68989,"_29612":68950,"_20544":114975,"_5":14097,"_26932":114884,"_2867":114976},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3381":68990,"_29612":68950,"_20544":114978,"_5":14097,"_26932":114884,"_2867":114979},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3381":68991,"_29612":68950,"_20544":114981,"_5":14097,"_26932":114884,"_2867":114982},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3381":68992,"_29612":68950,"_20544":114984,"_5":14097,"_26932":114888,"_2867":114985},[],"Un 500 indica un fallo interno, como una base de datos no disponible. El cuerpo `{\"err\": ...}` incluye hoy el texto del error interno, que puede contener nombres de esquema, tabla y restricción y, en fallos de conexión, el host y el usuario de la base de datos (no la contraseña). Localiza la causa en el log del servicio con la hora de la petición, y no reenvíes el cuerpo a terceros ni lo muestres a usuarios finales. Es un defecto conocido de divulgación de información: está previsto devolver un mensaje genérico en los 500 y dejar el detalle solo en el log del servicio (seguimiento en lamassuiot#814). El conector de autorización también devuelve el error interno, en el campo `details.error`. Algunos errores de petición, como un tamaño de clave que el motor no admite, se devuelven también como 500.",{"_3381":68993,"_29612":68950,"_20544":114987,"_5":14097,"_26932":114892,"_2867":114988},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3381":68994,"_29612":68950,"_20544":114990,"_5":14097,"_26932":114892,"_2867":114991},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3381":68995,"_29612":68950,"_20544":114993,"_5":14097,"_26932":114892,"_2867":114994},[],"un Secret de CA o de certificado de cliente de AMQP inexistente referenciado por `amqp.ca.secretName` o `amqp.client.secretName`;",{"_3381":68996,"_29612":68950,"_20544":114996,"_5":14097,"_26932":114892,"_2867":114997},[],"volumen persistente sin enlazar;",{"_3381":68997,"_29612":68950,"_20544":114999,"_5":14097,"_26932":114892,"_2867":115000},[],"imagen inaccesible o política de pull incorrecta;",{"_3381":68998,"_29612":68950,"_20544":115002,"_5":14097,"_26932":114892,"_2867":115003},[],"configuración inválida del motor criptográfico;",{"_3381":68999,"_29612":68950,"_20544":115005,"_5":14097,"_26932":114892,"_2867":115006},[],"límites de CPU o memoria demasiado bajos;",{"_3381":69000,"_29612":68950,"_20544":115008,"_5":14097,"_26932":114892,"_2867":115009},[],"migración previa incompleta.",{"_3381":69001,"_29612":68950,"_20544":115011,"_5":14097,"_26932":114892,"_2867":115012},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3381":69002,"_29612":68950,"_20544":115014,"_5":14097,"_26932":114892,"_2867":115015},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3381":69003,"_29612":68950,"_20544":115017,"_5":14097,"_26932":114892,"_2867":115018},[],"Las llamadas internas ahora fallan rápido en lugar de bloquearse para los clientes cubiertos por Proxy de salida: los intentos de conexión agotan el tiempo tras 30 segundos y los handshakes TLS tras 10 segundos. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada. Si un proxy de salida gestiona el tráfico de salida del clúster, comprueba las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY` del pod e incluye los nombres de servicio internos en `NO_PROXY`.",{"_3381":69004,"_29612":68950,"_20544":115020,"_5":14097,"_26932":114896,"_2867":115021},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3381":69005,"_29612":68950,"_20544":115023,"_5":14097,"_26932":114896,"_2867":115024},[],"verifica que esté habilitado en el servicio emisor;",{"_3381":69006,"_29612":68950,"_20544":115026,"_5":14097,"_26932":114896,"_2867":115027},[],"comprueba conectividad y credenciales AMQP;",{"_3381":69007,"_29612":68950,"_20544":115029,"_5":14097,"_26932":114896,"_2867":115030},[],"revisa exchange, routing key, colas y consumidores;",{"_3381":69008,"_29612":68950,"_20544":115032,"_5":14097,"_26932":114896,"_2867":115033},[],"inspecciona dead-letter queues;",{"_3381":69009,"_29612":68950,"_20544":115035,"_5":14097,"_26932":114896,"_2867":115036},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3381":69010,"_29612":68950,"_20544":115038,"_5":14097,"_26932":114896,"_2867":115039},[],"Si `amqp.tls` está habilitado, revisa también la parte TLS:",{"_3381":69011,"_29612":68950,"_20544":115041,"_5":14097,"_26932":114896,"_2867":115042},[],"confirma que el listener del broker hable AMQPS en el puerto configurado — el puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS;",{"_3381":69012,"_29612":68950,"_20544":115044,"_5":14097,"_26932":114896,"_2867":115045},[],"si defines `amqp.ca.secretName`, confirma que el Secret exista en el namespace del release y que su clave de datos coincida con `amqp.ca.certificateKey` (por defecto `ca.crt`); si no defines `amqp.ca.secretName`, los clientes confían en las CA del sistema;",{"_3381":69013,"_29612":68950,"_20544":115047,"_5":14097,"_26932":114896,"_2867":115048},[],"recuerda que un Secret referenciado inexistente impide arrancar los pods consumidores;",{"_3381":69014,"_29612":68950,"_20544":115050,"_5":14097,"_26932":114896,"_2867":115051},[],"tras actualizar el Secret de la CA o del certificado de cliente, reinicia los pods consumidores: el cliente AMQP carga los certificados al arrancar.",{"_3381":69015,"_29612":68950,"_20544":115053,"_5":14097,"_26932":114896,"_2867":115054},[],"Consulta TLS de AMQP (AMQPS) para la configuración completa.",{"_3381":69016,"_29612":68950,"_20544":115056,"_5":14097,"_26932":114896,"_2867":115057},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3381":69017,"_29612":68950,"_20544":115059,"_5":14097,"_26932":114900,"_2867":115060},[],"El chart puede habilitar la instrumentación OpenTelemetry para los servicios que la admiten, incluido authz; no configura OpenTelemetry para el AWS Connector, wfx ni la UI. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, servicio y dependencia.",{"_3381":69018,"_29612":68950,"_20544":115062,"_5":14097,"_26932":114900,"_2867":115063},[],"Antes de cerrar una incidencia, guarda:",{"_3381":69019,"_29612":68950,"_20544":115065,"_5":14097,"_26932":114900,"_2867":115066},[],"causa confirmada;",{"_3381":69020,"_29612":68950,"_20544":115068,"_5":14097,"_26932":114900,"_2867":115069},[],"alcance temporal y recursos afectados;",{"_3381":69021,"_29612":68950,"_20544":115071,"_5":14097,"_26932":114900,"_2867":115072},[],"comandos o consultas utilizados;",{"_3381":69022,"_29612":68950,"_20544":115074,"_5":14097,"_26932":114900,"_2867":115075},[],"cambio aplicado y forma de revertirlo;",{"_3381":69023,"_29612":68950,"_20544":115077,"_5":14097,"_26932":114900,"_2867":115078},[],"validación desde un consumidor;",{"_3381":69024,"_29612":68950,"_20544":115080,"_5":14097,"_26932":114900,"_2867":115081},[],"acción preventiva y propietario.",{"_3381":69025,"_29612":69025,"_5":14455,"_2867":115083,"_29965":115084,"_20544":115087,"_26932":69025},"Control de acceso",[48231,115085,115086],"Plataforma","Administración",[],{"_3381":69026,"_29612":69025,"_20544":115089,"_5":14097,"_26932":69025,"_2867":115090},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3381":69027,"_29612":69025,"_5":29962,"_20544":115092,"_26932":115093,"_2867":115094},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3381":69028,"_29612":69025,"_5":29962,"_20544":115096,"_26932":115097,"_2867":115098},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3381":69029,"_29612":69025,"_5":29962,"_20544":115100,"_26932":115101,"_2867":115102},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3381":69030,"_29612":69025,"_5":29962,"_20544":115104,"_26932":115105,"_2867":115106},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3381":69031,"_29612":69025,"_5":29962,"_20544":115108,"_26932":115109,"_2867":115110},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3381":69032,"_29612":69025,"_5":29962,"_20544":115112,"_26932":115113,"_2867":115114},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3381":69033,"_29612":69025,"_5":29962,"_20544":115116,"_26932":115117,"_2867":115118},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3381":69034,"_29612":69025,"_5":29962,"_20544":115120,"_26932":115121,"_2867":115122},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3381":69035,"_29612":69025,"_5":29962,"_20544":115124,"_26932":115125,"_2867":115126},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3381":69036,"_29612":69025,"_5":29962,"_20544":115128,"_26932":115129,"_2867":115130},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3381":69037,"_29612":69025,"_5":29962,"_20544":115132,"_26932":115133,"_2867":115134},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3381":69038,"_29612":69025,"_5":29962,"_20544":115136,"_26932":115137,"_2867":115138},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3381":69039,"_29612":69025,"_5":29962,"_20544":115140,"_26932":115141,"_2867":115142},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3381":69040,"_29612":69025,"_5":29962,"_20544":115144,"_26932":115145,"_2867":115146},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3381":69041,"_29612":69025,"_5":29962,"_20544":115148,"_26932":115149,"_2867":115150},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3381":69042,"_29612":69025,"_5":29962,"_20544":115152,"_26932":115153,"_2867":114260},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3381":69043,"_29612":69025,"_5":29962,"_20544":115155,"_26932":115156,"_2867":115157},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3381":69044,"_29612":69025,"_5":29962,"_20544":115159,"_26932":115160,"_2867":115161},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_3381":69045,"_29612":69025,"_5":29962,"_20544":115163,"_26932":115164,"_2867":115165},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3381":69046,"_29612":69025,"_5":29962,"_20544":115167,"_26932":115168,"_2867":115169},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3381":69047,"_29612":69025,"_5":29962,"_20544":115171,"_26932":115172,"_2867":115173},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3381":69048,"_29612":69025,"_5":29962,"_20544":115175,"_26932":115176,"_2867":115177},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3381":69049,"_29612":69025,"_5":29962,"_20544":115179,"_26932":115180,"_2867":115181},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3381":69050,"_29612":69025,"_5":29962,"_20544":115183,"_26932":115184,"_2867":115185},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3381":69051,"_29612":69025,"_5":29962,"_20544":115187,"_26932":115188,"_2867":115189},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3381":69052,"_29612":69025,"_5":29962,"_20544":115191,"_26932":115192,"_2867":115193},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3381":69053,"_29612":69025,"_5":29962,"_20544":115195,"_26932":115196,"_2867":115197},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3381":69054,"_29612":69025,"_5":29962,"_20544":115199,"_26932":115200,"_2867":115201},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3381":69055,"_29612":69025,"_5":29962,"_20544":115203,"_26932":115204,"_2867":115205},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3381":69056,"_29612":69025,"_5":29962,"_20544":115207,"_26932":115208,"_2867":115209},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3381":69057,"_29612":69025,"_5":29962,"_20544":115211,"_26932":115212,"_2867":115213},[],"/docs/pr-preview/pr-53/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3381":69058,"_29612":69025,"_20544":115215,"_5":14097,"_26932":69025,"_2867":115216},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3381":69059,"_29612":69025,"_20544":115218,"_5":14097,"_26932":69025,"_2867":115219},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3381":69060,"_29612":69025,"_20544":115221,"_5":14097,"_26932":69025,"_2867":115222},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3381":69061,"_29612":69025,"_20544":115224,"_5":14097,"_26932":115093,"_2867":115225},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3381":69062,"_29612":69025,"_20544":115227,"_5":14097,"_26932":115093,"_2867":115228},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3381":69063,"_29612":69025,"_20544":115230,"_5":14097,"_26932":115093,"_2867":115231},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3381":69064,"_29612":69025,"_20544":115233,"_5":14097,"_26932":115093,"_2867":115234},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3381":69065,"_29612":69025,"_20544":115236,"_5":14097,"_26932":115093,"_2867":115237},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3381":69066,"_29612":69025,"_20544":115239,"_5":14097,"_26932":115093,"_2867":115240},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3381":69067,"_29612":69025,"_20544":115242,"_5":14097,"_26932":115097,"_2867":115243},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3381":69068,"_29612":69025,"_20544":115245,"_5":14097,"_26932":115097,"_2867":115246},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3381":69069,"_29612":69025,"_20544":115248,"_5":14097,"_26932":115101,"_2867":115249},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3381":69070,"_29612":69025,"_20544":115251,"_5":14097,"_26932":115101,"_2867":115252},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3381":69071,"_29612":69025,"_20544":115254,"_5":14097,"_26932":115101,"_2867":115255},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3381":69072,"_29612":69025,"_20544":115257,"_5":14097,"_26932":115101,"_2867":115258},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3381":69073,"_29612":69025,"_20544":115260,"_5":14097,"_26932":115101,"_2867":115261},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3381":69074,"_29612":69025,"_20544":115263,"_5":14097,"_26932":115101,"_2867":115264},[],"Carga por separado las políticas concedidas a cada principal.",{"_3381":69075,"_29612":69025,"_20544":115266,"_5":14097,"_26932":115101,"_2867":115267},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3381":69076,"_29612":69025,"_20544":115269,"_5":14097,"_26932":115101,"_2867":115270},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3381":69077,"_29612":69025,"_20544":115272,"_5":14097,"_26932":115101,"_2867":115273},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3381":69078,"_29612":69025,"_20544":115275,"_5":14097,"_26932":115101,"_2867":115276},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3381":69079,"_29612":69025,"_20544":115278,"_5":14097,"_26932":115101,"_2867":115279},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad.",{"_3381":69080,"_29612":69025,"_20544":115281,"_5":14097,"_26932":115101,"_2867":115282},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3381":69081,"_29612":69025,"_20544":115284,"_5":14097,"_26932":115105,"_2867":115285},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3381":69082,"_29612":69025,"_20544":115287,"_5":14097,"_26932":115105,"_2867":115288},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3381":69083,"_29612":69025,"_20544":115290,"_5":14097,"_26932":115105,"_2867":115291},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3381":69084,"_29612":69025,"_20544":115293,"_5":14097,"_26932":115105,"_2867":115294},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3381":69085,"_29612":69025,"_20544":115296,"_5":14097,"_26932":115105,"_2867":115297},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3381":69086,"_29612":69025,"_20544":115299,"_5":14097,"_26932":115105,"_2867":115300},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3381":69087,"_29612":69025,"_20544":115302,"_5":14097,"_26932":115105,"_2867":115303},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3381":69088,"_29612":69025,"_20544":115305,"_5":14097,"_26932":115105,"_2867":115306},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3381":69089,"_29612":69025,"_20544":115308,"_5":14097,"_26932":115109,"_2867":115309},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3381":69090,"_29612":69025,"_20544":115311,"_5":14097,"_26932":115109,"_2867":115312},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3381":69091,"_29612":69025,"_20544":115314,"_5":14097,"_26932":115109,"_2867":115315},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3381":69092,"_29612":69025,"_20544":115317,"_5":14097,"_26932":115109,"_2867":115318},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3381":69093,"_29612":69025,"_20544":115320,"_5":14097,"_26932":115109,"_2867":115321},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3381":69094,"_29612":69025,"_20544":115323,"_5":14097,"_26932":115109,"_2867":115324},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3381":69095,"_29612":69025,"_20544":115326,"_5":14097,"_26932":115109,"_2867":115327},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3381":69096,"_29612":69025,"_20544":115329,"_5":14097,"_26932":115109,"_2867":115330},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3381":69097,"_29612":69025,"_20544":115332,"_5":14097,"_26932":115109,"_2867":115333},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3381":69098,"_29612":69025,"_20544":115335,"_5":14097,"_26932":115109,"_2867":115336},[],"Las acciones se dividen en dos grupos:",{"_3381":69099,"_29612":69025,"_20544":115338,"_5":14097,"_26932":115109,"_2867":115339},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3381":69100,"_29612":69025,"_20544":115341,"_5":14097,"_26932":115109,"_2867":115342},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3381":69101,"_29612":69025,"_20544":115344,"_5":14097,"_26932":115109,"_2867":115345},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3381":69102,"_29612":69025,"_20544":115347,"_5":14097,"_26932":115113,"_2867":115348},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3381":69103,"_29612":69025,"_20544":115350,"_5":14097,"_26932":115113,"_2867":115351},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3381":69104,"_29612":69025,"_20544":115353,"_5":14097,"_26932":115113,"_2867":115354},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3381":69105,"_29612":69025,"_20544":115356,"_5":14097,"_26932":115117,"_2867":115357},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3381":69106,"_29612":69025,"_20544":115359,"_5":14097,"_26932":115117,"_2867":115360},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3381":69107,"_29612":69025,"_20544":115362,"_5":14097,"_26932":115117,"_2867":115363},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3381":69108,"_29612":69025,"_20544":115365,"_5":14097,"_26932":115117,"_2867":115366},[],"Los operadores implementados son:",{"_3381":69109,"_29612":69025,"_20544":115368,"_5":14097,"_26932":115117,"_2867":115369},[],"`equals`, para igualdad exacta;",{"_3381":69110,"_29612":69025,"_20544":115371,"_5":14097,"_26932":115117,"_2867":115372},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3381":69111,"_29612":69025,"_20544":115374,"_5":14097,"_26932":115117,"_2867":115375},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3381":69112,"_29612":69025,"_20544":115377,"_5":14097,"_26932":115117,"_2867":115378},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3381":69113,"_29612":69025,"_20544":115380,"_5":14097,"_26932":115121,"_2867":115381},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3381":69114,"_29612":69025,"_20544":115383,"_5":14097,"_26932":115121,"_2867":115384},[],"Los modos disponibles son:",{"_3381":69115,"_29612":69025,"_20544":115386,"_5":14097,"_26932":115121,"_2867":115387},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3381":69116,"_29612":69025,"_20544":115389,"_5":14097,"_26932":115121,"_2867":115390},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3381":69117,"_29612":69025,"_20544":115392,"_5":14097,"_26932":115121,"_2867":115393},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3381":69118,"_29612":69025,"_20544":115395,"_5":14097,"_26932":115121,"_2867":115396},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3381":69119,"_29612":69025,"_20544":115398,"_5":14097,"_26932":115121,"_2867":115399},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3381":69120,"_29612":69025,"_20544":115401,"_5":14097,"_26932":115121,"_2867":115402},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3381":69121,"_29612":69025,"_20544":115404,"_5":14097,"_26932":115125,"_2867":115405},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3381":69122,"_29612":69025,"_20544":115407,"_5":14097,"_26932":115125,"_2867":115408},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3381":69123,"_29612":69025,"_20544":115410,"_5":14097,"_26932":115125,"_2867":115411},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3381":69124,"_29612":69025,"_20544":115413,"_5":14097,"_26932":115125,"_2867":115414},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3381":69125,"_29612":69025,"_20544":115416,"_5":14097,"_26932":115133,"_2867":115417},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3381":69126,"_29612":69025,"_20544":115419,"_5":14097,"_26932":115133,"_2867":115420},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3381":69127,"_29612":69025,"_20544":115422,"_5":14097,"_26932":115137,"_2867":115423},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora y la de un dispositivo con su DMS. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3381":69128,"_29612":69025,"_20544":115425,"_5":14097,"_26932":115137,"_2867":115426},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3381":69129,"_29612":69025,"_20544":115428,"_5":14097,"_26932":115141,"_2867":115429},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3381":69130,"_29612":69025,"_20544":115431,"_5":14097,"_26932":115141,"_2867":115432},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3381":69131,"_29612":69025,"_20544":115434,"_5":14097,"_26932":115141,"_2867":115435},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3381":69132,"_29612":69025,"_20544":115437,"_5":14097,"_26932":115145,"_2867":115438},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3381":69133,"_29612":69025,"_20544":115440,"_5":14097,"_26932":115145,"_2867":115441},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3381":69134,"_29612":69025,"_20544":115443,"_5":14097,"_26932":115145,"_2867":115444},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3381":69135,"_29612":69025,"_20544":115446,"_5":14097,"_26932":115145,"_2867":115447},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3381":69136,"_29612":69025,"_20544":115449,"_5":14097,"_26932":115145,"_2867":115450},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3381":69137,"_29612":69025,"_20544":115452,"_5":14097,"_26932":115145,"_2867":115453},[],"Ten en cuenta que:",{"_3381":69138,"_29612":69025,"_20544":115455,"_5":14097,"_26932":115145,"_2867":115456},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3381":69139,"_29612":69025,"_20544":115458,"_5":14097,"_26932":115145,"_2867":115459},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3381":69140,"_29612":69025,"_20544":115461,"_5":14097,"_26932":115145,"_2867":115462},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3381":69141,"_29612":69025,"_20544":115464,"_5":14097,"_26932":115149,"_2867":115465},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3381":69142,"_29612":69025,"_20544":115467,"_5":14097,"_26932":115149,"_2867":115468},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3381":69143,"_29612":69025,"_20544":115470,"_5":14097,"_26932":115149,"_2867":115471},[],"acceso completo y de solo lectura a KMS;",{"_3381":69144,"_29612":69025,"_20544":115473,"_5":14097,"_26932":115149,"_2867":115474},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3381":69145,"_29612":69025,"_20544":115476,"_5":14097,"_26932":115149,"_2867":115477},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3381":69146,"_29612":69025,"_20544":115479,"_5":14097,"_26932":115149,"_2867":115480},[],"acceso a la interfaz;",{"_3381":69147,"_29612":69025,"_20544":115482,"_5":14097,"_26932":115149,"_2867":115483},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3381":69148,"_29612":69025,"_20544":115485,"_5":14097,"_26932":115149,"_2867":115486},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3381":69149,"_29612":69025,"_20544":115488,"_5":14097,"_26932":115149,"_2867":115489},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3381":69150,"_29612":69025,"_20544":115491,"_5":14097,"_26932":115153,"_2867":115492},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3381":69151,"_29612":69025,"_20544":115494,"_5":14097,"_26932":115153,"_2867":115495},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3381":69152,"_29612":69025,"_20544":115497,"_5":14097,"_26932":115153,"_2867":115498},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3381":69153,"_29612":69025,"_20544":115500,"_5":14097,"_26932":115156,"_2867":115501},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3381":69154,"_29612":69025,"_20544":115503,"_5":14097,"_26932":115160,"_2867":115504},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_3381":69155,"_29612":69025,"_20544":115506,"_5":14097,"_26932":115160,"_2867":115507},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_3381":69156,"_29612":69025,"_20544":115509,"_5":14097,"_26932":115164,"_2867":115510},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3381":69157,"_29612":69025,"_20544":115512,"_5":14097,"_26932":115168,"_2867":115513},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3381":69158,"_29612":69025,"_20544":115515,"_5":14097,"_26932":115172,"_2867":115516},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3381":69159,"_29612":69025,"_20544":115518,"_5":14097,"_26932":115176,"_2867":115519},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3381":69160,"_29612":69025,"_20544":115521,"_5":14097,"_26932":115176,"_2867":115522},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3381":69161,"_29612":69025,"_20544":115524,"_5":14097,"_26932":115180,"_2867":115525},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3381":69162,"_29612":69025,"_20544":115527,"_5":14097,"_26932":115180,"_2867":115528},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3381":69163,"_29612":69025,"_20544":115530,"_5":14097,"_26932":115180,"_2867":115531},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3381":69164,"_29612":69025,"_20544":115533,"_5":14097,"_26932":115180,"_2867":115534},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3381":69165,"_29612":69025,"_20544":115536,"_5":14097,"_26932":115180,"_2867":115537},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3381":69166,"_29612":69025,"_20544":115539,"_5":14097,"_26932":115180,"_2867":115540},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3381":69167,"_29612":69025,"_20544":115542,"_5":14097,"_26932":115180,"_2867":115543},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3381":69168,"_29612":69025,"_20544":115545,"_5":14097,"_26932":115180,"_2867":115546},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3381":69169,"_29612":69025,"_20544":115548,"_5":14097,"_26932":115184,"_2867":115549},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3381":69170,"_29612":69025,"_20544":115551,"_5":14097,"_26932":115184,"_2867":115552},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3381":69171,"_29612":69025,"_20544":115554,"_5":14097,"_26932":115184,"_2867":115555},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3381":69172,"_29612":69025,"_20544":115557,"_5":14097,"_26932":115188,"_2867":115558},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3381":69173,"_29612":69025,"_20544":115560,"_5":14097,"_26932":115188,"_2867":115561},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3381":69174,"_29612":69025,"_20544":115563,"_5":14097,"_26932":115188,"_2867":115564},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3381":69175,"_29612":69025,"_20544":115566,"_5":14097,"_26932":115188,"_2867":115567},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3381":69176,"_29612":69025,"_20544":115569,"_5":14097,"_26932":115188,"_2867":115570},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3381":69177,"_29612":69025,"_20544":115572,"_5":14097,"_26932":115188,"_2867":115573},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3381":69178,"_29612":69025,"_20544":115575,"_5":14097,"_26932":115188,"_2867":115576},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3381":69179,"_29612":69025,"_20544":115578,"_5":14097,"_26932":115188,"_2867":115579},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3381":69180,"_29612":69025,"_20544":115581,"_5":14097,"_26932":115196,"_2867":115582},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3381":69181,"_29612":69025,"_20544":115584,"_5":14097,"_26932":115200,"_2867":115585},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3381":69182,"_29612":69025,"_20544":115587,"_5":14097,"_26932":115200,"_2867":115588},[],"que exista un principal activo del tipo correcto;",{"_3381":69183,"_29612":69025,"_20544":115590,"_5":14097,"_26932":115200,"_2867":115591},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3381":69184,"_29612":69025,"_20544":115593,"_5":14097,"_26932":115200,"_2867":115594},[],"que todas las condiciones del principal se cumplan;",{"_3381":69185,"_29612":69025,"_20544":115596,"_5":14097,"_26932":115200,"_2867":115597},[],"que el principal tenga concedida la política esperada;",{"_3381":69186,"_29612":69025,"_20544":115599,"_5":14097,"_26932":115200,"_2867":115600},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3381":69187,"_29612":69025,"_20544":115602,"_5":14097,"_26932":115200,"_2867":115603},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3381":69188,"_29612":69025,"_20544":115605,"_5":14097,"_26932":115200,"_2867":115606},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con las trazas OpenTelemetry habilitadas, una solicitud que llega al motor de políticas genera un span `engine.CheckHTTPRequest` cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente. Para correlacionarlo con la traza del Gateway, el contexto de traza debe propagarse hasta authz.",{"_3381":69189,"_29612":69025,"_20544":115608,"_5":14097,"_26932":115204,"_2867":115609},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3381":69190,"_29612":69025,"_20544":115611,"_5":14097,"_26932":115208,"_2867":115612},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3381":69191,"_29612":69025,"_20544":115614,"_5":14097,"_26932":115212,"_2867":115615},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3381":69192,"_29612":69025,"_20544":115617,"_5":14097,"_26932":115212,"_2867":115618},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3381":69193,"_29612":69193,"_5":14455,"_2867":115620,"_29965":115621,"_20544":115622,"_26932":69193},"Alertas y suscripciones",[48231,115085,115086],[],{"_3381":69194,"_29612":69193,"_20544":115624,"_5":14097,"_26932":69193,"_2867":115625},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3381":69195,"_29612":69193,"_5":29962,"_20544":115627,"_26932":115628,"_2867":115629},[],"/docs/pr-preview/pr-53/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3381":69196,"_29612":69193,"_5":29962,"_20544":115631,"_26932":115632,"_2867":115633},[],"/docs/pr-preview/pr-53/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3381":69197,"_29612":69193,"_5":29962,"_20544":115635,"_26932":115636,"_2867":115637},[],"/docs/pr-preview/pr-53/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3381":69198,"_29612":69193,"_5":29962,"_20544":115639,"_26932":115640,"_2867":115641},[],"/docs/pr-preview/pr-53/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3381":69199,"_29612":69193,"_5":29962,"_20544":115643,"_26932":115644,"_2867":115645},[],"/docs/pr-preview/pr-53/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3381":69200,"_29612":69193,"_5":29962,"_20544":115647,"_26932":115648,"_2867":115649},[],"/docs/pr-preview/pr-53/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3381":69201,"_29612":69193,"_5":29962,"_20544":115651,"_26932":115652,"_2867":115653},[],"/docs/pr-preview/pr-53/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3381":69202,"_29612":69193,"_5":29962,"_20544":115655,"_26932":115656,"_2867":115657},[],"/docs/pr-preview/pr-53/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","Configura el cliente HTTP del webhook",{"_3381":69203,"_29612":69193,"_5":29962,"_20544":115659,"_26932":115660,"_2867":115661},[],"/docs/pr-preview/pr-53/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3381":69204,"_29612":69193,"_5":29962,"_20544":115663,"_26932":115664,"_2867":115665},[],"/docs/pr-preview/pr-53/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3381":69205,"_29612":69193,"_5":29962,"_20544":115667,"_26932":115668,"_2867":115669},[],"/docs/pr-preview/pr-53/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3381":69206,"_29612":69193,"_20544":115671,"_5":14097,"_26932":69193,"_2867":115672},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3381":69207,"_29612":69193,"_20544":115674,"_5":14097,"_26932":115628,"_2867":115675},[],"Un servicio publica un evento de dominio.",{"_3381":69208,"_29612":69193,"_20544":115677,"_5":14097,"_26932":115628,"_2867":115678},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3381":69209,"_29612":69193,"_20544":115680,"_5":14097,"_26932":115628,"_2867":115681},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3381":69210,"_29612":69193,"_20544":115683,"_5":14097,"_26932":115628,"_2867":115684},[],"Lamassu entrega el evento al canal configurado.",{"_3381":69211,"_29612":69193,"_20544":115686,"_5":14097,"_26932":115628,"_2867":115687},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3381":69212,"_29612":69193,"_20544":115689,"_5":14097,"_26932":115632,"_2867":115690},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3381":69213,"_29612":69193,"_20544":115692,"_5":14097,"_26932":115632,"_2867":115693},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3381":69214,"_29612":69193,"_20544":115695,"_5":14097,"_26932":115632,"_2867":115696},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3381":69215,"_29612":69193,"_20544":115698,"_5":14097,"_26932":115632,"_2867":115699},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3381":69216,"_29612":69193,"_20544":115701,"_5":14097,"_26932":115632,"_2867":115702},[],"`apikey_options` necesita `header` y `key`.",{"_3381":69217,"_29612":69193,"_20544":115704,"_5":14097,"_26932":115632,"_2867":115705},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3381":69218,"_29612":69193,"_20544":115707,"_5":14097,"_26932":115632,"_2867":115708},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3381":69219,"_29612":69193,"_20544":115710,"_5":14097,"_26932":115632,"_2867":115711},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3381":69220,"_29612":69193,"_20544":115713,"_5":14097,"_26932":115640,"_2867":115714},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3381":69221,"_29612":69193,"_20544":115716,"_5":14097,"_26932":115644,"_2867":115717},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3381":69222,"_29612":69193,"_20544":115719,"_5":14097,"_26932":115648,"_2867":115720},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3381":69223,"_29612":69193,"_20544":115722,"_5":14097,"_26932":115648,"_2867":115723},[],"**None** notifica todas las instancias del evento.",{"_3381":69224,"_29612":69193,"_20544":115725,"_5":14097,"_26932":115648,"_2867":115726},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3381":69225,"_29612":69193,"_20544":115728,"_5":14097,"_26932":115648,"_2867":115729},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3381":69226,"_29612":69193,"_20544":115731,"_5":14097,"_26932":115648,"_2867":115732},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3381":69227,"_29612":69193,"_20544":115734,"_5":14097,"_26932":115648,"_2867":115735},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3381":69228,"_29612":69193,"_20544":115737,"_5":14097,"_26932":115648,"_2867":115738},[],"La consola evalúa el filtro contra el JSON del editor **Input Event**, que está prellenado con el último evento, e indica si coincide. Para los filtros JSON Path y JavaScript, muestra **The filter matches this Cloud Event** o **The filter does not match this Cloud Event**. Las expresiones JSON Path se evalúan sobre el Cloud Event completo, así que el valor por defecto, `$.data`, selecciona el campo `data` del evento, y la expresión debe empezar por `$`.",{"_3381":69229,"_29612":69193,"_20544":115740,"_5":14097,"_26932":115652,"_2867":115741},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3381":69230,"_29612":69193,"_20544":115743,"_5":14097,"_26932":115656,"_2867":115744},[],"Los canales Webhook y Microsoft Teams muestran esta configuración en el formulario de suscripción, en el paso del canal, y de nuevo al editar una suscripción; Email no la utiliza. Los campos se corresponden con el bloque opcional `http_client` descrito arriba:",{"_3381":69231,"_29612":69193,"_20544":115746,"_5":14097,"_26932":115656,"_2867":115747},[],"**Log Level** selecciona `debug`, `info`, `warn` o `error`; `info` es el valor por defecto.",{"_3381":69232,"_29612":69193,"_20544":115749,"_5":14097,"_26932":115656,"_2867":115750},[],"**Call Timeout** es de 10 segundos por defecto. La consola rechaza un valor superior a 30 segundos con `Webhook timeout must be at most 30s.`; la API ajusta ese mismo valor al tope en lugar de rechazarlo (ver Las llamadas están limitadas).",{"_3381":69233,"_29612":69193,"_20544":115752,"_5":14097,"_26932":115656,"_2867":115753},[],"No hay interruptor de verificación TLS para estos canales, porque el servicio siempre verifica el certificado del receptor (ver TLS siempre se verifica).",{"_3381":69234,"_29612":69193,"_20544":115755,"_5":14097,"_26932":115656,"_2867":115756},[],"**HTTP Authentication** selecciona `No Authentication` (por defecto), `API Key` (valor de la API key y Header Name, `X-API-Key` por defecto), `OIDC Client Credentials` (Client ID, Client Secret y Well-Known URL) o `Mutual TLS` (Client Certificate y Client Private Key pegados como PEM). Una clave privada guardada permanece oculta hasta que seleccionas **Show**.",{"_3381":69235,"_29612":69193,"_20544":115758,"_5":14097,"_26932":115656,"_2867":115759},[],"Una URL `http://` muestra en la consola la advertencia `Unencrypted HTTP connection` (ver la llamada Credenciales sobre http\\:// más abajo).",{"_3381":69236,"_29612":69193,"_20544":115761,"_5":14097,"_26932":115656,"_2867":115762},[],"Los campos se validan en línea con las mismas reglas de entrega: la URL del webhook y la Well-Known URL de OIDC deben ser URLs absolutas `http` o `https`, una cabecera API-key no puede usar un nombre reservado y el certificado y la clave mTLS deben ser contenido PEM, no rutas de ficheros.",{"_3381":69237,"_29612":69193,"_20544":115764,"_5":14097,"_26932":115656,"_2867":115765},[],"El resumen del paso de confirmación muestra la autenticación como `None`, `OIDC client credentials`, `API key` o `Mutual TLS`. Los detalles de la suscripción muestran la autenticación, el nombre de la cabecera API-key (nunca el valor), la URL del emisor OIDC, mTLS como `Configured` y una fila fija `TLS verification: Verified`. La API key, el client secret y la clave privada no se muestran en los detalles de la suscripción.",{"_3381":69238,"_29612":69193,"_20544":115767,"_5":14097,"_26932":115660,"_2867":115768},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3381":69239,"_29612":69193,"_20544":115770,"_5":14097,"_26932":115660,"_2867":115771},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3381":69240,"_29612":69193,"_20544":115773,"_5":14097,"_26932":115660,"_2867":115774},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3381":69241,"_29612":69193,"_20544":115776,"_5":14097,"_26932":115660,"_2867":115777},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3381":69242,"_29612":69193,"_20544":115779,"_5":14097,"_26932":115660,"_2867":115780},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3381":69243,"_29612":69193,"_20544":115782,"_5":14097,"_26932":115660,"_2867":115783},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3381":69244,"_29612":69193,"_20544":115785,"_5":14097,"_26932":115660,"_2867":115786},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3381":69245,"_29612":69193,"_20544":115788,"_5":14097,"_26932":115660,"_2867":115789},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3381":69246,"_29612":69193,"_20544":115791,"_5":14097,"_26932":115664,"_2867":115792},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3381":69247,"_29612":69193,"_20544":115794,"_5":14097,"_26932":115664,"_2867":115795},[],"Las suscripciones creadas con versiones anteriores de la consola pueden guardar el destino del webhook en `url` y `method` en lugar de `webhook_url` y `webhook_method`. El servicio entrega solo a través de `webhook_url` y `webhook_method`, así que una suscripción así no entrega aunque los detalles de la suscripción muestren el destino guardado. Abre la suscripción y vuelve a guardarla: el formulario de edición precarga el destino guardado, y al guardar se reescribe la configuración del canal con el formato actual.",{"_3381":69248,"_29612":69193,"_20544":115797,"_5":14097,"_26932":115668,"_2867":115798},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3381":69249,"_29612":69193,"_20544":115800,"_5":14097,"_26932":115668,"_2867":115801},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3381":69250,"_29612":69193,"_20544":115803,"_5":14097,"_26932":115668,"_2867":115804},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3381":69251,"_29612":69193,"_20544":115806,"_5":14097,"_26932":115668,"_2867":115807},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3381":69252,"_29612":69193,"_20544":115809,"_5":14097,"_26932":115668,"_2867":115810},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3381":69253,"_29612":69193,"_20544":115812,"_5":14097,"_26932":115668,"_2867":115813},[],"**Validación:** `va.role.crl.create`.",{"_3381":69254,"_29612":69193,"_20544":115815,"_5":14097,"_26932":115668,"_2867":115816},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3381":69255,"_29612":69193,"_20544":115818,"_5":14097,"_26932":115668,"_2867":115819},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3381":69256,"_29612":69256,"_5":14455,"_2867":115821,"_29965":115822,"_20544":115823,"_26932":69256},"Registros de auditoría",[48231,115085,115086],[],{"_3381":69257,"_29612":69256,"_20544":115825,"_5":14097,"_26932":69256,"_2867":115826},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3381":69258,"_29612":69256,"_5":29962,"_20544":115828,"_26932":115829,"_2867":115830},[],"/docs/pr-preview/pr-53/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3381":69259,"_29612":69256,"_5":29962,"_20544":115832,"_26932":115833,"_2867":115834},[],"/docs/pr-preview/pr-53/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3381":69260,"_29612":69256,"_5":29962,"_20544":115836,"_26932":115837,"_2867":115838},[],"/docs/pr-preview/pr-53/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3381":69261,"_29612":69256,"_5":29962,"_20544":115840,"_26932":115841,"_2867":115842},[],"/docs/pr-preview/pr-53/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3381":69262,"_29612":69256,"_5":29962,"_20544":115844,"_26932":115845,"_2867":115846},[],"/docs/pr-preview/pr-53/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3381":69263,"_29612":69256,"_5":29962,"_20544":115848,"_26932":115849,"_2867":115850},[],"/docs/pr-preview/pr-53/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3381":69264,"_29612":69256,"_5":29962,"_20544":115852,"_26932":115853,"_2867":115854},[],"/docs/pr-preview/pr-53/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3381":69265,"_29612":69256,"_5":29962,"_20544":115856,"_26932":115857,"_2867":115858},[],"/docs/pr-preview/pr-53/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3381":69266,"_29612":69256,"_5":29962,"_20544":115860,"_26932":115861,"_2867":115862},[],"/docs/pr-preview/pr-53/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3381":69267,"_29612":69256,"_5":29962,"_20544":115864,"_26932":115865,"_2867":115866},[],"/docs/pr-preview/pr-53/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3381":69268,"_29612":69256,"_5":29962,"_20544":115868,"_26932":115869,"_2867":115870},[],"/docs/pr-preview/pr-53/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3381":69269,"_29612":69256,"_20544":115872,"_5":14097,"_26932":69256,"_2867":115873},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3381":69270,"_29612":69256,"_20544":115875,"_5":14097,"_26932":115829,"_2867":115876},[],"El cuerpo de auditoría incluye:",{"_3381":69271,"_29612":69256,"_20544":115878,"_5":14097,"_26932":115829,"_2867":115879},[],"input: datos recibidos por la operación;",{"_3381":69272,"_29612":69256,"_20544":115881,"_5":14097,"_26932":115829,"_2867":115882},[],"has\\_error: indica si el servicio devolvió un error;",{"_3381":69273,"_29612":69256,"_20544":115884,"_5":14097,"_26932":115829,"_2867":115885},[],"output: resultado producido o mensaje de error;",{"_3381":69274,"_29612":69256,"_20544":115887,"_5":14097,"_26932":115829,"_2867":115888},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3381":69275,"_29612":69256,"_20544":115890,"_5":14097,"_26932":115829,"_2867":115891},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3381":69276,"_29612":69256,"_20544":115893,"_5":14097,"_26932":115829,"_2867":115894},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3381":69277,"_29612":69256,"_20544":115896,"_5":14097,"_26932":115833,"_2867":115897},[],"El backend aplica auditoría a mutaciones de:",{"_3381":69278,"_29612":69256,"_20544":115899,"_5":14097,"_26932":115833,"_2867":115900},[],"autoridades, certificados y perfiles de emisión;",{"_3381":69279,"_29612":69256,"_20544":115902,"_5":14097,"_26932":115833,"_2867":115903},[],"claves y motores KMS;",{"_3381":69280,"_29612":69256,"_20544":115905,"_5":14097,"_26932":115833,"_2867":115906},[],"dispositivos e identidades;",{"_3381":69281,"_29612":69256,"_20544":115908,"_5":14097,"_26932":115833,"_2867":115909},[],"DMS y operaciones de enrolamiento;",{"_3381":69282,"_29612":69256,"_20544":115911,"_5":14097,"_26932":115833,"_2867":115912},[],"funciones de validación y CRL;",{"_3381":69283,"_29612":69256,"_20544":115914,"_5":14097,"_26932":115833,"_2867":115915},[],"principales, políticas y concesiones de autorización.",{"_3381":69284,"_29612":69256,"_20544":115917,"_5":14097,"_26932":115833,"_2867":115918},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3381":69285,"_29612":69256,"_20544":115920,"_5":14097,"_26932":115837,"_2867":115921},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3381":69286,"_29612":69256,"_20544":115923,"_5":14097,"_26932":115837,"_2867":115924},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3381":69287,"_29612":69256,"_20544":115926,"_5":14097,"_26932":115837,"_2867":115927},[],"Diseña el consumidor para:",{"_3381":69288,"_29612":69256,"_20544":115929,"_5":14097,"_26932":115837,"_2867":115930},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3381":69289,"_29612":69256,"_20544":115932,"_5":14097,"_26932":115837,"_2867":115933},[],"conservar el CloudEvent completo sin modificar;",{"_3381":69290,"_29612":69256,"_20544":115935,"_5":14097,"_26932":115837,"_2867":115936},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3381":69291,"_29612":69256,"_20544":115938,"_5":14097,"_26932":115837,"_2867":115939},[],"cifrar en tránsito y en reposo;",{"_3381":69292,"_29612":69256,"_20544":115941,"_5":14097,"_26932":115837,"_2867":115942},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3381":69293,"_29612":69256,"_20544":115944,"_5":14097,"_26932":115837,"_2867":115945},[],"aplicar una política explícita de retención y legal hold;",{"_3381":69294,"_29612":69256,"_20544":115947,"_5":14097,"_26932":115837,"_2867":115948},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3381":69295,"_29612":69256,"_20544":115950,"_5":14097,"_26932":115841,"_2867":115951},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3381":69296,"_29612":69256,"_20544":115953,"_5":14097,"_26932":115841,"_2867":115954},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3381":69297,"_29612":69256,"_20544":115956,"_5":14097,"_26932":115849,"_2867":115957},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3381":69298,"_29612":69256,"_20544":115959,"_5":14097,"_26932":115853,"_2867":115960},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3381":69299,"_29612":69256,"_20544":115962,"_5":14097,"_26932":115857,"_2867":115963},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3381":69300,"_29612":69256,"_20544":115965,"_5":14097,"_26932":115861,"_2867":115966},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3381":69301,"_29612":69256,"_20544":115968,"_5":14097,"_26932":115865,"_2867":115969},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3381":69302,"_29612":69256,"_20544":115971,"_5":14097,"_26932":115869,"_2867":115972},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3381":69303,"_29612":69256,"_20544":115974,"_5":14097,"_26932":115869,"_2867":115975},[],"aparece un evento de auditoría correcto;",{"_3381":69304,"_29612":69256,"_20544":115977,"_5":14097,"_26932":115869,"_2867":115978},[],"el principal coincide con la identidad utilizada;",{"_3381":69305,"_29612":69256,"_20544":115980,"_5":14097,"_26932":115869,"_2867":115981},[],"el consumidor lo persiste una sola vez;",{"_3381":69306,"_29612":69256,"_20544":115983,"_5":14097,"_26932":115869,"_2867":115984},[],"puede recuperarse por recurso, actor y periodo;",{"_3381":69307,"_29612":69256,"_20544":115986,"_5":14097,"_26932":115869,"_2867":115987},[],"una interrupción del consumidor produce una alerta.",{"_3381":69308,"_29612":69256,"_20544":115989,"_5":14097,"_26932":115869,"_2867":115990},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3381":69309,"_29612":69309,"_5":14455,"_2867":115992,"_29965":115993,"_20544":115994,"_26932":69309},"Arquitectura de la plataforma",[48231,115085],[],{"_3381":69310,"_29612":69309,"_20544":115996,"_5":14097,"_26932":69309,"_2867":115997},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3381":69311,"_29612":69309,"_5":29962,"_20544":115999,"_26932":116000,"_2867":116001},[],"/docs/pr-preview/pr-53/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3381":69312,"_29612":69309,"_5":29962,"_20544":116003,"_26932":116004,"_2867":116005},[],"/docs/pr-preview/pr-53/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3381":69313,"_29612":69309,"_5":29962,"_20544":116007,"_26932":116008,"_2867":116009},[],"/docs/pr-preview/pr-53/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3381":69314,"_29612":69309,"_5":29962,"_20544":116011,"_26932":116012,"_2867":116013},[],"/docs/pr-preview/pr-53/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3381":69315,"_29612":69309,"_5":29962,"_20544":116015,"_26932":116016,"_2867":116017},[],"/docs/pr-preview/pr-53/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3381":69316,"_29612":69309,"_20544":116019,"_5":14097,"_26932":69309,"_2867":116020},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3381":69317,"_29612":69309,"_20544":116022,"_5":14097,"_26932":69309,"_2867":116023},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3381":69318,"_29612":69309,"_20544":116025,"_5":14097,"_26932":116000,"_2867":116026},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3381":69319,"_29612":69309,"_20544":116028,"_5":14097,"_26932":116004,"_2867":116029},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3381":69320,"_29612":69309,"_20544":116031,"_5":14097,"_26932":116008,"_2867":116032},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3381":69321,"_29612":69309,"_20544":116034,"_5":14097,"_26932":116012,"_2867":116035},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3381":69322,"_29612":69309,"_20544":116037,"_5":14097,"_26932":116016,"_2867":116038},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3381":69323,"_29612":69323,"_5":14455,"_2867":116040,"_29965":116041,"_20544":116042,"_26932":69323},"Cómo funciona Lamassu",[48231,115085],[],{"_3381":69324,"_29612":69323,"_20544":116044,"_5":14097,"_26932":69323,"_2867":116045},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3381":69325,"_29612":69323,"_5":29962,"_20544":116047,"_26932":116048,"_2867":116049},[],"/docs/pr-preview/pr-53/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3381":69326,"_29612":69323,"_5":29962,"_20544":116051,"_26932":116052,"_2867":116053},[],"/docs/pr-preview/pr-53/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3381":69327,"_29612":69323,"_20544":116055,"_5":14097,"_26932":69323,"_2867":116056},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3381":69328,"_29612":69323,"_20544":116058,"_5":14097,"_26932":116048,"_2867":116059},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3381":69329,"_29612":69323,"_20544":116061,"_5":14097,"_26932":116048,"_2867":116062},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3381":69330,"_29612":69323,"_20544":116064,"_5":14097,"_26932":116048,"_2867":116065},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3381":69331,"_29612":69323,"_20544":116067,"_5":14097,"_26932":116048,"_2867":116068},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3381":69332,"_29612":69323,"_20544":116070,"_5":14097,"_26932":116048,"_2867":116071},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3381":69333,"_29612":69323,"_20544":116073,"_5":14097,"_26932":116052,"_2867":116074},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3381":69334,"_29612":69323,"_20544":116076,"_5":14097,"_26932":116052,"_2867":116077},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3381":69335,"_29612":69323,"_20544":116079,"_5":14097,"_26932":116052,"_2867":116080},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3381":69336,"_29612":69323,"_20544":116082,"_5":14097,"_26932":116052,"_2867":116083},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3381":69337,"_29612":69323,"_20544":116085,"_5":14097,"_26932":116052,"_2867":116086},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3381":69338,"_29612":69323,"_20544":116088,"_5":14097,"_26932":116052,"_2867":116089},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3381":69339,"_29612":69323,"_20544":116091,"_5":14097,"_26932":116052,"_2867":116092},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3381":69340,"_29612":69340,"_5":14455,"_2867":116094,"_29965":116095,"_20544":116096,"_26932":69340},"Dispositivos e identidades",[48231,115085,50710,116094],[],{"_3381":69341,"_29612":69340,"_20544":116098,"_5":14097,"_26932":69340,"_2867":116099},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3381":69342,"_29612":69340,"_5":29962,"_20544":116101,"_26932":116102,"_2867":116103},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3381":69343,"_29612":69340,"_5":29962,"_20544":116105,"_26932":116106,"_2867":116107},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3381":69344,"_29612":69340,"_5":29962,"_20544":116109,"_26932":116110,"_2867":116111},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3381":69345,"_29612":69340,"_5":29962,"_20544":116113,"_26932":116114,"_2867":116115},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3381":69346,"_29612":69340,"_5":29962,"_20544":116117,"_26932":116118,"_2867":116119},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3381":69347,"_29612":69340,"_5":29962,"_20544":116121,"_26932":116122,"_2867":116123},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3381":69348,"_29612":69340,"_5":29962,"_20544":116125,"_26932":116126,"_2867":116127},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3381":69349,"_29612":69340,"_5":29962,"_20544":116129,"_26932":116130,"_2867":116131},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3381":69350,"_29612":69340,"_5":29962,"_20544":116133,"_26932":116134,"_2867":116135},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3381":69351,"_29612":69340,"_5":29962,"_20544":116137,"_26932":116138,"_2867":116139},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3381":69352,"_29612":69340,"_5":29962,"_20544":116141,"_26932":116142,"_2867":116143},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3381":69353,"_29612":69340,"_20544":116145,"_5":14097,"_26932":69340,"_2867":116146},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3381":69354,"_29612":69340,"_20544":116148,"_5":14097,"_26932":69340,"_2867":116149},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3381":69355,"_29612":69340,"_20544":116151,"_5":14097,"_26932":116102,"_2867":116152},[],"Vista operativa",{"_3381":69356,"_29612":69340,"_20544":116154,"_5":14097,"_26932":116102,"_2867":116155},[],"Interpretación",{"_3381":69357,"_29612":69340,"_20544":116157,"_5":14097,"_26932":116102,"_2867":50773},[],{"_3381":69358,"_29612":69340,"_20544":116159,"_5":14097,"_26932":116102,"_2867":116160},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3381":69359,"_29612":69340,"_20544":116162,"_5":14097,"_26932":116102,"_2867":50779},[],{"_3381":69360,"_29612":69340,"_20544":116164,"_5":14097,"_26932":116102,"_2867":116165},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3381":69361,"_29612":69340,"_20544":116167,"_5":14097,"_26932":116102,"_2867":50785},[],{"_3381":69362,"_29612":69340,"_20544":116169,"_5":14097,"_26932":116102,"_2867":116170},[],"La identidad está en la ventana operativa de renovación.",{"_3381":69363,"_29612":69340,"_20544":116172,"_5":14097,"_26932":116102,"_2867":50791},[],{"_3381":69364,"_29612":69340,"_20544":116174,"_5":14097,"_26932":116102,"_2867":116175},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3381":69365,"_29612":69340,"_20544":116177,"_5":14097,"_26932":116102,"_2867":50797},[],{"_3381":69366,"_29612":69340,"_20544":116179,"_5":14097,"_26932":116102,"_2867":116180},[],"La identidad ha vencido.",{"_3381":69367,"_29612":69340,"_20544":116182,"_5":14097,"_26932":116102,"_2867":50803},[],{"_3381":69368,"_29612":69340,"_20544":116184,"_5":14097,"_26932":116102,"_2867":116185},[],"La identidad está marcada como revocada.",{"_3381":69369,"_29612":69340,"_20544":116187,"_5":14097,"_26932":116102,"_2867":50809},[],{"_3381":69370,"_29612":69340,"_20544":116189,"_5":14097,"_26932":116102,"_2867":116190},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3381":69371,"_29612":69340,"_20544":116192,"_5":14097,"_26932":116102,"_2867":116193},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3381":69372,"_29612":69340,"_20544":116195,"_5":14097,"_26932":116106,"_2867":116196},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3381":69373,"_29612":69340,"_20544":116198,"_5":14097,"_26932":116106,"_2867":116199},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3381":69374,"_29612":69340,"_20544":116201,"_5":14097,"_26932":116106,"_2867":116202},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3381":69375,"_29612":69340,"_20544":116204,"_5":14097,"_26932":116106,"_2867":116205},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3381":69376,"_29612":69340,"_20544":116207,"_5":14097,"_26932":116110,"_2867":116208},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3381":69377,"_29612":69340,"_20544":116210,"_5":14097,"_26932":116114,"_2867":116211},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3381":69378,"_29612":69340,"_20544":116213,"_5":14097,"_26932":116118,"_2867":116214},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3381":69379,"_29612":69340,"_20544":116216,"_5":14097,"_26932":116122,"_2867":116217},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3381":69380,"_29612":69340,"_20544":116219,"_5":14097,"_26932":116126,"_2867":116220},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3381":69381,"_29612":69340,"_20544":116222,"_5":14097,"_26932":116126,"_2867":116223},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3381":69382,"_29612":69340,"_20544":116225,"_5":14097,"_26932":116130,"_2867":116226},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3381":69383,"_29612":69340,"_20544":116228,"_5":14097,"_26932":116130,"_2867":116229},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3381":69384,"_29612":69340,"_20544":116231,"_5":14097,"_26932":116130,"_2867":116232},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3381":69385,"_29612":69340,"_20544":116234,"_5":14097,"_26932":116130,"_2867":116235},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3381":69386,"_29612":69340,"_20544":116237,"_5":14097,"_26932":116130,"_2867":116238},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3381":69387,"_29612":69340,"_20544":116240,"_5":14097,"_26932":116130,"_2867":116241},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3381":69388,"_29612":69340,"_20544":116243,"_5":14097,"_26932":116134,"_2867":116244},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3381":69389,"_29612":69340,"_20544":116246,"_5":14097,"_26932":116134,"_2867":116247},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3381":69390,"_29612":69340,"_20544":116249,"_5":14097,"_26932":116138,"_2867":116250},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3381":69391,"_29612":69340,"_20544":116252,"_5":14097,"_26932":116138,"_2867":116253},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3381":69392,"_29612":69340,"_20544":116255,"_5":14097,"_26932":116138,"_2867":116256},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3381":69393,"_29612":69340,"_20544":116258,"_5":14097,"_26932":116138,"_2867":116259},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3381":69394,"_29612":69340,"_20544":116261,"_5":14097,"_26932":116142,"_2867":116262},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3381":69395,"_29612":69340,"_20544":116264,"_5":14097,"_26932":116142,"_2867":116265},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3381":69396,"_29612":69396,"_5":14455,"_2867":116267,"_29965":116268,"_20544":116270,"_26932":69396},"Identidad inicial y autenticación",[48231,115085,50710,116094,116269],"Enrolamiento con PKI",[],{"_3381":69397,"_29612":69396,"_20544":116272,"_5":14097,"_26932":69396,"_2867":116273},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_3381":69398,"_29612":69396,"_5":29962,"_20544":116275,"_26932":116276,"_2867":116277},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3381":69399,"_29612":69396,"_5":29962,"_20544":116279,"_26932":116280,"_2867":116281},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3381":69400,"_29612":69396,"_5":29962,"_20544":116283,"_26932":116284,"_2867":116285},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_3381":69401,"_29612":69396,"_5":29962,"_20544":116287,"_26932":116288,"_2867":116289},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3381":69402,"_29612":69396,"_5":29962,"_20544":116291,"_26932":116292,"_2867":116293},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3381":69403,"_29612":69396,"_20544":116295,"_5":14097,"_26932":69396,"_2867":116296},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3381":69404,"_29612":69396,"_20544":116298,"_5":14097,"_26932":116276,"_2867":116299},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3381":69405,"_29612":69396,"_20544":116301,"_5":14097,"_26932":116276,"_2867":116302},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3381":69406,"_29612":69396,"_20544":116304,"_5":14097,"_26932":116280,"_2867":116305},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3381":69407,"_29612":69396,"_20544":116307,"_5":14097,"_26932":116280,"_2867":116308},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3381":69408,"_29612":69396,"_20544":116310,"_5":14097,"_26932":116280,"_2867":116311},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3381":69409,"_29612":69396,"_20544":116313,"_5":14097,"_26932":116284,"_2867":116314},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3381":69410,"_29612":69396,"_20544":116316,"_5":14097,"_26932":116284,"_2867":116317},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3381":69411,"_29612":69396,"_20544":116319,"_5":14097,"_26932":116288,"_2867":116320},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3381":69412,"_29612":69396,"_20544":116322,"_5":14097,"_26932":116288,"_2867":116323},[],"Ejemplo de cuerpo:",{"_3381":69413,"_29612":69396,"_20544":116325,"_5":14097,"_26932":116288,"_2867":116326},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3381":69414,"_29612":69396,"_20544":116328,"_5":14097,"_26932":116288,"_2867":116329},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3381":69415,"_29612":69396,"_20544":116331,"_5":14097,"_26932":116288,"_2867":116332},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3381":69416,"_29612":69396,"_20544":116334,"_5":14097,"_26932":116288,"_2867":116335},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3381":69417,"_29612":69396,"_20544":116337,"_5":14097,"_26932":116292,"_2867":116338},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_3381":69418,"_29612":69396,"_20544":116340,"_5":14097,"_26932":116292,"_2867":116341},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3381":69419,"_29612":69419,"_5":14455,"_2867":116343,"_29965":116344,"_20544":116345,"_26932":69419},"Configura y opera el DMS",[48231,115085,50710,116094,116269],[],{"_3381":69420,"_29612":69419,"_20544":116347,"_5":14097,"_26932":69419,"_2867":116348},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3381":69421,"_29612":69419,"_5":29962,"_20544":116350,"_26932":116351,"_2867":113663},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3381":69422,"_29612":69419,"_5":29962,"_20544":116353,"_26932":116354,"_2867":116355},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3381":69423,"_29612":69419,"_5":29962,"_20544":116357,"_26932":116358,"_2867":116359},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3381":69424,"_29612":69419,"_5":29962,"_20544":116361,"_26932":116362,"_2867":116363},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3381":69425,"_29612":69419,"_5":29962,"_20544":116365,"_26932":116366,"_2867":116367},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3381":69426,"_29612":69419,"_5":29962,"_20544":116369,"_26932":116370,"_2867":116371},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3381":69427,"_29612":69419,"_5":29962,"_20544":116373,"_26932":116374,"_2867":116375},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3381":69428,"_29612":69419,"_5":29962,"_20544":116377,"_26932":116378,"_2867":116379},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_3381":69429,"_29612":69419,"_5":29962,"_20544":116381,"_26932":116382,"_2867":51005},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_3381":69430,"_29612":69419,"_5":29962,"_20544":116384,"_26932":116385,"_2867":51009},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_3381":69431,"_29612":69419,"_5":29962,"_20544":116387,"_26932":116388,"_2867":116389},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_3381":69432,"_29612":69419,"_5":29962,"_20544":116391,"_26932":116392,"_2867":116393},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3381":69433,"_29612":69419,"_5":29962,"_20544":116395,"_26932":116396,"_2867":116397},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_3381":69434,"_29612":69419,"_5":29962,"_20544":116399,"_26932":116400,"_2867":116401},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3381":69435,"_29612":69419,"_5":29962,"_20544":116403,"_26932":116404,"_2867":51029},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_3381":69436,"_29612":69419,"_5":29962,"_20544":116406,"_26932":116407,"_2867":116408},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_3381":69437,"_29612":69419,"_5":29962,"_20544":116410,"_26932":116411,"_2867":116412},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3381":69438,"_29612":69419,"_5":29962,"_20544":116414,"_26932":116415,"_2867":116416},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3381":69439,"_29612":69419,"_20544":116418,"_5":14097,"_26932":69419,"_2867":116419},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3381":69440,"_29612":69419,"_20544":116421,"_5":14097,"_26932":116351,"_2867":116422},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3381":69441,"_29612":69419,"_20544":116424,"_5":14097,"_26932":116351,"_2867":116425},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3381":69442,"_29612":69419,"_20544":116427,"_5":14097,"_26932":116358,"_2867":116428},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3381":69443,"_29612":69419,"_20544":116430,"_5":14097,"_26932":116362,"_2867":116431},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3381":69444,"_29612":69419,"_20544":116433,"_5":14097,"_26932":116366,"_2867":116434},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3381":69445,"_29612":69419,"_20544":116436,"_5":14097,"_26932":116370,"_2867":116437},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3381":69446,"_29612":69419,"_20544":116439,"_5":14097,"_26932":116374,"_2867":116440},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3381":69447,"_29612":69419,"_20544":116442,"_5":14097,"_26932":116382,"_2867":116443},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_3381":69448,"_29612":69419,"_20544":116445,"_5":14097,"_26932":116382,"_2867":116446},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3381":69449,"_29612":69419,"_20544":116448,"_5":14097,"_26932":116385,"_2867":116449},[],"Campo de `settings.enrollment_settings`",{"_3381":69450,"_29612":69419,"_20544":116451,"_5":14097,"_26932":116385,"_2867":116452},[],"Decisión",{"_3381":69451,"_29612":69419,"_20544":116454,"_5":14097,"_26932":116385,"_2867":51080},[],{"_3381":69452,"_29612":69419,"_20544":116456,"_5":14097,"_26932":116385,"_2867":116457},[],"`EST_RFC7030` para estas operaciones.",{"_3381":69453,"_29612":69419,"_20544":116459,"_5":14097,"_26932":116385,"_2867":51086},[],{"_3381":69454,"_29612":69419,"_20544":116461,"_5":14097,"_26932":116385,"_2867":116462},[],"ID de la CA que firmará.",{"_3381":69455,"_29612":69419,"_20544":116464,"_5":14097,"_26932":116385,"_2867":51092},[],{"_3381":69456,"_29612":69419,"_20544":116466,"_5":14097,"_26932":116385,"_2867":116467},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3381":69457,"_29612":69419,"_20544":116469,"_5":14097,"_26932":116385,"_2867":51098},[],{"_3381":69458,"_29612":69419,"_20544":116471,"_5":14097,"_26932":116385,"_2867":116472},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3381":69459,"_29612":69419,"_20544":116474,"_5":14097,"_26932":116385,"_2867":51104},[],{"_3381":69460,"_29612":69419,"_20544":116476,"_5":14097,"_26932":116385,"_2867":116477},[],"Uno de los cuatro modos de autenticación.",{"_3381":69461,"_29612":69419,"_20544":116479,"_5":14097,"_26932":116385,"_2867":116480},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3381":69462,"_29612":69419,"_20544":116482,"_5":14097,"_26932":116388,"_2867":116483},[],"Los bloques son independientes:",{"_3381":69463,"_29612":69419,"_20544":116485,"_5":14097,"_26932":116388,"_2867":116486},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3381":69464,"_29612":69419,"_20544":116488,"_5":14097,"_26932":116388,"_2867":116489},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3381":69465,"_29612":69419,"_20544":116491,"_5":14097,"_26932":116388,"_2867":51122},[],{"_3381":69466,"_29612":69419,"_20544":116493,"_5":14097,"_26932":116388,"_2867":116494},[],"Control aplicado en la operación configurada",{"_3381":69467,"_29612":69419,"_20544":116496,"_5":14097,"_26932":116388,"_2867":51128},[],{"_3381":69468,"_29612":69419,"_20544":116498,"_5":14097,"_26932":116388,"_2867":116499},[],"Validación del certificado presentado.",{"_3381":69469,"_29612":69419,"_20544":116501,"_5":14097,"_26932":116388,"_2867":51134},[],{"_3381":69470,"_29612":69419,"_20544":116503,"_5":14097,"_26932":116388,"_2867":116504},[],"Autorización del webhook configurado.",{"_3381":69471,"_29612":69419,"_20544":116506,"_5":14097,"_26932":116388,"_2867":51140},[],{"_3381":69472,"_29612":69419,"_20544":116508,"_5":14097,"_26932":116388,"_2867":116509},[],"Validación del certificado y, después, aprobación del webhook.",{"_3381":69473,"_29612":69419,"_20544":116511,"_5":14097,"_26932":116388,"_2867":51146},[],{"_3381":69474,"_29612":69419,"_20544":116513,"_5":14097,"_26932":116388,"_2867":116514},[],"Sin autenticación del solicitante por el DMS.",{"_3381":69475,"_29612":69419,"_20544":116516,"_5":14097,"_26932":116388,"_2867":116517},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3381":69476,"_29612":69419,"_20544":116519,"_5":14097,"_26932":116388,"_2867":116520},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3381":69477,"_29612":69419,"_20544":116522,"_5":14097,"_26932":116388,"_2867":116523},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`.",{"_3381":69478,"_29612":69419,"_20544":116525,"_5":14097,"_26932":116388,"_2867":116526},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3381":69479,"_29612":69419,"_20544":116528,"_5":14097,"_26932":116392,"_2867":116529},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3381":69480,"_29612":69419,"_20544":116531,"_5":14097,"_26932":116392,"_2867":116532},[],"Campo de `external_webhook_settings`",{"_3381":69481,"_29612":69419,"_20544":116534,"_5":14097,"_26932":116392,"_2867":116452},[],{"_3381":69482,"_29612":69419,"_20544":116536,"_5":14097,"_26932":116392,"_2867":51172},[],{"_3381":69483,"_29612":69419,"_20544":116538,"_5":14097,"_26932":116392,"_2867":116539},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3381":69484,"_29612":69419,"_20544":116541,"_5":14097,"_26932":116392,"_2867":51178},[],{"_3381":69485,"_29612":69419,"_20544":116543,"_5":14097,"_26932":116392,"_2867":116544},[],"`POST` o `PUT`; `POST` por defecto.",{"_3381":69486,"_29612":69419,"_20544":116546,"_5":14097,"_26932":116392,"_2867":51184},[],{"_3381":69487,"_29612":69419,"_20544":116548,"_5":14097,"_26932":116392,"_2867":116549},[],"Etiqueta usada en los logs del servicio.",{"_3381":69488,"_29612":69419,"_20544":116551,"_5":14097,"_26932":116392,"_2867":51190},[],{"_3381":69489,"_29612":69419,"_20544":116553,"_5":14097,"_26932":116392,"_2867":116554},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3381":69490,"_29612":69419,"_20544":116556,"_5":14097,"_26932":116392,"_2867":51196},[],{"_3381":69491,"_29612":69419,"_20544":116558,"_5":14097,"_26932":116392,"_2867":116559},[],"Nivel de log de la llamada del webhook: `debug`, `info`, `warn` o `error`; `info` por defecto.",{"_3381":69492,"_29612":69419,"_20544":116561,"_5":14097,"_26932":116392,"_2867":51202},[],{"_3381":69493,"_29612":69419,"_20544":116563,"_5":14097,"_26932":116392,"_2867":116564},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3381":69494,"_29612":69419,"_20544":116566,"_5":14097,"_26932":116392,"_2867":51208},[],{"_3381":69495,"_29612":69419,"_20544":116568,"_5":14097,"_26932":116392,"_2867":116569},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3381":69496,"_29612":69419,"_20544":116571,"_5":14097,"_26932":116392,"_2867":51214},[],{"_3381":69497,"_29612":69419,"_20544":116573,"_5":14097,"_26932":116392,"_2867":116574},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3381":69498,"_29612":69419,"_20544":116576,"_5":14097,"_26932":116392,"_2867":51220},[],{"_3381":69499,"_29612":69419,"_20544":116578,"_5":14097,"_26932":116392,"_2867":116579},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3381":69500,"_29612":69419,"_20544":116581,"_5":14097,"_26932":116392,"_2867":51226},[],{"_3381":69501,"_29612":69419,"_20544":116583,"_5":14097,"_26932":116392,"_2867":116584},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3381":69502,"_29612":69419,"_20544":116586,"_5":14097,"_26932":116392,"_2867":116587},[],"Reglas de esa configuración:",{"_3381":69503,"_29612":69419,"_20544":116589,"_5":14097,"_26932":116392,"_2867":116590},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3381":69504,"_29612":69419,"_20544":116592,"_5":14097,"_26932":116392,"_2867":116593},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3381":69505,"_29612":69419,"_20544":116595,"_5":14097,"_26932":116392,"_2867":116596},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3381":69506,"_29612":69419,"_20544":116598,"_5":14097,"_26932":116392,"_2867":116599},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3381":69507,"_29612":69419,"_20544":116601,"_5":14097,"_26932":116392,"_2867":116602},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3381":69508,"_29612":69419,"_20544":116604,"_5":14097,"_26932":116392,"_2867":116605},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3381":69509,"_29612":69419,"_20544":116607,"_5":14097,"_26932":116392,"_2867":116608},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento, con los mismos campos Log Level, Call Timeout, HTTP Authentication y credenciales que los canales webhook, además de un interruptor **Skip TLS Verification** (desactivado por defecto, así que la verificación permanece activa; la consola avisa cuando lo activas).",{"_3381":69510,"_29612":69419,"_20544":116610,"_5":14097,"_26932":116392,"_2867":116611},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Para corregirlo en la consola, abre el DMS, sustituye cualquier valor de ruta de fichero por contenido PEM — el editor rechaza las rutas de fichero con un error en el propio campo — y guarda. Al guardar se reescribe `external_webhook_settings.config` con las claves actuales, y la consola lee tanto el PEM sin codificar como el codificado en Base64 de las configuraciones migradas, y almacena el material codificado en Base64. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3381":69511,"_29612":69419,"_20544":116613,"_5":14097,"_26932":116392,"_2867":116614},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3381":69512,"_29612":69419,"_20544":116616,"_5":14097,"_26932":116396,"_2867":116617},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3381":69513,"_29612":69419,"_20544":116619,"_5":14097,"_26932":116400,"_2867":116620},[],"Campo de `settings.reenrollment_settings`",{"_3381":69514,"_29612":69419,"_20544":116622,"_5":14097,"_26932":116400,"_2867":116623},[],"Función",{"_3381":69515,"_29612":69419,"_20544":116625,"_5":14097,"_26932":116400,"_2867":51270},[],{"_3381":69516,"_29612":69419,"_20544":116627,"_5":14097,"_26932":116400,"_2867":116628},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3381":69517,"_29612":69419,"_20544":116630,"_5":14097,"_26932":116400,"_2867":51276},[],{"_3381":69518,"_29612":69419,"_20544":116632,"_5":14097,"_26932":116400,"_2867":116633},[],"Umbral operativo preventivo de monitorización.",{"_3381":69519,"_29612":69419,"_20544":116635,"_5":14097,"_26932":116400,"_2867":51282},[],{"_3381":69520,"_29612":69419,"_20544":116637,"_5":14097,"_26932":116400,"_2867":116638},[],"Umbral operativo crítico de monitorización.",{"_3381":69521,"_29612":69419,"_20544":116640,"_5":14097,"_26932":116400,"_2867":51288},[],{"_3381":69522,"_29612":69419,"_20544":116642,"_5":14097,"_26932":116400,"_2867":116643},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3381":69523,"_29612":69419,"_20544":116645,"_5":14097,"_26932":116400,"_2867":51294},[],{"_3381":69524,"_29612":69419,"_20544":116647,"_5":14097,"_26932":116400,"_2867":116648},[],"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3381":69525,"_29612":69419,"_20544":116650,"_5":14097,"_26932":116400,"_2867":51300},[],{"_3381":69526,"_29612":69419,"_20544":116652,"_5":14097,"_26932":116400,"_2867":116653},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3381":69527,"_29612":69419,"_20544":116655,"_5":14097,"_26932":116400,"_2867":116656},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_3381":69528,"_29612":69419,"_20544":116658,"_5":14097,"_26932":116404,"_2867":116659},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_3381":69529,"_29612":69419,"_20544":116661,"_5":14097,"_26932":116407,"_2867":114027},[],{"_3381":69530,"_29612":69419,"_20544":116663,"_5":14097,"_26932":116407,"_2867":116664},[],"Qué publica",{"_3381":69531,"_29612":69419,"_20544":116666,"_5":14097,"_26932":116407,"_2867":51317},[],{"_3381":69532,"_29612":69419,"_20544":116668,"_5":14097,"_26932":116407,"_2867":116669},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3381":69533,"_29612":69419,"_20544":116671,"_5":14097,"_26932":116407,"_2867":51323},[],{"_3381":69534,"_29612":69419,"_20544":116673,"_5":14097,"_26932":116407,"_2867":116674},[],"Certificado de la CA emisora seleccionada.",{"_3381":69535,"_29612":69419,"_20544":116676,"_5":14097,"_26932":116407,"_2867":51329},[],{"_3381":69536,"_29612":69419,"_20544":116678,"_5":14097,"_26932":116407,"_2867":116679},[],"Certificados de las CAs elegidas explícitamente.",{"_3381":69537,"_29612":69419,"_20544":116681,"_5":14097,"_26932":116407,"_2867":116682},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_3381":69538,"_29612":69419,"_20544":116684,"_5":14097,"_26932":116411,"_2867":116685},[],"**Edit** cambia nombre, ajustes y metadatos. Las actualizaciones se realizan mediante la API de DMS. `PUT /v1/dms/{id}` siempre actúa sobre el DMS identificado en la ruta de la URL: el cuerpo no lleva campo `id`, y cualquier `id` o `creation_ts` que contenga se ignora silenciosamente; la autorización se evalúa contra ese mismo identificador de la ruta. El cuerpo debe incluir un `name` no vacío y un objeto `settings`; si falta alguno, la respuesta es HTTP 400 y el DMS almacenado no se modifica. `name` y `settings` se sustituyen siempre por completo, así que lee el DMS antes de enviar una edición por API para no perder campos. `metadata` es opcional: si se omite o se envía `null`, se conservan los metadatos almacenados; un objeto suministrado los sustituye por completo; `{}` los borra (una consulta GET posterior devuelve un objeto vacío, no `null`). Los cuerpos al estilo antiguo que transportan el DMS completo siguen funcionando mientras incluyan `name` y `settings`; los campos desconocidos se ignoran. La actualización rechaza un `name` vacío con HTTP 400: un DMS cuyo nombre almacenado quedó vacío por una actualización anterior debe renombrarse antes de que cualquier cliente lo vuelva a leer y reenviar, incluida la escritura de vuelta del conector de AWS IoT en modo JITP. Si el objeto no incluye la clave del conector de AWS IoT (`lamassu.io/iot/{connector_id}`), el conector ignora los eventos siguientes del DMS.",{"_3381":69539,"_29612":69419,"_20544":116687,"_5":14097,"_26932":116411,"_2867":116688},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3381":69540,"_29612":69419,"_20544":116690,"_5":14097,"_26932":116411,"_2867":116691},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3381":69541,"_29612":69419,"_20544":116693,"_5":14097,"_26932":116415,"_2867":116694},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3381":69542,"_29612":69542,"_5":14455,"_2867":116696,"_29965":116697,"_20544":116698,"_26932":69542},"Integra el cliente EST",[48231,115085,50710,116094,116269],[],{"_3381":69543,"_29612":69542,"_20544":116700,"_5":14097,"_26932":69542,"_2867":116701},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_3381":69544,"_29612":69542,"_5":29962,"_20544":116703,"_26932":116704,"_2867":113663},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_3381":69545,"_29612":69542,"_5":29962,"_20544":116706,"_26932":116707,"_2867":116708},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_3381":69546,"_29612":69542,"_5":29962,"_20544":116710,"_26932":116711,"_2867":116712},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_3381":69547,"_29612":69542,"_5":29962,"_20544":116714,"_26932":116715,"_2867":116716},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_3381":69548,"_29612":69542,"_5":29962,"_20544":116718,"_26932":116719,"_2867":116720},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_3381":69549,"_29612":69542,"_5":29962,"_20544":116722,"_26932":116723,"_2867":116724},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_3381":69550,"_29612":69542,"_20544":116726,"_5":14097,"_26932":69542,"_2867":116727},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_3381":69551,"_29612":69542,"_20544":116729,"_5":14097,"_26932":116704,"_2867":116730},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3381":69552,"_29612":69542,"_20544":116732,"_5":14097,"_26932":116704,"_2867":116733},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3381":69553,"_29612":69542,"_20544":116735,"_5":14097,"_26932":116704,"_2867":116736},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3381":69554,"_29612":69542,"_20544":116738,"_5":14097,"_26932":116707,"_2867":116739},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_3381":69555,"_29612":69542,"_20544":116741,"_5":14097,"_26932":116707,"_2867":116742},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3381":69556,"_29612":69542,"_20544":116744,"_5":14097,"_26932":116711,"_2867":116745},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3381":69557,"_29612":69542,"_20544":116747,"_5":14097,"_26932":116711,"_2867":116748},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3381":69558,"_29612":69542,"_20544":116750,"_5":14097,"_26932":116715,"_2867":116751},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3381":69559,"_29612":69542,"_20544":116753,"_5":14097,"_26932":116715,"_2867":116754},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3381":69560,"_29612":69542,"_20544":116756,"_5":14097,"_26932":116719,"_2867":116757},[],"Para el caso de una raíz que emite directamente:",{"_3381":69561,"_29612":69542,"_20544":116759,"_5":14097,"_26932":116719,"_2867":116760},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3381":69562,"_29612":69542,"_20544":116762,"_5":14097,"_26932":116719,"_2867":116763},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3381":69563,"_29612":69542,"_20544":116765,"_5":14097,"_26932":116723,"_2867":116766},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_3381":69564,"_29612":69564,"_5":14455,"_2867":116768,"_29965":116769,"_20544":116770,"_26932":69564},"Referencia EST",[48231,115085,50710,116094,116269],[],{"_3381":69565,"_29612":69564,"_20544":116772,"_5":14097,"_26932":69564,"_2867":116773},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_3381":69566,"_29612":69564,"_5":29962,"_20544":116775,"_26932":116776,"_2867":116777},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_3381":69567,"_29612":69564,"_5":29962,"_20544":116779,"_26932":116780,"_2867":22272},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3381":69568,"_29612":69564,"_5":29962,"_20544":116782,"_26932":116783,"_2867":25568},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3381":69569,"_29612":69564,"_5":29962,"_20544":116785,"_26932":116786,"_2867":25575},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3381":69570,"_29612":69564,"_5":29962,"_20544":116788,"_26932":116789,"_2867":24892},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3381":69571,"_29612":69564,"_5":29962,"_20544":116791,"_26932":116792,"_2867":116793},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_3381":69572,"_29612":69564,"_5":29962,"_20544":116795,"_26932":116796,"_2867":116797},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_3381":69573,"_29612":69564,"_5":29962,"_20544":116799,"_26932":116800,"_2867":116801},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_3381":69574,"_29612":69564,"_20544":116803,"_5":14097,"_26932":69564,"_2867":116804},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_3381":69575,"_29612":69564,"_20544":116806,"_5":14097,"_26932":116776,"_2867":116807},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3381":69576,"_29612":69564,"_20544":116809,"_5":14097,"_26932":116776,"_2867":114845},[],{"_3381":69577,"_29612":69564,"_20544":116811,"_5":14097,"_26932":116776,"_2867":116812},[],"Método",{"_3381":69578,"_29612":69564,"_20544":116814,"_5":14097,"_26932":116776,"_2867":116815},[],"Autenticación y condición",{"_3381":69579,"_29612":69564,"_20544":116817,"_5":14097,"_26932":116776,"_2867":51472},[],{"_3381":69580,"_29612":69564,"_20544":116819,"_5":14097,"_26932":116776,"_2867":51475},[],{"_3381":69581,"_29612":69564,"_20544":116821,"_5":14097,"_26932":116776,"_2867":116822},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3381":69582,"_29612":69564,"_20544":116824,"_5":14097,"_26932":116776,"_2867":51481},[],{"_3381":69583,"_29612":69564,"_20544":116826,"_5":14097,"_26932":116776,"_2867":51484},[],{"_3381":69584,"_29612":69564,"_20544":116828,"_5":14097,"_26932":116776,"_2867":116829},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3381":69585,"_29612":69564,"_20544":116831,"_5":14097,"_26932":116776,"_2867":51490},[],{"_3381":69586,"_29612":69564,"_20544":116833,"_5":14097,"_26932":116776,"_2867":51484},[],{"_3381":69587,"_29612":69564,"_20544":116835,"_5":14097,"_26932":116776,"_2867":116836},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3381":69588,"_29612":69564,"_20544":116838,"_5":14097,"_26932":116776,"_2867":51498},[],{"_3381":69589,"_29612":69564,"_20544":116840,"_5":14097,"_26932":116776,"_2867":51484},[],{"_3381":69590,"_29612":69564,"_20544":116842,"_5":14097,"_26932":116776,"_2867":116843},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_3381":69591,"_29612":69564,"_20544":116845,"_5":14097,"_26932":116776,"_2867":116846},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3381":69592,"_29612":69564,"_20544":116848,"_5":14097,"_26932":116780,"_2867":116849},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_3381":69593,"_29612":69564,"_20544":116851,"_5":14097,"_26932":116780,"_2867":116852},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_3381":69594,"_29612":69564,"_20544":116854,"_5":14097,"_26932":116783,"_2867":116855},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_3381":69595,"_29612":69564,"_20544":116857,"_5":14097,"_26932":116783,"_2867":116858},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_3381":69596,"_29612":69564,"_20544":116860,"_5":14097,"_26932":116786,"_2867":116861},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_3381":69597,"_29612":69564,"_20544":116863,"_5":14097,"_26932":116786,"_2867":116864},[],"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_3381":69598,"_29612":69564,"_20544":116866,"_5":14097,"_26932":116789,"_2867":116867},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_3381":69599,"_29612":69564,"_20544":116869,"_5":14097,"_26932":116789,"_2867":116870},[],"El código admite RSA y ECDSA, y el valor `bits` del ajuste de clave del DMS significa algo distinto en cada caso. En ECDSA selecciona la curva: 224, 256, 384 o 521 corresponden a P-224, P-256, P-384 y P-521, y un tamaño no reconocido produce fallback a P-256, así que elige explícitamente un tamaño compatible y comprueba la clave resultante. En RSA se usa directamente como tamaño del módulo; la consola ofrece 2048, 3072 y 4096 bits. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_3381":69600,"_29612":69564,"_20544":116872,"_5":14097,"_26932":116792,"_2867":116873},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3381":69601,"_29612":69564,"_20544":116875,"_5":14097,"_26932":116792,"_2867":116876},[],"Parte",{"_3381":69602,"_29612":69564,"_20544":116878,"_5":14097,"_26932":116792,"_2867":116879},[],"Contenido tras decodificar su Base64",{"_3381":69603,"_29612":69564,"_20544":116881,"_5":14097,"_26932":116792,"_2867":51542},[],{"_3381":69604,"_29612":69564,"_20544":116883,"_5":14097,"_26932":116792,"_2867":116884},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3381":69605,"_29612":69564,"_20544":116886,"_5":14097,"_26932":116792,"_2867":51548},[],{"_3381":69606,"_29612":69564,"_20544":116888,"_5":14097,"_26932":116792,"_2867":116889},[],"PKCS#7 DER con el certificado emitido.",{"_3381":69607,"_29612":69564,"_20544":116891,"_5":14097,"_26932":116792,"_2867":116892},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3381":69608,"_29612":69564,"_20544":116894,"_5":14097,"_26932":116796,"_2867":116895},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3381":69609,"_29612":69564,"_20544":116897,"_5":14097,"_26932":116796,"_2867":116898},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_3381":69610,"_29612":69564,"_20544":116900,"_5":14097,"_26932":116796,"_2867":116901},[],"Convierte y comprueba el resultado:",{"_3381":69611,"_29612":69564,"_20544":116903,"_5":14097,"_26932":116796,"_2867":116904},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_3381":69612,"_29612":69564,"_20544":116906,"_5":14097,"_26932":116800,"_2867":116907},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3381":69613,"_29612":69564,"_20544":116909,"_5":14097,"_26932":116800,"_2867":116910},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3381":69614,"_29612":69614,"_5":14455,"_2867":116269,"_29965":116912,"_20544":116913,"_26932":69614},[48231,115085,50710,116094,116269],[],{"_3381":69615,"_29612":69614,"_20544":116915,"_5":14097,"_26932":69614,"_2867":116916},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_3381":69616,"_29612":69614,"_5":29962,"_20544":116918,"_26932":116919,"_2867":116920},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3381":69617,"_29612":69614,"_5":29962,"_20544":116922,"_26932":116923,"_2867":116924},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3381":69618,"_29612":69614,"_5":29962,"_20544":116926,"_26932":116927,"_2867":116928},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3381":69619,"_29612":69614,"_5":29962,"_20544":116930,"_26932":116931,"_2867":116932},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_3381":69620,"_29612":69614,"_20544":116934,"_5":14097,"_26932":69614,"_2867":116935},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3381":69621,"_29612":69614,"_20544":116937,"_5":14097,"_26932":116919,"_2867":116938},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3381":69622,"_29612":69614,"_20544":116940,"_5":14097,"_26932":116919,"_2867":116941},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3381":69623,"_29612":69614,"_20544":116943,"_5":14097,"_26932":116919,"_2867":116944},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3381":69624,"_29612":69614,"_20544":116946,"_5":14097,"_26932":116919,"_2867":116947},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3381":69625,"_29612":69614,"_20544":116949,"_5":14097,"_26932":116919,"_2867":116950},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3381":69626,"_29612":69614,"_20544":116952,"_5":14097,"_26932":116919,"_2867":116953},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3381":69627,"_29612":69614,"_20544":116955,"_5":14097,"_26932":116923,"_2867":116956},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3381":69628,"_29612":69614,"_20544":116958,"_5":14097,"_26932":116923,"_2867":116959},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3381":69629,"_29612":69614,"_20544":116961,"_5":14097,"_26932":116923,"_2867":116962},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3381":69630,"_29612":69614,"_20544":116964,"_5":14097,"_26932":116923,"_2867":116965},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3381":69631,"_29612":69614,"_20544":116967,"_5":14097,"_26932":116927,"_2867":116968},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3381":69632,"_29612":69614,"_20544":116970,"_5":14097,"_26932":116927,"_2867":116971},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3381":69633,"_29612":69614,"_20544":116973,"_5":14097,"_26932":116927,"_2867":116974},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3381":69634,"_29612":69614,"_20544":116976,"_5":14097,"_26932":116927,"_2867":116977},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3381":69635,"_29612":69614,"_20544":116979,"_5":14097,"_26932":116931,"_2867":116980},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_3381":69636,"_29612":69614,"_20544":116982,"_5":14097,"_26932":116931,"_2867":116983},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3381":69637,"_29612":69637,"_5":14455,"_2867":116985,"_29965":116986,"_20544":116987,"_26932":69637},"Estrategias de aprovisionamiento",[48231,115085,50710,116094,116269],[],{"_3381":69638,"_29612":69637,"_20544":116989,"_5":14097,"_26932":69637,"_2867":116990},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3381":69639,"_29612":69637,"_5":29962,"_20544":116992,"_26932":116993,"_2867":116994},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3381":69640,"_29612":69637,"_5":29962,"_20544":116996,"_26932":116997,"_2867":116998},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3381":69641,"_29612":69637,"_5":29962,"_20544":117000,"_26932":117001,"_2867":117002},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3381":69642,"_29612":69637,"_5":29962,"_20544":117004,"_26932":117005,"_2867":117006},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3381":69643,"_29612":69637,"_5":29962,"_20544":117008,"_26932":117009,"_2867":117010},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3381":69644,"_29612":69637,"_20544":117012,"_5":14097,"_26932":69637,"_2867":117013},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3381":69645,"_29612":69637,"_20544":117015,"_5":14097,"_26932":116993,"_2867":117016},[],"Recorrido",{"_3381":69646,"_29612":69637,"_20544":117018,"_5":14097,"_26932":116993,"_2867":117019},[],"Cuándo existe el dispositivo",{"_3381":69647,"_29612":69637,"_20544":117021,"_5":14097,"_26932":116993,"_2867":117022},[],"Qué compruebas",{"_3381":69648,"_29612":69637,"_20544":117024,"_5":14097,"_26932":116993,"_2867":117025},[],"Asignación manual",{"_3381":69649,"_29612":69637,"_20544":117027,"_5":14097,"_26932":116993,"_2867":117028},[],"El operador lo crea antes de asociar un certificado.",{"_3381":69650,"_29612":69637,"_20544":117030,"_5":14097,"_26932":116993,"_2867":117031},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3381":69651,"_29612":69637,"_20544":117033,"_5":14097,"_26932":116993,"_2867":117034},[],"EST con `JITP`",{"_3381":69652,"_29612":69637,"_20544":117036,"_5":14097,"_26932":116993,"_2867":117037},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3381":69653,"_29612":69637,"_20544":117039,"_5":14097,"_26932":116993,"_2867":117040},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3381":69654,"_29612":69637,"_20544":117042,"_5":14097,"_26932":116993,"_2867":117043},[],"EST con `PRE_REGISTRATION`",{"_3381":69655,"_29612":69637,"_20544":117045,"_5":14097,"_26932":116993,"_2867":117046},[],"Debe existir antes de `/simpleenroll`.",{"_3381":69656,"_29612":69637,"_20544":117048,"_5":14097,"_26932":116993,"_2867":117049},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3381":69657,"_29612":69637,"_20544":117051,"_5":14097,"_26932":116993,"_2867":117052},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3381":69658,"_29612":69637,"_20544":117054,"_5":14097,"_26932":116993,"_2867":117055},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3381":69659,"_29612":69637,"_20544":117057,"_5":14097,"_26932":116997,"_2867":117058},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3381":69660,"_29612":69637,"_20544":117060,"_5":14097,"_26932":116997,"_2867":117061},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3381":69661,"_29612":69637,"_20544":117063,"_5":14097,"_26932":116997,"_2867":117064},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3381":69662,"_29612":69637,"_20544":117066,"_5":14097,"_26932":117001,"_2867":117067},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3381":69663,"_29612":69637,"_20544":117069,"_5":14097,"_26932":117001,"_2867":117070},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3381":69664,"_29612":69637,"_20544":117072,"_5":14097,"_26932":117001,"_2867":117073},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3381":69665,"_29612":69637,"_20544":117075,"_5":14097,"_26932":117001,"_2867":117076},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3381":69666,"_29612":69637,"_20544":117078,"_5":14097,"_26932":117001,"_2867":117079},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3381":69667,"_29612":69637,"_20544":117081,"_5":14097,"_26932":117001,"_2867":117082},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3381":69668,"_29612":69637,"_20544":117084,"_5":14097,"_26932":117005,"_2867":114027},[],{"_3381":69669,"_29612":69637,"_20544":117086,"_5":14097,"_26932":117005,"_2867":117087},[],"Material que atraviesa EST",{"_3381":69670,"_29612":69637,"_20544":117089,"_5":14097,"_26932":117005,"_2867":117090},[],"Clave generada por el dispositivo",{"_3381":69671,"_29612":69637,"_20544":117092,"_5":14097,"_26932":117005,"_2867":117093},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3381":69672,"_29612":69637,"_20544":117095,"_5":14097,"_26932":117005,"_2867":117096},[],"Clave ya disponible en el dispositivo",{"_3381":69673,"_29612":69637,"_20544":117098,"_5":14097,"_26932":117005,"_2867":117099},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3381":69674,"_29612":69637,"_20544":117101,"_5":14097,"_26932":117005,"_2867":51029},[],{"_3381":69675,"_29612":69637,"_20544":117103,"_5":14097,"_26932":117005,"_2867":117104},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3381":69676,"_29612":69637,"_20544":117106,"_5":14097,"_26932":117005,"_2867":117107},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3381":69677,"_29612":69637,"_20544":117109,"_5":14097,"_26932":117009,"_2867":117110},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3381":69678,"_29612":69678,"_5":14455,"_2867":117112,"_29965":117113,"_20544":117114,"_26932":69678},"Renovación y recuperación",[48231,115085,50710,116094,116269],[],{"_3381":69679,"_29612":69678,"_20544":117116,"_5":14097,"_26932":69678,"_2867":117117},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_3381":69680,"_29612":69678,"_5":29962,"_20544":117119,"_26932":117120,"_2867":117121},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_3381":69681,"_29612":69678,"_5":29962,"_20544":117123,"_26932":117124,"_2867":117125},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_3381":69682,"_29612":69678,"_5":29962,"_20544":117127,"_26932":117128,"_2867":117129},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_3381":69683,"_29612":69678,"_5":29962,"_20544":117131,"_26932":117132,"_2867":117133},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_3381":69684,"_29612":69678,"_5":29962,"_20544":117135,"_26932":117136,"_2867":117137},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_3381":69685,"_29612":69678,"_20544":117139,"_5":14097,"_26932":69678,"_2867":117140},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_3381":69686,"_29612":69678,"_20544":117142,"_5":14097,"_26932":117120,"_2867":117143},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3381":69687,"_29612":69678,"_20544":117145,"_5":14097,"_26932":117120,"_2867":117146},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3381":69688,"_29612":69678,"_20544":117148,"_5":14097,"_26932":117120,"_2867":117149},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3381":69689,"_29612":69678,"_20544":117151,"_5":14097,"_26932":117120,"_2867":117152},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3381":69690,"_29612":69678,"_20544":117154,"_5":14097,"_26932":117124,"_2867":117155},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3381":69691,"_29612":69678,"_20544":117157,"_5":14097,"_26932":117124,"_2867":117158},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3381":69692,"_29612":69678,"_20544":117160,"_5":14097,"_26932":117128,"_2867":117161},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3381":69693,"_29612":69678,"_20544":117163,"_5":14097,"_26932":117128,"_2867":117164},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3381":69694,"_29612":69678,"_20544":117166,"_5":14097,"_26932":117128,"_2867":117167},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3381":69695,"_29612":69678,"_20544":117169,"_5":14097,"_26932":117132,"_2867":117170},[],"Situación",{"_3381":69696,"_29612":69678,"_20544":117172,"_5":14097,"_26932":117132,"_2867":117173},[],"Procedimiento",{"_3381":69697,"_29612":69678,"_20544":117175,"_5":14097,"_26932":117132,"_2867":117176},[],"Certificado vigente, fuera de ventana",{"_3381":69698,"_29612":69678,"_20544":117178,"_5":14097,"_26932":117132,"_2867":117179},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3381":69699,"_29612":69678,"_20544":117181,"_5":14097,"_26932":117132,"_2867":117182},[],"Certificado vencido, clave disponible",{"_3381":69700,"_29612":69678,"_20544":117184,"_5":14097,"_26932":117132,"_2867":117185},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3381":69701,"_29612":69678,"_20544":117187,"_5":14097,"_26932":117132,"_2867":117188},[],"Renovación por webhook o `NO_AUTH`",{"_3381":69702,"_29612":69678,"_20544":117190,"_5":14097,"_26932":117132,"_2867":117191},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3381":69703,"_29612":69678,"_20544":117193,"_5":14097,"_26932":117132,"_2867":117194},[],"Clave perdida o inaccesible",{"_3381":69704,"_29612":69678,"_20544":117196,"_5":14097,"_26932":117132,"_2867":117197},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3381":69705,"_29612":69678,"_20544":117199,"_5":14097,"_26932":117132,"_2867":117200},[],"Identidad actual revocada",{"_3381":69706,"_29612":69678,"_20544":117202,"_5":14097,"_26932":117132,"_2867":117203},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3381":69707,"_29612":69678,"_20544":117205,"_5":14097,"_26932":117132,"_2867":117206},[],"Dispositivo sin identidad",{"_3381":69708,"_29612":69678,"_20544":117208,"_5":14097,"_26932":117132,"_2867":117209},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3381":69709,"_29612":69678,"_20544":117211,"_5":14097,"_26932":117132,"_2867":117212},[],"Dispositivo retirado",{"_3381":69710,"_29612":69678,"_20544":117214,"_5":14097,"_26932":117132,"_2867":117215},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3381":69711,"_29612":69678,"_20544":117217,"_5":14097,"_26932":117132,"_2867":117218},[],"Timeout, HTTP 500 o fallo de instalación",{"_3381":69712,"_29612":69678,"_20544":117220,"_5":14097,"_26932":117132,"_2867":117221},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3381":69713,"_29612":69678,"_20544":117223,"_5":14097,"_26932":117136,"_2867":117224},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3381":69714,"_29612":69678,"_20544":117226,"_5":14097,"_26932":117136,"_2867":117227},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3381":69715,"_29612":69715,"_5":14455,"_2867":117229,"_29965":117230,"_20544":117231,"_26932":69715},"Diagnóstico de enrolamiento",[48231,115085,50710,116094,116269],[],{"_3381":69716,"_29612":69715,"_20544":117233,"_5":14097,"_26932":69715,"_2867":117234},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3381":69717,"_29612":69715,"_5":29962,"_20544":117236,"_26932":117237,"_2867":117238},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3381":69718,"_29612":69715,"_5":29962,"_20544":117240,"_26932":117241,"_2867":117242},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3381":69719,"_29612":69715,"_5":29962,"_20544":117244,"_26932":117245,"_2867":116801},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_3381":69720,"_29612":69715,"_5":29962,"_20544":117247,"_26932":117248,"_2867":117249},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3381":69721,"_29612":69715,"_20544":117251,"_5":14097,"_26932":69715,"_2867":117252},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3381":69722,"_29612":69715,"_20544":117254,"_5":14097,"_26932":117241,"_2867":117255},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3381":69723,"_29612":69715,"_20544":117257,"_5":14097,"_26932":117241,"_2867":117258},[],"Síntoma o mensaje",{"_3381":69724,"_29612":69715,"_20544":117260,"_5":14097,"_26932":117241,"_2867":117261},[],"Qué revisar",{"_3381":69725,"_29612":69715,"_20544":117263,"_5":14097,"_26932":117241,"_2867":117264},[],"curl rechaza TLS, nombre o emisor",{"_3381":69726,"_29612":69715,"_20544":117266,"_5":14097,"_26932":117241,"_2867":117267},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3381":69727,"_29612":69715,"_20544":117269,"_5":14097,"_26932":117241,"_2867":117270},[],"404 o APS ausente",{"_3381":69728,"_29612":69715,"_20544":117272,"_5":14097,"_26932":117241,"_2867":117273},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3381":69729,"_29612":69715,"_20544":117275,"_5":14097,"_26932":117241,"_2867":117276},[],"400, error de CSR o formato",{"_3381":69730,"_29612":69715,"_20544":117278,"_5":14097,"_26932":117241,"_2867":117279},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3381":69731,"_29612":69715,"_20544":117281,"_5":14097,"_26932":117241,"_2867":117282},[],"Credencial ausente o certificado no válido",{"_3381":69732,"_29612":69715,"_20544":117284,"_5":14097,"_26932":117241,"_2867":117285},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3381":69733,"_29612":69715,"_20544":117287,"_5":14097,"_26932":117241,"_2867":117288},[],"Webhook deniega, expira o responde sin autorización",{"_3381":69734,"_29612":69715,"_20544":117290,"_5":14097,"_26932":117241,"_2867":117291},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3381":69735,"_29612":69715,"_20544":117293,"_5":14097,"_26932":117241,"_2867":51955},[],{"_3381":69736,"_29612":69715,"_20544":117295,"_5":14097,"_26932":117241,"_2867":117296},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3381":69737,"_29612":69715,"_20544":117298,"_5":14097,"_26932":117241,"_2867":51961},[],{"_3381":69738,"_29612":69715,"_20544":117300,"_5":14097,"_26932":117241,"_2867":117301},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3381":69739,"_29612":69715,"_20544":117303,"_5":14097,"_26932":117241,"_2867":51967},[],{"_3381":69740,"_29612":69715,"_20544":117305,"_5":14097,"_26932":117241,"_2867":117306},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3381":69741,"_29612":69715,"_20544":117308,"_5":14097,"_26932":117241,"_2867":51973},[],{"_3381":69742,"_29612":69715,"_20544":117310,"_5":14097,"_26932":117241,"_2867":117311},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3381":69743,"_29612":69715,"_20544":117313,"_5":14097,"_26932":117241,"_2867":51979},[],{"_3381":69744,"_29612":69715,"_20544":117315,"_5":14097,"_26932":117241,"_2867":117316},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3381":69745,"_29612":69715,"_20544":117318,"_5":14097,"_26932":117241,"_2867":117319},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3381":69746,"_29612":69715,"_20544":117321,"_5":14097,"_26932":117241,"_2867":117322},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3381":69747,"_29612":69715,"_20544":117324,"_5":14097,"_26932":117241,"_2867":117325},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3381":69748,"_29612":69715,"_20544":117327,"_5":14097,"_26932":117241,"_2867":117328},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3381":69749,"_29612":69715,"_20544":117330,"_5":14097,"_26932":117241,"_2867":51997},[],{"_3381":69750,"_29612":69715,"_20544":117332,"_5":14097,"_26932":117241,"_2867":117333},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3381":69751,"_29612":69715,"_20544":117335,"_5":14097,"_26932":117241,"_2867":52003},[],{"_3381":69752,"_29612":69715,"_20544":117337,"_5":14097,"_26932":117241,"_2867":117338},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3381":69753,"_29612":69715,"_20544":117340,"_5":14097,"_26932":117241,"_2867":117341},[],"DMS propietario distinto",{"_3381":69754,"_29612":69715,"_20544":117343,"_5":14097,"_26932":117241,"_2867":117344},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3381":69755,"_29612":69715,"_20544":117346,"_5":14097,"_26932":117241,"_2867":52015},[],{"_3381":69756,"_29612":69715,"_20544":117348,"_5":14097,"_26932":117241,"_2867":117349},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3381":69757,"_29612":69715,"_20544":117351,"_5":14097,"_26932":117241,"_2867":52021},[],{"_3381":69758,"_29612":69715,"_20544":117353,"_5":14097,"_26932":117241,"_2867":117354},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3381":69759,"_29612":69715,"_20544":117356,"_5":14097,"_26932":117241,"_2867":117357},[],"Certificado actual revocado",{"_3381":69760,"_29612":69715,"_20544":117359,"_5":14097,"_26932":117241,"_2867":117360},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3381":69761,"_29612":69715,"_20544":117362,"_5":14097,"_26932":117241,"_2867":117363},[],"Error de CA, perfil o firma",{"_3381":69762,"_29612":69715,"_20544":117365,"_5":14097,"_26932":117241,"_2867":117366},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3381":69763,"_29612":69715,"_20544":117368,"_5":14097,"_26932":117241,"_2867":117369},[],"HTTP 200 sin conexión del dispositivo",{"_3381":69764,"_29612":69715,"_20544":117371,"_5":14097,"_26932":117241,"_2867":117372},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3381":69765,"_29612":69715,"_20544":117374,"_5":14097,"_26932":117241,"_2867":117375},[],"Timeout o error después de emitir",{"_3381":69766,"_29612":69715,"_20544":117377,"_5":14097,"_26932":117241,"_2867":117378},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3381":69767,"_29612":69715,"_20544":117380,"_5":14097,"_26932":117245,"_2867":117381},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3381":69768,"_29612":69715,"_20544":117383,"_5":14097,"_26932":117245,"_2867":117384},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_3381":69769,"_29612":69715,"_20544":117386,"_5":14097,"_26932":117248,"_2867":117387},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3381":69770,"_29612":69715,"_20544":117389,"_5":14097,"_26932":117248,"_2867":117390},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3381":69771,"_29612":69715,"_20544":117392,"_5":14097,"_26932":117248,"_2867":117393},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3381":69772,"_29612":69715,"_20544":117395,"_5":14097,"_26932":117248,"_2867":117396},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3381":69773,"_29612":69715,"_20544":117398,"_5":14097,"_26932":117248,"_2867":117399},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3381":69774,"_29612":69715,"_20544":117401,"_5":14097,"_26932":117248,"_2867":117402},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3381":69775,"_29612":69715,"_20544":117404,"_5":14097,"_26932":117248,"_2867":117405},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3381":69776,"_29612":69776,"_5":14455,"_2867":117407,"_29965":117408,"_20544":117409,"_26932":69776},"Distribución y actualización de confianza",[48231,115085,50710,116094,116269],[],{"_3381":69777,"_29612":69776,"_20544":117411,"_5":14097,"_26932":69776,"_2867":117412},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_3381":69778,"_29612":69776,"_5":29962,"_20544":117414,"_26932":117415,"_2867":117416},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_3381":69779,"_29612":69776,"_5":29962,"_20544":117418,"_26932":117419,"_2867":117420},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_3381":69780,"_29612":69776,"_5":29962,"_20544":117422,"_26932":117423,"_2867":117424},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_3381":69781,"_29612":69776,"_5":29962,"_20544":117426,"_26932":117427,"_2867":117428},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_3381":69782,"_29612":69776,"_5":29962,"_20544":117430,"_26932":117431,"_2867":117432},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_3381":69783,"_29612":69776,"_20544":117434,"_5":14097,"_26932":69776,"_2867":117435},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_3381":69784,"_29612":69776,"_20544":117437,"_5":14097,"_26932":117415,"_2867":117438},[],"Relación",{"_3381":69785,"_29612":69776,"_20544":117440,"_5":14097,"_26932":117415,"_2867":117441},[],"Material que prepara el responsable",{"_3381":69786,"_29612":69776,"_20544":117443,"_5":14097,"_26932":117415,"_2867":117444},[],"Dispositivo → servidor EST",{"_3381":69787,"_29612":69776,"_20544":117446,"_5":14097,"_26932":117415,"_2867":117447},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_3381":69788,"_29612":69776,"_20544":117449,"_5":14097,"_26932":117415,"_2867":117450},[],"DMS → solicitante",{"_3381":69789,"_29612":69776,"_20544":117452,"_5":14097,"_26932":117415,"_2867":117453},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_3381":69790,"_29612":69776,"_20544":117455,"_5":14097,"_26932":117415,"_2867":117456},[],"Consumidor → dispositivo",{"_3381":69791,"_29612":69776,"_20544":117458,"_5":14097,"_26932":117415,"_2867":117459},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_3381":69792,"_29612":69776,"_20544":117461,"_5":14097,"_26932":117415,"_2867":117462},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_3381":69793,"_29612":69776,"_20544":117464,"_5":14097,"_26932":117419,"_2867":117465},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3381":69794,"_29612":69776,"_20544":117467,"_5":14097,"_26932":117419,"_2867":117468},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3381":69795,"_29612":69776,"_20544":117470,"_5":14097,"_26932":117423,"_2867":117471},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_3381":69796,"_29612":69776,"_20544":117473,"_5":14097,"_26932":117423,"_2867":117474},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_3381":69797,"_29612":69776,"_20544":117476,"_5":14097,"_26932":117423,"_2867":117477},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_3381":69798,"_29612":69776,"_20544":117479,"_5":14097,"_26932":117423,"_2867":117480},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_3381":69799,"_29612":69776,"_20544":117482,"_5":14097,"_26932":117423,"_2867":117483},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_3381":69800,"_29612":69776,"_20544":117485,"_5":14097,"_26932":117423,"_2867":117486},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_3381":69801,"_29612":69776,"_20544":117488,"_5":14097,"_26932":117427,"_2867":117489},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_3381":69802,"_29612":69776,"_20544":117491,"_5":14097,"_26932":117427,"_2867":117492},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_3381":69803,"_29612":69776,"_20544":117494,"_5":14097,"_26932":117427,"_2867":117495},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_3381":69804,"_29612":69776,"_20544":117497,"_5":14097,"_26932":117431,"_2867":117498},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_3381":69805,"_29612":69805,"_5":14455,"_2867":52170,"_29965":117500,"_20544":117502,"_26932":69805},[48231,115085,50710,116094,117501],"Integraciones",[],{"_3381":69806,"_29612":69805,"_20544":117504,"_5":14097,"_26932":69805,"_2867":117505},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3381":69807,"_29612":69805,"_5":29962,"_20544":117507,"_26932":117508,"_2867":117509},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3381":69808,"_29612":69805,"_5":29962,"_20544":117511,"_26932":117512,"_2867":117513},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3381":69809,"_29612":69805,"_5":29962,"_20544":117515,"_26932":117516,"_2867":117517},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3381":69810,"_29612":69805,"_5":29962,"_20544":117519,"_26932":117520,"_2867":117521},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3381":69811,"_29612":69805,"_5":29962,"_20544":117523,"_26932":117524,"_2867":117525},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/integrations/aws-iot-core#máquina-de-estados-de-los-recursos","Máquina de estados de los recursos",{"_3381":69812,"_29612":69805,"_5":29962,"_20544":117527,"_26932":117528,"_2867":117529},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/integrations/aws-iot-core#eventos-que-gestiona-el-conector","Eventos que gestiona el conector",{"_3381":69813,"_29612":69805,"_5":29962,"_20544":117531,"_26932":117532,"_2867":117533},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","Estados del registro de la CA",{"_3381":69814,"_29612":69805,"_5":29962,"_20544":117535,"_26932":117536,"_2867":117537},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","Estados del modo de registro del DMS",{"_3381":69815,"_29612":69805,"_5":29962,"_20544":117539,"_26932":117540,"_2867":117541},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","Estados del certificado",{"_3381":69816,"_29612":69805,"_5":29962,"_20544":117543,"_26932":117544,"_2867":117545},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","Ciclo de vida del Thing",{"_3381":69817,"_29612":69805,"_5":29962,"_20544":117547,"_26932":117548,"_2867":117549},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3381":69818,"_29612":69805,"_5":29962,"_20544":117551,"_26932":117552,"_2867":117553},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3381":69819,"_29612":69805,"_5":29962,"_20544":117555,"_26932":117556,"_2867":52228},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3381":69820,"_29612":69805,"_5":29962,"_20544":117558,"_26932":117559,"_2867":52232},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3381":69821,"_29612":69805,"_5":29962,"_20544":117561,"_26932":117562,"_2867":117563},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3381":69822,"_29612":69805,"_5":29962,"_20544":117565,"_26932":117566,"_2867":117567},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3381":69823,"_29612":69805,"_5":29962,"_20544":117569,"_26932":117570,"_2867":117571},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3381":69824,"_29612":69805,"_5":29962,"_20544":117573,"_26932":117574,"_2867":117575},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3381":69825,"_29612":69805,"_5":29962,"_20544":117577,"_26932":117578,"_2867":117579},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3381":69826,"_29612":69805,"_5":29962,"_20544":117581,"_26932":117582,"_2867":117583},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3381":69827,"_29612":69805,"_5":29962,"_20544":117585,"_26932":117586,"_2867":117587},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3381":69828,"_29612":69805,"_5":29962,"_20544":117589,"_26932":117590,"_2867":117591},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3381":69829,"_29612":69805,"_5":29962,"_20544":117593,"_26932":117594,"_2867":117595},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3381":69830,"_29612":69805,"_5":29962,"_20544":117597,"_26932":117598,"_2867":117599},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3381":69831,"_29612":69805,"_5":29962,"_20544":117601,"_26932":117602,"_2867":117603},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3381":69832,"_29612":69805,"_5":29962,"_20544":117605,"_26932":117606,"_2867":117607},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3381":69833,"_29612":69805,"_20544":117609,"_5":14097,"_26932":69805,"_2867":117610},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3381":69834,"_29612":69805,"_20544":117612,"_5":14097,"_26932":69805,"_2867":117613},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3381":69835,"_29612":69805,"_20544":117615,"_5":14097,"_26932":69805,"_2867":117616},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3381":69836,"_29612":69805,"_20544":117618,"_5":14097,"_26932":117508,"_2867":117619},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3381":69837,"_29612":69805,"_20544":117621,"_5":14097,"_26932":117508,"_2867":117622},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3381":69838,"_29612":69805,"_20544":117624,"_5":14097,"_26932":117508,"_2867":117625},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3381":69839,"_29612":69805,"_20544":117627,"_5":14097,"_26932":117508,"_2867":117628},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3381":69840,"_29612":69805,"_20544":117630,"_5":14097,"_26932":117512,"_2867":117631},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3381":69841,"_29612":69805,"_20544":117633,"_5":14097,"_26932":117516,"_2867":117634},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3381":69842,"_29612":69805,"_20544":117636,"_5":14097,"_26932":117516,"_2867":117637},[],"Acción IAM",{"_3381":69843,"_29612":69805,"_20544":117639,"_5":14097,"_26932":117516,"_2867":114033},[],{"_3381":69844,"_29612":69805,"_20544":117641,"_5":14097,"_26932":117516,"_2867":52315},[],{"_3381":69845,"_29612":69805,"_20544":117643,"_5":14097,"_26932":117516,"_2867":117644},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3381":69846,"_29612":69805,"_20544":117646,"_5":14097,"_26932":117516,"_2867":52321},[],{"_3381":69847,"_29612":69805,"_20544":117648,"_5":14097,"_26932":117516,"_2867":117649},[],"Registrar la CA en AWS IoT",{"_3381":69848,"_29612":69805,"_20544":117651,"_5":14097,"_26932":117516,"_2867":52327},[],{"_3381":69849,"_29612":69805,"_20544":117653,"_5":14097,"_26932":117516,"_2867":117654},[],"Consultar el estado del registro de la CA",{"_3381":69850,"_29612":69805,"_20544":117656,"_5":14097,"_26932":117516,"_2867":52333},[],{"_3381":69851,"_29612":69805,"_20544":117658,"_5":14097,"_26932":117516,"_2867":117659},[],"Crear o actualizar Things en IoT Core",{"_3381":69852,"_29612":69805,"_20544":117661,"_5":14097,"_26932":117516,"_2867":52339},[],{"_3381":69853,"_29612":69805,"_20544":117663,"_5":14097,"_26932":117516,"_2867":117664},[],"Aprovisionar Things mediante plantilla",{"_3381":69854,"_29612":69805,"_20544":117666,"_5":14097,"_26932":117516,"_2867":52345},[],{"_3381":69855,"_29612":69805,"_20544":117668,"_5":14097,"_26932":117516,"_2867":117669},[],"Registrar certificados de dispositivo",{"_3381":69856,"_29612":69805,"_20544":117671,"_5":14097,"_26932":117516,"_2867":52351},[],{"_3381":69857,"_29612":69805,"_20544":117673,"_5":14097,"_26932":117516,"_2867":117674},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3381":69858,"_29612":69805,"_20544":117676,"_5":14097,"_26932":117516,"_2867":52357},[],{"_3381":69859,"_29612":69805,"_20544":117678,"_5":14097,"_26932":117516,"_2867":117679},[],"Crear y adjuntar políticas IoT",{"_3381":69860,"_29612":69805,"_20544":117681,"_5":14097,"_26932":117516,"_2867":52363},[],{"_3381":69861,"_29612":69805,"_20544":117683,"_5":14097,"_26932":117516,"_2867":117684},[],"Gestionar grupos de Things",{"_3381":69862,"_29612":69805,"_20544":117686,"_5":14097,"_26932":117516,"_2867":52369},[],{"_3381":69863,"_29612":69805,"_20544":117688,"_5":14097,"_26932":117516,"_2867":117689},[],"Crear plantillas JITP",{"_3381":69864,"_29612":69805,"_20544":117691,"_5":14097,"_26932":117516,"_2867":52375},[],{"_3381":69865,"_29612":69805,"_20544":117693,"_5":14097,"_26932":117516,"_2867":117694},[],"Leer y escribir el Device Shadow",{"_3381":69866,"_29612":69805,"_20544":117696,"_5":14097,"_26932":117516,"_2867":117697},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3381":69867,"_29612":69805,"_20544":117699,"_5":14097,"_26932":117520,"_2867":117700},[],"Parámetro",{"_3381":69868,"_29612":69805,"_20544":117702,"_5":14097,"_26932":117520,"_2867":117703},[],"Tipo",{"_3381":69869,"_29612":69805,"_20544":117705,"_5":14097,"_26932":117520,"_2867":117706},[],"Requerido",{"_3381":69870,"_29612":69805,"_20544":117708,"_5":14097,"_26932":117520,"_2867":117709},[],"Descripción",{"_3381":69871,"_29612":69805,"_20544":117711,"_5":14097,"_26932":117520,"_2867":52396},[],{"_3381":69872,"_29612":69805,"_20544":117713,"_5":14097,"_26932":117520,"_2867":24548},[],{"_3381":69873,"_29612":69805,"_20544":117715,"_5":14097,"_26932":117520,"_2867":117716},[],"Sí",{"_3381":69874,"_29612":69805,"_20544":117718,"_5":14097,"_26932":117520,"_2867":117719},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3381":69875,"_29612":69805,"_20544":117721,"_5":14097,"_26932":117520,"_2867":52407},[],{"_3381":69876,"_29612":69805,"_20544":117723,"_5":14097,"_26932":117520,"_2867":24548},[],{"_3381":69877,"_29612":69805,"_20544":117725,"_5":14097,"_26932":117520,"_2867":117716},[],{"_3381":69878,"_29612":69805,"_20544":117727,"_5":14097,"_26932":117520,"_2867":117728},[],"Región AWS donde opera el conector.",{"_3381":69879,"_29612":69805,"_20544":117730,"_5":14097,"_26932":117520,"_2867":52417},[],{"_3381":69880,"_29612":69805,"_20544":117732,"_5":14097,"_26932":117520,"_2867":24548},[],{"_3381":69881,"_29612":69805,"_20544":117734,"_5":14097,"_26932":117520,"_2867":117716},[],{"_3381":69882,"_29612":69805,"_20544":117736,"_5":14097,"_26932":117520,"_2867":117737},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3381":69883,"_29612":69805,"_20544":117739,"_5":14097,"_26932":117520,"_2867":52427},[],{"_3381":69884,"_29612":69805,"_20544":117741,"_5":14097,"_26932":117520,"_2867":24548},[],{"_3381":69885,"_29612":69805,"_20544":117743,"_5":14097,"_26932":117520,"_2867":117744},[],"Solo con `auth_method=static`",{"_3381":69886,"_29612":69805,"_20544":117746,"_5":14097,"_26932":117520,"_2867":117747},[],"Clave de acceso AWS.",{"_3381":69887,"_29612":69805,"_20544":117749,"_5":14097,"_26932":117520,"_2867":52438},[],{"_3381":69888,"_29612":69805,"_20544":117751,"_5":14097,"_26932":117520,"_2867":24548},[],{"_3381":69889,"_29612":69805,"_20544":117753,"_5":14097,"_26932":117520,"_2867":117744},[],{"_3381":69890,"_29612":69805,"_20544":117755,"_5":14097,"_26932":117520,"_2867":117756},[],"Clave secreta AWS.",{"_3381":69891,"_29612":69805,"_20544":117758,"_5":14097,"_26932":117520,"_2867":52448},[],{"_3381":69892,"_29612":69805,"_20544":117760,"_5":14097,"_26932":117520,"_2867":24548},[],{"_3381":69893,"_29612":69805,"_20544":117762,"_5":14097,"_26932":117520,"_2867":52453},[],{"_3381":69894,"_29612":69805,"_20544":117764,"_5":14097,"_26932":117520,"_2867":117765},[],"Token de sesión (con `auth_method=static`).",{"_3381":69895,"_29612":69805,"_20544":117767,"_5":14097,"_26932":117520,"_2867":52459},[],{"_3381":69896,"_29612":69805,"_20544":117769,"_5":14097,"_26932":117520,"_2867":24548},[],{"_3381":69897,"_29612":69805,"_20544":117771,"_5":14097,"_26932":117520,"_2867":117772},[],"Solo con `auth_method=role`",{"_3381":69898,"_29612":69805,"_20544":117774,"_5":14097,"_26932":117520,"_2867":117775},[],"ARN del rol a asumir.",{"_3381":69899,"_29612":69805,"_20544":117777,"_5":14097,"_26932":117520,"_2867":52470},[],{"_3381":69900,"_29612":69805,"_20544":117779,"_5":14097,"_26932":117520,"_2867":24548},[],{"_3381":69901,"_29612":69805,"_20544":117781,"_5":14097,"_26932":117520,"_2867":52453},[],{"_3381":69902,"_29612":69805,"_20544":117783,"_5":14097,"_26932":117520,"_2867":117784},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3381":69903,"_29612":69805,"_20544":117786,"_5":14097,"_26932":117520,"_2867":52480},[],{"_3381":69904,"_29612":69805,"_20544":117788,"_5":14097,"_26932":117520,"_2867":87695},[],{"_3381":69905,"_29612":69805,"_20544":117790,"_5":14097,"_26932":117520,"_2867":117716},[],{"_3381":69906,"_29612":69805,"_20544":117792,"_5":14097,"_26932":117520,"_2867":117793},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3381":69907,"_29612":69805,"_20544":117795,"_5":14097,"_26932":117520,"_2867":52490},[],{"_3381":69908,"_29612":69805,"_20544":117797,"_5":14097,"_26932":117520,"_2867":24548},[],{"_3381":69909,"_29612":69805,"_20544":117799,"_5":14097,"_26932":117520,"_2867":117716},[],{"_3381":69910,"_29612":69805,"_20544":117801,"_5":14097,"_26932":117520,"_2867":117802},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3381":69911,"_29612":69805,"_20544":117804,"_5":14097,"_26932":117520,"_2867":52500},[],{"_3381":69912,"_29612":69805,"_20544":117806,"_5":14097,"_26932":117520,"_2867":24548},[],{"_3381":69913,"_29612":69805,"_20544":117808,"_5":14097,"_26932":117520,"_2867":117716},[],{"_3381":69914,"_29612":69805,"_20544":117810,"_5":14097,"_26932":117520,"_2867":117811},[],"URL HTTP del Device Manager de Lamassu.",{"_3381":69915,"_29612":69805,"_20544":117813,"_5":14097,"_26932":117520,"_2867":52510},[],{"_3381":69916,"_29612":69805,"_20544":117815,"_5":14097,"_26932":117520,"_2867":24548},[],{"_3381":69917,"_29612":69805,"_20544":117817,"_5":14097,"_26932":117520,"_2867":117716},[],{"_3381":69918,"_29612":69805,"_20544":117819,"_5":14097,"_26932":117520,"_2867":117820},[],"URL HTTP del servicio de CA de Lamassu.",{"_3381":69919,"_29612":69805,"_20544":117822,"_5":14097,"_26932":117524,"_2867":117823},[],"El conector gestiona el lado AWS de cuatro tipos de recursos: CAs, plantillas de aprovisionamiento de DMS (JITP), certificados de dispositivo y Things. Esta sección mapea los eventos del bus que consume el conector a los recursos de AWS que toca y a las llamadas AWS que ejecuta cada transición. Los recursos de AWS se referencian con la notación `IoTCore/<recurso>`.",{"_3381":69920,"_29612":69805,"_20544":117825,"_5":14097,"_26932":117528,"_2867":117826},[],"La columna **Tipo de CloudEvent** lista el nombre del evento en el bus interno de Lamassu; la columna **Acciones IAM** lista las operaciones exactas del SDK de AWS que invoca cada flujo, para que los permisos necesarios se deriven directamente de esta tabla.",{"_3381":69921,"_29612":69805,"_20544":117828,"_5":14097,"_26932":117528,"_2867":117829},[],"Tipo de CloudEvent",{"_3381":69922,"_29612":69805,"_20544":117831,"_5":14097,"_26932":117528,"_2867":117832},[],"Recurso en Lamassu",{"_3381":69923,"_29612":69805,"_20544":117834,"_5":14097,"_26932":117528,"_2867":117835},[],"Recurso AWS",{"_3381":69924,"_29612":69805,"_20544":117837,"_5":14097,"_26932":117528,"_2867":117838},[],"Acciones IAM",{"_3381":69925,"_29612":69805,"_20544":117840,"_5":14097,"_26932":117528,"_2867":117841},[],"Llamadas AWS y efecto",{"_3381":69926,"_29612":69805,"_20544":117843,"_5":14097,"_26932":117528,"_2867":117844},[],"Dónde en esta página",{"_3381":69927,"_29612":69805,"_20544":117846,"_5":14097,"_26932":117528,"_2867":52544},[],{"_3381":69928,"_29612":69805,"_20544":117848,"_5":14097,"_26932":117528,"_2867":52547},[],{"_3381":69929,"_29612":69805,"_20544":117850,"_5":14097,"_26932":117528,"_2867":52550},[],{"_3381":69930,"_29612":69805,"_20544":117852,"_5":14097,"_26932":117528,"_2867":52553},[],{"_3381":69931,"_29612":69805,"_20544":117854,"_5":14097,"_26932":117528,"_2867":117855},[],"Carga la CA en el estado del conector; una escritura de `registration.status = REQUESTED` dispara el flujo de registro (Primary con certificado de verificación, o SNI-only) y escribe `SUCCEEDED` o `FAILED` en los metadatos de la CA.",{"_3381":69932,"_29612":69805,"_20544":117857,"_5":14097,"_26932":117528,"_2867":117533},[],{"_3381":69933,"_29612":69805,"_20544":117859,"_5":14097,"_26932":117528,"_2867":52561},[],{"_3381":69934,"_29612":69805,"_20544":117861,"_5":14097,"_26932":117528,"_2867":52564},[],{"_3381":69935,"_29612":69805,"_20544":117863,"_5":14097,"_26932":117528,"_2867":52567},[],{"_3381":69936,"_29612":69805,"_20544":117865,"_5":14097,"_26932":117528,"_2867":52570},[],{"_3381":69937,"_29612":69805,"_20544":117867,"_5":14097,"_26932":117528,"_2867":117868},[],"En modo `jitp`, intenta crear la plantilla de aprovisionamiento y la adjunta a la CA registrada. No idempotente: una edición `PUT /v1/dms/{id}` reintenta la creación y acaba en `lamassu-dlq` tras 3 reintentos. Idempotente para `none` y `auto` (solo configuración).",{"_3381":69938,"_29612":69805,"_20544":117870,"_5":14097,"_26932":117528,"_2867":117537},[],{"_3381":69939,"_29612":69805,"_20544":117872,"_5":14097,"_26932":117528,"_2867":52578},[],{"_3381":69940,"_29612":69805,"_20544":117874,"_5":14097,"_26932":117528,"_2867":117875},[],"Dispositivo",{"_3381":69941,"_29612":69805,"_20544":117877,"_5":14097,"_26932":117528,"_2867":52584},[],{"_3381":69942,"_29612":69805,"_20544":117879,"_5":14097,"_26932":117528,"_2867":52587},[],{"_3381":69943,"_29612":69805,"_20544":117881,"_5":14097,"_26932":117528,"_2867":117882},[],"En modo `auto`: crea/actualiza políticas, asegura los grupos de Things, revoca principals obsoletos y aprovisiona el Thing vía `iot:RegisterThing`. En modo `jitp`: no hay llamadas AWS; AWS ejecuta la plantilla JITP en la primera conexión.",{"_3381":69944,"_29612":69805,"_20544":117884,"_5":14097,"_26932":117528,"_2867":117545},[],{"_3381":69945,"_29612":69805,"_20544":117886,"_5":14097,"_26932":117528,"_2867":52595},[],{"_3381":69946,"_29612":69805,"_20544":117888,"_5":14097,"_26932":117528,"_2867":117889},[],"Certificado",{"_3381":69947,"_29612":69805,"_20544":117891,"_5":14097,"_26932":117528,"_2867":52601},[],{"_3381":69948,"_29612":69805,"_20544":117893,"_5":14097,"_26932":117528,"_2867":117894},[],"`iot:UpdateCertificate`, `iot:Connect` (plano de datos)",{"_3381":69949,"_29612":69805,"_20544":117896,"_5":14097,"_26932":117528,"_2867":117897},[],"Mapea el estado a AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), llama a `iot:UpdateCertificate` y fuerza una desconexión MQTT al revocar.",{"_3381":69950,"_29612":69805,"_20544":117899,"_5":14097,"_26932":117528,"_2867":117541},[],{"_3381":69951,"_29612":69805,"_20544":117901,"_5":14097,"_26932":117528,"_2867":52612},[],{"_3381":69952,"_29612":69805,"_20544":117903,"_5":14097,"_26932":117528,"_2867":117904},[],"Certificado / Dispositivo",{"_3381":69953,"_29612":69805,"_20544":117906,"_5":14097,"_26932":117528,"_2867":52618},[],{"_3381":69954,"_29612":69805,"_20544":117908,"_5":14097,"_26932":117528,"_2867":48627},[],{"_3381":69955,"_29612":69805,"_20544":117910,"_5":14097,"_26932":117528,"_2867":117911},[],"Refresca el estado interno; el conector ignora los eventos cuyo campo CloudEvent `source` coincide con su propia URI para evitar bucles autodisparados.",{"_3381":69956,"_29612":69805,"_20544":117913,"_5":14097,"_26932":117528,"_2867":117595},[],{"_3381":69957,"_29612":69805,"_20544":117915,"_5":14097,"_26932":117532,"_2867":117916},[],"El flujo de registro de la CA se gobierna por el campo `registration.status` de los metadatos del conector en la CA:",{"_3381":69958,"_29612":69805,"_20544":117918,"_5":14097,"_26932":117532,"_2867":117919},[],"por el campo `registration.status` de los metadatos del conector en la CA:",{"_3381":69959,"_29612":69805,"_20544":117921,"_5":14097,"_26932":117532,"_2867":117922},[],"Transición",{"_3381":69960,"_29612":69805,"_20544":117924,"_5":14097,"_26932":117532,"_2867":117925},[],"Llamadas AWS",{"_3381":69961,"_29612":69805,"_20544":117927,"_5":14097,"_26932":117532,"_2867":117928},[],"`NoRegistrada` → `Solicitada`",{"_3381":69962,"_29612":69805,"_20544":117930,"_5":14097,"_26932":117532,"_2867":117931},[],"ninguna (solo escritura de metadatos)",{"_3381":69963,"_29612":69805,"_20544":117933,"_5":14097,"_26932":117532,"_2867":117934},[],"`Solicitada` → `Registrando`",{"_3381":69964,"_29612":69805,"_20544":117936,"_5":14097,"_26932":117532,"_2867":117937},[],"`iot:GetRegistrationCode` (solo Primary Account)",{"_3381":69965,"_29612":69805,"_20544":117939,"_5":14097,"_26932":117532,"_2867":117940},[],"`Registrando` → `Completada`",{"_3381":69966,"_29612":69805,"_20544":117942,"_5":14097,"_26932":117532,"_2867":117943},[],"`iot:RegisterCACertificate` (Primary: prueba de posesión con clave efímera; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3381":69967,"_29612":69805,"_20544":117945,"_5":14097,"_26932":117532,"_2867":117946},[],"`Registrando` → `Fallida`",{"_3381":69968,"_29612":69805,"_20544":117948,"_5":14097,"_26932":117532,"_2867":117949},[],"`iot:RegisterCACertificate` fallida; el detalle del error se escribe en los metadatos de la CA",{"_3381":69969,"_29612":69805,"_20544":117951,"_5":14097,"_26932":117532,"_2867":117952},[],"`Fallida` / `Completada` → `Solicitada`",{"_3381":69970,"_29612":69805,"_20544":117954,"_5":14097,"_26932":117532,"_2867":117955},[],"ninguna (una nueva escritura `REQUESTED` reejecuta el flujo)",{"_3381":69971,"_29612":69805,"_20544":117957,"_5":14097,"_26932":117536,"_2867":117958},[],"El `registration_mode` del DMS determina qué hace el conector en el lado AWS cuando el DMS se crea o se edita por completo:",{"_3381":69972,"_29612":69805,"_20544":117960,"_5":14097,"_26932":117536,"_2867":117922},[],{"_3381":69973,"_29612":69805,"_20544":117962,"_5":14097,"_26932":117536,"_2867":117925},[],{"_3381":69974,"_29612":69805,"_20544":117964,"_5":14097,"_26932":117536,"_2867":117965},[],"`SinConfigurar` → `None` / `Auto`",{"_3381":69975,"_29612":69805,"_20544":117967,"_5":14097,"_26932":117536,"_2867":117968},[],"ninguna (solo configuración)",{"_3381":69976,"_29612":69805,"_20544":117970,"_5":14097,"_26932":117536,"_2867":52683},[],{"_3381":69977,"_29612":69805,"_20544":117972,"_5":14097,"_26932":117536,"_2867":117968},[],{"_3381":69978,"_29612":69805,"_20544":117974,"_5":14097,"_26932":117536,"_2867":117975},[],"Cualquiera → `Jitp`",{"_3381":69979,"_29612":69805,"_20544":117977,"_5":14097,"_26932":117536,"_2867":117978},[],"`iot:CreateProvisioningTemplate` (no idempotente: falla si la plantilla ya existe; tras 3 reintentos el evento acaba en `lamassu-dlq`)",{"_3381":69980,"_29612":69805,"_20544":117980,"_5":14097,"_26932":117536,"_2867":52694},[],{"_3381":69981,"_29612":69805,"_20544":117982,"_5":14097,"_26932":117536,"_2867":117983},[],"ninguna (la plantilla permanece en la cuenta AWS)",{"_3381":69982,"_29612":69805,"_20544":117985,"_5":14097,"_26932":117540,"_2867":117986},[],"Los certificados con la clave de metadatos del conector sincronizan su estado; los aprovisionados vía JITP no tienen clave de metadatos y quedan fuera de esta máquina:",{"_3381":69983,"_29612":69805,"_20544":117988,"_5":14097,"_26932":117540,"_2867":117922},[],{"_3381":69984,"_29612":69805,"_20544":117990,"_5":14097,"_26932":117540,"_2867":117925},[],{"_3381":69985,"_29612":69805,"_20544":117992,"_5":14097,"_26932":117540,"_2867":117993},[],"`NoSincronizado` → `Active`",{"_3381":69986,"_29612":69805,"_20544":117995,"_5":14097,"_26932":117540,"_2867":52351},[],{"_3381":69987,"_29612":69805,"_20544":117997,"_5":14097,"_26932":117540,"_2867":52712},[],{"_3381":69988,"_29612":69805,"_20544":117999,"_5":14097,"_26932":117540,"_2867":118000},[],"`iot:UpdateCertificate` + desconexión MQTT forzada",{"_3381":69989,"_29612":69805,"_20544":118002,"_5":14097,"_26932":117540,"_2867":52718},[],{"_3381":69990,"_29612":69805,"_20544":118004,"_5":14097,"_26932":117540,"_2867":118000},[],{"_3381":69991,"_29612":69805,"_20544":118006,"_5":14097,"_26932":117540,"_2867":52723},[],{"_3381":69992,"_29612":69805,"_20544":118008,"_5":14097,"_26932":117540,"_2867":52351},[],{"_3381":69993,"_29612":69805,"_20544":118010,"_5":14097,"_26932":117540,"_2867":52728},[],{"_3381":69994,"_29612":69805,"_20544":118012,"_5":14097,"_26932":117540,"_2867":118013},[],"ninguna (estos estados no se sincronizan con AWS)",{"_3381":69995,"_29612":69805,"_20544":118015,"_5":14097,"_26932":117544,"_2867":118016},[],"Los Things solo existen en modo `auto`; en modo `jitp` AWS crea el Thing por sí mismo cuando el dispositivo se conecta por primera vez. El nombre del Thing es siempre el CN del certificado del dispositivo:",{"_3381":69996,"_29612":69805,"_20544":118018,"_5":14097,"_26932":117544,"_2867":117922},[],{"_3381":69997,"_29612":69805,"_20544":118020,"_5":14097,"_26932":117544,"_2867":117925},[],{"_3381":69998,"_29612":69805,"_20544":118022,"_5":14097,"_26932":117544,"_2867":118023},[],"`Ausente` → `Aprovisionado`",{"_3381":69999,"_29612":69805,"_20544":118025,"_5":14097,"_26932":117544,"_2867":118026},[],"políticas creadas/actualizadas, grupos de Things asegurados, `iot:RegisterThing` (crea el Thing, registra el certificado, adjunta políticas)",{"_3381":70000,"_29612":69805,"_20544":118028,"_5":14097,"_26932":117544,"_2867":118029},[],"`Aprovisionado` → `Aprovisionado` (re-enrolamiento)",{"_3381":70001,"_29612":69805,"_20544":118031,"_5":14097,"_26932":117544,"_2867":118032},[],"principals obsoletos marcados como `REVOKED`, nueva ejecución de `iot:RegisterThing`; el nuevo ARN del certificado sustituye al anterior en los metadatos de Lamassu",{"_3381":70002,"_29612":69805,"_20544":118034,"_5":14097,"_26932":117544,"_2867":118035},[],"En modo `jitp` el conector no hace llamadas de aprovisionamiento: AWS ejecuta la plantilla JITP en la primera conexión del dispositivo y crea el Thing, registra el certificado y lo activa por su cuenta.",{"_3381":70003,"_29612":69805,"_20544":118037,"_5":14097,"_26932":117548,"_2867":118038},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3381":70004,"_29612":69805,"_20544":118040,"_5":14097,"_26932":117552,"_2867":118041},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3381":70005,"_29612":69805,"_20544":118043,"_5":14097,"_26932":117552,"_2867":118044},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3381":70006,"_29612":69805,"_20544":118046,"_5":14097,"_26932":117556,"_2867":118047},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3381":70007,"_29612":69805,"_20544":118049,"_5":14097,"_26932":117556,"_2867":118050},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3381":70008,"_29612":69805,"_20544":118052,"_5":14097,"_26932":117556,"_2867":118053},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3381":70009,"_29612":69805,"_20544":118055,"_5":14097,"_26932":117556,"_2867":118056},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3381":70010,"_29612":69805,"_20544":118058,"_5":14097,"_26932":117556,"_2867":118059},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3381":70011,"_29612":69805,"_20544":118061,"_5":14097,"_26932":117556,"_2867":118062},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3381":70012,"_29612":69805,"_20544":118064,"_5":14097,"_26932":117559,"_2867":118065},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3381":70013,"_29612":69805,"_20544":118067,"_5":14097,"_26932":117562,"_2867":118068},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3381":70014,"_29612":69805,"_20544":118070,"_5":14097,"_26932":117562,"_2867":118071},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3381":70015,"_29612":69805,"_20544":118073,"_5":14097,"_26932":117566,"_2867":118074},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3381":70016,"_29612":69805,"_20544":118076,"_5":14097,"_26932":117570,"_2867":118077},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3381":70017,"_29612":69805,"_20544":118079,"_5":14097,"_26932":117570,"_2867":118080},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3381":70018,"_29612":69805,"_20544":118082,"_5":14097,"_26932":117570,"_2867":118083},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3381":70019,"_29612":69805,"_20544":118085,"_5":14097,"_26932":117570,"_2867":118086},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3381":70020,"_29612":69805,"_20544":118088,"_5":14097,"_26932":117570,"_2867":118089},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3381":70021,"_29612":69805,"_20544":118091,"_5":14097,"_26932":117570,"_2867":118092},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3381":70022,"_29612":69805,"_20544":118094,"_5":14097,"_26932":117574,"_2867":118095},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. El conector intenta crear esta plantilla cuando el DMS se crea y de nuevo en cada edición completa del DMS (`PUT /v1/dms/{id}`) - no en el momento del enrolamiento del dispositivo. El intento no es idempotente: cuando ya existe una plantilla nombrada con el ID del DMS, la llamada de creación falla, el evento se reintenta tres veces y acaba en la cola de mensajes fallidos `lamassu-dlq` (ver Solución de problemas). La plantilla se crea una sola vez; las ediciones posteriores nunca actualizan su contenido. Una actualización del DMS que omite `metadata` o envía `null` conserva los metadatos almacenados, así que la clave del conector `lamassu.io/iot/{connector_id}` sigue presente y el intento se sigue disparando. Un cuerpo que suministra un objeto `metadata` sustituye por completo los metadatos almacenados: si ese objeto no lleva la clave del conector, la clave se elimina y el conector omite silenciosamente los eventos futuros del DMS. Una vez adjuntada la plantilla, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3381":70023,"_29612":69805,"_20544":118097,"_5":14097,"_26932":117574,"_2867":118098},[],"El conector crea la plantilla, nombrada con el ID del DMS, una sola vez. Cada edición posterior del DMS que conserve la clave del conector intenta crearla de nuevo y falla, porque el conector no actualiza plantillas existentes. Los cambios posteriores en `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` o en los grupos y políticas que la plantilla referencia deben aplicarse a mano en AWS IoT Core.",{"_3381":70024,"_29612":69805,"_20544":118100,"_5":14097,"_26932":117574,"_2867":118101},[],"El evento fallido se reintenta y termina en `lamassu-dlq`. Los grupos y las políticas se registran antes del fallo, pero se omiten la asignación de la plantilla a la CA registrada, la escritura del ARN en el DMS y la actualización de las shadows al cambiar `ManagedCAs`.",{"_3381":70025,"_29612":69805,"_20544":118103,"_5":14097,"_26932":117574,"_2867":118104},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3381":70026,"_29612":69805,"_20544":118106,"_5":14097,"_26932":117574,"_2867":118107},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3381":70027,"_29612":69805,"_20544":118109,"_5":14097,"_26932":117578,"_2867":118110},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3381":70028,"_29612":69805,"_20544":118112,"_5":14097,"_26932":117578,"_2867":118113},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3381":70029,"_29612":69805,"_20544":118115,"_5":14097,"_26932":117578,"_2867":118116},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3381":70030,"_29612":69805,"_20544":118118,"_5":14097,"_26932":117582,"_2867":118119},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3381":70031,"_29612":69805,"_20544":118121,"_5":14097,"_26932":117582,"_2867":118122},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3381":70032,"_29612":69805,"_20544":118124,"_5":14097,"_26932":117582,"_2867":118125},[],"Para que el flujo JITP funcione correctamente:",{"_3381":70033,"_29612":69805,"_20544":118127,"_5":14097,"_26932":117582,"_2867":118128},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3381":70034,"_29612":69805,"_20544":118130,"_5":14097,"_26932":117582,"_2867":118131},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3381":70035,"_29612":69805,"_20544":118133,"_5":14097,"_26932":117582,"_2867":118134},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3381":70036,"_29612":69805,"_20544":118136,"_5":14097,"_26932":117582,"_2867":118137},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3381":70037,"_29612":69805,"_20544":118139,"_5":14097,"_26932":117586,"_2867":118140},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3381":70038,"_29612":69805,"_20544":118142,"_5":14097,"_26932":117586,"_2867":118143},[],"Estado en Lamassu",{"_3381":70039,"_29612":69805,"_20544":118145,"_5":14097,"_26932":117586,"_2867":118146},[],"Razón de revocación",{"_3381":70040,"_29612":69805,"_20544":118148,"_5":14097,"_26932":117586,"_2867":118149},[],"Estado en AWS IoT Core",{"_3381":70041,"_29612":69805,"_20544":118151,"_5":14097,"_26932":117586,"_2867":52873},[],{"_3381":70042,"_29612":69805,"_20544":118153,"_5":14097,"_26932":117586,"_2867":118154},[],"Ninguna",{"_3381":70043,"_29612":69805,"_20544":118156,"_5":14097,"_26932":117586,"_2867":52879},[],{"_3381":70044,"_29612":69805,"_20544":118158,"_5":14097,"_26932":117586,"_2867":52882},[],{"_3381":70045,"_29612":69805,"_20544":118160,"_5":14097,"_26932":117586,"_2867":52885},[],{"_3381":70046,"_29612":69805,"_20544":118162,"_5":14097,"_26932":117586,"_2867":52888},[],{"_3381":70047,"_29612":69805,"_20544":118164,"_5":14097,"_26932":117586,"_2867":52882},[],{"_3381":70048,"_29612":69805,"_20544":118166,"_5":14097,"_26932":117586,"_2867":118167},[],"Cualquier otra razón",{"_3381":70049,"_29612":69805,"_20544":118169,"_5":14097,"_26932":117586,"_2867":52896},[],{"_3381":70050,"_29612":69805,"_20544":118171,"_5":14097,"_26932":117586,"_2867":118172},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3381":70051,"_29612":69805,"_20544":118174,"_5":14097,"_26932":117590,"_2867":118175},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3381":70052,"_29612":69805,"_20544":118177,"_5":14097,"_26932":117590,"_2867":118178},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3381":70053,"_29612":69805,"_20544":118180,"_5":14097,"_26932":117590,"_2867":118181},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3381":70054,"_29612":69805,"_20544":118183,"_5":14097,"_26932":117594,"_2867":118184},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3381":70055,"_29612":69805,"_20544":118186,"_5":14097,"_26932":117594,"_2867":118187},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3381":70056,"_29612":69805,"_20544":118189,"_5":14097,"_26932":117598,"_2867":118190},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3381":70057,"_29612":69805,"_20544":118192,"_5":14097,"_26932":117598,"_2867":118193},[],"Existen dos tipos de acciones:",{"_3381":70058,"_29612":69805,"_20544":118195,"_5":14097,"_26932":117598,"_2867":118196},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3381":70059,"_29612":69805,"_20544":118198,"_5":14097,"_26932":117598,"_2867":118199},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3381":70060,"_29612":69805,"_20544":118201,"_5":14097,"_26932":117598,"_2867":118202},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3381":70061,"_29612":69805,"_20544":118204,"_5":14097,"_26932":117602,"_2867":118205},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3381":70062,"_29612":69805,"_20544":118207,"_5":14097,"_26932":117602,"_2867":118208},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3381":70063,"_29612":69805,"_20544":118210,"_5":14097,"_26932":117602,"_2867":118211},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3381":70064,"_29612":69805,"_20544":118213,"_5":14097,"_26932":117606,"_2867":118214},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3381":70065,"_29612":69805,"_20544":118216,"_5":14097,"_26932":117606,"_2867":118217},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3381":70066,"_29612":69805,"_20544":118219,"_5":14097,"_26932":117606,"_2867":118220},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3381":70067,"_29612":69805,"_20544":118222,"_5":14097,"_26932":117606,"_2867":118223},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3381":70068,"_29612":69805,"_20544":118225,"_5":14097,"_26932":117606,"_2867":118226},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3381":70069,"_29612":69805,"_20544":118228,"_5":14097,"_26932":117606,"_2867":118229},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3381":70070,"_29612":69805,"_20544":118231,"_5":14097,"_26932":117606,"_2867":118232},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3381":70071,"_29612":69805,"_20544":118234,"_5":14097,"_26932":117606,"_2867":118235},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3381":70072,"_29612":69805,"_20544":118237,"_5":14097,"_26932":117606,"_2867":118238},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3381":70073,"_29612":69805,"_20544":118240,"_5":14097,"_26932":117606,"_2867":118241},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3381":70074,"_29612":69805,"_20544":118243,"_5":14097,"_26932":117606,"_2867":118244},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3381":70075,"_29612":69805,"_20544":118246,"_5":14097,"_26932":117606,"_2867":118247},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3381":70076,"_29612":69805,"_20544":118249,"_5":14097,"_26932":117606,"_2867":118250},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3381":70077,"_29612":69805,"_20544":118252,"_5":14097,"_26932":117606,"_2867":118253},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3381":70078,"_29612":69805,"_20544":118255,"_5":14097,"_26932":117606,"_2867":118256},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3381":70079,"_29612":69805,"_20544":118258,"_5":14097,"_26932":117606,"_2867":118259},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3381":70080,"_29612":69805,"_20544":118261,"_5":14097,"_26932":117606,"_2867":118262},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3381":70081,"_29612":69805,"_20544":118264,"_5":14097,"_26932":117606,"_2867":118265},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3381":70082,"_29612":69805,"_20544":118267,"_5":14097,"_26932":117606,"_2867":118268},[],"**Síntoma:** Tras editar un DMS en modo `jitp`, aparecen mensajes de actualización del DMS en `lamassu-dlq`, o los cambios de configuración JITP no tienen efecto en AWS.",{"_3381":70083,"_29612":69805,"_20544":118270,"_5":14097,"_26932":117606,"_2867":118271},[],"**Causa:** Cada edición completa del DMS (`PUT /v1/dms/{id}`) dispara un nuevo intento de `CreateProvisioningTemplate` para la plantilla nombrada con el ID del DMS, y la llamada no es idempotente: cuando la plantilla ya existe, falla, el evento se reintenta tres veces y acaba en `lamassu-dlq`. Se omiten los pasos posteriores del conector.",{"_3381":70084,"_29612":69805,"_20544":118273,"_5":14097,"_26932":117606,"_2867":118274},[],"**Resolución:** Comprobar que la plantilla nombrada con el ID del DMS existe en AWS IoT Core y que el enrolamiento JITP funciona. Si se cambió la configuración JITP, aplicarla a mano en la plantilla de AWS.",{"_3381":70085,"_29612":69805,"_20544":118276,"_5":14097,"_26932":117606,"_2867":118277},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3381":70086,"_29612":69805,"_20544":118279,"_5":14097,"_26932":117606,"_2867":118280},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3381":70087,"_29612":69805,"_20544":118282,"_5":14097,"_26932":117606,"_2867":118283},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3381":70088,"_29612":70088,"_5":14455,"_2867":50710,"_29965":118285,"_20544":118286,"_26932":70088},[48231,115085,50710],[],{"_3381":70089,"_29612":70088,"_20544":118288,"_5":14097,"_26932":70088,"_2867":118289},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3381":70090,"_29612":70088,"_5":29962,"_20544":118291,"_26932":118292,"_2867":118293},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3381":70091,"_29612":70088,"_5":29962,"_20544":118295,"_26932":118296,"_2867":116094},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3381":70092,"_29612":70088,"_5":29962,"_20544":118298,"_26932":118299,"_2867":116269},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3381":70093,"_29612":70088,"_5":29962,"_20544":118301,"_26932":118302,"_2867":117501},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/overview#integraciones",{"_3381":70094,"_29612":70088,"_5":29962,"_20544":118304,"_26932":118305,"_2867":118306},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3381":70095,"_29612":70088,"_20544":118308,"_5":14097,"_26932":70088,"_2867":118309},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3381":70096,"_29612":70088,"_20544":118311,"_5":14097,"_26932":118292,"_2867":118312},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3381":70097,"_29612":70088,"_20544":118314,"_5":14097,"_26932":118292,"_2867":118315},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3381":70098,"_29612":70088,"_20544":118317,"_5":14097,"_26932":118296,"_2867":118318},[],"Recurso",{"_3381":70099,"_29612":70088,"_20544":118320,"_5":14097,"_26932":118296,"_2867":118321},[],"Qué representa",{"_3381":70100,"_29612":70088,"_20544":118323,"_5":14097,"_26932":118296,"_2867":118324},[],"**Dispositivo**",{"_3381":70101,"_29612":70088,"_20544":118326,"_5":14097,"_26932":118296,"_2867":118327},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3381":70102,"_29612":70088,"_20544":118329,"_5":14097,"_26932":118296,"_2867":118330},[],"**Identidad**",{"_3381":70103,"_29612":70088,"_20544":118332,"_5":14097,"_26932":118296,"_2867":118333},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3381":70104,"_29612":70088,"_20544":118335,"_5":14097,"_26932":118296,"_2867":53063},[],{"_3381":70105,"_29612":70088,"_20544":118337,"_5":14097,"_26932":118296,"_2867":118338},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3381":70106,"_29612":70088,"_20544":118340,"_5":14097,"_26932":118296,"_2867":118341},[],"**Flota**",{"_3381":70107,"_29612":70088,"_20544":118343,"_5":14097,"_26932":118296,"_2867":118344},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3381":70108,"_29612":70088,"_20544":118346,"_5":14097,"_26932":118296,"_2867":118347},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3381":70109,"_29612":70088,"_20544":118349,"_5":14097,"_26932":118296,"_2867":118350},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3381":70110,"_29612":70088,"_20544":118352,"_5":14097,"_26932":118299,"_2867":118353},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3381":70111,"_29612":70088,"_20544":118355,"_5":14097,"_26932":118299,"_2867":118356},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3381":70112,"_29612":70088,"_20544":118358,"_5":14097,"_26932":118299,"_2867":118359},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3381":70113,"_29612":70088,"_20544":118361,"_5":14097,"_26932":118299,"_2867":118362},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3381":70114,"_29612":70088,"_20544":118364,"_5":14097,"_26932":118299,"_2867":118365},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3381":70115,"_29612":70088,"_20544":118367,"_5":14097,"_26932":118299,"_2867":118368},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3381":70116,"_29612":70088,"_20544":118370,"_5":14097,"_26932":118299,"_2867":118371},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3381":70117,"_29612":70088,"_20544":118373,"_5":14097,"_26932":118299,"_2867":118374},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3381":70118,"_29612":70088,"_20544":118376,"_5":14097,"_26932":118302,"_2867":118377},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3381":70119,"_29612":70088,"_20544":118379,"_5":14097,"_26932":118302,"_2867":118380},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3381":70120,"_29612":70088,"_20544":118382,"_5":14097,"_26932":118305,"_2867":118383},[],"Participante",{"_3381":70121,"_29612":70088,"_20544":118385,"_5":14097,"_26932":118305,"_2867":118386},[],"Responsabilidad",{"_3381":70122,"_29612":70088,"_20544":118388,"_5":14097,"_26932":118305,"_2867":118389},[],"Administrador PKI",{"_3381":70123,"_29612":70088,"_20544":118391,"_5":14097,"_26932":118305,"_2867":118392},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3381":70124,"_29612":70088,"_20544":118394,"_5":14097,"_26932":118305,"_2867":118395},[],"Administrador del aprovisionamiento",{"_3381":70125,"_29612":70088,"_20544":118397,"_5":14097,"_26932":118305,"_2867":118398},[],"DMS, admisión, autenticación por operación e inventario.",{"_3381":70126,"_29612":70088,"_20544":118400,"_5":14097,"_26932":118305,"_2867":118401},[],"Integrador del dispositivo",{"_3381":70127,"_29612":70088,"_20544":118403,"_5":14097,"_26932":118305,"_2867":118404},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3381":70128,"_29612":70088,"_20544":118406,"_5":14097,"_26932":118305,"_2867":118407},[],"Integrador del consumidor",{"_3381":70129,"_29612":70088,"_20544":118409,"_5":14097,"_26932":118305,"_2867":118410},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3381":70130,"_29612":70088,"_20544":118412,"_5":14097,"_26932":118305,"_2867":118413},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3381":70131,"_29612":70131,"_5":14455,"_2867":118415,"_29965":118416,"_20544":118418,"_26932":70131},"Enrola y conecta tu primer dispositivo",[48231,115085,50710,118417],"Primeros pasos",[],{"_3381":70132,"_29612":70131,"_20544":118420,"_5":14097,"_26932":70131,"_2867":118421},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3381":70133,"_29612":70131,"_5":29962,"_20544":118423,"_26932":118424,"_2867":113663},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3381":70134,"_29612":70131,"_5":29962,"_20544":118426,"_26932":118427,"_2867":118428},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3381":70135,"_29612":70131,"_5":29962,"_20544":118430,"_26932":118431,"_2867":118432},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3381":70136,"_29612":70131,"_5":29962,"_20544":118434,"_26932":118435,"_2867":118436},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3381":70137,"_29612":70131,"_5":29962,"_20544":118438,"_26932":118439,"_2867":118440},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3381":70138,"_29612":70131,"_5":29962,"_20544":118442,"_26932":118443,"_2867":118444},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3381":70139,"_29612":70131,"_5":29962,"_20544":118446,"_26932":118447,"_2867":118448},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3381":70140,"_29612":70131,"_5":29962,"_20544":118450,"_26932":118451,"_2867":118452},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3381":70141,"_29612":70131,"_20544":118454,"_5":14097,"_26932":70131,"_2867":118455},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3381":70142,"_29612":70131,"_20544":118457,"_5":14097,"_26932":118424,"_2867":118458},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3381":70143,"_29612":70131,"_20544":118460,"_5":14097,"_26932":118424,"_2867":118461},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3381":70144,"_29612":70131,"_20544":118463,"_5":14097,"_26932":118424,"_2867":118464},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3381":70145,"_29612":70131,"_20544":118466,"_5":14097,"_26932":118424,"_2867":118467},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3381":70146,"_29612":70131,"_20544":118469,"_5":14097,"_26932":118424,"_2867":118470},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3381":70147,"_29612":70131,"_20544":118472,"_5":14097,"_26932":118427,"_2867":118473},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3381":70148,"_29612":70131,"_20544":118475,"_5":14097,"_26932":118427,"_2867":118476},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3381":70149,"_29612":70131,"_20544":118478,"_5":14097,"_26932":118431,"_2867":118479},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3381":70150,"_29612":70131,"_20544":118481,"_5":14097,"_26932":118431,"_2867":118482},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3381":70151,"_29612":70131,"_20544":118484,"_5":14097,"_26932":118431,"_2867":118485},[],"Ajuste",{"_3381":70152,"_29612":70131,"_20544":118487,"_5":14097,"_26932":118431,"_2867":118488},[],"Valor de evaluación",{"_3381":70153,"_29612":70131,"_20544":118490,"_5":14097,"_26932":118431,"_2867":53219},[],{"_3381":70154,"_29612":70131,"_20544":118492,"_5":14097,"_26932":118431,"_2867":118493},[],"Raíz emisora de `device-root.pem`.",{"_3381":70155,"_29612":70131,"_20544":118495,"_5":14097,"_26932":118431,"_2867":116397},[],{"_3381":70156,"_29612":70131,"_20544":118497,"_5":14097,"_26932":118431,"_2867":118498},[],"Perfil final de 1 hora que acabas de preparar.",{"_3381":70157,"_29612":70131,"_20544":118500,"_5":14097,"_26932":118431,"_2867":53230},[],{"_3381":70158,"_29612":70131,"_20544":118502,"_5":14097,"_26932":118431,"_2867":53233},[],{"_3381":70159,"_29612":70131,"_20544":118504,"_5":14097,"_26932":118431,"_2867":53236},[],{"_3381":70160,"_29612":70131,"_20544":118506,"_5":14097,"_26932":118431,"_2867":118507},[],"Habilitado.",{"_3381":70161,"_29612":70131,"_20544":118509,"_5":14097,"_26932":118431,"_2867":53242},[],{"_3381":70162,"_29612":70131,"_20544":118511,"_5":14097,"_26932":118431,"_2867":118512},[],"Deshabilitado; el ID debe ser nuevo.",{"_3381":70163,"_29612":70131,"_20544":118514,"_5":14097,"_26932":118431,"_2867":118515},[],"Autenticación inicial",{"_3381":70164,"_29612":70131,"_20544":118517,"_5":14097,"_26932":118431,"_2867":118518},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3381":70165,"_29612":70131,"_20544":118520,"_5":14097,"_26932":118431,"_2867":118521},[],"Autenticación de renovación",{"_3381":70166,"_29612":70131,"_20544":118523,"_5":14097,"_26932":118431,"_2867":118524},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3381":70167,"_29612":70131,"_20544":118526,"_5":14097,"_26932":118431,"_2867":53260},[],{"_3381":70168,"_29612":70131,"_20544":118528,"_5":14097,"_26932":118431,"_2867":118529},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_3381":70169,"_29612":70131,"_20544":118531,"_5":14097,"_26932":118431,"_2867":53266},[],{"_3381":70170,"_29612":70131,"_20544":118533,"_5":14097,"_26932":118431,"_2867":118534},[],"1 hora.",{"_3381":70171,"_29612":70131,"_20544":118536,"_5":14097,"_26932":118431,"_2867":53272},[],{"_3381":70172,"_29612":70131,"_20544":118538,"_5":14097,"_26932":118431,"_2867":118539},[],"30 minutos / 10 minutos.",{"_3381":70173,"_29612":70131,"_20544":118541,"_5":14097,"_26932":118431,"_2867":53278},[],{"_3381":70174,"_29612":70131,"_20544":118543,"_5":14097,"_26932":118431,"_2867":118544},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3381":70175,"_29612":70131,"_20544":118546,"_5":14097,"_26932":118431,"_2867":51029},[],{"_3381":70176,"_29612":70131,"_20544":118548,"_5":14097,"_26932":118431,"_2867":118549},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3381":70177,"_29612":70131,"_20544":118551,"_5":14097,"_26932":118431,"_2867":53289},[],{"_3381":70178,"_29612":70131,"_20544":118553,"_5":14097,"_26932":118431,"_2867":118554},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3381":70179,"_29612":70131,"_20544":118556,"_5":14097,"_26932":118431,"_2867":118557},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento; la guía DMS describe sus campos, y también puedes comprobar el recurso mediante la API DMS.",{"_3381":70180,"_29612":70131,"_20544":118559,"_5":14097,"_26932":118435,"_2867":118560},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3381":70181,"_29612":70131,"_20544":118562,"_5":14097,"_26932":118435,"_2867":118563},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3381":70182,"_29612":70131,"_20544":118565,"_5":14097,"_26932":118439,"_2867":118566},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3381":70183,"_29612":70131,"_20544":118568,"_5":14097,"_26932":118439,"_2867":118569},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3381":70184,"_29612":70131,"_20544":118571,"_5":14097,"_26932":118439,"_2867":118572},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3381":70185,"_29612":70131,"_20544":118574,"_5":14097,"_26932":118443,"_2867":118575},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3381":70186,"_29612":70131,"_20544":118577,"_5":14097,"_26932":118443,"_2867":118578},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3381":70187,"_29612":70131,"_20544":118580,"_5":14097,"_26932":118447,"_2867":118581},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3381":70188,"_29612":70131,"_20544":118583,"_5":14097,"_26932":118447,"_2867":118584},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3381":70189,"_29612":70131,"_20544":118586,"_5":14097,"_26932":118447,"_2867":118587},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3381":70190,"_29612":70131,"_20544":118589,"_5":14097,"_26932":118447,"_2867":118590},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3381":70191,"_29612":70131,"_20544":118592,"_5":14097,"_26932":118447,"_2867":118593},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3381":70192,"_29612":70131,"_20544":118595,"_5":14097,"_26932":118451,"_2867":118596},[],"Comprobación",{"_3381":70193,"_29612":70131,"_20544":118598,"_5":14097,"_26932":118451,"_2867":118599},[],"Resultado esperado",{"_3381":70194,"_29612":70131,"_20544":118601,"_5":14097,"_26932":118451,"_2867":118602},[],"Registro",{"_3381":70195,"_29612":70131,"_20544":118604,"_5":14097,"_26932":118451,"_2867":118605},[],"ID creado automáticamente y DMS correcto.",{"_3381":70196,"_29612":70131,"_20544":118607,"_5":14097,"_26932":118451,"_2867":117889},[],{"_3381":70197,"_29612":70131,"_20544":118609,"_5":14097,"_26932":118451,"_2867":118610},[],"CN, perfil, serie y clave verificados.",{"_3381":70198,"_29612":70131,"_20544":118612,"_5":14097,"_26932":118451,"_2867":118613},[],"Inventario",{"_3381":70199,"_29612":70131,"_20544":118615,"_5":14097,"_26932":118451,"_2867":118616},[],"Serie recibida visible como identidad actual y en el historial.",{"_3381":70200,"_29612":70131,"_20544":118618,"_5":14097,"_26932":118451,"_2867":118619},[],"Consumidor",{"_3381":70201,"_29612":70131,"_20544":118621,"_5":14097,"_26932":118451,"_2867":118622},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3381":70202,"_29612":70131,"_20544":118624,"_5":14097,"_26932":118451,"_2867":118625},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3381":70203,"_29612":70131,"_20544":118627,"_5":14097,"_26932":118451,"_2867":118628},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3381":70204,"_29612":70204,"_5":14455,"_2867":116111,"_29965":118630,"_20544":118631,"_26932":70204},[48231,115085,50710,118417],[],{"_3381":70205,"_29612":70204,"_20544":118633,"_5":14097,"_26932":70204,"_2867":118634},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3381":70206,"_29612":70204,"_5":29962,"_20544":118636,"_26932":118637,"_2867":113663},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3381":70207,"_29612":70204,"_5":29962,"_20544":118639,"_26932":118640,"_2867":118641},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3381":70208,"_29612":70204,"_5":29962,"_20544":118643,"_26932":118644,"_2867":118645},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3381":70209,"_29612":70204,"_5":29962,"_20544":118647,"_26932":118648,"_2867":118649},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3381":70210,"_29612":70204,"_5":29962,"_20544":118651,"_26932":118652,"_2867":118653},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3381":70211,"_29612":70204,"_5":29962,"_20544":118655,"_26932":118656,"_2867":118657},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3381":70212,"_29612":70204,"_5":29962,"_20544":118659,"_26932":118660,"_2867":118599},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3381":70213,"_29612":70204,"_5":29962,"_20544":118662,"_26932":118663,"_2867":118664},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3381":70214,"_29612":70204,"_5":29962,"_20544":118666,"_26932":118667,"_2867":118668},[],"/docs/pr-preview/pr-53/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3381":70215,"_29612":70204,"_20544":118670,"_5":14097,"_26932":70204,"_2867":118671},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3381":70216,"_29612":70204,"_20544":118673,"_5":14097,"_26932":70204,"_2867":118674},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3381":70217,"_29612":70204,"_20544":118676,"_5":14097,"_26932":118637,"_2867":118677},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3381":70218,"_29612":70204,"_20544":118679,"_5":14097,"_26932":118637,"_2867":118680},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3381":70219,"_29612":70204,"_20544":118682,"_5":14097,"_26932":118637,"_2867":118683},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3381":70220,"_29612":70204,"_20544":118685,"_5":14097,"_26932":118637,"_2867":118686},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3381":70221,"_29612":70204,"_20544":118688,"_5":14097,"_26932":118640,"_2867":118689},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3381":70222,"_29612":70204,"_20544":118691,"_5":14097,"_26932":118640,"_2867":118692},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3381":70223,"_29612":70204,"_20544":118694,"_5":14097,"_26932":118640,"_2867":118695},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3381":70224,"_29612":70204,"_20544":118697,"_5":14097,"_26932":118640,"_2867":118698},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3381":70225,"_29612":70204,"_20544":118700,"_5":14097,"_26932":118640,"_2867":118701},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_3381":70226,"_29612":70204,"_20544":118703,"_5":14097,"_26932":118640,"_2867":118704},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3381":70227,"_29612":70204,"_20544":118706,"_5":14097,"_26932":118640,"_2867":118707},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3381":70228,"_29612":70204,"_20544":118709,"_5":14097,"_26932":118640,"_2867":118710},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3381":70229,"_29612":70204,"_20544":118712,"_5":14097,"_26932":118644,"_2867":118713},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3381":70230,"_29612":70204,"_20544":118715,"_5":14097,"_26932":118644,"_2867":53454},[],{"_3381":70231,"_29612":70204,"_20544":118717,"_5":14097,"_26932":118644,"_2867":118718},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3381":70232,"_29612":70204,"_20544":118720,"_5":14097,"_26932":118644,"_2867":118721},[],"**Icon** y **Tags**: clasificación opcional.",{"_3381":70233,"_29612":70204,"_20544":118723,"_5":14097,"_26932":118644,"_2867":118724},[],"Confirma el registro.",{"_3381":70234,"_29612":70204,"_20544":118726,"_5":14097,"_26932":118648,"_2867":118727},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3381":70235,"_29612":70204,"_20544":118729,"_5":14097,"_26932":118648,"_2867":118730},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3381":70236,"_29612":70204,"_20544":118732,"_5":14097,"_26932":118652,"_2867":118733},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3381":70237,"_29612":70204,"_20544":118735,"_5":14097,"_26932":118652,"_2867":118736},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3381":70238,"_29612":70204,"_20544":118738,"_5":14097,"_26932":118656,"_2867":118739},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3381":70239,"_29612":70204,"_20544":118741,"_5":14097,"_26932":118656,"_2867":118742},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3381":70240,"_29612":70204,"_20544":118744,"_5":14097,"_26932":118660,"_2867":118596},[],{"_3381":70241,"_29612":70204,"_20544":118746,"_5":14097,"_26932":118660,"_2867":118747},[],"Resultado",{"_3381":70242,"_29612":70204,"_20544":118749,"_5":14097,"_26932":118660,"_2867":117875},[],{"_3381":70243,"_29612":70204,"_20544":118751,"_5":14097,"_26932":118660,"_2867":118752},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3381":70244,"_29612":70204,"_20544":118754,"_5":14097,"_26932":118660,"_2867":118755},[],"Identidad actual",{"_3381":70245,"_29612":70204,"_20544":118757,"_5":14097,"_26932":118660,"_2867":118758},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3381":70246,"_29612":70204,"_20544":118760,"_5":14097,"_26932":118660,"_2867":118761},[],"Historial",{"_3381":70247,"_29612":70204,"_20544":118763,"_5":14097,"_26932":118660,"_2867":118764},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3381":70248,"_29612":70204,"_20544":118766,"_5":14097,"_26932":118660,"_2867":118767},[],"Clave y certificado",{"_3381":70249,"_29612":70204,"_20544":118769,"_5":14097,"_26932":118660,"_2867":118770},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3381":70250,"_29612":70204,"_20544":118772,"_5":14097,"_26932":118663,"_2867":118773},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3381":70251,"_29612":70204,"_20544":118775,"_5":14097,"_26932":118663,"_2867":118776},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3381":70252,"_29612":70204,"_20544":118778,"_5":14097,"_26932":118663,"_2867":118779},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3381":70253,"_29612":70204,"_20544":118781,"_5":14097,"_26932":118663,"_2867":118782},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3381":70254,"_29612":70204,"_20544":118784,"_5":14097,"_26932":118667,"_2867":118785},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3381":70255,"_29612":70204,"_20544":118787,"_5":14097,"_26932":118667,"_2867":118788},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3381":70256,"_29612":70204,"_20544":118790,"_5":14097,"_26932":118667,"_2867":118791},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3381":70257,"_29612":70257,"_5":14455,"_2867":118793,"_29965":118794,"_20544":118795,"_26932":70257},"Plataforma Lamassu IoT",[48231,115085],[],{"_3381":70258,"_29612":70257,"_20544":118797,"_5":14097,"_26932":70257,"_2867":118798},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3381":70259,"_29612":70257,"_5":29962,"_20544":118800,"_26932":118801,"_2867":118293},[],"/docs/pr-preview/pr-53/es/platform/overview#empieza-aquí",{"_3381":70260,"_29612":70257,"_5":29962,"_20544":118803,"_26932":118804,"_2867":118805},[],"/docs/pr-preview/pr-53/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3381":70261,"_29612":70257,"_5":29962,"_20544":118807,"_26932":118808,"_2867":118809},[],"/docs/pr-preview/pr-53/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3381":70262,"_29612":70257,"_5":29962,"_20544":118811,"_26932":118812,"_2867":118813},[],"/docs/pr-preview/pr-53/es/platform/overview#capacidades-principales","Capacidades principales",{"_3381":70263,"_29612":70257,"_5":29962,"_20544":118815,"_26932":118816,"_2867":118817},[],"/docs/pr-preview/pr-53/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3381":70264,"_29612":70257,"_5":29962,"_20544":118819,"_26932":118820,"_2867":118821},[],"/docs/pr-preview/pr-53/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3381":70265,"_29612":70257,"_5":29962,"_20544":118823,"_26932":118824,"_2867":118825},[],"/docs/pr-preview/pr-53/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3381":70266,"_29612":70257,"_5":29962,"_20544":118827,"_26932":118828,"_2867":118829},[],"/docs/pr-preview/pr-53/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3381":70267,"_29612":70257,"_5":29962,"_20544":118831,"_26932":118832,"_2867":118833},[],"/docs/pr-preview/pr-53/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3381":70268,"_29612":70257,"_5":29962,"_20544":118835,"_26932":118836,"_2867":118837},[],"/docs/pr-preview/pr-53/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3381":70269,"_29612":70257,"_5":29962,"_20544":118839,"_26932":118840,"_2867":118841},[],"/docs/pr-preview/pr-53/es/platform/overview#referencia-operativa","Referencia operativa",{"_3381":70270,"_29612":70257,"_20544":118843,"_5":14097,"_26932":70257,"_2867":118844},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3381":70271,"_29612":70257,"_20544":118846,"_5":14097,"_26932":118801,"_2867":118847},[],"Elige el resultado que necesitas obtener:",{"_3381":70272,"_29612":70257,"_20544":118849,"_5":14097,"_26932":118801,"_2867":118850},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3381":70273,"_29612":70257,"_20544":118852,"_5":14097,"_26932":118801,"_2867":118853},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3381":70274,"_29612":70257,"_20544":118855,"_5":14097,"_26932":118801,"_2867":118856},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3381":70275,"_29612":70257,"_20544":118858,"_5":14097,"_26932":118804,"_2867":118859},[],"Bloque",{"_3381":70276,"_29612":70257,"_20544":118861,"_5":14097,"_26932":118804,"_2867":118862},[],"Qué gestionas",{"_3381":70277,"_29612":70257,"_20544":118864,"_5":14097,"_26932":118804,"_2867":118865},[],"Punto de entrada",{"_3381":70278,"_29612":70257,"_20544":118867,"_5":14097,"_26932":118804,"_2867":53607},[],{"_3381":70279,"_29612":70257,"_20544":118869,"_5":14097,"_26932":118804,"_2867":118870},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3381":70280,"_29612":70257,"_20544":118872,"_5":14097,"_26932":118804,"_2867":118873},[],"Visión general de PKI",{"_3381":70281,"_29612":70257,"_20544":118875,"_5":14097,"_26932":118804,"_2867":53616},[],{"_3381":70282,"_29612":70257,"_20544":118877,"_5":14097,"_26932":118804,"_2867":118878},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3381":70283,"_29612":70257,"_20544":118880,"_5":14097,"_26932":118804,"_2867":118881},[],"Visión general de IoT Fleets",{"_3381":70284,"_29612":70257,"_20544":118883,"_5":14097,"_26932":118804,"_2867":118884},[],"**Administración**",{"_3381":70285,"_29612":70257,"_20544":118886,"_5":14097,"_26932":118804,"_2867":118887},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3381":70286,"_29612":70257,"_20544":118889,"_5":14097,"_26932":118804,"_2867":115083},[],{"_3381":70287,"_29612":70257,"_20544":118891,"_5":14097,"_26932":118804,"_2867":118892},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3381":70288,"_29612":70257,"_20544":118894,"_5":14097,"_26932":118808,"_2867":118895},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3381":70289,"_29612":70257,"_20544":118897,"_5":14097,"_26932":118808,"_2867":118898},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3381":70290,"_29612":70257,"_20544":118900,"_5":14097,"_26932":118808,"_2867":118901},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3381":70291,"_29612":70257,"_20544":118903,"_5":14097,"_26932":118808,"_2867":118904},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3381":70292,"_29612":70257,"_20544":118906,"_5":14097,"_26932":118808,"_2867":118907},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3381":70293,"_29612":70257,"_20544":118909,"_5":14097,"_26932":118808,"_2867":118910},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3381":70294,"_29612":70257,"_20544":118912,"_5":14097,"_26932":118816,"_2867":118913},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3381":70295,"_29612":70257,"_20544":118915,"_5":14097,"_26932":118820,"_2867":118916},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3381":70296,"_29612":70257,"_20544":118918,"_5":14097,"_26932":118824,"_2867":118919},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3381":70297,"_29612":70257,"_20544":118921,"_5":14097,"_26932":118828,"_2867":118922},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3381":70298,"_29612":70257,"_20544":118924,"_5":14097,"_26932":118832,"_2867":118925},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3381":70299,"_29612":70257,"_20544":118927,"_5":14097,"_26932":118836,"_2867":118928},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3381":70300,"_29612":70257,"_20544":118930,"_5":14097,"_26932":118840,"_2867":118386},[],{"_3381":70301,"_29612":70257,"_20544":118932,"_5":14097,"_26932":118840,"_2867":118933},[],"Qué prepara o comprueba",{"_3381":70302,"_29612":70257,"_20544":118935,"_5":14097,"_26932":118840,"_2867":118389},[],{"_3381":70303,"_29612":70257,"_20544":118937,"_5":14097,"_26932":118840,"_2867":118938},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3381":70304,"_29612":70257,"_20544":118940,"_5":14097,"_26932":118840,"_2867":118941},[],"Administrador de la flota",{"_3381":70305,"_29612":70257,"_20544":118943,"_5":14097,"_26932":118840,"_2867":118944},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3381":70306,"_29612":70257,"_20544":118946,"_5":14097,"_26932":118840,"_2867":118401},[],{"_3381":70307,"_29612":70257,"_20544":118948,"_5":14097,"_26932":118840,"_2867":118949},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3381":70308,"_29612":70257,"_20544":118951,"_5":14097,"_26932":118840,"_2867":118407},[],{"_3381":70309,"_29612":70257,"_20544":118953,"_5":14097,"_26932":118840,"_2867":118954},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3381":70310,"_29612":70257,"_20544":118956,"_5":14097,"_26932":118840,"_2867":118957},[],"Operador de infraestructura",{"_3381":70311,"_29612":70257,"_20544":118959,"_5":14097,"_26932":118840,"_2867":118960},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3381":70312,"_29612":70257,"_20544":118962,"_5":14097,"_26932":118840,"_2867":118963},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3381":70313,"_29612":70313,"_5":14455,"_2867":118965,"_29965":118966,"_20544":118968,"_26932":70313},"Jerarquía y rotación de CAs",[48231,115085,53708,118967],"Claves, autoridades y certificados",[],{"_3381":70314,"_29612":70313,"_20544":118970,"_5":14097,"_26932":70313,"_2867":118971},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3381":70315,"_29612":70313,"_5":29962,"_20544":118973,"_26932":118974,"_2867":118975},[],"/docs/pr-preview/pr-53/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3381":70316,"_29612":70313,"_5":29962,"_20544":118977,"_26932":118978,"_2867":118979},[],"/docs/pr-preview/pr-53/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3381":70317,"_29612":70313,"_5":29962,"_20544":118981,"_26932":118982,"_2867":118983},[],"/docs/pr-preview/pr-53/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3381":70318,"_29612":70313,"_5":29962,"_20544":118985,"_26932":118986,"_2867":118987},[],"/docs/pr-preview/pr-53/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3381":70319,"_29612":70313,"_5":29962,"_20544":118989,"_26932":118990,"_2867":118991},[],"/docs/pr-preview/pr-53/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3381":70320,"_29612":70313,"_5":29962,"_20544":118993,"_26932":118994,"_2867":118995},[],"/docs/pr-preview/pr-53/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3381":70321,"_29612":70313,"_5":29962,"_20544":118997,"_26932":118998,"_2867":118999},[],"/docs/pr-preview/pr-53/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3381":70322,"_29612":70313,"_5":29962,"_20544":119001,"_26932":119002,"_2867":119003},[],"/docs/pr-preview/pr-53/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3381":70323,"_29612":70313,"_5":29962,"_20544":119005,"_26932":119006,"_2867":119007},[],"/docs/pr-preview/pr-53/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3381":70324,"_29612":70313,"_5":29962,"_20544":119009,"_26932":119010,"_2867":119011},[],"/docs/pr-preview/pr-53/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3381":70325,"_29612":70313,"_5":29962,"_20544":119013,"_26932":119014,"_2867":119015},[],"/docs/pr-preview/pr-53/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3381":70326,"_29612":70313,"_5":29962,"_20544":119017,"_26932":119018,"_2867":119019},[],"/docs/pr-preview/pr-53/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3381":70327,"_29612":70313,"_20544":119021,"_5":14097,"_26932":70313,"_2867":119022},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3381":70328,"_29612":70313,"_20544":119024,"_5":14097,"_26932":70313,"_2867":119025},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3381":70329,"_29612":70313,"_20544":119027,"_5":14097,"_26932":118974,"_2867":119028},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3381":70330,"_29612":70313,"_20544":119030,"_5":14097,"_26932":118974,"_2867":119031},[],"entorno, como producción y preproducción;",{"_3381":70331,"_29612":70313,"_20544":119033,"_5":14097,"_26932":118974,"_2867":119034},[],"propietario o equipo operador;",{"_3381":70332,"_29612":70313,"_20544":119036,"_5":14097,"_26932":118974,"_2867":119037},[],"familia de dispositivos o proceso de fabricación;",{"_3381":70333,"_29612":70313,"_20544":119039,"_5":14097,"_26932":118974,"_2867":119040},[],"región o requisito regulatorio;",{"_3381":70334,"_29612":70313,"_20544":119042,"_5":14097,"_26932":118974,"_2867":119043},[],"motor criptográfico o política de clave;",{"_3381":70335,"_29612":70313,"_20544":119045,"_5":14097,"_26932":118974,"_2867":119046},[],"ventana de mantenimiento y ritmo de renovación.",{"_3381":70336,"_29612":70313,"_20544":119048,"_5":14097,"_26932":118974,"_2867":119049},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3381":70337,"_29612":70313,"_20544":119051,"_5":14097,"_26932":118974,"_2867":119052},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3381":70338,"_29612":70313,"_20544":119054,"_5":14097,"_26932":118978,"_2867":119055},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3381":70339,"_29612":70313,"_20544":119057,"_5":14097,"_26932":118978,"_2867":119058},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3381":70340,"_29612":70313,"_20544":119060,"_5":14097,"_26932":118978,"_2867":119061},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_3381":70341,"_29612":70313,"_20544":119063,"_5":14097,"_26932":118982,"_2867":119064},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3381":70342,"_29612":70313,"_20544":119066,"_5":14097,"_26932":118982,"_2867":119067},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3381":70343,"_29612":70313,"_20544":119069,"_5":14097,"_26932":118982,"_2867":119070},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3381":70344,"_29612":70313,"_20544":119072,"_5":14097,"_26932":118982,"_2867":119073},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3381":70345,"_29612":70313,"_20544":119075,"_5":14097,"_26932":118990,"_2867":119076},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3381":70346,"_29612":70313,"_20544":119078,"_5":14097,"_26932":118994,"_2867":119079},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3381":70347,"_29612":70313,"_20544":119081,"_5":14097,"_26932":118998,"_2867":119082},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3381":70348,"_29612":70313,"_20544":119084,"_5":14097,"_26932":119002,"_2867":119085},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_3381":70349,"_29612":70313,"_20544":119087,"_5":14097,"_26932":119006,"_2867":119088},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3381":70350,"_29612":70313,"_20544":119090,"_5":14097,"_26932":119010,"_2867":119091},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_3381":70351,"_29612":70313,"_20544":119093,"_5":14097,"_26932":119014,"_2867":119094},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3381":70352,"_29612":70313,"_20544":119096,"_5":14097,"_26932":119014,"_2867":119097},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3381":70353,"_29612":70313,"_20544":119099,"_5":14097,"_26932":119014,"_2867":119100},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_3381":70354,"_29612":70313,"_20544":119102,"_5":14097,"_26932":119014,"_2867":119103},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3381":70355,"_29612":70313,"_20544":119105,"_5":14097,"_26932":119018,"_2867":119106},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3381":70356,"_29612":70313,"_20544":119108,"_5":14097,"_26932":119018,"_2867":119109},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3381":70357,"_29612":70313,"_20544":119111,"_5":14097,"_26932":119018,"_2867":119112},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3381":70358,"_29612":70313,"_20544":119114,"_5":14097,"_26932":119018,"_2867":119115},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3381":70359,"_29612":70313,"_20544":119117,"_5":14097,"_26932":119018,"_2867":119118},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3381":70360,"_29612":70313,"_20544":119120,"_5":14097,"_26932":119018,"_2867":119121},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3381":70361,"_29612":70313,"_20544":119123,"_5":14097,"_26932":119018,"_2867":119124},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3381":70362,"_29612":70362,"_5":14455,"_2867":119126,"_29965":119127,"_20544":119128,"_26932":70362},"Autoridades de certificación",[48231,115085,53708,118967],[],{"_3381":70363,"_29612":70362,"_20544":119130,"_5":14097,"_26932":70362,"_2867":119131},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3381":70364,"_29612":70362,"_5":29962,"_20544":119133,"_26932":119134,"_2867":119135},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3381":70365,"_29612":70362,"_5":29962,"_20544":119137,"_26932":119138,"_2867":119139},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3381":70366,"_29612":70362,"_5":29962,"_20544":119141,"_26932":119142,"_2867":113663},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3381":70367,"_29612":70362,"_5":29962,"_20544":119144,"_26932":119145,"_2867":119146},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3381":70368,"_29612":70362,"_5":29962,"_20544":119148,"_26932":119149,"_2867":119150},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3381":70369,"_29612":70362,"_5":29962,"_20544":119152,"_26932":119153,"_2867":119154},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3381":70370,"_29612":70362,"_5":29962,"_20544":119156,"_26932":119157,"_2867":119158},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3381":70371,"_29612":70362,"_5":29962,"_20544":119160,"_26932":119161,"_2867":119162},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3381":70372,"_29612":70362,"_5":29962,"_20544":119164,"_26932":119165,"_2867":119166},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3381":70373,"_29612":70362,"_5":29962,"_20544":119168,"_26932":119169,"_2867":119170},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3381":70374,"_29612":70362,"_5":29962,"_20544":119172,"_26932":119173,"_2867":119174},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3381":70375,"_29612":70362,"_5":29962,"_20544":119176,"_26932":119177,"_2867":119178},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3381":70376,"_29612":70362,"_5":29962,"_20544":119180,"_26932":119181,"_2867":119182},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3381":70377,"_29612":70362,"_5":29962,"_20544":119184,"_26932":119185,"_2867":119186},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3381":70378,"_29612":70362,"_5":29962,"_20544":119188,"_26932":119189,"_2867":119190},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3381":70379,"_29612":70362,"_5":29962,"_20544":119192,"_26932":119193,"_2867":119194},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3381":70380,"_29612":70362,"_5":29962,"_20544":119196,"_26932":119197,"_2867":119198},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3381":70381,"_29612":70362,"_5":29962,"_20544":119200,"_26932":119201,"_2867":119202},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3381":70382,"_29612":70362,"_5":29962,"_20544":119204,"_26932":119205,"_2867":119206},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3381":70383,"_29612":70362,"_5":29962,"_20544":119208,"_26932":119209,"_2867":119210},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3381":70384,"_29612":70362,"_5":29962,"_20544":119212,"_26932":119213,"_2867":119214},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3381":70385,"_29612":70362,"_5":29962,"_20544":119216,"_26932":119217,"_2867":119218},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3381":70386,"_29612":70362,"_5":29962,"_20544":119220,"_26932":119221,"_2867":119222},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-authorities#elimina-una-ca","Elimina una CA",{"_3381":70387,"_29612":70362,"_20544":119224,"_5":14097,"_26932":70362,"_2867":119225},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3381":70388,"_29612":70362,"_20544":119227,"_5":14097,"_26932":70362,"_2867":119228},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3381":70389,"_29612":70362,"_20544":119230,"_5":14097,"_26932":70362,"_2867":119231},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3381":70390,"_29612":70362,"_20544":119233,"_5":14097,"_26932":119134,"_2867":119234},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3381":70391,"_29612":70362,"_20544":119236,"_5":14097,"_26932":119134,"_2867":119237},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3381":70392,"_29612":70362,"_20544":119239,"_5":14097,"_26932":119134,"_2867":119240},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3381":70393,"_29612":70362,"_20544":119242,"_5":14097,"_26932":119134,"_2867":119243},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3381":70394,"_29612":70362,"_20544":119245,"_5":14097,"_26932":119134,"_2867":119246},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3381":70395,"_29612":70362,"_20544":119248,"_5":14097,"_26932":119142,"_2867":119249},[],"Decide si la CA será raíz o intermedia.",{"_3381":70396,"_29612":70362,"_20544":119251,"_5":14097,"_26932":119142,"_2867":119252},[],"Elige el motor que custodiará la clave.",{"_3381":70397,"_29612":70362,"_20544":119254,"_5":14097,"_26932":119142,"_2867":119255},[],"Define una validez superior a la de los certificados que emitirá.",{"_3381":70398,"_29612":70362,"_20544":119257,"_5":14097,"_26932":119142,"_2867":119258},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3381":70399,"_29612":70362,"_20544":119260,"_5":14097,"_26932":119145,"_2867":119261},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3381":70400,"_29612":70362,"_20544":119263,"_5":14097,"_26932":119149,"_2867":119264},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3381":70401,"_29612":70362,"_20544":119266,"_5":14097,"_26932":119149,"_2867":119267},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3381":70402,"_29612":70362,"_20544":119269,"_5":14097,"_26932":119153,"_2867":119270},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3381":70403,"_29612":70362,"_20544":119272,"_5":14097,"_26932":119157,"_2867":119273},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3381":70404,"_29612":70362,"_20544":119275,"_5":14097,"_26932":119157,"_2867":119276},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3381":70405,"_29612":70362,"_20544":119278,"_5":14097,"_26932":119157,"_2867":119279},[],"`ST`: estado o provincia.",{"_3381":70406,"_29612":70362,"_20544":119281,"_5":14097,"_26932":119157,"_2867":119282},[],"`L`: localidad.",{"_3381":70407,"_29612":70362,"_20544":119284,"_5":14097,"_26932":119157,"_2867":119285},[],"`O`: organización.",{"_3381":70408,"_29612":70362,"_20544":119287,"_5":14097,"_26932":119157,"_2867":119288},[],"`OU`: unidad organizativa.",{"_3381":70409,"_29612":70362,"_20544":119290,"_5":14097,"_26932":119157,"_2867":119291},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3381":70410,"_29612":70362,"_20544":119293,"_5":14097,"_26932":119161,"_2867":119294},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3381":70411,"_29612":70362,"_20544":119296,"_5":14097,"_26932":119161,"_2867":119297},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3381":70412,"_29612":70362,"_20544":119299,"_5":14097,"_26932":119165,"_2867":119300},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3381":70413,"_29612":70362,"_20544":119302,"_5":14097,"_26932":119165,"_2867":119303},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3381":70414,"_29612":70362,"_20544":119305,"_5":14097,"_26932":119169,"_2867":119306},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3381":70415,"_29612":70362,"_20544":119308,"_5":14097,"_26932":119169,"_2867":119309},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3381":70416,"_29612":70362,"_20544":119311,"_5":14097,"_26932":119173,"_2867":119312},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma (incluido `cRLSign`, sin el cual la CA no puede publicar su CRL) y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3381":70417,"_29612":70362,"_20544":119314,"_5":14097,"_26932":119173,"_2867":119315},[],"El backend rechaza una importación cuyo certificado carece de la restricción básica de CA (`basicConstraints cA flag is not set`), cuyo número de serie coincide con el de un certificado almacenado con contenido distinto, o cuyo certificado idéntico ya pertenece a una CA existente. El registro de certificado de una CA eliminada se conserva y puede reutilizarse al reimportar el mismo certificado, incluido su estado anterior. Reimportar otro certificado con ese número de serie se rechaza; comprueba el certificado y su estado tras reimportarlo.",{"_3381":70418,"_29612":70362,"_20544":119317,"_5":14097,"_26932":119173,"_2867":119318},[],"Eliminar una CA libera las referencias a la clave de su propio certificado actual y de sus certificados reemitidos vinculados, pero conserva esos registros para la CRL y el OCSP de su emisor. Después intenta eliminar la clave; el KMS la conserva si otros certificados todavía la referencian, como los de otra CA que comparte la clave. Revocar los certificados emitidos por la CA eliminada no libera sus propias referencias a claves.",{"_3381":70419,"_29612":70362,"_20544":119320,"_5":14097,"_26932":119177,"_2867":119321},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3381":70420,"_29612":70362,"_20544":119323,"_5":14097,"_26932":119181,"_2867":119324},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3381":70421,"_29612":70362,"_20544":119326,"_5":14097,"_26932":119185,"_2867":119327},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3381":70422,"_29612":70362,"_20544":119329,"_5":14097,"_26932":119189,"_2867":119330},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3381":70423,"_29612":70362,"_20544":119332,"_5":14097,"_26932":119189,"_2867":119333},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3381":70424,"_29612":70362,"_20544":119335,"_5":14097,"_26932":119193,"_2867":119336},[],"Abre una CA desde el inventario para consultar:",{"_3381":70425,"_29612":70362,"_20544":119338,"_5":14097,"_26932":119193,"_2867":119339},[],"Estado y periodo de validez.",{"_3381":70426,"_29612":70362,"_20544":119341,"_5":14097,"_26932":119193,"_2867":119342},[],"Certificado y cadena en formato PEM.",{"_3381":70427,"_29612":70362,"_20544":119344,"_5":14097,"_26932":119193,"_2867":119345},[],"Número de certificados activos, expirados y revocados.",{"_3381":70428,"_29612":70362,"_20544":119347,"_5":14097,"_26932":119193,"_2867":119348},[],"Certificados emitidos en **Issued Certificates**.",{"_3381":70429,"_29612":70362,"_20544":119350,"_5":14097,"_26932":119193,"_2867":119351},[],"CRL vinculada a la autoridad.",{"_3381":70430,"_29612":70362,"_20544":119353,"_5":14097,"_26932":119193,"_2867":119354},[],"Metadatos y motor criptográfico asociado.",{"_3381":70431,"_29612":70362,"_20544":119356,"_5":14097,"_26932":119193,"_2867":119357},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3381":70432,"_29612":70362,"_20544":119359,"_5":14097,"_26932":119197,"_2867":119360},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3381":70433,"_29612":70362,"_20544":119362,"_5":14097,"_26932":119197,"_2867":119363},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3381":70434,"_29612":70362,"_20544":119365,"_5":14097,"_26932":119197,"_2867":119366},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3381":70435,"_29612":70362,"_20544":119368,"_5":14097,"_26932":119197,"_2867":119369},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3381":70436,"_29612":70362,"_20544":119371,"_5":14097,"_26932":119201,"_2867":119372},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_3381":70437,"_29612":70362,"_20544":119374,"_5":14097,"_26932":119205,"_2867":119375},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3381":70438,"_29612":70362,"_20544":119377,"_5":14097,"_26932":119209,"_2867":119378},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3381":70439,"_29612":70362,"_20544":119380,"_5":14097,"_26932":119213,"_2867":119381},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3381":70440,"_29612":70362,"_20544":119383,"_5":14097,"_26932":119217,"_2867":119384},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3381":70441,"_29612":70362,"_20544":119386,"_5":14097,"_26932":119221,"_2867":119387},[],"La eliminación permanente solo está disponible con la CA revocada o caducada; una CA importada sin clave puede eliminarse en cualquier estado. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3381":70442,"_29612":70362,"_20544":119389,"_5":14097,"_26932":119221,"_2867":119390},[],"El rol VA de la CA se conserva. Si no queda otra CA con el mismo SKI, deja de ser editable (consulta CRL), así que ajusta antes su validez y su firmante. La clave de la CA se libera, pero el KMS la conserva mientras otros certificados la referencien.",{"_3381":70443,"_29612":70362,"_20544":119392,"_5":14097,"_26932":119221,"_2867":119393},[],"Lamassu conserva el registro del certificado de una CA eliminada. Si se importa de nuevo ese mismo certificado, la importación termina bien y reutiliza el registro: actualiza el tipo, el emisor y la clave, pero conserva el estado, así que la CA reaparece con el que tenía al eliminarse (normalmente revocada o caducada). Un certificado distinto con el mismo número de serie se rechaza con error 400, y un certificado que ya pertenece a una CA existente, con error 409. Para no heredar el estado anterior, usa un certificado con otro número de serie y comprueba el resultado tras importar. Si el certificado nuevo usa la misma clave, comparte el SKI con el rol VA retenido de la CA eliminada, cuyo firmante es el certificado antiguo: comprueba que la CRL se genera y, si no es así, asigna con `PUT` un firmante de la CA nueva (consulta CRL).",{"_3381":70444,"_29612":70444,"_5":14455,"_2867":119395,"_29965":119396,"_20544":119397,"_26932":70444},"Perfiles de certificado",[48231,115085,53708,118967],[],{"_3381":70445,"_29612":70444,"_20544":119399,"_5":14097,"_26932":70444,"_2867":119400},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3381":70446,"_29612":70444,"_5":29962,"_20544":119402,"_26932":119403,"_2867":119404},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3381":70447,"_29612":70444,"_5":29962,"_20544":119406,"_26932":119407,"_2867":119408},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-profiles#validez","Validez",{"_3381":70448,"_29612":70444,"_5":29962,"_20544":119410,"_26932":119411,"_2867":119412},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3381":70449,"_29612":70444,"_5":29962,"_20544":119414,"_26932":119415,"_2867":119416},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3381":70450,"_29612":70444,"_5":29962,"_20544":119418,"_26932":119419,"_2867":119420},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3381":70451,"_29612":70444,"_5":29962,"_20544":119422,"_26932":119423,"_2867":119424},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3381":70452,"_29612":70444,"_5":29962,"_20544":119426,"_26932":119427,"_2867":119428},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3381":70453,"_29612":70444,"_5":29962,"_20544":119430,"_26932":119431,"_2867":119432},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3381":70454,"_29612":70444,"_5":29962,"_20544":119434,"_26932":119435,"_2867":119436},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3381":70455,"_29612":70444,"_5":29962,"_20544":119438,"_26932":119439,"_2867":119440},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3381":70456,"_29612":70444,"_5":29962,"_20544":119442,"_26932":119443,"_2867":119444},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3381":70457,"_29612":70444,"_5":29962,"_20544":119446,"_26932":119447,"_2867":119448},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3381":70458,"_29612":70444,"_5":29962,"_20544":119450,"_26932":119451,"_2867":119452},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3381":70459,"_29612":70444,"_5":29962,"_20544":119454,"_26932":119455,"_2867":119456},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3381":70460,"_29612":70444,"_5":29962,"_20544":119458,"_26932":119459,"_2867":119460},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3381":70461,"_29612":70444,"_5":29962,"_20544":119462,"_26932":119463,"_2867":119464},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3381":70462,"_29612":70444,"_20544":119466,"_5":14097,"_26932":70444,"_2867":119467},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3381":70463,"_29612":70444,"_20544":119469,"_5":14097,"_26932":70444,"_2867":119470},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3381":70464,"_29612":70444,"_20544":119472,"_5":14097,"_26932":119407,"_2867":119473},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3381":70465,"_29612":70444,"_20544":119475,"_5":14097,"_26932":119407,"_2867":119476},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3381":70466,"_29612":70444,"_20544":119478,"_5":14097,"_26932":119411,"_2867":119479},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Actívalo solo en perfiles destinados a crear o reemitir CAs subordinadas.",{"_3381":70467,"_29612":70444,"_20544":119481,"_5":14097,"_26932":119415,"_2867":119482},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3381":70468,"_29612":70444,"_20544":119484,"_5":14097,"_26932":119415,"_2867":119485},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3381":70469,"_29612":70444,"_20544":119487,"_5":14097,"_26932":119415,"_2867":119488},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3381":70470,"_29612":70444,"_20544":119490,"_5":14097,"_26932":119419,"_2867":119491},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3381":70471,"_29612":70444,"_20544":119493,"_5":14097,"_26932":119423,"_2867":119494},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3381":70472,"_29612":70444,"_20544":119496,"_5":14097,"_26932":119423,"_2867":119497},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3381":70473,"_29612":70444,"_20544":119499,"_5":14097,"_26932":119427,"_2867":119500},[],"La aplicación criptográfica puede:",{"_3381":70474,"_29612":70444,"_20544":119502,"_5":14097,"_26932":119427,"_2867":119503},[],"permitir o bloquear claves RSA;",{"_3381":70475,"_29612":70444,"_20544":119505,"_5":14097,"_26932":119427,"_2867":119506},[],"limitar los tamaños RSA admitidos;",{"_3381":70476,"_29612":70444,"_20544":119508,"_5":14097,"_26932":119427,"_2867":119509},[],"permitir o bloquear claves ECDSA;",{"_3381":70477,"_29612":70444,"_20544":119511,"_5":14097,"_26932":119427,"_2867":119512},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3381":70478,"_29612":70444,"_20544":119514,"_5":14097,"_26932":119427,"_2867":119515},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3381":70479,"_29612":70444,"_20544":119517,"_5":14097,"_26932":119431,"_2867":119518},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3381":70480,"_29612":70444,"_20544":119520,"_5":14097,"_26932":119431,"_2867":114845},[],{"_3381":70481,"_29612":70444,"_20544":119522,"_5":14097,"_26932":119431,"_2867":119523},[],"Primera opción",{"_3381":70482,"_29612":70444,"_20544":119525,"_5":14097,"_26932":119431,"_2867":119526},[],"Segunda opción",{"_3381":70483,"_29612":70444,"_20544":119528,"_5":14097,"_26932":119431,"_2867":119529},[],"Si no hay ninguna",{"_3381":70484,"_29612":70444,"_20544":119531,"_5":14097,"_26932":119431,"_2867":119532},[],"Firma directa con una CA",{"_3381":70485,"_29612":70444,"_20544":119534,"_5":14097,"_26932":119431,"_2867":119535},[],"`issuance_profile` incluido en la solicitud",{"_3381":70486,"_29612":70444,"_20544":119537,"_5":14097,"_26932":119431,"_2867":119538},[],"`issuance_profile_id` de la solicitud",{"_3381":70487,"_29612":70444,"_20544":119540,"_5":14097,"_26932":119431,"_2867":119541},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3381":70488,"_29612":70444,"_20544":119543,"_5":14097,"_26932":119431,"_2867":119544},[],"Emisión mediante DMS",{"_3381":70489,"_29612":70444,"_20544":119546,"_5":14097,"_26932":119431,"_2867":54289},[],{"_3381":70490,"_29612":70444,"_20544":119548,"_5":14097,"_26932":119431,"_2867":119549},[],"`settings.issuance_profile` incluido en el DMS",{"_3381":70491,"_29612":70444,"_20544":119551,"_5":14097,"_26932":119431,"_2867":119552},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3381":70492,"_29612":70444,"_20544":119554,"_5":14097,"_26932":119431,"_2867":119555},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3381":70493,"_29612":70444,"_20544":119557,"_5":14097,"_26932":119431,"_2867":119558},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3381":70494,"_29612":70444,"_20544":119560,"_5":14097,"_26932":119439,"_2867":119561},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3381":70495,"_29612":70444,"_20544":119563,"_5":14097,"_26932":119443,"_2867":119564},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3381":70496,"_29612":70444,"_20544":119566,"_5":14097,"_26932":119447,"_2867":119567},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3381":70497,"_29612":70444,"_20544":119569,"_5":14097,"_26932":119451,"_2867":119570},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3381":70498,"_29612":70444,"_20544":119572,"_5":14097,"_26932":119455,"_2867":119573},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3381":70499,"_29612":70444,"_20544":119575,"_5":14097,"_26932":119455,"_2867":119576},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3381":70500,"_29612":70444,"_20544":119578,"_5":14097,"_26932":119459,"_2867":119579},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3381":70501,"_29612":70444,"_20544":119581,"_5":14097,"_26932":119459,"_2867":119582},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3381":70502,"_29612":70444,"_20544":119584,"_5":14097,"_26932":119459,"_2867":119585},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3381":70503,"_29612":70444,"_20544":119587,"_5":14097,"_26932":119459,"_2867":119588},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3381":70504,"_29612":70444,"_20544":119590,"_5":14097,"_26932":119463,"_2867":119591},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3381":70505,"_29612":70444,"_20544":119593,"_5":14097,"_26932":119463,"_2867":119594},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3381":70506,"_29612":70506,"_5":14455,"_2867":119596,"_29965":119597,"_20544":119599,"_26932":70506},"Validación de certificados",[48231,115085,53708,119598],"Validación",[],{"_3381":70507,"_29612":70506,"_20544":119601,"_5":14097,"_26932":70506,"_2867":119602},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3381":70508,"_29612":70506,"_5":29962,"_20544":119604,"_26932":119605,"_2867":119606},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3381":70509,"_29612":70506,"_5":29962,"_20544":119608,"_26932":119609,"_2867":119610},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3381":70510,"_29612":70506,"_5":29962,"_20544":119612,"_26932":119613,"_2867":119614},[],"/docs/pr-preview/pr-53/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3381":70511,"_29612":70506,"_20544":119616,"_5":14097,"_26932":70506,"_2867":119617},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3381":70512,"_29612":70506,"_20544":119619,"_5":14097,"_26932":119605,"_2867":119620},[],"Verifica estos criterios juntos:",{"_3381":70513,"_29612":70506,"_20544":119622,"_5":14097,"_26932":119605,"_2867":118596},[],{"_3381":70514,"_29612":70506,"_20544":119624,"_5":14097,"_26932":119605,"_2867":119625},[],"Resultado necesario",{"_3381":70515,"_29612":70506,"_20544":119627,"_5":14097,"_26932":119605,"_2867":119628},[],"Cadena y firma",{"_3381":70516,"_29612":70506,"_20544":119630,"_5":14097,"_26932":119605,"_2867":119631},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3381":70517,"_29612":70506,"_20544":119633,"_5":14097,"_26932":119605,"_2867":119634},[],"Fechas",{"_3381":70518,"_29612":70506,"_20544":119636,"_5":14097,"_26932":119605,"_2867":119637},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3381":70519,"_29612":70506,"_20544":119639,"_5":14097,"_26932":119605,"_2867":114755},[],{"_3381":70520,"_29612":70506,"_20544":119641,"_5":14097,"_26932":119605,"_2867":119642},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3381":70521,"_29612":70506,"_20544":119644,"_5":14097,"_26932":119605,"_2867":119645},[],"Uso",{"_3381":70522,"_29612":70506,"_20544":119647,"_5":14097,"_26932":119605,"_2867":119648},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3381":70523,"_29612":70506,"_20544":119650,"_5":14097,"_26932":119605,"_2867":119651},[],"Revocación",{"_3381":70524,"_29612":70506,"_20544":119653,"_5":14097,"_26932":119605,"_2867":119654},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3381":70525,"_29612":70506,"_20544":119656,"_5":14097,"_26932":119605,"_2867":119657},[],"Autorización",{"_3381":70526,"_29612":70506,"_20544":119659,"_5":14097,"_26932":119605,"_2867":119660},[],"La aplicación permite la acción a esa identidad.",{"_3381":70527,"_29612":70506,"_20544":119662,"_5":14097,"_26932":119605,"_2867":119663},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3381":70528,"_29612":70506,"_20544":119665,"_5":14097,"_26932":119609,"_2867":119666},[],"Mecanismo",{"_3381":70529,"_29612":70506,"_20544":119668,"_5":14097,"_26932":119609,"_2867":119669},[],"Cuándo utilizarlo",{"_3381":70530,"_29612":70506,"_20544":119671,"_5":14097,"_26932":119609,"_2867":119672},[],"Qué debes mantener",{"_3381":70531,"_29612":70506,"_20544":119674,"_5":14097,"_26932":119609,"_2867":54417},[],{"_3381":70532,"_29612":70506,"_20544":119676,"_5":14097,"_26932":119609,"_2867":119677},[],"Consulta del estado de un certificado concreto.",{"_3381":70533,"_29612":70506,"_20544":119679,"_5":14097,"_26932":119609,"_2867":119680},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3381":70534,"_29612":70506,"_20544":119682,"_5":14097,"_26932":119609,"_2867":54426},[],{"_3381":70535,"_29612":70506,"_20544":119684,"_5":14097,"_26932":119609,"_2867":119685},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3381":70536,"_29612":70506,"_20544":119687,"_5":14097,"_26932":119609,"_2867":119688},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3381":70537,"_29612":70506,"_20544":119690,"_5":14097,"_26932":119609,"_2867":119691},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3381":70538,"_29612":70506,"_20544":119693,"_5":14097,"_26932":119609,"_2867":119694},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3381":70539,"_29612":70506,"_20544":119696,"_5":14097,"_26932":119613,"_2867":119697},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3381":70540,"_29612":70506,"_20544":119699,"_5":14097,"_26932":119613,"_2867":119700},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3381":70541,"_29612":70506,"_20544":119702,"_5":14097,"_26932":119613,"_2867":119703},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3381":70542,"_29612":70506,"_20544":119705,"_5":14097,"_26932":119613,"_2867":119706},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3381":70543,"_29612":70506,"_20544":119708,"_5":14097,"_26932":119613,"_2867":119709},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3381":70544,"_29612":70506,"_20544":119711,"_5":14097,"_26932":119613,"_2867":119712},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3381":70545,"_29612":70506,"_20544":119714,"_5":14097,"_26932":119613,"_2867":119715},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3381":70546,"_29612":70506,"_20544":119717,"_5":14097,"_26932":119613,"_2867":119718},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3381":70547,"_29612":70506,"_20544":119720,"_5":14097,"_26932":119613,"_2867":119721},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3381":70548,"_29612":70548,"_5":14455,"_2867":119723,"_29965":119724,"_20544":119725,"_26932":70548},"Certificados",[48231,115085,53708,118967],[],{"_3381":70549,"_29612":70548,"_20544":119727,"_5":14097,"_26932":70548,"_2867":119728},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3381":70550,"_29612":70548,"_5":29962,"_20544":119730,"_26932":119731,"_2867":119732},[],"/docs/pr-preview/pr-53/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3381":70551,"_29612":70548,"_5":29962,"_20544":119734,"_26932":119735,"_2867":119736},[],"/docs/pr-preview/pr-53/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3381":70552,"_29612":70548,"_5":29962,"_20544":119738,"_26932":119739,"_2867":119740},[],"/docs/pr-preview/pr-53/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3381":70553,"_29612":70548,"_5":29962,"_20544":119742,"_26932":119743,"_2867":119744},[],"/docs/pr-preview/pr-53/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3381":70554,"_29612":70548,"_5":29962,"_20544":119746,"_26932":119747,"_2867":119748},[],"/docs/pr-preview/pr-53/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3381":70555,"_29612":70548,"_5":29962,"_20544":119750,"_26932":119751,"_2867":119752},[],"/docs/pr-preview/pr-53/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3381":70556,"_29612":70548,"_5":29962,"_20544":119754,"_26932":119755,"_2867":119756},[],"/docs/pr-preview/pr-53/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3381":70557,"_29612":70548,"_5":29962,"_20544":119758,"_26932":119759,"_2867":119760},[],"/docs/pr-preview/pr-53/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3381":70558,"_29612":70548,"_5":29962,"_20544":119762,"_26932":119763,"_2867":119764},[],"/docs/pr-preview/pr-53/es/platform/pki/certificates#continúa","Continúa",{"_3381":70559,"_29612":70548,"_20544":119766,"_5":14097,"_26932":70548,"_2867":119767},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3381":70560,"_29612":70548,"_20544":119769,"_5":14097,"_26932":119731,"_2867":119770},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Un certificado no contiene su clave privada, así que las superficies de clave privada responden qué certificados tienen su clave custodiada en el KMS de Lamassu:",{"_3381":70561,"_29612":70548,"_20544":119772,"_5":14097,"_26932":119731,"_2867":119773},[],"El filtro avanzado **Private Key**, disponible en la página Certificates y en la pestaña **Issued Certificates** de una CA, limita la lista a **All Certificates**, **With Private Key** o **Without Private Key**.",{"_3381":70562,"_29612":70548,"_20544":119775,"_5":14097,"_26932":119731,"_2867":119776},[],"La columna ordenable **Private Key** — visible por defecto y oculta en pantallas estrechas — marca con una marca de verificación verde la clave custodiada en el KMS y muestra `-` en los demás casos.",{"_3381":70563,"_29612":70548,"_20544":119778,"_5":14097,"_26932":119731,"_2867":119779},[],"En los detalles del certificado, la pestaña **Information** muestra una fila **Private Key** en la sección **Key & Signature**. Cuando el certificado indica que tiene clave privada y están disponibles los identificadores de la clave y del motor del KMS, la fila enlaza a la clave (tooltip: **Open private key in KMS**). En caso contrario, muestra **Present** si el certificado indica que tiene clave privada o **Not available** si no lo indica. Esto no determina si existe una clave fuera de Lamassu.",{"_3381":70564,"_29612":70548,"_20544":119781,"_5":14097,"_26932":119731,"_2867":119782},[],"Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_3381":70565,"_29612":70548,"_20544":119784,"_5":14097,"_26932":119731,"_2867":119785},[],"Los detalles del certificado incluyen la referencia a la clave (`key_id`) y si la clave privada está gestionada (`has_private_key`); las listas de certificados pueden filtrarse por `has_private_key`.",{"_3381":70566,"_29612":70548,"_20544":119787,"_5":14097,"_26932":119731,"_2867":119788},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3381":70567,"_29612":70548,"_20544":119790,"_5":14097,"_26932":119735,"_2867":119791},[],"Descarga el PEM e inspecciónalo:",{"_3381":70568,"_29612":70548,"_20544":119793,"_5":14097,"_26932":119735,"_2867":119794},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3381":70569,"_29612":70548,"_20544":119796,"_5":14097,"_26932":119739,"_2867":119797},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3381":70570,"_29612":70548,"_20544":119799,"_5":14097,"_26932":119739,"_2867":119800},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3381":70571,"_29612":70548,"_20544":119802,"_5":14097,"_26932":119739,"_2867":119803},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3381":70572,"_29612":70548,"_20544":119805,"_5":14097,"_26932":119739,"_2867":119806},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3381":70573,"_29612":70548,"_20544":119808,"_5":14097,"_26932":119739,"_2867":119809},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3381":70574,"_29612":70548,"_20544":119811,"_5":14097,"_26932":119739,"_2867":119812},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3381":70575,"_29612":70548,"_20544":119814,"_5":14097,"_26932":119739,"_2867":119815},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3381":70576,"_29612":70548,"_20544":119817,"_5":14097,"_26932":119743,"_2867":119818},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3381":70577,"_29612":70548,"_20544":119820,"_5":14097,"_26932":119747,"_2867":119821},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3381":70578,"_29612":70548,"_20544":119823,"_5":14097,"_26932":119751,"_2867":119824},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3381":70579,"_29612":70548,"_20544":119826,"_5":14097,"_26932":119755,"_2867":119827},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3381":70580,"_29612":70548,"_20544":119829,"_5":14097,"_26932":119755,"_2867":119830},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3381":70581,"_29612":70548,"_20544":119832,"_5":14097,"_26932":119755,"_2867":119833},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3381":70582,"_29612":70548,"_20544":119835,"_5":14097,"_26932":119759,"_2867":119836},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3381":70583,"_29612":70548,"_20544":119838,"_5":14097,"_26932":119759,"_2867":119839},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3381":70584,"_29612":70548,"_20544":119841,"_5":14097,"_26932":119759,"_2867":119842},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_3381":70585,"_29612":70548,"_20544":119844,"_5":14097,"_26932":119763,"_2867":119845},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3381":70586,"_29612":70548,"_20544":119847,"_5":14097,"_26932":119763,"_2867":119848},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3381":70587,"_29612":70587,"_5":14455,"_2867":119850,"_29965":119851,"_20544":119853,"_26932":70587},"Ciclo de vida de un certificado",[48231,115085,53708,119852],"Conceptos",[],{"_3381":70588,"_29612":70587,"_20544":119855,"_5":14097,"_26932":70587,"_2867":119856},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3381":70589,"_29612":70587,"_5":29962,"_20544":119858,"_26932":119859,"_2867":119860},[],"/docs/pr-preview/pr-53/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3381":70590,"_29612":70587,"_5":29962,"_20544":119862,"_26932":119863,"_2867":119864},[],"/docs/pr-preview/pr-53/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3381":70591,"_29612":70587,"_5":29962,"_20544":119866,"_26932":119867,"_2867":119868},[],"/docs/pr-preview/pr-53/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3381":70592,"_29612":70587,"_5":29962,"_20544":119870,"_26932":119871,"_2867":119872},[],"/docs/pr-preview/pr-53/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3381":70593,"_29612":70587,"_5":29962,"_20544":119874,"_26932":119875,"_2867":119876},[],"/docs/pr-preview/pr-53/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3381":70594,"_29612":70587,"_5":29962,"_20544":119878,"_26932":119879,"_2867":119880},[],"/docs/pr-preview/pr-53/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3381":70595,"_29612":70587,"_5":29962,"_20544":119882,"_26932":119883,"_2867":117541},[],"/docs/pr-preview/pr-53/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado",{"_3381":70596,"_29612":70587,"_5":29962,"_20544":119885,"_26932":119886,"_2867":119887},[],"/docs/pr-preview/pr-53/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3381":70597,"_29612":70587,"_5":29962,"_20544":119889,"_26932":119890,"_2867":119891},[],"/docs/pr-preview/pr-53/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3381":70598,"_29612":70587,"_5":29962,"_20544":119893,"_26932":119894,"_2867":119895},[],"/docs/pr-preview/pr-53/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3381":70599,"_29612":70587,"_20544":119897,"_5":14097,"_26932":70587,"_2867":119898},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3381":70600,"_29612":70587,"_20544":119900,"_5":14097,"_26932":119863,"_2867":119901},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3381":70601,"_29612":70587,"_20544":119903,"_5":14097,"_26932":119867,"_2867":119904},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3381":70602,"_29612":70587,"_20544":119906,"_5":14097,"_26932":119871,"_2867":119907},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3381":70603,"_29612":70587,"_20544":119909,"_5":14097,"_26932":119875,"_2867":119910},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3381":70604,"_29612":70587,"_20544":119912,"_5":14097,"_26932":119879,"_2867":119913},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3381":70605,"_29612":70587,"_20544":119915,"_5":14097,"_26932":119883,"_2867":119916},[],"Lamassu persiste cuatro estados X.509:",{"_3381":70606,"_29612":70587,"_20544":119918,"_5":14097,"_26932":119883,"_2867":119919},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3381":70607,"_29612":70587,"_20544":119921,"_5":14097,"_26932":119883,"_2867":119922},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3381":70608,"_29612":70587,"_20544":119924,"_5":14097,"_26932":119883,"_2867":119925},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3381":70609,"_29612":70587,"_20544":119927,"_5":14097,"_26932":119883,"_2867":119928},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3381":70610,"_29612":70587,"_20544":119930,"_5":14097,"_26932":119883,"_2867":119931},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3381":70611,"_29612":70587,"_20544":119933,"_5":14097,"_26932":119886,"_2867":119934},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3381":70612,"_29612":70587,"_20544":119936,"_5":14097,"_26932":119886,"_2867":119937},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3381":70613,"_29612":70587,"_20544":119939,"_5":14097,"_26932":119886,"_2867":119940},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3381":70614,"_29612":70587,"_20544":119942,"_5":14097,"_26932":119890,"_2867":119943},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3381":70615,"_29612":70587,"_20544":119945,"_5":14097,"_26932":119890,"_2867":119946},[],"Antes de confirmar:",{"_3381":70616,"_29612":70587,"_20544":119948,"_5":14097,"_26932":119890,"_2867":119949},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3381":70617,"_29612":70587,"_20544":119951,"_5":14097,"_26932":119890,"_2867":119952},[],"Distribuye la nueva cadena de confianza.",{"_3381":70618,"_29612":70587,"_20544":119954,"_5":14097,"_26932":119890,"_2867":119955},[],"Reemite las identidades necesarias.",{"_3381":70619,"_29612":70587,"_20544":119957,"_5":14097,"_26932":119890,"_2867":119958},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3381":70620,"_29612":70587,"_20544":119960,"_5":14097,"_26932":119890,"_2867":119961},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3381":70621,"_29612":70587,"_20544":119963,"_5":14097,"_26932":119890,"_2867":119964},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3381":70622,"_29612":70587,"_20544":119966,"_5":14097,"_26932":119894,"_2867":119967},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3381":70623,"_29612":70587,"_20544":119969,"_5":14097,"_26932":119894,"_2867":119970},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3381":70624,"_29612":70587,"_20544":119972,"_5":14097,"_26932":119894,"_2867":119973},[],"Cambios de estado y razones de revocación.",{"_3381":70625,"_29612":70587,"_20544":119975,"_5":14097,"_26932":119894,"_2867":119976},[],"Publicación y vigencia de OCSP y CRLs.",{"_3381":70626,"_29612":70587,"_20544":119978,"_5":14097,"_26932":119894,"_2867":119979},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3381":70627,"_29612":70587,"_20544":119981,"_5":14097,"_26932":119894,"_2867":119982},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3381":70628,"_29612":70628,"_5":14455,"_2867":119984,"_29965":119985,"_20544":119986,"_26932":70628},"Modelo de confianza",[48231,115085,53708,119852],[],{"_3381":70629,"_29612":70628,"_20544":119988,"_5":14097,"_26932":70628,"_2867":119989},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3381":70630,"_29612":70628,"_5":29962,"_20544":119991,"_26932":119992,"_2867":119993},[],"/docs/pr-preview/pr-53/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3381":70631,"_29612":70628,"_5":29962,"_20544":119995,"_26932":119996,"_2867":119997},[],"/docs/pr-preview/pr-53/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3381":70632,"_29612":70628,"_5":29962,"_20544":119999,"_26932":120000,"_2867":120001},[],"/docs/pr-preview/pr-53/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3381":70633,"_29612":70628,"_5":29962,"_20544":120003,"_26932":120004,"_2867":120005},[],"/docs/pr-preview/pr-53/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3381":70634,"_29612":70628,"_5":29962,"_20544":120007,"_26932":120008,"_2867":120009},[],"/docs/pr-preview/pr-53/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3381":70635,"_29612":70628,"_5":29962,"_20544":120011,"_26932":120012,"_2867":120013},[],"/docs/pr-preview/pr-53/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3381":70636,"_29612":70628,"_5":29962,"_20544":120015,"_26932":120016,"_2867":120017},[],"/docs/pr-preview/pr-53/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3381":70637,"_29612":70628,"_5":29962,"_20544":120019,"_26932":120020,"_2867":120021},[],"/docs/pr-preview/pr-53/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3381":70638,"_29612":70628,"_5":29962,"_20544":120023,"_26932":120024,"_2867":120025},[],"/docs/pr-preview/pr-53/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3381":70639,"_29612":70628,"_5":29962,"_20544":120027,"_26932":120028,"_2867":120029},[],"/docs/pr-preview/pr-53/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3381":70640,"_29612":70628,"_20544":120031,"_5":14097,"_26932":70628,"_2867":120032},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3381":70641,"_29612":70628,"_20544":120034,"_5":14097,"_26932":119996,"_2867":120035},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3381":70642,"_29612":70628,"_20544":120037,"_5":14097,"_26932":120000,"_2867":120038},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3381":70643,"_29612":70628,"_20544":120040,"_5":14097,"_26932":120004,"_2867":120041},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3381":70644,"_29612":70628,"_20544":120043,"_5":14097,"_26932":120008,"_2867":120044},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3381":70645,"_29612":70628,"_20544":120046,"_5":14097,"_26932":120012,"_2867":120047},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3381":70646,"_29612":70628,"_20544":120049,"_5":14097,"_26932":120012,"_2867":120050},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3381":70647,"_29612":70628,"_20544":120052,"_5":14097,"_26932":120012,"_2867":120053},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3381":70648,"_29612":70628,"_20544":120055,"_5":14097,"_26932":120012,"_2867":120056},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3381":70649,"_29612":70628,"_20544":120058,"_5":14097,"_26932":120012,"_2867":120059},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3381":70650,"_29612":70628,"_20544":120061,"_5":14097,"_26932":120012,"_2867":120062},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3381":70651,"_29612":70628,"_20544":120064,"_5":14097,"_26932":120016,"_2867":120065},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3381":70652,"_29612":70628,"_20544":120067,"_5":14097,"_26932":120016,"_2867":120068},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3381":70653,"_29612":70628,"_20544":120070,"_5":14097,"_26932":120016,"_2867":120071},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_3381":70654,"_29612":70628,"_20544":120073,"_5":14097,"_26932":120016,"_2867":120074},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3381":70655,"_29612":70628,"_20544":120076,"_5":14097,"_26932":120016,"_2867":120077},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3381":70656,"_29612":70628,"_20544":120079,"_5":14097,"_26932":120020,"_2867":120080},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3381":70657,"_29612":70628,"_20544":120082,"_5":14097,"_26932":120020,"_2867":120083},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3381":70658,"_29612":70628,"_20544":120085,"_5":14097,"_26932":120020,"_2867":120086},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3381":70659,"_29612":70628,"_20544":120088,"_5":14097,"_26932":120020,"_2867":120089},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3381":70660,"_29612":70628,"_20544":120091,"_5":14097,"_26932":120020,"_2867":120092},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3381":70661,"_29612":70628,"_20544":120094,"_5":14097,"_26932":120020,"_2867":120095},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3381":70662,"_29612":70628,"_20544":120097,"_5":14097,"_26932":120020,"_2867":120098},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_3381":70663,"_29612":70628,"_20544":120100,"_5":14097,"_26932":120024,"_2867":120101},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3381":70664,"_29612":70628,"_20544":120103,"_5":14097,"_26932":120028,"_2867":120104},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3381":70665,"_29612":70628,"_20544":120106,"_5":14097,"_26932":120028,"_2867":120107},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3381":70666,"_29612":70628,"_20544":120109,"_5":14097,"_26932":120028,"_2867":120110},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3381":70667,"_29612":70628,"_20544":120112,"_5":14097,"_26932":120028,"_2867":120113},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3381":70668,"_29612":70628,"_20544":120115,"_5":14097,"_26932":120028,"_2867":120116},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3381":70669,"_29612":70628,"_20544":120118,"_5":14097,"_26932":120028,"_2867":120119},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3381":70670,"_29612":70628,"_20544":120121,"_5":14097,"_26932":120028,"_2867":120122},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3381":70671,"_29612":70671,"_5":14455,"_2867":120124,"_29965":120125,"_20544":120126,"_26932":70671},"Listas de revocación (CRL)",[48231,115085,53708,119598],[],{"_3381":70672,"_29612":70671,"_20544":120128,"_5":14097,"_26932":70671,"_2867":120129},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3381":70673,"_29612":70671,"_5":29962,"_20544":120131,"_26932":120132,"_2867":120133},[],"/docs/pr-preview/pr-53/es/platform/pki/crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_3381":70674,"_29612":70671,"_5":29962,"_20544":120135,"_26932":120136,"_2867":120137},[],"/docs/pr-preview/pr-53/es/platform/pki/crl#cas-que-comparten-clave","CAs que comparten clave",{"_3381":70675,"_29612":70671,"_5":29962,"_20544":120139,"_26932":120140,"_2867":120141},[],"/docs/pr-preview/pr-53/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3381":70676,"_29612":70671,"_5":29962,"_20544":120143,"_26932":120144,"_2867":120145},[],"/docs/pr-preview/pr-53/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3381":70677,"_29612":70671,"_5":29962,"_20544":120147,"_26932":120148,"_2867":120149},[],"/docs/pr-preview/pr-53/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3381":70678,"_29612":70671,"_5":29962,"_20544":120151,"_26932":120152,"_2867":120153},[],"/docs/pr-preview/pr-53/es/platform/pki/crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_3381":70679,"_29612":70671,"_5":29962,"_20544":120155,"_26932":120156,"_2867":120157},[],"/docs/pr-preview/pr-53/es/platform/pki/crl#errores-frecuentes-del-rol-va","Errores frecuentes del rol VA",{"_3381":70680,"_29612":70671,"_5":29962,"_20544":120159,"_26932":120160,"_2867":120161},[],"/docs/pr-preview/pr-53/es/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_3381":70681,"_29612":70671,"_5":29962,"_20544":120163,"_26932":120164,"_2867":120165},[],"/docs/pr-preview/pr-53/es/platform/pki/crl#referencias","Referencias",{"_3381":70682,"_29612":70671,"_20544":120167,"_5":14097,"_26932":70671,"_2867":120168},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su SKI y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3381":70683,"_29612":70671,"_20544":120170,"_5":14097,"_26932":120132,"_2867":120171},[],"El rol VA guarda la configuración y los metadatos de la última lista publicada para el SKI de una CA. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3381":70684,"_29612":70671,"_20544":120173,"_5":14097,"_26932":120132,"_2867":120174},[],"Campo de `crl_options`",{"_3381":70685,"_29612":70671,"_20544":120176,"_5":14097,"_26932":120132,"_2867":116623},[],{"_3381":70686,"_29612":70671,"_20544":120178,"_5":14097,"_26932":120132,"_2867":120179},[],"Valor inicial del backend",{"_3381":70687,"_29612":70671,"_20544":120181,"_5":14097,"_26932":120132,"_2867":54927},[],{"_3381":70688,"_29612":70671,"_20544":120183,"_5":14097,"_26932":120132,"_2867":120184},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3381":70689,"_29612":70671,"_20544":120186,"_5":14097,"_26932":120132,"_2867":120187},[],"7 días.",{"_3381":70690,"_29612":70671,"_20544":120189,"_5":14097,"_26932":120132,"_2867":54936},[],{"_3381":70691,"_29612":70671,"_20544":120191,"_5":14097,"_26932":120132,"_2867":120192},[],"Se guarda y se devuelve por la API, pero la VA no lo utiliza: la renovación programada no depende de él (consulta Regeneración periódica y automática).",{"_3381":70692,"_29612":70671,"_20544":120194,"_5":14097,"_26932":120132,"_2867":120195},[],"6 días y 23 horas.",{"_3381":70693,"_29612":70671,"_20544":120197,"_5":14097,"_26932":120132,"_2867":54945},[],{"_3381":70694,"_29612":70671,"_20544":120199,"_5":14097,"_26932":120132,"_2867":120200},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3381":70695,"_29612":70671,"_20544":120202,"_5":14097,"_26932":120132,"_2867":54951},[],{"_3381":70696,"_29612":70671,"_20544":120204,"_5":14097,"_26932":120132,"_2867":54954},[],{"_3381":70697,"_29612":70671,"_20544":120206,"_5":14097,"_26932":120132,"_2867":120207},[],"Número de serie del certificado existente que firma la CRL.",{"_3381":70698,"_29612":70671,"_20544":120209,"_5":14097,"_26932":120132,"_2867":120210},[],"Número de serie del certificado actual de la CA.",{"_3381":70699,"_29612":70671,"_20544":120212,"_5":14097,"_26932":120132,"_2867":120213},[],"El firmante debe ser un certificado existente con el uso `cRLSign`, el mismo sujeto y la misma clave pública que la CA. Quedan incluidos los certificados anteriores a una reemisión. No se admite un firmante delegado: un certificado con el sujeto de la CA pero con otra clave se rechaza.",{"_3381":70700,"_29612":70671,"_20544":120215,"_5":14097,"_26932":120132,"_2867":120216},[],"Al reemitir una CA, el rol sigue apuntando al certificado anterior. Las CRL siguen siendo válidas porque ambos certificados comparten sujeto y clave, pero el certificado anterior no puede eliminarse mientras el rol lo use. Para retirarlo, actualiza el firmante del rol.",{"_3381":70701,"_29612":70671,"_20544":120218,"_5":14097,"_26932":120132,"_2867":120219},[],"Al eliminar una CA, su rol VA se conserva y no puede borrarse por API. Si no queda ninguna otra CA con el mismo SKI, el rol puede consultarse pero cualquier `PUT` devuelve 404, y el trabajo de renovación registra un aviso en cada ciclo porque ya no encuentra la CA. La API no ofrece salida; solo se corrige editando la base de datos. Si queda otra CA con ese SKI, el rol sigue siendo editable (consulta CAs que comparten clave). Ajusta validez y firmante antes de eliminar la CA.",{"_3381":70702,"_29612":70671,"_20544":120221,"_5":14097,"_26932":120132,"_2867":120222},[],"Una CA cuyo certificado no tiene `cRLSign` no puede generar su CRL ni editar su rol (error 400). Desde 4.0 la VA exige este uso. Comprueba antes de importar con `openssl x509 -noout -ext keyUsage` y, si falta, obtén un certificado de la misma CA y clave que lo incluya y asígnalo como firmante con `PUT`. Tras reemitir una CA, comprueba también el uso de clave del certificado nuevo: puede no conservar los usos del original.",{"_3381":70703,"_29612":70671,"_20544":120224,"_5":14097,"_26932":120132,"_2867":120225},[],"El `PUT` valida siempre el firmante, aunque la petición no lo cambie. Si el firmante guardado ya no es válido, no se puede modificar ningún campo del rol, ni siquiera la validez, hasta asignar uno válido.",{"_3381":70704,"_29612":70671,"_20544":120227,"_5":14097,"_26932":120132,"_2867":120228},[],"Compartir una clave entre CA puede impedir la validación de las CRL. Consulta CAs que comparten clave.",{"_3381":70705,"_29612":70671,"_20544":120230,"_5":14097,"_26932":120132,"_2867":120231},[],"`latest_crl` contiene versión, inicio y fin de validez. Las versiones se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/{subject_key_id}/{version}.crl`; el endpoint público entrega DER.",{"_3381":70706,"_29612":70671,"_20544":120233,"_5":14097,"_26932":120136,"_2867":120234},[],"La VA identifica cada CRL por el SKI de la CA, y el SKI se deriva de su clave. Dos CAs con la misma clave tienen el mismo SKI y comparten un único rol VA y una única CRL. Ocurre al crear una CA sobre una clave ya existente del KMS, o al importar una CA cuyo certificado declara un SKI en uso. Lamassu toma el SKI del certificado importado tal cual y no comprueba que corresponda a su clave pública. El rol lo crea la primera CA y las demás lo conservan.",{"_3381":70707,"_29612":70671,"_20544":120236,"_5":14097,"_26932":120136,"_2867":120237},[],"Los certificados de todas ellas apuntan a `/crl/{ski}`, pero la lista publicada tiene como emisor a la primera CA y solo incluye sus revocaciones. Un verificador compara el emisor de la CRL con el del certificado que valida (RFC 5280, §6.3.2) y rechaza la lista si no coinciden. Según su política, el certificado queda bloqueado (*hard-fail*) o se acepta aunque esté revocado (*soft-fail*). Las revocaciones de las CAs secundarias no aparecen en ninguna lista.",{"_3381":70708,"_29612":70671,"_20544":120239,"_5":14097,"_26932":120136,"_2867":120240},[],"Si la primera CA se elimina, la generación de CRL de la restante falla porque el firmante configurado ya no corresponde a una CA con ese nombre. Hasta que se actualice el firmante del rol a un certificado de la CA restante, se sigue sirviendo la última lista publicada hasta que venza (7 días por defecto).",{"_3381":70709,"_29612":70671,"_20544":120242,"_5":14097,"_26932":120136,"_2867":120243},[],"Antes de actualizar, revisa las CAs que comparten clave. Para detectar el problema, compara el SKI de las CAs en el inventario: dos con el mismo SKI están afectadas. Para resolverlo, crea una CA con clave propia y reemite sus certificados; los ya emitidos conservan la URL antigua y no se corrigen hasta reemitirlos. Una CA importada con un SKI ya en uso no sustituye a la existente como emisora de la CRL, porque el emisor se resuelve a partir del firmante del rol. Sin embargo, sus propios certificados apuntan a esa misma URL y sus revocaciones no se publican. Hasta que Lamassu rechace estas importaciones, limita el permiso de importar CAs como control provisional; cubre solo la vía de importación. Crear una CA con &#x2A;*Create New CA (Existing Key)** sobre una clave KMS que otra CA ya usa produce la misma colisión, así que tampoco reutilices claves entre CAs. Una CRL por CA y el rechazo de importaciones cuyo SKI colisiona con el de una CA existente están planteados en lamassuiot#834, y ninguno está implementado todavía.",{"_3381":70710,"_29612":70671,"_20544":120245,"_5":14097,"_26932":120140,"_2867":120246},[],"El trabajo programado de la VA revisa todos los roles en cada ejecución y solicita otra lista cuando a `latest_crl` le queda menos validez que el intervalo entre ejecuciones. La frecuencia se configura en Helm con `services.va.job.crl.frequency` (por defecto `0 * * * *`) y admite una duración (`1h`) o una expresión cron. Una expresión cron se convierte en un intervalo constante igual al tiempo que falta para su siguiente disparo cuando arranca el servicio, así que no se alinea con el reloj. `refresh_interval` no interviene. Mantén `validity` claramente por encima del intervalo: con una validez menor, la lista se regenera en cada ciclo.",{"_3381":70711,"_29612":70671,"_20544":120248,"_5":14097,"_26932":120140,"_2867":120249},[],"Si la generación falla (por ejemplo, por un rol sin CA o un firmante inválido), el trabajo registra el aviso `something went wrong while calculating CRL for CA <ski>` y lo reintenta en el ciclo siguiente. No hay otra vía de renovación hasta corregir la causa, y la última lista publicada se sigue sirviendo hasta vencer. Todo ello depende de que el trabajo, el almacenamiento y la firma funcionen.",{"_3381":70712,"_29612":70671,"_20544":120251,"_5":14097,"_26932":120140,"_2867":120252},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores: si falla (rol inexistente, firmante inválido), el evento se reintenta y, agotados los reintentos, pasa a la cola de eventos fallidos. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3381":70713,"_29612":70671,"_20544":120254,"_5":14097,"_26932":120140,"_2867":120255},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3381":70714,"_29612":70671,"_20544":120257,"_5":14097,"_26932":120144,"_2867":120258},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3381":70715,"_29612":70671,"_20544":120260,"_5":14097,"_26932":120144,"_2867":120261},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3381":70716,"_29612":70671,"_20544":120263,"_5":14097,"_26932":120148,"_2867":120264},[],"El servicio VA expone `GET /crl/{subject_key_id}` sin autorización de gestión. Usa el SKI de la **CA emisora**, no el SKI del certificado final ni su número de serie. Inspecciona primero el CDP del certificado:",{"_3381":70717,"_29612":70671,"_20544":120266,"_5":14097,"_26932":120148,"_2867":120267},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3381":70718,"_29612":70671,"_20544":120269,"_5":14097,"_26932":120148,"_2867":120270},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Un certificado firmante aceptado tiene el mismo sujeto y la misma clave pública que la CA, por lo que esta comprobación de firma también funciona cuando el rol apunta a un certificado anterior de esa CA y clave. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3381":70719,"_29612":70671,"_20544":120272,"_5":14097,"_26932":120148,"_2867":120273},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3381":70720,"_29612":70671,"_20544":120275,"_5":14097,"_26932":120148,"_2867":120276},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3381":70721,"_29612":70671,"_20544":120278,"_5":14097,"_26932":120152,"_2867":120279},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3381":70722,"_29612":70671,"_20544":120281,"_5":14097,"_26932":120152,"_2867":116812},[],{"_3381":70723,"_29612":70671,"_20544":120283,"_5":14097,"_26932":120152,"_2867":120284},[],"Path relativo",{"_3381":70724,"_29612":70671,"_20544":120286,"_5":14097,"_26932":120152,"_2867":114845},[],{"_3381":70725,"_29612":70671,"_20544":120288,"_5":14097,"_26932":120152,"_2867":55039},[],{"_3381":70726,"_29612":70671,"_20544":120290,"_5":14097,"_26932":120152,"_2867":55042},[],{"_3381":70727,"_29612":70671,"_20544":120292,"_5":14097,"_26932":120152,"_2867":120293},[],"Consultar `crl_options` y `latest_crl`.",{"_3381":70728,"_29612":70671,"_20544":120295,"_5":14097,"_26932":120152,"_2867":55048},[],{"_3381":70729,"_29612":70671,"_20544":120297,"_5":14097,"_26932":120152,"_2867":55042},[],{"_3381":70730,"_29612":70671,"_20544":120299,"_5":14097,"_26932":120152,"_2867":120300},[],"Sustituir la configuración de CRL.",{"_3381":70731,"_29612":70671,"_20544":120302,"_5":14097,"_26932":120152,"_2867":120303},[],"Necesitas autenticación y permisos de lectura o actualización del rol. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato: el backend sustituye `crl_options`; no fusiona campos omitidos.",{"_3381":70732,"_29612":70671,"_20544":120305,"_5":14097,"_26932":120152,"_2867":120306},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar el rol no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3381":70733,"_29612":70671,"_20544":120308,"_5":14097,"_26932":120156,"_2867":120309},[],"Síntoma",{"_3381":70734,"_29612":70671,"_20544":120311,"_5":14097,"_26932":120156,"_2867":120312},[],"Causa",{"_3381":70735,"_29612":70671,"_20544":120314,"_5":14097,"_26932":120156,"_2867":120315},[],"Acción",{"_3381":70736,"_29612":70671,"_20544":120317,"_5":14097,"_26932":120156,"_2867":120318},[],"`PUT /v1/roles/{ca-ski}` devuelve 404 y `GET` devuelve 200.",{"_3381":70737,"_29612":70671,"_20544":120320,"_5":14097,"_26932":120156,"_2867":120321},[],"Se eliminó la CA del rol y no queda otra con el mismo SKI.",{"_3381":70738,"_29612":70671,"_20544":120323,"_5":14097,"_26932":120156,"_2867":120324},[],"No hay salida por API; requiere intervención en la base de datos. Evítalo ajustando el rol antes de eliminar la CA.",{"_3381":70739,"_29612":70671,"_20544":120326,"_5":14097,"_26932":120156,"_2867":120327},[],"`PUT` devuelve 400.",{"_3381":70740,"_29612":70671,"_20544":120329,"_5":14097,"_26932":120156,"_2867":120330},[],"El firmante no tiene `cRLSign`, o su sujeto y su clave no coinciden con ninguna CA de ese SKI (por ejemplo, tras eliminar la primera de dos CAs que comparten clave).",{"_3381":70741,"_29612":70671,"_20544":120332,"_5":14097,"_26932":120156,"_2867":120333},[],"Asigna con `PUT` el número de serie de un certificado válido de la CA restante.",{"_3381":70742,"_29612":70671,"_20544":120335,"_5":14097,"_26932":120156,"_2867":120336},[],"`PUT` devuelve 400 desde un cliente de 3.x.",{"_3381":70743,"_29612":70671,"_20544":120338,"_5":14097,"_26932":120156,"_2867":120339},[],"`crl_options.subject_key_id_signer` se sustituyó por `signer_certificate_serial_number`, que es obligatorio.",{"_3381":70744,"_29612":70671,"_20544":120341,"_5":14097,"_26932":120156,"_2867":120342},[],"Actualiza el cliente para enviar el campo nuevo.",{"_3381":70745,"_29612":70671,"_20544":120344,"_5":14097,"_26932":120156,"_2867":120345},[],"La CRL no cambia tras revocar un certificado.",{"_3381":70746,"_29612":70671,"_20544":120347,"_5":14097,"_26932":120156,"_2867":120348},[],"`regenerate_on_revoke` es `false`, o el evento falló por falta de rol o por un firmante inválido.",{"_3381":70747,"_29612":70671,"_20544":120350,"_5":14097,"_26932":120156,"_2867":120351},[],"Revisa los logs de la VA y la cola de eventos fallidos; corrige el firmante.",{"_3381":70748,"_29612":70671,"_20544":120353,"_5":14097,"_26932":120156,"_2867":120354},[],"Un verificador rechaza la CRL por el emisor.",{"_3381":70749,"_29612":70671,"_20544":120356,"_5":14097,"_26932":120156,"_2867":120357},[],"Varias CAs comparten SKI.",{"_3381":70750,"_29612":70671,"_20544":120359,"_5":14097,"_26932":120156,"_2867":120360},[],"Consulta CAs que comparten clave.",{"_3381":70751,"_29612":70671,"_20544":120362,"_5":14097,"_26932":120160,"_2867":120363},[],"La vista de la CA permite inspeccionar y descargar la lista disponible. Compara versión, emisor y tiempos con la copia descargada desde el endpoint público. Los ajustes VA de la CA también permiten seleccionar el firmante de la CRL: el selector de certificados solo ofrece certificados que tienen clave privada y el uso de clave `CRLSign`. Si el certificado de un firmante configurado no puede resolverse, la interfaz muestra `Unknown Certificate (Serial: X)` o `Certificate details unavailable (Serial: X)`. Para diagnosticar una diferencia, sigue Diagnóstico PKI.",{"_3381":70752,"_29612":70671,"_20544":120365,"_5":14097,"_26932":120164,"_2867":120366},[],"RFC 5280: perfil X.509 y CRL.",{"_3381":70753,"_29612":70671,"_20544":120368,"_5":14097,"_26932":120164,"_2867":55122},[],{"_3381":70754,"_29612":70671,"_20544":120370,"_5":14097,"_26932":120164,"_2867":55125},[],{"_3381":70755,"_29612":70671,"_20544":120372,"_5":14097,"_26932":120164,"_2867":120373},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3381":70756,"_29612":70671,"_20544":120375,"_5":14097,"_26932":120164,"_2867":120376},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3381":70757,"_29612":70757,"_5":14455,"_2867":120378,"_29965":120379,"_20544":120380,"_26932":70757},"Claves y motores criptográficos",[48231,115085,53708,118967],[],{"_3381":70758,"_29612":70757,"_20544":120382,"_5":14097,"_26932":70757,"_2867":120383},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3381":70759,"_29612":70757,"_5":29962,"_20544":120385,"_26932":120386,"_2867":120387},[],"/docs/pr-preview/pr-53/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3381":70760,"_29612":70757,"_5":29962,"_20544":120389,"_26932":120390,"_2867":120391},[],"/docs/pr-preview/pr-53/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3381":70761,"_29612":70757,"_5":29962,"_20544":120393,"_26932":120394,"_2867":55150},[],"/docs/pr-preview/pr-53/es/platform/pki/key-management#file-system",{"_3381":70762,"_29612":70757,"_5":29962,"_20544":120396,"_26932":120397,"_2867":55154},[],"/docs/pr-preview/pr-53/es/platform/pki/key-management#hashicorp-vault",{"_3381":70763,"_29612":70757,"_5":29962,"_20544":120399,"_26932":120400,"_2867":55158},[],"/docs/pr-preview/pr-53/es/platform/pki/key-management#aws-secrets-manager",{"_3381":70764,"_29612":70757,"_5":29962,"_20544":120402,"_26932":120403,"_2867":55162},[],"/docs/pr-preview/pr-53/es/platform/pki/key-management#aws-kms",{"_3381":70765,"_29612":70757,"_5":29962,"_20544":120405,"_26932":120406,"_2867":55166},[],"/docs/pr-preview/pr-53/es/platform/pki/key-management#pkcs11",{"_3381":70766,"_29612":70757,"_5":29962,"_20544":120408,"_26932":120409,"_2867":55170},[],"/docs/pr-preview/pr-53/es/platform/pki/key-management#azure-key-vault",{"_3381":70767,"_29612":70757,"_5":29962,"_20544":120411,"_26932":120412,"_2867":120413},[],"/docs/pr-preview/pr-53/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3381":70768,"_29612":70757,"_5":29962,"_20544":120415,"_26932":120416,"_2867":120417},[],"/docs/pr-preview/pr-53/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3381":70769,"_29612":70757,"_5":29962,"_20544":120419,"_26932":120420,"_2867":120421},[],"/docs/pr-preview/pr-53/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3381":70770,"_29612":70757,"_5":29962,"_20544":120423,"_26932":120424,"_2867":120425},[],"/docs/pr-preview/pr-53/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3381":70771,"_29612":70757,"_5":29962,"_20544":120427,"_26932":120428,"_2867":120429},[],"/docs/pr-preview/pr-53/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3381":70772,"_29612":70757,"_5":29962,"_20544":120431,"_26932":120432,"_2867":120433},[],"/docs/pr-preview/pr-53/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3381":70773,"_29612":70757,"_5":29962,"_20544":120435,"_26932":120436,"_2867":120437},[],"/docs/pr-preview/pr-53/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3381":70774,"_29612":70757,"_5":29962,"_20544":120439,"_26932":120440,"_2867":55202},[],"/docs/pr-preview/pr-53/es/platform/pki/key-management#sign",{"_3381":70775,"_29612":70757,"_5":29962,"_20544":120442,"_26932":120443,"_2867":55206},[],"/docs/pr-preview/pr-53/es/platform/pki/key-management#verify",{"_3381":70776,"_29612":70757,"_5":29962,"_20544":120445,"_26932":120446,"_2867":120447},[],"/docs/pr-preview/pr-53/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3381":70777,"_29612":70757,"_5":29962,"_20544":120449,"_26932":120450,"_2867":120451},[],"/docs/pr-preview/pr-53/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3381":70778,"_29612":70757,"_5":29962,"_20544":120453,"_26932":120454,"_2867":120455},[],"/docs/pr-preview/pr-53/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3381":70779,"_29612":70757,"_20544":120457,"_5":14097,"_26932":70757,"_2867":120458},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3381":70780,"_29612":70757,"_20544":120460,"_5":14097,"_26932":70757,"_2867":120461},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3381":70781,"_29612":70757,"_20544":120463,"_5":14097,"_26932":120386,"_2867":120464},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3381":70782,"_29612":70757,"_20544":120466,"_5":14097,"_26932":120386,"_2867":120467},[],"En la práctica, permite:",{"_3381":70783,"_29612":70757,"_20544":120469,"_5":14097,"_26932":120386,"_2867":120470},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3381":70784,"_29612":70757,"_20544":120472,"_5":14097,"_26932":120386,"_2867":120473},[],"Importar claves creadas externamente.",{"_3381":70785,"_29612":70757,"_20544":120475,"_5":14097,"_26932":120386,"_2867":120476},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3381":70786,"_29612":70757,"_20544":120478,"_5":14097,"_26932":120386,"_2867":120479},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3381":70787,"_29612":70757,"_20544":120481,"_5":14097,"_26932":120390,"_2867":120482},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3381":70788,"_29612":70757,"_20544":120484,"_5":14097,"_26932":120390,"_2867":120485},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3381":70789,"_29612":70757,"_20544":120487,"_5":14097,"_26932":120390,"_2867":120488},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3381":70790,"_29612":70757,"_20544":120490,"_5":14097,"_26932":120394,"_2867":120491},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3381":70791,"_29612":70757,"_20544":120493,"_5":14097,"_26932":120397,"_2867":120494},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3381":70792,"_29612":70757,"_20544":120496,"_5":14097,"_26932":120397,"_2867":120497},[],"El adaptador se comunica con Vault a través de su endpoint HTTP(S) configurado. El certificado del servidor de Vault se verifica contra el almacén de confianza del sistema; para confiar en un Vault con certificado emitido por una CA privada, añade ese certificado de CA al `ca_cert_file` del motor (codificado en PEM). `insecure_skip_verify=true` desactiva la verificación y es un último recurso; acuerda los ajustes de transporte con el responsable de Despliegue.",{"_3381":70793,"_29612":70757,"_20544":120499,"_5":14097,"_26932":120400,"_2867":120500},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3381":70794,"_29612":70757,"_20544":120502,"_5":14097,"_26932":120403,"_2867":120503},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3381":70795,"_29612":70757,"_20544":120505,"_5":14097,"_26932":120406,"_2867":120506},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3381":70796,"_29612":70757,"_20544":120508,"_5":14097,"_26932":120409,"_2867":120509},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3381":70797,"_29612":70757,"_20544":120511,"_5":14097,"_26932":120409,"_2867":120512},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3381":70798,"_29612":70757,"_20544":120514,"_5":14097,"_26932":120409,"_2867":120515},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3381":70799,"_29612":70757,"_20544":120517,"_5":14097,"_26932":120409,"_2867":120518},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3381":70800,"_29612":70757,"_20544":120520,"_5":14097,"_26932":120412,"_2867":120521},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3381":70801,"_29612":70757,"_20544":120523,"_5":14097,"_26932":120412,"_2867":120524},[],"La tabla incluye los siguientes campos:",{"_3381":70802,"_29612":70757,"_20544":120526,"_5":14097,"_26932":120412,"_2867":120527},[],"**Name**: nombre descriptivo de la clave.",{"_3381":70803,"_29612":70757,"_20544":120529,"_5":14097,"_26932":120412,"_2867":120530},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3381":70804,"_29612":70757,"_20544":120532,"_5":14097,"_26932":120412,"_2867":120533},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3381":70805,"_29612":70757,"_20544":120535,"_5":14097,"_26932":120412,"_2867":120536},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3381":70806,"_29612":70757,"_20544":120538,"_5":14097,"_26932":120412,"_2867":120539},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3381":70807,"_29612":70757,"_20544":120541,"_5":14097,"_26932":120412,"_2867":120542},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3381":70808,"_29612":70757,"_20544":120544,"_5":14097,"_26932":120412,"_2867":120545},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3381":70809,"_29612":70757,"_20544":120547,"_5":14097,"_26932":120412,"_2867":120548},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3381":70810,"_29612":70757,"_20544":120550,"_5":14097,"_26932":120412,"_2867":120551},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3381":70811,"_29612":70757,"_20544":120553,"_5":14097,"_26932":120412,"_2867":120554},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3381":70812,"_29612":70757,"_20544":120556,"_5":14097,"_26932":120412,"_2867":120557},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3381":70813,"_29612":70757,"_20544":120559,"_5":14097,"_26932":120412,"_2867":120560},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3381":70814,"_29612":70757,"_20544":120562,"_5":14097,"_26932":120412,"_2867":120563},[],"**Delete Key** para eliminar la clave del sistema.",{"_3381":70815,"_29612":70757,"_20544":120565,"_5":14097,"_26932":120416,"_2867":120566},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3381":70816,"_29612":70757,"_20544":120568,"_5":14097,"_26932":120420,"_2867":120569},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3381":70817,"_29612":70757,"_20544":120571,"_5":14097,"_26932":120420,"_2867":120572},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3381":70818,"_29612":70757,"_20544":120574,"_5":14097,"_26932":120420,"_2867":120575},[],"**Key Name**: nombre único y descriptivo.",{"_3381":70819,"_29612":70757,"_20544":120577,"_5":14097,"_26932":120420,"_2867":120578},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3381":70820,"_29612":70757,"_20544":120580,"_5":14097,"_26932":120420,"_2867":120581},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3381":70821,"_29612":70757,"_20544":120583,"_5":14097,"_26932":120420,"_2867":120584},[],"**Tags**: metadatos para clasificar la clave.",{"_3381":70822,"_29612":70757,"_20544":120586,"_5":14097,"_26932":120420,"_2867":120587},[],"**Metadata**: información adicional para usos avanzados.",{"_3381":70823,"_29612":70757,"_20544":120589,"_5":14097,"_26932":120424,"_2867":120590},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3381":70824,"_29612":70757,"_20544":120592,"_5":14097,"_26932":120424,"_2867":120593},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3381":70825,"_29612":70757,"_20544":120595,"_5":14097,"_26932":120424,"_2867":120596},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3381":70826,"_29612":70757,"_20544":120598,"_5":14097,"_26932":120424,"_2867":120599},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3381":70827,"_29612":70757,"_20544":120601,"_5":14097,"_26932":120424,"_2867":120602},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3381":70828,"_29612":70757,"_20544":120604,"_5":14097,"_26932":120424,"_2867":120605},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3381":70829,"_29612":70757,"_20544":120607,"_5":14097,"_26932":120424,"_2867":120608},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3381":70830,"_29612":70757,"_20544":120610,"_5":14097,"_26932":120424,"_2867":120611},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3381":70831,"_29612":70757,"_20544":120613,"_5":14097,"_26932":120424,"_2867":120614},[],"**Metadata**: información adicional opcional.",{"_3381":70832,"_29612":70757,"_20544":120616,"_5":14097,"_26932":120424,"_2867":120617},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3381":70833,"_29612":70757,"_20544":120619,"_5":14097,"_26932":120424,"_2867":120620},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3381":70834,"_29612":70757,"_20544":120622,"_5":14097,"_26932":120428,"_2867":120623},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3381":70835,"_29612":70757,"_20544":120625,"_5":14097,"_26932":120432,"_2867":120626},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3381":70836,"_29612":70757,"_20544":120628,"_5":14097,"_26932":120432,"_2867":120629},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3381":70837,"_29612":70757,"_20544":120631,"_5":14097,"_26932":120432,"_2867":120632},[],"**Key Name**: nombre descriptivo.",{"_3381":70838,"_29612":70757,"_20544":120634,"_5":14097,"_26932":120432,"_2867":120635},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3381":70839,"_29612":70757,"_20544":120637,"_5":14097,"_26932":120432,"_2867":120638},[],"**Tags**: etiquetas asociadas.",{"_3381":70840,"_29612":70757,"_20544":120640,"_5":14097,"_26932":120432,"_2867":120641},[],"**Aliases**: nombres alternativos.",{"_3381":70841,"_29612":70757,"_20544":120643,"_5":14097,"_26932":120432,"_2867":120644},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3381":70842,"_29612":70757,"_20544":120646,"_5":14097,"_26932":120432,"_2867":120647},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3381":70843,"_29612":70757,"_20544":120649,"_5":14097,"_26932":120432,"_2867":120650},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3381":70844,"_29612":70757,"_20544":120652,"_5":14097,"_26932":120432,"_2867":120653},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3381":70845,"_29612":70757,"_20544":120655,"_5":14097,"_26932":120436,"_2867":120656},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3381":70846,"_29612":70757,"_20544":120658,"_5":14097,"_26932":120436,"_2867":120659},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3381":70847,"_29612":70757,"_20544":120661,"_5":14097,"_26932":120436,"_2867":120662},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3381":70848,"_29612":70757,"_20544":120664,"_5":14097,"_26932":120440,"_2867":120665},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3381":70849,"_29612":70757,"_20544":120667,"_5":14097,"_26932":120440,"_2867":120668},[],"Campos principales:",{"_3381":70850,"_29612":70757,"_20544":120670,"_5":14097,"_26932":120440,"_2867":120671},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3381":70851,"_29612":70757,"_20544":120673,"_5":14097,"_26932":120440,"_2867":120674},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3381":70852,"_29612":70757,"_20544":120676,"_5":14097,"_26932":120440,"_2867":120677},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3381":70853,"_29612":70757,"_20544":120679,"_5":14097,"_26932":120440,"_2867":120680},[],"**Message**: contenido que se va a firmar.",{"_3381":70854,"_29612":70757,"_20544":120682,"_5":14097,"_26932":120440,"_2867":120683},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3381":70855,"_29612":70757,"_20544":120685,"_5":14097,"_26932":120443,"_2867":120686},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3381":70856,"_29612":70757,"_20544":120688,"_5":14097,"_26932":120443,"_2867":120668},[],{"_3381":70857,"_29612":70757,"_20544":120690,"_5":14097,"_26932":120443,"_2867":120691},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3381":70858,"_29612":70757,"_20544":120693,"_5":14097,"_26932":120443,"_2867":120694},[],"**Message Type**: `Raw` o `Digest`.",{"_3381":70859,"_29612":70757,"_20544":120696,"_5":14097,"_26932":120443,"_2867":120697},[],"**Payload Encoding**: codificación del mensaje.",{"_3381":70860,"_29612":70757,"_20544":120699,"_5":14097,"_26932":120443,"_2867":120700},[],"**Message**: mensaje original o hash.",{"_3381":70861,"_29612":70757,"_20544":120702,"_5":14097,"_26932":120443,"_2867":120703},[],"**Signature**: firma que se desea comprobar.",{"_3381":70862,"_29612":70757,"_20544":120705,"_5":14097,"_26932":120443,"_2867":120706},[],"**Result**: indicador del resultado de la validación.",{"_3381":70863,"_29612":70757,"_20544":120708,"_5":14097,"_26932":120446,"_2867":120709},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3381":70864,"_29612":70757,"_20544":120711,"_5":14097,"_26932":120446,"_2867":120712},[],"Este flujo es útil para:",{"_3381":70865,"_29612":70757,"_20544":120714,"_5":14097,"_26932":120446,"_2867":120715},[],"Solicitar certificados a una CA externa.",{"_3381":70866,"_29612":70757,"_20544":120717,"_5":14097,"_26932":120446,"_2867":120718},[],"Renovar una identidad manteniendo la misma clave.",{"_3381":70867,"_29612":70757,"_20544":120720,"_5":14097,"_26932":120446,"_2867":120721},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3381":70868,"_29612":70757,"_20544":120723,"_5":14097,"_26932":120446,"_2867":120724},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3381":70869,"_29612":70757,"_20544":120726,"_5":14097,"_26932":120446,"_2867":120727},[],"**Organization (O)**: organización o empresa.",{"_3381":70870,"_29612":70757,"_20544":120729,"_5":14097,"_26932":120446,"_2867":120730},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3381":70871,"_29612":70757,"_20544":120732,"_5":14097,"_26932":120446,"_2867":120733},[],"**Country (C)**: código de país de dos letras.",{"_3381":70872,"_29612":70757,"_20544":120735,"_5":14097,"_26932":120446,"_2867":120736},[],"**State / Province (ST)**: estado o provincia.",{"_3381":70873,"_29612":70757,"_20544":120738,"_5":14097,"_26932":120446,"_2867":120739},[],"**Locality (L)**: ciudad o localidad.",{"_3381":70874,"_29612":70757,"_20544":120741,"_5":14097,"_26932":120446,"_2867":120742},[],"**Email Address**: correo de contacto.",{"_3381":70875,"_29612":70757,"_20544":120744,"_5":14097,"_26932":120446,"_2867":120745},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3381":70876,"_29612":70757,"_20544":120747,"_5":14097,"_26932":120446,"_2867":120748},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3381":70877,"_29612":70757,"_20544":120750,"_5":14097,"_26932":120450,"_2867":120751},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3381":70878,"_29612":70757,"_20544":120753,"_5":14097,"_26932":120450,"_2867":120754},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3381":70879,"_29612":70757,"_20544":120756,"_5":14097,"_26932":120454,"_2867":120757},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3381":70880,"_29612":70757,"_20544":120759,"_5":14097,"_26932":120454,"_2867":120760},[],"El KMS se niega a eliminar una clave que todavía está referenciada por certificados. Eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados, y después intenta eliminar la clave. Si otros certificados todavía la referencian, como los de otra CA que la comparte, el KMS la conserva. Revocar los certificados emitidos por la CA eliminada no libera sus propias referencias a claves. La guía de actualización describe las referencias heredadas que conserva la migración.",{"_3381":70881,"_29612":70881,"_5":14455,"_2867":120762,"_29965":120763,"_20544":120764,"_26932":70881},"Validación online con OCSP",[48231,115085,53708,119598],[],{"_3381":70882,"_29612":70881,"_20544":120766,"_5":14097,"_26932":70881,"_2867":120767},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3381":70883,"_29612":70881,"_5":29962,"_20544":120769,"_26932":120770,"_2867":120771},[],"/docs/pr-preview/pr-53/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3381":70884,"_29612":70881,"_5":29962,"_20544":120773,"_26932":120774,"_2867":120775},[],"/docs/pr-preview/pr-53/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3381":70885,"_29612":70881,"_5":29962,"_20544":120777,"_26932":120778,"_2867":120779},[],"/docs/pr-preview/pr-53/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3381":70886,"_29612":70881,"_5":29962,"_20544":120781,"_26932":120782,"_2867":120783},[],"/docs/pr-preview/pr-53/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3381":70887,"_29612":70881,"_5":29962,"_20544":120785,"_26932":120786,"_2867":120787},[],"/docs/pr-preview/pr-53/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3381":70888,"_29612":70881,"_5":29962,"_20544":120789,"_26932":120790,"_2867":120165},[],"/docs/pr-preview/pr-53/es/platform/pki/ocsp#referencias",{"_3381":70889,"_29612":70881,"_20544":120792,"_5":14097,"_26932":70881,"_2867":120793},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3381":70890,"_29612":70881,"_20544":120795,"_5":14097,"_26932":120770,"_2867":120796},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3381":70891,"_29612":70881,"_20544":120798,"_5":14097,"_26932":120770,"_2867":120799},[],"Estado del registro",{"_3381":70892,"_29612":70881,"_20544":120801,"_5":14097,"_26932":120770,"_2867":120802},[],"Respuesta firmada",{"_3381":70893,"_29612":70881,"_20544":120804,"_5":14097,"_26932":120770,"_2867":52879},[],{"_3381":70894,"_29612":70881,"_20544":120806,"_5":14097,"_26932":120770,"_2867":55570},[],{"_3381":70895,"_29612":70881,"_20544":120808,"_5":14097,"_26932":120770,"_2867":52896},[],{"_3381":70896,"_29612":70881,"_20544":120810,"_5":14097,"_26932":120770,"_2867":120811},[],"`Revoked`, con razón y fecha de revocación.",{"_3381":70897,"_29612":70881,"_20544":120813,"_5":14097,"_26932":120770,"_2867":120814},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3381":70898,"_29612":70881,"_20544":120816,"_5":14097,"_26932":120770,"_2867":120817},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3381":70899,"_29612":70881,"_20544":120819,"_5":14097,"_26932":120770,"_2867":120820},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3381":70900,"_29612":70881,"_20544":120822,"_5":14097,"_26932":120770,"_2867":120823},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3381":70901,"_29612":70881,"_20544":120825,"_5":14097,"_26932":120770,"_2867":120826},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3381":70902,"_29612":70881,"_20544":120828,"_5":14097,"_26932":120774,"_2867":120829},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3381":70903,"_29612":70881,"_20544":120831,"_5":14097,"_26932":120774,"_2867":120832},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3381":70904,"_29612":70881,"_20544":120834,"_5":14097,"_26932":120778,"_2867":120835},[],"El servicio acepta:",{"_3381":70905,"_29612":70881,"_20544":120837,"_5":14097,"_26932":120778,"_2867":116812},[],{"_3381":70906,"_29612":70881,"_20544":120839,"_5":14097,"_26932":120778,"_2867":120840},[],"Ruta del servicio VA",{"_3381":70907,"_29612":70881,"_20544":120842,"_5":14097,"_26932":120778,"_2867":120843},[],"Formato",{"_3381":70908,"_29612":70881,"_20544":120845,"_5":14097,"_26932":120778,"_2867":55610},[],{"_3381":70909,"_29612":70881,"_20544":120847,"_5":14097,"_26932":120778,"_2867":55613},[],{"_3381":70910,"_29612":70881,"_20544":120849,"_5":14097,"_26932":120778,"_2867":120850},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3381":70911,"_29612":70881,"_20544":120852,"_5":14097,"_26932":120778,"_2867":55039},[],{"_3381":70912,"_29612":70881,"_20544":120854,"_5":14097,"_26932":120778,"_2867":55621},[],{"_3381":70913,"_29612":70881,"_20544":120856,"_5":14097,"_26932":120778,"_2867":120857},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3381":70914,"_29612":70881,"_20544":120859,"_5":14097,"_26932":120778,"_2867":120860},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3381":70915,"_29612":70881,"_20544":120862,"_5":14097,"_26932":120782,"_2867":120863},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3381":70916,"_29612":70881,"_20544":120865,"_5":14097,"_26932":120782,"_2867":120866},[],"Genera la solicitud:",{"_3381":70917,"_29612":70881,"_20544":120868,"_5":14097,"_26932":120782,"_2867":120869},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3381":70918,"_29612":70881,"_20544":120871,"_5":14097,"_26932":120782,"_2867":120872},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3381":70919,"_29612":70881,"_20544":120874,"_5":14097,"_26932":120782,"_2867":120875},[],"Verifica el DER recibido:",{"_3381":70920,"_29612":70881,"_20544":120877,"_5":14097,"_26932":120782,"_2867":120878},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3381":70921,"_29612":70881,"_20544":120880,"_5":14097,"_26932":120786,"_2867":120881},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3381":70922,"_29612":70881,"_20544":120883,"_5":14097,"_26932":120786,"_2867":120884},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3381":70923,"_29612":70881,"_20544":120886,"_5":14097,"_26932":120790,"_2867":55654},[],{"_3381":70924,"_29612":70881,"_20544":120888,"_5":14097,"_26932":120790,"_2867":55657},[],{"_3381":70925,"_29612":70881,"_20544":120890,"_5":14097,"_26932":120790,"_2867":120891},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3381":70926,"_29612":70881,"_20544":120893,"_5":14097,"_26932":120790,"_2867":120376},[],{"_3381":70927,"_29612":70927,"_5":14455,"_2867":53708,"_29965":120895,"_20544":120896,"_26932":70927},[48231,115085,53708],[],{"_3381":70928,"_29612":70927,"_20544":120898,"_5":14097,"_26932":70927,"_2867":120899},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3381":70929,"_29612":70927,"_5":29962,"_20544":120901,"_26932":120902,"_2867":118293},[],"/docs/pr-preview/pr-53/es/platform/pki/overview#empieza-aquí",{"_3381":70930,"_29612":70927,"_5":29962,"_20544":120904,"_26932":120905,"_2867":120906},[],"/docs/pr-preview/pr-53/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3381":70931,"_29612":70927,"_5":29962,"_20544":120908,"_26932":120909,"_2867":118813},[],"/docs/pr-preview/pr-53/es/platform/pki/overview#capacidades-principales",{"_3381":70932,"_29612":70927,"_5":29962,"_20544":120911,"_26932":120912,"_2867":118817},[],"/docs/pr-preview/pr-53/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3381":70933,"_29612":70927,"_5":29962,"_20544":120914,"_26932":120915,"_2867":118821},[],"/docs/pr-preview/pr-53/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3381":70934,"_29612":70927,"_5":29962,"_20544":120917,"_26932":120918,"_2867":118825},[],"/docs/pr-preview/pr-53/es/platform/pki/overview#emite-y-controla-certificados",{"_3381":70935,"_29612":70927,"_5":29962,"_20544":120920,"_26932":120921,"_2867":118833},[],"/docs/pr-preview/pr-53/es/platform/pki/overview#publica-el-estado-de-validación",{"_3381":70936,"_29612":70927,"_5":29962,"_20544":120923,"_26932":120924,"_2867":120925},[],"/docs/pr-preview/pr-53/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3381":70937,"_29612":70927,"_5":29962,"_20544":120927,"_26932":120928,"_2867":119764},[],"/docs/pr-preview/pr-53/es/platform/pki/overview#continúa",{"_3381":70938,"_29612":70927,"_20544":120930,"_5":14097,"_26932":70927,"_2867":120931},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3381":70939,"_29612":70927,"_20544":120933,"_5":14097,"_26932":120902,"_2867":120934},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3381":70940,"_29612":70927,"_20544":120936,"_5":14097,"_26932":120902,"_2867":120937},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3381":70941,"_29612":70927,"_20544":120939,"_5":14097,"_26932":120905,"_2867":120940},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3381":70942,"_29612":70927,"_20544":120942,"_5":14097,"_26932":120905,"_2867":120943},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3381":70943,"_29612":70927,"_20544":120945,"_5":14097,"_26932":120905,"_2867":120946},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3381":70944,"_29612":70927,"_20544":120948,"_5":14097,"_26932":120905,"_2867":120949},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3381":70945,"_29612":70927,"_20544":120951,"_5":14097,"_26932":120905,"_2867":120952},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3381":70946,"_29612":70927,"_20544":120954,"_5":14097,"_26932":120912,"_2867":120955},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3381":70947,"_29612":70927,"_20544":120957,"_5":14097,"_26932":120915,"_2867":120958},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3381":70948,"_29612":70927,"_20544":120960,"_5":14097,"_26932":120918,"_2867":120961},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3381":70949,"_29612":70927,"_20544":120963,"_5":14097,"_26932":120921,"_2867":120964},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3381":70950,"_29612":70927,"_20544":120966,"_5":14097,"_26932":120924,"_2867":120967},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3381":70951,"_29612":70927,"_20544":120969,"_5":14097,"_26932":120924,"_2867":120970},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3381":70952,"_29612":70927,"_20544":120972,"_5":14097,"_26932":120924,"_2867":120973},[],"su clave pública corresponda a la clave privada del cliente;",{"_3381":70953,"_29612":70927,"_20544":120975,"_5":14097,"_26932":120924,"_2867":120976},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3381":70954,"_29612":70927,"_20544":120978,"_5":14097,"_26932":120924,"_2867":120979},[],"sus fechas y usos permitan la operación;",{"_3381":70955,"_29612":70927,"_20544":120981,"_5":14097,"_26932":120924,"_2867":120982},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3381":70956,"_29612":70927,"_20544":120984,"_5":14097,"_26932":120924,"_2867":120985},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3381":70957,"_29612":70927,"_20544":120987,"_5":14097,"_26932":120928,"_2867":120988},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3381":70958,"_29612":70927,"_20544":120990,"_5":14097,"_26932":120928,"_2867":120991},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3381":70959,"_29612":70927,"_20544":120993,"_5":14097,"_26932":120928,"_2867":120994},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3381":70960,"_29612":70960,"_5":14455,"_2867":120996,"_29965":120997,"_20544":120998,"_26932":70960},"Crea tu primera CA",[48231,115085,53708,118417],[],{"_3381":70961,"_29612":70960,"_20544":121000,"_5":14097,"_26932":70960,"_2867":121001},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3381":70962,"_29612":70960,"_5":29962,"_20544":121003,"_26932":121004,"_2867":113663},[],"/docs/pr-preview/pr-53/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3381":70963,"_29612":70960,"_5":29962,"_20544":121006,"_26932":121007,"_2867":121008},[],"/docs/pr-preview/pr-53/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación-toc","Abre el asistente de creación [!toc]",{"_3381":70964,"_29612":70960,"_5":29962,"_20544":121010,"_26932":121011,"_2867":121012},[],"/docs/pr-preview/pr-53/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave-toc","Selecciona la clave [!toc]",{"_3381":70965,"_29612":70960,"_5":29962,"_20544":121014,"_26932":121015,"_2867":121016},[],"/docs/pr-preview/pr-53/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad-toc","Define la autoridad [!toc]",{"_3381":70966,"_29612":70960,"_5":29962,"_20544":121018,"_26932":121019,"_2867":121020},[],"/docs/pr-preview/pr-53/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca-toc","Revisa y crea la CA [!toc]",{"_3381":70967,"_29612":70960,"_5":29962,"_20544":121022,"_26932":121023,"_2867":121024},[],"/docs/pr-preview/pr-53/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado-toc","Verifica el resultado [!toc]",{"_3381":70968,"_29612":70960,"_5":29962,"_20544":121026,"_26932":121027,"_2867":121028},[],"/docs/pr-preview/pr-53/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3381":70969,"_29612":70960,"_5":29962,"_20544":121030,"_26932":121031,"_2867":118664},[],"/docs/pr-preview/pr-53/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3381":70970,"_29612":70960,"_5":29962,"_20544":121033,"_26932":121034,"_2867":113687},[],"/docs/pr-preview/pr-53/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3381":70971,"_29612":70960,"_20544":121036,"_5":14097,"_26932":70960,"_2867":121037},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3381":70972,"_29612":70960,"_20544":121039,"_5":14097,"_26932":121004,"_2867":121040},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3381":70973,"_29612":70960,"_20544":121042,"_5":14097,"_26932":121004,"_2867":121043},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3381":70974,"_29612":70960,"_20544":121045,"_5":14097,"_26932":121004,"_2867":121046},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3381":70975,"_29612":70960,"_20544":121048,"_5":14097,"_26932":121004,"_2867":121049},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3381":70976,"_29612":70960,"_20544":121051,"_5":14097,"_26932":121007,"_2867":121052},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_3381":70977,"_29612":70960,"_20544":121054,"_5":14097,"_26932":121007,"_2867":121055},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_3381":70978,"_29612":70960,"_20544":121057,"_5":14097,"_26932":121011,"_2867":121058},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_3381":70979,"_29612":70960,"_20544":121060,"_5":14097,"_26932":121011,"_2867":121061},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_3381":70980,"_29612":70960,"_20544":121063,"_5":14097,"_26932":121015,"_2867":121064},[],"Selecciona **Root CA** y completa:",{"_3381":70981,"_29612":70960,"_20544":121066,"_5":14097,"_26932":121015,"_2867":55836},[],{"_3381":70982,"_29612":70960,"_20544":121068,"_5":14097,"_26932":121015,"_2867":121069},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_3381":70983,"_29612":70960,"_20544":121071,"_5":14097,"_26932":121015,"_2867":121072},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_3381":70984,"_29612":70960,"_20544":121074,"_5":14097,"_26932":121015,"_2867":121075},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_3381":70985,"_29612":70960,"_20544":121077,"_5":14097,"_26932":121015,"_2867":121078},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_3381":70986,"_29612":70960,"_20544":121080,"_5":14097,"_26932":121019,"_2867":121081},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_3381":70987,"_29612":70960,"_20544":121083,"_5":14097,"_26932":121023,"_2867":121084},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_3381":70988,"_29612":70960,"_20544":121086,"_5":14097,"_26932":121023,"_2867":121087},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_3381":70989,"_29612":70960,"_20544":121089,"_5":14097,"_26932":121027,"_2867":121090},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3381":70990,"_29612":70960,"_20544":121092,"_5":14097,"_26932":121027,"_2867":121093},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3381":70991,"_29612":70960,"_20544":121095,"_5":14097,"_26932":121027,"_2867":121096},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3381":70992,"_29612":70960,"_20544":121098,"_5":14097,"_26932":121031,"_2867":121099},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3381":70993,"_29612":70960,"_20544":121101,"_5":14097,"_26932":121031,"_2867":121102},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3381":70994,"_29612":70960,"_20544":121104,"_5":14097,"_26932":121031,"_2867":121105},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3381":70995,"_29612":70960,"_20544":121107,"_5":14097,"_26932":121031,"_2867":121108},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3381":70996,"_29612":70960,"_20544":121110,"_5":14097,"_26932":121034,"_2867":121111},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3381":70997,"_29612":70997,"_5":14455,"_2867":121113,"_29965":121114,"_20544":121115,"_26932":70997},"Emite y verifica un certificado",[48231,115085,53708,118417],[],{"_3381":70998,"_29612":70997,"_20544":121117,"_5":14097,"_26932":70997,"_2867":121118},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3381":70999,"_29612":70997,"_5":29962,"_20544":121120,"_26932":121121,"_2867":113663},[],"/docs/pr-preview/pr-53/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3381":71000,"_29612":70997,"_5":29962,"_20544":121123,"_26932":121124,"_2867":121125},[],"/docs/pr-preview/pr-53/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3381":71001,"_29612":70997,"_5":29962,"_20544":121127,"_26932":121128,"_2867":121129},[],"/docs/pr-preview/pr-53/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3381":71002,"_29612":70997,"_5":29962,"_20544":121131,"_26932":121132,"_2867":121133},[],"/docs/pr-preview/pr-53/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3381":71003,"_29612":70997,"_5":29962,"_20544":121135,"_26932":121136,"_2867":121137},[],"/docs/pr-preview/pr-53/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3381":71004,"_29612":70997,"_5":29962,"_20544":121139,"_26932":121140,"_2867":121141},[],"/docs/pr-preview/pr-53/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3381":71005,"_29612":70997,"_5":29962,"_20544":121143,"_26932":121144,"_2867":121145},[],"/docs/pr-preview/pr-53/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado","Verifica el resultado",{"_3381":71006,"_29612":70997,"_5":29962,"_20544":121147,"_26932":121148,"_2867":121149},[],"/docs/pr-preview/pr-53/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3381":71007,"_29612":70997,"_5":29962,"_20544":121151,"_26932":121152,"_2867":121153},[],"/docs/pr-preview/pr-53/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3381":71008,"_29612":70997,"_5":29962,"_20544":121155,"_26932":121156,"_2867":121157},[],"/docs/pr-preview/pr-53/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3381":71009,"_29612":70997,"_5":29962,"_20544":121159,"_26932":121160,"_2867":118664},[],"/docs/pr-preview/pr-53/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3381":71010,"_29612":70997,"_5":29962,"_20544":121162,"_26932":121163,"_2867":113687},[],"/docs/pr-preview/pr-53/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3381":71011,"_29612":70997,"_20544":121165,"_5":14097,"_26932":70997,"_2867":121166},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3381":71012,"_29612":70997,"_20544":121168,"_5":14097,"_26932":121121,"_2867":121169},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3381":71013,"_29612":70997,"_20544":121171,"_5":14097,"_26932":121121,"_2867":121172},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3381":71014,"_29612":70997,"_20544":121174,"_5":14097,"_26932":121121,"_2867":121175},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3381":71015,"_29612":70997,"_20544":121177,"_5":14097,"_26932":121121,"_2867":121178},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3381":71016,"_29612":70997,"_20544":121180,"_5":14097,"_26932":121121,"_2867":121181},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3381":71017,"_29612":70997,"_20544":121183,"_5":14097,"_26932":121124,"_2867":121184},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3381":71018,"_29612":70997,"_20544":121186,"_5":14097,"_26932":121128,"_2867":121187},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3381":71019,"_29612":70997,"_20544":121189,"_5":14097,"_26932":121128,"_2867":121190},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3381":71020,"_29612":70997,"_20544":121192,"_5":14097,"_26932":121132,"_2867":121193},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3381":71021,"_29612":70997,"_20544":121195,"_5":14097,"_26932":121132,"_2867":121196},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3381":71022,"_29612":70997,"_20544":121198,"_5":14097,"_26932":121136,"_2867":121199},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3381":71023,"_29612":70997,"_20544":121201,"_5":14097,"_26932":121136,"_2867":121202},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3381":71024,"_29612":70997,"_20544":121204,"_5":14097,"_26932":121140,"_2867":121205},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3381":71025,"_29612":70997,"_20544":121207,"_5":14097,"_26932":121144,"_2867":121208},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3381":71026,"_29612":70997,"_20544":121210,"_5":14097,"_26932":121148,"_2867":121211},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3381":71027,"_29612":70997,"_20544":121213,"_5":14097,"_26932":121152,"_2867":121214},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3381":71028,"_29612":70997,"_20544":121216,"_5":14097,"_26932":121152,"_2867":121217},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3381":71029,"_29612":70997,"_20544":121219,"_5":14097,"_26932":121152,"_2867":121220},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3381":71030,"_29612":70997,"_20544":121222,"_5":14097,"_26932":121156,"_2867":121223},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3381":71031,"_29612":70997,"_20544":121225,"_5":14097,"_26932":121156,"_2867":121226},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3381":71032,"_29612":70997,"_20544":121228,"_5":14097,"_26932":121156,"_2867":121229},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3381":71033,"_29612":70997,"_20544":121231,"_5":14097,"_26932":121160,"_2867":118747},[],{"_3381":71034,"_29612":70997,"_20544":121233,"_5":14097,"_26932":121160,"_2867":117261},[],{"_3381":71035,"_29612":70997,"_20544":121235,"_5":14097,"_26932":121160,"_2867":121236},[],"La CA rechaza la emisión",{"_3381":71036,"_29612":70997,"_20544":121238,"_5":14097,"_26932":121160,"_2867":121239},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3381":71037,"_29612":70997,"_20544":121241,"_5":14097,"_26932":121160,"_2867":121242},[],"Sujeto o usos diferentes",{"_3381":71038,"_29612":70997,"_20544":121244,"_5":14097,"_26932":121160,"_2867":121245},[],"Perfil aplicado y valores solicitados.",{"_3381":71039,"_29612":70997,"_20544":121247,"_5":14097,"_26932":121160,"_2867":121248},[],"No se encuentra el emisor",{"_3381":71040,"_29612":70997,"_20544":121250,"_5":14097,"_26932":121160,"_2867":121251},[],"CA descargada y cadena intermedia necesaria.",{"_3381":71041,"_29612":70997,"_20544":121253,"_5":14097,"_26932":121160,"_2867":121254},[],"Falla la vigencia",{"_3381":71042,"_29612":70997,"_20544":121256,"_5":14097,"_26932":121160,"_2867":121257},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3381":71043,"_29612":70997,"_20544":121259,"_5":14097,"_26932":121160,"_2867":121260},[],"Los resúmenes de clave difieren",{"_3381":71044,"_29612":70997,"_20544":121262,"_5":14097,"_26932":121160,"_2867":121263},[],"Archivos de certificado y clave de la misma emisión.",{"_3381":71045,"_29612":70997,"_20544":121265,"_5":14097,"_26932":121160,"_2867":121266},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3381":71046,"_29612":70997,"_20544":121268,"_5":14097,"_26932":121163,"_2867":121269},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3381":71047,"_29612":70997,"_20544":121271,"_5":14097,"_26932":121163,"_2867":121272},[],"Gestionar certificados para inspección, estado y revocación.",{"_3381":71048,"_29612":70997,"_20544":121274,"_5":14097,"_26932":121163,"_2867":121275},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3381":71049,"_29612":70997,"_20544":121277,"_5":14097,"_26932":121163,"_2867":121278},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3381":71050,"_29612":70997,"_20544":121280,"_5":14097,"_26932":121163,"_2867":121281},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3381":71051,"_29612":71051,"_5":14455,"_2867":121283,"_29965":121284,"_20544":121285,"_26932":71051},"Primeros pasos de PKI",[48231,115085,53708,118417],[],{"_3381":71052,"_29612":71051,"_20544":121287,"_5":14097,"_26932":71051,"_2867":121288},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3381":71053,"_29612":71051,"_5":29962,"_20544":121290,"_26932":121291,"_2867":113663},[],"/docs/pr-preview/pr-53/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3381":71054,"_29612":71051,"_5":29962,"_20544":121293,"_26932":121294,"_2867":121295},[],"/docs/pr-preview/pr-53/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3381":71055,"_29612":71051,"_5":29962,"_20544":121297,"_26932":121298,"_2867":118599},[],"/docs/pr-preview/pr-53/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3381":71056,"_29612":71051,"_5":29962,"_20544":121300,"_26932":121301,"_2867":121302},[],"/docs/pr-preview/pr-53/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3381":71057,"_29612":71051,"_20544":121304,"_5":14097,"_26932":71051,"_2867":121305},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3381":71058,"_29612":71051,"_20544":121307,"_5":14097,"_26932":121291,"_2867":121308},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3381":71059,"_29612":71051,"_20544":121310,"_5":14097,"_26932":121291,"_2867":121311},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3381":71060,"_29612":71051,"_20544":121313,"_5":14097,"_26932":121291,"_2867":121314},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3381":71061,"_29612":71051,"_20544":121316,"_5":14097,"_26932":121291,"_2867":121317},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3381":71062,"_29612":71051,"_20544":121319,"_5":14097,"_26932":121291,"_2867":121320},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3381":71063,"_29612":71051,"_20544":121322,"_5":14097,"_26932":121294,"_2867":121323},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3381":71064,"_29612":71051,"_20544":121325,"_5":14097,"_26932":121294,"_2867":121326},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3381":71065,"_29612":71051,"_20544":121328,"_5":14097,"_26932":121294,"_2867":121329},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3381":71066,"_29612":71051,"_20544":121331,"_5":14097,"_26932":121294,"_2867":121332},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3381":71067,"_29612":71051,"_20544":121334,"_5":14097,"_26932":121298,"_2867":121335},[],"Archivo o recurso",{"_3381":71068,"_29612":71051,"_20544":121337,"_5":14097,"_26932":121298,"_2867":118596},[],{"_3381":71069,"_29612":71051,"_20544":121339,"_5":14097,"_26932":121298,"_2867":121340},[],"CA raíz activa y `ca.pem`",{"_3381":71070,"_29612":71051,"_20544":121342,"_5":14097,"_26932":121298,"_2867":121343},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3381":71071,"_29612":71051,"_20544":121345,"_5":14097,"_26932":121298,"_2867":121346},[],"Certificado final y `device.crt`",{"_3381":71072,"_29612":71051,"_20544":121348,"_5":14097,"_26932":121298,"_2867":121349},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3381":71073,"_29612":71051,"_20544":121351,"_5":14097,"_26932":121298,"_2867":121352},[],"Clave privada `device.key`",{"_3381":71074,"_29612":71051,"_20544":121354,"_5":14097,"_26932":121298,"_2867":121355},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3381":71075,"_29612":71051,"_20544":121357,"_5":14097,"_26932":121298,"_2867":121358},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3381":71076,"_29612":71051,"_20544":121360,"_5":14097,"_26932":121301,"_2867":121361},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3381":71077,"_29612":71051,"_20544":121363,"_5":14097,"_26932":121301,"_2867":121364},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3381":71078,"_29612":71051,"_20544":121366,"_5":14097,"_26932":121301,"_2867":121367},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3381":71079,"_29612":71079,"_5":14455,"_2867":121369,"_29965":121370,"_20544":121372,"_26932":71079},"Resolución de problemas PKI",[48231,115085,53708,121371],"Resolución de problemas",[],{"_3381":71080,"_29612":71079,"_20544":121374,"_5":14097,"_26932":71079,"_2867":121375},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3381":71081,"_29612":71079,"_5":29962,"_20544":121377,"_26932":121378,"_2867":121379},[],"/docs/pr-preview/pr-53/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3381":71082,"_29612":71079,"_5":29962,"_20544":121381,"_26932":121382,"_2867":121383},[],"/docs/pr-preview/pr-53/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3381":71083,"_29612":71079,"_5":29962,"_20544":121385,"_26932":121386,"_2867":121387},[],"/docs/pr-preview/pr-53/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3381":71084,"_29612":71079,"_20544":121389,"_5":14097,"_26932":71079,"_2867":121390},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3381":71085,"_29612":71079,"_20544":121392,"_5":14097,"_26932":71079,"_2867":121393},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3381":71086,"_29612":71079,"_20544":121395,"_5":14097,"_26932":121378,"_2867":118596},[],{"_3381":71087,"_29612":71079,"_20544":121397,"_5":14097,"_26932":121378,"_2867":117261},[],{"_3381":71088,"_29612":71079,"_20544":121399,"_5":14097,"_26932":121378,"_2867":113687},[],{"_3381":71089,"_29612":71079,"_20544":121401,"_5":14097,"_26932":121378,"_2867":52547},[],{"_3381":71090,"_29612":71079,"_20544":121403,"_5":14097,"_26932":121378,"_2867":121404},[],"Existe, está activa y sus fechas son utilizables.",{"_3381":71091,"_29612":71079,"_20544":121406,"_5":14097,"_26932":121378,"_2867":121407},[],"Autoridades.",{"_3381":71092,"_29612":71079,"_20544":121409,"_5":14097,"_26932":121378,"_2867":121410},[],"Clave",{"_3381":71093,"_29612":71079,"_20544":121412,"_5":14097,"_26932":121378,"_2867":121413},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3381":71094,"_29612":71079,"_20544":121415,"_5":14097,"_26932":121378,"_2867":121416},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3381":71095,"_29612":71079,"_20544":121418,"_5":14097,"_26932":121378,"_2867":56190},[],{"_3381":71096,"_29612":71079,"_20544":121420,"_5":14097,"_26932":121378,"_2867":121421},[],"PEM correcto y firma verificable.",{"_3381":71097,"_29612":71079,"_20544":121423,"_5":14097,"_26932":121378,"_2867":56196},[],{"_3381":71098,"_29612":71079,"_20544":121425,"_5":14097,"_26932":121378,"_2867":121426},[],"Perfil",{"_3381":71099,"_29612":71079,"_20544":121428,"_5":14097,"_26932":121378,"_2867":121429},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3381":71100,"_29612":71079,"_20544":121431,"_5":14097,"_26932":121378,"_2867":121432},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3381":71101,"_29612":71079,"_20544":121434,"_5":14097,"_26932":121378,"_2867":118747},[],{"_3381":71102,"_29612":71079,"_20544":121436,"_5":14097,"_26932":121378,"_2867":121437},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3381":71103,"_29612":71079,"_20544":121439,"_5":14097,"_26932":121378,"_2867":121440},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3381":71104,"_29612":71079,"_20544":121442,"_5":14097,"_26932":121378,"_2867":121443},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3381":71105,"_29612":71079,"_20544":121445,"_5":14097,"_26932":121378,"_2867":121446},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3381":71106,"_29612":71079,"_20544":121448,"_5":14097,"_26932":121382,"_2867":121449},[],"Revisa cada frontera por separado:",{"_3381":71107,"_29612":71079,"_20544":121451,"_5":14097,"_26932":121382,"_2867":121452},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3381":71108,"_29612":71079,"_20544":121454,"_5":14097,"_26932":121382,"_2867":121455},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3381":71109,"_29612":71079,"_20544":121457,"_5":14097,"_26932":121382,"_2867":121458},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3381":71110,"_29612":71079,"_20544":121460,"_5":14097,"_26932":121382,"_2867":121461},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3381":71111,"_29612":71079,"_20544":121463,"_5":14097,"_26932":121382,"_2867":121464},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3381":71112,"_29612":71079,"_20544":121466,"_5":14097,"_26932":121382,"_2867":121467},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_3381":71113,"_29612":71079,"_20544":121469,"_5":14097,"_26932":121386,"_2867":121470},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3381":71114,"_29612":71079,"_20544":121472,"_5":14097,"_26932":121386,"_2867":121473},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3381":71115,"_29612":71115,"_5":14455,"_2867":121475,"_29965":121476,"_20544":121477,"_26932":71115},"Seguridad",[48231],[],{"_3381":71116,"_29612":71115,"_20544":121479,"_5":14097,"_26932":71115,"_2867":121480},[],"Cómo reportar de forma privada una vulnerabilidad de seguridad en Lamassu, qué incluir en el reporte y qué releases reciben correcciones de seguridad.",{"_3381":71117,"_29612":71115,"_5":29962,"_20544":121482,"_26932":121483,"_2867":121484},[],"/docs/pr-preview/pr-53/es/security#cómo-reportar-una-vulnerabilidad","Cómo reportar una vulnerabilidad",{"_3381":71118,"_29612":71115,"_5":29962,"_20544":121486,"_26932":121487,"_2867":121488},[],"/docs/pr-preview/pr-53/es/security#qué-incluir-en-un-reporte","Qué incluir en un reporte",{"_3381":71119,"_29612":71115,"_5":29962,"_20544":121490,"_26932":121491,"_2867":121492},[],"/docs/pr-preview/pr-53/es/security#versiones-soportadas","Versiones soportadas",{"_3381":71120,"_29612":71115,"_5":29962,"_20544":121494,"_26932":121495,"_2867":121496},[],"/docs/pr-preview/pr-53/es/security#divulgación-responsable","Divulgación responsable",{"_3381":71121,"_29612":71115,"_20544":121498,"_5":14097,"_26932":71115,"_2867":121499},[],"¿Has encontrado una vulnerabilidad de seguridad en lamassuiot, lamassu-dashboard o lamassu-helm? Esta página explica cómo reportarla de forma privada, qué incluir en tu reporte y qué releases reciben correcciones de seguridad.",{"_3381":71122,"_29612":71115,"_20544":121501,"_5":14097,"_26932":121483,"_2867":121502},[],"No reportes vulnerabilidades de seguridad mediante issues, discusiones o pull requests públicos de GitHub. Un reporte público divulga el problema antes de que los mantenedores puedan corregirlo.",{"_3381":71123,"_29612":71115,"_20544":121504,"_5":14097,"_26932":121483,"_2867":121505},[],"En su lugar, reporta de forma privada mediante GitHub Security Advisories para el repositorio afectado:",{"_3381":71124,"_29612":71115,"_20544":121507,"_5":14097,"_26932":121483,"_2867":14722},[],{"_3381":71125,"_29612":71115,"_20544":121509,"_5":14097,"_26932":121483,"_2867":14668},[],{"_3381":71126,"_29612":71115,"_20544":121511,"_5":14097,"_26932":121483,"_2867":14715},[],{"_3381":71127,"_29612":71115,"_20544":121513,"_5":14097,"_26932":121483,"_2867":121514},[],"Así los mantenedores pueden evaluar y resolver el problema antes de que se publique.",{"_3381":71128,"_29612":71115,"_20544":121516,"_5":14097,"_26932":121483,"_2867":121517},[],"Si el reporte privado de vulnerabilidades no está habilitado en ese repositorio, reporta la vulnerabilidad de forma privada a lamassuiot\\@lksnext.com antes de divulgar cualquier detalle públicamente.",{"_3381":71129,"_29612":71115,"_20544":121519,"_5":14097,"_26932":121487,"_2867":121520},[],"Describe la vulnerabilidad, su impacto potencial y los pasos para reproducirla usando ejemplos no sensibles y anonimizados.",{"_3381":71130,"_29612":71115,"_20544":121522,"_5":14097,"_26932":121487,"_2867":121523},[],"No incluyas en el reporte:",{"_3381":71131,"_29612":71115,"_20544":121525,"_5":14097,"_26932":121487,"_2867":121526},[],"Credenciales, tokens o claves privadas",{"_3381":71132,"_29612":71115,"_20544":121528,"_5":14097,"_26932":121487,"_2867":121529},[],"Datos de clientes o información identificable de clientes",{"_3381":71133,"_29612":71115,"_20544":121531,"_5":14097,"_26932":121487,"_2867":121532},[],"Detalles confidenciales de arquitectura o de infraestructura interna",{"_3381":71134,"_29612":71115,"_20544":121534,"_5":14097,"_26932":121491,"_2867":121535},[],"Solo el último release estable recibe soporte de seguridad. El soporte de un release estable termina cuando se publica el siguiente release estable. Los releases anteriores y los pre-releases no tienen soporte.",{"_3381":71135,"_29612":71115,"_20544":121537,"_5":14097,"_26932":121491,"_2867":121538},[],"Para saber cómo actualizar, consulta Actualizaciones.",{"_3381":71136,"_29612":71115,"_20544":121540,"_5":14097,"_26932":121495,"_2867":121541},[],"Da a los mantenedores un tiempo razonable para investigar y resolver la vulnerabilidad reportada antes de cualquier divulgación pública.",{"_3381":71137,"_29612":71115,"_20544":121543,"_5":14097,"_26932":121495,"_2867":121544},[],"Evita violaciones de privacidad, destrucción de datos e interrupciones de servicio mientras investigas la vulnerabilidad.",{"_3381":71138,"_29612":71115,"_20544":121546,"_5":14097,"_26932":121495,"_2867":121547},[],"Interactúa solo con cuentas o datos que sean tuyos o sobre los que tengas permiso explícito.",{"_3381":71139,"_29612":71115,"_20544":121549,"_5":14097,"_26932":121495,"_2867":121550},[],"Los mantenedores reconocen los reportes en un tiempo razonable y te mantienen informado del progreso de la remediación.",{"_3381":71140,"_29612":71115,"_20544":121552,"_5":14097,"_26932":121495,"_2867":121553},[],"Esta política cubre el código fuente, la configuración y los flujos de CI/CD de los repositorios lamassuiot, lamassu-dashboard y lamassu-helm.",{"_3381":71141,"_29612":71141,"_5":14455,"_2867":121555,"_29965":121556,"_20544":121558,"_26932":71141},"3.8.0 a 4.0.0",[48231,121557],"Actualizaciones",[],{"_3381":71142,"_29612":71141,"_20544":121560,"_5":14097,"_26932":71141,"_2867":121561},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3381":71143,"_29612":71141,"_5":29962,"_20544":121563,"_26932":121564,"_2867":121565},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_3381":71144,"_29612":71141,"_5":29962,"_20544":121567,"_26932":121568,"_2867":121569},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3381":71145,"_29612":71141,"_5":29962,"_20544":121571,"_26932":121572,"_2867":121573},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3381":71146,"_29612":71141,"_5":29962,"_20544":121575,"_26932":121576,"_2867":121577},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3381":71147,"_29612":71141,"_5":29962,"_20544":121579,"_26932":121580,"_2867":121581},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3381":71148,"_29612":71141,"_5":29962,"_20544":121583,"_26932":121584,"_2867":121585},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3381":71149,"_29612":71141,"_5":29962,"_20544":121587,"_26932":121588,"_2867":56362},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3381":71150,"_29612":71141,"_5":29962,"_20544":121590,"_26932":121591,"_2867":121592},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_3381":71151,"_29612":71141,"_5":29962,"_20544":121594,"_26932":121595,"_2867":121596},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3381":71152,"_29612":71141,"_5":29962,"_20544":121598,"_26932":121599,"_2867":121600},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3381":71153,"_29612":71141,"_5":29962,"_20544":121602,"_26932":121603,"_2867":121604},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3381":71154,"_29612":71141,"_5":29962,"_20544":121606,"_26932":121607,"_2867":121608},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3381":71155,"_29612":71141,"_5":29962,"_20544":121610,"_26932":121611,"_2867":121612},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3381":71156,"_29612":71141,"_5":29962,"_20544":121614,"_26932":121615,"_2867":121616},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3381":71157,"_29612":71141,"_5":29962,"_20544":121618,"_26932":121619,"_2867":121620},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3381":71158,"_29612":71141,"_5":29962,"_20544":121622,"_26932":121623,"_2867":121624},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_3381":71159,"_29612":71141,"_5":29962,"_20544":121626,"_26932":121627,"_2867":121628},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3381":71160,"_29612":71141,"_5":29962,"_20544":121630,"_26932":121631,"_2867":121632},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3381":71161,"_29612":71141,"_5":29962,"_20544":121634,"_26932":121635,"_2867":121636},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3381":71162,"_29612":71141,"_5":29962,"_20544":121638,"_26932":121639,"_2867":121640},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#referencias-entre-certificados-claves-y-roles-va","Referencias entre certificados, claves y roles VA",{"_3381":71163,"_29612":71141,"_5":29962,"_20544":121642,"_26932":121643,"_2867":121644},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_3381":71164,"_29612":71141,"_5":29962,"_20544":121646,"_26932":121647,"_2867":121648},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3381":71165,"_29612":71141,"_5":29962,"_20544":121650,"_26932":121651,"_2867":121652},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3381":71166,"_29612":71141,"_5":29962,"_20544":121654,"_26932":121655,"_2867":121656},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3381":71167,"_29612":71141,"_5":29962,"_20544":121658,"_26932":121659,"_2867":121660},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3381":71168,"_29612":71141,"_5":29962,"_20544":121662,"_26932":121663,"_2867":121664},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3381":71169,"_29612":71141,"_5":29962,"_20544":121666,"_26932":121667,"_2867":121668},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3381":71170,"_29612":71141,"_5":29962,"_20544":121670,"_26932":121671,"_2867":121672},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#campo-firmante-del-rol-va","Campo firmante del rol VA",{"_3381":71171,"_29612":71141,"_5":29962,"_20544":121674,"_26932":121675,"_2867":121676},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3381":71172,"_29612":71141,"_5":29962,"_20544":121678,"_26932":121679,"_2867":121680},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3381":71173,"_29612":71141,"_5":29962,"_20544":121682,"_26932":121683,"_2867":121684},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3381":71174,"_29612":71141,"_5":29962,"_20544":121686,"_26932":121687,"_2867":121688},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3381":71175,"_29612":71141,"_5":29962,"_20544":121690,"_26932":121691,"_2867":121692},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3381":71176,"_29612":71141,"_5":29962,"_20544":121694,"_26932":121695,"_2867":121696},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3381":71177,"_29612":71141,"_5":29962,"_20544":121698,"_26932":121699,"_2867":121700},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3381":71178,"_29612":71141,"_5":29962,"_20544":121702,"_26932":121703,"_2867":117607},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3381":71179,"_29612":71141,"_5":29962,"_20544":121705,"_26932":121706,"_2867":121707},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3381":71180,"_29612":71141,"_5":29962,"_20544":121709,"_26932":121710,"_2867":121711},[],"/docs/pr-preview/pr-53/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3381":71181,"_29612":71141,"_20544":121713,"_5":14097,"_26932":71141,"_2867":121714},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3381":71182,"_29612":71141,"_20544":121716,"_5":14097,"_26932":71141,"_2867":121717},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3381":71183,"_29612":71141,"_20544":121719,"_5":14097,"_26932":71141,"_2867":121720},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_3381":71184,"_29612":71141,"_20544":121722,"_5":14097,"_26932":71141,"_2867":121723},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_3381":71185,"_29612":71141,"_20544":121725,"_5":14097,"_26932":71141,"_2867":121726},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3381":71186,"_29612":71141,"_20544":121728,"_5":14097,"_26932":71141,"_2867":121729},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3381":71187,"_29612":71141,"_20544":121731,"_5":14097,"_26932":71141,"_2867":121732},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3381":71188,"_29612":71141,"_20544":121734,"_5":14097,"_26932":121568,"_2867":121735},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3381":71189,"_29612":71141,"_20544":121737,"_5":14097,"_26932":121568,"_2867":121738},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_3381":71190,"_29612":71141,"_20544":121740,"_5":14097,"_26932":121572,"_2867":121741},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3381":71191,"_29612":71141,"_20544":121743,"_5":14097,"_26932":121572,"_2867":121744},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y roles de la VA. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3381":71192,"_29612":71141,"_20544":121746,"_5":14097,"_26932":121576,"_2867":121747},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera.",{"_3381":71193,"_29612":71141,"_20544":121749,"_5":14097,"_26932":121580,"_2867":121750},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3381":71194,"_29612":71141,"_20544":121752,"_5":14097,"_26932":121580,"_2867":121753},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3381":71195,"_29612":71141,"_20544":121755,"_5":14097,"_26932":121580,"_2867":121756},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_3381":71196,"_29612":71141,"_20544":121758,"_5":14097,"_26932":121580,"_2867":121759},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3381":71197,"_29612":71141,"_20544":121761,"_5":14097,"_26932":121580,"_2867":121762},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3381":71198,"_29612":71141,"_20544":121764,"_5":14097,"_26932":121584,"_2867":121765},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3381":71199,"_29612":71141,"_20544":121767,"_5":14097,"_26932":121584,"_2867":121768},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3381":71200,"_29612":71141,"_20544":121770,"_5":14097,"_26932":121584,"_2867":121771},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3381":71201,"_29612":71141,"_20544":121773,"_5":14097,"_26932":121584,"_2867":121774},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3381":71202,"_29612":71141,"_20544":121776,"_5":14097,"_26932":121584,"_2867":121777},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3381":71203,"_29612":71141,"_20544":121779,"_5":14097,"_26932":121588,"_2867":121780},[],"Cambio",{"_3381":71204,"_29612":71141,"_20544":121782,"_5":14097,"_26932":121588,"_2867":121783},[],"A quién afecta",{"_3381":71205,"_29612":71141,"_20544":121785,"_5":14097,"_26932":121588,"_2867":121786},[],"Gravedad",{"_3381":71206,"_29612":71141,"_20544":121788,"_5":14097,"_26932":121588,"_2867":120315},[],{"_3381":71207,"_29612":71141,"_20544":121790,"_5":14097,"_26932":121588,"_2867":121596},[],{"_3381":71208,"_29612":71141,"_20544":121792,"_5":14097,"_26932":121588,"_2867":121793},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_3381":71209,"_29612":71141,"_20544":121795,"_5":14097,"_26932":121588,"_2867":121796},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_3381":71210,"_29612":71141,"_20544":121798,"_5":14097,"_26932":121588,"_2867":121799},[],"Copiar los datos a los volúmenes nuevos",{"_3381":71211,"_29612":71141,"_20544":121801,"_5":14097,"_26932":121588,"_2867":121600},[],{"_3381":71212,"_29612":71141,"_20544":121803,"_5":14097,"_26932":121588,"_2867":121804},[],"Todas las releases de Helm",{"_3381":71213,"_29612":71141,"_20544":121806,"_5":14097,"_26932":121588,"_2867":121807},[],"Alta: `helm upgrade` falla",{"_3381":71214,"_29612":71141,"_20544":121809,"_5":14097,"_26932":121588,"_2867":121810},[],"Eliminar o renombrar las claves heredadas",{"_3381":71215,"_29612":71141,"_20544":121812,"_5":14097,"_26932":121588,"_2867":121604},[],{"_3381":71216,"_29612":71141,"_20544":121814,"_5":14097,"_26932":121588,"_2867":121815},[],"Todos los despliegues",{"_3381":71217,"_29612":71141,"_20544":121817,"_5":14097,"_26932":121588,"_2867":121818},[],"Alta: sin principal de bootstrap no hay administrador",{"_3381":71218,"_29612":71141,"_20544":121820,"_5":14097,"_26932":121588,"_2867":121821},[],"Configurar `services.authz`",{"_3381":71219,"_29612":71141,"_20544":121823,"_5":14097,"_26932":121588,"_2867":121608},[],{"_3381":71220,"_29612":71141,"_20544":121825,"_5":14097,"_26932":121588,"_2867":121804},[],{"_3381":71221,"_29612":71141,"_20544":121827,"_5":14097,"_26932":121588,"_2867":121828},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_3381":71222,"_29612":71141,"_20544":121830,"_5":14097,"_26932":121588,"_2867":121831},[],"Mover JWKS y roles a `services.authz`",{"_3381":71223,"_29612":71141,"_20544":121833,"_5":14097,"_26932":121588,"_2867":121628},[],{"_3381":71224,"_29612":71141,"_20544":121835,"_5":14097,"_26932":121588,"_2867":121836},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_3381":71225,"_29612":71141,"_20544":121838,"_5":14097,"_26932":121588,"_2867":121839},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_3381":71226,"_29612":71141,"_20544":121841,"_5":14097,"_26932":121588,"_2867":121842},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_3381":71227,"_29612":71141,"_20544":121844,"_5":14097,"_26932":121588,"_2867":121632},[],{"_3381":71228,"_29612":71141,"_20544":121846,"_5":14097,"_26932":121588,"_2867":121847},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_3381":71229,"_29612":71141,"_20544":121849,"_5":14097,"_26932":121588,"_2867":121850},[],"Alta: el backend ya no arranca con ellos",{"_3381":71230,"_29612":71141,"_20544":121852,"_5":14097,"_26932":121588,"_2867":121853},[],"Pasar a PostgreSQL antes de actualizar",{"_3381":71231,"_29612":71141,"_20544":121855,"_5":14097,"_26932":121588,"_2867":121856},[],"Webhooks con referencias a archivos",{"_3381":71232,"_29612":71141,"_20544":121858,"_5":14097,"_26932":121588,"_2867":121859},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3381":71233,"_29612":71141,"_20544":121861,"_5":14097,"_26932":121588,"_2867":121862},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_3381":71234,"_29612":71141,"_20544":121864,"_5":14097,"_26932":121588,"_2867":121865},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3381":71235,"_29612":71141,"_20544":121867,"_5":14097,"_26932":121588,"_2867":121612},[],{"_3381":71236,"_29612":71141,"_20544":121869,"_5":14097,"_26932":121588,"_2867":121870},[],"Releases con identidades por servicio o material de claves montado",{"_3381":71237,"_29612":71141,"_20544":121872,"_5":14097,"_26932":121588,"_2867":121873},[],"Media: los servicios no pueden leer sus archivos",{"_3381":71238,"_29612":71141,"_20544":121875,"_5":14097,"_26932":121588,"_2867":121876},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_3381":71239,"_29612":71141,"_20544":121878,"_5":14097,"_26932":121588,"_2867":121616},[],{"_3381":71240,"_29612":71141,"_20544":121880,"_5":14097,"_26932":121588,"_2867":121881},[],"Releases que definen `amqp.tls`",{"_3381":71241,"_29612":71141,"_20544":121883,"_5":14097,"_26932":121588,"_2867":121884},[],"Media: los clientes se conectan al puerto equivocado",{"_3381":71242,"_29612":71141,"_20544":121886,"_5":14097,"_26932":121588,"_2867":121887},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_3381":71243,"_29612":71141,"_20544":121889,"_5":14097,"_26932":121588,"_2867":121636},[],{"_3381":71244,"_29612":71141,"_20544":121891,"_5":14097,"_26932":121588,"_2867":121892},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3381":71245,"_29612":71141,"_20544":121894,"_5":14097,"_26932":121588,"_2867":121895},[],"Media: las claves de CA quedan sin gestionar",{"_3381":71246,"_29612":71141,"_20544":121897,"_5":14097,"_26932":121588,"_2867":121898},[],"Ejecutar la migración de CA a KMS",{"_3381":71247,"_29612":71141,"_20544":121900,"_5":14097,"_26932":121588,"_2867":121901},[],"Verificación del certificado del receptor",{"_3381":71248,"_29612":71141,"_20544":121903,"_5":14097,"_26932":121588,"_2867":121904},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_3381":71249,"_29612":71141,"_20544":121906,"_5":14097,"_26932":121588,"_2867":121907},[],"Media: las credenciales viajan a un receptor sin verificar",{"_3381":71250,"_29612":71141,"_20544":121909,"_5":14097,"_26932":121588,"_2867":121910},[],"Poner `insecure_skip_verify` a `false`",{"_3381":71251,"_29612":71141,"_20544":121912,"_5":14097,"_26932":121588,"_2867":121652},[],{"_3381":71252,"_29612":71141,"_20544":121914,"_5":14097,"_26932":121588,"_2867":121915},[],"Scripts y consolas que editan DMS por API",{"_3381":71253,"_29612":71141,"_20544":121917,"_5":14097,"_26932":121588,"_2867":121918},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3381":71254,"_29612":71141,"_20544":121920,"_5":14097,"_26932":121588,"_2867":121921},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3381":71255,"_29612":71141,"_20544":121923,"_5":14097,"_26932":121588,"_2867":121672},[],{"_3381":71256,"_29612":71141,"_20544":121925,"_5":14097,"_26932":121588,"_2867":121926},[],"Clientes que crean o actualizan roles VA por API",{"_3381":71257,"_29612":71141,"_20544":121928,"_5":14097,"_26932":121588,"_2867":121929},[],"Media: las peticiones con el campo antiguo devuelven un error",{"_3381":71258,"_29612":71141,"_20544":121931,"_5":14097,"_26932":121588,"_2867":121932},[],"Sustituir `crl_options.subject_key_id_signer` por el obligatorio `crl_options.signer_certificate_serial_number`",{"_3381":71259,"_29612":71141,"_20544":121934,"_5":14097,"_26932":121588,"_2867":121668},[],{"_3381":71260,"_29612":71141,"_20544":121936,"_5":14097,"_26932":121588,"_2867":121937},[],"Consumidores que leen el campo `events` del dispositivo",{"_3381":71261,"_29612":71141,"_20544":121939,"_5":14097,"_26932":121588,"_2867":121940},[],"Media: el campo desaparece",{"_3381":71262,"_29612":71141,"_20544":121942,"_5":14097,"_26932":121588,"_2867":121943},[],"Usar los nuevos endpoints de eventos",{"_3381":71263,"_29612":71141,"_20544":121945,"_5":14097,"_26932":121588,"_2867":121620},[],{"_3381":71264,"_29612":71141,"_20544":121947,"_5":14097,"_26932":121588,"_2867":121948},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_3381":71265,"_29612":71141,"_20544":121950,"_5":14097,"_26932":121588,"_2867":121951},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_3381":71266,"_29612":71141,"_20544":121953,"_5":14097,"_26932":121588,"_2867":121954},[],"Actualizar el archivo de values",{"_3381":71267,"_29612":71141,"_20544":121956,"_5":14097,"_26932":121588,"_2867":121660},[],{"_3381":71268,"_29612":71141,"_20544":121958,"_5":14097,"_26932":121588,"_2867":121959},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3381":71269,"_29612":71141,"_20544":121961,"_5":14097,"_26932":121588,"_2867":121962},[],"Baja: prevalece el ID de la URL",{"_3381":71270,"_29612":71141,"_20544":121964,"_5":14097,"_26932":121588,"_2867":121965},[],"Enviar el ID en la URL",{"_3381":71271,"_29612":71141,"_20544":121967,"_5":14097,"_26932":121588,"_2867":121664},[],{"_3381":71272,"_29612":71141,"_20544":121969,"_5":14097,"_26932":121588,"_2867":121970},[],"Consumidores que comparan el `type` del certificado",{"_3381":71273,"_29612":71141,"_20544":121972,"_5":14097,"_26932":121588,"_2867":121973},[],"Baja: dos valores cambian de nombre",{"_3381":71274,"_29612":71141,"_20544":121975,"_5":14097,"_26932":121588,"_2867":121976},[],"Adaptar los consumidores",{"_3381":71275,"_29612":71141,"_20544":121978,"_5":14097,"_26932":121588,"_2867":121656},[],{"_3381":71276,"_29612":71141,"_20544":121980,"_5":14097,"_26932":121588,"_2867":121981},[],"Cualquier DMS",{"_3381":71277,"_29612":71141,"_20544":121983,"_5":14097,"_26932":121588,"_2867":121984},[],"Baja: solo informativo",{"_3381":71278,"_29612":71141,"_20544":121986,"_5":14097,"_26932":121588,"_2867":121987},[],"Revisar ambos bloques antes de editar",{"_3381":71279,"_29612":71141,"_20544":121989,"_5":14097,"_26932":121595,"_2867":121990},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3381":71280,"_29612":71141,"_20544":121992,"_5":14097,"_26932":121595,"_2867":121993},[],"El paso 4 de la guía de migración copia los datos.",{"_3381":71281,"_29612":71141,"_20544":121995,"_5":14097,"_26932":121599,"_2867":121996},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3381":71282,"_29612":71141,"_20544":121998,"_5":14097,"_26932":121603,"_2867":121999},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3381":71283,"_29612":71141,"_20544":122001,"_5":14097,"_26932":121607,"_2867":122002},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3381":71284,"_29612":71141,"_20544":122004,"_5":14097,"_26932":121611,"_2867":122005},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3381":71285,"_29612":71141,"_20544":122007,"_5":14097,"_26932":121611,"_2867":122008},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3381":71286,"_29612":71141,"_20544":122010,"_5":14097,"_26932":121615,"_2867":122011},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3381":71287,"_29612":71141,"_20544":122013,"_5":14097,"_26932":121619,"_2867":122014},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3381":71288,"_29612":71141,"_20544":122016,"_5":14097,"_26932":121619,"_2867":122017},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3381":71289,"_29612":71141,"_20544":122019,"_5":14097,"_26932":121619,"_2867":122020},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3381":71290,"_29612":71141,"_20544":122022,"_5":14097,"_26932":121619,"_2867":122023},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3381":71291,"_29612":71141,"_20544":122025,"_5":14097,"_26932":121619,"_2867":122026},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3381":71292,"_29612":71141,"_20544":122028,"_5":14097,"_26932":121619,"_2867":122029},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3381":71293,"_29612":71141,"_20544":122031,"_5":14097,"_26932":121627,"_2867":122032},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3381":71294,"_29612":71141,"_20544":122034,"_5":14097,"_26932":121627,"_2867":122035},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3381":71295,"_29612":71141,"_20544":122037,"_5":14097,"_26932":121627,"_2867":122038},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3381":71296,"_29612":71141,"_20544":122040,"_5":14097,"_26932":121627,"_2867":122041},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3381":71297,"_29612":71141,"_20544":122043,"_5":14097,"_26932":121627,"_2867":122044},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_3381":71298,"_29612":71141,"_20544":122046,"_5":14097,"_26932":121631,"_2867":122047},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3381":71299,"_29612":71141,"_20544":122049,"_5":14097,"_26932":121635,"_2867":122050},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3381":71300,"_29612":71141,"_20544":122052,"_5":14097,"_26932":121635,"_2867":122053},[],"El `key_id` es el `subject_key_id` del certificado (SHA-256 de la clave pública).",{"_3381":71301,"_29612":71141,"_20544":122055,"_5":14097,"_26932":121635,"_2867":122056},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3381":71302,"_29612":71141,"_20544":122058,"_5":14097,"_26932":121635,"_2867":122059},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3381":71303,"_29612":71141,"_20544":122061,"_5":14097,"_26932":121635,"_2867":122062},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3381":71304,"_29612":71141,"_20544":122064,"_5":14097,"_26932":121635,"_2867":122065},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3381":71305,"_29612":71141,"_20544":122067,"_5":14097,"_26932":121635,"_2867":122068},[],"Una vez registradas las claves heredadas, arrancar el KMS con la opción de configuración del backend `crypto_engines.migrate_keys_format` renombra las claves cuyo nombre no es el digest SHA-256 de la clave pública, conserva el nombre antiguo como alias y traslada consigo las referencias de certificados. Es seguro volver a ejecutarla y puede desactivarse después.",{"_3381":71306,"_29612":71141,"_20544":122070,"_5":14097,"_26932":121639,"_2867":122071},[],"Los certificados referencian ahora su clave del KMS, y los roles VA referencian su certificado firmante, de modo que no se puede eliminar una clave o un certificado en uso. La migración del KMS descarta los metadatos de clave heredados `lamassu.io/kms/binded-resources`. Antes de 4.0.0, eliminar una CA podía borrar su clave y dejar referencias a ella en los registros de certificado conservados. La migración de CA registra esas claves ausentes en el KMS solo con su clave pública para satisfacer las referencias conservadas. Estas entradas no pueden eliminarse mientras los certificados conservados las referencien; no recuperan la clave privada. En 4.0.0, eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados antes de intentar eliminar la clave; los demás certificados que todavía la referencien impiden su eliminación.",{"_3381":71307,"_29612":71141,"_20544":122073,"_5":14097,"_26932":121647,"_2867":122074},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_3381":71308,"_29612":71141,"_20544":122076,"_5":14097,"_26932":121647,"_2867":122077},[],"Campo en 3.8.0",{"_3381":71309,"_29612":71141,"_20544":122079,"_5":14097,"_26932":121647,"_2867":122080},[],"Campo en 4.0.0",{"_3381":71310,"_29612":71141,"_20544":122082,"_5":14097,"_26932":121647,"_2867":56857},[],{"_3381":71311,"_29612":71141,"_20544":122084,"_5":14097,"_26932":121647,"_2867":122085},[],"`insecure_skip_verify` (con el valor negado)",{"_3381":71312,"_29612":71141,"_20544":122087,"_5":14097,"_26932":121647,"_2867":56863},[],{"_3381":71313,"_29612":71141,"_20544":122089,"_5":14097,"_26932":121647,"_2867":56866},[],{"_3381":71314,"_29612":71141,"_20544":122091,"_5":14097,"_26932":121647,"_2867":56869},[],{"_3381":71315,"_29612":71141,"_20544":122093,"_5":14097,"_26932":121647,"_2867":56872},[],{"_3381":71316,"_29612":71141,"_20544":122095,"_5":14097,"_26932":121647,"_2867":56875},[],{"_3381":71317,"_29612":71141,"_20544":122097,"_5":14097,"_26932":121647,"_2867":56878},[],{"_3381":71318,"_29612":71141,"_20544":122099,"_5":14097,"_26932":121647,"_2867":122100},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_3381":71319,"_29612":71141,"_20544":122102,"_5":14097,"_26932":121647,"_2867":122103},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3381":71320,"_29612":71141,"_20544":122105,"_5":14097,"_26932":121647,"_2867":122106},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3381":71321,"_29612":71141,"_20544":122108,"_5":14097,"_26932":121651,"_2867":122109},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3381":71322,"_29612":71141,"_20544":122111,"_5":14097,"_26932":121651,"_2867":122112},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3381":71323,"_29612":71141,"_20544":122114,"_5":14097,"_26932":121651,"_2867":122115},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3381":71324,"_29612":71141,"_20544":122117,"_5":14097,"_26932":121655,"_2867":122118},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. La consola expone editores independientes para ambos bloques; la guía de DMS describe sus campos, y también puedes editarlos mediante la API DMS.",{"_3381":71325,"_29612":71141,"_20544":122120,"_5":14097,"_26932":121659,"_2867":122121},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3381":71326,"_29612":71141,"_20544":122123,"_5":14097,"_26932":121663,"_2867":122124},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_3381":71327,"_29612":71141,"_20544":122126,"_5":14097,"_26932":121667,"_2867":122127},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3381":71328,"_29612":71141,"_20544":122129,"_5":14097,"_26932":121667,"_2867":122130},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3381":71329,"_29612":71141,"_20544":122132,"_5":14097,"_26932":121667,"_2867":122133},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3381":71330,"_29612":71141,"_20544":122135,"_5":14097,"_26932":121667,"_2867":122136},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza.",{"_3381":71331,"_29612":71141,"_20544":122138,"_5":14097,"_26932":121671,"_2867":122139},[],"`crl_options.subject_key_id_signer` se sustituye por el obligatorio `crl_options.signer_certificate_serial_number`, el número de serie del certificado existente que firma la CRL. El valor inicial de un rol nuevo es el número de serie del certificado actual de la CA. Las peticiones que aún contienen `subject_key_id_signer` devuelven un error. Las políticas de autorización personalizadas que filtran por el campo antiguo deben actualizarse: el filtro `crl_subject_key_id_signer` se renombra a `crl_signer_certificate_serial_number` y toma valores de número de serie.",{"_3381":71332,"_29612":71141,"_20544":122141,"_5":14097,"_26932":121675,"_2867":122142},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3381":71333,"_29612":71141,"_20544":122144,"_5":14097,"_26932":121679,"_2867":122145},[],"Haz una copia de seguridad verificable de PostgreSQL y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`.",{"_3381":71334,"_29612":71141,"_20544":122147,"_5":14097,"_26932":121679,"_2867":122148},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3381":71335,"_29612":71141,"_20544":122150,"_5":14097,"_26932":121679,"_2867":122151},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3381":71336,"_29612":71141,"_20544":122153,"_5":14097,"_26932":121679,"_2867":122154},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3381":71337,"_29612":71141,"_20544":122156,"_5":14097,"_26932":121679,"_2867":122157},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3381":71338,"_29612":71141,"_20544":122159,"_5":14097,"_26932":121683,"_2867":122160},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3381":71339,"_29612":71141,"_20544":122162,"_5":14097,"_26932":121683,"_2867":122163},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3381":71340,"_29612":71141,"_20544":122165,"_5":14097,"_26932":121683,"_2867":122166},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se lee el campo `database` de cada entrada; la conexión usa siempre los values globales `postgres.hostname`, `postgres.port`, `postgres.username` y `postgres.password`.",{"_3381":71341,"_29612":71141,"_20544":122168,"_5":14097,"_26932":121683,"_2867":122169},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3381":71342,"_29612":71141,"_20544":122171,"_5":14097,"_26932":121683,"_2867":122172},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3381":71343,"_29612":71141,"_20544":122174,"_5":14097,"_26932":121683,"_2867":122175},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3381":71344,"_29612":71141,"_20544":122177,"_5":14097,"_26932":121683,"_2867":122178},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3381":71345,"_29612":71141,"_20544":122180,"_5":14097,"_26932":121683,"_2867":122181},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3381":71346,"_29612":71141,"_20544":122183,"_5":14097,"_26932":121683,"_2867":122184},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3381":71347,"_29612":71141,"_20544":122186,"_5":14097,"_26932":121683,"_2867":122187},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3381":71348,"_29612":71141,"_20544":122189,"_5":14097,"_26932":121683,"_2867":122190},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3381":71349,"_29612":71141,"_20544":122192,"_5":14097,"_26932":121683,"_2867":122193},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida.",{"_3381":71350,"_29612":71141,"_20544":122195,"_5":14097,"_26932":121687,"_2867":122196},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_3381":71351,"_29612":71141,"_20544":122198,"_5":14097,"_26932":121687,"_2867":122199},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_3381":71352,"_29612":71141,"_20544":122201,"_5":14097,"_26932":121691,"_2867":122202},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3381":71353,"_29612":71141,"_20544":122204,"_5":14097,"_26932":121691,"_2867":122205},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3381":71354,"_29612":71141,"_20544":122207,"_5":14097,"_26932":121691,"_2867":122208},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3381":71355,"_29612":71141,"_20544":122210,"_5":14097,"_26932":121691,"_2867":122211},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_3381":71356,"_29612":71141,"_20544":122213,"_5":14097,"_26932":121691,"_2867":122214},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3381":71357,"_29612":71141,"_20544":122216,"_5":14097,"_26932":121691,"_2867":122217},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3381":71358,"_29612":71141,"_20544":122219,"_5":14097,"_26932":121691,"_2867":122220},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3381":71359,"_29612":71141,"_20544":122222,"_5":14097,"_26932":121691,"_2867":122223},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3381":71360,"_29612":71141,"_20544":122225,"_5":14097,"_26932":121691,"_2867":122226},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3381":71361,"_29612":71141,"_20544":122228,"_5":14097,"_26932":121691,"_2867":122229},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3381":71362,"_29612":71141,"_20544":122231,"_5":14097,"_26932":121691,"_2867":122232},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_3381":71363,"_29612":71141,"_20544":122234,"_5":14097,"_26932":121695,"_2867":122235},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3381":71364,"_29612":71141,"_20544":122237,"_5":14097,"_26932":121695,"_2867":122238},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3381":71365,"_29612":71141,"_20544":122240,"_5":14097,"_26932":121699,"_2867":122241},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3381":71366,"_29612":71141,"_20544":122243,"_5":14097,"_26932":121699,"_2867":122244},[],"Ejecuta las migraciones en el orden obligatorio, un esquema cada vez: primero `kms`, después la herramienta `ca-to-kms-migration` (necesaria solo en despliegues heredados cuyas claves de CA se nombran por SKI), luego `ca` y por último `va`. Los esquemas `devicemanager`, `dmsmanager` y `alerts` son independientes y pueden migrarse en cualquier orden. Con Helm, el job de preinstalación del chart aplica los esquemas en el orden correcto automáticamente.",{"_3381":71367,"_29612":71141,"_20544":122246,"_5":14097,"_26932":121699,"_2867":122247},[],"Los esquemas se referencian entre sí, así que el rol de PostgreSQL que ejecuta las migraciones necesita privilegios entre esquemas: el esquema `ca` necesita `USAGE` sobre `kms` más `SELECT`, `REFERENCES` e `INSERT` sobre `kms.kms_keys`, y el esquema `va` necesita `USAGE` sobre `ca` más `SELECT` y `REFERENCES` sobre `ca.certificates` y `SELECT` sobre `ca.ca_certificates`. Si tus servicios se conectan con un usuario distinto del que ejecutó las migraciones, concédele tras las migraciones `SELECT` sobre `ca.certificates_view`.",{"_3381":71368,"_29612":71141,"_20544":122249,"_5":14097,"_26932":121699,"_2867":122250},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3381":71369,"_29612":71141,"_20544":122252,"_5":14097,"_26932":121699,"_2867":122253},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3381":71370,"_29612":71141,"_20544":122255,"_5":14097,"_26932":121699,"_2867":122256},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_3381":71371,"_29612":71141,"_20544":122258,"_5":14097,"_26932":121699,"_2867":122259},[],"Los README de ambas herramientas documentan el formato de 4.0.0 con la base `pki` y coinciden con esta página: `goose-lamassu` usa ejemplos con `dbname=pki` y no valida el nombre de la base de datos, y el README de `ca-to-kms-migration` describe la base única `pki` y el orden de migración.",{"_3381":71372,"_29612":71141,"_20544":122261,"_5":14097,"_26932":121703,"_2867":122262},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3381":71373,"_29612":71141,"_20544":122264,"_5":14097,"_26932":121703,"_2867":122265},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_3381":71374,"_29612":71141,"_20544":122267,"_5":14097,"_26932":121703,"_2867":122268},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_3381":71375,"_29612":71141,"_20544":122270,"_5":14097,"_26932":121703,"_2867":122271},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3381":71376,"_29612":71141,"_20544":122273,"_5":14097,"_26932":121703,"_2867":122274},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó por IDs de CA duplicados o por valores de `engine_id` vacíos. Revisa los logs del job, corrige los permisos o los datos y vuelve a ejecutar la actualización.",{"_3381":71377,"_29612":71141,"_20544":122276,"_5":14097,"_26932":121703,"_2867":122277},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3381":71378,"_29612":71141,"_20544":122279,"_5":14097,"_26932":121703,"_2867":122280},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3381":71379,"_29612":71141,"_20544":122282,"_5":14097,"_26932":121703,"_2867":122283},[],"**Una migración aborta con `kms schema not found`.** Los esquemas deben migrarse en orden: ejecuta la migración del esquema `kms` antes que la del esquema `ca`.",{"_3381":71380,"_29612":71141,"_20544":122285,"_5":14097,"_26932":121703,"_2867":122286},[],"**Una migración aborta con `ca schema not found`.** Ejecuta la migración del esquema `ca` antes que la del esquema `va`.",{"_3381":71381,"_29612":71141,"_20544":122288,"_5":14097,"_26932":121703,"_2867":122289},[],"**La migración de VA falla con `cannot resolve signer certificate for VA role ... N candidates`.** La migración no puede identificar un certificado firmante de forma única a partir del SKI guardado en el rol. Revisa el SKI y los certificados candidatos indicados en el error; corrige los datos anteriores a la migración con una copia de seguridad verificada y vuelve a ejecutar la migración. El nuevo campo `signer_certificate_serial_number` se crea durante esa migración, por lo que no se puede configurar mediante la API de VA mientras esta falla.",{"_3381":71382,"_29612":71141,"_20544":122291,"_5":14097,"_26932":121703,"_2867":122292},[],"**Una migración o un servicio falla con `permission denied for table ...`.** Al rol de PostgreSQL le faltan los privilegios entre esquemas listados en Despliegues sin Helm; incluye `certificates_view` cuando se omitió el `GRANT SELECT` posterior a la migración. Concede los privilegios que falten y vuelve a ejecutar.",{"_3381":71383,"_29612":71141,"_20544":122294,"_5":14097,"_26932":121706,"_2867":122295},[],"Tras la actualización, comprueba en este orden:",{"_3381":71384,"_29612":71141,"_20544":122297,"_5":14097,"_26932":121706,"_2867":122298},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS, y las migraciones de claves foráneas que se ejecutan por esquema en el orden obligatorio.",{"_3381":71385,"_29612":71141,"_20544":122300,"_5":14097,"_26932":121706,"_2867":122301},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3381":71386,"_29612":71141,"_20544":122303,"_5":14097,"_26932":121706,"_2867":122304},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3381":71387,"_29612":71141,"_20544":122306,"_5":14097,"_26932":121706,"_2867":122307},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-ski>` sobre la VA devuelve una CRL emitida anteriormente, y se emiten CRLs nuevas.",{"_3381":71388,"_29612":71141,"_20544":122309,"_5":14097,"_26932":121706,"_2867":122310},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS.",{"_3381":71389,"_29612":71141,"_20544":122312,"_5":14097,"_26932":121706,"_2867":122313},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3381":71390,"_29612":71141,"_20544":122315,"_5":14097,"_26932":121706,"_2867":122316},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3381":71391,"_29612":71141,"_20544":122318,"_5":14097,"_26932":121706,"_2867":122319},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha.",{"_3381":71392,"_29612":71141,"_20544":122321,"_5":14097,"_26932":121706,"_2867":122322},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3381":71393,"_29612":71141,"_20544":122324,"_5":14097,"_26932":121706,"_2867":122325},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3381":71394,"_29612":71141,"_20544":122327,"_5":14097,"_26932":121706,"_2867":122328},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3381":71395,"_29612":71141,"_20544":122330,"_5":14097,"_26932":121706,"_2867":122331},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3381":71396,"_29612":71141,"_20544":122333,"_5":14097,"_26932":121706,"_2867":122334},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3381":71397,"_29612":71141,"_20544":122336,"_5":14097,"_26932":121706,"_2867":122337},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3381":71398,"_29612":71141,"_20544":122339,"_5":14097,"_26932":121710,"_2867":122340},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_3381":71399,"_29612":71141,"_20544":122342,"_5":14097,"_26932":121710,"_2867":122343},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3381":71400,"_29612":71141,"_20544":122345,"_5":14097,"_26932":121710,"_2867":122346},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3381":71401,"_29612":71141,"_20544":122348,"_5":14097,"_26932":121710,"_2867":122349},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_3381":71402,"_29612":71141,"_20544":122351,"_5":14097,"_26932":121710,"_2867":122352},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_57136":122354,"_57138":122355,"_57140":122356,"_57142":122357,"_17800":2902,"_68549":2902},"spanish",[2867,29612,5,26932],{"_2867":24548,"_29612":24548,"_5":24548,"_26932":24548},{"_2867":122358,"_29612":125208,"_5":128058,"_26932":130908},{"_4540":122359,"_57146":122360,"_5":24548},{"_14179":12919,"_14560":4443,"_14579":5827,"_28621":10284,"_14566":3960,"_19498":3336,"_14200":5938,"_14207":17664,"_28563":13017,"_28972":4478,"_28993":6839,"_28597":6877,"_33926":6151,"_28700":19956,"_29037":9668,"_33933":29140,"_33936":3899,"_33939":9365,"_33942":24895,"_29444":3251,"_33947":14021,"_33949":9814,"_29474":25115,"_14575":10821,"_33953":7335,"_33956":5846,"_33958":5877,"_29021":5867,"_29439":9916,"_29487":4662,"_33963":5879,"_33965":3563,"_33967":7320,"_28717":3311,"_33970":3918,"_33972":4218,"_33974":