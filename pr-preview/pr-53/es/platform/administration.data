rollment/est-reference.mdx",{"_40":288,"_47":58,"_42":289,"_52":290,"_61":-7,"_12":291,"_63":292},"es:platform/iot-fleets/enrollment/troubleshooting.mdx","Diagnóstico de enrolamiento","Localiza fallos de transporte, autenticación, registro, emisión e instalación.","/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/troubleshooting",{"_65":293},"platform/iot-fleets/enrollment/troubleshooting.mdx","es:platform/iot-fleets/enrollment",{"_197":296},"platform/iot-fleets/enrollment/meta.json","<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-network shrink-0\" aria-hidden=\"true\"><rect x=\"16\" y=\"16\" width=\"6\" height=\"6\" rx=\"1\"></rect><rect x=\"2\" y=\"16\" width=\"6\" height=\"6\" rx=\"1\"></rect><rect x=\"9\" y=\"2\" width=\"6\" height=\"6\" rx=\"1\"></rect><path d=\"M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3\"></path><path d=\"M12 12V8\"></path></svg>",{"_40":299,"_47":58,"_42":236,"_52":300,"_61":-7,"_12":301,"_63":302},"es:platform/iot-fleets/enrollment/overview.mdx","Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.","/docs/pr-preview/pr-53/es/platform/iot-fleets/enrollment/overview",{"_65":303},"platform/iot-fleets/enrollment/overview.mdx",{"_47":48,"_42":305,"_49":-7,"_51":-7,"_52":-7,"_54":-7,"_44":306,"_40":314,"_63":315,"_61":317},"Integraciones",[307],{"_40":308,"_47":58,"_42":309,"_52":310,"_61":-7,"_12":311,"_63":312},"es:platform/iot-fleets/integrations/aws-iot-core.mdx","AWS IoT Core","El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.","/docs/pr-preview/pr-53/es/platform/iot-fleets/integrations/aws-iot-core",{"_65":313},"platform/iot-fleets/int