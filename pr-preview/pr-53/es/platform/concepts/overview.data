.mdx",{"_39":171,"_46":57,"_41":172,"_51":173,"_60":-7,"_12":174,"_62":175},"es:platform/pki/ocsp.mdx","OCSP","Consulta el estado firmado y verifica la respuesta del respondedor.","/docs/pr-preview/pr-53/es/platform/pki/ocsp",{"_64":176},"platform/pki/ocsp.mdx",{"_39":178,"_46":57,"_41":179,"_51":180,"_60":-7,"_12":30,"_62":181},"es:platform/pki/crl.mdx","CRL","Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_64":182},"platform/pki/crl.mdx",{"_39":184,"_46":84,"_60":-7,"_41":185},"es:_4","Resolución de problemas",{"_39":187,"_46":57,"_41":188,"_51":189,"_60":-7,"_12":190,"_62":191},"es:platform/pki/troubleshooting.mdx","Resolución de problemas PKI","Diagnostica emisión de certificados, OCSP y CRL.","/docs/pr-preview/pr-53/es/platform/pki/troubleshooting",{"_64":192},"platform/pki/troubleshooting.mdx","es:platform/pki",{"_195":196},"metaFile","platform/pki/meta.json","<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-shield-check shrink-0\" aria-hidden=\"true\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"></path><path d=\"m9 12 2 2 4-4\"></path></svg>","index",{"_39":200,"_46":57,"_41":80,"_51":201,"_60":-7,"_12":202,"_62":203},"es:platform/pki/overview.mdx","Administra claves y autoridades, define la emisión y verifica los certificados resultantes.","/docs/pr-preview/pr-53/es/platform/pki/overview",{"_64":204},"platform/pki/overview.mdx",{"_46":47,"_41":206,"_48":-7,"_50":-7,"_51":-7,"_53":-7,"_43":207,"_39":316,"_62":317,"_60":319,"_198":320},"IoT Fleets",[208,210,217,224,227,233,302],{"_39":209,"_46":84,"_60":-7,"_41":85},"es:_5",{"_39":211,"_46":57,"_41":212,"_51":213,"_60":-7,"_12":214,"_62":215},"es:platform/iot-fleets/quickstarts/enro