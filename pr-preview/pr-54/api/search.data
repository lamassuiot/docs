14801,"_37394":114804,"_37396":114807,"_37398":114810,"_37400":114813,"_37402":114816,"_37405":114819,"_37407":114822,"_37409":114825},{"_3170":64340,"_28017":64340,"_5":13637,"_2665":106709,"_28360":106710,"_19412":106713,"_25509":64340},"Despliega desde AWS Marketplace",[45425,106711,106712],"Despliegue","Otros modelos",[],{"_3170":64341,"_28017":64340,"_19412":106715,"_5":13306,"_25509":64340,"_2665":106716},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_3170":64342,"_28017":64340,"_5":28357,"_19412":106718,"_25509":106719,"_2665":106720},[],"/docs/pr-preview/pr-54/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_3170":64343,"_28017":64340,"_5":28357,"_19412":106722,"_25509":106723,"_2665":106724},[],"/docs/pr-preview/pr-54/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_3170":64344,"_28017":64340,"_5":28357,"_19412":106726,"_25509":106727,"_2665":106728},[],"/docs/pr-preview/pr-54/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3170":64345,"_28017":64340,"_5":28357,"_19412":106730,"_25509":106731,"_2665":106732},[],"/docs/pr-preview/pr-54/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3170":64346,"_28017":64340,"_5":28357,"_19412":106734,"_25509":106735,"_2665":106736},[],"/docs/pr-preview/pr-54/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3170":64347,"_28017":64340,"_5":28357,"_19412":106738,"_25509":106739,"_2665":106740},[],"/docs/pr-preview/pr-54/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3170":64348,"_28017":64340,"_5":28357,"_19412":106742,"_25509":106743,"_2665":106744},[],"/docs/pr-preview/pr-54/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3170":64349,"_28017":64340,"_19412":106746,"_5":13306,"_25509":64340,"_2665":106747},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3170":64350,"_28017":64340,"_19412":106749,"_5":13306,"_25509":106719,"_2665":106750},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3170":64351,"_28017":64340,"_19412":106752,"_5":13306,"_25509":106719,"_2665":106753},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3170":64352,"_28017":64340,"_19412":106755,"_5":13306,"_25509":106719,"_2665":106756},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3170":64353,"_28017":64340,"_19412":106758,"_5":13306,"_25509":106723,"_2665":106759},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3170":64354,"_28017":64340,"_19412":106761,"_5":13306,"_25509":106723,"_2665":106762},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3170":64355,"_28017":64340,"_19412":106764,"_5":13306,"_25509":106723,"_2665":106765},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3170":64356,"_28017":64340,"_19412":106767,"_5":13306,"_25509":106727,"_2665":106768},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3170":64357,"_28017":64340,"_19412":106770,"_5":13306,"_25509":106731,"_2665":106771},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3170":64358,"_28017":64340,"_19412":106773,"_5":13306,"_25509":106735,"_2665":106774},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3170":64359,"_28017":64340,"_19412":106776,"_5":13306,"_25509":106739,"_2665":106777},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3170":64360,"_28017":64340,"_19412":106779,"_5":13306,"_25509":106743,"_2665":106780},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3170":64361,"_28017":64361,"_5":13637,"_2665":106782,"_28360":106783,"_19412":106784,"_25509":64361},"Despliega Lamassu",[45425,106711],[],{"_3170":64362,"_28017":64361,"_19412":106786,"_5":13306,"_25509":64361,"_2665":106787},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3170":64363,"_28017":64361,"_5":28357,"_19412":106789,"_25509":106790,"_2665":106791},[],"/docs/pr-preview/pr-54/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3170":64364,"_28017":64361,"_5":28357,"_19412":106793,"_25509":106794,"_2665":106795},[],"/docs/pr-preview/pr-54/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3170":64365,"_28017":64361,"_5":28357,"_19412":106797,"_25509":106798,"_2665":106799},[],"/docs/pr-preview/pr-54/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3170":64366,"_28017":64361,"_19412":106801,"_5":13306,"_25509":64361,"_2665":106802},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3170":64367,"_28017":64361,"_19412":106804,"_5":13306,"_25509":106790,"_2665":106805},[],"Modelo",{"_3170":64368,"_28017":64361,"_19412":106807,"_5":13306,"_25509":106790,"_2665":106808},[],"Recomendado para",{"_3170":64369,"_28017":64361,"_19412":106810,"_5":13306,"_25509":106790,"_2665":106811},[],"Quién opera la infraestructura",{"_3170":64370,"_28017":64361,"_19412":106813,"_5":13306,"_25509":106790,"_2665":106814},[],"Punto de partida",{"_3170":64371,"_28017":64361,"_19412":106816,"_5":13306,"_25509":106790,"_2665":45532},[],{"_3170":64372,"_28017":64361,"_19412":106818,"_5":13306,"_25509":106790,"_2665":106819},[],"Producción, entornos regulados y despliegues personalizados",{"_3170":64373,"_28017":64361,"_19412":106821,"_5":13306,"_25509":106790,"_2665":106822},[],"Tu equipo",{"_3170":64374,"_28017":64361,"_19412":106824,"_5":13306,"_25509":106790,"_2665":106825},[],"Helm o Fastlane",{"_3170":64375,"_28017":64361,"_19412":106827,"_5":13306,"_25509":106790,"_2665":45544},[],{"_3170":64376,"_28017":64361,"_19412":106829,"_5":13306,"_25509":106790,"_2665":106830},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3170":64377,"_28017":64361,"_19412":106832,"_5":13306,"_25509":106790,"_2665":106822},[],{"_3170":64378,"_28017":64361,"_19412":106834,"_5":13306,"_25509":106790,"_2665":106835},[],"Imagen preconfigurada en EC2",{"_3170":64379,"_28017":64361,"_19412":106837,"_5":13306,"_25509":106790,"_2665":45555},[],{"_3170":64380,"_28017":64361,"_19412":106839,"_5":13306,"_25509":106790,"_2665":106840},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3170":64381,"_28017":64361,"_19412":106842,"_5":13306,"_25509":106790,"_2665":45561},[],{"_3170":64382,"_28017":64361,"_19412":106844,"_5":13306,"_25509":106790,"_2665":106845},[],"Suscripción gestionada",{"_3170":64383,"_28017":64361,"_19412":106847,"_5":13306,"_25509":106790,"_2665":106848},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3170":64384,"_28017":64361,"_19412":106850,"_5":13306,"_25509":106790,"_2665":106851},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3170":64385,"_28017":64361,"_19412":106853,"_5":13306,"_25509":106790,"_2665":106854},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3170":64386,"_28017":64361,"_19412":106856,"_5":13306,"_25509":106794,"_2665":106857},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3170":64387,"_28017":64361,"_19412":106859,"_5":13306,"_25509":106798,"_2665":106860},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3170":64388,"_28017":64388,"_5":13637,"_2665":106862,"_28360":106863,"_19412":106864,"_25509":64388},"Utiliza Lamassu como SaaS",[45425,106711,106712],[],{"_3170":64389,"_28017":64388,"_19412":106866,"_5":13306,"_25509":64388,"_2665":106867},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3170":64390,"_28017":64388,"_5":28357,"_19412":106869,"_25509":106870,"_2665":106871},[],"/docs/pr-preview/pr-54/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3170":64391,"_28017":64388,"_5":28357,"_19412":106873,"_25509":106874,"_2665":106875},[],"/docs/pr-preview/pr-54/es/deployment/saas#planes","Planes",{"_3170":64392,"_28017":64388,"_5":28357,"_19412":106877,"_25509":106878,"_2665":106879},[],"/docs/pr-preview/pr-54/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3170":64393,"_28017":64388,"_19412":106881,"_5":13306,"_25509":64388,"_2665":106882},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3170":64394,"_28017":64388,"_19412":106884,"_5":13306,"_25509":106870,"_2665":106885},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3170":64395,"_28017":64388,"_19412":106887,"_5":13306,"_25509":106870,"_2665":106888},[],"Copias de seguridad automáticas.",{"_3170":64396,"_28017":64388,"_19412":106890,"_5":13306,"_25509":106870,"_2665":106891},[],"Actualizaciones de versión.",{"_3170":64397,"_28017":64388,"_19412":106893,"_5":13306,"_25509":106870,"_2665":106894},[],"Soporte técnico y SLA según el plan contratado.",{"_3170":64398,"_28017":64388,"_19412":106896,"_5":13306,"_25509":106874,"_2665":45616},[],{"_3170":64399,"_28017":64388,"_19412":106898,"_5":13306,"_25509":106874,"_2665":106899},[],"Dispositivos",{"_3170":64400,"_28017":64388,"_19412":106901,"_5":13306,"_25509":106874,"_2665":106902},[],"Soporte",{"_3170":64401,"_28017":64388,"_19412":106904,"_5":13306,"_25509":106874,"_2665":45625},[],{"_3170":64402,"_28017":64388,"_19412":106906,"_5":13306,"_25509":106874,"_2665":45628},[],{"_3170":64403,"_28017":64388,"_19412":106908,"_5":13306,"_25509":106874,"_2665":106909},[],"Hasta 1.000",{"_3170":64404,"_28017":64388,"_19412":106911,"_5":13306,"_25509":106874,"_2665":45634},[],{"_3170":64405,"_28017":64388,"_19412":106913,"_5":13306,"_25509":106874,"_2665":106914},[],"99,5 %",{"_3170":64406,"_28017":64388,"_19412":106916,"_5":13306,"_25509":106874,"_2665":45640},[],{"_3170":64407,"_28017":64388,"_19412":106918,"_5":13306,"_25509":106874,"_2665":106919},[],"Hasta 10.000",{"_3170":64408,"_28017":64388,"_19412":106921,"_5":13306,"_25509":106874,"_2665":106922},[],"Email y chat",{"_3170":64409,"_28017":64388,"_19412":106924,"_5":13306,"_25509":106874,"_2665":106925},[],"99,9 %",{"_3170":64410,"_28017":64388,"_19412":106927,"_5":13306,"_25509":106874,"_2665":45652},[],{"_3170":64411,"_28017":64388,"_19412":106929,"_5":13306,"_25509":106874,"_2665":106930},[],"Ilimitados",{"_3170":64412,"_28017":64388,"_19412":106932,"_5":13306,"_25509":106874,"_2665":106933},[],"Dedicado",{"_3170":64413,"_28017":64388,"_19412":106935,"_5":13306,"_25509":106874,"_2665":106936},[],"99,99 %",{"_3170":64414,"_28017":64388,"_19412":106938,"_5":13306,"_25509":106878,"_2665":106939},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3170":64415,"_28017":64388,"_19412":106941,"_5":13306,"_25509":106878,"_2665":106942},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3170":64416,"_28017":64416,"_5":13637,"_2665":45669,"_28360":106944,"_19412":106946,"_25509":64416},[45425,106711,106945],"Kubernetes autogestionado",[],{"_3170":64417,"_28017":64416,"_19412":106948,"_5":13306,"_25509":64416,"_2665":106949},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3170":64418,"_28017":64416,"_5":28357,"_19412":106951,"_25509":106952,"_2665":106953},[],"/docs/pr-preview/pr-54/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3170":64419,"_28017":64416,"_5":28357,"_19412":106955,"_25509":106956,"_2665":106957},[],"/docs/pr-preview/pr-54/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3170":64420,"_28017":64416,"_5":28357,"_19412":106959,"_25509":106960,"_2665":106961},[],"/docs/pr-preview/pr-54/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3170":64421,"_28017":64416,"_5":28357,"_19412":106963,"_25509":106964,"_2665":106965},[],"/docs/pr-preview/pr-54/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3170":64422,"_28017":64416,"_5":28357,"_19412":106967,"_25509":106968,"_2665":106969},[],"/docs/pr-preview/pr-54/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3170":64423,"_28017":64416,"_5":28357,"_19412":106971,"_25509":106972,"_2665":106973},[],"/docs/pr-preview/pr-54/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3170":64424,"_28017":64416,"_5":28357,"_19412":106975,"_25509":106976,"_2665":106977},[],"/docs/pr-preview/pr-54/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3170":64425,"_28017":64416,"_5":28357,"_19412":106979,"_25509":106980,"_2665":106981},[],"/docs/pr-preview/pr-54/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3170":64426,"_28017":64416,"_5":28357,"_19412":106983,"_25509":106984,"_2665":106985},[],"/docs/pr-preview/pr-54/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3170":64427,"_28017":64416,"_5":28357,"_19412":106987,"_25509":106988,"_2665":106989},[],"/docs/pr-preview/pr-54/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3170":64428,"_28017":64416,"_5":28357,"_19412":106991,"_25509":106992,"_2665":106993},[],"/docs/pr-preview/pr-54/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3170":64429,"_28017":64416,"_19412":106995,"_5":13306,"_25509":106952,"_2665":106996},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3170":64430,"_28017":64416,"_19412":106998,"_5":13306,"_25509":106952,"_2665":106999},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3170":64431,"_28017":64416,"_19412":107001,"_5":13306,"_25509":106956,"_2665":107002},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3170":64432,"_28017":64416,"_19412":107004,"_5":13306,"_25509":106956,"_2665":107005},[],"Fastlane instala o configura",{"_3170":64433,"_28017":64416,"_19412":107007,"_5":13306,"_25509":106956,"_2665":107008},[],"Tú sigues proporcionando",{"_3170":64434,"_28017":64416,"_19412":107010,"_5":13306,"_25509":106956,"_2665":107011},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3170":64435,"_28017":64416,"_19412":107013,"_5":13306,"_25509":106956,"_2665":107014},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3170":64436,"_28017":64416,"_19412":107016,"_5":13306,"_25509":106956,"_2665":107017},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3170":64437,"_28017":64416,"_19412":107019,"_5":13306,"_25509":106956,"_2665":107020},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3170":64438,"_28017":64416,"_19412":107022,"_5":13306,"_25509":106956,"_2665":107023},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_3170":64439,"_28017":64416,"_19412":107025,"_5":13306,"_25509":106956,"_2665":107026},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3170":64440,"_28017":64416,"_19412":107028,"_5":13306,"_25509":106956,"_2665":107029},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3170":64441,"_28017":64416,"_19412":107031,"_5":13306,"_25509":106956,"_2665":107032},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3170":64442,"_28017":64416,"_19412":107034,"_5":13306,"_25509":106956,"_2665":107035},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3170":64443,"_28017":64416,"_19412":107037,"_5":13306,"_25509":106960,"_2665":107038},[],"Necesitas:",{"_3170":64444,"_28017":64416,"_19412":107040,"_5":13306,"_25509":106960,"_2665":107041},[],"un clúster Kubernetes existente",{"_3170":64445,"_28017":64416,"_19412":107043,"_5":13306,"_25509":106960,"_2665":107044},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3170":64446,"_28017":64416,"_19412":107046,"_5":13306,"_25509":106960,"_2665":45771},[],{"_3170":64447,"_28017":64416,"_19412":107048,"_5":13306,"_25509":106960,"_2665":21988},[],{"_3170":64448,"_28017":64416,"_19412":107050,"_5":13306,"_25509":106960,"_2665":107051},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3170":64449,"_28017":64416,"_19412":107053,"_5":13306,"_25509":106960,"_2665":107054},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3170":64450,"_28017":64416,"_19412":107056,"_5":13306,"_25509":106960,"_2665":107057},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3170":64451,"_28017":64416,"_19412":107059,"_5":13306,"_25509":106960,"_2665":107060},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3170":64452,"_28017":64416,"_19412":107062,"_5":13306,"_25509":106960,"_2665":107063},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3170":64453,"_28017":64416,"_19412":107065,"_5":13306,"_25509":106964,"_2665":107066},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3170":64454,"_28017":64416,"_19412":107068,"_5":13306,"_25509":106964,"_2665":107069},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3170":64455,"_28017":64416,"_19412":107071,"_5":13306,"_25509":106968,"_2665":107072},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3170":64456,"_28017":64416,"_19412":107074,"_5":13306,"_25509":106968,"_2665":107075},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3170":64457,"_28017":64416,"_19412":107077,"_5":13306,"_25509":106968,"_2665":107078},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3170":64458,"_28017":64416,"_19412":107080,"_5":13306,"_25509":106968,"_2665":107081},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3170":64459,"_28017":64416,"_19412":107083,"_5":13306,"_25509":106972,"_2665":107084},[],"Opción",{"_3170":64460,"_28017":64416,"_19412":107086,"_5":13306,"_25509":106972,"_2665":107087},[],"Valor predeterminado",{"_3170":64461,"_28017":64416,"_19412":107089,"_5":13306,"_25509":106972,"_2665":107090},[],"Propósito",{"_3170":64462,"_28017":64416,"_19412":107092,"_5":13306,"_25509":106972,"_2665":45818},[],{"_3170":64463,"_28017":64416,"_19412":107094,"_5":13306,"_25509":106972,"_2665":45821},[],{"_3170":64464,"_28017":64416,"_19412":107096,"_5":13306,"_25509":106972,"_2665":107097},[],"Muestra la ayuda",{"_3170":64465,"_28017":64416,"_19412":107099,"_5":13306,"_25509":106972,"_2665":45827},[],{"_3170":64466,"_28017":64416,"_19412":107101,"_5":13306,"_25509":106972,"_2665":107102},[],"contexto actual",{"_3170":64467,"_28017":64416,"_19412":107104,"_5":13306,"_25509":106972,"_2665":107105},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3170":64468,"_28017":64416,"_19412":107107,"_5":13306,"_25509":106972,"_2665":45836},[],{"_3170":64469,"_28017":64416,"_19412":107109,"_5":13306,"_25509":106972,"_2665":5961},[],{"_3170":64470,"_28017":64416,"_19412":107111,"_5":13306,"_25509":106972,"_2665":107112},[],"Omite prompts y genera credenciales para las dependencias",{"_3170":64471,"_28017":64416,"_19412":107114,"_5":13306,"_25509":106972,"_2665":45844},[],{"_3170":64472,"_28017":64416,"_19412":107116,"_5":13306,"_25509":106972,"_2665":45847},[],{"_3170":64473,"_28017":64416,"_19412":107118,"_5":13306,"_25509":106972,"_2665":107119},[],"Namespace de la instalación",{"_3170":64474,"_28017":64416,"_19412":107121,"_5":13306,"_25509":106972,"_2665":45853},[],{"_3170":64475,"_28017":64416,"_19412":107123,"_5":13306,"_25509":106972,"_2665":45856},[],{"_3170":64476,"_28017":64416,"_19412":107125,"_5":13306,"_25509":106972,"_2665":107126},[],"Dominio usado por la UI, OIDC y el certificado",{"_3170":64477,"_28017":64416,"_19412":107128,"_5":13306,"_25509":106972,"_2665":45862},[],{"_3170":64478,"_28017":64416,"_19412":107130,"_5":13306,"_25509":106972,"_2665":13931},[],{"_3170":64479,"_28017":64416,"_19412":107132,"_5":13306,"_25509":106972,"_2665":107133},[],"Versión del chart de Lamassu",{"_3170":64480,"_28017":64416,"_19412":107135,"_5":13306,"_25509":106972,"_2665":45870},[],{"_3170":64481,"_28017":64416,"_19412":107137,"_5":13306,"_25509":106972,"_2665":45873},[],{"_3170":64482,"_28017":64416,"_19412":107139,"_5":13306,"_25509":106972,"_2665":107140},[],"Puerto del listener HTTPS",{"_3170":64483,"_28017":64416,"_19412":107142,"_5":13306,"_25509":106972,"_2665":45879},[],{"_3170":64484,"_28017":64416,"_19412":107144,"_5":13306,"_25509":106972,"_2665":45882},[],{"_3170":64485,"_28017":64416,"_19412":107146,"_5":13306,"_25509":106972,"_2665":107147},[],"Puerto del listener HTTP",{"_3170":64486,"_28017":64416,"_19412":107149,"_5":13306,"_25509":106972,"_2665":45888},[],{"_3170":64487,"_28017":64416,"_19412":107151,"_5":13306,"_25509":106972,"_2665":45821},[],{"_3170":64488,"_28017":64416,"_19412":107153,"_5":13306,"_25509":106972,"_2665":107154},[],"Certificado PEM para TLS downstream",{"_3170":64489,"_28017":64416,"_19412":107156,"_5":13306,"_25509":106972,"_2665":45896},[],{"_3170":64490,"_28017":64416,"_19412":107158,"_5":13306,"_25509":106972,"_2665":45821},[],{"_3170":64491,"_28017":64416,"_19412":107160,"_5":13306,"_25509":106972,"_2665":107161},[],"Clave privada PEM para TLS downstream",{"_3170":64492,"_28017":64416,"_19412":107163,"_5":13306,"_25509":106972,"_2665":45904},[],{"_3170":64493,"_28017":64416,"_19412":107165,"_5":13306,"_25509":106972,"_2665":107166},[],"chart del repositorio",{"_3170":64494,"_28017":64416,"_19412":107168,"_5":13306,"_25509":106972,"_2665":107169},[],"Usa un chart local de Lamassu sin empaquetar",{"_3170":64495,"_28017":64416,"_19412":107171,"_5":13306,"_25509":106972,"_2665":45913},[],{"_3170":64496,"_28017":64416,"_19412":107173,"_5":13306,"_25509":106972,"_2665":107174},[],"detección automática",{"_3170":64497,"_28017":64416,"_19412":107176,"_5":13306,"_25509":106972,"_2665":107177},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3170":64498,"_28017":64416,"_19412":107179,"_5":13306,"_25509":106972,"_2665":45921},[],{"_3170":64499,"_28017":64416,"_19412":107181,"_5":13306,"_25509":106972,"_2665":5961},[],{"_3170":64500,"_28017":64416,"_19412":107183,"_5":13306,"_25509":106972,"_2665":107184},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3170":64501,"_28017":64416,"_19412":107186,"_5":13306,"_25509":106972,"_2665":45929},[],{"_3170":64502,"_28017":64416,"_19412":107188,"_5":13306,"_25509":106972,"_2665":5961},[],{"_3170":64503,"_28017":64416,"_19412":107190,"_5":13306,"_25509":106972,"_2665":107191},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3170":64504,"_28017":64416,"_19412":107193,"_5":13306,"_25509":106972,"_2665":45937},[],{"_3170":64505,"_28017":64416,"_19412":107195,"_5":13306,"_25509":106972,"_2665":5961},[],{"_3170":64506,"_28017":64416,"_19412":107197,"_5":13306,"_25509":106972,"_2665":107198},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3170":64507,"_28017":64416,"_19412":107200,"_5":13306,"_25509":106972,"_2665":45945},[],{"_3170":64508,"_28017":64416,"_19412":107202,"_5":13306,"_25509":106972,"_2665":5961},[],{"_3170":64509,"_28017":64416,"_19412":107204,"_5":13306,"_25509":106972,"_2665":107205},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3170":64510,"_28017":64416,"_19412":107207,"_5":13306,"_25509":106972,"_2665":45953},[],{"_3170":64511,"_28017":64416,"_19412":107209,"_5":13306,"_25509":106972,"_2665":45956},[],{"_3170":64512,"_28017":64416,"_19412":107211,"_5":13306,"_25509":106972,"_2665":107212},[],"Usa otro chart local de SoftHSM",{"_3170":64513,"_28017":64416,"_19412":107214,"_5":13306,"_25509":106972,"_2665":107215},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3170":64514,"_28017":64416,"_19412":107217,"_5":13306,"_25509":106976,"_2665":107218},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3170":64515,"_28017":64416,"_19412":107220,"_5":13306,"_25509":106976,"_2665":107221},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3170":64516,"_28017":64416,"_19412":107223,"_5":13306,"_25509":106976,"_2665":107224},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3170":64517,"_28017":64416,"_19412":107226,"_5":13306,"_25509":106976,"_2665":107227},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3170":64518,"_28017":64416,"_19412":107229,"_5":13306,"_25509":106976,"_2665":107230},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3170":64519,"_28017":64416,"_19412":107232,"_5":13306,"_25509":106976,"_2665":107233},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3170":64520,"_28017":64416,"_19412":107235,"_5":13306,"_25509":106980,"_2665":45983},[],{"_3170":64521,"_28017":64416,"_19412":107237,"_5":13306,"_25509":106980,"_2665":107238},[],"valida las herramientas locales y el clúster seleccionado",{"_3170":64522,"_28017":64416,"_19412":107240,"_5":13306,"_25509":106980,"_2665":107241},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3170":64523,"_28017":64416,"_19412":107243,"_5":13306,"_25509":106980,"_2665":107244},[],"crea el namespace",{"_3170":64524,"_28017":64416,"_19412":107246,"_5":13306,"_25509":106980,"_2665":107247},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3170":64525,"_28017":64416,"_19412":107249,"_5":13306,"_25509":106980,"_2665":107250},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3170":64526,"_28017":64416,"_19412":107252,"_5":13306,"_25509":106980,"_2665":107253},[],"instala RabbitMQ",{"_3170":64527,"_28017":64416,"_19412":107255,"_5":13306,"_25509":106980,"_2665":107256},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3170":64528,"_28017":64416,"_19412":107258,"_5":13306,"_25509":106980,"_2665":107259},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_3170":64529,"_28017":64416,"_19412":107261,"_5":13306,"_25509":106980,"_2665":107262},[],"carga datos de ejemplo opcionalmente",{"_3170":64530,"_28017":64416,"_19412":107264,"_5":13306,"_25509":106980,"_2665":107265},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3170":64531,"_28017":64416,"_19412":107267,"_5":13306,"_25509":106984,"_2665":107268},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3170":64532,"_28017":64416,"_19412":107270,"_5":13306,"_25509":106984,"_2665":107271},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3170":64533,"_28017":64416,"_19412":107273,"_5":13306,"_25509":106988,"_2665":107274},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3170":64534,"_28017":64416,"_19412":107276,"_5":13306,"_25509":106988,"_2665":107277},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_3170":64535,"_28017":64416,"_19412":107279,"_5":13306,"_25509":106988,"_2665":107280},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3170":64536,"_28017":64416,"_19412":107282,"_5":13306,"_25509":106992,"_2665":107283},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3170":64537,"_28017":64537,"_5":13637,"_2665":107285,"_28360":107286,"_19412":107287,"_25509":64537},"Instala con Helm",[45425,106711,106945],[],{"_3170":64538,"_28017":64537,"_19412":107289,"_5":13306,"_25509":64537,"_2665":107290},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3170":64539,"_28017":64537,"_5":28357,"_19412":107292,"_25509":107293,"_2665":107294},[],"/docs/pr-preview/pr-54/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3170":64540,"_28017":64537,"_5":28357,"_19412":107296,"_25509":107297,"_2665":106961},[],"/docs/pr-preview/pr-54/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3170":64541,"_28017":64537,"_5":28357,"_19412":107299,"_25509":107300,"_2665":107301},[],"/docs/pr-preview/pr-54/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3170":64542,"_28017":64537,"_5":28357,"_19412":107303,"_25509":107304,"_2665":107305},[],"/docs/pr-preview/pr-54/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3170":64543,"_28017":64537,"_5":28357,"_19412":107307,"_25509":107308,"_2665":107309},[],"/docs/pr-preview/pr-54/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3170":64544,"_28017":64537,"_5":28357,"_19412":107311,"_25509":107312,"_2665":107313},[],"/docs/pr-preview/pr-54/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3170":64545,"_28017":64537,"_5":28357,"_19412":107315,"_25509":107316,"_2665":107317},[],"/docs/pr-preview/pr-54/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3170":64546,"_28017":64537,"_5":28357,"_19412":107319,"_25509":107320,"_2665":107321},[],"/docs/pr-preview/pr-54/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3170":64547,"_28017":64537,"_5":28357,"_19412":107323,"_25509":107324,"_2665":107325},[],"/docs/pr-preview/pr-54/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3170":64548,"_28017":64537,"_19412":107327,"_5":13306,"_25509":107293,"_2665":107328},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3170":64549,"_28017":64537,"_19412":107330,"_5":13306,"_25509":107297,"_2665":107331},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3170":64550,"_28017":64537,"_19412":107333,"_5":13306,"_25509":107297,"_2665":107334},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3170":64551,"_28017":64537,"_19412":107336,"_5":13306,"_25509":107297,"_2665":107337},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3170":64552,"_28017":64537,"_19412":107339,"_5":13306,"_25509":107297,"_2665":107340},[],"un broker RabbitMQ accesible y sus credenciales",{"_3170":64553,"_28017":64537,"_19412":107342,"_5":13306,"_25509":107297,"_2665":107343},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3170":64554,"_28017":64537,"_19412":107345,"_5":13306,"_25509":107297,"_2665":107346},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3170":64555,"_28017":64537,"_19412":107348,"_5":13306,"_25509":107297,"_2665":107349},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3170":64556,"_28017":64537,"_19412":107351,"_5":13306,"_25509":107297,"_2665":107352},[],"una StorageClass y un diseño de tráfico externo",{"_3170":64557,"_28017":64537,"_19412":107354,"_5":13306,"_25509":107297,"_2665":107355},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3170":64558,"_28017":64537,"_19412":107357,"_5":13306,"_25509":107297,"_2665":107358},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3170":64559,"_28017":64537,"_19412":107360,"_5":13306,"_25509":107297,"_2665":107361},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3170":64560,"_28017":64537,"_19412":107363,"_5":13306,"_25509":107300,"_2665":107364},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3170":64561,"_28017":64537,"_19412":107366,"_5":13306,"_25509":107300,"_2665":107367},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3170":64562,"_28017":64537,"_19412":107369,"_5":13306,"_25509":107300,"_2665":107370},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_3170":64563,"_28017":64537,"_19412":107372,"_5":13306,"_25509":107304,"_2665":107373},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3170":64564,"_28017":64537,"_19412":107375,"_5":13306,"_25509":107304,"_2665":107376},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3170":64565,"_28017":64537,"_19412":107378,"_5":13306,"_25509":107304,"_2665":107379},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3170":64566,"_28017":64537,"_19412":107381,"_5":13306,"_25509":107308,"_2665":107382},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_3170":64567,"_28017":64537,"_19412":107384,"_5":13306,"_25509":107312,"_2665":107385},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3170":64568,"_28017":64537,"_19412":107387,"_5":13306,"_25509":107312,"_2665":107388},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3170":64569,"_28017":64537,"_19412":107390,"_5":13306,"_25509":107312,"_2665":107391},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3170":64570,"_28017":64537,"_19412":107393,"_5":13306,"_25509":107312,"_2665":107394},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3170":64571,"_28017":64537,"_19412":107396,"_5":13306,"_25509":107316,"_2665":107397},[],"Para instalar un checkout local:",{"_3170":64572,"_28017":64537,"_19412":107399,"_5":13306,"_25509":107320,"_2665":107400},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3170":64573,"_28017":64537,"_19412":107402,"_5":13306,"_25509":107320,"_2665":107403},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3170":64574,"_28017":64537,"_19412":107405,"_5":13306,"_25509":107324,"_2665":107406},[],"Antes de pasar a producción, revisa:",{"_3170":64575,"_28017":64537,"_19412":107408,"_5":13306,"_25509":107324,"_2665":107409},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3170":64576,"_28017":64537,"_19412":107411,"_5":13306,"_25509":107324,"_2665":107412},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3170":64577,"_28017":64537,"_19412":107414,"_5":13306,"_25509":107324,"_2665":107415},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3170":64578,"_28017":64537,"_19412":107417,"_5":13306,"_25509":107324,"_2665":107418},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3170":64579,"_28017":64537,"_19412":107420,"_5":13306,"_25509":107324,"_2665":107421},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3170":64580,"_28017":64537,"_19412":107423,"_5":13306,"_25509":107324,"_2665":107424},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3170":64581,"_28017":64537,"_19412":107426,"_5":13306,"_25509":107324,"_2665":107427},[],"SMTP, observabilidad y entrega de alertas",{"_3170":64582,"_28017":64537,"_19412":107429,"_5":13306,"_25509":107324,"_2665":107430},[],"las guías de actualización entre versiones y las notas de `charts/lamassu/CHANGELOG/` antes de cada upgrade",{"_3170":64583,"_28017":64537,"_19412":107432,"_5":13306,"_25509":107324,"_2665":107433},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3170":64584,"_28017":64584,"_5":13637,"_2665":107435,"_28360":107436,"_19412":107437,"_25509":64584},"Expón el Gateway",[45425,106711,106945],[],{"_3170":64585,"_28017":64584,"_19412":107439,"_5":13306,"_25509":64584,"_2665":107440},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3170":64586,"_28017":64584,"_5":28357,"_19412":107442,"_25509":107443,"_2665":107444},[],"/docs/pr-preview/pr-54/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3170":64587,"_28017":64584,"_5":28357,"_19412":107446,"_25509":107447,"_2665":107448},[],"/docs/pr-preview/pr-54/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3170":64588,"_28017":64584,"_5":28357,"_19412":107450,"_25509":107451,"_2665":107452},[],"/docs/pr-preview/pr-54/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3170":64589,"_28017":64584,"_5":28357,"_19412":107454,"_25509":107455,"_2665":46204},[],"/docs/pr-preview/pr-54/es/deployment/self-hosted/networking#k3s",{"_3170":64590,"_28017":64584,"_5":28357,"_19412":107457,"_25509":107458,"_2665":107459},[],"/docs/pr-preview/pr-54/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3170":64591,"_28017":64584,"_5":28357,"_19412":107461,"_25509":107462,"_2665":107463},[],"/docs/pr-preview/pr-54/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3170":64592,"_28017":64584,"_5":28357,"_19412":107465,"_25509":107466,"_2665":107467},[],"/docs/pr-preview/pr-54/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3170":64593,"_28017":64584,"_5":28357,"_19412":107469,"_25509":107470,"_2665":107471},[],"/docs/pr-preview/pr-54/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3170":64594,"_28017":64584,"_5":28357,"_19412":107473,"_25509":107474,"_2665":107475},[],"/docs/pr-preview/pr-54/es/deployment/self-hosted/networking#proxy-de-salida","Proxy de salida",{"_3170":64595,"_28017":64584,"_5":28357,"_19412":107477,"_25509":107478,"_2665":107479},[],"/docs/pr-preview/pr-54/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3170":64596,"_28017":64584,"_19412":107481,"_5":13306,"_25509":107443,"_2665":107482},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3170":64597,"_28017":64584,"_19412":107484,"_5":13306,"_25509":107443,"_2665":107485},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3170":64598,"_28017":64584,"_19412":107487,"_5":13306,"_25509":107447,"_2665":107488},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3170":64599,"_28017":64584,"_19412":107490,"_5":13306,"_25509":107447,"_2665":107491},[],"Defínelo únicamente cuando:",{"_3170":64600,"_28017":64584,"_19412":107493,"_5":13306,"_25509":107447,"_2665":107494},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3170":64601,"_28017":64584,"_19412":107496,"_5":13306,"_25509":107447,"_2665":107497},[],"esa dirección está asignada a este Gateway",{"_3170":64602,"_28017":64584,"_19412":107499,"_5":13306,"_25509":107447,"_2665":107500},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3170":64603,"_28017":64584,"_19412":107502,"_5":13306,"_25509":107447,"_2665":107503},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3170":64604,"_28017":64584,"_19412":107505,"_5":13306,"_25509":107447,"_2665":107506},[],"No confundas estos valores:",{"_3170":64605,"_28017":64584,"_19412":107508,"_5":13306,"_25509":107447,"_2665":107509},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3170":64606,"_28017":64584,"_19412":107511,"_5":13306,"_25509":107447,"_2665":107512},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3170":64607,"_28017":64584,"_19412":107514,"_5":13306,"_25509":107447,"_2665":107515},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3170":64608,"_28017":64584,"_19412":107517,"_5":13306,"_25509":107451,"_2665":107518},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3170":64609,"_28017":64584,"_19412":107520,"_5":13306,"_25509":107451,"_2665":107521},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3170":64610,"_28017":64584,"_19412":107523,"_5":13306,"_25509":107455,"_2665":107524},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3170":64611,"_28017":64584,"_19412":107526,"_5":13306,"_25509":107455,"_2665":107527},[],"Para el diseño recomendado:",{"_3170":64612,"_28017":64584,"_19412":107529,"_5":13306,"_25509":107455,"_2665":107530},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3170":64613,"_28017":64584,"_19412":107532,"_5":13306,"_25509":107455,"_2665":107533},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3170":64614,"_28017":64584,"_19412":107535,"_5":13306,"_25509":107455,"_2665":107536},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3170":64615,"_28017":64584,"_19412":107538,"_5":13306,"_25509":107455,"_2665":107539},[],"Apunta DNS a la dirección accesible de la VM.",{"_3170":64616,"_28017":64584,"_19412":107541,"_5":13306,"_25509":107455,"_2665":107542},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3170":64617,"_28017":64584,"_19412":107544,"_5":13306,"_25509":107458,"_2665":107545},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3170":64618,"_28017":64584,"_19412":107547,"_5":13306,"_25509":107462,"_2665":107548},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3170":64619,"_28017":64584,"_19412":107550,"_5":13306,"_25509":107462,"_2665":107551},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3170":64620,"_28017":64584,"_19412":107553,"_5":13306,"_25509":107466,"_2665":107554},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3170":64621,"_28017":64584,"_19412":107556,"_5":13306,"_25509":107466,"_2665":107557},[],"Requisito",{"_3170":64622,"_28017":64584,"_19412":107559,"_5":13306,"_25509":107466,"_2665":107560},[],"Diseño recomendado",{"_3170":64623,"_28017":64584,"_19412":107562,"_5":13306,"_25509":107466,"_2665":107563},[],"Consecuencia",{"_3170":64624,"_28017":64584,"_19412":107565,"_5":13306,"_25509":107466,"_2665":107566},[],"Varias URL o servicios de Lamassu",{"_3170":64625,"_28017":64584,"_19412":107568,"_5":13306,"_25509":107466,"_2665":107569},[],"Un Gateway con varias rutas",{"_3170":64626,"_28017":64584,"_19412":107571,"_5":13306,"_25509":107466,"_2665":107572},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3170":64627,"_28017":64584,"_19412":107574,"_5":13306,"_25509":107466,"_2665":107575},[],"Gateways independientes e IP externas distintas",{"_3170":64628,"_28017":64584,"_19412":107577,"_5":13306,"_25509":107466,"_2665":107578},[],"Una VIP por Gateway",{"_3170":64629,"_28017":64584,"_19412":107580,"_5":13306,"_25509":107466,"_2665":107581},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3170":64630,"_28017":64584,"_19412":107583,"_5":13306,"_25509":107466,"_2665":107584},[],"Gateways independientes, un nodo y una IP",{"_3170":64631,"_28017":64584,"_19412":107586,"_5":13306,"_25509":107466,"_2665":107587},[],"Puertos externos diferentes",{"_3170":64632,"_28017":64584,"_19412":107589,"_5":13306,"_25509":107466,"_2665":107590},[],"Los clientes deben indicar puertos no estándar",{"_3170":64633,"_28017":64584,"_19412":107592,"_5":13306,"_25509":107466,"_2665":107593},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3170":64634,"_28017":64584,"_19412":107595,"_5":13306,"_25509":107466,"_2665":107596},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3170":64635,"_28017":64584,"_19412":107598,"_5":13306,"_25509":107466,"_2665":107599},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3170":64636,"_28017":64584,"_19412":107601,"_5":13306,"_25509":107466,"_2665":107602},[],"Recursos Gateway separados pero proxy compartido",{"_3170":64637,"_28017":64584,"_19412":107604,"_5":13306,"_25509":107466,"_2665":107605},[],"Modo merged Gateway de Envoy",{"_3170":64638,"_28017":64584,"_19412":107607,"_5":13306,"_25509":107466,"_2665":107608},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3170":64639,"_28017":64584,"_19412":107610,"_5":13306,"_25509":107466,"_2665":107611},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3170":64640,"_28017":64584,"_19412":107613,"_5":13306,"_25509":107466,"_2665":107614},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3170":64641,"_28017":64584,"_19412":107616,"_5":13306,"_25509":107466,"_2665":107617},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3170":64642,"_28017":64584,"_19412":107619,"_5":13306,"_25509":107466,"_2665":107620},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3170":64643,"_28017":64584,"_19412":107622,"_5":13306,"_25509":107470,"_2665":107623},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3170":64644,"_28017":64584,"_19412":107625,"_5":13306,"_25509":107470,"_2665":107626},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3170":64645,"_28017":64584,"_19412":107628,"_5":13306,"_25509":107470,"_2665":107629},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3170":64646,"_28017":64584,"_19412":107631,"_5":13306,"_25509":107470,"_2665":107632},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3170":64647,"_28017":64584,"_19412":107634,"_5":13306,"_25509":107470,"_2665":107635},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3170":64648,"_28017":64584,"_19412":107637,"_5":13306,"_25509":107474,"_2665":107638},[],"Los clientes internos de Lamassu — la conexión con el motor de Vault, las llamadas entre servicios y los webhooks salientes — respetan las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY`. La excepción es el conector del motor de autorización: usa su propio transporte y no consulta estas variables de proxy. Si tu despliegue enruta el tráfico de salida por un proxy, incluye los nombres de servicio internos del clúster en `NO_PROXY` (por ejemplo `.svc,.cluster.local`) para que el tráfico interno permanezca dentro del clúster. El tráfico de loopback nunca se envía por un proxy.",{"_3170":64649,"_28017":64584,"_19412":107640,"_5":13306,"_25509":107474,"_2665":107641},[],"El transporte predeterminado de estos clientes acota el timeout de conexión (30 segundos), el handshake TLS (10 segundos) y la reutilización de conexiones inactivas (90 segundos), de modo que una dependencia inalcanzable falla rápido en lugar de bloquearse; estos valores son los predeterminados del transporte de Go, no configuración de Lamassu. HTTP/2 se negocia cuando el otro extremo lo soporta. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada.",{"_3170":64650,"_28017":64584,"_19412":107643,"_5":13306,"_25509":107478,"_2665":107644},[],"Comprueba, en orden:",{"_3170":64651,"_28017":64584,"_19412":107646,"_5":13306,"_25509":107478,"_2665":107647},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3170":64652,"_28017":64584,"_19412":107649,"_5":13306,"_25509":107478,"_2665":107650},[],"Su estado contiene la dirección esperada.",{"_3170":64653,"_28017":64584,"_19412":107652,"_5":13306,"_25509":107478,"_2665":107653},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3170":64654,"_28017":64584,"_19412":107655,"_5":13306,"_25509":107478,"_2665":107656},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3170":64655,"_28017":64584,"_19412":107658,"_5":13306,"_25509":107478,"_2665":107659},[],"DNS resuelve al endpoint accesible externamente.",{"_3170":64656,"_28017":64584,"_19412":107661,"_5":13306,"_25509":107478,"_2665":107662},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3170":64657,"_28017":64584,"_19412":107664,"_5":13306,"_25509":107478,"_2665":107665},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3170":64658,"_28017":64658,"_5":13637,"_2665":45532,"_28360":107667,"_19412":107668,"_25509":64658},[45425,106711,106945],[],{"_3170":64659,"_28017":64658,"_19412":107670,"_5":13306,"_25509":64658,"_2665":107671},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3170":64660,"_28017":64658,"_5":28357,"_19412":107673,"_25509":107674,"_2665":107675},[],"/docs/pr-preview/pr-54/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3170":64661,"_28017":64658,"_5":28357,"_19412":107677,"_25509":107678,"_2665":107679},[],"/docs/pr-preview/pr-54/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3170":64662,"_28017":64658,"_5":28357,"_19412":107681,"_25509":107682,"_2665":107683},[],"/docs/pr-preview/pr-54/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3170":64663,"_28017":64658,"_5":28357,"_19412":107685,"_25509":107686,"_2665":107687},[],"/docs/pr-preview/pr-54/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3170":64664,"_28017":64658,"_5":28357,"_19412":107689,"_25509":107690,"_2665":107691},[],"/docs/pr-preview/pr-54/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3170":64665,"_28017":64658,"_5":28357,"_19412":107693,"_25509":107694,"_2665":107695},[],"/docs/pr-preview/pr-54/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3170":64666,"_28017":64658,"_19412":107697,"_5":13306,"_25509":107674,"_2665":107698},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3170":64667,"_28017":64658,"_19412":107700,"_5":13306,"_25509":107678,"_2665":107701},[],"Flujo",{"_3170":64668,"_28017":64658,"_19412":107703,"_5":13306,"_25509":107678,"_2665":107704},[],"Úsalo para",{"_3170":64669,"_28017":64658,"_19412":107706,"_5":13306,"_25509":107678,"_2665":107707},[],"Qué instala",{"_3170":64670,"_28017":64658,"_19412":107709,"_5":13306,"_25509":107678,"_2665":46459},[],{"_3170":64671,"_28017":64658,"_19412":107711,"_5":13306,"_25509":107678,"_2665":107712},[],"Producción y entornos controlados",{"_3170":64672,"_28017":64658,"_19412":107714,"_5":13306,"_25509":107678,"_2665":107715},[],"Servicios de Lamassu y recursos de Gateway API",{"_3170":64673,"_28017":64658,"_19412":107717,"_5":13306,"_25509":107678,"_2665":45669},[],{"_3170":64674,"_28017":64658,"_19412":107719,"_5":13306,"_25509":107678,"_2665":107720},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3170":64675,"_28017":64658,"_19412":107722,"_5":13306,"_25509":107678,"_2665":107723},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3170":64676,"_28017":64658,"_19412":107725,"_5":13306,"_25509":107682,"_2665":107726},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3170":64677,"_28017":64658,"_19412":107728,"_5":13306,"_25509":107682,"_2665":107729},[],"Área",{"_3170":64678,"_28017":64658,"_19412":107731,"_5":13306,"_25509":107682,"_2665":107732},[],"El chart de Lamassu proporciona",{"_3170":64679,"_28017":64658,"_19412":107734,"_5":13306,"_25509":107682,"_2665":107735},[],"Tú proporcionas",{"_3170":64680,"_28017":64658,"_19412":107737,"_5":13306,"_25509":107682,"_2665":107738},[],"Aplicaciones Lamassu",{"_3170":64681,"_28017":64658,"_19412":107740,"_5":13306,"_25509":107682,"_2665":107741},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3170":64682,"_28017":64658,"_19412":107743,"_5":13306,"_25509":107682,"_2665":107744},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3170":64683,"_28017":64658,"_19412":107746,"_5":13306,"_25509":107682,"_2665":107747},[],"Datos PostgreSQL",{"_3170":64684,"_28017":64658,"_19412":107749,"_5":13306,"_25509":107682,"_2665":107750},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3170":64685,"_28017":64658,"_19412":107752,"_5":13306,"_25509":107682,"_2665":107753},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3170":64686,"_28017":64658,"_19412":107755,"_5":13306,"_25509":107682,"_2665":107756},[],"Mensajería",{"_3170":64687,"_28017":64658,"_19412":107758,"_5":13306,"_25509":107682,"_2665":107759},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu",{"_3170":64688,"_28017":64658,"_19412":107761,"_5":13306,"_25509":107682,"_2665":107762},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3170":64689,"_28017":64658,"_19412":107764,"_5":13306,"_25509":107682,"_2665":107765},[],"Identidad",{"_3170":64690,"_28017":64658,"_19412":107767,"_5":13306,"_25509":107682,"_2665":107768},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3170":64691,"_28017":64658,"_19412":107770,"_5":13306,"_25509":107682,"_2665":107771},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3170":64692,"_28017":64658,"_19412":107773,"_5":13306,"_25509":107682,"_2665":107774},[],"Enrutamiento externo",{"_3170":64693,"_28017":64658,"_19412":107776,"_5":13306,"_25509":107682,"_2665":107777},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3170":64694,"_28017":64658,"_19412":107779,"_5":13306,"_25509":107682,"_2665":107780},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3170":64695,"_28017":64658,"_19412":107782,"_5":13306,"_25509":107682,"_2665":46533},[],{"_3170":64696,"_28017":64658,"_19412":107784,"_5":13306,"_25509":107682,"_2665":107785},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_3170":64697,"_28017":64658,"_19412":107787,"_5":13306,"_25509":107682,"_2665":107788},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3170":64698,"_28017":64658,"_19412":107790,"_5":13306,"_25509":107682,"_2665":107791},[],"Datos persistentes de la aplicación",{"_3170":64699,"_28017":64658,"_19412":107793,"_5":13306,"_25509":107682,"_2665":107794},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3170":64700,"_28017":64658,"_19412":107796,"_5":13306,"_25509":107682,"_2665":107797},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3170":64701,"_28017":64658,"_19412":107799,"_5":13306,"_25509":107682,"_2665":107800},[],"Integraciones opcionales",{"_3170":64702,"_28017":64658,"_19412":107802,"_5":13306,"_25509":107682,"_2665":107803},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3170":64703,"_28017":64658,"_19412":107805,"_5":13306,"_25509":107682,"_2665":107806},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3170":64704,"_28017":64658,"_19412":107808,"_5":13306,"_25509":107682,"_2665":107809},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3170":64705,"_28017":64658,"_19412":107811,"_5":13306,"_25509":107682,"_2665":107812},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3170":64706,"_28017":64658,"_19412":107814,"_5":13306,"_25509":107686,"_2665":107815},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3170":64707,"_28017":64658,"_19412":107817,"_5":13306,"_25509":107686,"_2665":107818},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3170":64708,"_28017":64658,"_19412":107820,"_5":13306,"_25509":107690,"_2665":107821},[],"Kubernetes 1.24 o posterior",{"_3170":64709,"_28017":64658,"_19412":107823,"_5":13306,"_25509":107690,"_2665":107824},[],"Helm 3.2 o posterior",{"_3170":64710,"_28017":64658,"_19412":107826,"_5":13306,"_25509":107690,"_2665":107827},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3170":64711,"_28017":64658,"_19412":107829,"_5":13306,"_25509":107690,"_2665":107830},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_3170":64712,"_28017":64658,"_19412":107832,"_5":13306,"_25509":107690,"_2665":107833},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3170":64713,"_28017":64658,"_19412":107835,"_5":13306,"_25509":107690,"_2665":107836},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3170":64714,"_28017":64658,"_19412":107838,"_5":13306,"_25509":107690,"_2665":107839},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3170":64715,"_28017":64658,"_19412":107841,"_5":13306,"_25509":107694,"_2665":107842},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3170":64716,"_28017":64658,"_19412":107844,"_5":13306,"_25509":107694,"_2665":107845},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3170":64717,"_28017":64658,"_19412":107847,"_5":13306,"_25509":107694,"_2665":107848},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3170":64718,"_28017":64658,"_19412":107850,"_5":13306,"_25509":107694,"_2665":107851},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3170":64719,"_28017":64719,"_5":13637,"_2665":107853,"_28360":107854,"_19412":107856,"_25509":64719},"Resolución de problemas de despliegue",[45425,106711,107855],"Operación",[],{"_3170":64720,"_28017":64719,"_19412":107858,"_5":13306,"_25509":64719,"_2665":107859},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3170":64721,"_28017":64719,"_5":28357,"_19412":107861,"_25509":107862,"_2665":107863},[],"/docs/pr-preview/pr-54/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3170":64722,"_28017":64719,"_5":28357,"_19412":107865,"_25509":107866,"_2665":107867},[],"/docs/pr-preview/pr-54/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3170":64723,"_28017":64719,"_5":28357,"_19412":107869,"_25509":107870,"_2665":107871},[],"/docs/pr-preview/pr-54/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3170":64724,"_28017":64719,"_5":28357,"_19412":107873,"_25509":107874,"_2665":107875},[],"/docs/pr-preview/pr-54/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3170":64725,"_28017":64719,"_5":28357,"_19412":107877,"_25509":107878,"_2665":107879},[],"/docs/pr-preview/pr-54/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3170":64726,"_28017":64719,"_5":28357,"_19412":107881,"_25509":107882,"_2665":107883},[],"/docs/pr-preview/pr-54/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3170":64727,"_28017":64719,"_5":28357,"_19412":107885,"_25509":107886,"_2665":107887},[],"/docs/pr-preview/pr-54/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3170":64728,"_28017":64719,"_5":28357,"_19412":107889,"_25509":107890,"_2665":107891},[],"/docs/pr-preview/pr-54/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3170":64729,"_28017":64719,"_5":28357,"_19412":107893,"_25509":107894,"_2665":107895},[],"/docs/pr-preview/pr-54/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3170":64730,"_28017":64719,"_5":28357,"_19412":107897,"_25509":107898,"_2665":107899},[],"/docs/pr-preview/pr-54/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3170":64731,"_28017":64719,"_5":28357,"_19412":107901,"_25509":107902,"_2665":107903},[],"/docs/pr-preview/pr-54/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3170":64732,"_28017":64719,"_5":28357,"_19412":107905,"_25509":107906,"_2665":107907},[],"/docs/pr-preview/pr-54/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3170":64733,"_28017":64719,"_19412":107909,"_5":13306,"_25509":64719,"_2665":107910},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3170":64734,"_28017":64719,"_19412":107912,"_5":13306,"_25509":107866,"_2665":107913},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3170":64735,"_28017":64719,"_19412":107915,"_5":13306,"_25509":107870,"_2665":107916},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3170":64736,"_28017":64719,"_19412":107918,"_5":13306,"_25509":107874,"_2665":107919},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3170":64737,"_28017":64719,"_19412":107921,"_5":13306,"_25509":107878,"_2665":107922},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3170":64738,"_28017":64719,"_19412":107924,"_5":13306,"_25509":107882,"_2665":107925},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3170":64739,"_28017":64719,"_19412":107927,"_5":13306,"_25509":107886,"_2665":107928},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3170":64740,"_28017":64719,"_19412":107930,"_5":13306,"_25509":107886,"_2665":107931},[],"Ejecuta también la prueba de conectividad del chart:",{"_3170":64741,"_28017":64719,"_19412":107933,"_5":13306,"_25509":107886,"_2665":107934},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3170":64742,"_28017":64719,"_19412":107936,"_5":13306,"_25509":107886,"_2665":107937},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3170":64743,"_28017":64719,"_19412":107939,"_5":13306,"_25509":107890,"_2665":107940},[],"Si recibes un 401:",{"_3170":64744,"_28017":64719,"_19412":107942,"_5":13306,"_25509":107890,"_2665":107943},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3170":64745,"_28017":64719,"_19412":107945,"_5":13306,"_25509":107890,"_2665":107946},[],"verifica emisor, audiencia y expiración del token;",{"_3170":64746,"_28017":64719,"_19412":107948,"_5":13306,"_25509":107890,"_2665":107949},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3170":64747,"_28017":64719,"_19412":107951,"_5":13306,"_25509":107890,"_2665":107952},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3170":64748,"_28017":64719,"_19412":107954,"_5":13306,"_25509":107890,"_2665":107955},[],"Si el login termina pero las APIs devuelven 403:",{"_3170":64749,"_28017":64719,"_19412":107957,"_5":13306,"_25509":107890,"_2665":107958},[],"inspecciona los claims reales del token;",{"_3170":64750,"_28017":64719,"_19412":107960,"_5":13306,"_25509":107890,"_2665":107961},[],"confirma que coinciden con un principal activo;",{"_3170":64751,"_28017":64719,"_19412":107963,"_5":13306,"_25509":107890,"_2665":107964},[],"revisa las políticas concedidas al principal;",{"_3170":64752,"_28017":64719,"_19412":107966,"_5":13306,"_25509":107890,"_2665":107967},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3170":64753,"_28017":64719,"_19412":107969,"_5":13306,"_25509":107890,"_2665":107970},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3170":64754,"_28017":64719,"_19412":107972,"_5":13306,"_25509":107894,"_2665":107973},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3170":64755,"_28017":64719,"_19412":107975,"_5":13306,"_25509":107894,"_2665":107976},[],"Localiza el pod y Service de authz.",{"_3170":64756,"_28017":64719,"_19412":107978,"_5":13306,"_25509":107894,"_2665":107979},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3170":64757,"_28017":64719,"_19412":107981,"_5":13306,"_25509":107894,"_2665":107982},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3170":64758,"_28017":64719,"_19412":107984,"_5":13306,"_25509":107894,"_2665":107985},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3170":64759,"_28017":64719,"_19412":107987,"_5":13306,"_25509":107894,"_2665":107988},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3170":64760,"_28017":64719,"_19412":107990,"_5":13306,"_25509":107898,"_2665":107991},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3170":64761,"_28017":64719,"_19412":107993,"_5":13306,"_25509":107898,"_2665":107994},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3170":64762,"_28017":64719,"_19412":107996,"_5":13306,"_25509":107898,"_2665":107997},[],"volumen persistente sin enlazar;",{"_3170":64763,"_28017":64719,"_19412":107999,"_5":13306,"_25509":107898,"_2665":108000},[],"imagen inaccesible o política de pull incorrecta;",{"_3170":64764,"_28017":64719,"_19412":108002,"_5":13306,"_25509":107898,"_2665":108003},[],"configuración inválida del motor criptográfico;",{"_3170":64765,"_28017":64719,"_19412":108005,"_5":13306,"_25509":107898,"_2665":108006},[],"límites de CPU o memoria demasiado bajos;",{"_3170":64766,"_28017":64719,"_19412":108008,"_5":13306,"_25509":107898,"_2665":108009},[],"migración previa incompleta.",{"_3170":64767,"_28017":64719,"_19412":108011,"_5":13306,"_25509":107898,"_2665":108012},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3170":64768,"_28017":64719,"_19412":108014,"_5":13306,"_25509":107898,"_2665":108015},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3170":64769,"_28017":64719,"_19412":108017,"_5":13306,"_25509":107898,"_2665":108018},[],"Las llamadas internas ahora fallan rápido en lugar de bloquearse para los clientes cubiertos por Proxy de salida: los intentos de conexión agotan el tiempo tras 30 segundos y los handshakes TLS tras 10 segundos. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada. Si un proxy de salida gestiona el tráfico de salida del clúster, comprueba las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY` del pod e incluye los nombres de servicio internos en `NO_PROXY`.",{"_3170":64770,"_28017":64719,"_19412":108020,"_5":13306,"_25509":107902,"_2665":108021},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3170":64771,"_28017":64719,"_19412":108023,"_5":13306,"_25509":107902,"_2665":108024},[],"verifica que esté habilitado en el servicio emisor;",{"_3170":64772,"_28017":64719,"_19412":108026,"_5":13306,"_25509":107902,"_2665":108027},[],"comprueba conectividad y credenciales AMQP;",{"_3170":64773,"_28017":64719,"_19412":108029,"_5":13306,"_25509":107902,"_2665":108030},[],"revisa exchange, routing key, colas y consumidores;",{"_3170":64774,"_28017":64719,"_19412":108032,"_5":13306,"_25509":107902,"_2665":108033},[],"inspecciona dead-letter queues;",{"_3170":64775,"_28017":64719,"_19412":108035,"_5":13306,"_25509":107902,"_2665":108036},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3170":64776,"_28017":64719,"_19412":108038,"_5":13306,"_25509":107902,"_2665":108039},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3170":64777,"_28017":64719,"_19412":108041,"_5":13306,"_25509":107906,"_2665":108042},[],"El chart puede habilitar instrumentación OpenTelemetry. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, authz, servicio y dependencia.",{"_3170":64778,"_28017":64719,"_19412":108044,"_5":13306,"_25509":107906,"_2665":108045},[],"Antes de cerrar una incidencia, guarda:",{"_3170":64779,"_28017":64719,"_19412":108047,"_5":13306,"_25509":107906,"_2665":108048},[],"causa confirmada;",{"_3170":64780,"_28017":64719,"_19412":108050,"_5":13306,"_25509":107906,"_2665":108051},[],"alcance temporal y recursos afectados;",{"_3170":64781,"_28017":64719,"_19412":108053,"_5":13306,"_25509":107906,"_2665":108054},[],"comandos o consultas utilizados;",{"_3170":64782,"_28017":64719,"_19412":108056,"_5":13306,"_25509":107906,"_2665":108057},[],"cambio aplicado y forma de revertirlo;",{"_3170":64783,"_28017":64719,"_19412":108059,"_5":13306,"_25509":107906,"_2665":108060},[],"validación desde un consumidor;",{"_3170":64784,"_28017":64719,"_19412":108062,"_5":13306,"_25509":107906,"_2665":108063},[],"acción preventiva y propietario.",{"_3170":64785,"_28017":64785,"_5":13637,"_2665":108065,"_28360":108066,"_19412":108069,"_25509":64785},"Control de acceso",[45425,108067,108068],"Plataforma","Administración",[],{"_3170":64786,"_28017":64785,"_19412":108071,"_5":13306,"_25509":64785,"_2665":108072},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3170":64787,"_28017":64785,"_5":28357,"_19412":108074,"_25509":108075,"_2665":108076},[],"/docs/pr-preview/pr-54/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3170":64788,"_28017":64785,"_5":28357,"_19412":108078,"_25509":108079,"_2665":108080},[],"/docs/pr-preview/pr-54/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3170":64789,"_28017":64785,"_5":28357,"_19412":108082,"_25509":108083,"_2665":108084},[],"/docs/pr-preview/pr-54/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3170":64790,"_28017":64785,"_5":28357,"_19412":108086,"_25509":108087,"_2665":108088},[],"/docs/pr-preview/pr-54/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3170":64791,"_28017":64785,"_5":28357,"_19412":108090,"_25509":108091,"_2665":108092},[],"/docs/pr-preview/pr-54/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3170":64792,"_28017":64785,"_5":28357,"_19412":108094,"_25509":108095,"_2665":108096},[],"/docs/pr-preview/pr-54/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3170":64793,"_28017":64785,"_5":28357,"_19412":108098,"_25509":108099,"_2665":108100},[],"/docs/pr-preview/pr-54/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3170":64794,"_28017":64785,"_5":28357,"_19412":108102,"_25509":108103,"_2665":108104},[],"/docs/pr-preview/pr-54/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3170":64795,"_28017":64785,"_5":28357,"_19412":108106,"_25509":108107,"_2665":108108},[],"/docs/pr-preview/pr-54/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3170":64796,"_28017":64785,"_5":28357,"_19412":108110,"_25509":108111,"_2665":108112},[],"/docs/pr-preview/pr-54/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3170":64797,"_28017":64785,"_5":28357,"_19412":108114,"_25509":108115,"_2665":108116},[],"/docs/pr-preview/pr-54/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3170":64798,"_28017":64785,"_5":28357,"_19412":108118,"_25509":108119,"_2665":108120},[],"/docs/pr-preview/pr-54/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3170":64799,"_28017":64785,"_5":28357,"_19412":108122,"_25509":108123,"_2665":108124},[],"/docs/pr-preview/pr-54/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3170":64800,"_28017":64785,"_5":28357,"_19412":108126,"_25509":108127,"_2665":108128},[],"/docs/pr-preview/pr-54/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3170":64801,"_28017":64785,"_5":28357,"_19412":108130,"_25509":108131,"_2665":108132},[],"/docs/pr-preview/pr-54/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3170":64802,"_28017":64785,"_5":28357,"_19412":108134,"_25509":108135,"_2665":107313},[],"/docs/pr-preview/pr-54/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3170":64803,"_28017":64785,"_5":28357,"_19412":108137,"_25509":108138,"_2665":108139},[],"/docs/pr-preview/pr-54/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3170":64804,"_28017":64785,"_5":28357,"_19412":108141,"_25509":108142,"_2665":108143},[],"/docs/pr-preview/pr-54/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_3170":64805,"_28017":64785,"_5":28357,"_19412":108145,"_25509":108146,"_2665":108147},[],"/docs/pr-preview/pr-54/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3170":64806,"_28017":64785,"_5":28357,"_19412":108149,"_25509":108150,"_2665":108151},[],"/docs/pr-preview/pr-54/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3170":64807,"_28017":64785,"_5":28357,"_19412":108153,"_25509":108154,"_2665":108155},[],"/docs/pr-preview/pr-54/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3170":64808,"_28017":64785,"_5":28357,"_19412":108157,"_25509":108158,"_2665":108159},[],"/docs/pr-preview/pr-54/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3170":64809,"_28017":64785,"_5":28357,"_19412":108161,"_25509":108162,"_2665":108163},[],"/docs/pr-preview/pr-54/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3170":64810,"_28017":64785,"_5":28357,"_19412":108165,"_25509":108166,"_2665":108167},[],"/docs/pr-preview/pr-54/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3170":64811,"_28017":64785,"_5":28357,"_19412":108169,"_25509":108170,"_2665":108171},[],"/docs/pr-preview/pr-54/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3170":64812,"_28017":64785,"_5":28357,"_19412":108173,"_25509":108174,"_2665":108175},[],"/docs/pr-preview/pr-54/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3170":64813,"_28017":64785,"_5":28357,"_19412":108177,"_25509":108178,"_2665":108179},[],"/docs/pr-preview/pr-54/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3170":64814,"_28017":64785,"_5":28357,"_19412":108181,"_25509":108182,"_2665":108183},[],"/docs/pr-preview/pr-54/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3170":64815,"_28017":64785,"_5":28357,"_19412":108185,"_25509":108186,"_2665":108187},[],"/docs/pr-preview/pr-54/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3170":64816,"_28017":64785,"_5":28357,"_19412":108189,"_25509":108190,"_2665":108191},[],"/docs/pr-preview/pr-54/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3170":64817,"_28017":64785,"_5":28357,"_19412":108193,"_25509":108194,"_2665":108195},[],"/docs/pr-preview/pr-54/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3170":64818,"_28017":64785,"_19412":108197,"_5":13306,"_25509":64785,"_2665":108198},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3170":64819,"_28017":64785,"_19412":108200,"_5":13306,"_25509":64785,"_2665":108201},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3170":64820,"_28017":64785,"_19412":108203,"_5":13306,"_25509":64785,"_2665":108204},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3170":64821,"_28017":64785,"_19412":108206,"_5":13306,"_25509":108075,"_2665":108207},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3170":64822,"_28017":64785,"_19412":108209,"_5":13306,"_25509":108075,"_2665":108210},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3170":64823,"_28017":64785,"_19412":108212,"_5":13306,"_25509":108075,"_2665":108213},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3170":64824,"_28017":64785,"_19412":108215,"_5":13306,"_25509":108075,"_2665":108216},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3170":64825,"_28017":64785,"_19412":108218,"_5":13306,"_25509":108075,"_2665":108219},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3170":64826,"_28017":64785,"_19412":108221,"_5":13306,"_25509":108075,"_2665":108222},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3170":64827,"_28017":64785,"_19412":108224,"_5":13306,"_25509":108079,"_2665":108225},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3170":64828,"_28017":64785,"_19412":108227,"_5":13306,"_25509":108079,"_2665":108228},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3170":64829,"_28017":64785,"_19412":108230,"_5":13306,"_25509":108083,"_2665":108231},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3170":64830,"_28017":64785,"_19412":108233,"_5":13306,"_25509":108083,"_2665":108234},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3170":64831,"_28017":64785,"_19412":108236,"_5":13306,"_25509":108083,"_2665":108237},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3170":64832,"_28017":64785,"_19412":108239,"_5":13306,"_25509":108083,"_2665":108240},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3170":64833,"_28017":64785,"_19412":108242,"_5":13306,"_25509":108083,"_2665":108243},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3170":64834,"_28017":64785,"_19412":108245,"_5":13306,"_25509":108083,"_2665":108246},[],"Carga por separado las políticas concedidas a cada principal.",{"_3170":64835,"_28017":64785,"_19412":108248,"_5":13306,"_25509":108083,"_2665":108249},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3170":64836,"_28017":64785,"_19412":108251,"_5":13306,"_25509":108083,"_2665":108252},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3170":64837,"_28017":64785,"_19412":108254,"_5":13306,"_25509":108083,"_2665":108255},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3170":64838,"_28017":64785,"_19412":108257,"_5":13306,"_25509":108083,"_2665":108258},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3170":64839,"_28017":64785,"_19412":108260,"_5":13306,"_25509":108083,"_2665":108261},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad.",{"_3170":64840,"_28017":64785,"_19412":108263,"_5":13306,"_25509":108083,"_2665":108264},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3170":64841,"_28017":64785,"_19412":108266,"_5":13306,"_25509":108087,"_2665":108267},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3170":64842,"_28017":64785,"_19412":108269,"_5":13306,"_25509":108087,"_2665":108270},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3170":64843,"_28017":64785,"_19412":108272,"_5":13306,"_25509":108087,"_2665":108273},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3170":64844,"_28017":64785,"_19412":108275,"_5":13306,"_25509":108087,"_2665":108276},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3170":64845,"_28017":64785,"_19412":108278,"_5":13306,"_25509":108087,"_2665":108279},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3170":64846,"_28017":64785,"_19412":108281,"_5":13306,"_25509":108087,"_2665":108282},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3170":64847,"_28017":64785,"_19412":108284,"_5":13306,"_25509":108087,"_2665":108285},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3170":64848,"_28017":64785,"_19412":108287,"_5":13306,"_25509":108087,"_2665":108288},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3170":64849,"_28017":64785,"_19412":108290,"_5":13306,"_25509":108091,"_2665":108291},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3170":64850,"_28017":64785,"_19412":108293,"_5":13306,"_25509":108091,"_2665":108294},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3170":64851,"_28017":64785,"_19412":108296,"_5":13306,"_25509":108091,"_2665":108297},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3170":64852,"_28017":64785,"_19412":108299,"_5":13306,"_25509":108091,"_2665":108300},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3170":64853,"_28017":64785,"_19412":108302,"_5":13306,"_25509":108091,"_2665":108303},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3170":64854,"_28017":64785,"_19412":108305,"_5":13306,"_25509":108091,"_2665":108306},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3170":64855,"_28017":64785,"_19412":108308,"_5":13306,"_25509":108091,"_2665":108309},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3170":64856,"_28017":64785,"_19412":108311,"_5":13306,"_25509":108091,"_2665":108312},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3170":64857,"_28017":64785,"_19412":108314,"_5":13306,"_25509":108091,"_2665":108315},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3170":64858,"_28017":64785,"_19412":108317,"_5":13306,"_25509":108091,"_2665":108318},[],"Las acciones se dividen en dos grupos:",{"_3170":64859,"_28017":64785,"_19412":108320,"_5":13306,"_25509":108091,"_2665":108321},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3170":64860,"_28017":64785,"_19412":108323,"_5":13306,"_25509":108091,"_2665":108324},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3170":64861,"_28017":64785,"_19412":108326,"_5":13306,"_25509":108091,"_2665":108327},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3170":64862,"_28017":64785,"_19412":108329,"_5":13306,"_25509":108095,"_2665":108330},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3170":64863,"_28017":64785,"_19412":108332,"_5":13306,"_25509":108095,"_2665":108333},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3170":64864,"_28017":64785,"_19412":108335,"_5":13306,"_25509":108095,"_2665":108336},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3170":64865,"_28017":64785,"_19412":108338,"_5":13306,"_25509":108099,"_2665":108339},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3170":64866,"_28017":64785,"_19412":108341,"_5":13306,"_25509":108099,"_2665":108342},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3170":64867,"_28017":64785,"_19412":108344,"_5":13306,"_25509":108099,"_2665":108345},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3170":64868,"_28017":64785,"_19412":108347,"_5":13306,"_25509":108099,"_2665":108348},[],"Los operadores implementados son:",{"_3170":64869,"_28017":64785,"_19412":108350,"_5":13306,"_25509":108099,"_2665":108351},[],"`equals`, para igualdad exacta;",{"_3170":64870,"_28017":64785,"_19412":108353,"_5":13306,"_25509":108099,"_2665":108354},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3170":64871,"_28017":64785,"_19412":108356,"_5":13306,"_25509":108099,"_2665":108357},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3170":64872,"_28017":64785,"_19412":108359,"_5":13306,"_25509":108099,"_2665":108360},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3170":64873,"_28017":64785,"_19412":108362,"_5":13306,"_25509":108103,"_2665":108363},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3170":64874,"_28017":64785,"_19412":108365,"_5":13306,"_25509":108103,"_2665":108366},[],"Los modos disponibles son:",{"_3170":64875,"_28017":64785,"_19412":108368,"_5":13306,"_25509":108103,"_2665":108369},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3170":64876,"_28017":64785,"_19412":108371,"_5":13306,"_25509":108103,"_2665":108372},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3170":64877,"_28017":64785,"_19412":108374,"_5":13306,"_25509":108103,"_2665":108375},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3170":64878,"_28017":64785,"_19412":108377,"_5":13306,"_25509":108103,"_2665":108378},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3170":64879,"_28017":64785,"_19412":108380,"_5":13306,"_25509":108103,"_2665":108381},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3170":64880,"_28017":64785,"_19412":108383,"_5":13306,"_25509":108103,"_2665":108384},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3170":64881,"_28017":64785,"_19412":108386,"_5":13306,"_25509":108107,"_2665":108387},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3170":64882,"_28017":64785,"_19412":108389,"_5":13306,"_25509":108107,"_2665":108390},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3170":64883,"_28017":64785,"_19412":108392,"_5":13306,"_25509":108107,"_2665":108393},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3170":64884,"_28017":64785,"_19412":108395,"_5":13306,"_25509":108107,"_2665":108396},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3170":64885,"_28017":64785,"_19412":108398,"_5":13306,"_25509":108115,"_2665":108399},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3170":64886,"_28017":64785,"_19412":108401,"_5":13306,"_25509":108115,"_2665":108402},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3170":64887,"_28017":64785,"_19412":108404,"_5":13306,"_25509":108119,"_2665":108405},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora y la de un dispositivo con su DMS. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3170":64888,"_28017":64785,"_19412":108407,"_5":13306,"_25509":108119,"_2665":108408},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3170":64889,"_28017":64785,"_19412":108410,"_5":13306,"_25509":108123,"_2665":108411},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3170":64890,"_28017":64785,"_19412":108413,"_5":13306,"_25509":108123,"_2665":108414},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3170":64891,"_28017":64785,"_19412":108416,"_5":13306,"_25509":108123,"_2665":108417},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3170":64892,"_28017":64785,"_19412":108419,"_5":13306,"_25509":108127,"_2665":108420},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3170":64893,"_28017":64785,"_19412":108422,"_5":13306,"_25509":108127,"_2665":108423},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3170":64894,"_28017":64785,"_19412":108425,"_5":13306,"_25509":108127,"_2665":108426},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3170":64895,"_28017":64785,"_19412":108428,"_5":13306,"_25509":108127,"_2665":108429},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3170":64896,"_28017":64785,"_19412":108431,"_5":13306,"_25509":108127,"_2665":108432},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3170":64897,"_28017":64785,"_19412":108434,"_5":13306,"_25509":108127,"_2665":108435},[],"Ten en cuenta que:",{"_3170":64898,"_28017":64785,"_19412":108437,"_5":13306,"_25509":108127,"_2665":108438},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3170":64899,"_28017":64785,"_19412":108440,"_5":13306,"_25509":108127,"_2665":108441},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3170":64900,"_28017":64785,"_19412":108443,"_5":13306,"_25509":108127,"_2665":108444},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3170":64901,"_28017":64785,"_19412":108446,"_5":13306,"_25509":108131,"_2665":108447},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3170":64902,"_28017":64785,"_19412":108449,"_5":13306,"_25509":108131,"_2665":108450},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3170":64903,"_28017":64785,"_19412":108452,"_5":13306,"_25509":108131,"_2665":108453},[],"acceso completo y de solo lectura a KMS;",{"_3170":64904,"_28017":64785,"_19412":108455,"_5":13306,"_25509":108131,"_2665":108456},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3170":64905,"_28017":64785,"_19412":108458,"_5":13306,"_25509":108131,"_2665":108459},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3170":64906,"_28017":64785,"_19412":108461,"_5":13306,"_25509":108131,"_2665":108462},[],"acceso a la interfaz;",{"_3170":64907,"_28017":64785,"_19412":108464,"_5":13306,"_25509":108131,"_2665":108465},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3170":64908,"_28017":64785,"_19412":108467,"_5":13306,"_25509":108131,"_2665":108468},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3170":64909,"_28017":64785,"_19412":108470,"_5":13306,"_25509":108131,"_2665":108471},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3170":64910,"_28017":64785,"_19412":108473,"_5":13306,"_25509":108135,"_2665":108474},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3170":64911,"_28017":64785,"_19412":108476,"_5":13306,"_25509":108135,"_2665":108477},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3170":64912,"_28017":64785,"_19412":108479,"_5":13306,"_25509":108135,"_2665":108480},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3170":64913,"_28017":64785,"_19412":108482,"_5":13306,"_25509":108138,"_2665":108483},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3170":64914,"_28017":64785,"_19412":108485,"_5":13306,"_25509":108142,"_2665":108486},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_3170":64915,"_28017":64785,"_19412":108488,"_5":13306,"_25509":108142,"_2665":108489},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_3170":64916,"_28017":64785,"_19412":108491,"_5":13306,"_25509":108146,"_2665":108492},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3170":64917,"_28017":64785,"_19412":108494,"_5":13306,"_25509":108150,"_2665":108495},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3170":64918,"_28017":64785,"_19412":108497,"_5":13306,"_25509":108154,"_2665":108498},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3170":64919,"_28017":64785,"_19412":108500,"_5":13306,"_25509":108158,"_2665":108501},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3170":64920,"_28017":64785,"_19412":108503,"_5":13306,"_25509":108158,"_2665":108504},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3170":64921,"_28017":64785,"_19412":108506,"_5":13306,"_25509":108162,"_2665":108507},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3170":64922,"_28017":64785,"_19412":108509,"_5":13306,"_25509":108162,"_2665":108510},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3170":64923,"_28017":64785,"_19412":108512,"_5":13306,"_25509":108162,"_2665":108513},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3170":64924,"_28017":64785,"_19412":108515,"_5":13306,"_25509":108162,"_2665":108516},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3170":64925,"_28017":64785,"_19412":108518,"_5":13306,"_25509":108162,"_2665":108519},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3170":64926,"_28017":64785,"_19412":108521,"_5":13306,"_25509":108162,"_2665":108522},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3170":64927,"_28017":64785,"_19412":108524,"_5":13306,"_25509":108162,"_2665":108525},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3170":64928,"_28017":64785,"_19412":108527,"_5":13306,"_25509":108162,"_2665":108528},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3170":64929,"_28017":64785,"_19412":108530,"_5":13306,"_25509":108166,"_2665":108531},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3170":64930,"_28017":64785,"_19412":108533,"_5":13306,"_25509":108166,"_2665":108534},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3170":64931,"_28017":64785,"_19412":108536,"_5":13306,"_25509":108166,"_2665":108537},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3170":64932,"_28017":64785,"_19412":108539,"_5":13306,"_25509":108170,"_2665":108540},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3170":64933,"_28017":64785,"_19412":108542,"_5":13306,"_25509":108170,"_2665":108543},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3170":64934,"_28017":64785,"_19412":108545,"_5":13306,"_25509":108170,"_2665":108546},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3170":64935,"_28017":64785,"_19412":108548,"_5":13306,"_25509":108170,"_2665":108549},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3170":64936,"_28017":64785,"_19412":108551,"_5":13306,"_25509":108170,"_2665":108552},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3170":64937,"_28017":64785,"_19412":108554,"_5":13306,"_25509":108170,"_2665":108555},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3170":64938,"_28017":64785,"_19412":108557,"_5":13306,"_25509":108170,"_2665":108558},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3170":64939,"_28017":64785,"_19412":108560,"_5":13306,"_25509":108170,"_2665":108561},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3170":64940,"_28017":64785,"_19412":108563,"_5":13306,"_25509":108178,"_2665":108564},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3170":64941,"_28017":64785,"_19412":108566,"_5":13306,"_25509":108182,"_2665":108567},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3170":64942,"_28017":64785,"_19412":108569,"_5":13306,"_25509":108182,"_2665":108570},[],"que exista un principal activo del tipo correcto;",{"_3170":64943,"_28017":64785,"_19412":108572,"_5":13306,"_25509":108182,"_2665":108573},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3170":64944,"_28017":64785,"_19412":108575,"_5":13306,"_25509":108182,"_2665":108576},[],"que todas las condiciones del principal se cumplan;",{"_3170":64945,"_28017":64785,"_19412":108578,"_5":13306,"_25509":108182,"_2665":108579},[],"que el principal tenga concedida la política esperada;",{"_3170":64946,"_28017":64785,"_19412":108581,"_5":13306,"_25509":108182,"_2665":108582},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3170":64947,"_28017":64785,"_19412":108584,"_5":13306,"_25509":108182,"_2665":108585},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3170":64948,"_28017":64785,"_19412":108587,"_5":13306,"_25509":108182,"_2665":108588},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con la instrumentación OpenTelemetry habilitada, cada decisión genera además un span —`engine.CheckHTTP` en el camino del Gateway— cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente, de forma que puedas correlacionar la denegación con la traza del Gateway.",{"_3170":64949,"_28017":64785,"_19412":108590,"_5":13306,"_25509":108186,"_2665":108591},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3170":64950,"_28017":64785,"_19412":108593,"_5":13306,"_25509":108190,"_2665":108594},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3170":64951,"_28017":64785,"_19412":108596,"_5":13306,"_25509":108194,"_2665":108597},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3170":64952,"_28017":64785,"_19412":108599,"_5":13306,"_25509":108194,"_2665":108600},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3170":64953,"_28017":64953,"_5":13637,"_2665":108602,"_28360":108603,"_19412":108604,"_25509":64953},"Alertas y suscripciones",[45425,108067,108068],[],{"_3170":64954,"_28017":64953,"_19412":108606,"_5":13306,"_25509":64953,"_2665":108607},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3170":64955,"_28017":64953,"_5":28357,"_19412":108609,"_25509":108610,"_2665":108611},[],"/docs/pr-preview/pr-54/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3170":64956,"_28017":64953,"_5":28357,"_19412":108613,"_25509":108614,"_2665":108615},[],"/docs/pr-preview/pr-54/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3170":64957,"_28017":64953,"_5":28357,"_19412":108617,"_25509":108618,"_2665":108619},[],"/docs/pr-preview/pr-54/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3170":64958,"_28017":64953,"_5":28357,"_19412":108621,"_25509":108622,"_2665":108623},[],"/docs/pr-preview/pr-54/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3170":64959,"_28017":64953,"_5":28357,"_19412":108625,"_25509":108626,"_2665":108627},[],"/docs/pr-preview/pr-54/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3170":64960,"_28017":64953,"_5":28357,"_19412":108629,"_25509":108630,"_2665":108631},[],"/docs/pr-preview/pr-54/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3170":64961,"_28017":64953,"_5":28357,"_19412":108633,"_25509":108634,"_2665":108635},[],"/docs/pr-preview/pr-54/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3170":64962,"_28017":64953,"_5":28357,"_19412":108637,"_25509":108638,"_2665":108639},[],"/docs/pr-preview/pr-54/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","Configura el cliente HTTP del webhook",{"_3170":64963,"_28017":64953,"_5":28357,"_19412":108641,"_25509":108642,"_2665":108643},[],"/docs/pr-preview/pr-54/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3170":64964,"_28017":64953,"_5":28357,"_19412":108645,"_25509":108646,"_2665":108647},[],"/docs/pr-preview/pr-54/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3170":64965,"_28017":64953,"_5":28357,"_19412":108649,"_25509":108650,"_2665":108651},[],"/docs/pr-preview/pr-54/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3170":64966,"_28017":64953,"_19412":108653,"_5":13306,"_25509":64953,"_2665":108654},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3170":64967,"_28017":64953,"_19412":108656,"_5":13306,"_25509":108610,"_2665":108657},[],"Un servicio publica un evento de dominio.",{"_3170":64968,"_28017":64953,"_19412":108659,"_5":13306,"_25509":108610,"_2665":108660},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3170":64969,"_28017":64953,"_19412":108662,"_5":13306,"_25509":108610,"_2665":108663},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3170":64970,"_28017":64953,"_19412":108665,"_5":13306,"_25509":108610,"_2665":108666},[],"Lamassu entrega el evento al canal configurado.",{"_3170":64971,"_28017":64953,"_19412":108668,"_5":13306,"_25509":108610,"_2665":108669},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3170":64972,"_28017":64953,"_19412":108671,"_5":13306,"_25509":108614,"_2665":108672},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3170":64973,"_28017":64953,"_19412":108674,"_5":13306,"_25509":108614,"_2665":108675},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3170":64974,"_28017":64953,"_19412":108677,"_5":13306,"_25509":108614,"_2665":108678},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3170":64975,"_28017":64953,"_19412":108680,"_5":13306,"_25509":108614,"_2665":108681},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3170":64976,"_28017":64953,"_19412":108683,"_5":13306,"_25509":108614,"_2665":108684},[],"`apikey_options` necesita `header` y `key`.",{"_3170":64977,"_28017":64953,"_19412":108686,"_5":13306,"_25509":108614,"_2665":108687},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3170":64978,"_28017":64953,"_19412":108689,"_5":13306,"_25509":108614,"_2665":108690},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3170":64979,"_28017":64953,"_19412":108692,"_5":13306,"_25509":108614,"_2665":108693},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3170":64980,"_28017":64953,"_19412":108695,"_5":13306,"_25509":108622,"_2665":108696},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3170":64981,"_28017":64953,"_19412":108698,"_5":13306,"_25509":108626,"_2665":108699},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3170":64982,"_28017":64953,"_19412":108701,"_5":13306,"_25509":108630,"_2665":108702},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3170":64983,"_28017":64953,"_19412":108704,"_5":13306,"_25509":108630,"_2665":108705},[],"**None** notifica todas las instancias del evento.",{"_3170":64984,"_28017":64953,"_19412":108707,"_5":13306,"_25509":108630,"_2665":108708},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3170":64985,"_28017":64953,"_19412":108710,"_5":13306,"_25509":108630,"_2665":108711},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3170":64986,"_28017":64953,"_19412":108713,"_5":13306,"_25509":108630,"_2665":108714},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3170":64987,"_28017":64953,"_19412":108716,"_5":13306,"_25509":108630,"_2665":108717},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3170":64988,"_28017":64953,"_19412":108719,"_5":13306,"_25509":108634,"_2665":108720},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3170":64989,"_28017":64953,"_19412":108722,"_5":13306,"_25509":108638,"_2665":108723},[],"Los canales Webhook y Microsoft Teams muestran esta configuración en el formulario de suscripción, en el paso del canal, y de nuevo al editar una suscripción; Email no la utiliza. Los campos se corresponden con el bloque opcional `http_client` descrito arriba:",{"_3170":64990,"_28017":64953,"_19412":108725,"_5":13306,"_25509":108638,"_2665":108726},[],"**Log Level** selecciona `debug`, `info`, `warn` o `error`; `info` es el valor por defecto.",{"_3170":64991,"_28017":64953,"_19412":108728,"_5":13306,"_25509":108638,"_2665":108729},[],"**Call Timeout** es de 10 segundos por defecto. La consola rechaza un valor superior a 30 segundos con `Webhook timeout must be at most 30s.`; la API ajusta ese mismo valor al tope en lugar de rechazarlo (ver Las llamadas están limitadas).",{"_3170":64992,"_28017":64953,"_19412":108731,"_5":13306,"_25509":108638,"_2665":108732},[],"No hay interruptor de verificación TLS para estos canales, porque el servicio siempre verifica el certificado del receptor (ver TLS siempre se verifica).",{"_3170":64993,"_28017":64953,"_19412":108734,"_5":13306,"_25509":108638,"_2665":108735},[],"**HTTP Authentication** selecciona `No Authentication` (por defecto), `API Key` (valor de la API key y Header Name, `X-API-Key` por defecto), `OIDC Client Credentials` (Client ID, Client Secret y Well-Known URL) o `Mutual TLS` (Client Certificate y Client Private Key pegados como PEM). Una clave privada guardada permanece oculta hasta que seleccionas **Show**.",{"_3170":64994,"_28017":64953,"_19412":108737,"_5":13306,"_25509":108638,"_2665":108738},[],"Una URL `http://` muestra en la consola la advertencia `Unencrypted HTTP connection` (ver la llamada Credenciales sobre http\\:// más abajo).",{"_3170":64995,"_28017":64953,"_19412":108740,"_5":13306,"_25509":108638,"_2665":108741},[],"Los campos se validan en línea con las mismas reglas de entrega: la URL del webhook y la Well-Known URL de OIDC deben ser URLs absolutas `http` o `https`, una cabecera API-key no puede usar un nombre reservado y el certificado y la clave mTLS deben ser contenido PEM, no rutas de ficheros.",{"_3170":64996,"_28017":64953,"_19412":108743,"_5":13306,"_25509":108638,"_2665":108744},[],"El resumen del paso de confirmación muestra la autenticación como `None`, `OIDC client credentials`, `API key` o `Mutual TLS`. Los detalles de la suscripción muestran la autenticación, el nombre de la cabecera API-key (nunca el valor), la URL del emisor OIDC, mTLS como `Configured` y una fila fija `TLS verification: Verified`. La API key, el client secret y la clave privada no se muestran en los detalles de la suscripción.",{"_3170":64997,"_28017":64953,"_19412":108746,"_5":13306,"_25509":108642,"_2665":108747},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3170":64998,"_28017":64953,"_19412":108749,"_5":13306,"_25509":108642,"_2665":108750},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3170":64999,"_28017":64953,"_19412":108752,"_5":13306,"_25509":108642,"_2665":108753},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3170":65000,"_28017":64953,"_19412":108755,"_5":13306,"_25509":108642,"_2665":108756},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3170":65001,"_28017":64953,"_19412":108758,"_5":13306,"_25509":108642,"_2665":108759},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3170":65002,"_28017":64953,"_19412":108761,"_5":13306,"_25509":108642,"_2665":108762},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3170":65003,"_28017":64953,"_19412":108764,"_5":13306,"_25509":108642,"_2665":108765},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3170":65004,"_28017":64953,"_19412":108767,"_5":13306,"_25509":108642,"_2665":108768},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3170":65005,"_28017":64953,"_19412":108770,"_5":13306,"_25509":108646,"_2665":108771},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3170":65006,"_28017":64953,"_19412":108773,"_5":13306,"_25509":108646,"_2665":108774},[],"Las suscripciones creadas con versiones anteriores de la consola pueden guardar el destino del webhook en `url` y `method` en lugar de `webhook_url` y `webhook_method`. El servicio entrega solo a través de `webhook_url` y `webhook_method`, así que una suscripción así no entrega aunque los detalles de la suscripción muestren el destino guardado. Abre la suscripción y vuelve a guardarla: el formulario de edición precarga el destino guardado, y al guardar se reescribe la configuración del canal con el formato actual.",{"_3170":65007,"_28017":64953,"_19412":108776,"_5":13306,"_25509":108650,"_2665":108777},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3170":65008,"_28017":64953,"_19412":108779,"_5":13306,"_25509":108650,"_2665":108780},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3170":65009,"_28017":64953,"_19412":108782,"_5":13306,"_25509":108650,"_2665":108783},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3170":65010,"_28017":64953,"_19412":108785,"_5":13306,"_25509":108650,"_2665":108786},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3170":65011,"_28017":64953,"_19412":108788,"_5":13306,"_25509":108650,"_2665":108789},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3170":65012,"_28017":64953,"_19412":108791,"_5":13306,"_25509":108650,"_2665":108792},[],"**Validación:** `va.role.crl.create`.",{"_3170":65013,"_28017":64953,"_19412":108794,"_5":13306,"_25509":108650,"_2665":108795},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3170":65014,"_28017":64953,"_19412":108797,"_5":13306,"_25509":108650,"_2665":108798},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3170":65015,"_28017":65015,"_5":13637,"_2665":108800,"_28360":108801,"_19412":108802,"_25509":65015},"Registros de auditoría",[45425,108067,108068],[],{"_3170":65016,"_28017":65015,"_19412":108804,"_5":13306,"_25509":65015,"_2665":108805},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3170":65017,"_28017":65015,"_5":28357,"_19412":108807,"_25509":108808,"_2665":108809},[],"/docs/pr-preview/pr-54/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3170":65018,"_28017":65015,"_5":28357,"_19412":108811,"_25509":108812,"_2665":108813},[],"/docs/pr-preview/pr-54/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3170":65019,"_28017":65015,"_5":28357,"_19412":108815,"_25509":108816,"_2665":108817},[],"/docs/pr-preview/pr-54/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3170":65020,"_28017":65015,"_5":28357,"_19412":108819,"_25509":108820,"_2665":108821},[],"/docs/pr-preview/pr-54/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3170":65021,"_28017":65015,"_5":28357,"_19412":108823,"_25509":108824,"_2665":108825},[],"/docs/pr-preview/pr-54/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3170":65022,"_28017":65015,"_5":28357,"_19412":108827,"_25509":108828,"_2665":108829},[],"/docs/pr-preview/pr-54/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3170":65023,"_28017":65015,"_5":28357,"_19412":108831,"_25509":108832,"_2665":108833},[],"/docs/pr-preview/pr-54/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3170":65024,"_28017":65015,"_5":28357,"_19412":108835,"_25509":108836,"_2665":108837},[],"/docs/pr-preview/pr-54/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3170":65025,"_28017":65015,"_5":28357,"_19412":108839,"_25509":108840,"_2665":108841},[],"/docs/pr-preview/pr-54/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3170":65026,"_28017":65015,"_5":28357,"_19412":108843,"_25509":108844,"_2665":108845},[],"/docs/pr-preview/pr-54/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3170":65027,"_28017":65015,"_5":28357,"_19412":108847,"_25509":108848,"_2665":108849},[],"/docs/pr-preview/pr-54/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3170":65028,"_28017":65015,"_19412":108851,"_5":13306,"_25509":65015,"_2665":108852},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3170":65029,"_28017":65015,"_19412":108854,"_5":13306,"_25509":108808,"_2665":108855},[],"El cuerpo de auditoría incluye:",{"_3170":65030,"_28017":65015,"_19412":108857,"_5":13306,"_25509":108808,"_2665":108858},[],"input: datos recibidos por la operación;",{"_3170":65031,"_28017":65015,"_19412":108860,"_5":13306,"_25509":108808,"_2665":108861},[],"has\\_error: indica si el servicio devolvió un error;",{"_3170":65032,"_28017":65015,"_19412":108863,"_5":13306,"_25509":108808,"_2665":108864},[],"output: resultado producido o mensaje de error;",{"_3170":65033,"_28017":65015,"_19412":108866,"_5":13306,"_25509":108808,"_2665":108867},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3170":65034,"_28017":65015,"_19412":108869,"_5":13306,"_25509":108808,"_2665":108870},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3170":65035,"_28017":65015,"_19412":108872,"_5":13306,"_25509":108808,"_2665":108873},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3170":65036,"_28017":65015,"_19412":108875,"_5":13306,"_25509":108812,"_2665":108876},[],"El backend aplica auditoría a mutaciones de:",{"_3170":65037,"_28017":65015,"_19412":108878,"_5":13306,"_25509":108812,"_2665":108879},[],"autoridades, certificados y perfiles de emisión;",{"_3170":65038,"_28017":65015,"_19412":108881,"_5":13306,"_25509":108812,"_2665":108882},[],"claves y motores KMS;",{"_3170":65039,"_28017":65015,"_19412":108884,"_5":13306,"_25509":108812,"_2665":108885},[],"dispositivos e identidades;",{"_3170":65040,"_28017":65015,"_19412":108887,"_5":13306,"_25509":108812,"_2665":108888},[],"DMS y operaciones de enrolamiento;",{"_3170":65041,"_28017":65015,"_19412":108890,"_5":13306,"_25509":108812,"_2665":108891},[],"funciones de validación y CRL;",{"_3170":65042,"_28017":65015,"_19412":108893,"_5":13306,"_25509":108812,"_2665":108894},[],"principales, políticas y concesiones de autorización.",{"_3170":65043,"_28017":65015,"_19412":108896,"_5":13306,"_25509":108812,"_2665":108897},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3170":65044,"_28017":65015,"_19412":108899,"_5":13306,"_25509":108816,"_2665":108900},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3170":65045,"_28017":65015,"_19412":108902,"_5":13306,"_25509":108816,"_2665":108903},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3170":65046,"_28017":65015,"_19412":108905,"_5":13306,"_25509":108816,"_2665":108906},[],"Diseña el consumidor para:",{"_3170":65047,"_28017":65015,"_19412":108908,"_5":13306,"_25509":108816,"_2665":108909},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3170":65048,"_28017":65015,"_19412":108911,"_5":13306,"_25509":108816,"_2665":108912},[],"conservar el CloudEvent completo sin modificar;",{"_3170":65049,"_28017":65015,"_19412":108914,"_5":13306,"_25509":108816,"_2665":108915},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3170":65050,"_28017":65015,"_19412":108917,"_5":13306,"_25509":108816,"_2665":108918},[],"cifrar en tránsito y en reposo;",{"_3170":65051,"_28017":65015,"_19412":108920,"_5":13306,"_25509":108816,"_2665":108921},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3170":65052,"_28017":65015,"_19412":108923,"_5":13306,"_25509":108816,"_2665":108924},[],"aplicar una política explícita de retención y legal hold;",{"_3170":65053,"_28017":65015,"_19412":108926,"_5":13306,"_25509":108816,"_2665":108927},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3170":65054,"_28017":65015,"_19412":108929,"_5":13306,"_25509":108820,"_2665":108930},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3170":65055,"_28017":65015,"_19412":108932,"_5":13306,"_25509":108820,"_2665":108933},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3170":65056,"_28017":65015,"_19412":108935,"_5":13306,"_25509":108828,"_2665":108936},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3170":65057,"_28017":65015,"_19412":108938,"_5":13306,"_25509":108832,"_2665":108939},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3170":65058,"_28017":65015,"_19412":108941,"_5":13306,"_25509":108836,"_2665":108942},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3170":65059,"_28017":65015,"_19412":108944,"_5":13306,"_25509":108840,"_2665":108945},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3170":65060,"_28017":65015,"_19412":108947,"_5":13306,"_25509":108844,"_2665":108948},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3170":65061,"_28017":65015,"_19412":108950,"_5":13306,"_25509":108848,"_2665":108951},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3170":65062,"_28017":65015,"_19412":108953,"_5":13306,"_25509":108848,"_2665":108954},[],"aparece un evento de auditoría correcto;",{"_3170":65063,"_28017":65015,"_19412":108956,"_5":13306,"_25509":108848,"_2665":108957},[],"el principal coincide con la identidad utilizada;",{"_3170":65064,"_28017":65015,"_19412":108959,"_5":13306,"_25509":108848,"_2665":108960},[],"el consumidor lo persiste una sola vez;",{"_3170":65065,"_28017":65015,"_19412":108962,"_5":13306,"_25509":108848,"_2665":108963},[],"puede recuperarse por recurso, actor y periodo;",{"_3170":65066,"_28017":65015,"_19412":108965,"_5":13306,"_25509":108848,"_2665":108966},[],"una interrupción del consumidor produce una alerta.",{"_3170":65067,"_28017":65015,"_19412":108968,"_5":13306,"_25509":108848,"_2665":108969},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3170":65068,"_28017":65068,"_5":13637,"_2665":108971,"_28360":108972,"_19412":108973,"_25509":65068},"Arquitectura de la plataforma",[45425,108067],[],{"_3170":65069,"_28017":65068,"_19412":108975,"_5":13306,"_25509":65068,"_2665":108976},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3170":65070,"_28017":65068,"_5":28357,"_19412":108978,"_25509":108979,"_2665":108980},[],"/docs/pr-preview/pr-54/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3170":65071,"_28017":65068,"_5":28357,"_19412":108982,"_25509":108983,"_2665":108984},[],"/docs/pr-preview/pr-54/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3170":65072,"_28017":65068,"_5":28357,"_19412":108986,"_25509":108987,"_2665":108988},[],"/docs/pr-preview/pr-54/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3170":65073,"_28017":65068,"_5":28357,"_19412":108990,"_25509":108991,"_2665":108992},[],"/docs/pr-preview/pr-54/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3170":65074,"_28017":65068,"_5":28357,"_19412":108994,"_25509":108995,"_2665":108996},[],"/docs/pr-preview/pr-54/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3170":65075,"_28017":65068,"_19412":108998,"_5":13306,"_25509":65068,"_2665":108999},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3170":65076,"_28017":65068,"_19412":109001,"_5":13306,"_25509":65068,"_2665":109002},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3170":65077,"_28017":65068,"_19412":109004,"_5":13306,"_25509":108979,"_2665":109005},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3170":65078,"_28017":65068,"_19412":109007,"_5":13306,"_25509":108983,"_2665":109008},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3170":65079,"_28017":65068,"_19412":109010,"_5":13306,"_25509":108987,"_2665":109011},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3170":65080,"_28017":65068,"_19412":109013,"_5":13306,"_25509":108991,"_2665":109014},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3170":65081,"_28017":65068,"_19412":109016,"_5":13306,"_25509":108995,"_2665":109017},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3170":65082,"_28017":65082,"_5":13637,"_2665":109019,"_28360":109020,"_19412":109021,"_25509":65082},"Cómo funciona Lamassu",[45425,108067],[],{"_3170":65083,"_28017":65082,"_19412":109023,"_5":13306,"_25509":65082,"_2665":109024},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3170":65084,"_28017":65082,"_5":28357,"_19412":109026,"_25509":109027,"_2665":109028},[],"/docs/pr-preview/pr-54/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3170":65085,"_28017":65082,"_5":28357,"_19412":109030,"_25509":109031,"_2665":109032},[],"/docs/pr-preview/pr-54/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3170":65086,"_28017":65082,"_19412":109034,"_5":13306,"_25509":65082,"_2665":109035},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3170":65087,"_28017":65082,"_19412":109037,"_5":13306,"_25509":109027,"_2665":109038},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3170":65088,"_28017":65082,"_19412":109040,"_5":13306,"_25509":109027,"_2665":109041},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3170":65089,"_28017":65082,"_19412":109043,"_5":13306,"_25509":109027,"_2665":109044},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3170":65090,"_28017":65082,"_19412":109046,"_5":13306,"_25509":109027,"_2665":109047},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3170":65091,"_28017":65082,"_19412":109049,"_5":13306,"_25509":109027,"_2665":109050},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3170":65092,"_28017":65082,"_19412":109052,"_5":13306,"_25509":109031,"_2665":109053},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3170":65093,"_28017":65082,"_19412":109055,"_5":13306,"_25509":109031,"_2665":109056},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3170":65094,"_28017":65082,"_19412":109058,"_5":13306,"_25509":109031,"_2665":109059},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3170":65095,"_28017":65082,"_19412":109061,"_5":13306,"_25509":109031,"_2665":109062},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3170":65096,"_28017":65082,"_19412":109064,"_5":13306,"_25509":109031,"_2665":109065},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3170":65097,"_28017":65082,"_19412":109067,"_5":13306,"_25509":109031,"_2665":109068},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3170":65098,"_28017":65082,"_19412":109070,"_5":13306,"_25509":109031,"_2665":109071},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3170":65099,"_28017":65099,"_5":13637,"_2665":109073,"_28360":109074,"_19412":109075,"_25509":65099},"Dispositivos e identidades",[45425,108067,47826,109073],[],{"_3170":65100,"_28017":65099,"_19412":109077,"_5":13306,"_25509":65099,"_2665":109078},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3170":65101,"_28017":65099,"_5":28357,"_19412":109080,"_25509":109081,"_2665":109082},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3170":65102,"_28017":65099,"_5":28357,"_19412":109084,"_25509":109085,"_2665":109086},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3170":65103,"_28017":65099,"_5":28357,"_19412":109088,"_25509":109089,"_2665":109090},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3170":65104,"_28017":65099,"_5":28357,"_19412":109092,"_25509":109093,"_2665":109094},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3170":65105,"_28017":65099,"_5":28357,"_19412":109096,"_25509":109097,"_2665":109098},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3170":65106,"_28017":65099,"_5":28357,"_19412":109100,"_25509":109101,"_2665":109102},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3170":65107,"_28017":65099,"_5":28357,"_19412":109104,"_25509":109105,"_2665":109106},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3170":65108,"_28017":65099,"_5":28357,"_19412":109108,"_25509":109109,"_2665":109110},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3170":65109,"_28017":65099,"_5":28357,"_19412":109112,"_25509":109113,"_2665":109114},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3170":65110,"_28017":65099,"_5":28357,"_19412":109116,"_25509":109117,"_2665":109118},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3170":65111,"_28017":65099,"_5":28357,"_19412":109120,"_25509":109121,"_2665":109122},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3170":65112,"_28017":65099,"_19412":109124,"_5":13306,"_25509":65099,"_2665":109125},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3170":65113,"_28017":65099,"_19412":109127,"_5":13306,"_25509":65099,"_2665":109128},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3170":65114,"_28017":65099,"_19412":109130,"_5":13306,"_25509":109081,"_2665":109131},[],"Vista operativa",{"_3170":65115,"_28017":65099,"_19412":109133,"_5":13306,"_25509":109081,"_2665":109134},[],"Interpretación",{"_3170":65116,"_28017":65099,"_19412":109136,"_5":13306,"_25509":109081,"_2665":47889},[],{"_3170":65117,"_28017":65099,"_19412":109138,"_5":13306,"_25509":109081,"_2665":109139},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3170":65118,"_28017":65099,"_19412":109141,"_5":13306,"_25509":109081,"_2665":47895},[],{"_3170":65119,"_28017":65099,"_19412":109143,"_5":13306,"_25509":109081,"_2665":109144},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3170":65120,"_28017":65099,"_19412":109146,"_5":13306,"_25509":109081,"_2665":47901},[],{"_3170":65121,"_28017":65099,"_19412":109148,"_5":13306,"_25509":109081,"_2665":109149},[],"La identidad está en la ventana operativa de renovación.",{"_3170":65122,"_28017":65099,"_19412":109151,"_5":13306,"_25509":109081,"_2665":47907},[],{"_3170":65123,"_28017":65099,"_19412":109153,"_5":13306,"_25509":109081,"_2665":109154},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3170":65124,"_28017":65099,"_19412":109156,"_5":13306,"_25509":109081,"_2665":47913},[],{"_3170":65125,"_28017":65099,"_19412":109158,"_5":13306,"_25509":109081,"_2665":109159},[],"La identidad ha vencido.",{"_3170":65126,"_28017":65099,"_19412":109161,"_5":13306,"_25509":109081,"_2665":47919},[],{"_3170":65127,"_28017":65099,"_19412":109163,"_5":13306,"_25509":109081,"_2665":109164},[],"La identidad está marcada como revocada.",{"_3170":65128,"_28017":65099,"_19412":109166,"_5":13306,"_25509":109081,"_2665":47925},[],{"_3170":65129,"_28017":65099,"_19412":109168,"_5":13306,"_25509":109081,"_2665":109169},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3170":65130,"_28017":65099,"_19412":109171,"_5":13306,"_25509":109081,"_2665":109172},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3170":65131,"_28017":65099,"_19412":109174,"_5":13306,"_25509":109085,"_2665":109175},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3170":65132,"_28017":65099,"_19412":109177,"_5":13306,"_25509":109085,"_2665":109178},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3170":65133,"_28017":65099,"_19412":109180,"_5":13306,"_25509":109085,"_2665":109181},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3170":65134,"_28017":65099,"_19412":109183,"_5":13306,"_25509":109085,"_2665":109184},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3170":65135,"_28017":65099,"_19412":109186,"_5":13306,"_25509":109089,"_2665":109187},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3170":65136,"_28017":65099,"_19412":109189,"_5":13306,"_25509":109093,"_2665":109190},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3170":65137,"_28017":65099,"_19412":109192,"_5":13306,"_25509":109097,"_2665":109193},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3170":65138,"_28017":65099,"_19412":109195,"_5":13306,"_25509":109101,"_2665":109196},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3170":65139,"_28017":65099,"_19412":109198,"_5":13306,"_25509":109105,"_2665":109199},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3170":65140,"_28017":65099,"_19412":109201,"_5":13306,"_25509":109105,"_2665":109202},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3170":65141,"_28017":65099,"_19412":109204,"_5":13306,"_25509":109109,"_2665":109205},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3170":65142,"_28017":65099,"_19412":109207,"_5":13306,"_25509":109109,"_2665":109208},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3170":65143,"_28017":65099,"_19412":109210,"_5":13306,"_25509":109109,"_2665":109211},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3170":65144,"_28017":65099,"_19412":109213,"_5":13306,"_25509":109109,"_2665":109214},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3170":65145,"_28017":65099,"_19412":109216,"_5":13306,"_25509":109109,"_2665":109217},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3170":65146,"_28017":65099,"_19412":109219,"_5":13306,"_25509":109109,"_2665":109220},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3170":65147,"_28017":65099,"_19412":109222,"_5":13306,"_25509":109113,"_2665":109223},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3170":65148,"_28017":65099,"_19412":109225,"_5":13306,"_25509":109113,"_2665":109226},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3170":65149,"_28017":65099,"_19412":109228,"_5":13306,"_25509":109117,"_2665":109229},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3170":65150,"_28017":65099,"_19412":109231,"_5":13306,"_25509":109117,"_2665":109232},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3170":65151,"_28017":65099,"_19412":109234,"_5":13306,"_25509":109117,"_2665":109235},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3170":65152,"_28017":65099,"_19412":109237,"_5":13306,"_25509":109117,"_2665":109238},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3170":65153,"_28017":65099,"_19412":109240,"_5":13306,"_25509":109121,"_2665":109241},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3170":65154,"_28017":65099,"_19412":109243,"_5":13306,"_25509":109121,"_2665":109244},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3170":65155,"_28017":65155,"_5":13637,"_2665":109246,"_28360":109247,"_19412":109249,"_25509":65155},"Identidad inicial y autenticación",[45425,108067,47826,109073,109248],"Enrolamiento con PKI",[],{"_3170":65156,"_28017":65155,"_19412":109251,"_5":13306,"_25509":65155,"_2665":109252},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_3170":65157,"_28017":65155,"_5":28357,"_19412":109254,"_25509":109255,"_2665":109256},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3170":65158,"_28017":65155,"_5":28357,"_19412":109258,"_25509":109259,"_2665":109260},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3170":65159,"_28017":65155,"_5":28357,"_19412":109262,"_25509":109263,"_2665":109264},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_3170":65160,"_28017":65155,"_5":28357,"_19412":109266,"_25509":109267,"_2665":109268},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3170":65161,"_28017":65155,"_5":28357,"_19412":109270,"_25509":109271,"_2665":109272},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3170":65162,"_28017":65155,"_19412":109274,"_5":13306,"_25509":65155,"_2665":109275},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3170":65163,"_28017":65155,"_19412":109277,"_5":13306,"_25509":109255,"_2665":109278},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3170":65164,"_28017":65155,"_19412":109280,"_5":13306,"_25509":109255,"_2665":109281},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3170":65165,"_28017":65155,"_19412":109283,"_5":13306,"_25509":109259,"_2665":109284},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3170":65166,"_28017":65155,"_19412":109286,"_5":13306,"_25509":109259,"_2665":109287},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3170":65167,"_28017":65155,"_19412":109289,"_5":13306,"_25509":109259,"_2665":109290},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3170":65168,"_28017":65155,"_19412":109292,"_5":13306,"_25509":109263,"_2665":109293},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3170":65169,"_28017":65155,"_19412":109295,"_5":13306,"_25509":109263,"_2665":109296},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3170":65170,"_28017":65155,"_19412":109298,"_5":13306,"_25509":109267,"_2665":109299},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3170":65171,"_28017":65155,"_19412":109301,"_5":13306,"_25509":109267,"_2665":109302},[],"Ejemplo de cuerpo:",{"_3170":65172,"_28017":65155,"_19412":109304,"_5":13306,"_25509":109267,"_2665":109305},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3170":65173,"_28017":65155,"_19412":109307,"_5":13306,"_25509":109267,"_2665":109308},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3170":65174,"_28017":65155,"_19412":109310,"_5":13306,"_25509":109267,"_2665":109311},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3170":65175,"_28017":65155,"_19412":109313,"_5":13306,"_25509":109267,"_2665":109314},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3170":65176,"_28017":65155,"_19412":109316,"_5":13306,"_25509":109271,"_2665":109317},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_3170":65177,"_28017":65155,"_19412":109319,"_5":13306,"_25509":109271,"_2665":109320},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3170":65178,"_28017":65178,"_5":13637,"_2665":109322,"_28360":109323,"_19412":109324,"_25509":65178},"Configura y opera el DMS",[45425,108067,47826,109073,109248],[],{"_3170":65179,"_28017":65178,"_19412":109326,"_5":13306,"_25509":65178,"_2665":109327},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3170":65180,"_28017":65178,"_5":28357,"_19412":109329,"_25509":109330,"_2665":106720},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3170":65181,"_28017":65178,"_5":28357,"_19412":109332,"_25509":109333,"_2665":109334},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3170":65182,"_28017":65178,"_5":28357,"_19412":109336,"_25509":109337,"_2665":109338},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3170":65183,"_28017":65178,"_5":28357,"_19412":109340,"_25509":109341,"_2665":109342},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3170":65184,"_28017":65178,"_5":28357,"_19412":109344,"_25509":109345,"_2665":109346},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3170":65185,"_28017":65178,"_5":28357,"_19412":109348,"_25509":109349,"_2665":109350},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3170":65186,"_28017":65178,"_5":28357,"_19412":109352,"_25509":109353,"_2665":109354},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3170":65187,"_28017":65178,"_5":28357,"_19412":109356,"_25509":109357,"_2665":109358},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_3170":65188,"_28017":65178,"_5":28357,"_19412":109360,"_25509":109361,"_2665":48121},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_3170":65189,"_28017":65178,"_5":28357,"_19412":109363,"_25509":109364,"_2665":48125},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_3170":65190,"_28017":65178,"_5":28357,"_19412":109366,"_25509":109367,"_2665":109368},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_3170":65191,"_28017":65178,"_5":28357,"_19412":109370,"_25509":109371,"_2665":109372},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3170":65192,"_28017":65178,"_5":28357,"_19412":109374,"_25509":109375,"_2665":109376},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_3170":65193,"_28017":65178,"_5":28357,"_19412":109378,"_25509":109379,"_2665":109380},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3170":65194,"_28017":65178,"_5":28357,"_19412":109382,"_25509":109383,"_2665":48145},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_3170":65195,"_28017":65178,"_5":28357,"_19412":109385,"_25509":109386,"_2665":109387},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_3170":65196,"_28017":65178,"_5":28357,"_19412":109389,"_25509":109390,"_2665":109391},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3170":65197,"_28017":65178,"_5":28357,"_19412":109393,"_25509":109394,"_2665":109395},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3170":65198,"_28017":65178,"_19412":109397,"_5":13306,"_25509":65178,"_2665":109398},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3170":65199,"_28017":65178,"_19412":109400,"_5":13306,"_25509":109330,"_2665":109401},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3170":65200,"_28017":65178,"_19412":109403,"_5":13306,"_25509":109330,"_2665":109404},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3170":65201,"_28017":65178,"_19412":109406,"_5":13306,"_25509":109337,"_2665":109407},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3170":65202,"_28017":65178,"_19412":109409,"_5":13306,"_25509":109341,"_2665":109410},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3170":65203,"_28017":65178,"_19412":109412,"_5":13306,"_25509":109345,"_2665":109413},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3170":65204,"_28017":65178,"_19412":109415,"_5":13306,"_25509":109349,"_2665":109416},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3170":65205,"_28017":65178,"_19412":109418,"_5":13306,"_25509":109353,"_2665":109419},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3170":65206,"_28017":65178,"_19412":109421,"_5":13306,"_25509":109361,"_2665":109422},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_3170":65207,"_28017":65178,"_19412":109424,"_5":13306,"_25509":109361,"_2665":109425},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3170":65208,"_28017":65178,"_19412":109427,"_5":13306,"_25509":109364,"_2665":109428},[],"Campo de `settings.enrollment_settings`",{"_3170":65209,"_28017":65178,"_19412":109430,"_5":13306,"_25509":109364,"_2665":109431},[],"Decisión",{"_3170":65210,"_28017":65178,"_19412":109433,"_5":13306,"_25509":109364,"_2665":48196},[],{"_3170":65211,"_28017":65178,"_19412":109435,"_5":13306,"_25509":109364,"_2665":109436},[],"`EST_RFC7030` para estas operaciones.",{"_3170":65212,"_28017":65178,"_19412":109438,"_5":13306,"_25509":109364,"_2665":48202},[],{"_3170":65213,"_28017":65178,"_19412":109440,"_5":13306,"_25509":109364,"_2665":109441},[],"ID de la CA que firmará.",{"_3170":65214,"_28017":65178,"_19412":109443,"_5":13306,"_25509":109364,"_2665":48208},[],{"_3170":65215,"_28017":65178,"_19412":109445,"_5":13306,"_25509":109364,"_2665":109446},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3170":65216,"_28017":65178,"_19412":109448,"_5":13306,"_25509":109364,"_2665":48214},[],{"_3170":65217,"_28017":65178,"_19412":109450,"_5":13306,"_25509":109364,"_2665":109451},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3170":65218,"_28017":65178,"_19412":109453,"_5":13306,"_25509":109364,"_2665":48220},[],{"_3170":65219,"_28017":65178,"_19412":109455,"_5":13306,"_25509":109364,"_2665":109456},[],"Uno de los cuatro modos de autenticación.",{"_3170":65220,"_28017":65178,"_19412":109458,"_5":13306,"_25509":109364,"_2665":109459},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3170":65221,"_28017":65178,"_19412":109461,"_5":13306,"_25509":109367,"_2665":109462},[],"Los bloques son independientes:",{"_3170":65222,"_28017":65178,"_19412":109464,"_5":13306,"_25509":109367,"_2665":109465},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3170":65223,"_28017":65178,"_19412":109467,"_5":13306,"_25509":109367,"_2665":109468},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3170":65224,"_28017":65178,"_19412":109470,"_5":13306,"_25509":109367,"_2665":48238},[],{"_3170":65225,"_28017":65178,"_19412":109472,"_5":13306,"_25509":109367,"_2665":109473},[],"Control aplicado en la operación configurada",{"_3170":65226,"_28017":65178,"_19412":109475,"_5":13306,"_25509":109367,"_2665":48244},[],{"_3170":65227,"_28017":65178,"_19412":109477,"_5":13306,"_25509":109367,"_2665":109478},[],"Validación del certificado presentado.",{"_3170":65228,"_28017":65178,"_19412":109480,"_5":13306,"_25509":109367,"_2665":48250},[],{"_3170":65229,"_28017":65178,"_19412":109482,"_5":13306,"_25509":109367,"_2665":109483},[],"Autorización del webhook configurado.",{"_3170":65230,"_28017":65178,"_19412":109485,"_5":13306,"_25509":109367,"_2665":48256},[],{"_3170":65231,"_28017":65178,"_19412":109487,"_5":13306,"_25509":109367,"_2665":109488},[],"Validación del certificado y, después, aprobación del webhook.",{"_3170":65232,"_28017":65178,"_19412":109490,"_5":13306,"_25509":109367,"_2665":48262},[],{"_3170":65233,"_28017":65178,"_19412":109492,"_5":13306,"_25509":109367,"_2665":109493},[],"Sin autenticación del solicitante por el DMS.",{"_3170":65234,"_28017":65178,"_19412":109495,"_5":13306,"_25509":109367,"_2665":109496},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3170":65235,"_28017":65178,"_19412":109498,"_5":13306,"_25509":109367,"_2665":109499},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3170":65236,"_28017":65178,"_19412":109501,"_5":13306,"_25509":109367,"_2665":109502},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`.",{"_3170":65237,"_28017":65178,"_19412":109504,"_5":13306,"_25509":109367,"_2665":109505},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3170":65238,"_28017":65178,"_19412":109507,"_5":13306,"_25509":109371,"_2665":109508},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3170":65239,"_28017":65178,"_19412":109510,"_5":13306,"_25509":109371,"_2665":109511},[],"Campo de `external_webhook_settings`",{"_3170":65240,"_28017":65178,"_19412":109513,"_5":13306,"_25509":109371,"_2665":109431},[],{"_3170":65241,"_28017":65178,"_19412":109515,"_5":13306,"_25509":109371,"_2665":48288},[],{"_3170":65242,"_28017":65178,"_19412":109517,"_5":13306,"_25509":109371,"_2665":109518},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3170":65243,"_28017":65178,"_19412":109520,"_5":13306,"_25509":109371,"_2665":48294},[],{"_3170":65244,"_28017":65178,"_19412":109522,"_5":13306,"_25509":109371,"_2665":109523},[],"`POST` o `PUT`; `POST` por defecto.",{"_3170":65245,"_28017":65178,"_19412":109525,"_5":13306,"_25509":109371,"_2665":48300},[],{"_3170":65246,"_28017":65178,"_19412":109527,"_5":13306,"_25509":109371,"_2665":109528},[],"Etiqueta usada en los logs del servicio.",{"_3170":65247,"_28017":65178,"_19412":109530,"_5":13306,"_25509":109371,"_2665":48306},[],{"_3170":65248,"_28017":65178,"_19412":109532,"_5":13306,"_25509":109371,"_2665":109533},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3170":65249,"_28017":65178,"_19412":109535,"_5":13306,"_25509":109371,"_2665":48312},[],{"_3170":65250,"_28017":65178,"_19412":109537,"_5":13306,"_25509":109371,"_2665":109538},[],"Nivel de log de la llamada del webhook: `debug`, `info`, `warn` o `error`; `info` por defecto.",{"_3170":65251,"_28017":65178,"_19412":109540,"_5":13306,"_25509":109371,"_2665":48318},[],{"_3170":65252,"_28017":65178,"_19412":109542,"_5":13306,"_25509":109371,"_2665":109543},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3170":65253,"_28017":65178,"_19412":109545,"_5":13306,"_25509":109371,"_2665":48324},[],{"_3170":65254,"_28017":65178,"_19412":109547,"_5":13306,"_25509":109371,"_2665":109548},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3170":65255,"_28017":65178,"_19412":109550,"_5":13306,"_25509":109371,"_2665":48330},[],{"_3170":65256,"_28017":65178,"_19412":109552,"_5":13306,"_25509":109371,"_2665":109553},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3170":65257,"_28017":65178,"_19412":109555,"_5":13306,"_25509":109371,"_2665":48336},[],{"_3170":65258,"_28017":65178,"_19412":109557,"_5":13306,"_25509":109371,"_2665":109558},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3170":65259,"_28017":65178,"_19412":109560,"_5":13306,"_25509":109371,"_2665":48342},[],{"_3170":65260,"_28017":65178,"_19412":109562,"_5":13306,"_25509":109371,"_2665":109563},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3170":65261,"_28017":65178,"_19412":109565,"_5":13306,"_25509":109371,"_2665":109566},[],"Reglas de esa configuración:",{"_3170":65262,"_28017":65178,"_19412":109568,"_5":13306,"_25509":109371,"_2665":109569},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3170":65263,"_28017":65178,"_19412":109571,"_5":13306,"_25509":109371,"_2665":109572},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3170":65264,"_28017":65178,"_19412":109574,"_5":13306,"_25509":109371,"_2665":109575},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3170":65265,"_28017":65178,"_19412":109577,"_5":13306,"_25509":109371,"_2665":109578},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3170":65266,"_28017":65178,"_19412":109580,"_5":13306,"_25509":109371,"_2665":109581},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3170":65267,"_28017":65178,"_19412":109583,"_5":13306,"_25509":109371,"_2665":109584},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3170":65268,"_28017":65178,"_19412":109586,"_5":13306,"_25509":109371,"_2665":109587},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento, con los mismos campos Log Level, Call Timeout, HTTP Authentication y credenciales que los canales webhook, además de un interruptor **Skip TLS Verification** (desactivado por defecto, así que la verificación permanece activa; la consola avisa cuando lo activas).",{"_3170":65269,"_28017":65178,"_19412":109589,"_5":13306,"_25509":109371,"_2665":109590},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Para corregirlo en la consola, abre el DMS, sustituye cualquier valor de ruta de fichero por contenido PEM — el editor rechaza las rutas de fichero con un error en el propio campo — y guarda. Al guardar se reescribe `external_webhook_settings.config` con las claves actuales, y la consola lee tanto el PEM sin codificar como el codificado en Base64 de las configuraciones migradas, y almacena el material codificado en Base64. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3170":65270,"_28017":65178,"_19412":109592,"_5":13306,"_25509":109371,"_2665":109593},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3170":65271,"_28017":65178,"_19412":109595,"_5":13306,"_25509":109375,"_2665":109596},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3170":65272,"_28017":65178,"_19412":109598,"_5":13306,"_25509":109379,"_2665":109599},[],"Campo de `settings.reenrollment_settings`",{"_3170":65273,"_28017":65178,"_19412":109601,"_5":13306,"_25509":109379,"_2665":109602},[],"Función",{"_3170":65274,"_28017":65178,"_19412":109604,"_5":13306,"_25509":109379,"_2665":48386},[],{"_3170":65275,"_28017":65178,"_19412":109606,"_5":13306,"_25509":109379,"_2665":109607},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3170":65276,"_28017":65178,"_19412":109609,"_5":13306,"_25509":109379,"_2665":48392},[],{"_3170":65277,"_28017":65178,"_19412":109611,"_5":13306,"_25509":109379,"_2665":109612},[],"Umbral operativo preventivo de monitorización.",{"_3170":65278,"_28017":65178,"_19412":109614,"_5":13306,"_25509":109379,"_2665":48398},[],{"_3170":65279,"_28017":65178,"_19412":109616,"_5":13306,"_25509":109379,"_2665":109617},[],"Umbral operativo crítico de monitorización.",{"_3170":65280,"_28017":65178,"_19412":109619,"_5":13306,"_25509":109379,"_2665":48404},[],{"_3170":65281,"_28017":65178,"_19412":109621,"_5":13306,"_25509":109379,"_2665":109622},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3170":65282,"_28017":65178,"_19412":109624,"_5":13306,"_25509":109379,"_2665":48410},[],{"_3170":65283,"_28017":65178,"_19412":109626,"_5":13306,"_25509":109379,"_2665":109627},[],"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3170":65284,"_28017":65178,"_19412":109629,"_5":13306,"_25509":109379,"_2665":48416},[],{"_3170":65285,"_28017":65178,"_19412":109631,"_5":13306,"_25509":109379,"_2665":109632},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3170":65286,"_28017":65178,"_19412":109634,"_5":13306,"_25509":109379,"_2665":109635},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_3170":65287,"_28017":65178,"_19412":109637,"_5":13306,"_25509":109383,"_2665":109638},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_3170":65288,"_28017":65178,"_19412":109640,"_5":13306,"_25509":109386,"_2665":107084},[],{"_3170":65289,"_28017":65178,"_19412":109642,"_5":13306,"_25509":109386,"_2665":109643},[],"Qué publica",{"_3170":65290,"_28017":65178,"_19412":109645,"_5":13306,"_25509":109386,"_2665":48433},[],{"_3170":65291,"_28017":65178,"_19412":109647,"_5":13306,"_25509":109386,"_2665":109648},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3170":65292,"_28017":65178,"_19412":109650,"_5":13306,"_25509":109386,"_2665":48439},[],{"_3170":65293,"_28017":65178,"_19412":109652,"_5":13306,"_25509":109386,"_2665":109653},[],"Certificado de la CA emisora seleccionada.",{"_3170":65294,"_28017":65178,"_19412":109655,"_5":13306,"_25509":109386,"_2665":48445},[],{"_3170":65295,"_28017":65178,"_19412":109657,"_5":13306,"_25509":109386,"_2665":109658},[],"Certificados de las CAs elegidas explícitamente.",{"_3170":65296,"_28017":65178,"_19412":109660,"_5":13306,"_25509":109386,"_2665":109661},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_3170":65297,"_28017":65178,"_19412":109663,"_5":13306,"_25509":109390,"_2665":109664},[],"**Edit** cambia nombre, ajustes y metadatos. La actualización del backend sustituye esos bloques completos; al usar la API, lee el DMS antes de enviar una edición para no perder campos.",{"_3170":65298,"_28017":65178,"_19412":109666,"_5":13306,"_25509":109390,"_2665":109667},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3170":65299,"_28017":65178,"_19412":109669,"_5":13306,"_25509":109390,"_2665":109670},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3170":65300,"_28017":65178,"_19412":109672,"_5":13306,"_25509":109394,"_2665":109673},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3170":65301,"_28017":65301,"_5":13637,"_2665":109675,"_28360":109676,"_19412":109677,"_25509":65301},"Integra el cliente EST",[45425,108067,47826,109073,109248],[],{"_3170":65302,"_28017":65301,"_19412":109679,"_5":13306,"_25509":65301,"_2665":109680},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_3170":65303,"_28017":65301,"_5":28357,"_19412":109682,"_25509":109683,"_2665":106720},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_3170":65304,"_28017":65301,"_5":28357,"_19412":109685,"_25509":109686,"_2665":109687},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_3170":65305,"_28017":65301,"_5":28357,"_19412":109689,"_25509":109690,"_2665":109691},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_3170":65306,"_28017":65301,"_5":28357,"_19412":109693,"_25509":109694,"_2665":109695},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_3170":65307,"_28017":65301,"_5":28357,"_19412":109697,"_25509":109698,"_2665":109699},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_3170":65308,"_28017":65301,"_5":28357,"_19412":109701,"_25509":109702,"_2665":109703},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_3170":65309,"_28017":65301,"_19412":109705,"_5":13306,"_25509":65301,"_2665":109706},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_3170":65310,"_28017":65301,"_19412":109708,"_5":13306,"_25509":109683,"_2665":109709},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3170":65311,"_28017":65301,"_19412":109711,"_5":13306,"_25509":109683,"_2665":109712},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3170":65312,"_28017":65301,"_19412":109714,"_5":13306,"_25509":109683,"_2665":109715},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3170":65313,"_28017":65301,"_19412":109717,"_5":13306,"_25509":109686,"_2665":109718},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_3170":65314,"_28017":65301,"_19412":109720,"_5":13306,"_25509":109686,"_2665":109721},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3170":65315,"_28017":65301,"_19412":109723,"_5":13306,"_25509":109690,"_2665":109724},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3170":65316,"_28017":65301,"_19412":109726,"_5":13306,"_25509":109690,"_2665":109727},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3170":65317,"_28017":65301,"_19412":109729,"_5":13306,"_25509":109694,"_2665":109730},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3170":65318,"_28017":65301,"_19412":109732,"_5":13306,"_25509":109694,"_2665":109733},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3170":65319,"_28017":65301,"_19412":109735,"_5":13306,"_25509":109698,"_2665":109736},[],"Para el caso de una raíz que emite directamente:",{"_3170":65320,"_28017":65301,"_19412":109738,"_5":13306,"_25509":109698,"_2665":109739},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3170":65321,"_28017":65301,"_19412":109741,"_5":13306,"_25509":109698,"_2665":109742},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3170":65322,"_28017":65301,"_19412":109744,"_5":13306,"_25509":109702,"_2665":109745},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_3170":65323,"_28017":65323,"_5":13637,"_2665":109747,"_28360":109748,"_19412":109749,"_25509":65323},"Referencia EST",[45425,108067,47826,109073,109248],[],{"_3170":65324,"_28017":65323,"_19412":109751,"_5":13306,"_25509":65323,"_2665":109752},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_3170":65325,"_28017":65323,"_5":28357,"_19412":109754,"_25509":109755,"_2665":109756},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_3170":65326,"_28017":65323,"_5":28357,"_19412":109758,"_25509":109759,"_2665":21097},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3170":65327,"_28017":65323,"_5":28357,"_19412":109761,"_25509":109762,"_2665":24195},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3170":65328,"_28017":65323,"_5":28357,"_19412":109764,"_25509":109765,"_2665":24202},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3170":65329,"_28017":65323,"_5":28357,"_19412":109767,"_25509":109768,"_2665":23547},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3170":65330,"_28017":65323,"_5":28357,"_19412":109770,"_25509":109771,"_2665":109772},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_3170":65331,"_28017":65323,"_5":28357,"_19412":109774,"_25509":109775,"_2665":109776},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_3170":65332,"_28017":65323,"_5":28357,"_19412":109778,"_25509":109779,"_2665":109780},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_3170":65333,"_28017":65323,"_19412":109782,"_5":13306,"_25509":65323,"_2665":109783},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_3170":65334,"_28017":65323,"_19412":109785,"_5":13306,"_25509":109755,"_2665":109786},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3170":65335,"_28017":65323,"_19412":109788,"_5":13306,"_25509":109755,"_2665":107855},[],{"_3170":65336,"_28017":65323,"_19412":109790,"_5":13306,"_25509":109755,"_2665":109791},[],"Método",{"_3170":65337,"_28017":65323,"_19412":109793,"_5":13306,"_25509":109755,"_2665":109794},[],"Autenticación y condición",{"_3170":65338,"_28017":65323,"_19412":109796,"_5":13306,"_25509":109755,"_2665":48588},[],{"_3170":65339,"_28017":65323,"_19412":109798,"_5":13306,"_25509":109755,"_2665":48591},[],{"_3170":65340,"_28017":65323,"_19412":109800,"_5":13306,"_25509":109755,"_2665":109801},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3170":65341,"_28017":65323,"_19412":109803,"_5":13306,"_25509":109755,"_2665":48597},[],{"_3170":65342,"_28017":65323,"_19412":109805,"_5":13306,"_25509":109755,"_2665":48600},[],{"_3170":65343,"_28017":65323,"_19412":109807,"_5":13306,"_25509":109755,"_2665":109808},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3170":65344,"_28017":65323,"_19412":109810,"_5":13306,"_25509":109755,"_2665":48606},[],{"_3170":65345,"_28017":65323,"_19412":109812,"_5":13306,"_25509":109755,"_2665":48600},[],{"_3170":65346,"_28017":65323,"_19412":109814,"_5":13306,"_25509":109755,"_2665":109815},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3170":65347,"_28017":65323,"_19412":109817,"_5":13306,"_25509":109755,"_2665":48614},[],{"_3170":65348,"_28017":65323,"_19412":109819,"_5":13306,"_25509":109755,"_2665":48600},[],{"_3170":65349,"_28017":65323,"_19412":109821,"_5":13306,"_25509":109755,"_2665":109822},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_3170":65350,"_28017":65323,"_19412":109824,"_5":13306,"_25509":109755,"_2665":109825},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3170":65351,"_28017":65323,"_19412":109827,"_5":13306,"_25509":109759,"_2665":109828},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_3170":65352,"_28017":65323,"_19412":109830,"_5":13306,"_25509":109759,"_2665":109831},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_3170":65353,"_28017":65323,"_19412":109833,"_5":13306,"_25509":109762,"_2665":109834},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_3170":65354,"_28017":65323,"_19412":109836,"_5":13306,"_25509":109762,"_2665":109837},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_3170":65355,"_28017":65323,"_19412":109839,"_5":13306,"_25509":109765,"_2665":109840},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_3170":65356,"_28017":65323,"_19412":109842,"_5":13306,"_25509":109765,"_2665":109843},[],"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_3170":65357,"_28017":65323,"_19412":109845,"_5":13306,"_25509":109768,"_2665":109846},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_3170":65358,"_28017":65323,"_19412":109848,"_5":13306,"_25509":109768,"_2665":109849},[],"El código admite RSA y ECDSA, y el valor `bits` del ajuste de clave del DMS significa algo distinto en cada caso. En ECDSA selecciona la curva: 224, 256, 384 o 521 corresponden a P-224, P-256, P-384 y P-521, y un tamaño no reconocido produce fallback a P-256, así que elige explícitamente un tamaño compatible y comprueba la clave resultante. En RSA se usa directamente como tamaño del módulo; la consola ofrece 2048, 3072 y 4096 bits. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_3170":65359,"_28017":65323,"_19412":109851,"_5":13306,"_25509":109771,"_2665":109852},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3170":65360,"_28017":65323,"_19412":109854,"_5":13306,"_25509":109771,"_2665":109855},[],"Parte",{"_3170":65361,"_28017":65323,"_19412":109857,"_5":13306,"_25509":109771,"_2665":109858},[],"Contenido tras decodificar su Base64",{"_3170":65362,"_28017":65323,"_19412":109860,"_5":13306,"_25509":109771,"_2665":48658},[],{"_3170":65363,"_28017":65323,"_19412":109862,"_5":13306,"_25509":109771,"_2665":109863},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3170":65364,"_28017":65323,"_19412":109865,"_5":13306,"_25509":109771,"_2665":48664},[],{"_3170":65365,"_28017":65323,"_19412":109867,"_5":13306,"_25509":109771,"_2665":109868},[],"PKCS#7 DER con el certificado emitido.",{"_3170":65366,"_28017":65323,"_19412":109870,"_5":13306,"_25509":109771,"_2665":109871},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3170":65367,"_28017":65323,"_19412":109873,"_5":13306,"_25509":109775,"_2665":109874},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3170":65368,"_28017":65323,"_19412":109876,"_5":13306,"_25509":109775,"_2665":109877},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_3170":65369,"_28017":65323,"_19412":109879,"_5":13306,"_25509":109775,"_2665":109880},[],"Convierte y comprueba el resultado:",{"_3170":65370,"_28017":65323,"_19412":109882,"_5":13306,"_25509":109775,"_2665":109883},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_3170":65371,"_28017":65323,"_19412":109885,"_5":13306,"_25509":109779,"_2665":109886},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3170":65372,"_28017":65323,"_19412":109888,"_5":13306,"_25509":109779,"_2665":109889},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3170":65373,"_28017":65373,"_5":13637,"_2665":109248,"_28360":109891,"_19412":109892,"_25509":65373},[45425,108067,47826,109073,109248],[],{"_3170":65374,"_28017":65373,"_19412":109894,"_5":13306,"_25509":65373,"_2665":109895},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_3170":65375,"_28017":65373,"_5":28357,"_19412":109897,"_25509":109898,"_2665":109899},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3170":65376,"_28017":65373,"_5":28357,"_19412":109901,"_25509":109902,"_2665":109903},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3170":65377,"_28017":65373,"_5":28357,"_19412":109905,"_25509":109906,"_2665":109907},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3170":65378,"_28017":65373,"_5":28357,"_19412":109909,"_25509":109910,"_2665":109911},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_3170":65379,"_28017":65373,"_19412":109913,"_5":13306,"_25509":65373,"_2665":109914},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3170":65380,"_28017":65373,"_19412":109916,"_5":13306,"_25509":109898,"_2665":109917},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3170":65381,"_28017":65373,"_19412":109919,"_5":13306,"_25509":109898,"_2665":109920},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3170":65382,"_28017":65373,"_19412":109922,"_5":13306,"_25509":109898,"_2665":109923},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3170":65383,"_28017":65373,"_19412":109925,"_5":13306,"_25509":109898,"_2665":109926},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3170":65384,"_28017":65373,"_19412":109928,"_5":13306,"_25509":109898,"_2665":109929},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3170":65385,"_28017":65373,"_19412":109931,"_5":13306,"_25509":109898,"_2665":109932},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3170":65386,"_28017":65373,"_19412":109934,"_5":13306,"_25509":109902,"_2665":109935},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3170":65387,"_28017":65373,"_19412":109937,"_5":13306,"_25509":109902,"_2665":109938},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3170":65388,"_28017":65373,"_19412":109940,"_5":13306,"_25509":109902,"_2665":109941},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3170":65389,"_28017":65373,"_19412":109943,"_5":13306,"_25509":109902,"_2665":109944},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3170":65390,"_28017":65373,"_19412":109946,"_5":13306,"_25509":109906,"_2665":109947},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3170":65391,"_28017":65373,"_19412":109949,"_5":13306,"_25509":109906,"_2665":109950},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3170":65392,"_28017":65373,"_19412":109952,"_5":13306,"_25509":109906,"_2665":109953},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3170":65393,"_28017":65373,"_19412":109955,"_5":13306,"_25509":109906,"_2665":109956},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3170":65394,"_28017":65373,"_19412":109958,"_5":13306,"_25509":109910,"_2665":109959},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_3170":65395,"_28017":65373,"_19412":109961,"_5":13306,"_25509":109910,"_2665":109962},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3170":65396,"_28017":65396,"_5":13637,"_2665":109964,"_28360":109965,"_19412":109966,"_25509":65396},"Estrategias de aprovisionamiento",[45425,108067,47826,109073,109248],[],{"_3170":65397,"_28017":65396,"_19412":109968,"_5":13306,"_25509":65396,"_2665":109969},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3170":65398,"_28017":65396,"_5":28357,"_19412":109971,"_25509":109972,"_2665":109973},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3170":65399,"_28017":65396,"_5":28357,"_19412":109975,"_25509":109976,"_2665":109977},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3170":65400,"_28017":65396,"_5":28357,"_19412":109979,"_25509":109980,"_2665":109981},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3170":65401,"_28017":65396,"_5":28357,"_19412":109983,"_25509":109984,"_2665":109985},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3170":65402,"_28017":65396,"_5":28357,"_19412":109987,"_25509":109988,"_2665":109989},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3170":65403,"_28017":65396,"_19412":109991,"_5":13306,"_25509":65396,"_2665":109992},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3170":65404,"_28017":65396,"_19412":109994,"_5":13306,"_25509":109972,"_2665":109995},[],"Recorrido",{"_3170":65405,"_28017":65396,"_19412":109997,"_5":13306,"_25509":109972,"_2665":109998},[],"Cuándo existe el dispositivo",{"_3170":65406,"_28017":65396,"_19412":110000,"_5":13306,"_25509":109972,"_2665":110001},[],"Qué compruebas",{"_3170":65407,"_28017":65396,"_19412":110003,"_5":13306,"_25509":109972,"_2665":110004},[],"Asignación manual",{"_3170":65408,"_28017":65396,"_19412":110006,"_5":13306,"_25509":109972,"_2665":110007},[],"El operador lo crea antes de asociar un certificado.",{"_3170":65409,"_28017":65396,"_19412":110009,"_5":13306,"_25509":109972,"_2665":110010},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3170":65410,"_28017":65396,"_19412":110012,"_5":13306,"_25509":109972,"_2665":110013},[],"EST con `JITP`",{"_3170":65411,"_28017":65396,"_19412":110015,"_5":13306,"_25509":109972,"_2665":110016},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3170":65412,"_28017":65396,"_19412":110018,"_5":13306,"_25509":109972,"_2665":110019},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3170":65413,"_28017":65396,"_19412":110021,"_5":13306,"_25509":109972,"_2665":110022},[],"EST con `PRE_REGISTRATION`",{"_3170":65414,"_28017":65396,"_19412":110024,"_5":13306,"_25509":109972,"_2665":110025},[],"Debe existir antes de `/simpleenroll`.",{"_3170":65415,"_28017":65396,"_19412":110027,"_5":13306,"_25509":109972,"_2665":110028},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3170":65416,"_28017":65396,"_19412":110030,"_5":13306,"_25509":109972,"_2665":110031},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3170":65417,"_28017":65396,"_19412":110033,"_5":13306,"_25509":109972,"_2665":110034},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3170":65418,"_28017":65396,"_19412":110036,"_5":13306,"_25509":109976,"_2665":110037},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3170":65419,"_28017":65396,"_19412":110039,"_5":13306,"_25509":109976,"_2665":110040},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3170":65420,"_28017":65396,"_19412":110042,"_5":13306,"_25509":109976,"_2665":110043},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3170":65421,"_28017":65396,"_19412":110045,"_5":13306,"_25509":109980,"_2665":110046},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3170":65422,"_28017":65396,"_19412":110048,"_5":13306,"_25509":109980,"_2665":110049},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3170":65423,"_28017":65396,"_19412":110051,"_5":13306,"_25509":109980,"_2665":110052},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3170":65424,"_28017":65396,"_19412":110054,"_5":13306,"_25509":109980,"_2665":110055},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3170":65425,"_28017":65396,"_19412":110057,"_5":13306,"_25509":109980,"_2665":110058},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3170":65426,"_28017":65396,"_19412":110060,"_5":13306,"_25509":109980,"_2665":110061},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3170":65427,"_28017":65396,"_19412":110063,"_5":13306,"_25509":109984,"_2665":107084},[],{"_3170":65428,"_28017":65396,"_19412":110065,"_5":13306,"_25509":109984,"_2665":110066},[],"Material que atraviesa EST",{"_3170":65429,"_28017":65396,"_19412":110068,"_5":13306,"_25509":109984,"_2665":110069},[],"Clave generada por el dispositivo",{"_3170":65430,"_28017":65396,"_19412":110071,"_5":13306,"_25509":109984,"_2665":110072},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3170":65431,"_28017":65396,"_19412":110074,"_5":13306,"_25509":109984,"_2665":110075},[],"Clave ya disponible en el dispositivo",{"_3170":65432,"_28017":65396,"_19412":110077,"_5":13306,"_25509":109984,"_2665":110078},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3170":65433,"_28017":65396,"_19412":110080,"_5":13306,"_25509":109984,"_2665":48145},[],{"_3170":65434,"_28017":65396,"_19412":110082,"_5":13306,"_25509":109984,"_2665":110083},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3170":65435,"_28017":65396,"_19412":110085,"_5":13306,"_25509":109984,"_2665":110086},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3170":65436,"_28017":65396,"_19412":110088,"_5":13306,"_25509":109988,"_2665":110089},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3170":65437,"_28017":65437,"_5":13637,"_2665":110091,"_28360":110092,"_19412":110093,"_25509":65437},"Renovación y recuperación",[45425,108067,47826,109073,109248],[],{"_3170":65438,"_28017":65437,"_19412":110095,"_5":13306,"_25509":65437,"_2665":110096},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_3170":65439,"_28017":65437,"_5":28357,"_19412":110098,"_25509":110099,"_2665":110100},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_3170":65440,"_28017":65437,"_5":28357,"_19412":110102,"_25509":110103,"_2665":110104},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_3170":65441,"_28017":65437,"_5":28357,"_19412":110106,"_25509":110107,"_2665":110108},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_3170":65442,"_28017":65437,"_5":28357,"_19412":110110,"_25509":110111,"_2665":110112},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_3170":65443,"_28017":65437,"_5":28357,"_19412":110114,"_25509":110115,"_2665":110116},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_3170":65444,"_28017":65437,"_19412":110118,"_5":13306,"_25509":65437,"_2665":110119},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_3170":65445,"_28017":65437,"_19412":110121,"_5":13306,"_25509":110099,"_2665":110122},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3170":65446,"_28017":65437,"_19412":110124,"_5":13306,"_25509":110099,"_2665":110125},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3170":65447,"_28017":65437,"_19412":110127,"_5":13306,"_25509":110099,"_2665":110128},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3170":65448,"_28017":65437,"_19412":110130,"_5":13306,"_25509":110099,"_2665":110131},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3170":65449,"_28017":65437,"_19412":110133,"_5":13306,"_25509":110103,"_2665":110134},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3170":65450,"_28017":65437,"_19412":110136,"_5":13306,"_25509":110103,"_2665":110137},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3170":65451,"_28017":65437,"_19412":110139,"_5":13306,"_25509":110107,"_2665":110140},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3170":65452,"_28017":65437,"_19412":110142,"_5":13306,"_25509":110107,"_2665":110143},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3170":65453,"_28017":65437,"_19412":110145,"_5":13306,"_25509":110107,"_2665":110146},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3170":65454,"_28017":65437,"_19412":110148,"_5":13306,"_25509":110111,"_2665":110149},[],"Situación",{"_3170":65455,"_28017":65437,"_19412":110151,"_5":13306,"_25509":110111,"_2665":110152},[],"Procedimiento",{"_3170":65456,"_28017":65437,"_19412":110154,"_5":13306,"_25509":110111,"_2665":110155},[],"Certificado vigente, fuera de ventana",{"_3170":65457,"_28017":65437,"_19412":110157,"_5":13306,"_25509":110111,"_2665":110158},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3170":65458,"_28017":65437,"_19412":110160,"_5":13306,"_25509":110111,"_2665":110161},[],"Certificado vencido, clave disponible",{"_3170":65459,"_28017":65437,"_19412":110163,"_5":13306,"_25509":110111,"_2665":110164},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3170":65460,"_28017":65437,"_19412":110166,"_5":13306,"_25509":110111,"_2665":110167},[],"Renovación por webhook o `NO_AUTH`",{"_3170":65461,"_28017":65437,"_19412":110169,"_5":13306,"_25509":110111,"_2665":110170},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3170":65462,"_28017":65437,"_19412":110172,"_5":13306,"_25509":110111,"_2665":110173},[],"Clave perdida o inaccesible",{"_3170":65463,"_28017":65437,"_19412":110175,"_5":13306,"_25509":110111,"_2665":110176},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3170":65464,"_28017":65437,"_19412":110178,"_5":13306,"_25509":110111,"_2665":110179},[],"Identidad actual revocada",{"_3170":65465,"_28017":65437,"_19412":110181,"_5":13306,"_25509":110111,"_2665":110182},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3170":65466,"_28017":65437,"_19412":110184,"_5":13306,"_25509":110111,"_2665":110185},[],"Dispositivo sin identidad",{"_3170":65467,"_28017":65437,"_19412":110187,"_5":13306,"_25509":110111,"_2665":110188},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3170":65468,"_28017":65437,"_19412":110190,"_5":13306,"_25509":110111,"_2665":110191},[],"Dispositivo retirado",{"_3170":65469,"_28017":65437,"_19412":110193,"_5":13306,"_25509":110111,"_2665":110194},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3170":65470,"_28017":65437,"_19412":110196,"_5":13306,"_25509":110111,"_2665":110197},[],"Timeout, HTTP 500 o fallo de instalación",{"_3170":65471,"_28017":65437,"_19412":110199,"_5":13306,"_25509":110111,"_2665":110200},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3170":65472,"_28017":65437,"_19412":110202,"_5":13306,"_25509":110115,"_2665":110203},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3170":65473,"_28017":65437,"_19412":110205,"_5":13306,"_25509":110115,"_2665":110206},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3170":65474,"_28017":65474,"_5":13637,"_2665":110208,"_28360":110209,"_19412":110210,"_25509":65474},"Diagnóstico de enrolamiento",[45425,108067,47826,109073,109248],[],{"_3170":65475,"_28017":65474,"_19412":110212,"_5":13306,"_25509":65474,"_2665":110213},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3170":65476,"_28017":65474,"_5":28357,"_19412":110215,"_25509":110216,"_2665":110217},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3170":65477,"_28017":65474,"_5":28357,"_19412":110219,"_25509":110220,"_2665":110221},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3170":65478,"_28017":65474,"_5":28357,"_19412":110223,"_25509":110224,"_2665":109780},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_3170":65479,"_28017":65474,"_5":28357,"_19412":110226,"_25509":110227,"_2665":110228},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3170":65480,"_28017":65474,"_19412":110230,"_5":13306,"_25509":65474,"_2665":110231},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3170":65481,"_28017":65474,"_19412":110233,"_5":13306,"_25509":110220,"_2665":110234},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3170":65482,"_28017":65474,"_19412":110236,"_5":13306,"_25509":110220,"_2665":110237},[],"Síntoma o mensaje",{"_3170":65483,"_28017":65474,"_19412":110239,"_5":13306,"_25509":110220,"_2665":110240},[],"Qué revisar",{"_3170":65484,"_28017":65474,"_19412":110242,"_5":13306,"_25509":110220,"_2665":110243},[],"curl rechaza TLS, nombre o emisor",{"_3170":65485,"_28017":65474,"_19412":110245,"_5":13306,"_25509":110220,"_2665":110246},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3170":65486,"_28017":65474,"_19412":110248,"_5":13306,"_25509":110220,"_2665":110249},[],"404 o APS ausente",{"_3170":65487,"_28017":65474,"_19412":110251,"_5":13306,"_25509":110220,"_2665":110252},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3170":65488,"_28017":65474,"_19412":110254,"_5":13306,"_25509":110220,"_2665":110255},[],"400, error de CSR o formato",{"_3170":65489,"_28017":65474,"_19412":110257,"_5":13306,"_25509":110220,"_2665":110258},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3170":65490,"_28017":65474,"_19412":110260,"_5":13306,"_25509":110220,"_2665":110261},[],"Credencial ausente o certificado no válido",{"_3170":65491,"_28017":65474,"_19412":110263,"_5":13306,"_25509":110220,"_2665":110264},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3170":65492,"_28017":65474,"_19412":110266,"_5":13306,"_25509":110220,"_2665":110267},[],"Webhook deniega, expira o responde sin autorización",{"_3170":65493,"_28017":65474,"_19412":110269,"_5":13306,"_25509":110220,"_2665":110270},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3170":65494,"_28017":65474,"_19412":110272,"_5":13306,"_25509":110220,"_2665":49071},[],{"_3170":65495,"_28017":65474,"_19412":110274,"_5":13306,"_25509":110220,"_2665":110275},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3170":65496,"_28017":65474,"_19412":110277,"_5":13306,"_25509":110220,"_2665":49077},[],{"_3170":65497,"_28017":65474,"_19412":110279,"_5":13306,"_25509":110220,"_2665":110280},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3170":65498,"_28017":65474,"_19412":110282,"_5":13306,"_25509":110220,"_2665":49083},[],{"_3170":65499,"_28017":65474,"_19412":110284,"_5":13306,"_25509":110220,"_2665":110285},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3170":65500,"_28017":65474,"_19412":110287,"_5":13306,"_25509":110220,"_2665":49089},[],{"_3170":65501,"_28017":65474,"_19412":110289,"_5":13306,"_25509":110220,"_2665":110290},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3170":65502,"_28017":65474,"_19412":110292,"_5":13306,"_25509":110220,"_2665":49095},[],{"_3170":65503,"_28017":65474,"_19412":110294,"_5":13306,"_25509":110220,"_2665":110295},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3170":65504,"_28017":65474,"_19412":110297,"_5":13306,"_25509":110220,"_2665":110298},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3170":65505,"_28017":65474,"_19412":110300,"_5":13306,"_25509":110220,"_2665":110301},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3170":65506,"_28017":65474,"_19412":110303,"_5":13306,"_25509":110220,"_2665":110304},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3170":65507,"_28017":65474,"_19412":110306,"_5":13306,"_25509":110220,"_2665":110307},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3170":65508,"_28017":65474,"_19412":110309,"_5":13306,"_25509":110220,"_2665":49113},[],{"_3170":65509,"_28017":65474,"_19412":110311,"_5":13306,"_25509":110220,"_2665":110312},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3170":65510,"_28017":65474,"_19412":110314,"_5":13306,"_25509":110220,"_2665":49119},[],{"_3170":65511,"_28017":65474,"_19412":110316,"_5":13306,"_25509":110220,"_2665":110317},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3170":65512,"_28017":65474,"_19412":110319,"_5":13306,"_25509":110220,"_2665":110320},[],"DMS propietario distinto",{"_3170":65513,"_28017":65474,"_19412":110322,"_5":13306,"_25509":110220,"_2665":110323},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3170":65514,"_28017":65474,"_19412":110325,"_5":13306,"_25509":110220,"_2665":49131},[],{"_3170":65515,"_28017":65474,"_19412":110327,"_5":13306,"_25509":110220,"_2665":110328},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3170":65516,"_28017":65474,"_19412":110330,"_5":13306,"_25509":110220,"_2665":49137},[],{"_3170":65517,"_28017":65474,"_19412":110332,"_5":13306,"_25509":110220,"_2665":110333},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3170":65518,"_28017":65474,"_19412":110335,"_5":13306,"_25509":110220,"_2665":110336},[],"Certificado actual revocado",{"_3170":65519,"_28017":65474,"_19412":110338,"_5":13306,"_25509":110220,"_2665":110339},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3170":65520,"_28017":65474,"_19412":110341,"_5":13306,"_25509":110220,"_2665":110342},[],"Error de CA, perfil o firma",{"_3170":65521,"_28017":65474,"_19412":110344,"_5":13306,"_25509":110220,"_2665":110345},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3170":65522,"_28017":65474,"_19412":110347,"_5":13306,"_25509":110220,"_2665":110348},[],"HTTP 200 sin conexión del dispositivo",{"_3170":65523,"_28017":65474,"_19412":110350,"_5":13306,"_25509":110220,"_2665":110351},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3170":65524,"_28017":65474,"_19412":110353,"_5":13306,"_25509":110220,"_2665":110354},[],"Timeout o error después de emitir",{"_3170":65525,"_28017":65474,"_19412":110356,"_5":13306,"_25509":110220,"_2665":110357},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3170":65526,"_28017":65474,"_19412":110359,"_5":13306,"_25509":110224,"_2665":110360},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3170":65527,"_28017":65474,"_19412":110362,"_5":13306,"_25509":110224,"_2665":110363},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_3170":65528,"_28017":65474,"_19412":110365,"_5":13306,"_25509":110227,"_2665":110366},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3170":65529,"_28017":65474,"_19412":110368,"_5":13306,"_25509":110227,"_2665":110369},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3170":65530,"_28017":65474,"_19412":110371,"_5":13306,"_25509":110227,"_2665":110372},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3170":65531,"_28017":65474,"_19412":110374,"_5":13306,"_25509":110227,"_2665":110375},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3170":65532,"_28017":65474,"_19412":110377,"_5":13306,"_25509":110227,"_2665":110378},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3170":65533,"_28017":65474,"_19412":110380,"_5":13306,"_25509":110227,"_2665":110381},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3170":65534,"_28017":65474,"_19412":110383,"_5":13306,"_25509":110227,"_2665":110384},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3170":65535,"_28017":65535,"_5":13637,"_2665":110386,"_28360":110387,"_19412":110388,"_25509":65535},"Distribución y actualización de confianza",[45425,108067,47826,109073,109248],[],{"_3170":65536,"_28017":65535,"_19412":110390,"_5":13306,"_25509":65535,"_2665":110391},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_3170":65537,"_28017":65535,"_5":28357,"_19412":110393,"_25509":110394,"_2665":110395},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_3170":65538,"_28017":65535,"_5":28357,"_19412":110397,"_25509":110398,"_2665":110399},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_3170":65539,"_28017":65535,"_5":28357,"_19412":110401,"_25509":110402,"_2665":110403},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_3170":65540,"_28017":65535,"_5":28357,"_19412":110405,"_25509":110406,"_2665":110407},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_3170":65541,"_28017":65535,"_5":28357,"_19412":110409,"_25509":110410,"_2665":110411},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_3170":65542,"_28017":65535,"_19412":110413,"_5":13306,"_25509":65535,"_2665":110414},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_3170":65543,"_28017":65535,"_19412":110416,"_5":13306,"_25509":110394,"_2665":110417},[],"Relación",{"_3170":65544,"_28017":65535,"_19412":110419,"_5":13306,"_25509":110394,"_2665":110420},[],"Material que prepara el responsable",{"_3170":65545,"_28017":65535,"_19412":110422,"_5":13306,"_25509":110394,"_2665":110423},[],"Dispositivo → servidor EST",{"_3170":65546,"_28017":65535,"_19412":110425,"_5":13306,"_25509":110394,"_2665":110426},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_3170":65547,"_28017":65535,"_19412":110428,"_5":13306,"_25509":110394,"_2665":110429},[],"DMS → solicitante",{"_3170":65548,"_28017":65535,"_19412":110431,"_5":13306,"_25509":110394,"_2665":110432},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_3170":65549,"_28017":65535,"_19412":110434,"_5":13306,"_25509":110394,"_2665":110435},[],"Consumidor → dispositivo",{"_3170":65550,"_28017":65535,"_19412":110437,"_5":13306,"_25509":110394,"_2665":110438},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_3170":65551,"_28017":65535,"_19412":110440,"_5":13306,"_25509":110394,"_2665":110441},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_3170":65552,"_28017":65535,"_19412":110443,"_5":13306,"_25509":110398,"_2665":110444},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3170":65553,"_28017":65535,"_19412":110446,"_5":13306,"_25509":110398,"_2665":110447},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3170":65554,"_28017":65535,"_19412":110449,"_5":13306,"_25509":110402,"_2665":110450},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_3170":65555,"_28017":65535,"_19412":110452,"_5":13306,"_25509":110402,"_2665":110453},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_3170":65556,"_28017":65535,"_19412":110455,"_5":13306,"_25509":110402,"_2665":110456},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_3170":65557,"_28017":65535,"_19412":110458,"_5":13306,"_25509":110402,"_2665":110459},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_3170":65558,"_28017":65535,"_19412":110461,"_5":13306,"_25509":110402,"_2665":110462},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_3170":65559,"_28017":65535,"_19412":110464,"_5":13306,"_25509":110402,"_2665":110465},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_3170":65560,"_28017":65535,"_19412":110467,"_5":13306,"_25509":110406,"_2665":110468},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_3170":65561,"_28017":65535,"_19412":110470,"_5":13306,"_25509":110406,"_2665":110471},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_3170":65562,"_28017":65535,"_19412":110473,"_5":13306,"_25509":110406,"_2665":110474},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_3170":65563,"_28017":65535,"_19412":110476,"_5":13306,"_25509":110410,"_2665":110477},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_3170":65564,"_28017":65564,"_5":13637,"_2665":49286,"_28360":110479,"_19412":110481,"_25509":65564},[45425,108067,47826,109073,110480],"Integraciones",[],{"_3170":65565,"_28017":65564,"_19412":110483,"_5":13306,"_25509":65564,"_2665":110484},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3170":65566,"_28017":65564,"_5":28357,"_19412":110486,"_25509":110487,"_2665":110488},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3170":65567,"_28017":65564,"_5":28357,"_19412":110490,"_25509":110491,"_2665":110492},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3170":65568,"_28017":65564,"_5":28357,"_19412":110494,"_25509":110495,"_2665":110496},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3170":65569,"_28017":65564,"_5":28357,"_19412":110498,"_25509":110499,"_2665":110500},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3170":65570,"_28017":65564,"_5":28357,"_19412":110502,"_25509":110503,"_2665":110504},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3170":65571,"_28017":65564,"_5":28357,"_19412":110506,"_25509":110507,"_2665":110508},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3170":65572,"_28017":65564,"_5":28357,"_19412":110510,"_25509":110511,"_2665":49320},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3170":65573,"_28017":65564,"_5":28357,"_19412":110513,"_25509":110514,"_2665":49324},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3170":65574,"_28017":65564,"_5":28357,"_19412":110516,"_25509":110517,"_2665":110518},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3170":65575,"_28017":65564,"_5":28357,"_19412":110520,"_25509":110521,"_2665":110522},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3170":65576,"_28017":65564,"_5":28357,"_19412":110524,"_25509":110525,"_2665":110526},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3170":65577,"_28017":65564,"_5":28357,"_19412":110528,"_25509":110529,"_2665":110530},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3170":65578,"_28017":65564,"_5":28357,"_19412":110532,"_25509":110533,"_2665":110534},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3170":65579,"_28017":65564,"_5":28357,"_19412":110536,"_25509":110537,"_2665":110538},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3170":65580,"_28017":65564,"_5":28357,"_19412":110540,"_25509":110541,"_2665":110542},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3170":65581,"_28017":65564,"_5":28357,"_19412":110544,"_25509":110545,"_2665":110546},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3170":65582,"_28017":65564,"_5":28357,"_19412":110548,"_25509":110549,"_2665":110550},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3170":65583,"_28017":65564,"_5":28357,"_19412":110552,"_25509":110553,"_2665":110554},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3170":65584,"_28017":65564,"_5":28357,"_19412":110556,"_25509":110557,"_2665":110558},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3170":65585,"_28017":65564,"_5":28357,"_19412":110560,"_25509":110561,"_2665":110562},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3170":65586,"_28017":65564,"_19412":110564,"_5":13306,"_25509":65564,"_2665":110565},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3170":65587,"_28017":65564,"_19412":110567,"_5":13306,"_25509":65564,"_2665":110568},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3170":65588,"_28017":65564,"_19412":110570,"_5":13306,"_25509":65564,"_2665":110571},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3170":65589,"_28017":65564,"_19412":110573,"_5":13306,"_25509":110487,"_2665":110574},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3170":65590,"_28017":65564,"_19412":110576,"_5":13306,"_25509":110487,"_2665":110577},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3170":65591,"_28017":65564,"_19412":110579,"_5":13306,"_25509":110487,"_2665":110580},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3170":65592,"_28017":65564,"_19412":110582,"_5":13306,"_25509":110487,"_2665":110583},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3170":65593,"_28017":65564,"_19412":110585,"_5":13306,"_25509":110491,"_2665":110586},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3170":65594,"_28017":65564,"_19412":110588,"_5":13306,"_25509":110495,"_2665":110589},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3170":65595,"_28017":65564,"_19412":110591,"_5":13306,"_25509":110495,"_2665":110592},[],"Acción IAM",{"_3170":65596,"_28017":65564,"_19412":110594,"_5":13306,"_25509":110495,"_2665":107090},[],{"_3170":65597,"_28017":65564,"_19412":110596,"_5":13306,"_25509":110495,"_2665":49407},[],{"_3170":65598,"_28017":65564,"_19412":110598,"_5":13306,"_25509":110495,"_2665":110599},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3170":65599,"_28017":65564,"_19412":110601,"_5":13306,"_25509":110495,"_2665":49413},[],{"_3170":65600,"_28017":65564,"_19412":110603,"_5":13306,"_25509":110495,"_2665":110604},[],"Registrar la CA en AWS IoT",{"_3170":65601,"_28017":65564,"_19412":110606,"_5":13306,"_25509":110495,"_2665":49419},[],{"_3170":65602,"_28017":65564,"_19412":110608,"_5":13306,"_25509":110495,"_2665":110609},[],"Consultar el estado del registro de la CA",{"_3170":65603,"_28017":65564,"_19412":110611,"_5":13306,"_25509":110495,"_2665":49425},[],{"_3170":65604,"_28017":65564,"_19412":110613,"_5":13306,"_25509":110495,"_2665":110614},[],"Crear o actualizar Things en IoT Core",{"_3170":65605,"_28017":65564,"_19412":110616,"_5":13306,"_25509":110495,"_2665":49431},[],{"_3170":65606,"_28017":65564,"_19412":110618,"_5":13306,"_25509":110495,"_2665":110619},[],"Aprovisionar Things mediante plantilla",{"_3170":65607,"_28017":65564,"_19412":110621,"_5":13306,"_25509":110495,"_2665":49437},[],{"_3170":65608,"_28017":65564,"_19412":110623,"_5":13306,"_25509":110495,"_2665":110624},[],"Registrar certificados de dispositivo",{"_3170":65609,"_28017":65564,"_19412":110626,"_5":13306,"_25509":110495,"_2665":49443},[],{"_3170":65610,"_28017":65564,"_19412":110628,"_5":13306,"_25509":110495,"_2665":110629},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3170":65611,"_28017":65564,"_19412":110631,"_5":13306,"_25509":110495,"_2665":49449},[],{"_3170":65612,"_28017":65564,"_19412":110633,"_5":13306,"_25509":110495,"_2665":110634},[],"Crear y adjuntar políticas IoT",{"_3170":65613,"_28017":65564,"_19412":110636,"_5":13306,"_25509":110495,"_2665":49455},[],{"_3170":65614,"_28017":65564,"_19412":110638,"_5":13306,"_25509":110495,"_2665":110639},[],"Gestionar grupos de Things",{"_3170":65615,"_28017":65564,"_19412":110641,"_5":13306,"_25509":110495,"_2665":49461},[],{"_3170":65616,"_28017":65564,"_19412":110643,"_5":13306,"_25509":110495,"_2665":110644},[],"Crear plantillas JITP",{"_3170":65617,"_28017":65564,"_19412":110646,"_5":13306,"_25509":110495,"_2665":49467},[],{"_3170":65618,"_28017":65564,"_19412":110648,"_5":13306,"_25509":110495,"_2665":110649},[],"Leer y escribir el Device Shadow",{"_3170":65619,"_28017":65564,"_19412":110651,"_5":13306,"_25509":110495,"_2665":110652},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3170":65620,"_28017":65564,"_19412":110654,"_5":13306,"_25509":110499,"_2665":110655},[],"Parámetro",{"_3170":65621,"_28017":65564,"_19412":110657,"_5":13306,"_25509":110499,"_2665":110658},[],"Tipo",{"_3170":65622,"_28017":65564,"_19412":110660,"_5":13306,"_25509":110499,"_2665":110661},[],"Requerido",{"_3170":65623,"_28017":65564,"_19412":110663,"_5":13306,"_25509":110499,"_2665":110664},[],"Descripción",{"_3170":65624,"_28017":65564,"_19412":110666,"_5":13306,"_25509":110499,"_2665":49488},[],{"_3170":65625,"_28017":65564,"_19412":110668,"_5":13306,"_25509":110499,"_2665":23214},[],{"_3170":65626,"_28017":65564,"_19412":110670,"_5":13306,"_25509":110499,"_2665":110671},[],"Sí",{"_3170":65627,"_28017":65564,"_19412":110673,"_5":13306,"_25509":110499,"_2665":110674},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3170":65628,"_28017":65564,"_19412":110676,"_5":13306,"_25509":110499,"_2665":49499},[],{"_3170":65629,"_28017":65564,"_19412":110678,"_5":13306,"_25509":110499,"_2665":23214},[],{"_3170":65630,"_28017":65564,"_19412":110680,"_5":13306,"_25509":110499,"_2665":110671},[],{"_3170":65631,"_28017":65564,"_19412":110682,"_5":13306,"_25509":110499,"_2665":110683},[],"Región AWS donde opera el conector.",{"_3170":65632,"_28017":65564,"_19412":110685,"_5":13306,"_25509":110499,"_2665":49509},[],{"_3170":65633,"_28017":65564,"_19412":110687,"_5":13306,"_25509":110499,"_2665":23214},[],{"_3170":65634,"_28017":65564,"_19412":110689,"_5":13306,"_25509":110499,"_2665":110671},[],{"_3170":65635,"_28017":65564,"_19412":110691,"_5":13306,"_25509":110499,"_2665":110692},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3170":65636,"_28017":65564,"_19412":110694,"_5":13306,"_25509":110499,"_2665":49519},[],{"_3170":65637,"_28017":65564,"_19412":110696,"_5":13306,"_25509":110499,"_2665":23214},[],{"_3170":65638,"_28017":65564,"_19412":110698,"_5":13306,"_25509":110499,"_2665":110699},[],"Solo con `auth_method=static`",{"_3170":65639,"_28017":65564,"_19412":110701,"_5":13306,"_25509":110499,"_2665":110702},[],"Clave de acceso AWS.",{"_3170":65640,"_28017":65564,"_19412":110704,"_5":13306,"_25509":110499,"_2665":49530},[],{"_3170":65641,"_28017":65564,"_19412":110706,"_5":13306,"_25509":110499,"_2665":23214},[],{"_3170":65642,"_28017":65564,"_19412":110708,"_5":13306,"_25509":110499,"_2665":110699},[],{"_3170":65643,"_28017":65564,"_19412":110710,"_5":13306,"_25509":110499,"_2665":110711},[],"Clave secreta AWS.",{"_3170":65644,"_28017":65564,"_19412":110713,"_5":13306,"_25509":110499,"_2665":49540},[],{"_3170":65645,"_28017":65564,"_19412":110715,"_5":13306,"_25509":110499,"_2665":23214},[],{"_3170":65646,"_28017":65564,"_19412":110717,"_5":13306,"_25509":110499,"_2665":49545},[],{"_3170":65647,"_28017":65564,"_19412":110719,"_5":13306,"_25509":110499,"_2665":110720},[],"Token de sesión (con `auth_method=static`).",{"_3170":65648,"_28017":65564,"_19412":110722,"_5":13306,"_25509":110499,"_2665":49551},[],{"_3170":65649,"_28017":65564,"_19412":110724,"_5":13306,"_25509":110499,"_2665":23214},[],{"_3170":65650,"_28017":65564,"_19412":110726,"_5":13306,"_25509":110499,"_2665":110727},[],"Solo con `auth_method=role`",{"_3170":65651,"_28017":65564,"_19412":110729,"_5":13306,"_25509":110499,"_2665":110730},[],"ARN del rol a asumir.",{"_3170":65652,"_28017":65564,"_19412":110732,"_5":13306,"_25509":110499,"_2665":49562},[],{"_3170":65653,"_28017":65564,"_19412":110734,"_5":13306,"_25509":110499,"_2665":23214},[],{"_3170":65654,"_28017":65564,"_19412":110736,"_5":13306,"_25509":110499,"_2665":49545},[],{"_3170":65655,"_28017":65564,"_19412":110738,"_5":13306,"_25509":110499,"_2665":110739},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3170":65656,"_28017":65564,"_19412":110741,"_5":13306,"_25509":110499,"_2665":49572},[],{"_3170":65657,"_28017":65564,"_19412":110743,"_5":13306,"_25509":110499,"_2665":16351},[],{"_3170":65658,"_28017":65564,"_19412":110745,"_5":13306,"_25509":110499,"_2665":110671},[],{"_3170":65659,"_28017":65564,"_19412":110747,"_5":13306,"_25509":110499,"_2665":110748},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3170":65660,"_28017":65564,"_19412":110750,"_5":13306,"_25509":110499,"_2665":49582},[],{"_3170":65661,"_28017":65564,"_19412":110752,"_5":13306,"_25509":110499,"_2665":23214},[],{"_3170":65662,"_28017":65564,"_19412":110754,"_5":13306,"_25509":110499,"_2665":110671},[],{"_3170":65663,"_28017":65564,"_19412":110756,"_5":13306,"_25509":110499,"_2665":110757},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3170":65664,"_28017":65564,"_19412":110759,"_5":13306,"_25509":110499,"_2665":49592},[],{"_3170":65665,"_28017":65564,"_19412":110761,"_5":13306,"_25509":110499,"_2665":23214},[],{"_3170":65666,"_28017":65564,"_19412":110763,"_5":13306,"_25509":110499,"_2665":110671},[],{"_3170":65667,"_28017":65564,"_19412":110765,"_5":13306,"_25509":110499,"_2665":110766},[],"URL HTTP del Device Manager de Lamassu.",{"_3170":65668,"_28017":65564,"_19412":110768,"_5":13306,"_25509":110499,"_2665":49602},[],{"_3170":65669,"_28017":65564,"_19412":110770,"_5":13306,"_25509":110499,"_2665":23214},[],{"_3170":65670,"_28017":65564,"_19412":110772,"_5":13306,"_25509":110499,"_2665":110671},[],{"_3170":65671,"_28017":65564,"_19412":110774,"_5":13306,"_25509":110499,"_2665":110775},[],"URL HTTP del servicio de CA de Lamassu.",{"_3170":65672,"_28017":65564,"_19412":110777,"_5":13306,"_25509":110503,"_2665":110778},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3170":65673,"_28017":65564,"_19412":110780,"_5":13306,"_25509":110507,"_2665":110781},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3170":65674,"_28017":65564,"_19412":110783,"_5":13306,"_25509":110507,"_2665":110784},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3170":65675,"_28017":65564,"_19412":110786,"_5":13306,"_25509":110511,"_2665":110787},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3170":65676,"_28017":65564,"_19412":110789,"_5":13306,"_25509":110511,"_2665":110790},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3170":65677,"_28017":65564,"_19412":110792,"_5":13306,"_25509":110511,"_2665":110793},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3170":65678,"_28017":65564,"_19412":110795,"_5":13306,"_25509":110511,"_2665":110796},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3170":65679,"_28017":65564,"_19412":110798,"_5":13306,"_25509":110511,"_2665":110799},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3170":65680,"_28017":65564,"_19412":110801,"_5":13306,"_25509":110511,"_2665":110802},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3170":65681,"_28017":65564,"_19412":110804,"_5":13306,"_25509":110514,"_2665":110805},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3170":65682,"_28017":65564,"_19412":110807,"_5":13306,"_25509":110517,"_2665":110808},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3170":65683,"_28017":65564,"_19412":110810,"_5":13306,"_25509":110517,"_2665":110811},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3170":65684,"_28017":65564,"_19412":110813,"_5":13306,"_25509":110521,"_2665":110814},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3170":65685,"_28017":65564,"_19412":110816,"_5":13306,"_25509":110525,"_2665":110817},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3170":65686,"_28017":65564,"_19412":110819,"_5":13306,"_25509":110525,"_2665":110820},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3170":65687,"_28017":65564,"_19412":110822,"_5":13306,"_25509":110525,"_2665":110823},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3170":65688,"_28017":65564,"_19412":110825,"_5":13306,"_25509":110525,"_2665":110826},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3170":65689,"_28017":65564,"_19412":110828,"_5":13306,"_25509":110525,"_2665":110829},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3170":65690,"_28017":65564,"_19412":110831,"_5":13306,"_25509":110525,"_2665":110832},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3170":65691,"_28017":65564,"_19412":110834,"_5":13306,"_25509":110529,"_2665":110835},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. Esta plantilla se crea o actualiza en el momento en que el DMS se crea o actualiza en Lamassu - no en el momento del enrolamiento del dispositivo. A partir de ese momento, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3170":65692,"_28017":65564,"_19412":110837,"_5":13306,"_25509":110529,"_2665":110838},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3170":65693,"_28017":65564,"_19412":110840,"_5":13306,"_25509":110529,"_2665":110841},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3170":65694,"_28017":65564,"_19412":110843,"_5":13306,"_25509":110533,"_2665":110844},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3170":65695,"_28017":65564,"_19412":110846,"_5":13306,"_25509":110533,"_2665":110847},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3170":65696,"_28017":65564,"_19412":110849,"_5":13306,"_25509":110533,"_2665":110850},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3170":65697,"_28017":65564,"_19412":110852,"_5":13306,"_25509":110537,"_2665":110853},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3170":65698,"_28017":65564,"_19412":110855,"_5":13306,"_25509":110537,"_2665":110856},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3170":65699,"_28017":65564,"_19412":110858,"_5":13306,"_25509":110537,"_2665":110859},[],"Para que el flujo JITP funcione correctamente:",{"_3170":65700,"_28017":65564,"_19412":110861,"_5":13306,"_25509":110537,"_2665":110862},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3170":65701,"_28017":65564,"_19412":110864,"_5":13306,"_25509":110537,"_2665":110865},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3170":65702,"_28017":65564,"_19412":110867,"_5":13306,"_25509":110537,"_2665":110868},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3170":65703,"_28017":65564,"_19412":110870,"_5":13306,"_25509":110537,"_2665":110871},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3170":65704,"_28017":65564,"_19412":110873,"_5":13306,"_25509":110541,"_2665":110874},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3170":65705,"_28017":65564,"_19412":110876,"_5":13306,"_25509":110541,"_2665":110877},[],"Estado en Lamassu",{"_3170":65706,"_28017":65564,"_19412":110879,"_5":13306,"_25509":110541,"_2665":110880},[],"Razón de revocación",{"_3170":65707,"_28017":65564,"_19412":110882,"_5":13306,"_25509":110541,"_2665":110883},[],"Estado en AWS IoT Core",{"_3170":65708,"_28017":65564,"_19412":110885,"_5":13306,"_25509":110541,"_2665":49723},[],{"_3170":65709,"_28017":65564,"_19412":110887,"_5":13306,"_25509":110541,"_2665":110888},[],"Ninguna",{"_3170":65710,"_28017":65564,"_19412":110890,"_5":13306,"_25509":110541,"_2665":49729},[],{"_3170":65711,"_28017":65564,"_19412":110892,"_5":13306,"_25509":110541,"_2665":49732},[],{"_3170":65712,"_28017":65564,"_19412":110894,"_5":13306,"_25509":110541,"_2665":49735},[],{"_3170":65713,"_28017":65564,"_19412":110896,"_5":13306,"_25509":110541,"_2665":49738},[],{"_3170":65714,"_28017":65564,"_19412":110898,"_5":13306,"_25509":110541,"_2665":49732},[],{"_3170":65715,"_28017":65564,"_19412":110900,"_5":13306,"_25509":110541,"_2665":110901},[],"Cualquier otra razón",{"_3170":65716,"_28017":65564,"_19412":110903,"_5":13306,"_25509":110541,"_2665":49746},[],{"_3170":65717,"_28017":65564,"_19412":110905,"_5":13306,"_25509":110541,"_2665":110906},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3170":65718,"_28017":65564,"_19412":110908,"_5":13306,"_25509":110545,"_2665":110909},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3170":65719,"_28017":65564,"_19412":110911,"_5":13306,"_25509":110545,"_2665":110912},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3170":65720,"_28017":65564,"_19412":110914,"_5":13306,"_25509":110545,"_2665":110915},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3170":65721,"_28017":65564,"_19412":110917,"_5":13306,"_25509":110549,"_2665":110918},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3170":65722,"_28017":65564,"_19412":110920,"_5":13306,"_25509":110549,"_2665":110921},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3170":65723,"_28017":65564,"_19412":110923,"_5":13306,"_25509":110553,"_2665":110924},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3170":65724,"_28017":65564,"_19412":110926,"_5":13306,"_25509":110553,"_2665":110927},[],"Existen dos tipos de acciones:",{"_3170":65725,"_28017":65564,"_19412":110929,"_5":13306,"_25509":110553,"_2665":110930},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3170":65726,"_28017":65564,"_19412":110932,"_5":13306,"_25509":110553,"_2665":110933},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3170":65727,"_28017":65564,"_19412":110935,"_5":13306,"_25509":110553,"_2665":110936},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3170":65728,"_28017":65564,"_19412":110938,"_5":13306,"_25509":110557,"_2665":110939},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3170":65729,"_28017":65564,"_19412":110941,"_5":13306,"_25509":110557,"_2665":110942},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3170":65730,"_28017":65564,"_19412":110944,"_5":13306,"_25509":110557,"_2665":110945},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3170":65731,"_28017":65564,"_19412":110947,"_5":13306,"_25509":110561,"_2665":110948},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3170":65732,"_28017":65564,"_19412":110950,"_5":13306,"_25509":110561,"_2665":110951},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3170":65733,"_28017":65564,"_19412":110953,"_5":13306,"_25509":110561,"_2665":110954},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3170":65734,"_28017":65564,"_19412":110956,"_5":13306,"_25509":110561,"_2665":110957},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3170":65735,"_28017":65564,"_19412":110959,"_5":13306,"_25509":110561,"_2665":110960},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3170":65736,"_28017":65564,"_19412":110962,"_5":13306,"_25509":110561,"_2665":110963},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3170":65737,"_28017":65564,"_19412":110965,"_5":13306,"_25509":110561,"_2665":110966},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3170":65738,"_28017":65564,"_19412":110968,"_5":13306,"_25509":110561,"_2665":110969},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3170":65739,"_28017":65564,"_19412":110971,"_5":13306,"_25509":110561,"_2665":110972},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3170":65740,"_28017":65564,"_19412":110974,"_5":13306,"_25509":110561,"_2665":110975},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3170":65741,"_28017":65564,"_19412":110977,"_5":13306,"_25509":110561,"_2665":110978},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3170":65742,"_28017":65564,"_19412":110980,"_5":13306,"_25509":110561,"_2665":110981},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3170":65743,"_28017":65564,"_19412":110983,"_5":13306,"_25509":110561,"_2665":110984},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3170":65744,"_28017":65564,"_19412":110986,"_5":13306,"_25509":110561,"_2665":110987},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3170":65745,"_28017":65564,"_19412":110989,"_5":13306,"_25509":110561,"_2665":110990},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3170":65746,"_28017":65564,"_19412":110992,"_5":13306,"_25509":110561,"_2665":110993},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3170":65747,"_28017":65564,"_19412":110995,"_5":13306,"_25509":110561,"_2665":110996},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3170":65748,"_28017":65564,"_19412":110998,"_5":13306,"_25509":110561,"_2665":110999},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3170":65749,"_28017":65564,"_19412":111001,"_5":13306,"_25509":110561,"_2665":111002},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3170":65750,"_28017":65564,"_19412":111004,"_5":13306,"_25509":110561,"_2665":111005},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3170":65751,"_28017":65564,"_19412":111007,"_5":13306,"_25509":110561,"_2665":111008},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3170":65752,"_28017":65752,"_5":13637,"_2665":47826,"_28360":111010,"_19412":111011,"_25509":65752},[45425,108067,47826],[],{"_3170":65753,"_28017":65752,"_19412":111013,"_5":13306,"_25509":65752,"_2665":111014},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3170":65754,"_28017":65752,"_5":28357,"_19412":111016,"_25509":111017,"_2665":111018},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3170":65755,"_28017":65752,"_5":28357,"_19412":111020,"_25509":111021,"_2665":109073},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3170":65756,"_28017":65752,"_5":28357,"_19412":111023,"_25509":111024,"_2665":109248},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3170":65757,"_28017":65752,"_5":28357,"_19412":111026,"_25509":111027,"_2665":110480},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/overview#integraciones",{"_3170":65758,"_28017":65752,"_5":28357,"_19412":111029,"_25509":111030,"_2665":111031},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3170":65759,"_28017":65752,"_19412":111033,"_5":13306,"_25509":65752,"_2665":111034},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3170":65760,"_28017":65752,"_19412":111036,"_5":13306,"_25509":111017,"_2665":111037},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3170":65761,"_28017":65752,"_19412":111039,"_5":13306,"_25509":111017,"_2665":111040},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3170":65762,"_28017":65752,"_19412":111042,"_5":13306,"_25509":111021,"_2665":111043},[],"Recurso",{"_3170":65763,"_28017":65752,"_19412":111045,"_5":13306,"_25509":111021,"_2665":111046},[],"Qué representa",{"_3170":65764,"_28017":65752,"_19412":111048,"_5":13306,"_25509":111021,"_2665":111049},[],"**Dispositivo**",{"_3170":65765,"_28017":65752,"_19412":111051,"_5":13306,"_25509":111021,"_2665":111052},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3170":65766,"_28017":65752,"_19412":111054,"_5":13306,"_25509":111021,"_2665":111055},[],"**Identidad**",{"_3170":65767,"_28017":65752,"_19412":111057,"_5":13306,"_25509":111021,"_2665":111058},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3170":65768,"_28017":65752,"_19412":111060,"_5":13306,"_25509":111021,"_2665":49904},[],{"_3170":65769,"_28017":65752,"_19412":111062,"_5":13306,"_25509":111021,"_2665":111063},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3170":65770,"_28017":65752,"_19412":111065,"_5":13306,"_25509":111021,"_2665":111066},[],"**Flota**",{"_3170":65771,"_28017":65752,"_19412":111068,"_5":13306,"_25509":111021,"_2665":111069},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3170":65772,"_28017":65752,"_19412":111071,"_5":13306,"_25509":111021,"_2665":111072},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3170":65773,"_28017":65752,"_19412":111074,"_5":13306,"_25509":111021,"_2665":111075},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3170":65774,"_28017":65752,"_19412":111077,"_5":13306,"_25509":111024,"_2665":111078},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3170":65775,"_28017":65752,"_19412":111080,"_5":13306,"_25509":111024,"_2665":111081},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3170":65776,"_28017":65752,"_19412":111083,"_5":13306,"_25509":111024,"_2665":111084},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3170":65777,"_28017":65752,"_19412":111086,"_5":13306,"_25509":111024,"_2665":111087},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3170":65778,"_28017":65752,"_19412":111089,"_5":13306,"_25509":111024,"_2665":111090},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3170":65779,"_28017":65752,"_19412":111092,"_5":13306,"_25509":111024,"_2665":111093},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3170":65780,"_28017":65752,"_19412":111095,"_5":13306,"_25509":111024,"_2665":111096},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3170":65781,"_28017":65752,"_19412":111098,"_5":13306,"_25509":111024,"_2665":111099},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3170":65782,"_28017":65752,"_19412":111101,"_5":13306,"_25509":111027,"_2665":111102},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3170":65783,"_28017":65752,"_19412":111104,"_5":13306,"_25509":111027,"_2665":111105},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3170":65784,"_28017":65752,"_19412":111107,"_5":13306,"_25509":111030,"_2665":111108},[],"Participante",{"_3170":65785,"_28017":65752,"_19412":111110,"_5":13306,"_25509":111030,"_2665":111111},[],"Responsabilidad",{"_3170":65786,"_28017":65752,"_19412":111113,"_5":13306,"_25509":111030,"_2665":111114},[],"Administrador PKI",{"_3170":65787,"_28017":65752,"_19412":111116,"_5":13306,"_25509":111030,"_2665":111117},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3170":65788,"_28017":65752,"_19412":111119,"_5":13306,"_25509":111030,"_2665":111120},[],"Administrador del aprovisionamiento",{"_3170":65789,"_28017":65752,"_19412":111122,"_5":13306,"_25509":111030,"_2665":111123},[],"DMS, admisión, autenticación por operación e inventario.",{"_3170":65790,"_28017":65752,"_19412":111125,"_5":13306,"_25509":111030,"_2665":111126},[],"Integrador del dispositivo",{"_3170":65791,"_28017":65752,"_19412":111128,"_5":13306,"_25509":111030,"_2665":111129},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3170":65792,"_28017":65752,"_19412":111131,"_5":13306,"_25509":111030,"_2665":111132},[],"Integrador del consumidor",{"_3170":65793,"_28017":65752,"_19412":111134,"_5":13306,"_25509":111030,"_2665":111135},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3170":65794,"_28017":65752,"_19412":111137,"_5":13306,"_25509":111030,"_2665":111138},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3170":65795,"_28017":65795,"_5":13637,"_2665":111140,"_28360":111141,"_19412":111143,"_25509":65795},"Enrola y conecta tu primer dispositivo",[45425,108067,47826,111142],"Primeros pasos",[],{"_3170":65796,"_28017":65795,"_19412":111145,"_5":13306,"_25509":65795,"_2665":111146},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3170":65797,"_28017":65795,"_5":28357,"_19412":111148,"_25509":111149,"_2665":106720},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3170":65798,"_28017":65795,"_5":28357,"_19412":111151,"_25509":111152,"_2665":111153},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3170":65799,"_28017":65795,"_5":28357,"_19412":111155,"_25509":111156,"_2665":111157},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3170":65800,"_28017":65795,"_5":28357,"_19412":111159,"_25509":111160,"_2665":111161},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3170":65801,"_28017":65795,"_5":28357,"_19412":111163,"_25509":111164,"_2665":111165},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3170":65802,"_28017":65795,"_5":28357,"_19412":111167,"_25509":111168,"_2665":111169},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3170":65803,"_28017":65795,"_5":28357,"_19412":111171,"_25509":111172,"_2665":111173},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3170":65804,"_28017":65795,"_5":28357,"_19412":111175,"_25509":111176,"_2665":111177},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3170":65805,"_28017":65795,"_19412":111179,"_5":13306,"_25509":65795,"_2665":111180},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3170":65806,"_28017":65795,"_19412":111182,"_5":13306,"_25509":111149,"_2665":111183},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3170":65807,"_28017":65795,"_19412":111185,"_5":13306,"_25509":111149,"_2665":111186},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3170":65808,"_28017":65795,"_19412":111188,"_5":13306,"_25509":111149,"_2665":111189},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3170":65809,"_28017":65795,"_19412":111191,"_5":13306,"_25509":111149,"_2665":111192},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3170":65810,"_28017":65795,"_19412":111194,"_5":13306,"_25509":111149,"_2665":111195},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3170":65811,"_28017":65795,"_19412":111197,"_5":13306,"_25509":111152,"_2665":111198},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3170":65812,"_28017":65795,"_19412":111200,"_5":13306,"_25509":111152,"_2665":111201},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3170":65813,"_28017":65795,"_19412":111203,"_5":13306,"_25509":111156,"_2665":111204},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3170":65814,"_28017":65795,"_19412":111206,"_5":13306,"_25509":111156,"_2665":111207},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3170":65815,"_28017":65795,"_19412":111209,"_5":13306,"_25509":111156,"_2665":111210},[],"Ajuste",{"_3170":65816,"_28017":65795,"_19412":111212,"_5":13306,"_25509":111156,"_2665":111213},[],"Valor de evaluación",{"_3170":65817,"_28017":65795,"_19412":111215,"_5":13306,"_25509":111156,"_2665":50060},[],{"_3170":65818,"_28017":65795,"_19412":111217,"_5":13306,"_25509":111156,"_2665":111218},[],"Raíz emisora de `device-root.pem`.",{"_3170":65819,"_28017":65795,"_19412":111220,"_5":13306,"_25509":111156,"_2665":109376},[],{"_3170":65820,"_28017":65795,"_19412":111222,"_5":13306,"_25509":111156,"_2665":111223},[],"Perfil final de 1 hora que acabas de preparar.",{"_3170":65821,"_28017":65795,"_19412":111225,"_5":13306,"_25509":111156,"_2665":50071},[],{"_3170":65822,"_28017":65795,"_19412":111227,"_5":13306,"_25509":111156,"_2665":50074},[],{"_3170":65823,"_28017":65795,"_19412":111229,"_5":13306,"_25509":111156,"_2665":50077},[],{"_3170":65824,"_28017":65795,"_19412":111231,"_5":13306,"_25509":111156,"_2665":111232},[],"Habilitado.",{"_3170":65825,"_28017":65795,"_19412":111234,"_5":13306,"_25509":111156,"_2665":50083},[],{"_3170":65826,"_28017":65795,"_19412":111236,"_5":13306,"_25509":111156,"_2665":111237},[],"Deshabilitado; el ID debe ser nuevo.",{"_3170":65827,"_28017":65795,"_19412":111239,"_5":13306,"_25509":111156,"_2665":111240},[],"Autenticación inicial",{"_3170":65828,"_28017":65795,"_19412":111242,"_5":13306,"_25509":111156,"_2665":111243},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3170":65829,"_28017":65795,"_19412":111245,"_5":13306,"_25509":111156,"_2665":111246},[],"Autenticación de renovación",{"_3170":65830,"_28017":65795,"_19412":111248,"_5":13306,"_25509":111156,"_2665":111249},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3170":65831,"_28017":65795,"_19412":111251,"_5":13306,"_25509":111156,"_2665":50101},[],{"_3170":65832,"_28017":65795,"_19412":111253,"_5":13306,"_25509":111156,"_2665":111254},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_3170":65833,"_28017":65795,"_19412":111256,"_5":13306,"_25509":111156,"_2665":50107},[],{"_3170":65834,"_28017":65795,"_19412":111258,"_5":13306,"_25509":111156,"_2665":111259},[],"1 hora.",{"_3170":65835,"_28017":65795,"_19412":111261,"_5":13306,"_25509":111156,"_2665":50113},[],{"_3170":65836,"_28017":65795,"_19412":111263,"_5":13306,"_25509":111156,"_2665":111264},[],"30 minutos / 10 minutos.",{"_3170":65837,"_28017":65795,"_19412":111266,"_5":13306,"_25509":111156,"_2665":50119},[],{"_3170":65838,"_28017":65795,"_19412":111268,"_5":13306,"_25509":111156,"_2665":111269},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3170":65839,"_28017":65795,"_19412":111271,"_5":13306,"_25509":111156,"_2665":48145},[],{"_3170":65840,"_28017":65795,"_19412":111273,"_5":13306,"_25509":111156,"_2665":111274},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3170":65841,"_28017":65795,"_19412":111276,"_5":13306,"_25509":111156,"_2665":50130},[],{"_3170":65842,"_28017":65795,"_19412":111278,"_5":13306,"_25509":111156,"_2665":111279},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3170":65843,"_28017":65795,"_19412":111281,"_5":13306,"_25509":111156,"_2665":111282},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento; la guía DMS describe sus campos, y también puedes comprobar el recurso mediante la API DMS.",{"_3170":65844,"_28017":65795,"_19412":111284,"_5":13306,"_25509":111160,"_2665":111285},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3170":65845,"_28017":65795,"_19412":111287,"_5":13306,"_25509":111160,"_2665":111288},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3170":65846,"_28017":65795,"_19412":111290,"_5":13306,"_25509":111164,"_2665":111291},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3170":65847,"_28017":65795,"_19412":111293,"_5":13306,"_25509":111164,"_2665":111294},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3170":65848,"_28017":65795,"_19412":111296,"_5":13306,"_25509":111164,"_2665":111297},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3170":65849,"_28017":65795,"_19412":111299,"_5":13306,"_25509":111168,"_2665":111300},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3170":65850,"_28017":65795,"_19412":111302,"_5":13306,"_25509":111168,"_2665":111303},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3170":65851,"_28017":65795,"_19412":111305,"_5":13306,"_25509":111172,"_2665":111306},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3170":65852,"_28017":65795,"_19412":111308,"_5":13306,"_25509":111172,"_2665":111309},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3170":65853,"_28017":65795,"_19412":111311,"_5":13306,"_25509":111172,"_2665":111312},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3170":65854,"_28017":65795,"_19412":111314,"_5":13306,"_25509":111172,"_2665":111315},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3170":65855,"_28017":65795,"_19412":111317,"_5":13306,"_25509":111172,"_2665":111318},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3170":65856,"_28017":65795,"_19412":111320,"_5":13306,"_25509":111176,"_2665":111321},[],"Comprobación",{"_3170":65857,"_28017":65795,"_19412":111323,"_5":13306,"_25509":111176,"_2665":111324},[],"Resultado esperado",{"_3170":65858,"_28017":65795,"_19412":111326,"_5":13306,"_25509":111176,"_2665":111327},[],"Registro",{"_3170":65859,"_28017":65795,"_19412":111329,"_5":13306,"_25509":111176,"_2665":111330},[],"ID creado automáticamente y DMS correcto.",{"_3170":65860,"_28017":65795,"_19412":111332,"_5":13306,"_25509":111176,"_2665":111333},[],"Certificado",{"_3170":65861,"_28017":65795,"_19412":111335,"_5":13306,"_25509":111176,"_2665":111336},[],"CN, perfil, serie y clave verificados.",{"_3170":65862,"_28017":65795,"_19412":111338,"_5":13306,"_25509":111176,"_2665":111339},[],"Inventario",{"_3170":65863,"_28017":65795,"_19412":111341,"_5":13306,"_25509":111176,"_2665":111342},[],"Serie recibida visible como identidad actual y en el historial.",{"_3170":65864,"_28017":65795,"_19412":111344,"_5":13306,"_25509":111176,"_2665":111345},[],"Consumidor",{"_3170":65865,"_28017":65795,"_19412":111347,"_5":13306,"_25509":111176,"_2665":111348},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3170":65866,"_28017":65795,"_19412":111350,"_5":13306,"_25509":111176,"_2665":111351},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3170":65867,"_28017":65795,"_19412":111353,"_5":13306,"_25509":111176,"_2665":111354},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3170":65868,"_28017":65868,"_5":13637,"_2665":109090,"_28360":111356,"_19412":111357,"_25509":65868},[45425,108067,47826,111142],[],{"_3170":65869,"_28017":65868,"_19412":111359,"_5":13306,"_25509":65868,"_2665":111360},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3170":65870,"_28017":65868,"_5":28357,"_19412":111362,"_25509":111363,"_2665":106720},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3170":65871,"_28017":65868,"_5":28357,"_19412":111365,"_25509":111366,"_2665":111367},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3170":65872,"_28017":65868,"_5":28357,"_19412":111369,"_25509":111370,"_2665":111371},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3170":65873,"_28017":65868,"_5":28357,"_19412":111373,"_25509":111374,"_2665":111375},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3170":65874,"_28017":65868,"_5":28357,"_19412":111377,"_25509":111378,"_2665":111379},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3170":65875,"_28017":65868,"_5":28357,"_19412":111381,"_25509":111382,"_2665":111383},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3170":65876,"_28017":65868,"_5":28357,"_19412":111385,"_25509":111386,"_2665":111324},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3170":65877,"_28017":65868,"_5":28357,"_19412":111388,"_25509":111389,"_2665":111390},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3170":65878,"_28017":65868,"_5":28357,"_19412":111392,"_25509":111393,"_2665":111394},[],"/docs/pr-preview/pr-54/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3170":65879,"_28017":65868,"_19412":111396,"_5":13306,"_25509":65868,"_2665":111397},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3170":65880,"_28017":65868,"_19412":111399,"_5":13306,"_25509":65868,"_2665":111400},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3170":65881,"_28017":65868,"_19412":111402,"_5":13306,"_25509":111363,"_2665":111403},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3170":65882,"_28017":65868,"_19412":111405,"_5":13306,"_25509":111363,"_2665":111406},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3170":65883,"_28017":65868,"_19412":111408,"_5":13306,"_25509":111363,"_2665":111409},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3170":65884,"_28017":65868,"_19412":111411,"_5":13306,"_25509":111363,"_2665":111412},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3170":65885,"_28017":65868,"_19412":111414,"_5":13306,"_25509":111366,"_2665":111415},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3170":65886,"_28017":65868,"_19412":111417,"_5":13306,"_25509":111366,"_2665":111418},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3170":65887,"_28017":65868,"_19412":111420,"_5":13306,"_25509":111366,"_2665":111421},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3170":65888,"_28017":65868,"_19412":111423,"_5":13306,"_25509":111366,"_2665":111424},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3170":65889,"_28017":65868,"_19412":111426,"_5":13306,"_25509":111366,"_2665":111427},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_3170":65890,"_28017":65868,"_19412":111429,"_5":13306,"_25509":111366,"_2665":111430},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3170":65891,"_28017":65868,"_19412":111432,"_5":13306,"_25509":111366,"_2665":111433},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3170":65892,"_28017":65868,"_19412":111435,"_5":13306,"_25509":111366,"_2665":111436},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3170":65893,"_28017":65868,"_19412":111438,"_5":13306,"_25509":111370,"_2665":111439},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3170":65894,"_28017":65868,"_19412":111441,"_5":13306,"_25509":111370,"_2665":50296},[],{"_3170":65895,"_28017":65868,"_19412":111443,"_5":13306,"_25509":111370,"_2665":111444},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3170":65896,"_28017":65868,"_19412":111446,"_5":13306,"_25509":111370,"_2665":111447},[],"**Icon** y **Tags**: clasificación opcional.",{"_3170":65897,"_28017":65868,"_19412":111449,"_5":13306,"_25509":111370,"_2665":111450},[],"Confirma el registro.",{"_3170":65898,"_28017":65868,"_19412":111452,"_5":13306,"_25509":111374,"_2665":111453},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3170":65899,"_28017":65868,"_19412":111455,"_5":13306,"_25509":111374,"_2665":111456},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3170":65900,"_28017":65868,"_19412":111458,"_5":13306,"_25509":111378,"_2665":111459},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3170":65901,"_28017":65868,"_19412":111461,"_5":13306,"_25509":111378,"_2665":111462},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3170":65902,"_28017":65868,"_19412":111464,"_5":13306,"_25509":111382,"_2665":111465},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3170":65903,"_28017":65868,"_19412":111467,"_5":13306,"_25509":111382,"_2665":111468},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3170":65904,"_28017":65868,"_19412":111470,"_5":13306,"_25509":111386,"_2665":111321},[],{"_3170":65905,"_28017":65868,"_19412":111472,"_5":13306,"_25509":111386,"_2665":111473},[],"Resultado",{"_3170":65906,"_28017":65868,"_19412":111475,"_5":13306,"_25509":111386,"_2665":111476},[],"Dispositivo",{"_3170":65907,"_28017":65868,"_19412":111478,"_5":13306,"_25509":111386,"_2665":111479},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3170":65908,"_28017":65868,"_19412":111481,"_5":13306,"_25509":111386,"_2665":111482},[],"Identidad actual",{"_3170":65909,"_28017":65868,"_19412":111484,"_5":13306,"_25509":111386,"_2665":111485},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3170":65910,"_28017":65868,"_19412":111487,"_5":13306,"_25509":111386,"_2665":111488},[],"Historial",{"_3170":65911,"_28017":65868,"_19412":111490,"_5":13306,"_25509":111386,"_2665":111491},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3170":65912,"_28017":65868,"_19412":111493,"_5":13306,"_25509":111386,"_2665":111494},[],"Clave y certificado",{"_3170":65913,"_28017":65868,"_19412":111496,"_5":13306,"_25509":111386,"_2665":111497},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3170":65914,"_28017":65868,"_19412":111499,"_5":13306,"_25509":111389,"_2665":111500},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3170":65915,"_28017":65868,"_19412":111502,"_5":13306,"_25509":111389,"_2665":111503},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3170":65916,"_28017":65868,"_19412":111505,"_5":13306,"_25509":111389,"_2665":111506},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3170":65917,"_28017":65868,"_19412":111508,"_5":13306,"_25509":111389,"_2665":111509},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3170":65918,"_28017":65868,"_19412":111511,"_5":13306,"_25509":111393,"_2665":111512},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3170":65919,"_28017":65868,"_19412":111514,"_5":13306,"_25509":111393,"_2665":111515},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3170":65920,"_28017":65868,"_19412":111517,"_5":13306,"_25509":111393,"_2665":111518},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3170":65921,"_28017":65921,"_5":13637,"_2665":111520,"_28360":111521,"_19412":111522,"_25509":65921},"Plataforma Lamassu IoT",[45425,108067],[],{"_3170":65922,"_28017":65921,"_19412":111524,"_5":13306,"_25509":65921,"_2665":111525},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3170":65923,"_28017":65921,"_5":28357,"_19412":111527,"_25509":111528,"_2665":111018},[],"/docs/pr-preview/pr-54/es/platform/overview#empieza-aquí",{"_3170":65924,"_28017":65921,"_5":28357,"_19412":111530,"_25509":111531,"_2665":111532},[],"/docs/pr-preview/pr-54/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3170":65925,"_28017":65921,"_5":28357,"_19412":111534,"_25509":111535,"_2665":111536},[],"/docs/pr-preview/pr-54/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3170":65926,"_28017":65921,"_5":28357,"_19412":111538,"_25509":111539,"_2665":111540},[],"/docs/pr-preview/pr-54/es/platform/overview#capacidades-principales","Capacidades principales",{"_3170":65927,"_28017":65921,"_5":28357,"_19412":111542,"_25509":111543,"_2665":111544},[],"/docs/pr-preview/pr-54/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3170":65928,"_28017":65921,"_5":28357,"_19412":111546,"_25509":111547,"_2665":111548},[],"/docs/pr-preview/pr-54/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3170":65929,"_28017":65921,"_5":28357,"_19412":111550,"_25509":111551,"_2665":111552},[],"/docs/pr-preview/pr-54/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3170":65930,"_28017":65921,"_5":28357,"_19412":111554,"_25509":111555,"_2665":111556},[],"/docs/pr-preview/pr-54/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3170":65931,"_28017":65921,"_5":28357,"_19412":111558,"_25509":111559,"_2665":111560},[],"/docs/pr-preview/pr-54/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3170":65932,"_28017":65921,"_5":28357,"_19412":111562,"_25509":111563,"_2665":111564},[],"/docs/pr-preview/pr-54/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3170":65933,"_28017":65921,"_5":28357,"_19412":111566,"_25509":111567,"_2665":111568},[],"/docs/pr-preview/pr-54/es/platform/overview#referencia-operativa","Referencia operativa",{"_3170":65934,"_28017":65921,"_19412":111570,"_5":13306,"_25509":65921,"_2665":111571},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3170":65935,"_28017":65921,"_19412":111573,"_5":13306,"_25509":111528,"_2665":111574},[],"Elige el resultado que necesitas obtener:",{"_3170":65936,"_28017":65921,"_19412":111576,"_5":13306,"_25509":111528,"_2665":111577},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3170":65937,"_28017":65921,"_19412":111579,"_5":13306,"_25509":111528,"_2665":111580},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3170":65938,"_28017":65921,"_19412":111582,"_5":13306,"_25509":111528,"_2665":111583},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3170":65939,"_28017":65921,"_19412":111585,"_5":13306,"_25509":111531,"_2665":111586},[],"Bloque",{"_3170":65940,"_28017":65921,"_19412":111588,"_5":13306,"_25509":111531,"_2665":111589},[],"Qué gestionas",{"_3170":65941,"_28017":65921,"_19412":111591,"_5":13306,"_25509":111531,"_2665":111592},[],"Punto de entrada",{"_3170":65942,"_28017":65921,"_19412":111594,"_5":13306,"_25509":111531,"_2665":50450},[],{"_3170":65943,"_28017":65921,"_19412":111596,"_5":13306,"_25509":111531,"_2665":111597},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3170":65944,"_28017":65921,"_19412":111599,"_5":13306,"_25509":111531,"_2665":111600},[],"Visión general de PKI",{"_3170":65945,"_28017":65921,"_19412":111602,"_5":13306,"_25509":111531,"_2665":50459},[],{"_3170":65946,"_28017":65921,"_19412":111604,"_5":13306,"_25509":111531,"_2665":111605},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3170":65947,"_28017":65921,"_19412":111607,"_5":13306,"_25509":111531,"_2665":111608},[],"Visión general de IoT Fleets",{"_3170":65948,"_28017":65921,"_19412":111610,"_5":13306,"_25509":111531,"_2665":111611},[],"**Administración**",{"_3170":65949,"_28017":65921,"_19412":111613,"_5":13306,"_25509":111531,"_2665":111614},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3170":65950,"_28017":65921,"_19412":111616,"_5":13306,"_25509":111531,"_2665":108065},[],{"_3170":65951,"_28017":65921,"_19412":111618,"_5":13306,"_25509":111531,"_2665":111619},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3170":65952,"_28017":65921,"_19412":111621,"_5":13306,"_25509":111535,"_2665":111622},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3170":65953,"_28017":65921,"_19412":111624,"_5":13306,"_25509":111535,"_2665":111625},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3170":65954,"_28017":65921,"_19412":111627,"_5":13306,"_25509":111535,"_2665":111628},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3170":65955,"_28017":65921,"_19412":111630,"_5":13306,"_25509":111535,"_2665":111631},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3170":65956,"_28017":65921,"_19412":111633,"_5":13306,"_25509":111535,"_2665":111634},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3170":65957,"_28017":65921,"_19412":111636,"_5":13306,"_25509":111535,"_2665":111637},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3170":65958,"_28017":65921,"_19412":111639,"_5":13306,"_25509":111543,"_2665":111640},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3170":65959,"_28017":65921,"_19412":111642,"_5":13306,"_25509":111547,"_2665":111643},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3170":65960,"_28017":65921,"_19412":111645,"_5":13306,"_25509":111551,"_2665":111646},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3170":65961,"_28017":65921,"_19412":111648,"_5":13306,"_25509":111555,"_2665":111649},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3170":65962,"_28017":65921,"_19412":111651,"_5":13306,"_25509":111559,"_2665":111652},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3170":65963,"_28017":65921,"_19412":111654,"_5":13306,"_25509":111563,"_2665":111655},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3170":65964,"_28017":65921,"_19412":111657,"_5":13306,"_25509":111567,"_2665":111111},[],{"_3170":65965,"_28017":65921,"_19412":111659,"_5":13306,"_25509":111567,"_2665":111660},[],"Qué prepara o comprueba",{"_3170":65966,"_28017":65921,"_19412":111662,"_5":13306,"_25509":111567,"_2665":111114},[],{"_3170":65967,"_28017":65921,"_19412":111664,"_5":13306,"_25509":111567,"_2665":111665},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3170":65968,"_28017":65921,"_19412":111667,"_5":13306,"_25509":111567,"_2665":111668},[],"Administrador de la flota",{"_3170":65969,"_28017":65921,"_19412":111670,"_5":13306,"_25509":111567,"_2665":111671},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3170":65970,"_28017":65921,"_19412":111673,"_5":13306,"_25509":111567,"_2665":111126},[],{"_3170":65971,"_28017":65921,"_19412":111675,"_5":13306,"_25509":111567,"_2665":111676},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3170":65972,"_28017":65921,"_19412":111678,"_5":13306,"_25509":111567,"_2665":111132},[],{"_3170":65973,"_28017":65921,"_19412":111680,"_5":13306,"_25509":111567,"_2665":111681},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3170":65974,"_28017":65921,"_19412":111683,"_5":13306,"_25509":111567,"_2665":111684},[],"Operador de infraestructura",{"_3170":65975,"_28017":65921,"_19412":111686,"_5":13306,"_25509":111567,"_2665":111687},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3170":65976,"_28017":65921,"_19412":111689,"_5":13306,"_25509":111567,"_2665":111690},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3170":65977,"_28017":65977,"_5":13637,"_2665":111692,"_28360":111693,"_19412":111695,"_25509":65977},"Jerarquía y rotación de CAs",[45425,108067,50551,111694],"Claves, autoridades y certificados",[],{"_3170":65978,"_28017":65977,"_19412":111697,"_5":13306,"_25509":65977,"_2665":111698},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3170":65979,"_28017":65977,"_5":28357,"_19412":111700,"_25509":111701,"_2665":111702},[],"/docs/pr-preview/pr-54/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3170":65980,"_28017":65977,"_5":28357,"_19412":111704,"_25509":111705,"_2665":111706},[],"/docs/pr-preview/pr-54/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3170":65981,"_28017":65977,"_5":28357,"_19412":111708,"_25509":111709,"_2665":111710},[],"/docs/pr-preview/pr-54/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3170":65982,"_28017":65977,"_5":28357,"_19412":111712,"_25509":111713,"_2665":111714},[],"/docs/pr-preview/pr-54/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3170":65983,"_28017":65977,"_5":28357,"_19412":111716,"_25509":111717,"_2665":111718},[],"/docs/pr-preview/pr-54/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3170":65984,"_28017":65977,"_5":28357,"_19412":111720,"_25509":111721,"_2665":111722},[],"/docs/pr-preview/pr-54/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3170":65985,"_28017":65977,"_5":28357,"_19412":111724,"_25509":111725,"_2665":111726},[],"/docs/pr-preview/pr-54/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3170":65986,"_28017":65977,"_5":28357,"_19412":111728,"_25509":111729,"_2665":111730},[],"/docs/pr-preview/pr-54/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3170":65987,"_28017":65977,"_5":28357,"_19412":111732,"_25509":111733,"_2665":111734},[],"/docs/pr-preview/pr-54/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3170":65988,"_28017":65977,"_5":28357,"_19412":111736,"_25509":111737,"_2665":111738},[],"/docs/pr-preview/pr-54/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3170":65989,"_28017":65977,"_5":28357,"_19412":111740,"_25509":111741,"_2665":111742},[],"/docs/pr-preview/pr-54/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3170":65990,"_28017":65977,"_5":28357,"_19412":111744,"_25509":111745,"_2665":111746},[],"/docs/pr-preview/pr-54/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3170":65991,"_28017":65977,"_19412":111748,"_5":13306,"_25509":65977,"_2665":111749},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3170":65992,"_28017":65977,"_19412":111751,"_5":13306,"_25509":65977,"_2665":111752},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3170":65993,"_28017":65977,"_19412":111754,"_5":13306,"_25509":111701,"_2665":111755},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3170":65994,"_28017":65977,"_19412":111757,"_5":13306,"_25509":111701,"_2665":111758},[],"entorno, como producción y preproducción;",{"_3170":65995,"_28017":65977,"_19412":111760,"_5":13306,"_25509":111701,"_2665":111761},[],"propietario o equipo operador;",{"_3170":65996,"_28017":65977,"_19412":111763,"_5":13306,"_25509":111701,"_2665":111764},[],"familia de dispositivos o proceso de fabricación;",{"_3170":65997,"_28017":65977,"_19412":111766,"_5":13306,"_25509":111701,"_2665":111767},[],"región o requisito regulatorio;",{"_3170":65998,"_28017":65977,"_19412":111769,"_5":13306,"_25509":111701,"_2665":111770},[],"motor criptográfico o política de clave;",{"_3170":65999,"_28017":65977,"_19412":111772,"_5":13306,"_25509":111701,"_2665":111773},[],"ventana de mantenimiento y ritmo de renovación.",{"_3170":66000,"_28017":65977,"_19412":111775,"_5":13306,"_25509":111701,"_2665":111776},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3170":66001,"_28017":65977,"_19412":111778,"_5":13306,"_25509":111701,"_2665":111779},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3170":66002,"_28017":65977,"_19412":111781,"_5":13306,"_25509":111705,"_2665":111782},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3170":66003,"_28017":65977,"_19412":111784,"_5":13306,"_25509":111705,"_2665":111785},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3170":66004,"_28017":65977,"_19412":111787,"_5":13306,"_25509":111705,"_2665":111788},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_3170":66005,"_28017":65977,"_19412":111790,"_5":13306,"_25509":111709,"_2665":111791},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3170":66006,"_28017":65977,"_19412":111793,"_5":13306,"_25509":111709,"_2665":111794},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3170":66007,"_28017":65977,"_19412":111796,"_5":13306,"_25509":111709,"_2665":111797},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3170":66008,"_28017":65977,"_19412":111799,"_5":13306,"_25509":111709,"_2665":111800},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3170":66009,"_28017":65977,"_19412":111802,"_5":13306,"_25509":111717,"_2665":111803},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3170":66010,"_28017":65977,"_19412":111805,"_5":13306,"_25509":111721,"_2665":111806},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3170":66011,"_28017":65977,"_19412":111808,"_5":13306,"_25509":111725,"_2665":111809},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3170":66012,"_28017":65977,"_19412":111811,"_5":13306,"_25509":111729,"_2665":111812},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_3170":66013,"_28017":65977,"_19412":111814,"_5":13306,"_25509":111733,"_2665":111815},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3170":66014,"_28017":65977,"_19412":111817,"_5":13306,"_25509":111737,"_2665":111818},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_3170":66015,"_28017":65977,"_19412":111820,"_5":13306,"_25509":111741,"_2665":111821},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3170":66016,"_28017":65977,"_19412":111823,"_5":13306,"_25509":111741,"_2665":111824},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3170":66017,"_28017":65977,"_19412":111826,"_5":13306,"_25509":111741,"_2665":111827},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_3170":66018,"_28017":65977,"_19412":111829,"_5":13306,"_25509":111741,"_2665":111830},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3170":66019,"_28017":65977,"_19412":111832,"_5":13306,"_25509":111745,"_2665":111833},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3170":66020,"_28017":65977,"_19412":111835,"_5":13306,"_25509":111745,"_2665":111836},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3170":66021,"_28017":65977,"_19412":111838,"_5":13306,"_25509":111745,"_2665":111839},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3170":66022,"_28017":65977,"_19412":111841,"_5":13306,"_25509":111745,"_2665":111842},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3170":66023,"_28017":65977,"_19412":111844,"_5":13306,"_25509":111745,"_2665":111845},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3170":66024,"_28017":65977,"_19412":111847,"_5":13306,"_25509":111745,"_2665":111848},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3170":66025,"_28017":65977,"_19412":111850,"_5":13306,"_25509":111745,"_2665":111851},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3170":66026,"_28017":66026,"_5":13637,"_2665":111853,"_28360":111854,"_19412":111855,"_25509":66026},"Autoridades de certificación",[45425,108067,50551,111694],[],{"_3170":66027,"_28017":66026,"_19412":111857,"_5":13306,"_25509":66026,"_2665":111858},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3170":66028,"_28017":66026,"_5":28357,"_19412":111860,"_25509":111861,"_2665":111862},[],"/docs/pr-preview/pr-54/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3170":66029,"_28017":66026,"_5":28357,"_19412":111864,"_25509":111865,"_2665":111866},[],"/docs/pr-preview/pr-54/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3170":66030,"_28017":66026,"_5":28357,"_19412":111868,"_25509":111869,"_2665":106720},[],"/docs/pr-preview/pr-54/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3170":66031,"_28017":66026,"_5":28357,"_19412":111871,"_25509":111872,"_2665":111873},[],"/docs/pr-preview/pr-54/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3170":66032,"_28017":66026,"_5":28357,"_19412":111875,"_25509":111876,"_2665":111877},[],"/docs/pr-preview/pr-54/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3170":66033,"_28017":66026,"_5":28357,"_19412":111879,"_25509":111880,"_2665":111881},[],"/docs/pr-preview/pr-54/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3170":66034,"_28017":66026,"_5":28357,"_19412":111883,"_25509":111884,"_2665":111885},[],"/docs/pr-preview/pr-54/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3170":66035,"_28017":66026,"_5":28357,"_19412":111887,"_25509":111888,"_2665":111889},[],"/docs/pr-preview/pr-54/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3170":66036,"_28017":66026,"_5":28357,"_19412":111891,"_25509":111892,"_2665":111893},[],"/docs/pr-preview/pr-54/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3170":66037,"_28017":66026,"_5":28357,"_19412":111895,"_25509":111896,"_2665":111897},[],"/docs/pr-preview/pr-54/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3170":66038,"_28017":66026,"_5":28357,"_19412":111899,"_25509":111900,"_2665":111901},[],"/docs/pr-preview/pr-54/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3170":66039,"_28017":66026,"_5":28357,"_19412":111903,"_25509":111904,"_2665":111905},[],"/docs/pr-preview/pr-54/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3170":66040,"_28017":66026,"_5":28357,"_19412":111907,"_25509":111908,"_2665":111909},[],"/docs/pr-preview/pr-54/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3170":66041,"_28017":66026,"_5":28357,"_19412":111911,"_25509":111912,"_2665":111913},[],"/docs/pr-preview/pr-54/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3170":66042,"_28017":66026,"_5":28357,"_19412":111915,"_25509":111916,"_2665":111917},[],"/docs/pr-preview/pr-54/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3170":66043,"_28017":66026,"_5":28357,"_19412":111919,"_25509":111920,"_2665":111921},[],"/docs/pr-preview/pr-54/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3170":66044,"_28017":66026,"_5":28357,"_19412":111923,"_25509":111924,"_2665":111925},[],"/docs/pr-preview/pr-54/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3170":66045,"_28017":66026,"_5":28357,"_19412":111927,"_25509":111928,"_2665":111929},[],"/docs/pr-preview/pr-54/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3170":66046,"_28017":66026,"_5":28357,"_19412":111931,"_25509":111932,"_2665":111933},[],"/docs/pr-preview/pr-54/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3170":66047,"_28017":66026,"_5":28357,"_19412":111935,"_25509":111936,"_2665":111937},[],"/docs/pr-preview/pr-54/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3170":66048,"_28017":66026,"_5":28357,"_19412":111939,"_25509":111940,"_2665":111941},[],"/docs/pr-preview/pr-54/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3170":66049,"_28017":66026,"_5":28357,"_19412":111943,"_25509":111944,"_2665":111945},[],"/docs/pr-preview/pr-54/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3170":66050,"_28017":66026,"_19412":111947,"_5":13306,"_25509":66026,"_2665":111948},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3170":66051,"_28017":66026,"_19412":111950,"_5":13306,"_25509":66026,"_2665":111951},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3170":66052,"_28017":66026,"_19412":111953,"_5":13306,"_25509":66026,"_2665":111954},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3170":66053,"_28017":66026,"_19412":111956,"_5":13306,"_25509":111861,"_2665":111957},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3170":66054,"_28017":66026,"_19412":111959,"_5":13306,"_25509":111861,"_2665":111960},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3170":66055,"_28017":66026,"_19412":111962,"_5":13306,"_25509":111861,"_2665":111963},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3170":66056,"_28017":66026,"_19412":111965,"_5":13306,"_25509":111861,"_2665":111966},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3170":66057,"_28017":66026,"_19412":111968,"_5":13306,"_25509":111861,"_2665":111969},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3170":66058,"_28017":66026,"_19412":111971,"_5":13306,"_25509":111869,"_2665":111972},[],"Decide si la CA será raíz o intermedia.",{"_3170":66059,"_28017":66026,"_19412":111974,"_5":13306,"_25509":111869,"_2665":111975},[],"Elige el motor que custodiará la clave.",{"_3170":66060,"_28017":66026,"_19412":111977,"_5":13306,"_25509":111869,"_2665":111978},[],"Define una validez superior a la de los certificados que emitirá.",{"_3170":66061,"_28017":66026,"_19412":111980,"_5":13306,"_25509":111869,"_2665":111981},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3170":66062,"_28017":66026,"_19412":111983,"_5":13306,"_25509":111872,"_2665":111984},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3170":66063,"_28017":66026,"_19412":111986,"_5":13306,"_25509":111876,"_2665":111987},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3170":66064,"_28017":66026,"_19412":111989,"_5":13306,"_25509":111876,"_2665":111990},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3170":66065,"_28017":66026,"_19412":111992,"_5":13306,"_25509":111880,"_2665":111993},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3170":66066,"_28017":66026,"_19412":111995,"_5":13306,"_25509":111884,"_2665":111996},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3170":66067,"_28017":66026,"_19412":111998,"_5":13306,"_25509":111884,"_2665":111999},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3170":66068,"_28017":66026,"_19412":112001,"_5":13306,"_25509":111884,"_2665":112002},[],"`ST`: estado o provincia.",{"_3170":66069,"_28017":66026,"_19412":112004,"_5":13306,"_25509":111884,"_2665":112005},[],"`L`: localidad.",{"_3170":66070,"_28017":66026,"_19412":112007,"_5":13306,"_25509":111884,"_2665":112008},[],"`O`: organización.",{"_3170":66071,"_28017":66026,"_19412":112010,"_5":13306,"_25509":111884,"_2665":112011},[],"`OU`: unidad organizativa.",{"_3170":66072,"_28017":66026,"_19412":112013,"_5":13306,"_25509":111884,"_2665":112014},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3170":66073,"_28017":66026,"_19412":112016,"_5":13306,"_25509":111888,"_2665":112017},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3170":66074,"_28017":66026,"_19412":112019,"_5":13306,"_25509":111888,"_2665":112020},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3170":66075,"_28017":66026,"_19412":112022,"_5":13306,"_25509":111892,"_2665":112023},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3170":66076,"_28017":66026,"_19412":112025,"_5":13306,"_25509":111892,"_2665":112026},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3170":66077,"_28017":66026,"_19412":112028,"_5":13306,"_25509":111896,"_2665":112029},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3170":66078,"_28017":66026,"_19412":112031,"_5":13306,"_25509":111896,"_2665":112032},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3170":66079,"_28017":66026,"_19412":112034,"_5":13306,"_25509":111900,"_2665":112035},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3170":66080,"_28017":66026,"_19412":112037,"_5":13306,"_25509":111904,"_2665":112038},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3170":66081,"_28017":66026,"_19412":112040,"_5":13306,"_25509":111908,"_2665":112041},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3170":66082,"_28017":66026,"_19412":112043,"_5":13306,"_25509":111912,"_2665":112044},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3170":66083,"_28017":66026,"_19412":112046,"_5":13306,"_25509":111916,"_2665":112047},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3170":66084,"_28017":66026,"_19412":112049,"_5":13306,"_25509":111916,"_2665":112050},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3170":66085,"_28017":66026,"_19412":112052,"_5":13306,"_25509":111920,"_2665":112053},[],"Abre una CA desde el inventario para consultar:",{"_3170":66086,"_28017":66026,"_19412":112055,"_5":13306,"_25509":111920,"_2665":112056},[],"Estado y periodo de validez.",{"_3170":66087,"_28017":66026,"_19412":112058,"_5":13306,"_25509":111920,"_2665":112059},[],"Certificado y cadena en formato PEM.",{"_3170":66088,"_28017":66026,"_19412":112061,"_5":13306,"_25509":111920,"_2665":112062},[],"Número de certificados activos, expirados y revocados.",{"_3170":66089,"_28017":66026,"_19412":112064,"_5":13306,"_25509":111920,"_2665":112065},[],"Certificados emitidos en **Issued Certificates**.",{"_3170":66090,"_28017":66026,"_19412":112067,"_5":13306,"_25509":111920,"_2665":112068},[],"CRL vinculada a la autoridad.",{"_3170":66091,"_28017":66026,"_19412":112070,"_5":13306,"_25509":111920,"_2665":112071},[],"Metadatos y motor criptográfico asociado.",{"_3170":66092,"_28017":66026,"_19412":112073,"_5":13306,"_25509":111920,"_2665":112074},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3170":66093,"_28017":66026,"_19412":112076,"_5":13306,"_25509":111924,"_2665":112077},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3170":66094,"_28017":66026,"_19412":112079,"_5":13306,"_25509":111924,"_2665":112080},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3170":66095,"_28017":66026,"_19412":112082,"_5":13306,"_25509":111924,"_2665":112083},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3170":66096,"_28017":66026,"_19412":112085,"_5":13306,"_25509":111924,"_2665":112086},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3170":66097,"_28017":66026,"_19412":112088,"_5":13306,"_25509":111928,"_2665":112089},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_3170":66098,"_28017":66026,"_19412":112091,"_5":13306,"_25509":111932,"_2665":112092},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3170":66099,"_28017":66026,"_19412":112094,"_5":13306,"_25509":111936,"_2665":112095},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3170":66100,"_28017":66026,"_19412":112097,"_5":13306,"_25509":111940,"_2665":112098},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3170":66101,"_28017":66026,"_19412":112100,"_5":13306,"_25509":111944,"_2665":112101},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3170":66102,"_28017":66026,"_19412":112103,"_5":13306,"_25509":111944,"_2665":112104},[],"La eliminación permanente solo está disponible después de revocar. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3170":66103,"_28017":66103,"_5":13637,"_2665":112106,"_28360":112107,"_19412":112108,"_25509":66103},"Perfiles de certificado",[45425,108067,50551,111694],[],{"_3170":66104,"_28017":66103,"_19412":112110,"_5":13306,"_25509":66103,"_2665":112111},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3170":66105,"_28017":66103,"_5":28357,"_19412":112113,"_25509":112114,"_2665":112115},[],"/docs/pr-preview/pr-54/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3170":66106,"_28017":66103,"_5":28357,"_19412":112117,"_25509":112118,"_2665":112119},[],"/docs/pr-preview/pr-54/es/platform/pki/certificate-profiles#validez","Validez",{"_3170":66107,"_28017":66103,"_5":28357,"_19412":112121,"_25509":112122,"_2665":112123},[],"/docs/pr-preview/pr-54/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3170":66108,"_28017":66103,"_5":28357,"_19412":112125,"_25509":112126,"_2665":112127},[],"/docs/pr-preview/pr-54/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3170":66109,"_28017":66103,"_5":28357,"_19412":112129,"_25509":112130,"_2665":112131},[],"/docs/pr-preview/pr-54/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3170":66110,"_28017":66103,"_5":28357,"_19412":112133,"_25509":112134,"_2665":112135},[],"/docs/pr-preview/pr-54/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3170":66111,"_28017":66103,"_5":28357,"_19412":112137,"_25509":112138,"_2665":112139},[],"/docs/pr-preview/pr-54/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3170":66112,"_28017":66103,"_5":28357,"_19412":112141,"_25509":112142,"_2665":112143},[],"/docs/pr-preview/pr-54/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3170":66113,"_28017":66103,"_5":28357,"_19412":112145,"_25509":112146,"_2665":112147},[],"/docs/pr-preview/pr-54/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3170":66114,"_28017":66103,"_5":28357,"_19412":112149,"_25509":112150,"_2665":112151},[],"/docs/pr-preview/pr-54/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3170":66115,"_28017":66103,"_5":28357,"_19412":112153,"_25509":112154,"_2665":112155},[],"/docs/pr-preview/pr-54/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3170":66116,"_28017":66103,"_5":28357,"_19412":112157,"_25509":112158,"_2665":112159},[],"/docs/pr-preview/pr-54/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3170":66117,"_28017":66103,"_5":28357,"_19412":112161,"_25509":112162,"_2665":112163},[],"/docs/pr-preview/pr-54/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3170":66118,"_28017":66103,"_5":28357,"_19412":112165,"_25509":112166,"_2665":112167},[],"/docs/pr-preview/pr-54/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3170":66119,"_28017":66103,"_5":28357,"_19412":112169,"_25509":112170,"_2665":112171},[],"/docs/pr-preview/pr-54/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3170":66120,"_28017":66103,"_5":28357,"_19412":112173,"_25509":112174,"_2665":112175},[],"/docs/pr-preview/pr-54/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3170":66121,"_28017":66103,"_19412":112177,"_5":13306,"_25509":66103,"_2665":112178},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3170":66122,"_28017":66103,"_19412":112180,"_5":13306,"_25509":66103,"_2665":112181},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3170":66123,"_28017":66103,"_19412":112183,"_5":13306,"_25509":112118,"_2665":112184},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3170":66124,"_28017":66103,"_19412":112186,"_5":13306,"_25509":112118,"_2665":112187},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3170":66125,"_28017":66103,"_19412":112189,"_5":13306,"_25509":112122,"_2665":112190},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Actívalo solo en perfiles destinados a crear o reemitir CAs subordinadas.",{"_3170":66126,"_28017":66103,"_19412":112192,"_5":13306,"_25509":112126,"_2665":112193},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3170":66127,"_28017":66103,"_19412":112195,"_5":13306,"_25509":112126,"_2665":112196},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3170":66128,"_28017":66103,"_19412":112198,"_5":13306,"_25509":112126,"_2665":112199},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3170":66129,"_28017":66103,"_19412":112201,"_5":13306,"_25509":112130,"_2665":112202},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3170":66130,"_28017":66103,"_19412":112204,"_5":13306,"_25509":112134,"_2665":112205},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3170":66131,"_28017":66103,"_19412":112207,"_5":13306,"_25509":112134,"_2665":112208},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3170":66132,"_28017":66103,"_19412":112210,"_5":13306,"_25509":112138,"_2665":112211},[],"La aplicación criptográfica puede:",{"_3170":66133,"_28017":66103,"_19412":112213,"_5":13306,"_25509":112138,"_2665":112214},[],"permitir o bloquear claves RSA;",{"_3170":66134,"_28017":66103,"_19412":112216,"_5":13306,"_25509":112138,"_2665":112217},[],"limitar los tamaños RSA admitidos;",{"_3170":66135,"_28017":66103,"_19412":112219,"_5":13306,"_25509":112138,"_2665":112220},[],"permitir o bloquear claves ECDSA;",{"_3170":66136,"_28017":66103,"_19412":112222,"_5":13306,"_25509":112138,"_2665":112223},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3170":66137,"_28017":66103,"_19412":112225,"_5":13306,"_25509":112138,"_2665":112226},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3170":66138,"_28017":66103,"_19412":112228,"_5":13306,"_25509":112142,"_2665":112229},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3170":66139,"_28017":66103,"_19412":112231,"_5":13306,"_25509":112142,"_2665":107855},[],{"_3170":66140,"_28017":66103,"_19412":112233,"_5":13306,"_25509":112142,"_2665":112234},[],"Primera opción",{"_3170":66141,"_28017":66103,"_19412":112236,"_5":13306,"_25509":112142,"_2665":112237},[],"Segunda opción",{"_3170":66142,"_28017":66103,"_19412":112239,"_5":13306,"_25509":112142,"_2665":112240},[],"Si no hay ninguna",{"_3170":66143,"_28017":66103,"_19412":112242,"_5":13306,"_25509":112142,"_2665":112243},[],"Firma directa con una CA",{"_3170":66144,"_28017":66103,"_19412":112245,"_5":13306,"_25509":112142,"_2665":112246},[],"`issuance_profile` incluido en la solicitud",{"_3170":66145,"_28017":66103,"_19412":112248,"_5":13306,"_25509":112142,"_2665":112249},[],"`issuance_profile_id` de la solicitud",{"_3170":66146,"_28017":66103,"_19412":112251,"_5":13306,"_25509":112142,"_2665":112252},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3170":66147,"_28017":66103,"_19412":112254,"_5":13306,"_25509":112142,"_2665":112255},[],"Emisión mediante DMS",{"_3170":66148,"_28017":66103,"_19412":112257,"_5":13306,"_25509":112142,"_2665":51116},[],{"_3170":66149,"_28017":66103,"_19412":112259,"_5":13306,"_25509":112142,"_2665":112260},[],"`settings.issuance_profile` incluido en el DMS",{"_3170":66150,"_28017":66103,"_19412":112262,"_5":13306,"_25509":112142,"_2665":112263},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3170":66151,"_28017":66103,"_19412":112265,"_5":13306,"_25509":112142,"_2665":112266},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3170":66152,"_28017":66103,"_19412":112268,"_5":13306,"_25509":112142,"_2665":112269},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3170":66153,"_28017":66103,"_19412":112271,"_5":13306,"_25509":112150,"_2665":112272},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3170":66154,"_28017":66103,"_19412":112274,"_5":13306,"_25509":112154,"_2665":112275},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3170":66155,"_28017":66103,"_19412":112277,"_5":13306,"_25509":112158,"_2665":112278},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3170":66156,"_28017":66103,"_19412":112280,"_5":13306,"_25509":112162,"_2665":112281},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3170":66157,"_28017":66103,"_19412":112283,"_5":13306,"_25509":112166,"_2665":112284},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3170":66158,"_28017":66103,"_19412":112286,"_5":13306,"_25509":112166,"_2665":112287},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3170":66159,"_28017":66103,"_19412":112289,"_5":13306,"_25509":112170,"_2665":112290},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3170":66160,"_28017":66103,"_19412":112292,"_5":13306,"_25509":112170,"_2665":112293},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3170":66161,"_28017":66103,"_19412":112295,"_5":13306,"_25509":112170,"_2665":112296},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3170":66162,"_28017":66103,"_19412":112298,"_5":13306,"_25509":112170,"_2665":112299},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3170":66163,"_28017":66103,"_19412":112301,"_5":13306,"_25509":112174,"_2665":112302},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3170":66164,"_28017":66103,"_19412":112304,"_5":13306,"_25509":112174,"_2665":112305},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3170":66165,"_28017":66165,"_5":13637,"_2665":112307,"_28360":112308,"_19412":112310,"_25509":66165},"Validación de certificados",[45425,108067,50551,112309],"Validación",[],{"_3170":66166,"_28017":66165,"_19412":112312,"_5":13306,"_25509":66165,"_2665":112313},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3170":66167,"_28017":66165,"_5":28357,"_19412":112315,"_25509":112316,"_2665":112317},[],"/docs/pr-preview/pr-54/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3170":66168,"_28017":66165,"_5":28357,"_19412":112319,"_25509":112320,"_2665":112321},[],"/docs/pr-preview/pr-54/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3170":66169,"_28017":66165,"_5":28357,"_19412":112323,"_25509":112324,"_2665":112325},[],"/docs/pr-preview/pr-54/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3170":66170,"_28017":66165,"_19412":112327,"_5":13306,"_25509":66165,"_2665":112328},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3170":66171,"_28017":66165,"_19412":112330,"_5":13306,"_25509":112316,"_2665":112331},[],"Verifica estos criterios juntos:",{"_3170":66172,"_28017":66165,"_19412":112333,"_5":13306,"_25509":112316,"_2665":111321},[],{"_3170":66173,"_28017":66165,"_19412":112335,"_5":13306,"_25509":112316,"_2665":112336},[],"Resultado necesario",{"_3170":66174,"_28017":66165,"_19412":112338,"_5":13306,"_25509":112316,"_2665":112339},[],"Cadena y firma",{"_3170":66175,"_28017":66165,"_19412":112341,"_5":13306,"_25509":112316,"_2665":112342},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3170":66176,"_28017":66165,"_19412":112344,"_5":13306,"_25509":112316,"_2665":112345},[],"Fechas",{"_3170":66177,"_28017":66165,"_19412":112347,"_5":13306,"_25509":112316,"_2665":112348},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3170":66178,"_28017":66165,"_19412":112350,"_5":13306,"_25509":112316,"_2665":107765},[],{"_3170":66179,"_28017":66165,"_19412":112352,"_5":13306,"_25509":112316,"_2665":112353},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3170":66180,"_28017":66165,"_19412":112355,"_5":13306,"_25509":112316,"_2665":112356},[],"Uso",{"_3170":66181,"_28017":66165,"_19412":112358,"_5":13306,"_25509":112316,"_2665":112359},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3170":66182,"_28017":66165,"_19412":112361,"_5":13306,"_25509":112316,"_2665":112362},[],"Revocación",{"_3170":66183,"_28017":66165,"_19412":112364,"_5":13306,"_25509":112316,"_2665":112365},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3170":66184,"_28017":66165,"_19412":112367,"_5":13306,"_25509":112316,"_2665":112368},[],"Autorización",{"_3170":66185,"_28017":66165,"_19412":112370,"_5":13306,"_25509":112316,"_2665":112371},[],"La aplicación permite la acción a esa identidad.",{"_3170":66186,"_28017":66165,"_19412":112373,"_5":13306,"_25509":112316,"_2665":112374},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3170":66187,"_28017":66165,"_19412":112376,"_5":13306,"_25509":112320,"_2665":112377},[],"Mecanismo",{"_3170":66188,"_28017":66165,"_19412":112379,"_5":13306,"_25509":112320,"_2665":112380},[],"Cuándo utilizarlo",{"_3170":66189,"_28017":66165,"_19412":112382,"_5":13306,"_25509":112320,"_2665":112383},[],"Qué debes mantener",{"_3170":66190,"_28017":66165,"_19412":112385,"_5":13306,"_25509":112320,"_2665":51244},[],{"_3170":66191,"_28017":66165,"_19412":112387,"_5":13306,"_25509":112320,"_2665":112388},[],"Consulta del estado de un certificado concreto.",{"_3170":66192,"_28017":66165,"_19412":112390,"_5":13306,"_25509":112320,"_2665":112391},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3170":66193,"_28017":66165,"_19412":112393,"_5":13306,"_25509":112320,"_2665":51253},[],{"_3170":66194,"_28017":66165,"_19412":112395,"_5":13306,"_25509":112320,"_2665":112396},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3170":66195,"_28017":66165,"_19412":112398,"_5":13306,"_25509":112320,"_2665":112399},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3170":66196,"_28017":66165,"_19412":112401,"_5":13306,"_25509":112320,"_2665":112402},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3170":66197,"_28017":66165,"_19412":112404,"_5":13306,"_25509":112320,"_2665":112405},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3170":66198,"_28017":66165,"_19412":112407,"_5":13306,"_25509":112324,"_2665":112408},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3170":66199,"_28017":66165,"_19412":112410,"_5":13306,"_25509":112324,"_2665":112411},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3170":66200,"_28017":66165,"_19412":112413,"_5":13306,"_25509":112324,"_2665":112414},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3170":66201,"_28017":66165,"_19412":112416,"_5":13306,"_25509":112324,"_2665":112417},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3170":66202,"_28017":66165,"_19412":112419,"_5":13306,"_25509":112324,"_2665":112420},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3170":66203,"_28017":66165,"_19412":112422,"_5":13306,"_25509":112324,"_2665":112423},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3170":66204,"_28017":66165,"_19412":112425,"_5":13306,"_25509":112324,"_2665":112426},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3170":66205,"_28017":66165,"_19412":112428,"_5":13306,"_25509":112324,"_2665":112429},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3170":66206,"_28017":66165,"_19412":112431,"_5":13306,"_25509":112324,"_2665":112432},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3170":66207,"_28017":66207,"_5":13637,"_2665":112434,"_28360":112435,"_19412":112436,"_25509":66207},"Certificados",[45425,108067,50551,111694],[],{"_3170":66208,"_28017":66207,"_19412":112438,"_5":13306,"_25509":66207,"_2665":112439},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3170":66209,"_28017":66207,"_5":28357,"_19412":112441,"_25509":112442,"_2665":112443},[],"/docs/pr-preview/pr-54/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3170":66210,"_28017":66207,"_5":28357,"_19412":112445,"_25509":112446,"_2665":112447},[],"/docs/pr-preview/pr-54/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3170":66211,"_28017":66207,"_5":28357,"_19412":112449,"_25509":112450,"_2665":112451},[],"/docs/pr-preview/pr-54/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3170":66212,"_28017":66207,"_5":28357,"_19412":112453,"_25509":112454,"_2665":112455},[],"/docs/pr-preview/pr-54/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3170":66213,"_28017":66207,"_5":28357,"_19412":112457,"_25509":112458,"_2665":112459},[],"/docs/pr-preview/pr-54/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3170":66214,"_28017":66207,"_5":28357,"_19412":112461,"_25509":112462,"_2665":112463},[],"/docs/pr-preview/pr-54/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3170":66215,"_28017":66207,"_5":28357,"_19412":112465,"_25509":112466,"_2665":112467},[],"/docs/pr-preview/pr-54/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3170":66216,"_28017":66207,"_5":28357,"_19412":112469,"_25509":112470,"_2665":112471},[],"/docs/pr-preview/pr-54/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3170":66217,"_28017":66207,"_5":28357,"_19412":112473,"_25509":112474,"_2665":112475},[],"/docs/pr-preview/pr-54/es/platform/pki/certificates#continúa","Continúa",{"_3170":66218,"_28017":66207,"_19412":112477,"_5":13306,"_25509":66207,"_2665":112478},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3170":66219,"_28017":66207,"_19412":112480,"_5":13306,"_25509":112442,"_2665":112481},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_3170":66220,"_28017":66207,"_19412":112483,"_5":13306,"_25509":112442,"_2665":112484},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3170":66221,"_28017":66207,"_19412":112486,"_5":13306,"_25509":112446,"_2665":112487},[],"Descarga el PEM e inspecciónalo:",{"_3170":66222,"_28017":66207,"_19412":112489,"_5":13306,"_25509":112446,"_2665":112490},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3170":66223,"_28017":66207,"_19412":112492,"_5":13306,"_25509":112450,"_2665":112493},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3170":66224,"_28017":66207,"_19412":112495,"_5":13306,"_25509":112450,"_2665":112496},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3170":66225,"_28017":66207,"_19412":112498,"_5":13306,"_25509":112450,"_2665":112499},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3170":66226,"_28017":66207,"_19412":112501,"_5":13306,"_25509":112450,"_2665":112502},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3170":66227,"_28017":66207,"_19412":112504,"_5":13306,"_25509":112450,"_2665":112505},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3170":66228,"_28017":66207,"_19412":112507,"_5":13306,"_25509":112450,"_2665":112508},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3170":66229,"_28017":66207,"_19412":112510,"_5":13306,"_25509":112450,"_2665":112511},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3170":66230,"_28017":66207,"_19412":112513,"_5":13306,"_25509":112454,"_2665":112514},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3170":66231,"_28017":66207,"_19412":112516,"_5":13306,"_25509":112458,"_2665":112517},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3170":66232,"_28017":66207,"_19412":112519,"_5":13306,"_25509":112462,"_2665":112520},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3170":66233,"_28017":66207,"_19412":112522,"_5":13306,"_25509":112466,"_2665":112523},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3170":66234,"_28017":66207,"_19412":112525,"_5":13306,"_25509":112466,"_2665":112526},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3170":66235,"_28017":66207,"_19412":112528,"_5":13306,"_25509":112466,"_2665":112529},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3170":66236,"_28017":66207,"_19412":112531,"_5":13306,"_25509":112470,"_2665":112532},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3170":66237,"_28017":66207,"_19412":112534,"_5":13306,"_25509":112470,"_2665":112535},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3170":66238,"_28017":66207,"_19412":112537,"_5":13306,"_25509":112470,"_2665":112538},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_3170":66239,"_28017":66207,"_19412":112540,"_5":13306,"_25509":112474,"_2665":112541},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3170":66240,"_28017":66207,"_19412":112543,"_5":13306,"_25509":112474,"_2665":112544},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3170":66241,"_28017":66241,"_5":13637,"_2665":112546,"_28360":112547,"_19412":112549,"_25509":66241},"Ciclo de vida de un certificado",[45425,108067,50551,112548],"Conceptos",[],{"_3170":66242,"_28017":66241,"_19412":112551,"_5":13306,"_25509":66241,"_2665":112552},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3170":66243,"_28017":66241,"_5":28357,"_19412":112554,"_25509":112555,"_2665":112556},[],"/docs/pr-preview/pr-54/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3170":66244,"_28017":66241,"_5":28357,"_19412":112558,"_25509":112559,"_2665":112560},[],"/docs/pr-preview/pr-54/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3170":66245,"_28017":66241,"_5":28357,"_19412":112562,"_25509":112563,"_2665":112564},[],"/docs/pr-preview/pr-54/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3170":66246,"_28017":66241,"_5":28357,"_19412":112566,"_25509":112567,"_2665":112568},[],"/docs/pr-preview/pr-54/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3170":66247,"_28017":66241,"_5":28357,"_19412":112570,"_25509":112571,"_2665":112572},[],"/docs/pr-preview/pr-54/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3170":66248,"_28017":66241,"_5":28357,"_19412":112574,"_25509":112575,"_2665":112576},[],"/docs/pr-preview/pr-54/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3170":66249,"_28017":66241,"_5":28357,"_19412":112578,"_25509":112579,"_2665":112580},[],"/docs/pr-preview/pr-54/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado","Estados del certificado",{"_3170":66250,"_28017":66241,"_5":28357,"_19412":112582,"_25509":112583,"_2665":112584},[],"/docs/pr-preview/pr-54/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3170":66251,"_28017":66241,"_5":28357,"_19412":112586,"_25509":112587,"_2665":112588},[],"/docs/pr-preview/pr-54/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3170":66252,"_28017":66241,"_5":28357,"_19412":112590,"_25509":112591,"_2665":112592},[],"/docs/pr-preview/pr-54/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3170":66253,"_28017":66241,"_19412":112594,"_5":13306,"_25509":66241,"_2665":112595},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3170":66254,"_28017":66241,"_19412":112597,"_5":13306,"_25509":112559,"_2665":112598},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3170":66255,"_28017":66241,"_19412":112600,"_5":13306,"_25509":112563,"_2665":112601},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3170":66256,"_28017":66241,"_19412":112603,"_5":13306,"_25509":112567,"_2665":112604},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3170":66257,"_28017":66241,"_19412":112606,"_5":13306,"_25509":112571,"_2665":112607},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3170":66258,"_28017":66241,"_19412":112609,"_5":13306,"_25509":112575,"_2665":112610},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3170":66259,"_28017":66241,"_19412":112612,"_5":13306,"_25509":112579,"_2665":112613},[],"Lamassu persiste cuatro estados X.509:",{"_3170":66260,"_28017":66241,"_19412":112615,"_5":13306,"_25509":112579,"_2665":112616},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3170":66261,"_28017":66241,"_19412":112618,"_5":13306,"_25509":112579,"_2665":112619},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3170":66262,"_28017":66241,"_19412":112621,"_5":13306,"_25509":112579,"_2665":112622},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3170":66263,"_28017":66241,"_19412":112624,"_5":13306,"_25509":112579,"_2665":112625},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3170":66264,"_28017":66241,"_19412":112627,"_5":13306,"_25509":112579,"_2665":112628},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3170":66265,"_28017":66241,"_19412":112630,"_5":13306,"_25509":112583,"_2665":112631},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3170":66266,"_28017":66241,"_19412":112633,"_5":13306,"_25509":112583,"_2665":112634},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3170":66267,"_28017":66241,"_19412":112636,"_5":13306,"_25509":112583,"_2665":112637},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3170":66268,"_28017":66241,"_19412":112639,"_5":13306,"_25509":112587,"_2665":112640},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3170":66269,"_28017":66241,"_19412":112642,"_5":13306,"_25509":112587,"_2665":112643},[],"Antes de confirmar:",{"_3170":66270,"_28017":66241,"_19412":112645,"_5":13306,"_25509":112587,"_2665":112646},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3170":66271,"_28017":66241,"_19412":112648,"_5":13306,"_25509":112587,"_2665":112649},[],"Distribuye la nueva cadena de confianza.",{"_3170":66272,"_28017":66241,"_19412":112651,"_5":13306,"_25509":112587,"_2665":112652},[],"Reemite las identidades necesarias.",{"_3170":66273,"_28017":66241,"_19412":112654,"_5":13306,"_25509":112587,"_2665":112655},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3170":66274,"_28017":66241,"_19412":112657,"_5":13306,"_25509":112587,"_2665":112658},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3170":66275,"_28017":66241,"_19412":112660,"_5":13306,"_25509":112587,"_2665":112661},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3170":66276,"_28017":66241,"_19412":112663,"_5":13306,"_25509":112591,"_2665":112664},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3170":66277,"_28017":66241,"_19412":112666,"_5":13306,"_25509":112591,"_2665":112667},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3170":66278,"_28017":66241,"_19412":112669,"_5":13306,"_25509":112591,"_2665":112670},[],"Cambios de estado y razones de revocación.",{"_3170":66279,"_28017":66241,"_19412":112672,"_5":13306,"_25509":112591,"_2665":112673},[],"Publicación y vigencia de OCSP y CRLs.",{"_3170":66280,"_28017":66241,"_19412":112675,"_5":13306,"_25509":112591,"_2665":112676},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3170":66281,"_28017":66241,"_19412":112678,"_5":13306,"_25509":112591,"_2665":112679},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3170":66282,"_28017":66282,"_5":13637,"_2665":112681,"_28360":112682,"_19412":112683,"_25509":66282},"Modelo de confianza",[45425,108067,50551,112548],[],{"_3170":66283,"_28017":66282,"_19412":112685,"_5":13306,"_25509":66282,"_2665":112686},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3170":66284,"_28017":66282,"_5":28357,"_19412":112688,"_25509":112689,"_2665":112690},[],"/docs/pr-preview/pr-54/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3170":66285,"_28017":66282,"_5":28357,"_19412":112692,"_25509":112693,"_2665":112694},[],"/docs/pr-preview/pr-54/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3170":66286,"_28017":66282,"_5":28357,"_19412":112696,"_25509":112697,"_2665":112698},[],"/docs/pr-preview/pr-54/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3170":66287,"_28017":66282,"_5":28357,"_19412":112700,"_25509":112701,"_2665":112702},[],"/docs/pr-preview/pr-54/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3170":66288,"_28017":66282,"_5":28357,"_19412":112704,"_25509":112705,"_2665":112706},[],"/docs/pr-preview/pr-54/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3170":66289,"_28017":66282,"_5":28357,"_19412":112708,"_25509":112709,"_2665":112710},[],"/docs/pr-preview/pr-54/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3170":66290,"_28017":66282,"_5":28357,"_19412":112712,"_25509":112713,"_2665":112714},[],"/docs/pr-preview/pr-54/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3170":66291,"_28017":66282,"_5":28357,"_19412":112716,"_25509":112717,"_2665":112718},[],"/docs/pr-preview/pr-54/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3170":66292,"_28017":66282,"_5":28357,"_19412":112720,"_25509":112721,"_2665":112722},[],"/docs/pr-preview/pr-54/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3170":66293,"_28017":66282,"_5":28357,"_19412":112724,"_25509":112725,"_2665":112726},[],"/docs/pr-preview/pr-54/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3170":66294,"_28017":66282,"_19412":112728,"_5":13306,"_25509":66282,"_2665":112729},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3170":66295,"_28017":66282,"_19412":112731,"_5":13306,"_25509":112693,"_2665":112732},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3170":66296,"_28017":66282,"_19412":112734,"_5":13306,"_25509":112697,"_2665":112735},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3170":66297,"_28017":66282,"_19412":112737,"_5":13306,"_25509":112701,"_2665":112738},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3170":66298,"_28017":66282,"_19412":112740,"_5":13306,"_25509":112705,"_2665":112741},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3170":66299,"_28017":66282,"_19412":112743,"_5":13306,"_25509":112709,"_2665":112744},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3170":66300,"_28017":66282,"_19412":112746,"_5":13306,"_25509":112709,"_2665":112747},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3170":66301,"_28017":66282,"_19412":112749,"_5":13306,"_25509":112709,"_2665":112750},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3170":66302,"_28017":66282,"_19412":112752,"_5":13306,"_25509":112709,"_2665":112753},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3170":66303,"_28017":66282,"_19412":112755,"_5":13306,"_25509":112709,"_2665":112756},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3170":66304,"_28017":66282,"_19412":112758,"_5":13306,"_25509":112709,"_2665":112759},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3170":66305,"_28017":66282,"_19412":112761,"_5":13306,"_25509":112713,"_2665":112762},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3170":66306,"_28017":66282,"_19412":112764,"_5":13306,"_25509":112713,"_2665":112765},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3170":66307,"_28017":66282,"_19412":112767,"_5":13306,"_25509":112713,"_2665":112768},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_3170":66308,"_28017":66282,"_19412":112770,"_5":13306,"_25509":112713,"_2665":112771},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3170":66309,"_28017":66282,"_19412":112773,"_5":13306,"_25509":112713,"_2665":112774},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3170":66310,"_28017":66282,"_19412":112776,"_5":13306,"_25509":112717,"_2665":112777},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3170":66311,"_28017":66282,"_19412":112779,"_5":13306,"_25509":112717,"_2665":112780},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3170":66312,"_28017":66282,"_19412":112782,"_5":13306,"_25509":112717,"_2665":112783},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3170":66313,"_28017":66282,"_19412":112785,"_5":13306,"_25509":112717,"_2665":112786},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3170":66314,"_28017":66282,"_19412":112788,"_5":13306,"_25509":112717,"_2665":112789},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3170":66315,"_28017":66282,"_19412":112791,"_5":13306,"_25509":112717,"_2665":112792},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3170":66316,"_28017":66282,"_19412":112794,"_5":13306,"_25509":112717,"_2665":112795},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_3170":66317,"_28017":66282,"_19412":112797,"_5":13306,"_25509":112721,"_2665":112798},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3170":66318,"_28017":66282,"_19412":112800,"_5":13306,"_25509":112725,"_2665":112801},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3170":66319,"_28017":66282,"_19412":112803,"_5":13306,"_25509":112725,"_2665":112804},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3170":66320,"_28017":66282,"_19412":112806,"_5":13306,"_25509":112725,"_2665":112807},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3170":66321,"_28017":66282,"_19412":112809,"_5":13306,"_25509":112725,"_2665":112810},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3170":66322,"_28017":66282,"_19412":112812,"_5":13306,"_25509":112725,"_2665":112813},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3170":66323,"_28017":66282,"_19412":112815,"_5":13306,"_25509":112725,"_2665":112816},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3170":66324,"_28017":66282,"_19412":112818,"_5":13306,"_25509":112725,"_2665":112819},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3170":66325,"_28017":66325,"_5":13637,"_2665":112821,"_28360":112822,"_19412":112823,"_25509":66325},"Listas de revocación (CRL)",[45425,108067,50551,112309],[],{"_3170":66326,"_28017":66325,"_19412":112825,"_5":13306,"_25509":66325,"_2665":112826},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3170":66327,"_28017":66325,"_5":28357,"_19412":112828,"_25509":112829,"_2665":112830},[],"/docs/pr-preview/pr-54/es/platform/pki/crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_3170":66328,"_28017":66325,"_5":28357,"_19412":112832,"_25509":112833,"_2665":112834},[],"/docs/pr-preview/pr-54/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3170":66329,"_28017":66325,"_5":28357,"_19412":112836,"_25509":112837,"_2665":112838},[],"/docs/pr-preview/pr-54/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3170":66330,"_28017":66325,"_5":28357,"_19412":112840,"_25509":112841,"_2665":112842},[],"/docs/pr-preview/pr-54/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3170":66331,"_28017":66325,"_5":28357,"_19412":112844,"_25509":112845,"_2665":112846},[],"/docs/pr-preview/pr-54/es/platform/pki/crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_3170":66332,"_28017":66325,"_5":28357,"_19412":112848,"_25509":112849,"_2665":112850},[],"/docs/pr-preview/pr-54/es/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_3170":66333,"_28017":66325,"_5":28357,"_19412":112852,"_25509":112853,"_2665":112854},[],"/docs/pr-preview/pr-54/es/platform/pki/crl#referencias","Referencias",{"_3170":66334,"_28017":66325,"_19412":112856,"_5":13306,"_25509":66325,"_2665":112857},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su SKI y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3170":66335,"_28017":66325,"_19412":112859,"_5":13306,"_25509":112829,"_2665":112860},[],"El rol VA guarda la configuración y los metadatos de la última lista publicada para el SKI de una CA. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3170":66336,"_28017":66325,"_19412":112862,"_5":13306,"_25509":112829,"_2665":112863},[],"Campo de `crl_options`",{"_3170":66337,"_28017":66325,"_19412":112865,"_5":13306,"_25509":112829,"_2665":109602},[],{"_3170":66338,"_28017":66325,"_19412":112867,"_5":13306,"_25509":112829,"_2665":112868},[],"Valor inicial del backend",{"_3170":66339,"_28017":66325,"_19412":112870,"_5":13306,"_25509":112829,"_2665":51731},[],{"_3170":66340,"_28017":66325,"_19412":112872,"_5":13306,"_25509":112829,"_2665":112873},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3170":66341,"_28017":66325,"_19412":112875,"_5":13306,"_25509":112829,"_2665":112876},[],"7 días.",{"_3170":66342,"_28017":66325,"_19412":112878,"_5":13306,"_25509":112829,"_2665":51740},[],{"_3170":66343,"_28017":66325,"_19412":112880,"_5":13306,"_25509":112829,"_2665":112881},[],"Plazo desde la publicación que activa la renovación programada.",{"_3170":66344,"_28017":66325,"_19412":112883,"_5":13306,"_25509":112829,"_2665":112884},[],"6 días y 23 horas.",{"_3170":66345,"_28017":66325,"_19412":112886,"_5":13306,"_25509":112829,"_2665":51749},[],{"_3170":66346,"_28017":66325,"_19412":112888,"_5":13306,"_25509":112829,"_2665":112889},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3170":66347,"_28017":66325,"_19412":112891,"_5":13306,"_25509":112829,"_2665":51755},[],{"_3170":66348,"_28017":66325,"_19412":112893,"_5":13306,"_25509":112829,"_2665":51758},[],{"_3170":66349,"_28017":66325,"_19412":112895,"_5":13306,"_25509":112829,"_2665":112896},[],"Campo de configuración inicializado con el SKI de la CA.",{"_3170":66350,"_28017":66325,"_19412":112898,"_5":13306,"_25509":112829,"_2665":112899},[],"SKI de la CA.",{"_3170":66351,"_28017":66325,"_19412":112901,"_5":13306,"_25509":112829,"_2665":112902},[],"El generador utiliza la clave de la CA identificada por el SKI solicitado. No interpretes `subject_key_id_signer` como soporte verificado de una CA delegada distinta: cambiar el campo no cambia el firmante en ese flujo.",{"_3170":66352,"_28017":66325,"_19412":112904,"_5":13306,"_25509":112829,"_2665":112905},[],"`latest_crl` contiene versión, inicio y fin de validez. Las versiones se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/{subject_key_id}/{version}.crl`; el endpoint público entrega DER.",{"_3170":66353,"_28017":66325,"_19412":112907,"_5":13306,"_25509":112833,"_2665":112908},[],"El trabajo programado solicita otra lista cuando se alcanza `refresh_interval` o cuando la lista está próxima a vencer según el periodo de vigilancia configurado. Esto depende de que el trabajo, almacenamiento y firma funcionen; no garantiza renovación ante un fallo del servicio.",{"_3170":66354,"_28017":66325,"_19412":112910,"_5":13306,"_25509":112833,"_2665":112911},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3170":66355,"_28017":66325,"_19412":112913,"_5":13306,"_25509":112833,"_2665":112914},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3170":66356,"_28017":66325,"_19412":112916,"_5":13306,"_25509":112837,"_2665":112917},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3170":66357,"_28017":66325,"_19412":112919,"_5":13306,"_25509":112837,"_2665":112920},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3170":66358,"_28017":66325,"_19412":112922,"_5":13306,"_25509":112841,"_2665":112923},[],"El servicio VA expone `GET /crl/{subject_key_id}` sin autorización de gestión. Usa el SKI de la **CA emisora**, no el SKI del certificado final ni su número de serie. Inspecciona primero el CDP del certificado:",{"_3170":66359,"_28017":66325,"_19412":112925,"_5":13306,"_25509":112841,"_2665":112926},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3170":66360,"_28017":66325,"_19412":112928,"_5":13306,"_25509":112841,"_2665":112929},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3170":66361,"_28017":66325,"_19412":112931,"_5":13306,"_25509":112841,"_2665":112932},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3170":66362,"_28017":66325,"_19412":112934,"_5":13306,"_25509":112841,"_2665":112935},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3170":66363,"_28017":66325,"_19412":112937,"_5":13306,"_25509":112845,"_2665":112938},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3170":66364,"_28017":66325,"_19412":112940,"_5":13306,"_25509":112845,"_2665":109791},[],{"_3170":66365,"_28017":66325,"_19412":112942,"_5":13306,"_25509":112845,"_2665":112943},[],"Path relativo",{"_3170":66366,"_28017":66325,"_19412":112945,"_5":13306,"_25509":112845,"_2665":107855},[],{"_3170":66367,"_28017":66325,"_19412":112947,"_5":13306,"_25509":112845,"_2665":51813},[],{"_3170":66368,"_28017":66325,"_19412":112949,"_5":13306,"_25509":112845,"_2665":51816},[],{"_3170":66369,"_28017":66325,"_19412":112951,"_5":13306,"_25509":112845,"_2665":112952},[],"Consultar `crl_options` y `latest_crl`.",{"_3170":66370,"_28017":66325,"_19412":112954,"_5":13306,"_25509":112845,"_2665":51822},[],{"_3170":66371,"_28017":66325,"_19412":112956,"_5":13306,"_25509":112845,"_2665":51816},[],{"_3170":66372,"_28017":66325,"_19412":112958,"_5":13306,"_25509":112845,"_2665":112959},[],"Sustituir la configuración de CRL.",{"_3170":66373,"_28017":66325,"_19412":112961,"_5":13306,"_25509":112845,"_2665":112962},[],"Necesitas autenticación y permisos de lectura o actualización del rol. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato: el backend sustituye `crl_options`; no fusiona campos omitidos.",{"_3170":66374,"_28017":66325,"_19412":112964,"_5":13306,"_25509":112845,"_2665":112965},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar el rol no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3170":66375,"_28017":66325,"_19412":112967,"_5":13306,"_25509":112849,"_2665":112968},[],"La vista de la CA permite inspeccionar y descargar la lista disponible. Compara versión, emisor y tiempos con la copia descargada desde el endpoint público. Para diagnosticar una diferencia, sigue Diagnóstico PKI.",{"_3170":66376,"_28017":66325,"_19412":112970,"_5":13306,"_25509":112853,"_2665":112971},[],"RFC 5280: perfil X.509 y CRL.",{"_3170":66377,"_28017":66325,"_19412":112973,"_5":13306,"_25509":112853,"_2665":51842},[],{"_3170":66378,"_28017":66325,"_19412":112975,"_5":13306,"_25509":112853,"_2665":51845},[],{"_3170":66379,"_28017":66325,"_19412":112977,"_5":13306,"_25509":112853,"_2665":112978},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3170":66380,"_28017":66325,"_19412":112980,"_5":13306,"_25509":112853,"_2665":112981},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3170":66381,"_28017":66381,"_5":13637,"_2665":112983,"_28360":112984,"_19412":112985,"_25509":66381},"Claves y motores criptográficos",[45425,108067,50551,111694],[],{"_3170":66382,"_28017":66381,"_19412":112987,"_5":13306,"_25509":66381,"_2665":112988},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3170":66383,"_28017":66381,"_5":28357,"_19412":112990,"_25509":112991,"_2665":112992},[],"/docs/pr-preview/pr-54/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3170":66384,"_28017":66381,"_5":28357,"_19412":112994,"_25509":112995,"_2665":112996},[],"/docs/pr-preview/pr-54/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3170":66385,"_28017":66381,"_5":28357,"_19412":112998,"_25509":112999,"_2665":51870},[],"/docs/pr-preview/pr-54/es/platform/pki/key-management#file-system",{"_3170":66386,"_28017":66381,"_5":28357,"_19412":113001,"_25509":113002,"_2665":51874},[],"/docs/pr-preview/pr-54/es/platform/pki/key-management#hashicorp-vault",{"_3170":66387,"_28017":66381,"_5":28357,"_19412":113004,"_25509":113005,"_2665":51878},[],"/docs/pr-preview/pr-54/es/platform/pki/key-management#aws-secrets-manager",{"_3170":66388,"_28017":66381,"_5":28357,"_19412":113007,"_25509":113008,"_2665":51882},[],"/docs/pr-preview/pr-54/es/platform/pki/key-management#aws-kms",{"_3170":66389,"_28017":66381,"_5":28357,"_19412":113010,"_25509":113011,"_2665":51886},[],"/docs/pr-preview/pr-54/es/platform/pki/key-management#pkcs11",{"_3170":66390,"_28017":66381,"_5":28357,"_19412":113013,"_25509":113014,"_2665":51890},[],"/docs/pr-preview/pr-54/es/platform/pki/key-management#azure-key-vault",{"_3170":66391,"_28017":66381,"_5":28357,"_19412":113016,"_25509":113017,"_2665":113018},[],"/docs/pr-preview/pr-54/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3170":66392,"_28017":66381,"_5":28357,"_19412":113020,"_25509":113021,"_2665":113022},[],"/docs/pr-preview/pr-54/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3170":66393,"_28017":66381,"_5":28357,"_19412":113024,"_25509":113025,"_2665":113026},[],"/docs/pr-preview/pr-54/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3170":66394,"_28017":66381,"_5":28357,"_19412":113028,"_25509":113029,"_2665":113030},[],"/docs/pr-preview/pr-54/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3170":66395,"_28017":66381,"_5":28357,"_19412":113032,"_25509":113033,"_2665":113034},[],"/docs/pr-preview/pr-54/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3170":66396,"_28017":66381,"_5":28357,"_19412":113036,"_25509":113037,"_2665":113038},[],"/docs/pr-preview/pr-54/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3170":66397,"_28017":66381,"_5":28357,"_19412":113040,"_25509":113041,"_2665":113042},[],"/docs/pr-preview/pr-54/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3170":66398,"_28017":66381,"_5":28357,"_19412":113044,"_25509":113045,"_2665":51922},[],"/docs/pr-preview/pr-54/es/platform/pki/key-management#sign",{"_3170":66399,"_28017":66381,"_5":28357,"_19412":113047,"_25509":113048,"_2665":51926},[],"/docs/pr-preview/pr-54/es/platform/pki/key-management#verify",{"_3170":66400,"_28017":66381,"_5":28357,"_19412":113050,"_25509":113051,"_2665":113052},[],"/docs/pr-preview/pr-54/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3170":66401,"_28017":66381,"_5":28357,"_19412":113054,"_25509":113055,"_2665":113056},[],"/docs/pr-preview/pr-54/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3170":66402,"_28017":66381,"_5":28357,"_19412":113058,"_25509":113059,"_2665":113060},[],"/docs/pr-preview/pr-54/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3170":66403,"_28017":66381,"_19412":113062,"_5":13306,"_25509":66381,"_2665":113063},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3170":66404,"_28017":66381,"_19412":113065,"_5":13306,"_25509":66381,"_2665":113066},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3170":66405,"_28017":66381,"_19412":113068,"_5":13306,"_25509":112991,"_2665":113069},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3170":66406,"_28017":66381,"_19412":113071,"_5":13306,"_25509":112991,"_2665":113072},[],"En la práctica, permite:",{"_3170":66407,"_28017":66381,"_19412":113074,"_5":13306,"_25509":112991,"_2665":113075},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3170":66408,"_28017":66381,"_19412":113077,"_5":13306,"_25509":112991,"_2665":113078},[],"Importar claves creadas externamente.",{"_3170":66409,"_28017":66381,"_19412":113080,"_5":13306,"_25509":112991,"_2665":113081},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3170":66410,"_28017":66381,"_19412":113083,"_5":13306,"_25509":112991,"_2665":113084},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3170":66411,"_28017":66381,"_19412":113086,"_5":13306,"_25509":112995,"_2665":113087},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3170":66412,"_28017":66381,"_19412":113089,"_5":13306,"_25509":112995,"_2665":113090},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3170":66413,"_28017":66381,"_19412":113092,"_5":13306,"_25509":112995,"_2665":113093},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3170":66414,"_28017":66381,"_19412":113095,"_5":13306,"_25509":112999,"_2665":113096},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3170":66415,"_28017":66381,"_19412":113098,"_5":13306,"_25509":113002,"_2665":113099},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3170":66416,"_28017":66381,"_19412":113101,"_5":13306,"_25509":113002,"_2665":113102},[],"El adaptador se comunica con Vault a través de su endpoint HTTP(S) configurado. El certificado del servidor de Vault se verifica contra el almacén de confianza del sistema; para confiar en un Vault con certificado emitido por una CA privada, añade ese certificado de CA al `ca_cert_file` del motor (codificado en PEM). `insecure_skip_verify=true` desactiva la verificación y es un último recurso; acuerda los ajustes de transporte con el responsable de Despliegue.",{"_3170":66417,"_28017":66381,"_19412":113104,"_5":13306,"_25509":113005,"_2665":113105},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3170":66418,"_28017":66381,"_19412":113107,"_5":13306,"_25509":113008,"_2665":113108},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3170":66419,"_28017":66381,"_19412":113110,"_5":13306,"_25509":113011,"_2665":113111},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3170":66420,"_28017":66381,"_19412":113113,"_5":13306,"_25509":113014,"_2665":113114},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3170":66421,"_28017":66381,"_19412":113116,"_5":13306,"_25509":113014,"_2665":113117},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3170":66422,"_28017":66381,"_19412":113119,"_5":13306,"_25509":113014,"_2665":113120},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3170":66423,"_28017":66381,"_19412":113122,"_5":13306,"_25509":113014,"_2665":113123},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3170":66424,"_28017":66381,"_19412":113125,"_5":13306,"_25509":113017,"_2665":113126},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3170":66425,"_28017":66381,"_19412":113128,"_5":13306,"_25509":113017,"_2665":113129},[],"La tabla incluye los siguientes campos:",{"_3170":66426,"_28017":66381,"_19412":113131,"_5":13306,"_25509":113017,"_2665":113132},[],"**Name**: nombre descriptivo de la clave.",{"_3170":66427,"_28017":66381,"_19412":113134,"_5":13306,"_25509":113017,"_2665":113135},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3170":66428,"_28017":66381,"_19412":113137,"_5":13306,"_25509":113017,"_2665":113138},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3170":66429,"_28017":66381,"_19412":113140,"_5":13306,"_25509":113017,"_2665":113141},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3170":66430,"_28017":66381,"_19412":113143,"_5":13306,"_25509":113017,"_2665":113144},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3170":66431,"_28017":66381,"_19412":113146,"_5":13306,"_25509":113017,"_2665":113147},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3170":66432,"_28017":66381,"_19412":113149,"_5":13306,"_25509":113017,"_2665":113150},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3170":66433,"_28017":66381,"_19412":113152,"_5":13306,"_25509":113017,"_2665":113153},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3170":66434,"_28017":66381,"_19412":113155,"_5":13306,"_25509":113017,"_2665":113156},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3170":66435,"_28017":66381,"_19412":113158,"_5":13306,"_25509":113017,"_2665":113159},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3170":66436,"_28017":66381,"_19412":113161,"_5":13306,"_25509":113017,"_2665":113162},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3170":66437,"_28017":66381,"_19412":113164,"_5":13306,"_25509":113017,"_2665":113165},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3170":66438,"_28017":66381,"_19412":113167,"_5":13306,"_25509":113017,"_2665":113168},[],"**Delete Key** para eliminar la clave del sistema.",{"_3170":66439,"_28017":66381,"_19412":113170,"_5":13306,"_25509":113021,"_2665":113171},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3170":66440,"_28017":66381,"_19412":113173,"_5":13306,"_25509":113025,"_2665":113174},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3170":66441,"_28017":66381,"_19412":113176,"_5":13306,"_25509":113025,"_2665":113177},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3170":66442,"_28017":66381,"_19412":113179,"_5":13306,"_25509":113025,"_2665":113180},[],"**Key Name**: nombre único y descriptivo.",{"_3170":66443,"_28017":66381,"_19412":113182,"_5":13306,"_25509":113025,"_2665":113183},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3170":66444,"_28017":66381,"_19412":113185,"_5":13306,"_25509":113025,"_2665":113186},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3170":66445,"_28017":66381,"_19412":113188,"_5":13306,"_25509":113025,"_2665":113189},[],"**Tags**: metadatos para clasificar la clave.",{"_3170":66446,"_28017":66381,"_19412":113191,"_5":13306,"_25509":113025,"_2665":113192},[],"**Metadata**: información adicional para usos avanzados.",{"_3170":66447,"_28017":66381,"_19412":113194,"_5":13306,"_25509":113029,"_2665":113195},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3170":66448,"_28017":66381,"_19412":113197,"_5":13306,"_25509":113029,"_2665":113198},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3170":66449,"_28017":66381,"_19412":113200,"_5":13306,"_25509":113029,"_2665":113201},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3170":66450,"_28017":66381,"_19412":113203,"_5":13306,"_25509":113029,"_2665":113204},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3170":66451,"_28017":66381,"_19412":113206,"_5":13306,"_25509":113029,"_2665":113207},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3170":66452,"_28017":66381,"_19412":113209,"_5":13306,"_25509":113029,"_2665":113210},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3170":66453,"_28017":66381,"_19412":113212,"_5":13306,"_25509":113029,"_2665":113213},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3170":66454,"_28017":66381,"_19412":113215,"_5":13306,"_25509":113029,"_2665":113216},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3170":66455,"_28017":66381,"_19412":113218,"_5":13306,"_25509":113029,"_2665":113219},[],"**Metadata**: información adicional opcional.",{"_3170":66456,"_28017":66381,"_19412":113221,"_5":13306,"_25509":113029,"_2665":113222},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3170":66457,"_28017":66381,"_19412":113224,"_5":13306,"_25509":113029,"_2665":113225},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3170":66458,"_28017":66381,"_19412":113227,"_5":13306,"_25509":113033,"_2665":113228},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3170":66459,"_28017":66381,"_19412":113230,"_5":13306,"_25509":113037,"_2665":113231},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3170":66460,"_28017":66381,"_19412":113233,"_5":13306,"_25509":113037,"_2665":113234},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3170":66461,"_28017":66381,"_19412":113236,"_5":13306,"_25509":113037,"_2665":113237},[],"**Key Name**: nombre descriptivo.",{"_3170":66462,"_28017":66381,"_19412":113239,"_5":13306,"_25509":113037,"_2665":113240},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3170":66463,"_28017":66381,"_19412":113242,"_5":13306,"_25509":113037,"_2665":113243},[],"**Tags**: etiquetas asociadas.",{"_3170":66464,"_28017":66381,"_19412":113245,"_5":13306,"_25509":113037,"_2665":113246},[],"**Aliases**: nombres alternativos.",{"_3170":66465,"_28017":66381,"_19412":113248,"_5":13306,"_25509":113037,"_2665":113249},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3170":66466,"_28017":66381,"_19412":113251,"_5":13306,"_25509":113037,"_2665":113252},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3170":66467,"_28017":66381,"_19412":113254,"_5":13306,"_25509":113037,"_2665":113255},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3170":66468,"_28017":66381,"_19412":113257,"_5":13306,"_25509":113037,"_2665":113258},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3170":66469,"_28017":66381,"_19412":113260,"_5":13306,"_25509":113041,"_2665":113261},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3170":66470,"_28017":66381,"_19412":113263,"_5":13306,"_25509":113041,"_2665":113264},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3170":66471,"_28017":66381,"_19412":113266,"_5":13306,"_25509":113041,"_2665":113267},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3170":66472,"_28017":66381,"_19412":113269,"_5":13306,"_25509":113045,"_2665":113270},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3170":66473,"_28017":66381,"_19412":113272,"_5":13306,"_25509":113045,"_2665":113273},[],"Campos principales:",{"_3170":66474,"_28017":66381,"_19412":113275,"_5":13306,"_25509":113045,"_2665":113276},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3170":66475,"_28017":66381,"_19412":113278,"_5":13306,"_25509":113045,"_2665":113279},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3170":66476,"_28017":66381,"_19412":113281,"_5":13306,"_25509":113045,"_2665":113282},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3170":66477,"_28017":66381,"_19412":113284,"_5":13306,"_25509":113045,"_2665":113285},[],"**Message**: contenido que se va a firmar.",{"_3170":66478,"_28017":66381,"_19412":113287,"_5":13306,"_25509":113045,"_2665":113288},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3170":66479,"_28017":66381,"_19412":113290,"_5":13306,"_25509":113048,"_2665":113291},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3170":66480,"_28017":66381,"_19412":113293,"_5":13306,"_25509":113048,"_2665":113273},[],{"_3170":66481,"_28017":66381,"_19412":113295,"_5":13306,"_25509":113048,"_2665":113296},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3170":66482,"_28017":66381,"_19412":113298,"_5":13306,"_25509":113048,"_2665":113299},[],"**Message Type**: `Raw` o `Digest`.",{"_3170":66483,"_28017":66381,"_19412":113301,"_5":13306,"_25509":113048,"_2665":113302},[],"**Payload Encoding**: codificación del mensaje.",{"_3170":66484,"_28017":66381,"_19412":113304,"_5":13306,"_25509":113048,"_2665":113305},[],"**Message**: mensaje original o hash.",{"_3170":66485,"_28017":66381,"_19412":113307,"_5":13306,"_25509":113048,"_2665":113308},[],"**Signature**: firma que se desea comprobar.",{"_3170":66486,"_28017":66381,"_19412":113310,"_5":13306,"_25509":113048,"_2665":113311},[],"**Result**: indicador del resultado de la validación.",{"_3170":66487,"_28017":66381,"_19412":113313,"_5":13306,"_25509":113051,"_2665":113314},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3170":66488,"_28017":66381,"_19412":113316,"_5":13306,"_25509":113051,"_2665":113317},[],"Este flujo es útil para:",{"_3170":66489,"_28017":66381,"_19412":113319,"_5":13306,"_25509":113051,"_2665":113320},[],"Solicitar certificados a una CA externa.",{"_3170":66490,"_28017":66381,"_19412":113322,"_5":13306,"_25509":113051,"_2665":113323},[],"Renovar una identidad manteniendo la misma clave.",{"_3170":66491,"_28017":66381,"_19412":113325,"_5":13306,"_25509":113051,"_2665":113326},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3170":66492,"_28017":66381,"_19412":113328,"_5":13306,"_25509":113051,"_2665":113329},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3170":66493,"_28017":66381,"_19412":113331,"_5":13306,"_25509":113051,"_2665":113332},[],"**Organization (O)**: organización o empresa.",{"_3170":66494,"_28017":66381,"_19412":113334,"_5":13306,"_25509":113051,"_2665":113335},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3170":66495,"_28017":66381,"_19412":113337,"_5":13306,"_25509":113051,"_2665":113338},[],"**Country (C)**: código de país de dos letras.",{"_3170":66496,"_28017":66381,"_19412":113340,"_5":13306,"_25509":113051,"_2665":113341},[],"**State / Province (ST)**: estado o provincia.",{"_3170":66497,"_28017":66381,"_19412":113343,"_5":13306,"_25509":113051,"_2665":113344},[],"**Locality (L)**: ciudad o localidad.",{"_3170":66498,"_28017":66381,"_19412":113346,"_5":13306,"_25509":113051,"_2665":113347},[],"**Email Address**: correo de contacto.",{"_3170":66499,"_28017":66381,"_19412":113349,"_5":13306,"_25509":113051,"_2665":113350},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3170":66500,"_28017":66381,"_19412":113352,"_5":13306,"_25509":113051,"_2665":113353},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3170":66501,"_28017":66381,"_19412":113355,"_5":13306,"_25509":113055,"_2665":113356},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3170":66502,"_28017":66381,"_19412":113358,"_5":13306,"_25509":113055,"_2665":52237},[],{"_3170":66503,"_28017":66381,"_19412":113360,"_5":13306,"_25509":113059,"_2665":113361},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3170":66504,"_28017":66504,"_5":13637,"_2665":113363,"_28360":113364,"_19412":113365,"_25509":66504},"Validación online con OCSP",[45425,108067,50551,112309],[],{"_3170":66505,"_28017":66504,"_19412":113367,"_5":13306,"_25509":66504,"_2665":113368},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3170":66506,"_28017":66504,"_5":28357,"_19412":113370,"_25509":113371,"_2665":113372},[],"/docs/pr-preview/pr-54/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3170":66507,"_28017":66504,"_5":28357,"_19412":113374,"_25509":113375,"_2665":113376},[],"/docs/pr-preview/pr-54/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3170":66508,"_28017":66504,"_5":28357,"_19412":113378,"_25509":113379,"_2665":113380},[],"/docs/pr-preview/pr-54/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3170":66509,"_28017":66504,"_5":28357,"_19412":113382,"_25509":113383,"_2665":113384},[],"/docs/pr-preview/pr-54/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3170":66510,"_28017":66504,"_5":28357,"_19412":113386,"_25509":113387,"_2665":113388},[],"/docs/pr-preview/pr-54/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3170":66511,"_28017":66504,"_5":28357,"_19412":113390,"_25509":113391,"_2665":112854},[],"/docs/pr-preview/pr-54/es/platform/pki/ocsp#referencias",{"_3170":66512,"_28017":66504,"_19412":113393,"_5":13306,"_25509":66504,"_2665":113394},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3170":66513,"_28017":66504,"_19412":113396,"_5":13306,"_25509":113371,"_2665":113397},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3170":66514,"_28017":66504,"_19412":113399,"_5":13306,"_25509":113371,"_2665":113400},[],"Estado del registro",{"_3170":66515,"_28017":66504,"_19412":113402,"_5":13306,"_25509":113371,"_2665":113403},[],"Respuesta firmada",{"_3170":66516,"_28017":66504,"_19412":113405,"_5":13306,"_25509":113371,"_2665":49729},[],{"_3170":66517,"_28017":66504,"_19412":113407,"_5":13306,"_25509":113371,"_2665":52287},[],{"_3170":66518,"_28017":66504,"_19412":113409,"_5":13306,"_25509":113371,"_2665":49746},[],{"_3170":66519,"_28017":66504,"_19412":113411,"_5":13306,"_25509":113371,"_2665":113412},[],"`Revoked`, con razón y fecha de revocación.",{"_3170":66520,"_28017":66504,"_19412":113414,"_5":13306,"_25509":113371,"_2665":113415},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3170":66521,"_28017":66504,"_19412":113417,"_5":13306,"_25509":113371,"_2665":113418},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3170":66522,"_28017":66504,"_19412":113420,"_5":13306,"_25509":113371,"_2665":113421},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3170":66523,"_28017":66504,"_19412":113423,"_5":13306,"_25509":113371,"_2665":113424},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3170":66524,"_28017":66504,"_19412":113426,"_5":13306,"_25509":113371,"_2665":113427},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3170":66525,"_28017":66504,"_19412":113429,"_5":13306,"_25509":113375,"_2665":113430},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3170":66526,"_28017":66504,"_19412":113432,"_5":13306,"_25509":113375,"_2665":113433},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3170":66527,"_28017":66504,"_19412":113435,"_5":13306,"_25509":113379,"_2665":113436},[],"El servicio acepta:",{"_3170":66528,"_28017":66504,"_19412":113438,"_5":13306,"_25509":113379,"_2665":109791},[],{"_3170":66529,"_28017":66504,"_19412":113440,"_5":13306,"_25509":113379,"_2665":113441},[],"Ruta del servicio VA",{"_3170":66530,"_28017":66504,"_19412":113443,"_5":13306,"_25509":113379,"_2665":113444},[],"Formato",{"_3170":66531,"_28017":66504,"_19412":113446,"_5":13306,"_25509":113379,"_2665":52327},[],{"_3170":66532,"_28017":66504,"_19412":113448,"_5":13306,"_25509":113379,"_2665":52330},[],{"_3170":66533,"_28017":66504,"_19412":113450,"_5":13306,"_25509":113379,"_2665":113451},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3170":66534,"_28017":66504,"_19412":113453,"_5":13306,"_25509":113379,"_2665":51813},[],{"_3170":66535,"_28017":66504,"_19412":113455,"_5":13306,"_25509":113379,"_2665":52338},[],{"_3170":66536,"_28017":66504,"_19412":113457,"_5":13306,"_25509":113379,"_2665":113458},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3170":66537,"_28017":66504,"_19412":113460,"_5":13306,"_25509":113379,"_2665":113461},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3170":66538,"_28017":66504,"_19412":113463,"_5":13306,"_25509":113383,"_2665":113464},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3170":66539,"_28017":66504,"_19412":113466,"_5":13306,"_25509":113383,"_2665":113467},[],"Genera la solicitud:",{"_3170":66540,"_28017":66504,"_19412":113469,"_5":13306,"_25509":113383,"_2665":113470},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3170":66541,"_28017":66504,"_19412":113472,"_5":13306,"_25509":113383,"_2665":113473},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3170":66542,"_28017":66504,"_19412":113475,"_5":13306,"_25509":113383,"_2665":113476},[],"Verifica el DER recibido:",{"_3170":66543,"_28017":66504,"_19412":113478,"_5":13306,"_25509":113383,"_2665":113479},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3170":66544,"_28017":66504,"_19412":113481,"_5":13306,"_25509":113387,"_2665":113482},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3170":66545,"_28017":66504,"_19412":113484,"_5":13306,"_25509":113387,"_2665":113485},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3170":66546,"_28017":66504,"_19412":113487,"_5":13306,"_25509":113391,"_2665":52371},[],{"_3170":66547,"_28017":66504,"_19412":113489,"_5":13306,"_25509":113391,"_2665":52374},[],{"_3170":66548,"_28017":66504,"_19412":113491,"_5":13306,"_25509":113391,"_2665":113492},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3170":66549,"_28017":66504,"_19412":113494,"_5":13306,"_25509":113391,"_2665":112981},[],{"_3170":66550,"_28017":66550,"_5":13637,"_2665":50551,"_28360":113496,"_19412":113497,"_25509":66550},[45425,108067,50551],[],{"_3170":66551,"_28017":66550,"_19412":113499,"_5":13306,"_25509":66550,"_2665":113500},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3170":66552,"_28017":66550,"_5":28357,"_19412":113502,"_25509":113503,"_2665":111018},[],"/docs/pr-preview/pr-54/es/platform/pki/overview#empieza-aquí",{"_3170":66553,"_28017":66550,"_5":28357,"_19412":113505,"_25509":113506,"_2665":113507},[],"/docs/pr-preview/pr-54/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3170":66554,"_28017":66550,"_5":28357,"_19412":113509,"_25509":113510,"_2665":111540},[],"/docs/pr-preview/pr-54/es/platform/pki/overview#capacidades-principales",{"_3170":66555,"_28017":66550,"_5":28357,"_19412":113512,"_25509":113513,"_2665":111544},[],"/docs/pr-preview/pr-54/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3170":66556,"_28017":66550,"_5":28357,"_19412":113515,"_25509":113516,"_2665":111548},[],"/docs/pr-preview/pr-54/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3170":66557,"_28017":66550,"_5":28357,"_19412":113518,"_25509":113519,"_2665":111552},[],"/docs/pr-preview/pr-54/es/platform/pki/overview#emite-y-controla-certificados",{"_3170":66558,"_28017":66550,"_5":28357,"_19412":113521,"_25509":113522,"_2665":111560},[],"/docs/pr-preview/pr-54/es/platform/pki/overview#publica-el-estado-de-validación",{"_3170":66559,"_28017":66550,"_5":28357,"_19412":113524,"_25509":113525,"_2665":113526},[],"/docs/pr-preview/pr-54/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3170":66560,"_28017":66550,"_5":28357,"_19412":113528,"_25509":113529,"_2665":112475},[],"/docs/pr-preview/pr-54/es/platform/pki/overview#continúa",{"_3170":66561,"_28017":66550,"_19412":113531,"_5":13306,"_25509":66550,"_2665":113532},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3170":66562,"_28017":66550,"_19412":113534,"_5":13306,"_25509":113503,"_2665":113535},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3170":66563,"_28017":66550,"_19412":113537,"_5":13306,"_25509":113503,"_2665":113538},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3170":66564,"_28017":66550,"_19412":113540,"_5":13306,"_25509":113506,"_2665":113541},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3170":66565,"_28017":66550,"_19412":113543,"_5":13306,"_25509":113506,"_2665":113544},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3170":66566,"_28017":66550,"_19412":113546,"_5":13306,"_25509":113506,"_2665":113547},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3170":66567,"_28017":66550,"_19412":113549,"_5":13306,"_25509":113506,"_2665":113550},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3170":66568,"_28017":66550,"_19412":113552,"_5":13306,"_25509":113506,"_2665":113553},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3170":66569,"_28017":66550,"_19412":113555,"_5":13306,"_25509":113513,"_2665":113556},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3170":66570,"_28017":66550,"_19412":113558,"_5":13306,"_25509":113516,"_2665":113559},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3170":66571,"_28017":66550,"_19412":113561,"_5":13306,"_25509":113519,"_2665":113562},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3170":66572,"_28017":66550,"_19412":113564,"_5":13306,"_25509":113522,"_2665":113565},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3170":66573,"_28017":66550,"_19412":113567,"_5":13306,"_25509":113525,"_2665":113568},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3170":66574,"_28017":66550,"_19412":113570,"_5":13306,"_25509":113525,"_2665":113571},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3170":66575,"_28017":66550,"_19412":113573,"_5":13306,"_25509":113525,"_2665":113574},[],"su clave pública corresponda a la clave privada del cliente;",{"_3170":66576,"_28017":66550,"_19412":113576,"_5":13306,"_25509":113525,"_2665":113577},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3170":66577,"_28017":66550,"_19412":113579,"_5":13306,"_25509":113525,"_2665":113580},[],"sus fechas y usos permitan la operación;",{"_3170":66578,"_28017":66550,"_19412":113582,"_5":13306,"_25509":113525,"_2665":113583},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3170":66579,"_28017":66550,"_19412":113585,"_5":13306,"_25509":113525,"_2665":113586},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3170":66580,"_28017":66550,"_19412":113588,"_5":13306,"_25509":113529,"_2665":113589},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3170":66581,"_28017":66550,"_19412":113591,"_5":13306,"_25509":113529,"_2665":113592},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3170":66582,"_28017":66550,"_19412":113594,"_5":13306,"_25509":113529,"_2665":113595},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3170":66583,"_28017":66583,"_5":13637,"_2665":113597,"_28360":113598,"_19412":113599,"_25509":66583},"Crea tu primera CA",[45425,108067,50551,111142],[],{"_3170":66584,"_28017":66583,"_19412":113601,"_5":13306,"_25509":66583,"_2665":113602},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3170":66585,"_28017":66583,"_5":28357,"_19412":113604,"_25509":113605,"_2665":106720},[],"/docs/pr-preview/pr-54/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3170":66586,"_28017":66583,"_5":28357,"_19412":113607,"_25509":113608,"_2665":113609},[],"/docs/pr-preview/pr-54/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación","Abre el asistente de creación",{"_3170":66587,"_28017":66583,"_5":28357,"_19412":113611,"_25509":113612,"_2665":113613},[],"/docs/pr-preview/pr-54/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave","Selecciona la clave",{"_3170":66588,"_28017":66583,"_5":28357,"_19412":113615,"_25509":113616,"_2665":113617},[],"/docs/pr-preview/pr-54/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad","Define la autoridad",{"_3170":66589,"_28017":66583,"_5":28357,"_19412":113619,"_25509":113620,"_2665":113621},[],"/docs/pr-preview/pr-54/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca","Revisa y crea la CA",{"_3170":66590,"_28017":66583,"_5":28357,"_19412":113623,"_25509":113624,"_2665":113625},[],"/docs/pr-preview/pr-54/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado","Verifica el resultado",{"_3170":66591,"_28017":66583,"_5":28357,"_19412":113627,"_25509":113628,"_2665":113629},[],"/docs/pr-preview/pr-54/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3170":66592,"_28017":66583,"_5":28357,"_19412":113631,"_25509":113632,"_2665":111390},[],"/docs/pr-preview/pr-54/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3170":66593,"_28017":66583,"_5":28357,"_19412":113634,"_25509":113635,"_2665":106744},[],"/docs/pr-preview/pr-54/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3170":66594,"_28017":66583,"_19412":113637,"_5":13306,"_25509":66583,"_2665":113638},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3170":66595,"_28017":66583,"_19412":113640,"_5":13306,"_25509":113605,"_2665":113641},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3170":66596,"_28017":66583,"_19412":113643,"_5":13306,"_25509":113605,"_2665":113644},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3170":66597,"_28017":66583,"_19412":113646,"_5":13306,"_25509":113605,"_2665":113647},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3170":66598,"_28017":66583,"_19412":113649,"_5":13306,"_25509":113605,"_2665":113650},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3170":66599,"_28017":66583,"_19412":113652,"_5":13306,"_25509":113608,"_2665":113653},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_3170":66600,"_28017":66583,"_19412":113655,"_5":13306,"_25509":113608,"_2665":113656},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_3170":66601,"_28017":66583,"_19412":113658,"_5":13306,"_25509":113612,"_2665":113659},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_3170":66602,"_28017":66583,"_19412":113661,"_5":13306,"_25509":113612,"_2665":113662},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_3170":66603,"_28017":66583,"_19412":113664,"_5":13306,"_25509":113616,"_2665":113665},[],"Selecciona **Root CA** y completa:",{"_3170":66604,"_28017":66583,"_19412":113667,"_5":13306,"_25509":113616,"_2665":52553},[],{"_3170":66605,"_28017":66583,"_19412":113669,"_5":13306,"_25509":113616,"_2665":113670},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_3170":66606,"_28017":66583,"_19412":113672,"_5":13306,"_25509":113616,"_2665":113673},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_3170":66607,"_28017":66583,"_19412":113675,"_5":13306,"_25509":113616,"_2665":113676},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_3170":66608,"_28017":66583,"_19412":113678,"_5":13306,"_25509":113616,"_2665":113679},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_3170":66609,"_28017":66583,"_19412":113681,"_5":13306,"_25509":113620,"_2665":113682},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_3170":66610,"_28017":66583,"_19412":113684,"_5":13306,"_25509":113624,"_2665":113685},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_3170":66611,"_28017":66583,"_19412":113687,"_5":13306,"_25509":113624,"_2665":113688},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_3170":66612,"_28017":66583,"_19412":113690,"_5":13306,"_25509":113628,"_2665":113691},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3170":66613,"_28017":66583,"_19412":113693,"_5":13306,"_25509":113628,"_2665":113694},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3170":66614,"_28017":66583,"_19412":113696,"_5":13306,"_25509":113628,"_2665":113697},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3170":66615,"_28017":66583,"_19412":113699,"_5":13306,"_25509":113632,"_2665":113700},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3170":66616,"_28017":66583,"_19412":113702,"_5":13306,"_25509":113632,"_2665":113703},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3170":66617,"_28017":66583,"_19412":113705,"_5":13306,"_25509":113632,"_2665":113706},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3170":66618,"_28017":66583,"_19412":113708,"_5":13306,"_25509":113632,"_2665":113709},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3170":66619,"_28017":66583,"_19412":113711,"_5":13306,"_25509":113635,"_2665":113712},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3170":66620,"_28017":66620,"_5":13637,"_2665":113714,"_28360":113715,"_19412":113716,"_25509":66620},"Emite y verifica un certificado",[45425,108067,50551,111142],[],{"_3170":66621,"_28017":66620,"_19412":113718,"_5":13306,"_25509":66620,"_2665":113719},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3170":66622,"_28017":66620,"_5":28357,"_19412":113721,"_25509":113722,"_2665":106720},[],"/docs/pr-preview/pr-54/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3170":66623,"_28017":66620,"_5":28357,"_19412":113724,"_25509":113725,"_2665":113726},[],"/docs/pr-preview/pr-54/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3170":66624,"_28017":66620,"_5":28357,"_19412":113728,"_25509":113729,"_2665":113730},[],"/docs/pr-preview/pr-54/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3170":66625,"_28017":66620,"_5":28357,"_19412":113732,"_25509":113733,"_2665":113734},[],"/docs/pr-preview/pr-54/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3170":66626,"_28017":66620,"_5":28357,"_19412":113736,"_25509":113737,"_2665":113738},[],"/docs/pr-preview/pr-54/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3170":66627,"_28017":66620,"_5":28357,"_19412":113740,"_25509":113741,"_2665":113742},[],"/docs/pr-preview/pr-54/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3170":66628,"_28017":66620,"_5":28357,"_19412":113744,"_25509":113745,"_2665":113625},[],"/docs/pr-preview/pr-54/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado",{"_3170":66629,"_28017":66620,"_5":28357,"_19412":113747,"_25509":113748,"_2665":113749},[],"/docs/pr-preview/pr-54/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3170":66630,"_28017":66620,"_5":28357,"_19412":113751,"_25509":113752,"_2665":113753},[],"/docs/pr-preview/pr-54/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3170":66631,"_28017":66620,"_5":28357,"_19412":113755,"_25509":113756,"_2665":113757},[],"/docs/pr-preview/pr-54/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3170":66632,"_28017":66620,"_5":28357,"_19412":113759,"_25509":113760,"_2665":111390},[],"/docs/pr-preview/pr-54/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3170":66633,"_28017":66620,"_5":28357,"_19412":113762,"_25509":113763,"_2665":106744},[],"/docs/pr-preview/pr-54/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3170":66634,"_28017":66620,"_19412":113765,"_5":13306,"_25509":66620,"_2665":113766},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3170":66635,"_28017":66620,"_19412":113768,"_5":13306,"_25509":113722,"_2665":113769},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3170":66636,"_28017":66620,"_19412":113771,"_5":13306,"_25509":113722,"_2665":113772},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3170":66637,"_28017":66620,"_19412":113774,"_5":13306,"_25509":113722,"_2665":113775},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3170":66638,"_28017":66620,"_19412":113777,"_5":13306,"_25509":113722,"_2665":113778},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3170":66639,"_28017":66620,"_19412":113780,"_5":13306,"_25509":113722,"_2665":113781},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3170":66640,"_28017":66620,"_19412":113783,"_5":13306,"_25509":113725,"_2665":113784},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3170":66641,"_28017":66620,"_19412":113786,"_5":13306,"_25509":113729,"_2665":113787},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3170":66642,"_28017":66620,"_19412":113789,"_5":13306,"_25509":113729,"_2665":113790},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3170":66643,"_28017":66620,"_19412":113792,"_5":13306,"_25509":113733,"_2665":113793},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3170":66644,"_28017":66620,"_19412":113795,"_5":13306,"_25509":113733,"_2665":113796},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3170":66645,"_28017":66620,"_19412":113798,"_5":13306,"_25509":113737,"_2665":113799},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3170":66646,"_28017":66620,"_19412":113801,"_5":13306,"_25509":113737,"_2665":113802},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3170":66647,"_28017":66620,"_19412":113804,"_5":13306,"_25509":113741,"_2665":113805},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3170":66648,"_28017":66620,"_19412":113807,"_5":13306,"_25509":113745,"_2665":113808},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3170":66649,"_28017":66620,"_19412":113810,"_5":13306,"_25509":113748,"_2665":113811},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3170":66650,"_28017":66620,"_19412":113813,"_5":13306,"_25509":113752,"_2665":113814},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3170":66651,"_28017":66620,"_19412":113816,"_5":13306,"_25509":113752,"_2665":113817},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3170":66652,"_28017":66620,"_19412":113819,"_5":13306,"_25509":113752,"_2665":113820},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3170":66653,"_28017":66620,"_19412":113822,"_5":13306,"_25509":113756,"_2665":113823},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3170":66654,"_28017":66620,"_19412":113825,"_5":13306,"_25509":113756,"_2665":113826},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3170":66655,"_28017":66620,"_19412":113828,"_5":13306,"_25509":113756,"_2665":113829},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3170":66656,"_28017":66620,"_19412":113831,"_5":13306,"_25509":113760,"_2665":111473},[],{"_3170":66657,"_28017":66620,"_19412":113833,"_5":13306,"_25509":113760,"_2665":110240},[],{"_3170":66658,"_28017":66620,"_19412":113835,"_5":13306,"_25509":113760,"_2665":113836},[],"La CA rechaza la emisión",{"_3170":66659,"_28017":66620,"_19412":113838,"_5":13306,"_25509":113760,"_2665":113839},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3170":66660,"_28017":66620,"_19412":113841,"_5":13306,"_25509":113760,"_2665":113842},[],"Sujeto o usos diferentes",{"_3170":66661,"_28017":66620,"_19412":113844,"_5":13306,"_25509":113760,"_2665":113845},[],"Perfil aplicado y valores solicitados.",{"_3170":66662,"_28017":66620,"_19412":113847,"_5":13306,"_25509":113760,"_2665":113848},[],"No se encuentra el emisor",{"_3170":66663,"_28017":66620,"_19412":113850,"_5":13306,"_25509":113760,"_2665":113851},[],"CA descargada y cadena intermedia necesaria.",{"_3170":66664,"_28017":66620,"_19412":113853,"_5":13306,"_25509":113760,"_2665":113854},[],"Falla la vigencia",{"_3170":66665,"_28017":66620,"_19412":113856,"_5":13306,"_25509":113760,"_2665":113857},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3170":66666,"_28017":66620,"_19412":113859,"_5":13306,"_25509":113760,"_2665":113860},[],"Los resúmenes de clave difieren",{"_3170":66667,"_28017":66620,"_19412":113862,"_5":13306,"_25509":113760,"_2665":113863},[],"Archivos de certificado y clave de la misma emisión.",{"_3170":66668,"_28017":66620,"_19412":113865,"_5":13306,"_25509":113760,"_2665":113866},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3170":66669,"_28017":66620,"_19412":113868,"_5":13306,"_25509":113763,"_2665":113869},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3170":66670,"_28017":66620,"_19412":113871,"_5":13306,"_25509":113763,"_2665":113872},[],"Gestionar certificados para inspección, estado y revocación.",{"_3170":66671,"_28017":66620,"_19412":113874,"_5":13306,"_25509":113763,"_2665":113875},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3170":66672,"_28017":66620,"_19412":113877,"_5":13306,"_25509":113763,"_2665":113878},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3170":66673,"_28017":66620,"_19412":113880,"_5":13306,"_25509":113763,"_2665":113881},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3170":66674,"_28017":66674,"_5":13637,"_2665":113883,"_28360":113884,"_19412":113885,"_25509":66674},"Primeros pasos de PKI",[45425,108067,50551,111142],[],{"_3170":66675,"_28017":66674,"_19412":113887,"_5":13306,"_25509":66674,"_2665":113888},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3170":66676,"_28017":66674,"_5":28357,"_19412":113890,"_25509":113891,"_2665":106720},[],"/docs/pr-preview/pr-54/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3170":66677,"_28017":66674,"_5":28357,"_19412":113893,"_25509":113894,"_2665":113895},[],"/docs/pr-preview/pr-54/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3170":66678,"_28017":66674,"_5":28357,"_19412":113897,"_25509":113898,"_2665":111324},[],"/docs/pr-preview/pr-54/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3170":66679,"_28017":66674,"_5":28357,"_19412":113900,"_25509":113901,"_2665":113902},[],"/docs/pr-preview/pr-54/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3170":66680,"_28017":66674,"_19412":113904,"_5":13306,"_25509":66674,"_2665":113905},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3170":66681,"_28017":66674,"_19412":113907,"_5":13306,"_25509":113891,"_2665":113908},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3170":66682,"_28017":66674,"_19412":113910,"_5":13306,"_25509":113891,"_2665":113911},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3170":66683,"_28017":66674,"_19412":113913,"_5":13306,"_25509":113891,"_2665":113914},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3170":66684,"_28017":66674,"_19412":113916,"_5":13306,"_25509":113891,"_2665":113917},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3170":66685,"_28017":66674,"_19412":113919,"_5":13306,"_25509":113891,"_2665":113920},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3170":66686,"_28017":66674,"_19412":113922,"_5":13306,"_25509":113894,"_2665":113923},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3170":66687,"_28017":66674,"_19412":113925,"_5":13306,"_25509":113894,"_2665":113926},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3170":66688,"_28017":66674,"_19412":113928,"_5":13306,"_25509":113894,"_2665":113929},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3170":66689,"_28017":66674,"_19412":113931,"_5":13306,"_25509":113894,"_2665":113932},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3170":66690,"_28017":66674,"_19412":113934,"_5":13306,"_25509":113898,"_2665":113935},[],"Archivo o recurso",{"_3170":66691,"_28017":66674,"_19412":113937,"_5":13306,"_25509":113898,"_2665":111321},[],{"_3170":66692,"_28017":66674,"_19412":113939,"_5":13306,"_25509":113898,"_2665":113940},[],"CA raíz activa y `ca.pem`",{"_3170":66693,"_28017":66674,"_19412":113942,"_5":13306,"_25509":113898,"_2665":113943},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3170":66694,"_28017":66674,"_19412":113945,"_5":13306,"_25509":113898,"_2665":113946},[],"Certificado final y `device.crt`",{"_3170":66695,"_28017":66674,"_19412":113948,"_5":13306,"_25509":113898,"_2665":113949},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3170":66696,"_28017":66674,"_19412":113951,"_5":13306,"_25509":113898,"_2665":113952},[],"Clave privada `device.key`",{"_3170":66697,"_28017":66674,"_19412":113954,"_5":13306,"_25509":113898,"_2665":113955},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3170":66698,"_28017":66674,"_19412":113957,"_5":13306,"_25509":113898,"_2665":113958},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3170":66699,"_28017":66674,"_19412":113960,"_5":13306,"_25509":113901,"_2665":113961},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3170":66700,"_28017":66674,"_19412":113963,"_5":13306,"_25509":113901,"_2665":113964},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3170":66701,"_28017":66674,"_19412":113966,"_5":13306,"_25509":113901,"_2665":113967},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3170":66702,"_28017":66702,"_5":13637,"_2665":113969,"_28360":113970,"_19412":113972,"_25509":66702},"Resolución de problemas PKI",[45425,108067,50551,113971],"Resolución de problemas",[],{"_3170":66703,"_28017":66702,"_19412":113974,"_5":13306,"_25509":66702,"_2665":113975},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3170":66704,"_28017":66702,"_5":28357,"_19412":113977,"_25509":113978,"_2665":113979},[],"/docs/pr-preview/pr-54/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3170":66705,"_28017":66702,"_5":28357,"_19412":113981,"_25509":113982,"_2665":113983},[],"/docs/pr-preview/pr-54/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3170":66706,"_28017":66702,"_5":28357,"_19412":113985,"_25509":113986,"_2665":113987},[],"/docs/pr-preview/pr-54/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3170":66707,"_28017":66702,"_19412":113989,"_5":13306,"_25509":66702,"_2665":113990},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3170":66708,"_28017":66702,"_19412":113992,"_5":13306,"_25509":66702,"_2665":113993},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3170":66709,"_28017":66702,"_19412":113995,"_5":13306,"_25509":113978,"_2665":111321},[],{"_3170":66710,"_28017":66702,"_19412":113997,"_5":13306,"_25509":113978,"_2665":110240},[],{"_3170":66711,"_28017":66702,"_19412":113999,"_5":13306,"_25509":113978,"_2665":106744},[],{"_3170":66712,"_28017":66702,"_19412":114001,"_5":13306,"_25509":113978,"_2665":52889},[],{"_3170":66713,"_28017":66702,"_19412":114003,"_5":13306,"_25509":113978,"_2665":114004},[],"Existe, está activa y sus fechas son utilizables.",{"_3170":66714,"_28017":66702,"_19412":114006,"_5":13306,"_25509":113978,"_2665":114007},[],"Autoridades.",{"_3170":66715,"_28017":66702,"_19412":114009,"_5":13306,"_25509":113978,"_2665":114010},[],"Clave",{"_3170":66716,"_28017":66702,"_19412":114012,"_5":13306,"_25509":113978,"_2665":114013},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3170":66717,"_28017":66702,"_19412":114015,"_5":13306,"_25509":113978,"_2665":114016},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3170":66718,"_28017":66702,"_19412":114018,"_5":13306,"_25509":113978,"_2665":52907},[],{"_3170":66719,"_28017":66702,"_19412":114020,"_5":13306,"_25509":113978,"_2665":114021},[],"PEM correcto y firma verificable.",{"_3170":66720,"_28017":66702,"_19412":114023,"_5":13306,"_25509":113978,"_2665":52913},[],{"_3170":66721,"_28017":66702,"_19412":114025,"_5":13306,"_25509":113978,"_2665":114026},[],"Perfil",{"_3170":66722,"_28017":66702,"_19412":114028,"_5":13306,"_25509":113978,"_2665":114029},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3170":66723,"_28017":66702,"_19412":114031,"_5":13306,"_25509":113978,"_2665":114032},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3170":66724,"_28017":66702,"_19412":114034,"_5":13306,"_25509":113978,"_2665":111473},[],{"_3170":66725,"_28017":66702,"_19412":114036,"_5":13306,"_25509":113978,"_2665":114037},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3170":66726,"_28017":66702,"_19412":114039,"_5":13306,"_25509":113978,"_2665":114040},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3170":66727,"_28017":66702,"_19412":114042,"_5":13306,"_25509":113978,"_2665":114043},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3170":66728,"_28017":66702,"_19412":114045,"_5":13306,"_25509":113978,"_2665":114046},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3170":66729,"_28017":66702,"_19412":114048,"_5":13306,"_25509":113982,"_2665":114049},[],"Revisa cada frontera por separado:",{"_3170":66730,"_28017":66702,"_19412":114051,"_5":13306,"_25509":113982,"_2665":114052},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3170":66731,"_28017":66702,"_19412":114054,"_5":13306,"_25509":113982,"_2665":114055},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3170":66732,"_28017":66702,"_19412":114057,"_5":13306,"_25509":113982,"_2665":114058},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3170":66733,"_28017":66702,"_19412":114060,"_5":13306,"_25509":113982,"_2665":114061},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3170":66734,"_28017":66702,"_19412":114063,"_5":13306,"_25509":113982,"_2665":114064},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3170":66735,"_28017":66702,"_19412":114066,"_5":13306,"_25509":113982,"_2665":114067},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_3170":66736,"_28017":66702,"_19412":114069,"_5":13306,"_25509":113986,"_2665":114070},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3170":66737,"_28017":66702,"_19412":114072,"_5":13306,"_25509":113986,"_2665":114073},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3170":66738,"_28017":66738,"_5":13637,"_2665":114075,"_28360":114076,"_19412":114078,"_25509":66738},"3.8.0 a 4.0.0",[45425,114077],"Actualizaciones",[],{"_3170":66739,"_28017":66738,"_19412":114080,"_5":13306,"_25509":66738,"_2665":114081},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3170":66740,"_28017":66738,"_5":28357,"_19412":114083,"_25509":114084,"_2665":114085},[],"/docs/pr-preview/pr-54/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_3170":66741,"_28017":66738,"_5":28357,"_19412":114087,"_25509":114088,"_2665":114089},[],"/docs/pr-preview/pr-54/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3170":66742,"_28017":66738,"_5":28357,"_19412":114091,"_25509":114092,"_2665":114093},[],"/docs/pr-preview/pr-54/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3170":66743,"_28017":66738,"_5":28357,"_19412":114095,"_25509":114096,"_2665":114097},[],"/docs/pr-preview/pr-54/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3170":66744,"_28017":66738,"_5":28357,"_19412":114099,"_25509":114100,"_2665":114101},[],"/docs/pr-preview/pr-54/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3170":66745,"_28017":66738,"_5":28357,"_19412":114103,"_25509":114104,"_2665":114105},[],"/docs/pr-preview/pr-54/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3170":66746,"_28017":66738,"_5":28357,"_19412":114107,"_25509":114108,"_2665":52999},[],"/docs/pr-preview/pr-54/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3170":66747,"_28017":66738,"_5":28357,"_19412":114110,"_25509":114111,"_2665":114112},[],"/docs/pr-preview/pr-54/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_3170":66748,"_28017":66738,"_5":28357,"_19412":114114,"_25509":114115,"_2665":114116},[],"/docs/pr-preview/pr-54/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3170":66749,"_28017":66738,"_5":28357,"_19412":114118,"_25509":114119,"_2665":114120},[],"/docs/pr-preview/pr-54/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3170":66750,"_28017":66738,"_5":28357,"_19412":114122,"_25509":114123,"_2665":114124},[],"/docs/pr-preview/pr-54/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3170":66751,"_28017":66738,"_5":28357,"_19412":114126,"_25509":114127,"_2665":114128},[],"/docs/pr-preview/pr-54/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3170":66752,"_28017":66738,"_5":28357,"_19412":114130,"_25509":114131,"_2665":114132},[],"/docs/pr-preview/pr-54/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3170":66753,"_28017":66738,"_5":28357,"_19412":114134,"_25509":114135,"_2665":114136},[],"/docs/pr-preview/pr-54/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3170":66754,"_28017":66738,"_5":28357,"_19412":114138,"_25509":114139,"_2665":114140},[],"/docs/pr-preview/pr-54/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3170":66755,"_28017":66738,"_5":28357,"_19412":114142,"_25509":114143,"_2665":114144},[],"/docs/pr-preview/pr-54/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_3170":66756,"_28017":66738,"_5":28357,"_19412":114146,"_25509":114147,"_2665":114148},[],"/docs/pr-preview/pr-54/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3170":66757,"_28017":66738,"_5":28357,"_19412":114150,"_25509":114151,"_2665":114152},[],"/docs/pr-preview/pr-54/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3170":66758,"_28017":66738,"_5":28357,"_19412":114154,"_25509":114155,"_2665":114156},[],"/docs/pr-preview/pr-54/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3170":66759,"_28017":66738,"_5":28357,"_19412":114158,"_25509":114159,"_2665":114160},[],"/docs/pr-preview/pr-54/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_3170":66760,"_28017":66738,"_5":28357,"_19412":114162,"_25509":114163,"_2665":114164},[],"/docs/pr-preview/pr-54/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3170":66761,"_28017":66738,"_5":28357,"_19412":114166,"_25509":114167,"_2665":114168},[],"/docs/pr-preview/pr-54/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3170":66762,"_28017":66738,"_5":28357,"_19412":114170,"_25509":114171,"_2665":114172},[],"/docs/pr-preview/pr-54/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3170":66763,"_28017":66738,"_5":28357,"_19412":114174,"_25509":114175,"_2665":114176},[],"/docs/pr-preview/pr-54/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3170":66764,"_28017":66738,"_5":28357,"_19412":114178,"_25509":114179,"_2665":114180},[],"/docs/pr-preview/pr-54/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3170":66765,"_28017":66738,"_5":28357,"_19412":114182,"_25509":114183,"_2665":114184},[],"/docs/pr-preview/pr-54/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3170":66766,"_28017":66738,"_5":28357,"_19412":114186,"_25509":114187,"_2665":114188},[],"/docs/pr-preview/pr-54/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3170":66767,"_28017":66738,"_5":28357,"_19412":114190,"_25509":114191,"_2665":114192},[],"/docs/pr-preview/pr-54/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3170":66768,"_28017":66738,"_5":28357,"_19412":114194,"_25509":114195,"_2665":114196},[],"/docs/pr-preview/pr-54/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3170":66769,"_28017":66738,"_5":28357,"_19412":114198,"_25509":114199,"_2665":114200},[],"/docs/pr-preview/pr-54/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3170":66770,"_28017":66738,"_5":28357,"_19412":114202,"_25509":114203,"_2665":114204},[],"/docs/pr-preview/pr-54/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3170":66771,"_28017":66738,"_5":28357,"_19412":114206,"_25509":114207,"_2665":114208},[],"/docs/pr-preview/pr-54/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3170":66772,"_28017":66738,"_5":28357,"_19412":114210,"_25509":114211,"_2665":114212},[],"/docs/pr-preview/pr-54/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3170":66773,"_28017":66738,"_5":28357,"_19412":114214,"_25509":114215,"_2665":110562},[],"/docs/pr-preview/pr-54/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3170":66774,"_28017":66738,"_5":28357,"_19412":114217,"_25509":114218,"_2665":114219},[],"/docs/pr-preview/pr-54/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3170":66775,"_28017":66738,"_5":28357,"_19412":114221,"_25509":114222,"_2665":114223},[],"/docs/pr-preview/pr-54/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3170":66776,"_28017":66738,"_19412":114225,"_5":13306,"_25509":66738,"_2665":114226},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3170":66777,"_28017":66738,"_19412":114228,"_5":13306,"_25509":66738,"_2665":114229},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3170":66778,"_28017":66738,"_19412":114231,"_5":13306,"_25509":66738,"_2665":114232},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_3170":66779,"_28017":66738,"_19412":114234,"_5":13306,"_25509":66738,"_2665":114235},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_3170":66780,"_28017":66738,"_19412":114237,"_5":13306,"_25509":66738,"_2665":114238},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3170":66781,"_28017":66738,"_19412":114240,"_5":13306,"_25509":66738,"_2665":114241},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3170":66782,"_28017":66738,"_19412":114243,"_5":13306,"_25509":66738,"_2665":114244},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3170":66783,"_28017":66738,"_19412":114246,"_5":13306,"_25509":114088,"_2665":114247},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3170":66784,"_28017":66738,"_19412":114249,"_5":13306,"_25509":114088,"_2665":114250},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_3170":66785,"_28017":66738,"_19412":114252,"_5":13306,"_25509":114092,"_2665":114253},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3170":66786,"_28017":66738,"_19412":114255,"_5":13306,"_25509":114092,"_2665":114256},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y roles de la VA. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3170":66787,"_28017":66738,"_19412":114258,"_5":13306,"_25509":114096,"_2665":114259},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera.",{"_3170":66788,"_28017":66738,"_19412":114261,"_5":13306,"_25509":114100,"_2665":114262},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3170":66789,"_28017":66738,"_19412":114264,"_5":13306,"_25509":114100,"_2665":114265},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3170":66790,"_28017":66738,"_19412":114267,"_5":13306,"_25509":114100,"_2665":114268},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_3170":66791,"_28017":66738,"_19412":114270,"_5":13306,"_25509":114100,"_2665":114271},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3170":66792,"_28017":66738,"_19412":114273,"_5":13306,"_25509":114100,"_2665":114274},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3170":66793,"_28017":66738,"_19412":114276,"_5":13306,"_25509":114104,"_2665":114277},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3170":66794,"_28017":66738,"_19412":114279,"_5":13306,"_25509":114104,"_2665":114280},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3170":66795,"_28017":66738,"_19412":114282,"_5":13306,"_25509":114104,"_2665":114283},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3170":66796,"_28017":66738,"_19412":114285,"_5":13306,"_25509":114104,"_2665":114286},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3170":66797,"_28017":66738,"_19412":114288,"_5":13306,"_25509":114104,"_2665":114289},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3170":66798,"_28017":66738,"_19412":114291,"_5":13306,"_25509":114108,"_2665":114292},[],"Cambio",{"_3170":66799,"_28017":66738,"_19412":114294,"_5":13306,"_25509":114108,"_2665":114295},[],"A quién afecta",{"_3170":66800,"_28017":66738,"_19412":114297,"_5":13306,"_25509":114108,"_2665":114298},[],"Gravedad",{"_3170":66801,"_28017":66738,"_19412":114300,"_5":13306,"_25509":114108,"_2665":114301},[],"Acción",{"_3170":66802,"_28017":66738,"_19412":114303,"_5":13306,"_25509":114108,"_2665":114116},[],{"_3170":66803,"_28017":66738,"_19412":114305,"_5":13306,"_25509":114108,"_2665":114306},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_3170":66804,"_28017":66738,"_19412":114308,"_5":13306,"_25509":114108,"_2665":114309},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_3170":66805,"_28017":66738,"_19412":114311,"_5":13306,"_25509":114108,"_2665":114312},[],"Copiar los datos a los volúmenes nuevos",{"_3170":66806,"_28017":66738,"_19412":114314,"_5":13306,"_25509":114108,"_2665":114120},[],{"_3170":66807,"_28017":66738,"_19412":114316,"_5":13306,"_25509":114108,"_2665":114317},[],"Todas las releases de Helm",{"_3170":66808,"_28017":66738,"_19412":114319,"_5":13306,"_25509":114108,"_2665":114320},[],"Alta: `helm upgrade` falla",{"_3170":66809,"_28017":66738,"_19412":114322,"_5":13306,"_25509":114108,"_2665":114323},[],"Eliminar o renombrar las claves heredadas",{"_3170":66810,"_28017":66738,"_19412":114325,"_5":13306,"_25509":114108,"_2665":114124},[],{"_3170":66811,"_28017":66738,"_19412":114327,"_5":13306,"_25509":114108,"_2665":114328},[],"Todos los despliegues",{"_3170":66812,"_28017":66738,"_19412":114330,"_5":13306,"_25509":114108,"_2665":114331},[],"Alta: sin principal de bootstrap no hay administrador",{"_3170":66813,"_28017":66738,"_19412":114333,"_5":13306,"_25509":114108,"_2665":114334},[],"Configurar `services.authz`",{"_3170":66814,"_28017":66738,"_19412":114336,"_5":13306,"_25509":114108,"_2665":114128},[],{"_3170":66815,"_28017":66738,"_19412":114338,"_5":13306,"_25509":114108,"_2665":114317},[],{"_3170":66816,"_28017":66738,"_19412":114340,"_5":13306,"_25509":114108,"_2665":114341},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_3170":66817,"_28017":66738,"_19412":114343,"_5":13306,"_25509":114108,"_2665":114344},[],"Mover JWKS y roles a `services.authz`",{"_3170":66818,"_28017":66738,"_19412":114346,"_5":13306,"_25509":114108,"_2665":114148},[],{"_3170":66819,"_28017":66738,"_19412":114348,"_5":13306,"_25509":114108,"_2665":114349},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_3170":66820,"_28017":66738,"_19412":114351,"_5":13306,"_25509":114108,"_2665":114352},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_3170":66821,"_28017":66738,"_19412":114354,"_5":13306,"_25509":114108,"_2665":114355},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_3170":66822,"_28017":66738,"_19412":114357,"_5":13306,"_25509":114108,"_2665":114152},[],{"_3170":66823,"_28017":66738,"_19412":114359,"_5":13306,"_25509":114108,"_2665":114360},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_3170":66824,"_28017":66738,"_19412":114362,"_5":13306,"_25509":114108,"_2665":114363},[],"Alta: el backend ya no arranca con ellos",{"_3170":66825,"_28017":66738,"_19412":114365,"_5":13306,"_25509":114108,"_2665":114366},[],"Pasar a PostgreSQL antes de actualizar",{"_3170":66826,"_28017":66738,"_19412":114368,"_5":13306,"_25509":114108,"_2665":114369},[],"Webhooks con referencias a archivos",{"_3170":66827,"_28017":66738,"_19412":114371,"_5":13306,"_25509":114108,"_2665":114372},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3170":66828,"_28017":66738,"_19412":114374,"_5":13306,"_25509":114108,"_2665":114375},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_3170":66829,"_28017":66738,"_19412":114377,"_5":13306,"_25509":114108,"_2665":114378},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3170":66830,"_28017":66738,"_19412":114380,"_5":13306,"_25509":114108,"_2665":114132},[],{"_3170":66831,"_28017":66738,"_19412":114382,"_5":13306,"_25509":114108,"_2665":114383},[],"Releases con identidades por servicio o material de claves montado",{"_3170":66832,"_28017":66738,"_19412":114385,"_5":13306,"_25509":114108,"_2665":114386},[],"Media: los servicios no pueden leer sus archivos",{"_3170":66833,"_28017":66738,"_19412":114388,"_5":13306,"_25509":114108,"_2665":114389},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_3170":66834,"_28017":66738,"_19412":114391,"_5":13306,"_25509":114108,"_2665":114136},[],{"_3170":66835,"_28017":66738,"_19412":114393,"_5":13306,"_25509":114108,"_2665":114394},[],"Releases que definen `amqp.tls`",{"_3170":66836,"_28017":66738,"_19412":114396,"_5":13306,"_25509":114108,"_2665":114397},[],"Media: los clientes se conectan al puerto equivocado",{"_3170":66837,"_28017":66738,"_19412":114399,"_5":13306,"_25509":114108,"_2665":114400},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_3170":66838,"_28017":66738,"_19412":114402,"_5":13306,"_25509":114108,"_2665":114156},[],{"_3170":66839,"_28017":66738,"_19412":114404,"_5":13306,"_25509":114108,"_2665":114405},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3170":66840,"_28017":66738,"_19412":114407,"_5":13306,"_25509":114108,"_2665":114408},[],"Media: las claves de CA quedan sin gestionar",{"_3170":66841,"_28017":66738,"_19412":114410,"_5":13306,"_25509":114108,"_2665":114411},[],"Ejecutar la migración de CA a KMS",{"_3170":66842,"_28017":66738,"_19412":114413,"_5":13306,"_25509":114108,"_2665":114414},[],"Verificación del certificado del receptor",{"_3170":66843,"_28017":66738,"_19412":114416,"_5":13306,"_25509":114108,"_2665":114417},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_3170":66844,"_28017":66738,"_19412":114419,"_5":13306,"_25509":114108,"_2665":114420},[],"Media: las credenciales viajan a un receptor sin verificar",{"_3170":66845,"_28017":66738,"_19412":114422,"_5":13306,"_25509":114108,"_2665":114423},[],"Poner `insecure_skip_verify` a `false`",{"_3170":66846,"_28017":66738,"_19412":114425,"_5":13306,"_25509":114108,"_2665":114168},[],{"_3170":66847,"_28017":66738,"_19412":114427,"_5":13306,"_25509":114108,"_2665":114428},[],"Scripts y consolas que editan DMS por API",{"_3170":66848,"_28017":66738,"_19412":114430,"_5":13306,"_25509":114108,"_2665":114431},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3170":66849,"_28017":66738,"_19412":114433,"_5":13306,"_25509":114108,"_2665":114434},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3170":66850,"_28017":66738,"_19412":114436,"_5":13306,"_25509":114108,"_2665":114184},[],{"_3170":66851,"_28017":66738,"_19412":114438,"_5":13306,"_25509":114108,"_2665":114439},[],"Consumidores que leen el campo `events` del dispositivo",{"_3170":66852,"_28017":66738,"_19412":114441,"_5":13306,"_25509":114108,"_2665":114442},[],"Media: el campo desaparece",{"_3170":66853,"_28017":66738,"_19412":114444,"_5":13306,"_25509":114108,"_2665":114445},[],"Usar los nuevos endpoints de eventos",{"_3170":66854,"_28017":66738,"_19412":114447,"_5":13306,"_25509":114108,"_2665":114140},[],{"_3170":66855,"_28017":66738,"_19412":114449,"_5":13306,"_25509":114108,"_2665":114450},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_3170":66856,"_28017":66738,"_19412":114452,"_5":13306,"_25509":114108,"_2665":114453},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_3170":66857,"_28017":66738,"_19412":114455,"_5":13306,"_25509":114108,"_2665":114456},[],"Actualizar el archivo de values",{"_3170":66858,"_28017":66738,"_19412":114458,"_5":13306,"_25509":114108,"_2665":114176},[],{"_3170":66859,"_28017":66738,"_19412":114460,"_5":13306,"_25509":114108,"_2665":114461},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3170":66860,"_28017":66738,"_19412":114463,"_5":13306,"_25509":114108,"_2665":114464},[],"Baja: prevalece el ID de la URL",{"_3170":66861,"_28017":66738,"_19412":114466,"_5":13306,"_25509":114108,"_2665":114467},[],"Enviar el ID en la URL",{"_3170":66862,"_28017":66738,"_19412":114469,"_5":13306,"_25509":114108,"_2665":114180},[],{"_3170":66863,"_28017":66738,"_19412":114471,"_5":13306,"_25509":114108,"_2665":114472},[],"Consumidores que comparan el `type` del certificado",{"_3170":66864,"_28017":66738,"_19412":114474,"_5":13306,"_25509":114108,"_2665":114475},[],"Baja: dos valores cambian de nombre",{"_3170":66865,"_28017":66738,"_19412":114477,"_5":13306,"_25509":114108,"_2665":114478},[],"Adaptar los consumidores",{"_3170":66866,"_28017":66738,"_19412":114480,"_5":13306,"_25509":114108,"_2665":114172},[],{"_3170":66867,"_28017":66738,"_19412":114482,"_5":13306,"_25509":114108,"_2665":114483},[],"Cualquier DMS",{"_3170":66868,"_28017":66738,"_19412":114485,"_5":13306,"_25509":114108,"_2665":114486},[],"Baja: solo informativo",{"_3170":66869,"_28017":66738,"_19412":114488,"_5":13306,"_25509":114108,"_2665":114489},[],"Revisar ambos bloques antes de editar",{"_3170":66870,"_28017":66738,"_19412":114491,"_5":13306,"_25509":114115,"_2665":114492},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3170":66871,"_28017":66738,"_19412":114494,"_5":13306,"_25509":114115,"_2665":114495},[],"El paso 4 de la guía de migración copia los datos.",{"_3170":66872,"_28017":66738,"_19412":114497,"_5":13306,"_25509":114119,"_2665":114498},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3170":66873,"_28017":66738,"_19412":114500,"_5":13306,"_25509":114123,"_2665":114501},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3170":66874,"_28017":66738,"_19412":114503,"_5":13306,"_25509":114127,"_2665":114504},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3170":66875,"_28017":66738,"_19412":114506,"_5":13306,"_25509":114131,"_2665":114507},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3170":66876,"_28017":66738,"_19412":114509,"_5":13306,"_25509":114131,"_2665":114510},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3170":66877,"_28017":66738,"_19412":114512,"_5":13306,"_25509":114135,"_2665":114513},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3170":66878,"_28017":66738,"_19412":114515,"_5":13306,"_25509":114139,"_2665":114516},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3170":66879,"_28017":66738,"_19412":114518,"_5":13306,"_25509":114139,"_2665":114519},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3170":66880,"_28017":66738,"_19412":114521,"_5":13306,"_25509":114139,"_2665":114522},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3170":66881,"_28017":66738,"_19412":114524,"_5":13306,"_25509":114139,"_2665":114525},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3170":66882,"_28017":66738,"_19412":114527,"_5":13306,"_25509":114139,"_2665":114528},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3170":66883,"_28017":66738,"_19412":114530,"_5":13306,"_25509":114139,"_2665":114531},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3170":66884,"_28017":66738,"_19412":114533,"_5":13306,"_25509":114147,"_2665":114534},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3170":66885,"_28017":66738,"_19412":114536,"_5":13306,"_25509":114147,"_2665":114537},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3170":66886,"_28017":66738,"_19412":114539,"_5":13306,"_25509":114147,"_2665":114540},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3170":66887,"_28017":66738,"_19412":114542,"_5":13306,"_25509":114147,"_2665":114543},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3170":66888,"_28017":66738,"_19412":114545,"_5":13306,"_25509":114147,"_2665":114546},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_3170":66889,"_28017":66738,"_19412":114548,"_5":13306,"_25509":114151,"_2665":114549},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3170":66890,"_28017":66738,"_19412":114551,"_5":13306,"_25509":114155,"_2665":114552},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3170":66891,"_28017":66738,"_19412":114554,"_5":13306,"_25509":114155,"_2665":114555},[],"El `key_id` es el `subject_key_id` del certificado (SHA-256 de la clave pública).",{"_3170":66892,"_28017":66738,"_19412":114557,"_5":13306,"_25509":114155,"_2665":114558},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3170":66893,"_28017":66738,"_19412":114560,"_5":13306,"_25509":114155,"_2665":114561},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3170":66894,"_28017":66738,"_19412":114563,"_5":13306,"_25509":114155,"_2665":114564},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3170":66895,"_28017":66738,"_19412":114566,"_5":13306,"_25509":114155,"_2665":114567},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3170":66896,"_28017":66738,"_19412":114569,"_5":13306,"_25509":114163,"_2665":114570},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_3170":66897,"_28017":66738,"_19412":114572,"_5":13306,"_25509":114163,"_2665":114573},[],"Campo en 3.8.0",{"_3170":66898,"_28017":66738,"_19412":114575,"_5":13306,"_25509":114163,"_2665":114576},[],"Campo en 4.0.0",{"_3170":66899,"_28017":66738,"_19412":114578,"_5":13306,"_25509":114163,"_2665":53470},[],{"_3170":66900,"_28017":66738,"_19412":114580,"_5":13306,"_25509":114163,"_2665":114581},[],"`insecure_skip_verify` (con el valor negado)",{"_3170":66901,"_28017":66738,"_19412":114583,"_5":13306,"_25509":114163,"_2665":53476},[],{"_3170":66902,"_28017":66738,"_19412":114585,"_5":13306,"_25509":114163,"_2665":53479},[],{"_3170":66903,"_28017":66738,"_19412":114587,"_5":13306,"_25509":114163,"_2665":53482},[],{"_3170":66904,"_28017":66738,"_19412":114589,"_5":13306,"_25509":114163,"_2665":53485},[],{"_3170":66905,"_28017":66738,"_19412":114591,"_5":13306,"_25509":114163,"_2665":53488},[],{"_3170":66906,"_28017":66738,"_19412":114593,"_5":13306,"_25509":114163,"_2665":53491},[],{"_3170":66907,"_28017":66738,"_19412":114595,"_5":13306,"_25509":114163,"_2665":114596},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_3170":66908,"_28017":66738,"_19412":114598,"_5":13306,"_25509":114163,"_2665":114599},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3170":66909,"_28017":66738,"_19412":114601,"_5":13306,"_25509":114163,"_2665":114602},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3170":66910,"_28017":66738,"_19412":114604,"_5":13306,"_25509":114167,"_2665":114605},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3170":66911,"_28017":66738,"_19412":114607,"_5":13306,"_25509":114167,"_2665":114608},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3170":66912,"_28017":66738,"_19412":114610,"_5":13306,"_25509":114167,"_2665":114611},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3170":66913,"_28017":66738,"_19412":114613,"_5":13306,"_25509":114171,"_2665":114614},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. La consola expone editores independientes para ambos bloques; la guía de DMS describe sus campos, y también puedes editarlos mediante la API DMS.",{"_3170":66914,"_28017":66738,"_19412":114616,"_5":13306,"_25509":114175,"_2665":114617},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3170":66915,"_28017":66738,"_19412":114619,"_5":13306,"_25509":114179,"_2665":114620},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_3170":66916,"_28017":66738,"_19412":114622,"_5":13306,"_25509":114183,"_2665":114623},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3170":66917,"_28017":66738,"_19412":114625,"_5":13306,"_25509":114183,"_2665":114626},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3170":66918,"_28017":66738,"_19412":114628,"_5":13306,"_25509":114183,"_2665":114629},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3170":66919,"_28017":66738,"_19412":114631,"_5":13306,"_25509":114183,"_2665":114632},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza.",{"_3170":66920,"_28017":66738,"_19412":114634,"_5":13306,"_25509":114187,"_2665":114635},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3170":66921,"_28017":66738,"_19412":114637,"_5":13306,"_25509":114191,"_2665":114638},[],"Haz una copia de seguridad verificable de PostgreSQL y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`.",{"_3170":66922,"_28017":66738,"_19412":114640,"_5":13306,"_25509":114191,"_2665":114641},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3170":66923,"_28017":66738,"_19412":114643,"_5":13306,"_25509":114191,"_2665":114644},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3170":66924,"_28017":66738,"_19412":114646,"_5":13306,"_25509":114191,"_2665":114647},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3170":66925,"_28017":66738,"_19412":114649,"_5":13306,"_25509":114191,"_2665":114650},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3170":66926,"_28017":66738,"_19412":114652,"_5":13306,"_25509":114195,"_2665":114653},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3170":66927,"_28017":66738,"_19412":114655,"_5":13306,"_25509":114195,"_2665":114656},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3170":66928,"_28017":66738,"_19412":114658,"_5":13306,"_25509":114195,"_2665":114659},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se lee el campo `database` de cada entrada; la conexión usa siempre los values globales `postgres.hostname`, `postgres.port`, `postgres.username` y `postgres.password`.",{"_3170":66929,"_28017":66738,"_19412":114661,"_5":13306,"_25509":114195,"_2665":114662},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3170":66930,"_28017":66738,"_19412":114664,"_5":13306,"_25509":114195,"_2665":114665},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3170":66931,"_28017":66738,"_19412":114667,"_5":13306,"_25509":114195,"_2665":114668},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3170":66932,"_28017":66738,"_19412":114670,"_5":13306,"_25509":114195,"_2665":114671},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3170":66933,"_28017":66738,"_19412":114673,"_5":13306,"_25509":114195,"_2665":114674},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3170":66934,"_28017":66738,"_19412":114676,"_5":13306,"_25509":114195,"_2665":114677},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3170":66935,"_28017":66738,"_19412":114679,"_5":13306,"_25509":114195,"_2665":114680},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3170":66936,"_28017":66738,"_19412":114682,"_5":13306,"_25509":114195,"_2665":114683},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3170":66937,"_28017":66738,"_19412":114685,"_5":13306,"_25509":114195,"_2665":114686},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida.",{"_3170":66938,"_28017":66738,"_19412":114688,"_5":13306,"_25509":114199,"_2665":114689},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_3170":66939,"_28017":66738,"_19412":114691,"_5":13306,"_25509":114199,"_2665":114692},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_3170":66940,"_28017":66738,"_19412":114694,"_5":13306,"_25509":114203,"_2665":114695},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3170":66941,"_28017":66738,"_19412":114697,"_5":13306,"_25509":114203,"_2665":114698},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3170":66942,"_28017":66738,"_19412":114700,"_5":13306,"_25509":114203,"_2665":114701},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3170":66943,"_28017":66738,"_19412":114703,"_5":13306,"_25509":114203,"_2665":114704},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_3170":66944,"_28017":66738,"_19412":114706,"_5":13306,"_25509":114203,"_2665":114707},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3170":66945,"_28017":66738,"_19412":114709,"_5":13306,"_25509":114203,"_2665":114710},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3170":66946,"_28017":66738,"_19412":114712,"_5":13306,"_25509":114203,"_2665":114713},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3170":66947,"_28017":66738,"_19412":114715,"_5":13306,"_25509":114203,"_2665":114716},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3170":66948,"_28017":66738,"_19412":114718,"_5":13306,"_25509":114203,"_2665":114719},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3170":66949,"_28017":66738,"_19412":114721,"_5":13306,"_25509":114203,"_2665":114722},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3170":66950,"_28017":66738,"_19412":114724,"_5":13306,"_25509":114203,"_2665":114725},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_3170":66951,"_28017":66738,"_19412":114727,"_5":13306,"_25509":114207,"_2665":114728},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3170":66952,"_28017":66738,"_19412":114730,"_5":13306,"_25509":114207,"_2665":114731},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3170":66953,"_28017":66738,"_19412":114733,"_5":13306,"_25509":114211,"_2665":114734},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3170":66954,"_28017":66738,"_19412":114736,"_5":13306,"_25509":114211,"_2665":114737},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3170":66955,"_28017":66738,"_19412":114739,"_5":13306,"_25509":114211,"_2665":114740},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3170":66956,"_28017":66738,"_19412":114742,"_5":13306,"_25509":114211,"_2665":114743},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_3170":66957,"_28017":66738,"_19412":114745,"_5":13306,"_25509":114211,"_2665":114746},[],"El README de `goose-lamassu` aún muestra ejemplos por base de datos (`dbname=ca`, `dbname=kms`) y afirma que la herramienta valida el nombre de la base de datos, y el README de `ca-to-kms-migration` sigue describiendo el modelo de dos bases anterior a 4.0.0. Sigue la forma con `dbname=pki` de esta página en lugar de sus ejemplos.",{"_3170":66958,"_28017":66738,"_19412":114748,"_5":13306,"_25509":114215,"_2665":114749},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3170":66959,"_28017":66738,"_19412":114751,"_5":13306,"_25509":114215,"_2665":114752},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_3170":66960,"_28017":66738,"_19412":114754,"_5":13306,"_25509":114215,"_2665":114755},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_3170":66961,"_28017":66738,"_19412":114757,"_5":13306,"_25509":114215,"_2665":114758},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3170":66962,"_28017":66738,"_19412":114760,"_5":13306,"_25509":114215,"_2665":114761},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó por IDs de CA duplicados o por valores de `engine_id` vacíos. Revisa los logs del job, corrige los permisos o los datos y vuelve a ejecutar la actualización.",{"_3170":66963,"_28017":66738,"_19412":114763,"_5":13306,"_25509":114215,"_2665":114764},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3170":66964,"_28017":66738,"_19412":114766,"_5":13306,"_25509":114215,"_2665":114767},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3170":66965,"_28017":66738,"_19412":114769,"_5":13306,"_25509":114218,"_2665":114770},[],"Tras la actualización, comprueba en este orden:",{"_3170":66966,"_28017":66738,"_19412":114772,"_5":13306,"_25509":114218,"_2665":114773},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS.",{"_3170":66967,"_28017":66738,"_19412":114775,"_5":13306,"_25509":114218,"_2665":114776},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3170":66968,"_28017":66738,"_19412":114778,"_5":13306,"_25509":114218,"_2665":114779},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3170":66969,"_28017":66738,"_19412":114781,"_5":13306,"_25509":114218,"_2665":114782},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-ski>` sobre la VA devuelve una CRL emitida anteriormente, y se emiten CRLs nuevas.",{"_3170":66970,"_28017":66738,"_19412":114784,"_5":13306,"_25509":114218,"_2665":114785},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS.",{"_3170":66971,"_28017":66738,"_19412":114787,"_5":13306,"_25509":114218,"_2665":114788},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3170":66972,"_28017":66738,"_19412":114790,"_5":13306,"_25509":114218,"_2665":114791},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3170":66973,"_28017":66738,"_19412":114793,"_5":13306,"_25509":114218,"_2665":114794},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha.",{"_3170":66974,"_28017":66738,"_19412":114796,"_5":13306,"_25509":114218,"_2665":114797},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3170":66975,"_28017":66738,"_19412":114799,"_5":13306,"_25509":114218,"_2665":114800},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3170":66976,"_28017":66738,"_19412":114802,"_5":13306,"_25509":114218,"_2665":114803},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3170":66977,"_28017":66738,"_19412":114805,"_5":13306,"_25509":114218,"_2665":114806},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3170":66978,"_28017":66738,"_19412":114808,"_5":13306,"_25509":114218,"_2665":114809},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3170":66979,"_28017":66738,"_19412":114811,"_5":13306,"_25509":114218,"_2665":114812},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3170":66980,"_28017":66738,"_19412":114814,"_5":13306,"_25509":114222,"_2665":114815},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_3170":66981,"_28017":66738,"_19412":114817,"_5":13306,"_25509":114222,"_2665":114818},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3170":66982,"_28017":66738,"_19412":114820,"_5":13306,"_25509":114222,"_2665":114821},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3170":66983,"_28017":66738,"_19412":114823,"_5":13306,"_25509":114222,"_2665":114824},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_3170":66984,"_28017":66738,"_19412":114826,"_5":13306,"_25509":114222,"_2665":114827},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_53728":114829,"_53730":114830,"_53732":114831,"_53734":114832,"_16910":2687,"_64333":2687},"spanish",[2665,28017,5,25509],{"_2665":23214,"_28017":23214,"_5":23214,"_25509":23214},{"_2665":114833,"_28017":117481,"_5":120129,"_25509":122777},{"_4261":114834,"_53738":114835,"_5":23214},{"_13361":3389,"_13736":6357,"_13755":5439,"_11980":6616,"_13742":9994,"_18428":6005,"_13382":5482,"_13389":10458,"_27061":6413,"_27452":2847,"_27473":5343,"_27079":5685,"_32136":2776,"_27484":23864,"_27513":2714,"_32143":3280,"_32146":3838,"_32149":4378,"_32152":5679,"_27859":3039,"_32157":5646,"_32159":5328,"_27889":2985,"_13751":3414,"_32163":14624,"_32166":3903,"_32168":4373,"_27502":2875,"_27854":7647,"_27902":5562,"_32173":5619,"_32175":9828,"_32177":6448,"_32179":3307,"_32181":5098,"_32183":3715,"_32185":4264,"_32187":5996,"_32189":4345,"_27131":3464,"_32192":2997,"_32194":6372,"_27125":19540,"_32197":14600,"_32199":8294,"_32201":6522,"_32204":5908,"_27171":15516,"_32208":7027,"_27052":2946,"_32211":3369,"_27084":4246,"_32214":6414,"_28075":6838,"_32218":2957,"_13745":4194,"_32221":5432,"_32223":2757,"_32226":5492,"_32228":3343,"_32230":18874,"_32232":4645,"_32234":8360,"_18431":10478,"_32237":10793,"_32239":9634,"_27105":6449,"_27496":5059,"_3224