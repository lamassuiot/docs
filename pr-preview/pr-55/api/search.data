471":122142,"_39474":122145,"_39476":122148,"_39478":122151,"_39480":122154,"_39482":122157,"_39484":122160,"_39486":122163,"_39488":122166,"_39490":122169,"_39492":122172,"_39494":122175,"_39496":122178,"_39498":122181,"_39500":122184,"_39502":122187,"_39504":122190,"_39506":122193,"_39508":122196,"_39510":122199,"_39512":122202,"_39514":122205,"_39517":122208,"_39519":122211,"_39521":122214,"_39524":122217,"_39526":122220,"_39528":122223,"_39530":122226,"_39532":122229,"_39534":122232,"_39536":122235,"_39538":122238,"_39540":122241,"_39542":122244,"_39544":122247,"_39546":122250,"_39548":122253,"_39550":122256,"_39552":122259,"_39554":122262,"_39556":122265,"_39558":122268,"_39560":122271,"_39562":122274,"_39564":122277,"_39566":122280,"_39568":122283,"_39570":122286,"_39572":122289,"_39574":122292,"_39576":122295,"_39578":122298,"_39580":122301,"_39582":122304,"_39584":122307,"_39586":122310,"_39588":122313,"_39590":122316,"_39592":122319,"_39594":122322,"_39596":122325,"_39598":122328,"_39600":122331,"_39602":122334,"_39604":122337,"_39606":122340,"_39608":122343,"_39610":122346,"_39613":122349,"_39615":122352,"_39617":122355},{"_3379":68554,"_29627":68554,"_5":14459,"_2866":113661,"_29980":113662,"_20564":113665,"_26947":68554},"Despliega desde AWS Marketplace",[48237,113663,113664],"Despliegue","Otros modelos",[],{"_3379":68555,"_29627":68554,"_20564":113667,"_5":14107,"_26947":68554,"_2866":113668},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_3379":68556,"_29627":68554,"_5":29977,"_20564":113670,"_26947":113671,"_2866":113672},[],"/docs/pr-preview/pr-55/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_3379":68557,"_29627":68554,"_5":29977,"_20564":113674,"_26947":113675,"_2866":113676},[],"/docs/pr-preview/pr-55/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_3379":68558,"_29627":68554,"_5":29977,"_20564":113678,"_26947":113679,"_2866":113680},[],"/docs/pr-preview/pr-55/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3379":68559,"_29627":68554,"_5":29977,"_20564":113682,"_26947":113683,"_2866":113684},[],"/docs/pr-preview/pr-55/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3379":68560,"_29627":68554,"_5":29977,"_20564":113686,"_26947":113687,"_2866":113688},[],"/docs/pr-preview/pr-55/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3379":68561,"_29627":68554,"_5":29977,"_20564":113690,"_26947":113691,"_2866":113692},[],"/docs/pr-preview/pr-55/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3379":68562,"_29627":68554,"_5":29977,"_20564":113694,"_26947":113695,"_2866":113696},[],"/docs/pr-preview/pr-55/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3379":68563,"_29627":68554,"_20564":113698,"_5":14107,"_26947":68554,"_2866":113699},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3379":68564,"_29627":68554,"_20564":113701,"_5":14107,"_26947":113671,"_2866":113702},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3379":68565,"_29627":68554,"_20564":113704,"_5":14107,"_26947":113671,"_2866":113705},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3379":68566,"_29627":68554,"_20564":113707,"_5":14107,"_26947":113671,"_2866":113708},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3379":68567,"_29627":68554,"_20564":113710,"_5":14107,"_26947":113675,"_2866":113711},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3379":68568,"_29627":68554,"_20564":113713,"_5":14107,"_26947":113675,"_2866":113714},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3379":68569,"_29627":68554,"_20564":113716,"_5":14107,"_26947":113675,"_2866":113717},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3379":68570,"_29627":68554,"_20564":113719,"_5":14107,"_26947":113679,"_2866":113720},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3379":68571,"_29627":68554,"_20564":113722,"_5":14107,"_26947":113683,"_2866":113723},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3379":68572,"_29627":68554,"_20564":113725,"_5":14107,"_26947":113687,"_2866":113726},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3379":68573,"_29627":68554,"_20564":113728,"_5":14107,"_26947":113691,"_2866":113729},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3379":68574,"_29627":68554,"_20564":113731,"_5":14107,"_26947":113695,"_2866":113732},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3379":68575,"_29627":68575,"_5":14459,"_2866":113734,"_29980":113735,"_20564":113736,"_26947":68575},"Despliega Lamassu",[48237,113663],[],{"_3379":68576,"_29627":68575,"_20564":113738,"_5":14107,"_26947":68575,"_2866":113739},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3379":68577,"_29627":68575,"_5":29977,"_20564":113741,"_26947":113742,"_2866":113743},[],"/docs/pr-preview/pr-55/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3379":68578,"_29627":68575,"_5":29977,"_20564":113745,"_26947":113746,"_2866":113747},[],"/docs/pr-preview/pr-55/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3379":68579,"_29627":68575,"_5":29977,"_20564":113749,"_26947":113750,"_2866":113751},[],"/docs/pr-preview/pr-55/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3379":68580,"_29627":68575,"_20564":113753,"_5":14107,"_26947":68575,"_2866":113754},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3379":68581,"_29627":68575,"_20564":113756,"_5":14107,"_26947":113742,"_2866":113757},[],"Modelo",{"_3379":68582,"_29627":68575,"_20564":113759,"_5":14107,"_26947":113742,"_2866":113760},[],"Recomendado para",{"_3379":68583,"_29627":68575,"_20564":113762,"_5":14107,"_26947":113742,"_2866":113763},[],"Quién opera la infraestructura",{"_3379":68584,"_29627":68575,"_20564":113765,"_5":14107,"_26947":113742,"_2866":113766},[],"Punto de partida",{"_3379":68585,"_29627":68575,"_20564":113768,"_5":14107,"_26947":113742,"_2866":48344},[],{"_3379":68586,"_29627":68575,"_20564":113770,"_5":14107,"_26947":113742,"_2866":113771},[],"Producción, entornos regulados y despliegues personalizados",{"_3379":68587,"_29627":68575,"_20564":113773,"_5":14107,"_26947":113742,"_2866":113774},[],"Tu equipo",{"_3379":68588,"_29627":68575,"_20564":113776,"_5":14107,"_26947":113742,"_2866":113777},[],"Helm o Fastlane",{"_3379":68589,"_29627":68575,"_20564":113779,"_5":14107,"_26947":113742,"_2866":48356},[],{"_3379":68590,"_29627":68575,"_20564":113781,"_5":14107,"_26947":113742,"_2866":113782},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3379":68591,"_29627":68575,"_20564":113784,"_5":14107,"_26947":113742,"_2866":113774},[],{"_3379":68592,"_29627":68575,"_20564":113786,"_5":14107,"_26947":113742,"_2866":113787},[],"Imagen preconfigurada en EC2",{"_3379":68593,"_29627":68575,"_20564":113789,"_5":14107,"_26947":113742,"_2866":48367},[],{"_3379":68594,"_29627":68575,"_20564":113791,"_5":14107,"_26947":113742,"_2866":113792},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3379":68595,"_29627":68575,"_20564":113794,"_5":14107,"_26947":113742,"_2866":48373},[],{"_3379":68596,"_29627":68575,"_20564":113796,"_5":14107,"_26947":113742,"_2866":113797},[],"Suscripción gestionada",{"_3379":68597,"_29627":68575,"_20564":113799,"_5":14107,"_26947":113742,"_2866":113800},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3379":68598,"_29627":68575,"_20564":113802,"_5":14107,"_26947":113742,"_2866":113803},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3379":68599,"_29627":68575,"_20564":113805,"_5":14107,"_26947":113742,"_2866":113806},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3379":68600,"_29627":68575,"_20564":113808,"_5":14107,"_26947":113746,"_2866":113809},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3379":68601,"_29627":68575,"_20564":113811,"_5":14107,"_26947":113750,"_2866":113812},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3379":68602,"_29627":68602,"_5":14459,"_2866":113814,"_29980":113815,"_20564":113816,"_26947":68602},"Utiliza Lamassu como SaaS",[48237,113663,113664],[],{"_3379":68603,"_29627":68602,"_20564":113818,"_5":14107,"_26947":68602,"_2866":113819},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3379":68604,"_29627":68602,"_5":29977,"_20564":113821,"_26947":113822,"_2866":113823},[],"/docs/pr-preview/pr-55/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3379":68605,"_29627":68602,"_5":29977,"_20564":113825,"_26947":113826,"_2866":113827},[],"/docs/pr-preview/pr-55/es/deployment/saas#planes","Planes",{"_3379":68606,"_29627":68602,"_5":29977,"_20564":113829,"_26947":113830,"_2866":113831},[],"/docs/pr-preview/pr-55/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3379":68607,"_29627":68602,"_20564":113833,"_5":14107,"_26947":68602,"_2866":113834},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3379":68608,"_29627":68602,"_20564":113836,"_5":14107,"_26947":113822,"_2866":113837},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3379":68609,"_29627":68602,"_20564":113839,"_5":14107,"_26947":113822,"_2866":113840},[],"Copias de seguridad automáticas.",{"_3379":68610,"_29627":68602,"_20564":113842,"_5":14107,"_26947":113822,"_2866":113843},[],"Actualizaciones de versión.",{"_3379":68611,"_29627":68602,"_20564":113845,"_5":14107,"_26947":113822,"_2866":113846},[],"Soporte técnico y SLA según el plan contratado.",{"_3379":68612,"_29627":68602,"_20564":113848,"_5":14107,"_26947":113826,"_2866":48428},[],{"_3379":68613,"_29627":68602,"_20564":113850,"_5":14107,"_26947":113826,"_2866":113851},[],"Dispositivos",{"_3379":68614,"_29627":68602,"_20564":113853,"_5":14107,"_26947":113826,"_2866":113854},[],"Soporte",{"_3379":68615,"_29627":68602,"_20564":113856,"_5":14107,"_26947":113826,"_2866":48437},[],{"_3379":68616,"_29627":68602,"_20564":113858,"_5":14107,"_26947":113826,"_2866":48440},[],{"_3379":68617,"_29627":68602,"_20564":113860,"_5":14107,"_26947":113826,"_2866":113861},[],"Hasta 1.000",{"_3379":68618,"_29627":68602,"_20564":113863,"_5":14107,"_26947":113826,"_2866":48446},[],{"_3379":68619,"_29627":68602,"_20564":113865,"_5":14107,"_26947":113826,"_2866":113866},[],"99,5 %",{"_3379":68620,"_29627":68602,"_20564":113868,"_5":14107,"_26947":113826,"_2866":48452},[],{"_3379":68621,"_29627":68602,"_20564":113870,"_5":14107,"_26947":113826,"_2866":113871},[],"Hasta 10.000",{"_3379":68622,"_29627":68602,"_20564":113873,"_5":14107,"_26947":113826,"_2866":113874},[],"Email y chat",{"_3379":68623,"_29627":68602,"_20564":113876,"_5":14107,"_26947":113826,"_2866":113877},[],"99,9 %",{"_3379":68624,"_29627":68602,"_20564":113879,"_5":14107,"_26947":113826,"_2866":48464},[],{"_3379":68625,"_29627":68602,"_20564":113881,"_5":14107,"_26947":113826,"_2866":113882},[],"Ilimitados",{"_3379":68626,"_29627":68602,"_20564":113884,"_5":14107,"_26947":113826,"_2866":113885},[],"Dedicado",{"_3379":68627,"_29627":68602,"_20564":113887,"_5":14107,"_26947":113826,"_2866":113888},[],"99,99 %",{"_3379":68628,"_29627":68602,"_20564":113890,"_5":14107,"_26947":113830,"_2866":113891},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3379":68629,"_29627":68602,"_20564":113893,"_5":14107,"_26947":113830,"_2866":113894},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3379":68630,"_29627":68630,"_5":14459,"_2866":48481,"_29980":113896,"_20564":113898,"_26947":68630},[48237,113663,113897],"Kubernetes autogestionado",[],{"_3379":68631,"_29627":68630,"_20564":113900,"_5":14107,"_26947":68630,"_2866":113901},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3379":68632,"_29627":68630,"_5":29977,"_20564":113903,"_26947":113904,"_2866":113905},[],"/docs/pr-preview/pr-55/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3379":68633,"_29627":68630,"_5":29977,"_20564":113907,"_26947":113908,"_2866":113909},[],"/docs/pr-preview/pr-55/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3379":68634,"_29627":68630,"_5":29977,"_20564":113911,"_26947":113912,"_2866":113913},[],"/docs/pr-preview/pr-55/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3379":68635,"_29627":68630,"_5":29977,"_20564":113915,"_26947":113916,"_2866":113917},[],"/docs/pr-preview/pr-55/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3379":68636,"_29627":68630,"_5":29977,"_20564":113919,"_26947":113920,"_2866":113921},[],"/docs/pr-preview/pr-55/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3379":68637,"_29627":68630,"_5":29977,"_20564":113923,"_26947":113924,"_2866":113925},[],"/docs/pr-preview/pr-55/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3379":68638,"_29627":68630,"_5":29977,"_20564":113927,"_26947":113928,"_2866":113929},[],"/docs/pr-preview/pr-55/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3379":68639,"_29627":68630,"_5":29977,"_20564":113931,"_26947":113932,"_2866":113933},[],"/docs/pr-preview/pr-55/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3379":68640,"_29627":68630,"_5":29977,"_20564":113935,"_26947":113936,"_2866":113937},[],"/docs/pr-preview/pr-55/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3379":68641,"_29627":68630,"_5":29977,"_20564":113939,"_26947":113940,"_2866":113941},[],"/docs/pr-preview/pr-55/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3379":68642,"_29627":68630,"_5":29977,"_20564":113943,"_26947":113944,"_2866":113945},[],"/docs/pr-preview/pr-55/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3379":68643,"_29627":68630,"_20564":113947,"_5":14107,"_26947":113904,"_2866":113948},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3379":68644,"_29627":68630,"_20564":113950,"_5":14107,"_26947":113904,"_2866":113951},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3379":68645,"_29627":68630,"_20564":113953,"_5":14107,"_26947":113908,"_2866":113954},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3379":68646,"_29627":68630,"_20564":113956,"_5":14107,"_26947":113908,"_2866":113957},[],"Fastlane instala o configura",{"_3379":68647,"_29627":68630,"_20564":113959,"_5":14107,"_26947":113908,"_2866":113960},[],"Tú sigues proporcionando",{"_3379":68648,"_29627":68630,"_20564":113962,"_5":14107,"_26947":113908,"_2866":113963},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3379":68649,"_29627":68630,"_20564":113965,"_5":14107,"_26947":113908,"_2866":113966},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3379":68650,"_29627":68630,"_20564":113968,"_5":14107,"_26947":113908,"_2866":113969},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3379":68651,"_29627":68630,"_20564":113971,"_5":14107,"_26947":113908,"_2866":113972},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3379":68652,"_29627":68630,"_20564":113974,"_5":14107,"_26947":113908,"_2866":113975},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_3379":68653,"_29627":68630,"_20564":113977,"_5":14107,"_26947":113908,"_2866":113978},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3379":68654,"_29627":68630,"_20564":113980,"_5":14107,"_26947":113908,"_2866":113981},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3379":68655,"_29627":68630,"_20564":113983,"_5":14107,"_26947":113908,"_2866":113984},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3379":68656,"_29627":68630,"_20564":113986,"_5":14107,"_26947":113908,"_2866":113987},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3379":68657,"_29627":68630,"_20564":113989,"_5":14107,"_26947":113912,"_2866":113990},[],"Necesitas:",{"_3379":68658,"_29627":68630,"_20564":113992,"_5":14107,"_26947":113912,"_2866":113993},[],"un clúster Kubernetes existente",{"_3379":68659,"_29627":68630,"_20564":113995,"_5":14107,"_26947":113912,"_2866":113996},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3379":68660,"_29627":68630,"_20564":113998,"_5":14107,"_26947":113912,"_2866":48583},[],{"_3379":68661,"_29627":68630,"_20564":114000,"_5":14107,"_26947":113912,"_2866":23245},[],{"_3379":68662,"_29627":68630,"_20564":114002,"_5":14107,"_26947":113912,"_2866":114003},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3379":68663,"_29627":68630,"_20564":114005,"_5":14107,"_26947":113912,"_2866":114006},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3379":68664,"_29627":68630,"_20564":114008,"_5":14107,"_26947":113912,"_2866":114009},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3379":68665,"_29627":68630,"_20564":114011,"_5":14107,"_26947":113912,"_2866":114012},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3379":68666,"_29627":68630,"_20564":114014,"_5":14107,"_26947":113912,"_2866":114015},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3379":68667,"_29627":68630,"_20564":114017,"_5":14107,"_26947":113916,"_2866":114018},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3379":68668,"_29627":68630,"_20564":114020,"_5":14107,"_26947":113916,"_2866":114021},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3379":68669,"_29627":68630,"_20564":114023,"_5":14107,"_26947":113920,"_2866":114024},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3379":68670,"_29627":68630,"_20564":114026,"_5":14107,"_26947":113920,"_2866":114027},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3379":68671,"_29627":68630,"_20564":114029,"_5":14107,"_26947":113920,"_2866":114030},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3379":68672,"_29627":68630,"_20564":114032,"_5":14107,"_26947":113920,"_2866":114033},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3379":68673,"_29627":68630,"_20564":114035,"_5":14107,"_26947":113924,"_2866":114036},[],"Opción",{"_3379":68674,"_29627":68630,"_20564":114038,"_5":14107,"_26947":113924,"_2866":114039},[],"Valor predeterminado",{"_3379":68675,"_29627":68630,"_20564":114041,"_5":14107,"_26947":113924,"_2866":114042},[],"Propósito",{"_3379":68676,"_29627":68630,"_20564":114044,"_5":14107,"_26947":113924,"_2866":48630},[],{"_3379":68677,"_29627":68630,"_20564":114046,"_5":14107,"_26947":113924,"_2866":48633},[],{"_3379":68678,"_29627":68630,"_20564":114048,"_5":14107,"_26947":113924,"_2866":114049},[],"Muestra la ayuda",{"_3379":68679,"_29627":68630,"_20564":114051,"_5":14107,"_26947":113924,"_2866":48639},[],{"_3379":68680,"_29627":68630,"_20564":114053,"_5":14107,"_26947":113924,"_2866":114054},[],"contexto actual",{"_3379":68681,"_29627":68630,"_20564":114056,"_5":14107,"_26947":113924,"_2866":114057},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3379":68682,"_29627":68630,"_20564":114059,"_5":14107,"_26947":113924,"_2866":48648},[],{"_3379":68683,"_29627":68630,"_20564":114061,"_5":14107,"_26947":113924,"_2866":6395},[],{"_3379":68684,"_29627":68630,"_20564":114063,"_5":14107,"_26947":113924,"_2866":114064},[],"Omite prompts y genera credenciales para las dependencias",{"_3379":68685,"_29627":68630,"_20564":114066,"_5":14107,"_26947":113924,"_2866":48656},[],{"_3379":68686,"_29627":68630,"_20564":114068,"_5":14107,"_26947":113924,"_2866":48659},[],{"_3379":68687,"_29627":68630,"_20564":114070,"_5":14107,"_26947":113924,"_2866":114071},[],"Namespace de la instalación",{"_3379":68688,"_29627":68630,"_20564":114073,"_5":14107,"_26947":113924,"_2866":48665},[],{"_3379":68689,"_29627":68630,"_20564":114075,"_5":14107,"_26947":113924,"_2866":48668},[],{"_3379":68690,"_29627":68630,"_20564":114077,"_5":14107,"_26947":113924,"_2866":114078},[],"Dominio usado por la UI, OIDC y el certificado",{"_3379":68691,"_29627":68630,"_20564":114080,"_5":14107,"_26947":113924,"_2866":48674},[],{"_3379":68692,"_29627":68630,"_20564":114082,"_5":14107,"_26947":113924,"_2866":14793},[],{"_3379":68693,"_29627":68630,"_20564":114084,"_5":14107,"_26947":113924,"_2866":114085},[],"Versión del chart de Lamassu",{"_3379":68694,"_29627":68630,"_20564":114087,"_5":14107,"_26947":113924,"_2866":48682},[],{"_3379":68695,"_29627":68630,"_20564":114089,"_5":14107,"_26947":113924,"_2866":48685},[],{"_3379":68696,"_29627":68630,"_20564":114091,"_5":14107,"_26947":113924,"_2866":114092},[],"Puerto del listener HTTPS",{"_3379":68697,"_29627":68630,"_20564":114094,"_5":14107,"_26947":113924,"_2866":48691},[],{"_3379":68698,"_29627":68630,"_20564":114096,"_5":14107,"_26947":113924,"_2866":48694},[],{"_3379":68699,"_29627":68630,"_20564":114098,"_5":14107,"_26947":113924,"_2866":114099},[],"Puerto del listener HTTP",{"_3379":68700,"_29627":68630,"_20564":114101,"_5":14107,"_26947":113924,"_2866":48700},[],{"_3379":68701,"_29627":68630,"_20564":114103,"_5":14107,"_26947":113924,"_2866":48633},[],{"_3379":68702,"_29627":68630,"_20564":114105,"_5":14107,"_26947":113924,"_2866":114106},[],"Certificado PEM para TLS downstream",{"_3379":68703,"_29627":68630,"_20564":114108,"_5":14107,"_26947":113924,"_2866":48708},[],{"_3379":68704,"_29627":68630,"_20564":114110,"_5":14107,"_26947":113924,"_2866":48633},[],{"_3379":68705,"_29627":68630,"_20564":114112,"_5":14107,"_26947":113924,"_2866":114113},[],"Clave privada PEM para TLS downstream",{"_3379":68706,"_29627":68630,"_20564":114115,"_5":14107,"_26947":113924,"_2866":48716},[],{"_3379":68707,"_29627":68630,"_20564":114117,"_5":14107,"_26947":113924,"_2866":114118},[],"chart del repositorio",{"_3379":68708,"_29627":68630,"_20564":114120,"_5":14107,"_26947":113924,"_2866":114121},[],"Usa un chart local de Lamassu sin empaquetar",{"_3379":68709,"_29627":68630,"_20564":114123,"_5":14107,"_26947":113924,"_2866":48725},[],{"_3379":68710,"_29627":68630,"_20564":114125,"_5":14107,"_26947":113924,"_2866":114126},[],"detección automática",{"_3379":68711,"_29627":68630,"_20564":114128,"_5":14107,"_26947":113924,"_2866":114129},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3379":68712,"_29627":68630,"_20564":114131,"_5":14107,"_26947":113924,"_2866":48733},[],{"_3379":68713,"_29627":68630,"_20564":114133,"_5":14107,"_26947":113924,"_2866":6395},[],{"_3379":68714,"_29627":68630,"_20564":114135,"_5":14107,"_26947":113924,"_2866":114136},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3379":68715,"_29627":68630,"_20564":114138,"_5":14107,"_26947":113924,"_2866":48741},[],{"_3379":68716,"_29627":68630,"_20564":114140,"_5":14107,"_26947":113924,"_2866":6395},[],{"_3379":68717,"_29627":68630,"_20564":114142,"_5":14107,"_26947":113924,"_2866":114143},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3379":68718,"_29627":68630,"_20564":114145,"_5":14107,"_26947":113924,"_2866":48749},[],{"_3379":68719,"_29627":68630,"_20564":114147,"_5":14107,"_26947":113924,"_2866":6395},[],{"_3379":68720,"_29627":68630,"_20564":114149,"_5":14107,"_26947":113924,"_2866":114150},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3379":68721,"_29627":68630,"_20564":114152,"_5":14107,"_26947":113924,"_2866":48757},[],{"_3379":68722,"_29627":68630,"_20564":114154,"_5":14107,"_26947":113924,"_2866":6395},[],{"_3379":68723,"_29627":68630,"_20564":114156,"_5":14107,"_26947":113924,"_2866":114157},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3379":68724,"_29627":68630,"_20564":114159,"_5":14107,"_26947":113924,"_2866":48765},[],{"_3379":68725,"_29627":68630,"_20564":114161,"_5":14107,"_26947":113924,"_2866":48768},[],{"_3379":68726,"_29627":68630,"_20564":114163,"_5":14107,"_26947":113924,"_2866":114164},[],"Usa otro chart local de SoftHSM",{"_3379":68727,"_29627":68630,"_20564":114166,"_5":14107,"_26947":113924,"_2866":114167},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3379":68728,"_29627":68630,"_20564":114169,"_5":14107,"_26947":113928,"_2866":114170},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3379":68729,"_29627":68630,"_20564":114172,"_5":14107,"_26947":113928,"_2866":114173},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3379":68730,"_29627":68630,"_20564":114175,"_5":14107,"_26947":113928,"_2866":114176},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3379":68731,"_29627":68630,"_20564":114178,"_5":14107,"_26947":113928,"_2866":114179},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3379":68732,"_29627":68630,"_20564":114181,"_5":14107,"_26947":113928,"_2866":114182},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3379":68733,"_29627":68630,"_20564":114184,"_5":14107,"_26947":113928,"_2866":114185},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3379":68734,"_29627":68630,"_20564":114187,"_5":14107,"_26947":113932,"_2866":48795},[],{"_3379":68735,"_29627":68630,"_20564":114189,"_5":14107,"_26947":113932,"_2866":114190},[],"valida las herramientas locales y el clúster seleccionado",{"_3379":68736,"_29627":68630,"_20564":114192,"_5":14107,"_26947":113932,"_2866":114193},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3379":68737,"_29627":68630,"_20564":114195,"_5":14107,"_26947":113932,"_2866":114196},[],"crea el namespace",{"_3379":68738,"_29627":68630,"_20564":114198,"_5":14107,"_26947":113932,"_2866":114199},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3379":68739,"_29627":68630,"_20564":114201,"_5":14107,"_26947":113932,"_2866":114202},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3379":68740,"_29627":68630,"_20564":114204,"_5":14107,"_26947":113932,"_2866":114205},[],"instala RabbitMQ",{"_3379":68741,"_29627":68630,"_20564":114207,"_5":14107,"_26947":113932,"_2866":114208},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3379":68742,"_29627":68630,"_20564":114210,"_5":14107,"_26947":113932,"_2866":114211},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_3379":68743,"_29627":68630,"_20564":114213,"_5":14107,"_26947":113932,"_2866":114214},[],"carga datos de ejemplo opcionalmente",{"_3379":68744,"_29627":68630,"_20564":114216,"_5":14107,"_26947":113932,"_2866":114217},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3379":68745,"_29627":68630,"_20564":114219,"_5":14107,"_26947":113936,"_2866":114220},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3379":68746,"_29627":68630,"_20564":114222,"_5":14107,"_26947":113936,"_2866":114223},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3379":68747,"_29627":68630,"_20564":114225,"_5":14107,"_26947":113940,"_2866":114226},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3379":68748,"_29627":68630,"_20564":114228,"_5":14107,"_26947":113940,"_2866":114229},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_3379":68749,"_29627":68630,"_20564":114231,"_5":14107,"_26947":113940,"_2866":114232},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3379":68750,"_29627":68630,"_20564":114234,"_5":14107,"_26947":113944,"_2866":114235},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3379":68751,"_29627":68751,"_5":14459,"_2866":114237,"_29980":114238,"_20564":114239,"_26947":68751},"Instala con Helm",[48237,113663,113897],[],{"_3379":68752,"_29627":68751,"_20564":114241,"_5":14107,"_26947":68751,"_2866":114242},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3379":68753,"_29627":68751,"_5":29977,"_20564":114244,"_26947":114245,"_2866":114246},[],"/docs/pr-preview/pr-55/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3379":68754,"_29627":68751,"_5":29977,"_20564":114248,"_26947":114249,"_2866":113913},[],"/docs/pr-preview/pr-55/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3379":68755,"_29627":68751,"_5":29977,"_20564":114251,"_26947":114252,"_2866":114253},[],"/docs/pr-preview/pr-55/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3379":68756,"_29627":68751,"_5":29977,"_20564":114255,"_26947":114256,"_2866":114257},[],"/docs/pr-preview/pr-55/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3379":68757,"_29627":68751,"_5":29977,"_20564":114259,"_26947":114260,"_2866":114261},[],"/docs/pr-preview/pr-55/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3379":68758,"_29627":68751,"_5":29977,"_20564":114263,"_26947":114264,"_2866":114265},[],"/docs/pr-preview/pr-55/es/deployment/self-hosted/helm#tls-de-amqp-amqps","TLS de AMQP (AMQPS)",{"_3379":68759,"_29627":68751,"_5":29977,"_20564":114267,"_26947":114268,"_2866":114269},[],"/docs/pr-preview/pr-55/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3379":68760,"_29627":68751,"_5":29977,"_20564":114271,"_26947":114272,"_2866":114273},[],"/docs/pr-preview/pr-55/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3379":68761,"_29627":68751,"_5":29977,"_20564":114275,"_26947":114276,"_2866":114277},[],"/docs/pr-preview/pr-55/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3379":68762,"_29627":68751,"_5":29977,"_20564":114279,"_26947":114280,"_2866":114281},[],"/docs/pr-preview/pr-55/es/deployment/self-hosted/helm#actualiza-lamassu","Actualiza Lamassu",{"_3379":68763,"_29627":68751,"_5":29977,"_20564":114283,"_26947":114284,"_2866":114285},[],"/docs/pr-preview/pr-55/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3379":68764,"_29627":68751,"_20564":114287,"_5":14107,"_26947":114245,"_2866":114288},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3379":68765,"_29627":68751,"_20564":114290,"_5":14107,"_26947":114249,"_2866":114291},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3379":68766,"_29627":68751,"_20564":114293,"_5":14107,"_26947":114249,"_2866":114294},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3379":68767,"_29627":68751,"_20564":114296,"_5":14107,"_26947":114249,"_2866":114297},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3379":68768,"_29627":68751,"_20564":114299,"_5":14107,"_26947":114249,"_2866":114300},[],"un broker RabbitMQ accesible y sus credenciales",{"_3379":68769,"_29627":68751,"_20564":114302,"_5":14107,"_26947":114249,"_2866":114303},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3379":68770,"_29627":68751,"_20564":114305,"_5":14107,"_26947":114249,"_2866":114306},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3379":68771,"_29627":68751,"_20564":114308,"_5":14107,"_26947":114249,"_2866":114309},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3379":68772,"_29627":68751,"_20564":114311,"_5":14107,"_26947":114249,"_2866":114312},[],"una StorageClass y un diseño de tráfico externo",{"_3379":68773,"_29627":68751,"_20564":114314,"_5":14107,"_26947":114249,"_2866":114315},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3379":68774,"_29627":68751,"_20564":114317,"_5":14107,"_26947":114249,"_2866":114318},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3379":68775,"_29627":68751,"_20564":114320,"_5":14107,"_26947":114249,"_2866":114321},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3379":68776,"_29627":68751,"_20564":114323,"_5":14107,"_26947":114252,"_2866":114324},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3379":68777,"_29627":68751,"_20564":114326,"_5":14107,"_26947":114252,"_2866":114327},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3379":68778,"_29627":68751,"_20564":114329,"_5":14107,"_26947":114252,"_2866":114330},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_3379":68779,"_29627":68751,"_20564":114332,"_5":14107,"_26947":114256,"_2866":114333},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3379":68780,"_29627":68751,"_20564":114335,"_5":14107,"_26947":114256,"_2866":114336},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3379":68781,"_29627":68751,"_20564":114338,"_5":14107,"_26947":114256,"_2866":114339},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3379":68782,"_29627":68751,"_20564":114341,"_5":14107,"_26947":114256,"_2866":114342},[],"Si tu archivo de valores aún contiene los ajustes heredados de validación JWT del Gateway — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` o `auth.authorization.roles.admin` — elimínalos. La guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documenta su eliminación sin alias de compatibilidad, y `values.schema.json` rechaza los bloques residuales en lugar de ignorarlos silenciosamente. Los reemplazos son `services.authz.jwkUrl` y `services.authz.bootstrap`, que ya aparecen en el ejemplo anterior.",{"_3379":68783,"_29627":68751,"_20564":114344,"_5":14107,"_26947":114260,"_2866":114345},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_3379":68784,"_29627":68751,"_20564":114347,"_5":14107,"_26947":114264,"_2866":114348},[],"`amqp.tls: true` selecciona AMQPS en todos los bloques de configuración del bus de eventos. El puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS, así que define `amqp.port` con el listener TLS del broker, normalmente `5671`.",{"_3379":68785,"_29627":68751,"_20564":114350,"_5":14107,"_26947":114264,"_2866":114351},[],"Sin un Secret de CA configurado, los clientes del bus de eventos usan las CA de confianza del sistema. Para confiar en una CA privada, crea un Secret en el namespace del release con el certificado de la CA en formato PEM y define `amqp.ca.secretName` (y `amqp.ca.certificateKey` si la clave de datos no es `ca.crt`).",{"_3379":68786,"_29627":68751,"_20564":114353,"_5":14107,"_26947":114264,"_2866":114354},[],"Para brokers que exijan TLS mutuo, crea un Secret con el certificado de cliente y su clave privada y define `amqp.client.secretName` (con `amqp.client.certificateKey` y `amqp.client.privateKeyKey` si las claves de datos no son `tls.crt` y `tls.key`).",{"_3379":68787,"_29627":68751,"_20564":114356,"_5":14107,"_26947":114264,"_2866":114357},[],"El chart monta los Secrets configurados en modo de solo lectura en todas las cargas de trabajo que consumen AMQP: el certificado de la CA en `/etc/lamassu/amqp/ca` y el certificado y la clave de cliente en `/etc/lamassu/amqp/client`. Los nombres de los archivos montados son siempre `ca.crt`, `tls.crt` y `tls.key` — los valores `certificateKey` y `privateKeyKey` renombran solo las claves de datos del Secret, nunca las rutas en disco. La clave privada del cliente se monta con permisos restrictivos (`defaultMode: 0440`; el volumen de la CA usa `0444`), que funcionan porque el chart añade `fsGroup` al security context del pod cuando `amqp.client.secretName` está definido — usa el `runAsGroup` del contenedor (por defecto `65532`) cuando `fsGroup` no está ya definido.",{"_3379":68788,"_29627":68751,"_20564":114359,"_5":14107,"_26947":114264,"_2866":114360},[],"Ambas opciones de Secret exigen `amqp.tls: true`: `values.schema.json` rechaza un `secretName` no vacío cuando `tls` es false, rechaza claves desconocidas y rechaza nombres de clave de datos fuera de `^[A-Za-z0-9._-]+$`. El Secret referenciado debe existir en el namespace del release o los pods consumidores no llegan a arrancar.",{"_3379":68789,"_29627":68751,"_20564":114362,"_5":14107,"_26947":114264,"_2866":114363},[],"El cliente AMQP carga los certificados al arrancar, así que reinicia los pods consumidores tras actualizar cualquiera de los dos Secrets. Cambiar cualquier valor de `amqp` reinicia las cargas de trabajo consumidoras mediante la anotación `checksum/config`, pero cambiar solo el contenido de un Secret no desencadena un rollout.",{"_3379":68790,"_29627":68751,"_20564":114365,"_5":14107,"_26947":114264,"_2866":114366},[],"Según la guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: en 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos usaban AMQP en claro; desde 4.0.0, `amqp.tls: true` los cambia a AMQPS. Define `amqp.port` con el listener TLS del broker antes del upgrade, o usa `amqp.tls: false` para mantener AMQP en claro. `amqp.tls: false` envía las credenciales del broker y todo el tráfico del bus de eventos en claro.",{"_3379":68791,"_29627":68751,"_20564":114368,"_5":14107,"_26947":114268,"_2866":114369},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3379":68792,"_29627":68751,"_20564":114371,"_5":14107,"_26947":114268,"_2866":114372},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3379":68793,"_29627":68751,"_20564":114374,"_5":14107,"_26947":114268,"_2866":114375},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3379":68794,"_29627":68751,"_20564":114377,"_5":14107,"_26947":114268,"_2866":114378},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3379":68795,"_29627":68751,"_20564":114380,"_5":14107,"_26947":114272,"_2866":114381},[],"Para instalar un checkout local:",{"_3379":68796,"_29627":68751,"_20564":114383,"_5":14107,"_26947":114276,"_2866":114384},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3379":68797,"_29627":68751,"_20564":114386,"_5":14107,"_26947":114276,"_2866":114387},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3379":68798,"_29627":68751,"_20564":114389,"_5":14107,"_26947":114280,"_2866":114390},[],"Los pasos de upgrade específicos de cada versión se mantienen en `charts/lamassu/CHANGELOG/` dentro del repositorio Helm. El chart también incluye un job de pre-upgrade opcional que migra las claves privadas de CA existentes al motor KMS configurado para el release. Está desactivado por defecto (`migrations.caToKms.enabled: false`) y solo es necesario cuando actualizas desde una versión anterior a 3.7.0.",{"_3379":68799,"_29627":68751,"_20564":114392,"_5":14107,"_26947":114280,"_2866":114393},[],"Mientras el flag esté activo, cada `helm upgrade` crea el job `<chart fullname>-ca-to-kms-migration` (`lamassu-ca-to-kms-migration` para el release `lamassu`); una instalación nueva no lo crea. Su hook weight es `-10`, por lo que se ejecuta antes de los otros hooks de pre-upgrade: la configuración de bootstrap de autorización (peso `-4`) y el job de migración de base de datos (peso `-3`).",{"_3379":68800,"_29627":68751,"_20564":114395,"_5":14107,"_26947":114280,"_2866":114396},[],"El job consume la misma configuración del servicio KMS que el chart renderiza en el ConfigMap de KMS, incluidos los motores de `services.kms.cryptoEngines`, y ejecuta la imagen de la herramienta de migración definida en `migrations.caToKms.image`. La monta en modo read-only en `/etc/lamassuiot/config.yml` desde la clave `config` del ConfigMap, así que configura el motor de destino en tus valores antes del upgrade que realiza la migración.",{"_3379":68801,"_29627":68751,"_20564":114398,"_5":14107,"_26947":114280,"_2866":114399},[],"El job resuelve su configuración mediante un volumen proyectado con dos fuentes opcionales: el ConfigMap `<chart fullname>-kms-config`, cuyo nombre incorpora el release (`lamassu-kms-config` para el release `lamassu`, `prod-lamassu-kms-config` para el release `prod`), y el ConfigMap legacy `kms-config`, sin el nombre del release, creado por versiones anteriores del chart. La configuración legacy mantiene la autoridad mientras siga presente y el job usa el ConfigMap del release una vez el legacy desaparece. Ambas fuentes son opcionales, por lo que un ConfigMap ausente nunca deja el pod del upgrade en `ContainerCreating`.",{"_3379":68802,"_29627":68751,"_20564":114401,"_5":14107,"_26947":114280,"_2866":114402},[],"Mantén `migrations.caToKms.enabled: true` en el upgrade que realiza la migración y elimina después el flag de tus valores una vez completada la migración; su valor por defecto es `false`.",{"_3379":68803,"_29627":68751,"_20564":114404,"_5":14107,"_26947":114284,"_2866":114405},[],"Antes de pasar a producción, revisa:",{"_3379":68804,"_29627":68751,"_20564":114407,"_5":14107,"_26947":114284,"_2866":114408},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3379":68805,"_29627":68751,"_20564":114410,"_5":14107,"_26947":114284,"_2866":114411},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3379":68806,"_29627":68751,"_20564":114413,"_5":14107,"_26947":114284,"_2866":114414},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3379":68807,"_29627":68751,"_20564":114416,"_5":14107,"_26947":114284,"_2866":114417},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3379":68808,"_29627":68751,"_20564":114419,"_5":14107,"_26947":114284,"_2866":114420},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3379":68809,"_29627":68751,"_20564":114422,"_5":14107,"_26947":114284,"_2866":114423},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3379":68810,"_29627":68751,"_20564":114425,"_5":14107,"_26947":114284,"_2866":114426},[],"SMTP, observabilidad y entrega de alertas",{"_3379":68811,"_29627":68751,"_20564":114428,"_5":14107,"_26947":114284,"_2866":114429},[],"las guías de actualización entre versiones y las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade, incluido el hook opcional de migración CA-to-KMS descrito arriba",{"_3379":68812,"_29627":68751,"_20564":114431,"_5":14107,"_26947":114284,"_2866":114432},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3379":68813,"_29627":68813,"_5":14459,"_2866":114434,"_29980":114435,"_20564":114436,"_26947":68813},"Expón el Gateway",[48237,113663,113897],[],{"_3379":68814,"_29627":68813,"_20564":114438,"_5":14107,"_26947":68813,"_2866":114439},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3379":68815,"_29627":68813,"_5":29977,"_20564":114441,"_26947":114442,"_2866":114443},[],"/docs/pr-preview/pr-55/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3379":68816,"_29627":68813,"_5":29977,"_20564":114445,"_26947":114446,"_2866":114447},[],"/docs/pr-preview/pr-55/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3379":68817,"_29627":68813,"_5":29977,"_20564":114449,"_26947":114450,"_2866":114451},[],"/docs/pr-preview/pr-55/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3379":68818,"_29627":68813,"_5":29977,"_20564":114453,"_26947":114454,"_2866":49063},[],"/docs/pr-preview/pr-55/es/deployment/self-hosted/networking#k3s",{"_3379":68819,"_29627":68813,"_5":29977,"_20564":114456,"_26947":114457,"_2866":114458},[],"/docs/pr-preview/pr-55/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3379":68820,"_29627":68813,"_5":29977,"_20564":114460,"_26947":114461,"_2866":114462},[],"/docs/pr-preview/pr-55/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3379":68821,"_29627":68813,"_5":29977,"_20564":114464,"_26947":114465,"_2866":114466},[],"/docs/pr-preview/pr-55/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3379":68822,"_29627":68813,"_5":29977,"_20564":114468,"_26947":114469,"_2866":114470},[],"/docs/pr-preview/pr-55/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3379":68823,"_29627":68813,"_5":29977,"_20564":114472,"_26947":114473,"_2866":114474},[],"/docs/pr-preview/pr-55/es/deployment/self-hosted/networking#proxy-de-salida","Proxy de salida",{"_3379":68824,"_29627":68813,"_5":29977,"_20564":114476,"_26947":114477,"_2866":114478},[],"/docs/pr-preview/pr-55/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3379":68825,"_29627":68813,"_20564":114480,"_5":14107,"_26947":114442,"_2866":114481},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3379":68826,"_29627":68813,"_20564":114483,"_5":14107,"_26947":114442,"_2866":114484},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3379":68827,"_29627":68813,"_20564":114486,"_5":14107,"_26947":114446,"_2866":114487},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3379":68828,"_29627":68813,"_20564":114489,"_5":14107,"_26947":114446,"_2866":114490},[],"Defínelo únicamente cuando:",{"_3379":68829,"_29627":68813,"_20564":114492,"_5":14107,"_26947":114446,"_2866":114493},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3379":68830,"_29627":68813,"_20564":114495,"_5":14107,"_26947":114446,"_2866":114496},[],"esa dirección está asignada a este Gateway",{"_3379":68831,"_29627":68813,"_20564":114498,"_5":14107,"_26947":114446,"_2866":114499},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3379":68832,"_29627":68813,"_20564":114501,"_5":14107,"_26947":114446,"_2866":114502},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3379":68833,"_29627":68813,"_20564":114504,"_5":14107,"_26947":114446,"_2866":114505},[],"No confundas estos valores:",{"_3379":68834,"_29627":68813,"_20564":114507,"_5":14107,"_26947":114446,"_2866":114508},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3379":68835,"_29627":68813,"_20564":114510,"_5":14107,"_26947":114446,"_2866":114511},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3379":68836,"_29627":68813,"_20564":114513,"_5":14107,"_26947":114446,"_2866":114514},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3379":68837,"_29627":68813,"_20564":114516,"_5":14107,"_26947":114450,"_2866":114517},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3379":68838,"_29627":68813,"_20564":114519,"_5":14107,"_26947":114450,"_2866":114520},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3379":68839,"_29627":68813,"_20564":114522,"_5":14107,"_26947":114454,"_2866":114523},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3379":68840,"_29627":68813,"_20564":114525,"_5":14107,"_26947":114454,"_2866":114526},[],"Para el diseño recomendado:",{"_3379":68841,"_29627":68813,"_20564":114528,"_5":14107,"_26947":114454,"_2866":114529},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3379":68842,"_29627":68813,"_20564":114531,"_5":14107,"_26947":114454,"_2866":114532},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3379":68843,"_29627":68813,"_20564":114534,"_5":14107,"_26947":114454,"_2866":114535},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3379":68844,"_29627":68813,"_20564":114537,"_5":14107,"_26947":114454,"_2866":114538},[],"Apunta DNS a la dirección accesible de la VM.",{"_3379":68845,"_29627":68813,"_20564":114540,"_5":14107,"_26947":114454,"_2866":114541},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3379":68846,"_29627":68813,"_20564":114543,"_5":14107,"_26947":114457,"_2866":114544},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3379":68847,"_29627":68813,"_20564":114546,"_5":14107,"_26947":114461,"_2866":114547},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3379":68848,"_29627":68813,"_20564":114549,"_5":14107,"_26947":114461,"_2866":114550},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3379":68849,"_29627":68813,"_20564":114552,"_5":14107,"_26947":114465,"_2866":114553},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3379":68850,"_29627":68813,"_20564":114555,"_5":14107,"_26947":114465,"_2866":114556},[],"Requisito",{"_3379":68851,"_29627":68813,"_20564":114558,"_5":14107,"_26947":114465,"_2866":114559},[],"Diseño recomendado",{"_3379":68852,"_29627":68813,"_20564":114561,"_5":14107,"_26947":114465,"_2866":114562},[],"Consecuencia",{"_3379":68853,"_29627":68813,"_20564":114564,"_5":14107,"_26947":114465,"_2866":114565},[],"Varias URL o servicios de Lamassu",{"_3379":68854,"_29627":68813,"_20564":114567,"_5":14107,"_26947":114465,"_2866":114568},[],"Un Gateway con varias rutas",{"_3379":68855,"_29627":68813,"_20564":114570,"_5":14107,"_26947":114465,"_2866":114571},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3379":68856,"_29627":68813,"_20564":114573,"_5":14107,"_26947":114465,"_2866":114574},[],"Gateways independientes e IP externas distintas",{"_3379":68857,"_29627":68813,"_20564":114576,"_5":14107,"_26947":114465,"_2866":114577},[],"Una VIP por Gateway",{"_3379":68858,"_29627":68813,"_20564":114579,"_5":14107,"_26947":114465,"_2866":114580},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3379":68859,"_29627":68813,"_20564":114582,"_5":14107,"_26947":114465,"_2866":114583},[],"Gateways independientes, un nodo y una IP",{"_3379":68860,"_29627":68813,"_20564":114585,"_5":14107,"_26947":114465,"_2866":114586},[],"Puertos externos diferentes",{"_3379":68861,"_29627":68813,"_20564":114588,"_5":14107,"_26947":114465,"_2866":114589},[],"Los clientes deben indicar puertos no estándar",{"_3379":68862,"_29627":68813,"_20564":114591,"_5":14107,"_26947":114465,"_2866":114592},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3379":68863,"_29627":68813,"_20564":114594,"_5":14107,"_26947":114465,"_2866":114595},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3379":68864,"_29627":68813,"_20564":114597,"_5":14107,"_26947":114465,"_2866":114598},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3379":68865,"_29627":68813,"_20564":114600,"_5":14107,"_26947":114465,"_2866":114601},[],"Recursos Gateway separados pero proxy compartido",{"_3379":68866,"_29627":68813,"_20564":114603,"_5":14107,"_26947":114465,"_2866":114604},[],"Modo merged Gateway de Envoy",{"_3379":68867,"_29627":68813,"_20564":114606,"_5":14107,"_26947":114465,"_2866":114607},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3379":68868,"_29627":68813,"_20564":114609,"_5":14107,"_26947":114465,"_2866":114610},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3379":68869,"_29627":68813,"_20564":114612,"_5":14107,"_26947":114465,"_2866":114613},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3379":68870,"_29627":68813,"_20564":114615,"_5":14107,"_26947":114465,"_2866":114616},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3379":68871,"_29627":68813,"_20564":114618,"_5":14107,"_26947":114465,"_2866":114619},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3379":68872,"_29627":68813,"_20564":114621,"_5":14107,"_26947":114469,"_2866":114622},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3379":68873,"_29627":68813,"_20564":114624,"_5":14107,"_26947":114469,"_2866":114625},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3379":68874,"_29627":68813,"_20564":114627,"_5":14107,"_26947":114469,"_2866":114628},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3379":68875,"_29627":68813,"_20564":114630,"_5":14107,"_26947":114469,"_2866":114631},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3379":68876,"_29627":68813,"_20564":114633,"_5":14107,"_26947":114469,"_2866":114634},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3379":68877,"_29627":68813,"_20564":114636,"_5":14107,"_26947":114473,"_2866":114637},[],"Los clientes internos de Lamassu — la conexión con el motor de Vault, las llamadas entre servicios y los webhooks salientes — respetan las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY`. La excepción es el conector del motor de autorización: usa su propio transporte y no consulta estas variables de proxy. Si tu despliegue enruta el tráfico de salida por un proxy, incluye los nombres de servicio internos del clúster en `NO_PROXY` (por ejemplo `.svc,.cluster.local`) para que el tráfico interno permanezca dentro del clúster. El tráfico de loopback nunca se envía por un proxy.",{"_3379":68878,"_29627":68813,"_20564":114639,"_5":14107,"_26947":114473,"_2866":114640},[],"El transporte predeterminado de estos clientes acota el timeout de conexión (30 segundos), el handshake TLS (10 segundos) y la reutilización de conexiones inactivas (90 segundos), de modo que una dependencia inalcanzable falla rápido en lugar de bloquearse; estos valores son los predeterminados del transporte de Go, no configuración de Lamassu. HTTP/2 se negocia cuando el otro extremo lo soporta. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada.",{"_3379":68879,"_29627":68813,"_20564":114642,"_5":14107,"_26947":114477,"_2866":114643},[],"Comprueba, en orden:",{"_3379":68880,"_29627":68813,"_20564":114645,"_5":14107,"_26947":114477,"_2866":114646},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3379":68881,"_29627":68813,"_20564":114648,"_5":14107,"_26947":114477,"_2866":114649},[],"Su estado contiene la dirección esperada.",{"_3379":68882,"_29627":68813,"_20564":114651,"_5":14107,"_26947":114477,"_2866":114652},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3379":68883,"_29627":68813,"_20564":114654,"_5":14107,"_26947":114477,"_2866":114655},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3379":68884,"_29627":68813,"_20564":114657,"_5":14107,"_26947":114477,"_2866":114658},[],"DNS resuelve al endpoint accesible externamente.",{"_3379":68885,"_29627":68813,"_20564":114660,"_5":14107,"_26947":114477,"_2866":114661},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3379":68886,"_29627":68813,"_20564":114663,"_5":14107,"_26947":114477,"_2866":114664},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3379":68887,"_29627":68887,"_5":14459,"_2866":48344,"_29980":114666,"_20564":114667,"_26947":68887},[48237,113663,113897],[],{"_3379":68888,"_29627":68887,"_20564":114669,"_5":14107,"_26947":68887,"_2866":114670},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3379":68889,"_29627":68887,"_5":29977,"_20564":114672,"_26947":114673,"_2866":114674},[],"/docs/pr-preview/pr-55/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3379":68890,"_29627":68887,"_5":29977,"_20564":114676,"_26947":114677,"_2866":114678},[],"/docs/pr-preview/pr-55/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3379":68891,"_29627":68887,"_5":29977,"_20564":114680,"_26947":114681,"_2866":114682},[],"/docs/pr-preview/pr-55/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3379":68892,"_29627":68887,"_5":29977,"_20564":114684,"_26947":114685,"_2866":114686},[],"/docs/pr-preview/pr-55/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3379":68893,"_29627":68887,"_5":29977,"_20564":114688,"_26947":114689,"_2866":114690},[],"/docs/pr-preview/pr-55/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3379":68894,"_29627":68887,"_5":29977,"_20564":114692,"_26947":114693,"_2866":114694},[],"/docs/pr-preview/pr-55/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3379":68895,"_29627":68887,"_20564":114696,"_5":14107,"_26947":114673,"_2866":114697},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3379":68896,"_29627":68887,"_20564":114699,"_5":14107,"_26947":114677,"_2866":114700},[],"Flujo",{"_3379":68897,"_29627":68887,"_20564":114702,"_5":14107,"_26947":114677,"_2866":114703},[],"Úsalo para",{"_3379":68898,"_29627":68887,"_20564":114705,"_5":14107,"_26947":114677,"_2866":114706},[],"Qué instala",{"_3379":68899,"_29627":68887,"_20564":114708,"_5":14107,"_26947":114677,"_2866":49318},[],{"_3379":68900,"_29627":68887,"_20564":114710,"_5":14107,"_26947":114677,"_2866":114711},[],"Producción y entornos controlados",{"_3379":68901,"_29627":68887,"_20564":114713,"_5":14107,"_26947":114677,"_2866":114714},[],"Servicios de Lamassu y recursos de Gateway API",{"_3379":68902,"_29627":68887,"_20564":114716,"_5":14107,"_26947":114677,"_2866":48481},[],{"_3379":68903,"_29627":68887,"_20564":114718,"_5":14107,"_26947":114677,"_2866":114719},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3379":68904,"_29627":68887,"_20564":114721,"_5":14107,"_26947":114677,"_2866":114722},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3379":68905,"_29627":68887,"_20564":114724,"_5":14107,"_26947":114681,"_2866":114725},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3379":68906,"_29627":68887,"_20564":114727,"_5":14107,"_26947":114681,"_2866":114728},[],"Área",{"_3379":68907,"_29627":68887,"_20564":114730,"_5":14107,"_26947":114681,"_2866":114731},[],"El chart de Lamassu proporciona",{"_3379":68908,"_29627":68887,"_20564":114733,"_5":14107,"_26947":114681,"_2866":114734},[],"Tú proporcionas",{"_3379":68909,"_29627":68887,"_20564":114736,"_5":14107,"_26947":114681,"_2866":114737},[],"Aplicaciones Lamassu",{"_3379":68910,"_29627":68887,"_20564":114739,"_5":14107,"_26947":114681,"_2866":114740},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3379":68911,"_29627":68887,"_20564":114742,"_5":14107,"_26947":114681,"_2866":114743},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3379":68912,"_29627":68887,"_20564":114745,"_5":14107,"_26947":114681,"_2866":114746},[],"Datos PostgreSQL",{"_3379":68913,"_29627":68887,"_20564":114748,"_5":14107,"_26947":114681,"_2866":114749},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3379":68914,"_29627":68887,"_20564":114751,"_5":14107,"_26947":114681,"_2866":114752},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3379":68915,"_29627":68887,"_20564":114754,"_5":14107,"_26947":114681,"_2866":114755},[],"Mensajería",{"_3379":68916,"_29627":68887,"_20564":114757,"_5":14107,"_26947":114681,"_2866":114758},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu; la conexión puede usar AMQPS, con una CA privada y un certificado de cliente opcionales, definidos mediante valores del chart",{"_3379":68917,"_29627":68887,"_20564":114760,"_5":14107,"_26947":114681,"_2866":114761},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3379":68918,"_29627":68887,"_20564":114763,"_5":14107,"_26947":114681,"_2866":114764},[],"Identidad",{"_3379":68919,"_29627":68887,"_20564":114766,"_5":14107,"_26947":114681,"_2866":114767},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3379":68920,"_29627":68887,"_20564":114769,"_5":14107,"_26947":114681,"_2866":114770},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3379":68921,"_29627":68887,"_20564":114772,"_5":14107,"_26947":114681,"_2866":114773},[],"Enrutamiento externo",{"_3379":68922,"_29627":68887,"_20564":114775,"_5":14107,"_26947":114681,"_2866":114776},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3379":68923,"_29627":68887,"_20564":114778,"_5":14107,"_26947":114681,"_2866":114779},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3379":68924,"_29627":68887,"_20564":114781,"_5":14107,"_26947":114681,"_2866":49392},[],{"_3379":68925,"_29627":68887,"_20564":114783,"_5":14107,"_26947":114681,"_2866":114784},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_3379":68926,"_29627":68887,"_20564":114786,"_5":14107,"_26947":114681,"_2866":114787},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3379":68927,"_29627":68887,"_20564":114789,"_5":14107,"_26947":114681,"_2866":114790},[],"Datos persistentes de la aplicación",{"_3379":68928,"_29627":68887,"_20564":114792,"_5":14107,"_26947":114681,"_2866":114793},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3379":68929,"_29627":68887,"_20564":114795,"_5":14107,"_26947":114681,"_2866":114796},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3379":68930,"_29627":68887,"_20564":114798,"_5":14107,"_26947":114681,"_2866":114799},[],"Integraciones opcionales",{"_3379":68931,"_29627":68887,"_20564":114801,"_5":14107,"_26947":114681,"_2866":114802},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3379":68932,"_29627":68887,"_20564":114804,"_5":14107,"_26947":114681,"_2866":114805},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3379":68933,"_29627":68887,"_20564":114807,"_5":14107,"_26947":114681,"_2866":114808},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3379":68934,"_29627":68887,"_20564":114810,"_5":14107,"_26947":114681,"_2866":114811},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3379":68935,"_29627":68887,"_20564":114813,"_5":14107,"_26947":114685,"_2866":114814},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3379":68936,"_29627":68887,"_20564":114816,"_5":14107,"_26947":114685,"_2866":114817},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3379":68937,"_29627":68887,"_20564":114819,"_5":14107,"_26947":114689,"_2866":114820},[],"Kubernetes 1.24 o posterior",{"_3379":68938,"_29627":68887,"_20564":114822,"_5":14107,"_26947":114689,"_2866":114823},[],"Helm 3.2 o posterior",{"_3379":68939,"_29627":68887,"_20564":114825,"_5":14107,"_26947":114689,"_2866":114826},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3379":68940,"_29627":68887,"_20564":114828,"_5":14107,"_26947":114689,"_2866":114829},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_3379":68941,"_29627":68887,"_20564":114831,"_5":14107,"_26947":114689,"_2866":114832},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3379":68942,"_29627":68887,"_20564":114834,"_5":14107,"_26947":114689,"_2866":114835},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3379":68943,"_29627":68887,"_20564":114837,"_5":14107,"_26947":114689,"_2866":114838},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3379":68944,"_29627":68887,"_20564":114840,"_5":14107,"_26947":114693,"_2866":114841},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3379":68945,"_29627":68887,"_20564":114843,"_5":14107,"_26947":114693,"_2866":114844},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3379":68946,"_29627":68887,"_20564":114846,"_5":14107,"_26947":114693,"_2866":114847},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3379":68947,"_29627":68887,"_20564":114849,"_5":14107,"_26947":114693,"_2866":114850},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3379":68948,"_29627":68948,"_5":14459,"_2866":114852,"_29980":114853,"_20564":114855,"_26947":68948},"Resolución de problemas de despliegue",[48237,113663,114854],"Operación",[],{"_3379":68949,"_29627":68948,"_20564":114857,"_5":14107,"_26947":68948,"_2866":114858},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3379":68950,"_29627":68948,"_5":29977,"_20564":114860,"_26947":114861,"_2866":114862},[],"/docs/pr-preview/pr-55/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3379":68951,"_29627":68948,"_5":29977,"_20564":114864,"_26947":114865,"_2866":114866},[],"/docs/pr-preview/pr-55/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3379":68952,"_29627":68948,"_5":29977,"_20564":114868,"_26947":114869,"_2866":114870},[],"/docs/pr-preview/pr-55/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3379":68953,"_29627":68948,"_5":29977,"_20564":114872,"_26947":114873,"_2866":114874},[],"/docs/pr-preview/pr-55/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3379":68954,"_29627":68948,"_5":29977,"_20564":114876,"_26947":114877,"_2866":114878},[],"/docs/pr-preview/pr-55/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3379":68955,"_29627":68948,"_5":29977,"_20564":114880,"_26947":114881,"_2866":114882},[],"/docs/pr-preview/pr-55/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3379":68956,"_29627":68948,"_5":29977,"_20564":114884,"_26947":114885,"_2866":114886},[],"/docs/pr-preview/pr-55/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3379":68957,"_29627":68948,"_5":29977,"_20564":114888,"_26947":114889,"_2866":114890},[],"/docs/pr-preview/pr-55/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3379":68958,"_29627":68948,"_5":29977,"_20564":114892,"_26947":114893,"_2866":114894},[],"/docs/pr-preview/pr-55/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3379":68959,"_29627":68948,"_5":29977,"_20564":114896,"_26947":114897,"_2866":114898},[],"/docs/pr-preview/pr-55/es/deployment/troubleshooting#errores-500-de-la-api","Errores 500 de la API",{"_3379":68960,"_29627":68948,"_5":29977,"_20564":114900,"_26947":114901,"_2866":114902},[],"/docs/pr-preview/pr-55/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3379":68961,"_29627":68948,"_5":29977,"_20564":114904,"_26947":114905,"_2866":114906},[],"/docs/pr-preview/pr-55/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3379":68962,"_29627":68948,"_5":29977,"_20564":114908,"_26947":114909,"_2866":114910},[],"/docs/pr-preview/pr-55/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3379":68963,"_29627":68948,"_20564":114912,"_5":14107,"_26947":68948,"_2866":114913},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3379":68964,"_29627":68948,"_20564":114915,"_5":14107,"_26947":114865,"_2866":114916},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3379":68965,"_29627":68948,"_20564":114918,"_5":14107,"_26947":114869,"_2866":114919},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3379":68966,"_29627":68948,"_20564":114921,"_5":14107,"_26947":114873,"_2866":114922},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3379":68967,"_29627":68948,"_20564":114924,"_5":14107,"_26947":114877,"_2866":114925},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3379":68968,"_29627":68948,"_20564":114927,"_5":14107,"_26947":114881,"_2866":114928},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3379":68969,"_29627":68948,"_20564":114930,"_5":14107,"_26947":114885,"_2866":114931},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3379":68970,"_29627":68948,"_20564":114933,"_5":14107,"_26947":114885,"_2866":114934},[],"Ejecuta también la prueba de conectividad del chart:",{"_3379":68971,"_29627":68948,"_20564":114936,"_5":14107,"_26947":114885,"_2866":114937},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3379":68972,"_29627":68948,"_20564":114939,"_5":14107,"_26947":114885,"_2866":114940},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3379":68973,"_29627":68948,"_20564":114942,"_5":14107,"_26947":114889,"_2866":114943},[],"Si recibes un 401:",{"_3379":68974,"_29627":68948,"_20564":114945,"_5":14107,"_26947":114889,"_2866":114946},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3379":68975,"_29627":68948,"_20564":114948,"_5":14107,"_26947":114889,"_2866":114949},[],"verifica emisor, audiencia y expiración del token;",{"_3379":68976,"_29627":68948,"_20564":114951,"_5":14107,"_26947":114889,"_2866":114952},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3379":68977,"_29627":68948,"_20564":114954,"_5":14107,"_26947":114889,"_2866":114955},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3379":68978,"_29627":68948,"_20564":114957,"_5":14107,"_26947":114889,"_2866":114958},[],"Si el login termina pero las APIs devuelven 403:",{"_3379":68979,"_29627":68948,"_20564":114960,"_5":14107,"_26947":114889,"_2866":114961},[],"inspecciona los claims reales del token;",{"_3379":68980,"_29627":68948,"_20564":114963,"_5":14107,"_26947":114889,"_2866":114964},[],"confirma que coinciden con un principal activo;",{"_3379":68981,"_29627":68948,"_20564":114966,"_5":14107,"_26947":114889,"_2866":114967},[],"revisa las políticas concedidas al principal;",{"_3379":68982,"_29627":68948,"_20564":114969,"_5":14107,"_26947":114889,"_2866":114970},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3379":68983,"_29627":68948,"_20564":114972,"_5":14107,"_26947":114889,"_2866":114973},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3379":68984,"_29627":68948,"_20564":114975,"_5":14107,"_26947":114893,"_2866":114976},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3379":68985,"_29627":68948,"_20564":114978,"_5":14107,"_26947":114893,"_2866":114979},[],"Localiza el pod y Service de authz.",{"_3379":68986,"_29627":68948,"_20564":114981,"_5":14107,"_26947":114893,"_2866":114982},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3379":68987,"_29627":68948,"_20564":114984,"_5":14107,"_26947":114893,"_2866":114985},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3379":68988,"_29627":68948,"_20564":114987,"_5":14107,"_26947":114893,"_2866":114988},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3379":68989,"_29627":68948,"_20564":114990,"_5":14107,"_26947":114893,"_2866":114991},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3379":68990,"_29627":68948,"_20564":114993,"_5":14107,"_26947":114897,"_2866":114994},[],"Un 500 indica un fallo interno, como una base de datos no disponible. El cuerpo `{\"err\": ...}` incluye hoy el texto del error interno, que puede contener nombres de esquema, tabla y restricción y, en fallos de conexión, el host y el usuario de la base de datos (no la contraseña). Localiza la causa en el log del servicio con la hora de la petición, y no reenvíes el cuerpo a terceros ni lo muestres a usuarios finales. Es un defecto conocido de divulgación de información: está previsto devolver un mensaje genérico en los 500 y dejar el detalle solo en el log del servicio (seguimiento en lamassuiot#814). El conector de autorización también devuelve el error interno, en el campo `details.error`. Algunos errores de petición, como un tamaño de clave que el motor no admite, se devuelven también como 500.",{"_3379":68991,"_29627":68948,"_20564":114996,"_5":14107,"_26947":114901,"_2866":114997},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3379":68992,"_29627":68948,"_20564":114999,"_5":14107,"_26947":114901,"_2866":115000},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3379":68993,"_29627":68948,"_20564":115002,"_5":14107,"_26947":114901,"_2866":115003},[],"un Secret de CA o de certificado de cliente de AMQP inexistente referenciado por `amqp.ca.secretName` o `amqp.client.secretName`;",{"_3379":68994,"_29627":68948,"_20564":115005,"_5":14107,"_26947":114901,"_2866":115006},[],"volumen persistente sin enlazar;",{"_3379":68995,"_29627":68948,"_20564":115008,"_5":14107,"_26947":114901,"_2866":115009},[],"imagen inaccesible o política de pull incorrecta;",{"_3379":68996,"_29627":68948,"_20564":115011,"_5":14107,"_26947":114901,"_2866":115012},[],"configuración inválida del motor criptográfico;",{"_3379":68997,"_29627":68948,"_20564":115014,"_5":14107,"_26947":114901,"_2866":115015},[],"límites de CPU o memoria demasiado bajos;",{"_3379":68998,"_29627":68948,"_20564":115017,"_5":14107,"_26947":114901,"_2866":115018},[],"migración previa incompleta.",{"_3379":68999,"_29627":68948,"_20564":115020,"_5":14107,"_26947":114901,"_2866":115021},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3379":69000,"_29627":68948,"_20564":115023,"_5":14107,"_26947":114901,"_2866":115024},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3379":69001,"_29627":68948,"_20564":115026,"_5":14107,"_26947":114901,"_2866":115027},[],"Las llamadas internas ahora fallan rápido en lugar de bloquearse para los clientes cubiertos por Proxy de salida: los intentos de conexión agotan el tiempo tras 30 segundos y los handshakes TLS tras 10 segundos. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada. Si un proxy de salida gestiona el tráfico de salida del clúster, comprueba las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY` del pod e incluye los nombres de servicio internos en `NO_PROXY`.",{"_3379":69002,"_29627":68948,"_20564":115029,"_5":14107,"_26947":114905,"_2866":115030},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3379":69003,"_29627":68948,"_20564":115032,"_5":14107,"_26947":114905,"_2866":115033},[],"verifica que esté habilitado en el servicio emisor;",{"_3379":69004,"_29627":68948,"_20564":115035,"_5":14107,"_26947":114905,"_2866":115036},[],"comprueba conectividad y credenciales AMQP;",{"_3379":69005,"_29627":68948,"_20564":115038,"_5":14107,"_26947":114905,"_2866":115039},[],"revisa exchange, routing key, colas y consumidores;",{"_3379":69006,"_29627":68948,"_20564":115041,"_5":14107,"_26947":114905,"_2866":115042},[],"inspecciona dead-letter queues;",{"_3379":69007,"_29627":68948,"_20564":115044,"_5":14107,"_26947":114905,"_2866":115045},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3379":69008,"_29627":68948,"_20564":115047,"_5":14107,"_26947":114905,"_2866":115048},[],"Si `amqp.tls` está habilitado, revisa también la parte TLS:",{"_3379":69009,"_29627":68948,"_20564":115050,"_5":14107,"_26947":114905,"_2866":115051},[],"confirma que el listener del broker hable AMQPS en el puerto configurado — el puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS;",{"_3379":69010,"_29627":68948,"_20564":115053,"_5":14107,"_26947":114905,"_2866":115054},[],"si defines `amqp.ca.secretName`, confirma que el Secret exista en el namespace del release y que su clave de datos coincida con `amqp.ca.certificateKey` (por defecto `ca.crt`); si no defines `amqp.ca.secretName`, los clientes confían en las CA del sistema;",{"_3379":69011,"_29627":68948,"_20564":115056,"_5":14107,"_26947":114905,"_2866":115057},[],"recuerda que un Secret referenciado inexistente impide arrancar los pods consumidores;",{"_3379":69012,"_29627":68948,"_20564":115059,"_5":14107,"_26947":114905,"_2866":115060},[],"tras actualizar el Secret de la CA o del certificado de cliente, reinicia los pods consumidores: el cliente AMQP carga los certificados al arrancar.",{"_3379":69013,"_29627":68948,"_20564":115062,"_5":14107,"_26947":114905,"_2866":115063},[],"Consulta TLS de AMQP (AMQPS) para la configuración completa.",{"_3379":69014,"_29627":68948,"_20564":115065,"_5":14107,"_26947":114905,"_2866":115066},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3379":69015,"_29627":68948,"_20564":115068,"_5":14107,"_26947":114909,"_2866":115069},[],"El chart puede habilitar la instrumentación OpenTelemetry para los servicios que la admiten, incluido authz; no configura OpenTelemetry para el AWS Connector, wfx ni la UI. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, servicio y dependencia.",{"_3379":69016,"_29627":68948,"_20564":115071,"_5":14107,"_26947":114909,"_2866":115072},[],"Antes de cerrar una incidencia, guarda:",{"_3379":69017,"_29627":68948,"_20564":115074,"_5":14107,"_26947":114909,"_2866":115075},[],"causa confirmada;",{"_3379":69018,"_29627":68948,"_20564":115077,"_5":14107,"_26947":114909,"_2866":115078},[],"alcance temporal y recursos afectados;",{"_3379":69019,"_29627":68948,"_20564":115080,"_5":14107,"_26947":114909,"_2866":115081},[],"comandos o consultas utilizados;",{"_3379":69020,"_29627":68948,"_20564":115083,"_5":14107,"_26947":114909,"_2866":115084},[],"cambio aplicado y forma de revertirlo;",{"_3379":69021,"_29627":68948,"_20564":115086,"_5":14107,"_26947":114909,"_2866":115087},[],"validación desde un consumidor;",{"_3379":69022,"_29627":68948,"_20564":115089,"_5":14107,"_26947":114909,"_2866":115090},[],"acción preventiva y propietario.",{"_3379":69023,"_29627":69023,"_5":14459,"_2866":115092,"_29980":115093,"_20564":115096,"_26947":69023},"Control de acceso",[48237,115094,115095],"Plataforma","Administración",[],{"_3379":69024,"_29627":69023,"_20564":115098,"_5":14107,"_26947":69023,"_2866":115099},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3379":69025,"_29627":69023,"_5":29977,"_20564":115101,"_26947":115102,"_2866":115103},[],"/docs/pr-preview/pr-55/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3379":69026,"_29627":69023,"_5":29977,"_20564":115105,"_26947":115106,"_2866":115107},[],"/docs/pr-preview/pr-55/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3379":69027,"_29627":69023,"_5":29977,"_20564":115109,"_26947":115110,"_2866":115111},[],"/docs/pr-preview/pr-55/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3379":69028,"_29627":69023,"_5":29977,"_20564":115113,"_26947":115114,"_2866":115115},[],"/docs/pr-preview/pr-55/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3379":69029,"_29627":69023,"_5":29977,"_20564":115117,"_26947":115118,"_2866":115119},[],"/docs/pr-preview/pr-55/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3379":69030,"_29627":69023,"_5":29977,"_20564":115121,"_26947":115122,"_2866":115123},[],"/docs/pr-preview/pr-55/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3379":69031,"_29627":69023,"_5":29977,"_20564":115125,"_26947":115126,"_2866":115127},[],"/docs/pr-preview/pr-55/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3379":69032,"_29627":69023,"_5":29977,"_20564":115129,"_26947":115130,"_2866":115131},[],"/docs/pr-preview/pr-55/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3379":69033,"_29627":69023,"_5":29977,"_20564":115133,"_26947":115134,"_2866":115135},[],"/docs/pr-preview/pr-55/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3379":69034,"_29627":69023,"_5":29977,"_20564":115137,"_26947":115138,"_2866":115139},[],"/docs/pr-preview/pr-55/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3379":69035,"_29627":69023,"_5":29977,"_20564":115141,"_26947":115142,"_2866":115143},[],"/docs/pr-preview/pr-55/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3379":69036,"_29627":69023,"_5":29977,"_20564":115145,"_26947":115146,"_2866":115147},[],"/docs/pr-preview/pr-55/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3379":69037,"_29627":69023,"_5":29977,"_20564":115149,"_26947":115150,"_2866":115151},[],"/docs/pr-preview/pr-55/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3379":69038,"_29627":69023,"_5":29977,"_20564":115153,"_26947":115154,"_2866":115155},[],"/docs/pr-preview/pr-55/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3379":69039,"_29627":69023,"_5":29977,"_20564":115157,"_26947":115158,"_2866":115159},[],"/docs/pr-preview/pr-55/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3379":69040,"_29627":69023,"_5":29977,"_20564":115161,"_26947":115162,"_2866":114269},[],"/docs/pr-preview/pr-55/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3379":69041,"_29627":69023,"_5":29977,"_20564":115164,"_26947":115165,"_2866":115166},[],"/docs/pr-preview/pr-55/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3379":69042,"_29627":69023,"_5":29977,"_20564":115168,"_26947":115169,"_2866":115170},[],"/docs/pr-preview/pr-55/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_3379":69043,"_29627":69023,"_5":29977,"_20564":115172,"_26947":115173,"_2866":115174},[],"/docs/pr-preview/pr-55/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3379":69044,"_29627":69023,"_5":29977,"_20564":115176,"_26947":115177,"_2866":115178},[],"/docs/pr-preview/pr-55/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3379":69045,"_29627":69023,"_5":29977,"_20564":115180,"_26947":115181,"_2866":115182},[],"/docs/pr-preview/pr-55/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3379":69046,"_29627":69023,"_5":29977,"_20564":115184,"_26947":115185,"_2866":115186},[],"/docs/pr-preview/pr-55/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3379":69047,"_29627":69023,"_5":29977,"_20564":115188,"_26947":115189,"_2866":115190},[],"/docs/pr-preview/pr-55/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3379":69048,"_29627":69023,"_5":29977,"_20564":115192,"_26947":115193,"_2866":115194},[],"/docs/pr-preview/pr-55/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3379":69049,"_29627":69023,"_5":29977,"_20564":115196,"_26947":115197,"_2866":115198},[],"/docs/pr-preview/pr-55/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3379":69050,"_29627":69023,"_5":29977,"_20564":115200,"_26947":115201,"_2866":115202},[],"/docs/pr-preview/pr-55/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3379":69051,"_29627":69023,"_5":29977,"_20564":115204,"_26947":115205,"_2866":115206},[],"/docs/pr-preview/pr-55/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3379":69052,"_29627":69023,"_5":29977,"_20564":115208,"_26947":115209,"_2866":115210},[],"/docs/pr-preview/pr-55/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3379":69053,"_29627":69023,"_5":29977,"_20564":115212,"_26947":115213,"_2866":115214},[],"/docs/pr-preview/pr-55/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3379":69054,"_29627":69023,"_5":29977,"_20564":115216,"_26947":115217,"_2866":115218},[],"/docs/pr-preview/pr-55/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3379":69055,"_29627":69023,"_5":29977,"_20564":115220,"_26947":115221,"_2866":115222},[],"/docs/pr-preview/pr-55/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3379":69056,"_29627":69023,"_20564":115224,"_5":14107,"_26947":69023,"_2866":115225},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3379":69057,"_29627":69023,"_20564":115227,"_5":14107,"_26947":69023,"_2866":115228},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3379":69058,"_29627":69023,"_20564":115230,"_5":14107,"_26947":69023,"_2866":115231},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3379":69059,"_29627":69023,"_20564":115233,"_5":14107,"_26947":115102,"_2866":115234},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3379":69060,"_29627":69023,"_20564":115236,"_5":14107,"_26947":115102,"_2866":115237},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3379":69061,"_29627":69023,"_20564":115239,"_5":14107,"_26947":115102,"_2866":115240},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3379":69062,"_29627":69023,"_20564":115242,"_5":14107,"_26947":115102,"_2866":115243},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3379":69063,"_29627":69023,"_20564":115245,"_5":14107,"_26947":115102,"_2866":115246},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3379":69064,"_29627":69023,"_20564":115248,"_5":14107,"_26947":115102,"_2866":115249},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3379":69065,"_29627":69023,"_20564":115251,"_5":14107,"_26947":115106,"_2866":115252},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3379":69066,"_29627":69023,"_20564":115254,"_5":14107,"_26947":115106,"_2866":115255},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3379":69067,"_29627":69023,"_20564":115257,"_5":14107,"_26947":115110,"_2866":115258},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3379":69068,"_29627":69023,"_20564":115260,"_5":14107,"_26947":115110,"_2866":115261},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3379":69069,"_29627":69023,"_20564":115263,"_5":14107,"_26947":115110,"_2866":115264},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3379":69070,"_29627":69023,"_20564":115266,"_5":14107,"_26947":115110,"_2866":115267},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3379":69071,"_29627":69023,"_20564":115269,"_5":14107,"_26947":115110,"_2866":115270},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3379":69072,"_29627":69023,"_20564":115272,"_5":14107,"_26947":115110,"_2866":115273},[],"Carga por separado las políticas concedidas a cada principal.",{"_3379":69073,"_29627":69023,"_20564":115275,"_5":14107,"_26947":115110,"_2866":115276},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3379":69074,"_29627":69023,"_20564":115278,"_5":14107,"_26947":115110,"_2866":115279},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3379":69075,"_29627":69023,"_20564":115281,"_5":14107,"_26947":115110,"_2866":115282},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3379":69076,"_29627":69023,"_20564":115284,"_5":14107,"_26947":115110,"_2866":115285},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3379":69077,"_29627":69023,"_20564":115287,"_5":14107,"_26947":115110,"_2866":115288},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad.",{"_3379":69078,"_29627":69023,"_20564":115290,"_5":14107,"_26947":115110,"_2866":115291},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3379":69079,"_29627":69023,"_20564":115293,"_5":14107,"_26947":115114,"_2866":115294},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3379":69080,"_29627":69023,"_20564":115296,"_5":14107,"_26947":115114,"_2866":115297},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3379":69081,"_29627":69023,"_20564":115299,"_5":14107,"_26947":115114,"_2866":115300},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3379":69082,"_29627":69023,"_20564":115302,"_5":14107,"_26947":115114,"_2866":115303},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3379":69083,"_29627":69023,"_20564":115305,"_5":14107,"_26947":115114,"_2866":115306},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3379":69084,"_29627":69023,"_20564":115308,"_5":14107,"_26947":115114,"_2866":115309},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3379":69085,"_29627":69023,"_20564":115311,"_5":14107,"_26947":115114,"_2866":115312},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3379":69086,"_29627":69023,"_20564":115314,"_5":14107,"_26947":115114,"_2866":115315},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3379":69087,"_29627":69023,"_20564":115317,"_5":14107,"_26947":115118,"_2866":115318},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3379":69088,"_29627":69023,"_20564":115320,"_5":14107,"_26947":115118,"_2866":115321},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3379":69089,"_29627":69023,"_20564":115323,"_5":14107,"_26947":115118,"_2866":115324},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3379":69090,"_29627":69023,"_20564":115326,"_5":14107,"_26947":115118,"_2866":115327},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3379":69091,"_29627":69023,"_20564":115329,"_5":14107,"_26947":115118,"_2866":115330},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3379":69092,"_29627":69023,"_20564":115332,"_5":14107,"_26947":115118,"_2866":115333},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3379":69093,"_29627":69023,"_20564":115335,"_5":14107,"_26947":115118,"_2866":115336},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3379":69094,"_29627":69023,"_20564":115338,"_5":14107,"_26947":115118,"_2866":115339},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3379":69095,"_29627":69023,"_20564":115341,"_5":14107,"_26947":115118,"_2866":115342},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3379":69096,"_29627":69023,"_20564":115344,"_5":14107,"_26947":115118,"_2866":115345},[],"Las acciones se dividen en dos grupos:",{"_3379":69097,"_29627":69023,"_20564":115347,"_5":14107,"_26947":115118,"_2866":115348},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3379":69098,"_29627":69023,"_20564":115350,"_5":14107,"_26947":115118,"_2866":115351},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3379":69099,"_29627":69023,"_20564":115353,"_5":14107,"_26947":115118,"_2866":115354},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3379":69100,"_29627":69023,"_20564":115356,"_5":14107,"_26947":115122,"_2866":115357},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3379":69101,"_29627":69023,"_20564":115359,"_5":14107,"_26947":115122,"_2866":115360},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3379":69102,"_29627":69023,"_20564":115362,"_5":14107,"_26947":115122,"_2866":115363},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3379":69103,"_29627":69023,"_20564":115365,"_5":14107,"_26947":115126,"_2866":115366},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3379":69104,"_29627":69023,"_20564":115368,"_5":14107,"_26947":115126,"_2866":115369},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3379":69105,"_29627":69023,"_20564":115371,"_5":14107,"_26947":115126,"_2866":115372},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3379":69106,"_29627":69023,"_20564":115374,"_5":14107,"_26947":115126,"_2866":115375},[],"Los operadores implementados son:",{"_3379":69107,"_29627":69023,"_20564":115377,"_5":14107,"_26947":115126,"_2866":115378},[],"`equals`, para igualdad exacta;",{"_3379":69108,"_29627":69023,"_20564":115380,"_5":14107,"_26947":115126,"_2866":115381},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3379":69109,"_29627":69023,"_20564":115383,"_5":14107,"_26947":115126,"_2866":115384},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3379":69110,"_29627":69023,"_20564":115386,"_5":14107,"_26947":115126,"_2866":115387},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3379":69111,"_29627":69023,"_20564":115389,"_5":14107,"_26947":115130,"_2866":115390},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3379":69112,"_29627":69023,"_20564":115392,"_5":14107,"_26947":115130,"_2866":115393},[],"Los modos disponibles son:",{"_3379":69113,"_29627":69023,"_20564":115395,"_5":14107,"_26947":115130,"_2866":115396},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3379":69114,"_29627":69023,"_20564":115398,"_5":14107,"_26947":115130,"_2866":115399},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3379":69115,"_29627":69023,"_20564":115401,"_5":14107,"_26947":115130,"_2866":115402},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3379":69116,"_29627":69023,"_20564":115404,"_5":14107,"_26947":115130,"_2866":115405},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3379":69117,"_29627":69023,"_20564":115407,"_5":14107,"_26947":115130,"_2866":115408},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3379":69118,"_29627":69023,"_20564":115410,"_5":14107,"_26947":115130,"_2866":115411},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3379":69119,"_29627":69023,"_20564":115413,"_5":14107,"_26947":115134,"_2866":115414},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3379":69120,"_29627":69023,"_20564":115416,"_5":14107,"_26947":115134,"_2866":115417},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3379":69121,"_29627":69023,"_20564":115419,"_5":14107,"_26947":115134,"_2866":115420},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3379":69122,"_29627":69023,"_20564":115422,"_5":14107,"_26947":115134,"_2866":115423},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3379":69123,"_29627":69023,"_20564":115425,"_5":14107,"_26947":115142,"_2866":115426},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3379":69124,"_29627":69023,"_20564":115428,"_5":14107,"_26947":115142,"_2866":115429},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3379":69125,"_29627":69023,"_20564":115431,"_5":14107,"_26947":115146,"_2866":115432},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora y la de un dispositivo con su DMS. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3379":69126,"_29627":69023,"_20564":115434,"_5":14107,"_26947":115146,"_2866":115435},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3379":69127,"_29627":69023,"_20564":115437,"_5":14107,"_26947":115150,"_2866":115438},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3379":69128,"_29627":69023,"_20564":115440,"_5":14107,"_26947":115150,"_2866":115441},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3379":69129,"_29627":69023,"_20564":115443,"_5":14107,"_26947":115150,"_2866":115444},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3379":69130,"_29627":69023,"_20564":115446,"_5":14107,"_26947":115154,"_2866":115447},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3379":69131,"_29627":69023,"_20564":115449,"_5":14107,"_26947":115154,"_2866":115450},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3379":69132,"_29627":69023,"_20564":115452,"_5":14107,"_26947":115154,"_2866":115453},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3379":69133,"_29627":69023,"_20564":115455,"_5":14107,"_26947":115154,"_2866":115456},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3379":69134,"_29627":69023,"_20564":115458,"_5":14107,"_26947":115154,"_2866":115459},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3379":69135,"_29627":69023,"_20564":115461,"_5":14107,"_26947":115154,"_2866":115462},[],"Ten en cuenta que:",{"_3379":69136,"_29627":69023,"_20564":115464,"_5":14107,"_26947":115154,"_2866":115465},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3379":69137,"_29627":69023,"_20564":115467,"_5":14107,"_26947":115154,"_2866":115468},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3379":69138,"_29627":69023,"_20564":115470,"_5":14107,"_26947":115154,"_2866":115471},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3379":69139,"_29627":69023,"_20564":115473,"_5":14107,"_26947":115158,"_2866":115474},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3379":69140,"_29627":69023,"_20564":115476,"_5":14107,"_26947":115158,"_2866":115477},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3379":69141,"_29627":69023,"_20564":115479,"_5":14107,"_26947":115158,"_2866":115480},[],"acceso completo y de solo lectura a KMS;",{"_3379":69142,"_29627":69023,"_20564":115482,"_5":14107,"_26947":115158,"_2866":115483},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3379":69143,"_29627":69023,"_20564":115485,"_5":14107,"_26947":115158,"_2866":115486},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3379":69144,"_29627":69023,"_20564":115488,"_5":14107,"_26947":115158,"_2866":115489},[],"acceso a la interfaz;",{"_3379":69145,"_29627":69023,"_20564":115491,"_5":14107,"_26947":115158,"_2866":115492},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3379":69146,"_29627":69023,"_20564":115494,"_5":14107,"_26947":115158,"_2866":115495},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3379":69147,"_29627":69023,"_20564":115497,"_5":14107,"_26947":115158,"_2866":115498},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3379":69148,"_29627":69023,"_20564":115500,"_5":14107,"_26947":115162,"_2866":115501},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3379":69149,"_29627":69023,"_20564":115503,"_5":14107,"_26947":115162,"_2866":115504},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3379":69150,"_29627":69023,"_20564":115506,"_5":14107,"_26947":115162,"_2866":115507},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3379":69151,"_29627":69023,"_20564":115509,"_5":14107,"_26947":115165,"_2866":115510},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3379":69152,"_29627":69023,"_20564":115512,"_5":14107,"_26947":115169,"_2866":115513},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_3379":69153,"_29627":69023,"_20564":115515,"_5":14107,"_26947":115169,"_2866":115516},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_3379":69154,"_29627":69023,"_20564":115518,"_5":14107,"_26947":115173,"_2866":115519},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3379":69155,"_29627":69023,"_20564":115521,"_5":14107,"_26947":115177,"_2866":115522},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3379":69156,"_29627":69023,"_20564":115524,"_5":14107,"_26947":115181,"_2866":115525},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3379":69157,"_29627":69023,"_20564":115527,"_5":14107,"_26947":115185,"_2866":115528},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3379":69158,"_29627":69023,"_20564":115530,"_5":14107,"_26947":115185,"_2866":115531},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3379":69159,"_29627":69023,"_20564":115533,"_5":14107,"_26947":115189,"_2866":115534},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3379":69160,"_29627":69023,"_20564":115536,"_5":14107,"_26947":115189,"_2866":115537},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3379":69161,"_29627":69023,"_20564":115539,"_5":14107,"_26947":115189,"_2866":115540},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3379":69162,"_29627":69023,"_20564":115542,"_5":14107,"_26947":115189,"_2866":115543},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3379":69163,"_29627":69023,"_20564":115545,"_5":14107,"_26947":115189,"_2866":115546},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3379":69164,"_29627":69023,"_20564":115548,"_5":14107,"_26947":115189,"_2866":115549},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3379":69165,"_29627":69023,"_20564":115551,"_5":14107,"_26947":115189,"_2866":115552},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3379":69166,"_29627":69023,"_20564":115554,"_5":14107,"_26947":115189,"_2866":115555},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3379":69167,"_29627":69023,"_20564":115557,"_5":14107,"_26947":115193,"_2866":115558},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3379":69168,"_29627":69023,"_20564":115560,"_5":14107,"_26947":115193,"_2866":115561},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3379":69169,"_29627":69023,"_20564":115563,"_5":14107,"_26947":115193,"_2866":115564},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3379":69170,"_29627":69023,"_20564":115566,"_5":14107,"_26947":115197,"_2866":115567},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3379":69171,"_29627":69023,"_20564":115569,"_5":14107,"_26947":115197,"_2866":115570},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3379":69172,"_29627":69023,"_20564":115572,"_5":14107,"_26947":115197,"_2866":115573},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3379":69173,"_29627":69023,"_20564":115575,"_5":14107,"_26947":115197,"_2866":115576},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3379":69174,"_29627":69023,"_20564":115578,"_5":14107,"_26947":115197,"_2866":115579},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3379":69175,"_29627":69023,"_20564":115581,"_5":14107,"_26947":115197,"_2866":115582},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3379":69176,"_29627":69023,"_20564":115584,"_5":14107,"_26947":115197,"_2866":115585},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3379":69177,"_29627":69023,"_20564":115587,"_5":14107,"_26947":115197,"_2866":115588},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3379":69178,"_29627":69023,"_20564":115590,"_5":14107,"_26947":115205,"_2866":115591},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3379":69179,"_29627":69023,"_20564":115593,"_5":14107,"_26947":115209,"_2866":115594},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3379":69180,"_29627":69023,"_20564":115596,"_5":14107,"_26947":115209,"_2866":115597},[],"que exista un principal activo del tipo correcto;",{"_3379":69181,"_29627":69023,"_20564":115599,"_5":14107,"_26947":115209,"_2866":115600},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3379":69182,"_29627":69023,"_20564":115602,"_5":14107,"_26947":115209,"_2866":115603},[],"que todas las condiciones del principal se cumplan;",{"_3379":69183,"_29627":69023,"_20564":115605,"_5":14107,"_26947":115209,"_2866":115606},[],"que el principal tenga concedida la política esperada;",{"_3379":69184,"_29627":69023,"_20564":115608,"_5":14107,"_26947":115209,"_2866":115609},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3379":69185,"_29627":69023,"_20564":115611,"_5":14107,"_26947":115209,"_2866":115612},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3379":69186,"_29627":69023,"_20564":115614,"_5":14107,"_26947":115209,"_2866":115615},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con las trazas OpenTelemetry habilitadas, una solicitud que llega al motor de políticas genera un span `engine.CheckHTTPRequest` cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente. Para correlacionarlo con la traza del Gateway, el contexto de traza debe propagarse hasta authz.",{"_3379":69187,"_29627":69023,"_20564":115617,"_5":14107,"_26947":115213,"_2866":115618},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3379":69188,"_29627":69023,"_20564":115620,"_5":14107,"_26947":115217,"_2866":115621},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3379":69189,"_29627":69023,"_20564":115623,"_5":14107,"_26947":115221,"_2866":115624},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3379":69190,"_29627":69023,"_20564":115626,"_5":14107,"_26947":115221,"_2866":115627},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3379":69191,"_29627":69191,"_5":14459,"_2866":115629,"_29980":115630,"_20564":115631,"_26947":69191},"Alertas y suscripciones",[48237,115094,115095],[],{"_3379":69192,"_29627":69191,"_20564":115633,"_5":14107,"_26947":69191,"_2866":115634},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3379":69193,"_29627":69191,"_5":29977,"_20564":115636,"_26947":115637,"_2866":115638},[],"/docs/pr-preview/pr-55/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3379":69194,"_29627":69191,"_5":29977,"_20564":115640,"_26947":115641,"_2866":115642},[],"/docs/pr-preview/pr-55/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3379":69195,"_29627":69191,"_5":29977,"_20564":115644,"_26947":115645,"_2866":115646},[],"/docs/pr-preview/pr-55/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3379":69196,"_29627":69191,"_5":29977,"_20564":115648,"_26947":115649,"_2866":115650},[],"/docs/pr-preview/pr-55/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3379":69197,"_29627":69191,"_5":29977,"_20564":115652,"_26947":115653,"_2866":115654},[],"/docs/pr-preview/pr-55/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3379":69198,"_29627":69191,"_5":29977,"_20564":115656,"_26947":115657,"_2866":115658},[],"/docs/pr-preview/pr-55/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3379":69199,"_29627":69191,"_5":29977,"_20564":115660,"_26947":115661,"_2866":115662},[],"/docs/pr-preview/pr-55/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3379":69200,"_29627":69191,"_5":29977,"_20564":115664,"_26947":115665,"_2866":115666},[],"/docs/pr-preview/pr-55/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","Configura el cliente HTTP del webhook",{"_3379":69201,"_29627":69191,"_5":29977,"_20564":115668,"_26947":115669,"_2866":115670},[],"/docs/pr-preview/pr-55/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3379":69202,"_29627":69191,"_5":29977,"_20564":115672,"_26947":115673,"_2866":115674},[],"/docs/pr-preview/pr-55/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3379":69203,"_29627":69191,"_5":29977,"_20564":115676,"_26947":115677,"_2866":115678},[],"/docs/pr-preview/pr-55/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3379":69204,"_29627":69191,"_20564":115680,"_5":14107,"_26947":69191,"_2866":115681},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3379":69205,"_29627":69191,"_20564":115683,"_5":14107,"_26947":115637,"_2866":115684},[],"Un servicio publica un evento de dominio.",{"_3379":69206,"_29627":69191,"_20564":115686,"_5":14107,"_26947":115637,"_2866":115687},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3379":69207,"_29627":69191,"_20564":115689,"_5":14107,"_26947":115637,"_2866":115690},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3379":69208,"_29627":69191,"_20564":115692,"_5":14107,"_26947":115637,"_2866":115693},[],"Lamassu entrega el evento al canal configurado.",{"_3379":69209,"_29627":69191,"_20564":115695,"_5":14107,"_26947":115637,"_2866":115696},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3379":69210,"_29627":69191,"_20564":115698,"_5":14107,"_26947":115641,"_2866":115699},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3379":69211,"_29627":69191,"_20564":115701,"_5":14107,"_26947":115641,"_2866":115702},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3379":69212,"_29627":69191,"_20564":115704,"_5":14107,"_26947":115641,"_2866":115705},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3379":69213,"_29627":69191,"_20564":115707,"_5":14107,"_26947":115641,"_2866":115708},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3379":69214,"_29627":69191,"_20564":115710,"_5":14107,"_26947":115641,"_2866":115711},[],"`apikey_options` necesita `header` y `key`.",{"_3379":69215,"_29627":69191,"_20564":115713,"_5":14107,"_26947":115641,"_2866":115714},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3379":69216,"_29627":69191,"_20564":115716,"_5":14107,"_26947":115641,"_2866":115717},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3379":69217,"_29627":69191,"_20564":115719,"_5":14107,"_26947":115641,"_2866":115720},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3379":69218,"_29627":69191,"_20564":115722,"_5":14107,"_26947":115649,"_2866":115723},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3379":69219,"_29627":69191,"_20564":115725,"_5":14107,"_26947":115653,"_2866":115726},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3379":69220,"_29627":69191,"_20564":115728,"_5":14107,"_26947":115657,"_2866":115729},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3379":69221,"_29627":69191,"_20564":115731,"_5":14107,"_26947":115657,"_2866":115732},[],"**None** notifica todas las instancias del evento.",{"_3379":69222,"_29627":69191,"_20564":115734,"_5":14107,"_26947":115657,"_2866":115735},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3379":69223,"_29627":69191,"_20564":115737,"_5":14107,"_26947":115657,"_2866":115738},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3379":69224,"_29627":69191,"_20564":115740,"_5":14107,"_26947":115657,"_2866":115741},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3379":69225,"_29627":69191,"_20564":115743,"_5":14107,"_26947":115657,"_2866":115744},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3379":69226,"_29627":69191,"_20564":115746,"_5":14107,"_26947":115657,"_2866":115747},[],"La consola evalúa el filtro contra el JSON del editor **Input Event**, que está prellenado con el último evento, e indica si coincide. Para los filtros JSON Path y JavaScript, muestra **The filter matches this Cloud Event** o **The filter does not match this Cloud Event**. Las expresiones JSON Path se evalúan sobre el Cloud Event completo, así que el valor por defecto, `$.data`, selecciona el campo `data` del evento, y la expresión debe empezar por `$`.",{"_3379":69227,"_29627":69191,"_20564":115749,"_5":14107,"_26947":115661,"_2866":115750},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3379":69228,"_29627":69191,"_20564":115752,"_5":14107,"_26947":115665,"_2866":115753},[],"Los canales Webhook y Microsoft Teams muestran esta configuración en el formulario de suscripción, en el paso del canal, y de nuevo al editar una suscripción; Email no la utiliza. Los campos se corresponden con el bloque opcional `http_client` descrito arriba:",{"_3379":69229,"_29627":69191,"_20564":115755,"_5":14107,"_26947":115665,"_2866":115756},[],"**Log Level** selecciona `debug`, `info`, `warn` o `error`; `info` es el valor por defecto.",{"_3379":69230,"_29627":69191,"_20564":115758,"_5":14107,"_26947":115665,"_2866":115759},[],"**Call Timeout** es de 10 segundos por defecto. La consola rechaza un valor superior a 30 segundos con `Webhook timeout must be at most 30s.`; la API ajusta ese mismo valor al tope en lugar de rechazarlo (ver Las llamadas están limitadas).",{"_3379":69231,"_29627":69191,"_20564":115761,"_5":14107,"_26947":115665,"_2866":115762},[],"No hay interruptor de verificación TLS para estos canales, porque el servicio siempre verifica el certificado del receptor (ver TLS siempre se verifica).",{"_3379":69232,"_29627":69191,"_20564":115764,"_5":14107,"_26947":115665,"_2866":115765},[],"**HTTP Authentication** selecciona `No Authentication` (por defecto), `API Key` (valor de la API key y Header Name, `X-API-Key` por defecto), `OIDC Client Credentials` (Client ID, Client Secret y Well-Known URL) o `Mutual TLS` (Client Certificate y Client Private Key pegados como PEM). Una clave privada guardada permanece oculta hasta que seleccionas **Show**.",{"_3379":69233,"_29627":69191,"_20564":115767,"_5":14107,"_26947":115665,"_2866":115768},[],"Una URL `http://` muestra en la consola la advertencia `Unencrypted HTTP connection` (ver la llamada Credenciales sobre http\\:// más abajo).",{"_3379":69234,"_29627":69191,"_20564":115770,"_5":14107,"_26947":115665,"_2866":115771},[],"Los campos se validan en línea con las mismas reglas de entrega: la URL del webhook y la Well-Known URL de OIDC deben ser URLs absolutas `http` o `https`, una cabecera API-key no puede usar un nombre reservado y el certificado y la clave mTLS deben ser contenido PEM, no rutas de ficheros.",{"_3379":69235,"_29627":69191,"_20564":115773,"_5":14107,"_26947":115665,"_2866":115774},[],"El resumen del paso de confirmación muestra la autenticación como `None`, `OIDC client credentials`, `API key` o `Mutual TLS`. Los detalles de la suscripción muestran la autenticación, el nombre de la cabecera API-key (nunca el valor), la URL del emisor OIDC, mTLS como `Configured` y una fila fija `TLS verification: Verified`. La API key, el client secret y la clave privada no se muestran en los detalles de la suscripción.",{"_3379":69236,"_29627":69191,"_20564":115776,"_5":14107,"_26947":115669,"_2866":115777},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3379":69237,"_29627":69191,"_20564":115779,"_5":14107,"_26947":115669,"_2866":115780},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3379":69238,"_29627":69191,"_20564":115782,"_5":14107,"_26947":115669,"_2866":115783},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3379":69239,"_29627":69191,"_20564":115785,"_5":14107,"_26947":115669,"_2866":115786},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3379":69240,"_29627":69191,"_20564":115788,"_5":14107,"_26947":115669,"_2866":115789},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3379":69241,"_29627":69191,"_20564":115791,"_5":14107,"_26947":115669,"_2866":115792},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3379":69242,"_29627":69191,"_20564":115794,"_5":14107,"_26947":115669,"_2866":115795},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3379":69243,"_29627":69191,"_20564":115797,"_5":14107,"_26947":115669,"_2866":115798},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3379":69244,"_29627":69191,"_20564":115800,"_5":14107,"_26947":115673,"_2866":115801},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3379":69245,"_29627":69191,"_20564":115803,"_5":14107,"_26947":115673,"_2866":115804},[],"Las suscripciones creadas con versiones anteriores de la consola pueden guardar el destino del webhook en `url` y `method` en lugar de `webhook_url` y `webhook_method`. El servicio entrega solo a través de `webhook_url` y `webhook_method`, así que una suscripción así no entrega aunque los detalles de la suscripción muestren el destino guardado. Abre la suscripción y vuelve a guardarla: el formulario de edición precarga el destino guardado, y al guardar se reescribe la configuración del canal con el formato actual.",{"_3379":69246,"_29627":69191,"_20564":115806,"_5":14107,"_26947":115677,"_2866":115807},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3379":69247,"_29627":69191,"_20564":115809,"_5":14107,"_26947":115677,"_2866":115810},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3379":69248,"_29627":69191,"_20564":115812,"_5":14107,"_26947":115677,"_2866":115813},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3379":69249,"_29627":69191,"_20564":115815,"_5":14107,"_26947":115677,"_2866":115816},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3379":69250,"_29627":69191,"_20564":115818,"_5":14107,"_26947":115677,"_2866":115819},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3379":69251,"_29627":69191,"_20564":115821,"_5":14107,"_26947":115677,"_2866":115822},[],"**Validación:** `va.role.crl.create`.",{"_3379":69252,"_29627":69191,"_20564":115824,"_5":14107,"_26947":115677,"_2866":115825},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3379":69253,"_29627":69191,"_20564":115827,"_5":14107,"_26947":115677,"_2866":115828},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3379":69254,"_29627":69254,"_5":14459,"_2866":115830,"_29980":115831,"_20564":115832,"_26947":69254},"Registros de auditoría",[48237,115094,115095],[],{"_3379":69255,"_29627":69254,"_20564":115834,"_5":14107,"_26947":69254,"_2866":115835},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3379":69256,"_29627":69254,"_5":29977,"_20564":115837,"_26947":115838,"_2866":115839},[],"/docs/pr-preview/pr-55/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3379":69257,"_29627":69254,"_5":29977,"_20564":115841,"_26947":115842,"_2866":115843},[],"/docs/pr-preview/pr-55/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3379":69258,"_29627":69254,"_5":29977,"_20564":115845,"_26947":115846,"_2866":115847},[],"/docs/pr-preview/pr-55/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3379":69259,"_29627":69254,"_5":29977,"_20564":115849,"_26947":115850,"_2866":115851},[],"/docs/pr-preview/pr-55/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3379":69260,"_29627":69254,"_5":29977,"_20564":115853,"_26947":115854,"_2866":115855},[],"/docs/pr-preview/pr-55/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3379":69261,"_29627":69254,"_5":29977,"_20564":115857,"_26947":115858,"_2866":115859},[],"/docs/pr-preview/pr-55/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3379":69262,"_29627":69254,"_5":29977,"_20564":115861,"_26947":115862,"_2866":115863},[],"/docs/pr-preview/pr-55/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3379":69263,"_29627":69254,"_5":29977,"_20564":115865,"_26947":115866,"_2866":115867},[],"/docs/pr-preview/pr-55/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3379":69264,"_29627":69254,"_5":29977,"_20564":115869,"_26947":115870,"_2866":115871},[],"/docs/pr-preview/pr-55/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3379":69265,"_29627":69254,"_5":29977,"_20564":115873,"_26947":115874,"_2866":115875},[],"/docs/pr-preview/pr-55/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3379":69266,"_29627":69254,"_5":29977,"_20564":115877,"_26947":115878,"_2866":115879},[],"/docs/pr-preview/pr-55/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3379":69267,"_29627":69254,"_20564":115881,"_5":14107,"_26947":69254,"_2866":115882},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3379":69268,"_29627":69254,"_20564":115884,"_5":14107,"_26947":115838,"_2866":115885},[],"El cuerpo de auditoría incluye:",{"_3379":69269,"_29627":69254,"_20564":115887,"_5":14107,"_26947":115838,"_2866":115888},[],"input: datos recibidos por la operación;",{"_3379":69270,"_29627":69254,"_20564":115890,"_5":14107,"_26947":115838,"_2866":115891},[],"has\\_error: indica si el servicio devolvió un error;",{"_3379":69271,"_29627":69254,"_20564":115893,"_5":14107,"_26947":115838,"_2866":115894},[],"output: resultado producido o mensaje de error;",{"_3379":69272,"_29627":69254,"_20564":115896,"_5":14107,"_26947":115838,"_2866":115897},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3379":69273,"_29627":69254,"_20564":115899,"_5":14107,"_26947":115838,"_2866":115900},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3379":69274,"_29627":69254,"_20564":115902,"_5":14107,"_26947":115838,"_2866":115903},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3379":69275,"_29627":69254,"_20564":115905,"_5":14107,"_26947":115842,"_2866":115906},[],"El backend aplica auditoría a mutaciones de:",{"_3379":69276,"_29627":69254,"_20564":115908,"_5":14107,"_26947":115842,"_2866":115909},[],"autoridades, certificados y perfiles de emisión;",{"_3379":69277,"_29627":69254,"_20564":115911,"_5":14107,"_26947":115842,"_2866":115912},[],"claves y motores KMS;",{"_3379":69278,"_29627":69254,"_20564":115914,"_5":14107,"_26947":115842,"_2866":115915},[],"dispositivos e identidades;",{"_3379":69279,"_29627":69254,"_20564":115917,"_5":14107,"_26947":115842,"_2866":115918},[],"DMS y operaciones de enrolamiento;",{"_3379":69280,"_29627":69254,"_20564":115920,"_5":14107,"_26947":115842,"_2866":115921},[],"funciones de validación y CRL;",{"_3379":69281,"_29627":69254,"_20564":115923,"_5":14107,"_26947":115842,"_2866":115924},[],"principales, políticas y concesiones de autorización.",{"_3379":69282,"_29627":69254,"_20564":115926,"_5":14107,"_26947":115842,"_2866":115927},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3379":69283,"_29627":69254,"_20564":115929,"_5":14107,"_26947":115846,"_2866":115930},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3379":69284,"_29627":69254,"_20564":115932,"_5":14107,"_26947":115846,"_2866":115933},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3379":69285,"_29627":69254,"_20564":115935,"_5":14107,"_26947":115846,"_2866":115936},[],"Diseña el consumidor para:",{"_3379":69286,"_29627":69254,"_20564":115938,"_5":14107,"_26947":115846,"_2866":115939},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3379":69287,"_29627":69254,"_20564":115941,"_5":14107,"_26947":115846,"_2866":115942},[],"conservar el CloudEvent completo sin modificar;",{"_3379":69288,"_29627":69254,"_20564":115944,"_5":14107,"_26947":115846,"_2866":115945},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3379":69289,"_29627":69254,"_20564":115947,"_5":14107,"_26947":115846,"_2866":115948},[],"cifrar en tránsito y en reposo;",{"_3379":69290,"_29627":69254,"_20564":115950,"_5":14107,"_26947":115846,"_2866":115951},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3379":69291,"_29627":69254,"_20564":115953,"_5":14107,"_26947":115846,"_2866":115954},[],"aplicar una política explícita de retención y legal hold;",{"_3379":69292,"_29627":69254,"_20564":115956,"_5":14107,"_26947":115846,"_2866":115957},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3379":69293,"_29627":69254,"_20564":115959,"_5":14107,"_26947":115850,"_2866":115960},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3379":69294,"_29627":69254,"_20564":115962,"_5":14107,"_26947":115850,"_2866":115963},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3379":69295,"_29627":69254,"_20564":115965,"_5":14107,"_26947":115858,"_2866":115966},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3379":69296,"_29627":69254,"_20564":115968,"_5":14107,"_26947":115862,"_2866":115969},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3379":69297,"_29627":69254,"_20564":115971,"_5":14107,"_26947":115866,"_2866":115972},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3379":69298,"_29627":69254,"_20564":115974,"_5":14107,"_26947":115870,"_2866":115975},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3379":69299,"_29627":69254,"_20564":115977,"_5":14107,"_26947":115874,"_2866":115978},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3379":69300,"_29627":69254,"_20564":115980,"_5":14107,"_26947":115878,"_2866":115981},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3379":69301,"_29627":69254,"_20564":115983,"_5":14107,"_26947":115878,"_2866":115984},[],"aparece un evento de auditoría correcto;",{"_3379":69302,"_29627":69254,"_20564":115986,"_5":14107,"_26947":115878,"_2866":115987},[],"el principal coincide con la identidad utilizada;",{"_3379":69303,"_29627":69254,"_20564":115989,"_5":14107,"_26947":115878,"_2866":115990},[],"el consumidor lo persiste una sola vez;",{"_3379":69304,"_29627":69254,"_20564":115992,"_5":14107,"_26947":115878,"_2866":115993},[],"puede recuperarse por recurso, actor y periodo;",{"_3379":69305,"_29627":69254,"_20564":115995,"_5":14107,"_26947":115878,"_2866":115996},[],"una interrupción del consumidor produce una alerta.",{"_3379":69306,"_29627":69254,"_20564":115998,"_5":14107,"_26947":115878,"_2866":115999},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3379":69307,"_29627":69307,"_5":14459,"_2866":116001,"_29980":116002,"_20564":116003,"_26947":69307},"Arquitectura de la plataforma",[48237,115094],[],{"_3379":69308,"_29627":69307,"_20564":116005,"_5":14107,"_26947":69307,"_2866":116006},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3379":69309,"_29627":69307,"_5":29977,"_20564":116008,"_26947":116009,"_2866":116010},[],"/docs/pr-preview/pr-55/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3379":69310,"_29627":69307,"_5":29977,"_20564":116012,"_26947":116013,"_2866":116014},[],"/docs/pr-preview/pr-55/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3379":69311,"_29627":69307,"_5":29977,"_20564":116016,"_26947":116017,"_2866":116018},[],"/docs/pr-preview/pr-55/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3379":69312,"_29627":69307,"_5":29977,"_20564":116020,"_26947":116021,"_2866":116022},[],"/docs/pr-preview/pr-55/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3379":69313,"_29627":69307,"_5":29977,"_20564":116024,"_26947":116025,"_2866":116026},[],"/docs/pr-preview/pr-55/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3379":69314,"_29627":69307,"_20564":116028,"_5":14107,"_26947":69307,"_2866":116029},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3379":69315,"_29627":69307,"_20564":116031,"_5":14107,"_26947":69307,"_2866":116032},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3379":69316,"_29627":69307,"_20564":116034,"_5":14107,"_26947":116009,"_2866":116035},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3379":69317,"_29627":69307,"_20564":116037,"_5":14107,"_26947":116013,"_2866":116038},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3379":69318,"_29627":69307,"_20564":116040,"_5":14107,"_26947":116017,"_2866":116041},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3379":69319,"_29627":69307,"_20564":116043,"_5":14107,"_26947":116021,"_2866":116044},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3379":69320,"_29627":69307,"_20564":116046,"_5":14107,"_26947":116025,"_2866":116047},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3379":69321,"_29627":69321,"_5":14459,"_2866":116049,"_29980":116050,"_20564":116051,"_26947":69321},"Cómo funciona Lamassu",[48237,115094],[],{"_3379":69322,"_29627":69321,"_20564":116053,"_5":14107,"_26947":69321,"_2866":116054},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3379":69323,"_29627":69321,"_5":29977,"_20564":116056,"_26947":116057,"_2866":116058},[],"/docs/pr-preview/pr-55/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3379":69324,"_29627":69321,"_5":29977,"_20564":116060,"_26947":116061,"_2866":116062},[],"/docs/pr-preview/pr-55/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3379":69325,"_29627":69321,"_20564":116064,"_5":14107,"_26947":69321,"_2866":116065},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3379":69326,"_29627":69321,"_20564":116067,"_5":14107,"_26947":116057,"_2866":116068},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3379":69327,"_29627":69321,"_20564":116070,"_5":14107,"_26947":116057,"_2866":116071},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3379":69328,"_29627":69321,"_20564":116073,"_5":14107,"_26947":116057,"_2866":116074},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3379":69329,"_29627":69321,"_20564":116076,"_5":14107,"_26947":116057,"_2866":116077},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3379":69330,"_29627":69321,"_20564":116079,"_5":14107,"_26947":116057,"_2866":116080},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3379":69331,"_29627":69321,"_20564":116082,"_5":14107,"_26947":116061,"_2866":116083},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3379":69332,"_29627":69321,"_20564":116085,"_5":14107,"_26947":116061,"_2866":116086},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3379":69333,"_29627":69321,"_20564":116088,"_5":14107,"_26947":116061,"_2866":116089},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3379":69334,"_29627":69321,"_20564":116091,"_5":14107,"_26947":116061,"_2866":116092},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3379":69335,"_29627":69321,"_20564":116094,"_5":14107,"_26947":116061,"_2866":116095},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3379":69336,"_29627":69321,"_20564":116097,"_5":14107,"_26947":116061,"_2866":116098},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3379":69337,"_29627":69321,"_20564":116100,"_5":14107,"_26947":116061,"_2866":116101},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3379":69338,"_29627":69338,"_5":14459,"_2866":116103,"_29980":116104,"_20564":116105,"_26947":69338},"Dispositivos e identidades",[48237,115094,50716,116103],[],{"_3379":69339,"_29627":69338,"_20564":116107,"_5":14107,"_26947":69338,"_2866":116108},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3379":69340,"_29627":69338,"_5":29977,"_20564":116110,"_26947":116111,"_2866":116112},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3379":69341,"_29627":69338,"_5":29977,"_20564":116114,"_26947":116115,"_2866":116116},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3379":69342,"_29627":69338,"_5":29977,"_20564":116118,"_26947":116119,"_2866":116120},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3379":69343,"_29627":69338,"_5":29977,"_20564":116122,"_26947":116123,"_2866":116124},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3379":69344,"_29627":69338,"_5":29977,"_20564":116126,"_26947":116127,"_2866":116128},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3379":69345,"_29627":69338,"_5":29977,"_20564":116130,"_26947":116131,"_2866":116132},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3379":69346,"_29627":69338,"_5":29977,"_20564":116134,"_26947":116135,"_2866":116136},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3379":69347,"_29627":69338,"_5":29977,"_20564":116138,"_26947":116139,"_2866":116140},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3379":69348,"_29627":69338,"_5":29977,"_20564":116142,"_26947":116143,"_2866":116144},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3379":69349,"_29627":69338,"_5":29977,"_20564":116146,"_26947":116147,"_2866":116148},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3379":69350,"_29627":69338,"_5":29977,"_20564":116150,"_26947":116151,"_2866":116152},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3379":69351,"_29627":69338,"_20564":116154,"_5":14107,"_26947":69338,"_2866":116155},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3379":69352,"_29627":69338,"_20564":116157,"_5":14107,"_26947":69338,"_2866":116158},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3379":69353,"_29627":69338,"_20564":116160,"_5":14107,"_26947":116111,"_2866":116161},[],"Vista operativa",{"_3379":69354,"_29627":69338,"_20564":116163,"_5":14107,"_26947":116111,"_2866":116164},[],"Interpretación",{"_3379":69355,"_29627":69338,"_20564":116166,"_5":14107,"_26947":116111,"_2866":50779},[],{"_3379":69356,"_29627":69338,"_20564":116168,"_5":14107,"_26947":116111,"_2866":116169},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3379":69357,"_29627":69338,"_20564":116171,"_5":14107,"_26947":116111,"_2866":50785},[],{"_3379":69358,"_29627":69338,"_20564":116173,"_5":14107,"_26947":116111,"_2866":116174},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3379":69359,"_29627":69338,"_20564":116176,"_5":14107,"_26947":116111,"_2866":50791},[],{"_3379":69360,"_29627":69338,"_20564":116178,"_5":14107,"_26947":116111,"_2866":116179},[],"La identidad está en la ventana operativa de renovación.",{"_3379":69361,"_29627":69338,"_20564":116181,"_5":14107,"_26947":116111,"_2866":50797},[],{"_3379":69362,"_29627":69338,"_20564":116183,"_5":14107,"_26947":116111,"_2866":116184},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3379":69363,"_29627":69338,"_20564":116186,"_5":14107,"_26947":116111,"_2866":50803},[],{"_3379":69364,"_29627":69338,"_20564":116188,"_5":14107,"_26947":116111,"_2866":116189},[],"La identidad ha vencido.",{"_3379":69365,"_29627":69338,"_20564":116191,"_5":14107,"_26947":116111,"_2866":50809},[],{"_3379":69366,"_29627":69338,"_20564":116193,"_5":14107,"_26947":116111,"_2866":116194},[],"La identidad está marcada como revocada.",{"_3379":69367,"_29627":69338,"_20564":116196,"_5":14107,"_26947":116111,"_2866":50815},[],{"_3379":69368,"_29627":69338,"_20564":116198,"_5":14107,"_26947":116111,"_2866":116199},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3379":69369,"_29627":69338,"_20564":116201,"_5":14107,"_26947":116111,"_2866":116202},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3379":69370,"_29627":69338,"_20564":116204,"_5":14107,"_26947":116115,"_2866":116205},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3379":69371,"_29627":69338,"_20564":116207,"_5":14107,"_26947":116115,"_2866":116208},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3379":69372,"_29627":69338,"_20564":116210,"_5":14107,"_26947":116115,"_2866":116211},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3379":69373,"_29627":69338,"_20564":116213,"_5":14107,"_26947":116115,"_2866":116214},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3379":69374,"_29627":69338,"_20564":116216,"_5":14107,"_26947":116119,"_2866":116217},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3379":69375,"_29627":69338,"_20564":116219,"_5":14107,"_26947":116123,"_2866":116220},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3379":69376,"_29627":69338,"_20564":116222,"_5":14107,"_26947":116127,"_2866":116223},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3379":69377,"_29627":69338,"_20564":116225,"_5":14107,"_26947":116131,"_2866":116226},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3379":69378,"_29627":69338,"_20564":116228,"_5":14107,"_26947":116135,"_2866":116229},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3379":69379,"_29627":69338,"_20564":116231,"_5":14107,"_26947":116135,"_2866":116232},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3379":69380,"_29627":69338,"_20564":116234,"_5":14107,"_26947":116139,"_2866":116235},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3379":69381,"_29627":69338,"_20564":116237,"_5":14107,"_26947":116139,"_2866":116238},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3379":69382,"_29627":69338,"_20564":116240,"_5":14107,"_26947":116139,"_2866":116241},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3379":69383,"_29627":69338,"_20564":116243,"_5":14107,"_26947":116139,"_2866":116244},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3379":69384,"_29627":69338,"_20564":116246,"_5":14107,"_26947":116139,"_2866":116247},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3379":69385,"_29627":69338,"_20564":116249,"_5":14107,"_26947":116139,"_2866":116250},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3379":69386,"_29627":69338,"_20564":116252,"_5":14107,"_26947":116143,"_2866":116253},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3379":69387,"_29627":69338,"_20564":116255,"_5":14107,"_26947":116143,"_2866":116256},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3379":69388,"_29627":69338,"_20564":116258,"_5":14107,"_26947":116147,"_2866":116259},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3379":69389,"_29627":69338,"_20564":116261,"_5":14107,"_26947":116147,"_2866":116262},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3379":69390,"_29627":69338,"_20564":116264,"_5":14107,"_26947":116147,"_2866":116265},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3379":69391,"_29627":69338,"_20564":116267,"_5":14107,"_26947":116147,"_2866":116268},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3379":69392,"_29627":69338,"_20564":116270,"_5":14107,"_26947":116151,"_2866":116271},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3379":69393,"_29627":69338,"_20564":116273,"_5":14107,"_26947":116151,"_2866":116274},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3379":69394,"_29627":69394,"_5":14459,"_2866":116276,"_29980":116277,"_20564":116279,"_26947":69394},"Identidad inicial y autenticación",[48237,115094,50716,116103,116278],"Enrolamiento con PKI",[],{"_3379":69395,"_29627":69394,"_20564":116281,"_5":14107,"_26947":69394,"_2866":116282},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_3379":69396,"_29627":69394,"_5":29977,"_20564":116284,"_26947":116285,"_2866":116286},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3379":69397,"_29627":69394,"_5":29977,"_20564":116288,"_26947":116289,"_2866":116290},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3379":69398,"_29627":69394,"_5":29977,"_20564":116292,"_26947":116293,"_2866":116294},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_3379":69399,"_29627":69394,"_5":29977,"_20564":116296,"_26947":116297,"_2866":116298},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3379":69400,"_29627":69394,"_5":29977,"_20564":116300,"_26947":116301,"_2866":116302},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3379":69401,"_29627":69394,"_20564":116304,"_5":14107,"_26947":69394,"_2866":116305},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3379":69402,"_29627":69394,"_20564":116307,"_5":14107,"_26947":116285,"_2866":116308},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3379":69403,"_29627":69394,"_20564":116310,"_5":14107,"_26947":116285,"_2866":116311},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3379":69404,"_29627":69394,"_20564":116313,"_5":14107,"_26947":116289,"_2866":116314},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3379":69405,"_29627":69394,"_20564":116316,"_5":14107,"_26947":116289,"_2866":116317},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3379":69406,"_29627":69394,"_20564":116319,"_5":14107,"_26947":116289,"_2866":116320},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3379":69407,"_29627":69394,"_20564":116322,"_5":14107,"_26947":116293,"_2866":116323},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3379":69408,"_29627":69394,"_20564":116325,"_5":14107,"_26947":116293,"_2866":116326},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3379":69409,"_29627":69394,"_20564":116328,"_5":14107,"_26947":116297,"_2866":116329},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3379":69410,"_29627":69394,"_20564":116331,"_5":14107,"_26947":116297,"_2866":116332},[],"Ejemplo de cuerpo:",{"_3379":69411,"_29627":69394,"_20564":116334,"_5":14107,"_26947":116297,"_2866":116335},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3379":69412,"_29627":69394,"_20564":116337,"_5":14107,"_26947":116297,"_2866":116338},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3379":69413,"_29627":69394,"_20564":116340,"_5":14107,"_26947":116297,"_2866":116341},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3379":69414,"_29627":69394,"_20564":116343,"_5":14107,"_26947":116297,"_2866":116344},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3379":69415,"_29627":69394,"_20564":116346,"_5":14107,"_26947":116301,"_2866":116347},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_3379":69416,"_29627":69394,"_20564":116349,"_5":14107,"_26947":116301,"_2866":116350},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3379":69417,"_29627":69417,"_5":14459,"_2866":116352,"_29980":116353,"_20564":116354,"_26947":69417},"Configura y opera el DMS",[48237,115094,50716,116103,116278],[],{"_3379":69418,"_29627":69417,"_20564":116356,"_5":14107,"_26947":69417,"_2866":116357},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3379":69419,"_29627":69417,"_5":29977,"_20564":116359,"_26947":116360,"_2866":113672},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3379":69420,"_29627":69417,"_5":29977,"_20564":116362,"_26947":116363,"_2866":116364},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3379":69421,"_29627":69417,"_5":29977,"_20564":116366,"_26947":116367,"_2866":116368},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3379":69422,"_29627":69417,"_5":29977,"_20564":116370,"_26947":116371,"_2866":116372},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3379":69423,"_29627":69417,"_5":29977,"_20564":116374,"_26947":116375,"_2866":116376},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3379":69424,"_29627":69417,"_5":29977,"_20564":116378,"_26947":116379,"_2866":116380},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3379":69425,"_29627":69417,"_5":29977,"_20564":116382,"_26947":116383,"_2866":116384},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3379":69426,"_29627":69417,"_5":29977,"_20564":116386,"_26947":116387,"_2866":116388},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_3379":69427,"_29627":69417,"_5":29977,"_20564":116390,"_26947":116391,"_2866":51011},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_3379":69428,"_29627":69417,"_5":29977,"_20564":116393,"_26947":116394,"_2866":51015},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_3379":69429,"_29627":69417,"_5":29977,"_20564":116396,"_26947":116397,"_2866":116398},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_3379":69430,"_29627":69417,"_5":29977,"_20564":116400,"_26947":116401,"_2866":116402},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3379":69431,"_29627":69417,"_5":29977,"_20564":116404,"_26947":116405,"_2866":116406},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_3379":69432,"_29627":69417,"_5":29977,"_20564":116408,"_26947":116409,"_2866":116410},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3379":69433,"_29627":69417,"_5":29977,"_20564":116412,"_26947":116413,"_2866":51035},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_3379":69434,"_29627":69417,"_5":29977,"_20564":116415,"_26947":116416,"_2866":116417},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_3379":69435,"_29627":69417,"_5":29977,"_20564":116419,"_26947":116420,"_2866":116421},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3379":69436,"_29627":69417,"_5":29977,"_20564":116423,"_26947":116424,"_2866":116425},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3379":69437,"_29627":69417,"_20564":116427,"_5":14107,"_26947":69417,"_2866":116428},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3379":69438,"_29627":69417,"_20564":116430,"_5":14107,"_26947":116360,"_2866":116431},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3379":69439,"_29627":69417,"_20564":116433,"_5":14107,"_26947":116360,"_2866":116434},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3379":69440,"_29627":69417,"_20564":116436,"_5":14107,"_26947":116367,"_2866":116437},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3379":69441,"_29627":69417,"_20564":116439,"_5":14107,"_26947":116371,"_2866":116440},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3379":69442,"_29627":69417,"_20564":116442,"_5":14107,"_26947":116375,"_2866":116443},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3379":69443,"_29627":69417,"_20564":116445,"_5":14107,"_26947":116379,"_2866":116446},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3379":69444,"_29627":69417,"_20564":116448,"_5":14107,"_26947":116383,"_2866":116449},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3379":69445,"_29627":69417,"_20564":116451,"_5":14107,"_26947":116391,"_2866":116452},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_3379":69446,"_29627":69417,"_20564":116454,"_5":14107,"_26947":116391,"_2866":116455},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3379":69447,"_29627":69417,"_20564":116457,"_5":14107,"_26947":116394,"_2866":116458},[],"Campo de `settings.enrollment_settings`",{"_3379":69448,"_29627":69417,"_20564":116460,"_5":14107,"_26947":116394,"_2866":116461},[],"Decisión",{"_3379":69449,"_29627":69417,"_20564":116463,"_5":14107,"_26947":116394,"_2866":51086},[],{"_3379":69450,"_29627":69417,"_20564":116465,"_5":14107,"_26947":116394,"_2866":116466},[],"`EST_RFC7030` para estas operaciones.",{"_3379":69451,"_29627":69417,"_20564":116468,"_5":14107,"_26947":116394,"_2866":51092},[],{"_3379":69452,"_29627":69417,"_20564":116470,"_5":14107,"_26947":116394,"_2866":116471},[],"ID de la CA que firmará.",{"_3379":69453,"_29627":69417,"_20564":116473,"_5":14107,"_26947":116394,"_2866":51098},[],{"_3379":69454,"_29627":69417,"_20564":116475,"_5":14107,"_26947":116394,"_2866":116476},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3379":69455,"_29627":69417,"_20564":116478,"_5":14107,"_26947":116394,"_2866":51104},[],{"_3379":69456,"_29627":69417,"_20564":116480,"_5":14107,"_26947":116394,"_2866":116481},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3379":69457,"_29627":69417,"_20564":116483,"_5":14107,"_26947":116394,"_2866":51110},[],{"_3379":69458,"_29627":69417,"_20564":116485,"_5":14107,"_26947":116394,"_2866":116486},[],"Uno de los cuatro modos de autenticación.",{"_3379":69459,"_29627":69417,"_20564":116488,"_5":14107,"_26947":116394,"_2866":116489},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3379":69460,"_29627":69417,"_20564":116491,"_5":14107,"_26947":116397,"_2866":116492},[],"Los bloques son independientes:",{"_3379":69461,"_29627":69417,"_20564":116494,"_5":14107,"_26947":116397,"_2866":116495},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3379":69462,"_29627":69417,"_20564":116497,"_5":14107,"_26947":116397,"_2866":116498},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3379":69463,"_29627":69417,"_20564":116500,"_5":14107,"_26947":116397,"_2866":51128},[],{"_3379":69464,"_29627":69417,"_20564":116502,"_5":14107,"_26947":116397,"_2866":116503},[],"Control aplicado en la operación configurada",{"_3379":69465,"_29627":69417,"_20564":116505,"_5":14107,"_26947":116397,"_2866":51134},[],{"_3379":69466,"_29627":69417,"_20564":116507,"_5":14107,"_26947":116397,"_2866":116508},[],"Validación del certificado presentado.",{"_3379":69467,"_29627":69417,"_20564":116510,"_5":14107,"_26947":116397,"_2866":51140},[],{"_3379":69468,"_29627":69417,"_20564":116512,"_5":14107,"_26947":116397,"_2866":116513},[],"Autorización del webhook configurado.",{"_3379":69469,"_29627":69417,"_20564":116515,"_5":14107,"_26947":116397,"_2866":51146},[],{"_3379":69470,"_29627":69417,"_20564":116517,"_5":14107,"_26947":116397,"_2866":116518},[],"Validación del certificado y, después, aprobación del webhook.",{"_3379":69471,"_29627":69417,"_20564":116520,"_5":14107,"_26947":116397,"_2866":51152},[],{"_3379":69472,"_29627":69417,"_20564":116522,"_5":14107,"_26947":116397,"_2866":116523},[],"Sin autenticación del solicitante por el DMS.",{"_3379":69473,"_29627":69417,"_20564":116525,"_5":14107,"_26947":116397,"_2866":116526},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3379":69474,"_29627":69417,"_20564":116528,"_5":14107,"_26947":116397,"_2866":116529},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3379":69475,"_29627":69417,"_20564":116531,"_5":14107,"_26947":116397,"_2866":116532},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`.",{"_3379":69476,"_29627":69417,"_20564":116534,"_5":14107,"_26947":116397,"_2866":116535},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3379":69477,"_29627":69417,"_20564":116537,"_5":14107,"_26947":116401,"_2866":116538},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3379":69478,"_29627":69417,"_20564":116540,"_5":14107,"_26947":116401,"_2866":116541},[],"Campo de `external_webhook_settings`",{"_3379":69479,"_29627":69417,"_20564":116543,"_5":14107,"_26947":116401,"_2866":116461},[],{"_3379":69480,"_29627":69417,"_20564":116545,"_5":14107,"_26947":116401,"_2866":51178},[],{"_3379":69481,"_29627":69417,"_20564":116547,"_5":14107,"_26947":116401,"_2866":116548},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3379":69482,"_29627":69417,"_20564":116550,"_5":14107,"_26947":116401,"_2866":51184},[],{"_3379":69483,"_29627":69417,"_20564":116552,"_5":14107,"_26947":116401,"_2866":116553},[],"`POST` o `PUT`; `POST` por defecto.",{"_3379":69484,"_29627":69417,"_20564":116555,"_5":14107,"_26947":116401,"_2866":51190},[],{"_3379":69485,"_29627":69417,"_20564":116557,"_5":14107,"_26947":116401,"_2866":116558},[],"Etiqueta usada en los logs del servicio.",{"_3379":69486,"_29627":69417,"_20564":116560,"_5":14107,"_26947":116401,"_2866":51196},[],{"_3379":69487,"_29627":69417,"_20564":116562,"_5":14107,"_26947":116401,"_2866":116563},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3379":69488,"_29627":69417,"_20564":116565,"_5":14107,"_26947":116401,"_2866":51202},[],{"_3379":69489,"_29627":69417,"_20564":116567,"_5":14107,"_26947":116401,"_2866":116568},[],"Nivel de log de la llamada del webhook: `debug`, `info`, `warn` o `error`; `info` por defecto.",{"_3379":69490,"_29627":69417,"_20564":116570,"_5":14107,"_26947":116401,"_2866":51208},[],{"_3379":69491,"_29627":69417,"_20564":116572,"_5":14107,"_26947":116401,"_2866":116573},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3379":69492,"_29627":69417,"_20564":116575,"_5":14107,"_26947":116401,"_2866":51214},[],{"_3379":69493,"_29627":69417,"_20564":116577,"_5":14107,"_26947":116401,"_2866":116578},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3379":69494,"_29627":69417,"_20564":116580,"_5":14107,"_26947":116401,"_2866":51220},[],{"_3379":69495,"_29627":69417,"_20564":116582,"_5":14107,"_26947":116401,"_2866":116583},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3379":69496,"_29627":69417,"_20564":116585,"_5":14107,"_26947":116401,"_2866":51226},[],{"_3379":69497,"_29627":69417,"_20564":116587,"_5":14107,"_26947":116401,"_2866":116588},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3379":69498,"_29627":69417,"_20564":116590,"_5":14107,"_26947":116401,"_2866":51232},[],{"_3379":69499,"_29627":69417,"_20564":116592,"_5":14107,"_26947":116401,"_2866":116593},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3379":69500,"_29627":69417,"_20564":116595,"_5":14107,"_26947":116401,"_2866":116596},[],"Reglas de esa configuración:",{"_3379":69501,"_29627":69417,"_20564":116598,"_5":14107,"_26947":116401,"_2866":116599},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3379":69502,"_29627":69417,"_20564":116601,"_5":14107,"_26947":116401,"_2866":116602},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3379":69503,"_29627":69417,"_20564":116604,"_5":14107,"_26947":116401,"_2866":116605},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3379":69504,"_29627":69417,"_20564":116607,"_5":14107,"_26947":116401,"_2866":116608},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3379":69505,"_29627":69417,"_20564":116610,"_5":14107,"_26947":116401,"_2866":116611},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3379":69506,"_29627":69417,"_20564":116613,"_5":14107,"_26947":116401,"_2866":116614},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3379":69507,"_29627":69417,"_20564":116616,"_5":14107,"_26947":116401,"_2866":116617},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento, con los mismos campos Log Level, Call Timeout, HTTP Authentication y credenciales que los canales webhook, además de un interruptor **Skip TLS Verification** (desactivado por defecto, así que la verificación permanece activa; la consola avisa cuando lo activas).",{"_3379":69508,"_29627":69417,"_20564":116619,"_5":14107,"_26947":116401,"_2866":116620},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Para corregirlo en la consola, abre el DMS, sustituye cualquier valor de ruta de fichero por contenido PEM — el editor rechaza las rutas de fichero con un error en el propio campo — y guarda. Al guardar se reescribe `external_webhook_settings.config` con las claves actuales, y la consola lee tanto el PEM sin codificar como el codificado en Base64 de las configuraciones migradas, y almacena el material codificado en Base64. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3379":69509,"_29627":69417,"_20564":116622,"_5":14107,"_26947":116401,"_2866":116623},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3379":69510,"_29627":69417,"_20564":116625,"_5":14107,"_26947":116405,"_2866":116626},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3379":69511,"_29627":69417,"_20564":116628,"_5":14107,"_26947":116409,"_2866":116629},[],"Campo de `settings.reenrollment_settings`",{"_3379":69512,"_29627":69417,"_20564":116631,"_5":14107,"_26947":116409,"_2866":116632},[],"Función",{"_3379":69513,"_29627":69417,"_20564":116634,"_5":14107,"_26947":116409,"_2866":51276},[],{"_3379":69514,"_29627":69417,"_20564":116636,"_5":14107,"_26947":116409,"_2866":116637},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3379":69515,"_29627":69417,"_20564":116639,"_5":14107,"_26947":116409,"_2866":51282},[],{"_3379":69516,"_29627":69417,"_20564":116641,"_5":14107,"_26947":116409,"_2866":116642},[],"Umbral operativo preventivo de monitorización.",{"_3379":69517,"_29627":69417,"_20564":116644,"_5":14107,"_26947":116409,"_2866":51288},[],{"_3379":69518,"_29627":69417,"_20564":116646,"_5":14107,"_26947":116409,"_2866":116647},[],"Umbral operativo crítico de monitorización.",{"_3379":69519,"_29627":69417,"_20564":116649,"_5":14107,"_26947":116409,"_2866":51294},[],{"_3379":69520,"_29627":69417,"_20564":116651,"_5":14107,"_26947":116409,"_2866":116652},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3379":69521,"_29627":69417,"_20564":116654,"_5":14107,"_26947":116409,"_2866":51300},[],{"_3379":69522,"_29627":69417,"_20564":116656,"_5":14107,"_26947":116409,"_2866":116657},[],"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3379":69523,"_29627":69417,"_20564":116659,"_5":14107,"_26947":116409,"_2866":51306},[],{"_3379":69524,"_29627":69417,"_20564":116661,"_5":14107,"_26947":116409,"_2866":116662},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3379":69525,"_29627":69417,"_20564":116664,"_5":14107,"_26947":116409,"_2866":116665},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_3379":69526,"_29627":69417,"_20564":116667,"_5":14107,"_26947":116413,"_2866":116668},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_3379":69527,"_29627":69417,"_20564":116670,"_5":14107,"_26947":116416,"_2866":114036},[],{"_3379":69528,"_29627":69417,"_20564":116672,"_5":14107,"_26947":116416,"_2866":116673},[],"Qué publica",{"_3379":69529,"_29627":69417,"_20564":116675,"_5":14107,"_26947":116416,"_2866":51323},[],{"_3379":69530,"_29627":69417,"_20564":116677,"_5":14107,"_26947":116416,"_2866":116678},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3379":69531,"_29627":69417,"_20564":116680,"_5":14107,"_26947":116416,"_2866":51329},[],{"_3379":69532,"_29627":69417,"_20564":116682,"_5":14107,"_26947":116416,"_2866":116683},[],"Certificado de la CA emisora seleccionada.",{"_3379":69533,"_29627":69417,"_20564":116685,"_5":14107,"_26947":116416,"_2866":51335},[],{"_3379":69534,"_29627":69417,"_20564":116687,"_5":14107,"_26947":116416,"_2866":116688},[],"Certificados de las CAs elegidas explícitamente.",{"_3379":69535,"_29627":69417,"_20564":116690,"_5":14107,"_26947":116416,"_2866":116691},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_3379":69536,"_29627":69417,"_20564":116693,"_5":14107,"_26947":116420,"_2866":116694},[],"**Edit** cambia nombre, ajustes y metadatos. Las actualizaciones se realizan mediante la API de DMS. `PUT /v1/dms/{id}` siempre actúa sobre el DMS identificado en la ruta de la URL: el cuerpo no lleva campo `id`, y cualquier `id` o `creation_ts` que contenga se ignora silenciosamente; la autorización se evalúa contra ese mismo identificador de la ruta. El cuerpo debe incluir un `name` no vacío y un objeto `settings`; si falta alguno, la respuesta es HTTP 400 y el DMS almacenado no se modifica. `name` y `settings` se sustituyen siempre por completo, así que lee el DMS antes de enviar una edición por API para no perder campos. `metadata` es opcional: si se omite o se envía `null`, se conservan los metadatos almacenados; un objeto suministrado los sustituye por completo; `{}` los borra (una consulta GET posterior devuelve un objeto vacío, no `null`). Los cuerpos al estilo antiguo que transportan el DMS completo siguen funcionando mientras incluyan `name` y `settings`; los campos desconocidos se ignoran. La actualización rechaza un `name` vacío con HTTP 400: un DMS cuyo nombre almacenado quedó vacío por una actualización anterior debe renombrarse antes de que cualquier cliente lo vuelva a leer y reenviar, incluida la escritura de vuelta del conector de AWS IoT en modo JITP. Si el objeto no incluye la clave del conector de AWS IoT (`lamassu.io/iot/{connector_id}`), el conector ignora los eventos siguientes del DMS.",{"_3379":69537,"_29627":69417,"_20564":116696,"_5":14107,"_26947":116420,"_2866":116697},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3379":69538,"_29627":69417,"_20564":116699,"_5":14107,"_26947":116420,"_2866":116700},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3379":69539,"_29627":69417,"_20564":116702,"_5":14107,"_26947":116424,"_2866":116703},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3379":69540,"_29627":69540,"_5":14459,"_2866":116705,"_29980":116706,"_20564":116707,"_26947":69540},"Integra el cliente EST",[48237,115094,50716,116103,116278],[],{"_3379":69541,"_29627":69540,"_20564":116709,"_5":14107,"_26947":69540,"_2866":116710},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_3379":69542,"_29627":69540,"_5":29977,"_20564":116712,"_26947":116713,"_2866":113672},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_3379":69543,"_29627":69540,"_5":29977,"_20564":116715,"_26947":116716,"_2866":116717},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_3379":69544,"_29627":69540,"_5":29977,"_20564":116719,"_26947":116720,"_2866":116721},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_3379":69545,"_29627":69540,"_5":29977,"_20564":116723,"_26947":116724,"_2866":116725},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_3379":69546,"_29627":69540,"_5":29977,"_20564":116727,"_26947":116728,"_2866":116729},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_3379":69547,"_29627":69540,"_5":29977,"_20564":116731,"_26947":116732,"_2866":116733},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_3379":69548,"_29627":69540,"_20564":116735,"_5":14107,"_26947":69540,"_2866":116736},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_3379":69549,"_29627":69540,"_20564":116738,"_5":14107,"_26947":116713,"_2866":116739},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3379":69550,"_29627":69540,"_20564":116741,"_5":14107,"_26947":116713,"_2866":116742},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3379":69551,"_29627":69540,"_20564":116744,"_5":14107,"_26947":116713,"_2866":116745},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3379":69552,"_29627":69540,"_20564":116747,"_5":14107,"_26947":116716,"_2866":116748},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_3379":69553,"_29627":69540,"_20564":116750,"_5":14107,"_26947":116716,"_2866":116751},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3379":69554,"_29627":69540,"_20564":116753,"_5":14107,"_26947":116720,"_2866":116754},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3379":69555,"_29627":69540,"_20564":116756,"_5":14107,"_26947":116720,"_2866":116757},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3379":69556,"_29627":69540,"_20564":116759,"_5":14107,"_26947":116724,"_2866":116760},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3379":69557,"_29627":69540,"_20564":116762,"_5":14107,"_26947":116724,"_2866":116763},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3379":69558,"_29627":69540,"_20564":116765,"_5":14107,"_26947":116728,"_2866":116766},[],"Para el caso de una raíz que emite directamente:",{"_3379":69559,"_29627":69540,"_20564":116768,"_5":14107,"_26947":116728,"_2866":116769},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3379":69560,"_29627":69540,"_20564":116771,"_5":14107,"_26947":116728,"_2866":116772},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3379":69561,"_29627":69540,"_20564":116774,"_5":14107,"_26947":116732,"_2866":116775},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_3379":69562,"_29627":69562,"_5":14459,"_2866":116777,"_29980":116778,"_20564":116779,"_26947":69562},"Referencia EST",[48237,115094,50716,116103,116278],[],{"_3379":69563,"_29627":69562,"_20564":116781,"_5":14107,"_26947":69562,"_2866":116782},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_3379":69564,"_29627":69562,"_5":29977,"_20564":116784,"_26947":116785,"_2866":116786},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_3379":69565,"_29627":69562,"_5":29977,"_20564":116788,"_26947":116789,"_2866":22292},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3379":69566,"_29627":69562,"_5":29977,"_20564":116791,"_26947":116792,"_2866":25583},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3379":69567,"_29627":69562,"_5":29977,"_20564":116794,"_26947":116795,"_2866":25590},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3379":69568,"_29627":69562,"_5":29977,"_20564":116797,"_26947":116798,"_2866":24912},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3379":69569,"_29627":69562,"_5":29977,"_20564":116800,"_26947":116801,"_2866":116802},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_3379":69570,"_29627":69562,"_5":29977,"_20564":116804,"_26947":116805,"_2866":116806},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_3379":69571,"_29627":69562,"_5":29977,"_20564":116808,"_26947":116809,"_2866":116810},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_3379":69572,"_29627":69562,"_20564":116812,"_5":14107,"_26947":69562,"_2866":116813},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_3379":69573,"_29627":69562,"_20564":116815,"_5":14107,"_26947":116785,"_2866":116816},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3379":69574,"_29627":69562,"_20564":116818,"_5":14107,"_26947":116785,"_2866":114854},[],{"_3379":69575,"_29627":69562,"_20564":116820,"_5":14107,"_26947":116785,"_2866":116821},[],"Método",{"_3379":69576,"_29627":69562,"_20564":116823,"_5":14107,"_26947":116785,"_2866":116824},[],"Autenticación y condición",{"_3379":69577,"_29627":69562,"_20564":116826,"_5":14107,"_26947":116785,"_2866":51478},[],{"_3379":69578,"_29627":69562,"_20564":116828,"_5":14107,"_26947":116785,"_2866":51481},[],{"_3379":69579,"_29627":69562,"_20564":116830,"_5":14107,"_26947":116785,"_2866":116831},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3379":69580,"_29627":69562,"_20564":116833,"_5":14107,"_26947":116785,"_2866":51487},[],{"_3379":69581,"_29627":69562,"_20564":116835,"_5":14107,"_26947":116785,"_2866":51490},[],{"_3379":69582,"_29627":69562,"_20564":116837,"_5":14107,"_26947":116785,"_2866":116838},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3379":69583,"_29627":69562,"_20564":116840,"_5":14107,"_26947":116785,"_2866":51496},[],{"_3379":69584,"_29627":69562,"_20564":116842,"_5":14107,"_26947":116785,"_2866":51490},[],{"_3379":69585,"_29627":69562,"_20564":116844,"_5":14107,"_26947":116785,"_2866":116845},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3379":69586,"_29627":69562,"_20564":116847,"_5":14107,"_26947":116785,"_2866":51504},[],{"_3379":69587,"_29627":69562,"_20564":116849,"_5":14107,"_26947":116785,"_2866":51490},[],{"_3379":69588,"_29627":69562,"_20564":116851,"_5":14107,"_26947":116785,"_2866":116852},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_3379":69589,"_29627":69562,"_20564":116854,"_5":14107,"_26947":116785,"_2866":116855},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3379":69590,"_29627":69562,"_20564":116857,"_5":14107,"_26947":116789,"_2866":116858},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_3379":69591,"_29627":69562,"_20564":116860,"_5":14107,"_26947":116789,"_2866":116861},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_3379":69592,"_29627":69562,"_20564":116863,"_5":14107,"_26947":116792,"_2866":116864},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_3379":69593,"_29627":69562,"_20564":116866,"_5":14107,"_26947":116792,"_2866":116867},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_3379":69594,"_29627":69562,"_20564":116869,"_5":14107,"_26947":116795,"_2866":116870},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_3379":69595,"_29627":69562,"_20564":116872,"_5":14107,"_26947":116795,"_2866":116873},[],"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_3379":69596,"_29627":69562,"_20564":116875,"_5":14107,"_26947":116798,"_2866":116876},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_3379":69597,"_29627":69562,"_20564":116878,"_5":14107,"_26947":116798,"_2866":116879},[],"El código admite RSA y ECDSA, y el valor `bits` del ajuste de clave del DMS significa algo distinto en cada caso. En ECDSA selecciona la curva: 224, 256, 384 o 521 corresponden a P-224, P-256, P-384 y P-521, y un tamaño no reconocido produce fallback a P-256, así que elige explícitamente un tamaño compatible y comprueba la clave resultante. En RSA se usa directamente como tamaño del módulo; la consola ofrece 2048, 3072 y 4096 bits. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_3379":69598,"_29627":69562,"_20564":116881,"_5":14107,"_26947":116801,"_2866":116882},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3379":69599,"_29627":69562,"_20564":116884,"_5":14107,"_26947":116801,"_2866":116885},[],"Parte",{"_3379":69600,"_29627":69562,"_20564":116887,"_5":14107,"_26947":116801,"_2866":116888},[],"Contenido tras decodificar su Base64",{"_3379":69601,"_29627":69562,"_20564":116890,"_5":14107,"_26947":116801,"_2866":51548},[],{"_3379":69602,"_29627":69562,"_20564":116892,"_5":14107,"_26947":116801,"_2866":116893},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3379":69603,"_29627":69562,"_20564":116895,"_5":14107,"_26947":116801,"_2866":51554},[],{"_3379":69604,"_29627":69562,"_20564":116897,"_5":14107,"_26947":116801,"_2866":116898},[],"PKCS#7 DER con el certificado emitido.",{"_3379":69605,"_29627":69562,"_20564":116900,"_5":14107,"_26947":116801,"_2866":116901},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3379":69606,"_29627":69562,"_20564":116903,"_5":14107,"_26947":116805,"_2866":116904},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3379":69607,"_29627":69562,"_20564":116906,"_5":14107,"_26947":116805,"_2866":116907},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_3379":69608,"_29627":69562,"_20564":116909,"_5":14107,"_26947":116805,"_2866":116910},[],"Convierte y comprueba el resultado:",{"_3379":69609,"_29627":69562,"_20564":116912,"_5":14107,"_26947":116805,"_2866":116913},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_3379":69610,"_29627":69562,"_20564":116915,"_5":14107,"_26947":116809,"_2866":116916},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3379":69611,"_29627":69562,"_20564":116918,"_5":14107,"_26947":116809,"_2866":116919},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3379":69612,"_29627":69612,"_5":14459,"_2866":116278,"_29980":116921,"_20564":116922,"_26947":69612},[48237,115094,50716,116103,116278],[],{"_3379":69613,"_29627":69612,"_20564":116924,"_5":14107,"_26947":69612,"_2866":116925},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_3379":69614,"_29627":69612,"_5":29977,"_20564":116927,"_26947":116928,"_2866":116929},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3379":69615,"_29627":69612,"_5":29977,"_20564":116931,"_26947":116932,"_2866":116933},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3379":69616,"_29627":69612,"_5":29977,"_20564":116935,"_26947":116936,"_2866":116937},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3379":69617,"_29627":69612,"_5":29977,"_20564":116939,"_26947":116940,"_2866":116941},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_3379":69618,"_29627":69612,"_20564":116943,"_5":14107,"_26947":69612,"_2866":116944},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3379":69619,"_29627":69612,"_20564":116946,"_5":14107,"_26947":116928,"_2866":116947},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3379":69620,"_29627":69612,"_20564":116949,"_5":14107,"_26947":116928,"_2866":116950},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3379":69621,"_29627":69612,"_20564":116952,"_5":14107,"_26947":116928,"_2866":116953},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3379":69622,"_29627":69612,"_20564":116955,"_5":14107,"_26947":116928,"_2866":116956},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3379":69623,"_29627":69612,"_20564":116958,"_5":14107,"_26947":116928,"_2866":116959},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3379":69624,"_29627":69612,"_20564":116961,"_5":14107,"_26947":116928,"_2866":116962},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3379":69625,"_29627":69612,"_20564":116964,"_5":14107,"_26947":116932,"_2866":116965},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3379":69626,"_29627":69612,"_20564":116967,"_5":14107,"_26947":116932,"_2866":116968},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3379":69627,"_29627":69612,"_20564":116970,"_5":14107,"_26947":116932,"_2866":116971},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3379":69628,"_29627":69612,"_20564":116973,"_5":14107,"_26947":116932,"_2866":116974},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3379":69629,"_29627":69612,"_20564":116976,"_5":14107,"_26947":116936,"_2866":116977},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3379":69630,"_29627":69612,"_20564":116979,"_5":14107,"_26947":116936,"_2866":116980},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3379":69631,"_29627":69612,"_20564":116982,"_5":14107,"_26947":116936,"_2866":116983},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3379":69632,"_29627":69612,"_20564":116985,"_5":14107,"_26947":116936,"_2866":116986},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3379":69633,"_29627":69612,"_20564":116988,"_5":14107,"_26947":116940,"_2866":116989},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_3379":69634,"_29627":69612,"_20564":116991,"_5":14107,"_26947":116940,"_2866":116992},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3379":69635,"_29627":69635,"_5":14459,"_2866":116994,"_29980":116995,"_20564":116996,"_26947":69635},"Estrategias de aprovisionamiento",[48237,115094,50716,116103,116278],[],{"_3379":69636,"_29627":69635,"_20564":116998,"_5":14107,"_26947":69635,"_2866":116999},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3379":69637,"_29627":69635,"_5":29977,"_20564":117001,"_26947":117002,"_2866":117003},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3379":69638,"_29627":69635,"_5":29977,"_20564":117005,"_26947":117006,"_2866":117007},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3379":69639,"_29627":69635,"_5":29977,"_20564":117009,"_26947":117010,"_2866":117011},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3379":69640,"_29627":69635,"_5":29977,"_20564":117013,"_26947":117014,"_2866":117015},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3379":69641,"_29627":69635,"_5":29977,"_20564":117017,"_26947":117018,"_2866":117019},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3379":69642,"_29627":69635,"_20564":117021,"_5":14107,"_26947":69635,"_2866":117022},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3379":69643,"_29627":69635,"_20564":117024,"_5":14107,"_26947":117002,"_2866":117025},[],"Recorrido",{"_3379":69644,"_29627":69635,"_20564":117027,"_5":14107,"_26947":117002,"_2866":117028},[],"Cuándo existe el dispositivo",{"_3379":69645,"_29627":69635,"_20564":117030,"_5":14107,"_26947":117002,"_2866":117031},[],"Qué compruebas",{"_3379":69646,"_29627":69635,"_20564":117033,"_5":14107,"_26947":117002,"_2866":117034},[],"Asignación manual",{"_3379":69647,"_29627":69635,"_20564":117036,"_5":14107,"_26947":117002,"_2866":117037},[],"El operador lo crea antes de asociar un certificado.",{"_3379":69648,"_29627":69635,"_20564":117039,"_5":14107,"_26947":117002,"_2866":117040},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3379":69649,"_29627":69635,"_20564":117042,"_5":14107,"_26947":117002,"_2866":117043},[],"EST con `JITP`",{"_3379":69650,"_29627":69635,"_20564":117045,"_5":14107,"_26947":117002,"_2866":117046},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3379":69651,"_29627":69635,"_20564":117048,"_5":14107,"_26947":117002,"_2866":117049},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3379":69652,"_29627":69635,"_20564":117051,"_5":14107,"_26947":117002,"_2866":117052},[],"EST con `PRE_REGISTRATION`",{"_3379":69653,"_29627":69635,"_20564":117054,"_5":14107,"_26947":117002,"_2866":117055},[],"Debe existir antes de `/simpleenroll`.",{"_3379":69654,"_29627":69635,"_20564":117057,"_5":14107,"_26947":117002,"_2866":117058},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3379":69655,"_29627":69635,"_20564":117060,"_5":14107,"_26947":117002,"_2866":117061},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3379":69656,"_29627":69635,"_20564":117063,"_5":14107,"_26947":117002,"_2866":117064},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3379":69657,"_29627":69635,"_20564":117066,"_5":14107,"_26947":117006,"_2866":117067},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3379":69658,"_29627":69635,"_20564":117069,"_5":14107,"_26947":117006,"_2866":117070},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3379":69659,"_29627":69635,"_20564":117072,"_5":14107,"_26947":117006,"_2866":117073},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3379":69660,"_29627":69635,"_20564":117075,"_5":14107,"_26947":117010,"_2866":117076},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3379":69661,"_29627":69635,"_20564":117078,"_5":14107,"_26947":117010,"_2866":117079},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3379":69662,"_29627":69635,"_20564":117081,"_5":14107,"_26947":117010,"_2866":117082},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3379":69663,"_29627":69635,"_20564":117084,"_5":14107,"_26947":117010,"_2866":117085},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3379":69664,"_29627":69635,"_20564":117087,"_5":14107,"_26947":117010,"_2866":117088},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3379":69665,"_29627":69635,"_20564":117090,"_5":14107,"_26947":117010,"_2866":117091},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3379":69666,"_29627":69635,"_20564":117093,"_5":14107,"_26947":117014,"_2866":114036},[],{"_3379":69667,"_29627":69635,"_20564":117095,"_5":14107,"_26947":117014,"_2866":117096},[],"Material que atraviesa EST",{"_3379":69668,"_29627":69635,"_20564":117098,"_5":14107,"_26947":117014,"_2866":117099},[],"Clave generada por el dispositivo",{"_3379":69669,"_29627":69635,"_20564":117101,"_5":14107,"_26947":117014,"_2866":117102},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3379":69670,"_29627":69635,"_20564":117104,"_5":14107,"_26947":117014,"_2866":117105},[],"Clave ya disponible en el dispositivo",{"_3379":69671,"_29627":69635,"_20564":117107,"_5":14107,"_26947":117014,"_2866":117108},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3379":69672,"_29627":69635,"_20564":117110,"_5":14107,"_26947":117014,"_2866":51035},[],{"_3379":69673,"_29627":69635,"_20564":117112,"_5":14107,"_26947":117014,"_2866":117113},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3379":69674,"_29627":69635,"_20564":117115,"_5":14107,"_26947":117014,"_2866":117116},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3379":69675,"_29627":69635,"_20564":117118,"_5":14107,"_26947":117018,"_2866":117119},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3379":69676,"_29627":69676,"_5":14459,"_2866":117121,"_29980":117122,"_20564":117123,"_26947":69676},"Renovación y recuperación",[48237,115094,50716,116103,116278],[],{"_3379":69677,"_29627":69676,"_20564":117125,"_5":14107,"_26947":69676,"_2866":117126},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_3379":69678,"_29627":69676,"_5":29977,"_20564":117128,"_26947":117129,"_2866":117130},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_3379":69679,"_29627":69676,"_5":29977,"_20564":117132,"_26947":117133,"_2866":117134},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_3379":69680,"_29627":69676,"_5":29977,"_20564":117136,"_26947":117137,"_2866":117138},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_3379":69681,"_29627":69676,"_5":29977,"_20564":117140,"_26947":117141,"_2866":117142},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_3379":69682,"_29627":69676,"_5":29977,"_20564":117144,"_26947":117145,"_2866":117146},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_3379":69683,"_29627":69676,"_20564":117148,"_5":14107,"_26947":69676,"_2866":117149},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_3379":69684,"_29627":69676,"_20564":117151,"_5":14107,"_26947":117129,"_2866":117152},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3379":69685,"_29627":69676,"_20564":117154,"_5":14107,"_26947":117129,"_2866":117155},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3379":69686,"_29627":69676,"_20564":117157,"_5":14107,"_26947":117129,"_2866":117158},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3379":69687,"_29627":69676,"_20564":117160,"_5":14107,"_26947":117129,"_2866":117161},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3379":69688,"_29627":69676,"_20564":117163,"_5":14107,"_26947":117133,"_2866":117164},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3379":69689,"_29627":69676,"_20564":117166,"_5":14107,"_26947":117133,"_2866":117167},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3379":69690,"_29627":69676,"_20564":117169,"_5":14107,"_26947":117137,"_2866":117170},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3379":69691,"_29627":69676,"_20564":117172,"_5":14107,"_26947":117137,"_2866":117173},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3379":69692,"_29627":69676,"_20564":117175,"_5":14107,"_26947":117137,"_2866":117176},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3379":69693,"_29627":69676,"_20564":117178,"_5":14107,"_26947":117141,"_2866":117179},[],"Situación",{"_3379":69694,"_29627":69676,"_20564":117181,"_5":14107,"_26947":117141,"_2866":117182},[],"Procedimiento",{"_3379":69695,"_29627":69676,"_20564":117184,"_5":14107,"_26947":117141,"_2866":117185},[],"Certificado vigente, fuera de ventana",{"_3379":69696,"_29627":69676,"_20564":117187,"_5":14107,"_26947":117141,"_2866":117188},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3379":69697,"_29627":69676,"_20564":117190,"_5":14107,"_26947":117141,"_2866":117191},[],"Certificado vencido, clave disponible",{"_3379":69698,"_29627":69676,"_20564":117193,"_5":14107,"_26947":117141,"_2866":117194},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3379":69699,"_29627":69676,"_20564":117196,"_5":14107,"_26947":117141,"_2866":117197},[],"Renovación por webhook o `NO_AUTH`",{"_3379":69700,"_29627":69676,"_20564":117199,"_5":14107,"_26947":117141,"_2866":117200},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3379":69701,"_29627":69676,"_20564":117202,"_5":14107,"_26947":117141,"_2866":117203},[],"Clave perdida o inaccesible",{"_3379":69702,"_29627":69676,"_20564":117205,"_5":14107,"_26947":117141,"_2866":117206},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3379":69703,"_29627":69676,"_20564":117208,"_5":14107,"_26947":117141,"_2866":117209},[],"Identidad actual revocada",{"_3379":69704,"_29627":69676,"_20564":117211,"_5":14107,"_26947":117141,"_2866":117212},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3379":69705,"_29627":69676,"_20564":117214,"_5":14107,"_26947":117141,"_2866":117215},[],"Dispositivo sin identidad",{"_3379":69706,"_29627":69676,"_20564":117217,"_5":14107,"_26947":117141,"_2866":117218},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3379":69707,"_29627":69676,"_20564":117220,"_5":14107,"_26947":117141,"_2866":117221},[],"Dispositivo retirado",{"_3379":69708,"_29627":69676,"_20564":117223,"_5":14107,"_26947":117141,"_2866":117224},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3379":69709,"_29627":69676,"_20564":117226,"_5":14107,"_26947":117141,"_2866":117227},[],"Timeout, HTTP 500 o fallo de instalación",{"_3379":69710,"_29627":69676,"_20564":117229,"_5":14107,"_26947":117141,"_2866":117230},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3379":69711,"_29627":69676,"_20564":117232,"_5":14107,"_26947":117145,"_2866":117233},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3379":69712,"_29627":69676,"_20564":117235,"_5":14107,"_26947":117145,"_2866":117236},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3379":69713,"_29627":69713,"_5":14459,"_2866":117238,"_29980":117239,"_20564":117240,"_26947":69713},"Diagnóstico de enrolamiento",[48237,115094,50716,116103,116278],[],{"_3379":69714,"_29627":69713,"_20564":117242,"_5":14107,"_26947":69713,"_2866":117243},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3379":69715,"_29627":69713,"_5":29977,"_20564":117245,"_26947":117246,"_2866":117247},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3379":69716,"_29627":69713,"_5":29977,"_20564":117249,"_26947":117250,"_2866":117251},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3379":69717,"_29627":69713,"_5":29977,"_20564":117253,"_26947":117254,"_2866":116810},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_3379":69718,"_29627":69713,"_5":29977,"_20564":117256,"_26947":117257,"_2866":117258},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3379":69719,"_29627":69713,"_20564":117260,"_5":14107,"_26947":69713,"_2866":117261},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3379":69720,"_29627":69713,"_20564":117263,"_5":14107,"_26947":117250,"_2866":117264},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3379":69721,"_29627":69713,"_20564":117266,"_5":14107,"_26947":117250,"_2866":117267},[],"Síntoma o mensaje",{"_3379":69722,"_29627":69713,"_20564":117269,"_5":14107,"_26947":117250,"_2866":117270},[],"Qué revisar",{"_3379":69723,"_29627":69713,"_20564":117272,"_5":14107,"_26947":117250,"_2866":117273},[],"curl rechaza TLS, nombre o emisor",{"_3379":69724,"_29627":69713,"_20564":117275,"_5":14107,"_26947":117250,"_2866":117276},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3379":69725,"_29627":69713,"_20564":117278,"_5":14107,"_26947":117250,"_2866":117279},[],"404 o APS ausente",{"_3379":69726,"_29627":69713,"_20564":117281,"_5":14107,"_26947":117250,"_2866":117282},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3379":69727,"_29627":69713,"_20564":117284,"_5":14107,"_26947":117250,"_2866":117285},[],"400, error de CSR o formato",{"_3379":69728,"_29627":69713,"_20564":117287,"_5":14107,"_26947":117250,"_2866":117288},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3379":69729,"_29627":69713,"_20564":117290,"_5":14107,"_26947":117250,"_2866":117291},[],"Credencial ausente o certificado no válido",{"_3379":69730,"_29627":69713,"_20564":117293,"_5":14107,"_26947":117250,"_2866":117294},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3379":69731,"_29627":69713,"_20564":117296,"_5":14107,"_26947":117250,"_2866":117297},[],"Webhook deniega, expira o responde sin autorización",{"_3379":69732,"_29627":69713,"_20564":117299,"_5":14107,"_26947":117250,"_2866":117300},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3379":69733,"_29627":69713,"_20564":117302,"_5":14107,"_26947":117250,"_2866":51961},[],{"_3379":69734,"_29627":69713,"_20564":117304,"_5":14107,"_26947":117250,"_2866":117305},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3379":69735,"_29627":69713,"_20564":117307,"_5":14107,"_26947":117250,"_2866":51967},[],{"_3379":69736,"_29627":69713,"_20564":117309,"_5":14107,"_26947":117250,"_2866":117310},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3379":69737,"_29627":69713,"_20564":117312,"_5":14107,"_26947":117250,"_2866":51973},[],{"_3379":69738,"_29627":69713,"_20564":117314,"_5":14107,"_26947":117250,"_2866":117315},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3379":69739,"_29627":69713,"_20564":117317,"_5":14107,"_26947":117250,"_2866":51979},[],{"_3379":69740,"_29627":69713,"_20564":117319,"_5":14107,"_26947":117250,"_2866":117320},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3379":69741,"_29627":69713,"_20564":117322,"_5":14107,"_26947":117250,"_2866":51985},[],{"_3379":69742,"_29627":69713,"_20564":117324,"_5":14107,"_26947":117250,"_2866":117325},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3379":69743,"_29627":69713,"_20564":117327,"_5":14107,"_26947":117250,"_2866":117328},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3379":69744,"_29627":69713,"_20564":117330,"_5":14107,"_26947":117250,"_2866":117331},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3379":69745,"_29627":69713,"_20564":117333,"_5":14107,"_26947":117250,"_2866":117334},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3379":69746,"_29627":69713,"_20564":117336,"_5":14107,"_26947":117250,"_2866":117337},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3379":69747,"_29627":69713,"_20564":117339,"_5":14107,"_26947":117250,"_2866":52003},[],{"_3379":69748,"_29627":69713,"_20564":117341,"_5":14107,"_26947":117250,"_2866":117342},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3379":69749,"_29627":69713,"_20564":117344,"_5":14107,"_26947":117250,"_2866":52009},[],{"_3379":69750,"_29627":69713,"_20564":117346,"_5":14107,"_26947":117250,"_2866":117347},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3379":69751,"_29627":69713,"_20564":117349,"_5":14107,"_26947":117250,"_2866":117350},[],"DMS propietario distinto",{"_3379":69752,"_29627":69713,"_20564":117352,"_5":14107,"_26947":117250,"_2866":117353},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3379":69753,"_29627":69713,"_20564":117355,"_5":14107,"_26947":117250,"_2866":52021},[],{"_3379":69754,"_29627":69713,"_20564":117357,"_5":14107,"_26947":117250,"_2866":117358},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3379":69755,"_29627":69713,"_20564":117360,"_5":14107,"_26947":117250,"_2866":52027},[],{"_3379":69756,"_29627":69713,"_20564":117362,"_5":14107,"_26947":117250,"_2866":117363},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3379":69757,"_29627":69713,"_20564":117365,"_5":14107,"_26947":117250,"_2866":117366},[],"Certificado actual revocado",{"_3379":69758,"_29627":69713,"_20564":117368,"_5":14107,"_26947":117250,"_2866":117369},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3379":69759,"_29627":69713,"_20564":117371,"_5":14107,"_26947":117250,"_2866":117372},[],"Error de CA, perfil o firma",{"_3379":69760,"_29627":69713,"_20564":117374,"_5":14107,"_26947":117250,"_2866":117375},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3379":69761,"_29627":69713,"_20564":117377,"_5":14107,"_26947":117250,"_2866":117378},[],"HTTP 200 sin conexión del dispositivo",{"_3379":69762,"_29627":69713,"_20564":117380,"_5":14107,"_26947":117250,"_2866":117381},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3379":69763,"_29627":69713,"_20564":117383,"_5":14107,"_26947":117250,"_2866":117384},[],"Timeout o error después de emitir",{"_3379":69764,"_29627":69713,"_20564":117386,"_5":14107,"_26947":117250,"_2866":117387},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3379":69765,"_29627":69713,"_20564":117389,"_5":14107,"_26947":117254,"_2866":117390},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3379":69766,"_29627":69713,"_20564":117392,"_5":14107,"_26947":117254,"_2866":117393},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_3379":69767,"_29627":69713,"_20564":117395,"_5":14107,"_26947":117257,"_2866":117396},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3379":69768,"_29627":69713,"_20564":117398,"_5":14107,"_26947":117257,"_2866":117399},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3379":69769,"_29627":69713,"_20564":117401,"_5":14107,"_26947":117257,"_2866":117402},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3379":69770,"_29627":69713,"_20564":117404,"_5":14107,"_26947":117257,"_2866":117405},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3379":69771,"_29627":69713,"_20564":117407,"_5":14107,"_26947":117257,"_2866":117408},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3379":69772,"_29627":69713,"_20564":117410,"_5":14107,"_26947":117257,"_2866":117411},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3379":69773,"_29627":69713,"_20564":117413,"_5":14107,"_26947":117257,"_2866":117414},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3379":69774,"_29627":69774,"_5":14459,"_2866":117416,"_29980":117417,"_20564":117418,"_26947":69774},"Distribución y actualización de confianza",[48237,115094,50716,116103,116278],[],{"_3379":69775,"_29627":69774,"_20564":117420,"_5":14107,"_26947":69774,"_2866":117421},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_3379":69776,"_29627":69774,"_5":29977,"_20564":117423,"_26947":117424,"_2866":117425},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_3379":69777,"_29627":69774,"_5":29977,"_20564":117427,"_26947":117428,"_2866":117429},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_3379":69778,"_29627":69774,"_5":29977,"_20564":117431,"_26947":117432,"_2866":117433},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_3379":69779,"_29627":69774,"_5":29977,"_20564":117435,"_26947":117436,"_2866":117437},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_3379":69780,"_29627":69774,"_5":29977,"_20564":117439,"_26947":117440,"_2866":117441},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_3379":69781,"_29627":69774,"_20564":117443,"_5":14107,"_26947":69774,"_2866":117444},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_3379":69782,"_29627":69774,"_20564":117446,"_5":14107,"_26947":117424,"_2866":117447},[],"Relación",{"_3379":69783,"_29627":69774,"_20564":117449,"_5":14107,"_26947":117424,"_2866":117450},[],"Material que prepara el responsable",{"_3379":69784,"_29627":69774,"_20564":117452,"_5":14107,"_26947":117424,"_2866":117453},[],"Dispositivo → servidor EST",{"_3379":69785,"_29627":69774,"_20564":117455,"_5":14107,"_26947":117424,"_2866":117456},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_3379":69786,"_29627":69774,"_20564":117458,"_5":14107,"_26947":117424,"_2866":117459},[],"DMS → solicitante",{"_3379":69787,"_29627":69774,"_20564":117461,"_5":14107,"_26947":117424,"_2866":117462},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_3379":69788,"_29627":69774,"_20564":117464,"_5":14107,"_26947":117424,"_2866":117465},[],"Consumidor → dispositivo",{"_3379":69789,"_29627":69774,"_20564":117467,"_5":14107,"_26947":117424,"_2866":117468},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_3379":69790,"_29627":69774,"_20564":117470,"_5":14107,"_26947":117424,"_2866":117471},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_3379":69791,"_29627":69774,"_20564":117473,"_5":14107,"_26947":117428,"_2866":117474},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3379":69792,"_29627":69774,"_20564":117476,"_5":14107,"_26947":117428,"_2866":117477},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3379":69793,"_29627":69774,"_20564":117479,"_5":14107,"_26947":117432,"_2866":117480},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_3379":69794,"_29627":69774,"_20564":117482,"_5":14107,"_26947":117432,"_2866":117483},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_3379":69795,"_29627":69774,"_20564":117485,"_5":14107,"_26947":117432,"_2866":117486},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_3379":69796,"_29627":69774,"_20564":117488,"_5":14107,"_26947":117432,"_2866":117489},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_3379":69797,"_29627":69774,"_20564":117491,"_5":14107,"_26947":117432,"_2866":117492},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_3379":69798,"_29627":69774,"_20564":117494,"_5":14107,"_26947":117432,"_2866":117495},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_3379":69799,"_29627":69774,"_20564":117497,"_5":14107,"_26947":117436,"_2866":117498},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_3379":69800,"_29627":69774,"_20564":117500,"_5":14107,"_26947":117436,"_2866":117501},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_3379":69801,"_29627":69774,"_20564":117503,"_5":14107,"_26947":117436,"_2866":117504},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_3379":69802,"_29627":69774,"_20564":117506,"_5":14107,"_26947":117440,"_2866":117507},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_3379":69803,"_29627":69803,"_5":14459,"_2866":52176,"_29980":117509,"_20564":117511,"_26947":69803},[48237,115094,50716,116103,117510],"Integraciones",[],{"_3379":69804,"_29627":69803,"_20564":117513,"_5":14107,"_26947":69803,"_2866":117514},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3379":69805,"_29627":69803,"_5":29977,"_20564":117516,"_26947":117517,"_2866":117518},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3379":69806,"_29627":69803,"_5":29977,"_20564":117520,"_26947":117521,"_2866":117522},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3379":69807,"_29627":69803,"_5":29977,"_20564":117524,"_26947":117525,"_2866":117526},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3379":69808,"_29627":69803,"_5":29977,"_20564":117528,"_26947":117529,"_2866":117530},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3379":69809,"_29627":69803,"_5":29977,"_20564":117532,"_26947":117533,"_2866":117534},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","Eventos y recursos de AWS",{"_3379":69810,"_29627":69803,"_5":29977,"_20564":117536,"_26947":117537,"_2866":117538},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3379":69811,"_29627":69803,"_5":29977,"_20564":117540,"_26947":117541,"_2866":117542},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3379":69812,"_29627":69803,"_5":29977,"_20564":117544,"_26947":117545,"_2866":117546},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","Estados del registro de la CA",{"_3379":69813,"_29627":69803,"_5":29977,"_20564":117548,"_26947":117549,"_2866":52218},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3379":69814,"_29627":69803,"_5":29977,"_20564":117551,"_26947":117552,"_2866":52222},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3379":69815,"_29627":69803,"_5":29977,"_20564":117554,"_26947":117555,"_2866":117556},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3379":69816,"_29627":69803,"_5":29977,"_20564":117558,"_26947":117559,"_2866":117560},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3379":69817,"_29627":69803,"_5":29977,"_20564":117562,"_26947":117563,"_2866":117564},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3379":69818,"_29627":69803,"_5":29977,"_20564":117566,"_26947":117567,"_2866":117568},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3379":69819,"_29627":69803,"_5":29977,"_20564":117570,"_26947":117571,"_2866":117572},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","Estados del modo de registro del DMS",{"_3379":69820,"_29627":69803,"_5":29977,"_20564":117574,"_26947":117575,"_2866":117576},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3379":69821,"_29627":69803,"_5":29977,"_20564":117578,"_26947":117579,"_2866":117580},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","Ciclo de vida del Thing",{"_3379":69822,"_29627":69803,"_5":29977,"_20564":117582,"_26947":117583,"_2866":117584},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3379":69823,"_29627":69803,"_5":29977,"_20564":117586,"_26947":117587,"_2866":117588},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3379":69824,"_29627":69803,"_5":29977,"_20564":117590,"_26947":117591,"_2866":117592},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","Estados del certificado",{"_3379":69825,"_29627":69803,"_5":29977,"_20564":117594,"_26947":117595,"_2866":117596},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3379":69826,"_29627":69803,"_5":29977,"_20564":117598,"_26947":117599,"_2866":117600},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3379":69827,"_29627":69803,"_5":29977,"_20564":117602,"_26947":117603,"_2866":117604},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3379":69828,"_29627":69803,"_5":29977,"_20564":117606,"_26947":117607,"_2866":117608},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3379":69829,"_29627":69803,"_5":29977,"_20564":117610,"_26947":117611,"_2866":117612},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3379":69830,"_29627":69803,"_20564":117614,"_5":14107,"_26947":69803,"_2866":117615},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3379":69831,"_29627":69803,"_20564":117617,"_5":14107,"_26947":69803,"_2866":117618},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3379":69832,"_29627":69803,"_20564":117620,"_5":14107,"_26947":69803,"_2866":117621},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3379":69833,"_29627":69803,"_20564":117623,"_5":14107,"_26947":117517,"_2866":117624},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3379":69834,"_29627":69803,"_20564":117626,"_5":14107,"_26947":117517,"_2866":117627},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3379":69835,"_29627":69803,"_20564":117629,"_5":14107,"_26947":117517,"_2866":117630},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3379":69836,"_29627":69803,"_20564":117632,"_5":14107,"_26947":117517,"_2866":117633},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3379":69837,"_29627":69803,"_20564":117635,"_5":14107,"_26947":117521,"_2866":117636},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3379":69838,"_29627":69803,"_20564":117638,"_5":14107,"_26947":117525,"_2866":117639},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3379":69839,"_29627":69803,"_20564":117641,"_5":14107,"_26947":117525,"_2866":117642},[],"Acción IAM",{"_3379":69840,"_29627":69803,"_20564":117644,"_5":14107,"_26947":117525,"_2866":114042},[],{"_3379":69841,"_29627":69803,"_20564":117646,"_5":14107,"_26947":117525,"_2866":52317},[],{"_3379":69842,"_29627":69803,"_20564":117648,"_5":14107,"_26947":117525,"_2866":117649},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3379":69843,"_29627":69803,"_20564":117651,"_5":14107,"_26947":117525,"_2866":52323},[],{"_3379":69844,"_29627":69803,"_20564":117653,"_5":14107,"_26947":117525,"_2866":117654},[],"Registrar la CA en AWS IoT",{"_3379":69845,"_29627":69803,"_20564":117656,"_5":14107,"_26947":117525,"_2866":52329},[],{"_3379":69846,"_29627":69803,"_20564":117658,"_5":14107,"_26947":117525,"_2866":117659},[],"Consultar el estado del registro de la CA",{"_3379":69847,"_29627":69803,"_20564":117661,"_5":14107,"_26947":117525,"_2866":52335},[],{"_3379":69848,"_29627":69803,"_20564":117663,"_5":14107,"_26947":117525,"_2866":117664},[],"Crear o actualizar Things en IoT Core",{"_3379":69849,"_29627":69803,"_20564":117666,"_5":14107,"_26947":117525,"_2866":52341},[],{"_3379":69850,"_29627":69803,"_20564":117668,"_5":14107,"_26947":117525,"_2866":117669},[],"Aprovisionar Things mediante plantilla",{"_3379":69851,"_29627":69803,"_20564":117671,"_5":14107,"_26947":117525,"_2866":52347},[],{"_3379":69852,"_29627":69803,"_20564":117673,"_5":14107,"_26947":117525,"_2866":117674},[],"Registrar certificados de dispositivo",{"_3379":69853,"_29627":69803,"_20564":117676,"_5":14107,"_26947":117525,"_2866":52353},[],{"_3379":69854,"_29627":69803,"_20564":117678,"_5":14107,"_26947":117525,"_2866":117679},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3379":69855,"_29627":69803,"_20564":117681,"_5":14107,"_26947":117525,"_2866":52359},[],{"_3379":69856,"_29627":69803,"_20564":117683,"_5":14107,"_26947":117525,"_2866":117684},[],"Crear y adjuntar políticas IoT",{"_3379":69857,"_29627":69803,"_20564":117686,"_5":14107,"_26947":117525,"_2866":52365},[],{"_3379":69858,"_29627":69803,"_20564":117688,"_5":14107,"_26947":117525,"_2866":117689},[],"Gestionar grupos de Things",{"_3379":69859,"_29627":69803,"_20564":117691,"_5":14107,"_26947":117525,"_2866":52371},[],{"_3379":69860,"_29627":69803,"_20564":117693,"_5":14107,"_26947":117525,"_2866":117694},[],"Crear plantillas JITP",{"_3379":69861,"_29627":69803,"_20564":117696,"_5":14107,"_26947":117525,"_2866":52377},[],{"_3379":69862,"_29627":69803,"_20564":117698,"_5":14107,"_26947":117525,"_2866":117699},[],"Leer y escribir el Device Shadow",{"_3379":69863,"_29627":69803,"_20564":117701,"_5":14107,"_26947":117525,"_2866":117702},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3379":69864,"_29627":69803,"_20564":117704,"_5":14107,"_26947":117529,"_2866":117705},[],"Parámetro",{"_3379":69865,"_29627":69803,"_20564":117707,"_5":14107,"_26947":117529,"_2866":117708},[],"Tipo",{"_3379":69866,"_29627":69803,"_20564":117710,"_5":14107,"_26947":117529,"_2866":117711},[],"Requerido",{"_3379":69867,"_29627":69803,"_20564":117713,"_5":14107,"_26947":117529,"_2866":117714},[],"Descripción",{"_3379":69868,"_29627":69803,"_20564":117716,"_5":14107,"_26947":117529,"_2866":52398},[],{"_3379":69869,"_29627":69803,"_20564":117718,"_5":14107,"_26947":117529,"_2866":24568},[],{"_3379":69870,"_29627":69803,"_20564":117720,"_5":14107,"_26947":117529,"_2866":117721},[],"Sí",{"_3379":69871,"_29627":69803,"_20564":117723,"_5":14107,"_26947":117529,"_2866":117724},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3379":69872,"_29627":69803,"_20564":117726,"_5":14107,"_26947":117529,"_2866":52409},[],{"_3379":69873,"_29627":69803,"_20564":117728,"_5":14107,"_26947":117529,"_2866":24568},[],{"_3379":69874,"_29627":69803,"_20564":117730,"_5":14107,"_26947":117529,"_2866":117721},[],{"_3379":69875,"_29627":69803,"_20564":117732,"_5":14107,"_26947":117529,"_2866":117733},[],"Región AWS donde opera el conector.",{"_3379":69876,"_29627":69803,"_20564":117735,"_5":14107,"_26947":117529,"_2866":52419},[],{"_3379":69877,"_29627":69803,"_20564":117737,"_5":14107,"_26947":117529,"_2866":24568},[],{"_3379":69878,"_29627":69803,"_20564":117739,"_5":14107,"_26947":117529,"_2866":117721},[],{"_3379":69879,"_29627":69803,"_20564":117741,"_5":14107,"_26947":117529,"_2866":117742},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3379":69880,"_29627":69803,"_20564":117744,"_5":14107,"_26947":117529,"_2866":52429},[],{"_3379":69881,"_29627":69803,"_20564":117746,"_5":14107,"_26947":117529,"_2866":24568},[],{"_3379":69882,"_29627":69803,"_20564":117748,"_5":14107,"_26947":117529,"_2866":117749},[],"Solo con `auth_method=static`",{"_3379":69883,"_29627":69803,"_20564":117751,"_5":14107,"_26947":117529,"_2866":117752},[],"Clave de acceso AWS.",{"_3379":69884,"_29627":69803,"_20564":117754,"_5":14107,"_26947":117529,"_2866":52440},[],{"_3379":69885,"_29627":69803,"_20564":117756,"_5":14107,"_26947":117529,"_2866":24568},[],{"_3379":69886,"_29627":69803,"_20564":117758,"_5":14107,"_26947":117529,"_2866":117749},[],{"_3379":69887,"_29627":69803,"_20564":117760,"_5":14107,"_26947":117529,"_2866":117761},[],"Clave secreta AWS.",{"_3379":69888,"_29627":69803,"_20564":117763,"_5":14107,"_26947":117529,"_2866":52450},[],{"_3379":69889,"_29627":69803,"_20564":117765,"_5":14107,"_26947":117529,"_2866":24568},[],{"_3379":69890,"_29627":69803,"_20564":117767,"_5":14107,"_26947":117529,"_2866":52455},[],{"_3379":69891,"_29627":69803,"_20564":117769,"_5":14107,"_26947":117529,"_2866":117770},[],"Token de sesión (con `auth_method=static`).",{"_3379":69892,"_29627":69803,"_20564":117772,"_5":14107,"_26947":117529,"_2866":52461},[],{"_3379":69893,"_29627":69803,"_20564":117774,"_5":14107,"_26947":117529,"_2866":24568},[],{"_3379":69894,"_29627":69803,"_20564":117776,"_5":14107,"_26947":117529,"_2866":117777},[],"Solo con `auth_method=role`",{"_3379":69895,"_29627":69803,"_20564":117779,"_5":14107,"_26947":117529,"_2866":117780},[],"ARN del rol a asumir.",{"_3379":69896,"_29627":69803,"_20564":117782,"_5":14107,"_26947":117529,"_2866":52472},[],{"_3379":69897,"_29627":69803,"_20564":117784,"_5":14107,"_26947":117529,"_2866":24568},[],{"_3379":69898,"_29627":69803,"_20564":117786,"_5":14107,"_26947":117529,"_2866":52455},[],{"_3379":69899,"_29627":69803,"_20564":117788,"_5":14107,"_26947":117529,"_2866":117789},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3379":69900,"_29627":69803,"_20564":117791,"_5":14107,"_26947":117529,"_2866":52482},[],{"_3379":69901,"_29627":69803,"_20564":117793,"_5":14107,"_26947":117529,"_2866":87707},[],{"_3379":69902,"_29627":69803,"_20564":117795,"_5":14107,"_26947":117529,"_2866":117721},[],{"_3379":69903,"_29627":69803,"_20564":117797,"_5":14107,"_26947":117529,"_2866":117798},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3379":69904,"_29627":69803,"_20564":117800,"_5":14107,"_26947":117529,"_2866":52492},[],{"_3379":69905,"_29627":69803,"_20564":117802,"_5":14107,"_26947":117529,"_2866":24568},[],{"_3379":69906,"_29627":69803,"_20564":117804,"_5":14107,"_26947":117529,"_2866":117721},[],{"_3379":69907,"_29627":69803,"_20564":117806,"_5":14107,"_26947":117529,"_2866":117807},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3379":69908,"_29627":69803,"_20564":117809,"_5":14107,"_26947":117529,"_2866":52502},[],{"_3379":69909,"_29627":69803,"_20564":117811,"_5":14107,"_26947":117529,"_2866":24568},[],{"_3379":69910,"_29627":69803,"_20564":117813,"_5":14107,"_26947":117529,"_2866":117721},[],{"_3379":69911,"_29627":69803,"_20564":117815,"_5":14107,"_26947":117529,"_2866":117816},[],"URL HTTP del Device Manager de Lamassu.",{"_3379":69912,"_29627":69803,"_20564":117818,"_5":14107,"_26947":117529,"_2866":52512},[],{"_3379":69913,"_29627":69803,"_20564":117820,"_5":14107,"_26947":117529,"_2866":24568},[],{"_3379":69914,"_29627":69803,"_20564":117822,"_5":14107,"_26947":117529,"_2866":117721},[],{"_3379":69915,"_29627":69803,"_20564":117824,"_5":14107,"_26947":117529,"_2866":117825},[],"URL HTTP del servicio de CA de Lamassu.",{"_3379":69916,"_29627":69803,"_20564":117827,"_5":14107,"_26947":117533,"_2866":117828},[],"El conector gestiona el lado AWS de cuatro tipos de recursos: CAs, plantillas de aprovisionamiento de DMS (JITP), certificados de dispositivo y Things. Esta sección mapea los eventos del bus que consume el conector a los recursos de AWS que toca y a las llamadas AWS que ejecuta cada flujo. La máquina de estados de cada recurso está junto a su explicación detallada; la última columna enlaza a ella. Los recursos de AWS se referencian con la notación `IoTCore/<recurso>`.",{"_3379":69917,"_29627":69803,"_20564":117830,"_5":14107,"_26947":117533,"_2866":117831},[],"La columna **Tipo de CloudEvent** lista el nombre del evento en el bus interno de Lamassu; la columna **Acciones IAM** lista las operaciones exactas del SDK de AWS que invoca cada flujo, para que los permisos necesarios se deriven directamente de esta tabla.",{"_3379":69918,"_29627":69803,"_20564":117833,"_5":14107,"_26947":117533,"_2866":117834},[],"Tipo de CloudEvent",{"_3379":69919,"_29627":69803,"_20564":117836,"_5":14107,"_26947":117533,"_2866":117837},[],"Recurso en Lamassu",{"_3379":69920,"_29627":69803,"_20564":117839,"_5":14107,"_26947":117533,"_2866":117840},[],"Recurso AWS",{"_3379":69921,"_29627":69803,"_20564":117842,"_5":14107,"_26947":117533,"_2866":117843},[],"Acciones IAM",{"_3379":69922,"_29627":69803,"_20564":117845,"_5":14107,"_26947":117533,"_2866":117846},[],"Llamadas AWS y efecto",{"_3379":69923,"_29627":69803,"_20564":117848,"_5":14107,"_26947":117533,"_2866":117849},[],"Dónde en esta página",{"_3379":69924,"_29627":69803,"_20564":117851,"_5":14107,"_26947":117533,"_2866":52546},[],{"_3379":69925,"_29627":69803,"_20564":117853,"_5":14107,"_26947":117533,"_2866":52549},[],{"_3379":69926,"_29627":69803,"_20564":117855,"_5":14107,"_26947":117533,"_2866":52552},[],{"_3379":69927,"_29627":69803,"_20564":117857,"_5":14107,"_26947":117533,"_2866":52555},[],{"_3379":69928,"_29627":69803,"_20564":117859,"_5":14107,"_26947":117533,"_2866":117860},[],"Carga la CA en el estado del conector; una escritura de `registration.status = REQUESTED` dispara el flujo de registro (Primary con certificado de verificación, o SNI-only) y escribe `SUCCEEDED` o `FAILED` en los metadatos de la CA.",{"_3379":69929,"_29627":69803,"_20564":117862,"_5":14107,"_26947":117533,"_2866":117546},[],{"_3379":69930,"_29627":69803,"_20564":117864,"_5":14107,"_26947":117533,"_2866":52563},[],{"_3379":69931,"_29627":69803,"_20564":117866,"_5":14107,"_26947":117533,"_2866":52566},[],{"_3379":69932,"_29627":69803,"_20564":117868,"_5":14107,"_26947":117533,"_2866":52569},[],{"_3379":69933,"_29627":69803,"_20564":117870,"_5":14107,"_26947":117533,"_2866":52572},[],{"_3379":69934,"_29627":69803,"_20564":117872,"_5":14107,"_26947":117533,"_2866":117873},[],"En modo `jitp`, intenta crear la plantilla de aprovisionamiento y la adjunta a la CA registrada. No idempotente: una edición `PUT /v1/dms/{id}` reintenta la creación y acaba en `lamassu-dlq` tras 3 reintentos. Idempotente para `none` y `auto` (solo configuración).",{"_3379":69935,"_29627":69803,"_20564":117875,"_5":14107,"_26947":117533,"_2866":117572},[],{"_3379":69936,"_29627":69803,"_20564":117877,"_5":14107,"_26947":117533,"_2866":52580},[],{"_3379":69937,"_29627":69803,"_20564":117879,"_5":14107,"_26947":117533,"_2866":117880},[],"Dispositivo",{"_3379":69938,"_29627":69803,"_20564":117882,"_5":14107,"_26947":117533,"_2866":52586},[],{"_3379":69939,"_29627":69803,"_20564":117884,"_5":14107,"_26947":117533,"_2866":52589},[],{"_3379":69940,"_29627":69803,"_20564":117886,"_5":14107,"_26947":117533,"_2866":117887},[],"En modo `auto`: crea/actualiza políticas, asegura los grupos de Things, revoca principals obsoletos y aprovisiona el Thing vía `iot:RegisterThing`. En modo `jitp`: no hay llamadas AWS; AWS ejecuta la plantilla JITP en la primera conexión.",{"_3379":69941,"_29627":69803,"_20564":117889,"_5":14107,"_26947":117533,"_2866":117580},[],{"_3379":69942,"_29627":69803,"_20564":117891,"_5":14107,"_26947":117533,"_2866":52597},[],{"_3379":69943,"_29627":69803,"_20564":117893,"_5":14107,"_26947":117533,"_2866":117894},[],"Certificado",{"_3379":69944,"_29627":69803,"_20564":117896,"_5":14107,"_26947":117533,"_2866":52603},[],{"_3379":69945,"_29627":69803,"_20564":117898,"_5":14107,"_26947":117533,"_2866":117899},[],"`iot:UpdateCertificate`, `iot:Connect` (plano de datos)",{"_3379":69946,"_29627":69803,"_20564":117901,"_5":14107,"_26947":117533,"_2866":117902},[],"Mapea el estado a AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), llama a `iot:UpdateCertificate` y fuerza una desconexión MQTT al revocar.",{"_3379":69947,"_29627":69803,"_20564":117904,"_5":14107,"_26947":117533,"_2866":117592},[],{"_3379":69948,"_29627":69803,"_20564":117906,"_5":14107,"_26947":117533,"_2866":52614},[],{"_3379":69949,"_29627":69803,"_20564":117908,"_5":14107,"_26947":117533,"_2866":117909},[],"Certificado / Dispositivo",{"_3379":69950,"_29627":69803,"_20564":117911,"_5":14107,"_26947":117533,"_2866":52620},[],{"_3379":69951,"_29627":69803,"_20564":117913,"_5":14107,"_26947":117533,"_2866":48633},[],{"_3379":69952,"_29627":69803,"_20564":117915,"_5":14107,"_26947":117533,"_2866":117916},[],"Refresca el estado interno; el conector ignora los eventos cuyo campo CloudEvent `source` coincide con su propia URI para evitar bucles autodisparados.",{"_3379":69953,"_29627":69803,"_20564":117918,"_5":14107,"_26947":117533,"_2866":117600},[],{"_3379":69954,"_29627":69803,"_20564":117920,"_5":14107,"_26947":117537,"_2866":117921},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3379":69955,"_29627":69803,"_20564":117923,"_5":14107,"_26947":117541,"_2866":117924},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3379":69956,"_29627":69803,"_20564":117926,"_5":14107,"_26947":117541,"_2866":117927},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3379":69957,"_29627":69803,"_20564":117929,"_5":14107,"_26947":117545,"_2866":117930},[],"El flujo de registro de la CA se gobierna por el campo `registration.status` de los metadatos del conector en la CA:",{"_3379":69958,"_29627":69803,"_20564":117932,"_5":14107,"_26947":117545,"_2866":117933},[],"Transición",{"_3379":69959,"_29627":69803,"_20564":117935,"_5":14107,"_26947":117545,"_2866":117936},[],"Llamadas AWS",{"_3379":69960,"_29627":69803,"_20564":117938,"_5":14107,"_26947":117545,"_2866":117939},[],"`NoRegistrada` → `Solicitada`",{"_3379":69961,"_29627":69803,"_20564":117941,"_5":14107,"_26947":117545,"_2866":117942},[],"ninguna (solo escritura de metadatos)",{"_3379":69962,"_29627":69803,"_20564":117944,"_5":14107,"_26947":117545,"_2866":117945},[],"`Solicitada` → `Registrando`",{"_3379":69963,"_29627":69803,"_20564":117947,"_5":14107,"_26947":117545,"_2866":117948},[],"`iot:GetRegistrationCode` (solo Primary Account)",{"_3379":69964,"_29627":69803,"_20564":117950,"_5":14107,"_26947":117545,"_2866":117951},[],"`Registrando` → `Completada`",{"_3379":69965,"_29627":69803,"_20564":117953,"_5":14107,"_26947":117545,"_2866":117954},[],"`iot:RegisterCACertificate` (Primary: prueba de posesión con clave efímera; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3379":69966,"_29627":69803,"_20564":117956,"_5":14107,"_26947":117545,"_2866":117957},[],"`Registrando` → `Fallida`",{"_3379":69967,"_29627":69803,"_20564":117959,"_5":14107,"_26947":117545,"_2866":117960},[],"`iot:RegisterCACertificate` fallida; el detalle del error se escribe en los metadatos de la CA",{"_3379":69968,"_29627":69803,"_20564":117962,"_5":14107,"_26947":117545,"_2866":117963},[],"`Fallida` / `Completada` → `Solicitada`",{"_3379":69969,"_29627":69803,"_20564":117965,"_5":14107,"_26947":117545,"_2866":117966},[],"ninguna (una nueva escritura `REQUESTED` reejecuta el flujo)",{"_3379":69970,"_29627":69803,"_20564":117968,"_5":14107,"_26947":117549,"_2866":117969},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3379":69971,"_29627":69803,"_20564":117971,"_5":14107,"_26947":117549,"_2866":117972},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3379":69972,"_29627":69803,"_20564":117974,"_5":14107,"_26947":117549,"_2866":117975},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3379":69973,"_29627":69803,"_20564":117977,"_5":14107,"_26947":117549,"_2866":117978},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3379":69974,"_29627":69803,"_20564":117980,"_5":14107,"_26947":117549,"_2866":117981},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3379":69975,"_29627":69803,"_20564":117983,"_5":14107,"_26947":117549,"_2866":117984},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3379":69976,"_29627":69803,"_20564":117986,"_5":14107,"_26947":117552,"_2866":117987},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3379":69977,"_29627":69803,"_20564":117989,"_5":14107,"_26947":117555,"_2866":117990},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3379":69978,"_29627":69803,"_20564":117992,"_5":14107,"_26947":117555,"_2866":117993},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3379":69979,"_29627":69803,"_20564":117995,"_5":14107,"_26947":117559,"_2866":117996},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3379":69980,"_29627":69803,"_20564":117998,"_5":14107,"_26947":117563,"_2866":117999},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3379":69981,"_29627":69803,"_20564":118001,"_5":14107,"_26947":117563,"_2866":118002},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3379":69982,"_29627":69803,"_20564":118004,"_5":14107,"_26947":117563,"_2866":118005},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3379":69983,"_29627":69803,"_20564":118007,"_5":14107,"_26947":117563,"_2866":118008},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3379":69984,"_29627":69803,"_20564":118010,"_5":14107,"_26947":117563,"_2866":118011},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3379":69985,"_29627":69803,"_20564":118013,"_5":14107,"_26947":117563,"_2866":118014},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3379":69986,"_29627":69803,"_20564":118016,"_5":14107,"_26947":117567,"_2866":118017},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. El conector intenta crear esta plantilla cuando el DMS se crea y de nuevo en cada edición completa del DMS (`PUT /v1/dms/{id}`) - no en el momento del enrolamiento del dispositivo. El intento no es idempotente: cuando ya existe una plantilla nombrada con el ID del DMS, la llamada de creación falla, el evento se reintenta tres veces y acaba en la cola de mensajes fallidos `lamassu-dlq` (ver Solución de problemas). La plantilla se crea una sola vez; las ediciones posteriores nunca actualizan su contenido. Una actualización del DMS que omite `metadata` o envía `null` conserva los metadatos almacenados, así que la clave del conector `lamassu.io/iot/{connector_id}` sigue presente y el intento se sigue disparando. Un cuerpo que suministra un objeto `metadata` sustituye por completo los metadatos almacenados: si ese objeto no lleva la clave del conector, la clave se elimina y el conector omite silenciosamente los eventos futuros del DMS. Una vez adjuntada la plantilla, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3379":69987,"_29627":69803,"_20564":118019,"_5":14107,"_26947":117567,"_2866":118020},[],"El conector crea la plantilla, nombrada con el ID del DMS, una sola vez. Cada edición posterior del DMS que conserve la clave del conector intenta crearla de nuevo y falla, porque el conector no actualiza plantillas existentes. Los cambios posteriores en `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` o en los grupos y políticas que la plantilla referencia deben aplicarse a mano en AWS IoT Core.",{"_3379":69988,"_29627":69803,"_20564":118022,"_5":14107,"_26947":117567,"_2866":118023},[],"El evento fallido se reintenta y termina en `lamassu-dlq`. Los grupos y las políticas se registran antes del fallo, pero se omiten la asignación de la plantilla a la CA registrada, la escritura del ARN en el DMS y la actualización de las shadows al cambiar `ManagedCAs`.",{"_3379":69989,"_29627":69803,"_20564":118025,"_5":14107,"_26947":117567,"_2866":118026},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3379":69990,"_29627":69803,"_20564":118028,"_5":14107,"_26947":117567,"_2866":118029},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3379":69991,"_29627":69803,"_20564":118031,"_5":14107,"_26947":117571,"_2866":118032},[],"El `registration_mode` del DMS determina qué hace el conector en el lado AWS cuando el DMS se crea o se edita por completo:",{"_3379":69992,"_29627":69803,"_20564":118034,"_5":14107,"_26947":117571,"_2866":117933},[],{"_3379":69993,"_29627":69803,"_20564":118036,"_5":14107,"_26947":117571,"_2866":117936},[],{"_3379":69994,"_29627":69803,"_20564":118038,"_5":14107,"_26947":117571,"_2866":118039},[],"`SinConfigurar` → `None` / `Auto`",{"_3379":69995,"_29627":69803,"_20564":118041,"_5":14107,"_26947":117571,"_2866":118042},[],"ninguna (solo configuración)",{"_3379":69996,"_29627":69803,"_20564":118044,"_5":14107,"_26947":117571,"_2866":52757},[],{"_3379":69997,"_29627":69803,"_20564":118046,"_5":14107,"_26947":117571,"_2866":118042},[],{"_3379":69998,"_29627":69803,"_20564":118048,"_5":14107,"_26947":117571,"_2866":118049},[],"Cualquiera → `Jitp`",{"_3379":69999,"_29627":69803,"_20564":118051,"_5":14107,"_26947":117571,"_2866":118052},[],"`iot:CreateProvisioningTemplate` (no idempotente: falla si la plantilla ya existe; tras 3 reintentos el evento acaba en `lamassu-dlq`)",{"_3379":70000,"_29627":69803,"_20564":118054,"_5":14107,"_26947":117571,"_2866":52768},[],{"_3379":70001,"_29627":69803,"_20564":118056,"_5":14107,"_26947":117571,"_2866":118057},[],"ninguna (la plantilla permanece en la cuenta AWS)",{"_3379":70002,"_29627":69803,"_20564":118059,"_5":14107,"_26947":117575,"_2866":118060},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3379":70003,"_29627":69803,"_20564":118062,"_5":14107,"_26947":117575,"_2866":118063},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3379":70004,"_29627":69803,"_20564":118065,"_5":14107,"_26947":117575,"_2866":118066},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3379":70005,"_29627":69803,"_20564":118068,"_5":14107,"_26947":117579,"_2866":118069},[],"Los Things solo existen en modo `auto`; en modo `jitp` AWS crea el Thing por sí mismo cuando el dispositivo se conecta por primera vez. El nombre del Thing es siempre el CN del certificado del dispositivo:",{"_3379":70006,"_29627":69803,"_20564":118071,"_5":14107,"_26947":117579,"_2866":117933},[],{"_3379":70007,"_29627":69803,"_20564":118073,"_5":14107,"_26947":117579,"_2866":117936},[],{"_3379":70008,"_29627":69803,"_20564":118075,"_5":14107,"_26947":117579,"_2866":118076},[],"`Ausente` → `Aprovisionado`",{"_3379":70009,"_29627":69803,"_20564":118078,"_5":14107,"_26947":117579,"_2866":118079},[],"políticas creadas/actualizadas, grupos de Things asegurados, `iot:RegisterThing` (crea el Thing, registra el certificado, adjunta políticas)",{"_3379":70010,"_29627":69803,"_20564":118081,"_5":14107,"_26947":117579,"_2866":118082},[],"`Aprovisionado` → `Aprovisionado` (re-enrolamiento)",{"_3379":70011,"_29627":69803,"_20564":118084,"_5":14107,"_26947":117579,"_2866":118085},[],"principals obsoletos marcados como `REVOKED`, nueva ejecución de `iot:RegisterThing`; el nuevo ARN del certificado sustituye al anterior en los metadatos de Lamassu",{"_3379":70012,"_29627":69803,"_20564":118087,"_5":14107,"_26947":117579,"_2866":118088},[],"En modo `jitp` el conector no hace llamadas de aprovisionamiento: AWS ejecuta la plantilla JITP en la primera conexión del dispositivo y crea el Thing, registra el certificado y lo activa por su cuenta.",{"_3379":70013,"_29627":69803,"_20564":118090,"_5":14107,"_26947":117583,"_2866":118091},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3379":70014,"_29627":69803,"_20564":118093,"_5":14107,"_26947":117583,"_2866":118094},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3379":70015,"_29627":69803,"_20564":118096,"_5":14107,"_26947":117583,"_2866":118097},[],"Para que el flujo JITP funcione correctamente:",{"_3379":70016,"_29627":69803,"_20564":118099,"_5":14107,"_26947":117583,"_2866":118100},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3379":70017,"_29627":69803,"_20564":118102,"_5":14107,"_26947":117583,"_2866":118103},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3379":70018,"_29627":69803,"_20564":118105,"_5":14107,"_26947":117583,"_2866":118106},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3379":70019,"_29627":69803,"_20564":118108,"_5":14107,"_26947":117583,"_2866":118109},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3379":70020,"_29627":69803,"_20564":118111,"_5":14107,"_26947":117587,"_2866":118112},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3379":70021,"_29627":69803,"_20564":118114,"_5":14107,"_26947":117587,"_2866":118115},[],"Estado en Lamassu",{"_3379":70022,"_29627":69803,"_20564":118117,"_5":14107,"_26947":117587,"_2866":118118},[],"Razón de revocación",{"_3379":70023,"_29627":69803,"_20564":118120,"_5":14107,"_26947":117587,"_2866":118121},[],"Estado en AWS IoT Core",{"_3379":70024,"_29627":69803,"_20564":118123,"_5":14107,"_26947":117587,"_2866":52838},[],{"_3379":70025,"_29627":69803,"_20564":118125,"_5":14107,"_26947":117587,"_2866":118126},[],"Ninguna",{"_3379":70026,"_29627":69803,"_20564":118128,"_5":14107,"_26947":117587,"_2866":52844},[],{"_3379":70027,"_29627":69803,"_20564":118130,"_5":14107,"_26947":117587,"_2866":52847},[],{"_3379":70028,"_29627":69803,"_20564":118132,"_5":14107,"_26947":117587,"_2866":52850},[],{"_3379":70029,"_29627":69803,"_20564":118134,"_5":14107,"_26947":117587,"_2866":52853},[],{"_3379":70030,"_29627":69803,"_20564":118136,"_5":14107,"_26947":117587,"_2866":52847},[],{"_3379":70031,"_29627":69803,"_20564":118138,"_5":14107,"_26947":117587,"_2866":118139},[],"Cualquier otra razón",{"_3379":70032,"_29627":69803,"_20564":118141,"_5":14107,"_26947":117587,"_2866":52861},[],{"_3379":70033,"_29627":69803,"_20564":118143,"_5":14107,"_26947":117587,"_2866":118144},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3379":70034,"_29627":69803,"_20564":118146,"_5":14107,"_26947":117591,"_2866":118147},[],"Los certificados con la clave de metadatos del conector sincronizan su estado; los aprovisionados vía JITP no tienen clave de metadatos y quedan fuera de esta máquina:",{"_3379":70035,"_29627":69803,"_20564":118149,"_5":14107,"_26947":117591,"_2866":117933},[],{"_3379":70036,"_29627":69803,"_20564":118151,"_5":14107,"_26947":117591,"_2866":117936},[],{"_3379":70037,"_29627":69803,"_20564":118153,"_5":14107,"_26947":117591,"_2866":118154},[],"`NoSincronizado` → `Active`",{"_3379":70038,"_29627":69803,"_20564":118156,"_5":14107,"_26947":117591,"_2866":52353},[],{"_3379":70039,"_29627":69803,"_20564":118158,"_5":14107,"_26947":117591,"_2866":52879},[],{"_3379":70040,"_29627":69803,"_20564":118160,"_5":14107,"_26947":117591,"_2866":118161},[],"`iot:UpdateCertificate` + desconexión MQTT forzada",{"_3379":70041,"_29627":69803,"_20564":118163,"_5":14107,"_26947":117591,"_2866":52885},[],{"_3379":70042,"_29627":69803,"_20564":118165,"_5":14107,"_26947":117591,"_2866":118161},[],{"_3379":70043,"_29627":69803,"_20564":118167,"_5":14107,"_26947":117591,"_2866":52890},[],{"_3379":70044,"_29627":69803,"_20564":118169,"_5":14107,"_26947":117591,"_2866":52353},[],{"_3379":70045,"_29627":69803,"_20564":118171,"_5":14107,"_26947":117591,"_2866":52895},[],{"_3379":70046,"_29627":69803,"_20564":118173,"_5":14107,"_26947":117591,"_2866":118174},[],"ninguna (estos estados no se sincronizan con AWS)",{"_3379":70047,"_29627":69803,"_20564":118176,"_5":14107,"_26947":117595,"_2866":118177},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3379":70048,"_29627":69803,"_20564":118179,"_5":14107,"_26947":117595,"_2866":118180},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3379":70049,"_29627":69803,"_20564":118182,"_5":14107,"_26947":117595,"_2866":118183},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3379":70050,"_29627":69803,"_20564":118185,"_5":14107,"_26947":117599,"_2866":118186},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3379":70051,"_29627":69803,"_20564":118188,"_5":14107,"_26947":117599,"_2866":118189},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3379":70052,"_29627":69803,"_20564":118191,"_5":14107,"_26947":117603,"_2866":118192},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3379":70053,"_29627":69803,"_20564":118194,"_5":14107,"_26947":117603,"_2866":118195},[],"Existen dos tipos de acciones:",{"_3379":70054,"_29627":69803,"_20564":118197,"_5":14107,"_26947":117603,"_2866":118198},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3379":70055,"_29627":69803,"_20564":118200,"_5":14107,"_26947":117603,"_2866":118201},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3379":70056,"_29627":69803,"_20564":118203,"_5":14107,"_26947":117603,"_2866":118204},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3379":70057,"_29627":69803,"_20564":118206,"_5":14107,"_26947":117607,"_2866":118207},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3379":70058,"_29627":69803,"_20564":118209,"_5":14107,"_26947":117607,"_2866":118210},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3379":70059,"_29627":69803,"_20564":118212,"_5":14107,"_26947":117607,"_2866":118213},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3379":70060,"_29627":69803,"_20564":118215,"_5":14107,"_26947":117611,"_2866":118216},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3379":70061,"_29627":69803,"_20564":118218,"_5":14107,"_26947":117611,"_2866":118219},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3379":70062,"_29627":69803,"_20564":118221,"_5":14107,"_26947":117611,"_2866":118222},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3379":70063,"_29627":69803,"_20564":118224,"_5":14107,"_26947":117611,"_2866":118225},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3379":70064,"_29627":69803,"_20564":118227,"_5":14107,"_26947":117611,"_2866":118228},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3379":70065,"_29627":69803,"_20564":118230,"_5":14107,"_26947":117611,"_2866":118231},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3379":70066,"_29627":69803,"_20564":118233,"_5":14107,"_26947":117611,"_2866":118234},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3379":70067,"_29627":69803,"_20564":118236,"_5":14107,"_26947":117611,"_2866":118237},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3379":70068,"_29627":69803,"_20564":118239,"_5":14107,"_26947":117611,"_2866":118240},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3379":70069,"_29627":69803,"_20564":118242,"_5":14107,"_26947":117611,"_2866":118243},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3379":70070,"_29627":69803,"_20564":118245,"_5":14107,"_26947":117611,"_2866":118246},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3379":70071,"_29627":69803,"_20564":118248,"_5":14107,"_26947":117611,"_2866":118249},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3379":70072,"_29627":69803,"_20564":118251,"_5":14107,"_26947":117611,"_2866":118252},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3379":70073,"_29627":69803,"_20564":118254,"_5":14107,"_26947":117611,"_2866":118255},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3379":70074,"_29627":69803,"_20564":118257,"_5":14107,"_26947":117611,"_2866":118258},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3379":70075,"_29627":69803,"_20564":118260,"_5":14107,"_26947":117611,"_2866":118261},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3379":70076,"_29627":69803,"_20564":118263,"_5":14107,"_26947":117611,"_2866":118264},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3379":70077,"_29627":69803,"_20564":118266,"_5":14107,"_26947":117611,"_2866":118267},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3379":70078,"_29627":69803,"_20564":118269,"_5":14107,"_26947":117611,"_2866":118270},[],"**Síntoma:** Tras editar un DMS en modo `jitp`, aparecen mensajes de actualización del DMS en `lamassu-dlq`, o los cambios de configuración JITP no tienen efecto en AWS.",{"_3379":70079,"_29627":69803,"_20564":118272,"_5":14107,"_26947":117611,"_2866":118273},[],"**Causa:** Cada edición completa del DMS (`PUT /v1/dms/{id}`) dispara un nuevo intento de `CreateProvisioningTemplate` para la plantilla nombrada con el ID del DMS, y la llamada no es idempotente: cuando la plantilla ya existe, falla, el evento se reintenta tres veces y acaba en `lamassu-dlq`. Se omiten los pasos posteriores del conector.",{"_3379":70080,"_29627":69803,"_20564":118275,"_5":14107,"_26947":117611,"_2866":118276},[],"**Resolución:** Comprobar que la plantilla nombrada con el ID del DMS existe en AWS IoT Core y que el enrolamiento JITP funciona. Si se cambió la configuración JITP, aplicarla a mano en la plantilla de AWS.",{"_3379":70081,"_29627":69803,"_20564":118278,"_5":14107,"_26947":117611,"_2866":118279},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3379":70082,"_29627":69803,"_20564":118281,"_5":14107,"_26947":117611,"_2866":118282},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3379":70083,"_29627":69803,"_20564":118284,"_5":14107,"_26947":117611,"_2866":118285},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3379":70084,"_29627":70084,"_5":14459,"_2866":50716,"_29980":118287,"_20564":118288,"_26947":70084},[48237,115094,50716],[],{"_3379":70085,"_29627":70084,"_20564":118290,"_5":14107,"_26947":70084,"_2866":118291},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3379":70086,"_29627":70084,"_5":29977,"_20564":118293,"_26947":118294,"_2866":118295},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3379":70087,"_29627":70084,"_5":29977,"_20564":118297,"_26947":118298,"_2866":116103},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3379":70088,"_29627":70084,"_5":29977,"_20564":118300,"_26947":118301,"_2866":116278},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3379":70089,"_29627":70084,"_5":29977,"_20564":118303,"_26947":118304,"_2866":117510},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/overview#integraciones",{"_3379":70090,"_29627":70084,"_5":29977,"_20564":118306,"_26947":118307,"_2866":118308},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3379":70091,"_29627":70084,"_20564":118310,"_5":14107,"_26947":70084,"_2866":118311},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3379":70092,"_29627":70084,"_20564":118313,"_5":14107,"_26947":118294,"_2866":118314},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3379":70093,"_29627":70084,"_20564":118316,"_5":14107,"_26947":118294,"_2866":118317},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3379":70094,"_29627":70084,"_20564":118319,"_5":14107,"_26947":118298,"_2866":118320},[],"Recurso",{"_3379":70095,"_29627":70084,"_20564":118322,"_5":14107,"_26947":118298,"_2866":118323},[],"Qué representa",{"_3379":70096,"_29627":70084,"_20564":118325,"_5":14107,"_26947":118298,"_2866":118326},[],"**Dispositivo**",{"_3379":70097,"_29627":70084,"_20564":118328,"_5":14107,"_26947":118298,"_2866":118329},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3379":70098,"_29627":70084,"_20564":118331,"_5":14107,"_26947":118298,"_2866":118332},[],"**Identidad**",{"_3379":70099,"_29627":70084,"_20564":118334,"_5":14107,"_26947":118298,"_2866":118335},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3379":70100,"_29627":70084,"_20564":118337,"_5":14107,"_26947":118298,"_2866":53062},[],{"_3379":70101,"_29627":70084,"_20564":118339,"_5":14107,"_26947":118298,"_2866":118340},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3379":70102,"_29627":70084,"_20564":118342,"_5":14107,"_26947":118298,"_2866":118343},[],"**Flota**",{"_3379":70103,"_29627":70084,"_20564":118345,"_5":14107,"_26947":118298,"_2866":118346},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3379":70104,"_29627":70084,"_20564":118348,"_5":14107,"_26947":118298,"_2866":118349},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3379":70105,"_29627":70084,"_20564":118351,"_5":14107,"_26947":118298,"_2866":118352},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3379":70106,"_29627":70084,"_20564":118354,"_5":14107,"_26947":118301,"_2866":118355},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3379":70107,"_29627":70084,"_20564":118357,"_5":14107,"_26947":118301,"_2866":118358},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3379":70108,"_29627":70084,"_20564":118360,"_5":14107,"_26947":118301,"_2866":118361},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3379":70109,"_29627":70084,"_20564":118363,"_5":14107,"_26947":118301,"_2866":118364},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3379":70110,"_29627":70084,"_20564":118366,"_5":14107,"_26947":118301,"_2866":118367},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3379":70111,"_29627":70084,"_20564":118369,"_5":14107,"_26947":118301,"_2866":118370},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3379":70112,"_29627":70084,"_20564":118372,"_5":14107,"_26947":118301,"_2866":118373},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3379":70113,"_29627":70084,"_20564":118375,"_5":14107,"_26947":118301,"_2866":118376},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3379":70114,"_29627":70084,"_20564":118378,"_5":14107,"_26947":118304,"_2866":118379},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3379":70115,"_29627":70084,"_20564":118381,"_5":14107,"_26947":118304,"_2866":118382},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3379":70116,"_29627":70084,"_20564":118384,"_5":14107,"_26947":118307,"_2866":118385},[],"Participante",{"_3379":70117,"_29627":70084,"_20564":118387,"_5":14107,"_26947":118307,"_2866":118388},[],"Responsabilidad",{"_3379":70118,"_29627":70084,"_20564":118390,"_5":14107,"_26947":118307,"_2866":118391},[],"Administrador PKI",{"_3379":70119,"_29627":70084,"_20564":118393,"_5":14107,"_26947":118307,"_2866":118394},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3379":70120,"_29627":70084,"_20564":118396,"_5":14107,"_26947":118307,"_2866":118397},[],"Administrador del aprovisionamiento",{"_3379":70121,"_29627":70084,"_20564":118399,"_5":14107,"_26947":118307,"_2866":118400},[],"DMS, admisión, autenticación por operación e inventario.",{"_3379":70122,"_29627":70084,"_20564":118402,"_5":14107,"_26947":118307,"_2866":118403},[],"Integrador del dispositivo",{"_3379":70123,"_29627":70084,"_20564":118405,"_5":14107,"_26947":118307,"_2866":118406},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3379":70124,"_29627":70084,"_20564":118408,"_5":14107,"_26947":118307,"_2866":118409},[],"Integrador del consumidor",{"_3379":70125,"_29627":70084,"_20564":118411,"_5":14107,"_26947":118307,"_2866":118412},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3379":70126,"_29627":70084,"_20564":118414,"_5":14107,"_26947":118307,"_2866":118415},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3379":70127,"_29627":70127,"_5":14459,"_2866":118417,"_29980":118418,"_20564":118420,"_26947":70127},"Enrola y conecta tu primer dispositivo",[48237,115094,50716,118419],"Primeros pasos",[],{"_3379":70128,"_29627":70127,"_20564":118422,"_5":14107,"_26947":70127,"_2866":118423},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3379":70129,"_29627":70127,"_5":29977,"_20564":118425,"_26947":118426,"_2866":113672},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3379":70130,"_29627":70127,"_5":29977,"_20564":118428,"_26947":118429,"_2866":118430},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3379":70131,"_29627":70127,"_5":29977,"_20564":118432,"_26947":118433,"_2866":118434},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3379":70132,"_29627":70127,"_5":29977,"_20564":118436,"_26947":118437,"_2866":118438},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3379":70133,"_29627":70127,"_5":29977,"_20564":118440,"_26947":118441,"_2866":118442},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3379":70134,"_29627":70127,"_5":29977,"_20564":118444,"_26947":118445,"_2866":118446},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3379":70135,"_29627":70127,"_5":29977,"_20564":118448,"_26947":118449,"_2866":118450},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3379":70136,"_29627":70127,"_5":29977,"_20564":118452,"_26947":118453,"_2866":118454},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3379":70137,"_29627":70127,"_20564":118456,"_5":14107,"_26947":70127,"_2866":118457},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3379":70138,"_29627":70127,"_20564":118459,"_5":14107,"_26947":118426,"_2866":118460},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3379":70139,"_29627":70127,"_20564":118462,"_5":14107,"_26947":118426,"_2866":118463},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3379":70140,"_29627":70127,"_20564":118465,"_5":14107,"_26947":118426,"_2866":118466},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3379":70141,"_29627":70127,"_20564":118468,"_5":14107,"_26947":118426,"_2866":118469},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3379":70142,"_29627":70127,"_20564":118471,"_5":14107,"_26947":118426,"_2866":118472},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3379":70143,"_29627":70127,"_20564":118474,"_5":14107,"_26947":118429,"_2866":118475},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3379":70144,"_29627":70127,"_20564":118477,"_5":14107,"_26947":118429,"_2866":118478},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3379":70145,"_29627":70127,"_20564":118480,"_5":14107,"_26947":118433,"_2866":118481},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3379":70146,"_29627":70127,"_20564":118483,"_5":14107,"_26947":118433,"_2866":118484},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3379":70147,"_29627":70127,"_20564":118486,"_5":14107,"_26947":118433,"_2866":118487},[],"Ajuste",{"_3379":70148,"_29627":70127,"_20564":118489,"_5":14107,"_26947":118433,"_2866":118490},[],"Valor de evaluación",{"_3379":70149,"_29627":70127,"_20564":118492,"_5":14107,"_26947":118433,"_2866":53218},[],{"_3379":70150,"_29627":70127,"_20564":118494,"_5":14107,"_26947":118433,"_2866":118495},[],"Raíz emisora de `device-root.pem`.",{"_3379":70151,"_29627":70127,"_20564":118497,"_5":14107,"_26947":118433,"_2866":116406},[],{"_3379":70152,"_29627":70127,"_20564":118499,"_5":14107,"_26947":118433,"_2866":118500},[],"Perfil final de 1 hora que acabas de preparar.",{"_3379":70153,"_29627":70127,"_20564":118502,"_5":14107,"_26947":118433,"_2866":53229},[],{"_3379":70154,"_29627":70127,"_20564":118504,"_5":14107,"_26947":118433,"_2866":53232},[],{"_3379":70155,"_29627":70127,"_20564":118506,"_5":14107,"_26947":118433,"_2866":53235},[],{"_3379":70156,"_29627":70127,"_20564":118508,"_5":14107,"_26947":118433,"_2866":118509},[],"Habilitado.",{"_3379":70157,"_29627":70127,"_20564":118511,"_5":14107,"_26947":118433,"_2866":53241},[],{"_3379":70158,"_29627":70127,"_20564":118513,"_5":14107,"_26947":118433,"_2866":118514},[],"Deshabilitado; el ID debe ser nuevo.",{"_3379":70159,"_29627":70127,"_20564":118516,"_5":14107,"_26947":118433,"_2866":118517},[],"Autenticación inicial",{"_3379":70160,"_29627":70127,"_20564":118519,"_5":14107,"_26947":118433,"_2866":118520},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3379":70161,"_29627":70127,"_20564":118522,"_5":14107,"_26947":118433,"_2866":118523},[],"Autenticación de renovación",{"_3379":70162,"_29627":70127,"_20564":118525,"_5":14107,"_26947":118433,"_2866":118526},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3379":70163,"_29627":70127,"_20564":118528,"_5":14107,"_26947":118433,"_2866":53259},[],{"_3379":70164,"_29627":70127,"_20564":118530,"_5":14107,"_26947":118433,"_2866":118531},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_3379":70165,"_29627":70127,"_20564":118533,"_5":14107,"_26947":118433,"_2866":53265},[],{"_3379":70166,"_29627":70127,"_20564":118535,"_5":14107,"_26947":118433,"_2866":118536},[],"1 hora.",{"_3379":70167,"_29627":70127,"_20564":118538,"_5":14107,"_26947":118433,"_2866":53271},[],{"_3379":70168,"_29627":70127,"_20564":118540,"_5":14107,"_26947":118433,"_2866":118541},[],"30 minutos / 10 minutos.",{"_3379":70169,"_29627":70127,"_20564":118543,"_5":14107,"_26947":118433,"_2866":53277},[],{"_3379":70170,"_29627":70127,"_20564":118545,"_5":14107,"_26947":118433,"_2866":118546},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3379":70171,"_29627":70127,"_20564":118548,"_5":14107,"_26947":118433,"_2866":51035},[],{"_3379":70172,"_29627":70127,"_20564":118550,"_5":14107,"_26947":118433,"_2866":118551},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3379":70173,"_29627":70127,"_20564":118553,"_5":14107,"_26947":118433,"_2866":53288},[],{"_3379":70174,"_29627":70127,"_20564":118555,"_5":14107,"_26947":118433,"_2866":118556},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3379":70175,"_29627":70127,"_20564":118558,"_5":14107,"_26947":118433,"_2866":118559},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento; la guía DMS describe sus campos, y también puedes comprobar el recurso mediante la API DMS.",{"_3379":70176,"_29627":70127,"_20564":118561,"_5":14107,"_26947":118437,"_2866":118562},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3379":70177,"_29627":70127,"_20564":118564,"_5":14107,"_26947":118437,"_2866":118565},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3379":70178,"_29627":70127,"_20564":118567,"_5":14107,"_26947":118441,"_2866":118568},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3379":70179,"_29627":70127,"_20564":118570,"_5":14107,"_26947":118441,"_2866":118571},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3379":70180,"_29627":70127,"_20564":118573,"_5":14107,"_26947":118441,"_2866":118574},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3379":70181,"_29627":70127,"_20564":118576,"_5":14107,"_26947":118445,"_2866":118577},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3379":70182,"_29627":70127,"_20564":118579,"_5":14107,"_26947":118445,"_2866":118580},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3379":70183,"_29627":70127,"_20564":118582,"_5":14107,"_26947":118449,"_2866":118583},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3379":70184,"_29627":70127,"_20564":118585,"_5":14107,"_26947":118449,"_2866":118586},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3379":70185,"_29627":70127,"_20564":118588,"_5":14107,"_26947":118449,"_2866":118589},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3379":70186,"_29627":70127,"_20564":118591,"_5":14107,"_26947":118449,"_2866":118592},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3379":70187,"_29627":70127,"_20564":118594,"_5":14107,"_26947":118449,"_2866":118595},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3379":70188,"_29627":70127,"_20564":118597,"_5":14107,"_26947":118453,"_2866":118598},[],"Comprobación",{"_3379":70189,"_29627":70127,"_20564":118600,"_5":14107,"_26947":118453,"_2866":118601},[],"Resultado esperado",{"_3379":70190,"_29627":70127,"_20564":118603,"_5":14107,"_26947":118453,"_2866":118604},[],"Registro",{"_3379":70191,"_29627":70127,"_20564":118606,"_5":14107,"_26947":118453,"_2866":118607},[],"ID creado automáticamente y DMS correcto.",{"_3379":70192,"_29627":70127,"_20564":118609,"_5":14107,"_26947":118453,"_2866":117894},[],{"_3379":70193,"_29627":70127,"_20564":118611,"_5":14107,"_26947":118453,"_2866":118612},[],"CN, perfil, serie y clave verificados.",{"_3379":70194,"_29627":70127,"_20564":118614,"_5":14107,"_26947":118453,"_2866":118615},[],"Inventario",{"_3379":70195,"_29627":70127,"_20564":118617,"_5":14107,"_26947":118453,"_2866":118618},[],"Serie recibida visible como identidad actual y en el historial.",{"_3379":70196,"_29627":70127,"_20564":118620,"_5":14107,"_26947":118453,"_2866":118621},[],"Consumidor",{"_3379":70197,"_29627":70127,"_20564":118623,"_5":14107,"_26947":118453,"_2866":118624},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3379":70198,"_29627":70127,"_20564":118626,"_5":14107,"_26947":118453,"_2866":118627},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3379":70199,"_29627":70127,"_20564":118629,"_5":14107,"_26947":118453,"_2866":118630},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3379":70200,"_29627":70200,"_5":14459,"_2866":116120,"_29980":118632,"_20564":118633,"_26947":70200},[48237,115094,50716,118419],[],{"_3379":70201,"_29627":70200,"_20564":118635,"_5":14107,"_26947":70200,"_2866":118636},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3379":70202,"_29627":70200,"_5":29977,"_20564":118638,"_26947":118639,"_2866":113672},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3379":70203,"_29627":70200,"_5":29977,"_20564":118641,"_26947":118642,"_2866":118643},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3379":70204,"_29627":70200,"_5":29977,"_20564":118645,"_26947":118646,"_2866":118647},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3379":70205,"_29627":70200,"_5":29977,"_20564":118649,"_26947":118650,"_2866":118651},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3379":70206,"_29627":70200,"_5":29977,"_20564":118653,"_26947":118654,"_2866":118655},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3379":70207,"_29627":70200,"_5":29977,"_20564":118657,"_26947":118658,"_2866":118659},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3379":70208,"_29627":70200,"_5":29977,"_20564":118661,"_26947":118662,"_2866":118601},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3379":70209,"_29627":70200,"_5":29977,"_20564":118664,"_26947":118665,"_2866":118666},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3379":70210,"_29627":70200,"_5":29977,"_20564":118668,"_26947":118669,"_2866":118670},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3379":70211,"_29627":70200,"_20564":118672,"_5":14107,"_26947":70200,"_2866":118673},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3379":70212,"_29627":70200,"_20564":118675,"_5":14107,"_26947":70200,"_2866":118676},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3379":70213,"_29627":70200,"_20564":118678,"_5":14107,"_26947":118639,"_2866":118679},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3379":70214,"_29627":70200,"_20564":118681,"_5":14107,"_26947":118639,"_2866":118682},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3379":70215,"_29627":70200,"_20564":118684,"_5":14107,"_26947":118639,"_2866":118685},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3379":70216,"_29627":70200,"_20564":118687,"_5":14107,"_26947":118639,"_2866":118688},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3379":70217,"_29627":70200,"_20564":118690,"_5":14107,"_26947":118642,"_2866":118691},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3379":70218,"_29627":70200,"_20564":118693,"_5":14107,"_26947":118642,"_2866":118694},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3379":70219,"_29627":70200,"_20564":118696,"_5":14107,"_26947":118642,"_2866":118697},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3379":70220,"_29627":70200,"_20564":118699,"_5":14107,"_26947":118642,"_2866":118700},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3379":70221,"_29627":70200,"_20564":118702,"_5":14107,"_26947":118642,"_2866":118703},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_3379":70222,"_29627":70200,"_20564":118705,"_5":14107,"_26947":118642,"_2866":118706},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3379":70223,"_29627":70200,"_20564":118708,"_5":14107,"_26947":118642,"_2866":118709},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3379":70224,"_29627":70200,"_20564":118711,"_5":14107,"_26947":118642,"_2866":118712},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3379":70225,"_29627":70200,"_20564":118714,"_5":14107,"_26947":118646,"_2866":118715},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3379":70226,"_29627":70200,"_20564":118717,"_5":14107,"_26947":118646,"_2866":53453},[],{"_3379":70227,"_29627":70200,"_20564":118719,"_5":14107,"_26947":118646,"_2866":118720},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3379":70228,"_29627":70200,"_20564":118722,"_5":14107,"_26947":118646,"_2866":118723},[],"**Icon** y **Tags**: clasificación opcional.",{"_3379":70229,"_29627":70200,"_20564":118725,"_5":14107,"_26947":118646,"_2866":118726},[],"Confirma el registro.",{"_3379":70230,"_29627":70200,"_20564":118728,"_5":14107,"_26947":118650,"_2866":118729},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3379":70231,"_29627":70200,"_20564":118731,"_5":14107,"_26947":118650,"_2866":118732},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3379":70232,"_29627":70200,"_20564":118734,"_5":14107,"_26947":118654,"_2866":118735},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3379":70233,"_29627":70200,"_20564":118737,"_5":14107,"_26947":118654,"_2866":118738},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3379":70234,"_29627":70200,"_20564":118740,"_5":14107,"_26947":118658,"_2866":118741},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3379":70235,"_29627":70200,"_20564":118743,"_5":14107,"_26947":118658,"_2866":118744},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3379":70236,"_29627":70200,"_20564":118746,"_5":14107,"_26947":118662,"_2866":118598},[],{"_3379":70237,"_29627":70200,"_20564":118748,"_5":14107,"_26947":118662,"_2866":118749},[],"Resultado",{"_3379":70238,"_29627":70200,"_20564":118751,"_5":14107,"_26947":118662,"_2866":117880},[],{"_3379":70239,"_29627":70200,"_20564":118753,"_5":14107,"_26947":118662,"_2866":118754},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3379":70240,"_29627":70200,"_20564":118756,"_5":14107,"_26947":118662,"_2866":118757},[],"Identidad actual",{"_3379":70241,"_29627":70200,"_20564":118759,"_5":14107,"_26947":118662,"_2866":118760},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3379":70242,"_29627":70200,"_20564":118762,"_5":14107,"_26947":118662,"_2866":118763},[],"Historial",{"_3379":70243,"_29627":70200,"_20564":118765,"_5":14107,"_26947":118662,"_2866":118766},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3379":70244,"_29627":70200,"_20564":118768,"_5":14107,"_26947":118662,"_2866":118769},[],"Clave y certificado",{"_3379":70245,"_29627":70200,"_20564":118771,"_5":14107,"_26947":118662,"_2866":118772},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3379":70246,"_29627":70200,"_20564":118774,"_5":14107,"_26947":118665,"_2866":118775},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3379":70247,"_29627":70200,"_20564":118777,"_5":14107,"_26947":118665,"_2866":118778},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3379":70248,"_29627":70200,"_20564":118780,"_5":14107,"_26947":118665,"_2866":118781},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3379":70249,"_29627":70200,"_20564":118783,"_5":14107,"_26947":118665,"_2866":118784},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3379":70250,"_29627":70200,"_20564":118786,"_5":14107,"_26947":118669,"_2866":118787},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3379":70251,"_29627":70200,"_20564":118789,"_5":14107,"_26947":118669,"_2866":118790},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3379":70252,"_29627":70200,"_20564":118792,"_5":14107,"_26947":118669,"_2866":118793},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3379":70253,"_29627":70253,"_5":14459,"_2866":118795,"_29980":118796,"_20564":118797,"_26947":70253},"Plataforma Lamassu IoT",[48237,115094],[],{"_3379":70254,"_29627":70253,"_20564":118799,"_5":14107,"_26947":70253,"_2866":118800},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3379":70255,"_29627":70253,"_5":29977,"_20564":118802,"_26947":118803,"_2866":118295},[],"/docs/pr-preview/pr-55/es/platform/overview#empieza-aquí",{"_3379":70256,"_29627":70253,"_5":29977,"_20564":118805,"_26947":118806,"_2866":118807},[],"/docs/pr-preview/pr-55/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3379":70257,"_29627":70253,"_5":29977,"_20564":118809,"_26947":118810,"_2866":118811},[],"/docs/pr-preview/pr-55/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3379":70258,"_29627":70253,"_5":29977,"_20564":118813,"_26947":118814,"_2866":118815},[],"/docs/pr-preview/pr-55/es/platform/overview#capacidades-principales","Capacidades principales",{"_3379":70259,"_29627":70253,"_5":29977,"_20564":118817,"_26947":118818,"_2866":118819},[],"/docs/pr-preview/pr-55/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3379":70260,"_29627":70253,"_5":29977,"_20564":118821,"_26947":118822,"_2866":118823},[],"/docs/pr-preview/pr-55/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3379":70261,"_29627":70253,"_5":29977,"_20564":118825,"_26947":118826,"_2866":118827},[],"/docs/pr-preview/pr-55/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3379":70262,"_29627":70253,"_5":29977,"_20564":118829,"_26947":118830,"_2866":118831},[],"/docs/pr-preview/pr-55/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3379":70263,"_29627":70253,"_5":29977,"_20564":118833,"_26947":118834,"_2866":118835},[],"/docs/pr-preview/pr-55/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3379":70264,"_29627":70253,"_5":29977,"_20564":118837,"_26947":118838,"_2866":118839},[],"/docs/pr-preview/pr-55/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3379":70265,"_29627":70253,"_5":29977,"_20564":118841,"_26947":118842,"_2866":118843},[],"/docs/pr-preview/pr-55/es/platform/overview#referencia-operativa","Referencia operativa",{"_3379":70266,"_29627":70253,"_20564":118845,"_5":14107,"_26947":70253,"_2866":118846},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3379":70267,"_29627":70253,"_20564":118848,"_5":14107,"_26947":118803,"_2866":118849},[],"Elige el resultado que necesitas obtener:",{"_3379":70268,"_29627":70253,"_20564":118851,"_5":14107,"_26947":118803,"_2866":118852},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3379":70269,"_29627":70253,"_20564":118854,"_5":14107,"_26947":118803,"_2866":118855},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3379":70270,"_29627":70253,"_20564":118857,"_5":14107,"_26947":118803,"_2866":118858},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3379":70271,"_29627":70253,"_20564":118860,"_5":14107,"_26947":118806,"_2866":118861},[],"Bloque",{"_3379":70272,"_29627":70253,"_20564":118863,"_5":14107,"_26947":118806,"_2866":118864},[],"Qué gestionas",{"_3379":70273,"_29627":70253,"_20564":118866,"_5":14107,"_26947":118806,"_2866":118867},[],"Punto de entrada",{"_3379":70274,"_29627":70253,"_20564":118869,"_5":14107,"_26947":118806,"_2866":53606},[],{"_3379":70275,"_29627":70253,"_20564":118871,"_5":14107,"_26947":118806,"_2866":118872},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3379":70276,"_29627":70253,"_20564":118874,"_5":14107,"_26947":118806,"_2866":118875},[],"Visión general de PKI",{"_3379":70277,"_29627":70253,"_20564":118877,"_5":14107,"_26947":118806,"_2866":53615},[],{"_3379":70278,"_29627":70253,"_20564":118879,"_5":14107,"_26947":118806,"_2866":118880},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3379":70279,"_29627":70253,"_20564":118882,"_5":14107,"_26947":118806,"_2866":118883},[],"Visión general de IoT Fleets",{"_3379":70280,"_29627":70253,"_20564":118885,"_5":14107,"_26947":118806,"_2866":118886},[],"**Administración**",{"_3379":70281,"_29627":70253,"_20564":118888,"_5":14107,"_26947":118806,"_2866":118889},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3379":70282,"_29627":70253,"_20564":118891,"_5":14107,"_26947":118806,"_2866":115092},[],{"_3379":70283,"_29627":70253,"_20564":118893,"_5":14107,"_26947":118806,"_2866":118894},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3379":70284,"_29627":70253,"_20564":118896,"_5":14107,"_26947":118810,"_2866":118897},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3379":70285,"_29627":70253,"_20564":118899,"_5":14107,"_26947":118810,"_2866":118900},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3379":70286,"_29627":70253,"_20564":118902,"_5":14107,"_26947":118810,"_2866":118903},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3379":70287,"_29627":70253,"_20564":118905,"_5":14107,"_26947":118810,"_2866":118906},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3379":70288,"_29627":70253,"_20564":118908,"_5":14107,"_26947":118810,"_2866":118909},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3379":70289,"_29627":70253,"_20564":118911,"_5":14107,"_26947":118810,"_2866":118912},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3379":70290,"_29627":70253,"_20564":118914,"_5":14107,"_26947":118818,"_2866":118915},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3379":70291,"_29627":70253,"_20564":118917,"_5":14107,"_26947":118822,"_2866":118918},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3379":70292,"_29627":70253,"_20564":118920,"_5":14107,"_26947":118826,"_2866":118921},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3379":70293,"_29627":70253,"_20564":118923,"_5":14107,"_26947":118830,"_2866":118924},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3379":70294,"_29627":70253,"_20564":118926,"_5":14107,"_26947":118834,"_2866":118927},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3379":70295,"_29627":70253,"_20564":118929,"_5":14107,"_26947":118838,"_2866":118930},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3379":70296,"_29627":70253,"_20564":118932,"_5":14107,"_26947":118842,"_2866":118388},[],{"_3379":70297,"_29627":70253,"_20564":118934,"_5":14107,"_26947":118842,"_2866":118935},[],"Qué prepara o comprueba",{"_3379":70298,"_29627":70253,"_20564":118937,"_5":14107,"_26947":118842,"_2866":118391},[],{"_3379":70299,"_29627":70253,"_20564":118939,"_5":14107,"_26947":118842,"_2866":118940},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3379":70300,"_29627":70253,"_20564":118942,"_5":14107,"_26947":118842,"_2866":118943},[],"Administrador de la flota",{"_3379":70301,"_29627":70253,"_20564":118945,"_5":14107,"_26947":118842,"_2866":118946},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3379":70302,"_29627":70253,"_20564":118948,"_5":14107,"_26947":118842,"_2866":118403},[],{"_3379":70303,"_29627":70253,"_20564":118950,"_5":14107,"_26947":118842,"_2866":118951},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3379":70304,"_29627":70253,"_20564":118953,"_5":14107,"_26947":118842,"_2866":118409},[],{"_3379":70305,"_29627":70253,"_20564":118955,"_5":14107,"_26947":118842,"_2866":118956},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3379":70306,"_29627":70253,"_20564":118958,"_5":14107,"_26947":118842,"_2866":118959},[],"Operador de infraestructura",{"_3379":70307,"_29627":70253,"_20564":118961,"_5":14107,"_26947":118842,"_2866":118962},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3379":70308,"_29627":70253,"_20564":118964,"_5":14107,"_26947":118842,"_2866":118965},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3379":70309,"_29627":70309,"_5":14459,"_2866":118967,"_29980":118968,"_20564":118970,"_26947":70309},"Jerarquía y rotación de CAs",[48237,115094,53707,118969],"Claves, autoridades y certificados",[],{"_3379":70310,"_29627":70309,"_20564":118972,"_5":14107,"_26947":70309,"_2866":118973},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3379":70311,"_29627":70309,"_5":29977,"_20564":118975,"_26947":118976,"_2866":118977},[],"/docs/pr-preview/pr-55/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3379":70312,"_29627":70309,"_5":29977,"_20564":118979,"_26947":118980,"_2866":118981},[],"/docs/pr-preview/pr-55/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3379":70313,"_29627":70309,"_5":29977,"_20564":118983,"_26947":118984,"_2866":118985},[],"/docs/pr-preview/pr-55/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3379":70314,"_29627":70309,"_5":29977,"_20564":118987,"_26947":118988,"_2866":118989},[],"/docs/pr-preview/pr-55/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3379":70315,"_29627":70309,"_5":29977,"_20564":118991,"_26947":118992,"_2866":118993},[],"/docs/pr-preview/pr-55/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3379":70316,"_29627":70309,"_5":29977,"_20564":118995,"_26947":118996,"_2866":118997},[],"/docs/pr-preview/pr-55/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3379":70317,"_29627":70309,"_5":29977,"_20564":118999,"_26947":119000,"_2866":119001},[],"/docs/pr-preview/pr-55/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3379":70318,"_29627":70309,"_5":29977,"_20564":119003,"_26947":119004,"_2866":119005},[],"/docs/pr-preview/pr-55/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3379":70319,"_29627":70309,"_5":29977,"_20564":119007,"_26947":119008,"_2866":119009},[],"/docs/pr-preview/pr-55/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3379":70320,"_29627":70309,"_5":29977,"_20564":119011,"_26947":119012,"_2866":119013},[],"/docs/pr-preview/pr-55/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3379":70321,"_29627":70309,"_5":29977,"_20564":119015,"_26947":119016,"_2866":119017},[],"/docs/pr-preview/pr-55/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3379":70322,"_29627":70309,"_5":29977,"_20564":119019,"_26947":119020,"_2866":119021},[],"/docs/pr-preview/pr-55/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3379":70323,"_29627":70309,"_20564":119023,"_5":14107,"_26947":70309,"_2866":119024},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3379":70324,"_29627":70309,"_20564":119026,"_5":14107,"_26947":70309,"_2866":119027},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3379":70325,"_29627":70309,"_20564":119029,"_5":14107,"_26947":118976,"_2866":119030},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3379":70326,"_29627":70309,"_20564":119032,"_5":14107,"_26947":118976,"_2866":119033},[],"entorno, como producción y preproducción;",{"_3379":70327,"_29627":70309,"_20564":119035,"_5":14107,"_26947":118976,"_2866":119036},[],"propietario o equipo operador;",{"_3379":70328,"_29627":70309,"_20564":119038,"_5":14107,"_26947":118976,"_2866":119039},[],"familia de dispositivos o proceso de fabricación;",{"_3379":70329,"_29627":70309,"_20564":119041,"_5":14107,"_26947":118976,"_2866":119042},[],"región o requisito regulatorio;",{"_3379":70330,"_29627":70309,"_20564":119044,"_5":14107,"_26947":118976,"_2866":119045},[],"motor criptográfico o política de clave;",{"_3379":70331,"_29627":70309,"_20564":119047,"_5":14107,"_26947":118976,"_2866":119048},[],"ventana de mantenimiento y ritmo de renovación.",{"_3379":70332,"_29627":70309,"_20564":119050,"_5":14107,"_26947":118976,"_2866":119051},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3379":70333,"_29627":70309,"_20564":119053,"_5":14107,"_26947":118976,"_2866":119054},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3379":70334,"_29627":70309,"_20564":119056,"_5":14107,"_26947":118980,"_2866":119057},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3379":70335,"_29627":70309,"_20564":119059,"_5":14107,"_26947":118980,"_2866":119060},[],"Si un rol VA de CRL de la CA está firmado por el certificado de la CA sustituido, al reemitir el firmante se mueve al certificado nuevo y se republica la CRL. Un rol firmado por otro certificado conserva ese firmante; consulta la guía de CRL.",{"_3379":70336,"_29627":70309,"_20564":119062,"_5":14107,"_26947":118980,"_2866":119063},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3379":70337,"_29627":70309,"_20564":119065,"_5":14107,"_26947":118980,"_2866":119066},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_3379":70338,"_29627":70309,"_20564":119068,"_5":14107,"_26947":118984,"_2866":119069},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3379":70339,"_29627":70309,"_20564":119071,"_5":14107,"_26947":118984,"_2866":119072},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3379":70340,"_29627":70309,"_20564":119074,"_5":14107,"_26947":118984,"_2866":119075},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3379":70341,"_29627":70309,"_20564":119077,"_5":14107,"_26947":118984,"_2866":119078},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3379":70342,"_29627":70309,"_20564":119080,"_5":14107,"_26947":118992,"_2866":119081},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3379":70343,"_29627":70309,"_20564":119083,"_5":14107,"_26947":118996,"_2866":119084},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3379":70344,"_29627":70309,"_20564":119086,"_5":14107,"_26947":119000,"_2866":119087},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3379":70345,"_29627":70309,"_20564":119089,"_5":14107,"_26947":119004,"_2866":119090},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_3379":70346,"_29627":70309,"_20564":119092,"_5":14107,"_26947":119008,"_2866":119093},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3379":70347,"_29627":70309,"_20564":119095,"_5":14107,"_26947":119012,"_2866":119096},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_3379":70348,"_29627":70309,"_20564":119098,"_5":14107,"_26947":119016,"_2866":119099},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3379":70349,"_29627":70309,"_20564":119101,"_5":14107,"_26947":119016,"_2866":119102},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3379":70350,"_29627":70309,"_20564":119104,"_5":14107,"_26947":119016,"_2866":119105},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_3379":70351,"_29627":70309,"_20564":119107,"_5":14107,"_26947":119016,"_2866":119108},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3379":70352,"_29627":70309,"_20564":119110,"_5":14107,"_26947":119020,"_2866":119111},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3379":70353,"_29627":70309,"_20564":119113,"_5":14107,"_26947":119020,"_2866":119114},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3379":70354,"_29627":70309,"_20564":119116,"_5":14107,"_26947":119020,"_2866":119117},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3379":70355,"_29627":70309,"_20564":119119,"_5":14107,"_26947":119020,"_2866":119120},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3379":70356,"_29627":70309,"_20564":119122,"_5":14107,"_26947":119020,"_2866":119123},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3379":70357,"_29627":70309,"_20564":119125,"_5":14107,"_26947":119020,"_2866":119126},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3379":70358,"_29627":70309,"_20564":119128,"_5":14107,"_26947":119020,"_2866":119129},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3379":70359,"_29627":70359,"_5":14459,"_2866":119131,"_29980":119132,"_20564":119133,"_26947":70359},"Autoridades de certificación",[48237,115094,53707,118969],[],{"_3379":70360,"_29627":70359,"_20564":119135,"_5":14107,"_26947":70359,"_2866":119136},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3379":70361,"_29627":70359,"_5":29977,"_20564":119138,"_26947":119139,"_2866":119140},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3379":70362,"_29627":70359,"_5":29977,"_20564":119142,"_26947":119143,"_2866":119144},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3379":70363,"_29627":70359,"_5":29977,"_20564":119146,"_26947":119147,"_2866":113672},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3379":70364,"_29627":70359,"_5":29977,"_20564":119149,"_26947":119150,"_2866":119151},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3379":70365,"_29627":70359,"_5":29977,"_20564":119153,"_26947":119154,"_2866":119155},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3379":70366,"_29627":70359,"_5":29977,"_20564":119157,"_26947":119158,"_2866":119159},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3379":70367,"_29627":70359,"_5":29977,"_20564":119161,"_26947":119162,"_2866":119163},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3379":70368,"_29627":70359,"_5":29977,"_20564":119165,"_26947":119166,"_2866":119167},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3379":70369,"_29627":70359,"_5":29977,"_20564":119169,"_26947":119170,"_2866":119171},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3379":70370,"_29627":70359,"_5":29977,"_20564":119173,"_26947":119174,"_2866":119175},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3379":70371,"_29627":70359,"_5":29977,"_20564":119177,"_26947":119178,"_2866":119179},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3379":70372,"_29627":70359,"_5":29977,"_20564":119181,"_26947":119182,"_2866":119183},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3379":70373,"_29627":70359,"_5":29977,"_20564":119185,"_26947":119186,"_2866":119187},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3379":70374,"_29627":70359,"_5":29977,"_20564":119189,"_26947":119190,"_2866":119191},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3379":70375,"_29627":70359,"_5":29977,"_20564":119193,"_26947":119194,"_2866":119195},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3379":70376,"_29627":70359,"_5":29977,"_20564":119197,"_26947":119198,"_2866":119199},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3379":70377,"_29627":70359,"_5":29977,"_20564":119201,"_26947":119202,"_2866":119203},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3379":70378,"_29627":70359,"_5":29977,"_20564":119205,"_26947":119206,"_2866":119207},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3379":70379,"_29627":70359,"_5":29977,"_20564":119209,"_26947":119210,"_2866":119211},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3379":70380,"_29627":70359,"_5":29977,"_20564":119213,"_26947":119214,"_2866":119215},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3379":70381,"_29627":70359,"_5":29977,"_20564":119217,"_26947":119218,"_2866":119219},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3379":70382,"_29627":70359,"_5":29977,"_20564":119221,"_26947":119222,"_2866":119223},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3379":70383,"_29627":70359,"_5":29977,"_20564":119225,"_26947":119226,"_2866":119227},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-authorities#elimina-una-ca","Elimina una CA",{"_3379":70384,"_29627":70359,"_20564":119229,"_5":14107,"_26947":70359,"_2866":119230},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3379":70385,"_29627":70359,"_20564":119232,"_5":14107,"_26947":70359,"_2866":119233},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3379":70386,"_29627":70359,"_20564":119235,"_5":14107,"_26947":70359,"_2866":119236},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3379":70387,"_29627":70359,"_20564":119238,"_5":14107,"_26947":119139,"_2866":119239},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3379":70388,"_29627":70359,"_20564":119241,"_5":14107,"_26947":119139,"_2866":119242},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3379":70389,"_29627":70359,"_20564":119244,"_5":14107,"_26947":119139,"_2866":119245},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3379":70390,"_29627":70359,"_20564":119247,"_5":14107,"_26947":119139,"_2866":119248},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3379":70391,"_29627":70359,"_20564":119250,"_5":14107,"_26947":119139,"_2866":119251},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3379":70392,"_29627":70359,"_20564":119253,"_5":14107,"_26947":119147,"_2866":119254},[],"Decide si la CA será raíz o intermedia.",{"_3379":70393,"_29627":70359,"_20564":119256,"_5":14107,"_26947":119147,"_2866":119257},[],"Elige el motor que custodiará la clave.",{"_3379":70394,"_29627":70359,"_20564":119259,"_5":14107,"_26947":119147,"_2866":119260},[],"Define una validez superior a la de los certificados que emitirá.",{"_3379":70395,"_29627":70359,"_20564":119262,"_5":14107,"_26947":119147,"_2866":119263},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3379":70396,"_29627":70359,"_20564":119265,"_5":14107,"_26947":119150,"_2866":119266},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3379":70397,"_29627":70359,"_20564":119268,"_5":14107,"_26947":119154,"_2866":119269},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3379":70398,"_29627":70359,"_20564":119271,"_5":14107,"_26947":119154,"_2866":119272},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3379":70399,"_29627":70359,"_20564":119274,"_5":14107,"_26947":119158,"_2866":119275},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3379":70400,"_29627":70359,"_20564":119277,"_5":14107,"_26947":119162,"_2866":119278},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3379":70401,"_29627":70359,"_20564":119280,"_5":14107,"_26947":119162,"_2866":119281},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3379":70402,"_29627":70359,"_20564":119283,"_5":14107,"_26947":119162,"_2866":119284},[],"`ST`: estado o provincia.",{"_3379":70403,"_29627":70359,"_20564":119286,"_5":14107,"_26947":119162,"_2866":119287},[],"`L`: localidad.",{"_3379":70404,"_29627":70359,"_20564":119289,"_5":14107,"_26947":119162,"_2866":119290},[],"`O`: organización.",{"_3379":70405,"_29627":70359,"_20564":119292,"_5":14107,"_26947":119162,"_2866":119293},[],"`OU`: unidad organizativa.",{"_3379":70406,"_29627":70359,"_20564":119295,"_5":14107,"_26947":119162,"_2866":119296},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3379":70407,"_29627":70359,"_20564":119298,"_5":14107,"_26947":119166,"_2866":119299},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3379":70408,"_29627":70359,"_20564":119301,"_5":14107,"_26947":119166,"_2866":119302},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3379":70409,"_29627":70359,"_20564":119304,"_5":14107,"_26947":119170,"_2866":119305},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3379":70410,"_29627":70359,"_20564":119307,"_5":14107,"_26947":119170,"_2866":119308},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3379":70411,"_29627":70359,"_20564":119310,"_5":14107,"_26947":119174,"_2866":119311},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3379":70412,"_29627":70359,"_20564":119313,"_5":14107,"_26947":119174,"_2866":119314},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3379":70413,"_29627":70359,"_20564":119316,"_5":14107,"_26947":119178,"_2866":119317},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma (incluido `cRLSign`, sin el cual la CA no puede publicar su CRL) y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3379":70414,"_29627":70359,"_20564":119319,"_5":14107,"_26947":119178,"_2866":119320},[],"El backend rechaza una importación cuyo certificado carece de la restricción básica de CA (`basicConstraints cA flag is not set`), cuyo número de serie coincide con el de un certificado almacenado con contenido distinto, o cuyo certificado idéntico ya pertenece a una CA existente. El registro de certificado de una CA eliminada se conserva y puede reutilizarse al reimportar el mismo certificado, incluido su estado anterior. Reimportar otro certificado con ese número de serie se rechaza; comprueba el certificado y su estado tras reimportarlo.",{"_3379":70415,"_29627":70359,"_20564":119322,"_5":14107,"_26947":119178,"_2866":119323},[],"Eliminar una CA libera las referencias a la clave de su propio certificado actual y de sus certificados reemitidos vinculados, pero conserva esos registros para la CRL y el OCSP de su emisor. Después intenta eliminar la clave; el KMS la conserva si otros certificados todavía la referencian, como los de otra CA que comparte la clave. Revocar los certificados emitidos por la CA eliminada no libera sus propias referencias a claves.",{"_3379":70416,"_29627":70359,"_20564":119325,"_5":14107,"_26947":119182,"_2866":119326},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3379":70417,"_29627":70359,"_20564":119328,"_5":14107,"_26947":119186,"_2866":119329},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3379":70418,"_29627":70359,"_20564":119331,"_5":14107,"_26947":119190,"_2866":119332},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3379":70419,"_29627":70359,"_20564":119334,"_5":14107,"_26947":119194,"_2866":119335},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3379":70420,"_29627":70359,"_20564":119337,"_5":14107,"_26947":119194,"_2866":119338},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3379":70421,"_29627":70359,"_20564":119340,"_5":14107,"_26947":119198,"_2866":119341},[],"Abre una CA desde el inventario para consultar:",{"_3379":70422,"_29627":70359,"_20564":119343,"_5":14107,"_26947":119198,"_2866":119344},[],"Estado y periodo de validez.",{"_3379":70423,"_29627":70359,"_20564":119346,"_5":14107,"_26947":119198,"_2866":119347},[],"Certificado y cadena en formato PEM.",{"_3379":70424,"_29627":70359,"_20564":119349,"_5":14107,"_26947":119198,"_2866":119350},[],"Número de certificados activos, expirados y revocados.",{"_3379":70425,"_29627":70359,"_20564":119352,"_5":14107,"_26947":119198,"_2866":119353},[],"Certificados emitidos en **Issued Certificates**.",{"_3379":70426,"_29627":70359,"_20564":119355,"_5":14107,"_26947":119198,"_2866":119356},[],"CRL vinculada a la autoridad.",{"_3379":70427,"_29627":70359,"_20564":119358,"_5":14107,"_26947":119198,"_2866":119359},[],"Metadatos y motor criptográfico asociado.",{"_3379":70428,"_29627":70359,"_20564":119361,"_5":14107,"_26947":119198,"_2866":119362},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3379":70429,"_29627":70359,"_20564":119364,"_5":14107,"_26947":119202,"_2866":119365},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3379":70430,"_29627":70359,"_20564":119367,"_5":14107,"_26947":119202,"_2866":119368},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3379":70431,"_29627":70359,"_20564":119370,"_5":14107,"_26947":119202,"_2866":119371},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3379":70432,"_29627":70359,"_20564":119373,"_5":14107,"_26947":119202,"_2866":119374},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3379":70433,"_29627":70359,"_20564":119376,"_5":14107,"_26947":119206,"_2866":119377},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_3379":70434,"_29627":70359,"_20564":119379,"_5":14107,"_26947":119210,"_2866":119380},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3379":70435,"_29627":70359,"_20564":119382,"_5":14107,"_26947":119214,"_2866":119383},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3379":70436,"_29627":70359,"_20564":119385,"_5":14107,"_26947":119218,"_2866":119386},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3379":70437,"_29627":70359,"_20564":119388,"_5":14107,"_26947":119222,"_2866":119389},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3379":70438,"_29627":70359,"_20564":119391,"_5":14107,"_26947":119226,"_2866":119392},[],"La eliminación permanente solo está disponible con la CA revocada o caducada; una CA importada sin clave puede eliminarse en cualquier estado. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3379":70439,"_29627":70359,"_20564":119394,"_5":14107,"_26947":119226,"_2866":119395},[],"El rol VA de la CA se conserva. Si no queda otra CA con el mismo SKI, deja de ser editable (consulta CRL), así que ajusta antes su validez y su firmante. La clave de la CA se libera, pero el KMS la conserva mientras otros certificados la referencien.",{"_3379":70440,"_29627":70359,"_20564":119397,"_5":14107,"_26947":119226,"_2866":119398},[],"Lamassu conserva el registro del certificado de una CA eliminada. Si se importa de nuevo ese mismo certificado, la importación termina bien y reutiliza el registro: actualiza el tipo, el emisor y la clave, pero conserva el estado, así que la CA reaparece con el que tenía al eliminarse (normalmente revocada o caducada). Un certificado distinto con el mismo número de serie se rechaza con error 400, y un certificado que ya pertenece a una CA existente, con error 409. Para no heredar el estado anterior, usa un certificado con otro número de serie y comprueba el resultado tras importar. Si el certificado nuevo usa la misma clave, comparte el SKI con el rol VA retenido de la CA eliminada, cuyo firmante es el certificado antiguo: comprueba que la CRL se genera y, si no es así, asigna con `PUT` un firmante de la CA nueva (consulta CRL).",{"_3379":70441,"_29627":70441,"_5":14459,"_2866":119400,"_29980":119401,"_20564":119402,"_26947":70441},"Perfiles de certificado",[48237,115094,53707,118969],[],{"_3379":70442,"_29627":70441,"_20564":119404,"_5":14107,"_26947":70441,"_2866":119405},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3379":70443,"_29627":70441,"_5":29977,"_20564":119407,"_26947":119408,"_2866":119409},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3379":70444,"_29627":70441,"_5":29977,"_20564":119411,"_26947":119412,"_2866":119413},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-profiles#validez","Validez",{"_3379":70445,"_29627":70441,"_5":29977,"_20564":119415,"_26947":119416,"_2866":119417},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3379":70446,"_29627":70441,"_5":29977,"_20564":119419,"_26947":119420,"_2866":119421},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3379":70447,"_29627":70441,"_5":29977,"_20564":119423,"_26947":119424,"_2866":119425},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3379":70448,"_29627":70441,"_5":29977,"_20564":119427,"_26947":119428,"_2866":119429},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3379":70449,"_29627":70441,"_5":29977,"_20564":119431,"_26947":119432,"_2866":119433},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3379":70450,"_29627":70441,"_5":29977,"_20564":119435,"_26947":119436,"_2866":119437},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3379":70451,"_29627":70441,"_5":29977,"_20564":119439,"_26947":119440,"_2866":119441},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3379":70452,"_29627":70441,"_5":29977,"_20564":119443,"_26947":119444,"_2866":119445},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3379":70453,"_29627":70441,"_5":29977,"_20564":119447,"_26947":119448,"_2866":119449},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3379":70454,"_29627":70441,"_5":29977,"_20564":119451,"_26947":119452,"_2866":119453},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3379":70455,"_29627":70441,"_5":29977,"_20564":119455,"_26947":119456,"_2866":119457},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3379":70456,"_29627":70441,"_5":29977,"_20564":119459,"_26947":119460,"_2866":119461},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3379":70457,"_29627":70441,"_5":29977,"_20564":119463,"_26947":119464,"_2866":119465},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3379":70458,"_29627":70441,"_5":29977,"_20564":119467,"_26947":119468,"_2866":119469},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3379":70459,"_29627":70441,"_20564":119471,"_5":14107,"_26947":70441,"_2866":119472},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3379":70460,"_29627":70441,"_20564":119474,"_5":14107,"_26947":70441,"_2866":119475},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3379":70461,"_29627":70441,"_20564":119477,"_5":14107,"_26947":119412,"_2866":119478},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3379":70462,"_29627":70441,"_20564":119480,"_5":14107,"_26947":119412,"_2866":119481},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3379":70463,"_29627":70441,"_20564":119483,"_5":14107,"_26947":119416,"_2866":119484},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Actívalo solo en perfiles destinados a crear o reemitir CAs subordinadas.",{"_3379":70464,"_29627":70441,"_20564":119486,"_5":14107,"_26947":119420,"_2866":119487},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3379":70465,"_29627":70441,"_20564":119489,"_5":14107,"_26947":119420,"_2866":119490},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3379":70466,"_29627":70441,"_20564":119492,"_5":14107,"_26947":119420,"_2866":119493},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3379":70467,"_29627":70441,"_20564":119495,"_5":14107,"_26947":119424,"_2866":119496},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3379":70468,"_29627":70441,"_20564":119498,"_5":14107,"_26947":119428,"_2866":119499},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3379":70469,"_29627":70441,"_20564":119501,"_5":14107,"_26947":119428,"_2866":119502},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3379":70470,"_29627":70441,"_20564":119504,"_5":14107,"_26947":119432,"_2866":119505},[],"La aplicación criptográfica puede:",{"_3379":70471,"_29627":70441,"_20564":119507,"_5":14107,"_26947":119432,"_2866":119508},[],"permitir o bloquear claves RSA;",{"_3379":70472,"_29627":70441,"_20564":119510,"_5":14107,"_26947":119432,"_2866":119511},[],"limitar los tamaños RSA admitidos;",{"_3379":70473,"_29627":70441,"_20564":119513,"_5":14107,"_26947":119432,"_2866":119514},[],"permitir o bloquear claves ECDSA;",{"_3379":70474,"_29627":70441,"_20564":119516,"_5":14107,"_26947":119432,"_2866":119517},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3379":70475,"_29627":70441,"_20564":119519,"_5":14107,"_26947":119432,"_2866":119520},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3379":70476,"_29627":70441,"_20564":119522,"_5":14107,"_26947":119436,"_2866":119523},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3379":70477,"_29627":70441,"_20564":119525,"_5":14107,"_26947":119436,"_2866":114854},[],{"_3379":70478,"_29627":70441,"_20564":119527,"_5":14107,"_26947":119436,"_2866":119528},[],"Primera opción",{"_3379":70479,"_29627":70441,"_20564":119530,"_5":14107,"_26947":119436,"_2866":119531},[],"Segunda opción",{"_3379":70480,"_29627":70441,"_20564":119533,"_5":14107,"_26947":119436,"_2866":119534},[],"Si no hay ninguna",{"_3379":70481,"_29627":70441,"_20564":119536,"_5":14107,"_26947":119436,"_2866":119537},[],"Firma directa con una CA",{"_3379":70482,"_29627":70441,"_20564":119539,"_5":14107,"_26947":119436,"_2866":119540},[],"`issuance_profile` incluido en la solicitud",{"_3379":70483,"_29627":70441,"_20564":119542,"_5":14107,"_26947":119436,"_2866":119543},[],"`issuance_profile_id` de la solicitud",{"_3379":70484,"_29627":70441,"_20564":119545,"_5":14107,"_26947":119436,"_2866":119546},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3379":70485,"_29627":70441,"_20564":119548,"_5":14107,"_26947":119436,"_2866":119549},[],"Emisión mediante DMS",{"_3379":70486,"_29627":70441,"_20564":119551,"_5":14107,"_26947":119436,"_2866":54291},[],{"_3379":70487,"_29627":70441,"_20564":119553,"_5":14107,"_26947":119436,"_2866":119554},[],"`settings.issuance_profile` incluido en el DMS",{"_3379":70488,"_29627":70441,"_20564":119556,"_5":14107,"_26947":119436,"_2866":119557},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3379":70489,"_29627":70441,"_20564":119559,"_5":14107,"_26947":119436,"_2866":119560},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3379":70490,"_29627":70441,"_20564":119562,"_5":14107,"_26947":119436,"_2866":119563},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3379":70491,"_29627":70441,"_20564":119565,"_5":14107,"_26947":119444,"_2866":119566},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3379":70492,"_29627":70441,"_20564":119568,"_5":14107,"_26947":119448,"_2866":119569},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3379":70493,"_29627":70441,"_20564":119571,"_5":14107,"_26947":119452,"_2866":119572},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3379":70494,"_29627":70441,"_20564":119574,"_5":14107,"_26947":119456,"_2866":119575},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3379":70495,"_29627":70441,"_20564":119577,"_5":14107,"_26947":119460,"_2866":119578},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3379":70496,"_29627":70441,"_20564":119580,"_5":14107,"_26947":119460,"_2866":119581},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3379":70497,"_29627":70441,"_20564":119583,"_5":14107,"_26947":119464,"_2866":119584},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3379":70498,"_29627":70441,"_20564":119586,"_5":14107,"_26947":119464,"_2866":119587},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3379":70499,"_29627":70441,"_20564":119589,"_5":14107,"_26947":119464,"_2866":119590},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3379":70500,"_29627":70441,"_20564":119592,"_5":14107,"_26947":119464,"_2866":119593},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3379":70501,"_29627":70441,"_20564":119595,"_5":14107,"_26947":119468,"_2866":119596},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3379":70502,"_29627":70441,"_20564":119598,"_5":14107,"_26947":119468,"_2866":119599},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3379":70503,"_29627":70503,"_5":14459,"_2866":119601,"_29980":119602,"_20564":119604,"_26947":70503},"Validación de certificados",[48237,115094,53707,119603],"Validación",[],{"_3379":70504,"_29627":70503,"_20564":119606,"_5":14107,"_26947":70503,"_2866":119607},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3379":70505,"_29627":70503,"_5":29977,"_20564":119609,"_26947":119610,"_2866":119611},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3379":70506,"_29627":70503,"_5":29977,"_20564":119613,"_26947":119614,"_2866":119615},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3379":70507,"_29627":70503,"_5":29977,"_20564":119617,"_26947":119618,"_2866":119619},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3379":70508,"_29627":70503,"_20564":119621,"_5":14107,"_26947":70503,"_2866":119622},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3379":70509,"_29627":70503,"_20564":119624,"_5":14107,"_26947":119610,"_2866":119625},[],"Verifica estos criterios juntos:",{"_3379":70510,"_29627":70503,"_20564":119627,"_5":14107,"_26947":119610,"_2866":118598},[],{"_3379":70511,"_29627":70503,"_20564":119629,"_5":14107,"_26947":119610,"_2866":119630},[],"Resultado necesario",{"_3379":70512,"_29627":70503,"_20564":119632,"_5":14107,"_26947":119610,"_2866":119633},[],"Cadena y firma",{"_3379":70513,"_29627":70503,"_20564":119635,"_5":14107,"_26947":119610,"_2866":119636},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3379":70514,"_29627":70503,"_20564":119638,"_5":14107,"_26947":119610,"_2866":119639},[],"Fechas",{"_3379":70515,"_29627":70503,"_20564":119641,"_5":14107,"_26947":119610,"_2866":119642},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3379":70516,"_29627":70503,"_20564":119644,"_5":14107,"_26947":119610,"_2866":114764},[],{"_3379":70517,"_29627":70503,"_20564":119646,"_5":14107,"_26947":119610,"_2866":119647},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3379":70518,"_29627":70503,"_20564":119649,"_5":14107,"_26947":119610,"_2866":119650},[],"Uso",{"_3379":70519,"_29627":70503,"_20564":119652,"_5":14107,"_26947":119610,"_2866":119653},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3379":70520,"_29627":70503,"_20564":119655,"_5":14107,"_26947":119610,"_2866":119656},[],"Revocación",{"_3379":70521,"_29627":70503,"_20564":119658,"_5":14107,"_26947":119610,"_2866":119659},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3379":70522,"_29627":70503,"_20564":119661,"_5":14107,"_26947":119610,"_2866":119662},[],"Autorización",{"_3379":70523,"_29627":70503,"_20564":119664,"_5":14107,"_26947":119610,"_2866":119665},[],"La aplicación permite la acción a esa identidad.",{"_3379":70524,"_29627":70503,"_20564":119667,"_5":14107,"_26947":119610,"_2866":119668},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3379":70525,"_29627":70503,"_20564":119670,"_5":14107,"_26947":119614,"_2866":119671},[],"Mecanismo",{"_3379":70526,"_29627":70503,"_20564":119673,"_5":14107,"_26947":119614,"_2866":119674},[],"Cuándo utilizarlo",{"_3379":70527,"_29627":70503,"_20564":119676,"_5":14107,"_26947":119614,"_2866":119677},[],"Qué debes mantener",{"_3379":70528,"_29627":70503,"_20564":119679,"_5":14107,"_26947":119614,"_2866":54419},[],{"_3379":70529,"_29627":70503,"_20564":119681,"_5":14107,"_26947":119614,"_2866":119682},[],"Consulta del estado de un certificado concreto.",{"_3379":70530,"_29627":70503,"_20564":119684,"_5":14107,"_26947":119614,"_2866":119685},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3379":70531,"_29627":70503,"_20564":119687,"_5":14107,"_26947":119614,"_2866":54428},[],{"_3379":70532,"_29627":70503,"_20564":119689,"_5":14107,"_26947":119614,"_2866":119690},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3379":70533,"_29627":70503,"_20564":119692,"_5":14107,"_26947":119614,"_2866":119693},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3379":70534,"_29627":70503,"_20564":119695,"_5":14107,"_26947":119614,"_2866":119696},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3379":70535,"_29627":70503,"_20564":119698,"_5":14107,"_26947":119614,"_2866":119699},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3379":70536,"_29627":70503,"_20564":119701,"_5":14107,"_26947":119618,"_2866":119702},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3379":70537,"_29627":70503,"_20564":119704,"_5":14107,"_26947":119618,"_2866":119705},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3379":70538,"_29627":70503,"_20564":119707,"_5":14107,"_26947":119618,"_2866":119708},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3379":70539,"_29627":70503,"_20564":119710,"_5":14107,"_26947":119618,"_2866":119711},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3379":70540,"_29627":70503,"_20564":119713,"_5":14107,"_26947":119618,"_2866":119714},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3379":70541,"_29627":70503,"_20564":119716,"_5":14107,"_26947":119618,"_2866":119717},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3379":70542,"_29627":70503,"_20564":119719,"_5":14107,"_26947":119618,"_2866":119720},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3379":70543,"_29627":70503,"_20564":119722,"_5":14107,"_26947":119618,"_2866":119723},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3379":70544,"_29627":70503,"_20564":119725,"_5":14107,"_26947":119618,"_2866":119726},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3379":70545,"_29627":70545,"_5":14459,"_2866":119728,"_29980":119729,"_20564":119730,"_26947":70545},"Certificados",[48237,115094,53707,118969],[],{"_3379":70546,"_29627":70545,"_20564":119732,"_5":14107,"_26947":70545,"_2866":119733},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3379":70547,"_29627":70545,"_5":29977,"_20564":119735,"_26947":119736,"_2866":119737},[],"/docs/pr-preview/pr-55/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3379":70548,"_29627":70545,"_5":29977,"_20564":119739,"_26947":119740,"_2866":119741},[],"/docs/pr-preview/pr-55/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3379":70549,"_29627":70545,"_5":29977,"_20564":119743,"_26947":119744,"_2866":119745},[],"/docs/pr-preview/pr-55/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3379":70550,"_29627":70545,"_5":29977,"_20564":119747,"_26947":119748,"_2866":119749},[],"/docs/pr-preview/pr-55/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3379":70551,"_29627":70545,"_5":29977,"_20564":119751,"_26947":119752,"_2866":119753},[],"/docs/pr-preview/pr-55/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3379":70552,"_29627":70545,"_5":29977,"_20564":119755,"_26947":119756,"_2866":119757},[],"/docs/pr-preview/pr-55/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3379":70553,"_29627":70545,"_5":29977,"_20564":119759,"_26947":119760,"_2866":119761},[],"/docs/pr-preview/pr-55/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3379":70554,"_29627":70545,"_5":29977,"_20564":119763,"_26947":119764,"_2866":119765},[],"/docs/pr-preview/pr-55/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3379":70555,"_29627":70545,"_5":29977,"_20564":119767,"_26947":119768,"_2866":119769},[],"/docs/pr-preview/pr-55/es/platform/pki/certificates#continúa","Continúa",{"_3379":70556,"_29627":70545,"_20564":119771,"_5":14107,"_26947":70545,"_2866":119772},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3379":70557,"_29627":70545,"_20564":119774,"_5":14107,"_26947":119736,"_2866":119775},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Un certificado no contiene su clave privada, así que las superficies de clave privada responden qué certificados tienen su clave custodiada en el KMS de Lamassu:",{"_3379":70558,"_29627":70545,"_20564":119777,"_5":14107,"_26947":119736,"_2866":119778},[],"El filtro avanzado **Private Key**, disponible en la página Certificates y en la pestaña **Issued Certificates** de una CA, limita la lista a **All Certificates**, **With Private Key** o **Without Private Key**.",{"_3379":70559,"_29627":70545,"_20564":119780,"_5":14107,"_26947":119736,"_2866":119781},[],"La columna ordenable **Private Key** — visible por defecto y oculta en pantallas estrechas — marca con una marca de verificación verde la clave custodiada en el KMS y muestra `-` en los demás casos.",{"_3379":70560,"_29627":70545,"_20564":119783,"_5":14107,"_26947":119736,"_2866":119784},[],"En los detalles del certificado, la pestaña **Information** muestra una fila **Private Key** en la sección **Key & Signature**. Cuando el certificado indica que tiene clave privada y están disponibles los identificadores de la clave y del motor del KMS, la fila enlaza a la clave (tooltip: **Open private key in KMS**). En caso contrario, muestra **Present** si el certificado indica que tiene clave privada o **Not available** si no lo indica. Esto no determina si existe una clave fuera de Lamassu.",{"_3379":70561,"_29627":70545,"_20564":119786,"_5":14107,"_26947":119736,"_2866":119787},[],"Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_3379":70562,"_29627":70545,"_20564":119789,"_5":14107,"_26947":119736,"_2866":119790},[],"Los detalles del certificado incluyen la referencia a la clave (`key_id`) y si la clave privada está gestionada (`has_private_key`); las listas de certificados pueden filtrarse por `has_private_key`.",{"_3379":70563,"_29627":70545,"_20564":119792,"_5":14107,"_26947":119736,"_2866":119793},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3379":70564,"_29627":70545,"_20564":119795,"_5":14107,"_26947":119740,"_2866":119796},[],"Descarga el PEM e inspecciónalo:",{"_3379":70565,"_29627":70545,"_20564":119798,"_5":14107,"_26947":119740,"_2866":119799},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3379":70566,"_29627":70545,"_20564":119801,"_5":14107,"_26947":119744,"_2866":119802},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3379":70567,"_29627":70545,"_20564":119804,"_5":14107,"_26947":119744,"_2866":119805},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3379":70568,"_29627":70545,"_20564":119807,"_5":14107,"_26947":119744,"_2866":119808},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3379":70569,"_29627":70545,"_20564":119810,"_5":14107,"_26947":119744,"_2866":119811},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3379":70570,"_29627":70545,"_20564":119813,"_5":14107,"_26947":119744,"_2866":119814},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3379":70571,"_29627":70545,"_20564":119816,"_5":14107,"_26947":119744,"_2866":119817},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3379":70572,"_29627":70545,"_20564":119819,"_5":14107,"_26947":119744,"_2866":119820},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3379":70573,"_29627":70545,"_20564":119822,"_5":14107,"_26947":119748,"_2866":119823},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3379":70574,"_29627":70545,"_20564":119825,"_5":14107,"_26947":119752,"_2866":119826},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3379":70575,"_29627":70545,"_20564":119828,"_5":14107,"_26947":119756,"_2866":119829},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3379":70576,"_29627":70545,"_20564":119831,"_5":14107,"_26947":119760,"_2866":119832},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3379":70577,"_29627":70545,"_20564":119834,"_5":14107,"_26947":119760,"_2866":119835},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3379":70578,"_29627":70545,"_20564":119837,"_5":14107,"_26947":119760,"_2866":119838},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3379":70579,"_29627":70545,"_20564":119840,"_5":14107,"_26947":119764,"_2866":119841},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3379":70580,"_29627":70545,"_20564":119843,"_5":14107,"_26947":119764,"_2866":119844},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3379":70581,"_29627":70545,"_20564":119846,"_5":14107,"_26947":119764,"_2866":119847},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_3379":70582,"_29627":70545,"_20564":119849,"_5":14107,"_26947":119768,"_2866":119850},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3379":70583,"_29627":70545,"_20564":119852,"_5":14107,"_26947":119768,"_2866":119853},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3379":70584,"_29627":70584,"_5":14459,"_2866":119855,"_29980":119856,"_20564":119858,"_26947":70584},"Ciclo de vida de un certificado",[48237,115094,53707,119857],"Conceptos",[],{"_3379":70585,"_29627":70584,"_20564":119860,"_5":14107,"_26947":70584,"_2866":119861},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3379":70586,"_29627":70584,"_5":29977,"_20564":119863,"_26947":119864,"_2866":119865},[],"/docs/pr-preview/pr-55/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3379":70587,"_29627":70584,"_5":29977,"_20564":119867,"_26947":119868,"_2866":119869},[],"/docs/pr-preview/pr-55/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3379":70588,"_29627":70584,"_5":29977,"_20564":119871,"_26947":119872,"_2866":119873},[],"/docs/pr-preview/pr-55/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3379":70589,"_29627":70584,"_5":29977,"_20564":119875,"_26947":119876,"_2866":119877},[],"/docs/pr-preview/pr-55/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3379":70590,"_29627":70584,"_5":29977,"_20564":119879,"_26947":119880,"_2866":119881},[],"/docs/pr-preview/pr-55/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3379":70591,"_29627":70584,"_5":29977,"_20564":119883,"_26947":119884,"_2866":119885},[],"/docs/pr-preview/pr-55/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3379":70592,"_29627":70584,"_5":29977,"_20564":119887,"_26947":119888,"_2866":117592},[],"/docs/pr-preview/pr-55/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado",{"_3379":70593,"_29627":70584,"_5":29977,"_20564":119890,"_26947":119891,"_2866":119892},[],"/docs/pr-preview/pr-55/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3379":70594,"_29627":70584,"_5":29977,"_20564":119894,"_26947":119895,"_2866":119896},[],"/docs/pr-preview/pr-55/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3379":70595,"_29627":70584,"_5":29977,"_20564":119898,"_26947":119899,"_2866":119900},[],"/docs/pr-preview/pr-55/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3379":70596,"_29627":70584,"_20564":119902,"_5":14107,"_26947":70584,"_2866":119903},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3379":70597,"_29627":70584,"_20564":119905,"_5":14107,"_26947":119868,"_2866":119906},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3379":70598,"_29627":70584,"_20564":119908,"_5":14107,"_26947":119872,"_2866":119909},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3379":70599,"_29627":70584,"_20564":119911,"_5":14107,"_26947":119876,"_2866":119912},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3379":70600,"_29627":70584,"_20564":119914,"_5":14107,"_26947":119880,"_2866":119915},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3379":70601,"_29627":70584,"_20564":119917,"_5":14107,"_26947":119884,"_2866":119918},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3379":70602,"_29627":70584,"_20564":119920,"_5":14107,"_26947":119888,"_2866":119921},[],"Lamassu persiste cuatro estados X.509:",{"_3379":70603,"_29627":70584,"_20564":119923,"_5":14107,"_26947":119888,"_2866":119924},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3379":70604,"_29627":70584,"_20564":119926,"_5":14107,"_26947":119888,"_2866":119927},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3379":70605,"_29627":70584,"_20564":119929,"_5":14107,"_26947":119888,"_2866":119930},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3379":70606,"_29627":70584,"_20564":119932,"_5":14107,"_26947":119888,"_2866":119933},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3379":70607,"_29627":70584,"_20564":119935,"_5":14107,"_26947":119888,"_2866":119936},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3379":70608,"_29627":70584,"_20564":119938,"_5":14107,"_26947":119891,"_2866":119939},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3379":70609,"_29627":70584,"_20564":119941,"_5":14107,"_26947":119891,"_2866":119942},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3379":70610,"_29627":70584,"_20564":119944,"_5":14107,"_26947":119891,"_2866":119945},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3379":70611,"_29627":70584,"_20564":119947,"_5":14107,"_26947":119895,"_2866":119948},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3379":70612,"_29627":70584,"_20564":119950,"_5":14107,"_26947":119895,"_2866":119951},[],"Antes de confirmar:",{"_3379":70613,"_29627":70584,"_20564":119953,"_5":14107,"_26947":119895,"_2866":119954},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3379":70614,"_29627":70584,"_20564":119956,"_5":14107,"_26947":119895,"_2866":119957},[],"Distribuye la nueva cadena de confianza.",{"_3379":70615,"_29627":70584,"_20564":119959,"_5":14107,"_26947":119895,"_2866":119960},[],"Reemite las identidades necesarias.",{"_3379":70616,"_29627":70584,"_20564":119962,"_5":14107,"_26947":119895,"_2866":119963},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3379":70617,"_29627":70584,"_20564":119965,"_5":14107,"_26947":119895,"_2866":119966},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3379":70618,"_29627":70584,"_20564":119968,"_5":14107,"_26947":119895,"_2866":119969},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3379":70619,"_29627":70584,"_20564":119971,"_5":14107,"_26947":119899,"_2866":119972},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3379":70620,"_29627":70584,"_20564":119974,"_5":14107,"_26947":119899,"_2866":119975},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3379":70621,"_29627":70584,"_20564":119977,"_5":14107,"_26947":119899,"_2866":119978},[],"Cambios de estado y razones de revocación.",{"_3379":70622,"_29627":70584,"_20564":119980,"_5":14107,"_26947":119899,"_2866":119981},[],"Publicación y vigencia de OCSP y CRLs.",{"_3379":70623,"_29627":70584,"_20564":119983,"_5":14107,"_26947":119899,"_2866":119984},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3379":70624,"_29627":70584,"_20564":119986,"_5":14107,"_26947":119899,"_2866":119987},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3379":70625,"_29627":70625,"_5":14459,"_2866":119989,"_29980":119990,"_20564":119991,"_26947":70625},"Modelo de confianza",[48237,115094,53707,119857],[],{"_3379":70626,"_29627":70625,"_20564":119993,"_5":14107,"_26947":70625,"_2866":119994},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3379":70627,"_29627":70625,"_5":29977,"_20564":119996,"_26947":119997,"_2866":119998},[],"/docs/pr-preview/pr-55/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3379":70628,"_29627":70625,"_5":29977,"_20564":120000,"_26947":120001,"_2866":120002},[],"/docs/pr-preview/pr-55/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3379":70629,"_29627":70625,"_5":29977,"_20564":120004,"_26947":120005,"_2866":120006},[],"/docs/pr-preview/pr-55/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3379":70630,"_29627":70625,"_5":29977,"_20564":120008,"_26947":120009,"_2866":120010},[],"/docs/pr-preview/pr-55/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3379":70631,"_29627":70625,"_5":29977,"_20564":120012,"_26947":120013,"_2866":120014},[],"/docs/pr-preview/pr-55/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3379":70632,"_29627":70625,"_5":29977,"_20564":120016,"_26947":120017,"_2866":120018},[],"/docs/pr-preview/pr-55/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3379":70633,"_29627":70625,"_5":29977,"_20564":120020,"_26947":120021,"_2866":120022},[],"/docs/pr-preview/pr-55/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3379":70634,"_29627":70625,"_5":29977,"_20564":120024,"_26947":120025,"_2866":120026},[],"/docs/pr-preview/pr-55/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3379":70635,"_29627":70625,"_5":29977,"_20564":120028,"_26947":120029,"_2866":120030},[],"/docs/pr-preview/pr-55/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3379":70636,"_29627":70625,"_5":29977,"_20564":120032,"_26947":120033,"_2866":120034},[],"/docs/pr-preview/pr-55/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3379":70637,"_29627":70625,"_20564":120036,"_5":14107,"_26947":70625,"_2866":120037},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3379":70638,"_29627":70625,"_20564":120039,"_5":14107,"_26947":120001,"_2866":120040},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3379":70639,"_29627":70625,"_20564":120042,"_5":14107,"_26947":120005,"_2866":120043},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3379":70640,"_29627":70625,"_20564":120045,"_5":14107,"_26947":120009,"_2866":120046},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3379":70641,"_29627":70625,"_20564":120048,"_5":14107,"_26947":120013,"_2866":120049},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3379":70642,"_29627":70625,"_20564":120051,"_5":14107,"_26947":120017,"_2866":120052},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3379":70643,"_29627":70625,"_20564":120054,"_5":14107,"_26947":120017,"_2866":120055},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3379":70644,"_29627":70625,"_20564":120057,"_5":14107,"_26947":120017,"_2866":120058},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3379":70645,"_29627":70625,"_20564":120060,"_5":14107,"_26947":120017,"_2866":120061},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3379":70646,"_29627":70625,"_20564":120063,"_5":14107,"_26947":120017,"_2866":120064},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3379":70647,"_29627":70625,"_20564":120066,"_5":14107,"_26947":120017,"_2866":120067},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3379":70648,"_29627":70625,"_20564":120069,"_5":14107,"_26947":120021,"_2866":120070},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3379":70649,"_29627":70625,"_20564":120072,"_5":14107,"_26947":120021,"_2866":120073},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3379":70650,"_29627":70625,"_20564":120075,"_5":14107,"_26947":120021,"_2866":120076},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_3379":70651,"_29627":70625,"_20564":120078,"_5":14107,"_26947":120021,"_2866":120079},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3379":70652,"_29627":70625,"_20564":120081,"_5":14107,"_26947":120021,"_2866":120082},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3379":70653,"_29627":70625,"_20564":120084,"_5":14107,"_26947":120025,"_2866":120085},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3379":70654,"_29627":70625,"_20564":120087,"_5":14107,"_26947":120025,"_2866":120088},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3379":70655,"_29627":70625,"_20564":120090,"_5":14107,"_26947":120025,"_2866":120091},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3379":70656,"_29627":70625,"_20564":120093,"_5":14107,"_26947":120025,"_2866":120094},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3379":70657,"_29627":70625,"_20564":120096,"_5":14107,"_26947":120025,"_2866":120097},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3379":70658,"_29627":70625,"_20564":120099,"_5":14107,"_26947":120025,"_2866":120100},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3379":70659,"_29627":70625,"_20564":120102,"_5":14107,"_26947":120025,"_2866":120103},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_3379":70660,"_29627":70625,"_20564":120105,"_5":14107,"_26947":120029,"_2866":120106},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3379":70661,"_29627":70625,"_20564":120108,"_5":14107,"_26947":120033,"_2866":120109},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3379":70662,"_29627":70625,"_20564":120111,"_5":14107,"_26947":120033,"_2866":120112},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3379":70663,"_29627":70625,"_20564":120114,"_5":14107,"_26947":120033,"_2866":120115},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3379":70664,"_29627":70625,"_20564":120117,"_5":14107,"_26947":120033,"_2866":120118},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3379":70665,"_29627":70625,"_20564":120120,"_5":14107,"_26947":120033,"_2866":120121},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3379":70666,"_29627":70625,"_20564":120123,"_5":14107,"_26947":120033,"_2866":120124},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3379":70667,"_29627":70625,"_20564":120126,"_5":14107,"_26947":120033,"_2866":120127},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3379":70668,"_29627":70668,"_5":14459,"_2866":120129,"_29980":120130,"_20564":120131,"_26947":70668},"Listas de revocación (CRL)",[48237,115094,53707,119603],[],{"_3379":70669,"_29627":70668,"_20564":120133,"_5":14107,"_26947":70668,"_2866":120134},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3379":70670,"_29627":70668,"_5":29977,"_20564":120136,"_26947":120137,"_2866":120138},[],"/docs/pr-preview/pr-55/es/platform/pki/crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_3379":70671,"_29627":70668,"_5":29977,"_20564":120140,"_26947":120141,"_2866":120142},[],"/docs/pr-preview/pr-55/es/platform/pki/crl#cas-que-comparten-clave","CAs que comparten clave",{"_3379":70672,"_29627":70668,"_5":29977,"_20564":120144,"_26947":120145,"_2866":120146},[],"/docs/pr-preview/pr-55/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3379":70673,"_29627":70668,"_5":29977,"_20564":120148,"_26947":120149,"_2866":120150},[],"/docs/pr-preview/pr-55/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3379":70674,"_29627":70668,"_5":29977,"_20564":120152,"_26947":120153,"_2866":120154},[],"/docs/pr-preview/pr-55/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3379":70675,"_29627":70668,"_5":29977,"_20564":120156,"_26947":120157,"_2866":120158},[],"/docs/pr-preview/pr-55/es/platform/pki/crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_3379":70676,"_29627":70668,"_5":29977,"_20564":120160,"_26947":120161,"_2866":120162},[],"/docs/pr-preview/pr-55/es/platform/pki/crl#errores-frecuentes-del-rol-va","Errores frecuentes del rol VA",{"_3379":70677,"_29627":70668,"_5":29977,"_20564":120164,"_26947":120165,"_2866":120166},[],"/docs/pr-preview/pr-55/es/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_3379":70678,"_29627":70668,"_5":29977,"_20564":120168,"_26947":120169,"_2866":120170},[],"/docs/pr-preview/pr-55/es/platform/pki/crl#referencias","Referencias",{"_3379":70679,"_29627":70668,"_20564":120172,"_5":14107,"_26947":70668,"_2866":120173},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su SKI y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3379":70680,"_29627":70668,"_20564":120175,"_5":14107,"_26947":120137,"_2866":120176},[],"El rol VA guarda la configuración y los metadatos de la última lista publicada para el SKI de una CA. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3379":70681,"_29627":70668,"_20564":120178,"_5":14107,"_26947":120137,"_2866":120179},[],"Campo de `crl_options`",{"_3379":70682,"_29627":70668,"_20564":120181,"_5":14107,"_26947":120137,"_2866":116632},[],{"_3379":70683,"_29627":70668,"_20564":120183,"_5":14107,"_26947":120137,"_2866":120184},[],"Valor inicial del backend",{"_3379":70684,"_29627":70668,"_20564":120186,"_5":14107,"_26947":120137,"_2866":54929},[],{"_3379":70685,"_29627":70668,"_20564":120188,"_5":14107,"_26947":120137,"_2866":120189},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3379":70686,"_29627":70668,"_20564":120191,"_5":14107,"_26947":120137,"_2866":120192},[],"7 días.",{"_3379":70687,"_29627":70668,"_20564":120194,"_5":14107,"_26947":120137,"_2866":54938},[],{"_3379":70688,"_29627":70668,"_20564":120196,"_5":14107,"_26947":120137,"_2866":120197},[],"Tiempo desde la emisión de la última CRL publicada que activa la renovación programada; `0` la desactiva (consulta Regeneración periódica y automática).",{"_3379":70689,"_29627":70668,"_20564":120199,"_5":14107,"_26947":120137,"_2866":120200},[],"6 días y 23 horas.",{"_3379":70690,"_29627":70668,"_20564":120202,"_5":14107,"_26947":120137,"_2866":54947},[],{"_3379":70691,"_29627":70668,"_20564":120204,"_5":14107,"_26947":120137,"_2866":120205},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3379":70692,"_29627":70668,"_20564":120207,"_5":14107,"_26947":120137,"_2866":54953},[],{"_3379":70693,"_29627":70668,"_20564":120209,"_5":14107,"_26947":120137,"_2866":54956},[],{"_3379":70694,"_29627":70668,"_20564":120211,"_5":14107,"_26947":120137,"_2866":120212},[],"Número de serie del certificado existente que firma la CRL.",{"_3379":70695,"_29627":70668,"_20564":120214,"_5":14107,"_26947":120137,"_2866":120215},[],"Número de serie del certificado actual de la CA.",{"_3379":70696,"_29627":70668,"_20564":120217,"_5":14107,"_26947":120137,"_2866":120218},[],"El firmante debe ser un certificado existente con el uso `cRLSign`, el mismo sujeto y la misma clave pública que la CA. Quedan incluidos los certificados anteriores a una reemisión. No se admite un firmante delegado: un certificado con el sujeto de la CA pero con otra clave se rechaza.",{"_3379":70697,"_29627":70668,"_20564":120220,"_5":14107,"_26947":120137,"_2866":120221},[],"Al reemitir una CA, si el firmante del rol es el certificado de la CA sustituido, la VA lo mueve al certificado nuevo — siempre que incluya `cRLSign` — y republica la CRL. Si el firmante es cualquier otro certificado con el sujeto y la clave de la CA, se deja deliberadamente sin cambios; en ese caso el certificado anterior no puede eliminarse mientras el rol lo use, y para retirarlo actualizas el firmante con `PUT`.",{"_3379":70698,"_29627":70668,"_20564":120223,"_5":14107,"_26947":120137,"_2866":120224},[],"Al eliminar una CA, su rol VA se conserva y no puede borrarse por API. Si no queda ninguna otra CA con el mismo SKI, el rol puede consultarse pero cualquier `PUT` devuelve 404, y el trabajo de renovación registra un aviso en cada ciclo porque ya no encuentra la CA. La API no ofrece salida; solo se corrige editando la base de datos. Si queda otra CA con ese SKI, el rol sigue siendo editable (consulta CAs que comparten clave). Ajusta validez y firmante antes de eliminar la CA.",{"_3379":70699,"_29627":70668,"_20564":120226,"_5":14107,"_26947":120137,"_2866":120227},[],"Una CA cuyo certificado no tiene `cRLSign` no puede generar su CRL ni editar su rol (error 400). Desde 4.0 la VA exige este uso. Comprueba antes de importar con `openssl x509 -noout -ext keyUsage` y, si falta, obtén un certificado de la misma CA y clave que lo incluya y asígnalo como firmante con `PUT`. Tras reemitir una CA, comprueba también el uso de clave del certificado nuevo: puede no conservar los usos del original, y sin `cRLSign` el rol conserva su firmante anterior.",{"_3379":70700,"_29627":70668,"_20564":120229,"_5":14107,"_26947":120137,"_2866":120230},[],"El `PUT` valida siempre el firmante, aunque la petición no lo cambie. Si el firmante guardado ya no es válido, no se puede modificar ningún campo del rol, ni siquiera la validez, hasta asignar uno válido.",{"_3379":70701,"_29627":70668,"_20564":120232,"_5":14107,"_26947":120137,"_2866":120233},[],"Compartir una clave entre CA puede impedir la validación de las CRL. Consulta CAs que comparten clave.",{"_3379":70702,"_29627":70668,"_20564":120235,"_5":14107,"_26947":120137,"_2866":120236},[],"`latest_crl` contiene versión, inicio y fin de validez. Las versiones se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/{subject_key_id}/{version}.crl`; el endpoint público entrega DER.",{"_3379":70703,"_29627":70668,"_20564":120238,"_5":14107,"_26947":120141,"_2866":120239},[],"La VA identifica cada CRL por el SKI de la CA, y el SKI se deriva de su clave. Dos CAs con la misma clave tienen el mismo SKI y comparten un único rol VA y una única CRL. Ocurre al crear una CA sobre una clave ya existente del KMS, o al importar una CA cuyo certificado declara un SKI en uso. Lamassu toma el SKI del certificado importado tal cual y no comprueba que corresponda a su clave pública. El rol lo crea la primera CA y las demás lo conservan.",{"_3379":70704,"_29627":70668,"_20564":120241,"_5":14107,"_26947":120141,"_2866":120242},[],"Los certificados de todas ellas apuntan a `/crl/{ski}`, pero la lista publicada tiene como emisor a la primera CA y solo incluye sus revocaciones. Un verificador compara el emisor de la CRL con el del certificado que valida (RFC 5280, §6.3.2) y rechaza la lista si no coinciden. Según su política, el certificado queda bloqueado (*hard-fail*) o se acepta aunque esté revocado (*soft-fail*). Las revocaciones de las CAs secundarias no aparecen en ninguna lista.",{"_3379":70705,"_29627":70668,"_20564":120244,"_5":14107,"_26947":120141,"_2866":120245},[],"Si la primera CA se elimina, la generación de CRL de la restante falla porque el firmante configurado ya no corresponde a una CA con ese nombre. Hasta que se actualice el firmante del rol a un certificado de la CA restante, se sigue sirviendo la última lista publicada hasta que venza (7 días por defecto).",{"_3379":70706,"_29627":70668,"_20564":120247,"_5":14107,"_26947":120141,"_2866":120248},[],"Antes de actualizar, revisa las CAs que comparten clave. Para detectar el problema, compara el SKI de las CAs en el inventario: dos con el mismo SKI están afectadas. Para resolverlo, crea una CA con clave propia y reemite sus certificados; los ya emitidos conservan la URL antigua y no se corrigen hasta reemitirlos. Una CA importada con un SKI ya en uso no sustituye a la existente como emisora de la CRL, porque el emisor se resuelve a partir del firmante del rol. Sin embargo, sus propios certificados apuntan a esa misma URL y sus revocaciones no se publican. Hasta que Lamassu rechace estas importaciones, limita el permiso de importar CAs como control provisional; cubre solo la vía de importación. Crear una CA con &#x2A;*Create New CA (Existing Key)** sobre una clave KMS que otra CA ya usa produce la misma colisión, así que tampoco reutilices claves entre CAs. Una CRL por CA y el rechazo de importaciones cuyo SKI colisiona con el de una CA existente están planteados en lamassuiot#834, y ninguno está implementado todavía.",{"_3379":70707,"_29627":70668,"_20564":120250,"_5":14107,"_26947":120145,"_2866":120251},[],"El trabajo programado de la VA revisa todos los roles en cada ejecución y solicita otra lista cuando a `latest_crl` le queda menos validez que el intervalo entre ejecuciones. La frecuencia se configura en Helm con `services.va.job.crl.frequency` (por defecto `0 * * * *`) y admite una duración (`1h`) o una expresión cron. Una expresión cron se convierte en un intervalo constante igual al tiempo que falta para su siguiente disparo cuando arranca el servicio, así que no se alinea con el reloj. También solicita otra lista cuando el tiempo transcurrido desde la emisión de la última CRL publicada alcanza `refresh_interval`; con `0` solo se desactiva este disparador. Mantén `validity` claramente por encima del intervalo: con una validez menor, la lista se regenera en cada ciclo.",{"_3379":70708,"_29627":70668,"_20564":120253,"_5":14107,"_26947":120145,"_2866":120254},[],"Si la generación falla (por ejemplo, por un rol sin CA o un firmante inválido), el trabajo registra el aviso `something went wrong while calculating CRL for CA <ski>` y lo reintenta en el ciclo siguiente. No hay otra vía de renovación hasta corregir la causa, y la última lista publicada se sigue sirviendo hasta vencer. Todo ello depende de que el trabajo, el almacenamiento y la firma funcionen.",{"_3379":70709,"_29627":70668,"_20564":120256,"_5":14107,"_26947":120145,"_2866":120257},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores: si falla (rol inexistente, firmante inválido), el evento se reintenta y, agotados los reintentos, pasa a la cola de eventos fallidos. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3379":70710,"_29627":70668,"_20564":120259,"_5":14107,"_26947":120145,"_2866":120260},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3379":70711,"_29627":70668,"_20564":120262,"_5":14107,"_26947":120149,"_2866":120263},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3379":70712,"_29627":70668,"_20564":120265,"_5":14107,"_26947":120149,"_2866":120266},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3379":70713,"_29627":70668,"_20564":120268,"_5":14107,"_26947":120153,"_2866":120269},[],"El servicio VA expone `GET /crl/{subject_key_id}` sin autorización de gestión. Usa el SKI de la **CA emisora**, no el SKI del certificado final ni su número de serie. Inspecciona primero el CDP del certificado:",{"_3379":70714,"_29627":70668,"_20564":120271,"_5":14107,"_26947":120153,"_2866":120272},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3379":70715,"_29627":70668,"_20564":120274,"_5":14107,"_26947":120153,"_2866":120275},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Un certificado firmante aceptado tiene el mismo sujeto y la misma clave pública que la CA, por lo que esta comprobación de firma también funciona cuando el rol apunta a un certificado anterior de esa CA y clave. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3379":70716,"_29627":70668,"_20564":120277,"_5":14107,"_26947":120153,"_2866":120278},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3379":70717,"_29627":70668,"_20564":120280,"_5":14107,"_26947":120153,"_2866":120281},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3379":70718,"_29627":70668,"_20564":120283,"_5":14107,"_26947":120157,"_2866":120284},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3379":70719,"_29627":70668,"_20564":120286,"_5":14107,"_26947":120157,"_2866":116821},[],{"_3379":70720,"_29627":70668,"_20564":120288,"_5":14107,"_26947":120157,"_2866":120289},[],"Path relativo",{"_3379":70721,"_29627":70668,"_20564":120291,"_5":14107,"_26947":120157,"_2866":114854},[],{"_3379":70722,"_29627":70668,"_20564":120293,"_5":14107,"_26947":120157,"_2866":55041},[],{"_3379":70723,"_29627":70668,"_20564":120295,"_5":14107,"_26947":120157,"_2866":55044},[],{"_3379":70724,"_29627":70668,"_20564":120297,"_5":14107,"_26947":120157,"_2866":120298},[],"Consultar `crl_options` y `latest_crl`.",{"_3379":70725,"_29627":70668,"_20564":120300,"_5":14107,"_26947":120157,"_2866":55050},[],{"_3379":70726,"_29627":70668,"_20564":120302,"_5":14107,"_26947":120157,"_2866":55044},[],{"_3379":70727,"_29627":70668,"_20564":120304,"_5":14107,"_26947":120157,"_2866":120305},[],"Sustituir la configuración de CRL.",{"_3379":70728,"_29627":70668,"_20564":120307,"_5":14107,"_26947":120157,"_2866":120308},[],"Necesitas autenticación y permisos de lectura o actualización del rol. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato: el backend sustituye `crl_options`; no fusiona campos omitidos.",{"_3379":70729,"_29627":70668,"_20564":120310,"_5":14107,"_26947":120157,"_2866":120311},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar el rol no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3379":70730,"_29627":70668,"_20564":120313,"_5":14107,"_26947":120161,"_2866":120314},[],"Síntoma",{"_3379":70731,"_29627":70668,"_20564":120316,"_5":14107,"_26947":120161,"_2866":120317},[],"Causa",{"_3379":70732,"_29627":70668,"_20564":120319,"_5":14107,"_26947":120161,"_2866":120320},[],"Acción",{"_3379":70733,"_29627":70668,"_20564":120322,"_5":14107,"_26947":120161,"_2866":120323},[],"`PUT /v1/roles/{ca-ski}` devuelve 404 y `GET` devuelve 200.",{"_3379":70734,"_29627":70668,"_20564":120325,"_5":14107,"_26947":120161,"_2866":120326},[],"Se eliminó la CA del rol y no queda otra con el mismo SKI.",{"_3379":70735,"_29627":70668,"_20564":120328,"_5":14107,"_26947":120161,"_2866":120329},[],"No hay salida por API; requiere intervención en la base de datos. Evítalo ajustando el rol antes de eliminar la CA.",{"_3379":70736,"_29627":70668,"_20564":120331,"_5":14107,"_26947":120161,"_2866":120332},[],"`PUT` devuelve 400.",{"_3379":70737,"_29627":70668,"_20564":120334,"_5":14107,"_26947":120161,"_2866":120335},[],"El firmante no tiene `cRLSign`, o su sujeto y su clave no coinciden con ninguna CA de ese SKI (por ejemplo, tras eliminar la primera de dos CAs que comparten clave).",{"_3379":70738,"_29627":70668,"_20564":120337,"_5":14107,"_26947":120161,"_2866":120338},[],"Asigna con `PUT` el número de serie de un certificado válido de la CA restante.",{"_3379":70739,"_29627":70668,"_20564":120340,"_5":14107,"_26947":120161,"_2866":120341},[],"`PUT` devuelve 400 desde un cliente de 3.x.",{"_3379":70740,"_29627":70668,"_20564":120343,"_5":14107,"_26947":120161,"_2866":120344},[],"`crl_options.subject_key_id_signer` se sustituyó por `signer_certificate_serial_number`, que es obligatorio.",{"_3379":70741,"_29627":70668,"_20564":120346,"_5":14107,"_26947":120161,"_2866":120347},[],"Actualiza el cliente para enviar el campo nuevo.",{"_3379":70742,"_29627":70668,"_20564":120349,"_5":14107,"_26947":120161,"_2866":120350},[],"La CRL no cambia tras revocar un certificado.",{"_3379":70743,"_29627":70668,"_20564":120352,"_5":14107,"_26947":120161,"_2866":120353},[],"`regenerate_on_revoke` es `false`, o el evento falló por falta de rol o por un firmante inválido.",{"_3379":70744,"_29627":70668,"_20564":120355,"_5":14107,"_26947":120161,"_2866":120356},[],"Revisa los logs de la VA y la cola de eventos fallidos; corrige el firmante.",{"_3379":70745,"_29627":70668,"_20564":120358,"_5":14107,"_26947":120161,"_2866":120359},[],"Un verificador rechaza la CRL por el emisor.",{"_3379":70746,"_29627":70668,"_20564":120361,"_5":14107,"_26947":120161,"_2866":120362},[],"Varias CAs comparten SKI.",{"_3379":70747,"_29627":70668,"_20564":120364,"_5":14107,"_26947":120161,"_2866":120365},[],"Consulta CAs que comparten clave.",{"_3379":70748,"_29627":70668,"_20564":120367,"_5":14107,"_26947":120165,"_2866":120368},[],"La vista de la CA permite inspeccionar y descargar la lista disponible. Compara versión, emisor y tiempos con la copia descargada desde el endpoint público. Los ajustes VA de la CA también permiten seleccionar el firmante de la CRL: el selector de certificados solo ofrece certificados que tienen clave privada y el uso de clave `cRLSign`. Si el certificado de un firmante configurado no puede resolverse, la interfaz muestra `Unknown Certificate (Serial: X)` o `Certificate details unavailable (Serial: X)`. Para diagnosticar una diferencia, sigue Diagnóstico PKI.",{"_3379":70749,"_29627":70668,"_20564":120370,"_5":14107,"_26947":120169,"_2866":120371},[],"RFC 5280: perfil X.509 y CRL.",{"_3379":70750,"_29627":70668,"_20564":120373,"_5":14107,"_26947":120169,"_2866":55124},[],{"_3379":70751,"_29627":70668,"_20564":120375,"_5":14107,"_26947":120169,"_2866":55127},[],{"_3379":70752,"_29627":70668,"_20564":120377,"_5":14107,"_26947":120169,"_2866":120378},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3379":70753,"_29627":70668,"_20564":120380,"_5":14107,"_26947":120169,"_2866":120381},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3379":70754,"_29627":70754,"_5":14459,"_2866":120383,"_29980":120384,"_20564":120385,"_26947":70754},"Claves y motores criptográficos",[48237,115094,53707,118969],[],{"_3379":70755,"_29627":70754,"_20564":120387,"_5":14107,"_26947":70754,"_2866":120388},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3379":70756,"_29627":70754,"_5":29977,"_20564":120390,"_26947":120391,"_2866":120392},[],"/docs/pr-preview/pr-55/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3379":70757,"_29627":70754,"_5":29977,"_20564":120394,"_26947":120395,"_2866":120396},[],"/docs/pr-preview/pr-55/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3379":70758,"_29627":70754,"_5":29977,"_20564":120398,"_26947":120399,"_2866":55152},[],"/docs/pr-preview/pr-55/es/platform/pki/key-management#file-system",{"_3379":70759,"_29627":70754,"_5":29977,"_20564":120401,"_26947":120402,"_2866":55156},[],"/docs/pr-preview/pr-55/es/platform/pki/key-management#hashicorp-vault",{"_3379":70760,"_29627":70754,"_5":29977,"_20564":120404,"_26947":120405,"_2866":55160},[],"/docs/pr-preview/pr-55/es/platform/pki/key-management#aws-secrets-manager",{"_3379":70761,"_29627":70754,"_5":29977,"_20564":120407,"_26947":120408,"_2866":55164},[],"/docs/pr-preview/pr-55/es/platform/pki/key-management#aws-kms",{"_3379":70762,"_29627":70754,"_5":29977,"_20564":120410,"_26947":120411,"_2866":55168},[],"/docs/pr-preview/pr-55/es/platform/pki/key-management#pkcs11",{"_3379":70763,"_29627":70754,"_5":29977,"_20564":120413,"_26947":120414,"_2866":55172},[],"/docs/pr-preview/pr-55/es/platform/pki/key-management#azure-key-vault",{"_3379":70764,"_29627":70754,"_5":29977,"_20564":120416,"_26947":120417,"_2866":120418},[],"/docs/pr-preview/pr-55/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3379":70765,"_29627":70754,"_5":29977,"_20564":120420,"_26947":120421,"_2866":120422},[],"/docs/pr-preview/pr-55/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3379":70766,"_29627":70754,"_5":29977,"_20564":120424,"_26947":120425,"_2866":120426},[],"/docs/pr-preview/pr-55/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3379":70767,"_29627":70754,"_5":29977,"_20564":120428,"_26947":120429,"_2866":120430},[],"/docs/pr-preview/pr-55/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3379":70768,"_29627":70754,"_5":29977,"_20564":120432,"_26947":120433,"_2866":120434},[],"/docs/pr-preview/pr-55/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3379":70769,"_29627":70754,"_5":29977,"_20564":120436,"_26947":120437,"_2866":120438},[],"/docs/pr-preview/pr-55/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3379":70770,"_29627":70754,"_5":29977,"_20564":120440,"_26947":120441,"_2866":120442},[],"/docs/pr-preview/pr-55/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3379":70771,"_29627":70754,"_5":29977,"_20564":120444,"_26947":120445,"_2866":55204},[],"/docs/pr-preview/pr-55/es/platform/pki/key-management#sign",{"_3379":70772,"_29627":70754,"_5":29977,"_20564":120447,"_26947":120448,"_2866":55208},[],"/docs/pr-preview/pr-55/es/platform/pki/key-management#verify",{"_3379":70773,"_29627":70754,"_5":29977,"_20564":120450,"_26947":120451,"_2866":120452},[],"/docs/pr-preview/pr-55/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3379":70774,"_29627":70754,"_5":29977,"_20564":120454,"_26947":120455,"_2866":120456},[],"/docs/pr-preview/pr-55/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3379":70775,"_29627":70754,"_5":29977,"_20564":120458,"_26947":120459,"_2866":120460},[],"/docs/pr-preview/pr-55/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3379":70776,"_29627":70754,"_20564":120462,"_5":14107,"_26947":70754,"_2866":120463},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3379":70777,"_29627":70754,"_20564":120465,"_5":14107,"_26947":70754,"_2866":120466},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3379":70778,"_29627":70754,"_20564":120468,"_5":14107,"_26947":120391,"_2866":120469},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3379":70779,"_29627":70754,"_20564":120471,"_5":14107,"_26947":120391,"_2866":120472},[],"En la práctica, permite:",{"_3379":70780,"_29627":70754,"_20564":120474,"_5":14107,"_26947":120391,"_2866":120475},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3379":70781,"_29627":70754,"_20564":120477,"_5":14107,"_26947":120391,"_2866":120478},[],"Importar claves creadas externamente.",{"_3379":70782,"_29627":70754,"_20564":120480,"_5":14107,"_26947":120391,"_2866":120481},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3379":70783,"_29627":70754,"_20564":120483,"_5":14107,"_26947":120391,"_2866":120484},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3379":70784,"_29627":70754,"_20564":120486,"_5":14107,"_26947":120395,"_2866":120487},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3379":70785,"_29627":70754,"_20564":120489,"_5":14107,"_26947":120395,"_2866":120490},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3379":70786,"_29627":70754,"_20564":120492,"_5":14107,"_26947":120395,"_2866":120493},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3379":70787,"_29627":70754,"_20564":120495,"_5":14107,"_26947":120399,"_2866":120496},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3379":70788,"_29627":70754,"_20564":120498,"_5":14107,"_26947":120402,"_2866":120499},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3379":70789,"_29627":70754,"_20564":120501,"_5":14107,"_26947":120402,"_2866":120502},[],"El adaptador se comunica con Vault a través de su endpoint HTTP(S) configurado. El certificado del servidor de Vault se verifica contra el almacén de confianza del sistema; para confiar en un Vault con certificado emitido por una CA privada, añade ese certificado de CA al `ca_cert_file` del motor (codificado en PEM). `insecure_skip_verify=true` desactiva la verificación y es un último recurso; acuerda los ajustes de transporte con el responsable de Despliegue.",{"_3379":70790,"_29627":70754,"_20564":120504,"_5":14107,"_26947":120405,"_2866":120505},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3379":70791,"_29627":70754,"_20564":120507,"_5":14107,"_26947":120408,"_2866":120508},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3379":70792,"_29627":70754,"_20564":120510,"_5":14107,"_26947":120411,"_2866":120511},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3379":70793,"_29627":70754,"_20564":120513,"_5":14107,"_26947":120414,"_2866":120514},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3379":70794,"_29627":70754,"_20564":120516,"_5":14107,"_26947":120414,"_2866":120517},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3379":70795,"_29627":70754,"_20564":120519,"_5":14107,"_26947":120414,"_2866":120520},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3379":70796,"_29627":70754,"_20564":120522,"_5":14107,"_26947":120414,"_2866":120523},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3379":70797,"_29627":70754,"_20564":120525,"_5":14107,"_26947":120417,"_2866":120526},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3379":70798,"_29627":70754,"_20564":120528,"_5":14107,"_26947":120417,"_2866":120529},[],"La tabla incluye los siguientes campos:",{"_3379":70799,"_29627":70754,"_20564":120531,"_5":14107,"_26947":120417,"_2866":120532},[],"**Name**: nombre descriptivo de la clave.",{"_3379":70800,"_29627":70754,"_20564":120534,"_5":14107,"_26947":120417,"_2866":120535},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3379":70801,"_29627":70754,"_20564":120537,"_5":14107,"_26947":120417,"_2866":120538},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3379":70802,"_29627":70754,"_20564":120540,"_5":14107,"_26947":120417,"_2866":120541},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3379":70803,"_29627":70754,"_20564":120543,"_5":14107,"_26947":120417,"_2866":120544},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3379":70804,"_29627":70754,"_20564":120546,"_5":14107,"_26947":120417,"_2866":120547},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3379":70805,"_29627":70754,"_20564":120549,"_5":14107,"_26947":120417,"_2866":120550},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3379":70806,"_29627":70754,"_20564":120552,"_5":14107,"_26947":120417,"_2866":120553},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3379":70807,"_29627":70754,"_20564":120555,"_5":14107,"_26947":120417,"_2866":120556},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3379":70808,"_29627":70754,"_20564":120558,"_5":14107,"_26947":120417,"_2866":120559},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3379":70809,"_29627":70754,"_20564":120561,"_5":14107,"_26947":120417,"_2866":120562},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3379":70810,"_29627":70754,"_20564":120564,"_5":14107,"_26947":120417,"_2866":120565},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3379":70811,"_29627":70754,"_20564":120567,"_5":14107,"_26947":120417,"_2866":120568},[],"**Delete Key** para eliminar la clave del sistema.",{"_3379":70812,"_29627":70754,"_20564":120570,"_5":14107,"_26947":120421,"_2866":120571},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3379":70813,"_29627":70754,"_20564":120573,"_5":14107,"_26947":120425,"_2866":120574},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3379":70814,"_29627":70754,"_20564":120576,"_5":14107,"_26947":120425,"_2866":120577},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3379":70815,"_29627":70754,"_20564":120579,"_5":14107,"_26947":120425,"_2866":120580},[],"**Key Name**: nombre único y descriptivo.",{"_3379":70816,"_29627":70754,"_20564":120582,"_5":14107,"_26947":120425,"_2866":120583},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3379":70817,"_29627":70754,"_20564":120585,"_5":14107,"_26947":120425,"_2866":120586},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3379":70818,"_29627":70754,"_20564":120588,"_5":14107,"_26947":120425,"_2866":120589},[],"**Tags**: metadatos para clasificar la clave.",{"_3379":70819,"_29627":70754,"_20564":120591,"_5":14107,"_26947":120425,"_2866":120592},[],"**Metadata**: información adicional para usos avanzados.",{"_3379":70820,"_29627":70754,"_20564":120594,"_5":14107,"_26947":120429,"_2866":120595},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3379":70821,"_29627":70754,"_20564":120597,"_5":14107,"_26947":120429,"_2866":120598},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3379":70822,"_29627":70754,"_20564":120600,"_5":14107,"_26947":120429,"_2866":120601},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3379":70823,"_29627":70754,"_20564":120603,"_5":14107,"_26947":120429,"_2866":120604},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3379":70824,"_29627":70754,"_20564":120606,"_5":14107,"_26947":120429,"_2866":120607},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3379":70825,"_29627":70754,"_20564":120609,"_5":14107,"_26947":120429,"_2866":120610},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3379":70826,"_29627":70754,"_20564":120612,"_5":14107,"_26947":120429,"_2866":120613},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3379":70827,"_29627":70754,"_20564":120615,"_5":14107,"_26947":120429,"_2866":120616},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3379":70828,"_29627":70754,"_20564":120618,"_5":14107,"_26947":120429,"_2866":120619},[],"**Metadata**: información adicional opcional.",{"_3379":70829,"_29627":70754,"_20564":120621,"_5":14107,"_26947":120429,"_2866":120622},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3379":70830,"_29627":70754,"_20564":120624,"_5":14107,"_26947":120429,"_2866":120625},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3379":70831,"_29627":70754,"_20564":120627,"_5":14107,"_26947":120433,"_2866":120628},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3379":70832,"_29627":70754,"_20564":120630,"_5":14107,"_26947":120437,"_2866":120631},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3379":70833,"_29627":70754,"_20564":120633,"_5":14107,"_26947":120437,"_2866":120634},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3379":70834,"_29627":70754,"_20564":120636,"_5":14107,"_26947":120437,"_2866":120637},[],"**Key Name**: nombre descriptivo.",{"_3379":70835,"_29627":70754,"_20564":120639,"_5":14107,"_26947":120437,"_2866":120640},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3379":70836,"_29627":70754,"_20564":120642,"_5":14107,"_26947":120437,"_2866":120643},[],"**Tags**: etiquetas asociadas.",{"_3379":70837,"_29627":70754,"_20564":120645,"_5":14107,"_26947":120437,"_2866":120646},[],"**Aliases**: nombres alternativos.",{"_3379":70838,"_29627":70754,"_20564":120648,"_5":14107,"_26947":120437,"_2866":120649},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3379":70839,"_29627":70754,"_20564":120651,"_5":14107,"_26947":120437,"_2866":120652},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3379":70840,"_29627":70754,"_20564":120654,"_5":14107,"_26947":120437,"_2866":120655},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3379":70841,"_29627":70754,"_20564":120657,"_5":14107,"_26947":120437,"_2866":120658},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3379":70842,"_29627":70754,"_20564":120660,"_5":14107,"_26947":120441,"_2866":120661},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3379":70843,"_29627":70754,"_20564":120663,"_5":14107,"_26947":120441,"_2866":120664},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3379":70844,"_29627":70754,"_20564":120666,"_5":14107,"_26947":120441,"_2866":120667},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3379":70845,"_29627":70754,"_20564":120669,"_5":14107,"_26947":120445,"_2866":120670},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3379":70846,"_29627":70754,"_20564":120672,"_5":14107,"_26947":120445,"_2866":120673},[],"Campos principales:",{"_3379":70847,"_29627":70754,"_20564":120675,"_5":14107,"_26947":120445,"_2866":120676},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3379":70848,"_29627":70754,"_20564":120678,"_5":14107,"_26947":120445,"_2866":120679},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3379":70849,"_29627":70754,"_20564":120681,"_5":14107,"_26947":120445,"_2866":120682},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3379":70850,"_29627":70754,"_20564":120684,"_5":14107,"_26947":120445,"_2866":120685},[],"**Message**: contenido que se va a firmar.",{"_3379":70851,"_29627":70754,"_20564":120687,"_5":14107,"_26947":120445,"_2866":120688},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3379":70852,"_29627":70754,"_20564":120690,"_5":14107,"_26947":120448,"_2866":120691},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3379":70853,"_29627":70754,"_20564":120693,"_5":14107,"_26947":120448,"_2866":120673},[],{"_3379":70854,"_29627":70754,"_20564":120695,"_5":14107,"_26947":120448,"_2866":120696},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3379":70855,"_29627":70754,"_20564":120698,"_5":14107,"_26947":120448,"_2866":120699},[],"**Message Type**: `Raw` o `Digest`.",{"_3379":70856,"_29627":70754,"_20564":120701,"_5":14107,"_26947":120448,"_2866":120702},[],"**Payload Encoding**: codificación del mensaje.",{"_3379":70857,"_29627":70754,"_20564":120704,"_5":14107,"_26947":120448,"_2866":120705},[],"**Message**: mensaje original o hash.",{"_3379":70858,"_29627":70754,"_20564":120707,"_5":14107,"_26947":120448,"_2866":120708},[],"**Signature**: firma que se desea comprobar.",{"_3379":70859,"_29627":70754,"_20564":120710,"_5":14107,"_26947":120448,"_2866":120711},[],"**Result**: indicador del resultado de la validación.",{"_3379":70860,"_29627":70754,"_20564":120713,"_5":14107,"_26947":120451,"_2866":120714},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3379":70861,"_29627":70754,"_20564":120716,"_5":14107,"_26947":120451,"_2866":120717},[],"Este flujo es útil para:",{"_3379":70862,"_29627":70754,"_20564":120719,"_5":14107,"_26947":120451,"_2866":120720},[],"Solicitar certificados a una CA externa.",{"_3379":70863,"_29627":70754,"_20564":120722,"_5":14107,"_26947":120451,"_2866":120723},[],"Renovar una identidad manteniendo la misma clave.",{"_3379":70864,"_29627":70754,"_20564":120725,"_5":14107,"_26947":120451,"_2866":120726},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3379":70865,"_29627":70754,"_20564":120728,"_5":14107,"_26947":120451,"_2866":120729},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3379":70866,"_29627":70754,"_20564":120731,"_5":14107,"_26947":120451,"_2866":120732},[],"**Organization (O)**: organización o empresa.",{"_3379":70867,"_29627":70754,"_20564":120734,"_5":14107,"_26947":120451,"_2866":120735},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3379":70868,"_29627":70754,"_20564":120737,"_5":14107,"_26947":120451,"_2866":120738},[],"**Country (C)**: código de país de dos letras.",{"_3379":70869,"_29627":70754,"_20564":120740,"_5":14107,"_26947":120451,"_2866":120741},[],"**State / Province (ST)**: estado o provincia.",{"_3379":70870,"_29627":70754,"_20564":120743,"_5":14107,"_26947":120451,"_2866":120744},[],"**Locality (L)**: ciudad o localidad.",{"_3379":70871,"_29627":70754,"_20564":120746,"_5":14107,"_26947":120451,"_2866":120747},[],"**Email Address**: correo de contacto.",{"_3379":70872,"_29627":70754,"_20564":120749,"_5":14107,"_26947":120451,"_2866":120750},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3379":70873,"_29627":70754,"_20564":120752,"_5":14107,"_26947":120451,"_2866":120753},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3379":70874,"_29627":70754,"_20564":120755,"_5":14107,"_26947":120455,"_2866":120756},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3379":70875,"_29627":70754,"_20564":120758,"_5":14107,"_26947":120455,"_2866":120759},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3379":70876,"_29627":70754,"_20564":120761,"_5":14107,"_26947":120459,"_2866":120762},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3379":70877,"_29627":70754,"_20564":120764,"_5":14107,"_26947":120459,"_2866":120765},[],"El KMS se niega a eliminar una clave que todavía está referenciada por certificados. Eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados, y después intenta eliminar la clave. Si otros certificados todavía la referencian, como los de otra CA que la comparte, el KMS la conserva. Revocar los certificados emitidos por la CA eliminada no libera sus propias referencias a claves. La guía de actualización describe las referencias heredadas que conserva la migración.",{"_3379":70878,"_29627":70878,"_5":14459,"_2866":120767,"_29980":120768,"_20564":120769,"_26947":70878},"Validación online con OCSP",[48237,115094,53707,119603],[],{"_3379":70879,"_29627":70878,"_20564":120771,"_5":14107,"_26947":70878,"_2866":120772},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3379":70880,"_29627":70878,"_5":29977,"_20564":120774,"_26947":120775,"_2866":120776},[],"/docs/pr-preview/pr-55/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3379":70881,"_29627":70878,"_5":29977,"_20564":120778,"_26947":120779,"_2866":120780},[],"/docs/pr-preview/pr-55/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3379":70882,"_29627":70878,"_5":29977,"_20564":120782,"_26947":120783,"_2866":120784},[],"/docs/pr-preview/pr-55/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3379":70883,"_29627":70878,"_5":29977,"_20564":120786,"_26947":120787,"_2866":120788},[],"/docs/pr-preview/pr-55/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3379":70884,"_29627":70878,"_5":29977,"_20564":120790,"_26947":120791,"_2866":120792},[],"/docs/pr-preview/pr-55/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3379":70885,"_29627":70878,"_5":29977,"_20564":120794,"_26947":120795,"_2866":120170},[],"/docs/pr-preview/pr-55/es/platform/pki/ocsp#referencias",{"_3379":70886,"_29627":70878,"_20564":120797,"_5":14107,"_26947":70878,"_2866":120798},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3379":70887,"_29627":70878,"_20564":120800,"_5":14107,"_26947":120775,"_2866":120801},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3379":70888,"_29627":70878,"_20564":120803,"_5":14107,"_26947":120775,"_2866":120804},[],"Estado del registro",{"_3379":70889,"_29627":70878,"_20564":120806,"_5":14107,"_26947":120775,"_2866":120807},[],"Respuesta firmada",{"_3379":70890,"_29627":70878,"_20564":120809,"_5":14107,"_26947":120775,"_2866":52844},[],{"_3379":70891,"_29627":70878,"_20564":120811,"_5":14107,"_26947":120775,"_2866":55572},[],{"_3379":70892,"_29627":70878,"_20564":120813,"_5":14107,"_26947":120775,"_2866":52861},[],{"_3379":70893,"_29627":70878,"_20564":120815,"_5":14107,"_26947":120775,"_2866":120816},[],"`Revoked`, con razón y fecha de revocación.",{"_3379":70894,"_29627":70878,"_20564":120818,"_5":14107,"_26947":120775,"_2866":120819},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3379":70895,"_29627":70878,"_20564":120821,"_5":14107,"_26947":120775,"_2866":120822},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3379":70896,"_29627":70878,"_20564":120824,"_5":14107,"_26947":120775,"_2866":120825},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3379":70897,"_29627":70878,"_20564":120827,"_5":14107,"_26947":120775,"_2866":120828},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3379":70898,"_29627":70878,"_20564":120830,"_5":14107,"_26947":120775,"_2866":120831},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3379":70899,"_29627":70878,"_20564":120833,"_5":14107,"_26947":120779,"_2866":120834},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3379":70900,"_29627":70878,"_20564":120836,"_5":14107,"_26947":120779,"_2866":120837},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3379":70901,"_29627":70878,"_20564":120839,"_5":14107,"_26947":120783,"_2866":120840},[],"El servicio acepta:",{"_3379":70902,"_29627":70878,"_20564":120842,"_5":14107,"_26947":120783,"_2866":116821},[],{"_3379":70903,"_29627":70878,"_20564":120844,"_5":14107,"_26947":120783,"_2866":120845},[],"Ruta del servicio VA",{"_3379":70904,"_29627":70878,"_20564":120847,"_5":14107,"_26947":120783,"_2866":120848},[],"Formato",{"_3379":70905,"_29627":70878,"_20564":120850,"_5":14107,"_26947":120783,"_2866":55612},[],{"_3379":70906,"_29627":70878,"_20564":120852,"_5":14107,"_26947":120783,"_2866":55615},[],{"_3379":70907,"_29627":70878,"_20564":120854,"_5":14107,"_26947":120783,"_2866":120855},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3379":70908,"_29627":70878,"_20564":120857,"_5":14107,"_26947":120783,"_2866":55041},[],{"_3379":70909,"_29627":70878,"_20564":120859,"_5":14107,"_26947":120783,"_2866":55623},[],{"_3379":70910,"_29627":70878,"_20564":120861,"_5":14107,"_26947":120783,"_2866":120862},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3379":70911,"_29627":70878,"_20564":120864,"_5":14107,"_26947":120783,"_2866":120865},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3379":70912,"_29627":70878,"_20564":120867,"_5":14107,"_26947":120787,"_2866":120868},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3379":70913,"_29627":70878,"_20564":120870,"_5":14107,"_26947":120787,"_2866":120871},[],"Genera la solicitud:",{"_3379":70914,"_29627":70878,"_20564":120873,"_5":14107,"_26947":120787,"_2866":120874},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3379":70915,"_29627":70878,"_20564":120876,"_5":14107,"_26947":120787,"_2866":120877},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3379":70916,"_29627":70878,"_20564":120879,"_5":14107,"_26947":120787,"_2866":120880},[],"Verifica el DER recibido:",{"_3379":70917,"_29627":70878,"_20564":120882,"_5":14107,"_26947":120787,"_2866":120883},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3379":70918,"_29627":70878,"_20564":120885,"_5":14107,"_26947":120791,"_2866":120886},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3379":70919,"_29627":70878,"_20564":120888,"_5":14107,"_26947":120791,"_2866":120889},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3379":70920,"_29627":70878,"_20564":120891,"_5":14107,"_26947":120795,"_2866":55656},[],{"_3379":70921,"_29627":70878,"_20564":120893,"_5":14107,"_26947":120795,"_2866":55659},[],{"_3379":70922,"_29627":70878,"_20564":120895,"_5":14107,"_26947":120795,"_2866":120896},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3379":70923,"_29627":70878,"_20564":120898,"_5":14107,"_26947":120795,"_2866":120381},[],{"_3379":70924,"_29627":70924,"_5":14459,"_2866":53707,"_29980":120900,"_20564":120901,"_26947":70924},[48237,115094,53707],[],{"_3379":70925,"_29627":70924,"_20564":120903,"_5":14107,"_26947":70924,"_2866":120904},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3379":70926,"_29627":70924,"_5":29977,"_20564":120906,"_26947":120907,"_2866":118295},[],"/docs/pr-preview/pr-55/es/platform/pki/overview#empieza-aquí",{"_3379":70927,"_29627":70924,"_5":29977,"_20564":120909,"_26947":120910,"_2866":120911},[],"/docs/pr-preview/pr-55/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3379":70928,"_29627":70924,"_5":29977,"_20564":120913,"_26947":120914,"_2866":118815},[],"/docs/pr-preview/pr-55/es/platform/pki/overview#capacidades-principales",{"_3379":70929,"_29627":70924,"_5":29977,"_20564":120916,"_26947":120917,"_2866":118819},[],"/docs/pr-preview/pr-55/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3379":70930,"_29627":70924,"_5":29977,"_20564":120919,"_26947":120920,"_2866":118823},[],"/docs/pr-preview/pr-55/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3379":70931,"_29627":70924,"_5":29977,"_20564":120922,"_26947":120923,"_2866":118827},[],"/docs/pr-preview/pr-55/es/platform/pki/overview#emite-y-controla-certificados",{"_3379":70932,"_29627":70924,"_5":29977,"_20564":120925,"_26947":120926,"_2866":118835},[],"/docs/pr-preview/pr-55/es/platform/pki/overview#publica-el-estado-de-validación",{"_3379":70933,"_29627":70924,"_5":29977,"_20564":120928,"_26947":120929,"_2866":120930},[],"/docs/pr-preview/pr-55/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3379":70934,"_29627":70924,"_5":29977,"_20564":120932,"_26947":120933,"_2866":119769},[],"/docs/pr-preview/pr-55/es/platform/pki/overview#continúa",{"_3379":70935,"_29627":70924,"_20564":120935,"_5":14107,"_26947":70924,"_2866":120936},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3379":70936,"_29627":70924,"_20564":120938,"_5":14107,"_26947":120907,"_2866":120939},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3379":70937,"_29627":70924,"_20564":120941,"_5":14107,"_26947":120907,"_2866":120942},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3379":70938,"_29627":70924,"_20564":120944,"_5":14107,"_26947":120910,"_2866":120945},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3379":70939,"_29627":70924,"_20564":120947,"_5":14107,"_26947":120910,"_2866":120948},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3379":70940,"_29627":70924,"_20564":120950,"_5":14107,"_26947":120910,"_2866":120951},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3379":70941,"_29627":70924,"_20564":120953,"_5":14107,"_26947":120910,"_2866":120954},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3379":70942,"_29627":70924,"_20564":120956,"_5":14107,"_26947":120910,"_2866":120957},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3379":70943,"_29627":70924,"_20564":120959,"_5":14107,"_26947":120917,"_2866":120960},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3379":70944,"_29627":70924,"_20564":120962,"_5":14107,"_26947":120920,"_2866":120963},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3379":70945,"_29627":70924,"_20564":120965,"_5":14107,"_26947":120923,"_2866":120966},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3379":70946,"_29627":70924,"_20564":120968,"_5":14107,"_26947":120926,"_2866":120969},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3379":70947,"_29627":70924,"_20564":120971,"_5":14107,"_26947":120929,"_2866":120972},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3379":70948,"_29627":70924,"_20564":120974,"_5":14107,"_26947":120929,"_2866":120975},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3379":70949,"_29627":70924,"_20564":120977,"_5":14107,"_26947":120929,"_2866":120978},[],"su clave pública corresponda a la clave privada del cliente;",{"_3379":70950,"_29627":70924,"_20564":120980,"_5":14107,"_26947":120929,"_2866":120981},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3379":70951,"_29627":70924,"_20564":120983,"_5":14107,"_26947":120929,"_2866":120984},[],"sus fechas y usos permitan la operación;",{"_3379":70952,"_29627":70924,"_20564":120986,"_5":14107,"_26947":120929,"_2866":120987},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3379":70953,"_29627":70924,"_20564":120989,"_5":14107,"_26947":120929,"_2866":120990},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3379":70954,"_29627":70924,"_20564":120992,"_5":14107,"_26947":120933,"_2866":120993},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3379":70955,"_29627":70924,"_20564":120995,"_5":14107,"_26947":120933,"_2866":120996},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3379":70956,"_29627":70924,"_20564":120998,"_5":14107,"_26947":120933,"_2866":120999},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3379":70957,"_29627":70957,"_5":14459,"_2866":121001,"_29980":121002,"_20564":121003,"_26947":70957},"Crea tu primera CA",[48237,115094,53707,118419],[],{"_3379":70958,"_29627":70957,"_20564":121005,"_5":14107,"_26947":70957,"_2866":121006},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3379":70959,"_29627":70957,"_5":29977,"_20564":121008,"_26947":121009,"_2866":113672},[],"/docs/pr-preview/pr-55/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3379":70960,"_29627":70957,"_5":29977,"_20564":121011,"_26947":121012,"_2866":121013},[],"/docs/pr-preview/pr-55/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación-toc","Abre el asistente de creación [!toc]",{"_3379":70961,"_29627":70957,"_5":29977,"_20564":121015,"_26947":121016,"_2866":121017},[],"/docs/pr-preview/pr-55/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave-toc","Selecciona la clave [!toc]",{"_3379":70962,"_29627":70957,"_5":29977,"_20564":121019,"_26947":121020,"_2866":121021},[],"/docs/pr-preview/pr-55/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad-toc","Define la autoridad [!toc]",{"_3379":70963,"_29627":70957,"_5":29977,"_20564":121023,"_26947":121024,"_2866":121025},[],"/docs/pr-preview/pr-55/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca-toc","Revisa y crea la CA [!toc]",{"_3379":70964,"_29627":70957,"_5":29977,"_20564":121027,"_26947":121028,"_2866":121029},[],"/docs/pr-preview/pr-55/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado-toc","Verifica el resultado [!toc]",{"_3379":70965,"_29627":70957,"_5":29977,"_20564":121031,"_26947":121032,"_2866":121033},[],"/docs/pr-preview/pr-55/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3379":70966,"_29627":70957,"_5":29977,"_20564":121035,"_26947":121036,"_2866":118666},[],"/docs/pr-preview/pr-55/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3379":70967,"_29627":70957,"_5":29977,"_20564":121038,"_26947":121039,"_2866":113696},[],"/docs/pr-preview/pr-55/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3379":70968,"_29627":70957,"_20564":121041,"_5":14107,"_26947":70957,"_2866":121042},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3379":70969,"_29627":70957,"_20564":121044,"_5":14107,"_26947":121009,"_2866":121045},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3379":70970,"_29627":70957,"_20564":121047,"_5":14107,"_26947":121009,"_2866":121048},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3379":70971,"_29627":70957,"_20564":121050,"_5":14107,"_26947":121009,"_2866":121051},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3379":70972,"_29627":70957,"_20564":121053,"_5":14107,"_26947":121009,"_2866":121054},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3379":70973,"_29627":70957,"_20564":121056,"_5":14107,"_26947":121012,"_2866":121057},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_3379":70974,"_29627":70957,"_20564":121059,"_5":14107,"_26947":121012,"_2866":121060},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_3379":70975,"_29627":70957,"_20564":121062,"_5":14107,"_26947":121016,"_2866":121063},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_3379":70976,"_29627":70957,"_20564":121065,"_5":14107,"_26947":121016,"_2866":121066},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_3379":70977,"_29627":70957,"_20564":121068,"_5":14107,"_26947":121020,"_2866":121069},[],"Selecciona **Root CA** y completa:",{"_3379":70978,"_29627":70957,"_20564":121071,"_5":14107,"_26947":121020,"_2866":55838},[],{"_3379":70979,"_29627":70957,"_20564":121073,"_5":14107,"_26947":121020,"_2866":121074},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_3379":70980,"_29627":70957,"_20564":121076,"_5":14107,"_26947":121020,"_2866":121077},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_3379":70981,"_29627":70957,"_20564":121079,"_5":14107,"_26947":121020,"_2866":121080},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_3379":70982,"_29627":70957,"_20564":121082,"_5":14107,"_26947":121020,"_2866":121083},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_3379":70983,"_29627":70957,"_20564":121085,"_5":14107,"_26947":121024,"_2866":121086},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_3379":70984,"_29627":70957,"_20564":121088,"_5":14107,"_26947":121028,"_2866":121089},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_3379":70985,"_29627":70957,"_20564":121091,"_5":14107,"_26947":121028,"_2866":121092},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_3379":70986,"_29627":70957,"_20564":121094,"_5":14107,"_26947":121032,"_2866":121095},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3379":70987,"_29627":70957,"_20564":121097,"_5":14107,"_26947":121032,"_2866":121098},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3379":70988,"_29627":70957,"_20564":121100,"_5":14107,"_26947":121032,"_2866":121101},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3379":70989,"_29627":70957,"_20564":121103,"_5":14107,"_26947":121036,"_2866":121104},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3379":70990,"_29627":70957,"_20564":121106,"_5":14107,"_26947":121036,"_2866":121107},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3379":70991,"_29627":70957,"_20564":121109,"_5":14107,"_26947":121036,"_2866":121110},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3379":70992,"_29627":70957,"_20564":121112,"_5":14107,"_26947":121036,"_2866":121113},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3379":70993,"_29627":70957,"_20564":121115,"_5":14107,"_26947":121039,"_2866":121116},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3379":70994,"_29627":70994,"_5":14459,"_2866":121118,"_29980":121119,"_20564":121120,"_26947":70994},"Emite y verifica un certificado",[48237,115094,53707,118419],[],{"_3379":70995,"_29627":70994,"_20564":121122,"_5":14107,"_26947":70994,"_2866":121123},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3379":70996,"_29627":70994,"_5":29977,"_20564":121125,"_26947":121126,"_2866":113672},[],"/docs/pr-preview/pr-55/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3379":70997,"_29627":70994,"_5":29977,"_20564":121128,"_26947":121129,"_2866":121130},[],"/docs/pr-preview/pr-55/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3379":70998,"_29627":70994,"_5":29977,"_20564":121132,"_26947":121133,"_2866":121134},[],"/docs/pr-preview/pr-55/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3379":70999,"_29627":70994,"_5":29977,"_20564":121136,"_26947":121137,"_2866":121138},[],"/docs/pr-preview/pr-55/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3379":71000,"_29627":70994,"_5":29977,"_20564":121140,"_26947":121141,"_2866":121142},[],"/docs/pr-preview/pr-55/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3379":71001,"_29627":70994,"_5":29977,"_20564":121144,"_26947":121145,"_2866":121146},[],"/docs/pr-preview/pr-55/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3379":71002,"_29627":70994,"_5":29977,"_20564":121148,"_26947":121149,"_2866":121150},[],"/docs/pr-preview/pr-55/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado","Verifica el resultado",{"_3379":71003,"_29627":70994,"_5":29977,"_20564":121152,"_26947":121153,"_2866":121154},[],"/docs/pr-preview/pr-55/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3379":71004,"_29627":70994,"_5":29977,"_20564":121156,"_26947":121157,"_2866":121158},[],"/docs/pr-preview/pr-55/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3379":71005,"_29627":70994,"_5":29977,"_20564":121160,"_26947":121161,"_2866":121162},[],"/docs/pr-preview/pr-55/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3379":71006,"_29627":70994,"_5":29977,"_20564":121164,"_26947":121165,"_2866":118666},[],"/docs/pr-preview/pr-55/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3379":71007,"_29627":70994,"_5":29977,"_20564":121167,"_26947":121168,"_2866":113696},[],"/docs/pr-preview/pr-55/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3379":71008,"_29627":70994,"_20564":121170,"_5":14107,"_26947":70994,"_2866":121171},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3379":71009,"_29627":70994,"_20564":121173,"_5":14107,"_26947":121126,"_2866":121174},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3379":71010,"_29627":70994,"_20564":121176,"_5":14107,"_26947":121126,"_2866":121177},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3379":71011,"_29627":70994,"_20564":121179,"_5":14107,"_26947":121126,"_2866":121180},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3379":71012,"_29627":70994,"_20564":121182,"_5":14107,"_26947":121126,"_2866":121183},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3379":71013,"_29627":70994,"_20564":121185,"_5":14107,"_26947":121126,"_2866":121186},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3379":71014,"_29627":70994,"_20564":121188,"_5":14107,"_26947":121129,"_2866":121189},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3379":71015,"_29627":70994,"_20564":121191,"_5":14107,"_26947":121133,"_2866":121192},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3379":71016,"_29627":70994,"_20564":121194,"_5":14107,"_26947":121133,"_2866":121195},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3379":71017,"_29627":70994,"_20564":121197,"_5":14107,"_26947":121137,"_2866":121198},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3379":71018,"_29627":70994,"_20564":121200,"_5":14107,"_26947":121137,"_2866":121201},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3379":71019,"_29627":70994,"_20564":121203,"_5":14107,"_26947":121141,"_2866":121204},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3379":71020,"_29627":70994,"_20564":121206,"_5":14107,"_26947":121141,"_2866":121207},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3379":71021,"_29627":70994,"_20564":121209,"_5":14107,"_26947":121145,"_2866":121210},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3379":71022,"_29627":70994,"_20564":121212,"_5":14107,"_26947":121149,"_2866":121213},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3379":71023,"_29627":70994,"_20564":121215,"_5":14107,"_26947":121153,"_2866":121216},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3379":71024,"_29627":70994,"_20564":121218,"_5":14107,"_26947":121157,"_2866":121219},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3379":71025,"_29627":70994,"_20564":121221,"_5":14107,"_26947":121157,"_2866":121222},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3379":71026,"_29627":70994,"_20564":121224,"_5":14107,"_26947":121157,"_2866":121225},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3379":71027,"_29627":70994,"_20564":121227,"_5":14107,"_26947":121161,"_2866":121228},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3379":71028,"_29627":70994,"_20564":121230,"_5":14107,"_26947":121161,"_2866":121231},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3379":71029,"_29627":70994,"_20564":121233,"_5":14107,"_26947":121161,"_2866":121234},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3379":71030,"_29627":70994,"_20564":121236,"_5":14107,"_26947":121165,"_2866":118749},[],{"_3379":71031,"_29627":70994,"_20564":121238,"_5":14107,"_26947":121165,"_2866":117270},[],{"_3379":71032,"_29627":70994,"_20564":121240,"_5":14107,"_26947":121165,"_2866":121241},[],"La CA rechaza la emisión",{"_3379":71033,"_29627":70994,"_20564":121243,"_5":14107,"_26947":121165,"_2866":121244},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3379":71034,"_29627":70994,"_20564":121246,"_5":14107,"_26947":121165,"_2866":121247},[],"Sujeto o usos diferentes",{"_3379":71035,"_29627":70994,"_20564":121249,"_5":14107,"_26947":121165,"_2866":121250},[],"Perfil aplicado y valores solicitados.",{"_3379":71036,"_29627":70994,"_20564":121252,"_5":14107,"_26947":121165,"_2866":121253},[],"No se encuentra el emisor",{"_3379":71037,"_29627":70994,"_20564":121255,"_5":14107,"_26947":121165,"_2866":121256},[],"CA descargada y cadena intermedia necesaria.",{"_3379":71038,"_29627":70994,"_20564":121258,"_5":14107,"_26947":121165,"_2866":121259},[],"Falla la vigencia",{"_3379":71039,"_29627":70994,"_20564":121261,"_5":14107,"_26947":121165,"_2866":121262},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3379":71040,"_29627":70994,"_20564":121264,"_5":14107,"_26947":121165,"_2866":121265},[],"Los resúmenes de clave difieren",{"_3379":71041,"_29627":70994,"_20564":121267,"_5":14107,"_26947":121165,"_2866":121268},[],"Archivos de certificado y clave de la misma emisión.",{"_3379":71042,"_29627":70994,"_20564":121270,"_5":14107,"_26947":121165,"_2866":121271},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3379":71043,"_29627":70994,"_20564":121273,"_5":14107,"_26947":121168,"_2866":121274},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3379":71044,"_29627":70994,"_20564":121276,"_5":14107,"_26947":121168,"_2866":121277},[],"Gestionar certificados para inspección, estado y revocación.",{"_3379":71045,"_29627":70994,"_20564":121279,"_5":14107,"_26947":121168,"_2866":121280},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3379":71046,"_29627":70994,"_20564":121282,"_5":14107,"_26947":121168,"_2866":121283},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3379":71047,"_29627":70994,"_20564":121285,"_5":14107,"_26947":121168,"_2866":121286},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3379":71048,"_29627":71048,"_5":14459,"_2866":121288,"_29980":121289,"_20564":121290,"_26947":71048},"Primeros pasos de PKI",[48237,115094,53707,118419],[],{"_3379":71049,"_29627":71048,"_20564":121292,"_5":14107,"_26947":71048,"_2866":121293},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3379":71050,"_29627":71048,"_5":29977,"_20564":121295,"_26947":121296,"_2866":113672},[],"/docs/pr-preview/pr-55/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3379":71051,"_29627":71048,"_5":29977,"_20564":121298,"_26947":121299,"_2866":121300},[],"/docs/pr-preview/pr-55/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3379":71052,"_29627":71048,"_5":29977,"_20564":121302,"_26947":121303,"_2866":118601},[],"/docs/pr-preview/pr-55/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3379":71053,"_29627":71048,"_5":29977,"_20564":121305,"_26947":121306,"_2866":121307},[],"/docs/pr-preview/pr-55/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3379":71054,"_29627":71048,"_20564":121309,"_5":14107,"_26947":71048,"_2866":121310},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3379":71055,"_29627":71048,"_20564":121312,"_5":14107,"_26947":121296,"_2866":121313},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3379":71056,"_29627":71048,"_20564":121315,"_5":14107,"_26947":121296,"_2866":121316},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3379":71057,"_29627":71048,"_20564":121318,"_5":14107,"_26947":121296,"_2866":121319},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3379":71058,"_29627":71048,"_20564":121321,"_5":14107,"_26947":121296,"_2866":121322},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3379":71059,"_29627":71048,"_20564":121324,"_5":14107,"_26947":121296,"_2866":121325},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3379":71060,"_29627":71048,"_20564":121327,"_5":14107,"_26947":121299,"_2866":121328},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3379":71061,"_29627":71048,"_20564":121330,"_5":14107,"_26947":121299,"_2866":121331},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3379":71062,"_29627":71048,"_20564":121333,"_5":14107,"_26947":121299,"_2866":121334},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3379":71063,"_29627":71048,"_20564":121336,"_5":14107,"_26947":121299,"_2866":121337},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3379":71064,"_29627":71048,"_20564":121339,"_5":14107,"_26947":121303,"_2866":121340},[],"Archivo o recurso",{"_3379":71065,"_29627":71048,"_20564":121342,"_5":14107,"_26947":121303,"_2866":118598},[],{"_3379":71066,"_29627":71048,"_20564":121344,"_5":14107,"_26947":121303,"_2866":121345},[],"CA raíz activa y `ca.pem`",{"_3379":71067,"_29627":71048,"_20564":121347,"_5":14107,"_26947":121303,"_2866":121348},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3379":71068,"_29627":71048,"_20564":121350,"_5":14107,"_26947":121303,"_2866":121351},[],"Certificado final y `device.crt`",{"_3379":71069,"_29627":71048,"_20564":121353,"_5":14107,"_26947":121303,"_2866":121354},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3379":71070,"_29627":71048,"_20564":121356,"_5":14107,"_26947":121303,"_2866":121357},[],"Clave privada `device.key`",{"_3379":71071,"_29627":71048,"_20564":121359,"_5":14107,"_26947":121303,"_2866":121360},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3379":71072,"_29627":71048,"_20564":121362,"_5":14107,"_26947":121303,"_2866":121363},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3379":71073,"_29627":71048,"_20564":121365,"_5":14107,"_26947":121306,"_2866":121366},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3379":71074,"_29627":71048,"_20564":121368,"_5":14107,"_26947":121306,"_2866":121369},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3379":71075,"_29627":71048,"_20564":121371,"_5":14107,"_26947":121306,"_2866":121372},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3379":71076,"_29627":71076,"_5":14459,"_2866":121374,"_29980":121375,"_20564":121377,"_26947":71076},"Resolución de problemas PKI",[48237,115094,53707,121376],"Resolución de problemas",[],{"_3379":71077,"_29627":71076,"_20564":121379,"_5":14107,"_26947":71076,"_2866":121380},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3379":71078,"_29627":71076,"_5":29977,"_20564":121382,"_26947":121383,"_2866":121384},[],"/docs/pr-preview/pr-55/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3379":71079,"_29627":71076,"_5":29977,"_20564":121386,"_26947":121387,"_2866":121388},[],"/docs/pr-preview/pr-55/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3379":71080,"_29627":71076,"_5":29977,"_20564":121390,"_26947":121391,"_2866":121392},[],"/docs/pr-preview/pr-55/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3379":71081,"_29627":71076,"_20564":121394,"_5":14107,"_26947":71076,"_2866":121395},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3379":71082,"_29627":71076,"_20564":121397,"_5":14107,"_26947":71076,"_2866":121398},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3379":71083,"_29627":71076,"_20564":121400,"_5":14107,"_26947":121383,"_2866":118598},[],{"_3379":71084,"_29627":71076,"_20564":121402,"_5":14107,"_26947":121383,"_2866":117270},[],{"_3379":71085,"_29627":71076,"_20564":121404,"_5":14107,"_26947":121383,"_2866":113696},[],{"_3379":71086,"_29627":71076,"_20564":121406,"_5":14107,"_26947":121383,"_2866":52549},[],{"_3379":71087,"_29627":71076,"_20564":121408,"_5":14107,"_26947":121383,"_2866":121409},[],"Existe, está activa y sus fechas son utilizables.",{"_3379":71088,"_29627":71076,"_20564":121411,"_5":14107,"_26947":121383,"_2866":121412},[],"Autoridades.",{"_3379":71089,"_29627":71076,"_20564":121414,"_5":14107,"_26947":121383,"_2866":121415},[],"Clave",{"_3379":71090,"_29627":71076,"_20564":121417,"_5":14107,"_26947":121383,"_2866":121418},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3379":71091,"_29627":71076,"_20564":121420,"_5":14107,"_26947":121383,"_2866":121421},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3379":71092,"_29627":71076,"_20564":121423,"_5":14107,"_26947":121383,"_2866":56192},[],{"_3379":71093,"_29627":71076,"_20564":121425,"_5":14107,"_26947":121383,"_2866":121426},[],"PEM correcto y firma verificable.",{"_3379":71094,"_29627":71076,"_20564":121428,"_5":14107,"_26947":121383,"_2866":56198},[],{"_3379":71095,"_29627":71076,"_20564":121430,"_5":14107,"_26947":121383,"_2866":121431},[],"Perfil",{"_3379":71096,"_29627":71076,"_20564":121433,"_5":14107,"_26947":121383,"_2866":121434},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3379":71097,"_29627":71076,"_20564":121436,"_5":14107,"_26947":121383,"_2866":121437},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3379":71098,"_29627":71076,"_20564":121439,"_5":14107,"_26947":121383,"_2866":118749},[],{"_3379":71099,"_29627":71076,"_20564":121441,"_5":14107,"_26947":121383,"_2866":121442},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3379":71100,"_29627":71076,"_20564":121444,"_5":14107,"_26947":121383,"_2866":121445},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3379":71101,"_29627":71076,"_20564":121447,"_5":14107,"_26947":121383,"_2866":121448},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3379":71102,"_29627":71076,"_20564":121450,"_5":14107,"_26947":121383,"_2866":121451},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3379":71103,"_29627":71076,"_20564":121453,"_5":14107,"_26947":121387,"_2866":121454},[],"Revisa cada frontera por separado:",{"_3379":71104,"_29627":71076,"_20564":121456,"_5":14107,"_26947":121387,"_2866":121457},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3379":71105,"_29627":71076,"_20564":121459,"_5":14107,"_26947":121387,"_2866":121460},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3379":71106,"_29627":71076,"_20564":121462,"_5":14107,"_26947":121387,"_2866":121463},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3379":71107,"_29627":71076,"_20564":121465,"_5":14107,"_26947":121387,"_2866":121466},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3379":71108,"_29627":71076,"_20564":121468,"_5":14107,"_26947":121387,"_2866":121469},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3379":71109,"_29627":71076,"_20564":121471,"_5":14107,"_26947":121387,"_2866":121472},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_3379":71110,"_29627":71076,"_20564":121474,"_5":14107,"_26947":121391,"_2866":121475},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3379":71111,"_29627":71076,"_20564":121477,"_5":14107,"_26947":121391,"_2866":121478},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3379":71112,"_29627":71112,"_5":14459,"_2866":121480,"_29980":121481,"_20564":121482,"_26947":71112},"Seguridad",[48237],[],{"_3379":71113,"_29627":71112,"_20564":121484,"_5":14107,"_26947":71112,"_2866":121485},[],"Cómo reportar de forma privada una vulnerabilidad de seguridad en Lamassu, qué incluir en el reporte y qué releases reciben correcciones de seguridad.",{"_3379":71114,"_29627":71112,"_5":29977,"_20564":121487,"_26947":121488,"_2866":121489},[],"/docs/pr-preview/pr-55/es/security#cómo-reportar-una-vulnerabilidad","Cómo reportar una vulnerabilidad",{"_3379":71115,"_29627":71112,"_5":29977,"_20564":121491,"_26947":121492,"_2866":121493},[],"/docs/pr-preview/pr-55/es/security#qué-incluir-en-un-reporte","Qué incluir en un reporte",{"_3379":71116,"_29627":71112,"_5":29977,"_20564":121495,"_26947":121496,"_2866":121497},[],"/docs/pr-preview/pr-55/es/security#versiones-soportadas","Versiones soportadas",{"_3379":71117,"_29627":71112,"_5":29977,"_20564":121499,"_26947":121500,"_2866":121501},[],"/docs/pr-preview/pr-55/es/security#divulgación-responsable","Divulgación responsable",{"_3379":71118,"_29627":71112,"_20564":121503,"_5":14107,"_26947":71112,"_2866":121504},[],"¿Has encontrado una vulnerabilidad de seguridad en lamassuiot, lamassu-dashboard o lamassu-helm? Esta página explica cómo reportarla de forma privada, qué incluir en tu reporte y qué releases reciben correcciones de seguridad.",{"_3379":71119,"_29627":71112,"_20564":121506,"_5":14107,"_26947":121488,"_2866":121507},[],"No reportes vulnerabilidades de seguridad mediante issues, discusiones o pull requests públicos de GitHub. Un reporte público divulga el problema antes de que los mantenedores puedan corregirlo.",{"_3379":71120,"_29627":71112,"_20564":121509,"_5":14107,"_26947":121488,"_2866":121510},[],"En su lugar, reporta de forma privada mediante GitHub Security Advisories para el repositorio afectado:",{"_3379":71121,"_29627":71112,"_20564":121512,"_5":14107,"_26947":121488,"_2866":14726},[],{"_3379":71122,"_29627":71112,"_20564":121514,"_5":14107,"_26947":121488,"_2866":14672},[],{"_3379":71123,"_29627":71112,"_20564":121516,"_5":14107,"_26947":121488,"_2866":14719},[],{"_3379":71124,"_29627":71112,"_20564":121518,"_5":14107,"_26947":121488,"_2866":121519},[],"Así los mantenedores pueden evaluar y resolver el problema antes de que se publique.",{"_3379":71125,"_29627":71112,"_20564":121521,"_5":14107,"_26947":121488,"_2866":121522},[],"Si el reporte privado de vulnerabilidades no está habilitado en ese repositorio, reporta la vulnerabilidad de forma privada a lamassuiot\\@lksnext.com antes de divulgar cualquier detalle públicamente.",{"_3379":71126,"_29627":71112,"_20564":121524,"_5":14107,"_26947":121492,"_2866":121525},[],"Describe la vulnerabilidad, su impacto potencial y los pasos para reproducirla usando ejemplos no sensibles y anonimizados.",{"_3379":71127,"_29627":71112,"_20564":121527,"_5":14107,"_26947":121492,"_2866":121528},[],"No incluyas en el reporte:",{"_3379":71128,"_29627":71112,"_20564":121530,"_5":14107,"_26947":121492,"_2866":121531},[],"Credenciales, tokens o claves privadas",{"_3379":71129,"_29627":71112,"_20564":121533,"_5":14107,"_26947":121492,"_2866":121534},[],"Datos de clientes o información identificable de clientes",{"_3379":71130,"_29627":71112,"_20564":121536,"_5":14107,"_26947":121492,"_2866":121537},[],"Detalles confidenciales de arquitectura o de infraestructura interna",{"_3379":71131,"_29627":71112,"_20564":121539,"_5":14107,"_26947":121496,"_2866":121540},[],"Solo el último release estable recibe soporte de seguridad. El soporte de un release estable termina cuando se publica el siguiente release estable. Los releases anteriores y los pre-releases no tienen soporte.",{"_3379":71132,"_29627":71112,"_20564":121542,"_5":14107,"_26947":121496,"_2866":121543},[],"Para saber cómo actualizar, consulta Actualizaciones.",{"_3379":71133,"_29627":71112,"_20564":121545,"_5":14107,"_26947":121500,"_2866":121546},[],"Da a los mantenedores un tiempo razonable para investigar y resolver la vulnerabilidad reportada antes de cualquier divulgación pública.",{"_3379":71134,"_29627":71112,"_20564":121548,"_5":14107,"_26947":121500,"_2866":121549},[],"Evita violaciones de privacidad, destrucción de datos e interrupciones de servicio mientras investigas la vulnerabilidad.",{"_3379":71135,"_29627":71112,"_20564":121551,"_5":14107,"_26947":121500,"_2866":121552},[],"Interactúa solo con cuentas o datos que sean tuyos o sobre los que tengas permiso explícito.",{"_3379":71136,"_29627":71112,"_20564":121554,"_5":14107,"_26947":121500,"_2866":121555},[],"Los mantenedores reconocen los reportes en un tiempo razonable y te mantienen informado del progreso de la remediación.",{"_3379":71137,"_29627":71112,"_20564":121557,"_5":14107,"_26947":121500,"_2866":121558},[],"Esta política cubre el código fuente, la configuración y los flujos de CI/CD de los repositorios lamassuiot, lamassu-dashboard y lamassu-helm.",{"_3379":71138,"_29627":71138,"_5":14459,"_2866":121560,"_29980":121561,"_20564":121563,"_26947":71138},"3.8.0 a 4.0.0",[48237,121562],"Actualizaciones",[],{"_3379":71139,"_29627":71138,"_20564":121565,"_5":14107,"_26947":71138,"_2866":121566},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3379":71140,"_29627":71138,"_5":29977,"_20564":121568,"_26947":121569,"_2866":121570},[],"/docs/pr-preview/pr-55/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_3379":71141,"_29627":71138,"_5":29977,"_20564":121572,"_26947":121573,"_2866":121574},[],"/docs/pr-preview/pr-55/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3379":71142,"_29627":71138,"_5":29977,"_20564":121576,"_26947":121577,"_2866":121578},[],"/docs/pr-preview/pr-55/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3379":71143,"_29627":71138,"_5":29977,"_20564":121580,"_26947":121581,"_2866":121582},[],"/docs/pr-preview/pr-55/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3379":71144,"_29627":71138,"_5":29977,"_20564":121584,"_26947":121585,"_2866":121586},[],"/docs/pr-preview/pr-55/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3379":71145,"_29627":71138,"_5":29977,"_20564":121588,"_26947":121589,"_2866":121590},[],"/docs/pr-preview/pr-55/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3379":71146,"_29627":71138,"_5":29977,"_20564":121592,"_26947":121593,"_2866":56364},[],"/docs/pr-preview/pr-55/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3379":71147,"_29627":71138,"_5":29977,"_20564":121595,"_26947":121596,"_2866":121597},[],"/docs/pr-preview/pr-55/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_3379":71148,"_29627":71138,"_5":29977,"_20564":121599,"_26947":121600,"_2866":121601},[],"/docs/pr-preview/pr-55/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3379":71149,"_29627":71138,"_5":29977,"_20564":121603,"_26947":121604,"_2866":121605},[],"/docs/pr-preview/pr-55/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3379":71150,"_29627":71138,"_5":29977,"_20564":121607,"_26947":121608,"_2866":121609},[],"/docs/pr-preview/pr-55/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3379":71151,"_29627":71138,"_5":29977,"_20564":121611,"_26947":121612,"_2866":121613},[],"/docs/pr-preview/pr-55/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3379":71152,"_29627":71138,"_5":29977,"_20564":121615,"_26947":121616,"_2866":121617},[],"/docs/pr-preview/pr-55/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3379":71153,"_29627":71138,"_5":29977,"_20564":121619,"_26947":121620,"_2866":121621},[],"/docs/pr-preview/pr-55/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3379":71154,"_29627":71138,"_5":29977,"_20564":121623,"_26947":121624,"_2866":121625},[],"/docs/pr-preview/pr-55/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3379":71155,"_29627":71138,"_5":29977,"_20564":121627,"_26947":121628,"_2866":121629},[],"/docs/pr-preview/pr-55/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_3379":71156,"_29627":71138,"_5":29977,"_20564":121631,"_26947":121632,"_2866":121633},[],"/docs/pr-preview/pr-55/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3379":71157,"_29627":71138,"_5":29977,"_20564":121635,"_26947":121636,"_2866":121637},[],"/docs/pr-preview/pr-55/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3379":71158,"_29627":71138,"_5":29977,"_20564":121639,"_26947":121640,"_2866":121641},[],"/docs/pr-preview/pr-55/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3379":71159,"_29627":71138,"_5":29977,"_20564":121643,"_26947":121644,"_2866":121645},[],"/docs/pr-preview/pr-55/es/upgrades/3-8-0-to-4-0-0#referencias-entre-certificados-claves-y-roles-va","Referencias entre certificados, claves y roles VA",{"_3379":71160,"_29627":71138,"_5":29977,"_20564":121647,"_26947":121648,"_2866":121649},[],"/docs/pr-preview/pr-55/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_3379":71161,"_29627":71138,"_5":29977,"_20564":121651,"_26947":121652,"_2866":121653},[],"/docs/pr-preview/pr-55/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3379":71162,"_29627":71138,"_5":29977,"_20564":121655,"_26947":121656,"_2866":121657},[],"/docs/pr-preview/pr-55/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3379":71163,"_29627":71138,"_5":29977,"_20564":121659,"_26947":121660,"_2866":121661},[],"/docs/pr-preview/pr-55/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3379":71164,"_29627":71138,"_5":29977,"_20564":121663,"_26947":121664,"_2866":121665},[],"/docs/pr-preview/pr-55/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3379":71165,"_29627":71138,"_5":29977,"_20564":121667,"_26947":121668,"_2866":121669},[],"/docs/pr-preview/pr-55/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3379":71166,"_29627":71138,"_5":29977,"_20564":121671,"_26947":121672,"_2866":121673},[],"/docs/pr-preview/pr-55/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3379":71167,"_29627":71138,"_5":29977,"_20564":121675,"_26947":121676,"_2866":121677},[],"/docs/pr-preview/pr-55/es/upgrades/3-8-0-to-4-0-0#campo-firmante-del-rol-va","Campo firmante del rol VA",{"_3379":71168,"_29627":71138,"_5":29977,"_20564":121679,"_26947":121680,"_2866":121681},[],"/docs/pr-preview/pr-55/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3379":71169,"_29627":71138,"_5":29977,"_20564":121683,"_26947":121684,"_2866":121685},[],"/docs/pr-preview/pr-55/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3379":71170,"_29627":71138,"_5":29977,"_20564":121687,"_26947":121688,"_2866":121689},[],"/docs/pr-preview/pr-55/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3379":71171,"_29627":71138,"_5":29977,"_20564":121691,"_26947":121692,"_2866":121693},[],"/docs/pr-preview/pr-55/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3379":71172,"_29627":71138,"_5":29977,"_20564":121695,"_26947":121696,"_2866":121697},[],"/docs/pr-preview/pr-55/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3379":71173,"_29627":71138,"_5":29977,"_20564":121699,"_26947":121700,"_2866":121701},[],"/docs/pr-preview/pr-55/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3379":71174,"_29627":71138,"_5":29977,"_20564":121703,"_26947":121704,"_2866":121705},[],"/docs/pr-preview/pr-55/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3379":71175,"_29627":71138,"_5":29977,"_20564":121707,"_26947":121708,"_2866":117612},[],"/docs/pr-preview/pr-55/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3379":71176,"_29627":71138,"_5":29977,"_20564":121710,"_26947":121711,"_2866":121712},[],"/docs/pr-preview/pr-55/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3379":71177,"_29627":71138,"_5":29977,"_20564":121714,"_26947":121715,"_2866":121716},[],"/docs/pr-preview/pr-55/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3379":71178,"_29627":71138,"_20564":121718,"_5":14107,"_26947":71138,"_2866":121719},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3379":71179,"_29627":71138,"_20564":121721,"_5":14107,"_26947":71138,"_2866":121722},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3379":71180,"_29627":71138,"_20564":121724,"_5":14107,"_26947":71138,"_2866":121725},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_3379":71181,"_29627":71138,"_20564":121727,"_5":14107,"_26947":71138,"_2866":121728},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_3379":71182,"_29627":71138,"_20564":121730,"_5":14107,"_26947":71138,"_2866":121731},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3379":71183,"_29627":71138,"_20564":121733,"_5":14107,"_26947":71138,"_2866":121734},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3379":71184,"_29627":71138,"_20564":121736,"_5":14107,"_26947":71138,"_2866":121737},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3379":71185,"_29627":71138,"_20564":121739,"_5":14107,"_26947":121573,"_2866":121740},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3379":71186,"_29627":71138,"_20564":121742,"_5":14107,"_26947":121573,"_2866":121743},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_3379":71187,"_29627":71138,"_20564":121745,"_5":14107,"_26947":121577,"_2866":121746},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3379":71188,"_29627":71138,"_20564":121748,"_5":14107,"_26947":121577,"_2866":121749},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y roles de la VA. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3379":71189,"_29627":71138,"_20564":121751,"_5":14107,"_26947":121581,"_2866":121752},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera.",{"_3379":71190,"_29627":71138,"_20564":121754,"_5":14107,"_26947":121585,"_2866":121755},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3379":71191,"_29627":71138,"_20564":121757,"_5":14107,"_26947":121585,"_2866":121758},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3379":71192,"_29627":71138,"_20564":121760,"_5":14107,"_26947":121585,"_2866":121761},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_3379":71193,"_29627":71138,"_20564":121763,"_5":14107,"_26947":121585,"_2866":121764},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3379":71194,"_29627":71138,"_20564":121766,"_5":14107,"_26947":121585,"_2866":121767},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3379":71195,"_29627":71138,"_20564":121769,"_5":14107,"_26947":121589,"_2866":121770},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3379":71196,"_29627":71138,"_20564":121772,"_5":14107,"_26947":121589,"_2866":121773},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3379":71197,"_29627":71138,"_20564":121775,"_5":14107,"_26947":121589,"_2866":121776},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3379":71198,"_29627":71138,"_20564":121778,"_5":14107,"_26947":121589,"_2866":121779},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3379":71199,"_29627":71138,"_20564":121781,"_5":14107,"_26947":121589,"_2866":121782},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3379":71200,"_29627":71138,"_20564":121784,"_5":14107,"_26947":121593,"_2866":121785},[],"Cambio",{"_3379":71201,"_29627":71138,"_20564":121787,"_5":14107,"_26947":121593,"_2866":121788},[],"A quién afecta",{"_3379":71202,"_29627":71138,"_20564":121790,"_5":14107,"_26947":121593,"_2866":121791},[],"Gravedad",{"_3379":71203,"_29627":71138,"_20564":121793,"_5":14107,"_26947":121593,"_2866":120320},[],{"_3379":71204,"_29627":71138,"_20564":121795,"_5":14107,"_26947":121593,"_2866":121601},[],{"_3379":71205,"_29627":71138,"_20564":121797,"_5":14107,"_26947":121593,"_2866":121798},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_3379":71206,"_29627":71138,"_20564":121800,"_5":14107,"_26947":121593,"_2866":121801},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_3379":71207,"_29627":71138,"_20564":121803,"_5":14107,"_26947":121593,"_2866":121804},[],"Copiar los datos a los volúmenes nuevos",{"_3379":71208,"_29627":71138,"_20564":121806,"_5":14107,"_26947":121593,"_2866":121605},[],{"_3379":71209,"_29627":71138,"_20564":121808,"_5":14107,"_26947":121593,"_2866":121809},[],"Todas las releases de Helm",{"_3379":71210,"_29627":71138,"_20564":121811,"_5":14107,"_26947":121593,"_2866":121812},[],"Alta: `helm upgrade` falla",{"_3379":71211,"_29627":71138,"_20564":121814,"_5":14107,"_26947":121593,"_2866":121815},[],"Eliminar o renombrar las claves heredadas",{"_3379":71212,"_29627":71138,"_20564":121817,"_5":14107,"_26947":121593,"_2866":121609},[],{"_3379":71213,"_29627":71138,"_20564":121819,"_5":14107,"_26947":121593,"_2866":121820},[],"Todos los despliegues",{"_3379":71214,"_29627":71138,"_20564":121822,"_5":14107,"_26947":121593,"_2866":121823},[],"Alta: sin principal de bootstrap no hay administrador",{"_3379":71215,"_29627":71138,"_20564":121825,"_5":14107,"_26947":121593,"_2866":121826},[],"Configurar `services.authz`",{"_3379":71216,"_29627":71138,"_20564":121828,"_5":14107,"_26947":121593,"_2866":121613},[],{"_3379":71217,"_29627":71138,"_20564":121830,"_5":14107,"_26947":121593,"_2866":121809},[],{"_3379":71218,"_29627":71138,"_20564":121832,"_5":14107,"_26947":121593,"_2866":121833},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_3379":71219,"_29627":71138,"_20564":121835,"_5":14107,"_26947":121593,"_2866":121836},[],"Mover JWKS y roles a `services.authz`",{"_3379":71220,"_29627":71138,"_20564":121838,"_5":14107,"_26947":121593,"_2866":121633},[],{"_3379":71221,"_29627":71138,"_20564":121840,"_5":14107,"_26947":121593,"_2866":121841},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_3379":71222,"_29627":71138,"_20564":121843,"_5":14107,"_26947":121593,"_2866":121844},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_3379":71223,"_29627":71138,"_20564":121846,"_5":14107,"_26947":121593,"_2866":121847},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_3379":71224,"_29627":71138,"_20564":121849,"_5":14107,"_26947":121593,"_2866":121637},[],{"_3379":71225,"_29627":71138,"_20564":121851,"_5":14107,"_26947":121593,"_2866":121852},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_3379":71226,"_29627":71138,"_20564":121854,"_5":14107,"_26947":121593,"_2866":121855},[],"Alta: el backend ya no arranca con ellos",{"_3379":71227,"_29627":71138,"_20564":121857,"_5":14107,"_26947":121593,"_2866":121858},[],"Pasar a PostgreSQL antes de actualizar",{"_3379":71228,"_29627":71138,"_20564":121860,"_5":14107,"_26947":121593,"_2866":121861},[],"Webhooks con referencias a archivos",{"_3379":71229,"_29627":71138,"_20564":121863,"_5":14107,"_26947":121593,"_2866":121864},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3379":71230,"_29627":71138,"_20564":121866,"_5":14107,"_26947":121593,"_2866":121867},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_3379":71231,"_29627":71138,"_20564":121869,"_5":14107,"_26947":121593,"_2866":121870},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3379":71232,"_29627":71138,"_20564":121872,"_5":14107,"_26947":121593,"_2866":121617},[],{"_3379":71233,"_29627":71138,"_20564":121874,"_5":14107,"_26947":121593,"_2866":121875},[],"Releases con identidades por servicio o material de claves montado",{"_3379":71234,"_29627":71138,"_20564":121877,"_5":14107,"_26947":121593,"_2866":121878},[],"Media: los servicios no pueden leer sus archivos",{"_3379":71235,"_29627":71138,"_20564":121880,"_5":14107,"_26947":121593,"_2866":121881},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_3379":71236,"_29627":71138,"_20564":121883,"_5":14107,"_26947":121593,"_2866":121621},[],{"_3379":71237,"_29627":71138,"_20564":121885,"_5":14107,"_26947":121593,"_2866":121886},[],"Releases que definen `amqp.tls`",{"_3379":71238,"_29627":71138,"_20564":121888,"_5":14107,"_26947":121593,"_2866":121889},[],"Media: los clientes se conectan al puerto equivocado",{"_3379":71239,"_29627":71138,"_20564":121891,"_5":14107,"_26947":121593,"_2866":121892},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_3379":71240,"_29627":71138,"_20564":121894,"_5":14107,"_26947":121593,"_2866":121641},[],{"_3379":71241,"_29627":71138,"_20564":121896,"_5":14107,"_26947":121593,"_2866":121897},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3379":71242,"_29627":71138,"_20564":121899,"_5":14107,"_26947":121593,"_2866":121900},[],"Media: las claves de CA quedan sin gestionar",{"_3379":71243,"_29627":71138,"_20564":121902,"_5":14107,"_26947":121593,"_2866":121903},[],"Ejecutar la migración de CA a KMS",{"_3379":71244,"_29627":71138,"_20564":121905,"_5":14107,"_26947":121593,"_2866":121906},[],"Verificación del certificado del receptor",{"_3379":71245,"_29627":71138,"_20564":121908,"_5":14107,"_26947":121593,"_2866":121909},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_3379":71246,"_29627":71138,"_20564":121911,"_5":14107,"_26947":121593,"_2866":121912},[],"Media: las credenciales viajan a un receptor sin verificar",{"_3379":71247,"_29627":71138,"_20564":121914,"_5":14107,"_26947":121593,"_2866":121915},[],"Poner `insecure_skip_verify` a `false`",{"_3379":71248,"_29627":71138,"_20564":121917,"_5":14107,"_26947":121593,"_2866":121657},[],{"_3379":71249,"_29627":71138,"_20564":121919,"_5":14107,"_26947":121593,"_2866":121920},[],"Scripts y consolas que editan DMS por API",{"_3379":71250,"_29627":71138,"_20564":121922,"_5":14107,"_26947":121593,"_2866":121923},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3379":71251,"_29627":71138,"_20564":121925,"_5":14107,"_26947":121593,"_2866":121926},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3379":71252,"_29627":71138,"_20564":121928,"_5":14107,"_26947":121593,"_2866":121677},[],{"_3379":71253,"_29627":71138,"_20564":121930,"_5":14107,"_26947":121593,"_2866":121931},[],"Clientes que crean o actualizan roles VA por API",{"_3379":71254,"_29627":71138,"_20564":121933,"_5":14107,"_26947":121593,"_2866":121934},[],"Media: las peticiones con el campo antiguo devuelven un error",{"_3379":71255,"_29627":71138,"_20564":121936,"_5":14107,"_26947":121593,"_2866":121937},[],"Sustituir `crl_options.subject_key_id_signer` por el obligatorio `crl_options.signer_certificate_serial_number`",{"_3379":71256,"_29627":71138,"_20564":121939,"_5":14107,"_26947":121593,"_2866":121673},[],{"_3379":71257,"_29627":71138,"_20564":121941,"_5":14107,"_26947":121593,"_2866":121942},[],"Consumidores que leen el campo `events` del dispositivo",{"_3379":71258,"_29627":71138,"_20564":121944,"_5":14107,"_26947":121593,"_2866":121945},[],"Media: el campo desaparece",{"_3379":71259,"_29627":71138,"_20564":121947,"_5":14107,"_26947":121593,"_2866":121948},[],"Usar los nuevos endpoints de eventos",{"_3379":71260,"_29627":71138,"_20564":121950,"_5":14107,"_26947":121593,"_2866":121625},[],{"_3379":71261,"_29627":71138,"_20564":121952,"_5":14107,"_26947":121593,"_2866":121953},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_3379":71262,"_29627":71138,"_20564":121955,"_5":14107,"_26947":121593,"_2866":121956},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_3379":71263,"_29627":71138,"_20564":121958,"_5":14107,"_26947":121593,"_2866":121959},[],"Actualizar el archivo de values",{"_3379":71264,"_29627":71138,"_20564":121961,"_5":14107,"_26947":121593,"_2866":121665},[],{"_3379":71265,"_29627":71138,"_20564":121963,"_5":14107,"_26947":121593,"_2866":121964},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3379":71266,"_29627":71138,"_20564":121966,"_5":14107,"_26947":121593,"_2866":121967},[],"Baja: prevalece el ID de la URL",{"_3379":71267,"_29627":71138,"_20564":121969,"_5":14107,"_26947":121593,"_2866":121970},[],"Enviar el ID en la URL",{"_3379":71268,"_29627":71138,"_20564":121972,"_5":14107,"_26947":121593,"_2866":121669},[],{"_3379":71269,"_29627":71138,"_20564":121974,"_5":14107,"_26947":121593,"_2866":121975},[],"Consumidores que comparan el `type` del certificado",{"_3379":71270,"_29627":71138,"_20564":121977,"_5":14107,"_26947":121593,"_2866":121978},[],"Baja: dos valores cambian de nombre",{"_3379":71271,"_29627":71138,"_20564":121980,"_5":14107,"_26947":121593,"_2866":121981},[],"Adaptar los consumidores",{"_3379":71272,"_29627":71138,"_20564":121983,"_5":14107,"_26947":121593,"_2866":121661},[],{"_3379":71273,"_29627":71138,"_20564":121985,"_5":14107,"_26947":121593,"_2866":121986},[],"Cualquier DMS",{"_3379":71274,"_29627":71138,"_20564":121988,"_5":14107,"_26947":121593,"_2866":121989},[],"Baja: solo informativo",{"_3379":71275,"_29627":71138,"_20564":121991,"_5":14107,"_26947":121593,"_2866":121992},[],"Revisar ambos bloques antes de editar",{"_3379":71276,"_29627":71138,"_20564":121994,"_5":14107,"_26947":121600,"_2866":121995},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3379":71277,"_29627":71138,"_20564":121997,"_5":14107,"_26947":121600,"_2866":121998},[],"El paso 4 de la guía de migración copia los datos.",{"_3379":71278,"_29627":71138,"_20564":122000,"_5":14107,"_26947":121604,"_2866":122001},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3379":71279,"_29627":71138,"_20564":122003,"_5":14107,"_26947":121608,"_2866":122004},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3379":71280,"_29627":71138,"_20564":122006,"_5":14107,"_26947":121612,"_2866":122007},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3379":71281,"_29627":71138,"_20564":122009,"_5":14107,"_26947":121616,"_2866":122010},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3379":71282,"_29627":71138,"_20564":122012,"_5":14107,"_26947":121616,"_2866":122013},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3379":71283,"_29627":71138,"_20564":122015,"_5":14107,"_26947":121620,"_2866":122016},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3379":71284,"_29627":71138,"_20564":122018,"_5":14107,"_26947":121624,"_2866":122019},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3379":71285,"_29627":71138,"_20564":122021,"_5":14107,"_26947":121624,"_2866":122022},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3379":71286,"_29627":71138,"_20564":122024,"_5":14107,"_26947":121624,"_2866":122025},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3379":71287,"_29627":71138,"_20564":122027,"_5":14107,"_26947":121624,"_2866":122028},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3379":71288,"_29627":71138,"_20564":122030,"_5":14107,"_26947":121624,"_2866":122031},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3379":71289,"_29627":71138,"_20564":122033,"_5":14107,"_26947":121624,"_2866":122034},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3379":71290,"_29627":71138,"_20564":122036,"_5":14107,"_26947":121632,"_2866":122037},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3379":71291,"_29627":71138,"_20564":122039,"_5":14107,"_26947":121632,"_2866":122040},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3379":71292,"_29627":71138,"_20564":122042,"_5":14107,"_26947":121632,"_2866":122043},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3379":71293,"_29627":71138,"_20564":122045,"_5":14107,"_26947":121632,"_2866":122046},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3379":71294,"_29627":71138,"_20564":122048,"_5":14107,"_26947":121632,"_2866":122049},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_3379":71295,"_29627":71138,"_20564":122051,"_5":14107,"_26947":121636,"_2866":122052},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3379":71296,"_29627":71138,"_20564":122054,"_5":14107,"_26947":121640,"_2866":122055},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3379":71297,"_29627":71138,"_20564":122057,"_5":14107,"_26947":121640,"_2866":122058},[],"El `key_id` es el `subject_key_id` del certificado (SHA-256 de la clave pública).",{"_3379":71298,"_29627":71138,"_20564":122060,"_5":14107,"_26947":121640,"_2866":122061},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3379":71299,"_29627":71138,"_20564":122063,"_5":14107,"_26947":121640,"_2866":122064},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3379":71300,"_29627":71138,"_20564":122066,"_5":14107,"_26947":121640,"_2866":122067},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3379":71301,"_29627":71138,"_20564":122069,"_5":14107,"_26947":121640,"_2866":122070},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3379":71302,"_29627":71138,"_20564":122072,"_5":14107,"_26947":121640,"_2866":122073},[],"Una vez registradas las claves heredadas, arrancar el KMS con la opción de configuración del backend `crypto_engines.migrate_keys_format` renombra las claves cuyo nombre no es el digest SHA-256 de la clave pública, conserva el nombre antiguo como alias y traslada consigo las referencias de certificados. Es seguro volver a ejecutarla y puede desactivarse después.",{"_3379":71303,"_29627":71138,"_20564":122075,"_5":14107,"_26947":121644,"_2866":122076},[],"Los certificados referencian ahora su clave del KMS, y los roles VA referencian su certificado firmante, de modo que no se puede eliminar una clave o un certificado en uso. La migración del KMS descarta los metadatos de clave heredados `lamassu.io/kms/binded-resources`. Antes de 4.0.0, eliminar una CA podía borrar su clave y dejar referencias a ella en los registros de certificado conservados. La migración de CA registra esas claves ausentes en el KMS solo con su clave pública para satisfacer las referencias conservadas. Estas entradas no pueden eliminarse mientras los certificados conservados las referencien; no recuperan la clave privada. En 4.0.0, eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados antes de intentar eliminar la clave; los demás certificados que todavía la referencien impiden su eliminación.",{"_3379":71304,"_29627":71138,"_20564":122078,"_5":14107,"_26947":121652,"_2866":122079},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_3379":71305,"_29627":71138,"_20564":122081,"_5":14107,"_26947":121652,"_2866":122082},[],"Campo en 3.8.0",{"_3379":71306,"_29627":71138,"_20564":122084,"_5":14107,"_26947":121652,"_2866":122085},[],"Campo en 4.0.0",{"_3379":71307,"_29627":71138,"_20564":122087,"_5":14107,"_26947":121652,"_2866":56859},[],{"_3379":71308,"_29627":71138,"_20564":122089,"_5":14107,"_26947":121652,"_2866":122090},[],"`insecure_skip_verify` (con el valor negado)",{"_3379":71309,"_29627":71138,"_20564":122092,"_5":14107,"_26947":121652,"_2866":56865},[],{"_3379":71310,"_29627":71138,"_20564":122094,"_5":14107,"_26947":121652,"_2866":56868},[],{"_3379":71311,"_29627":71138,"_20564":122096,"_5":14107,"_26947":121652,"_2866":56871},[],{"_3379":71312,"_29627":71138,"_20564":122098,"_5":14107,"_26947":121652,"_2866":56874},[],{"_3379":71313,"_29627":71138,"_20564":122100,"_5":14107,"_26947":121652,"_2866":56877},[],{"_3379":71314,"_29627":71138,"_20564":122102,"_5":14107,"_26947":121652,"_2866":56880},[],{"_3379":71315,"_29627":71138,"_20564":122104,"_5":14107,"_26947":121652,"_2866":122105},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_3379":71316,"_29627":71138,"_20564":122107,"_5":14107,"_26947":121652,"_2866":122108},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3379":71317,"_29627":71138,"_20564":122110,"_5":14107,"_26947":121652,"_2866":122111},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3379":71318,"_29627":71138,"_20564":122113,"_5":14107,"_26947":121656,"_2866":122114},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3379":71319,"_29627":71138,"_20564":122116,"_5":14107,"_26947":121656,"_2866":122117},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3379":71320,"_29627":71138,"_20564":122119,"_5":14107,"_26947":121656,"_2866":122120},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3379":71321,"_29627":71138,"_20564":122122,"_5":14107,"_26947":121660,"_2866":122123},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. La consola expone editores independientes para ambos bloques; la guía de DMS describe sus campos, y también puedes editarlos mediante la API DMS.",{"_3379":71322,"_29627":71138,"_20564":122125,"_5":14107,"_26947":121664,"_2866":122126},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3379":71323,"_29627":71138,"_20564":122128,"_5":14107,"_26947":121668,"_2866":122129},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_3379":71324,"_29627":71138,"_20564":122131,"_5":14107,"_26947":121672,"_2866":122132},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3379":71325,"_29627":71138,"_20564":122134,"_5":14107,"_26947":121672,"_2866":122135},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3379":71326,"_29627":71138,"_20564":122137,"_5":14107,"_26947":121672,"_2866":122138},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3379":71327,"_29627":71138,"_20564":122140,"_5":14107,"_26947":121672,"_2866":122141},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza.",{"_3379":71328,"_29627":71138,"_20564":122143,"_5":14107,"_26947":121676,"_2866":122144},[],"`crl_options.subject_key_id_signer` se sustituye por el obligatorio `crl_options.signer_certificate_serial_number`, el número de serie del certificado existente que firma la CRL. El valor inicial de un rol nuevo es el número de serie del certificado actual de la CA. Las peticiones que aún contienen `subject_key_id_signer` devuelven un error. Las políticas de autorización personalizadas que filtran por el campo antiguo deben actualizarse: el filtro `crl_subject_key_id_signer` se renombra a `crl_signer_certificate_serial_number` y toma valores de número de serie.",{"_3379":71329,"_29627":71138,"_20564":122146,"_5":14107,"_26947":121680,"_2866":122147},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3379":71330,"_29627":71138,"_20564":122149,"_5":14107,"_26947":121684,"_2866":122150},[],"Haz una copia de seguridad verificable de PostgreSQL y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`.",{"_3379":71331,"_29627":71138,"_20564":122152,"_5":14107,"_26947":121684,"_2866":122153},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3379":71332,"_29627":71138,"_20564":122155,"_5":14107,"_26947":121684,"_2866":122156},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3379":71333,"_29627":71138,"_20564":122158,"_5":14107,"_26947":121684,"_2866":122159},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3379":71334,"_29627":71138,"_20564":122161,"_5":14107,"_26947":121684,"_2866":122162},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3379":71335,"_29627":71138,"_20564":122164,"_5":14107,"_26947":121688,"_2866":122165},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3379":71336,"_29627":71138,"_20564":122167,"_5":14107,"_26947":121688,"_2866":122168},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3379":71337,"_29627":71138,"_20564":122170,"_5":14107,"_26947":121688,"_2866":122171},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se lee el campo `database` de cada entrada; la conexión usa siempre los values globales `postgres.hostname`, `postgres.port`, `postgres.username` y `postgres.password`.",{"_3379":71338,"_29627":71138,"_20564":122173,"_5":14107,"_26947":121688,"_2866":122174},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3379":71339,"_29627":71138,"_20564":122176,"_5":14107,"_26947":121688,"_2866":122177},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3379":71340,"_29627":71138,"_20564":122179,"_5":14107,"_26947":121688,"_2866":122180},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3379":71341,"_29627":71138,"_20564":122182,"_5":14107,"_26947":121688,"_2866":122183},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3379":71342,"_29627":71138,"_20564":122185,"_5":14107,"_26947":121688,"_2866":122186},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3379":71343,"_29627":71138,"_20564":122188,"_5":14107,"_26947":121688,"_2866":122189},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3379":71344,"_29627":71138,"_20564":122191,"_5":14107,"_26947":121688,"_2866":122192},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3379":71345,"_29627":71138,"_20564":122194,"_5":14107,"_26947":121688,"_2866":122195},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3379":71346,"_29627":71138,"_20564":122197,"_5":14107,"_26947":121688,"_2866":122198},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida.",{"_3379":71347,"_29627":71138,"_20564":122200,"_5":14107,"_26947":121692,"_2866":122201},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_3379":71348,"_29627":71138,"_20564":122203,"_5":14107,"_26947":121692,"_2866":122204},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_3379":71349,"_29627":71138,"_20564":122206,"_5":14107,"_26947":121696,"_2866":122207},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3379":71350,"_29627":71138,"_20564":122209,"_5":14107,"_26947":121696,"_2866":122210},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3379":71351,"_29627":71138,"_20564":122212,"_5":14107,"_26947":121696,"_2866":122213},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3379":71352,"_29627":71138,"_20564":122215,"_5":14107,"_26947":121696,"_2866":122216},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_3379":71353,"_29627":71138,"_20564":122218,"_5":14107,"_26947":121696,"_2866":122219},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3379":71354,"_29627":71138,"_20564":122221,"_5":14107,"_26947":121696,"_2866":122222},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3379":71355,"_29627":71138,"_20564":122224,"_5":14107,"_26947":121696,"_2866":122225},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3379":71356,"_29627":71138,"_20564":122227,"_5":14107,"_26947":121696,"_2866":122228},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3379":71357,"_29627":71138,"_20564":122230,"_5":14107,"_26947":121696,"_2866":122231},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3379":71358,"_29627":71138,"_20564":122233,"_5":14107,"_26947":121696,"_2866":122234},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3379":71359,"_29627":71138,"_20564":122236,"_5":14107,"_26947":121696,"_2866":122237},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_3379":71360,"_29627":71138,"_20564":122239,"_5":14107,"_26947":121700,"_2866":122240},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3379":71361,"_29627":71138,"_20564":122242,"_5":14107,"_26947":121700,"_2866":122243},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3379":71362,"_29627":71138,"_20564":122245,"_5":14107,"_26947":121704,"_2866":122246},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3379":71363,"_29627":71138,"_20564":122248,"_5":14107,"_26947":121704,"_2866":122249},[],"Ejecuta las migraciones en el orden obligatorio, un esquema cada vez: primero `kms`, después la herramienta `ca-to-kms-migration` (necesaria solo en despliegues heredados cuyas claves de CA se nombran por SKI), luego `ca` y por último `va`. Los esquemas `devicemanager`, `dmsmanager` y `alerts` son independientes y pueden migrarse en cualquier orden. Con Helm, el job de preinstalación del chart aplica los esquemas en el orden correcto automáticamente.",{"_3379":71364,"_29627":71138,"_20564":122251,"_5":14107,"_26947":121704,"_2866":122252},[],"Los esquemas se referencian entre sí, así que el rol de PostgreSQL que ejecuta las migraciones necesita privilegios entre esquemas: el esquema `ca` necesita `USAGE` sobre `kms` más `SELECT`, `REFERENCES` e `INSERT` sobre `kms.kms_keys`, y el esquema `va` necesita `USAGE` sobre `ca` más `SELECT` y `REFERENCES` sobre `ca.certificates` y `SELECT` sobre `ca.ca_certificates`. Si tus servicios se conectan con un usuario distinto del que ejecutó las migraciones, concédele tras las migraciones `SELECT` sobre `ca.certificates_view`.",{"_3379":71365,"_29627":71138,"_20564":122254,"_5":14107,"_26947":121704,"_2866":122255},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3379":71366,"_29627":71138,"_20564":122257,"_5":14107,"_26947":121704,"_2866":122258},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3379":71367,"_29627":71138,"_20564":122260,"_5":14107,"_26947":121704,"_2866":122261},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_3379":71368,"_29627":71138,"_20564":122263,"_5":14107,"_26947":121704,"_2866":122264},[],"Los README de ambas herramientas documentan el formato de 4.0.0 con la base `pki` y coinciden con esta página: `goose-lamassu` usa ejemplos con `dbname=pki` y no valida el nombre de la base de datos, y el README de `ca-to-kms-migration` describe la base única `pki` y el orden de migración.",{"_3379":71369,"_29627":71138,"_20564":122266,"_5":14107,"_26947":121708,"_2866":122267},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3379":71370,"_29627":71138,"_20564":122269,"_5":14107,"_26947":121708,"_2866":122270},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_3379":71371,"_29627":71138,"_20564":122272,"_5":14107,"_26947":121708,"_2866":122273},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_3379":71372,"_29627":71138,"_20564":122275,"_5":14107,"_26947":121708,"_2866":122276},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3379":71373,"_29627":71138,"_20564":122278,"_5":14107,"_26947":121708,"_2866":122279},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó por IDs de CA duplicados o por valores de `engine_id` vacíos. Revisa los logs del job, corrige los permisos o los datos y vuelve a ejecutar la actualización.",{"_3379":71374,"_29627":71138,"_20564":122281,"_5":14107,"_26947":121708,"_2866":122282},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3379":71375,"_29627":71138,"_20564":122284,"_5":14107,"_26947":121708,"_2866":122285},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3379":71376,"_29627":71138,"_20564":122287,"_5":14107,"_26947":121708,"_2866":122288},[],"**Una migración aborta con `kms schema not found`.** Los esquemas deben migrarse en orden: ejecuta la migración del esquema `kms` antes que la del esquema `ca`.",{"_3379":71377,"_29627":71138,"_20564":122290,"_5":14107,"_26947":121708,"_2866":122291},[],"**Una migración aborta con `ca schema not found`.** Ejecuta la migración del esquema `ca` antes que la del esquema `va`.",{"_3379":71378,"_29627":71138,"_20564":122293,"_5":14107,"_26947":121708,"_2866":122294},[],"**La migración de VA falla con `cannot resolve signer certificate for VA role ... N candidates`.** La migración no puede identificar un certificado firmante de forma única a partir del SKI guardado en el rol. Revisa el SKI y los certificados candidatos indicados en el error; corrige los datos anteriores a la migración con una copia de seguridad verificada y vuelve a ejecutar la migración. El nuevo campo `signer_certificate_serial_number` se crea durante esa migración, por lo que no se puede configurar mediante la API de VA mientras esta falla.",{"_3379":71379,"_29627":71138,"_20564":122296,"_5":14107,"_26947":121708,"_2866":122297},[],"**Una migración o un servicio falla con `permission denied for table ...`.** Al rol de PostgreSQL le faltan los privilegios entre esquemas listados en Despliegues sin Helm; incluye `certificates_view` cuando se omitió el `GRANT SELECT` posterior a la migración. Concede los privilegios que falten y vuelve a ejecutar.",{"_3379":71380,"_29627":71138,"_20564":122299,"_5":14107,"_26947":121711,"_2866":122300},[],"Tras la actualización, comprueba en este orden:",{"_3379":71381,"_29627":71138,"_20564":122302,"_5":14107,"_26947":121711,"_2866":122303},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS, y las migraciones de claves foráneas que se ejecutan por esquema en el orden obligatorio.",{"_3379":71382,"_29627":71138,"_20564":122305,"_5":14107,"_26947":121711,"_2866":122306},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3379":71383,"_29627":71138,"_20564":122308,"_5":14107,"_26947":121711,"_2866":122309},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3379":71384,"_29627":71138,"_20564":122311,"_5":14107,"_26947":121711,"_2866":122312},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-ski>` sobre la VA devuelve una CRL emitida anteriormente, y se emiten CRLs nuevas.",{"_3379":71385,"_29627":71138,"_20564":122314,"_5":14107,"_26947":121711,"_2866":122315},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS.",{"_3379":71386,"_29627":71138,"_20564":122317,"_5":14107,"_26947":121711,"_2866":122318},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3379":71387,"_29627":71138,"_20564":122320,"_5":14107,"_26947":121711,"_2866":122321},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3379":71388,"_29627":71138,"_20564":122323,"_5":14107,"_26947":121711,"_2866":122324},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha.",{"_3379":71389,"_29627":71138,"_20564":122326,"_5":14107,"_26947":121711,"_2866":122327},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3379":71390,"_29627":71138,"_20564":122329,"_5":14107,"_26947":121711,"_2866":122330},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3379":71391,"_29627":71138,"_20564":122332,"_5":14107,"_26947":121711,"_2866":122333},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3379":71392,"_29627":71138,"_20564":122335,"_5":14107,"_26947":121711,"_2866":122336},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3379":71393,"_29627":71138,"_20564":122338,"_5":14107,"_26947":121711,"_2866":122339},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3379":71394,"_29627":71138,"_20564":122341,"_5":14107,"_26947":121711,"_2866":122342},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3379":71395,"_29627":71138,"_20564":122344,"_5":14107,"_26947":121715,"_2866":122345},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_3379":71396,"_29627":71138,"_20564":122347,"_5":14107,"_26947":121715,"_2866":122348},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3379":71397,"_29627":71138,"_20564":122350,"_5":14107,"_26947":121715,"_2866":122351},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3379":71398,"_29627":71138,"_20564":122353,"_5":14107,"_26947":121715,"_2866":122354},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_3379":71399,"_29627":71138,"_20564":122356,"_5":14107,"_26947":121715,"_2866":122357},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_57138":122359,"_57140":122360,"_57142":122361,"_57144":122362,"_17804":2901,"_68547":2901},"spanish",[2866,29627,5,26947],{"_2866":24568,"_29627":24568,"_5":24568,"_26947":24568},{"_2866":122363,"_29627":125212,"_5":128061,"_26947":130910},{"_4543":122364,"_57148":122365,"_5":24568},{"_14183":12929,"_14564":4446,"_14583":5832,"_28636":3293,"_14570":3963,"_19518":3334,"_14204":7200,"_14211":3986,"_28578":10225,"_28987":6821,"_29008":6843,"_28612":6881,"_33935":6156,"_28715":19976,"_29052":9672,"_33942":29155,"_33945":3902,"_33948":49