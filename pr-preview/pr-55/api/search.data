81":53670,"_37383":53673,"_37385":53676,"_37387":53679,"_37389":53682,"_37391":53685,"_37393":53688,"_37395":53691,"_37397":53694,"_37399":53697,"_37401":53700,"_37403":53703,"_37405":53706,"_37408":53709,"_37410":53712,"_37412":53715,"_37414":53718,"_37416":53721,"_37418":53724,"_37420":53727,"_37422":53730,"_37424":53733,"_37426":53736,"_37428":53739,"_37430":53742,"_37432":53745,"_37434":53748,"_37436":53751,"_37438":53754,"_37440":53757,"_37442":53760,"_37444":53763,"_37446":53766,"_37448":53769,"_37451":53772,"_37453":53775,"_37455":53778,"_37457":53781},{"_3172":15,"_28058":15,"_5":13662,"_2667":45475,"_28401":45476,"_19443":45480,"_25550":15},"Deploy from AWS Marketplace",[45477,45478,45479],"Docs","Deployment","Other models",[],{"_3172":16,"_28058":15,"_19443":45482,"_5":13331,"_25550":15,"_2667":45483},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_3172":17,"_28058":15,"_5":28398,"_19443":45485,"_25550":45486,"_2667":45487},[],"/docs/pr-preview/pr-55/deployment/aws-marketplace#before-you-begin","Before you begin",{"_3172":18,"_28058":15,"_5":28398,"_19443":45489,"_25550":45490,"_2667":45491},[],"/docs/pr-preview/pr-55/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_3172":19,"_28058":15,"_5":28398,"_19443":45493,"_25550":45494,"_2667":45495},[],"/docs/pr-preview/pr-55/deployment/aws-marketplace#open-the-offer","Open the offer",{"_3172":20,"_28058":15,"_5":28398,"_19443":45497,"_25550":45498,"_2667":45499},[],"/docs/pr-preview/pr-55/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_3172":21,"_28058":15,"_5":28398,"_19443":45501,"_25550":45502,"_2667":45503},[],"/docs/pr-preview/pr-55/deployment/aws-marketplace#limit-network-access","Limit network access",{"_3172":22,"_28058":15,"_5":28398,"_19443":45505,"_25550":45506,"_2667":45507},[],"/docs/pr-preview/pr-55/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_3172":23,"_28058":15,"_5":28398,"_19443":45509,"_25550":45510,"_2667":45511},[],"/docs/pr-preview/pr-55/deployment/aws-marketplace#next-step","Next step",{"_3172":24,"_28058":15,"_19443":45513,"_5":13331,"_25550":15,"_2667":45514},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_3172":25,"_28058":15,"_19443":45516,"_5":13331,"_25550":45486,"_2667":45517},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_3172":26,"_28058":15,"_19443":45519,"_5":13331,"_25550":45486,"_2667":45520},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_3172":27,"_28058":15,"_19443":45522,"_5":13331,"_25550":45486,"_2667":45523},[],"A security group allowing the necessary endpoints.",{"_3172":28,"_28058":15,"_19443":45525,"_5":13331,"_25550":45490,"_2667":45526},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_3172":29,"_28058":15,"_19443":45528,"_5":13331,"_25550":45490,"_2667":45529},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_3172":30,"_28058":15,"_19443":45531,"_5":13331,"_25550":45490,"_2667":45532},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_3172":31,"_28058":15,"_19443":45534,"_5":13331,"_25550":45494,"_2667":45535},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_3172":32,"_28058":15,"_19443":45537,"_5":13331,"_25550":45498,"_2667":45538},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_3172":33,"_28058":15,"_19443":45540,"_5":13331,"_25550":45502,"_2667":45541},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_3172":34,"_28058":15,"_19443":45543,"_5":13331,"_25550":45506,"_2667":45544},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_3172":35,"_28058":15,"_19443":45546,"_5":13331,"_25550":45510,"_2667":45547},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_3172":36,"_28058":36,"_5":13662,"_2667":45549,"_28401":45550,"_19443":45551,"_25550":36},"Deploy Lamassu",[45477,45478],[],{"_3172":37,"_28058":36,"_19443":45553,"_5":13331,"_25550":36,"_2667":45554},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_3172":38,"_28058":36,"_5":28398,"_19443":45556,"_25550":45557,"_2667":45558},[],"/docs/pr-preview/pr-55/deployment/overview#choose-a-model","Choose a model",{"_3172":39,"_28058":36,"_5":28398,"_19443":45560,"_25550":45561,"_2667":45562},[],"/docs/pr-preview/pr-55/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_3172":40,"_28058":36,"_5":28398,"_19443":45564,"_25550":45565,"_2667":45566},[],"/docs/pr-preview/pr-55/deployment/overview#after-deployment","After deployment",{"_3172":41,"_28058":36,"_19443":45568,"_5":13331,"_25550":36,"_2667":45569},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_3172":42,"_28058":36,"_19443":45571,"_5":13331,"_25550":45557,"_2667":45572},[],"Model",{"_3172":43,"_28058":36,"_19443":45574,"_5":13331,"_25550":45557,"_2667":45575},[],"Recommended for",{"_3172":44,"_28058":36,"_19443":45577,"_5":13331,"_25550":45557,"_2667":45578},[],"Who operates the infrastructure",{"_3172":45,"_28058":36,"_19443":45580,"_5":13331,"_25550":45557,"_2667":45581},[],"Starting point",{"_3172":46,"_28058":36,"_19443":45583,"_5":13331,"_25550":45557,"_2667":45584},[],"Kubernetes self-managed",{"_3172":47,"_28058":36,"_19443":45586,"_5":13331,"_25550":45557,"_2667":45587},[],"Production, regulated environments and custom deployments",{"_3172":48,"_28058":36,"_19443":45589,"_5":13331,"_25550":45557,"_2667":45590},[],"Your team",{"_3172":49,"_28058":36,"_19443":45592,"_5":13331,"_25550":45557,"_2667":45593},[],"Helm or Fastlane",{"_3172":50,"_28058":36,"_19443":45595,"_5":13331,"_25550":45557,"_2667":45596},[],"AWS Marketplace",{"_3172":51,"_28058":36,"_19443":45598,"_5":13331,"_25550":45557,"_2667":45599},[],"Evaluation or a dedicated deployment inside an AWS account",{"_3172":52,"_28058":36,"_19443":45601,"_5":13331,"_25550":45557,"_2667":45590},[],{"_3172":53,"_28058":36,"_19443":45603,"_5":13331,"_25550":45557,"_2667":45604},[],"Preconfigured image on EC2",{"_3172":54,"_28058":36,"_19443":45606,"_5":13331,"_25550":45557,"_2667":45607},[],"SaaS",{"_3172":55,"_28058":36,"_19443":45609,"_5":13331,"_25550":45557,"_2667":45610},[],"Teams that want to use the platform without operating it",{"_3172":56,"_28058":36,"_19443":45612,"_5":13331,"_25550":45557,"_2667":45613},[],"Lamassu",{"_3172":57,"_28058":36,"_19443":45615,"_5":13331,"_25550":45557,"_2667":45616},[],"Managed subscription",{"_3172":58,"_28058":36,"_19443":45618,"_5":13331,"_25550":45557,"_2667":45619},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3172":59,"_28058":36,"_19443":45621,"_5":13331,"_25550":45557,"_2667":45622},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3172":60,"_28058":36,"_19443":45624,"_5":13331,"_25550":45557,"_2667":45625},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_3172":61,"_28058":36,"_19443":45627,"_5":13331,"_25550":45561,"_2667":45628},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_3172":62,"_28058":36,"_19443":45630,"_5":13331,"_25550":45565,"_2667":45631},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_3172":63,"_28058":63,"_5":13662,"_2667":45633,"_28401":45634,"_19443":45635,"_25550":63},"Use Lamassu as SaaS",[45477,45478,45479],[],{"_3172":64,"_28058":63,"_19443":45637,"_5":13331,"_25550":63,"_2667":45638},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_3172":65,"_28058":63,"_5":28398,"_19443":45640,"_25550":45641,"_2667":45642},[],"/docs/pr-preview/pr-55/deployment/saas#what-the-service-manages","What the service manages",{"_3172":66,"_28058":63,"_5":28398,"_19443":45644,"_25550":45645,"_2667":45646},[],"/docs/pr-preview/pr-55/deployment/saas#plans","Plans",{"_3172":67,"_28058":63,"_5":28398,"_19443":45648,"_25550":45649,"_2667":45650},[],"/docs/pr-preview/pr-55/deployment/saas#request-access","Request access",{"_3172":68,"_28058":63,"_19443":45652,"_5":13331,"_25550":63,"_2667":45653},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_3172":69,"_28058":63,"_19443":45655,"_5":13331,"_25550":45641,"_2667":45656},[],"Platform availability and maintenance.",{"_3172":70,"_28058":63,"_19443":45658,"_5":13331,"_25550":45641,"_2667":45659},[],"Automatic backups.",{"_3172":71,"_28058":63,"_19443":45661,"_5":13331,"_25550":45641,"_2667":45662},[],"Version upgrades.",{"_3172":72,"_28058":63,"_19443":45664,"_5":13331,"_25550":45641,"_2667":45665},[],"Technical support and SLA according to your plan.",{"_3172":73,"_28058":63,"_19443":45667,"_5":13331,"_25550":45645,"_2667":45668},[],"Plan",{"_3172":74,"_28058":63,"_19443":45670,"_5":13331,"_25550":45645,"_2667":45671},[],"Devices",{"_3172":75,"_28058":63,"_19443":45673,"_5":13331,"_25550":45645,"_2667":45674},[],"Support",{"_3172":76,"_28058":63,"_19443":45676,"_5":13331,"_25550":45645,"_2667":45677},[],"SLA",{"_3172":77,"_28058":63,"_19443":45679,"_5":13331,"_25550":45645,"_2667":45680},[],"Starter",{"_3172":78,"_28058":63,"_19443":45682,"_5":13331,"_25550":45645,"_2667":45683},[],"Up to 1,000",{"_3172":79,"_28058":63,"_19443":45685,"_5":13331,"_25550":45645,"_2667":45686},[],"Email",{"_3172":80,"_28058":63,"_19443":45688,"_5":13331,"_25550":45645,"_2667":45689},[],"99.5 %",{"_3172":81,"_28058":63,"_19443":45691,"_5":13331,"_25550":45645,"_2667":45692},[],"Professional",{"_3172":82,"_28058":63,"_19443":45694,"_5":13331,"_25550":45645,"_2667":45695},[],"Up to 10,000",{"_3172":83,"_28058":63,"_19443":45697,"_5":13331,"_25550":45645,"_2667":45698},[],"Email and chat",{"_3172":84,"_28058":63,"_19443":45700,"_5":13331,"_25550":45645,"_2667":45701},[],"99.9 %",{"_3172":85,"_28058":63,"_19443":45703,"_5":13331,"_25550":45645,"_2667":45704},[],"Enterprise",{"_3172":86,"_28058":63,"_19443":45706,"_5":13331,"_25550":45645,"_2667":45707},[],"Unlimited",{"_3172":87,"_28058":63,"_19443":45709,"_5":13331,"_25550":45645,"_2667":45710},[],"Dedicated",{"_3172":88,"_28058":63,"_19443":45712,"_5":13331,"_25550":45645,"_2667":45713},[],"99.99 %",{"_3172":89,"_28058":63,"_19443":45715,"_5":13331,"_25550":45649,"_2667":45716},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_3172":90,"_28058":63,"_19443":45718,"_5":13331,"_25550":45649,"_2667":45719},[],"When you receive your instance's credentials, continue with Get started.",{"_3172":91,"_28058":91,"_5":13662,"_2667":45721,"_28401":45722,"_19443":45723,"_25550":91},"Fastlane",[45477,45478,45584],[],{"_3172":92,"_28058":91,"_19443":45725,"_5":13331,"_25550":91,"_2667":45726},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_3172":93,"_28058":91,"_5":28398,"_19443":45728,"_25550":45729,"_2667":45730},[],"/docs/pr-preview/pr-55/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_3172":94,"_28058":91,"_5":28398,"_19443":45732,"_25550":45733,"_2667":45734},[],"/docs/pr-preview/pr-55/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_3172":95,"_28058":91,"_5":28398,"_19443":45736,"_25550":45737,"_2667":45487},[],"/docs/pr-preview/pr-55/deployment/self-hosted/fastlane#before-you-begin",{"_3172":96,"_28058":91,"_5":28398,"_19443":45739,"_25550":45740,"_2667":45741},[],"/docs/pr-preview/pr-55/deployment/self-hosted/fastlane#quick-start","Quick start",{"_3172":97,"_28058":91,"_5":28398,"_19443":45743,"_25550":45744,"_2667":45745},[],"/docs/pr-preview/pr-55/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_3172":98,"_28058":91,"_5":28398,"_19443":45747,"_25550":45748,"_2667":45749},[],"/docs/pr-preview/pr-55/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_3172":99,"_28058":91,"_5":28398,"_19443":45751,"_25550":45752,"_2667":45753},[],"/docs/pr-preview/pr-55/deployment/self-hosted/fastlane#development-mode","Development mode",{"_3172":100,"_28058":91,"_5":28398,"_19443":45755,"_25550":45756,"_2667":45757},[],"/docs/pr-preview/pr-55/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_3172":101,"_28058":91,"_5":28398,"_19443":45759,"_25550":45760,"_2667":45761},[],"/docs/pr-preview/pr-55/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_3172":102,"_28058":91,"_5":28398,"_19443":45763,"_25550":45764,"_2667":45765},[],"/docs/pr-preview/pr-55/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_3172":103,"_28058":91,"_5":28398,"_19443":45767,"_25550":45768,"_2667":45769},[],"/docs/pr-preview/pr-55/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_3172":104,"_28058":91,"_19443":45771,"_5":13331,"_25550":45729,"_2667":45772},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_3172":105,"_28058":91,"_19443":45774,"_5":13331,"_25550":45729,"_2667":45775},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_3172":106,"_28058":91,"_19443":45777,"_5":13331,"_25550":45733,"_2667":45778},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_3172":107,"_28058":91,"_19443":45780,"_5":13331,"_25550":45733,"_2667":45781},[],"Fastlane installs or configures",{"_3172":108,"_28058":91,"_19443":45783,"_5":13331,"_25550":45733,"_2667":45784},[],"You still provide",{"_3172":109,"_28058":91,"_19443":45786,"_5":13331,"_25550":45733,"_2667":45787},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_3172":110,"_28058":91,"_19443":45789,"_5":13331,"_25550":45733,"_2667":45790},[],"The Kubernetes cluster, nodes and persistent storage",{"_3172":111,"_28058":91,"_19443":45792,"_5":13331,"_25550":45733,"_2667":45793},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_3172":112,"_28058":91,"_19443":45795,"_5":13331,"_25550":45733,"_2667":45796},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_3172":113,"_28058":91,"_19443":45798,"_5":13331,"_25550":45733,"_2667":45799},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_3172":114,"_28058":91,"_19443":45801,"_5":13331,"_25550":45733,"_2667":45802},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_3172":115,"_28058":91,"_19443":45804,"_5":13331,"_25550":45733,"_2667":45805},[],"Optional observability and lab HSM components",{"_3172":116,"_28058":91,"_19443":45807,"_5":13331,"_25550":45733,"_2667":45808},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_3172":117,"_28058":91,"_19443":45810,"_5":13331,"_25550":45733,"_2667":45811},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_3172":118,"_28058":91,"_19443":45813,"_5":13331,"_25550":45737,"_2667":45814},[],"You need:",{"_3172":119,"_28058":91,"_19443":45816,"_5":13331,"_25550":45737,"_2667":45817},[],"an existing Kubernetes cluster",{"_3172":120,"_28058":91,"_19443":45819,"_5":13331,"_25550":45737,"_2667":45820},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_3172":121,"_28058":91,"_19443":45822,"_5":13331,"_25550":45737,"_2667":45823},[],"`yq`",{"_3172":122,"_28058":91,"_19443":45825,"_5":13331,"_25550":45737,"_2667":22029},[],{"_3172":123,"_28058":91,"_19443":45827,"_5":13331,"_25550":45737,"_2667":45828},[],"`jq` only when using `--sample-data` or `--development`",{"_3172":124,"_28058":91,"_19443":45830,"_5":13331,"_25550":45737,"_2667":45831},[],"`ssh-keygen` only when using `--with-hsm`",{"_3172":125,"_28058":91,"_19443":45833,"_5":13331,"_25550":45737,"_2667":45834},[],"free external ports 80 and 443 on a single-node K3s host",{"_3172":126,"_28058":91,"_19443":45836,"_5":13331,"_25550":45737,"_2667":45837},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_3172":127,"_28058":91,"_19443":45839,"_5":13331,"_25550":45737,"_2667":45840},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_3172":128,"_28058":91,"_19443":45842,"_5":13331,"_25550":45740,"_2667":45843},[],"Run the script from a clone of the Helm repository:",{"_3172":129,"_28058":91,"_19443":45845,"_5":13331,"_25550":45740,"_2667":45846},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_3172":130,"_28058":91,"_19443":45848,"_5":13331,"_25550":45744,"_2667":45849},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_3172":131,"_28058":91,"_19443":45851,"_5":13331,"_25550":45744,"_2667":45852},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_3172":132,"_28058":91,"_19443":45854,"_5":13331,"_25550":45744,"_2667":45855},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_3172":133,"_28058":91,"_19443":45857,"_5":13331,"_25550":45744,"_2667":45858},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_3172":134,"_28058":91,"_19443":45860,"_5":13331,"_25550":45748,"_2667":45861},[],"Option",{"_3172":135,"_28058":91,"_19443":45863,"_5":13331,"_25550":45748,"_2667":45864},[],"Default",{"_3172":136,"_28058":91,"_19443":45866,"_5":13331,"_25550":45748,"_2667":45867},[],"Purpose",{"_3172":137,"_28058":91,"_19443":45869,"_5":13331,"_25550":45748,"_2667":45870},[],"`-h`, `--help`",{"_3172":138,"_28058":91,"_19443":45872,"_5":13331,"_25550":45748,"_2667":45873},[],"—",{"_3172":139,"_28058":91,"_19443":45875,"_5":13331,"_25550":45748,"_2667":45876},[],"Show help",{"_3172":140,"_28058":91,"_19443":45878,"_5":13331,"_25550":45748,"_2667":45879},[],"`-c`, `--context`",{"_3172":141,"_28058":91,"_19443":45881,"_5":13331,"_25550":45748,"_2667":45882},[],"current context",{"_3172":142,"_28058":91,"_19443":45884,"_5":13331,"_25550":45748,"_2667":45885},[],"Select the kubeconfig context for kubectl and Helm",{"_3172":143,"_28058":91,"_19443":45887,"_5":13331,"_25550":45748,"_2667":45888},[],"`-n`, `--non-interactive`",{"_3172":144,"_28058":91,"_19443":45890,"_5":13331,"_25550":45748,"_2667":5970},[],{"_3172":145,"_28058":91,"_19443":45892,"_5":13331,"_25550":45748,"_2667":45893},[],"Skip prompts and generate dependency credentials",{"_3172":146,"_28058":91,"_19443":45895,"_5":13331,"_25550":45748,"_2667":45896},[],"`-ns`, `--namespace`",{"_3172":147,"_28058":91,"_19443":45898,"_5":13331,"_25550":45748,"_2667":45899},[],"`lamassu-dev`",{"_3172":148,"_28058":91,"_19443":45901,"_5":13331,"_25550":45748,"_2667":45902},[],"Namespace for the installation",{"_3172":149,"_28058":91,"_19443":45904,"_5":13331,"_25550":45748,"_2667":45905},[],"`-d`, `--domain`",{"_3172":150,"_28058":91,"_19443":45907,"_5":13331,"_25550":45748,"_2667":45908},[],"`dev.lamassu.io`",{"_3172":151,"_28058":91,"_19443":45910,"_5":13331,"_25550":45748,"_2667":45911},[],"Domain used by the UI, OIDC and certificate",{"_3172":152,"_28058":91,"_19443":45913,"_5":13331,"_25550":45748,"_2667":45914},[],"`-v`, `--version`",{"_3172":153,"_28058":91,"_19443":45916,"_5":13331,"_25550":45748,"_2667":13956},[],{"_3172":154,"_28058":91,"_19443":45918,"_5":13331,"_25550":45748,"_2667":45919},[],"Lamassu chart version",{"_3172":155,"_28058":91,"_19443":45921,"_5":13331,"_25550":45748,"_2667":45922},[],"`--https-port`",{"_3172":156,"_28058":91,"_19443":45924,"_5":13331,"_25550":45748,"_2667":45925},[],"`443`",{"_3172":157,"_28058":91,"_19443":45927,"_5":13331,"_25550":45748,"_2667":45928},[],"Gateway HTTPS listener port",{"_3172":158,"_28058":91,"_19443":45930,"_5":13331,"_25550":45748,"_2667":45931},[],"`--http-port`",{"_3172":159,"_28058":91,"_19443":45933,"_5":13331,"_25550":45748,"_2667":45934},[],"`80`",{"_3172":160,"_28058":91,"_19443":45936,"_5":13331,"_25550":45748,"_2667":45937},[],"Gateway HTTP listener port",{"_3172":161,"_28058":91,"_19443":45939,"_5":13331,"_25550":45748,"_2667":45940},[],"`--tls-crt`",{"_3172":162,"_28058":91,"_19443":45942,"_5":13331,"_25550":45748,"_2667":45873},[],{"_3172":163,"_28058":91,"_19443":45944,"_5":13331,"_25550":45748,"_2667":45945},[],"PEM certificate for downstream TLS",{"_3172":164,"_28058":91,"_19443":45947,"_5":13331,"_25550":45748,"_2667":45948},[],"`--tls-key`",{"_3172":165,"_28058":91,"_19443":45950,"_5":13331,"_25550":45748,"_2667":45873},[],{"_3172":166,"_28058":91,"_19443":45952,"_5":13331,"_25550":45748,"_2667":45953},[],"PEM private key for downstream TLS",{"_3172":167,"_28058":91,"_19443":45955,"_5":13331,"_25550":45748,"_2667":45956},[],"`-l`, `--local-chart-path`",{"_3172":168,"_28058":91,"_19443":45958,"_5":13331,"_25550":45748,"_2667":45959},[],"repository chart",{"_3172":169,"_28058":91,"_19443":45961,"_5":13331,"_25550":45748,"_2667":45962},[],"Use an unpacked local Lamassu chart",{"_3172":170,"_28058":91,"_19443":45964,"_5":13331,"_25550":45748,"_2667":45965},[],"`-ip`, `--gateway-ip`",{"_3172":171,"_28058":91,"_19443":45967,"_5":13331,"_25550":45748,"_2667":8028},[],{"_3172":172,"_28058":91,"_19443":45969,"_5":13331,"_25550":45748,"_2667":45970},[],"Override the address written to `gateway.addresses`",{"_3172":173,"_28058":91,"_19443":45972,"_5":13331,"_25550":45748,"_2667":45973},[],"`--otel`",{"_3172":174,"_28058":91,"_19443":45975,"_5":13331,"_25550":45748,"_2667":5970},[],{"_3172":175,"_28058":91,"_19443":45977,"_5":13331,"_25550":45748,"_2667":45978},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_3172":176,"_28058":91,"_19443":45980,"_5":13331,"_25550":45748,"_2667":45981},[],"`--development`",{"_3172":177,"_28058":91,"_19443":45983,"_5":13331,"_25550":45748,"_2667":5970},[],{"_3172":178,"_28058":91,"_19443":45985,"_5":13331,"_25550":45748,"_2667":45986},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_3172":179,"_28058":91,"_19443":45988,"_5":13331,"_25550":45748,"_2667":45989},[],"`--sample-data`",{"_3172":180,"_28058":91,"_19443":45991,"_5":13331,"_25550":45748,"_2667":5970},[],{"_3172":181,"_28058":91,"_19443":45993,"_5":13331,"_25550":45748,"_2667":45994},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_3172":182,"_28058":91,"_19443":45996,"_5":13331,"_25550":45748,"_2667":45997},[],"`--with-hsm`",{"_3172":183,"_28058":91,"_19443":45999,"_5":13331,"_25550":45748,"_2667":5970},[],{"_3172":184,"_28058":91,"_19443":46001,"_5":13331,"_25550":45748,"_2667":46002},[],"Install lab HSM components and configure KMS for PKCS#11",{"_3172":185,"_28058":91,"_19443":46004,"_5":13331,"_25550":45748,"_2667":46005},[],"`--softhsm-chart-path`",{"_3172":186,"_28058":91,"_19443":46007,"_5":13331,"_25550":45748,"_2667":46008},[],"`./charts/softhsm`",{"_3172":187,"_28058":91,"_19443":46010,"_5":13331,"_25550":45748,"_2667":46011},[],"Use a different local SoftHSM chart",{"_3172":188,"_28058":91,"_19443":46013,"_5":13331,"_25550":45748,"_2667":46014},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_3172":189,"_28058":91,"_19443":46016,"_5":13331,"_25550":45752,"_2667":46017},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_3172":190,"_28058":91,"_19443":46019,"_5":13331,"_25550":45752,"_2667":46020},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_3172":191,"_28058":91,"_19443":46022,"_5":13331,"_25550":45752,"_2667":46023},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_3172":192,"_28058":91,"_19443":46025,"_5":13331,"_25550":45752,"_2667":46026},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_3172":193,"_28058":91,"_19443":46028,"_5":13331,"_25550":45752,"_2667":46029},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_3172":194,"_28058":91,"_19443":46031,"_5":13331,"_25550":45752,"_2667":46032},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_3172":195,"_28058":91,"_19443":46034,"_5":13331,"_25550":45756,"_2667":46035},[],"Fastlane:",{"_3172":196,"_28058":91,"_19443":46037,"_5":13331,"_25550":45756,"_2667":46038},[],"validates local tools and the selected cluster",{"_3172":197,"_28058":91,"_19443":46040,"_5":13331,"_25550":45756,"_2667":46041},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_3172":198,"_28058":91,"_19443":46043,"_5":13331,"_25550":45756,"_2667":46044},[],"creates the namespace",{"_3172":199,"_28058":91,"_19443":46046,"_5":13331,"_25550":45756,"_2667":46047},[],"installs PostgreSQL and creates the required databases",{"_3172":200,"_28058":91,"_19443":46049,"_5":13331,"_25550":45756,"_2667":46050},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_3172":201,"_28058":91,"_19443":46052,"_5":13331,"_25550":45756,"_2667":46053},[],"installs RabbitMQ",{"_3172":202,"_28058":91,"_19443":46055,"_5":13331,"_25550":45756,"_2667":46056},[],"optionally installs observability and lab HSM components",{"_3172":203,"_28058":91,"_19443":46058,"_5":13331,"_25550":45756,"_2667":46059},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_3172":204,"_28058":91,"_19443":46061,"_5":13331,"_25550":45756,"_2667":46062},[],"optionally loads sample data",{"_3172":205,"_28058":91,"_19443":46064,"_5":13331,"_25550":45756,"_2667":46065},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_3172":206,"_28058":91,"_19443":46067,"_5":13331,"_25550":45760,"_2667":46068},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_3172":207,"_28058":91,"_19443":46070,"_5":13331,"_25550":45760,"_2667":46071},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_3172":208,"_28058":91,"_19443":46073,"_5":13331,"_25550":45764,"_2667":46074},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_3172":209,"_28058":91,"_19443":46076,"_5":13331,"_25550":45764,"_2667":46077},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_3172":210,"_28058":91,"_19443":46079,"_5":13331,"_25550":45764,"_2667":46080},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_3172":211,"_28058":91,"_19443":46082,"_5":13331,"_25550":45768,"_2667":46083},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_3172":212,"_28058":212,"_5":13662,"_2667":46085,"_28401":46086,"_19443":46087,"_25550":212},"Install with Helm",[45477,45478,45584],[],{"_3172":213,"_28058":212,"_19443":46089,"_5":13331,"_25550":212,"_2667":46090},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_3172":214,"_28058":212,"_5":28398,"_19443":46092,"_25550":46093,"_2667":46094},[],"/docs/pr-preview/pr-55/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_3172":215,"_28058":212,"_5":28398,"_19443":46096,"_25550":46097,"_2667":45487},[],"/docs/pr-preview/pr-55/deployment/self-hosted/helm#before-you-begin",{"_3172":216,"_28058":212,"_5":28398,"_19443":46099,"_25550":46100,"_2667":46101},[],"/docs/pr-preview/pr-55/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_3172":217,"_28058":212,"_5":28398,"_19443":46103,"_25550":46104,"_2667":46105},[],"/docs/pr-preview/pr-55/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_3172":218,"_28058":212,"_5":28398,"_19443":46107,"_25550":46108,"_2667":46109},[],"/docs/pr-preview/pr-55/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_3172":219,"_28058":212,"_5":28398,"_19443":46111,"_25550":46112,"_2667":46113},[],"/docs/pr-preview/pr-55/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_3172":220,"_28058":212,"_5":28398,"_19443":46115,"_25550":46116,"_2667":46117},[],"/docs/pr-preview/pr-55/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_3172":221,"_28058":212,"_5":28398,"_19443":46119,"_25550":46120,"_2667":46121},[],"/docs/pr-preview/pr-55/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_3172":222,"_28058":212,"_5":28398,"_19443":46123,"_25550":46124,"_2667":46125},[],"/docs/pr-preview/pr-55/deployment/self-hosted/helm#production-decisions","Production decisions",{"_3172":223,"_28058":212,"_19443":46127,"_5":13331,"_25550":46093,"_2667":46128},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_3172":224,"_28058":212,"_19443":46130,"_5":13331,"_25550":46097,"_2667":46131},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_3172":225,"_28058":212,"_19443":46133,"_5":13331,"_25550":46097,"_2667":46134},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_3172":226,"_28058":212,"_19443":46136,"_5":13331,"_25550":46097,"_2667":46137},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_3172":227,"_28058":212,"_19443":46139,"_5":13331,"_25550":46097,"_2667":46140},[],"a reachable RabbitMQ broker and credentials",{"_3172":228,"_28058":212,"_19443":46142,"_5":13331,"_25550":46097,"_2667":46143},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_3172":229,"_28058":212,"_19443":46145,"_5":13331,"_25550":46097,"_2667":46146},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_3172":230,"_28058":212,"_19443":46148,"_5":13331,"_25550":46097,"_2667":46149},[],"cert-manager 1.14+ (only for the default `tls.type: certManager` mode); for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_3172":231,"_28058":212,"_19443":46151,"_5":13331,"_25550":46097,"_2667":46152},[],"a StorageClass and an external traffic design",{"_3172":232,"_28058":212,"_19443":46154,"_5":13331,"_25550":46097,"_2667":46155},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_3172":233,"_28058":212,"_19443":46157,"_5":13331,"_25550":46097,"_2667":46158},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_3172":234,"_28058":212,"_19443":46160,"_5":13331,"_25550":46097,"_2667":46161},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_3172":235,"_28058":212,"_19443":46163,"_5":13331,"_25550":46100,"_2667":46164},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_3172":236,"_28058":212,"_19443":46166,"_5":13331,"_25550":46100,"_2667":46167},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_3172":237,"_28058":212,"_19443":46169,"_5":13331,"_25550":46100,"_2667":46170},[],"Install cert-manager separately before Lamassu, but only for the default `tls.type: certManager` mode. In that mode the chart renders its self-signed Issuer and CA Certificate resources regardless of whether `tls.certManagerOptions.clusterIssuer` is set, so cert-manager stays a prerequisite. With `tls.type: external`, the chart renders no cert-manager resources and the Gateway terminates TLS with an existing Secret you provide instead.",{"_3172":238,"_28058":212,"_19443":46172,"_5":13331,"_25550":46104,"_2667":46173},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_3172":239,"_28058":212,"_19443":46175,"_5":13331,"_25550":46104,"_2667":46176},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_3172":240,"_28058":212,"_19443":46178,"_5":13331,"_25550":46104,"_2667":46179},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_3172":241,"_28058":212,"_19443":46181,"_5":13331,"_25550":46108,"_2667":46182},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it. The Secret must already exist before installing: in `external` mode the chart renders no cert-manager resources and never creates this Secret.",{"_3172":242,"_28058":212,"_19443":46184,"_5":13331,"_25550":46112,"_2667":46185},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_3172":243,"_28058":212,"_19443":46187,"_5":13331,"_25550":46112,"_2667":46188},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_3172":244,"_28058":212,"_19443":46190,"_5":13331,"_25550":46112,"_2667":46191},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_3172":245,"_28058":212,"_19443":46193,"_5":13331,"_25550":46112,"_2667":46194},[],"See Access control for the principal and policy model.",{"_3172":246,"_28058":212,"_19443":46196,"_5":13331,"_25550":46116,"_2667":46197},[],"To install a local checkout instead:",{"_3172":247,"_28058":212,"_19443":46199,"_5":13331,"_25550":46120,"_2667":46200},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_3172":248,"_28058":212,"_19443":46202,"_5":13331,"_25550":46120,"_2667":46203},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_3172":249,"_28058":212,"_19443":46205,"_5":13331,"_25550":46124,"_2667":46206},[],"Before going live, review:",{"_3172":250,"_28058":212,"_19443":46208,"_5":13331,"_25550":46124,"_2667":46209},[],"backup and recovery for PostgreSQL and persistent volumes",{"_3172":251,"_28058":212,"_19443":46211,"_5":13331,"_25550":46124,"_2667":46212},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_3172":252,"_28058":212,"_19443":46214,"_5":13331,"_25550":46124,"_2667":46215},[],"shared VA storage before increasing VA replicas",{"_3172":253,"_28058":212,"_19443":46217,"_5":13331,"_25550":46124,"_2667":46218},[],"managed OIDC roles and removal of evaluation credentials",{"_3172":254,"_28058":212,"_19443":46220,"_5":13331,"_25550":46124,"_2667":46221},[],"a trusted TLS issuer or externally managed certificate",{"_3172":255,"_28058":212,"_19443":46223,"_5":13331,"_25550":46124,"_2667":46224},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_3172":256,"_28058":212,"_19443":46226,"_5":13331,"_25550":46124,"_2667":46227},[],"SMTP, observability and alert delivery",{"_3172":257,"_28058":212,"_19443":46229,"_5":13331,"_25550":46124,"_2667":46230},[],"the version upgrade guides and the notes in `charts/lamassu/CHANGELOG/` before every upgrade",{"_3172":258,"_28058":212,"_19443":46232,"_5":13331,"_25550":46124,"_2667":46233},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_3172":259,"_28058":259,"_5":13662,"_2667":46235,"_28401":46236,"_19443":46237,"_25550":259},"Expose the Gateway",[45477,45478,45584],[],{"_3172":260,"_28058":259,"_19443":46239,"_5":13331,"_25550":259,"_2667":46240},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_3172":261,"_28058":259,"_5":28398,"_19443":46242,"_25550":46243,"_2667":46244},[],"/docs/pr-preview/pr-55/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_3172":262,"_28058":259,"_5":28398,"_19443":46246,"_25550":46247,"_2667":46248},[],"/docs/pr-preview/pr-55/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_3172":263,"_28058":259,"_5":28398,"_19443":46250,"_25550":46251,"_2667":46252},[],"/docs/pr-preview/pr-55/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_3172":264,"_28058":259,"_5":28398,"_19443":46254,"_25550":46255,"_2667":46256},[],"/docs/pr-preview/pr-55/deployment/self-hosted/networking#k3s","K3s",{"_3172":265,"_28058":259,"_5":28398,"_19443":46258,"_25550":46259,"_2667":46260},[],"/docs/pr-preview/pr-55/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_3172":266,"_28058":259,"_5":28398,"_19443":46262,"_25550":46263,"_2667":46264},[],"/docs/pr-preview/pr-55/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_3172":267,"_28058":259,"_5":28398,"_19443":46266,"_25550":46267,"_2667":46268},[],"/docs/pr-preview/pr-55/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_3172":268,"_28058":259,"_5":28398,"_19443":46270,"_25550":46271,"_2667":46272},[],"/docs/pr-preview/pr-55/deployment/self-hosted/networking#decision-guide","Decision guide",{"_3172":269,"_28058":259,"_5":28398,"_19443":46274,"_25550":46275,"_2667":46276},[],"/docs/pr-preview/pr-55/deployment/self-hosted/networking#egress-proxy","Egress proxy",{"_3172":270,"_28058":259,"_5":28398,"_19443":46278,"_25550":46279,"_2667":46280},[],"/docs/pr-preview/pr-55/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_3172":271,"_28058":259,"_19443":46282,"_5":13331,"_25550":46243,"_2667":46283},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_3172":272,"_28058":259,"_19443":46285,"_5":13331,"_25550":46243,"_2667":46286},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_3172":273,"_28058":259,"_19443":46288,"_5":13331,"_25550":46247,"_2667":46289},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_3172":274,"_28058":259,"_19443":46291,"_5":13331,"_25550":46247,"_2667":46292},[],"Set it only when:",{"_3172":275,"_28058":259,"_19443":46294,"_5":13331,"_25550":46247,"_2667":46295},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_3172":276,"_28058":259,"_19443":46297,"_5":13331,"_25550":46247,"_2667":46298},[],"that address is allocated to this Gateway",{"_3172":277,"_28058":259,"_19443":46300,"_5":13331,"_25550":46247,"_2667":46301},[],"the surrounding network already routes traffic for it to the cluster",{"_3172":278,"_28058":259,"_19443":46303,"_5":13331,"_25550":46247,"_2667":46304},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_3172":279,"_28058":259,"_19443":46306,"_5":13331,"_25550":46247,"_2667":46307},[],"Keep these two settings separate:",{"_3172":280,"_28058":259,"_19443":46309,"_5":13331,"_25550":46247,"_2667":46310},[],"`gateway.addresses` requests an address for the Gateway.",{"_3172":281,"_28058":259,"_19443":46312,"_5":13331,"_25550":46247,"_2667":46313},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_3172":282,"_28058":259,"_19443":46315,"_5":13331,"_25550":46247,"_2667":46316},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_3172":283,"_28058":259,"_19443":46318,"_5":13331,"_25550":46251,"_2667":46319},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_3172":284,"_28058":259,"_19443":46321,"_5":13331,"_25550":46251,"_2667":46322},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_3172":285,"_28058":259,"_19443":46324,"_5":13331,"_25550":46255,"_2667":46325},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_3172":286,"_28058":259,"_19443":46327,"_5":13331,"_25550":46255,"_2667":46328},[],"For the recommended design:",{"_3172":287,"_28058":259,"_19443":46330,"_5":13331,"_25550":46255,"_2667":46331},[],"Use only one externally exposed Lamassu Gateway.",{"_3172":288,"_28058":259,"_19443":46333,"_5":13331,"_25550":46255,"_2667":46334},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_3172":289,"_28058":259,"_19443":46336,"_5":13331,"_25550":46255,"_2667":46337},[],"Allow those ports through the VM firewall and any upstream security group.",{"_3172":290,"_28058":259,"_19443":46339,"_5":13331,"_25550":46255,"_2667":46340},[],"Point DNS at the VM's reachable address.",{"_3172":291,"_28058":259,"_19443":46342,"_5":13331,"_25550":46255,"_2667":46343},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_3172":292,"_28058":259,"_19443":46345,"_5":13331,"_25550":46259,"_2667":46346},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_3172":293,"_28058":259,"_19443":46348,"_5":13331,"_25550":46263,"_2667":46349},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_3172":294,"_28058":259,"_19443":46351,"_5":13331,"_25550":46263,"_2667":46352},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_3172":295,"_28058":259,"_19443":46354,"_5":13331,"_25550":46267,"_2667":46355},[],"First decide whether you need three independent data planes or only three hostnames.",{"_3172":296,"_28058":259,"_19443":46357,"_5":13331,"_25550":46267,"_2667":46358},[],"Requirement",{"_3172":297,"_28058":259,"_19443":46360,"_5":13331,"_25550":46267,"_2667":46361},[],"Recommended design",{"_3172":298,"_28058":259,"_19443":46363,"_5":13331,"_25550":46267,"_2667":46364},[],"Consequence",{"_3172":299,"_28058":259,"_19443":46366,"_5":13331,"_25550":46267,"_2667":46367},[],"Several Lamassu URLs or services",{"_3172":300,"_28058":259,"_19443":46369,"_5":13331,"_25550":46267,"_2667":46370},[],"One Gateway with multiple routes",{"_3172":301,"_28058":259,"_19443":46372,"_5":13331,"_25550":46267,"_2667":46373},[],"One IP and one proxy fleet; this is the chart default",{"_3172":302,"_28058":259,"_19443":46375,"_5":13331,"_25550":46267,"_2667":46376},[],"Independent Gateways and separate external IPs",{"_3172":303,"_28058":259,"_19443":46378,"_5":13331,"_25550":46267,"_2667":46379},[],"One VIP per Gateway",{"_3172":304,"_28058":259,"_19443":46381,"_5":13331,"_25550":46267,"_2667":46382},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_3172":305,"_28058":259,"_19443":46384,"_5":13331,"_25550":46267,"_2667":46385},[],"Independent Gateways on one node and one IP",{"_3172":306,"_28058":259,"_19443":46387,"_5":13331,"_25550":46267,"_2667":46388},[],"Use different external ports",{"_3172":307,"_28058":259,"_19443":46390,"_5":13331,"_25550":46267,"_2667":46391},[],"Clients must include non-standard ports",{"_3172":308,"_28058":259,"_19443":46393,"_5":13331,"_25550":46267,"_2667":46394},[],"Separate TLS/mTLS termination behind one IP",{"_3172":309,"_28058":259,"_19443":46396,"_5":13331,"_25550":46267,"_2667":46397},[],"Front-door SNI routing to internal Gateways",{"_3172":310,"_28058":259,"_19443":46399,"_5":13331,"_25550":46267,"_2667":46400},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_3172":311,"_28058":259,"_19443":46402,"_5":13331,"_25550":46267,"_2667":46403},[],"Separate Gateway resources but shared proxy infrastructure",{"_3172":312,"_28058":259,"_19443":46405,"_5":13331,"_25550":46267,"_2667":46406},[],"Envoy merged-Gateway mode",{"_3172":313,"_28058":259,"_19443":46408,"_5":13331,"_25550":46267,"_2667":46409},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_3172":314,"_28058":259,"_19443":46411,"_5":13331,"_25550":46267,"_2667":46412},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_3172":315,"_28058":259,"_19443":46414,"_5":13331,"_25550":46267,"_2667":46415},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_3172":316,"_28058":259,"_19443":46417,"_5":13331,"_25550":46267,"_2667":46418},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_3172":317,"_28058":259,"_19443":46420,"_5":13331,"_25550":46267,"_2667":46421},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_3172":318,"_28058":259,"_19443":46423,"_5":13331,"_25550":46271,"_2667":46424},[],"If one Gateway can own TLS and routing, use the chart default.",{"_3172":319,"_28058":259,"_19443":46426,"_5":13331,"_25550":46271,"_2667":46427},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_3172":320,"_28058":259,"_19443":46429,"_5":13331,"_25550":46271,"_2667":46430},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_3172":321,"_28058":259,"_19443":46432,"_5":13331,"_25550":46271,"_2667":46433},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_3172":322,"_28058":259,"_19443":46435,"_5":13331,"_25550":46271,"_2667":46436},[],"If none of those are possible, use different external ports or change the external network design.",{"_3172":323,"_28058":259,"_19443":46438,"_5":13331,"_25550":46275,"_2667":46439},[],"Internal Lamassu clients — the Vault engine connection, service-to-service calls and webhook deliveries — honor the `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables. The exception is the authorization-engine connector: it uses its own transport and does not consult these proxy variables. If your deployment routes egress through a proxy, list in-cluster service names in `NO_PROXY` (for example `.svc,.cluster.local`) so internal traffic stays inside the cluster. Loopback traffic is never sent through a proxy.",{"_3172":324,"_28058":259,"_19443":46441,"_5":13331,"_25550":46275,"_2667":46442},[],"The default transport of these clients bounds the dial timeout (30 seconds), the TLS handshake (10 seconds) and idle connection reuse (90 seconds) so an unreachable dependency fails fast instead of hanging; these values are Go transport defaults, not Lamassu settings. HTTP/2 is negotiated when the peer supports it. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call.",{"_3172":325,"_28058":259,"_19443":46444,"_5":13331,"_25550":46279,"_2667":46445},[],"Check, in order:",{"_3172":326,"_28058":259,"_19443":46447,"_5":13331,"_25550":46279,"_2667":46448},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_3172":327,"_28058":259,"_19443":46450,"_5":13331,"_25550":46279,"_2667":46451},[],"Its status contains the expected address.",{"_3172":328,"_28058":259,"_19443":46453,"_5":13331,"_25550":46279,"_2667":46454},[],"The generated `LoadBalancer` Service has a usable external address.",{"_3172":329,"_28058":259,"_19443":46456,"_5":13331,"_25550":46279,"_2667":46457},[],"Port 443 reaches that address from the client network.",{"_3172":330,"_28058":259,"_19443":46459,"_5":13331,"_25550":46279,"_2667":46460},[],"DNS resolves to the externally reachable endpoint.",{"_3172":331,"_28058":259,"_19443":46462,"_5":13331,"_25550":46279,"_2667":46463},[],"The certificate contains the DNS name or IP used by the client.",{"_3172":332,"_28058":259,"_19443":46465,"_5":13331,"_25550":46279,"_2667":46466},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_3172":333,"_28058":333,"_5":13662,"_2667":45584,"_28401":46468,"_19443":46469,"_25550":333},[45477,45478,45584],[],{"_3172":334,"_28058":333,"_19443":46471,"_5":13331,"_25550":333,"_2667":46472},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_3172":335,"_28058":333,"_5":28398,"_19443":46474,"_25550":46475,"_2667":46476},[],"/docs/pr-preview/pr-55/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_3172":336,"_28058":333,"_5":28398,"_19443":46478,"_25550":46479,"_2667":46480},[],"/docs/pr-preview/pr-55/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_3172":337,"_28058":333,"_5":28398,"_19443":46482,"_25550":46483,"_2667":46484},[],"/docs/pr-preview/pr-55/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_3172":338,"_28058":333,"_5":28398,"_19443":46486,"_25550":46487,"_2667":46488},[],"/docs/pr-preview/pr-55/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_3172":339,"_28058":333,"_5":28398,"_19443":46490,"_25550":46491,"_2667":46492},[],"/docs/pr-preview/pr-55/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_3172":340,"_28058":333,"_5":28398,"_19443":46494,"_25550":46495,"_2667":46496},[],"/docs/pr-preview/pr-55/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_3172":341,"_28058":333,"_19443":46498,"_5":13331,"_25550":46475,"_2667":46499},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_3172":342,"_28058":333,"_19443":46501,"_5":13331,"_25550":46479,"_2667":46502},[],"Workflow",{"_3172":343,"_28058":333,"_19443":46504,"_5":13331,"_25550":46479,"_2667":46505},[],"Use it for",{"_3172":344,"_28058":333,"_19443":46507,"_5":13331,"_25550":46479,"_2667":46508},[],"What it installs",{"_3172":345,"_28058":333,"_19443":46510,"_5":13331,"_25550":46479,"_2667":46511},[],"Helm",{"_3172":346,"_28058":333,"_19443":46513,"_5":13331,"_25550":46479,"_2667":46514},[],"Production and controlled environments",{"_3172":347,"_28058":333,"_19443":46516,"_5":13331,"_25550":46479,"_2667":46517},[],"Lamassu services and Gateway API resources",{"_3172":348,"_28058":333,"_19443":46519,"_5":13331,"_25550":46479,"_2667":45721},[],{"_3172":349,"_28058":333,"_19443":46521,"_5":13331,"_25550":46479,"_2667":46522},[],"Evaluation, demos, CI and small lab clusters",{"_3172":350,"_28058":333,"_19443":46524,"_5":13331,"_25550":46479,"_2667":46525},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_3172":351,"_28058":333,"_19443":46527,"_5":13331,"_25550":46483,"_2667":46528},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_3172":352,"_28058":333,"_19443":46530,"_5":13331,"_25550":46483,"_2667":46531},[],"Area",{"_3172":353,"_28058":333,"_19443":46533,"_5":13331,"_25550":46483,"_2667":46534},[],"The Lamassu chart provides",{"_3172":354,"_28058":333,"_19443":46536,"_5":13331,"_25550":46483,"_2667":46537},[],"You provide",{"_3172":355,"_28058":333,"_19443":46539,"_5":13331,"_25550":46483,"_2667":46540},[],"Lamassu applications",{"_3172":356,"_28058":333,"_19443":46542,"_5":13331,"_25550":46483,"_2667":46543},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_3172":357,"_28058":333,"_19443":46545,"_5":13331,"_25550":46483,"_2667":46546},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_3172":358,"_28058":333,"_19443":46548,"_5":13331,"_25550":46483,"_2667":46549},[],"PostgreSQL data",{"_3172":359,"_28058":333,"_19443":46551,"_5":13331,"_25550":46483,"_2667":46552},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_3172":360,"_28058":333,"_19443":46554,"_5":13331,"_25550":46483,"_2667":46555},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_3172":361,"_28058":333,"_19443":46557,"_5":13331,"_25550":46483,"_2667":46558},[],"Messaging",{"_3172":362,"_28058":333,"_19443":46560,"_5":13331,"_25550":46483,"_2667":46561},[],"RabbitMQ connection configuration for the Lamassu services",{"_3172":363,"_28058":333,"_19443":46563,"_5":13331,"_25550":46483,"_2667":46564},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_3172":364,"_28058":333,"_19443":46566,"_5":13331,"_25550":46483,"_2667":46567},[],"Identity",{"_3172":365,"_28058":333,"_19443":46569,"_5":13331,"_25550":46483,"_2667":46570},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_3172":366,"_28058":333,"_19443":46572,"_5":13331,"_25550":46483,"_2667":46573},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_3172":367,"_28058":333,"_19443":46575,"_5":13331,"_25550":46483,"_2667":46576},[],"External routing",{"_3172":368,"_28058":333,"_19443":46578,"_5":13331,"_25550":46483,"_2667":46579},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_3172":369,"_28058":333,"_19443":46581,"_5":13331,"_25550":46483,"_2667":46582},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_3172":370,"_28058":333,"_19443":46584,"_5":13331,"_25550":46483,"_2667":46585},[],"TLS",{"_3172":371,"_28058":333,"_19443":46587,"_5":13331,"_25550":46483,"_2667":46588},[],"In the default `tls.type: certManager` mode, cert-manager `Issuer` and CA `Certificate` resources and a chart-managed downstream `Certificate`; in the `tls.type: external` mode, a reference to your TLS Secret",{"_3172":372,"_28058":333,"_19443":46590,"_5":13331,"_25550":46483,"_2667":46591},[],"cert-manager only for the default `tls.type: certManager` mode; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_3172":373,"_28058":333,"_19443":46593,"_5":13331,"_25550":46483,"_2667":46594},[],"Persistent application data",{"_3172":374,"_28058":333,"_19443":46596,"_5":13331,"_25550":46483,"_2667":46597},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_3172":375,"_28058":333,"_19443":46599,"_5":13331,"_25550":46483,"_2667":46600},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_3172":376,"_28058":333,"_19443":46602,"_5":13331,"_25550":46483,"_2667":46603},[],"Optional integrations",{"_3172":377,"_28058":333,"_19443":46605,"_5":13331,"_25550":46483,"_2667":46606},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_3172":378,"_28058":333,"_19443":46608,"_5":13331,"_25550":46483,"_2667":46609},[],"The observability backends, cloud credentials and production HSM or external key service",{"_3172":379,"_28058":333,"_19443":46611,"_5":13331,"_25550":46483,"_2667":46612},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_3172":380,"_28058":333,"_19443":46614,"_5":13331,"_25550":46483,"_2667":46615},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_3172":381,"_28058":333,"_19443":46617,"_5":13331,"_25550":46487,"_2667":46618},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_3172":382,"_28058":333,"_19443":46620,"_5":13331,"_25550":46487,"_2667":46621},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_3172":383,"_28058":333,"_19443":46623,"_5":13331,"_25550":46491,"_2667":46624},[],"Kubernetes 1.24 or newer",{"_3172":384,"_28058":333,"_19443":46626,"_5":13331,"_25550":46491,"_2667":46627},[],"Helm 3.2 or newer",{"_3172":385,"_28058":333,"_19443":46629,"_5":13331,"_25550":46491,"_2667":46630},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_3172":386,"_28058":333,"_19443":46632,"_5":13331,"_25550":46491,"_2667":46633},[],"cert-manager 1.14 or newer; required only for the default `tls.type: certManager` TLS mode, not for `tls.type: external`",{"_3172":387,"_28058":333,"_19443":46635,"_5":13331,"_25550":46491,"_2667":46636},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_3172":388,"_28058":333,"_19443":46638,"_5":13331,"_25550":46491,"_2667":46639},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_3172":389,"_28058":333,"_19443":46641,"_5":13331,"_25550":46491,"_2667":46642},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_3172":390,"_28058":333,"_19443":46644,"_5":13331,"_25550":46495,"_2667":46645},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3172":391,"_28058":333,"_19443":46647,"_5":13331,"_25550":46495,"_2667":46648},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3172":392,"_28058":333,"_19443":46650,"_5":13331,"_25550":46495,"_2667":46651},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3172":393,"_28058":333,"_19443":46653,"_5":13331,"_25550":46495,"_2667":46654},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3172":394,"_28058":394,"_5":13662,"_2667":46656,"_28401":46657,"_19443":46659,"_25550":394},"Deployment troubleshooting",[45477,45478,46658],"Operations",[],{"_3172":395,"_28058":394,"_19443":46661,"_5":13331,"_25550":394,"_2667":46662},[],"Diagnose access, service health and infrastructure dependencies.",{"_3172":396,"_28058":394,"_5":28398,"_19443":46664,"_25550":46665,"_2667":46666},[],"/docs/pr-preview/pr-55/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_3172":397,"_28058":394,"_5":28398,"_19443":46668,"_25550":46669,"_2667":46670},[],"/docs/pr-preview/pr-55/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_3172":398,"_28058":394,"_5":28398,"_19443":46672,"_25550":46673,"_2667":46674},[],"/docs/pr-preview/pr-55/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_3172":399,"_28058":394,"_5":28398,"_19443":46676,"_25550":46677,"_2667":46678},[],"/docs/pr-preview/pr-55/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_3172":400,"_28058":394,"_5":28398,"_19443":46680,"_25550":46681,"_2667":46682},[],"/docs/pr-preview/pr-55/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_3172":401,"_28058":394,"_5":28398,"_19443":46684,"_25550":46685,"_2667":46686},[],"/docs/pr-preview/pr-55/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_3172":402,"_28058":394,"_5":28398,"_19443":46688,"_25550":46689,"_2667":46690},[],"/docs/pr-preview/pr-55/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_3172":403,"_28058":394,"_5":28398,"_19443":46692,"_25550":46693,"_2667":46694},[],"/docs/pr-preview/pr-55/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_3172":404,"_28058":394,"_5":28398,"_19443":46696,"_25550":46697,"_2667":46698},[],"/docs/pr-preview/pr-55/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_3172":405,"_28058":394,"_5":28398,"_19443":46700,"_25550":46701,"_2667":46702},[],"/docs/pr-preview/pr-55/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_3172":406,"_28058":394,"_5":28398,"_19443":46704,"_25550":46705,"_2667":46706},[],"/docs/pr-preview/pr-55/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_3172":407,"_28058":394,"_5":28398,"_19443":46708,"_25550":46709,"_2667":46710},[],"/docs/pr-preview/pr-55/deployment/troubleshooting#observability","Observability",{"_3172":408,"_28058":394,"_19443":46712,"_5":13331,"_25550":394,"_2667":46713},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_3172":409,"_28058":394,"_19443":46715,"_5":13331,"_25550":46669,"_2667":46716},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_3172":410,"_28058":394,"_19443":46718,"_5":13331,"_25550":46673,"_2667":46719},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_3172":411,"_28058":394,"_19443":46721,"_5":13331,"_25550":46677,"_2667":46722},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_3172":412,"_28058":394,"_19443":46724,"_5":13331,"_25550":46681,"_2667":46725},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_3172":413,"_28058":394,"_19443":46727,"_5":13331,"_25550":46685,"_2667":46728},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_3172":414,"_28058":394,"_19443":46730,"_5":13331,"_25550":46689,"_2667":46731},[],"Replace the placeholders with your real release, namespace and deployment.",{"_3172":415,"_28058":394,"_19443":46733,"_5":13331,"_25550":46689,"_2667":46734},[],"Also run the chart's connectivity test:",{"_3172":416,"_28058":394,"_19443":46736,"_5":13331,"_25550":46689,"_2667":46737},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_3172":417,"_28058":394,"_19443":46739,"_5":13331,"_25550":46689,"_2667":46740},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_3172":418,"_28058":394,"_19443":46742,"_5":13331,"_25550":46693,"_2667":46743},[],"If you receive a 401:",{"_3172":419,"_28058":394,"_19443":46745,"_5":13331,"_25550":46693,"_2667":46746},[],"check that the UI's OIDC authority is reachable from the browser;",{"_3172":420,"_28058":394,"_19443":46748,"_5":13331,"_25550":46693,"_2667":46749},[],"verify issuer, audience and expiration of the token;",{"_3172":421,"_28058":394,"_19443":46751,"_5":13331,"_25550":46693,"_2667":46752},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_3172":422,"_28058":394,"_19443":46754,"_5":13331,"_25550":46693,"_2667":46755},[],"check that the provider's public and internal routes point to the same realm.",{"_3172":423,"_28058":394,"_19443":46757,"_5":13331,"_25550":46693,"_2667":46758},[],"If login succeeds but the APIs return 403:",{"_3172":424,"_28058":394,"_19443":46760,"_5":13331,"_25550":46693,"_2667":46761},[],"inspect the token's real claims;",{"_3172":425,"_28058":394,"_19443":46763,"_5":13331,"_25550":46693,"_2667":46764},[],"confirm they match an active principal;",{"_3172":426,"_28058":394,"_19443":46766,"_5":13331,"_25550":46693,"_2667":46767},[],"review the policies granted to that principal;",{"_3172":427,"_28058":394,"_19443":46769,"_5":13331,"_25550":46693,"_2667":46770},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_3172":428,"_28058":394,"_19443":46772,"_5":13331,"_25550":46693,"_2667":46773},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_3172":429,"_28058":394,"_19443":46775,"_5":13331,"_25550":46697,"_2667":46776},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_3172":430,"_28058":394,"_19443":46778,"_5":13331,"_25550":46697,"_2667":46779},[],"Locate the authz pod and Service.",{"_3172":431,"_28058":394,"_19443":46781,"_5":13331,"_25550":46697,"_2667":46782},[],"Check /health, logs and its database connection.",{"_3172":432,"_28058":394,"_19443":46784,"_5":13331,"_25550":46697,"_2667":46785},[],"Verify the DNS and port configured in externalAuthorization.",{"_3172":433,"_28058":394,"_19443":46787,"_5":13331,"_25550":46697,"_2667":46788},[],"Check the check route is /v1/ext\\_authz/check.",{"_3172":434,"_28058":394,"_19443":46790,"_5":13331,"_25550":46697,"_2667":46791},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_3172":435,"_28058":394,"_19443":46793,"_5":13331,"_25550":46701,"_2667":46794},[],"Review kubectl describe pod first. Common causes are:",{"_3172":436,"_28058":394,"_19443":46796,"_5":13331,"_25550":46701,"_2667":46797},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_3172":437,"_28058":394,"_19443":46799,"_5":13331,"_25550":46701,"_2667":46800},[],"unbound persistent volume;",{"_3172":438,"_28058":394,"_19443":46802,"_5":13331,"_25550":46701,"_2667":46803},[],"inaccessible image or incorrect pull policy;",{"_3172":439,"_28058":394,"_19443":46805,"_5":13331,"_25550":46701,"_2667":46806},[],"invalid cryptographic engine configuration;",{"_3172":440,"_28058":394,"_19443":46808,"_5":13331,"_25550":46701,"_2667":46809},[],"CPU or memory limits set too low;",{"_3172":441,"_28058":394,"_19443":46811,"_5":13331,"_25550":46701,"_2667":46812},[],"an incomplete prior migration.",{"_3172":442,"_28058":394,"_19443":46814,"_5":13331,"_25550":46701,"_2667":46815},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_3172":443,"_28058":394,"_19443":46817,"_5":13331,"_25550":46701,"_2667":46818},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_3172":444,"_28058":394,"_19443":46820,"_5":13331,"_25550":46701,"_2667":46821},[],"Internal calls now fail fast instead of hanging for the clients covered by Egress proxy: connection attempts time out after 30 seconds and TLS handshakes after 10 seconds. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call. If an egress proxy handles the cluster's outbound traffic, check the pod's `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables and list in-cluster service names in `NO_PROXY`.",{"_3172":445,"_28058":394,"_19443":46823,"_5":13331,"_25550":46705,"_2667":46824},[],"Domain and audit events depend on the bus publisher:",{"_3172":446,"_28058":394,"_19443":46826,"_5":13331,"_25550":46705,"_2667":46827},[],"verify it is enabled in the emitting service;",{"_3172":447,"_28058":394,"_19443":46829,"_5":13331,"_25550":46705,"_2667":46830},[],"check AMQP connectivity and credentials;",{"_3172":448,"_28058":394,"_19443":46832,"_5":13331,"_25550":46705,"_2667":46833},[],"review exchange, routing key, queues and consumers;",{"_3172":449,"_28058":394,"_19443":46835,"_5":13331,"_25550":46705,"_2667":46836},[],"inspect dead-letter queues;",{"_3172":450,"_28058":394,"_19443":46838,"_5":13331,"_25550":46705,"_2667":46839},[],"alert on orphan durable queues and backlog growth.",{"_3172":451,"_28058":394,"_19443":46841,"_5":13331,"_25550":46705,"_2667":46842},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_3172":452,"_28058":394,"_19443":46844,"_5":13331,"_25550":46709,"_2667":46845},[],"The chart can enable OpenTelemetry instrumentation. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, authz, service and dependency.",{"_3172":453,"_28058":394,"_19443":46847,"_5":13331,"_25550":46709,"_2667":46848},[],"Before closing an incident, record:",{"_3172":454,"_28058":394,"_19443":46850,"_5":13331,"_25550":46709,"_2667":46851},[],"the confirmed cause;",{"_3172":455,"_28058":394,"_19443":46853,"_5":13331,"_25550":46709,"_2667":46854},[],"the time scope and affected resources;",{"_3172":456,"_28058":394,"_19443":46856,"_5":13331,"_25550":46709,"_2667":46857},[],"the commands or queries used;",{"_3172":457,"_28058":394,"_19443":46859,"_5":13331,"_25550":46709,"_2667":46860},[],"the applied change and how to revert it;",{"_3172":458,"_28058":394,"_19443":46862,"_5":13331,"_25550":46709,"_2667":46863},[],"validation from a consumer;",{"_3172":459,"_28058":394,"_19443":46865,"_5":13331,"_25550":46709,"_2667":46866},[],"the preventive action and its owner.",{"_3172":460,"_28058":460,"_5":13662,"_2667":46868,"_28401":46869,"_19443":46872,"_25550":460},"Access control",[45477,46870,46871],"Platform","Administration",[],{"_3172":461,"_28058":460,"_19443":46874,"_5":13331,"_25550":460,"_2667":46875},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_3172":462,"_28058":460,"_5":28398,"_19443":46877,"_25550":46878,"_2667":46879},[],"/docs/pr-preview/pr-55/platform/administration/access-control#essential-concepts","Essential concepts",{"_3172":463,"_28058":460,"_5":28398,"_19443":46881,"_25550":46882,"_2667":46883},[],"/docs/pr-preview/pr-55/platform/administration/access-control#two-decision-systems","Two decision systems",{"_3172":464,"_28058":460,"_5":28398,"_19443":46885,"_25550":46886,"_2667":46887},[],"/docs/pr-preview/pr-55/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_3172":465,"_28058":460,"_5":28398,"_19443":46889,"_25550":46890,"_2667":46891},[],"/docs/pr-preview/pr-55/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_3172":466,"_28058":460,"_5":28398,"_19443":46893,"_25550":46894,"_2667":46895},[],"/docs/pr-preview/pr-55/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_3172":467,"_28058":460,"_5":28398,"_19443":46897,"_25550":46898,"_2667":46899},[],"/docs/pr-preview/pr-55/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_3172":468,"_28058":460,"_5":28398,"_19443":46901,"_25550":46902,"_2667":46903},[],"/docs/pr-preview/pr-55/platform/administration/access-control#oidc-principals","OIDC principals",{"_3172":469,"_28058":460,"_5":28398,"_19443":46905,"_25550":46906,"_2667":46907},[],"/docs/pr-preview/pr-55/platform/administration/access-control#x509-principals","X.509 principals",{"_3172":470,"_28058":460,"_5":28398,"_19443":46909,"_25550":46910,"_2667":46911},[],"/docs/pr-preview/pr-55/platform/administration/access-control#when-several-principals-match","When several principals match",{"_3172":471,"_28058":460,"_5":28398,"_19443":46913,"_25550":46914,"_2667":46915},[],"/docs/pr-preview/pr-55/platform/administration/access-control#how-policies-express-access","How policies express access",{"_3172":472,"_28058":460,"_5":28398,"_19443":46917,"_25550":46918,"_2667":46919},[],"/docs/pr-preview/pr-55/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_3172":473,"_28058":460,"_5":28398,"_19443":46921,"_25550":46922,"_2667":46923},[],"/docs/pr-preview/pr-55/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_3172":474,"_28058":460,"_5":28398,"_19443":46925,"_25550":46926,"_2667":46927},[],"/docs/pr-preview/pr-55/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_3172":475,"_28058":460,"_5":28398,"_19443":46929,"_25550":46930,"_2667":46931},[],"/docs/pr-preview/pr-55/platform/administration/access-control#http-rules","HTTP rules",{"_3172":476,"_28058":460,"_5":28398,"_19443":46933,"_25550":46934,"_2667":46935},[],"/docs/pr-preview/pr-55/platform/administration/access-control#included-policies","Included policies",{"_3172":477,"_28058":460,"_5":28398,"_19443":46937,"_25550":46938,"_2667":46113},[],"/docs/pr-preview/pr-55/platform/administration/access-control#provision-the-first-administrator",{"_3172":478,"_28058":460,"_5":28398,"_19443":46940,"_25550":46941,"_2667":46942},[],"/docs/pr-preview/pr-55/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_3172":479,"_28058":460,"_5":28398,"_19443":46944,"_25550":46945,"_2667":46946},[],"/docs/pr-preview/pr-55/platform/administration/access-control#configure-token-validation","Configure token validation",{"_3172":480,"_28058":460,"_5":28398,"_19443":46948,"_25550":46949,"_2667":46950},[],"/docs/pr-preview/pr-55/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_3172":481,"_28058":460,"_5":28398,"_19443":46952,"_25550":46953,"_2667":46954},[],"/docs/pr-preview/pr-55/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_3172":482,"_28058":460,"_5":28398,"_19443":46956,"_25550":46957,"_2667":46958},[],"/docs/pr-preview/pr-55/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_3172":483,"_28058":460,"_5":28398,"_19443":46960,"_25550":46961,"_2667":46962},[],"/docs/pr-preview/pr-55/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_3172":484,"_28058":460,"_5":28398,"_19443":46964,"_25550":46965,"_2667":46966},[],"/docs/pr-preview/pr-55/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_3172":485,"_28058":460,"_5":28398,"_19443":46968,"_25550":46969,"_2667":46970},[],"/docs/pr-preview/pr-55/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_3172":486,"_28058":460,"_5":28398,"_19443":46972,"_25550":46973,"_2667":46974},[],"/docs/pr-preview/pr-55/platform/administration/access-control#operational-checklist","Operational checklist",{"_3172":487,"_28058":460,"_5":28398,"_19443":46976,"_25550":46977,"_2667":46978},[],"/docs/pr-preview/pr-55/platform/administration/access-control#diagnostics","Diagnostics",{"_3172":488,"_28058":460,"_5":28398,"_19443":46980,"_25550":46981,"_2667":46982},[],"/docs/pr-preview/pr-55/platform/administration/access-control#the-response-is-401","The response is 401",{"_3172":489,"_28058":460,"_5":28398,"_19443":46984,"_25550":46985,"_2667":46986},[],"/docs/pr-preview/pr-55/platform/administration/access-control#the-response-is-403","The response is 403",{"_3172":490,"_28058":460,"_5":28398,"_19443":46988,"_25550":46989,"_2667":46990},[],"/docs/pr-preview/pr-55/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_3172":491,"_28058":460,"_5":28398,"_19443":46992,"_25550":46993,"_2667":46994},[],"/docs/pr-preview/pr-55/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_3172":492,"_28058":460,"_5":28398,"_19443":46996,"_25550":46997,"_2667":46998},[],"/docs/pr-preview/pr-55/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_3172":493,"_28058":460,"_19443":47000,"_5":13331,"_25550":460,"_2667":47001},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_3172":494,"_28058":460,"_19443":47003,"_5":13331,"_25550":460,"_2667":47004},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_3172":495,"_28058":460,"_19443":47006,"_5":13331,"_25550":460,"_2667":47007},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_3172":496,"_28058":460,"_19443":47009,"_5":13331,"_25550":46878,"_2667":47010},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_3172":497,"_28058":460,"_19443":47012,"_5":13331,"_25550":46878,"_2667":47013},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_3172":498,"_28058":460,"_19443":47015,"_5":13331,"_25550":46878,"_2667":47016},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_3172":499,"_28058":460,"_19443":47018,"_5":13331,"_25550":46878,"_2667":47019},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_3172":500,"_28058":460,"_19443":47021,"_5":13331,"_25550":46878,"_2667":47022},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_3172":501,"_28058":460,"_19443":47024,"_5":13331,"_25550":46878,"_2667":47025},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_3172":502,"_28058":460,"_19443":47027,"_5":13331,"_25550":46882,"_2667":47028},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_3172":503,"_28058":460,"_19443":47030,"_5":13331,"_25550":46882,"_2667":47031},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_3172":504,"_28058":460,"_19443":47033,"_5":13331,"_25550":46886,"_2667":47034},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_3172":505,"_28058":460,"_19443":47036,"_5":13331,"_25550":46886,"_2667":47037},[],"The decision is made **before forwarding the request to the service**:",{"_3172":506,"_28058":460,"_19443":47039,"_5":13331,"_25550":46886,"_2667":47040},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_3172":507,"_28058":460,"_19443":47042,"_5":13331,"_25550":46886,"_2667":47043},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_3172":508,"_28058":460,"_19443":47045,"_5":13331,"_25550":46886,"_2667":47046},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_3172":509,"_28058":460,"_19443":47048,"_5":13331,"_25550":46886,"_2667":47049},[],"It separately loads the policies granted to each principal.",{"_3172":510,"_28058":460,"_19443":47051,"_5":13331,"_25550":46886,"_2667":47052},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_3172":511,"_28058":460,"_19443":47054,"_5":13331,"_25550":46886,"_2667":47055},[],"`authz` looks for an HTTP rule granting that action.",{"_3172":512,"_28058":460,"_19443":47057,"_5":13331,"_25550":46886,"_2667":47058},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_3172":513,"_28058":460,"_19443":47060,"_5":13331,"_25550":46886,"_2667":47061},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_3172":514,"_28058":460,"_19443":47063,"_5":13331,"_25550":46886,"_2667":47064},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context.",{"_3172":515,"_28058":460,"_19443":47066,"_5":13331,"_25550":46886,"_2667":47067},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_3172":516,"_28058":460,"_19443":47069,"_5":13331,"_25550":46890,"_2667":47070},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_3172":517,"_28058":460,"_19443":47072,"_5":13331,"_25550":46890,"_2667":47073},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_3172":518,"_28058":460,"_19443":47075,"_5":13331,"_25550":46890,"_2667":47076},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_3172":519,"_28058":460,"_19443":47078,"_5":13331,"_25550":46890,"_2667":47079},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_3172":520,"_28058":460,"_19443":47081,"_5":13331,"_25550":46890,"_2667":47082},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_3172":521,"_28058":460,"_19443":47084,"_5":13331,"_25550":46890,"_2667":47085},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_3172":522,"_28058":460,"_19443":47087,"_5":13331,"_25550":46890,"_2667":47088},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_3172":523,"_28058":460,"_19443":47090,"_5":13331,"_25550":46890,"_2667":47091},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_3172":524,"_28058":460,"_19443":47093,"_5":13331,"_25550":46894,"_2667":47094},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_3172":525,"_28058":460,"_19443":47096,"_5":13331,"_25550":46894,"_2667":47097},[],"The decision is made with the domain operation context:",{"_3172":526,"_28058":460,"_19443":47099,"_5":13331,"_25550":46894,"_2667":47100},[],"The middleware extracts the credential and resolves the matching principals.",{"_3172":527,"_28058":460,"_19443":47102,"_5":13331,"_25550":46894,"_2667":47103},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_3172":528,"_28058":460,"_19443":47105,"_5":13331,"_25550":46894,"_2667":47106},[],"`authz` gathers the entity rules of the granted policies.",{"_3172":529,"_28058":460,"_19443":47108,"_5":13331,"_25550":46894,"_2667":47109},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_3172":530,"_28058":460,"_19443":47111,"_5":13331,"_25550":46894,"_2667":47112},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_3172":531,"_28058":460,"_19443":47114,"_5":13331,"_25550":46894,"_2667":47115},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_3172":532,"_28058":460,"_19443":47117,"_5":13331,"_25550":46894,"_2667":47118},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_3172":533,"_28058":460,"_19443":47120,"_5":13331,"_25550":46894,"_2667":47121},[],"Actions fall into two groups:",{"_3172":534,"_28058":460,"_19443":47123,"_5":13331,"_25550":46894,"_2667":47124},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_3172":535,"_28058":460,"_19443":47126,"_5":13331,"_25550":46894,"_2667":47127},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_3172":536,"_28058":460,"_19443":47129,"_5":13331,"_25550":46894,"_2667":47130},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_3172":537,"_28058":460,"_19443":47132,"_5":13331,"_25550":46898,"_2667":47133},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_3172":538,"_28058":460,"_19443":47135,"_5":13331,"_25550":46898,"_2667":47136},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_3172":539,"_28058":460,"_19443":47138,"_5":13331,"_25550":46898,"_2667":47139},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_3172":540,"_28058":460,"_19443":47141,"_5":13331,"_25550":46902,"_2667":47142},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_3172":541,"_28058":460,"_19443":47144,"_5":13331,"_25550":46902,"_2667":47145},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_3172":542,"_28058":460,"_19443":47147,"_5":13331,"_25550":46902,"_2667":47148},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_3172":543,"_28058":460,"_19443":47150,"_5":13331,"_25550":46902,"_2667":47151},[],"The implemented operators are:",{"_3172":544,"_28058":460,"_19443":47153,"_5":13331,"_25550":46902,"_2667":47154},[],"`equals`, for exact equality;",{"_3172":545,"_28058":460,"_19443":47156,"_5":13331,"_25550":46902,"_2667":47157},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_3172":546,"_28058":460,"_19443":47159,"_5":13331,"_25550":46902,"_2667":47160},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_3172":547,"_28058":460,"_19443":47162,"_5":13331,"_25550":46902,"_2667":47163},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_3172":548,"_28058":460,"_19443":47165,"_5":13331,"_25550":46906,"_2667":47166},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_3172":549,"_28058":460,"_19443":47168,"_5":13331,"_25550":46906,"_2667":47169},[],"The available modes are:",{"_3172":550,"_28058":460,"_19443":47171,"_5":13331,"_25550":46906,"_2667":47172},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_3172":551,"_28058":460,"_19443":47174,"_5":13331,"_25550":46906,"_2667":47175},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_3172":552,"_28058":460,"_19443":47177,"_5":13331,"_25550":46906,"_2667":47178},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_3172":553,"_28058":460,"_19443":47180,"_5":13331,"_25550":46906,"_2667":47181},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_3172":554,"_28058":460,"_19443":47183,"_5":13331,"_25550":46906,"_2667":47184},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_3172":555,"_28058":460,"_19443":47186,"_5":13331,"_25550":46906,"_2667":47187},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_3172":556,"_28058":460,"_19443":47189,"_5":13331,"_25550":46910,"_2667":47190},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_3172":557,"_28058":460,"_19443":47192,"_5":13331,"_25550":46910,"_2667":47193},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_3172":558,"_28058":460,"_19443":47195,"_5":13331,"_25550":46910,"_2667":47196},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_3172":559,"_28058":460,"_19443":47198,"_5":13331,"_25550":46910,"_2667":47199},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_3172":560,"_28058":460,"_19443":47201,"_5":13331,"_25550":46918,"_2667":47202},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_3172":561,"_28058":460,"_19443":47204,"_5":13331,"_25550":46918,"_2667":47205},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_3172":562,"_28058":460,"_19443":47207,"_5":13331,"_25550":46922,"_2667":47208},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA and of a device to its DMS. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_3172":563,"_28058":460,"_19443":47210,"_5":13331,"_25550":46922,"_2667":47211},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_3172":564,"_28058":460,"_19443":47213,"_5":13331,"_25550":46926,"_2667":47214},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_3172":565,"_28058":460,"_19443":47216,"_5":13331,"_25550":46926,"_2667":47217},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_3172":566,"_28058":460,"_19443":47219,"_5":13331,"_25550":46926,"_2667":47220},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_3172":567,"_28058":460,"_19443":47222,"_5":13331,"_25550":46930,"_2667":47223},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_3172":568,"_28058":460,"_19443":47225,"_5":13331,"_25550":46930,"_2667":47226},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_3172":569,"_28058":460,"_19443":47228,"_5":13331,"_25550":46930,"_2667":47229},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_3172":570,"_28058":460,"_19443":47231,"_5":13331,"_25550":46930,"_2667":47232},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_3172":571,"_28058":460,"_19443":47234,"_5":13331,"_25550":46930,"_2667":47235},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_3172":572,"_28058":460,"_19443":47237,"_5":13331,"_25550":46930,"_2667":47238},[],"Note that:",{"_3172":573,"_28058":460,"_19443":47240,"_5":13331,"_25550":46930,"_2667":47241},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_3172":574,"_28058":460,"_19443":47243,"_5":13331,"_25550":46930,"_2667":47244},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_3172":575,"_28058":460,"_19443":47246,"_5":13331,"_25550":46930,"_2667":47247},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_3172":576,"_28058":460,"_19443":47249,"_5":13331,"_25550":46934,"_2667":47250},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_3172":577,"_28058":460,"_19443":47252,"_5":13331,"_25550":46934,"_2667":47253},[],"full and read-only access to certificates and authorities;",{"_3172":578,"_28058":460,"_19443":47255,"_5":13331,"_25550":46934,"_2667":47256},[],"full and read-only access to the KMS;",{"_3172":579,"_28058":460,"_19443":47258,"_5":13331,"_25550":46934,"_2667":47259},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_3172":580,"_28058":460,"_19443":47261,"_5":13331,"_25550":46934,"_2667":47262},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_3172":581,"_28058":460,"_19443":47264,"_5":13331,"_25550":46934,"_2667":47265},[],"console access;",{"_3172":582,"_28058":460,"_19443":47267,"_5":13331,"_25550":46934,"_2667":47268},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_3172":583,"_28058":460,"_19443":47270,"_5":13331,"_25550":46934,"_2667":47271},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_3172":584,"_28058":460,"_19443":47273,"_5":13331,"_25550":46934,"_2667":47274},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_3172":585,"_28058":460,"_19443":47276,"_5":13331,"_25550":46938,"_2667":47277},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_3172":586,"_28058":460,"_19443":47279,"_5":13331,"_25550":46938,"_2667":47280},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_3172":587,"_28058":460,"_19443":47282,"_5":13331,"_25550":46938,"_2667":47283},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_3172":588,"_28058":460,"_19443":47285,"_5":13331,"_25550":46941,"_2667":47286},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_3172":589,"_28058":460,"_19443":47288,"_5":13331,"_25550":46945,"_2667":47289},[],"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`.",{"_3172":590,"_28058":460,"_19443":47291,"_5":13331,"_25550":46945,"_2667":47292},[],"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0.",{"_3172":591,"_28058":460,"_19443":47294,"_5":13331,"_25550":46949,"_2667":47295},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_3172":592,"_28058":460,"_19443":47297,"_5":13331,"_25550":46953,"_2667":47298},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_3172":593,"_28058":460,"_19443":47300,"_5":13331,"_25550":46957,"_2667":47301},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_3172":594,"_28058":460,"_19443":47303,"_5":13331,"_25550":46961,"_2667":47304},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_3172":595,"_28058":460,"_19443":47306,"_5":13331,"_25550":46961,"_2667":47307},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_3172":596,"_28058":460,"_19443":47309,"_5":13331,"_25550":46965,"_2667":47310},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_3172":597,"_28058":460,"_19443":47312,"_5":13331,"_25550":46965,"_2667":47313},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_3172":598,"_28058":460,"_19443":47315,"_5":13331,"_25550":46965,"_2667":47316},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_3172":599,"_28058":460,"_19443":47318,"_5":13331,"_25550":46965,"_2667":47319},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_3172":600,"_28058":460,"_19443":47321,"_5":13331,"_25550":46965,"_2667":47322},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_3172":601,"_28058":460,"_19443":47324,"_5":13331,"_25550":46965,"_2667":47325},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_3172":602,"_28058":460,"_19443":47327,"_5":13331,"_25550":46965,"_2667":47328},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_3172":603,"_28058":460,"_19443":47330,"_5":13331,"_25550":46965,"_2667":47331},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_3172":604,"_28058":460,"_19443":47333,"_5":13331,"_25550":46969,"_2667":47334},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_3172":605,"_28058":460,"_19443":47336,"_5":13331,"_25550":46969,"_2667":47337},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_3172":606,"_28058":460,"_19443":47339,"_5":13331,"_25550":46969,"_2667":47340},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_3172":607,"_28058":460,"_19443":47342,"_5":13331,"_25550":46973,"_2667":47343},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_3172":608,"_28058":460,"_19443":47345,"_5":13331,"_25550":46973,"_2667":47346},[],"Use groups or stable roles for people and independent identities for automations.",{"_3172":609,"_28058":460,"_19443":47348,"_5":13331,"_25550":46973,"_2667":47349},[],"Keep at least two recovery administrators and test their access periodically.",{"_3172":610,"_28058":460,"_19443":47351,"_5":13331,"_25550":46973,"_2667":47352},[],"Review active principals, their matches and their grants after IdP changes.",{"_3172":611,"_28058":460,"_19443":47354,"_5":13331,"_25550":46973,"_2667":47355},[],"Search for wildcards in policies before upgrading Lamassu.",{"_3172":612,"_28058":460,"_19443":47357,"_5":13331,"_25550":46973,"_2667":47358},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_3172":613,"_28058":460,"_19443":47360,"_5":13331,"_25550":46973,"_2667":47361},[],"Always test one allowed and one denied operation for each role.",{"_3172":614,"_28058":460,"_19443":47363,"_5":13331,"_25550":46973,"_2667":47364},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_3172":615,"_28058":460,"_19443":47366,"_5":13331,"_25550":46981,"_2667":47367},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_3172":616,"_28058":460,"_19443":47369,"_5":13331,"_25550":46985,"_2667":47370},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_3172":617,"_28058":460,"_19443":47372,"_5":13331,"_25550":46985,"_2667":47373},[],"that an active principal of the correct type exists;",{"_3172":618,"_28058":460,"_19443":47375,"_5":13331,"_25550":46985,"_2667":47376},[],"that the claim paths and values match the real token exactly;",{"_3172":619,"_28058":460,"_19443":47378,"_5":13331,"_25550":46985,"_2667":47379},[],"that all of the principal's conditions hold;",{"_3172":620,"_28058":460,"_19443":47381,"_5":13331,"_25550":46985,"_2667":47382},[],"that the principal has the expected policy granted;",{"_3172":621,"_28058":460,"_19443":47384,"_5":13331,"_25550":46985,"_2667":47385},[],"that the policy includes the action and the requested resource type or route;",{"_3172":622,"_28058":460,"_19443":47387,"_5":13331,"_25550":46985,"_2667":47388},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_3172":623,"_28058":460,"_19443":47390,"_5":13331,"_25550":46985,"_2667":47391},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry instrumentation enabled, each decision also produces a span — `engine.CheckHTTP` on the Gateway path — whose attributes record `authz.allowed`, the matched policy and the matched principal, so you can correlate the denial with the Gateway trace.",{"_3172":624,"_28058":460,"_19443":47393,"_5":13331,"_25550":46989,"_2667":47394},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_3172":625,"_28058":460,"_19443":47396,"_5":13331,"_25550":46993,"_2667":47397},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_3172":626,"_28058":460,"_19443":47399,"_5":13331,"_25550":46997,"_2667":47400},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_3172":627,"_28058":460,"_19443":47402,"_5":13331,"_25550":46997,"_2667":47403},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_3172":628,"_28058":628,"_5":13662,"_2667":47405,"_28401":47406,"_19443":47407,"_25550":628},"Alerts and subscriptions",[45477,46870,46871],[],{"_3172":629,"_28058":628,"_19443":47409,"_5":13331,"_25550":628,"_2667":47410},[],"Send PKI events to people and external systems.",{"_3172":630,"_28058":628,"_5":28398,"_19443":47412,"_25550":47413,"_2667":47414},[],"/docs/pr-preview/pr-55/platform/administration/alerts#how-it-works","How it works",{"_3172":631,"_28058":628,"_5":28398,"_19443":47416,"_25550":47417,"_2667":47418},[],"/docs/pr-preview/pr-55/platform/administration/alerts#available-channels","Available channels",{"_3172":632,"_28058":628,"_5":28398,"_19443":47420,"_25550":47421,"_2667":47422},[],"/docs/pr-preview/pr-55/platform/administration/alerts#create-a-subscription","Create a subscription",{"_3172":633,"_28058":628,"_5":28398,"_19443":47424,"_25550":47425,"_2667":47426},[],"/docs/pr-preview/pr-55/platform/administration/alerts#choose-the-event","Choose the event",{"_3172":634,"_28058":628,"_5":28398,"_19443":47428,"_25550":47429,"_2667":47430},[],"/docs/pr-preview/pr-55/platform/administration/alerts#configure-the-destination","Configure the destination",{"_3172":635,"_28058":628,"_5":28398,"_19443":47432,"_25550":47433,"_2667":47434},[],"/docs/pr-preview/pr-55/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_3172":636,"_28058":628,"_5":28398,"_19443":47436,"_25550":47437,"_2667":47438},[],"/docs/pr-preview/pr-55/platform/administration/alerts#review-and-activate","Review and activate",{"_3172":637,"_28058":628,"_5":28398,"_19443":47440,"_25550":47441,"_2667":47442},[],"/docs/pr-preview/pr-55/platform/administration/alerts#configure-the-webhook-http-client","Configure the webhook HTTP client",{"_3172":638,"_28058":628,"_5":28398,"_19443":47444,"_25550":47445,"_2667":47446},[],"/docs/pr-preview/pr-55/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_3172":639,"_28058":628,"_5":28398,"_19443":47448,"_25550":47449,"_2667":47450},[],"/docs/pr-preview/pr-55/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_3172":640,"_28058":628,"_5":28398,"_19443":47452,"_25550":47453,"_2667":47454},[],"/docs/pr-preview/pr-55/platform/administration/alerts#event-families","Event families",{"_3172":641,"_28058":628,"_19443":47456,"_5":13331,"_25550":628,"_2667":47457},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_3172":642,"_28058":628,"_19443":47459,"_5":13331,"_25550":47413,"_2667":47460},[],"A service publishes a domain event.",{"_3172":643,"_28058":628,"_19443":47462,"_5":13331,"_25550":47413,"_2667":47463},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_3172":644,"_28058":628,"_19443":47465,"_5":13331,"_25550":47413,"_2667":47466},[],"Each subscription's filter decides whether it should be notified.",{"_3172":645,"_28058":628,"_19443":47468,"_5":13331,"_25550":47413,"_2667":47469},[],"Lamassu delivers the event to the configured channel.",{"_3172":646,"_28058":628,"_19443":47471,"_5":13331,"_25550":47413,"_2667":47472},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_3172":647,"_28058":628,"_19443":47474,"_5":13331,"_25550":47417,"_2667":47475},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_3172":648,"_28058":628,"_19443":47477,"_5":13331,"_25550":47417,"_2667":47478},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_3172":649,"_28058":628,"_19443":47480,"_5":13331,"_25550":47417,"_2667":47481},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_3172":650,"_28058":628,"_19443":47483,"_5":13331,"_25550":47417,"_2667":47484},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_3172":651,"_28058":628,"_19443":47486,"_5":13331,"_25550":47417,"_2667":47487},[],"`apikey_options` requires `header` and `key`.",{"_3172":652,"_28058":628,"_19443":47489,"_5":13331,"_25550":47417,"_2667":47490},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3172":653,"_28058":628,"_19443":47492,"_5":13331,"_25550":47417,"_2667":47493},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_3172":654,"_28058":628,"_19443":47495,"_5":13331,"_25550":47417,"_2667":47496},[],"The alerts API reference documents the full `http_client` schema.",{"_3172":655,"_28058":628,"_19443":47498,"_5":13331,"_25550":47425,"_2667":47499},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_3172":656,"_28058":628,"_19443":47501,"_5":13331,"_25550":47429,"_2667":47502},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_3172":657,"_28058":628,"_19443":47504,"_5":13331,"_25550":47433,"_2667":47505},[],"Add a filter if you don't want to receive every instance of the event.",{"_3172":658,"_28058":628,"_19443":47507,"_5":13331,"_25550":47433,"_2667":47508},[],"**None** notifies all instances of the event.",{"_3172":659,"_28058":628,"_19443":47510,"_5":13331,"_25550":47433,"_2667":47511},[],"**JSON Path** evaluates one or more specific fields.",{"_3172":660,"_28058":628,"_19443":47513,"_5":13331,"_25550":47433,"_2667":47514},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_3172":661,"_28058":628,"_19443":47516,"_5":13331,"_25550":47433,"_2667":47517},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_3172":662,"_28058":628,"_19443":47519,"_5":13331,"_25550":47433,"_2667":47520},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_3172":663,"_28058":628,"_19443":47522,"_5":13331,"_25550":47437,"_2667":47523},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_3172":664,"_28058":628,"_19443":47525,"_5":13331,"_25550":47441,"_2667":47526},[],"The Webhook and Microsoft Teams channels show this configuration in the subscribe form, at the channel step, and again when editing a subscription; Email does not use it. The fields map to the optional `http_client` block described above:",{"_3172":665,"_28058":628,"_19443":47528,"_5":13331,"_25550":47441,"_2667":47529},[],"**Log Level** selects `debug`, `info`, `warn` or `error`; `info` is the default.",{"_3172":666,"_28058":628,"_19443":47531,"_5":13331,"_25550":47441,"_2667":47532},[],"**Call Timeout** defaults to 10 seconds. The console rejects a value above 30 seconds with `Webhook timeout must be at most 30s.`; the API clamps the same value to the cap instead (see Calls are bounded).",{"_3172":667,"_28058":628,"_19443":47534,"_5":13331,"_25550":47441,"_2667":47535},[],"There is no TLS-verification switch for these channels, because the service always verifies the receiver certificate (see TLS is always verified).",{"_3172":668,"_28058":628,"_19443":47537,"_5":13331,"_25550":47441,"_2667":47538},[],"**HTTP Authentication** selects `No Authentication` (the default), `API Key` (API key value and Header Name, `X-API-Key` by default), `OIDC Client Credentials` (Client ID, Client Secret and Well-Known URL) or `Mutual TLS` (Client Certificate and Client Private Key pasted as PEM). A stored private key stays hidden until you select **Show**.",{"_3172":669,"_28058":628,"_19443":47540,"_5":13331,"_25550":47441,"_2667":47541},[],"A `http://` URL shows the console warning `Unencrypted HTTP connection` (see the Credentials over http\\:// callout below).",{"_3172":670,"_28058":628,"_19443":47543,"_5":13331,"_25550":47441,"_2667":47544},[],"The form validates inline against the same delivery rules: the webhook URL and the OIDC Well-Known URL must be absolute `http` or `https` URLs, an API-key header may not use a reserved name, and the mTLS certificate and key must be PEM content, not file paths.",{"_3172":671,"_28058":628,"_19443":47546,"_5":13331,"_25550":47441,"_2667":47547},[],"The summary in the Confirm step shows the authentication as `None`, `OIDC client credentials`, `API key` or `Mutual TLS`. The subscription details show the authentication, the API key header name (never the value), the OIDC issuer URL, mTLS as `Configured` and a fixed `TLS verification: Verified` row. The API key, client secret and private key are not shown in the subscription details.",{"_3172":672,"_28058":628,"_19443":47549,"_5":13331,"_25550":47445,"_2667":47550},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_3172":673,"_28058":628,"_19443":47552,"_5":13331,"_25550":47445,"_2667":47553},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_3172":674,"_28058":628,"_19443":47555,"_5":13331,"_25550":47445,"_2667":47556},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_3172":675,"_28058":628,"_19443":47558,"_5":13331,"_25550":47445,"_2667":47559},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_3172":676,"_28058":628,"_19443":47561,"_5":13331,"_25550":47445,"_2667":47562},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_3172":677,"_28058":628,"_19443":47564,"_5":13331,"_25550":47445,"_2667":47565},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_3172":678,"_28058":628,"_19443":47567,"_5":13331,"_25550":47445,"_2667":47568},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_3172":679,"_28058":628,"_19443":47570,"_5":13331,"_25550":47445,"_2667":47571},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_3172":680,"_28058":628,"_19443":47573,"_5":13331,"_25550":47449,"_2667":47574},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_3172":681,"_28058":628,"_19443":47576,"_5":13331,"_25550":47449,"_2667":47577},[],"Subscriptions created with older console versions may store the webhook target under `url` and `method` instead of `webhook_url` and `webhook_method`. The service delivers only through `webhook_url` and `webhook_method`, so such a subscription does not deliver even though the subscription details show the stored target. Open the subscription and save it again: the edit form prefills the stored target, and saving rewrites the channel configuration in the current layout.",{"_3172":682,"_28058":628,"_19443":47579,"_5":13331,"_25550":47453,"_2667":47580},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_3172":683,"_28058":628,"_19443":47582,"_5":13331,"_25550":47453,"_2667":47583},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_3172":684,"_28058":628,"_19443":47585,"_5":13331,"_25550":47453,"_2667":47586},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_3172":685,"_28058":628,"_19443":47588,"_5":13331,"_25550":47453,"_2667":47589},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_3172":686,"_28058":628,"_19443":47591,"_5":13331,"_25550":47453,"_2667":47592},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_3172":687,"_28058":628,"_19443":47594,"_5":13331,"_25550":47453,"_2667":47595},[],"**Validation:** `va.role.crl.create`.",{"_3172":688,"_28058":628,"_19443":47597,"_5":13331,"_25550":47453,"_2667":47598},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_3172":689,"_28058":628,"_19443":47600,"_5":13331,"_25550":47453,"_2667":47601},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_3172":690,"_28058":690,"_5":13662,"_2667":47603,"_28401":47604,"_19443":47605,"_25550":690},"Audit logs",[45477,46870,46871],[],{"_3172":691,"_28058":690,"_19443":47607,"_5":13331,"_25550":690,"_2667":47608},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_3172":692,"_28058":690,"_5":28398,"_19443":47610,"_25550":47611,"_2667":47612},[],"/docs/pr-preview/pr-55/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_3172":693,"_28058":690,"_5":28398,"_19443":47614,"_25550":47615,"_2667":47616},[],"/docs/pr-preview/pr-55/platform/administration/audit-logs#coverage","Coverage",{"_3172":694,"_28058":690,"_5":28398,"_19443":47618,"_25550":47619,"_2667":47620},[],"/docs/pr-preview/pr-55/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_3172":695,"_28058":690,"_5":28398,"_19443":47622,"_25550":47623,"_2667":47624},[],"/docs/pr-preview/pr-55/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_3172":696,"_28058":690,"_5":28398,"_19443":47626,"_25550":47627,"_2667":47628},[],"/docs/pr-preview/pr-55/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_3172":697,"_28058":690,"_5":28398,"_19443":47630,"_25550":47631,"_2667":47632},[],"/docs/pr-preview/pr-55/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_3172":698,"_28058":690,"_5":28398,"_19443":47634,"_25550":47635,"_2667":47636},[],"/docs/pr-preview/pr-55/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_3172":699,"_28058":690,"_5":28398,"_19443":47638,"_25550":47639,"_2667":47640},[],"/docs/pr-preview/pr-55/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_3172":700,"_28058":690,"_5":28398,"_19443":47642,"_25550":47643,"_2667":47644},[],"/docs/pr-preview/pr-55/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_3172":701,"_28058":690,"_5":28398,"_19443":47646,"_25550":47647,"_2667":47648},[],"/docs/pr-preview/pr-55/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_3172":702,"_28058":690,"_5":28398,"_19443":47650,"_25550":47651,"_2667":47652},[],"/docs/pr-preview/pr-55/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_3172":703,"_28058":690,"_19443":47654,"_5":13331,"_25550":690,"_2667":47655},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_3172":704,"_28058":690,"_19443":47657,"_5":13331,"_25550":47611,"_2667":47658},[],"The audit body includes:",{"_3172":705,"_28058":690,"_19443":47660,"_5":13331,"_25550":47611,"_2667":47661},[],"input: data received by the operation;",{"_3172":706,"_28058":690,"_19443":47663,"_5":13331,"_25550":47611,"_2667":47664},[],"has\\_error: whether the service returned an error;",{"_3172":707,"_28058":690,"_19443":47666,"_5":13331,"_25550":47611,"_2667":47667},[],"output: produced result or error message;",{"_3172":708,"_28058":690,"_19443":47669,"_5":13331,"_25550":47611,"_2667":47670},[],"principals: identifiers of the principals that matched the request.",{"_3172":709,"_28058":690,"_19443":47672,"_5":13331,"_25550":47611,"_2667":47673},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_3172":710,"_28058":690,"_19443":47675,"_5":13331,"_25550":47611,"_2667":47676},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_3172":711,"_28058":690,"_19443":47678,"_5":13331,"_25550":47615,"_2667":47679},[],"The backend applies auditing to mutations of:",{"_3172":712,"_28058":690,"_19443":47681,"_5":13331,"_25550":47615,"_2667":47682},[],"authorities, certificates and issuance profiles;",{"_3172":713,"_28058":690,"_19443":47684,"_5":13331,"_25550":47615,"_2667":47685},[],"keys and KMS engines;",{"_3172":714,"_28058":690,"_19443":47687,"_5":13331,"_25550":47615,"_2667":47688},[],"devices and identities;",{"_3172":715,"_28058":690,"_19443":47690,"_5":13331,"_25550":47615,"_2667":47691},[],"DMSs and enrollment operations;",{"_3172":716,"_28058":690,"_19443":47693,"_5":13331,"_25550":47615,"_2667":47694},[],"validation functions and CRL;",{"_3172":717,"_28058":690,"_19443":47696,"_5":13331,"_25550":47615,"_2667":47697},[],"principals, policies and authorization grants.",{"_3172":718,"_28058":690,"_19443":47699,"_5":13331,"_25550":47615,"_2667":47700},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_3172":719,"_28058":690,"_19443":47702,"_5":13331,"_25550":47619,"_2667":47703},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_3172":720,"_28058":690,"_19443":47705,"_5":13331,"_25550":47619,"_2667":47706},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_3172":721,"_28058":690,"_19443":47708,"_5":13331,"_25550":47619,"_2667":47709},[],"Design the consumer to:",{"_3172":722,"_28058":690,"_19443":47711,"_5":13331,"_25550":47619,"_2667":47712},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_3172":723,"_28058":690,"_19443":47714,"_5":13331,"_25550":47619,"_2667":47715},[],"keep the complete CloudEvent unmodified;",{"_3172":724,"_28058":690,"_19443":47717,"_5":13331,"_25550":47619,"_2667":47718},[],"record the ingestion time and detect duplicates by ID;",{"_3172":725,"_28058":690,"_19443":47720,"_5":13331,"_25550":47619,"_2667":47721},[],"encrypt in transit and at rest;",{"_3172":726,"_28058":690,"_19443":47723,"_5":13331,"_25550":47619,"_2667":47724},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_3172":727,"_28058":690,"_19443":47726,"_5":13331,"_25550":47619,"_2667":47727},[],"apply an explicit retention and legal hold policy;",{"_3172":728,"_28058":690,"_19443":47729,"_5":13331,"_25550":47619,"_2667":47730},[],"alert if it stops consuming or the pending queue grows.",{"_3172":729,"_28058":690,"_19443":47732,"_5":13331,"_25550":47623,"_2667":47733},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_3172":730,"_28058":690,"_19443":47735,"_5":13331,"_25550":47623,"_2667":47736},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_3172":731,"_28058":690,"_19443":47738,"_5":13331,"_25550":47631,"_2667":47739},[],"Start from the reported time and normalize every source to UTC.",{"_3172":732,"_28058":690,"_19443":47741,"_5":13331,"_25550":47635,"_2667":47742},[],"Filter by event type, service source and resource identifier.",{"_3172":733,"_28058":690,"_19443":47744,"_5":13331,"_25550":47639,"_2667":47745},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_3172":734,"_28058":690,"_19443":47747,"_5":13331,"_25550":47643,"_2667":47748},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_3172":735,"_28058":690,"_19443":47750,"_5":13331,"_25550":47647,"_2667":47751},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_3172":736,"_28058":690,"_19443":47753,"_5":13331,"_25550":47651,"_2667":47754},[],"Generate a controlled mutation in a test environment and check that:",{"_3172":737,"_28058":690,"_19443":47756,"_5":13331,"_25550":47651,"_2667":47757},[],"a successful audit event appears;",{"_3172":738,"_28058":690,"_19443":47759,"_5":13331,"_25550":47651,"_2667":47760},[],"the principal matches the identity used;",{"_3172":739,"_28058":690,"_19443":47762,"_5":13331,"_25550":47651,"_2667":47763},[],"the consumer persists it exactly once;",{"_3172":740,"_28058":690,"_19443":47765,"_5":13331,"_25550":47651,"_2667":47766},[],"it can be retrieved by resource, actor and period;",{"_3172":741,"_28058":690,"_19443":47768,"_5":13331,"_25550":47651,"_2667":47769},[],"a consumer outage raises an alert.",{"_3172":742,"_28058":690,"_19443":47771,"_5":13331,"_25550":47651,"_2667":47772},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_3172":743,"_28058":743,"_5":13662,"_2667":47774,"_28401":47775,"_19443":47776,"_25550":743},"Platform architecture",[45477,46870],[],{"_3172":744,"_28058":743,"_19443":47778,"_5":13331,"_25550":743,"_2667":47779},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_3172":745,"_28058":743,"_5":28398,"_19443":47781,"_25550":47782,"_2667":47783},[],"/docs/pr-preview/pr-55/platform/concepts/architecture#control-plane","Control plane",{"_3172":746,"_28058":743,"_5":28398,"_19443":47785,"_25550":47786,"_2667":47787},[],"/docs/pr-preview/pr-55/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_3172":747,"_28058":743,"_5":28398,"_19443":47789,"_25550":47790,"_2667":47791},[],"/docs/pr-preview/pr-55/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_3172":748,"_28058":743,"_5":28398,"_19443":47793,"_25550":47794,"_2667":47795},[],"/docs/pr-preview/pr-55/platform/concepts/architecture#status-and-validation","Status and validation",{"_3172":749,"_28058":743,"_5":28398,"_19443":47797,"_25550":47798,"_2667":47799},[],"/docs/pr-preview/pr-55/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_3172":750,"_28058":743,"_19443":47801,"_5":13331,"_25550":743,"_2667":47802},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_3172":751,"_28058":743,"_19443":47804,"_5":13331,"_25550":743,"_2667":47805},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_3172":752,"_28058":743,"_19443":47807,"_5":13331,"_25550":47782,"_2667":47808},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_3172":753,"_28058":743,"_19443":47810,"_5":13331,"_25550":47786,"_2667":47811},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_3172":754,"_28058":743,"_19443":47813,"_5":13331,"_25550":47790,"_2667":47814},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_3172":755,"_28058":743,"_19443":47816,"_5":13331,"_25550":47794,"_2667":47817},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_3172":756,"_28058":743,"_19443":47819,"_5":13331,"_25550":47798,"_2667":47820},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_3172":757,"_28058":757,"_5":13662,"_2667":47822,"_28401":47823,"_19443":47824,"_25550":757},"How Lamassu works",[45477,46870],[],{"_3172":758,"_28058":757,"_19443":47826,"_5":13331,"_25550":757,"_2667":47827},[],"The mental model of trust, keys, certificates and devices.",{"_3172":759,"_28058":757,"_5":28398,"_19443":47829,"_25550":47830,"_2667":47831},[],"/docs/pr-preview/pr-55/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_3172":760,"_28058":757,"_5":28398,"_19443":47833,"_25550":47834,"_2667":47835},[],"/docs/pr-preview/pr-55/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_3172":761,"_28058":757,"_19443":47837,"_5":13331,"_25550":757,"_2667":47838},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_3172":762,"_28058":757,"_19443":47840,"_5":13331,"_25550":47830,"_2667":47841},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_3172":763,"_28058":757,"_19443":47843,"_5":13331,"_25550":47830,"_2667":47844},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_3172":764,"_28058":757,"_19443":47846,"_5":13331,"_25550":47830,"_2667":47847},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_3172":765,"_28058":757,"_19443":47849,"_5":13331,"_25550":47830,"_2667":47850},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_3172":766,"_28058":757,"_19443":47852,"_5":13331,"_25550":47830,"_2667":47853},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_3172":767,"_28058":757,"_19443":47855,"_5":13331,"_25550":47834,"_2667":47856},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_3172":768,"_28058":757,"_19443":47858,"_5":13331,"_25550":47834,"_2667":47859},[],"A DMS relates that CA to an enrollment policy.",{"_3172":769,"_28058":757,"_19443":47861,"_5":13331,"_25550":47834,"_2667":47862},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_3172":770,"_28058":757,"_19443":47864,"_5":13331,"_25550":47834,"_2667":47865},[],"Lamassu keeps the inventory, history and status of the identity.",{"_3172":771,"_28058":757,"_19443":47867,"_5":13331,"_25550":47834,"_2667":47868},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_3172":772,"_28058":757,"_19443":47870,"_5":13331,"_25550":47834,"_2667":47871},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_3172":773,"_28058":757,"_19443":47873,"_5":13331,"_25550":47834,"_2667":47874},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3172":774,"_28058":774,"_5":13662,"_2667":47876,"_28401":47877,"_19443":47879,"_25550":774},"Devices and identities",[45477,46870,47878,47876],"IoT Fleets",[],{"_3172":775,"_28058":774,"_19443":47881,"_5":13331,"_25550":774,"_2667":47882},[],"Register, inspect and retire devices while checking their current identity and history.",{"_3172":776,"_28058":774,"_5":28398,"_19443":47884,"_25550":47885,"_2667":47886},[],"/docs/pr-preview/pr-55/platform/iot-fleets/device-management#device-states","Device states",{"_3172":777,"_28058":774,"_5":28398,"_19443":47888,"_25550":47889,"_2667":47890},[],"/docs/pr-preview/pr-55/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_3172":778,"_28058":774,"_5":28398,"_19443":47892,"_25550":47893,"_2667":47894},[],"/docs/pr-preview/pr-55/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_3172":779,"_28058":774,"_5":28398,"_19443":47896,"_25550":47897,"_2667":47898},[],"/docs/pr-preview/pr-55/platform/iot-fleets/device-management#create-the-device","Create the device",{"_3172":780,"_28058":774,"_5":28398,"_19443":47900,"_25550":47901,"_2667":47902},[],"/docs/pr-preview/pr-55/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_3172":781,"_28058":774,"_5":28398,"_19443":47904,"_25550":47905,"_2667":47906},[],"/docs/pr-preview/pr-55/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_3172":782,"_28058":774,"_5":28398,"_19443":47908,"_25550":47909,"_2667":47910},[],"/docs/pr-preview/pr-55/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_3172":783,"_28058":774,"_5":28398,"_19443":47912,"_25550":47913,"_2667":47914},[],"/docs/pr-preview/pr-55/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_3172":784,"_28058":774,"_5":28398,"_19443":47916,"_25550":47917,"_2667":47918},[],"/docs/pr-preview/pr-55/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_3172":785,"_28058":774,"_5":28398,"_19443":47920,"_25550":47921,"_2667":47922},[],"/docs/pr-preview/pr-55/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_3172":786,"_28058":774,"_5":28398,"_19443":47924,"_25550":47925,"_2667":47926},[],"/docs/pr-preview/pr-55/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_3172":787,"_28058":774,"_19443":47928,"_5":13331,"_25550":774,"_2667":47929},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_3172":788,"_28058":774,"_19443":47931,"_5":13331,"_25550":774,"_2667":47932},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_3172":789,"_28058":774,"_19443":47934,"_5":13331,"_25550":47885,"_2667":47935},[],"Operational view",{"_3172":790,"_28058":774,"_19443":47937,"_5":13331,"_25550":47885,"_2667":47938},[],"Meaning",{"_3172":791,"_28058":774,"_19443":47940,"_5":13331,"_25550":47885,"_2667":47941},[],"**No Identity**",{"_3172":792,"_28058":774,"_19443":47943,"_5":13331,"_25550":47885,"_2667":47944},[],"A record exists without an associated identity.",{"_3172":793,"_28058":774,"_19443":47946,"_5":13331,"_25550":47885,"_2667":47947},[],"**Active**",{"_3172":794,"_28058":774,"_19443":47949,"_5":13331,"_25550":47885,"_2667":47950},[],"The slot is active; also check certificate dates, status and usages.",{"_3172":795,"_28058":774,"_19443":47952,"_5":13331,"_25550":47885,"_2667":47953},[],"**Renewal Pending**",{"_3172":796,"_28058":774,"_19443":47955,"_5":13331,"_25550":47885,"_2667":47956},[],"The identity is in the operational renewal window.",{"_3172":797,"_28058":774,"_19443":47958,"_5":13331,"_25550":47885,"_2667":47959},[],"**Expiring Soon**",{"_3172":798,"_28058":774,"_19443":47961,"_5":13331,"_25550":47885,"_2667":47962},[],"Expiration is approaching according to configured thresholds.",{"_3172":799,"_28058":774,"_19443":47964,"_5":13331,"_25550":47885,"_2667":47965},[],"**Expired**",{"_3172":800,"_28058":774,"_19443":47967,"_5":13331,"_25550":47885,"_2667":47968},[],"The identity has expired.",{"_3172":801,"_28058":774,"_19443":47970,"_5":13331,"_25550":47885,"_2667":47971},[],"**Revoked**",{"_3172":802,"_28058":774,"_19443":47973,"_5":13331,"_25550":47885,"_2667":47974},[],"The identity is marked revoked.",{"_3172":803,"_28058":774,"_19443":47976,"_5":13331,"_25550":47885,"_2667":47977},[],"**Decommissioned**",{"_3172":804,"_28058":774,"_19443":47979,"_5":13331,"_25550":47885,"_2667":47980},[],"The record is retired and ordinary updates do not restore operation.",{"_3172":805,"_28058":774,"_19443":47982,"_5":13331,"_25550":47885,"_2667":47983},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_3172":806,"_28058":774,"_19443":47985,"_5":13331,"_25550":47889,"_2667":47986},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_3172":807,"_28058":774,"_19443":47988,"_5":13331,"_25550":47889,"_2667":47989},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_3172":808,"_28058":774,"_19443":47991,"_5":13331,"_25550":47889,"_2667":47992},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_3172":809,"_28058":774,"_19443":47994,"_5":13331,"_25550":47889,"_2667":47995},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_3172":810,"_28058":774,"_19443":47997,"_5":13331,"_25550":47893,"_2667":47998},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_3172":811,"_28058":774,"_19443":48000,"_5":13331,"_25550":47897,"_2667":48001},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_3172":812,"_28058":774,"_19443":48003,"_5":13331,"_25550":47901,"_2667":48004},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_3172":813,"_28058":774,"_19443":48006,"_5":13331,"_25550":47905,"_2667":48007},[],"Add model, environment or location tags and an icon according to your inventory.",{"_3172":814,"_28058":774,"_19443":48009,"_5":13331,"_25550":47909,"_2667":48010},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_3172":815,"_28058":774,"_19443":48012,"_5":13331,"_25550":47909,"_2667":48013},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_3172":816,"_28058":774,"_19443":48015,"_5":13331,"_25550":47913,"_2667":48016},[],"From **No Identity**, use **Assign Identity**:",{"_3172":817,"_28058":774,"_19443":48018,"_5":13331,"_25550":47913,"_2667":48019},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_3172":818,"_28058":774,"_19443":48021,"_5":13331,"_25550":47913,"_2667":48022},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_3172":819,"_28058":774,"_19443":48024,"_5":13331,"_25550":47913,"_2667":48025},[],"Confirm and read the serial, active version and history again.",{"_3172":820,"_28058":774,"_19443":48027,"_5":13331,"_25550":47913,"_2667":48028},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_3172":821,"_28058":774,"_19443":48030,"_5":13331,"_25550":47913,"_2667":48031},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_3172":822,"_28058":774,"_19443":48033,"_5":13331,"_25550":47917,"_2667":48034},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_3172":823,"_28058":774,"_19443":48036,"_5":13331,"_25550":47917,"_2667":48037},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_3172":824,"_28058":774,"_19443":48039,"_5":13331,"_25550":47921,"_2667":48040},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_3172":825,"_28058":774,"_19443":48042,"_5":13331,"_25550":47921,"_2667":48043},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_3172":826,"_28058":774,"_19443":48045,"_5":13331,"_25550":47921,"_2667":48046},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_3172":827,"_28058":774,"_19443":48048,"_5":13331,"_25550":47921,"_2667":48049},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_3172":828,"_28058":774,"_19443":48051,"_5":13331,"_25550":47925,"_2667":48052},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3172":829,"_28058":774,"_19443":48054,"_5":13331,"_25550":47925,"_2667":48055},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3172":830,"_28058":830,"_5":13662,"_2667":48057,"_28401":48058,"_19443":48060,"_25550":830},"Bootstrap identity and authentication",[45477,46870,47878,47876,48059],"Enrollment with PKI",[],{"_3172":831,"_28058":830,"_19443":48062,"_5":13331,"_25550":830,"_2667":48063},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_3172":832,"_28058":830,"_5":28398,"_19443":48065,"_25550":48066,"_2667":48067},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_3172":833,"_28058":830,"_5":28398,"_19443":48069,"_25550":48070,"_2667":48071},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_3172":834,"_28058":830,"_5":28398,"_19443":48073,"_25550":48074,"_2667":48075},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_3172":835,"_28058":830,"_5":28398,"_19443":48077,"_25550":48078,"_2667":48079},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_3172":836,"_28058":830,"_5":28398,"_19443":48081,"_25550":48082,"_2667":48083},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_3172":837,"_28058":830,"_19443":48085,"_5":13331,"_25550":830,"_2667":48086},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_3172":838,"_28058":830,"_19443":48088,"_5":13331,"_25550":48066,"_2667":48089},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_3172":839,"_28058":830,"_19443":48091,"_5":13331,"_25550":48066,"_2667":48092},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_3172":840,"_28058":830,"_19443":48094,"_5":13331,"_25550":48070,"_2667":48095},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_3172":841,"_28058":830,"_19443":48097,"_5":13331,"_25550":48070,"_2667":48098},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_3172":842,"_28058":830,"_19443":48100,"_5":13331,"_25550":48070,"_2667":48101},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_3172":843,"_28058":830,"_19443":48103,"_5":13331,"_25550":48074,"_2667":48104},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_3172":844,"_28058":830,"_19443":48106,"_5":13331,"_25550":48074,"_2667":48107},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_3172":845,"_28058":830,"_19443":48109,"_5":13331,"_25550":48078,"_2667":48110},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_3172":846,"_28058":830,"_19443":48112,"_5":13331,"_25550":48078,"_2667":48113},[],"Example body:",{"_3172":847,"_28058":830,"_19443":48115,"_5":13331,"_25550":48078,"_2667":48116},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_3172":848,"_28058":830,"_19443":48118,"_5":13331,"_25550":48078,"_2667":48119},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_3172":849,"_28058":830,"_19443":48121,"_5":13331,"_25550":48078,"_2667":48122},[],"Continuation requires a successful HTTP response and JSON:",{"_3172":850,"_28058":830,"_19443":48124,"_5":13331,"_25550":48078,"_2667":48125},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_3172":851,"_28058":830,"_19443":48127,"_5":13331,"_25550":48082,"_2667":48128},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_3172":852,"_28058":830,"_19443":48130,"_5":13331,"_25550":48082,"_2667":48131},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_3172":853,"_28058":853,"_5":13662,"_2667":48133,"_28401":48134,"_19443":48135,"_25550":853},"Configure and operate the DMS",[45477,46870,47878,47876,48059],[],{"_3172":854,"_28058":853,"_19443":48137,"_5":13331,"_25550":853,"_2667":48138},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_3172":855,"_28058":853,"_5":28398,"_19443":48140,"_25550":48141,"_2667":45487},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/dms#before-you-begin",{"_3172":856,"_28058":853,"_5":28398,"_19443":48143,"_25550":48144,"_2667":48145},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_3172":857,"_28058":853,"_5":28398,"_19443":48147,"_25550":48148,"_2667":48149},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_3172":858,"_28058":853,"_5":28398,"_19443":48151,"_25550":48152,"_2667":48153},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_3172":859,"_28058":853,"_5":28398,"_19443":48155,"_25550":48156,"_2667":48157},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_3172":860,"_28058":853,"_5":28398,"_19443":48159,"_25550":48160,"_2667":48161},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_3172":861,"_28058":853,"_5":28398,"_19443":48163,"_25550":48164,"_2667":48165},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_3172":862,"_28058":853,"_5":28398,"_19443":48167,"_25550":48168,"_2667":48169},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_3172":863,"_28058":853,"_5":28398,"_19443":48171,"_25550":48172,"_2667":48173},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_3172":864,"_28058":853,"_5":28398,"_19443":48175,"_25550":48176,"_2667":48177},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_3172":865,"_28058":853,"_5":28398,"_19443":48179,"_25550":48180,"_2667":48181},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_3172":866,"_28058":853,"_5":28398,"_19443":48183,"_25550":48184,"_2667":48185},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_3172":867,"_28058":853,"_5":28398,"_19443":48187,"_25550":48188,"_2667":48189},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_3172":868,"_28058":853,"_5":28398,"_19443":48191,"_25550":48192,"_2667":48193},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_3172":869,"_28058":853,"_5":28398,"_19443":48195,"_25550":48196,"_2667":48197},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_3172":870,"_28058":853,"_5":28398,"_19443":48199,"_25550":48200,"_2667":48201},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_3172":871,"_28058":853,"_5":28398,"_19443":48203,"_25550":48204,"_2667":48205},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_3172":872,"_28058":853,"_5":28398,"_19443":48207,"_25550":48208,"_2667":48209},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_3172":873,"_28058":853,"_19443":48211,"_5":13331,"_25550":853,"_2667":48212},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_3172":874,"_28058":853,"_19443":48214,"_5":13331,"_25550":48141,"_2667":48215},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_3172":875,"_28058":853,"_19443":48217,"_5":13331,"_25550":48141,"_2667":48218},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_3172":876,"_28058":853,"_19443":48220,"_5":13331,"_25550":48148,"_2667":48221},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_3172":877,"_28058":853,"_19443":48223,"_5":13331,"_25550":48152,"_2667":48224},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_3172":878,"_28058":853,"_19443":48226,"_5":13331,"_25550":48156,"_2667":48227},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_3172":879,"_28058":853,"_19443":48229,"_5":13331,"_25550":48160,"_2667":48230},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_3172":880,"_28058":853,"_19443":48232,"_5":13331,"_25550":48164,"_2667":48233},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_3172":881,"_28058":853,"_19443":48235,"_5":13331,"_25550":48172,"_2667":48236},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_3172":882,"_28058":853,"_19443":48238,"_5":13331,"_25550":48172,"_2667":48239},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_3172":883,"_28058":853,"_19443":48241,"_5":13331,"_25550":48176,"_2667":48242},[],"`settings.enrollment_settings` field",{"_3172":884,"_28058":853,"_19443":48244,"_5":13331,"_25550":48176,"_2667":48245},[],"Decision",{"_3172":885,"_28058":853,"_19443":48247,"_5":13331,"_25550":48176,"_2667":48248},[],"`protocol`",{"_3172":886,"_28058":853,"_19443":48250,"_5":13331,"_25550":48176,"_2667":48251},[],"`EST_RFC7030` for these operations.",{"_3172":887,"_28058":853,"_19443":48253,"_5":13331,"_25550":48176,"_2667":48254},[],"`enrollment_ca`",{"_3172":888,"_28058":853,"_19443":48256,"_5":13331,"_25550":48176,"_2667":48257},[],"ID of the signing CA.",{"_3172":889,"_28058":853,"_19443":48259,"_5":13331,"_25550":48176,"_2667":48260},[],"`verify_csr_signature`",{"_3172":890,"_28058":853,"_19443":48262,"_5":13331,"_25550":48176,"_2667":48263},[],"Keep `true` to verify CSR key possession.",{"_3172":891,"_28058":853,"_19443":48265,"_5":13331,"_25550":48176,"_2667":48266},[],"`enable_replaceable_enrollment`",{"_3172":892,"_28058":853,"_19443":48268,"_5":13331,"_25550":48176,"_2667":48269},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_3172":893,"_28058":853,"_19443":48271,"_5":13331,"_25550":48176,"_2667":48272},[],"`est_rfc7030_settings.auth_mode`",{"_3172":894,"_28058":853,"_19443":48274,"_5":13331,"_25550":48176,"_2667":48275},[],"One of the four authentication modes.",{"_3172":895,"_28058":853,"_19443":48277,"_5":13331,"_25550":48176,"_2667":48278},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_3172":896,"_28058":853,"_19443":48280,"_5":13331,"_25550":48180,"_2667":48281},[],"The blocks are independent:",{"_3172":897,"_28058":853,"_19443":48283,"_5":13331,"_25550":48180,"_2667":48284},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_3172":898,"_28058":853,"_19443":48286,"_5":13331,"_25550":48180,"_2667":48287},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_3172":899,"_28058":853,"_19443":48289,"_5":13331,"_25550":48180,"_2667":48290},[],"`auth_mode`",{"_3172":900,"_28058":853,"_19443":48292,"_5":13331,"_25550":48180,"_2667":48293},[],"Control applied in the configured operation",{"_3172":901,"_28058":853,"_19443":48295,"_5":13331,"_25550":48180,"_2667":48296},[],"`CLIENT_CERTIFICATE`",{"_3172":902,"_28058":853,"_19443":48298,"_5":13331,"_25550":48180,"_2667":48299},[],"Presented certificate validation.",{"_3172":903,"_28058":853,"_19443":48301,"_5":13331,"_25550":48180,"_2667":48302},[],"`EXTERNAL_WEBHOOK`",{"_3172":904,"_28058":853,"_19443":48304,"_5":13331,"_25550":48180,"_2667":48305},[],"Configured webhook authorization.",{"_3172":905,"_28058":853,"_19443":48307,"_5":13331,"_25550":48180,"_2667":48308},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3172":906,"_28058":853,"_19443":48310,"_5":13331,"_25550":48180,"_2667":48311},[],"Certificate validation followed by webhook approval.",{"_3172":907,"_28058":853,"_19443":48313,"_5":13331,"_25550":48180,"_2667":48314},[],"`NO_AUTH`",{"_3172":908,"_28058":853,"_19443":48316,"_5":13331,"_25550":48180,"_2667":48317},[],"No DMS requester authentication.",{"_3172":909,"_28058":853,"_19443":48319,"_5":13331,"_25550":48180,"_2667":48320},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_3172":910,"_28058":853,"_19443":48322,"_5":13331,"_25550":48180,"_2667":48323},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_3172":911,"_28058":853,"_19443":48325,"_5":13331,"_25550":48180,"_2667":48326},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs. That list is optional because the enrollment CA is always trusted for re-enrollment, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`.",{"_3172":912,"_28058":853,"_19443":48328,"_5":13331,"_25550":48180,"_2667":48329},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_3172":913,"_28058":853,"_19443":48331,"_5":13331,"_25550":48184,"_2667":48332},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_3172":914,"_28058":853,"_19443":48334,"_5":13331,"_25550":48184,"_2667":48335},[],"`external_webhook_settings` field",{"_3172":915,"_28058":853,"_19443":48337,"_5":13331,"_25550":48184,"_2667":48245},[],{"_3172":916,"_28058":853,"_19443":48339,"_5":13331,"_25550":48184,"_2667":48340},[],"`url`",{"_3172":917,"_28058":853,"_19443":48342,"_5":13331,"_25550":48184,"_2667":48343},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_3172":918,"_28058":853,"_19443":48345,"_5":13331,"_25550":48184,"_2667":48346},[],"`method`",{"_3172":919,"_28058":853,"_19443":48348,"_5":13331,"_25550":48184,"_2667":48349},[],"`POST` or `PUT`; `POST` by default.",{"_3172":920,"_28058":853,"_19443":48351,"_5":13331,"_25550":48184,"_2667":48352},[],"`name`",{"_3172":921,"_28058":853,"_19443":48354,"_5":13331,"_25550":48184,"_2667":48355},[],"Label used in service logs.",{"_3172":922,"_28058":853,"_19443":48357,"_5":13331,"_25550":48184,"_2667":48358},[],"`config.auth_mode`",{"_3172":923,"_28058":853,"_19443":48360,"_5":13331,"_25550":48184,"_2667":48361},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_3172":924,"_28058":853,"_19443":48363,"_5":13331,"_25550":48184,"_2667":48364},[],"`config.log_level`",{"_3172":925,"_28058":853,"_19443":48366,"_5":13331,"_25550":48184,"_2667":48367},[],"Log level of the webhook call: `debug`, `info`, `warn` or `error`; `info` by default.",{"_3172":926,"_28058":853,"_19443":48369,"_5":13331,"_25550":48184,"_2667":48370},[],"`config.apikey_options`",{"_3172":927,"_28058":853,"_19443":48372,"_5":13331,"_25550":48184,"_2667":48373},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_3172":928,"_28058":853,"_19443":48375,"_5":13331,"_25550":48184,"_2667":48376},[],"`config.jwt_options`",{"_3172":929,"_28058":853,"_19443":48378,"_5":13331,"_25550":48184,"_2667":48379},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3172":930,"_28058":853,"_19443":48381,"_5":13331,"_25550":48184,"_2667":48382},[],"`config.mtls_options`",{"_3172":931,"_28058":853,"_19443":48384,"_5":13331,"_25550":48184,"_2667":48385},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_3172":932,"_28058":853,"_19443":48387,"_5":13331,"_25550":48184,"_2667":48388},[],"`config.insecure_skip_verify`",{"_3172":933,"_28058":853,"_19443":48390,"_5":13331,"_25550":48184,"_2667":48391},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_3172":934,"_28058":853,"_19443":48393,"_5":13331,"_25550":48184,"_2667":48394},[],"`config.call_timeout`",{"_3172":935,"_28058":853,"_19443":48396,"_5":13331,"_25550":48184,"_2667":48397},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_3172":936,"_28058":853,"_19443":48399,"_5":13331,"_25550":48184,"_2667":48400},[],"Rules for that configuration:",{"_3172":937,"_28058":853,"_19443":48402,"_5":13331,"_25550":48184,"_2667":48403},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_3172":938,"_28058":853,"_19443":48405,"_5":13331,"_25550":48184,"_2667":48406},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_3172":939,"_28058":853,"_19443":48408,"_5":13331,"_25550":48184,"_2667":48409},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_3172":940,"_28058":853,"_19443":48411,"_5":13331,"_25550":48184,"_2667":48412},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_3172":941,"_28058":853,"_19443":48414,"_5":13331,"_25550":48184,"_2667":48415},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_3172":942,"_28058":853,"_19443":48417,"_5":13331,"_25550":48184,"_2667":48418},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_3172":943,"_28058":853,"_19443":48420,"_5":13331,"_25550":48184,"_2667":48421},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing. The console exposes independent editors for the enrollment and re-enrollment authentication, with the same Log Level, Call Timeout, HTTP Authentication and credential fields as the webhook channels, plus a **Skip TLS Verification** switch (off by default, so verification stays on; the console warns when you enable it).",{"_3172":944,"_28058":853,"_19443":48423,"_5":13331,"_25550":48184,"_2667":48424},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. To fix it in the console, open the DMS, replace any file-path value with PEM content — the editor rejects file paths with an inline field error — and save. Saving rewrites `external_webhook_settings.config` with the current keys, and the console reads both plain and Base64-encoded PEM from migrated configurations and stores the material Base64-encoded. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_3172":945,"_28058":853,"_19443":48426,"_5":13331,"_25550":48184,"_2667":48427},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_3172":946,"_28058":853,"_19443":48429,"_5":13331,"_25550":48188,"_2667":48430},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_3172":947,"_28058":853,"_19443":48432,"_5":13331,"_25550":48192,"_2667":48433},[],"`settings.reenrollment_settings` field",{"_3172":948,"_28058":853,"_19443":48435,"_5":13331,"_25550":48192,"_2667":45867},[],{"_3172":949,"_28058":853,"_19443":48437,"_5":13331,"_25550":48192,"_2667":48438},[],"`reenrollment_delta`",{"_3172":950,"_28058":853,"_19443":48440,"_5":13331,"_25550":48192,"_2667":48441},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_3172":951,"_28058":853,"_19443":48443,"_5":13331,"_25550":48192,"_2667":48444},[],"`preventive_delta`",{"_3172":952,"_28058":853,"_19443":48446,"_5":13331,"_25550":48192,"_2667":48447},[],"Preventive operational monitoring threshold.",{"_3172":953,"_28058":853,"_19443":48449,"_5":13331,"_25550":48192,"_2667":48450},[],"`critical_delta`",{"_3172":954,"_28058":853,"_19443":48452,"_5":13331,"_25550":48192,"_2667":48453},[],"Critical operational monitoring threshold.",{"_3172":955,"_28058":853,"_19443":48455,"_5":13331,"_25550":48192,"_2667":48456},[],"`enable_expired_renewal`",{"_3172":956,"_28058":853,"_19443":48458,"_5":13331,"_25550":48192,"_2667":48459},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_3172":957,"_28058":853,"_19443":48461,"_5":13331,"_25550":48192,"_2667":48462},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_3172":958,"_28058":853,"_19443":48464,"_5":13331,"_25550":48192,"_2667":48465},[],"Re-enrollment validation CAs for the renewal mTLS credential, tried after the enrollment CA; optional, because the enrollment CA is always trusted. Typically populated during CA rotation while old-CA cohorts renew.",{"_3172":959,"_28058":853,"_19443":48467,"_5":13331,"_25550":48192,"_2667":48468},[],"`revoke_on_reenrollment`",{"_3172":960,"_28058":853,"_19443":48470,"_5":13331,"_25550":48192,"_2667":48471},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_3172":961,"_28058":853,"_19443":48473,"_5":13331,"_25550":48192,"_2667":48474},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_3172":962,"_28058":853,"_19443":48476,"_5":13331,"_25550":48196,"_2667":48477},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. The console exposes it through an **Enable server-side key generation** switch and a **Key type** selection: `ECDSA` P-256, P-384 or P-521, or `RSA` with 2048, 3072 or 4096 bits; the defaults are P-256 for `ECDSA` and 4096 bit for `RSA`. Algorithm and size come from its `key` field, stored as `{type,bits}` where P-256, P-384 and P-521 map to `bits` 256, 384 and 521; `key` is omitted when disabled. The profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_3172":963,"_28058":853,"_19443":48479,"_5":13331,"_25550":48200,"_2667":45861},[],{"_3172":964,"_28058":853,"_19443":48481,"_5":13331,"_25550":48200,"_2667":48482},[],"Published material",{"_3172":965,"_28058":853,"_19443":48484,"_5":13331,"_25550":48200,"_2667":48485},[],"**Include Lamassu System CA**",{"_3172":966,"_28058":853,"_19443":48487,"_5":13331,"_25550":48200,"_2667":48488},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_3172":967,"_28058":853,"_19443":48490,"_5":13331,"_25550":48200,"_2667":48491},[],"**Include Enrollment CA**",{"_3172":968,"_28058":853,"_19443":48493,"_5":13331,"_25550":48200,"_2667":48494},[],"Selected issuing CA certificate.",{"_3172":969,"_28058":853,"_19443":48496,"_5":13331,"_25550":48200,"_2667":48497},[],"**Managed CAs**",{"_3172":970,"_28058":853,"_19443":48499,"_5":13331,"_25550":48200,"_2667":48500},[],"Explicitly selected CA certificates.",{"_3172":971,"_28058":853,"_19443":48502,"_5":13331,"_25550":48200,"_2667":48503},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_3172":972,"_28058":853,"_19443":48505,"_5":13331,"_25550":48204,"_2667":48506},[],"**Edit** changes name, settings and metadata. Backend updates replace these complete blocks; read the DMS before sending API edits to avoid losing fields.",{"_3172":973,"_28058":853,"_19443":48508,"_5":13331,"_25550":48204,"_2667":48509},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_3172":974,"_28058":853,"_19443":48511,"_5":13331,"_25550":48204,"_2667":48512},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_3172":975,"_28058":853,"_19443":48514,"_5":13331,"_25550":48208,"_2667":48515},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_3172":976,"_28058":976,"_5":13662,"_2667":48517,"_28401":48518,"_19443":48519,"_25550":976},"Integrate the EST client",[45477,46870,47878,47876,48059],[],{"_3172":977,"_28058":976,"_19443":48521,"_5":13331,"_25550":976,"_2667":48522},[],"Prepare trust, send a CSR and check the identity you receive.",{"_3172":978,"_28058":976,"_5":28398,"_19443":48524,"_25550":48525,"_2667":45487},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_3172":979,"_28058":976,"_5":28398,"_19443":48527,"_25550":48528,"_2667":48529},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_3172":980,"_28058":976,"_5":28398,"_19443":48531,"_25550":48532,"_2667":48533},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_3172":981,"_28058":976,"_5":28398,"_19443":48535,"_25550":48536,"_2667":48537},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_3172":982,"_28058":976,"_5":28398,"_19443":48539,"_25550":48540,"_2667":48541},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_3172":983,"_28058":976,"_5":28398,"_19443":48543,"_25550":48544,"_2667":48545},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_3172":984,"_28058":976,"_19443":48547,"_5":13331,"_25550":976,"_2667":48548},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_3172":985,"_28058":976,"_19443":48550,"_5":13331,"_25550":48525,"_2667":48551},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_3172":986,"_28058":976,"_19443":48553,"_5":13331,"_25550":48525,"_2667":48554},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_3172":987,"_28058":976,"_19443":48556,"_5":13331,"_25550":48525,"_2667":48557},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_3172":988,"_28058":976,"_19443":48559,"_5":13331,"_25550":48528,"_2667":48560},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_3172":989,"_28058":976,"_19443":48562,"_5":13331,"_25550":48528,"_2667":48563},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_3172":990,"_28058":976,"_19443":48565,"_5":13331,"_25550":48532,"_2667":48566},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_3172":991,"_28058":976,"_19443":48568,"_5":13331,"_25550":48532,"_2667":48569},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_3172":992,"_28058":976,"_19443":48571,"_5":13331,"_25550":48536,"_2667":48572},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_3172":993,"_28058":976,"_19443":48574,"_5":13331,"_25550":48536,"_2667":48575},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_3172":994,"_28058":976,"_19443":48577,"_5":13331,"_25550":48540,"_2667":48578},[],"For a root that issues directly:",{"_3172":995,"_28058":976,"_19443":48580,"_5":13331,"_25550":48540,"_2667":48581},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_3172":996,"_28058":976,"_19443":48583,"_5":13331,"_25550":48540,"_2667":48584},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_3172":997,"_28058":976,"_19443":48586,"_5":13331,"_25550":48544,"_2667":48587},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_3172":998,"_28058":998,"_5":13662,"_2667":48589,"_28401":48590,"_19443":48591,"_25550":998},"EST reference",[45477,46870,47878,47876,48059],[],{"_3172":999,"_28058":998,"_19443":48593,"_5":13331,"_25550":998,"_2667":48594},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_3172":1000,"_28058":998,"_5":28398,"_19443":48596,"_25550":48597,"_2667":48598},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_3172":1001,"_28058":998,"_5":28398,"_19443":48600,"_25550":48601,"_2667":21138},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3172":1002,"_28058":998,"_5":28398,"_19443":48603,"_25550":48604,"_2667":24236},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3172":1003,"_28058":998,"_5":28398,"_19443":48606,"_25550":48607,"_2667":24243},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3172":1004,"_28058":998,"_5":28398,"_19443":48609,"_25550":48610,"_2667":23588},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3172":1005,"_28058":998,"_5":28398,"_19443":48612,"_25550":48613,"_2667":48614},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_3172":1006,"_28058":998,"_5":28398,"_19443":48616,"_25550":48617,"_2667":48618},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_3172":1007,"_28058":998,"_5":28398,"_19443":48620,"_25550":48621,"_2667":48622},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_3172":1008,"_28058":998,"_19443":48624,"_5":13331,"_25550":998,"_2667":48625},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_3172":1009,"_28058":998,"_19443":48627,"_5":13331,"_25550":48597,"_2667":48628},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_3172":1010,"_28058":998,"_19443":48630,"_5":13331,"_25550":48597,"_2667":48631},[],"Operation",{"_3172":1011,"_28058":998,"_19443":48633,"_5":13331,"_25550":48597,"_2667":48634},[],"Method",{"_3172":1012,"_28058":998,"_19443":48636,"_5":13331,"_25550":48597,"_2667":48637},[],"Authentication and condition",{"_3172":1013,"_28058":998,"_19443":48639,"_5":13331,"_25550":48597,"_2667":48640},[],"`/cacerts`",{"_3172":1014,"_28058":998,"_19443":48642,"_5":13331,"_25550":48597,"_2667":48643},[],"GET",{"_3172":1015,"_28058":998,"_19443":48645,"_5":13331,"_25550":48597,"_2667":48646},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_3172":1016,"_28058":998,"_19443":48648,"_5":13331,"_25550":48597,"_2667":48649},[],"`/simpleenroll`",{"_3172":1017,"_28058":998,"_19443":48651,"_5":13331,"_25550":48597,"_2667":48652},[],"POST",{"_3172":1018,"_28058":998,"_19443":48654,"_5":13331,"_25550":48597,"_2667":48655},[],"Initial authentication and DMS registration/replacement policy.",{"_3172":1019,"_28058":998,"_19443":48657,"_5":13331,"_25550":48597,"_2667":48658},[],"`/simplereenroll`",{"_3172":1020,"_28058":998,"_19443":48660,"_5":13331,"_25550":48597,"_2667":48652},[],{"_3172":1021,"_28058":998,"_19443":48662,"_5":13331,"_25550":48597,"_2667":48663},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_3172":1022,"_28058":998,"_19443":48665,"_5":13331,"_25550":48597,"_2667":48666},[],"`/serverkeygen`",{"_3172":1023,"_28058":998,"_19443":48668,"_5":13331,"_25550":48597,"_2667":48652},[],{"_3172":1024,"_28058":998,"_19443":48670,"_5":13331,"_25550":48597,"_2667":48671},[],"Initial authentication and admission; server generation enabled.",{"_3172":1025,"_28058":998,"_19443":48673,"_5":13331,"_25550":48597,"_2667":48674},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_3172":1026,"_28058":998,"_19443":48676,"_5":13331,"_25550":48601,"_2667":48677},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_3172":1027,"_28058":998,"_19443":48679,"_5":13331,"_25550":48601,"_2667":48680},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_3172":1028,"_28058":998,"_19443":48682,"_5":13331,"_25550":48604,"_2667":48683},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_3172":1029,"_28058":998,"_19443":48685,"_5":13331,"_25550":48604,"_2667":48686},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_3172":1030,"_28058":998,"_19443":48688,"_5":13331,"_25550":48607,"_2667":48689},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_3172":1031,"_28058":998,"_19443":48691,"_5":13331,"_25550":48607,"_2667":48692},[],"In mTLS mode, the enrollment CA always validates the re-enrollment credential; certificates from other issuers are accepted only if they are listed as validation CAs in the re-enrollment block. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_3172":1032,"_28058":998,"_19443":48694,"_5":13331,"_25550":48610,"_2667":48695},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_3172":1033,"_28058":998,"_19443":48697,"_5":13331,"_25550":48610,"_2667":48698},[],"The code supports RSA and ECDSA, and the `bits` value of the DMS key setting means something different for each. For ECDSA it selects the curve: 224, 256, 384 or 521 map to P-224, P-256, P-384 and P-521, and an unrecognized size falls back to P-256, so explicitly select a compatible size and check the resulting key. For RSA it is used directly as the modulus size; the console offers 2048, 3072 and 4096 bits. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_3172":1034,"_28058":998,"_19443":48700,"_5":13331,"_25550":48613,"_2667":48701},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_3172":1035,"_28058":998,"_19443":48703,"_5":13331,"_25550":48613,"_2667":48704},[],"Part",{"_3172":1036,"_28058":998,"_19443":48706,"_5":13331,"_25550":48613,"_2667":48707},[],"Content after decoding its Base64",{"_3172":1037,"_28058":998,"_19443":48709,"_5":13331,"_25550":48613,"_2667":48710},[],"`application/pkcs8`",{"_3172":1038,"_28058":998,"_19443":48712,"_5":13331,"_25550":48613,"_2667":48713},[],"Unencrypted DER PKCS#8 private key.",{"_3172":1039,"_28058":998,"_19443":48715,"_5":13331,"_25550":48613,"_2667":48716},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_3172":1040,"_28058":998,"_19443":48718,"_5":13331,"_25550":48613,"_2667":48719},[],"DER PKCS#7 containing the issued certificate.",{"_3172":1041,"_28058":998,"_19443":48721,"_5":13331,"_25550":48613,"_2667":48722},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_3172":1042,"_28058":998,"_19443":48724,"_5":13331,"_25550":48617,"_2667":48725},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_3172":1043,"_28058":998,"_19443":48727,"_5":13331,"_25550":48617,"_2667":48728},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_3172":1044,"_28058":998,"_19443":48730,"_5":13331,"_25550":48617,"_2667":48731},[],"Convert and check the result:",{"_3172":1045,"_28058":998,"_19443":48733,"_5":13331,"_25550":48617,"_2667":48734},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_3172":1046,"_28058":998,"_19443":48736,"_5":13331,"_25550":48621,"_2667":48737},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_3172":1047,"_28058":998,"_19443":48739,"_5":13331,"_25550":48621,"_2667":48740},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_3172":1048,"_28058":1048,"_5":13662,"_2667":48059,"_28401":48742,"_19443":48743,"_25550":1048},[45477,46870,47878,47876,48059],[],{"_3172":1049,"_28058":1048,"_19443":48745,"_5":13331,"_25550":1048,"_2667":48746},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_3172":1050,"_28058":1048,"_5":28398,"_19443":48748,"_25550":48749,"_2667":48750},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_3172":1051,"_28058":1048,"_5":28398,"_19443":48752,"_25550":48753,"_2667":48754},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_3172":1052,"_28058":1048,"_5":28398,"_19443":48756,"_25550":48757,"_2667":48758},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_3172":1053,"_28058":1048,"_5":28398,"_19443":48760,"_25550":48761,"_2667":48762},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_3172":1054,"_28058":1048,"_19443":48764,"_5":13331,"_25550":1048,"_2667":48765},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_3172":1055,"_28058":1048,"_19443":48767,"_5":13331,"_25550":48749,"_2667":48768},[],"The administrator prepares the CA, issuance profile and DMS.",{"_3172":1056,"_28058":1048,"_19443":48770,"_5":13331,"_25550":48749,"_2667":48771},[],"The integrator installs initial EST server trust and an admission credential.",{"_3172":1057,"_28058":1048,"_19443":48773,"_5":13331,"_25550":48749,"_2667":48774},[],"The client requests an identity for its `Device ID` through EST.",{"_3172":1058,"_28058":1048,"_19443":48776,"_5":13331,"_25550":48749,"_2667":48777},[],"Certificate, device binding and key/certificate installation are checked.",{"_3172":1059,"_28058":1048,"_19443":48779,"_5":13331,"_25550":48749,"_2667":48780},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_3172":1060,"_28058":1048,"_19443":48782,"_5":13331,"_25550":48749,"_2667":48783},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_3172":1061,"_28058":1048,"_19443":48785,"_5":13331,"_25550":48753,"_2667":48786},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3172":1062,"_28058":1048,"_19443":48788,"_5":13331,"_25550":48753,"_2667":48789},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3172":1063,"_28058":1048,"_19443":48791,"_5":13331,"_25550":48753,"_2667":48792},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3172":1064,"_28058":1048,"_19443":48794,"_5":13331,"_25550":48753,"_2667":48795},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3172":1065,"_28058":1048,"_19443":48797,"_5":13331,"_25550":48757,"_2667":48798},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3172":1066,"_28058":1048,"_19443":48800,"_5":13331,"_25550":48757,"_2667":48801},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3172":1067,"_28058":1048,"_19443":48803,"_5":13331,"_25550":48757,"_2667":48804},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3172":1068,"_28058":1048,"_19443":48806,"_5":13331,"_25550":48757,"_2667":48807},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3172":1069,"_28058":1048,"_19443":48809,"_5":13331,"_25550":48761,"_2667":48810},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_3172":1070,"_28058":1048,"_19443":48812,"_5":13331,"_25550":48761,"_2667":48813},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_3172":1071,"_28058":1071,"_5":13662,"_2667":48815,"_28401":48816,"_19443":48817,"_25550":1071},"Provisioning strategies",[45477,46870,47878,47876,48059],[],{"_3172":1072,"_28058":1071,"_19443":48819,"_5":13331,"_25550":1071,"_2667":48820},[],"Choose device registration, identity authorization and key generation.",{"_3172":1073,"_28058":1071,"_5":28398,"_19443":48822,"_25550":48823,"_2667":48824},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_3172":1074,"_28058":1071,"_5":28398,"_19443":48826,"_25550":48827,"_2667":48828},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_3172":1075,"_28058":1071,"_5":28398,"_19443":48830,"_25550":48831,"_2667":48832},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_3172":1076,"_28058":1071,"_5":28398,"_19443":48834,"_25550":48835,"_2667":48836},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_3172":1077,"_28058":1071,"_5":28398,"_19443":48838,"_25550":48839,"_2667":48840},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_3172":1078,"_28058":1071,"_19443":48842,"_5":13331,"_25550":1071,"_2667":48843},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_3172":1079,"_28058":1071,"_19443":48845,"_5":13331,"_25550":48823,"_2667":48846},[],"Path",{"_3172":1080,"_28058":1071,"_19443":48848,"_5":13331,"_25550":48823,"_2667":48849},[],"When the device exists",{"_3172":1081,"_28058":1071,"_19443":48851,"_5":13331,"_25550":48823,"_2667":48852},[],"What to check",{"_3172":1082,"_28058":1071,"_19443":48854,"_5":13331,"_25550":48823,"_2667":48855},[],"Manual assignment",{"_3172":1083,"_28058":1071,"_19443":48857,"_5":13331,"_25550":48823,"_2667":48858},[],"An operator creates it before associating a certificate.",{"_3172":1084,"_28058":1071,"_19443":48860,"_5":13331,"_25550":48823,"_2667":48861},[],"ID, owning DMS, certificate CN and bound serial.",{"_3172":1085,"_28058":1071,"_19443":48863,"_5":13331,"_25550":48823,"_2667":48864},[],"EST with `JITP`",{"_3172":1086,"_28058":1071,"_19443":48866,"_5":13331,"_25550":48823,"_2667":48867},[],"Created for an unknown CN during `/simpleenroll`.",{"_3172":1087,"_28058":1071,"_19443":48869,"_5":13331,"_25550":48823,"_2667":48870},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_3172":1088,"_28058":1071,"_19443":48872,"_5":13331,"_25550":48823,"_2667":48873},[],"EST with `PRE_REGISTRATION`",{"_3172":1089,"_28058":1071,"_19443":48875,"_5":13331,"_25550":48823,"_2667":48876},[],"Must exist before `/simpleenroll`.",{"_3172":1090,"_28058":1071,"_19443":48878,"_5":13331,"_25550":48823,"_2667":48879},[],"Approved record, same DMS and replacement conditions for your version.",{"_3172":1091,"_28058":1071,"_19443":48881,"_5":13331,"_25550":48823,"_2667":48882},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_3172":1092,"_28058":1071,"_19443":48884,"_5":13331,"_25550":48823,"_2667":48885},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_3172":1093,"_28058":1071,"_19443":48887,"_5":13331,"_25550":48827,"_2667":48888},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_3172":1094,"_28058":1071,"_19443":48890,"_5":13331,"_25550":48827,"_2667":48891},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_3172":1095,"_28058":1071,"_19443":48893,"_5":13331,"_25550":48827,"_2667":48894},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_3172":1096,"_28058":1071,"_19443":48896,"_5":13331,"_25550":48831,"_2667":48897},[],"Decide initial enrollment and re-enrollment separately:",{"_3172":1097,"_28058":1071,"_19443":48899,"_5":13331,"_25550":48831,"_2667":48900},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_3172":1098,"_28058":1071,"_19443":48902,"_5":13331,"_25550":48831,"_2667":48903},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_3172":1099,"_28058":1071,"_19443":48905,"_5":13331,"_25550":48831,"_2667":48906},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_3172":1100,"_28058":1071,"_19443":48908,"_5":13331,"_25550":48831,"_2667":48909},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_3172":1101,"_28058":1071,"_19443":48911,"_5":13331,"_25550":48831,"_2667":48912},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_3172":1102,"_28058":1071,"_19443":48914,"_5":13331,"_25550":48835,"_2667":45861},[],{"_3172":1103,"_28058":1071,"_19443":48916,"_5":13331,"_25550":48835,"_2667":48917},[],"Material crossing EST",{"_3172":1104,"_28058":1071,"_19443":48919,"_5":13331,"_25550":48835,"_2667":48920},[],"Device-generated key",{"_3172":1105,"_28058":1071,"_19443":48922,"_5":13331,"_25550":48835,"_2667":48923},[],"Public CSR and certificate; the key stays on the client.",{"_3172":1106,"_28058":1071,"_19443":48925,"_5":13331,"_25550":48835,"_2667":48926},[],"Existing device key",{"_3172":1107,"_28058":1071,"_19443":48928,"_5":13331,"_25550":48835,"_2667":48929},[],"CSR signed with that key and a new certificate.",{"_3172":1108,"_28058":1071,"_19443":48931,"_5":13331,"_25550":48835,"_2667":48197},[],{"_3172":1109,"_28058":1071,"_19443":48933,"_5":13331,"_25550":48835,"_2667":48934},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_3172":1110,"_28058":1071,"_19443":48936,"_5":13331,"_25550":48835,"_2667":48937},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_3172":1111,"_28058":1071,"_19443":48939,"_5":13331,"_25550":48839,"_2667":48940},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_3172":1112,"_28058":1112,"_5":13662,"_2667":48942,"_28401":48943,"_19443":48944,"_25550":1112},"Renewal and recovery",[45477,46870,47878,47876,48059],[],{"_3172":1113,"_28058":1112,"_19443":48946,"_5":13331,"_25550":1112,"_2667":48947},[],"Renew without losing the identity and recover devices according to their actual state.",{"_3172":1114,"_28058":1112,"_5":28398,"_19443":48949,"_25550":48950,"_2667":48951},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_3172":1115,"_28058":1112,"_5":28398,"_19443":48953,"_25550":48954,"_2667":48955},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_3172":1116,"_28058":1112,"_5":28398,"_19443":48957,"_25550":48958,"_2667":48959},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_3172":1117,"_28058":1112,"_5":28398,"_19443":48961,"_25550":48962,"_2667":48963},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_3172":1118,"_28058":1112,"_5":28398,"_19443":48965,"_25550":48966,"_2667":48967},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_3172":1119,"_28058":1112,"_19443":48969,"_5":13331,"_25550":1112,"_2667":48970},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_3172":1120,"_28058":1112,"_19443":48972,"_5":13331,"_25550":48950,"_2667":48973},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_3172":1121,"_28058":1112,"_19443":48975,"_5":13331,"_25550":48950,"_2667":48976},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_3172":1122,"_28058":1112,"_19443":48978,"_5":13331,"_25550":48950,"_2667":48979},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_3172":1123,"_28058":1112,"_19443":48981,"_5":13331,"_25550":48950,"_2667":48982},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_3172":1124,"_28058":1112,"_19443":48984,"_5":13331,"_25550":48954,"_2667":48985},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_3172":1125,"_28058":1112,"_19443":48987,"_5":13331,"_25550":48954,"_2667":48988},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_3172":1126,"_28058":1112,"_19443":48990,"_5":13331,"_25550":48958,"_2667":48991},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_3172":1127,"_28058":1112,"_19443":48993,"_5":13331,"_25550":48958,"_2667":48994},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_3172":1128,"_28058":1112,"_19443":48996,"_5":13331,"_25550":48958,"_2667":48997},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_3172":1129,"_28058":1112,"_19443":48999,"_5":13331,"_25550":48962,"_2667":49000},[],"Situation",{"_3172":1130,"_28058":1112,"_19443":49002,"_5":13331,"_25550":48962,"_2667":49003},[],"Procedure",{"_3172":1131,"_28058":1112,"_19443":49005,"_5":13331,"_25550":48962,"_2667":49006},[],"Valid certificate, outside the window",{"_3172":1132,"_28058":1112,"_19443":49008,"_5":13331,"_25550":48962,"_2667":49009},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_3172":1133,"_28058":1112,"_19443":49011,"_5":13331,"_25550":48962,"_2667":49012},[],"Expired certificate, key available",{"_3172":1134,"_28058":1112,"_19443":49014,"_5":13331,"_25550":48962,"_2667":49015},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_3172":1135,"_28058":1112,"_19443":49017,"_5":13331,"_25550":48962,"_2667":49018},[],"Renewal through webhook or `NO_AUTH`",{"_3172":1136,"_28058":1112,"_19443":49020,"_5":13331,"_25550":48962,"_2667":49021},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_3172":1137,"_28058":1112,"_19443":49023,"_5":13331,"_25550":48962,"_2667":49024},[],"Lost or inaccessible key",{"_3172":1138,"_28058":1112,"_19443":49026,"_5":13331,"_25550":48962,"_2667":49027},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_3172":1139,"_28058":1112,"_19443":49029,"_5":13331,"_25550":48962,"_2667":49030},[],"Current identity revoked",{"_3172":1140,"_28058":1112,"_19443":49032,"_5":13331,"_25550":48962,"_2667":49033},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_3172":1141,"_28058":1112,"_19443":49035,"_5":13331,"_25550":48962,"_2667":49036},[],"Device without an identity",{"_3172":1142,"_28058":1112,"_19443":49038,"_5":13331,"_25550":48962,"_2667":49039},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_3172":1143,"_28058":1112,"_19443":49041,"_5":13331,"_25550":48962,"_2667":49042},[],"Retired device",{"_3172":1144,"_28058":1112,"_19443":49044,"_5":13331,"_25550":48962,"_2667":49045},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_3172":1145,"_28058":1112,"_19443":49047,"_5":13331,"_25550":48962,"_2667":49048},[],"Timeout, HTTP 500 or installation failure",{"_3172":1146,"_28058":1112,"_19443":49050,"_5":13331,"_25550":48962,"_2667":49051},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_3172":1147,"_28058":1112,"_19443":49053,"_5":13331,"_25550":48966,"_2667":49054},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_3172":1148,"_28058":1112,"_19443":49056,"_5":13331,"_25550":48966,"_2667":49057},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_3172":1149,"_28058":1149,"_5":13662,"_2667":49059,"_28401":49060,"_19443":49061,"_25550":1149},"Enrollment troubleshooting",[45477,46870,47878,47876,48059],[],{"_3172":1150,"_28058":1149,"_19443":49063,"_5":13331,"_25550":1149,"_2667":49064},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_3172":1151,"_28058":1149,"_5":28398,"_19443":49066,"_25550":49067,"_2667":49068},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_3172":1152,"_28058":1149,"_5":28398,"_19443":49070,"_25550":49071,"_2667":49072},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_3172":1153,"_28058":1149,"_5":28398,"_19443":49074,"_25550":49075,"_2667":48622},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_3172":1154,"_28058":1149,"_5":28398,"_19443":49077,"_25550":49078,"_2667":49079},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_3172":1155,"_28058":1149,"_19443":49081,"_5":13331,"_25550":1149,"_2667":49082},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_3172":1156,"_28058":1149,"_19443":49084,"_5":13331,"_25550":49071,"_2667":49085},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_3172":1157,"_28058":1149,"_19443":49087,"_5":13331,"_25550":49071,"_2667":49088},[],"Symptom or message",{"_3172":1158,"_28058":1149,"_19443":49090,"_5":13331,"_25550":49071,"_2667":48852},[],{"_3172":1159,"_28058":1149,"_19443":49092,"_5":13331,"_25550":49071,"_2667":49093},[],"curl rejects TLS, name or issuer",{"_3172":1160,"_28058":1149,"_19443":49095,"_5":13331,"_25550":49071,"_2667":49096},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_3172":1161,"_28058":1149,"_19443":49098,"_5":13331,"_25550":49071,"_2667":49099},[],"404 or missing APS",{"_3172":1162,"_28058":1149,"_19443":49101,"_5":13331,"_25550":49071,"_2667":49102},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_3172":1163,"_28058":1149,"_19443":49104,"_5":13331,"_25550":49071,"_2667":49105},[],"400, CSR or format error",{"_3172":1164,"_28058":1149,"_19443":49107,"_5":13331,"_25550":49071,"_2667":49108},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_3172":1165,"_28058":1149,"_19443":49110,"_5":13331,"_25550":49071,"_2667":49111},[],"Missing credential or invalid certificate",{"_3172":1166,"_28058":1149,"_19443":49113,"_5":13331,"_25550":49071,"_2667":49114},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_3172":1167,"_28058":1149,"_19443":49116,"_5":13331,"_25550":49071,"_2667":49117},[],"Webhook denies, times out or responds without authorization",{"_3172":1168,"_28058":1149,"_19443":49119,"_5":13331,"_25550":49071,"_2667":49120},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_3172":1169,"_28058":1149,"_19443":49122,"_5":13331,"_25550":49071,"_2667":49123},[],"`unexpected status code: <n>: redirects are not followed`",{"_3172":1170,"_28058":1149,"_19443":49125,"_5":13331,"_25550":49071,"_2667":49126},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_3172":1171,"_28058":1149,"_19443":49128,"_5":13331,"_25550":49071,"_2667":49129},[],"`webhook response exceeds 1048576 bytes`",{"_3172":1172,"_28058":1149,"_19443":49131,"_5":13331,"_25550":49071,"_2667":49132},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_3172":1173,"_28058":1149,"_19443":49134,"_5":13331,"_25550":49071,"_2667":49135},[],"`webhook config must not reference files`",{"_3172":1174,"_28058":1149,"_19443":49137,"_5":13331,"_25550":49071,"_2667":49138},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_3172":1175,"_28058":1149,"_19443":49140,"_5":13331,"_25550":49071,"_2667":49141},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_3172":1176,"_28058":1149,"_19443":49143,"_5":13331,"_25550":49071,"_2667":49144},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_3172":1177,"_28058":1149,"_19443":49146,"_5":13331,"_25550":49071,"_2667":49147},[],"`webhook mTLS certificate and key are invalid: …`",{"_3172":1178,"_28058":1149,"_19443":49149,"_5":13331,"_25550":49071,"_2667":49150},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_3172":1179,"_28058":1149,"_19443":49152,"_5":13331,"_25550":49071,"_2667":49153},[],"400 `struct validation error` creating or updating a DMS",{"_3172":1180,"_28058":1149,"_19443":49155,"_5":13331,"_25550":49071,"_2667":49156},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_3172":1181,"_28058":1149,"_19443":49158,"_5":13331,"_25550":49071,"_2667":49159},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_3172":1182,"_28058":1149,"_19443":49161,"_5":13331,"_25550":49071,"_2667":49162},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_3172":1183,"_28058":1149,"_19443":49164,"_5":13331,"_25550":49071,"_2667":49165},[],"`device not preregistered`",{"_3172":1184,"_28058":1149,"_19443":49167,"_5":13331,"_25550":49071,"_2667":49168},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_3172":1185,"_28058":1149,"_19443":49170,"_5":13331,"_25550":49071,"_2667":49171},[],"`forbiddenNewEnrollment`",{"_3172":1186,"_28058":1149,"_19443":49173,"_5":13331,"_25550":49071,"_2667":49174},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_3172":1187,"_28058":1149,"_19443":49176,"_5":13331,"_25550":49071,"_2667":49177},[],"Different owning DMS",{"_3172":1188,"_28058":1149,"_19443":49179,"_5":13331,"_25550":49071,"_2667":49180},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_3172":1189,"_28058":1149,"_19443":49182,"_5":13331,"_25550":49071,"_2667":49183},[],"`invalid RawSubject bytes`",{"_3172":1190,"_28058":1149,"_19443":49185,"_5":13331,"_25550":49071,"_2667":49186},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_3172":1191,"_28058":1149,"_19443":49188,"_5":13331,"_25550":49071,"_2667":49189},[],"`invalid reenroll window`",{"_3172":1192,"_28058":1149,"_19443":49191,"_5":13331,"_25550":49071,"_2667":49192},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_3172":1193,"_28058":1149,"_19443":49194,"_5":13331,"_25550":49071,"_2667":49195},[],"Current certificate revoked",{"_3172":1194,"_28058":1149,"_19443":49197,"_5":13331,"_25550":49071,"_2667":49198},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_3172":1195,"_28058":1149,"_19443":49200,"_5":13331,"_25550":49071,"_2667":49201},[],"CA, profile or signing error",{"_3172":1196,"_28058":1149,"_19443":49203,"_5":13331,"_25550":49071,"_2667":49204},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_3172":1197,"_28058":1149,"_19443":49206,"_5":13331,"_25550":49071,"_2667":49207},[],"HTTP 200 without a device connection",{"_3172":1198,"_28058":1149,"_19443":49209,"_5":13331,"_25550":49071,"_2667":49210},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_3172":1199,"_28058":1149,"_19443":49212,"_5":13331,"_25550":49071,"_2667":49213},[],"Timeout or error after issuance",{"_3172":1200,"_28058":1149,"_19443":49215,"_5":13331,"_25550":49071,"_2667":49216},[],"New certificates, current slot and previous identity's state before retrying.",{"_3172":1201,"_28058":1149,"_19443":49218,"_5":13331,"_25550":49075,"_2667":49219},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_3172":1202,"_28058":1149,"_19443":49221,"_5":13331,"_25550":49075,"_2667":49222},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_3172":1203,"_28058":1149,"_19443":49224,"_5":13331,"_25550":49078,"_2667":49225},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_3172":1204,"_28058":1149,"_19443":49227,"_5":13331,"_25550":49078,"_2667":49228},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_3172":1205,"_28058":1149,"_19443":49230,"_5":13331,"_25550":49078,"_2667":49231},[],"Verify the CSR locally and relate its CN to the inventory.",{"_3172":1206,"_28058":1149,"_19443":49233,"_5":13331,"_25550":49078,"_2667":49234},[],"Make one request, save headers/body and query the device and certificates.",{"_3172":1207,"_28058":1149,"_19443":49236,"_5":13331,"_25550":49078,"_2667":49237},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_3172":1208,"_28058":1149,"_19443":49239,"_5":13331,"_25550":49078,"_2667":49240},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_3172":1209,"_28058":1149,"_19443":49242,"_5":13331,"_25550":49078,"_2667":49243},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_3172":1210,"_28058":1210,"_5":13662,"_2667":49245,"_28401":49246,"_19443":49247,"_25550":1210},"Trust distribution and updates",[45477,46870,47878,47876,48059],[],{"_3172":1211,"_28058":1210,"_19443":49249,"_5":13331,"_25550":1210,"_2667":49250},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_3172":1212,"_28058":1210,"_5":28398,"_19443":49252,"_25550":49253,"_2667":49254},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_3172":1213,"_28058":1210,"_5":28398,"_19443":49256,"_25550":49257,"_2667":49258},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_3172":1214,"_28058":1210,"_5":28398,"_19443":49260,"_25550":49261,"_2667":49262},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_3172":1215,"_28058":1210,"_5":28398,"_19443":49264,"_25550":49265,"_2667":49266},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_3172":1216,"_28058":1210,"_5":28398,"_19443":49268,"_25550":49269,"_2667":49270},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_3172":1217,"_28058":1210,"_19443":49272,"_5":13331,"_25550":1210,"_2667":49273},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_3172":1218,"_28058":1210,"_19443":49275,"_5":13331,"_25550":49253,"_2667":49276},[],"Relationship",{"_3172":1219,"_28058":1210,"_19443":49278,"_5":13331,"_25550":49253,"_2667":49279},[],"Material prepared by its owner",{"_3172":1220,"_28058":1210,"_19443":49281,"_5":13331,"_25550":49253,"_2667":49282},[],"Device → EST server",{"_3172":1221,"_28058":1210,"_19443":49284,"_5":13331,"_25550":49253,"_2667":49285},[],"Previously verified server root, chain or pin and TLS name.",{"_3172":1222,"_28058":1210,"_19443":49287,"_5":13331,"_25550":49253,"_2667":49288},[],"DMS → requester",{"_3172":1223,"_28058":1210,"_19443":49290,"_5":13331,"_25550":49253,"_2667":49291},[],"CAs and rules authorizing initial or renewal credentials.",{"_3172":1224,"_28058":1210,"_19443":49293,"_5":13331,"_25550":49253,"_2667":49294},[],"Consumer → device",{"_3172":1225,"_28058":1210,"_19443":49296,"_5":13331,"_25550":49253,"_2667":49297},[],"Operational identity roots, intermediates, validation and permissions.",{"_3172":1226,"_28058":1210,"_19443":49299,"_5":13331,"_25550":49253,"_2667":49300},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_3172":1227,"_28058":1210,"_19443":49302,"_5":13331,"_25550":49257,"_2667":49303},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_3172":1228,"_28058":1210,"_19443":49305,"_5":13331,"_25550":49257,"_2667":49306},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_3172":1229,"_28058":1210,"_19443":49308,"_5":13331,"_25550":49261,"_2667":49309},[],"Keep initial EST server trust separate from identity consumer trust.",{"_3172":1230,"_28058":1210,"_19443":49311,"_5":13331,"_25550":49261,"_2667":49312},[],"Select policy-approved roots as anchors.",{"_3172":1231,"_28058":1210,"_19443":49314,"_5":13331,"_25550":49261,"_2667":49315},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_3172":1232,"_28058":1210,"_19443":49317,"_5":13331,"_25550":49261,"_2667":49318},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_3172":1233,"_28058":1210,"_19443":49320,"_5":13331,"_25550":49261,"_2667":49321},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_3172":1234,"_28058":1210,"_19443":49323,"_5":13331,"_25550":49261,"_2667":49324},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_3172":1235,"_28058":1210,"_19443":49326,"_5":13331,"_25550":49265,"_2667":49327},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_3172":1236,"_28058":1210,"_19443":49329,"_5":13331,"_25550":49265,"_2667":49330},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. That list is optional because the enrollment CA always validates re-enrollment credentials, but when switching the enrollment CA, add the previous issuance CA to it so old-CA identities keep re-enrolling during overlap. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_3172":1237,"_28058":1210,"_19443":49332,"_5":13331,"_25550":49265,"_2667":49333},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_3172":1238,"_28058":1210,"_19443":49335,"_5":13331,"_25550":49269,"_2667":49336},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_3172":1239,"_28058":1239,"_5":13662,"_2667":49338,"_28401":49339,"_19443":49341,"_25550":1239},"AWS IoT Core",[45477,46870,47878,47876,49340],"Integrations",[],{"_3172":1240,"_28058":1239,"_19443":49343,"_5":13331,"_25550":1239,"_2667":49344},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_3172":1241,"_28058":1239,"_5":28398,"_19443":49346,"_25550":49347,"_2667":49348},[],"/docs/pr-preview/pr-55/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_3172":1242,"_28058":1239,"_5":28398,"_19443":49350,"_25550":49351,"_2667":49352},[],"/docs/pr-preview/pr-55/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_3172":1243,"_28058":1239,"_5":28398,"_19443":49354,"_25550":49355,"_2667":49356},[],"/docs/pr-preview/pr-55/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_3172":1244,"_28058":1239,"_5":28398,"_19443":49358,"_25550":49359,"_2667":49360},[],"/docs/pr-preview/pr-55/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_3172":1245,"_28058":1239,"_5":28398,"_19443":49362,"_25550":49363,"_2667":49364},[],"/docs/pr-preview/pr-55/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_3172":1246,"_28058":1239,"_5":28398,"_19443":49366,"_25550":49367,"_2667":49368},[],"/docs/pr-preview/pr-55/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_3172":1247,"_28058":1239,"_5":28398,"_19443":49370,"_25550":49371,"_2667":49372},[],"/docs/pr-preview/pr-55/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_3172":1248,"_28058":1239,"_5":28398,"_19443":49374,"_25550":49375,"_2667":49376},[],"/docs/pr-preview/pr-55/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3172":1249,"_28058":1239,"_5":28398,"_19443":49378,"_25550":49379,"_2667":49380},[],"/docs/pr-preview/pr-55/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_3172":1250,"_28058":1239,"_5":28398,"_19443":49382,"_25550":49383,"_2667":49384},[],"/docs/pr-preview/pr-55/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_3172":1251,"_28058":1239,"_5":28398,"_19443":49386,"_25550":49387,"_2667":49388},[],"/docs/pr-preview/pr-55/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_3172":1252,"_28058":1239,"_5":28398,"_19443":49390,"_25550":49391,"_2667":49392},[],"/docs/pr-preview/pr-55/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_3172":1253,"_28058":1239,"_5":28398,"_19443":49394,"_25550":49395,"_2667":49396},[],"/docs/pr-preview/pr-55/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_3172":1254,"_28058":1239,"_5":28398,"_19443":49398,"_25550":49399,"_2667":49400},[],"/docs/pr-preview/pr-55/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_3172":1255,"_28058":1239,"_5":28398,"_19443":49402,"_25550":49403,"_2667":49404},[],"/docs/pr-preview/pr-55/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_3172":1256,"_28058":1239,"_5":28398,"_19443":49406,"_25550":49407,"_2667":49408},[],"/docs/pr-preview/pr-55/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_3172":1257,"_28058":1239,"_5":28398,"_19443":49410,"_25550":49411,"_2667":49412},[],"/docs/pr-preview/pr-55/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_3172":1258,"_28058":1239,"_5":28398,"_19443":49414,"_25550":49415,"_2667":49416},[],"/docs/pr-preview/pr-55/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_3172":1259,"_28058":1239,"_5":28398,"_19443":49418,"_25550":49419,"_2667":49420},[],"/docs/pr-preview/pr-55/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_3172":1260,"_28058":1239,"_5":28398,"_19443":49422,"_25550":49423,"_2667":49424},[],"/docs/pr-preview/pr-55/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_3172":1261,"_28058":1239,"_19443":49426,"_5":13331,"_25550":1239,"_2667":49427},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_3172":1262,"_28058":1239,"_19443":49429,"_5":13331,"_25550":1239,"_2667":49430},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_3172":1263,"_28058":1239,"_19443":49432,"_5":13331,"_25550":1239,"_2667":49433},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_3172":1264,"_28058":1239,"_19443":49435,"_5":13331,"_25550":49347,"_2667":49436},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_3172":1265,"_28058":1239,"_19443":49438,"_5":13331,"_25550":49347,"_2667":49439},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_3172":1266,"_28058":1239,"_19443":49441,"_5":13331,"_25550":49347,"_2667":49442},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_3172":1267,"_28058":1239,"_19443":49444,"_5":13331,"_25550":49347,"_2667":49445},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_3172":1268,"_28058":1239,"_19443":49447,"_5":13331,"_25550":49351,"_2667":49448},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_3172":1269,"_28058":1239,"_19443":49450,"_5":13331,"_25550":49355,"_2667":49451},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_3172":1270,"_28058":1239,"_19443":49453,"_5":13331,"_25550":49355,"_2667":49454},[],"IAM action",{"_3172":1271,"_28058":1239,"_19443":49456,"_5":13331,"_25550":49355,"_2667":45867},[],{"_3172":1272,"_28058":1239,"_19443":49458,"_5":13331,"_25550":49355,"_2667":49459},[],"`iot:GetRegistrationCode`",{"_3172":1273,"_28058":1239,"_19443":49461,"_5":13331,"_25550":49355,"_2667":49462},[],"Obtain the verification code for CA registration in the Primary Account",{"_3172":1274,"_28058":1239,"_19443":49464,"_5":13331,"_25550":49355,"_2667":49465},[],"`iot:RegisterCACertificate`",{"_3172":1275,"_28058":1239,"_19443":49467,"_5":13331,"_25550":49355,"_2667":49468},[],"Register the CA in AWS IoT",{"_3172":1276,"_28058":1239,"_19443":49470,"_5":13331,"_25550":49355,"_2667":49471},[],"`iot:DescribeCACertificate`",{"_3172":1277,"_28058":1239,"_19443":49473,"_5":13331,"_25550":49355,"_2667":49474},[],"Check the CA registration status",{"_3172":1278,"_28058":1239,"_19443":49476,"_5":13331,"_25550":49355,"_2667":49477},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3172":1279,"_28058":1239,"_19443":49479,"_5":13331,"_25550":49355,"_2667":49480},[],"Create or update Things in IoT Core",{"_3172":1280,"_28058":1239,"_19443":49482,"_5":13331,"_25550":49355,"_2667":49483},[],"`iot:RegisterThing`",{"_3172":1281,"_28058":1239,"_19443":49485,"_5":13331,"_25550":49355,"_2667":49486},[],"Provision Things through a template",{"_3172":1282,"_28058":1239,"_19443":49488,"_5":13331,"_25550":49355,"_2667":49489},[],"`iot:RegisterCertificate`",{"_3172":1283,"_28058":1239,"_19443":49491,"_5":13331,"_25550":49355,"_2667":49492},[],"Register device certificates",{"_3172":1284,"_28058":1239,"_19443":49494,"_5":13331,"_25550":49355,"_2667":49495},[],"`iot:UpdateCertificate`",{"_3172":1285,"_28058":1239,"_19443":49497,"_5":13331,"_25550":49355,"_2667":49498},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_3172":1286,"_28058":1239,"_19443":49500,"_5":13331,"_25550":49355,"_2667":49501},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3172":1287,"_28058":1239,"_19443":49503,"_5":13331,"_25550":49355,"_2667":49504},[],"Create and attach IoT policies",{"_3172":1288,"_28058":1239,"_19443":49506,"_5":13331,"_25550":49355,"_2667":49507},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3172":1289,"_28058":1239,"_19443":49509,"_5":13331,"_25550":49355,"_2667":49510},[],"Manage Thing groups",{"_3172":1290,"_28058":1239,"_19443":49512,"_5":13331,"_25550":49355,"_2667":49513},[],"`iot:CreateProvisioningTemplate`",{"_3172":1291,"_28058":1239,"_19443":49515,"_5":13331,"_25550":49355,"_2667":49516},[],"Create JITP templates",{"_3172":1292,"_28058":1239,"_19443":49518,"_5":13331,"_25550":49355,"_2667":49519},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3172":1293,"_28058":1239,"_19443":49521,"_5":13331,"_25550":49355,"_2667":49522},[],"Read and write the Device Shadow",{"_3172":1294,"_28058":1239,"_19443":49524,"_5":13331,"_25550":49355,"_2667":49525},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_3172":1295,"_28058":1239,"_19443":49527,"_5":13331,"_25550":49359,"_2667":49528},[],"Parameter",{"_3172":1296,"_28058":1239,"_19443":49530,"_5":13331,"_25550":49359,"_2667":49531},[],"Type",{"_3172":1297,"_28058":1239,"_19443":49533,"_5":13331,"_25550":49359,"_2667":49534},[],"Required",{"_3172":1298,"_28058":1239,"_19443":49536,"_5":13331,"_25550":49359,"_2667":49537},[],"Description",{"_3172":1299,"_28058":1239,"_19443":49539,"_5":13331,"_25550":49359,"_2667":49540},[],"`connector_id`",{"_3172":1300,"_28058":1239,"_19443":49542,"_5":13331,"_25550":49359,"_2667":23255},[],{"_3172":1301,"_28058":1239,"_19443":49544,"_5":13331,"_25550":49359,"_2667":49545},[],"Yes",{"_3172":1302,"_28058":1239,"_19443":49547,"_5":13331,"_25550":49359,"_2667":49548},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_3172":1303,"_28058":1239,"_19443":49550,"_5":13331,"_25550":49359,"_2667":49551},[],"`aws_config.region`",{"_3172":1304,"_28058":1239,"_19443":49553,"_5":13331,"_25550":49359,"_2667":23255},[],{"_3172":1305,"_28058":1239,"_19443":49555,"_5":13331,"_25550":49359,"_2667":49545},[],{"_3172":1306,"_28058":1239,"_19443":49557,"_5":13331,"_25550":49359,"_2667":49558},[],"AWS region where the connector operates.",{"_3172":1307,"_28058":1239,"_19443":49560,"_5":13331,"_25550":49359,"_2667":49561},[],"`aws_config.auth_method`",{"_3172":1308,"_28058":1239,"_19443":49563,"_5":13331,"_25550":49359,"_2667":23255},[],{"_3172":1309,"_28058":1239,"_19443":49565,"_5":13331,"_25550":49359,"_2667":49545},[],{"_3172":1310,"_28058":1239,"_19443":49567,"_5":13331,"_25550":49359,"_2667":49568},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_3172":1311,"_28058":1239,"_19443":49570,"_5":13331,"_25550":49359,"_2667":49571},[],"`aws_config.access_key_id`",{"_3172":1312,"_28058":1239,"_19443":49573,"_5":13331,"_25550":49359,"_2667":23255},[],{"_3172":1313,"_28058":1239,"_19443":49575,"_5":13331,"_25550":49359,"_2667":49576},[],"Only with `auth_method=static`",{"_3172":1314,"_28058":1239,"_19443":49578,"_5":13331,"_25550":49359,"_2667":49579},[],"AWS access key.",{"_3172":1315,"_28058":1239,"_19443":49581,"_5":13331,"_25550":49359,"_2667":49582},[],"`aws_config.secret_access_key`",{"_3172":1316,"_28058":1239,"_19443":49584,"_5":13331,"_25550":49359,"_2667":23255},[],{"_3172":1317,"_28058":1239,"_19443":49586,"_5":13331,"_25550":49359,"_2667":49576},[],{"_3172":1318,"_28058":1239,"_19443":49588,"_5":13331,"_25550":49359,"_2667":49589},[],"AWS secret key.",{"_3172":1319,"_28058":1239,"_19443":49591,"_5":13331,"_25550":49359,"_2667":49592},[],"`aws_config.session_token`",{"_3172":1320,"_28058":1239,"_19443":49594,"_5":13331,"_25550":49359,"_2667":23255},[],{"_3172":1321,"_28058":1239,"_19443":49596,"_5":13331,"_25550":49359,"_2667":49597},[],"No",{"_3172":1322,"_28058":1239,"_19443":49599,"_5":13331,"_25550":49359,"_2667":49600},[],"Session token (with `auth_method=static`).",{"_3172":1323,"_28058":1239,"_19443":49602,"_5":13331,"_25550":49359,"_2667":49603},[],"`aws_config.role_arn`",{"_3172":1324,"_28058":1239,"_19443":49605,"_5":13331,"_25550":49359,"_2667":23255},[],{"_3172":1325,"_28058":1239,"_19443":49607,"_5":13331,"_25550":49359,"_2667":49608},[],"Only with `auth_method=role`",{"_3172":1326,"_28058":1239,"_19443":49610,"_5":13331,"_25550":49359,"_2667":49611},[],"ARN of the role to assume.",{"_3172":1327,"_28058":1239,"_19443":49613,"_5":13331,"_25550":49359,"_2667":49614},[],"`aws_config.endpoint_url`",{"_3172":1328,"_28058":1239,"_19443":49616,"_5":13331,"_25550":49359,"_2667":23255},[],{"_3172":1329,"_28058":1239,"_19443":49618,"_5":13331,"_25550":49359,"_2667":49597},[],{"_3172":1330,"_28058":1239,"_19443":49620,"_5":13331,"_25550":49359,"_2667":49621},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_3172":1331,"_28058":1239,"_19443":49623,"_5":13331,"_25550":49359,"_2667":49624},[],"`subscriber_event_bus`",{"_3172":1332,"_28058":1239,"_19443":49626,"_5":13331,"_25550":49359,"_2667":16365},[],{"_3172":1333,"_28058":1239,"_19443":49628,"_5":13331,"_25550":49359,"_2667":49545},[],{"_3172":1334,"_28058":1239,"_19443":49630,"_5":13331,"_25550":49359,"_2667":49631},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_3172":1335,"_28058":1239,"_19443":49633,"_5":13331,"_25550":49359,"_2667":49634},[],"`dms_manager_client`",{"_3172":1336,"_28058":1239,"_19443":49636,"_5":13331,"_25550":49359,"_2667":23255},[],{"_3172":1337,"_28058":1239,"_19443":49638,"_5":13331,"_25550":49359,"_2667":49545},[],{"_3172":1338,"_28058":1239,"_19443":49640,"_5":13331,"_25550":49359,"_2667":49641},[],"HTTP URL of Lamassu's DMS Manager service.",{"_3172":1339,"_28058":1239,"_19443":49643,"_5":13331,"_25550":49359,"_2667":49644},[],"`device_manager_client`",{"_3172":1340,"_28058":1239,"_19443":49646,"_5":13331,"_25550":49359,"_2667":23255},[],{"_3172":1341,"_28058":1239,"_19443":49648,"_5":13331,"_25550":49359,"_2667":49545},[],{"_3172":1342,"_28058":1239,"_19443":49650,"_5":13331,"_25550":49359,"_2667":49651},[],"HTTP URL of Lamassu's Device Manager.",{"_3172":1343,"_28058":1239,"_19443":49653,"_5":13331,"_25550":49359,"_2667":49654},[],"`ca_client`",{"_3172":1344,"_28058":1239,"_19443":49656,"_5":13331,"_25550":49359,"_2667":23255},[],{"_3172":1345,"_28058":1239,"_19443":49658,"_5":13331,"_25550":49359,"_2667":49545},[],{"_3172":1346,"_28058":1239,"_19443":49660,"_5":13331,"_25550":49359,"_2667":49661},[],"HTTP URL of Lamassu's CA service.",{"_3172":1347,"_28058":1239,"_19443":49663,"_5":13331,"_25550":49363,"_2667":49664},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_3172":1348,"_28058":1239,"_19443":49666,"_5":13331,"_25550":49367,"_2667":49667},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_3172":1349,"_28058":1239,"_19443":49669,"_5":13331,"_25550":49367,"_2667":49670},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_3172":1350,"_28058":1239,"_19443":49672,"_5":13331,"_25550":49371,"_2667":49673},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_3172":1351,"_28058":1239,"_19443":49675,"_5":13331,"_25550":49371,"_2667":49676},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_3172":1352,"_28058":1239,"_19443":49678,"_5":13331,"_25550":49371,"_2667":49679},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_3172":1353,"_28058":1239,"_19443":49681,"_5":13331,"_25550":49371,"_2667":49682},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_3172":1354,"_28058":1239,"_19443":49684,"_5":13331,"_25550":49371,"_2667":49685},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_3172":1355,"_28058":1239,"_19443":49687,"_5":13331,"_25550":49371,"_2667":49688},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_3172":1356,"_28058":1239,"_19443":49690,"_5":13331,"_25550":49375,"_2667":49691},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_3172":1357,"_28058":1239,"_19443":49693,"_5":13331,"_25550":49379,"_2667":49694},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_3172":1358,"_28058":1239,"_19443":49696,"_5":13331,"_25550":49379,"_2667":49697},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_3172":1359,"_28058":1239,"_19443":49699,"_5":13331,"_25550":49383,"_2667":49700},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_3172":1360,"_28058":1239,"_19443":49702,"_5":13331,"_25550":49387,"_2667":49703},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_3172":1361,"_28058":1239,"_19443":49705,"_5":13331,"_25550":49387,"_2667":49706},[],"Creates or updates the IoT policies configured in the DMS.",{"_3172":1362,"_28058":1239,"_19443":49708,"_5":13331,"_25550":49387,"_2667":49709},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_3172":1363,"_28058":1239,"_19443":49711,"_5":13331,"_25550":49387,"_2667":49712},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_3172":1364,"_28058":1239,"_19443":49714,"_5":13331,"_25550":49387,"_2667":49715},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_3172":1365,"_28058":1239,"_19443":49717,"_5":13331,"_25550":49387,"_2667":49718},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_3172":1366,"_28058":1239,"_19443":49720,"_5":13331,"_25550":49387,"_2667":49721},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_3172":1367,"_28058":1239,"_19443":49723,"_5":13331,"_25550":49391,"_2667":49724},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. This template is created or updated at the moment the DMS is created or updated in Lamassu — not at device enrollment time. From then on, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_3172":1368,"_28058":1239,"_19443":49726,"_5":13331,"_25550":49391,"_2667":49727},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_3172":1369,"_28058":1239,"_19443":49729,"_5":13331,"_25550":49391,"_2667":49730},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_3172":1370,"_28058":1239,"_19443":49732,"_5":13331,"_25550":49395,"_2667":49733},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_3172":1371,"_28058":1239,"_19443":49735,"_5":13331,"_25550":49395,"_2667":49736},[],"The full flow from the device's perspective is:",{"_3172":1372,"_28058":1239,"_19443":49738,"_5":13331,"_25550":49395,"_2667":49739},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_3172":1373,"_28058":1239,"_19443":49741,"_5":13331,"_25550":49399,"_2667":49742},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_3172":1374,"_28058":1239,"_19443":49744,"_5":13331,"_25550":49399,"_2667":49745},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_3172":1375,"_28058":1239,"_19443":49747,"_5":13331,"_25550":49399,"_2667":49748},[],"For the JITP flow to work correctly:",{"_3172":1376,"_28058":1239,"_19443":49750,"_5":13331,"_25550":49399,"_2667":49751},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_3172":1377,"_28058":1239,"_19443":49753,"_5":13331,"_25550":49399,"_2667":49754},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_3172":1378,"_28058":1239,"_19443":49756,"_5":13331,"_25550":49399,"_2667":49757},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_3172":1379,"_28058":1239,"_19443":49759,"_5":13331,"_25550":49399,"_2667":49760},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_3172":1380,"_28058":1239,"_19443":49762,"_5":13331,"_25550":49403,"_2667":49763},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_3172":1381,"_28058":1239,"_19443":49765,"_5":13331,"_25550":49403,"_2667":49766},[],"Status in Lamassu",{"_3172":1382,"_28058":1239,"_19443":49768,"_5":13331,"_25550":49403,"_2667":49769},[],"Revocation reason",{"_3172":1383,"_28058":1239,"_19443":49771,"_5":13331,"_25550":49403,"_2667":49772},[],"Status in AWS IoT Core",{"_3172":1384,"_28058":1239,"_19443":49774,"_5":13331,"_25550":49403,"_2667":49775},[],"`Active`",{"_3172":1385,"_28058":1239,"_19443":49777,"_5":13331,"_25550":49403,"_2667":49778},[],"None",{"_3172":1386,"_28058":1239,"_19443":49780,"_5":13331,"_25550":49403,"_2667":49781},[],"`ACTIVE`",{"_3172":1387,"_28058":1239,"_19443":49783,"_5":13331,"_25550":49403,"_2667":49784},[],"`Revoked`",{"_3172":1388,"_28058":1239,"_19443":49786,"_5":13331,"_25550":49403,"_2667":49787},[],"`certificateHold`",{"_3172":1389,"_28058":1239,"_19443":49789,"_5":13331,"_25550":49403,"_2667":49790},[],"`INACTIVE`",{"_3172":1390,"_28058":1239,"_19443":49792,"_5":13331,"_25550":49403,"_2667":49784},[],{"_3172":1391,"_28058":1239,"_19443":49794,"_5":13331,"_25550":49403,"_2667":49795},[],"Any other reason",{"_3172":1392,"_28058":1239,"_19443":49797,"_5":13331,"_25550":49403,"_2667":49798},[],"`REVOKED`",{"_3172":1393,"_28058":1239,"_19443":49800,"_5":13331,"_25550":49403,"_2667":49801},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_3172":1394,"_28058":1239,"_19443":49803,"_5":13331,"_25550":49407,"_2667":49804},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_3172":1395,"_28058":1239,"_19443":49806,"_5":13331,"_25550":49407,"_2667":49807},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_3172":1396,"_28058":1239,"_19443":49809,"_5":13331,"_25550":49407,"_2667":49810},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_3172":1397,"_28058":1239,"_19443":49812,"_5":13331,"_25550":49411,"_2667":49813},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_3172":1398,"_28058":1239,"_19443":49815,"_5":13331,"_25550":49411,"_2667":49816},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_3172":1399,"_28058":1239,"_19443":49818,"_5":13331,"_25550":49415,"_2667":49819},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_3172":1400,"_28058":1239,"_19443":49821,"_5":13331,"_25550":49415,"_2667":49822},[],"There are two action types:",{"_3172":1401,"_28058":1239,"_19443":49824,"_5":13331,"_25550":49415,"_2667":49825},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_3172":1402,"_28058":1239,"_19443":49827,"_5":13331,"_25550":49415,"_2667":49828},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_3172":1403,"_28058":1239,"_19443":49830,"_5":13331,"_25550":49415,"_2667":49831},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_3172":1404,"_28058":1239,"_19443":49833,"_5":13331,"_25550":49419,"_2667":49834},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_3172":1405,"_28058":1239,"_19443":49836,"_5":13331,"_25550":49419,"_2667":49837},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_3172":1406,"_28058":1239,"_19443":49839,"_5":13331,"_25550":49419,"_2667":49840},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_3172":1407,"_28058":1239,"_19443":49842,"_5":13331,"_25550":49423,"_2667":49843},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_3172":1408,"_28058":1239,"_19443":49845,"_5":13331,"_25550":49423,"_2667":49846},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_3172":1409,"_28058":1239,"_19443":49848,"_5":13331,"_25550":49423,"_2667":49849},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_3172":1410,"_28058":1239,"_19443":49851,"_5":13331,"_25550":49423,"_2667":49852},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_3172":1411,"_28058":1239,"_19443":49854,"_5":13331,"_25550":49423,"_2667":49855},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_3172":1412,"_28058":1239,"_19443":49857,"_5":13331,"_25550":49423,"_2667":49858},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_3172":1413,"_28058":1239,"_19443":49860,"_5":13331,"_25550":49423,"_2667":49861},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_3172":1414,"_28058":1239,"_19443":49863,"_5":13331,"_25550":49423,"_2667":49864},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_3172":1415,"_28058":1239,"_19443":49866,"_5":13331,"_25550":49423,"_2667":49867},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_3172":1416,"_28058":1239,"_19443":49869,"_5":13331,"_25550":49423,"_2667":49870},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_3172":1417,"_28058":1239,"_19443":49872,"_5":13331,"_25550":49423,"_2667":49873},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_3172":1418,"_28058":1239,"_19443":49875,"_5":13331,"_25550":49423,"_2667":49876},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_3172":1419,"_28058":1239,"_19443":49878,"_5":13331,"_25550":49423,"_2667":49879},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_3172":1420,"_28058":1239,"_19443":49881,"_5":13331,"_25550":49423,"_2667":49882},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_3172":1421,"_28058":1239,"_19443":49884,"_5":13331,"_25550":49423,"_2667":49885},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_3172":1422,"_28058":1239,"_19443":49887,"_5":13331,"_25550":49423,"_2667":49888},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_3172":1423,"_28058":1239,"_19443":49890,"_5":13331,"_25550":49423,"_2667":49891},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_3172":1424,"_28058":1239,"_19443":49893,"_5":13331,"_25550":49423,"_2667":49894},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_3172":1425,"_28058":1239,"_19443":49896,"_5":13331,"_25550":49423,"_2667":49897},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3172":1426,"_28058":1239,"_19443":49899,"_5":13331,"_25550":49423,"_2667":49900},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3172":1427,"_28058":1239,"_19443":49902,"_5":13331,"_25550":49423,"_2667":49903},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_3172":1428,"_28058":1428,"_5":13662,"_2667":47878,"_28401":49905,"_19443":49906,"_25550":1428},[45477,46870,47878],[],{"_3172":1429,"_28058":1428,"_19443":49908,"_5":13331,"_25550":1428,"_2667":49909},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_3172":1430,"_28058":1428,"_5":28398,"_19443":49911,"_25550":49912,"_2667":49913},[],"/docs/pr-preview/pr-55/platform/iot-fleets/overview#start-here","Start here",{"_3172":1431,"_28058":1428,"_5":28398,"_19443":49915,"_25550":49916,"_2667":47876},[],"/docs/pr-preview/pr-55/platform/iot-fleets/overview#devices-and-identities",{"_3172":1432,"_28058":1428,"_5":28398,"_19443":49918,"_25550":49919,"_2667":48059},[],"/docs/pr-preview/pr-55/platform/iot-fleets/overview#enrollment-with-pki",{"_3172":1433,"_28058":1428,"_5":28398,"_19443":49921,"_25550":49922,"_2667":49340},[],"/docs/pr-preview/pr-55/platform/iot-fleets/overview#integrations",{"_3172":1434,"_28058":1428,"_5":28398,"_19443":49924,"_25550":49925,"_2667":49926},[],"/docs/pr-preview/pr-55/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_3172":1435,"_28058":1428,"_19443":49928,"_5":13331,"_25550":1428,"_2667":49929},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_3172":1436,"_28058":1428,"_19443":49931,"_5":13331,"_25550":49912,"_2667":49932},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_3172":1437,"_28058":1428,"_19443":49934,"_5":13331,"_25550":49912,"_2667":49935},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_3172":1438,"_28058":1428,"_19443":49937,"_5":13331,"_25550":49916,"_2667":49938},[],"Resource",{"_3172":1439,"_28058":1428,"_19443":49940,"_5":13331,"_25550":49916,"_2667":49941},[],"What it represents",{"_3172":1440,"_28058":1428,"_19443":49943,"_5":13331,"_25550":49916,"_2667":49944},[],"**Device**",{"_3172":1441,"_28058":1428,"_19443":49946,"_5":13331,"_25550":49916,"_2667":49947},[],"An inventory entry with an identifier, owning DMS and classification.",{"_3172":1442,"_28058":1428,"_19443":49949,"_5":13331,"_25550":49916,"_2667":49950},[],"**Identity**",{"_3172":1443,"_28058":1428,"_19443":49952,"_5":13331,"_25550":49916,"_2667":49953},[],"The device's association with its certificates: an active version and a history.",{"_3172":1444,"_28058":1428,"_19443":49955,"_5":13331,"_25550":49916,"_2667":49956},[],"**DMS**",{"_3172":1445,"_28058":1428,"_19443":49958,"_5":13331,"_25550":49916,"_2667":49959},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_3172":1446,"_28058":1428,"_19443":49961,"_5":13331,"_25550":49916,"_2667":49962},[],"**Fleet**",{"_3172":1447,"_28058":1428,"_19443":49964,"_5":13331,"_25550":49916,"_2667":49965},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_3172":1448,"_28058":1428,"_19443":49967,"_5":13331,"_25550":49916,"_2667":49968},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_3172":1449,"_28058":1428,"_19443":49970,"_5":13331,"_25550":49916,"_2667":49971},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_3172":1450,"_28058":1428,"_19443":49973,"_5":13331,"_25550":49919,"_2667":49974},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_3172":1451,"_28058":1428,"_19443":49976,"_5":13331,"_25550":49919,"_2667":49977},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_3172":1452,"_28058":1428,"_19443":49979,"_5":13331,"_25550":49919,"_2667":49980},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_3172":1453,"_28058":1428,"_19443":49982,"_5":13331,"_25550":49919,"_2667":49983},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_3172":1454,"_28058":1428,"_19443":49985,"_5":13331,"_25550":49919,"_2667":49986},[],"**Result:** request the certificate, install it and check its association with the device.",{"_3172":1455,"_28058":1428,"_19443":49988,"_5":13331,"_25550":49919,"_2667":49989},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_3172":1456,"_28058":1428,"_19443":49991,"_5":13331,"_25550":49919,"_2667":49992},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3172":1457,"_28058":1428,"_19443":49994,"_5":13331,"_25550":49919,"_2667":49995},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3172":1458,"_28058":1428,"_19443":49997,"_5":13331,"_25550":49922,"_2667":49998},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_3172":1459,"_28058":1428,"_19443":50000,"_5":13331,"_25550":49922,"_2667":50001},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_3172":1460,"_28058":1428,"_19443":50003,"_5":13331,"_25550":49925,"_2667":50004},[],"Participant",{"_3172":1461,"_28058":1428,"_19443":50006,"_5":13331,"_25550":49925,"_2667":50007},[],"Responsibility",{"_3172":1462,"_28058":1428,"_19443":50009,"_5":13331,"_25550":49925,"_2667":50010},[],"PKI administrator",{"_3172":1463,"_28058":1428,"_19443":50012,"_5":13331,"_25550":49925,"_2667":50013},[],"CA, issuance profile, chain and revocation publication.",{"_3172":1464,"_28058":1428,"_19443":50015,"_5":13331,"_25550":49925,"_2667":50016},[],"Provisioning administrator",{"_3172":1465,"_28058":1428,"_19443":50018,"_5":13331,"_25550":49925,"_2667":50019},[],"DMS, admission, authentication per operation and inventory.",{"_3172":1466,"_28058":1428,"_19443":50021,"_5":13331,"_25550":49925,"_2667":50022},[],"Device integrator",{"_3172":1467,"_28058":1428,"_19443":50024,"_5":13331,"_25550":49925,"_2667":50025},[],"Initial credential, key, EST client, trust and certificate installation.",{"_3172":1468,"_28058":1428,"_19443":50027,"_5":13331,"_25550":49925,"_2667":50028},[],"Consumer integrator",{"_3172":1469,"_28058":1428,"_19443":50030,"_5":13331,"_25550":49925,"_2667":50031},[],"Trusted issuers, validation and device permissions in the destination.",{"_3172":1470,"_28058":1428,"_19443":50033,"_5":13331,"_25550":49925,"_2667":50034},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_3172":1471,"_28058":1471,"_5":13662,"_2667":50036,"_28401":50037,"_19443":50039,"_25550":1471},"Enroll and connect your first device",[45477,46870,47878,50038],"Getting started",[],{"_3172":1472,"_28058":1471,"_19443":50041,"_5":13331,"_25550":1471,"_2667":50042},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_3172":1473,"_28058":1471,"_5":28398,"_19443":50044,"_25550":50045,"_2667":45487},[],"/docs/pr-preview/pr-55/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_3172":1474,"_28058":1471,"_5":28398,"_19443":50047,"_25550":50048,"_2667":50049},[],"/docs/pr-preview/pr-55/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_3172":1475,"_28058":1471,"_5":28398,"_19443":50051,"_25550":50052,"_2667":50053},[],"/docs/pr-preview/pr-55/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_3172":1476,"_28058":1471,"_5":28398,"_19443":50055,"_25550":50056,"_2667":50057},[],"/docs/pr-preview/pr-55/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_3172":1477,"_28058":1471,"_5":28398,"_19443":50059,"_25550":50060,"_2667":50061},[],"/docs/pr-preview/pr-55/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_3172":1478,"_28058":1471,"_5":28398,"_19443":50063,"_25550":50064,"_2667":50065},[],"/docs/pr-preview/pr-55/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_3172":1479,"_28058":1471,"_5":28398,"_19443":50067,"_25550":50068,"_2667":50069},[],"/docs/pr-preview/pr-55/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_3172":1480,"_28058":1471,"_5":28398,"_19443":50071,"_25550":50072,"_2667":50073},[],"/docs/pr-preview/pr-55/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_3172":1481,"_28058":1471,"_19443":50075,"_5":13331,"_25550":1471,"_2667":50076},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_3172":1482,"_28058":1471,"_19443":50078,"_5":13331,"_25550":50045,"_2667":50079},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_3172":1483,"_28058":1471,"_19443":50081,"_5":13331,"_25550":50045,"_2667":50082},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_3172":1484,"_28058":1471,"_19443":50084,"_5":13331,"_25550":50045,"_2667":50085},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_3172":1485,"_28058":1471,"_19443":50087,"_5":13331,"_25550":50045,"_2667":50088},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_3172":1486,"_28058":1471,"_19443":50090,"_5":13331,"_25550":50045,"_2667":50091},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_3172":1487,"_28058":1471,"_19443":50093,"_5":13331,"_25550":50048,"_2667":50094},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_3172":1488,"_28058":1471,"_19443":50096,"_5":13331,"_25550":50048,"_2667":50097},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_3172":1489,"_28058":1471,"_19443":50099,"_5":13331,"_25550":50052,"_2667":50100},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_3172":1490,"_28058":1471,"_19443":50102,"_5":13331,"_25550":50052,"_2667":50103},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_3172":1491,"_28058":1471,"_19443":50105,"_5":13331,"_25550":50052,"_2667":50106},[],"Setting",{"_3172":1492,"_28058":1471,"_19443":50108,"_5":13331,"_25550":50052,"_2667":50109},[],"Evaluation value",{"_3172":1493,"_28058":1471,"_19443":50111,"_5":13331,"_25550":50052,"_2667":50112},[],"Enrollment CA",{"_3172":1494,"_28058":1471,"_19443":50114,"_5":13331,"_25550":50052,"_2667":50115},[],"Issuing root from `device-root.pem`.",{"_3172":1495,"_28058":1471,"_19443":50117,"_5":13331,"_25550":50052,"_2667":48189},[],{"_3172":1496,"_28058":1471,"_19443":50119,"_5":13331,"_25550":50052,"_2667":50120},[],"The 1-hour leaf profile you just prepared.",{"_3172":1497,"_28058":1471,"_19443":50122,"_5":13331,"_25550":50052,"_2667":50123},[],"Protocol / Registration Mode",{"_3172":1498,"_28058":1471,"_19443":50125,"_5":13331,"_25550":50052,"_2667":50126},[],"`EST_RFC7030` / `JITP`.",{"_3172":1499,"_28058":1471,"_19443":50128,"_5":13331,"_25550":50052,"_2667":50129},[],"Verify CSR Signature",{"_3172":1500,"_28058":1471,"_19443":50131,"_5":13331,"_25550":50052,"_2667":50132},[],"Enabled.",{"_3172":1501,"_28058":1471,"_19443":50134,"_5":13331,"_25550":50052,"_2667":50135},[],"Enable Replaceable Enrollment",{"_3172":1502,"_28058":1471,"_19443":50137,"_5":13331,"_25550":50052,"_2667":50138},[],"Disabled; the ID must be new.",{"_3172":1503,"_28058":1471,"_19443":50140,"_5":13331,"_25550":50052,"_2667":50141},[],"Initial authentication",{"_3172":1504,"_28058":1471,"_19443":50143,"_5":13331,"_25550":50052,"_2667":50144},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_3172":1505,"_28058":1471,"_19443":50146,"_5":13331,"_25550":50052,"_2667":50147},[],"Renewal authentication",{"_3172":1506,"_28058":1471,"_19443":50149,"_5":13331,"_25550":50052,"_2667":50150},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_3172":1507,"_28058":1471,"_19443":50152,"_5":13331,"_25550":50052,"_2667":50153},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_3172":1508,"_28058":1471,"_19443":50155,"_5":13331,"_25550":50052,"_2667":50156},[],"Not needed for this direct issuance; the Enrollment CA is always trusted for re-enrollment / disabled.",{"_3172":1509,"_28058":1471,"_19443":50158,"_5":13331,"_25550":50052,"_2667":50159},[],"Re-enrollment Delta",{"_3172":1510,"_28058":1471,"_19443":50161,"_5":13331,"_25550":50052,"_2667":50162},[],"1 hour.",{"_3172":1511,"_28058":1471,"_19443":50164,"_5":13331,"_25550":50052,"_2667":50165},[],"Preventive / Critical Delta",{"_3172":1512,"_28058":1471,"_19443":50167,"_5":13331,"_25550":50052,"_2667":50168},[],"30 minutes / 10 minutes.",{"_3172":1513,"_28058":1471,"_19443":50170,"_5":13331,"_25550":50052,"_2667":50171},[],"Revoke on Re-enrollment",{"_3172":1514,"_28058":1471,"_19443":50173,"_5":13331,"_25550":50052,"_2667":50174},[],"Disabled to test the successor before retiring the previous identity.",{"_3172":1515,"_28058":1471,"_19443":50176,"_5":13331,"_25550":50052,"_2667":48197},[],{"_3172":1516,"_28058":1471,"_19443":50178,"_5":13331,"_25550":50052,"_2667":50179},[],"Disabled; the operational key is generated in the client.",{"_3172":1517,"_28058":1471,"_19443":50181,"_5":13331,"_25550":50052,"_2667":50182},[],"CA Distribution",{"_3172":1518,"_28058":1471,"_19443":50184,"_5":13331,"_25550":50052,"_2667":50185},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_3172":1519,"_28058":1471,"_19443":50187,"_5":13331,"_25550":50052,"_2667":50188},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. The console exposes independent editors for the enrollment and re-enrollment authentication; the DMS guide describes their fields, and you can also check the resource through the DMS API.",{"_3172":1520,"_28058":1471,"_19443":50190,"_5":13331,"_25550":50056,"_2667":50191},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_3172":1521,"_28058":1471,"_19443":50193,"_5":13331,"_25550":50056,"_2667":50194},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_3172":1522,"_28058":1471,"_19443":50196,"_5":13331,"_25550":50060,"_2667":50197},[],"Generate a new key and CSR with the selected identifier:",{"_3172":1523,"_28058":1471,"_19443":50199,"_5":13331,"_25550":50060,"_2667":50200},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_3172":1524,"_28058":1471,"_19443":50202,"_5":13331,"_25550":50060,"_2667":50203},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_3172":1525,"_28058":1471,"_19443":50205,"_5":13331,"_25550":50064,"_2667":50206},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_3172":1526,"_28058":1471,"_19443":50208,"_5":13331,"_25550":50064,"_2667":50209},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_3172":1527,"_28058":1471,"_19443":50211,"_5":13331,"_25550":50068,"_2667":50212},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_3172":1528,"_28058":1471,"_19443":50214,"_5":13331,"_25550":50068,"_2667":50215},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_3172":1529,"_28058":1471,"_19443":50217,"_5":13331,"_25550":50068,"_2667":50218},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_3172":1530,"_28058":1471,"_19443":50220,"_5":13331,"_25550":50068,"_2667":50221},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_3172":1531,"_28058":1471,"_19443":50223,"_5":13331,"_25550":50068,"_2667":50224},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_3172":1532,"_28058":1471,"_19443":50226,"_5":13331,"_25550":50072,"_2667":50227},[],"Check",{"_3172":1533,"_28058":1471,"_19443":50229,"_5":13331,"_25550":50072,"_2667":50230},[],"Expected result",{"_3172":1534,"_28058":1471,"_19443":50232,"_5":13331,"_25550":50072,"_2667":50233},[],"Registration",{"_3172":1535,"_28058":1471,"_19443":50235,"_5":13331,"_25550":50072,"_2667":50236},[],"ID created automatically and correct DMS.",{"_3172":1536,"_28058":1471,"_19443":50238,"_5":13331,"_25550":50072,"_2667":50239},[],"Certificate",{"_3172":1537,"_28058":1471,"_19443":50241,"_5":13331,"_25550":50072,"_2667":50242},[],"CN, profile, serial and key verified.",{"_3172":1538,"_28058":1471,"_19443":50244,"_5":13331,"_25550":50072,"_2667":50245},[],"Inventory",{"_3172":1539,"_28058":1471,"_19443":50247,"_5":13331,"_25550":50072,"_2667":50248},[],"Received serial visible as the current identity and in history.",{"_3172":1540,"_28058":1471,"_19443":50250,"_5":13331,"_25550":50072,"_2667":50251},[],"Consumer",{"_3172":1541,"_28058":1471,"_19443":50253,"_5":13331,"_25550":50072,"_2667":50254},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_3172":1542,"_28058":1471,"_19443":50256,"_5":13331,"_25550":50072,"_2667":50257},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_3172":1543,"_28058":1471,"_19443":50259,"_5":13331,"_25550":50072,"_2667":50260},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_3172":1544,"_28058":1544,"_5":13662,"_2667":47894,"_28401":50262,"_19443":50263,"_25550":1544},[45477,46870,47878,50038],[],{"_3172":1545,"_28058":1544,"_19443":50265,"_5":13331,"_25550":1544,"_2667":50266},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_3172":1546,"_28058":1544,"_5":28398,"_19443":50268,"_25550":50269,"_2667":45487},[],"/docs/pr-preview/pr-55/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_3172":1547,"_28058":1544,"_5":28398,"_19443":50271,"_25550":50272,"_2667":50273},[],"/docs/pr-preview/pr-55/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_3172":1548,"_28058":1544,"_5":28398,"_19443":50275,"_25550":50276,"_2667":50277},[],"/docs/pr-preview/pr-55/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_3172":1549,"_28058":1544,"_5":28398,"_19443":50279,"_25550":50280,"_2667":50281},[],"/docs/pr-preview/pr-55/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_3172":1550,"_28058":1544,"_5":28398,"_19443":50283,"_25550":50284,"_2667":50285},[],"/docs/pr-preview/pr-55/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_3172":1551,"_28058":1544,"_5":28398,"_19443":50287,"_25550":50288,"_2667":50289},[],"/docs/pr-preview/pr-55/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_3172":1552,"_28058":1544,"_5":28398,"_19443":50291,"_25550":50292,"_2667":50230},[],"/docs/pr-preview/pr-55/platform/iot-fleets/quickstarts/register-device#expected-result",{"_3172":1553,"_28058":1544,"_5":28398,"_19443":50294,"_25550":50295,"_2667":50296},[],"/docs/pr-preview/pr-55/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_3172":1554,"_28058":1544,"_5":28398,"_19443":50298,"_25550":50299,"_2667":50300},[],"/docs/pr-preview/pr-55/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_3172":1555,"_28058":1544,"_19443":50302,"_5":13331,"_25550":1544,"_2667":50303},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_3172":1556,"_28058":1544,"_19443":50305,"_5":13331,"_25550":1544,"_2667":50306},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_3172":1557,"_28058":1544,"_19443":50308,"_5":13331,"_25550":50269,"_2667":50309},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_3172":1558,"_28058":1544,"_19443":50311,"_5":13331,"_25550":50269,"_2667":50312},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_3172":1559,"_28058":1544,"_19443":50314,"_5":13331,"_25550":50269,"_2667":50315},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_3172":1560,"_28058":1544,"_19443":50317,"_5":13331,"_25550":50269,"_2667":50318},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_3172":1561,"_28058":1544,"_19443":50320,"_5":13331,"_25550":50272,"_2667":50321},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_3172":1562,"_28058":1544,"_19443":50323,"_5":13331,"_25550":50272,"_2667":50324},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_3172":1563,"_28058":1544,"_19443":50326,"_5":13331,"_25550":50272,"_2667":50327},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_3172":1564,"_28058":1544,"_19443":50329,"_5":13331,"_25550":50272,"_2667":50330},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_3172":1565,"_28058":1544,"_19443":50332,"_5":13331,"_25550":50272,"_2667":50333},[],"In the authentication section, enable **Require client certificate** and leave **Call external webhook** off. Under **Require client certificate**, add the CA whose initial certificates you will accept to **Validation CAs**; for this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and leave **Enable server-side key generation** off if you will not use it.",{"_3172":1566,"_28058":1544,"_19443":50335,"_5":13331,"_25550":50272,"_2667":50336},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_3172":1567,"_28058":1544,"_19443":50338,"_5":13331,"_25550":50272,"_2667":50339},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_3172":1568,"_28058":1544,"_19443":50341,"_5":13331,"_25550":50272,"_2667":50342},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_3172":1569,"_28058":1544,"_19443":50344,"_5":13331,"_25550":50276,"_2667":50345},[],"Open **Managed Devices** and the registration action. Complete:",{"_3172":1570,"_28058":1544,"_19443":50347,"_5":13331,"_25550":50276,"_2667":50348},[],"**Device ID**: `device-001`.",{"_3172":1571,"_28058":1544,"_19443":50350,"_5":13331,"_25550":50276,"_2667":50351},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_3172":1572,"_28058":1544,"_19443":50353,"_5":13331,"_25550":50276,"_2667":50354},[],"**Icon** and **Tags**: optional classification.",{"_3172":1573,"_28058":1544,"_19443":50356,"_5":13331,"_25550":50276,"_2667":50357},[],"Confirm registration.",{"_3172":1574,"_28058":1544,"_19443":50359,"_5":13331,"_25550":50280,"_2667":50360},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_3172":1575,"_28058":1544,"_19443":50362,"_5":13331,"_25550":50280,"_2667":50363},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_3172":1576,"_28058":1544,"_19443":50365,"_5":13331,"_25550":50284,"_2667":50366},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_3172":1577,"_28058":1544,"_19443":50368,"_5":13331,"_25550":50284,"_2667":50369},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_3172":1578,"_28058":1544,"_19443":50371,"_5":13331,"_25550":50288,"_2667":50372},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_3172":1579,"_28058":1544,"_19443":50374,"_5":13331,"_25550":50288,"_2667":50375},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_3172":1580,"_28058":1544,"_19443":50377,"_5":13331,"_25550":50292,"_2667":50227},[],{"_3172":1581,"_28058":1544,"_19443":50379,"_5":13331,"_25550":50292,"_2667":50380},[],"Result",{"_3172":1582,"_28058":1544,"_19443":50382,"_5":13331,"_25550":50292,"_2667":50383},[],"Device",{"_3172":1583,"_28058":1544,"_19443":50385,"_5":13331,"_25550":50292,"_2667":50386},[],"`device-001` appears in inventory with the expected DMS.",{"_3172":1584,"_28058":1544,"_19443":50388,"_5":13331,"_25550":50292,"_2667":50389},[],"Current identity",{"_3172":1585,"_28058":1544,"_19443":50391,"_5":13331,"_25550":50292,"_2667":50392},[],"The associated certificate matches the one you verified in PKI.",{"_3172":1586,"_28058":1544,"_19443":50394,"_5":13331,"_25550":50292,"_2667":50395},[],"History",{"_3172":1587,"_28058":1544,"_19443":50397,"_5":13331,"_25550":50292,"_2667":50398},[],"The associated issuance appears with its serial number and dates.",{"_3172":1588,"_28058":1544,"_19443":50400,"_5":13331,"_25550":50292,"_2667":50401},[],"Key and certificate",{"_3172":1589,"_28058":1544,"_19443":50403,"_5":13331,"_25550":50292,"_2667":50404},[],"You have the verified pair ready to install on the device.",{"_3172":1590,"_28058":1544,"_19443":50406,"_5":13331,"_25550":50295,"_2667":50407},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_3172":1591,"_28058":1544,"_19443":50409,"_5":13331,"_25550":50295,"_2667":50410},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_3172":1592,"_28058":1544,"_19443":50412,"_5":13331,"_25550":50295,"_2667":50413},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_3172":1593,"_28058":1544,"_19443":50415,"_5":13331,"_25550":50295,"_2667":50416},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_3172":1594,"_28058":1544,"_19443":50418,"_5":13331,"_25550":50299,"_2667":50419},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_3172":1595,"_28058":1544,"_19443":50421,"_5":13331,"_25550":50299,"_2667":50422},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_3172":1596,"_28058":1544,"_19443":50424,"_5":13331,"_25550":50299,"_2667":50425},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_3172":1597,"_28058":1597,"_5":13662,"_2667":50427,"_28401":50428,"_19443":50429,"_25550":1597},"Lamassu IoT Platform",[45477,46870],[],{"_3172":1598,"_28058":1597,"_19443":50431,"_5":13331,"_25550":1597,"_2667":50432},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_3172":1599,"_28058":1597,"_5":28398,"_19443":50434,"_25550":50435,"_2667":49913},[],"/docs/pr-preview/pr-55/platform/overview#start-here",{"_3172":1600,"_28058":1597,"_5":28398,"_19443":50437,"_25550":50438,"_2667":50439},[],"/docs/pr-preview/pr-55/platform/overview#choose-your-path","Choose your path",{"_3172":1601,"_28058":1597,"_5":28398,"_19443":50441,"_25550":50442,"_2667":50443},[],"/docs/pr-preview/pr-55/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_3172":1602,"_28058":1597,"_5":28398,"_19443":50445,"_25550":50446,"_2667":50447},[],"/docs/pr-preview/pr-55/platform/overview#core-capabilities","Core capabilities",{"_3172":1603,"_28058":1597,"_5":28398,"_19443":50449,"_25550":50450,"_2667":50451},[],"/docs/pr-preview/pr-55/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_3172":1604,"_28058":1597,"_5":28398,"_19443":50453,"_25550":50454,"_2667":50455},[],"/docs/pr-preview/pr-55/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_3172":1605,"_28058":1597,"_5":28398,"_19443":50457,"_25550":50458,"_2667":50459},[],"/docs/pr-preview/pr-55/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_3172":1606,"_28058":1597,"_5":28398,"_19443":50461,"_25550":50462,"_2667":50463},[],"/docs/pr-preview/pr-55/platform/overview#automate-device-identities","Automate device identities",{"_3172":1607,"_28058":1597,"_5":28398,"_19443":50465,"_25550":50466,"_2667":50467},[],"/docs/pr-preview/pr-55/platform/overview#publish-validation-status","Publish validation status",{"_3172":1608,"_28058":1597,"_5":28398,"_19443":50469,"_25550":50470,"_2667":50471},[],"/docs/pr-preview/pr-55/platform/overview#react-to-events","React to events",{"_3172":1609,"_28058":1597,"_5":28398,"_19443":50473,"_25550":50474,"_2667":50475},[],"/docs/pr-preview/pr-55/platform/overview#operational-reference","Operational reference",{"_3172":1610,"_28058":1597,"_19443":50477,"_5":13331,"_25550":1597,"_2667":50478},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_3172":1611,"_28058":1597,"_19443":50480,"_5":13331,"_25550":50435,"_2667":50481},[],"Choose the result you need:",{"_3172":1612,"_28058":1597,"_19443":50483,"_5":13331,"_25550":50435,"_2667":50484},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3172":1613,"_28058":1597,"_19443":50486,"_5":13331,"_25550":50435,"_2667":50487},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3172":1614,"_28058":1597,"_19443":50489,"_5":13331,"_25550":50435,"_2667":50490},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_3172":1615,"_28058":1597,"_19443":50492,"_5":13331,"_25550":50438,"_2667":50493},[],"Section",{"_3172":1616,"_28058":1597,"_19443":50495,"_5":13331,"_25550":50438,"_2667":50496},[],"What you manage",{"_3172":1617,"_28058":1597,"_19443":50498,"_5":13331,"_25550":50438,"_2667":50499},[],"Entry point",{"_3172":1618,"_28058":1597,"_19443":50501,"_5":13331,"_25550":50438,"_2667":50502},[],"**PKI**",{"_3172":1619,"_28058":1597,"_19443":50504,"_5":13331,"_25550":50438,"_2667":50505},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_3172":1620,"_28058":1597,"_19443":50507,"_5":13331,"_25550":50438,"_2667":50508},[],"PKI overview",{"_3172":1621,"_28058":1597,"_19443":50510,"_5":13331,"_25550":50438,"_2667":50511},[],"**IoT Fleets**",{"_3172":1622,"_28058":1597,"_19443":50513,"_5":13331,"_25550":50438,"_2667":50514},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_3172":1623,"_28058":1597,"_19443":50516,"_5":13331,"_25550":50438,"_2667":50517},[],"IoT Fleets overview",{"_3172":1624,"_28058":1597,"_19443":50519,"_5":13331,"_25550":50438,"_2667":50520},[],"**Administration**",{"_3172":1625,"_28058":1597,"_19443":50522,"_5":13331,"_25550":50438,"_2667":50523},[],"Operator permissions, audit and event subscriptions.",{"_3172":1626,"_28058":1597,"_19443":50525,"_5":13331,"_25550":50438,"_2667":46868},[],{"_3172":1627,"_28058":1597,"_19443":50527,"_5":13331,"_25550":50438,"_2667":50528},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_3172":1628,"_28058":1597,"_19443":50530,"_5":13331,"_25550":50442,"_2667":50531},[],"An identity's journey connects four responsibilities:",{"_3172":1629,"_28058":1597,"_19443":50533,"_5":13331,"_25550":50442,"_2667":50534},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_3172":1630,"_28058":1597,"_19443":50536,"_5":13331,"_25550":50442,"_2667":50537},[],"The provisioning administrator configures the DMS and initial trust.",{"_3172":1631,"_28058":1597,"_19443":50539,"_5":13331,"_25550":50442,"_2667":50540},[],"The device client requests a certificate and installs it with the matching key.",{"_3172":1632,"_28058":1597,"_19443":50542,"_5":13331,"_25550":50442,"_2667":50543},[],"The consumer validates the identity and applies its access permissions.",{"_3172":1633,"_28058":1597,"_19443":50545,"_5":13331,"_25550":50442,"_2667":50546},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_3172":1634,"_28058":1597,"_19443":50548,"_5":13331,"_25550":50450,"_2667":50549},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_3172":1635,"_28058":1597,"_19443":50551,"_5":13331,"_25550":50454,"_2667":50552},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_3172":1636,"_28058":1597,"_19443":50554,"_5":13331,"_25550":50458,"_2667":50555},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_3172":1637,"_28058":1597,"_19443":50557,"_5":13331,"_25550":50462,"_2667":50558},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_3172":1638,"_28058":1597,"_19443":50560,"_5":13331,"_25550":50466,"_2667":50561},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_3172":1639,"_28058":1597,"_19443":50563,"_5":13331,"_25550":50470,"_2667":50564},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_3172":1640,"_28058":1597,"_19443":50566,"_5":13331,"_25550":50474,"_2667":50007},[],{"_3172":1641,"_28058":1597,"_19443":50568,"_5":13331,"_25550":50474,"_2667":50569},[],"What it prepares or checks",{"_3172":1642,"_28058":1597,"_19443":50571,"_5":13331,"_25550":50474,"_2667":50010},[],{"_3172":1643,"_28058":1597,"_19443":50573,"_5":13331,"_25550":50474,"_2667":50574},[],"Key custody, CA hierarchy, profiles and validation.",{"_3172":1644,"_28058":1597,"_19443":50576,"_5":13331,"_25550":50474,"_2667":50577},[],"Fleet administrator",{"_3172":1645,"_28058":1597,"_19443":50579,"_5":13331,"_25550":50474,"_2667":50580},[],"DMS, device admission, renewal policy and inventory.",{"_3172":1646,"_28058":1597,"_19443":50582,"_5":13331,"_25550":50474,"_2667":50022},[],{"_3172":1647,"_28058":1597,"_19443":50584,"_5":13331,"_25550":50474,"_2667":50585},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_3172":1648,"_28058":1597,"_19443":50587,"_5":13331,"_25550":50474,"_2667":50028},[],{"_3172":1649,"_28058":1597,"_19443":50589,"_5":13331,"_25550":50474,"_2667":50590},[],"Issuer trust, certificate validation and permissions in the destination.",{"_3172":1650,"_28058":1597,"_19443":50592,"_5":13331,"_25550":50474,"_2667":50593},[],"Infrastructure operator",{"_3172":1651,"_28058":1597,"_19443":50595,"_5":13331,"_25550":50474,"_2667":50596},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_3172":1652,"_28058":1597,"_19443":50598,"_5":13331,"_25550":50474,"_2667":50599},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_3172":1653,"_28058":1653,"_5":13662,"_2667":50601,"_28401":50602,"_19443":50605,"_25550":1653},"CA hierarchy and rotation",[45477,46870,50603,50604],"PKI","Keys, authorities and certificates",[],{"_3172":1654,"_28058":1653,"_19443":50607,"_5":13331,"_25550":1653,"_2667":50608},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_3172":1655,"_28058":1653,"_5":28398,"_19443":50610,"_25550":50611,"_2667":50612},[],"/docs/pr-preview/pr-55/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_3172":1656,"_28058":1653,"_5":28398,"_19443":50614,"_25550":50615,"_2667":50616},[],"/docs/pr-preview/pr-55/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_3172":1657,"_28058":1653,"_5":28398,"_19443":50618,"_25550":50619,"_2667":50620},[],"/docs/pr-preview/pr-55/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_3172":1658,"_28058":1653,"_5":28398,"_19443":50622,"_25550":50623,"_2667":50624},[],"/docs/pr-preview/pr-55/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_3172":1659,"_28058":1653,"_5":28398,"_19443":50626,"_25550":50627,"_2667":50628},[],"/docs/pr-preview/pr-55/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_3172":1660,"_28058":1653,"_5":28398,"_19443":50630,"_25550":50631,"_2667":50632},[],"/docs/pr-preview/pr-55/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_3172":1661,"_28058":1653,"_5":28398,"_19443":50634,"_25550":50635,"_2667":50636},[],"/docs/pr-preview/pr-55/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_3172":1662,"_28058":1653,"_5":28398,"_19443":50638,"_25550":50639,"_2667":50640},[],"/docs/pr-preview/pr-55/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_3172":1663,"_28058":1653,"_5":28398,"_19443":50642,"_25550":50643,"_2667":50644},[],"/docs/pr-preview/pr-55/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_3172":1664,"_28058":1653,"_5":28398,"_19443":50646,"_25550":50647,"_2667":50648},[],"/docs/pr-preview/pr-55/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_3172":1665,"_28058":1653,"_5":28398,"_19443":50650,"_25550":50651,"_2667":50652},[],"/docs/pr-preview/pr-55/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_3172":1666,"_28058":1653,"_5":28398,"_19443":50654,"_25550":50655,"_2667":50656},[],"/docs/pr-preview/pr-55/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_3172":1667,"_28058":1653,"_19443":50658,"_5":13331,"_25550":1653,"_2667":50659},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_3172":1668,"_28058":1653,"_19443":50661,"_5":13331,"_25550":1653,"_2667":50662},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_3172":1669,"_28058":1653,"_19443":50664,"_5":13331,"_25550":50611,"_2667":50665},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_3172":1670,"_28058":1653,"_19443":50667,"_5":13331,"_25550":50611,"_2667":50668},[],"environment, such as production and preproduction;",{"_3172":1671,"_28058":1653,"_19443":50670,"_5":13331,"_25550":50611,"_2667":50671},[],"owner or operating team;",{"_3172":1672,"_28058":1653,"_19443":50673,"_5":13331,"_25550":50611,"_2667":50674},[],"device family or manufacturing process;",{"_3172":1673,"_28058":1653,"_19443":50676,"_5":13331,"_25550":50611,"_2667":50677},[],"region or regulatory requirement;",{"_3172":1674,"_28058":1653,"_19443":50679,"_5":13331,"_25550":50611,"_2667":50680},[],"cryptographic engine or key policy;",{"_3172":1675,"_28058":1653,"_19443":50682,"_5":13331,"_25550":50611,"_2667":50683},[],"maintenance window and renewal cadence.",{"_3172":1676,"_28058":1653,"_19443":50685,"_5":13331,"_25550":50611,"_2667":50686},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_3172":1677,"_28058":1653,"_19443":50688,"_5":13331,"_25550":50611,"_2667":50689},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_3172":1678,"_28058":1653,"_19443":50691,"_5":13331,"_25550":50615,"_2667":50692},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_3172":1679,"_28058":1653,"_19443":50694,"_5":13331,"_25550":50615,"_2667":50695},[],"If a VA CRL role for the CA is signed by the superseded CA certificate, reissuing moves the signer to the new certificate and republishes the CRL. A role signed by a different certificate keeps that signer; see the CRL guide.",{"_3172":1680,"_28058":1653,"_19443":50697,"_5":13331,"_25550":50615,"_2667":50698},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_3172":1681,"_28058":1653,"_19443":50700,"_5":13331,"_25550":50615,"_2667":50701},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_3172":1682,"_28058":1653,"_19443":50703,"_5":13331,"_25550":50619,"_2667":50704},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_3172":1683,"_28058":1653,"_19443":50706,"_5":13331,"_25550":50619,"_2667":50707},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_3172":1684,"_28058":1653,"_19443":50709,"_5":13331,"_25550":50619,"_2667":50710},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_3172":1685,"_28058":1653,"_19443":50712,"_5":13331,"_25550":50619,"_2667":50713},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_3172":1686,"_28058":1653,"_19443":50715,"_5":13331,"_25550":50627,"_2667":50716},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_3172":1687,"_28058":1653,"_19443":50718,"_5":13331,"_25550":50631,"_2667":50719},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_3172":1688,"_28058":1653,"_19443":50721,"_5":13331,"_25550":50635,"_2667":50722},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_3172":1689,"_28058":1653,"_19443":50724,"_5":13331,"_25550":50639,"_2667":50725},[],"Update the enrollment CA and profile of the DMSs. While old-CA cohorts still renew, add the previous enrollment CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`): the new enrollment CA is trusted automatically, but the old one was the enrollment CA and appears in no re-enrollment trust list, so without that entry its certificates can no longer renew. The DMS guide documents the setting.",{"_3172":1690,"_28058":1653,"_19443":50727,"_5":13331,"_25550":50643,"_2667":50728},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_3172":1691,"_28058":1653,"_19443":50730,"_5":13331,"_25550":50647,"_2667":50731},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance, from the re-enrollment validation CAs and from the distributed CAs. Revoke it if policy requires it.",{"_3172":1692,"_28058":1653,"_19443":50733,"_5":13331,"_25550":50651,"_2667":50734},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_3172":1693,"_28058":1653,"_19443":50736,"_5":13331,"_25550":50651,"_2667":50737},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_3172":1694,"_28058":1653,"_19443":50739,"_5":13331,"_25550":50651,"_2667":50740},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_3172":1695,"_28058":1653,"_19443":50742,"_5":13331,"_25550":50651,"_2667":50743},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_3172":1696,"_28058":1653,"_19443":50745,"_5":13331,"_25550":50655,"_2667":50746},[],"The new chain ends in an anchor installed by the consumer.",{"_3172":1697,"_28058":1653,"_19443":50748,"_5":13331,"_25550":50655,"_2667":50749},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_3172":1698,"_28058":1653,"_19443":50751,"_5":13331,"_25550":50655,"_2667":50752},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_3172":1699,"_28058":1653,"_19443":50754,"_5":13331,"_25550":50655,"_2667":50755},[],"Re-enrollment accepts the old identity during the planned period.",{"_3172":1700,"_28058":1653,"_19443":50757,"_5":13331,"_25550":50655,"_2667":50758},[],"OCSP and CRL respond for the authorities that remain active.",{"_3172":1701,"_28058":1653,"_19443":50760,"_5":13331,"_25550":50655,"_2667":50761},[],"No DMS is left accidentally issuing from the old CA.",{"_3172":1702,"_28058":1653,"_19443":50763,"_5":13331,"_25550":50655,"_2667":50764},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_3172":1703,"_28058":1703,"_5":13662,"_2667":50766,"_28401":50767,"_19443":50768,"_25550":1703},"Certification authorities",[45477,46870,50603,50604],[],{"_3172":1704,"_28058":1703,"_19443":50770,"_5":13331,"_25550":1703,"_2667":50771},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_3172":1705,"_28058":1703,"_5":28398,"_19443":50773,"_25550":50774,"_2667":50775},[],"/docs/pr-preview/pr-55/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_3172":1706,"_28058":1703,"_5":28398,"_19443":50777,"_25550":50778,"_2667":50779},[],"/docs/pr-preview/pr-55/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_3172":1707,"_28058":1703,"_5":28398,"_19443":50781,"_25550":50782,"_2667":45487},[],"/docs/pr-preview/pr-55/platform/pki/certificate-authorities#before-you-begin",{"_3172":1708,"_28058":1703,"_5":28398,"_19443":50784,"_25550":50785,"_2667":50786},[],"/docs/pr-preview/pr-55/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_3172":1709,"_28058":1703,"_5":28398,"_19443":50788,"_25550":50789,"_2667":50790},[],"/docs/pr-preview/pr-55/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_3172":1710,"_28058":1703,"_5":28398,"_19443":50792,"_25550":50793,"_2667":50794},[],"/docs/pr-preview/pr-55/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_3172":1711,"_28058":1703,"_5":28398,"_19443":50796,"_25550":50797,"_2667":50798},[],"/docs/pr-preview/pr-55/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_3172":1712,"_28058":1703,"_5":28398,"_19443":50800,"_25550":50801,"_2667":50802},[],"/docs/pr-preview/pr-55/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_3172":1713,"_28058":1703,"_5":28398,"_19443":50804,"_25550":50805,"_2667":50806},[],"/docs/pr-preview/pr-55/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_3172":1714,"_28058":1703,"_5":28398,"_19443":50808,"_25550":50809,"_2667":50810},[],"/docs/pr-preview/pr-55/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_3172":1715,"_28058":1703,"_5":28398,"_19443":50812,"_25550":50813,"_2667":50814},[],"/docs/pr-preview/pr-55/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_3172":1716,"_28058":1703,"_5":28398,"_19443":50816,"_25550":50817,"_2667":50818},[],"/docs/pr-preview/pr-55/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_3172":1717,"_28058":1703,"_5":28398,"_19443":50820,"_25550":50821,"_2667":50822},[],"/docs/pr-preview/pr-55/platform/pki/certificate-authorities#load-the-material","Load the material",{"_3172":1718,"_28058":1703,"_5":28398,"_19443":50824,"_25550":50825,"_2667":50826},[],"/docs/pr-preview/pr-55/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_3172":1719,"_28058":1703,"_5":28398,"_19443":50828,"_25550":50829,"_2667":50830},[],"/docs/pr-preview/pr-55/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_3172":1720,"_28058":1703,"_5":28398,"_19443":50832,"_25550":50833,"_2667":50834},[],"/docs/pr-preview/pr-55/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_3172":1721,"_28058":1703,"_5":28398,"_19443":50836,"_25550":50837,"_2667":50838},[],"/docs/pr-preview/pr-55/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_3172":1722,"_28058":1703,"_5":28398,"_19443":50840,"_25550":50841,"_2667":50842},[],"/docs/pr-preview/pr-55/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_3172":1723,"_28058":1703,"_5":28398,"_19443":50844,"_25550":50845,"_2667":50846},[],"/docs/pr-preview/pr-55/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_3172":1724,"_28058":1703,"_5":28398,"_19443":50848,"_25550":50849,"_2667":50850},[],"/docs/pr-preview/pr-55/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_3172":1725,"_28058":1703,"_5":28398,"_19443":50852,"_25550":50853,"_2667":50854},[],"/docs/pr-preview/pr-55/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_3172":1726,"_28058":1703,"_5":28398,"_19443":50856,"_25550":50857,"_2667":50858},[],"/docs/pr-preview/pr-55/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_3172":1727,"_28058":1703,"_19443":50860,"_5":13331,"_25550":1703,"_2667":50861},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_3172":1728,"_28058":1703,"_19443":50863,"_5":13331,"_25550":1703,"_2667":50864},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_3172":1729,"_28058":1703,"_19443":50866,"_5":13331,"_25550":1703,"_2667":50867},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_3172":1730,"_28058":1703,"_19443":50869,"_5":13331,"_25550":50774,"_2667":50870},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_3172":1731,"_28058":1703,"_19443":50872,"_5":13331,"_25550":50774,"_2667":50873},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_3172":1732,"_28058":1703,"_19443":50875,"_5":13331,"_25550":50774,"_2667":50876},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_3172":1733,"_28058":1703,"_19443":50878,"_5":13331,"_25550":50774,"_2667":50879},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_3172":1734,"_28058":1703,"_19443":50881,"_5":13331,"_25550":50774,"_2667":50882},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_3172":1735,"_28058":1703,"_19443":50884,"_5":13331,"_25550":50782,"_2667":50885},[],"Decide whether the CA will be a root or an intermediate.",{"_3172":1736,"_28058":1703,"_19443":50887,"_5":13331,"_25550":50782,"_2667":50888},[],"Choose the engine that will keep the key.",{"_3172":1737,"_28058":1703,"_19443":50890,"_5":13331,"_25550":50782,"_2667":50891},[],"Define a validity longer than that of the certificates it will issue.",{"_3172":1738,"_28058":1703,"_19443":50893,"_5":13331,"_25550":50782,"_2667":50894},[],"For an intermediate CA, make sure the parent CA is active.",{"_3172":1739,"_28058":1703,"_19443":50896,"_5":13331,"_25550":50785,"_2667":50897},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_3172":1740,"_28058":1703,"_19443":50899,"_5":13331,"_25550":50789,"_2667":50900},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_3172":1741,"_28058":1703,"_19443":50902,"_5":13331,"_25550":50789,"_2667":50903},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_3172":1742,"_28058":1703,"_19443":50905,"_5":13331,"_25550":50793,"_2667":50906},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_3172":1743,"_28058":1703,"_19443":50908,"_5":13331,"_25550":50797,"_2667":50909},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_3172":1744,"_28058":1703,"_19443":50911,"_5":13331,"_25550":50797,"_2667":50912},[],"`C`: two-letter ISO 3166-1 country code.",{"_3172":1745,"_28058":1703,"_19443":50914,"_5":13331,"_25550":50797,"_2667":50915},[],"`ST`: state or province.",{"_3172":1746,"_28058":1703,"_19443":50917,"_5":13331,"_25550":50797,"_2667":50918},[],"`L`: locality.",{"_3172":1747,"_28058":1703,"_19443":50920,"_5":13331,"_25550":50797,"_2667":50921},[],"`O`: organization.",{"_3172":1748,"_28058":1703,"_19443":50923,"_5":13331,"_25550":50797,"_2667":50924},[],"`OU`: organizational unit.",{"_3172":1749,"_28058":1703,"_19443":50926,"_5":13331,"_25550":50797,"_2667":50927},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_3172":1750,"_28058":1703,"_19443":50929,"_5":13331,"_25550":50801,"_2667":50930},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_3172":1751,"_28058":1703,"_19443":50932,"_5":13331,"_25550":50801,"_2667":50933},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_3172":1752,"_28058":1703,"_19443":50935,"_5":13331,"_25550":50805,"_2667":50936},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_3172":1753,"_28058":1703,"_19443":50938,"_5":13331,"_25550":50805,"_2667":50939},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_3172":1754,"_28058":1703,"_19443":50941,"_5":13331,"_25550":50809,"_2667":50942},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_3172":1755,"_28058":1703,"_19443":50944,"_5":13331,"_25550":50809,"_2667":50945},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_3172":1756,"_28058":1703,"_19443":50947,"_5":13331,"_25550":50813,"_2667":50948},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_3172":1757,"_28058":1703,"_19443":50950,"_5":13331,"_25550":50817,"_2667":50951},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_3172":1758,"_28058":1703,"_19443":50953,"_5":13331,"_25550":50821,"_2667":50954},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_3172":1759,"_28058":1703,"_19443":50956,"_5":13331,"_25550":50825,"_2667":50957},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_3172":1760,"_28058":1703,"_19443":50959,"_5":13331,"_25550":50829,"_2667":50960},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_3172":1761,"_28058":1703,"_19443":50962,"_5":13331,"_25550":50829,"_2667":50963},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_3172":1762,"_28058":1703,"_19443":50965,"_5":13331,"_25550":50833,"_2667":50966},[],"Open a CA from the inventory to review:",{"_3172":1763,"_28058":1703,"_19443":50968,"_5":13331,"_25550":50833,"_2667":50969},[],"Status and validity period.",{"_3172":1764,"_28058":1703,"_19443":50971,"_5":13331,"_25550":50833,"_2667":50972},[],"Certificate and chain in PEM format.",{"_3172":1765,"_28058":1703,"_19443":50974,"_5":13331,"_25550":50833,"_2667":50975},[],"Number of active, expired and revoked certificates.",{"_3172":1766,"_28058":1703,"_19443":50977,"_5":13331,"_25550":50833,"_2667":50978},[],"Certificates issued in **Issued Certificates**.",{"_3172":1767,"_28058":1703,"_19443":50980,"_5":13331,"_25550":50833,"_2667":50981},[],"The CRL linked to the authority.",{"_3172":1768,"_28058":1703,"_19443":50983,"_5":13331,"_25550":50833,"_2667":50984},[],"Metadata and the associated cryptographic engine.",{"_3172":1769,"_28058":1703,"_19443":50986,"_5":13331,"_25550":50833,"_2667":50987},[],"You can filter the inventory by name, status and CA type.",{"_3172":1770,"_28058":1703,"_19443":50989,"_5":13331,"_25550":50837,"_2667":50990},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_3172":1771,"_28058":1703,"_19443":50992,"_5":13331,"_25550":50837,"_2667":50993},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_3172":1772,"_28058":1703,"_19443":50995,"_5":13331,"_25550":50837,"_2667":50996},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_3172":1773,"_28058":1703,"_19443":50998,"_5":13331,"_25550":50837,"_2667":50999},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_3172":1774,"_28058":1703,"_19443":51001,"_5":13331,"_25550":50841,"_2667":51002},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_3172":1775,"_28058":1703,"_19443":51004,"_5":13331,"_25550":50845,"_2667":51005},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_3172":1776,"_28058":1703,"_19443":51007,"_5":13331,"_25550":50849,"_2667":51008},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_3172":1777,"_28058":1703,"_19443":51010,"_5":13331,"_25550":50853,"_2667":51011},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_3172":1778,"_28058":1703,"_19443":51013,"_5":13331,"_25550":50857,"_2667":51014},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_3172":1779,"_28058":1703,"_19443":51016,"_5":13331,"_25550":50857,"_2667":51017},[],"Permanent deletion is only available after revoking. Delete the record only when your retention and audit policy allows it.",{"_3172":1780,"_28058":1780,"_5":13662,"_2667":51019,"_28401":51020,"_19443":51021,"_25550":1780},"Certificate profiles",[45477,46870,50603,50604],[],{"_3172":1781,"_28058":1780,"_19443":51023,"_5":13331,"_25550":1780,"_2667":51024},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_3172":1782,"_28058":1780,"_5":28398,"_19443":51026,"_25550":51027,"_2667":51028},[],"/docs/pr-preview/pr-55/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_3172":1783,"_28058":1780,"_5":28398,"_19443":51030,"_25550":51031,"_2667":51032},[],"/docs/pr-preview/pr-55/platform/pki/certificate-profiles#validity","Validity",{"_3172":1784,"_28058":1780,"_5":28398,"_19443":51034,"_25550":51035,"_2667":51036},[],"/docs/pr-preview/pr-55/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_3172":1785,"_28058":1780,"_5":28398,"_19443":51038,"_25550":51039,"_2667":51040},[],"/docs/pr-preview/pr-55/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_3172":1786,"_28058":1780,"_5":28398,"_19443":51042,"_25550":51043,"_2667":51044},[],"/docs/pr-preview/pr-55/platform/pki/certificate-profiles#subject","Subject",{"_3172":1787,"_28058":1780,"_5":28398,"_19443":51046,"_25550":51047,"_2667":51048},[],"/docs/pr-preview/pr-55/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_3172":1788,"_28058":1780,"_5":28398,"_19443":51050,"_25550":51051,"_2667":51052},[],"/docs/pr-preview/pr-55/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_3172":1789,"_28058":1780,"_5":28398,"_19443":51054,"_25550":51055,"_2667":51056},[],"/docs/pr-preview/pr-55/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_3172":1790,"_28058":1780,"_5":28398,"_19443":51058,"_25550":51059,"_2667":51060},[],"/docs/pr-preview/pr-55/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_3172":1791,"_28058":1780,"_5":28398,"_19443":51062,"_25550":51063,"_2667":51064},[],"/docs/pr-preview/pr-55/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_3172":1792,"_28058":1780,"_5":28398,"_19443":51066,"_25550":51067,"_2667":51068},[],"/docs/pr-preview/pr-55/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_3172":1793,"_28058":1780,"_5":28398,"_19443":51070,"_25550":51071,"_2667":51072},[],"/docs/pr-preview/pr-55/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_3172":1794,"_28058":1780,"_5":28398,"_19443":51074,"_25550":51075,"_2667":51076},[],"/docs/pr-preview/pr-55/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_3172":1795,"_28058":1780,"_5":28398,"_19443":51078,"_25550":51079,"_2667":51080},[],"/docs/pr-preview/pr-55/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_3172":1796,"_28058":1780,"_5":28398,"_19443":51082,"_25550":51083,"_2667":51084},[],"/docs/pr-preview/pr-55/platform/pki/certificate-profiles#design-examples","Design examples",{"_3172":1797,"_28058":1780,"_5":28398,"_19443":51086,"_25550":51087,"_2667":51088},[],"/docs/pr-preview/pr-55/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_3172":1798,"_28058":1780,"_19443":51090,"_5":13331,"_25550":1780,"_2667":51091},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_3172":1799,"_28058":1780,"_19443":51093,"_5":13331,"_25550":1780,"_2667":51094},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_3172":1800,"_28058":1780,"_19443":51096,"_5":13331,"_25550":51031,"_2667":51097},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_3172":1801,"_28058":1780,"_19443":51099,"_5":13331,"_25550":51031,"_2667":51100},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_3172":1802,"_28058":1780,"_19443":51102,"_5":13331,"_25550":51035,"_2667":51103},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Enable it only in profiles intended to create or reissue subordinate CAs.",{"_3172":1803,"_28058":1780,"_19443":51105,"_5":13331,"_25550":51039,"_2667":51106},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_3172":1804,"_28058":1780,"_19443":51108,"_5":13331,"_25550":51039,"_2667":51109},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_3172":1805,"_28058":1780,"_19443":51111,"_5":13331,"_25550":51039,"_2667":51112},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_3172":1806,"_28058":1780,"_19443":51114,"_5":13331,"_25550":51043,"_2667":51115},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_3172":1807,"_28058":1780,"_19443":51117,"_5":13331,"_25550":51047,"_2667":51118},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_3172":1808,"_28058":1780,"_19443":51120,"_5":13331,"_25550":51047,"_2667":51121},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_3172":1809,"_28058":1780,"_19443":51123,"_5":13331,"_25550":51051,"_2667":51124},[],"The cryptographic enforcement can:",{"_3172":1810,"_28058":1780,"_19443":51126,"_5":13331,"_25550":51051,"_2667":51127},[],"allow or block RSA keys;",{"_3172":1811,"_28058":1780,"_19443":51129,"_5":13331,"_25550":51051,"_2667":51130},[],"limit the supported RSA sizes;",{"_3172":1812,"_28058":1780,"_19443":51132,"_5":13331,"_25550":51051,"_2667":51133},[],"allow or block ECDSA keys;",{"_3172":1813,"_28058":1780,"_19443":51135,"_5":13331,"_25550":51051,"_2667":51136},[],"limit the supported ECDSA sizes or curves.",{"_3172":1814,"_28058":1780,"_19443":51138,"_5":13331,"_25550":51051,"_2667":51139},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_3172":1815,"_28058":1780,"_19443":51141,"_5":13331,"_25550":51055,"_2667":51142},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_3172":1816,"_28058":1780,"_19443":51144,"_5":13331,"_25550":51055,"_2667":48631},[],{"_3172":1817,"_28058":1780,"_19443":51146,"_5":13331,"_25550":51055,"_2667":51147},[],"First choice",{"_3172":1818,"_28058":1780,"_19443":51149,"_5":13331,"_25550":51055,"_2667":51150},[],"Second choice",{"_3172":1819,"_28058":1780,"_19443":51152,"_5":13331,"_25550":51055,"_2667":51153},[],"If neither is supplied",{"_3172":1820,"_28058":1780,"_19443":51155,"_5":13331,"_25550":51055,"_2667":51156},[],"Direct signing with a CA",{"_3172":1821,"_28058":1780,"_19443":51158,"_5":13331,"_25550":51055,"_2667":51159},[],"`issuance_profile` embedded in the request",{"_3172":1822,"_28058":1780,"_19443":51161,"_5":13331,"_25550":51055,"_2667":51162},[],"Request `issuance_profile_id`",{"_3172":1823,"_28058":1780,"_19443":51164,"_5":13331,"_25550":51055,"_2667":51165},[],"CA default profile (`profile_id`).",{"_3172":1824,"_28058":1780,"_19443":51167,"_5":13331,"_25550":51055,"_2667":51168},[],"Issuance through a DMS",{"_3172":1825,"_28058":1780,"_19443":51170,"_5":13331,"_25550":51055,"_2667":51171},[],"`settings.issuance_profile_id`",{"_3172":1826,"_28058":1780,"_19443":51173,"_5":13331,"_25550":51055,"_2667":51174},[],"`settings.issuance_profile` embedded in the DMS",{"_3172":1827,"_28058":1780,"_19443":51176,"_5":13331,"_25550":51055,"_2667":51177},[],"Enrollment CA default profile.",{"_3172":1828,"_28058":1780,"_19443":51179,"_5":13331,"_25550":51055,"_2667":51180},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_3172":1829,"_28058":1780,"_19443":51182,"_5":13331,"_25550":51055,"_2667":51183},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_3172":1830,"_28058":1780,"_19443":51185,"_5":13331,"_25550":51063,"_2667":51186},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_3172":1831,"_28058":1780,"_19443":51188,"_5":13331,"_25550":51067,"_2667":51189},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_3172":1832,"_28058":1780,"_19443":51191,"_5":13331,"_25550":51071,"_2667":51192},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_3172":1833,"_28058":1780,"_19443":51194,"_5":13331,"_25550":51075,"_2667":51195},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_3172":1834,"_28058":1780,"_19443":51197,"_5":13331,"_25550":51079,"_2667":51198},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_3172":1835,"_28058":1780,"_19443":51200,"_5":13331,"_25550":51079,"_2667":51201},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_3172":1836,"_28058":1780,"_19443":51203,"_5":13331,"_25550":51083,"_2667":51204},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_3172":1837,"_28058":1780,"_19443":51206,"_5":13331,"_25550":51083,"_2667":51207},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_3172":1838,"_28058":1780,"_19443":51209,"_5":13331,"_25550":51083,"_2667":51210},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_3172":1839,"_28058":1780,"_19443":51212,"_5":13331,"_25550":51083,"_2667":51213},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_3172":1840,"_28058":1780,"_19443":51215,"_5":13331,"_25550":51087,"_2667":51216},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_3172":1841,"_28058":1780,"_19443":51218,"_5":13331,"_25550":51087,"_2667":51219},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_3172":1842,"_28058":1842,"_5":13662,"_2667":51221,"_28401":51222,"_19443":51224,"_25550":1842},"Certificate validation",[45477,46870,50603,51223],"Validation",[],{"_3172":1843,"_28058":1842,"_19443":51226,"_5":13331,"_25550":1842,"_2667":51227},[],"Check chain, identity, purpose and revocation from the consumer.",{"_3172":1844,"_28058":1842,"_5":28398,"_19443":51229,"_25550":51230,"_2667":51231},[],"/docs/pr-preview/pr-55/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_3172":1845,"_28058":1842,"_5":28398,"_19443":51233,"_25550":51234,"_2667":51235},[],"/docs/pr-preview/pr-55/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_3172":1846,"_28058":1842,"_5":28398,"_19443":51237,"_25550":51238,"_2667":51239},[],"/docs/pr-preview/pr-55/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_3172":1847,"_28058":1842,"_19443":51241,"_5":13331,"_25550":1842,"_2667":51242},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_3172":1848,"_28058":1842,"_19443":51244,"_5":13331,"_25550":51230,"_2667":51245},[],"Verify these criteria together:",{"_3172":1849,"_28058":1842,"_19443":51247,"_5":13331,"_25550":51230,"_2667":50227},[],{"_3172":1850,"_28058":1842,"_19443":51249,"_5":13331,"_25550":51230,"_2667":51250},[],"Required result",{"_3172":1851,"_28058":1842,"_19443":51252,"_5":13331,"_25550":51230,"_2667":51253},[],"Chain and signature",{"_3172":1852,"_28058":1842,"_19443":51255,"_5":13331,"_25550":51230,"_2667":51256},[],"Valid chain to a root deliberately installed in the consumer.",{"_3172":1853,"_28058":1842,"_19443":51258,"_5":13331,"_25550":51230,"_2667":51259},[],"Dates",{"_3172":1854,"_28058":1842,"_19443":51261,"_5":13331,"_25550":51230,"_2667":51262},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_3172":1855,"_28058":1842,"_19443":51264,"_5":13331,"_25550":51230,"_2667":46567},[],{"_3172":1856,"_28058":1842,"_19443":51266,"_5":13331,"_25550":51230,"_2667":51267},[],"Name, SAN or identifier matches the expected peer.",{"_3172":1857,"_28058":1842,"_19443":51269,"_5":13331,"_25550":51230,"_2667":45867},[],{"_3172":1858,"_28058":1842,"_19443":51271,"_5":13331,"_25550":51230,"_2667":51272},[],"KU, EKU and constraints permit the specific operation.",{"_3172":1859,"_28058":1842,"_19443":51274,"_5":13331,"_25550":51230,"_2667":51275},[],"Revocation",{"_3172":1860,"_28058":1842,"_19443":51277,"_5":13331,"_25550":51230,"_2667":51278},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_3172":1861,"_28058":1842,"_19443":51280,"_5":13331,"_25550":51230,"_2667":51281},[],"Authorization",{"_3172":1862,"_28058":1842,"_19443":51283,"_5":13331,"_25550":51230,"_2667":51284},[],"The application permits that identity to perform the action.",{"_3172":1863,"_28058":1842,"_19443":51286,"_5":13331,"_25550":51230,"_2667":51287},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_3172":1864,"_28058":1842,"_19443":51289,"_5":13331,"_25550":51234,"_2667":51290},[],"Mechanism",{"_3172":1865,"_28058":1842,"_19443":51292,"_5":13331,"_25550":51234,"_2667":51293},[],"When to use it",{"_3172":1866,"_28058":1842,"_19443":51295,"_5":13331,"_25550":51234,"_2667":51296},[],"What you must maintain",{"_3172":1867,"_28058":1842,"_19443":51298,"_5":13331,"_25550":51234,"_2667":51299},[],"OCSP",{"_3172":1868,"_28058":1842,"_19443":51301,"_5":13331,"_25550":51234,"_2667":51302},[],"Status query for a specific certificate.",{"_3172":1869,"_28058":1842,"_19443":51304,"_5":13331,"_25550":51234,"_2667":51305},[],"Responder access, signature verification and cache/freshness policy.",{"_3172":1870,"_28058":1842,"_19443":51307,"_5":13331,"_25550":51234,"_2667":51308},[],"CRL",{"_3172":1871,"_28058":1842,"_19443":51310,"_5":13331,"_25550":51234,"_2667":51311},[],"Local checks for many certificates or offline operation.",{"_3172":1872,"_28058":1842,"_19443":51313,"_5":13331,"_25550":51234,"_2667":51314},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_3172":1873,"_28058":1842,"_19443":51316,"_5":13331,"_25550":51234,"_2667":51317},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_3172":1874,"_28058":1842,"_19443":51319,"_5":13331,"_25550":51234,"_2667":51320},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_3172":1875,"_28058":1842,"_19443":51322,"_5":13331,"_25550":51238,"_2667":51323},[],"Accept a current, authorized certificate with a known chain.",{"_3172":1876,"_28058":1842,"_19443":51325,"_5":13331,"_25550":51238,"_2667":51326},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_3172":1877,"_28058":1842,"_19443":51328,"_5":13331,"_25550":51238,"_2667":51329},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_3172":1878,"_28058":1842,"_19443":51331,"_5":13331,"_25550":51238,"_2667":51332},[],"Check that a new connection with that identity is rejected.",{"_3172":1879,"_28058":1842,"_19443":51334,"_5":13331,"_25550":51238,"_2667":51335},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_3172":1880,"_28058":1842,"_19443":51337,"_5":13331,"_25550":51238,"_2667":51338},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_3172":1881,"_28058":1842,"_19443":51340,"_5":13331,"_25550":51238,"_2667":51341},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_3172":1882,"_28058":1842,"_19443":51343,"_5":13331,"_25550":51238,"_2667":51344},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_3172":1883,"_28058":1842,"_19443":51346,"_5":13331,"_25550":51238,"_2667":51347},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_3172":1884,"_28058":1884,"_5":13662,"_2667":51349,"_28401":51350,"_19443":51351,"_25550":1884},"Certificates",[45477,46870,50603,50604],[],{"_3172":1885,"_28058":1884,"_19443":51353,"_5":13331,"_25550":1884,"_2667":51354},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_3172":1886,"_28058":1884,"_5":28398,"_19443":51356,"_25550":51357,"_2667":51358},[],"/docs/pr-preview/pr-55/platform/pki/certificates#find-a-certificate","Find a certificate",{"_3172":1887,"_28058":1884,"_5":28398,"_19443":51360,"_25550":51361,"_2667":51362},[],"/docs/pr-preview/pr-55/platform/pki/certificates#download-the-certificate","Download the certificate",{"_3172":1888,"_28058":1884,"_5":28398,"_19443":51364,"_25550":51365,"_2667":51366},[],"/docs/pr-preview/pr-55/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_3172":1889,"_28058":1884,"_5":28398,"_19443":51368,"_25550":51369,"_2667":51370},[],"/docs/pr-preview/pr-55/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_3172":1890,"_28058":1884,"_5":28398,"_19443":51372,"_25550":51373,"_2667":51374},[],"/docs/pr-preview/pr-55/platform/pki/certificates#open-the-action","Open the action",{"_3172":1891,"_28058":1884,"_5":28398,"_19443":51376,"_25550":51377,"_2667":51378},[],"/docs/pr-preview/pr-55/platform/pki/certificates#choose-a-reason","Choose a reason",{"_3172":1892,"_28058":1884,"_5":28398,"_19443":51380,"_25550":51381,"_2667":51382},[],"/docs/pr-preview/pr-55/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_3172":1893,"_28058":1884,"_5":28398,"_19443":51384,"_25550":51385,"_2667":51386},[],"/docs/pr-preview/pr-55/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_3172":1894,"_28058":1884,"_5":28398,"_19443":51388,"_25550":51389,"_2667":51390},[],"/docs/pr-preview/pr-55/platform/pki/certificates#continue","Continue",{"_3172":1895,"_28058":1884,"_19443":51392,"_5":13331,"_25550":1884,"_2667":51393},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_3172":1896,"_28058":1884,"_19443":51395,"_5":13331,"_25550":51357,"_2667":51396},[],"Filter by `Common Name`, serial, status and issuer. Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_3172":1897,"_28058":1884,"_19443":51398,"_5":13331,"_25550":51357,"_2667":51399},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_3172":1898,"_28058":1884,"_19443":51401,"_5":13331,"_25550":51361,"_2667":51402},[],"Download the PEM and inspect it:",{"_3172":1899,"_28058":1884,"_19443":51404,"_5":13331,"_25550":51361,"_2667":51405},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_3172":1900,"_28058":1884,"_19443":51407,"_5":13331,"_25550":51365,"_2667":51408},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_3172":1901,"_28058":1884,"_19443":51410,"_5":13331,"_25550":51365,"_2667":51411},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_3172":1902,"_28058":1884,"_19443":51413,"_5":13331,"_25550":51365,"_2667":51414},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_3172":1903,"_28058":1884,"_19443":51416,"_5":13331,"_25550":51365,"_2667":51417},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_3172":1904,"_28058":1884,"_19443":51419,"_5":13331,"_25550":51365,"_2667":51420},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_3172":1905,"_28058":1884,"_19443":51422,"_5":13331,"_25550":51365,"_2667":51423},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_3172":1906,"_28058":1884,"_19443":51425,"_5":13331,"_25550":51365,"_2667":51426},[],"For browser key generation, follow Issue your first certificate.",{"_3172":1907,"_28058":1884,"_19443":51428,"_5":13331,"_25550":51369,"_2667":51429},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_3172":1908,"_28058":1884,"_19443":51431,"_5":13331,"_25550":51373,"_2667":51432},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_3172":1909,"_28058":1884,"_19443":51434,"_5":13331,"_25550":51377,"_2667":51435},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_3172":1910,"_28058":1884,"_19443":51437,"_5":13331,"_25550":51381,"_2667":51438},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_3172":1911,"_28058":1884,"_19443":51440,"_5":13331,"_25550":51381,"_2667":51441},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_3172":1912,"_28058":1884,"_19443":51443,"_5":13331,"_25550":51381,"_2667":51444},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_3172":1913,"_28058":1884,"_19443":51446,"_5":13331,"_25550":51385,"_2667":51447},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_3172":1914,"_28058":1884,"_19443":51449,"_5":13331,"_25550":51385,"_2667":51450},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_3172":1915,"_28058":1884,"_19443":51452,"_5":13331,"_25550":51385,"_2667":51453},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_3172":1916,"_28058":1884,"_19443":51455,"_5":13331,"_25550":51389,"_2667":51456},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_3172":1917,"_28058":1884,"_19443":51458,"_5":13331,"_25550":51389,"_2667":51459},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_3172":1918,"_28058":1918,"_5":13662,"_2667":51461,"_28401":51462,"_19443":51464,"_25550":1918},"Certificate lifecycle",[45477,46870,50603,51463],"Concepts",[],{"_3172":1919,"_28058":1918,"_19443":51466,"_5":13331,"_25550":1918,"_2667":51467},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_3172":1920,"_28058":1918,"_5":28398,"_19443":51469,"_25550":51470,"_2667":51471},[],"/docs/pr-preview/pr-55/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_3172":1921,"_28058":1918,"_5":28398,"_19443":51473,"_25550":51474,"_2667":51475},[],"/docs/pr-preview/pr-55/platform/pki/concepts/certificate-lifecycle#request","Request",{"_3172":1922,"_28058":1918,"_5":28398,"_19443":51477,"_25550":51478,"_2667":51479},[],"/docs/pr-preview/pr-55/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_3172":1923,"_28058":1918,"_5":28398,"_19443":51481,"_25550":51482,"_2667":51483},[],"/docs/pr-preview/pr-55/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_3172":1924,"_28058":1918,"_5":28398,"_19443":51485,"_25550":51486,"_2667":51487},[],"/docs/pr-preview/pr-55/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_3172":1925,"_28058":1918,"_5":28398,"_19443":51489,"_25550":51490,"_2667":51491},[],"/docs/pr-preview/pr-55/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_3172":1926,"_28058":1918,"_5":28398,"_19443":51493,"_25550":51494,"_2667":51495},[],"/docs/pr-preview/pr-55/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_3172":1927,"_28058":1918,"_5":28398,"_19443":51497,"_25550":51498,"_2667":51499},[],"/docs/pr-preview/pr-55/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_3172":1928,"_28058":1918,"_5":28398,"_19443":51501,"_25550":51502,"_2667":51503},[],"/docs/pr-preview/pr-55/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_3172":1929,"_28058":1918,"_5":28398,"_19443":51505,"_25550":51506,"_2667":51507},[],"/docs/pr-preview/pr-55/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_3172":1930,"_28058":1918,"_19443":51509,"_5":13331,"_25550":1918,"_2667":51510},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_3172":1931,"_28058":1918,"_19443":51512,"_5":13331,"_25550":51474,"_2667":51513},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_3172":1932,"_28058":1918,"_19443":51515,"_5":13331,"_25550":51478,"_2667":51516},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_3172":1933,"_28058":1918,"_19443":51518,"_5":13331,"_25550":51482,"_2667":51519},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_3172":1934,"_28058":1918,"_19443":51521,"_5":13331,"_25550":51486,"_2667":51522},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_3172":1935,"_28058":1918,"_19443":51524,"_5":13331,"_25550":51490,"_2667":51525},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_3172":1936,"_28058":1918,"_19443":51527,"_5":13331,"_25550":51494,"_2667":51528},[],"Lamassu persists four X.509 states:",{"_3172":1937,"_28058":1918,"_19443":51530,"_5":13331,"_25550":51494,"_2667":51531},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_3172":1938,"_28058":1918,"_19443":51533,"_5":13331,"_25550":51494,"_2667":51534},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_3172":1939,"_28058":1918,"_19443":51536,"_5":13331,"_25550":51494,"_2667":51537},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_3172":1940,"_28058":1918,"_19443":51539,"_5":13331,"_25550":51494,"_2667":51540},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_3172":1941,"_28058":1918,"_19443":51542,"_5":13331,"_25550":51494,"_2667":51543},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_3172":1942,"_28058":1918,"_19443":51545,"_5":13331,"_25550":51498,"_2667":51546},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_3172":1943,"_28058":1918,"_19443":51548,"_5":13331,"_25550":51498,"_2667":51549},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_3172":1944,"_28058":1918,"_19443":51551,"_5":13331,"_25550":51498,"_2667":51552},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_3172":1945,"_28058":1918,"_19443":51554,"_5":13331,"_25550":51502,"_2667":51555},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_3172":1946,"_28058":1918,"_19443":51557,"_5":13331,"_25550":51502,"_2667":51558},[],"Before confirming:",{"_3172":1947,"_28058":1918,"_19443":51560,"_5":13331,"_25550":51502,"_2667":51561},[],"Identify DMSs, devices and services that trust that chain.",{"_3172":1948,"_28058":1918,"_19443":51563,"_5":13331,"_25550":51502,"_2667":51564},[],"Distribute the new chain of trust.",{"_3172":1949,"_28058":1918,"_19443":51566,"_5":13331,"_25550":51502,"_2667":51567},[],"Reissue the necessary identities.",{"_3172":1950,"_28058":1918,"_19443":51569,"_5":13331,"_25550":51502,"_2667":51570},[],"Check OCSP and CRL from a real consumer.",{"_3172":1951,"_28058":1918,"_19443":51572,"_5":13331,"_25550":51502,"_2667":51573},[],"Revoke the old CA once no legitimate traffic remains.",{"_3172":1952,"_28058":1918,"_19443":51575,"_5":13331,"_25550":51502,"_2667":51576},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_3172":1953,"_28058":1918,"_19443":51578,"_5":13331,"_25550":51506,"_2667":51579},[],"Certificates entering the preventive or critical renewal window.",{"_3172":1954,"_28058":1918,"_19443":51581,"_5":13331,"_25550":51506,"_2667":51582},[],"Repeated enrollment or re-enrollment failures.",{"_3172":1955,"_28058":1918,"_19443":51584,"_5":13331,"_25550":51506,"_2667":51585},[],"Status changes and revocation reasons.",{"_3172":1956,"_28058":1918,"_19443":51587,"_5":13331,"_25550":51506,"_2667":51588},[],"OCSP and CRL publication and validity.",{"_3172":1957,"_28058":1918,"_19443":51590,"_5":13331,"_25550":51506,"_2667":51591},[],"Dependencies still presenting a replaced certificate.",{"_3172":1958,"_28058":1918,"_19443":51593,"_5":13331,"_25550":51506,"_2667":51594},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_3172":1959,"_28058":1959,"_5":13662,"_2667":51596,"_28401":51597,"_19443":51598,"_25550":1959},"Trust model",[45477,46870,50603,51463],[],{"_3172":1960,"_28058":1959,"_19443":51600,"_5":13331,"_25550":1959,"_2667":51601},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_3172":1961,"_28058":1959,"_5":28398,"_19443":51603,"_25550":51604,"_2667":51605},[],"/docs/pr-preview/pr-55/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_3172":1962,"_28058":1959,"_5":28398,"_19443":51607,"_25550":51608,"_2667":51609},[],"/docs/pr-preview/pr-55/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_3172":1963,"_28058":1959,"_5":28398,"_19443":51611,"_25550":51612,"_2667":51613},[],"/docs/pr-preview/pr-55/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_3172":1964,"_28058":1959,"_5":28398,"_19443":51615,"_25550":51616,"_2667":51617},[],"/docs/pr-preview/pr-55/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_3172":1965,"_28058":1959,"_5":28398,"_19443":51619,"_25550":51620,"_2667":51621},[],"/docs/pr-preview/pr-55/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_3172":1966,"_28058":1959,"_5":28398,"_19443":51623,"_25550":51624,"_2667":51625},[],"/docs/pr-preview/pr-55/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_3172":1967,"_28058":1959,"_5":28398,"_19443":51627,"_25550":51628,"_2667":51629},[],"/docs/pr-preview/pr-55/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_3172":1968,"_28058":1959,"_5":28398,"_19443":51631,"_25550":51632,"_2667":51633},[],"/docs/pr-preview/pr-55/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_3172":1969,"_28058":1959,"_5":28398,"_19443":51635,"_25550":51636,"_2667":51637},[],"/docs/pr-preview/pr-55/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_3172":1970,"_28058":1959,"_5":28398,"_19443":51639,"_25550":51640,"_2667":51641},[],"/docs/pr-preview/pr-55/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_3172":1971,"_28058":1959,"_19443":51643,"_5":13331,"_25550":1959,"_2667":51644},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_3172":1972,"_28058":1959,"_19443":51646,"_5":13331,"_25550":51608,"_2667":51647},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_3172":1973,"_28058":1959,"_19443":51649,"_5":13331,"_25550":51612,"_2667":51650},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_3172":1974,"_28058":1959,"_19443":51652,"_5":13331,"_25550":51616,"_2667":51653},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_3172":1975,"_28058":1959,"_19443":51655,"_5":13331,"_25550":51620,"_2667":51656},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_3172":1976,"_28058":1959,"_19443":51658,"_5":13331,"_25550":51624,"_2667":51659},[],"The device proves it can enroll according to the DMS policy.",{"_3172":1977,"_28058":1959,"_19443":51661,"_5":13331,"_25550":51624,"_2667":51662},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_3172":1978,"_28058":1959,"_19443":51664,"_5":13331,"_25550":51624,"_2667":51665},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_3172":1979,"_28058":1959,"_19443":51667,"_5":13331,"_25550":51624,"_2667":51668},[],"The device installs the certificate and the chain it needs.",{"_3172":1980,"_28058":1959,"_19443":51670,"_5":13331,"_25550":51624,"_2667":51671},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_3172":1981,"_28058":1959,"_19443":51673,"_5":13331,"_25550":51624,"_2667":51674},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_3172":1982,"_28058":1959,"_19443":51676,"_5":13331,"_25550":51628,"_2667":51677},[],"A DMS relates three sets that are worth designing separately:",{"_3172":1983,"_28058":1959,"_19443":51679,"_5":13331,"_25550":51628,"_2667":51680},[],"**Enrollment CA:** signs the new identities.",{"_3172":1984,"_28058":1959,"_19443":51682,"_5":13331,"_25550":51628,"_2667":51683},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, the enrollment CA is always trusted and Lamassu then tries the validation CAs configured in the re-enrollment block; those are optional.",{"_3172":1985,"_28058":1959,"_19443":51685,"_5":13331,"_25550":51628,"_2667":51686},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_3172":1986,"_28058":1959,"_19443":51688,"_5":13331,"_25550":51628,"_2667":51689},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_3172":1987,"_28058":1959,"_19443":51691,"_5":13331,"_25550":51632,"_2667":51692},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_3172":1988,"_28058":1959,"_19443":51694,"_5":13331,"_25550":51632,"_2667":51695},[],"that the current date is between `Not Before` and `Not After`;",{"_3172":1989,"_28058":1959,"_19443":51697,"_5":13331,"_25550":51632,"_2667":51698},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_3172":1990,"_28058":1959,"_19443":51700,"_5":13331,"_25550":51632,"_2667":51701},[],"that names, SANs and subject match the expected identity;",{"_3172":1991,"_28058":1959,"_19443":51703,"_5":13331,"_25550":51632,"_2667":51704},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_3172":1992,"_28058":1959,"_19443":51706,"_5":13331,"_25550":51632,"_2667":51707},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_3172":1993,"_28058":1959,"_19443":51709,"_5":13331,"_25550":51632,"_2667":51710},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_3172":1994,"_28058":1959,"_19443":51712,"_5":13331,"_25550":51636,"_2667":51713},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_3172":1995,"_28058":1959,"_19443":51715,"_5":13331,"_25550":51640,"_2667":51716},[],"Keep the root out of daily operations, or with very restricted access.",{"_3172":1996,"_28058":1959,"_19443":51718,"_5":13331,"_25550":51640,"_2667":51719},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_3172":1997,"_28058":1959,"_19443":51721,"_5":13331,"_25550":51640,"_2667":51722},[],"Assign explicit profiles to every use case.",{"_3172":1998,"_28058":1959,"_19443":51724,"_5":13331,"_25550":51640,"_2667":51725},[],"Distribute the new trust before starting a rotation.",{"_3172":1999,"_28058":1959,"_19443":51727,"_5":13331,"_25550":51640,"_2667":51728},[],"Keep enough overlap to renew a disconnected fleet.",{"_3172":2000,"_28058":1959,"_19443":51730,"_5":13331,"_25550":51640,"_2667":51731},[],"Validate from the consuming system, not only from the Lamassu console.",{"_3172":2001,"_28058":1959,"_19443":51733,"_5":13331,"_25550":51640,"_2667":51734},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_3172":2002,"_28058":2002,"_5":13662,"_2667":51736,"_28401":51737,"_19443":51738,"_25550":2002},"Revocation lists (CRL)",[45477,46870,50603,51223],[],{"_3172":2003,"_28058":2002,"_19443":51740,"_5":13331,"_25550":2002,"_2667":51741},[],"Generate and distribute signed lists to validate certificates offline.",{"_3172":2004,"_28058":2002,"_5":28398,"_19443":51743,"_25550":51744,"_2667":51745},[],"/docs/pr-preview/pr-55/platform/pki/crl#va-role-and-per-ca-configuration","VA role and per-CA configuration",{"_3172":2005,"_28058":2002,"_5":28398,"_19443":51747,"_25550":51748,"_2667":51749},[],"/docs/pr-preview/pr-55/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_3172":2006,"_28058":2002,"_5":28398,"_19443":51751,"_25550":51752,"_2667":51753},[],"/docs/pr-preview/pr-55/platform/pki/crl#crl-contents","CRL contents",{"_3172":2007,"_28058":2002,"_5":28398,"_19443":51755,"_25550":51756,"_2667":51757},[],"/docs/pr-preview/pr-55/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_3172":2008,"_28058":2002,"_5":28398,"_19443":51759,"_25550":51760,"_2667":51761},[],"/docs/pr-preview/pr-55/platform/pki/crl#va-role-management-api","VA role management API",{"_3172":2009,"_28058":2002,"_5":28398,"_19443":51763,"_25550":51764,"_2667":51765},[],"/docs/pr-preview/pr-55/platform/pki/crl#from-the-interface","From the interface",{"_3172":2010,"_28058":2002,"_5":28398,"_19443":51767,"_25550":51768,"_2667":51769},[],"/docs/pr-preview/pr-55/platform/pki/crl#references","References",{"_3172":2011,"_28058":2002,"_19443":51771,"_5":13331,"_25550":2002,"_2667":51772},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its SKI and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_3172":2012,"_28058":2002,"_19443":51774,"_5":13331,"_25550":51744,"_2667":51775},[],"The VA role stores configuration and metadata for the latest list published for a CA’s SKI. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_3172":2013,"_28058":2002,"_19443":51777,"_5":13331,"_25550":51744,"_2667":51778},[],"`crl_options` field",{"_3172":2014,"_28058":2002,"_19443":51780,"_5":13331,"_25550":51744,"_2667":45867},[],{"_3172":2015,"_28058":2002,"_19443":51782,"_5":13331,"_25550":51744,"_2667":51783},[],"Backend initial value",{"_3172":2016,"_28058":2002,"_19443":51785,"_5":13331,"_25550":51744,"_2667":51786},[],"`validity`",{"_3172":2017,"_28058":2002,"_19443":51788,"_5":13331,"_25550":51744,"_2667":51789},[],"Time from `thisUpdate` to `nextUpdate`.",{"_3172":2018,"_28058":2002,"_19443":51791,"_5":13331,"_25550":51744,"_2667":51792},[],"7 days.",{"_3172":2019,"_28058":2002,"_19443":51794,"_5":13331,"_25550":51744,"_2667":51795},[],"`refresh_interval`",{"_3172":2020,"_28058":2002,"_19443":51797,"_5":13331,"_25550":51744,"_2667":51798},[],"Time since the issuance of the latest published CRL that triggers scheduled renewal.",{"_3172":2021,"_28058":2002,"_19443":51800,"_5":13331,"_25550":51744,"_2667":51801},[],"6 days and 23 hours.",{"_3172":2022,"_28058":2002,"_19443":51803,"_5":13331,"_25550":51744,"_2667":51804},[],"`regenerate_on_revoke`",{"_3172":2023,"_28058":2002,"_19443":51806,"_5":13331,"_25550":51744,"_2667":51807},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_3172":2024,"_28058":2002,"_19443":51809,"_5":13331,"_25550":51744,"_2667":51810},[],"`true`.",{"_3172":2025,"_28058":2002,"_19443":51812,"_5":13331,"_25550":51744,"_2667":51813},[],"`signer_certificate_serial_number`",{"_3172":2026,"_28058":2002,"_19443":51815,"_5":13331,"_25550":51744,"_2667":51816},[],"Serial number of the certificate used to sign the CRL.",{"_3172":2027,"_28058":2002,"_19443":51818,"_5":13331,"_25550":51744,"_2667":51819},[],"CA certificate serial number.",{"_3172":2028,"_28058":2002,"_19443":51821,"_5":13331,"_25550":51744,"_2667":51822},[],"The CRL is signed by the certificate identified by `signer_certificate_serial_number`. That certificate must exist in the CA’s certificate store, share the CA’s subject and public key, and carry the `cRLSign` key usage. You can change the signer with `PUT /v1/roles/{ca-ski}` (see VA role management API).",{"_3172":2029,"_28058":2002,"_19443":51824,"_5":13331,"_25550":51744,"_2667":51825},[],"When the CA is reissued, if the signer references the superseded CA certificate, the VA moves it to the new certificate — provided the new certificate carries `cRLSign` — and republishes the CRL. A role signed by a different certificate, for example a delegated signer, is deliberately left unchanged.",{"_3172":2030,"_28058":2002,"_19443":51827,"_5":13331,"_25550":51744,"_2667":51828},[],"`latest_crl` contains version, validity start and end. Versions are kept as PEM in object storage at `pki/va/crl/{subject_key_id}/{version}.crl`; the public endpoint returns DER.",{"_3172":2031,"_28058":2002,"_19443":51830,"_5":13331,"_25550":51748,"_2667":51831},[],"The scheduled job requests another list when the time elapsed since the issuance of the latest published CRL reaches `refresh_interval`, or earlier when the list approaches expiration within the configured watch period. Setting the interval to `0` disables interval-based renewal; regeneration before expiration still applies. The effective timing is also bounded by the CRL monitoring job’s frequency. This depends on working jobs, storage and signing; it does not guarantee renewal during a service failure.",{"_3172":2032,"_28058":2002,"_19443":51833,"_5":13331,"_25550":51748,"_2667":51834},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_3172":2033,"_28058":2002,"_19443":51836,"_5":13331,"_25550":51748,"_2667":51837},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_3172":2034,"_28058":2002,"_19443":51839,"_5":13331,"_25550":51752,"_2667":51840},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_3172":2035,"_28058":2002,"_19443":51842,"_5":13331,"_25550":51752,"_2667":51843},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_3172":2036,"_28058":2002,"_19443":51845,"_5":13331,"_25550":51756,"_2667":51846},[],"The VA service exposes `GET /crl/{subject_key_id}` without management authorization. Use the **issuing CA’s** SKI, not the end-entity certificate’s SKI or serial. First inspect the certificate’s CDP:",{"_3172":2037,"_28058":2002,"_19443":51848,"_5":13331,"_25550":51756,"_2667":51849},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_3172":2038,"_28058":2002,"_19443":51851,"_5":13331,"_25550":51756,"_2667":51852},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_3172":2039,"_28058":2002,"_19443":51854,"_5":13331,"_25550":51756,"_2667":51855},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_3172":2040,"_28058":2002,"_19443":51857,"_5":13331,"_25550":51756,"_2667":51858},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_3172":2041,"_28058":2002,"_19443":51860,"_5":13331,"_25550":51760,"_2667":51861},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_3172":2042,"_28058":2002,"_19443":51863,"_5":13331,"_25550":51760,"_2667":48634},[],{"_3172":2043,"_28058":2002,"_19443":51865,"_5":13331,"_25550":51760,"_2667":51866},[],"Relative path",{"_3172":2044,"_28058":2002,"_19443":51868,"_5":13331,"_25550":51760,"_2667":48631},[],{"_3172":2045,"_28058":2002,"_19443":51870,"_5":13331,"_25550":51760,"_2667":51871},[],"`GET`",{"_3172":2046,"_28058":2002,"_19443":51873,"_5":13331,"_25550":51760,"_2667":51874},[],"`/v1/roles/{ca-ski}`",{"_3172":2047,"_28058":2002,"_19443":51876,"_5":13331,"_25550":51760,"_2667":51877},[],"Read `crl_options` and `latest_crl`.",{"_3172":2048,"_28058":2002,"_19443":51879,"_5":13331,"_25550":51760,"_2667":51880},[],"`PUT`",{"_3172":2049,"_28058":2002,"_19443":51882,"_5":13331,"_25550":51760,"_2667":51874},[],{"_3172":2050,"_28058":2002,"_19443":51884,"_5":13331,"_25550":51760,"_2667":51885},[],"Replace CRL configuration.",{"_3172":2051,"_28058":2002,"_19443":51887,"_5":13331,"_25550":51760,"_2667":51888},[],"You need authentication and role read or update permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract: the backend replaces `crl_options`; it does not merge omitted fields.",{"_3172":2052,"_28058":2002,"_19443":51890,"_5":13331,"_25550":51760,"_2667":51891},[],"After a change, check saved configuration and the next list actually published. Updating the role alone does not establish regeneration or client acceptance.",{"_3172":2053,"_28058":2002,"_19443":51893,"_5":13331,"_25550":51764,"_2667":51894},[],"The CA view lets you inspect and download the available list. Compare version, issuer and timestamps with the copy downloaded from the public endpoint. Diagnose differences using PKI troubleshooting.",{"_3172":2054,"_28058":2002,"_19443":51896,"_5":13331,"_25550":51768,"_2667":51897},[],"RFC 5280: X.509 and CRL profile.",{"_3172":2055,"_28058":2002,"_19443":51899,"_5":13331,"_25550":51768,"_2667":51900},[],"OpenSSL: openssl-crl.",{"_3172":2056,"_28058":2002,"_19443":51902,"_5":13331,"_25550":51768,"_2667":51903},[],"OpenSSL: openssl-verify.",{"_3172":2057,"_28058":2002,"_19443":51905,"_5":13331,"_25550":51768,"_2667":51906},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_3172":2058,"_28058":2002,"_19443":51908,"_5":13331,"_25550":51768,"_2667":51909},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3172":2059,"_28058":2059,"_5":13662,"_2667":51911,"_28401":51912,"_19443":51913,"_25550":2059},"Keys and cryptographic engines",[45477,46870,50603,50604],[],{"_3172":2060,"_28058":2059,"_19443":51915,"_5":13331,"_25550":2059,"_2667":51916},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_3172":2061,"_28058":2059,"_5":28398,"_19443":51918,"_25550":51919,"_2667":51920},[],"/docs/pr-preview/pr-55/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_3172":2062,"_28058":2059,"_5":28398,"_19443":51922,"_25550":51923,"_2667":51924},[],"/docs/pr-preview/pr-55/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_3172":2063,"_28058":2059,"_5":28398,"_19443":51926,"_25550":51927,"_2667":51928},[],"/docs/pr-preview/pr-55/platform/pki/key-management#file-system","File System",{"_3172":2064,"_28058":2059,"_5":28398,"_19443":51930,"_25550":51931,"_2667":51932},[],"/docs/pr-preview/pr-55/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3172":2065,"_28058":2059,"_5":28398,"_19443":51934,"_25550":51935,"_2667":51936},[],"/docs/pr-preview/pr-55/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3172":2066,"_28058":2059,"_5":28398,"_19443":51938,"_25550":51939,"_2667":51940},[],"/docs/pr-preview/pr-55/platform/pki/key-management#aws-kms","AWS KMS",{"_3172":2067,"_28058":2059,"_5":28398,"_19443":51942,"_25550":51943,"_2667":51944},[],"/docs/pr-preview/pr-55/platform/pki/key-management#pkcs11","PKCS#11",{"_3172":2068,"_28058":2059,"_5":28398,"_19443":51946,"_25550":51947,"_2667":51948},[],"/docs/pr-preview/pr-55/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_3172":2069,"_28058":2059,"_5":28398,"_19443":51950,"_25550":51951,"_2667":51952},[],"/docs/pr-preview/pr-55/platform/pki/key-management#key-inventory","Key inventory",{"_3172":2070,"_28058":2059,"_5":28398,"_19443":51954,"_25550":51955,"_2667":51956},[],"/docs/pr-preview/pr-55/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_3172":2071,"_28058":2059,"_5":28398,"_19443":51958,"_25550":51959,"_2667":51960},[],"/docs/pr-preview/pr-55/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_3172":2072,"_28058":2059,"_5":28398,"_19443":51962,"_25550":51963,"_2667":51964},[],"/docs/pr-preview/pr-55/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_3172":2073,"_28058":2059,"_5":28398,"_19443":51966,"_25550":51967,"_2667":51968},[],"/docs/pr-preview/pr-55/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_3172":2074,"_28058":2059,"_5":28398,"_19443":51970,"_25550":51971,"_2667":51972},[],"/docs/pr-preview/pr-55/platform/pki/key-management#view-details","View details",{"_3172":2075,"_28058":2059,"_5":28398,"_19443":51974,"_25550":51975,"_2667":51976},[],"/docs/pr-preview/pr-55/platform/pki/key-management#sign-and-verify","Sign and verify",{"_3172":2076,"_28058":2059,"_5":28398,"_19443":51978,"_25550":51979,"_2667":51980},[],"/docs/pr-preview/pr-55/platform/pki/key-management#sign","Sign",{"_3172":2077,"_28058":2059,"_5":28398,"_19443":51982,"_25550":51983,"_2667":51984},[],"/docs/pr-preview/pr-55/platform/pki/key-management#verify","Verify",{"_3172":2078,"_28058":2059,"_5":28398,"_19443":51986,"_25550":51987,"_2667":51988},[],"/docs/pr-preview/pr-55/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_3172":2079,"_28058":2059,"_5":28398,"_19443":51990,"_25550":51991,"_2667":51992},[],"/docs/pr-preview/pr-55/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_3172":2080,"_28058":2059,"_5":28398,"_19443":51994,"_25550":51995,"_2667":51996},[],"/docs/pr-preview/pr-55/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_3172":2081,"_28058":2059,"_19443":51998,"_5":13331,"_25550":2059,"_2667":51999},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_3172":2082,"_28058":2059,"_19443":52001,"_5":13331,"_25550":2059,"_2667":52002},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_3172":2083,"_28058":2059,"_19443":52004,"_5":13331,"_25550":51919,"_2667":52005},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_3172":2084,"_28058":2059,"_19443":52007,"_5":13331,"_25550":51919,"_2667":52008},[],"In practice, it lets you:",{"_3172":2085,"_28058":2059,"_19443":52010,"_5":13331,"_25550":51919,"_2667":52011},[],"Generate new key pairs from Lamassu IoT.",{"_3172":2086,"_28058":2059,"_19443":52013,"_5":13331,"_25550":51919,"_2667":52014},[],"Import keys created externally.",{"_3172":2087,"_28058":2059,"_19443":52016,"_5":13331,"_25550":51919,"_2667":52017},[],"Delegate custody and cryptographic operations to external engines.",{"_3172":2088,"_28058":2059,"_19443":52019,"_5":13331,"_25550":51919,"_2667":52020},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_3172":2089,"_28058":2059,"_19443":52022,"_5":13331,"_25550":51923,"_2667":52023},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_3172":2090,"_28058":2059,"_19443":52025,"_5":13331,"_25550":51923,"_2667":52026},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_3172":2091,"_28058":2059,"_19443":52028,"_5":13331,"_25550":51923,"_2667":52029},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_3172":2092,"_28058":2059,"_19443":52031,"_5":13331,"_25550":51927,"_2667":52032},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_3172":2093,"_28058":2059,"_19443":52034,"_5":13331,"_25550":51931,"_2667":52035},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_3172":2094,"_28058":2059,"_19443":52037,"_5":13331,"_25550":51931,"_2667":52038},[],"The adapter reaches Vault over its configured HTTP(S) endpoint. The Vault server certificate is verified against the system trust store; a Vault signed by a private CA is trusted by adding its CA certificate to the engine's `ca_cert_file` (PEM-encoded). `insecure_skip_verify=true` disables verification and is a last resort; agree the transport settings with the deployment owner.",{"_3172":2095,"_28058":2059,"_19443":52040,"_5":13331,"_25550":51935,"_2667":52041},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_3172":2096,"_28058":2059,"_19443":52043,"_5":13331,"_25550":51939,"_2667":52044},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_3172":2097,"_28058":2059,"_19443":52046,"_5":13331,"_25550":51943,"_2667":52047},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_3172":2098,"_28058":2059,"_19443":52049,"_5":13331,"_25550":51947,"_2667":52050},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_3172":2099,"_28058":2059,"_19443":52052,"_5":13331,"_25550":51947,"_2667":52053},[],"Lamassu shows the enabled engines in the console.",{"_3172":2100,"_28058":2059,"_19443":52055,"_5":13331,"_25550":51947,"_2667":52056},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_3172":2101,"_28058":2059,"_19443":52058,"_5":13331,"_25550":51947,"_2667":52059},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_3172":2102,"_28058":2059,"_19443":52061,"_5":13331,"_25550":51951,"_2667":52062},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_3172":2103,"_28058":2059,"_19443":52064,"_5":13331,"_25550":51951,"_2667":52065},[],"The table includes the following fields:",{"_3172":2104,"_28058":2059,"_19443":52067,"_5":13331,"_25550":51951,"_2667":52068},[],"**Name**: descriptive name of the key.",{"_3172":2105,"_28058":2059,"_19443":52070,"_5":13331,"_25550":51951,"_2667":52071},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_3172":2106,"_28058":2059,"_19443":52073,"_5":13331,"_25550":51951,"_2667":52074},[],"**Strength**: visual indicator of cryptographic strength.",{"_3172":2107,"_28058":2059,"_19443":52076,"_5":13331,"_25550":51951,"_2667":52077},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_3172":2108,"_28058":2059,"_19443":52079,"_5":13331,"_25550":51951,"_2667":52080},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_3172":2109,"_28058":2059,"_19443":52082,"_5":13331,"_25550":51951,"_2667":52083},[],"**Aliases**: alternative names associated with the key.",{"_3172":2110,"_28058":2059,"_19443":52085,"_5":13331,"_25550":51951,"_2667":52086},[],"**Tags**: labels for classification and search.",{"_3172":2111,"_28058":2059,"_19443":52088,"_5":13331,"_25550":51951,"_2667":52089},[],"**Related Entities**: certificates or other entities linked to that key.",{"_3172":2112,"_28058":2059,"_19443":52091,"_5":13331,"_25550":51951,"_2667":52092},[],"From this view you also reach the most common actions:",{"_3172":2113,"_28058":2059,"_19443":52094,"_5":13331,"_25550":51951,"_2667":52095},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_3172":2114,"_28058":2059,"_19443":52097,"_5":13331,"_25550":51951,"_2667":52098},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_3172":2115,"_28058":2059,"_19443":52100,"_5":13331,"_25550":51951,"_2667":52101},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_3172":2116,"_28058":2059,"_19443":52103,"_5":13331,"_25550":51951,"_2667":52104},[],"**Delete Key** to remove the key from the system.",{"_3172":2117,"_28058":2059,"_19443":52106,"_5":13331,"_25550":51955,"_2667":52107},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_3172":2118,"_28058":2059,"_19443":52109,"_5":13331,"_25550":51959,"_2667":52110},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_3172":2119,"_28058":2059,"_19443":52112,"_5":13331,"_25550":51959,"_2667":52113},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_3172":2120,"_28058":2059,"_19443":52115,"_5":13331,"_25550":51959,"_2667":52116},[],"**Key Name**: unique and descriptive name.",{"_3172":2121,"_28058":2059,"_19443":52118,"_5":13331,"_25550":51959,"_2667":52119},[],"**Crypto Engine**: engine that will keep the key.",{"_3172":2122,"_28058":2059,"_19443":52121,"_5":13331,"_25550":51959,"_2667":52122},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_3172":2123,"_28058":2059,"_19443":52124,"_5":13331,"_25550":51959,"_2667":52125},[],"**Tags**: metadata to classify the key.",{"_3172":2124,"_28058":2059,"_19443":52127,"_5":13331,"_25550":51959,"_2667":52128},[],"**Metadata**: additional information for advanced uses.",{"_3172":2125,"_28058":2059,"_19443":52130,"_5":13331,"_25550":51963,"_2667":52131},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_3172":2126,"_28058":2059,"_19443":52133,"_5":13331,"_25550":51963,"_2667":52134},[],"When you have an exportable private key and the destination engine supports import.",{"_3172":2127,"_28058":2059,"_19443":52136,"_5":13331,"_25550":51963,"_2667":52137},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_3172":2128,"_28058":2059,"_19443":52139,"_5":13331,"_25550":51963,"_2667":52140},[],"When Lamassu must operate with a root of trust created by a third party.",{"_3172":2129,"_28058":2059,"_19443":52142,"_5":13331,"_25550":51963,"_2667":52143},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_3172":2130,"_28058":2059,"_19443":52145,"_5":13331,"_25550":51963,"_2667":52146},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_3172":2131,"_28058":2059,"_19443":52148,"_5":13331,"_25550":51963,"_2667":52149},[],"**Crypto Engine**: engine that will keep the imported key.",{"_3172":2132,"_28058":2059,"_19443":52151,"_5":13331,"_25550":51963,"_2667":52152},[],"**Tags**: labels for organization and search.",{"_3172":2133,"_28058":2059,"_19443":52154,"_5":13331,"_25550":51963,"_2667":52155},[],"**Metadata**: additional optional information.",{"_3172":2134,"_28058":2059,"_19443":52157,"_5":13331,"_25550":51963,"_2667":52158},[],"**Private Key (PEM)**: private key in PEM format.",{"_3172":2135,"_28058":2059,"_19443":52160,"_5":13331,"_25550":51963,"_2667":52161},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_3172":2136,"_28058":2059,"_19443":52163,"_5":13331,"_25550":51967,"_2667":52164},[],"Each registered key has a detail view and several operational actions.",{"_3172":2137,"_28058":2059,"_19443":52166,"_5":13331,"_25550":51971,"_2667":52167},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_3172":2138,"_28058":2059,"_19443":52169,"_5":13331,"_25550":51971,"_2667":52170},[],"The **Overview** tab shows, among others, these fields:",{"_3172":2139,"_28058":2059,"_19443":52172,"_5":13331,"_25550":51971,"_2667":52173},[],"**Key Name**: descriptive name.",{"_3172":2140,"_28058":2059,"_19443":52175,"_5":13331,"_25550":51971,"_2667":52176},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_3172":2141,"_28058":2059,"_19443":52178,"_5":13331,"_25550":51971,"_2667":52179},[],"**Tags**: associated labels.",{"_3172":2142,"_28058":2059,"_19443":52181,"_5":13331,"_25550":51971,"_2667":52182},[],"**Aliases**: alternative names.",{"_3172":2143,"_28058":2059,"_19443":52184,"_5":13331,"_25550":51971,"_2667":52185},[],"**Crypto Engine**: engine where the key resides.",{"_3172":2144,"_28058":2059,"_19443":52187,"_5":13331,"_25550":51971,"_2667":52188},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_3172":2145,"_28058":2059,"_19443":52190,"_5":13331,"_25550":51971,"_2667":52191},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_3172":2146,"_28058":2059,"_19443":52193,"_5":13331,"_25550":51971,"_2667":52194},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_3172":2147,"_28058":2059,"_19443":52196,"_5":13331,"_25550":51975,"_2667":52197},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_3172":2148,"_28058":2059,"_19443":52199,"_5":13331,"_25550":51975,"_2667":52200},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_3172":2149,"_28058":2059,"_19443":52202,"_5":13331,"_25550":51975,"_2667":52203},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_3172":2150,"_28058":2059,"_19443":52205,"_5":13331,"_25550":51979,"_2667":52206},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_3172":2151,"_28058":2059,"_19443":52208,"_5":13331,"_25550":51979,"_2667":52209},[],"Main fields:",{"_3172":2152,"_28058":2059,"_19443":52211,"_5":13331,"_25550":51979,"_2667":52212},[],"**Algorithm**: signing algorithm available for the key type.",{"_3172":2153,"_28058":2059,"_19443":52214,"_5":13331,"_25550":51979,"_2667":52215},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_3172":2154,"_28058":2059,"_19443":52217,"_5":13331,"_25550":51979,"_2667":52218},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_3172":2155,"_28058":2059,"_19443":52220,"_5":13331,"_25550":51979,"_2667":52221},[],"**Message**: content to sign.",{"_3172":2156,"_28058":2059,"_19443":52223,"_5":13331,"_25550":51979,"_2667":52224},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_3172":2157,"_28058":2059,"_19443":52226,"_5":13331,"_25550":51983,"_2667":52227},[],"This tab checks whether a signature corresponds to the associated public key.",{"_3172":2158,"_28058":2059,"_19443":52229,"_5":13331,"_25550":51983,"_2667":52209},[],{"_3172":2159,"_28058":2059,"_19443":52231,"_5":13331,"_25550":51983,"_2667":52232},[],"**Algorithm**: must match the algorithm used for the signature.",{"_3172":2160,"_28058":2059,"_19443":52234,"_5":13331,"_25550":51983,"_2667":52235},[],"**Message Type**: `Raw` or `Digest`.",{"_3172":2161,"_28058":2059,"_19443":52237,"_5":13331,"_25550":51983,"_2667":52238},[],"**Payload Encoding**: encoding of the message.",{"_3172":2162,"_28058":2059,"_19443":52240,"_5":13331,"_25550":51983,"_2667":52241},[],"**Message**: original message or hash.",{"_3172":2163,"_28058":2059,"_19443":52243,"_5":13331,"_25550":51983,"_2667":52244},[],"**Signature**: signature to check.",{"_3172":2164,"_28058":2059,"_19443":52246,"_5":13331,"_25550":51983,"_2667":52247},[],"**Result**: indicator of the validation result.",{"_3172":2165,"_28058":2059,"_19443":52249,"_5":13331,"_25550":51987,"_2667":52250},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_3172":2166,"_28058":2059,"_19443":52252,"_5":13331,"_25550":51987,"_2667":52253},[],"This flow is useful for:",{"_3172":2167,"_28058":2059,"_19443":52255,"_5":13331,"_25550":51987,"_2667":52256},[],"Requesting certificates from an external CA.",{"_3172":2168,"_28058":2059,"_19443":52258,"_5":13331,"_25550":51987,"_2667":52259},[],"Renewing an identity while keeping the same key.",{"_3172":2169,"_28058":2059,"_19443":52261,"_5":13331,"_25550":51987,"_2667":52262},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_3172":2170,"_28058":2059,"_19443":52264,"_5":13331,"_25550":51987,"_2667":52265},[],"**Common Name (CN)**: main name of the identity.",{"_3172":2171,"_28058":2059,"_19443":52267,"_5":13331,"_25550":51987,"_2667":52268},[],"**Organization (O)**: organization or company.",{"_3172":2172,"_28058":2059,"_19443":52270,"_5":13331,"_25550":51987,"_2667":52271},[],"**Organizational Unit (OU)**: department or unit.",{"_3172":2173,"_28058":2059,"_19443":52273,"_5":13331,"_25550":51987,"_2667":52274},[],"**Country (C)**: two-letter country code.",{"_3172":2174,"_28058":2059,"_19443":52276,"_5":13331,"_25550":51987,"_2667":52277},[],"**State / Province (ST)**: state or province.",{"_3172":2175,"_28058":2059,"_19443":52279,"_5":13331,"_25550":51987,"_2667":52280},[],"**Locality (L)**: city or locality.",{"_3172":2176,"_28058":2059,"_19443":52282,"_5":13331,"_25550":51987,"_2667":52283},[],"**Email Address**: contact email.",{"_3172":2177,"_28058":2059,"_19443":52285,"_5":13331,"_25550":51987,"_2667":52286},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_3172":2178,"_28058":2059,"_19443":52288,"_5":13331,"_25550":51987,"_2667":52289},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_3172":2179,"_28058":2059,"_19443":52291,"_5":13331,"_25550":51991,"_2667":52292},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_3172":2180,"_28058":2059,"_19443":52294,"_5":13331,"_25550":51991,"_2667":52295},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3172":2181,"_28058":2059,"_19443":52297,"_5":13331,"_25550":51995,"_2667":52298},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_3172":2182,"_28058":2182,"_5":13662,"_2667":52300,"_28401":52301,"_19443":52302,"_25550":2182},"Online validation with OCSP",[45477,46870,50603,51223],[],{"_3172":2183,"_28058":2182,"_19443":52304,"_5":13331,"_25550":2182,"_2667":52305},[],"Query signed status and verify the responder’s response.",{"_3172":2184,"_28058":2182,"_5":28398,"_19443":52307,"_25550":52308,"_2667":52309},[],"/docs/pr-preview/pr-55/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_3172":2185,"_28058":2182,"_5":28398,"_19443":52311,"_25550":52312,"_2667":52313},[],"/docs/pr-preview/pr-55/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_3172":2186,"_28058":2182,"_5":28398,"_19443":52315,"_25550":52316,"_2667":52317},[],"/docs/pr-preview/pr-55/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_3172":2187,"_28058":2182,"_5":28398,"_19443":52319,"_25550":52320,"_2667":52321},[],"/docs/pr-preview/pr-55/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_3172":2188,"_28058":2182,"_5":28398,"_19443":52323,"_25550":52324,"_2667":52325},[],"/docs/pr-preview/pr-55/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_3172":2189,"_28058":2182,"_5":28398,"_19443":52327,"_25550":52328,"_2667":51769},[],"/docs/pr-preview/pr-55/platform/pki/ocsp#references",{"_3172":2190,"_28058":2182,"_19443":52330,"_5":13331,"_25550":2182,"_2667":52331},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_3172":2191,"_28058":2182,"_19443":52333,"_5":13331,"_25550":52308,"_2667":52334},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_3172":2192,"_28058":2182,"_19443":52336,"_5":13331,"_25550":52308,"_2667":52337},[],"Record status",{"_3172":2193,"_28058":2182,"_19443":52339,"_5":13331,"_25550":52308,"_2667":52340},[],"Signed response",{"_3172":2194,"_28058":2182,"_19443":52342,"_5":13331,"_25550":52308,"_2667":49781},[],{"_3172":2195,"_28058":2182,"_19443":52344,"_5":13331,"_25550":52308,"_2667":52345},[],"`Good`.",{"_3172":2196,"_28058":2182,"_19443":52347,"_5":13331,"_25550":52308,"_2667":49798},[],{"_3172":2197,"_28058":2182,"_19443":52349,"_5":13331,"_25550":52308,"_2667":52350},[],"`Revoked`, with revocation reason and timestamp.",{"_3172":2198,"_28058":2182,"_19443":52352,"_5":13331,"_25550":52308,"_2667":52353},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_3172":2199,"_28058":2182,"_19443":52355,"_5":13331,"_25550":52308,"_2667":52356},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_3172":2200,"_28058":2182,"_19443":52358,"_5":13331,"_25550":52308,"_2667":52359},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_3172":2201,"_28058":2182,"_19443":52361,"_5":13331,"_25550":52308,"_2667":52362},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_3172":2202,"_28058":2182,"_19443":52364,"_5":13331,"_25550":52308,"_2667":52365},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_3172":2203,"_28058":2182,"_19443":52367,"_5":13331,"_25550":52312,"_2667":52368},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_3172":2204,"_28058":2182,"_19443":52370,"_5":13331,"_25550":52312,"_2667":52371},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_3172":2205,"_28058":2182,"_19443":52373,"_5":13331,"_25550":52316,"_2667":52374},[],"The service accepts:",{"_3172":2206,"_28058":2182,"_19443":52376,"_5":13331,"_25550":52316,"_2667":48634},[],{"_3172":2207,"_28058":2182,"_19443":52378,"_5":13331,"_25550":52316,"_2667":52379},[],"VA service path",{"_3172":2208,"_28058":2182,"_19443":52381,"_5":13331,"_25550":52316,"_2667":52382},[],"Format",{"_3172":2209,"_28058":2182,"_19443":52384,"_5":13331,"_25550":52316,"_2667":52385},[],"`POST`",{"_3172":2210,"_28058":2182,"_19443":52387,"_5":13331,"_25550":52316,"_2667":52388},[],"`/ocsp`",{"_3172":2211,"_28058":2182,"_19443":52390,"_5":13331,"_25550":52316,"_2667":52391},[],"DER request, `Content-Type: application/ocsp-request`.",{"_3172":2212,"_28058":2182,"_19443":52393,"_5":13331,"_25550":52316,"_2667":51871},[],{"_3172":2213,"_28058":2182,"_19443":52395,"_5":13331,"_25550":52316,"_2667":52396},[],"`/ocsp/{ocsp_request}`",{"_3172":2214,"_28058":2182,"_19443":52398,"_5":13331,"_25550":52316,"_2667":52399},[],"DER request encoded using padded URL Base64.",{"_3172":2215,"_28058":2182,"_19443":52401,"_5":13331,"_25550":52316,"_2667":52402},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_3172":2216,"_28058":2182,"_19443":52404,"_5":13331,"_25550":52320,"_2667":52405},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_3172":2217,"_28058":2182,"_19443":52407,"_5":13331,"_25550":52320,"_2667":52408},[],"Generate the request:",{"_3172":2218,"_28058":2182,"_19443":52410,"_5":13331,"_25550":52320,"_2667":52411},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_3172":2219,"_28058":2182,"_19443":52413,"_5":13331,"_25550":52320,"_2667":52414},[],"Replace the example URL with the inspected endpoint:",{"_3172":2220,"_28058":2182,"_19443":52416,"_5":13331,"_25550":52320,"_2667":52417},[],"Verify the returned DER:",{"_3172":2221,"_28058":2182,"_19443":52419,"_5":13331,"_25550":52320,"_2667":52420},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_3172":2222,"_28058":2182,"_19443":52422,"_5":13331,"_25550":52324,"_2667":52423},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_3172":2223,"_28058":2182,"_19443":52425,"_5":13331,"_25550":52324,"_2667":52426},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_3172":2224,"_28058":2182,"_19443":52428,"_5":13331,"_25550":52328,"_2667":52429},[],"RFC 6960: OCSP.",{"_3172":2225,"_28058":2182,"_19443":52431,"_5":13331,"_25550":52328,"_2667":52432},[],"OpenSSL: openssl-ocsp.",{"_3172":2226,"_28058":2182,"_19443":52434,"_5":13331,"_25550":52328,"_2667":52435},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_3172":2227,"_28058":2182,"_19443":52437,"_5":13331,"_25550":52328,"_2667":51909},[],{"_3172":2228,"_28058":2228,"_5":13662,"_2667":50603,"_28401":52439,"_19443":52440,"_25550":2228},[45477,46870,50603],[],{"_3172":2229,"_28058":2228,"_19443":52442,"_5":13331,"_25550":2228,"_2667":52443},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_3172":2230,"_28058":2228,"_5":28398,"_19443":52445,"_25550":52446,"_2667":49913},[],"/docs/pr-preview/pr-55/platform/pki/overview#start-here",{"_3172":2231,"_28058":2228,"_5":28398,"_19443":52448,"_25550":52449,"_2667":52450},[],"/docs/pr-preview/pr-55/platform/pki/overview#what-you-need","What you need",{"_3172":2232,"_28058":2228,"_5":28398,"_19443":52452,"_25550":52453,"_2667":50447},[],"/docs/pr-preview/pr-55/platform/pki/overview#core-capabilities",{"_3172":2233,"_28058":2228,"_5":28398,"_19443":52455,"_25550":52456,"_2667":50451},[],"/docs/pr-preview/pr-55/platform/pki/overview#build-your-trust-hierarchy",{"_3172":2234,"_28058":2228,"_5":28398,"_19443":52458,"_25550":52459,"_2667":50455},[],"/docs/pr-preview/pr-55/platform/pki/overview#protect-cryptographic-keys",{"_3172":2235,"_28058":2228,"_5":28398,"_19443":52461,"_25550":52462,"_2667":50459},[],"/docs/pr-preview/pr-55/platform/pki/overview#issue-and-control-certificates",{"_3172":2236,"_28058":2228,"_5":28398,"_19443":52464,"_25550":52465,"_2667":50467},[],"/docs/pr-preview/pr-55/platform/pki/overview#publish-validation-status",{"_3172":2237,"_28058":2228,"_5":28398,"_19443":52467,"_25550":52468,"_2667":52469},[],"/docs/pr-preview/pr-55/platform/pki/overview#how-to-check-the-result","How to check the result",{"_3172":2238,"_28058":2228,"_5":28398,"_19443":52471,"_25550":52472,"_2667":51390},[],"/docs/pr-preview/pr-55/platform/pki/overview#continue",{"_3172":2239,"_28058":2228,"_19443":52474,"_5":13331,"_25550":2228,"_2667":52475},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_3172":2240,"_28058":2228,"_19443":52477,"_5":13331,"_25550":52446,"_2667":52478},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_3172":2241,"_28058":2228,"_19443":52480,"_5":13331,"_25550":52446,"_2667":52481},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_3172":2242,"_28058":2228,"_19443":52483,"_5":13331,"_25550":52449,"_2667":52484},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_3172":2243,"_28058":2228,"_19443":52486,"_5":13331,"_25550":52449,"_2667":52487},[],"An available cryptographic engine to keep the authority's key.",{"_3172":2244,"_28058":2228,"_19443":52489,"_5":13331,"_25550":52449,"_2667":52490},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_3172":2245,"_28058":2228,"_19443":52492,"_5":13331,"_25550":52449,"_2667":52493},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_3172":2246,"_28058":2228,"_19443":52495,"_5":13331,"_25550":52449,"_2667":52496},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_3172":2247,"_28058":2228,"_19443":52498,"_5":13331,"_25550":52456,"_2667":52499},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_3172":2248,"_28058":2228,"_19443":52501,"_5":13331,"_25550":52459,"_2667":52502},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_3172":2249,"_28058":2228,"_19443":52504,"_5":13331,"_25550":52462,"_2667":52505},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_3172":2250,"_28058":2228,"_19443":52507,"_5":13331,"_25550":52465,"_2667":52508},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_3172":2251,"_28058":2228,"_19443":52510,"_5":13331,"_25550":52468,"_2667":52511},[],"An active certificate in the console is one part of the check. Also verify that:",{"_3172":2252,"_28058":2228,"_19443":52513,"_5":13331,"_25550":52468,"_2667":52514},[],"its subject and extensions identify the expected client;",{"_3172":2253,"_28058":2228,"_19443":52516,"_5":13331,"_25550":52468,"_2667":52517},[],"its public key matches the client's private key;",{"_3172":2254,"_28058":2228,"_19443":52519,"_5":13331,"_25550":52468,"_2667":52520},[],"its chain reaches a root trusted by the consumer;",{"_3172":2255,"_28058":2228,"_19443":52522,"_5":13331,"_25550":52468,"_2667":52523},[],"its dates and usages allow the operation;",{"_3172":2256,"_28058":2228,"_19443":52525,"_5":13331,"_25550":52468,"_2667":52526},[],"the consumer applies revocation checks and authorization.",{"_3172":2257,"_28058":2228,"_19443":52528,"_5":13331,"_25550":52468,"_2667":52529},[],"The issuance path includes the first independent checks.",{"_3172":2258,"_28058":2228,"_19443":52531,"_5":13331,"_25550":52472,"_2667":52532},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3172":2259,"_28058":2228,"_19443":52534,"_5":13331,"_25550":52472,"_2667":52535},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3172":2260,"_28058":2228,"_19443":52537,"_5":13331,"_25550":52472,"_2667":52538},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3172":2261,"_28058":2261,"_5":13662,"_2667":52540,"_28401":52541,"_19443":52542,"_25550":2261},"Create your first CA",[45477,46870,50603,50038],[],{"_3172":2262,"_28058":2261,"_19443":52544,"_5":13331,"_25550":2261,"_2667":52545},[],"Create an evaluation root and check its certificate before issuing.",{"_3172":2263,"_28058":2261,"_5":28398,"_19443":52547,"_25550":52548,"_2667":45487},[],"/docs/pr-preview/pr-55/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_3172":2264,"_28058":2261,"_5":28398,"_19443":52550,"_25550":52551,"_2667":52552},[],"/docs/pr-preview/pr-55/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard","Open the creation wizard",{"_3172":2265,"_28058":2261,"_5":28398,"_19443":52554,"_25550":52555,"_2667":52556},[],"/docs/pr-preview/pr-55/platform/pki/quickstarts/create-certificate-authority#select-the-key","Select the key",{"_3172":2266,"_28058":2261,"_5":28398,"_19443":52558,"_25550":52559,"_2667":52560},[],"/docs/pr-preview/pr-55/platform/pki/quickstarts/create-certificate-authority#define-the-authority","Define the authority",{"_3172":2267,"_28058":2261,"_5":28398,"_19443":52562,"_25550":52563,"_2667":52564},[],"/docs/pr-preview/pr-55/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca","Review and create the CA",{"_3172":2268,"_28058":2261,"_5":28398,"_19443":52566,"_25550":52567,"_2667":52568},[],"/docs/pr-preview/pr-55/platform/pki/quickstarts/create-certificate-authority#verify-the-result","Verify the result",{"_3172":2269,"_28058":2261,"_5":28398,"_19443":52570,"_25550":52571,"_2667":52572},[],"/docs/pr-preview/pr-55/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_3172":2270,"_28058":2261,"_5":28398,"_19443":52574,"_25550":52575,"_2667":50296},[],"/docs/pr-preview/pr-55/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_3172":2271,"_28058":2261,"_5":28398,"_19443":52577,"_25550":52578,"_2667":45511},[],"/docs/pr-preview/pr-55/platform/pki/quickstarts/create-certificate-authority#next-step",{"_3172":2272,"_28058":2261,"_19443":52580,"_5":13331,"_25550":2261,"_2667":52581},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_3172":2273,"_28058":2261,"_19443":52583,"_5":13331,"_25550":52548,"_2667":52584},[],"Console access and permission to create keys and authorities.",{"_3172":2274,"_28058":2261,"_19443":52586,"_5":13331,"_25550":52548,"_2667":52587},[],"An available cryptographic engine that supports the chosen algorithm.",{"_3172":2275,"_28058":2261,"_19443":52589,"_5":13331,"_25550":52548,"_2667":52590},[],"OpenSSL 3.x to check the downloaded certificate.",{"_3172":2276,"_28058":2261,"_19443":52592,"_5":13331,"_25550":52548,"_2667":52593},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_3172":2277,"_28058":2261,"_19443":52595,"_5":13331,"_25550":52551,"_2667":52596},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_3172":2278,"_28058":2261,"_19443":52598,"_5":13331,"_25550":52551,"_2667":52599},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_3172":2279,"_28058":2261,"_19443":52601,"_5":13331,"_25550":52555,"_2667":52602},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_3172":2280,"_28058":2261,"_19443":52604,"_5":13331,"_25550":52555,"_2667":52605},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_3172":2281,"_28058":2261,"_19443":52607,"_5":13331,"_25550":52559,"_2667":52608},[],"Select **Root CA** and complete:",{"_3172":2282,"_28058":2261,"_19443":52610,"_5":13331,"_25550":52559,"_2667":52611},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_3172":2283,"_28058":2261,"_19443":52613,"_5":13331,"_25550":52559,"_2667":52614},[],"**Subject**: organization and country details for your evaluation.",{"_3172":2284,"_28058":2261,"_19443":52616,"_5":13331,"_25550":52559,"_2667":52617},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_3172":2285,"_28058":2261,"_19443":52619,"_5":13331,"_25550":52559,"_2667":52620},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_3172":2286,"_28058":2261,"_19443":52622,"_5":13331,"_25550":52559,"_2667":52623},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_3172":2287,"_28058":2261,"_19443":52625,"_5":13331,"_25550":52563,"_2667":52626},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_3172":2288,"_28058":2261,"_19443":52628,"_5":13331,"_25550":52567,"_2667":52629},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_3172":2289,"_28058":2261,"_19443":52631,"_5":13331,"_25550":52567,"_2667":52632},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_3172":2290,"_28058":2261,"_19443":52634,"_5":13331,"_25550":52571,"_2667":52635},[],"Run from the directory where you saved `ca.pem`:",{"_3172":2291,"_28058":2261,"_19443":52637,"_5":13331,"_25550":52571,"_2667":52638},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_3172":2292,"_28058":2261,"_19443":52640,"_5":13331,"_25550":52571,"_2667":52641},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_3172":2293,"_28058":2261,"_19443":52643,"_5":13331,"_25550":52575,"_2667":52644},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_3172":2294,"_28058":2261,"_19443":52646,"_5":13331,"_25550":52575,"_2667":52647},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_3172":2295,"_28058":2261,"_19443":52649,"_5":13331,"_25550":52575,"_2667":52650},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_3172":2296,"_28058":2261,"_19443":52652,"_5":13331,"_25550":52575,"_2667":52653},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_3172":2297,"_28058":2261,"_19443":52655,"_5":13331,"_25550":52578,"_2667":52656},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_3172":2298,"_28058":2298,"_5":13662,"_2667":52658,"_28401":52659,"_19443":52660,"_25550":2298},"Issue and verify a certificate",[45477,46870,50603,50038],[],{"_3172":2299,"_28058":2298,"_19443":52662,"_5":13331,"_25550":2298,"_2667":52663},[],"Issue a client certificate and check content, chain and key correspondence.",{"_3172":2300,"_28058":2298,"_5":28398,"_19443":52665,"_25550":52666,"_2667":45487},[],"/docs/pr-preview/pr-55/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_3172":2301,"_28058":2298,"_5":28398,"_19443":52668,"_25550":52669,"_2667":52670},[],"/docs/pr-preview/pr-55/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_3172":2302,"_28058":2298,"_5":28398,"_19443":52672,"_25550":52673,"_2667":52674},[],"/docs/pr-preview/pr-55/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_3172":2303,"_28058":2298,"_5":28398,"_19443":52676,"_25550":52677,"_2667":52678},[],"/docs/pr-preview/pr-55/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_3172":2304,"_28058":2298,"_5":28398,"_19443":52680,"_25550":52681,"_2667":52682},[],"/docs/pr-preview/pr-55/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_3172":2305,"_28058":2298,"_5":28398,"_19443":52684,"_25550":52685,"_2667":52686},[],"/docs/pr-preview/pr-55/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_3172":2306,"_28058":2298,"_5":28398,"_19443":52688,"_25550":52689,"_2667":52568},[],"/docs/pr-preview/pr-55/platform/pki/quickstarts/issue-certificate#verify-the-result",{"_3172":2307,"_28058":2298,"_5":28398,"_19443":52691,"_25550":52692,"_2667":52693},[],"/docs/pr-preview/pr-55/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_3172":2308,"_28058":2298,"_5":28398,"_19443":52695,"_25550":52696,"_2667":52697},[],"/docs/pr-preview/pr-55/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_3172":2309,"_28058":2298,"_5":28398,"_19443":52699,"_25550":52700,"_2667":52701},[],"/docs/pr-preview/pr-55/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_3172":2310,"_28058":2298,"_5":28398,"_19443":52703,"_25550":52704,"_2667":50296},[],"/docs/pr-preview/pr-55/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_3172":2311,"_28058":2298,"_5":28398,"_19443":52706,"_25550":52707,"_2667":45511},[],"/docs/pr-preview/pr-55/platform/pki/quickstarts/issue-certificate#next-step",{"_3172":2312,"_28058":2298,"_19443":52709,"_5":13331,"_25550":2298,"_2667":52710},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_3172":2313,"_28058":2298,"_19443":52712,"_5":13331,"_25550":52666,"_2667":52713},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_3172":2314,"_28058":2298,"_19443":52715,"_5":13331,"_25550":52666,"_2667":52716},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_3172":2315,"_28058":2298,"_19443":52718,"_5":13331,"_25550":52666,"_2667":52719},[],"OpenSSL 3.x and a working directory with restricted access.",{"_3172":2316,"_28058":2298,"_19443":52721,"_5":13331,"_25550":52666,"_2667":52722},[],"A client identifier: here we use `device-001`.",{"_3172":2317,"_28058":2298,"_19443":52724,"_5":13331,"_25550":52666,"_2667":52725},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_3172":2318,"_28058":2298,"_19443":52727,"_5":13331,"_25550":52669,"_2667":52728},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_3172":2319,"_28058":2298,"_19443":52730,"_5":13331,"_25550":52673,"_2667":52731},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_3172":2320,"_28058":2298,"_19443":52733,"_5":13331,"_25550":52673,"_2667":52734},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_3172":2321,"_28058":2298,"_19443":52736,"_5":13331,"_25550":52677,"_2667":52737},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_3172":2322,"_28058":2298,"_19443":52739,"_5":13331,"_25550":52677,"_2667":52740},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_3172":2323,"_28058":2298,"_19443":52742,"_5":13331,"_25550":52681,"_2667":52743},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_3172":2324,"_28058":2298,"_19443":52745,"_5":13331,"_25550":52681,"_2667":52746},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_3172":2325,"_28058":2298,"_19443":52748,"_5":13331,"_25550":52685,"_2667":52749},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_3172":2326,"_28058":2298,"_19443":52751,"_5":13331,"_25550":52689,"_2667":52752},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_3172":2327,"_28058":2298,"_19443":52754,"_5":13331,"_25550":52692,"_2667":52755},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_3172":2328,"_28058":2298,"_19443":52757,"_5":13331,"_25550":52696,"_2667":52758},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_3172":2329,"_28058":2298,"_19443":52760,"_5":13331,"_25550":52696,"_2667":52761},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_3172":2330,"_28058":2298,"_19443":52763,"_5":13331,"_25550":52696,"_2667":52764},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_3172":2331,"_28058":2298,"_19443":52766,"_5":13331,"_25550":52700,"_2667":52767},[],"In Bash, compare the two public-key digests:",{"_3172":2332,"_28058":2298,"_19443":52769,"_5":13331,"_25550":52700,"_2667":52770},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_3172":2333,"_28058":2298,"_19443":52772,"_5":13331,"_25550":52700,"_2667":52773},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_3172":2334,"_28058":2298,"_19443":52775,"_5":13331,"_25550":52704,"_2667":50380},[],{"_3172":2335,"_28058":2298,"_19443":52777,"_5":13331,"_25550":52704,"_2667":52778},[],"What to review",{"_3172":2336,"_28058":2298,"_19443":52780,"_5":13331,"_25550":52704,"_2667":52781},[],"The CA rejects issuance",{"_3172":2337,"_28058":2298,"_19443":52783,"_5":13331,"_25550":52704,"_2667":52784},[],"Permissions, CA state and key, algorithm and profile.",{"_3172":2338,"_28058":2298,"_19443":52786,"_5":13331,"_25550":52704,"_2667":52787},[],"Different subject or usages",{"_3172":2339,"_28058":2298,"_19443":52789,"_5":13331,"_25550":52704,"_2667":52790},[],"Applied profile and requested values.",{"_3172":2340,"_28058":2298,"_19443":52792,"_5":13331,"_25550":52704,"_2667":52793},[],"Issuer cannot be found",{"_3172":2341,"_28058":2298,"_19443":52795,"_5":13331,"_25550":52704,"_2667":52796},[],"Downloaded CA and required intermediate chain.",{"_3172":2342,"_28058":2298,"_19443":52798,"_5":13331,"_25550":52704,"_2667":52799},[],"Validity fails",{"_3172":2343,"_28058":2298,"_19443":52801,"_5":13331,"_25550":52704,"_2667":52802},[],"Certificate and CA dates, and the computer's clock.",{"_3172":2344,"_28058":2298,"_19443":52804,"_5":13331,"_25550":52704,"_2667":52805},[],"Public-key digests differ",{"_3172":2345,"_28058":2298,"_19443":52807,"_5":13331,"_25550":52704,"_2667":52808},[],"Certificate and key files from the same issuance.",{"_3172":2346,"_28058":2298,"_19443":52810,"_5":13331,"_25550":52704,"_2667":52811},[],"See PKI diagnostics to narrow an issuance failure.",{"_3172":2347,"_28058":2298,"_19443":52813,"_5":13331,"_25550":52707,"_2667":52814},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_3172":2348,"_28058":2298,"_19443":52816,"_5":13331,"_25550":52707,"_2667":52817},[],"Manage certificates for inspection, status and revocation.",{"_3172":2349,"_28058":2298,"_19443":52819,"_5":13331,"_25550":52707,"_2667":52820},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_3172":2350,"_28058":2298,"_19443":52822,"_5":13331,"_25550":52707,"_2667":52823},[],"Prepare EST for the device to request its next identities.",{"_3172":2351,"_28058":2298,"_19443":52825,"_5":13331,"_25550":52707,"_2667":52826},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_3172":2352,"_28058":2352,"_5":13662,"_2667":52828,"_28401":52829,"_19443":52830,"_25550":2352},"PKI getting started",[45477,46870,50603,50038],[],{"_3172":2353,"_28058":2352,"_19443":52832,"_5":13331,"_25550":2352,"_2667":52833},[],"Create a CA, issue a client certificate and check its chain and key.",{"_3172":2354,"_28058":2352,"_5":28398,"_19443":52835,"_25550":52836,"_2667":45487},[],"/docs/pr-preview/pr-55/platform/pki/quickstarts/overview#before-you-begin",{"_3172":2355,"_28058":2352,"_5":28398,"_19443":52838,"_25550":52839,"_2667":52840},[],"/docs/pr-preview/pr-55/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_3172":2356,"_28058":2352,"_5":28398,"_19443":52842,"_25550":52843,"_2667":50230},[],"/docs/pr-preview/pr-55/platform/pki/quickstarts/overview#expected-result",{"_3172":2357,"_28058":2352,"_5":28398,"_19443":52845,"_25550":52846,"_2667":52847},[],"/docs/pr-preview/pr-55/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_3172":2358,"_28058":2352,"_19443":52849,"_5":13331,"_25550":2352,"_2667":52850},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_3172":2359,"_28058":2352,"_19443":52852,"_5":13331,"_25550":52836,"_2667":52853},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_3172":2360,"_28058":2352,"_19443":52855,"_5":13331,"_25550":52836,"_2667":52856},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_3172":2361,"_28058":2352,"_19443":52858,"_5":13331,"_25550":52836,"_2667":52859},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_3172":2362,"_28058":2352,"_19443":52861,"_5":13331,"_25550":52836,"_2667":52862},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_3172":2363,"_28058":2352,"_19443":52864,"_5":13331,"_25550":52836,"_2667":52865},[],"A working directory with restricted access for the downloaded key.",{"_3172":2364,"_28058":2352,"_19443":52867,"_5":13331,"_25550":52839,"_2667":52868},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3172":2365,"_28058":2352,"_19443":52870,"_5":13331,"_25550":52839,"_2667":52871},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3172":2366,"_28058":2352,"_19443":52873,"_5":13331,"_25550":52839,"_2667":52874},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_3172":2367,"_28058":2352,"_19443":52876,"_5":13331,"_25550":52839,"_2667":52877},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_3172":2368,"_28058":2352,"_19443":52879,"_5":13331,"_25550":52843,"_2667":52880},[],"File or resource",{"_3172":2369,"_28058":2352,"_19443":52882,"_5":13331,"_25550":52843,"_2667":50227},[],{"_3172":2370,"_28058":2352,"_19443":52884,"_5":13331,"_25550":52843,"_2667":52885},[],"Active root CA and `ca.pem`",{"_3172":2371,"_28058":2352,"_19443":52887,"_5":13331,"_25550":52843,"_2667":52888},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_3172":2372,"_28058":2352,"_19443":52890,"_5":13331,"_25550":52843,"_2667":52891},[],"End-entity certificate and `device.crt`",{"_3172":2373,"_28058":2352,"_19443":52893,"_5":13331,"_25550":52843,"_2667":52894},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_3172":2374,"_28058":2352,"_19443":52896,"_5":13331,"_25550":52843,"_2667":52897},[],"Private key `device.key`",{"_3172":2375,"_28058":2352,"_19443":52899,"_5":13331,"_25550":52843,"_2667":52900},[],"Its public key matches the one included in `device.crt`.",{"_3172":2376,"_28058":2352,"_19443":52902,"_5":13331,"_25550":52843,"_2667":52903},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_3172":2377,"_28058":2352,"_19443":52905,"_5":13331,"_25550":52846,"_2667":52906},[],"To operate certificates, continue with Certificates and Validation.",{"_3172":2378,"_28058":2352,"_19443":52908,"_5":13331,"_25550":52846,"_2667":52909},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_3172":2379,"_28058":2352,"_19443":52911,"_5":13331,"_25550":52846,"_2667":52912},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_3172":2380,"_28058":2380,"_5":13662,"_2667":52914,"_28401":52915,"_19443":52916,"_25550":2380},"PKI troubleshooting",[45477,46870,50603,49424],[],{"_3172":2381,"_28058":2380,"_19443":52918,"_5":13331,"_25550":2380,"_2667":52919},[],"Diagnose certificate issuance, OCSP and CRL.",{"_3172":2382,"_28058":2380,"_5":28398,"_19443":52921,"_25550":52922,"_2667":52923},[],"/docs/pr-preview/pr-55/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_3172":2383,"_28058":2380,"_5":28398,"_19443":52925,"_25550":52926,"_2667":52927},[],"/docs/pr-preview/pr-55/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_3172":2384,"_28058":2380,"_5":28398,"_19443":52929,"_25550":52930,"_2667":52931},[],"/docs/pr-preview/pr-55/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_3172":2385,"_28058":2380,"_19443":52933,"_5":13331,"_25550":2380,"_2667":52934},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_3172":2386,"_28058":2380,"_19443":52936,"_5":13331,"_25550":2380,"_2667":52937},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_3172":2387,"_28058":2380,"_19443":52939,"_5":13331,"_25550":52922,"_2667":50227},[],{"_3172":2388,"_28058":2380,"_19443":52941,"_5":13331,"_25550":52922,"_2667":52942},[],"What to inspect",{"_3172":2389,"_28058":2380,"_19443":52944,"_5":13331,"_25550":52922,"_2667":45511},[],{"_3172":2390,"_28058":2380,"_19443":52946,"_5":13331,"_25550":52922,"_2667":52947},[],"CA",{"_3172":2391,"_28058":2380,"_19443":52949,"_5":13331,"_25550":52922,"_2667":52950},[],"Exists, is active and has usable dates.",{"_3172":2392,"_28058":2380,"_19443":52952,"_5":13331,"_25550":52922,"_2667":52953},[],"Authorities.",{"_3172":2393,"_28058":2380,"_19443":52955,"_5":13331,"_25550":52922,"_2667":52956},[],"Key",{"_3172":2394,"_28058":2380,"_19443":52958,"_5":13331,"_25550":52922,"_2667":52959},[],"The record has a usable private key and the engine can sign.",{"_3172":2395,"_28058":2380,"_19443":52961,"_5":13331,"_25550":52922,"_2667":52962},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_3172":2396,"_28058":2380,"_19443":52964,"_5":13331,"_25550":52922,"_2667":52965},[],"CSR",{"_3172":2397,"_28058":2380,"_19443":52967,"_5":13331,"_25550":52922,"_2667":52968},[],"Correct PEM and verifiable signature.",{"_3172":2398,"_28058":2380,"_19443":52970,"_5":13331,"_25550":52922,"_2667":52971},[],"`openssl req -in request.csr -noout -verify -text`.",{"_3172":2399,"_28058":2380,"_19443":52973,"_5":13331,"_25550":52922,"_2667":52974},[],"Profile",{"_3172":2400,"_28058":2380,"_19443":52976,"_5":13331,"_25550":52922,"_2667":52977},[],"Selected source, existing ID, allowed algorithm and size.",{"_3172":2401,"_28058":2380,"_19443":52979,"_5":13331,"_25550":52922,"_2667":52980},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_3172":2402,"_28058":2380,"_19443":52982,"_5":13331,"_25550":52922,"_2667":50380},[],{"_3172":2403,"_28058":2380,"_19443":52984,"_5":13331,"_25550":52922,"_2667":52985},[],"Appropriate subject, SAN, usages and dates.",{"_3172":2404,"_28058":2380,"_19443":52987,"_5":13331,"_25550":52922,"_2667":52988},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_3172":2405,"_28058":2380,"_19443":52990,"_5":13331,"_25550":52922,"_2667":52991},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_3172":2406,"_28058":2380,"_19443":52993,"_5":13331,"_25550":52922,"_2667":52994},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation.",{"_3172":2407,"_28058":2380,"_19443":52996,"_5":13331,"_25550":52926,"_2667":52997},[],"Check each boundary independently:",{"_3172":2408,"_28058":2380,"_19443":52999,"_5":13331,"_25550":52926,"_2667":53000},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_3172":2409,"_28058":2380,"_19443":53002,"_5":13331,"_25550":52926,"_2667":53003},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_3172":2410,"_28058":2380,"_19443":53005,"_5":13331,"_25550":52926,"_2667":53006},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_3172":2411,"_28058":2380,"_19443":53008,"_5":13331,"_25550":52926,"_2667":53009},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_3172":2412,"_28058":2380,"_19443":53011,"_5":13331,"_25550":52926,"_2667":53012},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_3172":2413,"_28058":2380,"_19443":53014,"_5":13331,"_25550":52926,"_2667":53015},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_3172":2414,"_28058":2380,"_19443":53017,"_5":13331,"_25550":52930,"_2667":53018},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_3172":2415,"_28058":2380,"_19443":53020,"_5":13331,"_25550":52930,"_2667":53021},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_3172":2416,"_28058":2416,"_5":13662,"_2667":53023,"_28401":53024,"_19443":53026,"_25550":2416},"3.8.0 to 4.0.0",[45477,53025],"Upgrades",[],{"_3172":2417,"_28058":2416,"_19443":53028,"_5":13331,"_25550":2416,"_2667":53029},[],"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result.",{"_3172":2418,"_28058":2416,"_5":28398,"_19443":53031,"_25550":53032,"_2667":53033},[],"/docs/pr-preview/pr-55/upgrades/3-8-0-to-4-0-0#architecture-changes","Architecture changes",{"_3172":2419,"_28058":2416,"_5":28398,"_19443":53035,"_25550":53036,"_2667":53037},[],"/docs/pr-preview/pr-55/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_3172":2420,"_28058":2416,"_5":28398,"_19443":53039,"_25550":53040,"_2667":53041},[],"/docs/pr-preview/pr-55/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_3172":2421,"_28058":2416,"_5":28398,"_19443":53043,"_25550":53044,"_2667":53045},[],"/docs/pr-preview/pr-55/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_3172":2422,"_28058":2416,"_5":28398,"_19443":53047,"_25550":53048,"_2667":53049},[],"/docs/pr-preview/pr-55/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_3172":2423,"_28058":2416,"_5":28398,"_19443":53051,"_25550":53052,"_2667":53053},[],"/docs/pr-preview/pr-55/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_3172":2424,"_28058":2416,"_5":28398,"_19443":53055,"_25550":53056,"_2667":53057},[],"/docs/pr-preview/pr-55/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_3172":2425,"_28058":2416,"_5":28398,"_19443":53059,"_25550":53060,"_2667":53061},[],"/docs/pr-preview/pr-55/upgrades/3-8-0-to-4-0-0#helm-chart-and-values","Helm chart and values",{"_3172":2426,"_28058":2416,"_5":28398,"_19443":53063,"_25550":53064,"_2667":53065},[],"/docs/pr-preview/pr-55/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_3172":2427,"_28058":2416,"_5":28398,"_19443":53067,"_25550":53068,"_2667":53069},[],"/docs/pr-preview/pr-55/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_3172":2428,"_28058":2416,"_5":28398,"_19443":53071,"_25550":53072,"_2667":53073},[],"/docs/pr-preview/pr-55/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_3172":2429,"_28058":2416,"_5":28398,"_19443":53075,"_25550":53076,"_2667":53077},[],"/docs/pr-preview/pr-55/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_3172":2430,"_28058":2416,"_5":28398,"_19443":53079,"_25550":53080,"_2667":53081},[],"/docs/pr-preview/pr-55/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_3172":2431,"_28058":2416,"_5":28398,"_19443":53083,"_25550":53084,"_2667":53085},[],"/docs/pr-preview/pr-55/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_3172":2432,"_28058":2416,"_5":28398,"_19443":53087,"_25550":53088,"_2667":53089},[],"/docs/pr-preview/pr-55/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_3172":2433,"_28058":2416,"_5":28398,"_19443":53091,"_25550":53092,"_2667":53093},[],"/docs/pr-preview/pr-55/upgrades/3-8-0-to-4-0-0#data-and-storage","Data and storage",{"_3172":2434,"_28058":2416,"_5":28398,"_19443":53095,"_25550":53096,"_2667":53097},[],"/docs/pr-preview/pr-55/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_3172":2435,"_28058":2416,"_5":28398,"_19443":53099,"_25550":53100,"_2667":53101},[],"/docs/pr-preview/pr-55/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","SQLite storage removed",{"_3172":2436,"_28058":2416,"_5":28398,"_19443":53103,"_25550":53104,"_2667":53105},[],"/docs/pr-preview/pr-55/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_3172":2437,"_28058":2416,"_5":28398,"_19443":53107,"_25550":53108,"_2667":53109},[],"/docs/pr-preview/pr-55/upgrades/3-8-0-to-4-0-0#apis-and-stored-configuration","APIs and stored configuration",{"_3172":2438,"_28058":2416,"_5":28398,"_19443":53111,"_25550":53112,"_2667":53113},[],"/docs/pr-preview/pr-55/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_3172":2439,"_28058":2416,"_5":28398,"_19443":53115,"_25550":53116,"_2667":53117},[],"/docs/pr-preview/pr-55/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_3172":2440,"_28058":2416,"_5":28398,"_19443":53119,"_25550":53120,"_2667":53121},[],"/docs/pr-preview/pr-55/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_3172":2441,"_28058":2416,"_5":28398,"_19443":53123,"_25550":53124,"_2667":53125},[],"/docs/pr-preview/pr-55/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_3172":2442,"_28058":2416,"_5":28398,"_19443":53127,"_25550":53128,"_2667":53129},[],"/docs/pr-preview/pr-55/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_3172":2443,"_28058":2416,"_5":28398,"_19443":53131,"_25550":53132,"_2667":53133},[],"/docs/pr-preview/pr-55/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_3172":2444,"_28058":2416,"_5":28398,"_19443":53135,"_25550":53136,"_2667":53137},[],"/docs/pr-preview/pr-55/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_3172":2445,"_28058":2416,"_5":28398,"_19443":53139,"_25550":53140,"_2667":53141},[],"/docs/pr-preview/pr-55/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_3172":2446,"_28058":2416,"_5":28398,"_19443":53143,"_25550":53144,"_2667":53145},[],"/docs/pr-preview/pr-55/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_3172":2447,"_28058":2416,"_5":28398,"_19443":53147,"_25550":53148,"_2667":53149},[],"/docs/pr-preview/pr-55/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_3172":2448,"_28058":2416,"_5":28398,"_19443":53151,"_25550":53152,"_2667":53153},[],"/docs/pr-preview/pr-55/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_3172":2449,"_28058":2416,"_5":28398,"_19443":53155,"_25550":53156,"_2667":53157},[],"/docs/pr-preview/pr-55/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_3172":2450,"_28058":2416,"_5":28398,"_19443":53159,"_25550":53160,"_2667":53161},[],"/docs/pr-preview/pr-55/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_3172":2451,"_28058":2416,"_5":28398,"_19443":53163,"_25550":53164,"_2667":49424},[],"/docs/pr-preview/pr-55/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_3172":2452,"_28058":2416,"_5":28398,"_19443":53166,"_25550":53167,"_2667":53168},[],"/docs/pr-preview/pr-55/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_3172":2453,"_28058":2416,"_5":28398,"_19443":53170,"_25550":53171,"_2667":53172},[],"/docs/pr-preview/pr-55/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_3172":2454,"_28058":2416,"_19443":53174,"_5":13331,"_25550":2416,"_2667":53175},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_3172":2455,"_28058":2416,"_19443":53177,"_5":13331,"_25550":2416,"_2667":53178},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_3172":2456,"_28058":2416,"_19443":53180,"_5":13331,"_25550":2416,"_2667":53181},[],"Architecture changes: what is different in 4.0.0 and what the upgrade migrates on its own.",{"_3172":2457,"_28058":2416,"_19443":53183,"_5":13331,"_25550":2416,"_2667":53184},[],"Breaking changes: every change that can break a 3.8.0 deployment, who it affects and what to do.",{"_3172":2458,"_28058":2416,"_19443":53186,"_5":13331,"_25550":2416,"_2667":53187},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_3172":2459,"_28058":2416,"_19443":53189,"_5":13331,"_25550":2416,"_2667":53190},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_3172":2460,"_28058":2416,"_19443":53192,"_5":13331,"_25550":2416,"_2667":53193},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_3172":2461,"_28058":2416,"_19443":53195,"_5":13331,"_25550":53036,"_2667":53196},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_3172":2462,"_28058":2416,"_19443":53198,"_5":13331,"_25550":53036,"_2667":53199},[],"PostgreSQL is now the only storage engine. SQLite support is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0.",{"_3172":2463,"_28058":2416,"_19443":53201,"_5":13331,"_25550":53040,"_2667":53202},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_3172":2464,"_28058":2416,"_19443":53204,"_5":13331,"_25550":53040,"_2667":53205},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and VA roles. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_3172":2465,"_28058":2416,"_19443":53207,"_5":13331,"_25550":53044,"_2667":53208},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. The events endpoint can also stream events over Server-Sent Events (SSE); to fan events out across service instances, each Device Manager instance binds its own durable AMQP queue.",{"_3172":2466,"_28058":2416,"_19443":53210,"_5":13331,"_25550":53048,"_2667":53211},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_3172":2467,"_28058":2416,"_19443":53213,"_5":13331,"_25550":53048,"_2667":53214},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_3172":2468,"_28058":2416,"_19443":53216,"_5":13331,"_25550":53048,"_2667":53217},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_3172":2469,"_28058":2416,"_19443":53219,"_5":13331,"_25550":53048,"_2667":53220},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_3172":2470,"_28058":2416,"_19443":53222,"_5":13331,"_25550":53048,"_2667":53223},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_3172":2471,"_28058":2416,"_19443":53225,"_5":13331,"_25550":53052,"_2667":53226},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_3172":2472,"_28058":2416,"_19443":53228,"_5":13331,"_25550":53052,"_2667":53229},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_3172":2473,"_28058":2416,"_19443":53231,"_5":13331,"_25550":53052,"_2667":53232},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_3172":2474,"_28058":2416,"_19443":53234,"_5":13331,"_25550":53052,"_2667":53235},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_3172":2475,"_28058":2416,"_19443":53237,"_5":13331,"_25550":53052,"_2667":53238},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_3172":2476,"_28058":2416,"_19443":53240,"_5":13331,"_25550":53056,"_2667":53241},[],"Change",{"_3172":2477,"_28058":2416,"_19443":53243,"_5":13331,"_25550":53056,"_2667":53244},[],"Who is affected",{"_3172":2478,"_28058":2416,"_19443":53246,"_5":13331,"_25550":53056,"_2667":53247},[],"Severity",{"_3172":2479,"_28058":2416,"_19443":53249,"_5":13331,"_25550":53056,"_2667":53250},[],"Action",{"_3172":2480,"_28058":2416,"_19443":53252,"_5":13331,"_25550":53056,"_2667":53065},[],{"_3172":2481,"_28058":2416,"_19443":53254,"_5":13331,"_25550":53056,"_2667":53255},[],"Helm releases with a filesystem KMS engine or local VA CRL storage",{"_3172":2482,"_28058":2416,"_19443":53257,"_5":13331,"_25550":53056,"_2667":53258},[],"High: KMS and VA start on empty volumes",{"_3172":2483,"_28058":2416,"_19443":53260,"_5":13331,"_25550":53056,"_2667":53261},[],"Copy the data into the new volumes",{"_3172":2484,"_28058":2416,"_19443":53263,"_5":13331,"_25550":53056,"_2667":53069},[],{"_3172":2485,"_28058":2416,"_19443":53265,"_5":13331,"_25550":53056,"_2667":53266},[],"Every Helm release",{"_3172":2486,"_28058":2416,"_19443":53268,"_5":13331,"_25550":53056,"_2667":53269},[],"High: `helm upgrade` fails",{"_3172":2487,"_28058":2416,"_19443":53271,"_5":13331,"_25550":53056,"_2667":53272},[],"Remove or rename legacy keys",{"_3172":2488,"_28058":2416,"_19443":53274,"_5":13331,"_25550":53056,"_2667":53073},[],{"_3172":2489,"_28058":2416,"_19443":53276,"_5":13331,"_25550":53056,"_2667":53277},[],"Every deployment",{"_3172":2490,"_28058":2416,"_19443":53279,"_5":13331,"_25550":53056,"_2667":53280},[],"High: without a bootstrap principal there is no administrator",{"_3172":2491,"_28058":2416,"_19443":53282,"_5":13331,"_25550":53056,"_2667":53283},[],"Configure `services.authz`",{"_3172":2492,"_28058":2416,"_19443":53285,"_5":13331,"_25550":53056,"_2667":53077},[],{"_3172":2493,"_28058":2416,"_19443":53287,"_5":13331,"_25550":53056,"_2667":53266},[],{"_3172":2494,"_28058":2416,"_19443":53289,"_5":13331,"_25550":53056,"_2667":53290},[],"High: `helm upgrade` fails on the old keys",{"_3172":2495,"_28058":2416,"_19443":53292,"_5":13331,"_25550":53056,"_2667":53293},[],"Move JWKS and roles into `services.authz`",{"_3172":2496,"_28058":2416,"_19443":53295,"_5":13331,"_25550":53056,"_2667":53097},[],{"_3172":2497,"_28058":2416,"_19443":53297,"_5":13331,"_25550":53056,"_2667":53298},[],"3.8.0 deployments with per-service databases",{"_3172":2498,"_28058":2416,"_19443":53300,"_5":13331,"_25550":53056,"_2667":53301},[],"High: services find no data, or a migration aborts",{"_3172":2499,"_28058":2416,"_19443":53303,"_5":13331,"_25550":53056,"_2667":53304},[],"Clean duplicate CA IDs and empty `engine_id` values first; move data manually outside Helm",{"_3172":2500,"_28058":2416,"_19443":53306,"_5":13331,"_25550":53056,"_2667":53101},[],{"_3172":2501,"_28058":2416,"_19443":53308,"_5":13331,"_25550":53056,"_2667":53309},[],"Deployments on SQLite, `couch_db` or `dynamo_db`",{"_3172":2502,"_28058":2416,"_19443":53311,"_5":13331,"_25550":53056,"_2667":53312},[],"High: the backend no longer starts with them",{"_3172":2503,"_28058":2416,"_19443":53314,"_5":13331,"_25550":53056,"_2667":53315},[],"Move to PostgreSQL before upgrading",{"_3172":2504,"_28058":2416,"_19443":53317,"_5":13331,"_25550":53056,"_2667":53318},[],"Webhooks with file references",{"_3172":2505,"_28058":2416,"_19443":53320,"_5":13331,"_25550":53056,"_2667":53321},[],"DMSs whose webhook mTLS certificate or key were file paths",{"_3172":2506,"_28058":2416,"_19443":53323,"_5":13331,"_25550":53056,"_2667":53324},[],"High: enrollments calling the webhook fail",{"_3172":2507,"_28058":2416,"_19443":53326,"_5":13331,"_25550":53056,"_2667":53327},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_3172":2508,"_28058":2416,"_19443":53329,"_5":13331,"_25550":53056,"_2667":53081},[],{"_3172":2509,"_28058":2416,"_19443":53331,"_5":13331,"_25550":53056,"_2667":53332},[],"Releases with per-service identity overrides or mounted key material",{"_3172":2510,"_28058":2416,"_19443":53334,"_5":13331,"_25550":53056,"_2667":53335},[],"Medium: services cannot read their files",{"_3172":2511,"_28058":2416,"_19443":53337,"_5":13331,"_25550":53056,"_2667":53338},[],"Remove the overrides and fix volume ownership",{"_3172":2512,"_28058":2416,"_19443":53340,"_5":13331,"_25550":53056,"_2667":53085},[],{"_3172":2513,"_28058":2416,"_19443":53342,"_5":13331,"_25550":53056,"_2667":53343},[],"Releases that set `amqp.tls`",{"_3172":2514,"_28058":2416,"_19443":53345,"_5":13331,"_25550":53056,"_2667":53346},[],"Medium: clients connect to the wrong port",{"_3172":2515,"_28058":2416,"_19443":53348,"_5":13331,"_25550":53056,"_2667":53349},[],"Point `amqp.port` at the TLS listener, or disable TLS",{"_3172":2516,"_28058":2416,"_19443":53351,"_5":13331,"_25550":53056,"_2667":53105},[],{"_3172":2517,"_28058":2416,"_19443":53353,"_5":13331,"_25550":53056,"_2667":53354},[],"Installations whose CA keys predate the KMS",{"_3172":2518,"_28058":2416,"_19443":53356,"_5":13331,"_25550":53056,"_2667":53357},[],"Medium: CA keys stay unmanaged",{"_3172":2519,"_28058":2416,"_19443":53359,"_5":13331,"_25550":53056,"_2667":53360},[],"Run the CA-to-KMS migration",{"_3172":2520,"_28058":2416,"_19443":53362,"_5":13331,"_25550":53056,"_2667":53363},[],"Receiver certificate verification",{"_3172":2521,"_28058":2416,"_19443":53365,"_5":13331,"_25550":53056,"_2667":53366},[],"DMSs whose webhook had `validate_server_cert: false`",{"_3172":2522,"_28058":2416,"_19443":53368,"_5":13331,"_25550":53056,"_2667":53369},[],"Medium: credentials go to an unverified receiver",{"_3172":2523,"_28058":2416,"_19443":53371,"_5":13331,"_25550":53056,"_2667":53372},[],"Set `insecure_skip_verify` to `false`",{"_3172":2524,"_28058":2416,"_19443":53374,"_5":13331,"_25550":53056,"_2667":53117},[],{"_3172":2525,"_28058":2416,"_19443":53376,"_5":13331,"_25550":53056,"_2667":53377},[],"Scripts and consoles that edit DMSs through the API",{"_3172":2526,"_28058":2416,"_19443":53379,"_5":13331,"_25550":53056,"_2667":53380},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_3172":2527,"_28058":2416,"_19443":53382,"_5":13331,"_25550":53056,"_2667":53383},[],"Read the DMS before editing and use the new field",{"_3172":2528,"_28058":2416,"_19443":53385,"_5":13331,"_25550":53056,"_2667":53133},[],{"_3172":2529,"_28058":2416,"_19443":53387,"_5":13331,"_25550":53056,"_2667":53388},[],"Consumers that read the device `events` field",{"_3172":2530,"_28058":2416,"_19443":53390,"_5":13331,"_25550":53056,"_2667":53391},[],"Medium: the field disappears",{"_3172":2531,"_28058":2416,"_19443":53393,"_5":13331,"_25550":53056,"_2667":53394},[],"Use the new event endpoints",{"_3172":2532,"_28058":2416,"_19443":53396,"_5":13331,"_25550":53056,"_2667":53089},[],{"_3172":2533,"_28058":2416,"_19443":53398,"_5":13331,"_25550":53056,"_2667":53399},[],"Releases that override `toolbox`, `services.connectors`, ports, probes or scheduling",{"_3172":2534,"_28058":2416,"_19443":53401,"_5":13331,"_25550":53056,"_2667":53402},[],"Low to medium: validation errors or changed defaults",{"_3172":2535,"_28058":2416,"_19443":53404,"_5":13331,"_25550":53056,"_2667":53405},[],"Update the values file",{"_3172":2536,"_28058":2416,"_19443":53407,"_5":13331,"_25550":53056,"_2667":53125},[],{"_3172":2537,"_28058":2416,"_19443":53409,"_5":13331,"_25550":53056,"_2667":53410},[],"Clients that send the DMS ID in the update body",{"_3172":2538,"_28058":2416,"_19443":53412,"_5":13331,"_25550":53056,"_2667":53413},[],"Low: the ID in the URL wins",{"_3172":2539,"_28058":2416,"_19443":53415,"_5":13331,"_25550":53056,"_2667":53416},[],"Send the ID in the URL",{"_3172":2540,"_28058":2416,"_19443":53418,"_5":13331,"_25550":53056,"_2667":53129},[],{"_3172":2541,"_28058":2416,"_19443":53420,"_5":13331,"_25550":53056,"_2667":53421},[],"Consumers that match on certificate `type`",{"_3172":2542,"_28058":2416,"_19443":53423,"_5":13331,"_25550":53056,"_2667":53424},[],"Low: two values are renamed",{"_3172":2543,"_28058":2416,"_19443":53426,"_5":13331,"_25550":53056,"_2667":53427},[],"Adapt consumers",{"_3172":2544,"_28058":2416,"_19443":53429,"_5":13331,"_25550":53056,"_2667":53121},[],{"_3172":2545,"_28058":2416,"_19443":53431,"_5":13331,"_25550":53056,"_2667":53432},[],"Any DMS",{"_3172":2546,"_28058":2416,"_19443":53434,"_5":13331,"_25550":53056,"_2667":53435},[],"Low: informational",{"_3172":2547,"_28058":2416,"_19443":53437,"_5":13331,"_25550":53056,"_2667":53438},[],"Read both blocks before editing",{"_3172":2548,"_28058":2416,"_19443":53440,"_5":13331,"_25550":53064,"_2667":53441},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_3172":2549,"_28058":2416,"_19443":53443,"_5":13331,"_25550":53064,"_2667":53444},[],"Step 4 of the migration guide copies the data.",{"_3172":2550,"_28058":2416,"_19443":53446,"_5":13331,"_25550":53068,"_2667":53447},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_3172":2551,"_28058":2416,"_19443":53449,"_5":13331,"_25550":53072,"_2667":53450},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_3172":2552,"_28058":2416,"_19443":53452,"_5":13331,"_25550":53076,"_2667":53453},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_3172":2553,"_28058":2416,"_19443":53455,"_5":13331,"_25550":53080,"_2667":53456},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_3172":2554,"_28058":2416,"_19443":53458,"_5":13331,"_25550":53080,"_2667":53459},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_3172":2555,"_28058":2416,"_19443":53461,"_5":13331,"_25550":53084,"_2667":53462},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_3172":2556,"_28058":2416,"_19443":53464,"_5":13331,"_25550":53088,"_2667":53465},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_3172":2557,"_28058":2416,"_19443":53467,"_5":13331,"_25550":53088,"_2667":53468},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_3172":2558,"_28058":2416,"_19443":53470,"_5":13331,"_25550":53088,"_2667":53471},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_3172":2559,"_28058":2416,"_19443":53473,"_5":13331,"_25550":53088,"_2667":53474},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_3172":2560,"_28058":2416,"_19443":53476,"_5":13331,"_25550":53088,"_2667":53477},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_3172":2561,"_28058":2416,"_19443":53479,"_5":13331,"_25550":53088,"_2667":53480},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_3172":2562,"_28058":2416,"_19443":53482,"_5":13331,"_25550":53096,"_2667":53483},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_3172":2563,"_28058":2416,"_19443":53485,"_5":13331,"_25550":53096,"_2667":53486},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_3172":2564,"_28058":2416,"_19443":53488,"_5":13331,"_25550":53096,"_2667":53489},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_3172":2565,"_28058":2416,"_19443":53491,"_5":13331,"_25550":53096,"_2667":53492},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_3172":2566,"_28058":2416,"_19443":53494,"_5":13331,"_25550":53096,"_2667":53495},[],"The same KMS migration deletes, with a `NOTICE`, aliases that equal an existing key ID, because identifiers now resolve as a key ID before an alias. Affected aliases are dropped, not redirected.",{"_3172":2567,"_28058":2416,"_19443":53497,"_5":13331,"_25550":53100,"_2667":53498},[],"The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_3172":2568,"_28058":2416,"_19443":53500,"_5":13331,"_25550":53104,"_2667":53501},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_3172":2569,"_28058":2416,"_19443":53503,"_5":13331,"_25550":53104,"_2667":53504},[],"The `key_id` is the certificate's `subject_key_id` (SHA-256 of the public key).",{"_3172":2570,"_28058":2416,"_19443":53506,"_5":13331,"_25550":53104,"_2667":53507},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_3172":2571,"_28058":2416,"_19443":53509,"_5":13331,"_25550":53104,"_2667":53510},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_3172":2572,"_28058":2416,"_19443":53512,"_5":13331,"_25550":53104,"_2667":53513},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_3172":2573,"_28058":2416,"_19443":53515,"_5":13331,"_25550":53104,"_2667":53516},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_3172":2574,"_28058":2416,"_19443":53518,"_5":13331,"_25550":53112,"_2667":53519},[],"Stored webhook configs are rewritten to the current layout and their fields renamed:",{"_3172":2575,"_28058":2416,"_19443":53521,"_5":13331,"_25550":53112,"_2667":53522},[],"Field in 3.8.0",{"_3172":2576,"_28058":2416,"_19443":53524,"_5":13331,"_25550":53112,"_2667":53525},[],"Field in 4.0.0",{"_3172":2577,"_28058":2416,"_19443":53527,"_5":13331,"_25550":53112,"_2667":53528},[],"`validate_server_cert`",{"_3172":2578,"_28058":2416,"_19443":53530,"_5":13331,"_25550":53112,"_2667":53531},[],"`insecure_skip_verify` (value negated)",{"_3172":2579,"_28058":2416,"_19443":53533,"_5":13331,"_25550":53112,"_2667":53534},[],"`oidc`",{"_3172":2580,"_28058":2416,"_19443":53536,"_5":13331,"_25550":53112,"_2667":53537},[],"`jwt_options`",{"_3172":2581,"_28058":2416,"_19443":53539,"_5":13331,"_25550":53112,"_2667":53540},[],"`apikey`",{"_3172":2582,"_28058":2416,"_19443":53542,"_5":13331,"_25550":53112,"_2667":53543},[],"`apikey_options`",{"_3172":2583,"_28058":2416,"_19443":53545,"_5":13331,"_25550":53112,"_2667":53546},[],"`mtls`",{"_3172":2584,"_28058":2416,"_19443":53548,"_5":13331,"_25550":53112,"_2667":53549},[],"`mtls_options`",{"_3172":2585,"_28058":2416,"_19443":53551,"_5":13331,"_25550":53112,"_2667":53552},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. Two cases do need it.",{"_3172":2586,"_28058":2416,"_19443":53554,"_5":13331,"_25550":53112,"_2667":53555},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_3172":2587,"_28058":2416,"_19443":53557,"_5":13331,"_25550":53112,"_2667":53558},[],"**Receiver certificate verification.** A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_3172":2588,"_28058":2416,"_19443":53560,"_5":13331,"_25550":53116,"_2667":53561},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3172":2589,"_28058":2416,"_19443":53563,"_5":13331,"_25550":53116,"_2667":53564},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_3172":2590,"_28058":2416,"_19443":53566,"_5":13331,"_25550":53116,"_2667":53567},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_3172":2591,"_28058":2416,"_19443":53569,"_5":13331,"_25550":53120,"_2667":53570},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but read both blocks before editing a DMS so that you do not modify one while believing you are editing the other. The console exposes independent editors for both blocks; the DMS guide describes their fields, and you can also edit them through the DMS API.",{"_3172":2592,"_28058":2416,"_19443":53572,"_5":13331,"_25550":53124,"_2667":53573},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_3172":2593,"_28058":2416,"_19443":53575,"_5":13331,"_25550":53128,"_2667":53576},[],"Stored certificate type values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Adapt consumers that read or match on those values.",{"_3172":2594,"_28058":2416,"_19443":53578,"_5":13331,"_25550":53132,"_2667":53579},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_3172":2595,"_28058":2416,"_19443":53581,"_5":13331,"_25550":53132,"_2667":53582},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_3172":2596,"_28058":2416,"_19443":53584,"_5":13331,"_25550":53132,"_2667":53585},[],"`POST /v1/devices/:id/events` creates an event.",{"_3172":2597,"_28058":2416,"_19443":53587,"_5":13331,"_25550":53132,"_2667":53588},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Each Device Manager instance binds a durable AMQP queue named after its service ID, `device-manager-sse-<uuid>`. Queues from crashed or replaced instances linger until removed, so configure an expiration or cleanup policy on the broker.",{"_3172":2598,"_28058":2416,"_19443":53590,"_5":13331,"_25550":53136,"_2667":53591},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_3172":2599,"_28058":2416,"_19443":53593,"_5":13331,"_25550":53140,"_2667":53594},[],"Take a verifiable backup of PostgreSQL and schedule downtime. The upgrade moves every service's data into `pki`.",{"_3172":2600,"_28058":2416,"_19443":53596,"_5":13331,"_25550":53140,"_2667":53597},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_3172":2601,"_28058":2416,"_19443":53599,"_5":13331,"_25550":53140,"_2667":53600},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_3172":2602,"_28058":2416,"_19443":53602,"_5":13331,"_25550":53140,"_2667":53603},[],"Record the names of your local-storage PVCs:",{"_3172":2603,"_28058":2416,"_19443":53605,"_5":13331,"_25550":53140,"_2667":53606},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_3172":2604,"_28058":2416,"_19443":53608,"_5":13331,"_25550":53144,"_2667":53609},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_3172":2605,"_28058":2416,"_19443":53611,"_5":13331,"_25550":53144,"_2667":53612},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_3172":2606,"_28058":2416,"_19443":53614,"_5":13331,"_25550":53144,"_2667":53615},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is read; the connection always uses the global `postgres.hostname`, `postgres.port`, `postgres.username` and `postgres.password` values.",{"_3172":2607,"_28058":2416,"_19443":53617,"_5":13331,"_25550":53144,"_2667":53618},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_3172":2608,"_28058":2416,"_19443":53620,"_5":13331,"_25550":53144,"_2667":53621},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_3172":2609,"_28058":2416,"_19443":53623,"_5":13331,"_25550":53144,"_2667":53624},[],"**Rename `toolbox` to `connectivityTest`:**",{"_3172":2610,"_28058":2416,"_19443":53626,"_5":13331,"_25550":53144,"_2667":53627},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3172":2611,"_28058":2416,"_19443":53629,"_5":13331,"_25550":53144,"_2667":53630},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_3172":2612,"_28058":2416,"_19443":53632,"_5":13331,"_25550":53144,"_2667":53633},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_3172":2613,"_28058":2416,"_19443":53635,"_5":13331,"_25550":53144,"_2667":53636},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_3172":2614,"_28058":2416,"_19443":53638,"_5":13331,"_25550":53144,"_2667":53639},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_3172":2615,"_28058":2416,"_19443":53641,"_5":13331,"_25550":53144,"_2667":53642},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown.",{"_3172":2616,"_28058":2416,"_19443":53644,"_5":13331,"_25550":53148,"_2667":53645},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_3172":2617,"_28058":2416,"_19443":53647,"_5":13331,"_25550":53148,"_2667":53648},[],"If the deployment uses local KMS or VA storage, those pods fail until you complete step 4, so `--wait` cannot succeed: Helm waits for them to become ready, times out, exits with an error and marks the release `failed`. The hooks have already run by then, and every manifest, including the new StatefulSets and their PVCs, has been applied. Helm does not roll anything back without `--atomic`. Continue with step 4, then re-run the same `helm upgrade` command so it completes and Helm records the release as `deployed`. Both hooks are idempotent, so they are safe to run again.",{"_3172":2618,"_28058":2416,"_19443":53650,"_5":13331,"_25550":53152,"_2667":53651},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_3172":2619,"_28058":2416,"_19443":53653,"_5":13331,"_25550":53152,"_2667":53654},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_3172":2620,"_28058":2416,"_19443":53656,"_5":13331,"_25550":53152,"_2667":53657},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If `claims_ok` prints `ABORT`, the block stops before listing the claims: either a StatefulSet lookup failed, or a new claim resolves to the 3.8.0 claim. In the second case the copy would verify against itself and the final cleanup would delete the live volume. The chart always appends `-kms` and `-va` to the release-scoped name, so a collision means the claims are not what this guide expects; investigate before going on. Item 3 runs the same check and refuses to create the helper pod, so nothing touches the volumes. The check returns instead of calling `exit`, which would close your shell and lose the variables set so far. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_3172":2621,"_28058":2416,"_19443":53659,"_5":13331,"_25550":53152,"_2667":53660},[],"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:",{"_3172":2622,"_28058":2416,"_19443":53662,"_5":13331,"_25550":53152,"_2667":53663},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_3172":2623,"_28058":2416,"_19443":53665,"_5":13331,"_25550":53152,"_2667":53666},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_3172":2624,"_28058":2416,"_19443":53668,"_5":13331,"_25550":53152,"_2667":53669},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_3172":2625,"_28058":2416,"_19443":53671,"_5":13331,"_25550":53152,"_2667":53672},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_3172":2626,"_28058":2416,"_19443":53674,"_5":13331,"_25550":53152,"_2667":53675},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_3172":2627,"_28058":2416,"_19443":53677,"_5":13331,"_25550":53152,"_2667":53678},[],"**Remove the helper and restore the recorded replica counts:**",{"_3172":2628,"_28058":2416,"_19443":53680,"_5":13331,"_25550":53152,"_2667":53681},[],"**Re-run the step 3 `helm upgrade` command.** The KMS and VA pods now start against the copied data, so `--wait` succeeds and the release moves from `failed` to `deployed`.",{"_3172":2629,"_28058":2416,"_19443":53683,"_5":13331,"_25550":53156,"_2667":53684},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_3172":2630,"_28058":2416,"_19443":53686,"_5":13331,"_25550":53156,"_2667":53687},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_3172":2631,"_28058":2416,"_19443":53689,"_5":13331,"_25550":53160,"_2667":53690},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_3172":2632,"_28058":2416,"_19443":53692,"_5":13331,"_25550":53160,"_2667":53693},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_3172":2633,"_28058":2416,"_19443":53695,"_5":13331,"_25550":53160,"_2667":53696},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_3172":2634,"_28058":2416,"_19443":53698,"_5":13331,"_25550":53160,"_2667":53699},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository.",{"_3172":2635,"_28058":2416,"_19443":53701,"_5":13331,"_25550":53160,"_2667":53702},[],"The `goose-lamassu` README still shows per-database examples (`dbname=ca`, `dbname=kms`) and claims the tool validates the database name, and the `ca-to-kms-migration` README still describes the pre-4.0.0 two-database layout. Follow the `dbname=pki` form on this page instead of their examples.",{"_3172":2636,"_28058":2416,"_19443":53704,"_5":13331,"_25550":53164,"_2667":53705},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_3172":2637,"_28058":2416,"_19443":53707,"_5":13331,"_25550":53164,"_2667":53708},[],"**`helm upgrade --wait` times out and `helm status` reports the release as `failed`.** With local KMS or VA storage this is expected on the first run: the new pods cannot become ready before their data is copied. The hooks ran and the manifests and PVCs were applied, so complete step 4 and re-run the same `helm upgrade` command. If other pods are also not ready, check their logs, because something else is wrong.",{"_3172":2638,"_28058":2416,"_19443":53710,"_5":13331,"_25550":53164,"_2667":53711},[],"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait.",{"_3172":2639,"_28058":2416,"_19443":53713,"_5":13331,"_25550":53164,"_2667":53714},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_3172":2640,"_28058":2416,"_19443":53716,"_5":13331,"_25550":53164,"_2667":53717},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted on duplicate CA IDs or missing `engine_id` values. Check the job logs, fix the privileges or the data, and re-run the upgrade.",{"_3172":2641,"_28058":2416,"_19443":53719,"_5":13331,"_25550":53164,"_2667":53720},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_3172":2642,"_28058":2416,"_19443":53722,"_5":13331,"_25550":53164,"_2667":53723},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_3172":2643,"_28058":2416,"_19443":53725,"_5":13331,"_25550":53167,"_2667":53726},[],"After the upgrade, check in this order:",{"_3172":2644,"_28058":2416,"_19443":53728,"_5":13331,"_25550":53167,"_2667":53729},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations.",{"_3172":2645,"_28058":2416,"_19443":53731,"_5":13331,"_25550":53167,"_2667":53732},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_3172":2646,"_28058":2416,"_19443":53734,"_5":13331,"_25550":53167,"_2667":53735},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_3172":2647,"_28058":2416,"_19443":53737,"_5":13331,"_25550":53167,"_2667":53738},[],"**Existing CRLs are served.** `GET /crl/<ca-ski>` on VA returns a previously issued CRL, and new CRLs are issued.",{"_3172":2648,"_28058":2416,"_19443":53740,"_5":13331,"_25550":53167,"_2667":53741},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS.",{"_3172":2649,"_28058":2416,"_19443":53743,"_5":13331,"_25550":53167,"_2667":53744},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_3172":2650,"_28058":2416,"_19443":53746,"_5":13331,"_25550":53167,"_2667":53747},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_3172":2651,"_28058":2416,"_19443":53749,"_5":13331,"_25550":53167,"_2667":53750},[],"**AMQP.** The backend connects to the broker with the expected TLS settings, and the cleanup policy for SSE queues is in place.",{"_3172":2652,"_28058":2416,"_19443":53752,"_5":13331,"_25550":53167,"_2667":53753},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_3172":2653,"_28058":2416,"_19443":53755,"_5":13331,"_25550":53167,"_2667":53756},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_3172":2654,"_28058":2416,"_19443":53758,"_5":13331,"_25550":53167,"_2667":53759},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_3172":2655,"_28058":2416,"_19443":53761,"_5":13331,"_25550":53167,"_2667":53762},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_3172":2656,"_28058":2416,"_19443":53764,"_5":13331,"_25550":53167,"_2667":53765},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_3172":2657,"_28058":2416,"_19443":53767,"_5":13331,"_25550":53167,"_2667":53768},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_3172":2658,"_28058":2416,"_19443":53770,"_5":13331,"_25550":53171,"_2667":53771},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy. These are the fixed 3.8.0 names recorded in step 1; before deleting, confirm that neither is mounted by a running pod, for example with `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, where `Used By` must be `<none>`:",{"_3172":2659,"_28058":2416,"_19443":53773,"_5":13331,"_25550":53171,"_2667":53774},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_3172":2660,"_28058":2416,"_19443":53776,"_5":13331,"_25550":53171,"_2667":53777},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3172":2661,"_28058":2416,"_19443":53779,"_5":13331,"_25550":53171,"_2667":53780},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_3172":2662,"_28058":2416,"_19443":53782,"_5":13331,"_25550":53171,"_2667":53783},[],"<Card title=\"Configure a DMS\" description=\"Enrollment, re-enrollment and webhook settings.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />","sorting",{"_53786":53787,"_53788":53789,"_53790":53791,"_53792":53793,"_16935":2689,"_64399":2689},"language","english","sortableProperties",[2667,28058,5,25550],"sortablePropertiesWithTypes",{"_2667":23255,"_28058":23255,"_5":23255,"_25550":23255},"sorts",{"_2667":53794,"_28058":56446,"_5":59097,"_25550":61748},{"_4263":53795,"_53796":53797,"_5":23255},{"_13386":3390,"_13761":5346,"_13780":5264,"_12000":4718,"_13767":3146,"_18459":4948,"_13407":3234,"_13414":3044,"_27102":3143,"_27493":4378,"_27514":5616,"_27120":4551,"_32177":6904,"_27525":6314,"_27554":6875,"_32184":2844,"_32187":6447,"_32190":20877,"_32193":16875,"_27900":4063,"_32198":8205,"_32200":2955,"_27930":4218,"_13776":2932,"_32204":12269,"_32207":5125,"_32209":4387,"_27543":10184,"_27895":6986,"_27943":11208,"_32214":3370,"_32216":4240,"_32218":3740,"_32220":2766,"_32222":2992,"_32224":3962,"_32226":14457,"_32228":3361,"_32230":9249,"_27172":6999,"_32233":2808,"_32235":3217,"_27166":3052,"_32238":4318,"_32240":3661,"_32242":2848,"_32245":10910,"_27212":15477,"_32249":12999,"_27093":5911,"_32252":6431,"_27125":3684,"_32255":15478,"_32257":4728,"_28116":4353,"_13770":6349,"_32262":9900,"_32264":4376,"_32267":16185,"_32269":4226,"_32271":3373,"_32273":4054,"_32275":5629,"_18462":21348,"_32278":3787,"_32280":5961,"_27146":4889,"_27537":8102,"_32284":5474,"_32286":3456,"_32288":4634,"_27960":2776,"_32291":6362,"_32293":6577,"_32295":4695,"_28038":4582,"_27570":5763,"_32299":12854,"_32301":5008,"_27135":2779,"_32304":6831,"_32306":5198,"_32308":2985,"_27976":2941,"_27232":21142,"_26582":7428,"_32313":3100,"_32315":11511,"_32317":4744,"_27269":2976,"_32321":4341,"_27531":4554,"_32325":6838,"_32327":3969,"_32329":5803,"_32331":5356,"_32333":6016,"_32335":6917,"_27258":6769,"_27498":9119,"_32339":5337,"_32341":42