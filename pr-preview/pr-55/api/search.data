_39561":57056,"_39563":57059,"_39565":57062,"_39567":57065,"_39569":57068,"_39571":57071,"_39573":57074,"_39575":57077,"_39577":57080,"_39579":57083,"_39581":57086,"_39583":57089,"_39585":57092,"_39587":57095,"_39589":57098,"_39591":57101,"_39593":57104,"_39595":57107,"_39597":57110,"_39599":57113,"_39601":57116,"_39603":57119,"_39605":57122,"_39607":57125,"_39609":57128,"_39611":57131,"_39613":57134,"_39615":57137,"_39617":57140,"_39619":57143,"_39621":57146,"_39623":57149,"_39625":57152,"_39627":57155,"_39629":57158,"_39631":57161,"_39633":57164,"_39635":57167,"_39637":57170,"_39639":57173,"_39641":57176,"_39644":57179,"_39646":57182,"_39648":57185,"_39650":57188},{"_3383":15,"_29651":15,"_5":14473,"_2870":48278,"_30004":48279,"_20578":48283,"_26960":15},"Deploy from AWS Marketplace",[48280,48281,48282],"Docs","Deployment","Other models",[],{"_3383":16,"_29651":15,"_20578":48285,"_5":14121,"_26960":15,"_2870":48286},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_3383":17,"_29651":15,"_5":30001,"_20578":48288,"_26960":48289,"_2870":48290},[],"/docs/pr-preview/pr-55/deployment/aws-marketplace#before-you-begin","Before you begin",{"_3383":18,"_29651":15,"_5":30001,"_20578":48292,"_26960":48293,"_2870":48294},[],"/docs/pr-preview/pr-55/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_3383":19,"_29651":15,"_5":30001,"_20578":48296,"_26960":48297,"_2870":48298},[],"/docs/pr-preview/pr-55/deployment/aws-marketplace#open-the-offer","Open the offer",{"_3383":20,"_29651":15,"_5":30001,"_20578":48300,"_26960":48301,"_2870":48302},[],"/docs/pr-preview/pr-55/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_3383":21,"_29651":15,"_5":30001,"_20578":48304,"_26960":48305,"_2870":48306},[],"/docs/pr-preview/pr-55/deployment/aws-marketplace#limit-network-access","Limit network access",{"_3383":22,"_29651":15,"_5":30001,"_20578":48308,"_26960":48309,"_2870":48310},[],"/docs/pr-preview/pr-55/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_3383":23,"_29651":15,"_5":30001,"_20578":48312,"_26960":48313,"_2870":48314},[],"/docs/pr-preview/pr-55/deployment/aws-marketplace#next-step","Next step",{"_3383":24,"_29651":15,"_20578":48316,"_5":14121,"_26960":15,"_2870":48317},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_3383":25,"_29651":15,"_20578":48319,"_5":14121,"_26960":48289,"_2870":48320},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_3383":26,"_29651":15,"_20578":48322,"_5":14121,"_26960":48289,"_2870":48323},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_3383":27,"_29651":15,"_20578":48325,"_5":14121,"_26960":48289,"_2870":48326},[],"A security group allowing the necessary endpoints.",{"_3383":28,"_29651":15,"_20578":48328,"_5":14121,"_26960":48293,"_2870":48329},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_3383":29,"_29651":15,"_20578":48331,"_5":14121,"_26960":48293,"_2870":48332},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_3383":30,"_29651":15,"_20578":48334,"_5":14121,"_26960":48293,"_2870":48335},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_3383":31,"_29651":15,"_20578":48337,"_5":14121,"_26960":48297,"_2870":48338},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_3383":32,"_29651":15,"_20578":48340,"_5":14121,"_26960":48301,"_2870":48341},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_3383":33,"_29651":15,"_20578":48343,"_5":14121,"_26960":48305,"_2870":48344},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_3383":34,"_29651":15,"_20578":48346,"_5":14121,"_26960":48309,"_2870":48347},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_3383":35,"_29651":15,"_20578":48349,"_5":14121,"_26960":48313,"_2870":48350},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_3383":36,"_29651":36,"_5":14473,"_2870":48352,"_30004":48353,"_20578":48354,"_26960":36},"Deploy Lamassu",[48280,48281],[],{"_3383":37,"_29651":36,"_20578":48356,"_5":14121,"_26960":36,"_2870":48357},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_3383":38,"_29651":36,"_5":30001,"_20578":48359,"_26960":48360,"_2870":48361},[],"/docs/pr-preview/pr-55/deployment/overview#choose-a-model","Choose a model",{"_3383":39,"_29651":36,"_5":30001,"_20578":48363,"_26960":48364,"_2870":48365},[],"/docs/pr-preview/pr-55/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_3383":40,"_29651":36,"_5":30001,"_20578":48367,"_26960":48368,"_2870":48369},[],"/docs/pr-preview/pr-55/deployment/overview#after-deployment","After deployment",{"_3383":41,"_29651":36,"_20578":48371,"_5":14121,"_26960":36,"_2870":48372},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_3383":42,"_29651":36,"_20578":48374,"_5":14121,"_26960":48360,"_2870":48375},[],"Model",{"_3383":43,"_29651":36,"_20578":48377,"_5":14121,"_26960":48360,"_2870":48378},[],"Recommended for",{"_3383":44,"_29651":36,"_20578":48380,"_5":14121,"_26960":48360,"_2870":48381},[],"Who operates the infrastructure",{"_3383":45,"_29651":36,"_20578":48383,"_5":14121,"_26960":48360,"_2870":48384},[],"Starting point",{"_3383":46,"_29651":36,"_20578":48386,"_5":14121,"_26960":48360,"_2870":48387},[],"Kubernetes self-managed",{"_3383":47,"_29651":36,"_20578":48389,"_5":14121,"_26960":48360,"_2870":48390},[],"Production, regulated environments and custom deployments",{"_3383":48,"_29651":36,"_20578":48392,"_5":14121,"_26960":48360,"_2870":48393},[],"Your team",{"_3383":49,"_29651":36,"_20578":48395,"_5":14121,"_26960":48360,"_2870":48396},[],"Helm or Fastlane",{"_3383":50,"_29651":36,"_20578":48398,"_5":14121,"_26960":48360,"_2870":48399},[],"AWS Marketplace",{"_3383":51,"_29651":36,"_20578":48401,"_5":14121,"_26960":48360,"_2870":48402},[],"Evaluation or a dedicated deployment inside an AWS account",{"_3383":52,"_29651":36,"_20578":48404,"_5":14121,"_26960":48360,"_2870":48393},[],{"_3383":53,"_29651":36,"_20578":48406,"_5":14121,"_26960":48360,"_2870":48407},[],"Preconfigured image on EC2",{"_3383":54,"_29651":36,"_20578":48409,"_5":14121,"_26960":48360,"_2870":48410},[],"SaaS",{"_3383":55,"_29651":36,"_20578":48412,"_5":14121,"_26960":48360,"_2870":48413},[],"Teams that want to use the platform without operating it",{"_3383":56,"_29651":36,"_20578":48415,"_5":14121,"_26960":48360,"_2870":48416},[],"Lamassu",{"_3383":57,"_29651":36,"_20578":48418,"_5":14121,"_26960":48360,"_2870":48419},[],"Managed subscription",{"_3383":58,"_29651":36,"_20578":48421,"_5":14121,"_26960":48360,"_2870":48422},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3383":59,"_29651":36,"_20578":48424,"_5":14121,"_26960":48360,"_2870":48425},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3383":60,"_29651":36,"_20578":48427,"_5":14121,"_26960":48360,"_2870":48428},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_3383":61,"_29651":36,"_20578":48430,"_5":14121,"_26960":48364,"_2870":48431},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_3383":62,"_29651":36,"_20578":48433,"_5":14121,"_26960":48368,"_2870":48434},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_3383":63,"_29651":63,"_5":14473,"_2870":48436,"_30004":48437,"_20578":48438,"_26960":63},"Use Lamassu as SaaS",[48280,48281,48282],[],{"_3383":64,"_29651":63,"_20578":48440,"_5":14121,"_26960":63,"_2870":48441},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_3383":65,"_29651":63,"_5":30001,"_20578":48443,"_26960":48444,"_2870":48445},[],"/docs/pr-preview/pr-55/deployment/saas#what-the-service-manages","What the service manages",{"_3383":66,"_29651":63,"_5":30001,"_20578":48447,"_26960":48448,"_2870":48449},[],"/docs/pr-preview/pr-55/deployment/saas#plans","Plans",{"_3383":67,"_29651":63,"_5":30001,"_20578":48451,"_26960":48452,"_2870":48453},[],"/docs/pr-preview/pr-55/deployment/saas#request-access","Request access",{"_3383":68,"_29651":63,"_20578":48455,"_5":14121,"_26960":63,"_2870":48456},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_3383":69,"_29651":63,"_20578":48458,"_5":14121,"_26960":48444,"_2870":48459},[],"Platform availability and maintenance.",{"_3383":70,"_29651":63,"_20578":48461,"_5":14121,"_26960":48444,"_2870":48462},[],"Automatic backups.",{"_3383":71,"_29651":63,"_20578":48464,"_5":14121,"_26960":48444,"_2870":48465},[],"Version upgrades.",{"_3383":72,"_29651":63,"_20578":48467,"_5":14121,"_26960":48444,"_2870":48468},[],"Technical support and SLA according to your plan.",{"_3383":73,"_29651":63,"_20578":48470,"_5":14121,"_26960":48448,"_2870":48471},[],"Plan",{"_3383":74,"_29651":63,"_20578":48473,"_5":14121,"_26960":48448,"_2870":48474},[],"Devices",{"_3383":75,"_29651":63,"_20578":48476,"_5":14121,"_26960":48448,"_2870":48477},[],"Support",{"_3383":76,"_29651":63,"_20578":48479,"_5":14121,"_26960":48448,"_2870":48480},[],"SLA",{"_3383":77,"_29651":63,"_20578":48482,"_5":14121,"_26960":48448,"_2870":48483},[],"Starter",{"_3383":78,"_29651":63,"_20578":48485,"_5":14121,"_26960":48448,"_2870":48486},[],"Up to 1,000",{"_3383":79,"_29651":63,"_20578":48488,"_5":14121,"_26960":48448,"_2870":48489},[],"Email",{"_3383":80,"_29651":63,"_20578":48491,"_5":14121,"_26960":48448,"_2870":48492},[],"99.5 %",{"_3383":81,"_29651":63,"_20578":48494,"_5":14121,"_26960":48448,"_2870":48495},[],"Professional",{"_3383":82,"_29651":63,"_20578":48497,"_5":14121,"_26960":48448,"_2870":48498},[],"Up to 10,000",{"_3383":83,"_29651":63,"_20578":48500,"_5":14121,"_26960":48448,"_2870":48501},[],"Email and chat",{"_3383":84,"_29651":63,"_20578":48503,"_5":14121,"_26960":48448,"_2870":48504},[],"99.9 %",{"_3383":85,"_29651":63,"_20578":48506,"_5":14121,"_26960":48448,"_2870":48507},[],"Enterprise",{"_3383":86,"_29651":63,"_20578":48509,"_5":14121,"_26960":48448,"_2870":48510},[],"Unlimited",{"_3383":87,"_29651":63,"_20578":48512,"_5":14121,"_26960":48448,"_2870":48513},[],"Dedicated",{"_3383":88,"_29651":63,"_20578":48515,"_5":14121,"_26960":48448,"_2870":48516},[],"99.99 %",{"_3383":89,"_29651":63,"_20578":48518,"_5":14121,"_26960":48452,"_2870":48519},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_3383":90,"_29651":63,"_20578":48521,"_5":14121,"_26960":48452,"_2870":48522},[],"When you receive your instance's credentials, continue with Get started.",{"_3383":91,"_29651":91,"_5":14473,"_2870":48524,"_30004":48525,"_20578":48526,"_26960":91},"Fastlane",[48280,48281,48387],[],{"_3383":92,"_29651":91,"_20578":48528,"_5":14121,"_26960":91,"_2870":48529},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_3383":93,"_29651":91,"_5":30001,"_20578":48531,"_26960":48532,"_2870":48533},[],"/docs/pr-preview/pr-55/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_3383":94,"_29651":91,"_5":30001,"_20578":48535,"_26960":48536,"_2870":48537},[],"/docs/pr-preview/pr-55/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_3383":95,"_29651":91,"_5":30001,"_20578":48539,"_26960":48540,"_2870":48290},[],"/docs/pr-preview/pr-55/deployment/self-hosted/fastlane#before-you-begin",{"_3383":96,"_29651":91,"_5":30001,"_20578":48542,"_26960":48543,"_2870":48544},[],"/docs/pr-preview/pr-55/deployment/self-hosted/fastlane#quick-start","Quick start",{"_3383":97,"_29651":91,"_5":30001,"_20578":48546,"_26960":48547,"_2870":48548},[],"/docs/pr-preview/pr-55/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_3383":98,"_29651":91,"_5":30001,"_20578":48550,"_26960":48551,"_2870":48552},[],"/docs/pr-preview/pr-55/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_3383":99,"_29651":91,"_5":30001,"_20578":48554,"_26960":48555,"_2870":48556},[],"/docs/pr-preview/pr-55/deployment/self-hosted/fastlane#development-mode","Development mode",{"_3383":100,"_29651":91,"_5":30001,"_20578":48558,"_26960":48559,"_2870":48560},[],"/docs/pr-preview/pr-55/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_3383":101,"_29651":91,"_5":30001,"_20578":48562,"_26960":48563,"_2870":48564},[],"/docs/pr-preview/pr-55/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_3383":102,"_29651":91,"_5":30001,"_20578":48566,"_26960":48567,"_2870":48568},[],"/docs/pr-preview/pr-55/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_3383":103,"_29651":91,"_5":30001,"_20578":48570,"_26960":48571,"_2870":48572},[],"/docs/pr-preview/pr-55/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_3383":104,"_29651":91,"_20578":48574,"_5":14121,"_26960":48532,"_2870":48575},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_3383":105,"_29651":91,"_20578":48577,"_5":14121,"_26960":48532,"_2870":48578},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_3383":106,"_29651":91,"_20578":48580,"_5":14121,"_26960":48536,"_2870":48581},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_3383":107,"_29651":91,"_20578":48583,"_5":14121,"_26960":48536,"_2870":48584},[],"Fastlane installs or configures",{"_3383":108,"_29651":91,"_20578":48586,"_5":14121,"_26960":48536,"_2870":48587},[],"You still provide",{"_3383":109,"_29651":91,"_20578":48589,"_5":14121,"_26960":48536,"_2870":48590},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_3383":110,"_29651":91,"_20578":48592,"_5":14121,"_26960":48536,"_2870":48593},[],"The Kubernetes cluster, nodes and persistent storage",{"_3383":111,"_29651":91,"_20578":48595,"_5":14121,"_26960":48536,"_2870":48596},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_3383":112,"_29651":91,"_20578":48598,"_5":14121,"_26960":48536,"_2870":48599},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_3383":113,"_29651":91,"_20578":48601,"_5":14121,"_26960":48536,"_2870":48602},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_3383":114,"_29651":91,"_20578":48604,"_5":14121,"_26960":48536,"_2870":48605},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_3383":115,"_29651":91,"_20578":48607,"_5":14121,"_26960":48536,"_2870":48608},[],"Optional observability and lab HSM components",{"_3383":116,"_29651":91,"_20578":48610,"_5":14121,"_26960":48536,"_2870":48611},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_3383":117,"_29651":91,"_20578":48613,"_5":14121,"_26960":48536,"_2870":48614},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_3383":118,"_29651":91,"_20578":48616,"_5":14121,"_26960":48540,"_2870":48617},[],"You need:",{"_3383":119,"_29651":91,"_20578":48619,"_5":14121,"_26960":48540,"_2870":48620},[],"an existing Kubernetes cluster",{"_3383":120,"_29651":91,"_20578":48622,"_5":14121,"_26960":48540,"_2870":48623},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_3383":121,"_29651":91,"_20578":48625,"_5":14121,"_26960":48540,"_2870":48626},[],"`yq`",{"_3383":122,"_29651":91,"_20578":48628,"_5":14121,"_26960":48540,"_2870":23259},[],{"_3383":123,"_29651":91,"_20578":48630,"_5":14121,"_26960":48540,"_2870":48631},[],"`jq` only when using `--sample-data` or `--development`",{"_3383":124,"_29651":91,"_20578":48633,"_5":14121,"_26960":48540,"_2870":48634},[],"`ssh-keygen` only when using `--with-hsm`",{"_3383":125,"_29651":91,"_20578":48636,"_5":14121,"_26960":48540,"_2870":48637},[],"free external ports 80 and 443 on a single-node K3s host",{"_3383":126,"_29651":91,"_20578":48639,"_5":14121,"_26960":48540,"_2870":48640},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_3383":127,"_29651":91,"_20578":48642,"_5":14121,"_26960":48540,"_2870":48643},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_3383":128,"_29651":91,"_20578":48645,"_5":14121,"_26960":48543,"_2870":48646},[],"Run the script from a clone of the Helm repository:",{"_3383":129,"_29651":91,"_20578":48648,"_5":14121,"_26960":48543,"_2870":48649},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_3383":130,"_29651":91,"_20578":48651,"_5":14121,"_26960":48547,"_2870":48652},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_3383":131,"_29651":91,"_20578":48654,"_5":14121,"_26960":48547,"_2870":48655},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_3383":132,"_29651":91,"_20578":48657,"_5":14121,"_26960":48547,"_2870":48658},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_3383":133,"_29651":91,"_20578":48660,"_5":14121,"_26960":48547,"_2870":48661},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_3383":134,"_29651":91,"_20578":48663,"_5":14121,"_26960":48551,"_2870":48664},[],"Option",{"_3383":135,"_29651":91,"_20578":48666,"_5":14121,"_26960":48551,"_2870":48667},[],"Default",{"_3383":136,"_29651":91,"_20578":48669,"_5":14121,"_26960":48551,"_2870":48670},[],"Purpose",{"_3383":137,"_29651":91,"_20578":48672,"_5":14121,"_26960":48551,"_2870":48673},[],"`-h`, `--help`",{"_3383":138,"_29651":91,"_20578":48675,"_5":14121,"_26960":48551,"_2870":48676},[],"—",{"_3383":139,"_29651":91,"_20578":48678,"_5":14121,"_26960":48551,"_2870":48679},[],"Show help",{"_3383":140,"_29651":91,"_20578":48681,"_5":14121,"_26960":48551,"_2870":48682},[],"`-c`, `--context`",{"_3383":141,"_29651":91,"_20578":48684,"_5":14121,"_26960":48551,"_2870":48685},[],"current context",{"_3383":142,"_29651":91,"_20578":48687,"_5":14121,"_26960":48551,"_2870":48688},[],"Select the kubeconfig context for kubectl and Helm",{"_3383":143,"_29651":91,"_20578":48690,"_5":14121,"_26960":48551,"_2870":48691},[],"`-n`, `--non-interactive`",{"_3383":144,"_29651":91,"_20578":48693,"_5":14121,"_26960":48551,"_2870":6408},[],{"_3383":145,"_29651":91,"_20578":48695,"_5":14121,"_26960":48551,"_2870":48696},[],"Skip prompts and generate dependency credentials",{"_3383":146,"_29651":91,"_20578":48698,"_5":14121,"_26960":48551,"_2870":48699},[],"`-ns`, `--namespace`",{"_3383":147,"_29651":91,"_20578":48701,"_5":14121,"_26960":48551,"_2870":48702},[],"`lamassu-dev`",{"_3383":148,"_29651":91,"_20578":48704,"_5":14121,"_26960":48551,"_2870":48705},[],"Namespace for the installation",{"_3383":149,"_29651":91,"_20578":48707,"_5":14121,"_26960":48551,"_2870":48708},[],"`-d`, `--domain`",{"_3383":150,"_29651":91,"_20578":48710,"_5":14121,"_26960":48551,"_2870":48711},[],"`dev.lamassu.io`",{"_3383":151,"_29651":91,"_20578":48713,"_5":14121,"_26960":48551,"_2870":48714},[],"Domain used by the UI, OIDC and certificate",{"_3383":152,"_29651":91,"_20578":48716,"_5":14121,"_26960":48551,"_2870":48717},[],"`-v`, `--version`",{"_3383":153,"_29651":91,"_20578":48719,"_5":14121,"_26960":48551,"_2870":14807},[],{"_3383":154,"_29651":91,"_20578":48721,"_5":14121,"_26960":48551,"_2870":48722},[],"Lamassu chart version",{"_3383":155,"_29651":91,"_20578":48724,"_5":14121,"_26960":48551,"_2870":48725},[],"`--https-port`",{"_3383":156,"_29651":91,"_20578":48727,"_5":14121,"_26960":48551,"_2870":48728},[],"`443`",{"_3383":157,"_29651":91,"_20578":48730,"_5":14121,"_26960":48551,"_2870":48731},[],"Gateway HTTPS listener port",{"_3383":158,"_29651":91,"_20578":48733,"_5":14121,"_26960":48551,"_2870":48734},[],"`--http-port`",{"_3383":159,"_29651":91,"_20578":48736,"_5":14121,"_26960":48551,"_2870":48737},[],"`80`",{"_3383":160,"_29651":91,"_20578":48739,"_5":14121,"_26960":48551,"_2870":48740},[],"Gateway HTTP listener port",{"_3383":161,"_29651":91,"_20578":48742,"_5":14121,"_26960":48551,"_2870":48743},[],"`--tls-crt`",{"_3383":162,"_29651":91,"_20578":48745,"_5":14121,"_26960":48551,"_2870":48676},[],{"_3383":163,"_29651":91,"_20578":48747,"_5":14121,"_26960":48551,"_2870":48748},[],"PEM certificate for downstream TLS",{"_3383":164,"_29651":91,"_20578":48750,"_5":14121,"_26960":48551,"_2870":48751},[],"`--tls-key`",{"_3383":165,"_29651":91,"_20578":48753,"_5":14121,"_26960":48551,"_2870":48676},[],{"_3383":166,"_29651":91,"_20578":48755,"_5":14121,"_26960":48551,"_2870":48756},[],"PEM private key for downstream TLS",{"_3383":167,"_29651":91,"_20578":48758,"_5":14121,"_26960":48551,"_2870":48759},[],"`-l`, `--local-chart-path`",{"_3383":168,"_29651":91,"_20578":48761,"_5":14121,"_26960":48551,"_2870":48762},[],"repository chart",{"_3383":169,"_29651":91,"_20578":48764,"_5":14121,"_26960":48551,"_2870":48765},[],"Use an unpacked local Lamassu chart",{"_3383":170,"_29651":91,"_20578":48767,"_5":14121,"_26960":48551,"_2870":48768},[],"`-ip`, `--gateway-ip`",{"_3383":171,"_29651":91,"_20578":48770,"_5":14121,"_26960":48551,"_2870":8578},[],{"_3383":172,"_29651":91,"_20578":48772,"_5":14121,"_26960":48551,"_2870":48773},[],"Override the address written to `gateway.addresses`",{"_3383":173,"_29651":91,"_20578":48775,"_5":14121,"_26960":48551,"_2870":48776},[],"`--otel`",{"_3383":174,"_29651":91,"_20578":48778,"_5":14121,"_26960":48551,"_2870":6408},[],{"_3383":175,"_29651":91,"_20578":48780,"_5":14121,"_26960":48551,"_2870":48781},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_3383":176,"_29651":91,"_20578":48783,"_5":14121,"_26960":48551,"_2870":48784},[],"`--development`",{"_3383":177,"_29651":91,"_20578":48786,"_5":14121,"_26960":48551,"_2870":6408},[],{"_3383":178,"_29651":91,"_20578":48788,"_5":14121,"_26960":48551,"_2870":48789},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_3383":179,"_29651":91,"_20578":48791,"_5":14121,"_26960":48551,"_2870":48792},[],"`--sample-data`",{"_3383":180,"_29651":91,"_20578":48794,"_5":14121,"_26960":48551,"_2870":6408},[],{"_3383":181,"_29651":91,"_20578":48796,"_5":14121,"_26960":48551,"_2870":48797},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_3383":182,"_29651":91,"_20578":48799,"_5":14121,"_26960":48551,"_2870":48800},[],"`--with-hsm`",{"_3383":183,"_29651":91,"_20578":48802,"_5":14121,"_26960":48551,"_2870":6408},[],{"_3383":184,"_29651":91,"_20578":48804,"_5":14121,"_26960":48551,"_2870":48805},[],"Install lab HSM components and configure KMS for PKCS#11",{"_3383":185,"_29651":91,"_20578":48807,"_5":14121,"_26960":48551,"_2870":48808},[],"`--softhsm-chart-path`",{"_3383":186,"_29651":91,"_20578":48810,"_5":14121,"_26960":48551,"_2870":48811},[],"`./charts/softhsm`",{"_3383":187,"_29651":91,"_20578":48813,"_5":14121,"_26960":48551,"_2870":48814},[],"Use a different local SoftHSM chart",{"_3383":188,"_29651":91,"_20578":48816,"_5":14121,"_26960":48551,"_2870":48817},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_3383":189,"_29651":91,"_20578":48819,"_5":14121,"_26960":48555,"_2870":48820},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_3383":190,"_29651":91,"_20578":48822,"_5":14121,"_26960":48555,"_2870":48823},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_3383":191,"_29651":91,"_20578":48825,"_5":14121,"_26960":48555,"_2870":48826},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_3383":192,"_29651":91,"_20578":48828,"_5":14121,"_26960":48555,"_2870":48829},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_3383":193,"_29651":91,"_20578":48831,"_5":14121,"_26960":48555,"_2870":48832},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_3383":194,"_29651":91,"_20578":48834,"_5":14121,"_26960":48555,"_2870":48835},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_3383":195,"_29651":91,"_20578":48837,"_5":14121,"_26960":48559,"_2870":48838},[],"Fastlane:",{"_3383":196,"_29651":91,"_20578":48840,"_5":14121,"_26960":48559,"_2870":48841},[],"validates local tools and the selected cluster",{"_3383":197,"_29651":91,"_20578":48843,"_5":14121,"_26960":48559,"_2870":48844},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_3383":198,"_29651":91,"_20578":48846,"_5":14121,"_26960":48559,"_2870":48847},[],"creates the namespace",{"_3383":199,"_29651":91,"_20578":48849,"_5":14121,"_26960":48559,"_2870":48850},[],"installs PostgreSQL and creates the required databases",{"_3383":200,"_29651":91,"_20578":48852,"_5":14121,"_26960":48559,"_2870":48853},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_3383":201,"_29651":91,"_20578":48855,"_5":14121,"_26960":48559,"_2870":48856},[],"installs RabbitMQ",{"_3383":202,"_29651":91,"_20578":48858,"_5":14121,"_26960":48559,"_2870":48859},[],"optionally installs observability and lab HSM components",{"_3383":203,"_29651":91,"_20578":48861,"_5":14121,"_26960":48559,"_2870":48862},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_3383":204,"_29651":91,"_20578":48864,"_5":14121,"_26960":48559,"_2870":48865},[],"optionally loads sample data",{"_3383":205,"_29651":91,"_20578":48867,"_5":14121,"_26960":48559,"_2870":48868},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_3383":206,"_29651":91,"_20578":48870,"_5":14121,"_26960":48563,"_2870":48871},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_3383":207,"_29651":91,"_20578":48873,"_5":14121,"_26960":48563,"_2870":48874},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_3383":208,"_29651":91,"_20578":48876,"_5":14121,"_26960":48567,"_2870":48877},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_3383":209,"_29651":91,"_20578":48879,"_5":14121,"_26960":48567,"_2870":48880},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_3383":210,"_29651":91,"_20578":48882,"_5":14121,"_26960":48567,"_2870":48883},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_3383":211,"_29651":91,"_20578":48885,"_5":14121,"_26960":48571,"_2870":48886},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_3383":212,"_29651":212,"_5":14473,"_2870":48888,"_30004":48889,"_20578":48890,"_26960":212},"Install with Helm",[48280,48281,48387],[],{"_3383":213,"_29651":212,"_20578":48892,"_5":14121,"_26960":212,"_2870":48893},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_3383":214,"_29651":212,"_5":30001,"_20578":48895,"_26960":48896,"_2870":48897},[],"/docs/pr-preview/pr-55/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_3383":215,"_29651":212,"_5":30001,"_20578":48899,"_26960":48900,"_2870":48290},[],"/docs/pr-preview/pr-55/deployment/self-hosted/helm#before-you-begin",{"_3383":216,"_29651":212,"_5":30001,"_20578":48902,"_26960":48903,"_2870":48904},[],"/docs/pr-preview/pr-55/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_3383":217,"_29651":212,"_5":30001,"_20578":48906,"_26960":48907,"_2870":48908},[],"/docs/pr-preview/pr-55/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_3383":218,"_29651":212,"_5":30001,"_20578":48910,"_26960":48911,"_2870":48912},[],"/docs/pr-preview/pr-55/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_3383":219,"_29651":212,"_5":30001,"_20578":48914,"_26960":48915,"_2870":48916},[],"/docs/pr-preview/pr-55/deployment/self-hosted/helm#amqp-tls-amqps","AMQP TLS (AMQPS)",{"_3383":220,"_29651":212,"_5":30001,"_20578":48918,"_26960":48919,"_2870":48920},[],"/docs/pr-preview/pr-55/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_3383":221,"_29651":212,"_5":30001,"_20578":48922,"_26960":48923,"_2870":48924},[],"/docs/pr-preview/pr-55/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_3383":222,"_29651":212,"_5":30001,"_20578":48926,"_26960":48927,"_2870":48928},[],"/docs/pr-preview/pr-55/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_3383":223,"_29651":212,"_5":30001,"_20578":48930,"_26960":48931,"_2870":48932},[],"/docs/pr-preview/pr-55/deployment/self-hosted/helm#upgrading-lamassu","Upgrading Lamassu",{"_3383":224,"_29651":212,"_5":30001,"_20578":48934,"_26960":48935,"_2870":48936},[],"/docs/pr-preview/pr-55/deployment/self-hosted/helm#production-decisions","Production decisions",{"_3383":225,"_29651":212,"_20578":48938,"_5":14121,"_26960":48896,"_2870":48939},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_3383":226,"_29651":212,"_20578":48941,"_5":14121,"_26960":48900,"_2870":48942},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_3383":227,"_29651":212,"_20578":48944,"_5":14121,"_26960":48900,"_2870":48945},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_3383":228,"_29651":212,"_20578":48947,"_5":14121,"_26960":48900,"_2870":48948},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_3383":229,"_29651":212,"_20578":48950,"_5":14121,"_26960":48900,"_2870":48951},[],"a reachable RabbitMQ broker and credentials",{"_3383":230,"_29651":212,"_20578":48953,"_5":14121,"_26960":48900,"_2870":48954},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_3383":231,"_29651":212,"_20578":48956,"_5":14121,"_26960":48900,"_2870":48957},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_3383":232,"_29651":212,"_20578":48959,"_5":14121,"_26960":48900,"_2870":48960},[],"cert-manager 1.14+ (only for the default `tls.type: certManager` mode); for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_3383":233,"_29651":212,"_20578":48962,"_5":14121,"_26960":48900,"_2870":48963},[],"a StorageClass and an external traffic design",{"_3383":234,"_29651":212,"_20578":48965,"_5":14121,"_26960":48900,"_2870":48966},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_3383":235,"_29651":212,"_20578":48968,"_5":14121,"_26960":48900,"_2870":48969},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_3383":236,"_29651":212,"_20578":48971,"_5":14121,"_26960":48900,"_2870":48972},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_3383":237,"_29651":212,"_20578":48974,"_5":14121,"_26960":48903,"_2870":48975},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_3383":238,"_29651":212,"_20578":48977,"_5":14121,"_26960":48903,"_2870":48978},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_3383":239,"_29651":212,"_20578":48980,"_5":14121,"_26960":48903,"_2870":48981},[],"Install cert-manager separately before Lamassu, but only for the default `tls.type: certManager` mode. In that mode the chart renders its self-signed Issuer and CA Certificate resources regardless of whether `tls.certManagerOptions.clusterIssuer` is set, so cert-manager stays a prerequisite. With `tls.type: external`, the chart renders no cert-manager resources and the Gateway terminates TLS with an existing Secret you provide instead.",{"_3383":240,"_29651":212,"_20578":48983,"_5":14121,"_26960":48907,"_2870":48984},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_3383":241,"_29651":212,"_20578":48986,"_5":14121,"_26960":48907,"_2870":48987},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_3383":242,"_29651":212,"_20578":48989,"_5":14121,"_26960":48907,"_2870":48990},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_3383":243,"_29651":212,"_20578":48992,"_5":14121,"_26960":48907,"_2870":48993},[],"If your values file still carries the legacy gateway JWT validation settings — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` or `auth.authorization.roles.admin` — remove them. The migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documents their removal with no compatibility aliases, and `values.schema.json` rejects the leftover blocks instead of silently ignoring them. The replacements are `services.authz.jwkUrl` and `services.authz.bootstrap`, already shown in the example above.",{"_3383":244,"_29651":212,"_20578":48995,"_5":14121,"_26960":48911,"_2870":48996},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it. The Secret must already exist before installing: in `external` mode the chart renders no cert-manager resources and never creates this Secret.",{"_3383":245,"_29651":212,"_20578":48998,"_5":14121,"_26960":48915,"_2870":48999},[],"`amqp.tls: true` selects AMQPS in every event-bus configuration block. The default port stays `5672` and does not change automatically when TLS is enabled, so set `amqp.port` to the broker's TLS listener, commonly `5671`.",{"_3383":246,"_29651":212,"_20578":49001,"_5":14121,"_26960":48915,"_2870":49002},[],"With no CA Secret configured, the event-bus clients use the system-trusted CAs. To trust a private CA, create a Secret in the release namespace containing the CA certificate in PEM format and set `amqp.ca.secretName` (and `amqp.ca.certificateKey` if the data key is not `ca.crt`).",{"_3383":247,"_29651":212,"_20578":49004,"_5":14121,"_26960":48915,"_2870":49005},[],"For brokers that require mutual TLS, create a Secret containing the client certificate and private key and set `amqp.client.secretName` (with `amqp.client.certificateKey` and `amqp.client.privateKeyKey` if the data keys are not `tls.crt` and `tls.key`).",{"_3383":248,"_29651":212,"_20578":49007,"_5":14121,"_26960":48915,"_2870":49008},[],"The chart mounts configured Secrets read-only into every AMQP-consuming workload: the CA certificate under `/etc/lamassu/amqp/ca` and the client certificate and key under `/etc/lamassu/amqp/client`. The mounted file names are always `ca.crt`, `tls.crt` and `tls.key` — the `certificateKey` and `privateKeyKey` values rename only the Secret data keys, never the on-disk paths. The client private key is mounted with restrictive permissions (`defaultMode: 0440`; the CA volume uses `0444`), which works because the chart adds `fsGroup` to the pod security context when `amqp.client.secretName` is set — it uses the container `runAsGroup` (default `65532`) when `fsGroup` is not already set.",{"_3383":249,"_29651":212,"_20578":49010,"_5":14121,"_26960":48915,"_2870":49011},[],"Both Secret options require `amqp.tls: true`: `values.schema.json` rejects a non-empty `secretName` when `tls` is false, rejects unknown keys and rejects data-key names outside `^[A-Za-z0-9._-]+$`. The referenced Secret must exist in the release namespace or the consuming pods fail to start.",{"_3383":250,"_29651":212,"_20578":49013,"_5":14121,"_26960":48915,"_2870":49014},[],"The AMQP client loads certificates at startup, so restart the consuming pods after updating either Secret. Changing any `amqp` value rolls the consuming pods through the `checksum/config` annotation, but a change to Secret content alone does not trigger a rollout.",{"_3383":251,"_29651":212,"_20578":49016,"_5":14121,"_26960":48915,"_2870":49017},[],"Per the migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: in 3.8.0 `amqp.tls` was not applied and event-bus clients used plaintext AMQP; from 4.0.0, `amqp.tls: true` switches them to AMQPS. Set `amqp.port` to the broker TLS listener before upgrading, or set `amqp.tls: false` to keep plaintext AMQP. `amqp.tls: false` sends the broker credentials and all event-bus traffic in cleartext.",{"_3383":252,"_29651":212,"_20578":49019,"_5":14121,"_26960":48919,"_2870":49020},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_3383":253,"_29651":212,"_20578":49022,"_5":14121,"_26960":48919,"_2870":49023},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_3383":254,"_29651":212,"_20578":49025,"_5":14121,"_26960":48919,"_2870":49026},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_3383":255,"_29651":212,"_20578":49028,"_5":14121,"_26960":48919,"_2870":49029},[],"See Access control for the principal and policy model.",{"_3383":256,"_29651":212,"_20578":49031,"_5":14121,"_26960":48923,"_2870":49032},[],"To install a local checkout instead:",{"_3383":257,"_29651":212,"_20578":49034,"_5":14121,"_26960":48927,"_2870":49035},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_3383":258,"_29651":212,"_20578":49037,"_5":14121,"_26960":48927,"_2870":49038},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_3383":259,"_29651":212,"_20578":49040,"_5":14121,"_26960":48931,"_2870":49041},[],"Version-specific upgrade steps live in `charts/lamassu/CHANGELOG/` in the Helm repository. The chart also ships an optional pre-upgrade Job that migrates existing CA private keys into the KMS engine configured for the release. It is off by default (`migrations.caToKms.enabled: false`) and is only needed when upgrading from a version prior to 3.7.0.",{"_3383":260,"_29651":212,"_20578":49043,"_5":14121,"_26960":48931,"_2870":49044},[],"While the flag is enabled, every `helm upgrade` creates the `<chart fullname>-ca-to-kms-migration` Job (`lamassu-ca-to-kms-migration` for release `lamassu`); a fresh install does not create it. Its hook weight is `-10`, so it runs before the other pre-upgrade hooks: the authorization bootstrap configuration (weight `-4`) and the database-migration Job (weight `-3`).",{"_3383":261,"_29651":212,"_20578":49046,"_5":14121,"_26960":48931,"_2870":49047},[],"The Job consumes the same KMS service configuration the chart renders into the KMS ConfigMap, including the engines from `services.kms.cryptoEngines`, and runs the migration tool defined in `migrations.caToKms.image`. It mounts that configuration read-only at `/etc/lamassuiot/config.yml` from the ConfigMap key `config`, so configure the destination engine in your values before the upgrade that performs the migration.",{"_3383":262,"_29651":212,"_20578":49049,"_5":14121,"_26960":48931,"_2870":49050},[],"The Job resolves its configuration through a projected volume with two optional sources: the release-scoped `<chart fullname>-kms-config` (`lamassu-kms-config` for release `lamassu`, `prod-lamassu-kms-config` for release `prod`) and the legacy unscoped `kms-config` created by chart versions before release-scoped naming. The legacy configuration remains authoritative while it is still present, and the release-scoped one is used once the legacy one is gone. Both sources are optional, so a missing ConfigMap never leaves the upgrade pod in `ContainerCreating`.",{"_3383":263,"_29651":212,"_20578":49052,"_5":14121,"_26960":48931,"_2870":49053},[],"Keep `migrations.caToKms.enabled: true` for the upgrade that performs the migration, then remove the flag from your values once the migration completes; it defaults to `false`.",{"_3383":264,"_29651":212,"_20578":49055,"_5":14121,"_26960":48935,"_2870":49056},[],"Before going live, review:",{"_3383":265,"_29651":212,"_20578":49058,"_5":14121,"_26960":48935,"_2870":49059},[],"backup and recovery for PostgreSQL and persistent volumes",{"_3383":266,"_29651":212,"_20578":49061,"_5":14121,"_26960":48935,"_2870":49062},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_3383":267,"_29651":212,"_20578":49064,"_5":14121,"_26960":48935,"_2870":49065},[],"shared VA storage before increasing VA replicas",{"_3383":268,"_29651":212,"_20578":49067,"_5":14121,"_26960":48935,"_2870":49068},[],"managed OIDC roles and removal of evaluation credentials",{"_3383":269,"_29651":212,"_20578":49070,"_5":14121,"_26960":48935,"_2870":49071},[],"a trusted TLS issuer or externally managed certificate",{"_3383":270,"_29651":212,"_20578":49073,"_5":14121,"_26960":48935,"_2870":49074},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_3383":271,"_29651":212,"_20578":49076,"_5":14121,"_26960":48935,"_2870":49077},[],"SMTP, observability and alert delivery",{"_3383":272,"_29651":212,"_20578":49079,"_5":14121,"_26960":48935,"_2870":49080},[],"the version upgrade guides and migration notes in `charts/lamassu/CHANGELOG/` before every upgrade, including the optional CA-to-KMS migration hook described above",{"_3383":273,"_29651":212,"_20578":49082,"_5":14121,"_26960":48935,"_2870":49083},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_3383":274,"_29651":274,"_5":14473,"_2870":49085,"_30004":49086,"_20578":49087,"_26960":274},"Expose the Gateway",[48280,48281,48387],[],{"_3383":275,"_29651":274,"_20578":49089,"_5":14121,"_26960":274,"_2870":49090},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_3383":276,"_29651":274,"_5":30001,"_20578":49092,"_26960":49093,"_2870":49094},[],"/docs/pr-preview/pr-55/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_3383":277,"_29651":274,"_5":30001,"_20578":49096,"_26960":49097,"_2870":49098},[],"/docs/pr-preview/pr-55/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_3383":278,"_29651":274,"_5":30001,"_20578":49100,"_26960":49101,"_2870":49102},[],"/docs/pr-preview/pr-55/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_3383":279,"_29651":274,"_5":30001,"_20578":49104,"_26960":49105,"_2870":49106},[],"/docs/pr-preview/pr-55/deployment/self-hosted/networking#k3s","K3s",{"_3383":280,"_29651":274,"_5":30001,"_20578":49108,"_26960":49109,"_2870":49110},[],"/docs/pr-preview/pr-55/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_3383":281,"_29651":274,"_5":30001,"_20578":49112,"_26960":49113,"_2870":49114},[],"/docs/pr-preview/pr-55/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_3383":282,"_29651":274,"_5":30001,"_20578":49116,"_26960":49117,"_2870":49118},[],"/docs/pr-preview/pr-55/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_3383":283,"_29651":274,"_5":30001,"_20578":49120,"_26960":49121,"_2870":49122},[],"/docs/pr-preview/pr-55/deployment/self-hosted/networking#decision-guide","Decision guide",{"_3383":284,"_29651":274,"_5":30001,"_20578":49124,"_26960":49125,"_2870":49126},[],"/docs/pr-preview/pr-55/deployment/self-hosted/networking#egress-proxy","Egress proxy",{"_3383":285,"_29651":274,"_5":30001,"_20578":49128,"_26960":49129,"_2870":49130},[],"/docs/pr-preview/pr-55/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_3383":286,"_29651":274,"_20578":49132,"_5":14121,"_26960":49093,"_2870":49133},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_3383":287,"_29651":274,"_20578":49135,"_5":14121,"_26960":49093,"_2870":49136},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_3383":288,"_29651":274,"_20578":49138,"_5":14121,"_26960":49097,"_2870":49139},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_3383":289,"_29651":274,"_20578":49141,"_5":14121,"_26960":49097,"_2870":49142},[],"Set it only when:",{"_3383":290,"_29651":274,"_20578":49144,"_5":14121,"_26960":49097,"_2870":49145},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_3383":291,"_29651":274,"_20578":49147,"_5":14121,"_26960":49097,"_2870":49148},[],"that address is allocated to this Gateway",{"_3383":292,"_29651":274,"_20578":49150,"_5":14121,"_26960":49097,"_2870":49151},[],"the surrounding network already routes traffic for it to the cluster",{"_3383":293,"_29651":274,"_20578":49153,"_5":14121,"_26960":49097,"_2870":49154},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_3383":294,"_29651":274,"_20578":49156,"_5":14121,"_26960":49097,"_2870":49157},[],"Keep these two settings separate:",{"_3383":295,"_29651":274,"_20578":49159,"_5":14121,"_26960":49097,"_2870":49160},[],"`gateway.addresses` requests an address for the Gateway.",{"_3383":296,"_29651":274,"_20578":49162,"_5":14121,"_26960":49097,"_2870":49163},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_3383":297,"_29651":274,"_20578":49165,"_5":14121,"_26960":49097,"_2870":49166},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_3383":298,"_29651":274,"_20578":49168,"_5":14121,"_26960":49101,"_2870":49169},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_3383":299,"_29651":274,"_20578":49171,"_5":14121,"_26960":49101,"_2870":49172},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_3383":300,"_29651":274,"_20578":49174,"_5":14121,"_26960":49105,"_2870":49175},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_3383":301,"_29651":274,"_20578":49177,"_5":14121,"_26960":49105,"_2870":49178},[],"For the recommended design:",{"_3383":302,"_29651":274,"_20578":49180,"_5":14121,"_26960":49105,"_2870":49181},[],"Use only one externally exposed Lamassu Gateway.",{"_3383":303,"_29651":274,"_20578":49183,"_5":14121,"_26960":49105,"_2870":49184},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_3383":304,"_29651":274,"_20578":49186,"_5":14121,"_26960":49105,"_2870":49187},[],"Allow those ports through the VM firewall and any upstream security group.",{"_3383":305,"_29651":274,"_20578":49189,"_5":14121,"_26960":49105,"_2870":49190},[],"Point DNS at the VM's reachable address.",{"_3383":306,"_29651":274,"_20578":49192,"_5":14121,"_26960":49105,"_2870":49193},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_3383":307,"_29651":274,"_20578":49195,"_5":14121,"_26960":49109,"_2870":49196},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_3383":308,"_29651":274,"_20578":49198,"_5":14121,"_26960":49113,"_2870":49199},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_3383":309,"_29651":274,"_20578":49201,"_5":14121,"_26960":49113,"_2870":49202},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_3383":310,"_29651":274,"_20578":49204,"_5":14121,"_26960":49117,"_2870":49205},[],"First decide whether you need three independent data planes or only three hostnames.",{"_3383":311,"_29651":274,"_20578":49207,"_5":14121,"_26960":49117,"_2870":49208},[],"Requirement",{"_3383":312,"_29651":274,"_20578":49210,"_5":14121,"_26960":49117,"_2870":49211},[],"Recommended design",{"_3383":313,"_29651":274,"_20578":49213,"_5":14121,"_26960":49117,"_2870":49214},[],"Consequence",{"_3383":314,"_29651":274,"_20578":49216,"_5":14121,"_26960":49117,"_2870":49217},[],"Several Lamassu URLs or services",{"_3383":315,"_29651":274,"_20578":49219,"_5":14121,"_26960":49117,"_2870":49220},[],"One Gateway with multiple routes",{"_3383":316,"_29651":274,"_20578":49222,"_5":14121,"_26960":49117,"_2870":49223},[],"One IP and one proxy fleet; this is the chart default",{"_3383":317,"_29651":274,"_20578":49225,"_5":14121,"_26960":49117,"_2870":49226},[],"Independent Gateways and separate external IPs",{"_3383":318,"_29651":274,"_20578":49228,"_5":14121,"_26960":49117,"_2870":49229},[],"One VIP per Gateway",{"_3383":319,"_29651":274,"_20578":49231,"_5":14121,"_26960":49117,"_2870":49232},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_3383":320,"_29651":274,"_20578":49234,"_5":14121,"_26960":49117,"_2870":49235},[],"Independent Gateways on one node and one IP",{"_3383":321,"_29651":274,"_20578":49237,"_5":14121,"_26960":49117,"_2870":49238},[],"Use different external ports",{"_3383":322,"_29651":274,"_20578":49240,"_5":14121,"_26960":49117,"_2870":49241},[],"Clients must include non-standard ports",{"_3383":323,"_29651":274,"_20578":49243,"_5":14121,"_26960":49117,"_2870":49244},[],"Separate TLS/mTLS termination behind one IP",{"_3383":324,"_29651":274,"_20578":49246,"_5":14121,"_26960":49117,"_2870":49247},[],"Front-door SNI routing to internal Gateways",{"_3383":325,"_29651":274,"_20578":49249,"_5":14121,"_26960":49117,"_2870":49250},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_3383":326,"_29651":274,"_20578":49252,"_5":14121,"_26960":49117,"_2870":49253},[],"Separate Gateway resources but shared proxy infrastructure",{"_3383":327,"_29651":274,"_20578":49255,"_5":14121,"_26960":49117,"_2870":49256},[],"Envoy merged-Gateway mode",{"_3383":328,"_29651":274,"_20578":49258,"_5":14121,"_26960":49117,"_2870":49259},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_3383":329,"_29651":274,"_20578":49261,"_5":14121,"_26960":49117,"_2870":49262},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_3383":330,"_29651":274,"_20578":49264,"_5":14121,"_26960":49117,"_2870":49265},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_3383":331,"_29651":274,"_20578":49267,"_5":14121,"_26960":49117,"_2870":49268},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_3383":332,"_29651":274,"_20578":49270,"_5":14121,"_26960":49117,"_2870":49271},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_3383":333,"_29651":274,"_20578":49273,"_5":14121,"_26960":49121,"_2870":49274},[],"If one Gateway can own TLS and routing, use the chart default.",{"_3383":334,"_29651":274,"_20578":49276,"_5":14121,"_26960":49121,"_2870":49277},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_3383":335,"_29651":274,"_20578":49279,"_5":14121,"_26960":49121,"_2870":49280},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_3383":336,"_29651":274,"_20578":49282,"_5":14121,"_26960":49121,"_2870":49283},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_3383":337,"_29651":274,"_20578":49285,"_5":14121,"_26960":49121,"_2870":49286},[],"If none of those are possible, use different external ports or change the external network design.",{"_3383":338,"_29651":274,"_20578":49288,"_5":14121,"_26960":49125,"_2870":49289},[],"Internal Lamassu clients — the Vault engine connection, service-to-service calls and webhook deliveries — honor the `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables. The exception is the authorization-engine connector: it uses its own transport and does not consult these proxy variables. If your deployment routes egress through a proxy, list in-cluster service names in `NO_PROXY` (for example `.svc,.cluster.local`) so internal traffic stays inside the cluster. Loopback traffic is never sent through a proxy.",{"_3383":339,"_29651":274,"_20578":49291,"_5":14121,"_26960":49125,"_2870":49292},[],"The default transport of these clients bounds the dial timeout (30 seconds), the TLS handshake (10 seconds) and idle connection reuse (90 seconds) so an unreachable dependency fails fast instead of hanging; these values are Go transport defaults, not Lamassu settings. HTTP/2 is negotiated when the peer supports it. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call.",{"_3383":340,"_29651":274,"_20578":49294,"_5":14121,"_26960":49129,"_2870":49295},[],"Check, in order:",{"_3383":341,"_29651":274,"_20578":49297,"_5":14121,"_26960":49129,"_2870":49298},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_3383":342,"_29651":274,"_20578":49300,"_5":14121,"_26960":49129,"_2870":49301},[],"Its status contains the expected address.",{"_3383":343,"_29651":274,"_20578":49303,"_5":14121,"_26960":49129,"_2870":49304},[],"The generated `LoadBalancer` Service has a usable external address.",{"_3383":344,"_29651":274,"_20578":49306,"_5":14121,"_26960":49129,"_2870":49307},[],"Port 443 reaches that address from the client network.",{"_3383":345,"_29651":274,"_20578":49309,"_5":14121,"_26960":49129,"_2870":49310},[],"DNS resolves to the externally reachable endpoint.",{"_3383":346,"_29651":274,"_20578":49312,"_5":14121,"_26960":49129,"_2870":49313},[],"The certificate contains the DNS name or IP used by the client.",{"_3383":347,"_29651":274,"_20578":49315,"_5":14121,"_26960":49129,"_2870":49316},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_3383":348,"_29651":348,"_5":14473,"_2870":48387,"_30004":49318,"_20578":49319,"_26960":348},[48280,48281,48387],[],{"_3383":349,"_29651":348,"_20578":49321,"_5":14121,"_26960":348,"_2870":49322},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_3383":350,"_29651":348,"_5":30001,"_20578":49324,"_26960":49325,"_2870":49326},[],"/docs/pr-preview/pr-55/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_3383":351,"_29651":348,"_5":30001,"_20578":49328,"_26960":49329,"_2870":49330},[],"/docs/pr-preview/pr-55/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_3383":352,"_29651":348,"_5":30001,"_20578":49332,"_26960":49333,"_2870":49334},[],"/docs/pr-preview/pr-55/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_3383":353,"_29651":348,"_5":30001,"_20578":49336,"_26960":49337,"_2870":49338},[],"/docs/pr-preview/pr-55/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_3383":354,"_29651":348,"_5":30001,"_20578":49340,"_26960":49341,"_2870":49342},[],"/docs/pr-preview/pr-55/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_3383":355,"_29651":348,"_5":30001,"_20578":49344,"_26960":49345,"_2870":49346},[],"/docs/pr-preview/pr-55/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_3383":356,"_29651":348,"_20578":49348,"_5":14121,"_26960":49325,"_2870":49349},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_3383":357,"_29651":348,"_20578":49351,"_5":14121,"_26960":49329,"_2870":49352},[],"Workflow",{"_3383":358,"_29651":348,"_20578":49354,"_5":14121,"_26960":49329,"_2870":49355},[],"Use it for",{"_3383":359,"_29651":348,"_20578":49357,"_5":14121,"_26960":49329,"_2870":49358},[],"What it installs",{"_3383":360,"_29651":348,"_20578":49360,"_5":14121,"_26960":49329,"_2870":49361},[],"Helm",{"_3383":361,"_29651":348,"_20578":49363,"_5":14121,"_26960":49329,"_2870":49364},[],"Production and controlled environments",{"_3383":362,"_29651":348,"_20578":49366,"_5":14121,"_26960":49329,"_2870":49367},[],"Lamassu services and Gateway API resources",{"_3383":363,"_29651":348,"_20578":49369,"_5":14121,"_26960":49329,"_2870":48524},[],{"_3383":364,"_29651":348,"_20578":49371,"_5":14121,"_26960":49329,"_2870":49372},[],"Evaluation, demos, CI and small lab clusters",{"_3383":365,"_29651":348,"_20578":49374,"_5":14121,"_26960":49329,"_2870":49375},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_3383":366,"_29651":348,"_20578":49377,"_5":14121,"_26960":49333,"_2870":49378},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_3383":367,"_29651":348,"_20578":49380,"_5":14121,"_26960":49333,"_2870":49381},[],"Area",{"_3383":368,"_29651":348,"_20578":49383,"_5":14121,"_26960":49333,"_2870":49384},[],"The Lamassu chart provides",{"_3383":369,"_29651":348,"_20578":49386,"_5":14121,"_26960":49333,"_2870":49387},[],"You provide",{"_3383":370,"_29651":348,"_20578":49389,"_5":14121,"_26960":49333,"_2870":49390},[],"Lamassu applications",{"_3383":371,"_29651":348,"_20578":49392,"_5":14121,"_26960":49333,"_2870":49393},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_3383":372,"_29651":348,"_20578":49395,"_5":14121,"_26960":49333,"_2870":49396},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_3383":373,"_29651":348,"_20578":49398,"_5":14121,"_26960":49333,"_2870":49399},[],"PostgreSQL data",{"_3383":374,"_29651":348,"_20578":49401,"_5":14121,"_26960":49333,"_2870":49402},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_3383":375,"_29651":348,"_20578":49404,"_5":14121,"_26960":49333,"_2870":49405},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_3383":376,"_29651":348,"_20578":49407,"_5":14121,"_26960":49333,"_2870":49408},[],"Messaging",{"_3383":377,"_29651":348,"_20578":49410,"_5":14121,"_26960":49333,"_2870":49411},[],"RabbitMQ connection configuration for the Lamassu services; the connection can use AMQPS, with an optional private CA and an optional client certificate, both set through chart values",{"_3383":378,"_29651":348,"_20578":49413,"_5":14121,"_26960":49333,"_2870":49414},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_3383":379,"_29651":348,"_20578":49416,"_5":14121,"_26960":49333,"_2870":49417},[],"Identity",{"_3383":380,"_29651":348,"_20578":49419,"_5":14121,"_26960":49333,"_2870":49420},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_3383":381,"_29651":348,"_20578":49422,"_5":14121,"_26960":49333,"_2870":49423},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_3383":382,"_29651":348,"_20578":49425,"_5":14121,"_26960":49333,"_2870":49426},[],"External routing",{"_3383":383,"_29651":348,"_20578":49428,"_5":14121,"_26960":49333,"_2870":49429},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_3383":384,"_29651":348,"_20578":49431,"_5":14121,"_26960":49333,"_2870":49432},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_3383":385,"_29651":348,"_20578":49434,"_5":14121,"_26960":49333,"_2870":49435},[],"TLS",{"_3383":386,"_29651":348,"_20578":49437,"_5":14121,"_26960":49333,"_2870":49438},[],"In the default `tls.type: certManager` mode, cert-manager `Issuer` and CA `Certificate` resources and a chart-managed downstream `Certificate`; in the `tls.type: external` mode, a reference to your TLS Secret",{"_3383":387,"_29651":348,"_20578":49440,"_5":14121,"_26960":49333,"_2870":49441},[],"cert-manager only for the default `tls.type: certManager` mode; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_3383":388,"_29651":348,"_20578":49443,"_5":14121,"_26960":49333,"_2870":49444},[],"Persistent application data",{"_3383":389,"_29651":348,"_20578":49446,"_5":14121,"_26960":49333,"_2870":49447},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_3383":390,"_29651":348,"_20578":49449,"_5":14121,"_26960":49333,"_2870":49450},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_3383":391,"_29651":348,"_20578":49452,"_5":14121,"_26960":49333,"_2870":49453},[],"Optional integrations",{"_3383":392,"_29651":348,"_20578":49455,"_5":14121,"_26960":49333,"_2870":49456},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_3383":393,"_29651":348,"_20578":49458,"_5":14121,"_26960":49333,"_2870":49459},[],"The observability backends, cloud credentials and production HSM or external key service",{"_3383":394,"_29651":348,"_20578":49461,"_5":14121,"_26960":49333,"_2870":49462},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_3383":395,"_29651":348,"_20578":49464,"_5":14121,"_26960":49333,"_2870":49465},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_3383":396,"_29651":348,"_20578":49467,"_5":14121,"_26960":49337,"_2870":49468},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_3383":397,"_29651":348,"_20578":49470,"_5":14121,"_26960":49337,"_2870":49471},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_3383":398,"_29651":348,"_20578":49473,"_5":14121,"_26960":49341,"_2870":49474},[],"Kubernetes 1.24 or newer",{"_3383":399,"_29651":348,"_20578":49476,"_5":14121,"_26960":49341,"_2870":49477},[],"Helm 3.2 or newer",{"_3383":400,"_29651":348,"_20578":49479,"_5":14121,"_26960":49341,"_2870":49480},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_3383":401,"_29651":348,"_20578":49482,"_5":14121,"_26960":49341,"_2870":49483},[],"cert-manager 1.14 or newer; required only for the default `tls.type: certManager` TLS mode, not for `tls.type: external`",{"_3383":402,"_29651":348,"_20578":49485,"_5":14121,"_26960":49341,"_2870":49486},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_3383":403,"_29651":348,"_20578":49488,"_5":14121,"_26960":49341,"_2870":49489},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_3383":404,"_29651":348,"_20578":49491,"_5":14121,"_26960":49341,"_2870":49492},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_3383":405,"_29651":348,"_20578":49494,"_5":14121,"_26960":49345,"_2870":49495},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3383":406,"_29651":348,"_20578":49497,"_5":14121,"_26960":49345,"_2870":49498},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3383":407,"_29651":348,"_20578":49500,"_5":14121,"_26960":49345,"_2870":49501},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3383":408,"_29651":348,"_20578":49503,"_5":14121,"_26960":49345,"_2870":49504},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3383":409,"_29651":409,"_5":14473,"_2870":49506,"_30004":49507,"_20578":49509,"_26960":409},"Deployment troubleshooting",[48280,48281,49508],"Operations",[],{"_3383":410,"_29651":409,"_20578":49511,"_5":14121,"_26960":409,"_2870":49512},[],"Diagnose access, service health and infrastructure dependencies.",{"_3383":411,"_29651":409,"_5":30001,"_20578":49514,"_26960":49515,"_2870":49516},[],"/docs/pr-preview/pr-55/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_3383":412,"_29651":409,"_5":30001,"_20578":49518,"_26960":49519,"_2870":49520},[],"/docs/pr-preview/pr-55/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_3383":413,"_29651":409,"_5":30001,"_20578":49522,"_26960":49523,"_2870":49524},[],"/docs/pr-preview/pr-55/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_3383":414,"_29651":409,"_5":30001,"_20578":49526,"_26960":49527,"_2870":49528},[],"/docs/pr-preview/pr-55/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_3383":415,"_29651":409,"_5":30001,"_20578":49530,"_26960":49531,"_2870":49532},[],"/docs/pr-preview/pr-55/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_3383":416,"_29651":409,"_5":30001,"_20578":49534,"_26960":49535,"_2870":49536},[],"/docs/pr-preview/pr-55/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_3383":417,"_29651":409,"_5":30001,"_20578":49538,"_26960":49539,"_2870":49540},[],"/docs/pr-preview/pr-55/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_3383":418,"_29651":409,"_5":30001,"_20578":49542,"_26960":49543,"_2870":49544},[],"/docs/pr-preview/pr-55/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_3383":419,"_29651":409,"_5":30001,"_20578":49546,"_26960":49547,"_2870":49548},[],"/docs/pr-preview/pr-55/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_3383":420,"_29651":409,"_5":30001,"_20578":49550,"_26960":49551,"_2870":49552},[],"/docs/pr-preview/pr-55/deployment/troubleshooting#api-500-errors","API 500 errors",{"_3383":421,"_29651":409,"_5":30001,"_20578":49554,"_26960":49555,"_2870":49556},[],"/docs/pr-preview/pr-55/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_3383":422,"_29651":409,"_5":30001,"_20578":49558,"_26960":49559,"_2870":49560},[],"/docs/pr-preview/pr-55/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_3383":423,"_29651":409,"_5":30001,"_20578":49562,"_26960":49563,"_2870":49564},[],"/docs/pr-preview/pr-55/deployment/troubleshooting#observability","Observability",{"_3383":424,"_29651":409,"_20578":49566,"_5":14121,"_26960":409,"_2870":49567},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_3383":425,"_29651":409,"_20578":49569,"_5":14121,"_26960":49519,"_2870":49570},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_3383":426,"_29651":409,"_20578":49572,"_5":14121,"_26960":49523,"_2870":49573},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_3383":427,"_29651":409,"_20578":49575,"_5":14121,"_26960":49527,"_2870":49576},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_3383":428,"_29651":409,"_20578":49578,"_5":14121,"_26960":49531,"_2870":49579},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_3383":429,"_29651":409,"_20578":49581,"_5":14121,"_26960":49535,"_2870":49582},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_3383":430,"_29651":409,"_20578":49584,"_5":14121,"_26960":49539,"_2870":49585},[],"Replace the placeholders with your real release, namespace and deployment.",{"_3383":431,"_29651":409,"_20578":49587,"_5":14121,"_26960":49539,"_2870":49588},[],"Also run the chart's connectivity test:",{"_3383":432,"_29651":409,"_20578":49590,"_5":14121,"_26960":49539,"_2870":49591},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_3383":433,"_29651":409,"_20578":49593,"_5":14121,"_26960":49539,"_2870":49594},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_3383":434,"_29651":409,"_20578":49596,"_5":14121,"_26960":49543,"_2870":49597},[],"If you receive a 401:",{"_3383":435,"_29651":409,"_20578":49599,"_5":14121,"_26960":49543,"_2870":49600},[],"check that the UI's OIDC authority is reachable from the browser;",{"_3383":436,"_29651":409,"_20578":49602,"_5":14121,"_26960":49543,"_2870":49603},[],"verify issuer, audience and expiration of the token;",{"_3383":437,"_29651":409,"_20578":49605,"_5":14121,"_26960":49543,"_2870":49606},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_3383":438,"_29651":409,"_20578":49608,"_5":14121,"_26960":49543,"_2870":49609},[],"check that the provider's public and internal routes point to the same realm.",{"_3383":439,"_29651":409,"_20578":49611,"_5":14121,"_26960":49543,"_2870":49612},[],"If login succeeds but the APIs return 403:",{"_3383":440,"_29651":409,"_20578":49614,"_5":14121,"_26960":49543,"_2870":49615},[],"inspect the token's real claims;",{"_3383":441,"_29651":409,"_20578":49617,"_5":14121,"_26960":49543,"_2870":49618},[],"confirm they match an active principal;",{"_3383":442,"_29651":409,"_20578":49620,"_5":14121,"_26960":49543,"_2870":49621},[],"review the policies granted to that principal;",{"_3383":443,"_29651":409,"_20578":49623,"_5":14121,"_26960":49543,"_2870":49624},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_3383":444,"_29651":409,"_20578":49626,"_5":14121,"_26960":49543,"_2870":49627},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_3383":445,"_29651":409,"_20578":49629,"_5":14121,"_26960":49547,"_2870":49630},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_3383":446,"_29651":409,"_20578":49632,"_5":14121,"_26960":49547,"_2870":49633},[],"Locate the authz pod and Service.",{"_3383":447,"_29651":409,"_20578":49635,"_5":14121,"_26960":49547,"_2870":49636},[],"Check /health, logs and its database connection.",{"_3383":448,"_29651":409,"_20578":49638,"_5":14121,"_26960":49547,"_2870":49639},[],"Verify the DNS and port configured in externalAuthorization.",{"_3383":449,"_29651":409,"_20578":49641,"_5":14121,"_26960":49547,"_2870":49642},[],"Check the check route is /v1/ext\\_authz/check.",{"_3383":450,"_29651":409,"_20578":49644,"_5":14121,"_26960":49547,"_2870":49645},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_3383":451,"_29651":409,"_20578":49647,"_5":14121,"_26960":49551,"_2870":49648},[],"A 500 indicates an internal failure, such as an unavailable database. The `{\"err\": ...}` body currently includes the text of the internal error, which can contain schema, table and constraint names and, on connection failures, the database host and user (not the password). Find the cause in the service log using the request time, and do not forward the body to third parties or show it to end users. This is a known information-disclosure defect: generic messages are planned for 500 responses, keeping the detail only in the service log (tracked in lamassuiot#814). The authorization connector also returns the internal error, in the `details.error` field. Some request errors, such as a key size the engine does not support, are also returned as 500.",{"_3383":452,"_29651":409,"_20578":49650,"_5":14121,"_26960":49555,"_2870":49651},[],"Review kubectl describe pod first. Common causes are:",{"_3383":453,"_29651":409,"_20578":49653,"_5":14121,"_26960":49555,"_2870":49654},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_3383":454,"_29651":409,"_20578":49656,"_5":14121,"_26960":49555,"_2870":49657},[],"a missing AMQP CA or client certificate Secret referenced by `amqp.ca.secretName` or `amqp.client.secretName`;",{"_3383":455,"_29651":409,"_20578":49659,"_5":14121,"_26960":49555,"_2870":49660},[],"unbound persistent volume;",{"_3383":456,"_29651":409,"_20578":49662,"_5":14121,"_26960":49555,"_2870":49663},[],"inaccessible image or incorrect pull policy;",{"_3383":457,"_29651":409,"_20578":49665,"_5":14121,"_26960":49555,"_2870":49666},[],"invalid cryptographic engine configuration;",{"_3383":458,"_29651":409,"_20578":49668,"_5":14121,"_26960":49555,"_2870":49669},[],"CPU or memory limits set too low;",{"_3383":459,"_29651":409,"_20578":49671,"_5":14121,"_26960":49555,"_2870":49672},[],"an incomplete prior migration.",{"_3383":460,"_29651":409,"_20578":49674,"_5":14121,"_26960":49555,"_2870":49675},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_3383":461,"_29651":409,"_20578":49677,"_5":14121,"_26960":49555,"_2870":49678},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_3383":462,"_29651":409,"_20578":49680,"_5":14121,"_26960":49555,"_2870":49681},[],"Internal calls now fail fast instead of hanging for the clients covered by Egress proxy: connection attempts time out after 30 seconds and TLS handshakes after 10 seconds. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call. If an egress proxy handles the cluster's outbound traffic, check the pod's `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables and list in-cluster service names in `NO_PROXY`.",{"_3383":463,"_29651":409,"_20578":49683,"_5":14121,"_26960":49559,"_2870":49684},[],"Domain and audit events depend on the bus publisher:",{"_3383":464,"_29651":409,"_20578":49686,"_5":14121,"_26960":49559,"_2870":49687},[],"verify it is enabled in the emitting service;",{"_3383":465,"_29651":409,"_20578":49689,"_5":14121,"_26960":49559,"_2870":49690},[],"check AMQP connectivity and credentials;",{"_3383":466,"_29651":409,"_20578":49692,"_5":14121,"_26960":49559,"_2870":49693},[],"review exchange, routing key, queues and consumers;",{"_3383":467,"_29651":409,"_20578":49695,"_5":14121,"_26960":49559,"_2870":49696},[],"inspect dead-letter queues;",{"_3383":468,"_29651":409,"_20578":49698,"_5":14121,"_26960":49559,"_2870":49699},[],"alert on orphan durable queues and backlog growth.",{"_3383":469,"_29651":409,"_20578":49701,"_5":14121,"_26960":49559,"_2870":49702},[],"If `amqp.tls` is enabled, verify the TLS side as well:",{"_3383":470,"_29651":409,"_20578":49704,"_5":14121,"_26960":49559,"_2870":49705},[],"confirm the broker listener speaks AMQPS on the configured port — the default port stays `5672` and does not follow TLS automatically;",{"_3383":471,"_29651":409,"_20578":49707,"_5":14121,"_26960":49559,"_2870":49708},[],"if you set `amqp.ca.secretName`, confirm the Secret exists in the release namespace and its data key matches `amqp.ca.certificateKey` (default `ca.crt`); if `amqp.ca.secretName` is not set, the clients trust the system CAs;",{"_3383":472,"_29651":409,"_20578":49710,"_5":14121,"_26960":49559,"_2870":49711},[],"remember that a missing referenced Secret prevents the consuming pods from starting;",{"_3383":473,"_29651":409,"_20578":49713,"_5":14121,"_26960":49559,"_2870":49714},[],"after updating the CA or client certificate Secret, restart the consuming pods: the AMQP client loads certificates at startup.",{"_3383":474,"_29651":409,"_20578":49716,"_5":14121,"_26960":49559,"_2870":49717},[],"See AMQP TLS (AMQPS) for the full configuration.",{"_3383":475,"_29651":409,"_20578":49719,"_5":14121,"_26960":49559,"_2870":49720},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_3383":476,"_29651":409,"_20578":49722,"_5":14121,"_26960":49563,"_2870":49723},[],"The chart can enable OpenTelemetry instrumentation for the services that support it, including authz; it does not configure OpenTelemetry for AWS Connector, wfx or the UI. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, service and dependency.",{"_3383":477,"_29651":409,"_20578":49725,"_5":14121,"_26960":49563,"_2870":49726},[],"Before closing an incident, record:",{"_3383":478,"_29651":409,"_20578":49728,"_5":14121,"_26960":49563,"_2870":49729},[],"the confirmed cause;",{"_3383":479,"_29651":409,"_20578":49731,"_5":14121,"_26960":49563,"_2870":49732},[],"the time scope and affected resources;",{"_3383":480,"_29651":409,"_20578":49734,"_5":14121,"_26960":49563,"_2870":49735},[],"the commands or queries used;",{"_3383":481,"_29651":409,"_20578":49737,"_5":14121,"_26960":49563,"_2870":49738},[],"the applied change and how to revert it;",{"_3383":482,"_29651":409,"_20578":49740,"_5":14121,"_26960":49563,"_2870":49741},[],"validation from a consumer;",{"_3383":483,"_29651":409,"_20578":49743,"_5":14121,"_26960":49563,"_2870":49744},[],"the preventive action and its owner.",{"_3383":484,"_29651":484,"_5":14473,"_2870":49746,"_30004":49747,"_20578":49750,"_26960":484},"Access control",[48280,49748,49749],"Platform","Administration",[],{"_3383":485,"_29651":484,"_20578":49752,"_5":14121,"_26960":484,"_2870":49753},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_3383":486,"_29651":484,"_5":30001,"_20578":49755,"_26960":49756,"_2870":49757},[],"/docs/pr-preview/pr-55/platform/administration/access-control#essential-concepts","Essential concepts",{"_3383":487,"_29651":484,"_5":30001,"_20578":49759,"_26960":49760,"_2870":49761},[],"/docs/pr-preview/pr-55/platform/administration/access-control#two-decision-systems","Two decision systems",{"_3383":488,"_29651":484,"_5":30001,"_20578":49763,"_26960":49764,"_2870":49765},[],"/docs/pr-preview/pr-55/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_3383":489,"_29651":484,"_5":30001,"_20578":49767,"_26960":49768,"_2870":49769},[],"/docs/pr-preview/pr-55/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_3383":490,"_29651":484,"_5":30001,"_20578":49771,"_26960":49772,"_2870":49773},[],"/docs/pr-preview/pr-55/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_3383":491,"_29651":484,"_5":30001,"_20578":49775,"_26960":49776,"_2870":49777},[],"/docs/pr-preview/pr-55/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_3383":492,"_29651":484,"_5":30001,"_20578":49779,"_26960":49780,"_2870":49781},[],"/docs/pr-preview/pr-55/platform/administration/access-control#oidc-principals","OIDC principals",{"_3383":493,"_29651":484,"_5":30001,"_20578":49783,"_26960":49784,"_2870":49785},[],"/docs/pr-preview/pr-55/platform/administration/access-control#x509-principals","X.509 principals",{"_3383":494,"_29651":484,"_5":30001,"_20578":49787,"_26960":49788,"_2870":49789},[],"/docs/pr-preview/pr-55/platform/administration/access-control#when-several-principals-match","When several principals match",{"_3383":495,"_29651":484,"_5":30001,"_20578":49791,"_26960":49792,"_2870":49793},[],"/docs/pr-preview/pr-55/platform/administration/access-control#how-policies-express-access","How policies express access",{"_3383":496,"_29651":484,"_5":30001,"_20578":49795,"_26960":49796,"_2870":49797},[],"/docs/pr-preview/pr-55/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_3383":497,"_29651":484,"_5":30001,"_20578":49799,"_26960":49800,"_2870":49801},[],"/docs/pr-preview/pr-55/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_3383":498,"_29651":484,"_5":30001,"_20578":49803,"_26960":49804,"_2870":49805},[],"/docs/pr-preview/pr-55/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_3383":499,"_29651":484,"_5":30001,"_20578":49807,"_26960":49808,"_2870":49809},[],"/docs/pr-preview/pr-55/platform/administration/access-control#http-rules","HTTP rules",{"_3383":500,"_29651":484,"_5":30001,"_20578":49811,"_26960":49812,"_2870":49813},[],"/docs/pr-preview/pr-55/platform/administration/access-control#included-policies","Included policies",{"_3383":501,"_29651":484,"_5":30001,"_20578":49815,"_26960":49816,"_2870":48920},[],"/docs/pr-preview/pr-55/platform/administration/access-control#provision-the-first-administrator",{"_3383":502,"_29651":484,"_5":30001,"_20578":49818,"_26960":49819,"_2870":49820},[],"/docs/pr-preview/pr-55/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_3383":503,"_29651":484,"_5":30001,"_20578":49822,"_26960":49823,"_2870":49824},[],"/docs/pr-preview/pr-55/platform/administration/access-control#configure-token-validation","Configure token validation",{"_3383":504,"_29651":484,"_5":30001,"_20578":49826,"_26960":49827,"_2870":49828},[],"/docs/pr-preview/pr-55/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_3383":505,"_29651":484,"_5":30001,"_20578":49830,"_26960":49831,"_2870":49832},[],"/docs/pr-preview/pr-55/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_3383":506,"_29651":484,"_5":30001,"_20578":49834,"_26960":49835,"_2870":49836},[],"/docs/pr-preview/pr-55/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_3383":507,"_29651":484,"_5":30001,"_20578":49838,"_26960":49839,"_2870":49840},[],"/docs/pr-preview/pr-55/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_3383":508,"_29651":484,"_5":30001,"_20578":49842,"_26960":49843,"_2870":49844},[],"/docs/pr-preview/pr-55/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_3383":509,"_29651":484,"_5":30001,"_20578":49846,"_26960":49847,"_2870":49848},[],"/docs/pr-preview/pr-55/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_3383":510,"_29651":484,"_5":30001,"_20578":49850,"_26960":49851,"_2870":49852},[],"/docs/pr-preview/pr-55/platform/administration/access-control#operational-checklist","Operational checklist",{"_3383":511,"_29651":484,"_5":30001,"_20578":49854,"_26960":49855,"_2870":49856},[],"/docs/pr-preview/pr-55/platform/administration/access-control#diagnostics","Diagnostics",{"_3383":512,"_29651":484,"_5":30001,"_20578":49858,"_26960":49859,"_2870":49860},[],"/docs/pr-preview/pr-55/platform/administration/access-control#the-response-is-401","The response is 401",{"_3383":513,"_29651":484,"_5":30001,"_20578":49862,"_26960":49863,"_2870":49864},[],"/docs/pr-preview/pr-55/platform/administration/access-control#the-response-is-403","The response is 403",{"_3383":514,"_29651":484,"_5":30001,"_20578":49866,"_26960":49867,"_2870":49868},[],"/docs/pr-preview/pr-55/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_3383":515,"_29651":484,"_5":30001,"_20578":49870,"_26960":49871,"_2870":49872},[],"/docs/pr-preview/pr-55/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_3383":516,"_29651":484,"_5":30001,"_20578":49874,"_26960":49875,"_2870":49876},[],"/docs/pr-preview/pr-55/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_3383":517,"_29651":484,"_20578":49878,"_5":14121,"_26960":484,"_2870":49879},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_3383":518,"_29651":484,"_20578":49881,"_5":14121,"_26960":484,"_2870":49882},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_3383":519,"_29651":484,"_20578":49884,"_5":14121,"_26960":484,"_2870":49885},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_3383":520,"_29651":484,"_20578":49887,"_5":14121,"_26960":49756,"_2870":49888},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_3383":521,"_29651":484,"_20578":49890,"_5":14121,"_26960":49756,"_2870":49891},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_3383":522,"_29651":484,"_20578":49893,"_5":14121,"_26960":49756,"_2870":49894},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_3383":523,"_29651":484,"_20578":49896,"_5":14121,"_26960":49756,"_2870":49897},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_3383":524,"_29651":484,"_20578":49899,"_5":14121,"_26960":49756,"_2870":49900},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_3383":525,"_29651":484,"_20578":49902,"_5":14121,"_26960":49756,"_2870":49903},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_3383":526,"_29651":484,"_20578":49905,"_5":14121,"_26960":49760,"_2870":49906},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_3383":527,"_29651":484,"_20578":49908,"_5":14121,"_26960":49760,"_2870":49909},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_3383":528,"_29651":484,"_20578":49911,"_5":14121,"_26960":49764,"_2870":49912},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_3383":529,"_29651":484,"_20578":49914,"_5":14121,"_26960":49764,"_2870":49915},[],"The decision is made **before forwarding the request to the service**:",{"_3383":530,"_29651":484,"_20578":49917,"_5":14121,"_26960":49764,"_2870":49918},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_3383":531,"_29651":484,"_20578":49920,"_5":14121,"_26960":49764,"_2870":49921},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_3383":532,"_29651":484,"_20578":49923,"_5":14121,"_26960":49764,"_2870":49924},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_3383":533,"_29651":484,"_20578":49926,"_5":14121,"_26960":49764,"_2870":49927},[],"It separately loads the policies granted to each principal.",{"_3383":534,"_29651":484,"_20578":49929,"_5":14121,"_26960":49764,"_2870":49930},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_3383":535,"_29651":484,"_20578":49932,"_5":14121,"_26960":49764,"_2870":49933},[],"`authz` looks for an HTTP rule granting that action.",{"_3383":536,"_29651":484,"_20578":49935,"_5":14121,"_26960":49764,"_2870":49936},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_3383":537,"_29651":484,"_20578":49938,"_5":14121,"_26960":49764,"_2870":49939},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_3383":538,"_29651":484,"_20578":49941,"_5":14121,"_26960":49764,"_2870":49942},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context.",{"_3383":539,"_29651":484,"_20578":49944,"_5":14121,"_26960":49764,"_2870":49945},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_3383":540,"_29651":484,"_20578":49947,"_5":14121,"_26960":49768,"_2870":49948},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_3383":541,"_29651":484,"_20578":49950,"_5":14121,"_26960":49768,"_2870":49951},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_3383":542,"_29651":484,"_20578":49953,"_5":14121,"_26960":49768,"_2870":49954},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_3383":543,"_29651":484,"_20578":49956,"_5":14121,"_26960":49768,"_2870":49957},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_3383":544,"_29651":484,"_20578":49959,"_5":14121,"_26960":49768,"_2870":49960},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_3383":545,"_29651":484,"_20578":49962,"_5":14121,"_26960":49768,"_2870":49963},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_3383":546,"_29651":484,"_20578":49965,"_5":14121,"_26960":49768,"_2870":49966},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_3383":547,"_29651":484,"_20578":49968,"_5":14121,"_26960":49768,"_2870":49969},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_3383":548,"_29651":484,"_20578":49971,"_5":14121,"_26960":49772,"_2870":49972},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_3383":549,"_29651":484,"_20578":49974,"_5":14121,"_26960":49772,"_2870":49975},[],"The decision is made with the domain operation context:",{"_3383":550,"_29651":484,"_20578":49977,"_5":14121,"_26960":49772,"_2870":49978},[],"The middleware extracts the credential and resolves the matching principals.",{"_3383":551,"_29651":484,"_20578":49980,"_5":14121,"_26960":49772,"_2870":49981},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_3383":552,"_29651":484,"_20578":49983,"_5":14121,"_26960":49772,"_2870":49984},[],"`authz` gathers the entity rules of the granted policies.",{"_3383":553,"_29651":484,"_20578":49986,"_5":14121,"_26960":49772,"_2870":49987},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_3383":554,"_29651":484,"_20578":49989,"_5":14121,"_26960":49772,"_2870":49990},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_3383":555,"_29651":484,"_20578":49992,"_5":14121,"_26960":49772,"_2870":49993},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_3383":556,"_29651":484,"_20578":49995,"_5":14121,"_26960":49772,"_2870":49996},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_3383":557,"_29651":484,"_20578":49998,"_5":14121,"_26960":49772,"_2870":49999},[],"Actions fall into two groups:",{"_3383":558,"_29651":484,"_20578":50001,"_5":14121,"_26960":49772,"_2870":50002},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_3383":559,"_29651":484,"_20578":50004,"_5":14121,"_26960":49772,"_2870":50005},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_3383":560,"_29651":484,"_20578":50007,"_5":14121,"_26960":49772,"_2870":50008},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_3383":561,"_29651":484,"_20578":50010,"_5":14121,"_26960":49776,"_2870":50011},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_3383":562,"_29651":484,"_20578":50013,"_5":14121,"_26960":49776,"_2870":50014},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_3383":563,"_29651":484,"_20578":50016,"_5":14121,"_26960":49776,"_2870":50017},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_3383":564,"_29651":484,"_20578":50019,"_5":14121,"_26960":49780,"_2870":50020},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_3383":565,"_29651":484,"_20578":50022,"_5":14121,"_26960":49780,"_2870":50023},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_3383":566,"_29651":484,"_20578":50025,"_5":14121,"_26960":49780,"_2870":50026},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_3383":567,"_29651":484,"_20578":50028,"_5":14121,"_26960":49780,"_2870":50029},[],"The implemented operators are:",{"_3383":568,"_29651":484,"_20578":50031,"_5":14121,"_26960":49780,"_2870":50032},[],"`equals`, for exact equality;",{"_3383":569,"_29651":484,"_20578":50034,"_5":14121,"_26960":49780,"_2870":50035},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_3383":570,"_29651":484,"_20578":50037,"_5":14121,"_26960":49780,"_2870":50038},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_3383":571,"_29651":484,"_20578":50040,"_5":14121,"_26960":49780,"_2870":50041},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_3383":572,"_29651":484,"_20578":50043,"_5":14121,"_26960":49784,"_2870":50044},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_3383":573,"_29651":484,"_20578":50046,"_5":14121,"_26960":49784,"_2870":50047},[],"The available modes are:",{"_3383":574,"_29651":484,"_20578":50049,"_5":14121,"_26960":49784,"_2870":50050},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_3383":575,"_29651":484,"_20578":50052,"_5":14121,"_26960":49784,"_2870":50053},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_3383":576,"_29651":484,"_20578":50055,"_5":14121,"_26960":49784,"_2870":50056},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_3383":577,"_29651":484,"_20578":50058,"_5":14121,"_26960":49784,"_2870":50059},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_3383":578,"_29651":484,"_20578":50061,"_5":14121,"_26960":49784,"_2870":50062},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_3383":579,"_29651":484,"_20578":50064,"_5":14121,"_26960":49784,"_2870":50065},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_3383":580,"_29651":484,"_20578":50067,"_5":14121,"_26960":49788,"_2870":50068},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_3383":581,"_29651":484,"_20578":50070,"_5":14121,"_26960":49788,"_2870":50071},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_3383":582,"_29651":484,"_20578":50073,"_5":14121,"_26960":49788,"_2870":50074},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_3383":583,"_29651":484,"_20578":50076,"_5":14121,"_26960":49788,"_2870":50077},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_3383":584,"_29651":484,"_20578":50079,"_5":14121,"_26960":49796,"_2870":50080},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_3383":585,"_29651":484,"_20578":50082,"_5":14121,"_26960":49796,"_2870":50083},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_3383":586,"_29651":484,"_20578":50085,"_5":14121,"_26960":49800,"_2870":50086},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA and of a device to its DMS. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_3383":587,"_29651":484,"_20578":50088,"_5":14121,"_26960":49800,"_2870":50089},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_3383":588,"_29651":484,"_20578":50091,"_5":14121,"_26960":49804,"_2870":50092},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_3383":589,"_29651":484,"_20578":50094,"_5":14121,"_26960":49804,"_2870":50095},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_3383":590,"_29651":484,"_20578":50097,"_5":14121,"_26960":49804,"_2870":50098},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_3383":591,"_29651":484,"_20578":50100,"_5":14121,"_26960":49808,"_2870":50101},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_3383":592,"_29651":484,"_20578":50103,"_5":14121,"_26960":49808,"_2870":50104},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_3383":593,"_29651":484,"_20578":50106,"_5":14121,"_26960":49808,"_2870":50107},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_3383":594,"_29651":484,"_20578":50109,"_5":14121,"_26960":49808,"_2870":50110},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_3383":595,"_29651":484,"_20578":50112,"_5":14121,"_26960":49808,"_2870":50113},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_3383":596,"_29651":484,"_20578":50115,"_5":14121,"_26960":49808,"_2870":50116},[],"Note that:",{"_3383":597,"_29651":484,"_20578":50118,"_5":14121,"_26960":49808,"_2870":50119},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_3383":598,"_29651":484,"_20578":50121,"_5":14121,"_26960":49808,"_2870":50122},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_3383":599,"_29651":484,"_20578":50124,"_5":14121,"_26960":49808,"_2870":50125},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_3383":600,"_29651":484,"_20578":50127,"_5":14121,"_26960":49812,"_2870":50128},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_3383":601,"_29651":484,"_20578":50130,"_5":14121,"_26960":49812,"_2870":50131},[],"full and read-only access to certificates and authorities;",{"_3383":602,"_29651":484,"_20578":50133,"_5":14121,"_26960":49812,"_2870":50134},[],"full and read-only access to the KMS;",{"_3383":603,"_29651":484,"_20578":50136,"_5":14121,"_26960":49812,"_2870":50137},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_3383":604,"_29651":484,"_20578":50139,"_5":14121,"_26960":49812,"_2870":50140},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_3383":605,"_29651":484,"_20578":50142,"_5":14121,"_26960":49812,"_2870":50143},[],"console access;",{"_3383":606,"_29651":484,"_20578":50145,"_5":14121,"_26960":49812,"_2870":50146},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_3383":607,"_29651":484,"_20578":50148,"_5":14121,"_26960":49812,"_2870":50149},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_3383":608,"_29651":484,"_20578":50151,"_5":14121,"_26960":49812,"_2870":50152},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_3383":609,"_29651":484,"_20578":50154,"_5":14121,"_26960":49816,"_2870":50155},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_3383":610,"_29651":484,"_20578":50157,"_5":14121,"_26960":49816,"_2870":50158},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_3383":611,"_29651":484,"_20578":50160,"_5":14121,"_26960":49816,"_2870":50161},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_3383":612,"_29651":484,"_20578":50163,"_5":14121,"_26960":49819,"_2870":50164},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_3383":613,"_29651":484,"_20578":50166,"_5":14121,"_26960":49823,"_2870":50167},[],"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`.",{"_3383":614,"_29651":484,"_20578":50169,"_5":14121,"_26960":49823,"_2870":50170},[],"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0.",{"_3383":615,"_29651":484,"_20578":50172,"_5":14121,"_26960":49827,"_2870":50173},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_3383":616,"_29651":484,"_20578":50175,"_5":14121,"_26960":49831,"_2870":50176},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_3383":617,"_29651":484,"_20578":50178,"_5":14121,"_26960":49835,"_2870":50179},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_3383":618,"_29651":484,"_20578":50181,"_5":14121,"_26960":49839,"_2870":50182},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_3383":619,"_29651":484,"_20578":50184,"_5":14121,"_26960":49839,"_2870":50185},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_3383":620,"_29651":484,"_20578":50187,"_5":14121,"_26960":49843,"_2870":50188},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_3383":621,"_29651":484,"_20578":50190,"_5":14121,"_26960":49843,"_2870":50191},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_3383":622,"_29651":484,"_20578":50193,"_5":14121,"_26960":49843,"_2870":50194},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_3383":623,"_29651":484,"_20578":50196,"_5":14121,"_26960":49843,"_2870":50197},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_3383":624,"_29651":484,"_20578":50199,"_5":14121,"_26960":49843,"_2870":50200},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_3383":625,"_29651":484,"_20578":50202,"_5":14121,"_26960":49843,"_2870":50203},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_3383":626,"_29651":484,"_20578":50205,"_5":14121,"_26960":49843,"_2870":50206},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_3383":627,"_29651":484,"_20578":50208,"_5":14121,"_26960":49843,"_2870":50209},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_3383":628,"_29651":484,"_20578":50211,"_5":14121,"_26960":49847,"_2870":50212},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_3383":629,"_29651":484,"_20578":50214,"_5":14121,"_26960":49847,"_2870":50215},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_3383":630,"_29651":484,"_20578":50217,"_5":14121,"_26960":49847,"_2870":50218},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_3383":631,"_29651":484,"_20578":50220,"_5":14121,"_26960":49851,"_2870":50221},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_3383":632,"_29651":484,"_20578":50223,"_5":14121,"_26960":49851,"_2870":50224},[],"Use groups or stable roles for people and independent identities for automations.",{"_3383":633,"_29651":484,"_20578":50226,"_5":14121,"_26960":49851,"_2870":50227},[],"Keep at least two recovery administrators and test their access periodically.",{"_3383":634,"_29651":484,"_20578":50229,"_5":14121,"_26960":49851,"_2870":50230},[],"Review active principals, their matches and their grants after IdP changes.",{"_3383":635,"_29651":484,"_20578":50232,"_5":14121,"_26960":49851,"_2870":50233},[],"Search for wildcards in policies before upgrading Lamassu.",{"_3383":636,"_29651":484,"_20578":50235,"_5":14121,"_26960":49851,"_2870":50236},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_3383":637,"_29651":484,"_20578":50238,"_5":14121,"_26960":49851,"_2870":50239},[],"Always test one allowed and one denied operation for each role.",{"_3383":638,"_29651":484,"_20578":50241,"_5":14121,"_26960":49851,"_2870":50242},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_3383":639,"_29651":484,"_20578":50244,"_5":14121,"_26960":49859,"_2870":50245},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_3383":640,"_29651":484,"_20578":50247,"_5":14121,"_26960":49863,"_2870":50248},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_3383":641,"_29651":484,"_20578":50250,"_5":14121,"_26960":49863,"_2870":50251},[],"that an active principal of the correct type exists;",{"_3383":642,"_29651":484,"_20578":50253,"_5":14121,"_26960":49863,"_2870":50254},[],"that the claim paths and values match the real token exactly;",{"_3383":643,"_29651":484,"_20578":50256,"_5":14121,"_26960":49863,"_2870":50257},[],"that all of the principal's conditions hold;",{"_3383":644,"_29651":484,"_20578":50259,"_5":14121,"_26960":49863,"_2870":50260},[],"that the principal has the expected policy granted;",{"_3383":645,"_29651":484,"_20578":50262,"_5":14121,"_26960":49863,"_2870":50263},[],"that the policy includes the action and the requested resource type or route;",{"_3383":646,"_29651":484,"_20578":50265,"_5":14121,"_26960":49863,"_2870":50266},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_3383":647,"_29651":484,"_20578":50268,"_5":14121,"_26960":49863,"_2870":50269},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry tracing enabled, a request that reaches the policy engine produces an `engine.CheckHTTPRequest` span whose attributes record `authz.allowed`, the matched policy and the matched principal. Correlation with the Gateway trace requires trace context to be propagated to authz.",{"_3383":648,"_29651":484,"_20578":50271,"_5":14121,"_26960":49867,"_2870":50272},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_3383":649,"_29651":484,"_20578":50274,"_5":14121,"_26960":49871,"_2870":50275},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_3383":650,"_29651":484,"_20578":50277,"_5":14121,"_26960":49875,"_2870":50278},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_3383":651,"_29651":484,"_20578":50280,"_5":14121,"_26960":49875,"_2870":50281},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_3383":652,"_29651":652,"_5":14473,"_2870":50283,"_30004":50284,"_20578":50285,"_26960":652},"Alerts and subscriptions",[48280,49748,49749],[],{"_3383":653,"_29651":652,"_20578":50287,"_5":14121,"_26960":652,"_2870":50288},[],"Send PKI events to people and external systems.",{"_3383":654,"_29651":652,"_5":30001,"_20578":50290,"_26960":50291,"_2870":50292},[],"/docs/pr-preview/pr-55/platform/administration/alerts#how-it-works","How it works",{"_3383":655,"_29651":652,"_5":30001,"_20578":50294,"_26960":50295,"_2870":50296},[],"/docs/pr-preview/pr-55/platform/administration/alerts#available-channels","Available channels",{"_3383":656,"_29651":652,"_5":30001,"_20578":50298,"_26960":50299,"_2870":50300},[],"/docs/pr-preview/pr-55/platform/administration/alerts#create-a-subscription","Create a subscription",{"_3383":657,"_29651":652,"_5":30001,"_20578":50302,"_26960":50303,"_2870":50304},[],"/docs/pr-preview/pr-55/platform/administration/alerts#choose-the-event","Choose the event",{"_3383":658,"_29651":652,"_5":30001,"_20578":50306,"_26960":50307,"_2870":50308},[],"/docs/pr-preview/pr-55/platform/administration/alerts#configure-the-destination","Configure the destination",{"_3383":659,"_29651":652,"_5":30001,"_20578":50310,"_26960":50311,"_2870":50312},[],"/docs/pr-preview/pr-55/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_3383":660,"_29651":652,"_5":30001,"_20578":50314,"_26960":50315,"_2870":50316},[],"/docs/pr-preview/pr-55/platform/administration/alerts#review-and-activate","Review and activate",{"_3383":661,"_29651":652,"_5":30001,"_20578":50318,"_26960":50319,"_2870":50320},[],"/docs/pr-preview/pr-55/platform/administration/alerts#configure-the-webhook-http-client","Configure the webhook HTTP client",{"_3383":662,"_29651":652,"_5":30001,"_20578":50322,"_26960":50323,"_2870":50324},[],"/docs/pr-preview/pr-55/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_3383":663,"_29651":652,"_5":30001,"_20578":50326,"_26960":50327,"_2870":50328},[],"/docs/pr-preview/pr-55/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_3383":664,"_29651":652,"_5":30001,"_20578":50330,"_26960":50331,"_2870":50332},[],"/docs/pr-preview/pr-55/platform/administration/alerts#event-families","Event families",{"_3383":665,"_29651":652,"_20578":50334,"_5":14121,"_26960":652,"_2870":50335},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_3383":666,"_29651":652,"_20578":50337,"_5":14121,"_26960":50291,"_2870":50338},[],"A service publishes a domain event.",{"_3383":667,"_29651":652,"_20578":50340,"_5":14121,"_26960":50291,"_2870":50341},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_3383":668,"_29651":652,"_20578":50343,"_5":14121,"_26960":50291,"_2870":50344},[],"Each subscription's filter decides whether it should be notified.",{"_3383":669,"_29651":652,"_20578":50346,"_5":14121,"_26960":50291,"_2870":50347},[],"Lamassu delivers the event to the configured channel.",{"_3383":670,"_29651":652,"_20578":50349,"_5":14121,"_26960":50291,"_2870":50350},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_3383":671,"_29651":652,"_20578":50352,"_5":14121,"_26960":50295,"_2870":50353},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_3383":672,"_29651":652,"_20578":50355,"_5":14121,"_26960":50295,"_2870":50356},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_3383":673,"_29651":652,"_20578":50358,"_5":14121,"_26960":50295,"_2870":50359},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_3383":674,"_29651":652,"_20578":50361,"_5":14121,"_26960":50295,"_2870":50362},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_3383":675,"_29651":652,"_20578":50364,"_5":14121,"_26960":50295,"_2870":50365},[],"`apikey_options` requires `header` and `key`.",{"_3383":676,"_29651":652,"_20578":50367,"_5":14121,"_26960":50295,"_2870":50368},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3383":677,"_29651":652,"_20578":50370,"_5":14121,"_26960":50295,"_2870":50371},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_3383":678,"_29651":652,"_20578":50373,"_5":14121,"_26960":50295,"_2870":50374},[],"The alerts API reference documents the full `http_client` schema.",{"_3383":679,"_29651":652,"_20578":50376,"_5":14121,"_26960":50303,"_2870":50377},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_3383":680,"_29651":652,"_20578":50379,"_5":14121,"_26960":50307,"_2870":50380},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_3383":681,"_29651":652,"_20578":50382,"_5":14121,"_26960":50311,"_2870":50383},[],"Add a filter if you don't want to receive every instance of the event.",{"_3383":682,"_29651":652,"_20578":50385,"_5":14121,"_26960":50311,"_2870":50386},[],"**None** notifies all instances of the event.",{"_3383":683,"_29651":652,"_20578":50388,"_5":14121,"_26960":50311,"_2870":50389},[],"**JSON Path** evaluates one or more specific fields.",{"_3383":684,"_29651":652,"_20578":50391,"_5":14121,"_26960":50311,"_2870":50392},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_3383":685,"_29651":652,"_20578":50394,"_5":14121,"_26960":50311,"_2870":50395},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_3383":686,"_29651":652,"_20578":50397,"_5":14121,"_26960":50311,"_2870":50398},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_3383":687,"_29651":652,"_20578":50400,"_5":14121,"_26960":50311,"_2870":50401},[],"The console evaluates the filter against the JSON shown in the **Input Event** editor, which is prefilled with the latest event, and reports whether it matches. For JSON Path and JavaScript filters, it shows **The filter matches this Cloud Event** or **The filter does not match this Cloud Event**. JSON Path expressions are evaluated against the full Cloud Event, so the default `$.data` selects the event's `data` field, and the expression must start with `$`.",{"_3383":688,"_29651":652,"_20578":50403,"_5":14121,"_26960":50315,"_2870":50404},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_3383":689,"_29651":652,"_20578":50406,"_5":14121,"_26960":50319,"_2870":50407},[],"The Webhook and Microsoft Teams channels show this configuration in the subscribe form, at the channel step, and again when editing a subscription; Email does not use it. The fields map to the optional `http_client` block described above:",{"_3383":690,"_29651":652,"_20578":50409,"_5":14121,"_26960":50319,"_2870":50410},[],"**Log Level** selects `debug`, `info`, `warn` or `error`; `info` is the default.",{"_3383":691,"_29651":652,"_20578":50412,"_5":14121,"_26960":50319,"_2870":50413},[],"**Call Timeout** defaults to 10 seconds. The console rejects a value above 30 seconds with `Webhook timeout must be at most 30s.`; the API clamps the same value to the cap instead (see Calls are bounded).",{"_3383":692,"_29651":652,"_20578":50415,"_5":14121,"_26960":50319,"_2870":50416},[],"There is no TLS-verification switch for these channels, because the service always verifies the receiver certificate (see TLS is always verified).",{"_3383":693,"_29651":652,"_20578":50418,"_5":14121,"_26960":50319,"_2870":50419},[],"**HTTP Authentication** selects `No Authentication` (the default), `API Key` (API key value and Header Name, `X-API-Key` by default), `OIDC Client Credentials` (Client ID, Client Secret and Well-Known URL) or `Mutual TLS` (Client Certificate and Client Private Key pasted as PEM). A stored private key stays hidden until you select **Show**.",{"_3383":694,"_29651":652,"_20578":50421,"_5":14121,"_26960":50319,"_2870":50422},[],"A `http://` URL shows the console warning `Unencrypted HTTP connection` (see the Credentials over http\\:// callout below).",{"_3383":695,"_29651":652,"_20578":50424,"_5":14121,"_26960":50319,"_2870":50425},[],"The form validates inline against the same delivery rules: the webhook URL and the OIDC Well-Known URL must be absolute `http` or `https` URLs, an API-key header may not use a reserved name, and the mTLS certificate and key must be PEM content, not file paths.",{"_3383":696,"_29651":652,"_20578":50427,"_5":14121,"_26960":50319,"_2870":50428},[],"The summary in the Confirm step shows the authentication as `None`, `OIDC client credentials`, `API key` or `Mutual TLS`. The subscription details show the authentication, the API key header name (never the value), the OIDC issuer URL, mTLS as `Configured` and a fixed `TLS verification: Verified` row. The API key, client secret and private key are not shown in the subscription details.",{"_3383":697,"_29651":652,"_20578":50430,"_5":14121,"_26960":50323,"_2870":50431},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_3383":698,"_29651":652,"_20578":50433,"_5":14121,"_26960":50323,"_2870":50434},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_3383":699,"_29651":652,"_20578":50436,"_5":14121,"_26960":50323,"_2870":50437},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_3383":700,"_29651":652,"_20578":50439,"_5":14121,"_26960":50323,"_2870":50440},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_3383":701,"_29651":652,"_20578":50442,"_5":14121,"_26960":50323,"_2870":50443},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_3383":702,"_29651":652,"_20578":50445,"_5":14121,"_26960":50323,"_2870":50446},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_3383":703,"_29651":652,"_20578":50448,"_5":14121,"_26960":50323,"_2870":50449},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_3383":704,"_29651":652,"_20578":50451,"_5":14121,"_26960":50323,"_2870":50452},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_3383":705,"_29651":652,"_20578":50454,"_5":14121,"_26960":50327,"_2870":50455},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_3383":706,"_29651":652,"_20578":50457,"_5":14121,"_26960":50327,"_2870":50458},[],"Subscriptions created with older console versions may store the webhook target under `url` and `method` instead of `webhook_url` and `webhook_method`. The service delivers only through `webhook_url` and `webhook_method`, so such a subscription does not deliver even though the subscription details show the stored target. Open the subscription and save it again: the edit form prefills the stored target, and saving rewrites the channel configuration in the current layout.",{"_3383":707,"_29651":652,"_20578":50460,"_5":14121,"_26960":50331,"_2870":50461},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_3383":708,"_29651":652,"_20578":50463,"_5":14121,"_26960":50331,"_2870":50464},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_3383":709,"_29651":652,"_20578":50466,"_5":14121,"_26960":50331,"_2870":50467},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_3383":710,"_29651":652,"_20578":50469,"_5":14121,"_26960":50331,"_2870":50470},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_3383":711,"_29651":652,"_20578":50472,"_5":14121,"_26960":50331,"_2870":50473},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_3383":712,"_29651":652,"_20578":50475,"_5":14121,"_26960":50331,"_2870":50476},[],"**Validation:** `va.role.crl.create`.",{"_3383":713,"_29651":652,"_20578":50478,"_5":14121,"_26960":50331,"_2870":50479},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_3383":714,"_29651":652,"_20578":50481,"_5":14121,"_26960":50331,"_2870":50482},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_3383":715,"_29651":715,"_5":14473,"_2870":50484,"_30004":50485,"_20578":50486,"_26960":715},"Audit logs",[48280,49748,49749],[],{"_3383":716,"_29651":715,"_20578":50488,"_5":14121,"_26960":715,"_2870":50489},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_3383":717,"_29651":715,"_5":30001,"_20578":50491,"_26960":50492,"_2870":50493},[],"/docs/pr-preview/pr-55/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_3383":718,"_29651":715,"_5":30001,"_20578":50495,"_26960":50496,"_2870":50497},[],"/docs/pr-preview/pr-55/platform/administration/audit-logs#coverage","Coverage",{"_3383":719,"_29651":715,"_5":30001,"_20578":50499,"_26960":50500,"_2870":50501},[],"/docs/pr-preview/pr-55/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_3383":720,"_29651":715,"_5":30001,"_20578":50503,"_26960":50504,"_2870":50505},[],"/docs/pr-preview/pr-55/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_3383":721,"_29651":715,"_5":30001,"_20578":50507,"_26960":50508,"_2870":50509},[],"/docs/pr-preview/pr-55/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_3383":722,"_29651":715,"_5":30001,"_20578":50511,"_26960":50512,"_2870":50513},[],"/docs/pr-preview/pr-55/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_3383":723,"_29651":715,"_5":30001,"_20578":50515,"_26960":50516,"_2870":50517},[],"/docs/pr-preview/pr-55/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_3383":724,"_29651":715,"_5":30001,"_20578":50519,"_26960":50520,"_2870":50521},[],"/docs/pr-preview/pr-55/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_3383":725,"_29651":715,"_5":30001,"_20578":50523,"_26960":50524,"_2870":50525},[],"/docs/pr-preview/pr-55/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_3383":726,"_29651":715,"_5":30001,"_20578":50527,"_26960":50528,"_2870":50529},[],"/docs/pr-preview/pr-55/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_3383":727,"_29651":715,"_5":30001,"_20578":50531,"_26960":50532,"_2870":50533},[],"/docs/pr-preview/pr-55/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_3383":728,"_29651":715,"_20578":50535,"_5":14121,"_26960":715,"_2870":50536},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_3383":729,"_29651":715,"_20578":50538,"_5":14121,"_26960":50492,"_2870":50539},[],"The audit body includes:",{"_3383":730,"_29651":715,"_20578":50541,"_5":14121,"_26960":50492,"_2870":50542},[],"input: data received by the operation;",{"_3383":731,"_29651":715,"_20578":50544,"_5":14121,"_26960":50492,"_2870":50545},[],"has\\_error: whether the service returned an error;",{"_3383":732,"_29651":715,"_20578":50547,"_5":14121,"_26960":50492,"_2870":50548},[],"output: produced result or error message;",{"_3383":733,"_29651":715,"_20578":50550,"_5":14121,"_26960":50492,"_2870":50551},[],"principals: identifiers of the principals that matched the request.",{"_3383":734,"_29651":715,"_20578":50553,"_5":14121,"_26960":50492,"_2870":50554},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_3383":735,"_29651":715,"_20578":50556,"_5":14121,"_26960":50492,"_2870":50557},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_3383":736,"_29651":715,"_20578":50559,"_5":14121,"_26960":50496,"_2870":50560},[],"The backend applies auditing to mutations of:",{"_3383":737,"_29651":715,"_20578":50562,"_5":14121,"_26960":50496,"_2870":50563},[],"authorities, certificates and issuance profiles;",{"_3383":738,"_29651":715,"_20578":50565,"_5":14121,"_26960":50496,"_2870":50566},[],"keys and KMS engines;",{"_3383":739,"_29651":715,"_20578":50568,"_5":14121,"_26960":50496,"_2870":50569},[],"devices and identities;",{"_3383":740,"_29651":715,"_20578":50571,"_5":14121,"_26960":50496,"_2870":50572},[],"DMSs and enrollment operations;",{"_3383":741,"_29651":715,"_20578":50574,"_5":14121,"_26960":50496,"_2870":50575},[],"validation functions and CRL;",{"_3383":742,"_29651":715,"_20578":50577,"_5":14121,"_26960":50496,"_2870":50578},[],"principals, policies and authorization grants.",{"_3383":743,"_29651":715,"_20578":50580,"_5":14121,"_26960":50496,"_2870":50581},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_3383":744,"_29651":715,"_20578":50583,"_5":14121,"_26960":50500,"_2870":50584},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_3383":745,"_29651":715,"_20578":50586,"_5":14121,"_26960":50500,"_2870":50587},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_3383":746,"_29651":715,"_20578":50589,"_5":14121,"_26960":50500,"_2870":50590},[],"Design the consumer to:",{"_3383":747,"_29651":715,"_20578":50592,"_5":14121,"_26960":50500,"_2870":50593},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_3383":748,"_29651":715,"_20578":50595,"_5":14121,"_26960":50500,"_2870":50596},[],"keep the complete CloudEvent unmodified;",{"_3383":749,"_29651":715,"_20578":50598,"_5":14121,"_26960":50500,"_2870":50599},[],"record the ingestion time and detect duplicates by ID;",{"_3383":750,"_29651":715,"_20578":50601,"_5":14121,"_26960":50500,"_2870":50602},[],"encrypt in transit and at rest;",{"_3383":751,"_29651":715,"_20578":50604,"_5":14121,"_26960":50500,"_2870":50605},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_3383":752,"_29651":715,"_20578":50607,"_5":14121,"_26960":50500,"_2870":50608},[],"apply an explicit retention and legal hold policy;",{"_3383":753,"_29651":715,"_20578":50610,"_5":14121,"_26960":50500,"_2870":50611},[],"alert if it stops consuming or the pending queue grows.",{"_3383":754,"_29651":715,"_20578":50613,"_5":14121,"_26960":50504,"_2870":50614},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_3383":755,"_29651":715,"_20578":50616,"_5":14121,"_26960":50504,"_2870":50617},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_3383":756,"_29651":715,"_20578":50619,"_5":14121,"_26960":50512,"_2870":50620},[],"Start from the reported time and normalize every source to UTC.",{"_3383":757,"_29651":715,"_20578":50622,"_5":14121,"_26960":50516,"_2870":50623},[],"Filter by event type, service source and resource identifier.",{"_3383":758,"_29651":715,"_20578":50625,"_5":14121,"_26960":50520,"_2870":50626},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_3383":759,"_29651":715,"_20578":50628,"_5":14121,"_26960":50524,"_2870":50629},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_3383":760,"_29651":715,"_20578":50631,"_5":14121,"_26960":50528,"_2870":50632},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_3383":761,"_29651":715,"_20578":50634,"_5":14121,"_26960":50532,"_2870":50635},[],"Generate a controlled mutation in a test environment and check that:",{"_3383":762,"_29651":715,"_20578":50637,"_5":14121,"_26960":50532,"_2870":50638},[],"a successful audit event appears;",{"_3383":763,"_29651":715,"_20578":50640,"_5":14121,"_26960":50532,"_2870":50641},[],"the principal matches the identity used;",{"_3383":764,"_29651":715,"_20578":50643,"_5":14121,"_26960":50532,"_2870":50644},[],"the consumer persists it exactly once;",{"_3383":765,"_29651":715,"_20578":50646,"_5":14121,"_26960":50532,"_2870":50647},[],"it can be retrieved by resource, actor and period;",{"_3383":766,"_29651":715,"_20578":50649,"_5":14121,"_26960":50532,"_2870":50650},[],"a consumer outage raises an alert.",{"_3383":767,"_29651":715,"_20578":50652,"_5":14121,"_26960":50532,"_2870":50653},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_3383":768,"_29651":768,"_5":14473,"_2870":50655,"_30004":50656,"_20578":50657,"_26960":768},"Platform architecture",[48280,49748],[],{"_3383":769,"_29651":768,"_20578":50659,"_5":14121,"_26960":768,"_2870":50660},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_3383":770,"_29651":768,"_5":30001,"_20578":50662,"_26960":50663,"_2870":50664},[],"/docs/pr-preview/pr-55/platform/concepts/architecture#control-plane","Control plane",{"_3383":771,"_29651":768,"_5":30001,"_20578":50666,"_26960":50667,"_2870":50668},[],"/docs/pr-preview/pr-55/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_3383":772,"_29651":768,"_5":30001,"_20578":50670,"_26960":50671,"_2870":50672},[],"/docs/pr-preview/pr-55/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_3383":773,"_29651":768,"_5":30001,"_20578":50674,"_26960":50675,"_2870":50676},[],"/docs/pr-preview/pr-55/platform/concepts/architecture#status-and-validation","Status and validation",{"_3383":774,"_29651":768,"_5":30001,"_20578":50678,"_26960":50679,"_2870":50680},[],"/docs/pr-preview/pr-55/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_3383":775,"_29651":768,"_20578":50682,"_5":14121,"_26960":768,"_2870":50683},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_3383":776,"_29651":768,"_20578":50685,"_5":14121,"_26960":768,"_2870":50686},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_3383":777,"_29651":768,"_20578":50688,"_5":14121,"_26960":50663,"_2870":50689},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_3383":778,"_29651":768,"_20578":50691,"_5":14121,"_26960":50667,"_2870":50692},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_3383":779,"_29651":768,"_20578":50694,"_5":14121,"_26960":50671,"_2870":50695},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_3383":780,"_29651":768,"_20578":50697,"_5":14121,"_26960":50675,"_2870":50698},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_3383":781,"_29651":768,"_20578":50700,"_5":14121,"_26960":50679,"_2870":50701},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_3383":782,"_29651":782,"_5":14473,"_2870":50703,"_30004":50704,"_20578":50705,"_26960":782},"How Lamassu works",[48280,49748],[],{"_3383":783,"_29651":782,"_20578":50707,"_5":14121,"_26960":782,"_2870":50708},[],"The mental model of trust, keys, certificates and devices.",{"_3383":784,"_29651":782,"_5":30001,"_20578":50710,"_26960":50711,"_2870":50712},[],"/docs/pr-preview/pr-55/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_3383":785,"_29651":782,"_5":30001,"_20578":50714,"_26960":50715,"_2870":50716},[],"/docs/pr-preview/pr-55/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_3383":786,"_29651":782,"_20578":50718,"_5":14121,"_26960":782,"_2870":50719},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_3383":787,"_29651":782,"_20578":50721,"_5":14121,"_26960":50711,"_2870":50722},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_3383":788,"_29651":782,"_20578":50724,"_5":14121,"_26960":50711,"_2870":50725},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_3383":789,"_29651":782,"_20578":50727,"_5":14121,"_26960":50711,"_2870":50728},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_3383":790,"_29651":782,"_20578":50730,"_5":14121,"_26960":50711,"_2870":50731},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_3383":791,"_29651":782,"_20578":50733,"_5":14121,"_26960":50711,"_2870":50734},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_3383":792,"_29651":782,"_20578":50736,"_5":14121,"_26960":50715,"_2870":50737},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_3383":793,"_29651":782,"_20578":50739,"_5":14121,"_26960":50715,"_2870":50740},[],"A DMS relates that CA to an enrollment policy.",{"_3383":794,"_29651":782,"_20578":50742,"_5":14121,"_26960":50715,"_2870":50743},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_3383":795,"_29651":782,"_20578":50745,"_5":14121,"_26960":50715,"_2870":50746},[],"Lamassu keeps the inventory, history and status of the identity.",{"_3383":796,"_29651":782,"_20578":50748,"_5":14121,"_26960":50715,"_2870":50749},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_3383":797,"_29651":782,"_20578":50751,"_5":14121,"_26960":50715,"_2870":50752},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_3383":798,"_29651":782,"_20578":50754,"_5":14121,"_26960":50715,"_2870":50755},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3383":799,"_29651":799,"_5":14473,"_2870":50757,"_30004":50758,"_20578":50760,"_26960":799},"Devices and identities",[48280,49748,50759,50757],"IoT Fleets",[],{"_3383":800,"_29651":799,"_20578":50762,"_5":14121,"_26960":799,"_2870":50763},[],"Register, inspect and retire devices while checking their current identity and history.",{"_3383":801,"_29651":799,"_5":30001,"_20578":50765,"_26960":50766,"_2870":50767},[],"/docs/pr-preview/pr-55/platform/iot-fleets/device-management#device-states","Device states",{"_3383":802,"_29651":799,"_5":30001,"_20578":50769,"_26960":50770,"_2870":50771},[],"/docs/pr-preview/pr-55/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_3383":803,"_29651":799,"_5":30001,"_20578":50773,"_26960":50774,"_2870":50775},[],"/docs/pr-preview/pr-55/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_3383":804,"_29651":799,"_5":30001,"_20578":50777,"_26960":50778,"_2870":50779},[],"/docs/pr-preview/pr-55/platform/iot-fleets/device-management#create-the-device","Create the device",{"_3383":805,"_29651":799,"_5":30001,"_20578":50781,"_26960":50782,"_2870":50783},[],"/docs/pr-preview/pr-55/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_3383":806,"_29651":799,"_5":30001,"_20578":50785,"_26960":50786,"_2870":50787},[],"/docs/pr-preview/pr-55/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_3383":807,"_29651":799,"_5":30001,"_20578":50789,"_26960":50790,"_2870":50791},[],"/docs/pr-preview/pr-55/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_3383":808,"_29651":799,"_5":30001,"_20578":50793,"_26960":50794,"_2870":50795},[],"/docs/pr-preview/pr-55/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_3383":809,"_29651":799,"_5":30001,"_20578":50797,"_26960":50798,"_2870":50799},[],"/docs/pr-preview/pr-55/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_3383":810,"_29651":799,"_5":30001,"_20578":50801,"_26960":50802,"_2870":50803},[],"/docs/pr-preview/pr-55/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_3383":811,"_29651":799,"_5":30001,"_20578":50805,"_26960":50806,"_2870":50807},[],"/docs/pr-preview/pr-55/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_3383":812,"_29651":799,"_20578":50809,"_5":14121,"_26960":799,"_2870":50810},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_3383":813,"_29651":799,"_20578":50812,"_5":14121,"_26960":799,"_2870":50813},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_3383":814,"_29651":799,"_20578":50815,"_5":14121,"_26960":50766,"_2870":50816},[],"Operational view",{"_3383":815,"_29651":799,"_20578":50818,"_5":14121,"_26960":50766,"_2870":50819},[],"Meaning",{"_3383":816,"_29651":799,"_20578":50821,"_5":14121,"_26960":50766,"_2870":50822},[],"**No Identity**",{"_3383":817,"_29651":799,"_20578":50824,"_5":14121,"_26960":50766,"_2870":50825},[],"A record exists without an associated identity.",{"_3383":818,"_29651":799,"_20578":50827,"_5":14121,"_26960":50766,"_2870":50828},[],"**Active**",{"_3383":819,"_29651":799,"_20578":50830,"_5":14121,"_26960":50766,"_2870":50831},[],"The slot is active; also check certificate dates, status and usages.",{"_3383":820,"_29651":799,"_20578":50833,"_5":14121,"_26960":50766,"_2870":50834},[],"**Renewal Pending**",{"_3383":821,"_29651":799,"_20578":50836,"_5":14121,"_26960":50766,"_2870":50837},[],"The identity is in the operational renewal window.",{"_3383":822,"_29651":799,"_20578":50839,"_5":14121,"_26960":50766,"_2870":50840},[],"**Expiring Soon**",{"_3383":823,"_29651":799,"_20578":50842,"_5":14121,"_26960":50766,"_2870":50843},[],"Expiration is approaching according to configured thresholds.",{"_3383":824,"_29651":799,"_20578":50845,"_5":14121,"_26960":50766,"_2870":50846},[],"**Expired**",{"_3383":825,"_29651":799,"_20578":50848,"_5":14121,"_26960":50766,"_2870":50849},[],"The identity has expired.",{"_3383":826,"_29651":799,"_20578":50851,"_5":14121,"_26960":50766,"_2870":50852},[],"**Revoked**",{"_3383":827,"_29651":799,"_20578":50854,"_5":14121,"_26960":50766,"_2870":50855},[],"The identity is marked revoked.",{"_3383":828,"_29651":799,"_20578":50857,"_5":14121,"_26960":50766,"_2870":50858},[],"**Decommissioned**",{"_3383":829,"_29651":799,"_20578":50860,"_5":14121,"_26960":50766,"_2870":50861},[],"The record is retired and ordinary updates do not restore operation.",{"_3383":830,"_29651":799,"_20578":50863,"_5":14121,"_26960":50766,"_2870":50864},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_3383":831,"_29651":799,"_20578":50866,"_5":14121,"_26960":50770,"_2870":50867},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_3383":832,"_29651":799,"_20578":50869,"_5":14121,"_26960":50770,"_2870":50870},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_3383":833,"_29651":799,"_20578":50872,"_5":14121,"_26960":50770,"_2870":50873},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_3383":834,"_29651":799,"_20578":50875,"_5":14121,"_26960":50770,"_2870":50876},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_3383":835,"_29651":799,"_20578":50878,"_5":14121,"_26960":50774,"_2870":50879},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_3383":836,"_29651":799,"_20578":50881,"_5":14121,"_26960":50778,"_2870":50882},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_3383":837,"_29651":799,"_20578":50884,"_5":14121,"_26960":50782,"_2870":50885},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_3383":838,"_29651":799,"_20578":50887,"_5":14121,"_26960":50786,"_2870":50888},[],"Add model, environment or location tags and an icon according to your inventory.",{"_3383":839,"_29651":799,"_20578":50890,"_5":14121,"_26960":50790,"_2870":50891},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_3383":840,"_29651":799,"_20578":50893,"_5":14121,"_26960":50790,"_2870":50894},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_3383":841,"_29651":799,"_20578":50896,"_5":14121,"_26960":50794,"_2870":50897},[],"From **No Identity**, use **Assign Identity**:",{"_3383":842,"_29651":799,"_20578":50899,"_5":14121,"_26960":50794,"_2870":50900},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_3383":843,"_29651":799,"_20578":50902,"_5":14121,"_26960":50794,"_2870":50903},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_3383":844,"_29651":799,"_20578":50905,"_5":14121,"_26960":50794,"_2870":50906},[],"Confirm and read the serial, active version and history again.",{"_3383":845,"_29651":799,"_20578":50908,"_5":14121,"_26960":50794,"_2870":50909},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_3383":846,"_29651":799,"_20578":50911,"_5":14121,"_26960":50794,"_2870":50912},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_3383":847,"_29651":799,"_20578":50914,"_5":14121,"_26960":50798,"_2870":50915},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_3383":848,"_29651":799,"_20578":50917,"_5":14121,"_26960":50798,"_2870":50918},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_3383":849,"_29651":799,"_20578":50920,"_5":14121,"_26960":50802,"_2870":50921},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_3383":850,"_29651":799,"_20578":50923,"_5":14121,"_26960":50802,"_2870":50924},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_3383":851,"_29651":799,"_20578":50926,"_5":14121,"_26960":50802,"_2870":50927},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_3383":852,"_29651":799,"_20578":50929,"_5":14121,"_26960":50802,"_2870":50930},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_3383":853,"_29651":799,"_20578":50932,"_5":14121,"_26960":50806,"_2870":50933},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3383":854,"_29651":799,"_20578":50935,"_5":14121,"_26960":50806,"_2870":50936},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3383":855,"_29651":855,"_5":14473,"_2870":50938,"_30004":50939,"_20578":50941,"_26960":855},"Bootstrap identity and authentication",[48280,49748,50759,50757,50940],"Enrollment with PKI",[],{"_3383":856,"_29651":855,"_20578":50943,"_5":14121,"_26960":855,"_2870":50944},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_3383":857,"_29651":855,"_5":30001,"_20578":50946,"_26960":50947,"_2870":50948},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_3383":858,"_29651":855,"_5":30001,"_20578":50950,"_26960":50951,"_2870":50952},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_3383":859,"_29651":855,"_5":30001,"_20578":50954,"_26960":50955,"_2870":50956},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_3383":860,"_29651":855,"_5":30001,"_20578":50958,"_26960":50959,"_2870":50960},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_3383":861,"_29651":855,"_5":30001,"_20578":50962,"_26960":50963,"_2870":50964},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_3383":862,"_29651":855,"_20578":50966,"_5":14121,"_26960":855,"_2870":50967},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_3383":863,"_29651":855,"_20578":50969,"_5":14121,"_26960":50947,"_2870":50970},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_3383":864,"_29651":855,"_20578":50972,"_5":14121,"_26960":50947,"_2870":50973},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_3383":865,"_29651":855,"_20578":50975,"_5":14121,"_26960":50951,"_2870":50976},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_3383":866,"_29651":855,"_20578":50978,"_5":14121,"_26960":50951,"_2870":50979},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_3383":867,"_29651":855,"_20578":50981,"_5":14121,"_26960":50951,"_2870":50982},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_3383":868,"_29651":855,"_20578":50984,"_5":14121,"_26960":50955,"_2870":50985},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_3383":869,"_29651":855,"_20578":50987,"_5":14121,"_26960":50955,"_2870":50988},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_3383":870,"_29651":855,"_20578":50990,"_5":14121,"_26960":50959,"_2870":50991},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_3383":871,"_29651":855,"_20578":50993,"_5":14121,"_26960":50959,"_2870":50994},[],"Example body:",{"_3383":872,"_29651":855,"_20578":50996,"_5":14121,"_26960":50959,"_2870":50997},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_3383":873,"_29651":855,"_20578":50999,"_5":14121,"_26960":50959,"_2870":51000},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_3383":874,"_29651":855,"_20578":51002,"_5":14121,"_26960":50959,"_2870":51003},[],"Continuation requires a successful HTTP response and JSON:",{"_3383":875,"_29651":855,"_20578":51005,"_5":14121,"_26960":50959,"_2870":51006},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_3383":876,"_29651":855,"_20578":51008,"_5":14121,"_26960":50963,"_2870":51009},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_3383":877,"_29651":855,"_20578":51011,"_5":14121,"_26960":50963,"_2870":51012},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_3383":878,"_29651":878,"_5":14473,"_2870":51014,"_30004":51015,"_20578":51016,"_26960":878},"Configure and operate the DMS",[48280,49748,50759,50757,50940],[],{"_3383":879,"_29651":878,"_20578":51018,"_5":14121,"_26960":878,"_2870":51019},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_3383":880,"_29651":878,"_5":30001,"_20578":51021,"_26960":51022,"_2870":48290},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/dms#before-you-begin",{"_3383":881,"_29651":878,"_5":30001,"_20578":51024,"_26960":51025,"_2870":51026},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_3383":882,"_29651":878,"_5":30001,"_20578":51028,"_26960":51029,"_2870":51030},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_3383":883,"_29651":878,"_5":30001,"_20578":51032,"_26960":51033,"_2870":51034},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_3383":884,"_29651":878,"_5":30001,"_20578":51036,"_26960":51037,"_2870":51038},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_3383":885,"_29651":878,"_5":30001,"_20578":51040,"_26960":51041,"_2870":51042},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_3383":886,"_29651":878,"_5":30001,"_20578":51044,"_26960":51045,"_2870":51046},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_3383":887,"_29651":878,"_5":30001,"_20578":51048,"_26960":51049,"_2870":51050},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_3383":888,"_29651":878,"_5":30001,"_20578":51052,"_26960":51053,"_2870":51054},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_3383":889,"_29651":878,"_5":30001,"_20578":51056,"_26960":51057,"_2870":51058},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_3383":890,"_29651":878,"_5":30001,"_20578":51060,"_26960":51061,"_2870":51062},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_3383":891,"_29651":878,"_5":30001,"_20578":51064,"_26960":51065,"_2870":51066},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_3383":892,"_29651":878,"_5":30001,"_20578":51068,"_26960":51069,"_2870":51070},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_3383":893,"_29651":878,"_5":30001,"_20578":51072,"_26960":51073,"_2870":51074},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_3383":894,"_29651":878,"_5":30001,"_20578":51076,"_26960":51077,"_2870":51078},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_3383":895,"_29651":878,"_5":30001,"_20578":51080,"_26960":51081,"_2870":51082},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_3383":896,"_29651":878,"_5":30001,"_20578":51084,"_26960":51085,"_2870":51086},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_3383":897,"_29651":878,"_5":30001,"_20578":51088,"_26960":51089,"_2870":51090},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_3383":898,"_29651":878,"_20578":51092,"_5":14121,"_26960":878,"_2870":51093},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_3383":899,"_29651":878,"_20578":51095,"_5":14121,"_26960":51022,"_2870":51096},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_3383":900,"_29651":878,"_20578":51098,"_5":14121,"_26960":51022,"_2870":51099},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_3383":901,"_29651":878,"_20578":51101,"_5":14121,"_26960":51029,"_2870":51102},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_3383":902,"_29651":878,"_20578":51104,"_5":14121,"_26960":51033,"_2870":51105},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_3383":903,"_29651":878,"_20578":51107,"_5":14121,"_26960":51037,"_2870":51108},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_3383":904,"_29651":878,"_20578":51110,"_5":14121,"_26960":51041,"_2870":51111},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_3383":905,"_29651":878,"_20578":51113,"_5":14121,"_26960":51045,"_2870":51114},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_3383":906,"_29651":878,"_20578":51116,"_5":14121,"_26960":51053,"_2870":51117},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_3383":907,"_29651":878,"_20578":51119,"_5":14121,"_26960":51053,"_2870":51120},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_3383":908,"_29651":878,"_20578":51122,"_5":14121,"_26960":51057,"_2870":51123},[],"`settings.enrollment_settings` field",{"_3383":909,"_29651":878,"_20578":51125,"_5":14121,"_26960":51057,"_2870":51126},[],"Decision",{"_3383":910,"_29651":878,"_20578":51128,"_5":14121,"_26960":51057,"_2870":51129},[],"`protocol`",{"_3383":911,"_29651":878,"_20578":51131,"_5":14121,"_26960":51057,"_2870":51132},[],"`EST_RFC7030` for these operations.",{"_3383":912,"_29651":878,"_20578":51134,"_5":14121,"_26960":51057,"_2870":51135},[],"`enrollment_ca`",{"_3383":913,"_29651":878,"_20578":51137,"_5":14121,"_26960":51057,"_2870":51138},[],"ID of the signing CA.",{"_3383":914,"_29651":878,"_20578":51140,"_5":14121,"_26960":51057,"_2870":51141},[],"`verify_csr_signature`",{"_3383":915,"_29651":878,"_20578":51143,"_5":14121,"_26960":51057,"_2870":51144},[],"Keep `true` to verify CSR key possession.",{"_3383":916,"_29651":878,"_20578":51146,"_5":14121,"_26960":51057,"_2870":51147},[],"`enable_replaceable_enrollment`",{"_3383":917,"_29651":878,"_20578":51149,"_5":14121,"_26960":51057,"_2870":51150},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_3383":918,"_29651":878,"_20578":51152,"_5":14121,"_26960":51057,"_2870":51153},[],"`est_rfc7030_settings.auth_mode`",{"_3383":919,"_29651":878,"_20578":51155,"_5":14121,"_26960":51057,"_2870":51156},[],"One of the four authentication modes.",{"_3383":920,"_29651":878,"_20578":51158,"_5":14121,"_26960":51057,"_2870":51159},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_3383":921,"_29651":878,"_20578":51161,"_5":14121,"_26960":51061,"_2870":51162},[],"The blocks are independent:",{"_3383":922,"_29651":878,"_20578":51164,"_5":14121,"_26960":51061,"_2870":51165},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_3383":923,"_29651":878,"_20578":51167,"_5":14121,"_26960":51061,"_2870":51168},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_3383":924,"_29651":878,"_20578":51170,"_5":14121,"_26960":51061,"_2870":51171},[],"`auth_mode`",{"_3383":925,"_29651":878,"_20578":51173,"_5":14121,"_26960":51061,"_2870":51174},[],"Control applied in the configured operation",{"_3383":926,"_29651":878,"_20578":51176,"_5":14121,"_26960":51061,"_2870":51177},[],"`CLIENT_CERTIFICATE`",{"_3383":927,"_29651":878,"_20578":51179,"_5":14121,"_26960":51061,"_2870":51180},[],"Presented certificate validation.",{"_3383":928,"_29651":878,"_20578":51182,"_5":14121,"_26960":51061,"_2870":51183},[],"`EXTERNAL_WEBHOOK`",{"_3383":929,"_29651":878,"_20578":51185,"_5":14121,"_26960":51061,"_2870":51186},[],"Configured webhook authorization.",{"_3383":930,"_29651":878,"_20578":51188,"_5":14121,"_26960":51061,"_2870":51189},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3383":931,"_29651":878,"_20578":51191,"_5":14121,"_26960":51061,"_2870":51192},[],"Certificate validation followed by webhook approval.",{"_3383":932,"_29651":878,"_20578":51194,"_5":14121,"_26960":51061,"_2870":51195},[],"`NO_AUTH`",{"_3383":933,"_29651":878,"_20578":51197,"_5":14121,"_26960":51061,"_2870":51198},[],"No DMS requester authentication.",{"_3383":934,"_29651":878,"_20578":51200,"_5":14121,"_26960":51061,"_2870":51201},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_3383":935,"_29651":878,"_20578":51203,"_5":14121,"_26960":51061,"_2870":51204},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_3383":936,"_29651":878,"_20578":51206,"_5":14121,"_26960":51061,"_2870":51207},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs. That list is optional because the enrollment CA is always trusted for re-enrollment, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`.",{"_3383":937,"_29651":878,"_20578":51209,"_5":14121,"_26960":51061,"_2870":51210},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_3383":938,"_29651":878,"_20578":51212,"_5":14121,"_26960":51065,"_2870":51213},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_3383":939,"_29651":878,"_20578":51215,"_5":14121,"_26960":51065,"_2870":51216},[],"`external_webhook_settings` field",{"_3383":940,"_29651":878,"_20578":51218,"_5":14121,"_26960":51065,"_2870":51126},[],{"_3383":941,"_29651":878,"_20578":51220,"_5":14121,"_26960":51065,"_2870":51221},[],"`url`",{"_3383":942,"_29651":878,"_20578":51223,"_5":14121,"_26960":51065,"_2870":51224},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_3383":943,"_29651":878,"_20578":51226,"_5":14121,"_26960":51065,"_2870":51227},[],"`method`",{"_3383":944,"_29651":878,"_20578":51229,"_5":14121,"_26960":51065,"_2870":51230},[],"`POST` or `PUT`; `POST` by default.",{"_3383":945,"_29651":878,"_20578":51232,"_5":14121,"_26960":51065,"_2870":51233},[],"`name`",{"_3383":946,"_29651":878,"_20578":51235,"_5":14121,"_26960":51065,"_2870":51236},[],"Label used in service logs.",{"_3383":947,"_29651":878,"_20578":51238,"_5":14121,"_26960":51065,"_2870":51239},[],"`config.auth_mode`",{"_3383":948,"_29651":878,"_20578":51241,"_5":14121,"_26960":51065,"_2870":51242},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_3383":949,"_29651":878,"_20578":51244,"_5":14121,"_26960":51065,"_2870":51245},[],"`config.log_level`",{"_3383":950,"_29651":878,"_20578":51247,"_5":14121,"_26960":51065,"_2870":51248},[],"Log level of the webhook call: `debug`, `info`, `warn` or `error`; `info` by default.",{"_3383":951,"_29651":878,"_20578":51250,"_5":14121,"_26960":51065,"_2870":51251},[],"`config.apikey_options`",{"_3383":952,"_29651":878,"_20578":51253,"_5":14121,"_26960":51065,"_2870":51254},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_3383":953,"_29651":878,"_20578":51256,"_5":14121,"_26960":51065,"_2870":51257},[],"`config.jwt_options`",{"_3383":954,"_29651":878,"_20578":51259,"_5":14121,"_26960":51065,"_2870":51260},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3383":955,"_29651":878,"_20578":51262,"_5":14121,"_26960":51065,"_2870":51263},[],"`config.mtls_options`",{"_3383":956,"_29651":878,"_20578":51265,"_5":14121,"_26960":51065,"_2870":51266},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_3383":957,"_29651":878,"_20578":51268,"_5":14121,"_26960":51065,"_2870":51269},[],"`config.insecure_skip_verify`",{"_3383":958,"_29651":878,"_20578":51271,"_5":14121,"_26960":51065,"_2870":51272},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_3383":959,"_29651":878,"_20578":51274,"_5":14121,"_26960":51065,"_2870":51275},[],"`config.call_timeout`",{"_3383":960,"_29651":878,"_20578":51277,"_5":14121,"_26960":51065,"_2870":51278},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_3383":961,"_29651":878,"_20578":51280,"_5":14121,"_26960":51065,"_2870":51281},[],"Rules for that configuration:",{"_3383":962,"_29651":878,"_20578":51283,"_5":14121,"_26960":51065,"_2870":51284},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_3383":963,"_29651":878,"_20578":51286,"_5":14121,"_26960":51065,"_2870":51287},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_3383":964,"_29651":878,"_20578":51289,"_5":14121,"_26960":51065,"_2870":51290},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_3383":965,"_29651":878,"_20578":51292,"_5":14121,"_26960":51065,"_2870":51293},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_3383":966,"_29651":878,"_20578":51295,"_5":14121,"_26960":51065,"_2870":51296},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_3383":967,"_29651":878,"_20578":51298,"_5":14121,"_26960":51065,"_2870":51299},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_3383":968,"_29651":878,"_20578":51301,"_5":14121,"_26960":51065,"_2870":51302},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing. The console exposes independent editors for the enrollment and re-enrollment authentication, with the same Log Level, Call Timeout, HTTP Authentication and credential fields as the webhook channels, plus a **Skip TLS Verification** switch (off by default, so verification stays on; the console warns when you enable it).",{"_3383":969,"_29651":878,"_20578":51304,"_5":14121,"_26960":51065,"_2870":51305},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. To fix it in the console, open the DMS, replace any file-path value with PEM content — the editor rejects file paths with an inline field error — and save. Saving rewrites `external_webhook_settings.config` with the current keys, and the console reads both plain and Base64-encoded PEM from migrated configurations and stores the material Base64-encoded. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_3383":970,"_29651":878,"_20578":51307,"_5":14121,"_26960":51065,"_2870":51308},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_3383":971,"_29651":878,"_20578":51310,"_5":14121,"_26960":51069,"_2870":51311},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_3383":972,"_29651":878,"_20578":51313,"_5":14121,"_26960":51073,"_2870":51314},[],"`settings.reenrollment_settings` field",{"_3383":973,"_29651":878,"_20578":51316,"_5":14121,"_26960":51073,"_2870":48670},[],{"_3383":974,"_29651":878,"_20578":51318,"_5":14121,"_26960":51073,"_2870":51319},[],"`reenrollment_delta`",{"_3383":975,"_29651":878,"_20578":51321,"_5":14121,"_26960":51073,"_2870":51322},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_3383":976,"_29651":878,"_20578":51324,"_5":14121,"_26960":51073,"_2870":51325},[],"`preventive_delta`",{"_3383":977,"_29651":878,"_20578":51327,"_5":14121,"_26960":51073,"_2870":51328},[],"Preventive operational monitoring threshold.",{"_3383":978,"_29651":878,"_20578":51330,"_5":14121,"_26960":51073,"_2870":51331},[],"`critical_delta`",{"_3383":979,"_29651":878,"_20578":51333,"_5":14121,"_26960":51073,"_2870":51334},[],"Critical operational monitoring threshold.",{"_3383":980,"_29651":878,"_20578":51336,"_5":14121,"_26960":51073,"_2870":51337},[],"`enable_expired_renewal`",{"_3383":981,"_29651":878,"_20578":51339,"_5":14121,"_26960":51073,"_2870":51340},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_3383":982,"_29651":878,"_20578":51342,"_5":14121,"_26960":51073,"_2870":51343},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_3383":983,"_29651":878,"_20578":51345,"_5":14121,"_26960":51073,"_2870":51346},[],"Re-enrollment validation CAs for the renewal mTLS credential, tried after the enrollment CA; optional, because the enrollment CA is always trusted. Typically populated during CA rotation while old-CA cohorts renew.",{"_3383":984,"_29651":878,"_20578":51348,"_5":14121,"_26960":51073,"_2870":51349},[],"`revoke_on_reenrollment`",{"_3383":985,"_29651":878,"_20578":51351,"_5":14121,"_26960":51073,"_2870":51352},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_3383":986,"_29651":878,"_20578":51354,"_5":14121,"_26960":51073,"_2870":51355},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_3383":987,"_29651":878,"_20578":51357,"_5":14121,"_26960":51077,"_2870":51358},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. The console exposes it through an **Enable server-side key generation** switch and a **Key type** selection: `ECDSA` P-256, P-384 or P-521, or `RSA` with 2048, 3072 or 4096 bits; the defaults are P-256 for `ECDSA` and 4096 bit for `RSA`. Algorithm and size come from its `key` field, stored as `{type,bits}` where P-256, P-384 and P-521 map to `bits` 256, 384 and 521; `key` is omitted when disabled. The profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_3383":988,"_29651":878,"_20578":51360,"_5":14121,"_26960":51081,"_2870":48664},[],{"_3383":989,"_29651":878,"_20578":51362,"_5":14121,"_26960":51081,"_2870":51363},[],"Published material",{"_3383":990,"_29651":878,"_20578":51365,"_5":14121,"_26960":51081,"_2870":51366},[],"**Include Lamassu System CA**",{"_3383":991,"_29651":878,"_20578":51368,"_5":14121,"_26960":51081,"_2870":51369},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_3383":992,"_29651":878,"_20578":51371,"_5":14121,"_26960":51081,"_2870":51372},[],"**Include Enrollment CA**",{"_3383":993,"_29651":878,"_20578":51374,"_5":14121,"_26960":51081,"_2870":51375},[],"Selected issuing CA certificate.",{"_3383":994,"_29651":878,"_20578":51377,"_5":14121,"_26960":51081,"_2870":51378},[],"**Managed CAs**",{"_3383":995,"_29651":878,"_20578":51380,"_5":14121,"_26960":51081,"_2870":51381},[],"Explicitly selected CA certificates.",{"_3383":996,"_29651":878,"_20578":51383,"_5":14121,"_26960":51081,"_2870":51384},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_3383":997,"_29651":878,"_20578":51386,"_5":14121,"_26960":51085,"_2870":51387},[],"**Edit** changes name, settings and metadata. Updates go through the DMS API. `PUT /v1/dms/{id}` always targets the DMS identified by the URL path: the body carries no `id` field, and any `id` or `creation_ts` in it is silently ignored — authorization is evaluated against the same URL identifier. The body must include a non-empty `name` and a `settings` object; missing either returns HTTP 400 and leaves the stored DMS unchanged. `name` and `settings` are always full replacements, so read the DMS before sending API edits to avoid losing fields. `metadata` is optional: omitting it or sending `null` keeps the stored metadata, a supplied object replaces it entirely, and `{}` clears it (a later GET returns an empty object, not `null`). Old-style bodies that carry the full DMS object keep working while they include `name` and `settings`; unknown fields are ignored. Updates reject an empty `name` with HTTP 400: a DMS whose stored name was zeroed by an earlier update must be renamed before any client round-trips it — the AWS IoT connector’s JITP writeback included. If the object does not include the AWS IoT connector key (`lamassu.io/iot/{connector_id}`), the connector ignores the DMS's later events.",{"_3383":998,"_29651":878,"_20578":51389,"_5":14121,"_26960":51085,"_2870":51390},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_3383":999,"_29651":878,"_20578":51392,"_5":14121,"_26960":51085,"_2870":51393},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_3383":1000,"_29651":878,"_20578":51395,"_5":14121,"_26960":51089,"_2870":51396},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_3383":1001,"_29651":1001,"_5":14473,"_2870":51398,"_30004":51399,"_20578":51400,"_26960":1001},"Integrate the EST client",[48280,49748,50759,50757,50940],[],{"_3383":1002,"_29651":1001,"_20578":51402,"_5":14121,"_26960":1001,"_2870":51403},[],"Prepare trust, send a CSR and check the identity you receive.",{"_3383":1003,"_29651":1001,"_5":30001,"_20578":51405,"_26960":51406,"_2870":48290},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_3383":1004,"_29651":1001,"_5":30001,"_20578":51408,"_26960":51409,"_2870":51410},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_3383":1005,"_29651":1001,"_5":30001,"_20578":51412,"_26960":51413,"_2870":51414},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_3383":1006,"_29651":1001,"_5":30001,"_20578":51416,"_26960":51417,"_2870":51418},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_3383":1007,"_29651":1001,"_5":30001,"_20578":51420,"_26960":51421,"_2870":51422},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_3383":1008,"_29651":1001,"_5":30001,"_20578":51424,"_26960":51425,"_2870":51426},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_3383":1009,"_29651":1001,"_20578":51428,"_5":14121,"_26960":1001,"_2870":51429},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_3383":1010,"_29651":1001,"_20578":51431,"_5":14121,"_26960":51406,"_2870":51432},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_3383":1011,"_29651":1001,"_20578":51434,"_5":14121,"_26960":51406,"_2870":51435},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_3383":1012,"_29651":1001,"_20578":51437,"_5":14121,"_26960":51406,"_2870":51438},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_3383":1013,"_29651":1001,"_20578":51440,"_5":14121,"_26960":51409,"_2870":51441},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_3383":1014,"_29651":1001,"_20578":51443,"_5":14121,"_26960":51409,"_2870":51444},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_3383":1015,"_29651":1001,"_20578":51446,"_5":14121,"_26960":51413,"_2870":51447},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_3383":1016,"_29651":1001,"_20578":51449,"_5":14121,"_26960":51413,"_2870":51450},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_3383":1017,"_29651":1001,"_20578":51452,"_5":14121,"_26960":51417,"_2870":51453},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_3383":1018,"_29651":1001,"_20578":51455,"_5":14121,"_26960":51417,"_2870":51456},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_3383":1019,"_29651":1001,"_20578":51458,"_5":14121,"_26960":51421,"_2870":51459},[],"For a root that issues directly:",{"_3383":1020,"_29651":1001,"_20578":51461,"_5":14121,"_26960":51421,"_2870":51462},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_3383":1021,"_29651":1001,"_20578":51464,"_5":14121,"_26960":51421,"_2870":51465},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_3383":1022,"_29651":1001,"_20578":51467,"_5":14121,"_26960":51425,"_2870":51468},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_3383":1023,"_29651":1023,"_5":14473,"_2870":51470,"_30004":51471,"_20578":51472,"_26960":1023},"EST reference",[48280,49748,50759,50757,50940],[],{"_3383":1024,"_29651":1023,"_20578":51474,"_5":14121,"_26960":1023,"_2870":51475},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_3383":1025,"_29651":1023,"_5":30001,"_20578":51477,"_26960":51478,"_2870":51479},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_3383":1026,"_29651":1023,"_5":30001,"_20578":51481,"_26960":51482,"_2870":22306},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3383":1027,"_29651":1023,"_5":30001,"_20578":51484,"_26960":51485,"_2870":25596},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3383":1028,"_29651":1023,"_5":30001,"_20578":51487,"_26960":51488,"_2870":25603},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3383":1029,"_29651":1023,"_5":30001,"_20578":51490,"_26960":51491,"_2870":24926},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3383":1030,"_29651":1023,"_5":30001,"_20578":51493,"_26960":51494,"_2870":51495},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_3383":1031,"_29651":1023,"_5":30001,"_20578":51497,"_26960":51498,"_2870":51499},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_3383":1032,"_29651":1023,"_5":30001,"_20578":51501,"_26960":51502,"_2870":51503},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_3383":1033,"_29651":1023,"_20578":51505,"_5":14121,"_26960":1023,"_2870":51506},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_3383":1034,"_29651":1023,"_20578":51508,"_5":14121,"_26960":51478,"_2870":51509},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_3383":1035,"_29651":1023,"_20578":51511,"_5":14121,"_26960":51478,"_2870":51512},[],"Operation",{"_3383":1036,"_29651":1023,"_20578":51514,"_5":14121,"_26960":51478,"_2870":51515},[],"Method",{"_3383":1037,"_29651":1023,"_20578":51517,"_5":14121,"_26960":51478,"_2870":51518},[],"Authentication and condition",{"_3383":1038,"_29651":1023,"_20578":51520,"_5":14121,"_26960":51478,"_2870":51521},[],"`/cacerts`",{"_3383":1039,"_29651":1023,"_20578":51523,"_5":14121,"_26960":51478,"_2870":51524},[],"GET",{"_3383":1040,"_29651":1023,"_20578":51526,"_5":14121,"_26960":51478,"_2870":51527},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_3383":1041,"_29651":1023,"_20578":51529,"_5":14121,"_26960":51478,"_2870":51530},[],"`/simpleenroll`",{"_3383":1042,"_29651":1023,"_20578":51532,"_5":14121,"_26960":51478,"_2870":51533},[],"POST",{"_3383":1043,"_29651":1023,"_20578":51535,"_5":14121,"_26960":51478,"_2870":51536},[],"Initial authentication and DMS registration/replacement policy.",{"_3383":1044,"_29651":1023,"_20578":51538,"_5":14121,"_26960":51478,"_2870":51539},[],"`/simplereenroll`",{"_3383":1045,"_29651":1023,"_20578":51541,"_5":14121,"_26960":51478,"_2870":51533},[],{"_3383":1046,"_29651":1023,"_20578":51543,"_5":14121,"_26960":51478,"_2870":51544},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_3383":1047,"_29651":1023,"_20578":51546,"_5":14121,"_26960":51478,"_2870":51547},[],"`/serverkeygen`",{"_3383":1048,"_29651":1023,"_20578":51549,"_5":14121,"_26960":51478,"_2870":51533},[],{"_3383":1049,"_29651":1023,"_20578":51551,"_5":14121,"_26960":51478,"_2870":51552},[],"Initial authentication and admission; server generation enabled.",{"_3383":1050,"_29651":1023,"_20578":51554,"_5":14121,"_26960":51478,"_2870":51555},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_3383":1051,"_29651":1023,"_20578":51557,"_5":14121,"_26960":51482,"_2870":51558},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_3383":1052,"_29651":1023,"_20578":51560,"_5":14121,"_26960":51482,"_2870":51561},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_3383":1053,"_29651":1023,"_20578":51563,"_5":14121,"_26960":51485,"_2870":51564},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_3383":1054,"_29651":1023,"_20578":51566,"_5":14121,"_26960":51485,"_2870":51567},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_3383":1055,"_29651":1023,"_20578":51569,"_5":14121,"_26960":51488,"_2870":51570},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_3383":1056,"_29651":1023,"_20578":51572,"_5":14121,"_26960":51488,"_2870":51573},[],"In mTLS mode, the enrollment CA always validates the re-enrollment credential; certificates from other issuers are accepted only if they are listed as validation CAs in the re-enrollment block. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_3383":1057,"_29651":1023,"_20578":51575,"_5":14121,"_26960":51491,"_2870":51576},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_3383":1058,"_29651":1023,"_20578":51578,"_5":14121,"_26960":51491,"_2870":51579},[],"The code supports RSA and ECDSA, and the `bits` value of the DMS key setting means something different for each. For ECDSA it selects the curve: 224, 256, 384 or 521 map to P-224, P-256, P-384 and P-521, and an unrecognized size falls back to P-256, so explicitly select a compatible size and check the resulting key. For RSA it is used directly as the modulus size; the console offers 2048, 3072 and 4096 bits. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_3383":1059,"_29651":1023,"_20578":51581,"_5":14121,"_26960":51494,"_2870":51582},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_3383":1060,"_29651":1023,"_20578":51584,"_5":14121,"_26960":51494,"_2870":51585},[],"Part",{"_3383":1061,"_29651":1023,"_20578":51587,"_5":14121,"_26960":51494,"_2870":51588},[],"Content after decoding its Base64",{"_3383":1062,"_29651":1023,"_20578":51590,"_5":14121,"_26960":51494,"_2870":51591},[],"`application/pkcs8`",{"_3383":1063,"_29651":1023,"_20578":51593,"_5":14121,"_26960":51494,"_2870":51594},[],"Unencrypted DER PKCS#8 private key.",{"_3383":1064,"_29651":1023,"_20578":51596,"_5":14121,"_26960":51494,"_2870":51597},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_3383":1065,"_29651":1023,"_20578":51599,"_5":14121,"_26960":51494,"_2870":51600},[],"DER PKCS#7 containing the issued certificate.",{"_3383":1066,"_29651":1023,"_20578":51602,"_5":14121,"_26960":51494,"_2870":51603},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_3383":1067,"_29651":1023,"_20578":51605,"_5":14121,"_26960":51498,"_2870":51606},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_3383":1068,"_29651":1023,"_20578":51608,"_5":14121,"_26960":51498,"_2870":51609},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_3383":1069,"_29651":1023,"_20578":51611,"_5":14121,"_26960":51498,"_2870":51612},[],"Convert and check the result:",{"_3383":1070,"_29651":1023,"_20578":51614,"_5":14121,"_26960":51498,"_2870":51615},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_3383":1071,"_29651":1023,"_20578":51617,"_5":14121,"_26960":51502,"_2870":51618},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_3383":1072,"_29651":1023,"_20578":51620,"_5":14121,"_26960":51502,"_2870":51621},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_3383":1073,"_29651":1073,"_5":14473,"_2870":50940,"_30004":51623,"_20578":51624,"_26960":1073},[48280,49748,50759,50757,50940],[],{"_3383":1074,"_29651":1073,"_20578":51626,"_5":14121,"_26960":1073,"_2870":51627},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_3383":1075,"_29651":1073,"_5":30001,"_20578":51629,"_26960":51630,"_2870":51631},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_3383":1076,"_29651":1073,"_5":30001,"_20578":51633,"_26960":51634,"_2870":51635},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_3383":1077,"_29651":1073,"_5":30001,"_20578":51637,"_26960":51638,"_2870":51639},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_3383":1078,"_29651":1073,"_5":30001,"_20578":51641,"_26960":51642,"_2870":51643},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_3383":1079,"_29651":1073,"_20578":51645,"_5":14121,"_26960":1073,"_2870":51646},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_3383":1080,"_29651":1073,"_20578":51648,"_5":14121,"_26960":51630,"_2870":51649},[],"The administrator prepares the CA, issuance profile and DMS.",{"_3383":1081,"_29651":1073,"_20578":51651,"_5":14121,"_26960":51630,"_2870":51652},[],"The integrator installs initial EST server trust and an admission credential.",{"_3383":1082,"_29651":1073,"_20578":51654,"_5":14121,"_26960":51630,"_2870":51655},[],"The client requests an identity for its `Device ID` through EST.",{"_3383":1083,"_29651":1073,"_20578":51657,"_5":14121,"_26960":51630,"_2870":51658},[],"Certificate, device binding and key/certificate installation are checked.",{"_3383":1084,"_29651":1073,"_20578":51660,"_5":14121,"_26960":51630,"_2870":51661},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_3383":1085,"_29651":1073,"_20578":51663,"_5":14121,"_26960":51630,"_2870":51664},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_3383":1086,"_29651":1073,"_20578":51666,"_5":14121,"_26960":51634,"_2870":51667},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3383":1087,"_29651":1073,"_20578":51669,"_5":14121,"_26960":51634,"_2870":51670},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3383":1088,"_29651":1073,"_20578":51672,"_5":14121,"_26960":51634,"_2870":51673},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3383":1089,"_29651":1073,"_20578":51675,"_5":14121,"_26960":51634,"_2870":51676},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3383":1090,"_29651":1073,"_20578":51678,"_5":14121,"_26960":51638,"_2870":51679},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3383":1091,"_29651":1073,"_20578":51681,"_5":14121,"_26960":51638,"_2870":51682},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3383":1092,"_29651":1073,"_20578":51684,"_5":14121,"_26960":51638,"_2870":51685},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3383":1093,"_29651":1073,"_20578":51687,"_5":14121,"_26960":51638,"_2870":51688},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3383":1094,"_29651":1073,"_20578":51690,"_5":14121,"_26960":51642,"_2870":51691},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_3383":1095,"_29651":1073,"_20578":51693,"_5":14121,"_26960":51642,"_2870":51694},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_3383":1096,"_29651":1096,"_5":14473,"_2870":51696,"_30004":51697,"_20578":51698,"_26960":1096},"Provisioning strategies",[48280,49748,50759,50757,50940],[],{"_3383":1097,"_29651":1096,"_20578":51700,"_5":14121,"_26960":1096,"_2870":51701},[],"Choose device registration, identity authorization and key generation.",{"_3383":1098,"_29651":1096,"_5":30001,"_20578":51703,"_26960":51704,"_2870":51705},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_3383":1099,"_29651":1096,"_5":30001,"_20578":51707,"_26960":51708,"_2870":51709},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_3383":1100,"_29651":1096,"_5":30001,"_20578":51711,"_26960":51712,"_2870":51713},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_3383":1101,"_29651":1096,"_5":30001,"_20578":51715,"_26960":51716,"_2870":51717},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_3383":1102,"_29651":1096,"_5":30001,"_20578":51719,"_26960":51720,"_2870":51721},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_3383":1103,"_29651":1096,"_20578":51723,"_5":14121,"_26960":1096,"_2870":51724},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_3383":1104,"_29651":1096,"_20578":51726,"_5":14121,"_26960":51704,"_2870":51727},[],"Path",{"_3383":1105,"_29651":1096,"_20578":51729,"_5":14121,"_26960":51704,"_2870":51730},[],"When the device exists",{"_3383":1106,"_29651":1096,"_20578":51732,"_5":14121,"_26960":51704,"_2870":51733},[],"What to check",{"_3383":1107,"_29651":1096,"_20578":51735,"_5":14121,"_26960":51704,"_2870":51736},[],"Manual assignment",{"_3383":1108,"_29651":1096,"_20578":51738,"_5":14121,"_26960":51704,"_2870":51739},[],"An operator creates it before associating a certificate.",{"_3383":1109,"_29651":1096,"_20578":51741,"_5":14121,"_26960":51704,"_2870":51742},[],"ID, owning DMS, certificate CN and bound serial.",{"_3383":1110,"_29651":1096,"_20578":51744,"_5":14121,"_26960":51704,"_2870":51745},[],"EST with `JITP`",{"_3383":1111,"_29651":1096,"_20578":51747,"_5":14121,"_26960":51704,"_2870":51748},[],"Created for an unknown CN during `/simpleenroll`.",{"_3383":1112,"_29651":1096,"_20578":51750,"_5":14121,"_26960":51704,"_2870":51751},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_3383":1113,"_29651":1096,"_20578":51753,"_5":14121,"_26960":51704,"_2870":51754},[],"EST with `PRE_REGISTRATION`",{"_3383":1114,"_29651":1096,"_20578":51756,"_5":14121,"_26960":51704,"_2870":51757},[],"Must exist before `/simpleenroll`.",{"_3383":1115,"_29651":1096,"_20578":51759,"_5":14121,"_26960":51704,"_2870":51760},[],"Approved record, same DMS and replacement conditions for your version.",{"_3383":1116,"_29651":1096,"_20578":51762,"_5":14121,"_26960":51704,"_2870":51763},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_3383":1117,"_29651":1096,"_20578":51765,"_5":14121,"_26960":51704,"_2870":51766},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_3383":1118,"_29651":1096,"_20578":51768,"_5":14121,"_26960":51708,"_2870":51769},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_3383":1119,"_29651":1096,"_20578":51771,"_5":14121,"_26960":51708,"_2870":51772},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_3383":1120,"_29651":1096,"_20578":51774,"_5":14121,"_26960":51708,"_2870":51775},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_3383":1121,"_29651":1096,"_20578":51777,"_5":14121,"_26960":51712,"_2870":51778},[],"Decide initial enrollment and re-enrollment separately:",{"_3383":1122,"_29651":1096,"_20578":51780,"_5":14121,"_26960":51712,"_2870":51781},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_3383":1123,"_29651":1096,"_20578":51783,"_5":14121,"_26960":51712,"_2870":51784},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_3383":1124,"_29651":1096,"_20578":51786,"_5":14121,"_26960":51712,"_2870":51787},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_3383":1125,"_29651":1096,"_20578":51789,"_5":14121,"_26960":51712,"_2870":51790},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_3383":1126,"_29651":1096,"_20578":51792,"_5":14121,"_26960":51712,"_2870":51793},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_3383":1127,"_29651":1096,"_20578":51795,"_5":14121,"_26960":51716,"_2870":48664},[],{"_3383":1128,"_29651":1096,"_20578":51797,"_5":14121,"_26960":51716,"_2870":51798},[],"Material crossing EST",{"_3383":1129,"_29651":1096,"_20578":51800,"_5":14121,"_26960":51716,"_2870":51801},[],"Device-generated key",{"_3383":1130,"_29651":1096,"_20578":51803,"_5":14121,"_26960":51716,"_2870":51804},[],"Public CSR and certificate; the key stays on the client.",{"_3383":1131,"_29651":1096,"_20578":51806,"_5":14121,"_26960":51716,"_2870":51807},[],"Existing device key",{"_3383":1132,"_29651":1096,"_20578":51809,"_5":14121,"_26960":51716,"_2870":51810},[],"CSR signed with that key and a new certificate.",{"_3383":1133,"_29651":1096,"_20578":51812,"_5":14121,"_26960":51716,"_2870":51078},[],{"_3383":1134,"_29651":1096,"_20578":51814,"_5":14121,"_26960":51716,"_2870":51815},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_3383":1135,"_29651":1096,"_20578":51817,"_5":14121,"_26960":51716,"_2870":51818},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_3383":1136,"_29651":1096,"_20578":51820,"_5":14121,"_26960":51720,"_2870":51821},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_3383":1137,"_29651":1137,"_5":14473,"_2870":51823,"_30004":51824,"_20578":51825,"_26960":1137},"Renewal and recovery",[48280,49748,50759,50757,50940],[],{"_3383":1138,"_29651":1137,"_20578":51827,"_5":14121,"_26960":1137,"_2870":51828},[],"Renew without losing the identity and recover devices according to their actual state.",{"_3383":1139,"_29651":1137,"_5":30001,"_20578":51830,"_26960":51831,"_2870":51832},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_3383":1140,"_29651":1137,"_5":30001,"_20578":51834,"_26960":51835,"_2870":51836},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_3383":1141,"_29651":1137,"_5":30001,"_20578":51838,"_26960":51839,"_2870":51840},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_3383":1142,"_29651":1137,"_5":30001,"_20578":51842,"_26960":51843,"_2870":51844},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_3383":1143,"_29651":1137,"_5":30001,"_20578":51846,"_26960":51847,"_2870":51848},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_3383":1144,"_29651":1137,"_20578":51850,"_5":14121,"_26960":1137,"_2870":51851},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_3383":1145,"_29651":1137,"_20578":51853,"_5":14121,"_26960":51831,"_2870":51854},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_3383":1146,"_29651":1137,"_20578":51856,"_5":14121,"_26960":51831,"_2870":51857},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_3383":1147,"_29651":1137,"_20578":51859,"_5":14121,"_26960":51831,"_2870":51860},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_3383":1148,"_29651":1137,"_20578":51862,"_5":14121,"_26960":51831,"_2870":51863},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_3383":1149,"_29651":1137,"_20578":51865,"_5":14121,"_26960":51835,"_2870":51866},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_3383":1150,"_29651":1137,"_20578":51868,"_5":14121,"_26960":51835,"_2870":51869},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_3383":1151,"_29651":1137,"_20578":51871,"_5":14121,"_26960":51839,"_2870":51872},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_3383":1152,"_29651":1137,"_20578":51874,"_5":14121,"_26960":51839,"_2870":51875},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_3383":1153,"_29651":1137,"_20578":51877,"_5":14121,"_26960":51839,"_2870":51878},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_3383":1154,"_29651":1137,"_20578":51880,"_5":14121,"_26960":51843,"_2870":51881},[],"Situation",{"_3383":1155,"_29651":1137,"_20578":51883,"_5":14121,"_26960":51843,"_2870":51884},[],"Procedure",{"_3383":1156,"_29651":1137,"_20578":51886,"_5":14121,"_26960":51843,"_2870":51887},[],"Valid certificate, outside the window",{"_3383":1157,"_29651":1137,"_20578":51889,"_5":14121,"_26960":51843,"_2870":51890},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_3383":1158,"_29651":1137,"_20578":51892,"_5":14121,"_26960":51843,"_2870":51893},[],"Expired certificate, key available",{"_3383":1159,"_29651":1137,"_20578":51895,"_5":14121,"_26960":51843,"_2870":51896},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_3383":1160,"_29651":1137,"_20578":51898,"_5":14121,"_26960":51843,"_2870":51899},[],"Renewal through webhook or `NO_AUTH`",{"_3383":1161,"_29651":1137,"_20578":51901,"_5":14121,"_26960":51843,"_2870":51902},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_3383":1162,"_29651":1137,"_20578":51904,"_5":14121,"_26960":51843,"_2870":51905},[],"Lost or inaccessible key",{"_3383":1163,"_29651":1137,"_20578":51907,"_5":14121,"_26960":51843,"_2870":51908},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_3383":1164,"_29651":1137,"_20578":51910,"_5":14121,"_26960":51843,"_2870":51911},[],"Current identity revoked",{"_3383":1165,"_29651":1137,"_20578":51913,"_5":14121,"_26960":51843,"_2870":51914},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_3383":1166,"_29651":1137,"_20578":51916,"_5":14121,"_26960":51843,"_2870":51917},[],"Device without an identity",{"_3383":1167,"_29651":1137,"_20578":51919,"_5":14121,"_26960":51843,"_2870":51920},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_3383":1168,"_29651":1137,"_20578":51922,"_5":14121,"_26960":51843,"_2870":51923},[],"Retired device",{"_3383":1169,"_29651":1137,"_20578":51925,"_5":14121,"_26960":51843,"_2870":51926},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_3383":1170,"_29651":1137,"_20578":51928,"_5":14121,"_26960":51843,"_2870":51929},[],"Timeout, HTTP 500 or installation failure",{"_3383":1171,"_29651":1137,"_20578":51931,"_5":14121,"_26960":51843,"_2870":51932},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_3383":1172,"_29651":1137,"_20578":51934,"_5":14121,"_26960":51847,"_2870":51935},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_3383":1173,"_29651":1137,"_20578":51937,"_5":14121,"_26960":51847,"_2870":51938},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_3383":1174,"_29651":1174,"_5":14473,"_2870":51940,"_30004":51941,"_20578":51942,"_26960":1174},"Enrollment troubleshooting",[48280,49748,50759,50757,50940],[],{"_3383":1175,"_29651":1174,"_20578":51944,"_5":14121,"_26960":1174,"_2870":51945},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_3383":1176,"_29651":1174,"_5":30001,"_20578":51947,"_26960":51948,"_2870":51949},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_3383":1177,"_29651":1174,"_5":30001,"_20578":51951,"_26960":51952,"_2870":51953},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_3383":1178,"_29651":1174,"_5":30001,"_20578":51955,"_26960":51956,"_2870":51503},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_3383":1179,"_29651":1174,"_5":30001,"_20578":51958,"_26960":51959,"_2870":51960},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_3383":1180,"_29651":1174,"_20578":51962,"_5":14121,"_26960":1174,"_2870":51963},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_3383":1181,"_29651":1174,"_20578":51965,"_5":14121,"_26960":51952,"_2870":51966},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_3383":1182,"_29651":1174,"_20578":51968,"_5":14121,"_26960":51952,"_2870":51969},[],"Symptom or message",{"_3383":1183,"_29651":1174,"_20578":51971,"_5":14121,"_26960":51952,"_2870":51733},[],{"_3383":1184,"_29651":1174,"_20578":51973,"_5":14121,"_26960":51952,"_2870":51974},[],"curl rejects TLS, name or issuer",{"_3383":1185,"_29651":1174,"_20578":51976,"_5":14121,"_26960":51952,"_2870":51977},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_3383":1186,"_29651":1174,"_20578":51979,"_5":14121,"_26960":51952,"_2870":51980},[],"404 or missing APS",{"_3383":1187,"_29651":1174,"_20578":51982,"_5":14121,"_26960":51952,"_2870":51983},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_3383":1188,"_29651":1174,"_20578":51985,"_5":14121,"_26960":51952,"_2870":51986},[],"400, CSR or format error",{"_3383":1189,"_29651":1174,"_20578":51988,"_5":14121,"_26960":51952,"_2870":51989},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_3383":1190,"_29651":1174,"_20578":51991,"_5":14121,"_26960":51952,"_2870":51992},[],"Missing credential or invalid certificate",{"_3383":1191,"_29651":1174,"_20578":51994,"_5":14121,"_26960":51952,"_2870":51995},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_3383":1192,"_29651":1174,"_20578":51997,"_5":14121,"_26960":51952,"_2870":51998},[],"Webhook denies, times out or responds without authorization",{"_3383":1193,"_29651":1174,"_20578":52000,"_5":14121,"_26960":51952,"_2870":52001},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_3383":1194,"_29651":1174,"_20578":52003,"_5":14121,"_26960":51952,"_2870":52004},[],"`unexpected status code: <n>: redirects are not followed`",{"_3383":1195,"_29651":1174,"_20578":52006,"_5":14121,"_26960":51952,"_2870":52007},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_3383":1196,"_29651":1174,"_20578":52009,"_5":14121,"_26960":51952,"_2870":52010},[],"`webhook response exceeds 1048576 bytes`",{"_3383":1197,"_29651":1174,"_20578":52012,"_5":14121,"_26960":51952,"_2870":52013},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_3383":1198,"_29651":1174,"_20578":52015,"_5":14121,"_26960":51952,"_2870":52016},[],"`webhook config must not reference files`",{"_3383":1199,"_29651":1174,"_20578":52018,"_5":14121,"_26960":51952,"_2870":52019},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_3383":1200,"_29651":1174,"_20578":52021,"_5":14121,"_26960":51952,"_2870":52022},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_3383":1201,"_29651":1174,"_20578":52024,"_5":14121,"_26960":51952,"_2870":52025},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_3383":1202,"_29651":1174,"_20578":52027,"_5":14121,"_26960":51952,"_2870":52028},[],"`webhook mTLS certificate and key are invalid: …`",{"_3383":1203,"_29651":1174,"_20578":52030,"_5":14121,"_26960":51952,"_2870":52031},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_3383":1204,"_29651":1174,"_20578":52033,"_5":14121,"_26960":51952,"_2870":52034},[],"400 `struct validation error` creating or updating a DMS",{"_3383":1205,"_29651":1174,"_20578":52036,"_5":14121,"_26960":51952,"_2870":52037},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_3383":1206,"_29651":1174,"_20578":52039,"_5":14121,"_26960":51952,"_2870":52040},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_3383":1207,"_29651":1174,"_20578":52042,"_5":14121,"_26960":51952,"_2870":52043},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_3383":1208,"_29651":1174,"_20578":52045,"_5":14121,"_26960":51952,"_2870":52046},[],"`device not preregistered`",{"_3383":1209,"_29651":1174,"_20578":52048,"_5":14121,"_26960":51952,"_2870":52049},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_3383":1210,"_29651":1174,"_20578":52051,"_5":14121,"_26960":51952,"_2870":52052},[],"`forbiddenNewEnrollment`",{"_3383":1211,"_29651":1174,"_20578":52054,"_5":14121,"_26960":51952,"_2870":52055},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_3383":1212,"_29651":1174,"_20578":52057,"_5":14121,"_26960":51952,"_2870":52058},[],"Different owning DMS",{"_3383":1213,"_29651":1174,"_20578":52060,"_5":14121,"_26960":51952,"_2870":52061},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_3383":1214,"_29651":1174,"_20578":52063,"_5":14121,"_26960":51952,"_2870":52064},[],"`invalid RawSubject bytes`",{"_3383":1215,"_29651":1174,"_20578":52066,"_5":14121,"_26960":51952,"_2870":52067},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_3383":1216,"_29651":1174,"_20578":52069,"_5":14121,"_26960":51952,"_2870":52070},[],"`invalid reenroll window`",{"_3383":1217,"_29651":1174,"_20578":52072,"_5":14121,"_26960":51952,"_2870":52073},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_3383":1218,"_29651":1174,"_20578":52075,"_5":14121,"_26960":51952,"_2870":52076},[],"Current certificate revoked",{"_3383":1219,"_29651":1174,"_20578":52078,"_5":14121,"_26960":51952,"_2870":52079},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_3383":1220,"_29651":1174,"_20578":52081,"_5":14121,"_26960":51952,"_2870":52082},[],"CA, profile or signing error",{"_3383":1221,"_29651":1174,"_20578":52084,"_5":14121,"_26960":51952,"_2870":52085},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_3383":1222,"_29651":1174,"_20578":52087,"_5":14121,"_26960":51952,"_2870":52088},[],"HTTP 200 without a device connection",{"_3383":1223,"_29651":1174,"_20578":52090,"_5":14121,"_26960":51952,"_2870":52091},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_3383":1224,"_29651":1174,"_20578":52093,"_5":14121,"_26960":51952,"_2870":52094},[],"Timeout or error after issuance",{"_3383":1225,"_29651":1174,"_20578":52096,"_5":14121,"_26960":51952,"_2870":52097},[],"New certificates, current slot and previous identity's state before retrying.",{"_3383":1226,"_29651":1174,"_20578":52099,"_5":14121,"_26960":51956,"_2870":52100},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_3383":1227,"_29651":1174,"_20578":52102,"_5":14121,"_26960":51956,"_2870":52103},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_3383":1228,"_29651":1174,"_20578":52105,"_5":14121,"_26960":51959,"_2870":52106},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_3383":1229,"_29651":1174,"_20578":52108,"_5":14121,"_26960":51959,"_2870":52109},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_3383":1230,"_29651":1174,"_20578":52111,"_5":14121,"_26960":51959,"_2870":52112},[],"Verify the CSR locally and relate its CN to the inventory.",{"_3383":1231,"_29651":1174,"_20578":52114,"_5":14121,"_26960":51959,"_2870":52115},[],"Make one request, save headers/body and query the device and certificates.",{"_3383":1232,"_29651":1174,"_20578":52117,"_5":14121,"_26960":51959,"_2870":52118},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_3383":1233,"_29651":1174,"_20578":52120,"_5":14121,"_26960":51959,"_2870":52121},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_3383":1234,"_29651":1174,"_20578":52123,"_5":14121,"_26960":51959,"_2870":52124},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_3383":1235,"_29651":1235,"_5":14473,"_2870":52126,"_30004":52127,"_20578":52128,"_26960":1235},"Trust distribution and updates",[48280,49748,50759,50757,50940],[],{"_3383":1236,"_29651":1235,"_20578":52130,"_5":14121,"_26960":1235,"_2870":52131},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_3383":1237,"_29651":1235,"_5":30001,"_20578":52133,"_26960":52134,"_2870":52135},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_3383":1238,"_29651":1235,"_5":30001,"_20578":52137,"_26960":52138,"_2870":52139},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_3383":1239,"_29651":1235,"_5":30001,"_20578":52141,"_26960":52142,"_2870":52143},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_3383":1240,"_29651":1235,"_5":30001,"_20578":52145,"_26960":52146,"_2870":52147},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_3383":1241,"_29651":1235,"_5":30001,"_20578":52149,"_26960":52150,"_2870":52151},[],"/docs/pr-preview/pr-55/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_3383":1242,"_29651":1235,"_20578":52153,"_5":14121,"_26960":1235,"_2870":52154},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_3383":1243,"_29651":1235,"_20578":52156,"_5":14121,"_26960":52134,"_2870":52157},[],"Relationship",{"_3383":1244,"_29651":1235,"_20578":52159,"_5":14121,"_26960":52134,"_2870":52160},[],"Material prepared by its owner",{"_3383":1245,"_29651":1235,"_20578":52162,"_5":14121,"_26960":52134,"_2870":52163},[],"Device → EST server",{"_3383":1246,"_29651":1235,"_20578":52165,"_5":14121,"_26960":52134,"_2870":52166},[],"Previously verified server root, chain or pin and TLS name.",{"_3383":1247,"_29651":1235,"_20578":52168,"_5":14121,"_26960":52134,"_2870":52169},[],"DMS → requester",{"_3383":1248,"_29651":1235,"_20578":52171,"_5":14121,"_26960":52134,"_2870":52172},[],"CAs and rules authorizing initial or renewal credentials.",{"_3383":1249,"_29651":1235,"_20578":52174,"_5":14121,"_26960":52134,"_2870":52175},[],"Consumer → device",{"_3383":1250,"_29651":1235,"_20578":52177,"_5":14121,"_26960":52134,"_2870":52178},[],"Operational identity roots, intermediates, validation and permissions.",{"_3383":1251,"_29651":1235,"_20578":52180,"_5":14121,"_26960":52134,"_2870":52181},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_3383":1252,"_29651":1235,"_20578":52183,"_5":14121,"_26960":52138,"_2870":52184},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_3383":1253,"_29651":1235,"_20578":52186,"_5":14121,"_26960":52138,"_2870":52187},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_3383":1254,"_29651":1235,"_20578":52189,"_5":14121,"_26960":52142,"_2870":52190},[],"Keep initial EST server trust separate from identity consumer trust.",{"_3383":1255,"_29651":1235,"_20578":52192,"_5":14121,"_26960":52142,"_2870":52193},[],"Select policy-approved roots as anchors.",{"_3383":1256,"_29651":1235,"_20578":52195,"_5":14121,"_26960":52142,"_2870":52196},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_3383":1257,"_29651":1235,"_20578":52198,"_5":14121,"_26960":52142,"_2870":52199},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_3383":1258,"_29651":1235,"_20578":52201,"_5":14121,"_26960":52142,"_2870":52202},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_3383":1259,"_29651":1235,"_20578":52204,"_5":14121,"_26960":52142,"_2870":52205},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_3383":1260,"_29651":1235,"_20578":52207,"_5":14121,"_26960":52146,"_2870":52208},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_3383":1261,"_29651":1235,"_20578":52210,"_5":14121,"_26960":52146,"_2870":52211},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. That list is optional because the enrollment CA always validates re-enrollment credentials, but when switching the enrollment CA, add the previous issuance CA to it so old-CA identities keep re-enrolling during overlap. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_3383":1262,"_29651":1235,"_20578":52213,"_5":14121,"_26960":52146,"_2870":52214},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_3383":1263,"_29651":1235,"_20578":52216,"_5":14121,"_26960":52150,"_2870":52217},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_3383":1264,"_29651":1264,"_5":14473,"_2870":52219,"_30004":52220,"_20578":52222,"_26960":1264},"AWS IoT Core",[48280,49748,50759,50757,52221],"Integrations",[],{"_3383":1265,"_29651":1264,"_20578":52224,"_5":14121,"_26960":1264,"_2870":52225},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_3383":1266,"_29651":1264,"_5":30001,"_20578":52227,"_26960":52228,"_2870":52229},[],"/docs/pr-preview/pr-55/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_3383":1267,"_29651":1264,"_5":30001,"_20578":52231,"_26960":52232,"_2870":52233},[],"/docs/pr-preview/pr-55/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_3383":1268,"_29651":1264,"_5":30001,"_20578":52235,"_26960":52236,"_2870":52237},[],"/docs/pr-preview/pr-55/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_3383":1269,"_29651":1264,"_5":30001,"_20578":52239,"_26960":52240,"_2870":52241},[],"/docs/pr-preview/pr-55/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_3383":1270,"_29651":1264,"_5":30001,"_20578":52243,"_26960":52244,"_2870":52245},[],"/docs/pr-preview/pr-55/platform/iot-fleets/integrations/aws-iot-core#events-and-aws-resources","Events and AWS resources",{"_3383":1271,"_29651":1264,"_5":30001,"_20578":52247,"_26960":52248,"_2870":52249},[],"/docs/pr-preview/pr-55/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_3383":1272,"_29651":1264,"_5":30001,"_20578":52251,"_26960":52252,"_2870":52253},[],"/docs/pr-preview/pr-55/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_3383":1273,"_29651":1264,"_5":30001,"_20578":52255,"_26960":52256,"_2870":52257},[],"/docs/pr-preview/pr-55/platform/iot-fleets/integrations/aws-iot-core#ca-registration-states","CA registration states",{"_3383":1274,"_29651":1264,"_5":30001,"_20578":52259,"_26960":52260,"_2870":52261},[],"/docs/pr-preview/pr-55/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_3383":1275,"_29651":1264,"_5":30001,"_20578":52263,"_26960":52264,"_2870":52265},[],"/docs/pr-preview/pr-55/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3383":1276,"_29651":1264,"_5":30001,"_20578":52267,"_26960":52268,"_2870":52269},[],"/docs/pr-preview/pr-55/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_3383":1277,"_29651":1264,"_5":30001,"_20578":52271,"_26960":52272,"_2870":52273},[],"/docs/pr-preview/pr-55/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_3383":1278,"_29651":1264,"_5":30001,"_20578":52275,"_26960":52276,"_2870":52277},[],"/docs/pr-preview/pr-55/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_3383":1279,"_29651":1264,"_5":30001,"_20578":52279,"_26960":52280,"_2870":52281},[],"/docs/pr-preview/pr-55/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_3383":1280,"_29651":1264,"_5":30001,"_20578":52283,"_26960":52284,"_2870":52285},[],"/docs/pr-preview/pr-55/platform/iot-fleets/integrations/aws-iot-core#dms-registration-mode-states","DMS registration-mode states",{"_3383":1281,"_29651":1264,"_5":30001,"_20578":52287,"_26960":52288,"_2870":52289},[],"/docs/pr-preview/pr-55/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_3383":1282,"_29651":1264,"_5":30001,"_20578":52291,"_26960":52292,"_2870":52293},[],"/docs/pr-preview/pr-55/platform/iot-fleets/integrations/aws-iot-core#thing-lifecycle","Thing lifecycle",{"_3383":1283,"_29651":1264,"_5":30001,"_20578":52295,"_26960":52296,"_2870":52297},[],"/docs/pr-preview/pr-55/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_3383":1284,"_29651":1264,"_5":30001,"_20578":52299,"_26960":52300,"_2870":52301},[],"/docs/pr-preview/pr-55/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_3383":1285,"_29651":1264,"_5":30001,"_20578":52303,"_26960":52304,"_2870":52305},[],"/docs/pr-preview/pr-55/platform/iot-fleets/integrations/aws-iot-core#certificate-status-states","Certificate status states",{"_3383":1286,"_29651":1264,"_5":30001,"_20578":52307,"_26960":52308,"_2870":52309},[],"/docs/pr-preview/pr-55/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_3383":1287,"_29651":1264,"_5":30001,"_20578":52311,"_26960":52312,"_2870":52313},[],"/docs/pr-preview/pr-55/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_3383":1288,"_29651":1264,"_5":30001,"_20578":52315,"_26960":52316,"_2870":52317},[],"/docs/pr-preview/pr-55/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_3383":1289,"_29651":1264,"_5":30001,"_20578":52319,"_26960":52320,"_2870":52321},[],"/docs/pr-preview/pr-55/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_3383":1290,"_29651":1264,"_5":30001,"_20578":52323,"_26960":52324,"_2870":52325},[],"/docs/pr-preview/pr-55/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_3383":1291,"_29651":1264,"_20578":52327,"_5":14121,"_26960":1264,"_2870":52328},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_3383":1292,"_29651":1264,"_20578":52330,"_5":14121,"_26960":1264,"_2870":52331},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_3383":1293,"_29651":1264,"_20578":52333,"_5":14121,"_26960":1264,"_2870":52334},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_3383":1294,"_29651":1264,"_20578":52336,"_5":14121,"_26960":52228,"_2870":52337},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_3383":1295,"_29651":1264,"_20578":52339,"_5":14121,"_26960":52228,"_2870":52340},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_3383":1296,"_29651":1264,"_20578":52342,"_5":14121,"_26960":52228,"_2870":52343},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_3383":1297,"_29651":1264,"_20578":52345,"_5":14121,"_26960":52228,"_2870":52346},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_3383":1298,"_29651":1264,"_20578":52348,"_5":14121,"_26960":52232,"_2870":52349},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_3383":1299,"_29651":1264,"_20578":52351,"_5":14121,"_26960":52236,"_2870":52352},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_3383":1300,"_29651":1264,"_20578":52354,"_5":14121,"_26960":52236,"_2870":52355},[],"IAM action",{"_3383":1301,"_29651":1264,"_20578":52357,"_5":14121,"_26960":52236,"_2870":48670},[],{"_3383":1302,"_29651":1264,"_20578":52359,"_5":14121,"_26960":52236,"_2870":52360},[],"`iot:GetRegistrationCode`",{"_3383":1303,"_29651":1264,"_20578":52362,"_5":14121,"_26960":52236,"_2870":52363},[],"Obtain the verification code for CA registration in the Primary Account",{"_3383":1304,"_29651":1264,"_20578":52365,"_5":14121,"_26960":52236,"_2870":52366},[],"`iot:RegisterCACertificate`",{"_3383":1305,"_29651":1264,"_20578":52368,"_5":14121,"_26960":52236,"_2870":52369},[],"Register the CA in AWS IoT",{"_3383":1306,"_29651":1264,"_20578":52371,"_5":14121,"_26960":52236,"_2870":52372},[],"`iot:DescribeCACertificate`",{"_3383":1307,"_29651":1264,"_20578":52374,"_5":14121,"_26960":52236,"_2870":52375},[],"Check the CA registration status",{"_3383":1308,"_29651":1264,"_20578":52377,"_5":14121,"_26960":52236,"_2870":52378},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3383":1309,"_29651":1264,"_20578":52380,"_5":14121,"_26960":52236,"_2870":52381},[],"Create or update Things in IoT Core",{"_3383":1310,"_29651":1264,"_20578":52383,"_5":14121,"_26960":52236,"_2870":52384},[],"`iot:RegisterThing`",{"_3383":1311,"_29651":1264,"_20578":52386,"_5":14121,"_26960":52236,"_2870":52387},[],"Provision Things through a template",{"_3383":1312,"_29651":1264,"_20578":52389,"_5":14121,"_26960":52236,"_2870":52390},[],"`iot:RegisterCertificate`",{"_3383":1313,"_29651":1264,"_20578":52392,"_5":14121,"_26960":52236,"_2870":52393},[],"Register device certificates",{"_3383":1314,"_29651":1264,"_20578":52395,"_5":14121,"_26960":52236,"_2870":52396},[],"`iot:UpdateCertificate`",{"_3383":1315,"_29651":1264,"_20578":52398,"_5":14121,"_26960":52236,"_2870":52399},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_3383":1316,"_29651":1264,"_20578":52401,"_5":14121,"_26960":52236,"_2870":52402},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3383":1317,"_29651":1264,"_20578":52404,"_5":14121,"_26960":52236,"_2870":52405},[],"Create and attach IoT policies",{"_3383":1318,"_29651":1264,"_20578":52407,"_5":14121,"_26960":52236,"_2870":52408},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3383":1319,"_29651":1264,"_20578":52410,"_5":14121,"_26960":52236,"_2870":52411},[],"Manage Thing groups",{"_3383":1320,"_29651":1264,"_20578":52413,"_5":14121,"_26960":52236,"_2870":52414},[],"`iot:CreateProvisioningTemplate`",{"_3383":1321,"_29651":1264,"_20578":52416,"_5":14121,"_26960":52236,"_2870":52417},[],"Create JITP templates",{"_3383":1322,"_29651":1264,"_20578":52419,"_5":14121,"_26960":52236,"_2870":52420},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3383":1323,"_29651":1264,"_20578":52422,"_5":14121,"_26960":52236,"_2870":52423},[],"Read and write the Device Shadow",{"_3383":1324,"_29651":1264,"_20578":52425,"_5":14121,"_26960":52236,"_2870":52426},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_3383":1325,"_29651":1264,"_20578":52428,"_5":14121,"_26960":52240,"_2870":52429},[],"Parameter",{"_3383":1326,"_29651":1264,"_20578":52431,"_5":14121,"_26960":52240,"_2870":52432},[],"Type",{"_3383":1327,"_29651":1264,"_20578":52434,"_5":14121,"_26960":52240,"_2870":52435},[],"Required",{"_3383":1328,"_29651":1264,"_20578":52437,"_5":14121,"_26960":52240,"_2870":52438},[],"Description",{"_3383":1329,"_29651":1264,"_20578":52440,"_5":14121,"_26960":52240,"_2870":52441},[],"`connector_id`",{"_3383":1330,"_29651":1264,"_20578":52443,"_5":14121,"_26960":52240,"_2870":24582},[],{"_3383":1331,"_29651":1264,"_20578":52445,"_5":14121,"_26960":52240,"_2870":52446},[],"Yes",{"_3383":1332,"_29651":1264,"_20578":52448,"_5":14121,"_26960":52240,"_2870":52449},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_3383":1333,"_29651":1264,"_20578":52451,"_5":14121,"_26960":52240,"_2870":52452},[],"`aws_config.region`",{"_3383":1334,"_29651":1264,"_20578":52454,"_5":14121,"_26960":52240,"_2870":24582},[],{"_3383":1335,"_29651":1264,"_20578":52456,"_5":14121,"_26960":52240,"_2870":52446},[],{"_3383":1336,"_29651":1264,"_20578":52458,"_5":14121,"_26960":52240,"_2870":52459},[],"AWS region where the connector operates.",{"_3383":1337,"_29651":1264,"_20578":52461,"_5":14121,"_26960":52240,"_2870":52462},[],"`aws_config.auth_method`",{"_3383":1338,"_29651":1264,"_20578":52464,"_5":14121,"_26960":52240,"_2870":24582},[],{"_3383":1339,"_29651":1264,"_20578":52466,"_5":14121,"_26960":52240,"_2870":52446},[],{"_3383":1340,"_29651":1264,"_20578":52468,"_5":14121,"_26960":52240,"_2870":52469},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_3383":1341,"_29651":1264,"_20578":52471,"_5":14121,"_26960":52240,"_2870":52472},[],"`aws_config.access_key_id`",{"_3383":1342,"_29651":1264,"_20578":52474,"_5":14121,"_26960":52240,"_2870":24582},[],{"_3383":1343,"_29651":1264,"_20578":52476,"_5":14121,"_26960":52240,"_2870":52477},[],"Only with `auth_method=static`",{"_3383":1344,"_29651":1264,"_20578":52479,"_5":14121,"_26960":52240,"_2870":52480},[],"AWS access key.",{"_3383":1345,"_29651":1264,"_20578":52482,"_5":14121,"_26960":52240,"_2870":52483},[],"`aws_config.secret_access_key`",{"_3383":1346,"_29651":1264,"_20578":52485,"_5":14121,"_26960":52240,"_2870":24582},[],{"_3383":1347,"_29651":1264,"_20578":52487,"_5":14121,"_26960":52240,"_2870":52477},[],{"_3383":1348,"_29651":1264,"_20578":52489,"_5":14121,"_26960":52240,"_2870":52490},[],"AWS secret key.",{"_3383":1349,"_29651":1264,"_20578":52492,"_5":14121,"_26960":52240,"_2870":52493},[],"`aws_config.session_token`",{"_3383":1350,"_29651":1264,"_20578":52495,"_5":14121,"_26960":52240,"_2870":24582},[],{"_3383":1351,"_29651":1264,"_20578":52497,"_5":14121,"_26960":52240,"_2870":52498},[],"No",{"_3383":1352,"_29651":1264,"_20578":52500,"_5":14121,"_26960":52240,"_2870":52501},[],"Session token (with `auth_method=static`).",{"_3383":1353,"_29651":1264,"_20578":52503,"_5":14121,"_26960":52240,"_2870":52504},[],"`aws_config.role_arn`",{"_3383":1354,"_29651":1264,"_20578":52506,"_5":14121,"_26960":52240,"_2870":24582},[],{"_3383":1355,"_29651":1264,"_20578":52508,"_5":14121,"_26960":52240,"_2870":52509},[],"Only with `auth_method=role`",{"_3383":1356,"_29651":1264,"_20578":52511,"_5":14121,"_26960":52240,"_2870":52512},[],"ARN of the role to assume.",{"_3383":1357,"_29651":1264,"_20578":52514,"_5":14121,"_26960":52240,"_2870":52515},[],"`aws_config.endpoint_url`",{"_3383":1358,"_29651":1264,"_20578":52517,"_5":14121,"_26960":52240,"_2870":24582},[],{"_3383":1359,"_29651":1264,"_20578":52519,"_5":14121,"_26960":52240,"_2870":52498},[],{"_3383":1360,"_29651":1264,"_20578":52521,"_5":14121,"_26960":52240,"_2870":52522},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_3383":1361,"_29651":1264,"_20578":52524,"_5":14121,"_26960":52240,"_2870":52525},[],"`subscriber_event_bus`",{"_3383":1362,"_29651":1264,"_20578":52527,"_5":14121,"_26960":52240,"_2870":17317},[],{"_3383":1363,"_29651":1264,"_20578":52529,"_5":14121,"_26960":52240,"_2870":52446},[],{"_3383":1364,"_29651":1264,"_20578":52531,"_5":14121,"_26960":52240,"_2870":52532},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_3383":1365,"_29651":1264,"_20578":52534,"_5":14121,"_26960":52240,"_2870":52535},[],"`dms_manager_client`",{"_3383":1366,"_29651":1264,"_20578":52537,"_5":14121,"_26960":52240,"_2870":24582},[],{"_3383":1367,"_29651":1264,"_20578":52539,"_5":14121,"_26960":52240,"_2870":52446},[],{"_3383":1368,"_29651":1264,"_20578":52541,"_5":14121,"_26960":52240,"_2870":52542},[],"HTTP URL of Lamassu's DMS Manager service.",{"_3383":1369,"_29651":1264,"_20578":52544,"_5":14121,"_26960":52240,"_2870":52545},[],"`device_manager_client`",{"_3383":1370,"_29651":1264,"_20578":52547,"_5":14121,"_26960":52240,"_2870":24582},[],{"_3383":1371,"_29651":1264,"_20578":52549,"_5":14121,"_26960":52240,"_2870":52446},[],{"_3383":1372,"_29651":1264,"_20578":52551,"_5":14121,"_26960":52240,"_2870":52552},[],"HTTP URL of Lamassu's Device Manager.",{"_3383":1373,"_29651":1264,"_20578":52554,"_5":14121,"_26960":52240,"_2870":52555},[],"`ca_client`",{"_3383":1374,"_29651":1264,"_20578":52557,"_5":14121,"_26960":52240,"_2870":24582},[],{"_3383":1375,"_29651":1264,"_20578":52559,"_5":14121,"_26960":52240,"_2870":52446},[],{"_3383":1376,"_29651":1264,"_20578":52561,"_5":14121,"_26960":52240,"_2870":52562},[],"HTTP URL of Lamassu's CA service.",{"_3383":1377,"_29651":1264,"_20578":52564,"_5":14121,"_26960":52244,"_2870":52565},[],"The connector owns the AWS side of four resource types — CAs, DMS provisioning templates (JITP), device certificates and Things. This section maps the bus events the connector consumes to the AWS resources they touch and to the AWS calls each flow performs. The state machine of each resource lives next to its detailed explanation; the last column links to it. AWS resources are referenced with the notation `IoTCore/<resource>`.",{"_3383":1378,"_29651":1264,"_20578":52567,"_5":14121,"_26960":52244,"_2870":52568},[],"The **CloudEvent type** column lists the event name on Lamassu's internal event bus; the **IAM actions** column lists the exact AWS SDK operations each flow invokes, so the required permissions can be derived directly from this table.",{"_3383":1379,"_29651":1264,"_20578":52570,"_5":14121,"_26960":52244,"_2870":52571},[],"CloudEvent type",{"_3383":1380,"_29651":1264,"_20578":52573,"_5":14121,"_26960":52244,"_2870":52574},[],"Lamassu resource",{"_3383":1381,"_29651":1264,"_20578":52576,"_5":14121,"_26960":52244,"_2870":52577},[],"AWS Resource",{"_3383":1382,"_29651":1264,"_20578":52579,"_5":14121,"_26960":52244,"_2870":52580},[],"IAM actions",{"_3383":1383,"_29651":1264,"_20578":52582,"_5":14121,"_26960":52244,"_2870":52583},[],"AWS calls and effect",{"_3383":1384,"_29651":1264,"_20578":52585,"_5":14121,"_26960":52244,"_2870":52586},[],"Where in this page",{"_3383":1385,"_29651":1264,"_20578":52588,"_5":14121,"_26960":52244,"_2870":52589},[],"`EventCreateCAKey` / `EventImportCAKey` / `EventUpdateCAMetadataKey`",{"_3383":1386,"_29651":1264,"_20578":52591,"_5":14121,"_26960":52244,"_2870":52592},[],"CA",{"_3383":1387,"_29651":1264,"_20578":52594,"_5":14121,"_26960":52244,"_2870":52595},[],"`IoTCore/CACertificate`",{"_3383":1388,"_29651":1264,"_20578":52597,"_5":14121,"_26960":52244,"_2870":52598},[],"`iot:GetRegistrationCode`, `iot:RegisterCACertificate`, `iot:DescribeCACertificate`, `iot:ListCACertificates`",{"_3383":1389,"_29651":1264,"_20578":52600,"_5":14121,"_26960":52244,"_2870":52601},[],"Loads the CA into connector state; a `registration.status = REQUESTED` write fires the registration flow (Primary with verification certificate, or SNI-only) and writes `SUCCEEDED` or `FAILED` back to the CA's metadata.",{"_3383":1390,"_29651":1264,"_20578":52603,"_5":14121,"_26960":52244,"_2870":52257},[],{"_3383":1391,"_29651":1264,"_20578":52605,"_5":14121,"_26960":52244,"_2870":52606},[],"`EventCreateDMSKey` / `EventUpdateDMSKey`",{"_3383":1392,"_29651":1264,"_20578":52608,"_5":14121,"_26960":52244,"_2870":52609},[],"DMS",{"_3383":1393,"_29651":1264,"_20578":52611,"_5":14121,"_26960":52244,"_2870":52612},[],"`IoTCore/ProvisioningTemplate`",{"_3383":1394,"_29651":1264,"_20578":52614,"_5":14121,"_26960":52244,"_2870":52615},[],"`iot:CreateProvisioningTemplate`, `iot:UpdateCACertificate`",{"_3383":1395,"_29651":1264,"_20578":52617,"_5":14121,"_26960":52244,"_2870":52618},[],"In `jitp` mode, attempts to create the provisioning template and attaches it to the registered CA. Non-idempotent: a `PUT /v1/dms/{id}` edit retries the creation and lands in `lamassu-dlq` after 3 retries. Idempotent for `none` and `auto` (configuration only).",{"_3383":1396,"_29651":1264,"_20578":52620,"_5":14121,"_26960":52244,"_2870":52285},[],{"_3383":1397,"_29651":1264,"_20578":52622,"_5":14121,"_26960":52244,"_2870":52623},[],"`EventBindDeviceIdentityKey`",{"_3383":1398,"_29651":1264,"_20578":52625,"_5":14121,"_26960":52244,"_2870":52626},[],"Device",{"_3383":1399,"_29651":1264,"_20578":52628,"_5":14121,"_26960":52244,"_2870":52629},[],"`IoTCore/Policy`, `IoTCore/ThingGroup`, `IoTCore/Thing`",{"_3383":1400,"_29651":1264,"_20578":52631,"_5":14121,"_26960":52244,"_2870":52632},[],"`iot:CreatePolicy` / `iot:DeletePolicyVersion`, `iot:GetPolicy` / `iot:ListPolicyVersions`, `iot:CreateThingGroup`, `iot:DescribeThing` / `iot:ListThingPrincipals`, `iot:RegisterThing`",{"_3383":1401,"_29651":1264,"_20578":52634,"_5":14121,"_26960":52244,"_2870":52635},[],"In `auto` mode: creates/updates policies, ensures Thing groups, revokes stale principals and provisions the Thing via `iot:RegisterThing`. In `jitp` mode: no AWS calls; AWS runs the JITP template on first connection.",{"_3383":1402,"_29651":1264,"_20578":52637,"_5":14121,"_26960":52244,"_2870":52293},[],{"_3383":1403,"_29651":1264,"_20578":52639,"_5":14121,"_26960":52244,"_2870":52640},[],"`EventUpdateCertificateStatusKey`",{"_3383":1404,"_29651":1264,"_20578":52642,"_5":14121,"_26960":52244,"_2870":52643},[],"Certificate",{"_3383":1405,"_29651":1264,"_20578":52645,"_5":14121,"_26960":52244,"_2870":52646},[],"`IoTCore/Certificate`",{"_3383":1406,"_29651":1264,"_20578":52648,"_5":14121,"_26960":52244,"_2870":52649},[],"`iot:UpdateCertificate`, `iot:Connect` (data plane)",{"_3383":1407,"_29651":1264,"_20578":52651,"_5":14121,"_26960":52244,"_2870":52652},[],"Maps status to AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), calls `iot:UpdateCertificate` and forces an MQTT disconnect on revoke.",{"_3383":1408,"_29651":1264,"_20578":52654,"_5":14121,"_26960":52244,"_2870":52305},[],{"_3383":1409,"_29651":1264,"_20578":52656,"_5":14121,"_26960":52244,"_2870":52657},[],"`EventUpdateCertificateMetadataKey` / `EventUpdateDeviceMetadataKey`",{"_3383":1410,"_29651":1264,"_20578":52659,"_5":14121,"_26960":52244,"_2870":52660},[],"Certificate / Device",{"_3383":1411,"_29651":1264,"_20578":52662,"_5":14121,"_26960":52244,"_2870":52663},[],"`IoTCore/Certificate`, `IoTCore/Thing`",{"_3383":1412,"_29651":1264,"_20578":52665,"_5":14121,"_26960":52244,"_2870":48676},[],{"_3383":1413,"_29651":1264,"_20578":52667,"_5":14121,"_26960":52244,"_2870":52668},[],"Refreshes internal state; the connector ignores events whose CloudEvent `source` matches its own URI to avoid self-triggered loops.",{"_3383":1414,"_29651":1264,"_20578":52670,"_5":14121,"_26960":52244,"_2870":52313},[],{"_3383":1415,"_29651":1264,"_20578":52672,"_5":14121,"_26960":52248,"_2870":52673},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_3383":1416,"_29651":1264,"_20578":52675,"_5":14121,"_26960":52252,"_2870":52676},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_3383":1417,"_29651":1264,"_20578":52678,"_5":14121,"_26960":52252,"_2870":52679},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_3383":1418,"_29651":1264,"_20578":52681,"_5":14121,"_26960":52256,"_2870":52682},[],"The CA registration flow is driven by the `registration.status` field of the CA's connector metadata:",{"_3383":1419,"_29651":1264,"_20578":52684,"_5":14121,"_26960":52256,"_2870":52685},[],"Transition",{"_3383":1420,"_29651":1264,"_20578":52687,"_5":14121,"_26960":52256,"_2870":52688},[],"AWS calls",{"_3383":1421,"_29651":1264,"_20578":52690,"_5":14121,"_26960":52256,"_2870":52691},[],"`NotRegistered` → `Requested`",{"_3383":1422,"_29651":1264,"_20578":52693,"_5":14121,"_26960":52256,"_2870":52694},[],"none (metadata write only)",{"_3383":1423,"_29651":1264,"_20578":52696,"_5":14121,"_26960":52256,"_2870":52697},[],"`Requested` → `Registering`",{"_3383":1424,"_29651":1264,"_20578":52699,"_5":14121,"_26960":52256,"_2870":52700},[],"`iot:GetRegistrationCode` (Primary Account only)",{"_3383":1425,"_29651":1264,"_20578":52702,"_5":14121,"_26960":52256,"_2870":52703},[],"`Registering` → `Succeeded`",{"_3383":1426,"_29651":1264,"_20578":52705,"_5":14121,"_26960":52256,"_2870":52706},[],"`iot:RegisterCACertificate` (Primary: proof-of-possession with an ephemeral key; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3383":1427,"_29651":1264,"_20578":52708,"_5":14121,"_26960":52256,"_2870":52709},[],"`Registering` → `Failed`",{"_3383":1428,"_29651":1264,"_20578":52711,"_5":14121,"_26960":52256,"_2870":52712},[],"failed `iot:RegisterCACertificate`; the error detail is written to the CA's metadata",{"_3383":1429,"_29651":1264,"_20578":52714,"_5":14121,"_26960":52256,"_2870":52715},[],"`Failed` / `Succeeded` → `Requested`",{"_3383":1430,"_29651":1264,"_20578":52717,"_5":14121,"_26960":52256,"_2870":52718},[],"none (a new `REQUESTED` write re-runs the flow)",{"_3383":1431,"_29651":1264,"_20578":52720,"_5":14121,"_26960":52260,"_2870":52721},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_3383":1432,"_29651":1264,"_20578":52723,"_5":14121,"_26960":52260,"_2870":52724},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_3383":1433,"_29651":1264,"_20578":52726,"_5":14121,"_26960":52260,"_2870":52727},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_3383":1434,"_29651":1264,"_20578":52729,"_5":14121,"_26960":52260,"_2870":52730},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_3383":1435,"_29651":1264,"_20578":52732,"_5":14121,"_26960":52260,"_2870":52733},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_3383":1436,"_29651":1264,"_20578":52735,"_5":14121,"_26960":52260,"_2870":52736},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_3383":1437,"_29651":1264,"_20578":52738,"_5":14121,"_26960":52264,"_2870":52739},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_3383":1438,"_29651":1264,"_20578":52741,"_5":14121,"_26960":52268,"_2870":52742},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_3383":1439,"_29651":1264,"_20578":52744,"_5":14121,"_26960":52268,"_2870":52745},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_3383":1440,"_29651":1264,"_20578":52747,"_5":14121,"_26960":52272,"_2870":52748},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_3383":1441,"_29651":1264,"_20578":52750,"_5":14121,"_26960":52276,"_2870":52751},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_3383":1442,"_29651":1264,"_20578":52753,"_5":14121,"_26960":52276,"_2870":52754},[],"Creates or updates the IoT policies configured in the DMS.",{"_3383":1443,"_29651":1264,"_20578":52756,"_5":14121,"_26960":52276,"_2870":52757},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_3383":1444,"_29651":1264,"_20578":52759,"_5":14121,"_26960":52276,"_2870":52760},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_3383":1445,"_29651":1264,"_20578":52762,"_5":14121,"_26960":52276,"_2870":52763},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_3383":1446,"_29651":1264,"_20578":52765,"_5":14121,"_26960":52276,"_2870":52766},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_3383":1447,"_29651":1264,"_20578":52768,"_5":14121,"_26960":52276,"_2870":52769},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_3383":1448,"_29651":1264,"_20578":52771,"_5":14121,"_26960":52280,"_2870":52772},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. The connector attempts to create this template when the DMS is created and again on every full DMS edit (`PUT /v1/dms/{id}`) — not at device enrollment time. The attempt is not idempotent: when a template named after the DMS ID already exists, the creation call fails, the event is retried three times and finally lands in the `lamassu-dlq` poison queue (see Troubleshooting). The template is created once; later DMS edits never update its content. A DMS update that omits `metadata` or sends `null` keeps the stored metadata, so the connector key `lamassu.io/iot/{connector_id}` remains present and the attempt is still triggered. A body that supplies a `metadata` object replaces the stored metadata entirely: if that object does not carry the connector key, the key is dropped and the connector silently skips the DMS's future events. Once the template is attached, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_3383":1449,"_29651":1264,"_20578":52774,"_5":14121,"_26960":52280,"_2870":52775},[],"The connector creates the template, named after the DMS ID, only once. Each later edit of the DMS that keeps the connector key tries to create it again and fails, because the connector does not update existing templates. Later changes to `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` or to the groups and policies the template references must be applied by hand in AWS IoT Core.",{"_3383":1450,"_29651":1264,"_20578":52777,"_5":14121,"_26960":52280,"_2870":52778},[],"The failed event is retried and ends in `lamassu-dlq`. Groups and policies are registered before the failure, but the assignment of the template to the registered CA, the write-back of the ARN to the DMS and the shadow update when `ManagedCAs` changes are skipped.",{"_3383":1451,"_29651":1264,"_20578":52780,"_5":14121,"_26960":52280,"_2870":52781},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_3383":1452,"_29651":1264,"_20578":52783,"_5":14121,"_26960":52280,"_2870":52784},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_3383":1453,"_29651":1264,"_20578":52786,"_5":14121,"_26960":52284,"_2870":52787},[],"The DMS's `registration_mode` determines what the connector does on the AWS side when the DMS is created or fully edited:",{"_3383":1454,"_29651":1264,"_20578":52789,"_5":14121,"_26960":52284,"_2870":52685},[],{"_3383":1455,"_29651":1264,"_20578":52791,"_5":14121,"_26960":52284,"_2870":52688},[],{"_3383":1456,"_29651":1264,"_20578":52793,"_5":14121,"_26960":52284,"_2870":52794},[],"`Unconfigured` → `None` / `Auto`",{"_3383":1457,"_29651":1264,"_20578":52796,"_5":14121,"_26960":52284,"_2870":52797},[],"none (configuration only)",{"_3383":1458,"_29651":1264,"_20578":52799,"_5":14121,"_26960":52284,"_2870":52800},[],"`None` ↔ `Auto`",{"_3383":1459,"_29651":1264,"_20578":52802,"_5":14121,"_26960":52284,"_2870":52797},[],{"_3383":1460,"_29651":1264,"_20578":52804,"_5":14121,"_26960":52284,"_2870":52805},[],"Any → `Jitp`",{"_3383":1461,"_29651":1264,"_20578":52807,"_5":14121,"_26960":52284,"_2870":52808},[],"`iot:CreateProvisioningTemplate` (non-idempotent: it fails when the template already exists; after 3 retries the event lands in `lamassu-dlq`)",{"_3383":1462,"_29651":1264,"_20578":52810,"_5":14121,"_26960":52284,"_2870":52811},[],"`Jitp` → `None` / `Auto`",{"_3383":1463,"_29651":1264,"_20578":52813,"_5":14121,"_26960":52284,"_2870":52814},[],"none (the template stays in the AWS account)",{"_3383":1464,"_29651":1264,"_20578":52816,"_5":14121,"_26960":52288,"_2870":52817},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_3383":1465,"_29651":1264,"_20578":52819,"_5":14121,"_26960":52288,"_2870":52820},[],"The full flow from the device's perspective is:",{"_3383":1466,"_29651":1264,"_20578":52822,"_5":14121,"_26960":52288,"_2870":52823},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_3383":1467,"_29651":1264,"_20578":52825,"_5":14121,"_26960":52292,"_2870":52826},[],"Things only exist under `auto` mode; in `jitp` mode AWS creates the Thing itself when the device first connects. The Thing name is always the device certificate's CN:",{"_3383":1468,"_29651":1264,"_20578":52828,"_5":14121,"_26960":52292,"_2870":52685},[],{"_3383":1469,"_29651":1264,"_20578":52830,"_5":14121,"_26960":52292,"_2870":52688},[],{"_3383":1470,"_29651":1264,"_20578":52832,"_5":14121,"_26960":52292,"_2870":52833},[],"`Absent` → `Provisioned`",{"_3383":1471,"_29651":1264,"_20578":52835,"_5":14121,"_26960":52292,"_2870":52836},[],"policies created/updated, Thing groups ensured, `iot:RegisterThing` (creates the Thing, registers the certificate, attaches policies)",{"_3383":1472,"_29651":1264,"_20578":52838,"_5":14121,"_26960":52292,"_2870":52839},[],"`Provisioned` → `Provisioned` (re-enrollment)",{"_3383":1473,"_29651":1264,"_20578":52841,"_5":14121,"_26960":52292,"_2870":52842},[],"stale principals marked `REVOKED`, new `iot:RegisterThing` run; the new certificate ARN replaces the old one in Lamassu metadata",{"_3383":1474,"_29651":1264,"_20578":52844,"_5":14121,"_26960":52292,"_2870":52845},[],"In `jitp` mode the connector makes no provisioning calls: AWS executes the JITP template on the device's first connection and creates the Thing, registers the certificate and activates it on its own.",{"_3383":1475,"_29651":1264,"_20578":52847,"_5":14121,"_26960":52296,"_2870":52848},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_3383":1476,"_29651":1264,"_20578":52850,"_5":14121,"_26960":52296,"_2870":52851},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_3383":1477,"_29651":1264,"_20578":52853,"_5":14121,"_26960":52296,"_2870":52854},[],"For the JITP flow to work correctly:",{"_3383":1478,"_29651":1264,"_20578":52856,"_5":14121,"_26960":52296,"_2870":52857},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_3383":1479,"_29651":1264,"_20578":52859,"_5":14121,"_26960":52296,"_2870":52860},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_3383":1480,"_29651":1264,"_20578":52862,"_5":14121,"_26960":52296,"_2870":52863},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_3383":1481,"_29651":1264,"_20578":52865,"_5":14121,"_26960":52296,"_2870":52866},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_3383":1482,"_29651":1264,"_20578":52868,"_5":14121,"_26960":52300,"_2870":52869},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_3383":1483,"_29651":1264,"_20578":52871,"_5":14121,"_26960":52300,"_2870":52872},[],"Status in Lamassu",{"_3383":1484,"_29651":1264,"_20578":52874,"_5":14121,"_26960":52300,"_2870":52875},[],"Revocation reason",{"_3383":1485,"_29651":1264,"_20578":52877,"_5":14121,"_26960":52300,"_2870":52878},[],"Status in AWS IoT Core",{"_3383":1486,"_29651":1264,"_20578":52880,"_5":14121,"_26960":52300,"_2870":52881},[],"`Active`",{"_3383":1487,"_29651":1264,"_20578":52883,"_5":14121,"_26960":52300,"_2870":52884},[],"None",{"_3383":1488,"_29651":1264,"_20578":52886,"_5":14121,"_26960":52300,"_2870":52887},[],"`ACTIVE`",{"_3383":1489,"_29651":1264,"_20578":52889,"_5":14121,"_26960":52300,"_2870":52890},[],"`Revoked`",{"_3383":1490,"_29651":1264,"_20578":52892,"_5":14121,"_26960":52300,"_2870":52893},[],"`certificateHold`",{"_3383":1491,"_29651":1264,"_20578":52895,"_5":14121,"_26960":52300,"_2870":52896},[],"`INACTIVE`",{"_3383":1492,"_29651":1264,"_20578":52898,"_5":14121,"_26960":52300,"_2870":52890},[],{"_3383":1493,"_29651":1264,"_20578":52900,"_5":14121,"_26960":52300,"_2870":52901},[],"Any other reason",{"_3383":1494,"_29651":1264,"_20578":52903,"_5":14121,"_26960":52300,"_2870":52904},[],"`REVOKED`",{"_3383":1495,"_29651":1264,"_20578":52906,"_5":14121,"_26960":52300,"_2870":52907},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_3383":1496,"_29651":1264,"_20578":52909,"_5":14121,"_26960":52304,"_2870":52910},[],"Certificates holding the connector's metadata key sync their status; certificates provisioned via JITP have no metadata key and stay out of this machine:",{"_3383":1497,"_29651":1264,"_20578":52912,"_5":14121,"_26960":52304,"_2870":52685},[],{"_3383":1498,"_29651":1264,"_20578":52914,"_5":14121,"_26960":52304,"_2870":52688},[],{"_3383":1499,"_29651":1264,"_20578":52916,"_5":14121,"_26960":52304,"_2870":52917},[],"`NotSynced` → `Active`",{"_3383":1500,"_29651":1264,"_20578":52919,"_5":14121,"_26960":52304,"_2870":52396},[],{"_3383":1501,"_29651":1264,"_20578":52921,"_5":14121,"_26960":52304,"_2870":52922},[],"`Active` → `Inactive`",{"_3383":1502,"_29651":1264,"_20578":52924,"_5":14121,"_26960":52304,"_2870":52925},[],"`iot:UpdateCertificate` + forced MQTT disconnect",{"_3383":1503,"_29651":1264,"_20578":52927,"_5":14121,"_26960":52304,"_2870":52928},[],"`Active` → `Revoked`",{"_3383":1504,"_29651":1264,"_20578":52930,"_5":14121,"_26960":52304,"_2870":52925},[],{"_3383":1505,"_29651":1264,"_20578":52932,"_5":14121,"_26960":52304,"_2870":52933},[],"`Inactive` / `Revoked` → `Active`",{"_3383":1506,"_29651":1264,"_20578":52935,"_5":14121,"_26960":52304,"_2870":52396},[],{"_3383":1507,"_29651":1264,"_20578":52937,"_5":14121,"_26960":52304,"_2870":52938},[],"`RenewalWindow` / `AboutToExpire` / `Expired`",{"_3383":1508,"_29651":1264,"_20578":52940,"_5":14121,"_26960":52304,"_2870":52941},[],"none (these states are not synced to AWS)",{"_3383":1509,"_29651":1264,"_20578":52943,"_5":14121,"_26960":52308,"_2870":52944},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_3383":1510,"_29651":1264,"_20578":52946,"_5":14121,"_26960":52308,"_2870":52947},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_3383":1511,"_29651":1264,"_20578":52949,"_5":14121,"_26960":52308,"_2870":52950},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_3383":1512,"_29651":1264,"_20578":52952,"_5":14121,"_26960":52312,"_2870":52953},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_3383":1513,"_29651":1264,"_20578":52955,"_5":14121,"_26960":52312,"_2870":52956},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_3383":1514,"_29651":1264,"_20578":52958,"_5":14121,"_26960":52316,"_2870":52959},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_3383":1515,"_29651":1264,"_20578":52961,"_5":14121,"_26960":52316,"_2870":52962},[],"There are two action types:",{"_3383":1516,"_29651":1264,"_20578":52964,"_5":14121,"_26960":52316,"_2870":52965},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_3383":1517,"_29651":1264,"_20578":52967,"_5":14121,"_26960":52316,"_2870":52968},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_3383":1518,"_29651":1264,"_20578":52970,"_5":14121,"_26960":52316,"_2870":52971},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_3383":1519,"_29651":1264,"_20578":52973,"_5":14121,"_26960":52320,"_2870":52974},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_3383":1520,"_29651":1264,"_20578":52976,"_5":14121,"_26960":52320,"_2870":52977},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_3383":1521,"_29651":1264,"_20578":52979,"_5":14121,"_26960":52320,"_2870":52980},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_3383":1522,"_29651":1264,"_20578":52982,"_5":14121,"_26960":52324,"_2870":52983},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_3383":1523,"_29651":1264,"_20578":52985,"_5":14121,"_26960":52324,"_2870":52986},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_3383":1524,"_29651":1264,"_20578":52988,"_5":14121,"_26960":52324,"_2870":52989},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_3383":1525,"_29651":1264,"_20578":52991,"_5":14121,"_26960":52324,"_2870":52992},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_3383":1526,"_29651":1264,"_20578":52994,"_5":14121,"_26960":52324,"_2870":52995},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_3383":1527,"_29651":1264,"_20578":52997,"_5":14121,"_26960":52324,"_2870":52998},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_3383":1528,"_29651":1264,"_20578":53000,"_5":14121,"_26960":52324,"_2870":53001},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_3383":1529,"_29651":1264,"_20578":53003,"_5":14121,"_26960":52324,"_2870":53004},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_3383":1530,"_29651":1264,"_20578":53006,"_5":14121,"_26960":52324,"_2870":53007},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_3383":1531,"_29651":1264,"_20578":53009,"_5":14121,"_26960":52324,"_2870":53010},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_3383":1532,"_29651":1264,"_20578":53012,"_5":14121,"_26960":52324,"_2870":53013},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_3383":1533,"_29651":1264,"_20578":53015,"_5":14121,"_26960":52324,"_2870":53016},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_3383":1534,"_29651":1264,"_20578":53018,"_5":14121,"_26960":52324,"_2870":53019},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_3383":1535,"_29651":1264,"_20578":53021,"_5":14121,"_26960":52324,"_2870":53022},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_3383":1536,"_29651":1264,"_20578":53024,"_5":14121,"_26960":52324,"_2870":53025},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_3383":1537,"_29651":1264,"_20578":53027,"_5":14121,"_26960":52324,"_2870":53028},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_3383":1538,"_29651":1264,"_20578":53030,"_5":14121,"_26960":52324,"_2870":53031},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_3383":1539,"_29651":1264,"_20578":53033,"_5":14121,"_26960":52324,"_2870":53034},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_3383":1540,"_29651":1264,"_20578":53036,"_5":14121,"_26960":52324,"_2870":53037},[],"**Symptom:** After editing a DMS in `jitp` mode, DMS update messages appear in `lamassu-dlq`, or JITP configuration changes have no effect in AWS.",{"_3383":1541,"_29651":1264,"_20578":53039,"_5":14121,"_26960":52324,"_2870":53040},[],"**Cause:** Every full DMS edit (`PUT /v1/dms/{id}`) triggers a `CreateProvisioningTemplate` attempt for the template named after the DMS ID, and the call is not idempotent: when the template already exists, it fails, the event is retried three times and finally lands in `lamassu-dlq`. The connector’s later steps are skipped.",{"_3383":1542,"_29651":1264,"_20578":53042,"_5":14121,"_26960":52324,"_2870":53043},[],"**Resolution:** Check that the template named with the DMS ID exists in AWS IoT Core and that JITP enrollment works. If the JITP configuration was changed, apply it by hand to the AWS template.",{"_3383":1543,"_29651":1264,"_20578":53045,"_5":14121,"_26960":52324,"_2870":53046},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3383":1544,"_29651":1264,"_20578":53048,"_5":14121,"_26960":52324,"_2870":53049},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3383":1545,"_29651":1264,"_20578":53051,"_5":14121,"_26960":52324,"_2870":53052},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_3383":1546,"_29651":1546,"_5":14473,"_2870":50759,"_30004":53054,"_20578":53055,"_26960":1546},[48280,49748,50759],[],{"_3383":1547,"_29651":1546,"_20578":53057,"_5":14121,"_26960":1546,"_2870":53058},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_3383":1548,"_29651":1546,"_5":30001,"_20578":53060,"_26960":53061,"_2870":53062},[],"/docs/pr-preview/pr-55/platform/iot-fleets/overview#start-here","Start here",{"_3383":1549,"_29651":1546,"_5":30001,"_20578":53064,"_26960":53065,"_2870":50757},[],"/docs/pr-preview/pr-55/platform/iot-fleets/overview#devices-and-identities",{"_3383":1550,"_29651":1546,"_5":30001,"_20578":53067,"_26960":53068,"_2870":50940},[],"/docs/pr-preview/pr-55/platform/iot-fleets/overview#enrollment-with-pki",{"_3383":1551,"_29651":1546,"_5":30001,"_20578":53070,"_26960":53071,"_2870":52221},[],"/docs/pr-preview/pr-55/platform/iot-fleets/overview#integrations",{"_3383":1552,"_29651":1546,"_5":30001,"_20578":53073,"_26960":53074,"_2870":53075},[],"/docs/pr-preview/pr-55/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_3383":1553,"_29651":1546,"_20578":53077,"_5":14121,"_26960":1546,"_2870":53078},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_3383":1554,"_29651":1546,"_20578":53080,"_5":14121,"_26960":53061,"_2870":53081},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_3383":1555,"_29651":1546,"_20578":53083,"_5":14121,"_26960":53061,"_2870":53084},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_3383":1556,"_29651":1546,"_20578":53086,"_5":14121,"_26960":53065,"_2870":53087},[],"Resource",{"_3383":1557,"_29651":1546,"_20578":53089,"_5":14121,"_26960":53065,"_2870":53090},[],"What it represents",{"_3383":1558,"_29651":1546,"_20578":53092,"_5":14121,"_26960":53065,"_2870":53093},[],"**Device**",{"_3383":1559,"_29651":1546,"_20578":53095,"_5":14121,"_26960":53065,"_2870":53096},[],"An inventory entry with an identifier, owning DMS and classification.",{"_3383":1560,"_29651":1546,"_20578":53098,"_5":14121,"_26960":53065,"_2870":53099},[],"**Identity**",{"_3383":1561,"_29651":1546,"_20578":53101,"_5":14121,"_26960":53065,"_2870":53102},[],"The device's association with its certificates: an active version and a history.",{"_3383":1562,"_29651":1546,"_20578":53104,"_5":14121,"_26960":53065,"_2870":53105},[],"**DMS**",{"_3383":1563,"_29651":1546,"_20578":53107,"_5":14121,"_26960":53065,"_2870":53108},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_3383":1564,"_29651":1546,"_20578":53110,"_5":14121,"_26960":53065,"_2870":53111},[],"**Fleet**",{"_3383":1565,"_29651":1546,"_20578":53113,"_5":14121,"_26960":53065,"_2870":53114},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_3383":1566,"_29651":1546,"_20578":53116,"_5":14121,"_26960":53065,"_2870":53117},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_3383":1567,"_29651":1546,"_20578":53119,"_5":14121,"_26960":53065,"_2870":53120},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_3383":1568,"_29651":1546,"_20578":53122,"_5":14121,"_26960":53068,"_2870":53123},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_3383":1569,"_29651":1546,"_20578":53125,"_5":14121,"_26960":53068,"_2870":53126},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_3383":1570,"_29651":1546,"_20578":53128,"_5":14121,"_26960":53068,"_2870":53129},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_3383":1571,"_29651":1546,"_20578":53131,"_5":14121,"_26960":53068,"_2870":53132},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_3383":1572,"_29651":1546,"_20578":53134,"_5":14121,"_26960":53068,"_2870":53135},[],"**Result:** request the certificate, install it and check its association with the device.",{"_3383":1573,"_29651":1546,"_20578":53137,"_5":14121,"_26960":53068,"_2870":53138},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_3383":1574,"_29651":1546,"_20578":53140,"_5":14121,"_26960":53068,"_2870":53141},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3383":1575,"_29651":1546,"_20578":53143,"_5":14121,"_26960":53068,"_2870":53144},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3383":1576,"_29651":1546,"_20578":53146,"_5":14121,"_26960":53071,"_2870":53147},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_3383":1577,"_29651":1546,"_20578":53149,"_5":14121,"_26960":53071,"_2870":53150},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_3383":1578,"_29651":1546,"_20578":53152,"_5":14121,"_26960":53074,"_2870":53153},[],"Participant",{"_3383":1579,"_29651":1546,"_20578":53155,"_5":14121,"_26960":53074,"_2870":53156},[],"Responsibility",{"_3383":1580,"_29651":1546,"_20578":53158,"_5":14121,"_26960":53074,"_2870":53159},[],"PKI administrator",{"_3383":1581,"_29651":1546,"_20578":53161,"_5":14121,"_26960":53074,"_2870":53162},[],"CA, issuance profile, chain and revocation publication.",{"_3383":1582,"_29651":1546,"_20578":53164,"_5":14121,"_26960":53074,"_2870":53165},[],"Provisioning administrator",{"_3383":1583,"_29651":1546,"_20578":53167,"_5":14121,"_26960":53074,"_2870":53168},[],"DMS, admission, authentication per operation and inventory.",{"_3383":1584,"_29651":1546,"_20578":53170,"_5":14121,"_26960":53074,"_2870":53171},[],"Device integrator",{"_3383":1585,"_29651":1546,"_20578":53173,"_5":14121,"_26960":53074,"_2870":53174},[],"Initial credential, key, EST client, trust and certificate installation.",{"_3383":1586,"_29651":1546,"_20578":53176,"_5":14121,"_26960":53074,"_2870":53177},[],"Consumer integrator",{"_3383":1587,"_29651":1546,"_20578":53179,"_5":14121,"_26960":53074,"_2870":53180},[],"Trusted issuers, validation and device permissions in the destination.",{"_3383":1588,"_29651":1546,"_20578":53182,"_5":14121,"_26960":53074,"_2870":53183},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_3383":1589,"_29651":1589,"_5":14473,"_2870":53185,"_30004":53186,"_20578":53188,"_26960":1589},"Enroll and connect your first device",[48280,49748,50759,53187],"Getting started",[],{"_3383":1590,"_29651":1589,"_20578":53190,"_5":14121,"_26960":1589,"_2870":53191},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_3383":1591,"_29651":1589,"_5":30001,"_20578":53193,"_26960":53194,"_2870":48290},[],"/docs/pr-preview/pr-55/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_3383":1592,"_29651":1589,"_5":30001,"_20578":53196,"_26960":53197,"_2870":53198},[],"/docs/pr-preview/pr-55/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_3383":1593,"_29651":1589,"_5":30001,"_20578":53200,"_26960":53201,"_2870":53202},[],"/docs/pr-preview/pr-55/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_3383":1594,"_29651":1589,"_5":30001,"_20578":53204,"_26960":53205,"_2870":53206},[],"/docs/pr-preview/pr-55/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_3383":1595,"_29651":1589,"_5":30001,"_20578":53208,"_26960":53209,"_2870":53210},[],"/docs/pr-preview/pr-55/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_3383":1596,"_29651":1589,"_5":30001,"_20578":53212,"_26960":53213,"_2870":53214},[],"/docs/pr-preview/pr-55/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_3383":1597,"_29651":1589,"_5":30001,"_20578":53216,"_26960":53217,"_2870":53218},[],"/docs/pr-preview/pr-55/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_3383":1598,"_29651":1589,"_5":30001,"_20578":53220,"_26960":53221,"_2870":53222},[],"/docs/pr-preview/pr-55/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_3383":1599,"_29651":1589,"_20578":53224,"_5":14121,"_26960":1589,"_2870":53225},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_3383":1600,"_29651":1589,"_20578":53227,"_5":14121,"_26960":53194,"_2870":53228},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_3383":1601,"_29651":1589,"_20578":53230,"_5":14121,"_26960":53194,"_2870":53231},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_3383":1602,"_29651":1589,"_20578":53233,"_5":14121,"_26960":53194,"_2870":53234},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_3383":1603,"_29651":1589,"_20578":53236,"_5":14121,"_26960":53194,"_2870":53237},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_3383":1604,"_29651":1589,"_20578":53239,"_5":14121,"_26960":53194,"_2870":53240},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_3383":1605,"_29651":1589,"_20578":53242,"_5":14121,"_26960":53197,"_2870":53243},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_3383":1606,"_29651":1589,"_20578":53245,"_5":14121,"_26960":53197,"_2870":53246},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_3383":1607,"_29651":1589,"_20578":53248,"_5":14121,"_26960":53201,"_2870":53249},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_3383":1608,"_29651":1589,"_20578":53251,"_5":14121,"_26960":53201,"_2870":53252},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_3383":1609,"_29651":1589,"_20578":53254,"_5":14121,"_26960":53201,"_2870":53255},[],"Setting",{"_3383":1610,"_29651":1589,"_20578":53257,"_5":14121,"_26960":53201,"_2870":53258},[],"Evaluation value",{"_3383":1611,"_29651":1589,"_20578":53260,"_5":14121,"_26960":53201,"_2870":53261},[],"Enrollment CA",{"_3383":1612,"_29651":1589,"_20578":53263,"_5":14121,"_26960":53201,"_2870":53264},[],"Issuing root from `device-root.pem`.",{"_3383":1613,"_29651":1589,"_20578":53266,"_5":14121,"_26960":53201,"_2870":51070},[],{"_3383":1614,"_29651":1589,"_20578":53268,"_5":14121,"_26960":53201,"_2870":53269},[],"The 1-hour leaf profile you just prepared.",{"_3383":1615,"_29651":1589,"_20578":53271,"_5":14121,"_26960":53201,"_2870":53272},[],"Protocol / Registration Mode",{"_3383":1616,"_29651":1589,"_20578":53274,"_5":14121,"_26960":53201,"_2870":53275},[],"`EST_RFC7030` / `JITP`.",{"_3383":1617,"_29651":1589,"_20578":53277,"_5":14121,"_26960":53201,"_2870":53278},[],"Verify CSR Signature",{"_3383":1618,"_29651":1589,"_20578":53280,"_5":14121,"_26960":53201,"_2870":53281},[],"Enabled.",{"_3383":1619,"_29651":1589,"_20578":53283,"_5":14121,"_26960":53201,"_2870":53284},[],"Enable Replaceable Enrollment",{"_3383":1620,"_29651":1589,"_20578":53286,"_5":14121,"_26960":53201,"_2870":53287},[],"Disabled; the ID must be new.",{"_3383":1621,"_29651":1589,"_20578":53289,"_5":14121,"_26960":53201,"_2870":53290},[],"Initial authentication",{"_3383":1622,"_29651":1589,"_20578":53292,"_5":14121,"_26960":53201,"_2870":53293},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_3383":1623,"_29651":1589,"_20578":53295,"_5":14121,"_26960":53201,"_2870":53296},[],"Renewal authentication",{"_3383":1624,"_29651":1589,"_20578":53298,"_5":14121,"_26960":53201,"_2870":53299},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_3383":1625,"_29651":1589,"_20578":53301,"_5":14121,"_26960":53201,"_2870":53302},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_3383":1626,"_29651":1589,"_20578":53304,"_5":14121,"_26960":53201,"_2870":53305},[],"Not needed for this direct issuance; the Enrollment CA is always trusted for re-enrollment / disabled.",{"_3383":1627,"_29651":1589,"_20578":53307,"_5":14121,"_26960":53201,"_2870":53308},[],"Re-enrollment Delta",{"_3383":1628,"_29651":1589,"_20578":53310,"_5":14121,"_26960":53201,"_2870":53311},[],"1 hour.",{"_3383":1629,"_29651":1589,"_20578":53313,"_5":14121,"_26960":53201,"_2870":53314},[],"Preventive / Critical Delta",{"_3383":1630,"_29651":1589,"_20578":53316,"_5":14121,"_26960":53201,"_2870":53317},[],"30 minutes / 10 minutes.",{"_3383":1631,"_29651":1589,"_20578":53319,"_5":14121,"_26960":53201,"_2870":53320},[],"Revoke on Re-enrollment",{"_3383":1632,"_29651":1589,"_20578":53322,"_5":14121,"_26960":53201,"_2870":53323},[],"Disabled to test the successor before retiring the previous identity.",{"_3383":1633,"_29651":1589,"_20578":53325,"_5":14121,"_26960":53201,"_2870":51078},[],{"_3383":1634,"_29651":1589,"_20578":53327,"_5":14121,"_26960":53201,"_2870":53328},[],"Disabled; the operational key is generated in the client.",{"_3383":1635,"_29651":1589,"_20578":53330,"_5":14121,"_26960":53201,"_2870":53331},[],"CA Distribution",{"_3383":1636,"_29651":1589,"_20578":53333,"_5":14121,"_26960":53201,"_2870":53334},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_3383":1637,"_29651":1589,"_20578":53336,"_5":14121,"_26960":53201,"_2870":53337},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. The console exposes independent editors for the enrollment and re-enrollment authentication; the DMS guide describes their fields, and you can also check the resource through the DMS API.",{"_3383":1638,"_29651":1589,"_20578":53339,"_5":14121,"_26960":53205,"_2870":53340},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_3383":1639,"_29651":1589,"_20578":53342,"_5":14121,"_26960":53205,"_2870":53343},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_3383":1640,"_29651":1589,"_20578":53345,"_5":14121,"_26960":53209,"_2870":53346},[],"Generate a new key and CSR with the selected identifier:",{"_3383":1641,"_29651":1589,"_20578":53348,"_5":14121,"_26960":53209,"_2870":53349},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_3383":1642,"_29651":1589,"_20578":53351,"_5":14121,"_26960":53209,"_2870":53352},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_3383":1643,"_29651":1589,"_20578":53354,"_5":14121,"_26960":53213,"_2870":53355},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_3383":1644,"_29651":1589,"_20578":53357,"_5":14121,"_26960":53213,"_2870":53358},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_3383":1645,"_29651":1589,"_20578":53360,"_5":14121,"_26960":53217,"_2870":53361},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_3383":1646,"_29651":1589,"_20578":53363,"_5":14121,"_26960":53217,"_2870":53364},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_3383":1647,"_29651":1589,"_20578":53366,"_5":14121,"_26960":53217,"_2870":53367},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_3383":1648,"_29651":1589,"_20578":53369,"_5":14121,"_26960":53217,"_2870":53370},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_3383":1649,"_29651":1589,"_20578":53372,"_5":14121,"_26960":53217,"_2870":53373},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_3383":1650,"_29651":1589,"_20578":53375,"_5":14121,"_26960":53221,"_2870":53376},[],"Check",{"_3383":1651,"_29651":1589,"_20578":53378,"_5":14121,"_26960":53221,"_2870":53379},[],"Expected result",{"_3383":1652,"_29651":1589,"_20578":53381,"_5":14121,"_26960":53221,"_2870":53382},[],"Registration",{"_3383":1653,"_29651":1589,"_20578":53384,"_5":14121,"_26960":53221,"_2870":53385},[],"ID created automatically and correct DMS.",{"_3383":1654,"_29651":1589,"_20578":53387,"_5":14121,"_26960":53221,"_2870":52643},[],{"_3383":1655,"_29651":1589,"_20578":53389,"_5":14121,"_26960":53221,"_2870":53390},[],"CN, profile, serial and key verified.",{"_3383":1656,"_29651":1589,"_20578":53392,"_5":14121,"_26960":53221,"_2870":53393},[],"Inventory",{"_3383":1657,"_29651":1589,"_20578":53395,"_5":14121,"_26960":53221,"_2870":53396},[],"Received serial visible as the current identity and in history.",{"_3383":1658,"_29651":1589,"_20578":53398,"_5":14121,"_26960":53221,"_2870":53399},[],"Consumer",{"_3383":1659,"_29651":1589,"_20578":53401,"_5":14121,"_26960":53221,"_2870":53402},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_3383":1660,"_29651":1589,"_20578":53404,"_5":14121,"_26960":53221,"_2870":53405},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_3383":1661,"_29651":1589,"_20578":53407,"_5":14121,"_26960":53221,"_2870":53408},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_3383":1662,"_29651":1662,"_5":14473,"_2870":50775,"_30004":53410,"_20578":53411,"_26960":1662},[48280,49748,50759,53187],[],{"_3383":1663,"_29651":1662,"_20578":53413,"_5":14121,"_26960":1662,"_2870":53414},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_3383":1664,"_29651":1662,"_5":30001,"_20578":53416,"_26960":53417,"_2870":48290},[],"/docs/pr-preview/pr-55/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_3383":1665,"_29651":1662,"_5":30001,"_20578":53419,"_26960":53420,"_2870":53421},[],"/docs/pr-preview/pr-55/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_3383":1666,"_29651":1662,"_5":30001,"_20578":53423,"_26960":53424,"_2870":53425},[],"/docs/pr-preview/pr-55/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_3383":1667,"_29651":1662,"_5":30001,"_20578":53427,"_26960":53428,"_2870":53429},[],"/docs/pr-preview/pr-55/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_3383":1668,"_29651":1662,"_5":30001,"_20578":53431,"_26960":53432,"_2870":53433},[],"/docs/pr-preview/pr-55/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_3383":1669,"_29651":1662,"_5":30001,"_20578":53435,"_26960":53436,"_2870":53437},[],"/docs/pr-preview/pr-55/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_3383":1670,"_29651":1662,"_5":30001,"_20578":53439,"_26960":53440,"_2870":53379},[],"/docs/pr-preview/pr-55/platform/iot-fleets/quickstarts/register-device#expected-result",{"_3383":1671,"_29651":1662,"_5":30001,"_20578":53442,"_26960":53443,"_2870":53444},[],"/docs/pr-preview/pr-55/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_3383":1672,"_29651":1662,"_5":30001,"_20578":53446,"_26960":53447,"_2870":53448},[],"/docs/pr-preview/pr-55/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_3383":1673,"_29651":1662,"_20578":53450,"_5":14121,"_26960":1662,"_2870":53451},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_3383":1674,"_29651":1662,"_20578":53453,"_5":14121,"_26960":1662,"_2870":53454},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_3383":1675,"_29651":1662,"_20578":53456,"_5":14121,"_26960":53417,"_2870":53457},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_3383":1676,"_29651":1662,"_20578":53459,"_5":14121,"_26960":53417,"_2870":53460},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_3383":1677,"_29651":1662,"_20578":53462,"_5":14121,"_26960":53417,"_2870":53463},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_3383":1678,"_29651":1662,"_20578":53465,"_5":14121,"_26960":53417,"_2870":53466},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_3383":1679,"_29651":1662,"_20578":53468,"_5":14121,"_26960":53420,"_2870":53469},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_3383":1680,"_29651":1662,"_20578":53471,"_5":14121,"_26960":53420,"_2870":53472},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_3383":1681,"_29651":1662,"_20578":53474,"_5":14121,"_26960":53420,"_2870":53475},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_3383":1682,"_29651":1662,"_20578":53477,"_5":14121,"_26960":53420,"_2870":53478},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_3383":1683,"_29651":1662,"_20578":53480,"_5":14121,"_26960":53420,"_2870":53481},[],"In the authentication section, enable **Require client certificate** and leave **Call external webhook** off. Under **Require client certificate**, add the CA whose initial certificates you will accept to **Validation CAs**; for this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and leave **Enable server-side key generation** off if you will not use it.",{"_3383":1684,"_29651":1662,"_20578":53483,"_5":14121,"_26960":53420,"_2870":53484},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_3383":1685,"_29651":1662,"_20578":53486,"_5":14121,"_26960":53420,"_2870":53487},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_3383":1686,"_29651":1662,"_20578":53489,"_5":14121,"_26960":53420,"_2870":53490},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_3383":1687,"_29651":1662,"_20578":53492,"_5":14121,"_26960":53424,"_2870":53493},[],"Open **Managed Devices** and the registration action. Complete:",{"_3383":1688,"_29651":1662,"_20578":53495,"_5":14121,"_26960":53424,"_2870":53496},[],"**Device ID**: `device-001`.",{"_3383":1689,"_29651":1662,"_20578":53498,"_5":14121,"_26960":53424,"_2870":53499},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_3383":1690,"_29651":1662,"_20578":53501,"_5":14121,"_26960":53424,"_2870":53502},[],"**Icon** and **Tags**: optional classification.",{"_3383":1691,"_29651":1662,"_20578":53504,"_5":14121,"_26960":53424,"_2870":53505},[],"Confirm registration.",{"_3383":1692,"_29651":1662,"_20578":53507,"_5":14121,"_26960":53428,"_2870":53508},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_3383":1693,"_29651":1662,"_20578":53510,"_5":14121,"_26960":53428,"_2870":53511},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_3383":1694,"_29651":1662,"_20578":53513,"_5":14121,"_26960":53432,"_2870":53514},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_3383":1695,"_29651":1662,"_20578":53516,"_5":14121,"_26960":53432,"_2870":53517},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_3383":1696,"_29651":1662,"_20578":53519,"_5":14121,"_26960":53436,"_2870":53520},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_3383":1697,"_29651":1662,"_20578":53522,"_5":14121,"_26960":53436,"_2870":53523},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_3383":1698,"_29651":1662,"_20578":53525,"_5":14121,"_26960":53440,"_2870":53376},[],{"_3383":1699,"_29651":1662,"_20578":53527,"_5":14121,"_26960":53440,"_2870":53528},[],"Result",{"_3383":1700,"_29651":1662,"_20578":53530,"_5":14121,"_26960":53440,"_2870":52626},[],{"_3383":1701,"_29651":1662,"_20578":53532,"_5":14121,"_26960":53440,"_2870":53533},[],"`device-001` appears in inventory with the expected DMS.",{"_3383":1702,"_29651":1662,"_20578":53535,"_5":14121,"_26960":53440,"_2870":53536},[],"Current identity",{"_3383":1703,"_29651":1662,"_20578":53538,"_5":14121,"_26960":53440,"_2870":53539},[],"The associated certificate matches the one you verified in PKI.",{"_3383":1704,"_29651":1662,"_20578":53541,"_5":14121,"_26960":53440,"_2870":53542},[],"History",{"_3383":1705,"_29651":1662,"_20578":53544,"_5":14121,"_26960":53440,"_2870":53545},[],"The associated issuance appears with its serial number and dates.",{"_3383":1706,"_29651":1662,"_20578":53547,"_5":14121,"_26960":53440,"_2870":53548},[],"Key and certificate",{"_3383":1707,"_29651":1662,"_20578":53550,"_5":14121,"_26960":53440,"_2870":53551},[],"You have the verified pair ready to install on the device.",{"_3383":1708,"_29651":1662,"_20578":53553,"_5":14121,"_26960":53443,"_2870":53554},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_3383":1709,"_29651":1662,"_20578":53556,"_5":14121,"_26960":53443,"_2870":53557},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_3383":1710,"_29651":1662,"_20578":53559,"_5":14121,"_26960":53443,"_2870":53560},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_3383":1711,"_29651":1662,"_20578":53562,"_5":14121,"_26960":53443,"_2870":53563},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_3383":1712,"_29651":1662,"_20578":53565,"_5":14121,"_26960":53447,"_2870":53566},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_3383":1713,"_29651":1662,"_20578":53568,"_5":14121,"_26960":53447,"_2870":53569},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_3383":1714,"_29651":1662,"_20578":53571,"_5":14121,"_26960":53447,"_2870":53572},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_3383":1715,"_29651":1715,"_5":14473,"_2870":53574,"_30004":53575,"_20578":53576,"_26960":1715},"Lamassu IoT Platform",[48280,49748],[],{"_3383":1716,"_29651":1715,"_20578":53578,"_5":14121,"_26960":1715,"_2870":53579},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_3383":1717,"_29651":1715,"_5":30001,"_20578":53581,"_26960":53582,"_2870":53062},[],"/docs/pr-preview/pr-55/platform/overview#start-here",{"_3383":1718,"_29651":1715,"_5":30001,"_20578":53584,"_26960":53585,"_2870":53586},[],"/docs/pr-preview/pr-55/platform/overview#choose-your-path","Choose your path",{"_3383":1719,"_29651":1715,"_5":30001,"_20578":53588,"_26960":53589,"_2870":53590},[],"/docs/pr-preview/pr-55/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_3383":1720,"_29651":1715,"_5":30001,"_20578":53592,"_26960":53593,"_2870":53594},[],"/docs/pr-preview/pr-55/platform/overview#core-capabilities","Core capabilities",{"_3383":1721,"_29651":1715,"_5":30001,"_20578":53596,"_26960":53597,"_2870":53598},[],"/docs/pr-preview/pr-55/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_3383":1722,"_29651":1715,"_5":30001,"_20578":53600,"_26960":53601,"_2870":53602},[],"/docs/pr-preview/pr-55/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_3383":1723,"_29651":1715,"_5":30001,"_20578":53604,"_26960":53605,"_2870":53606},[],"/docs/pr-preview/pr-55/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_3383":1724,"_29651":1715,"_5":30001,"_20578":53608,"_26960":53609,"_2870":53610},[],"/docs/pr-preview/pr-55/platform/overview#automate-device-identities","Automate device identities",{"_3383":1725,"_29651":1715,"_5":30001,"_20578":53612,"_26960":53613,"_2870":53614},[],"/docs/pr-preview/pr-55/platform/overview#publish-validation-status","Publish validation status",{"_3383":1726,"_29651":1715,"_5":30001,"_20578":53616,"_26960":53617,"_2870":53618},[],"/docs/pr-preview/pr-55/platform/overview#react-to-events","React to events",{"_3383":1727,"_29651":1715,"_5":30001,"_20578":53620,"_26960":53621,"_2870":53622},[],"/docs/pr-preview/pr-55/platform/overview#operational-reference","Operational reference",{"_3383":1728,"_29651":1715,"_20578":53624,"_5":14121,"_26960":1715,"_2870":53625},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_3383":1729,"_29651":1715,"_20578":53627,"_5":14121,"_26960":53582,"_2870":53628},[],"Choose the result you need:",{"_3383":1730,"_29651":1715,"_20578":53630,"_5":14121,"_26960":53582,"_2870":53631},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3383":1731,"_29651":1715,"_20578":53633,"_5":14121,"_26960":53582,"_2870":53634},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3383":1732,"_29651":1715,"_20578":53636,"_5":14121,"_26960":53582,"_2870":53637},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_3383":1733,"_29651":1715,"_20578":53639,"_5":14121,"_26960":53585,"_2870":53640},[],"Section",{"_3383":1734,"_29651":1715,"_20578":53642,"_5":14121,"_26960":53585,"_2870":53643},[],"What you manage",{"_3383":1735,"_29651":1715,"_20578":53645,"_5":14121,"_26960":53585,"_2870":53646},[],"Entry point",{"_3383":1736,"_29651":1715,"_20578":53648,"_5":14121,"_26960":53585,"_2870":53649},[],"**PKI**",{"_3383":1737,"_29651":1715,"_20578":53651,"_5":14121,"_26960":53585,"_2870":53652},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_3383":1738,"_29651":1715,"_20578":53654,"_5":14121,"_26960":53585,"_2870":53655},[],"PKI overview",{"_3383":1739,"_29651":1715,"_20578":53657,"_5":14121,"_26960":53585,"_2870":53658},[],"**IoT Fleets**",{"_3383":1740,"_29651":1715,"_20578":53660,"_5":14121,"_26960":53585,"_2870":53661},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_3383":1741,"_29651":1715,"_20578":53663,"_5":14121,"_26960":53585,"_2870":53664},[],"IoT Fleets overview",{"_3383":1742,"_29651":1715,"_20578":53666,"_5":14121,"_26960":53585,"_2870":53667},[],"**Administration**",{"_3383":1743,"_29651":1715,"_20578":53669,"_5":14121,"_26960":53585,"_2870":53670},[],"Operator permissions, audit and event subscriptions.",{"_3383":1744,"_29651":1715,"_20578":53672,"_5":14121,"_26960":53585,"_2870":49746},[],{"_3383":1745,"_29651":1715,"_20578":53674,"_5":14121,"_26960":53585,"_2870":53675},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_3383":1746,"_29651":1715,"_20578":53677,"_5":14121,"_26960":53589,"_2870":53678},[],"An identity's journey connects four responsibilities:",{"_3383":1747,"_29651":1715,"_20578":53680,"_5":14121,"_26960":53589,"_2870":53681},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_3383":1748,"_29651":1715,"_20578":53683,"_5":14121,"_26960":53589,"_2870":53684},[],"The provisioning administrator configures the DMS and initial trust.",{"_3383":1749,"_29651":1715,"_20578":53686,"_5":14121,"_26960":53589,"_2870":53687},[],"The device client requests a certificate and installs it with the matching key.",{"_3383":1750,"_29651":1715,"_20578":53689,"_5":14121,"_26960":53589,"_2870":53690},[],"The consumer validates the identity and applies its access permissions.",{"_3383":1751,"_29651":1715,"_20578":53692,"_5":14121,"_26960":53589,"_2870":53693},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_3383":1752,"_29651":1715,"_20578":53695,"_5":14121,"_26960":53597,"_2870":53696},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_3383":1753,"_29651":1715,"_20578":53698,"_5":14121,"_26960":53601,"_2870":53699},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_3383":1754,"_29651":1715,"_20578":53701,"_5":14121,"_26960":53605,"_2870":53702},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_3383":1755,"_29651":1715,"_20578":53704,"_5":14121,"_26960":53609,"_2870":53705},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_3383":1756,"_29651":1715,"_20578":53707,"_5":14121,"_26960":53613,"_2870":53708},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_3383":1757,"_29651":1715,"_20578":53710,"_5":14121,"_26960":53617,"_2870":53711},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_3383":1758,"_29651":1715,"_20578":53713,"_5":14121,"_26960":53621,"_2870":53156},[],{"_3383":1759,"_29651":1715,"_20578":53715,"_5":14121,"_26960":53621,"_2870":53716},[],"What it prepares or checks",{"_3383":1760,"_29651":1715,"_20578":53718,"_5":14121,"_26960":53621,"_2870":53159},[],{"_3383":1761,"_29651":1715,"_20578":53720,"_5":14121,"_26960":53621,"_2870":53721},[],"Key custody, CA hierarchy, profiles and validation.",{"_3383":1762,"_29651":1715,"_20578":53723,"_5":14121,"_26960":53621,"_2870":53724},[],"Fleet administrator",{"_3383":1763,"_29651":1715,"_20578":53726,"_5":14121,"_26960":53621,"_2870":53727},[],"DMS, device admission, renewal policy and inventory.",{"_3383":1764,"_29651":1715,"_20578":53729,"_5":14121,"_26960":53621,"_2870":53171},[],{"_3383":1765,"_29651":1715,"_20578":53731,"_5":14121,"_26960":53621,"_2870":53732},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_3383":1766,"_29651":1715,"_20578":53734,"_5":14121,"_26960":53621,"_2870":53177},[],{"_3383":1767,"_29651":1715,"_20578":53736,"_5":14121,"_26960":53621,"_2870":53737},[],"Issuer trust, certificate validation and permissions in the destination.",{"_3383":1768,"_29651":1715,"_20578":53739,"_5":14121,"_26960":53621,"_2870":53740},[],"Infrastructure operator",{"_3383":1769,"_29651":1715,"_20578":53742,"_5":14121,"_26960":53621,"_2870":53743},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_3383":1770,"_29651":1715,"_20578":53745,"_5":14121,"_26960":53621,"_2870":53746},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_3383":1771,"_29651":1771,"_5":14473,"_2870":53748,"_30004":53749,"_20578":53752,"_26960":1771},"CA hierarchy and rotation",[48280,49748,53750,53751],"PKI","Keys, authorities and certificates",[],{"_3383":1772,"_29651":1771,"_20578":53754,"_5":14121,"_26960":1771,"_2870":53755},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_3383":1773,"_29651":1771,"_5":30001,"_20578":53757,"_26960":53758,"_2870":53759},[],"/docs/pr-preview/pr-55/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_3383":1774,"_29651":1771,"_5":30001,"_20578":53761,"_26960":53762,"_2870":53763},[],"/docs/pr-preview/pr-55/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_3383":1775,"_29651":1771,"_5":30001,"_20578":53765,"_26960":53766,"_2870":53767},[],"/docs/pr-preview/pr-55/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_3383":1776,"_29651":1771,"_5":30001,"_20578":53769,"_26960":53770,"_2870":53771},[],"/docs/pr-preview/pr-55/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_3383":1777,"_29651":1771,"_5":30001,"_20578":53773,"_26960":53774,"_2870":53775},[],"/docs/pr-preview/pr-55/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_3383":1778,"_29651":1771,"_5":30001,"_20578":53777,"_26960":53778,"_2870":53779},[],"/docs/pr-preview/pr-55/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_3383":1779,"_29651":1771,"_5":30001,"_20578":53781,"_26960":53782,"_2870":53783},[],"/docs/pr-preview/pr-55/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_3383":1780,"_29651":1771,"_5":30001,"_20578":53785,"_26960":53786,"_2870":53787},[],"/docs/pr-preview/pr-55/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_3383":1781,"_29651":1771,"_5":30001,"_20578":53789,"_26960":53790,"_2870":53791},[],"/docs/pr-preview/pr-55/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_3383":1782,"_29651":1771,"_5":30001,"_20578":53793,"_26960":53794,"_2870":53795},[],"/docs/pr-preview/pr-55/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_3383":1783,"_29651":1771,"_5":30001,"_20578":53797,"_26960":53798,"_2870":53799},[],"/docs/pr-preview/pr-55/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_3383":1784,"_29651":1771,"_5":30001,"_20578":53801,"_26960":53802,"_2870":53803},[],"/docs/pr-preview/pr-55/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_3383":1785,"_29651":1771,"_20578":53805,"_5":14121,"_26960":1771,"_2870":53806},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_3383":1786,"_29651":1771,"_20578":53808,"_5":14121,"_26960":1771,"_2870":53809},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_3383":1787,"_29651":1771,"_20578":53811,"_5":14121,"_26960":53758,"_2870":53812},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_3383":1788,"_29651":1771,"_20578":53814,"_5":14121,"_26960":53758,"_2870":53815},[],"environment, such as production and preproduction;",{"_3383":1789,"_29651":1771,"_20578":53817,"_5":14121,"_26960":53758,"_2870":53818},[],"owner or operating team;",{"_3383":1790,"_29651":1771,"_20578":53820,"_5":14121,"_26960":53758,"_2870":53821},[],"device family or manufacturing process;",{"_3383":1791,"_29651":1771,"_20578":53823,"_5":14121,"_26960":53758,"_2870":53824},[],"region or regulatory requirement;",{"_3383":1792,"_29651":1771,"_20578":53826,"_5":14121,"_26960":53758,"_2870":53827},[],"cryptographic engine or key policy;",{"_3383":1793,"_29651":1771,"_20578":53829,"_5":14121,"_26960":53758,"_2870":53830},[],"maintenance window and renewal cadence.",{"_3383":1794,"_29651":1771,"_20578":53832,"_5":14121,"_26960":53758,"_2870":53833},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_3383":1795,"_29651":1771,"_20578":53835,"_5":14121,"_26960":53758,"_2870":53836},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_3383":1796,"_29651":1771,"_20578":53838,"_5":14121,"_26960":53762,"_2870":53839},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_3383":1797,"_29651":1771,"_20578":53841,"_5":14121,"_26960":53762,"_2870":53842},[],"If a VA CRL role for the CA is signed by the superseded CA certificate, reissuing moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. Otherwise, and for a role signed by a different certificate, the role keeps its signer, so check the new certificate’s key usage after reissuing; see the CRL guide.",{"_3383":1798,"_29651":1771,"_20578":53844,"_5":14121,"_26960":53762,"_2870":53845},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_3383":1799,"_29651":1771,"_20578":53847,"_5":14121,"_26960":53762,"_2870":53848},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_3383":1800,"_29651":1771,"_20578":53850,"_5":14121,"_26960":53766,"_2870":53851},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_3383":1801,"_29651":1771,"_20578":53853,"_5":14121,"_26960":53766,"_2870":53854},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_3383":1802,"_29651":1771,"_20578":53856,"_5":14121,"_26960":53766,"_2870":53857},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_3383":1803,"_29651":1771,"_20578":53859,"_5":14121,"_26960":53766,"_2870":53860},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_3383":1804,"_29651":1771,"_20578":53862,"_5":14121,"_26960":53774,"_2870":53863},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_3383":1805,"_29651":1771,"_20578":53865,"_5":14121,"_26960":53778,"_2870":53866},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_3383":1806,"_29651":1771,"_20578":53868,"_5":14121,"_26960":53782,"_2870":53869},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_3383":1807,"_29651":1771,"_20578":53871,"_5":14121,"_26960":53786,"_2870":53872},[],"Update the enrollment CA and profile of the DMSs. While old-CA cohorts still renew, add the previous enrollment CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`): the new enrollment CA is trusted automatically, but the old one was the enrollment CA and appears in no re-enrollment trust list, so without that entry its certificates can no longer renew. The DMS guide documents the setting.",{"_3383":1808,"_29651":1771,"_20578":53874,"_5":14121,"_26960":53790,"_2870":53875},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_3383":1809,"_29651":1771,"_20578":53877,"_5":14121,"_26960":53794,"_2870":53878},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance, from the re-enrollment validation CAs and from the distributed CAs. Revoke it if policy requires it.",{"_3383":1810,"_29651":1771,"_20578":53880,"_5":14121,"_26960":53798,"_2870":53881},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_3383":1811,"_29651":1771,"_20578":53883,"_5":14121,"_26960":53798,"_2870":53884},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_3383":1812,"_29651":1771,"_20578":53886,"_5":14121,"_26960":53798,"_2870":53887},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_3383":1813,"_29651":1771,"_20578":53889,"_5":14121,"_26960":53798,"_2870":53890},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_3383":1814,"_29651":1771,"_20578":53892,"_5":14121,"_26960":53802,"_2870":53893},[],"The new chain ends in an anchor installed by the consumer.",{"_3383":1815,"_29651":1771,"_20578":53895,"_5":14121,"_26960":53802,"_2870":53896},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_3383":1816,"_29651":1771,"_20578":53898,"_5":14121,"_26960":53802,"_2870":53899},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_3383":1817,"_29651":1771,"_20578":53901,"_5":14121,"_26960":53802,"_2870":53902},[],"Re-enrollment accepts the old identity during the planned period.",{"_3383":1818,"_29651":1771,"_20578":53904,"_5":14121,"_26960":53802,"_2870":53905},[],"OCSP and CRL respond for the authorities that remain active.",{"_3383":1819,"_29651":1771,"_20578":53907,"_5":14121,"_26960":53802,"_2870":53908},[],"No DMS is left accidentally issuing from the old CA.",{"_3383":1820,"_29651":1771,"_20578":53910,"_5":14121,"_26960":53802,"_2870":53911},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_3383":1821,"_29651":1821,"_5":14473,"_2870":53913,"_30004":53914,"_20578":53915,"_26960":1821},"Certification authorities",[48280,49748,53750,53751],[],{"_3383":1822,"_29651":1821,"_20578":53917,"_5":14121,"_26960":1821,"_2870":53918},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_3383":1823,"_29651":1821,"_5":30001,"_20578":53920,"_26960":53921,"_2870":53922},[],"/docs/pr-preview/pr-55/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_3383":1824,"_29651":1821,"_5":30001,"_20578":53924,"_26960":53925,"_2870":53926},[],"/docs/pr-preview/pr-55/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_3383":1825,"_29651":1821,"_5":30001,"_20578":53928,"_26960":53929,"_2870":48290},[],"/docs/pr-preview/pr-55/platform/pki/certificate-authorities#before-you-begin",{"_3383":1826,"_29651":1821,"_5":30001,"_20578":53931,"_26960":53932,"_2870":53933},[],"/docs/pr-preview/pr-55/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_3383":1827,"_29651":1821,"_5":30001,"_20578":53935,"_26960":53936,"_2870":53937},[],"/docs/pr-preview/pr-55/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_3383":1828,"_29651":1821,"_5":30001,"_20578":53939,"_26960":53940,"_2870":53941},[],"/docs/pr-preview/pr-55/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_3383":1829,"_29651":1821,"_5":30001,"_20578":53943,"_26960":53944,"_2870":53945},[],"/docs/pr-preview/pr-55/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_3383":1830,"_29651":1821,"_5":30001,"_20578":53947,"_26960":53948,"_2870":53949},[],"/docs/pr-preview/pr-55/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_3383":1831,"_29651":1821,"_5":30001,"_20578":53951,"_26960":53952,"_2870":53953},[],"/docs/pr-preview/pr-55/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_3383":1832,"_29651":1821,"_5":30001,"_20578":53955,"_26960":53956,"_2870":53957},[],"/docs/pr-preview/pr-55/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_3383":1833,"_29651":1821,"_5":30001,"_20578":53959,"_26960":53960,"_2870":53961},[],"/docs/pr-preview/pr-55/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_3383":1834,"_29651":1821,"_5":30001,"_20578":53963,"_26960":53964,"_2870":53965},[],"/docs/pr-preview/pr-55/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_3383":1835,"_29651":1821,"_5":30001,"_20578":53967,"_26960":53968,"_2870":53969},[],"/docs/pr-preview/pr-55/platform/pki/certificate-authorities#load-the-material","Load the material",{"_3383":1836,"_29651":1821,"_5":30001,"_20578":53971,"_26960":53972,"_2870":53973},[],"/docs/pr-preview/pr-55/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_3383":1837,"_29651":1821,"_5":30001,"_20578":53975,"_26960":53976,"_2870":53977},[],"/docs/pr-preview/pr-55/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_3383":1838,"_29651":1821,"_5":30001,"_20578":53979,"_26960":53980,"_2870":53981},[],"/docs/pr-preview/pr-55/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_3383":1839,"_29651":1821,"_5":30001,"_20578":53983,"_26960":53984,"_2870":53985},[],"/docs/pr-preview/pr-55/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_3383":1840,"_29651":1821,"_5":30001,"_20578":53987,"_26960":53988,"_2870":53989},[],"/docs/pr-preview/pr-55/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_3383":1841,"_29651":1821,"_5":30001,"_20578":53991,"_26960":53992,"_2870":53993},[],"/docs/pr-preview/pr-55/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_3383":1842,"_29651":1821,"_5":30001,"_20578":53995,"_26960":53996,"_2870":53997},[],"/docs/pr-preview/pr-55/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_3383":1843,"_29651":1821,"_5":30001,"_20578":53999,"_26960":54000,"_2870":54001},[],"/docs/pr-preview/pr-55/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_3383":1844,"_29651":1821,"_5":30001,"_20578":54003,"_26960":54004,"_2870":54005},[],"/docs/pr-preview/pr-55/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_3383":1845,"_29651":1821,"_5":30001,"_20578":54007,"_26960":54008,"_2870":54009},[],"/docs/pr-preview/pr-55/platform/pki/certificate-authorities#delete-a-ca","Delete a CA",{"_3383":1846,"_29651":1821,"_20578":54011,"_5":14121,"_26960":1821,"_2870":54012},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_3383":1847,"_29651":1821,"_20578":54014,"_5":14121,"_26960":1821,"_2870":54015},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_3383":1848,"_29651":1821,"_20578":54017,"_5":14121,"_26960":1821,"_2870":54018},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_3383":1849,"_29651":1821,"_20578":54020,"_5":14121,"_26960":53921,"_2870":54021},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_3383":1850,"_29651":1821,"_20578":54023,"_5":14121,"_26960":53921,"_2870":54024},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_3383":1851,"_29651":1821,"_20578":54026,"_5":14121,"_26960":53921,"_2870":54027},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_3383":1852,"_29651":1821,"_20578":54029,"_5":14121,"_26960":53921,"_2870":54030},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_3383":1853,"_29651":1821,"_20578":54032,"_5":14121,"_26960":53921,"_2870":54033},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_3383":1854,"_29651":1821,"_20578":54035,"_5":14121,"_26960":53929,"_2870":54036},[],"Decide whether the CA will be a root or an intermediate.",{"_3383":1855,"_29651":1821,"_20578":54038,"_5":14121,"_26960":53929,"_2870":54039},[],"Choose the engine that will keep the key.",{"_3383":1856,"_29651":1821,"_20578":54041,"_5":14121,"_26960":53929,"_2870":54042},[],"Define a validity longer than that of the certificates it will issue.",{"_3383":1857,"_29651":1821,"_20578":54044,"_5":14121,"_26960":53929,"_2870":54045},[],"For an intermediate CA, make sure the parent CA is active.",{"_3383":1858,"_29651":1821,"_20578":54047,"_5":14121,"_26960":53932,"_2870":54048},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_3383":1859,"_29651":1821,"_20578":54050,"_5":14121,"_26960":53936,"_2870":54051},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_3383":1860,"_29651":1821,"_20578":54053,"_5":14121,"_26960":53936,"_2870":54054},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_3383":1861,"_29651":1821,"_20578":54056,"_5":14121,"_26960":53940,"_2870":54057},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_3383":1862,"_29651":1821,"_20578":54059,"_5":14121,"_26960":53944,"_2870":54060},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_3383":1863,"_29651":1821,"_20578":54062,"_5":14121,"_26960":53944,"_2870":54063},[],"`C`: two-letter ISO 3166-1 country code.",{"_3383":1864,"_29651":1821,"_20578":54065,"_5":14121,"_26960":53944,"_2870":54066},[],"`ST`: state or province.",{"_3383":1865,"_29651":1821,"_20578":54068,"_5":14121,"_26960":53944,"_2870":54069},[],"`L`: locality.",{"_3383":1866,"_29651":1821,"_20578":54071,"_5":14121,"_26960":53944,"_2870":54072},[],"`O`: organization.",{"_3383":1867,"_29651":1821,"_20578":54074,"_5":14121,"_26960":53944,"_2870":54075},[],"`OU`: organizational unit.",{"_3383":1868,"_29651":1821,"_20578":54077,"_5":14121,"_26960":53944,"_2870":54078},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_3383":1869,"_29651":1821,"_20578":54080,"_5":14121,"_26960":53948,"_2870":54081},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_3383":1870,"_29651":1821,"_20578":54083,"_5":14121,"_26960":53948,"_2870":54084},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_3383":1871,"_29651":1821,"_20578":54086,"_5":14121,"_26960":53952,"_2870":54087},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_3383":1872,"_29651":1821,"_20578":54089,"_5":14121,"_26960":53952,"_2870":54090},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_3383":1873,"_29651":1821,"_20578":54092,"_5":14121,"_26960":53956,"_2870":54093},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_3383":1874,"_29651":1821,"_20578":54095,"_5":14121,"_26960":53956,"_2870":54096},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_3383":1875,"_29651":1821,"_20578":54098,"_5":14121,"_26960":53960,"_2870":54099},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages (including `cRLSign`, without which the CA cannot publish its CRL) and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_3383":1876,"_29651":1821,"_20578":54101,"_5":14121,"_26960":53960,"_2870":54102},[],"The backend rejects an import whose certificate lacks the CA basic constraint (`basicConstraints cA flag is not set`), whose serial number matches a stored certificate with different contents, or whose identical certificate already belongs to an existing CA. A deleted CA's certificate record is kept and can be reused when re-importing the same certificate, including its previous status. Re-importing a different certificate with that serial number is rejected; check the certificate and status after re-importing.",{"_3383":1877,"_29651":1821,"_20578":54104,"_5":14121,"_26960":53960,"_2870":54105},[],"Deleting a CA releases the key references of its own current certificate and linked reissued certificates, while keeping those records for its issuer's CRL and OCSP. It then attempts to delete the key; the KMS keeps it if other certificates still reference it, such as another CA sharing the key. Revoking certificates issued by the deleted CA does not release their own key references.",{"_3383":1878,"_29651":1821,"_20578":54107,"_5":14121,"_26960":53964,"_2870":54108},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_3383":1879,"_29651":1821,"_20578":54110,"_5":14121,"_26960":53968,"_2870":54111},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_3383":1880,"_29651":1821,"_20578":54113,"_5":14121,"_26960":53972,"_2870":54114},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_3383":1881,"_29651":1821,"_20578":54116,"_5":14121,"_26960":53976,"_2870":54117},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_3383":1882,"_29651":1821,"_20578":54119,"_5":14121,"_26960":53976,"_2870":54120},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_3383":1883,"_29651":1821,"_20578":54122,"_5":14121,"_26960":53980,"_2870":54123},[],"Open a CA from the inventory to review:",{"_3383":1884,"_29651":1821,"_20578":54125,"_5":14121,"_26960":53980,"_2870":54126},[],"Status and validity period.",{"_3383":1885,"_29651":1821,"_20578":54128,"_5":14121,"_26960":53980,"_2870":54129},[],"Certificate and chain in PEM format.",{"_3383":1886,"_29651":1821,"_20578":54131,"_5":14121,"_26960":53980,"_2870":54132},[],"Number of active, expired and revoked certificates.",{"_3383":1887,"_29651":1821,"_20578":54134,"_5":14121,"_26960":53980,"_2870":54135},[],"Certificates issued in **Issued Certificates**.",{"_3383":1888,"_29651":1821,"_20578":54137,"_5":14121,"_26960":53980,"_2870":54138},[],"The CRL linked to the authority.",{"_3383":1889,"_29651":1821,"_20578":54140,"_5":14121,"_26960":53980,"_2870":54141},[],"Metadata and the associated cryptographic engine.",{"_3383":1890,"_29651":1821,"_20578":54143,"_5":14121,"_26960":53980,"_2870":54144},[],"You can filter the inventory by name, status and CA type.",{"_3383":1891,"_29651":1821,"_20578":54146,"_5":14121,"_26960":53984,"_2870":54147},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_3383":1892,"_29651":1821,"_20578":54149,"_5":14121,"_26960":53984,"_2870":54150},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_3383":1893,"_29651":1821,"_20578":54152,"_5":14121,"_26960":53984,"_2870":54153},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_3383":1894,"_29651":1821,"_20578":54155,"_5":14121,"_26960":53984,"_2870":54156},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_3383":1895,"_29651":1821,"_20578":54158,"_5":14121,"_26960":53988,"_2870":54159},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_3383":1896,"_29651":1821,"_20578":54161,"_5":14121,"_26960":53992,"_2870":54162},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_3383":1897,"_29651":1821,"_20578":54164,"_5":14121,"_26960":53996,"_2870":54165},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_3383":1898,"_29651":1821,"_20578":54167,"_5":14121,"_26960":54000,"_2870":54168},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_3383":1899,"_29651":1821,"_20578":54170,"_5":14121,"_26960":54004,"_2870":54171},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_3383":1900,"_29651":1821,"_20578":54173,"_5":14121,"_26960":54008,"_2870":54174},[],"Permanent deletion is only available with the CA revoked or expired; a CA imported without a key can be deleted in any state. Delete the record only when your retention and audit policy allows it.",{"_3383":1901,"_29651":1821,"_20578":54176,"_5":14121,"_26960":54008,"_2870":54177},[],"The CA’s VA role is kept. If no other CA with the same SKI remains, it can no longer be edited (see CRL), so adjust its validity and signer beforehand. The CA’s key is released, but the KMS keeps it while other certificates still reference it.",{"_3383":1902,"_29651":1821,"_20578":54179,"_5":14121,"_26960":54008,"_2870":54180},[],"Lamassu keeps the certificate record of a deleted CA. If that same certificate is imported again, the import succeeds and reuses the record: it updates the type, issuer and key but keeps the status, so the CA reappears in the state it had when deleted (normally revoked or expired). A different certificate with the same serial number is rejected with a 400 error, and a certificate that already belongs to an existing CA with a 409 error. To avoid inheriting the previous status, use a certificate with a different serial number and check the result after importing. If the new certificate uses the same key, it shares the SKI with the retained VA role of the deleted CA, whose signer is the old certificate: check that the CRL is generated and, if it is not, use `PUT` to set a signer of the new CA (see CRL).",{"_3383":1903,"_29651":1903,"_5":14473,"_2870":54182,"_30004":54183,"_20578":54184,"_26960":1903},"Certificate profiles",[48280,49748,53750,53751],[],{"_3383":1904,"_29651":1903,"_20578":54186,"_5":14121,"_26960":1903,"_2870":54187},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_3383":1905,"_29651":1903,"_5":30001,"_20578":54189,"_26960":54190,"_2870":54191},[],"/docs/pr-preview/pr-55/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_3383":1906,"_29651":1903,"_5":30001,"_20578":54193,"_26960":54194,"_2870":54195},[],"/docs/pr-preview/pr-55/platform/pki/certificate-profiles#validity","Validity",{"_3383":1907,"_29651":1903,"_5":30001,"_20578":54197,"_26960":54198,"_2870":54199},[],"/docs/pr-preview/pr-55/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_3383":1908,"_29651":1903,"_5":30001,"_20578":54201,"_26960":54202,"_2870":54203},[],"/docs/pr-preview/pr-55/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_3383":1909,"_29651":1903,"_5":30001,"_20578":54205,"_26960":54206,"_2870":54207},[],"/docs/pr-preview/pr-55/platform/pki/certificate-profiles#subject","Subject",{"_3383":1910,"_29651":1903,"_5":30001,"_20578":54209,"_26960":54210,"_2870":54211},[],"/docs/pr-preview/pr-55/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_3383":1911,"_29651":1903,"_5":30001,"_20578":54213,"_26960":54214,"_2870":54215},[],"/docs/pr-preview/pr-55/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_3383":1912,"_29651":1903,"_5":30001,"_20578":54217,"_26960":54218,"_2870":54219},[],"/docs/pr-preview/pr-55/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_3383":1913,"_29651":1903,"_5":30001,"_20578":54221,"_26960":54222,"_2870":54223},[],"/docs/pr-preview/pr-55/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_3383":1914,"_29651":1903,"_5":30001,"_20578":54225,"_26960":54226,"_2870":54227},[],"/docs/pr-preview/pr-55/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_3383":1915,"_29651":1903,"_5":30001,"_20578":54229,"_26960":54230,"_2870":54231},[],"/docs/pr-preview/pr-55/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_3383":1916,"_29651":1903,"_5":30001,"_20578":54233,"_26960":54234,"_2870":54235},[],"/docs/pr-preview/pr-55/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_3383":1917,"_29651":1903,"_5":30001,"_20578":54237,"_26960":54238,"_2870":54239},[],"/docs/pr-preview/pr-55/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_3383":1918,"_29651":1903,"_5":30001,"_20578":54241,"_26960":54242,"_2870":54243},[],"/docs/pr-preview/pr-55/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_3383":1919,"_29651":1903,"_5":30001,"_20578":54245,"_26960":54246,"_2870":54247},[],"/docs/pr-preview/pr-55/platform/pki/certificate-profiles#design-examples","Design examples",{"_3383":1920,"_29651":1903,"_5":30001,"_20578":54249,"_26960":54250,"_2870":54251},[],"/docs/pr-preview/pr-55/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_3383":1921,"_29651":1903,"_20578":54253,"_5":14121,"_26960":1903,"_2870":54254},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_3383":1922,"_29651":1903,"_20578":54256,"_5":14121,"_26960":1903,"_2870":54257},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_3383":1923,"_29651":1903,"_20578":54259,"_5":14121,"_26960":54194,"_2870":54260},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_3383":1924,"_29651":1903,"_20578":54262,"_5":14121,"_26960":54194,"_2870":54263},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_3383":1925,"_29651":1903,"_20578":54265,"_5":14121,"_26960":54198,"_2870":54266},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Enable it only in profiles intended to create or reissue subordinate CAs.",{"_3383":1926,"_29651":1903,"_20578":54268,"_5":14121,"_26960":54202,"_2870":54269},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_3383":1927,"_29651":1903,"_20578":54271,"_5":14121,"_26960":54202,"_2870":54272},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_3383":1928,"_29651":1903,"_20578":54274,"_5":14121,"_26960":54202,"_2870":54275},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_3383":1929,"_29651":1903,"_20578":54277,"_5":14121,"_26960":54206,"_2870":54278},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_3383":1930,"_29651":1903,"_20578":54280,"_5":14121,"_26960":54210,"_2870":54281},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_3383":1931,"_29651":1903,"_20578":54283,"_5":14121,"_26960":54210,"_2870":54284},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_3383":1932,"_29651":1903,"_20578":54286,"_5":14121,"_26960":54214,"_2870":54287},[],"The cryptographic enforcement can:",{"_3383":1933,"_29651":1903,"_20578":54289,"_5":14121,"_26960":54214,"_2870":54290},[],"allow or block RSA keys;",{"_3383":1934,"_29651":1903,"_20578":54292,"_5":14121,"_26960":54214,"_2870":54293},[],"limit the supported RSA sizes;",{"_3383":1935,"_29651":1903,"_20578":54295,"_5":14121,"_26960":54214,"_2870":54296},[],"allow or block ECDSA keys;",{"_3383":1936,"_29651":1903,"_20578":54298,"_5":14121,"_26960":54214,"_2870":54299},[],"limit the supported ECDSA sizes or curves.",{"_3383":1937,"_29651":1903,"_20578":54301,"_5":14121,"_26960":54214,"_2870":54302},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_3383":1938,"_29651":1903,"_20578":54304,"_5":14121,"_26960":54218,"_2870":54305},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_3383":1939,"_29651":1903,"_20578":54307,"_5":14121,"_26960":54218,"_2870":51512},[],{"_3383":1940,"_29651":1903,"_20578":54309,"_5":14121,"_26960":54218,"_2870":54310},[],"First choice",{"_3383":1941,"_29651":1903,"_20578":54312,"_5":14121,"_26960":54218,"_2870":54313},[],"Second choice",{"_3383":1942,"_29651":1903,"_20578":54315,"_5":14121,"_26960":54218,"_2870":54316},[],"If neither is supplied",{"_3383":1943,"_29651":1903,"_20578":54318,"_5":14121,"_26960":54218,"_2870":54319},[],"Direct signing with a CA",{"_3383":1944,"_29651":1903,"_20578":54321,"_5":14121,"_26960":54218,"_2870":54322},[],"`issuance_profile` embedded in the request",{"_3383":1945,"_29651":1903,"_20578":54324,"_5":14121,"_26960":54218,"_2870":54325},[],"Request `issuance_profile_id`",{"_3383":1946,"_29651":1903,"_20578":54327,"_5":14121,"_26960":54218,"_2870":54328},[],"CA default profile (`profile_id`).",{"_3383":1947,"_29651":1903,"_20578":54330,"_5":14121,"_26960":54218,"_2870":54331},[],"Issuance through a DMS",{"_3383":1948,"_29651":1903,"_20578":54333,"_5":14121,"_26960":54218,"_2870":54334},[],"`settings.issuance_profile_id`",{"_3383":1949,"_29651":1903,"_20578":54336,"_5":14121,"_26960":54218,"_2870":54337},[],"`settings.issuance_profile` embedded in the DMS",{"_3383":1950,"_29651":1903,"_20578":54339,"_5":14121,"_26960":54218,"_2870":54340},[],"Enrollment CA default profile.",{"_3383":1951,"_29651":1903,"_20578":54342,"_5":14121,"_26960":54218,"_2870":54343},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_3383":1952,"_29651":1903,"_20578":54345,"_5":14121,"_26960":54218,"_2870":54346},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_3383":1953,"_29651":1903,"_20578":54348,"_5":14121,"_26960":54226,"_2870":54349},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_3383":1954,"_29651":1903,"_20578":54351,"_5":14121,"_26960":54230,"_2870":54352},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_3383":1955,"_29651":1903,"_20578":54354,"_5":14121,"_26960":54234,"_2870":54355},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_3383":1956,"_29651":1903,"_20578":54357,"_5":14121,"_26960":54238,"_2870":54358},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_3383":1957,"_29651":1903,"_20578":54360,"_5":14121,"_26960":54242,"_2870":54361},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_3383":1958,"_29651":1903,"_20578":54363,"_5":14121,"_26960":54242,"_2870":54364},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_3383":1959,"_29651":1903,"_20578":54366,"_5":14121,"_26960":54246,"_2870":54367},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_3383":1960,"_29651":1903,"_20578":54369,"_5":14121,"_26960":54246,"_2870":54370},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_3383":1961,"_29651":1903,"_20578":54372,"_5":14121,"_26960":54246,"_2870":54373},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_3383":1962,"_29651":1903,"_20578":54375,"_5":14121,"_26960":54246,"_2870":54376},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_3383":1963,"_29651":1903,"_20578":54378,"_5":14121,"_26960":54250,"_2870":54379},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_3383":1964,"_29651":1903,"_20578":54381,"_5":14121,"_26960":54250,"_2870":54382},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_3383":1965,"_29651":1965,"_5":14473,"_2870":54384,"_30004":54385,"_20578":54387,"_26960":1965},"Certificate validation",[48280,49748,53750,54386],"Validation",[],{"_3383":1966,"_29651":1965,"_20578":54389,"_5":14121,"_26960":1965,"_2870":54390},[],"Check chain, identity, purpose and revocation from the consumer.",{"_3383":1967,"_29651":1965,"_5":30001,"_20578":54392,"_26960":54393,"_2870":54394},[],"/docs/pr-preview/pr-55/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_3383":1968,"_29651":1965,"_5":30001,"_20578":54396,"_26960":54397,"_2870":54398},[],"/docs/pr-preview/pr-55/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_3383":1969,"_29651":1965,"_5":30001,"_20578":54400,"_26960":54401,"_2870":54402},[],"/docs/pr-preview/pr-55/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_3383":1970,"_29651":1965,"_20578":54404,"_5":14121,"_26960":1965,"_2870":54405},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_3383":1971,"_29651":1965,"_20578":54407,"_5":14121,"_26960":54393,"_2870":54408},[],"Verify these criteria together:",{"_3383":1972,"_29651":1965,"_20578":54410,"_5":14121,"_26960":54393,"_2870":53376},[],{"_3383":1973,"_29651":1965,"_20578":54412,"_5":14121,"_26960":54393,"_2870":54413},[],"Required result",{"_3383":1974,"_29651":1965,"_20578":54415,"_5":14121,"_26960":54393,"_2870":54416},[],"Chain and signature",{"_3383":1975,"_29651":1965,"_20578":54418,"_5":14121,"_26960":54393,"_2870":54419},[],"Valid chain to a root deliberately installed in the consumer.",{"_3383":1976,"_29651":1965,"_20578":54421,"_5":14121,"_26960":54393,"_2870":54422},[],"Dates",{"_3383":1977,"_29651":1965,"_20578":54424,"_5":14121,"_26960":54393,"_2870":54425},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_3383":1978,"_29651":1965,"_20578":54427,"_5":14121,"_26960":54393,"_2870":49417},[],{"_3383":1979,"_29651":1965,"_20578":54429,"_5":14121,"_26960":54393,"_2870":54430},[],"Name, SAN or identifier matches the expected peer.",{"_3383":1980,"_29651":1965,"_20578":54432,"_5":14121,"_26960":54393,"_2870":48670},[],{"_3383":1981,"_29651":1965,"_20578":54434,"_5":14121,"_26960":54393,"_2870":54435},[],"KU, EKU and constraints permit the specific operation.",{"_3383":1982,"_29651":1965,"_20578":54437,"_5":14121,"_26960":54393,"_2870":54438},[],"Revocation",{"_3383":1983,"_29651":1965,"_20578":54440,"_5":14121,"_26960":54393,"_2870":54441},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_3383":1984,"_29651":1965,"_20578":54443,"_5":14121,"_26960":54393,"_2870":54444},[],"Authorization",{"_3383":1985,"_29651":1965,"_20578":54446,"_5":14121,"_26960":54393,"_2870":54447},[],"The application permits that identity to perform the action.",{"_3383":1986,"_29651":1965,"_20578":54449,"_5":14121,"_26960":54393,"_2870":54450},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_3383":1987,"_29651":1965,"_20578":54452,"_5":14121,"_26960":54397,"_2870":54453},[],"Mechanism",{"_3383":1988,"_29651":1965,"_20578":54455,"_5":14121,"_26960":54397,"_2870":54456},[],"When to use it",{"_3383":1989,"_29651":1965,"_20578":54458,"_5":14121,"_26960":54397,"_2870":54459},[],"What you must maintain",{"_3383":1990,"_29651":1965,"_20578":54461,"_5":14121,"_26960":54397,"_2870":54462},[],"OCSP",{"_3383":1991,"_29651":1965,"_20578":54464,"_5":14121,"_26960":54397,"_2870":54465},[],"Status query for a specific certificate.",{"_3383":1992,"_29651":1965,"_20578":54467,"_5":14121,"_26960":54397,"_2870":54468},[],"Responder access, signature verification and cache/freshness policy.",{"_3383":1993,"_29651":1965,"_20578":54470,"_5":14121,"_26960":54397,"_2870":54471},[],"CRL",{"_3383":1994,"_29651":1965,"_20578":54473,"_5":14121,"_26960":54397,"_2870":54474},[],"Local checks for many certificates or offline operation.",{"_3383":1995,"_29651":1965,"_20578":54476,"_5":14121,"_26960":54397,"_2870":54477},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_3383":1996,"_29651":1965,"_20578":54479,"_5":14121,"_26960":54397,"_2870":54480},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_3383":1997,"_29651":1965,"_20578":54482,"_5":14121,"_26960":54397,"_2870":54483},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_3383":1998,"_29651":1965,"_20578":54485,"_5":14121,"_26960":54401,"_2870":54486},[],"Accept a current, authorized certificate with a known chain.",{"_3383":1999,"_29651":1965,"_20578":54488,"_5":14121,"_26960":54401,"_2870":54489},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_3383":2000,"_29651":1965,"_20578":54491,"_5":14121,"_26960":54401,"_2870":54492},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_3383":2001,"_29651":1965,"_20578":54494,"_5":14121,"_26960":54401,"_2870":54495},[],"Check that a new connection with that identity is rejected.",{"_3383":2002,"_29651":1965,"_20578":54497,"_5":14121,"_26960":54401,"_2870":54498},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_3383":2003,"_29651":1965,"_20578":54500,"_5":14121,"_26960":54401,"_2870":54501},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_3383":2004,"_29651":1965,"_20578":54503,"_5":14121,"_26960":54401,"_2870":54504},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_3383":2005,"_29651":1965,"_20578":54506,"_5":14121,"_26960":54401,"_2870":54507},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_3383":2006,"_29651":1965,"_20578":54509,"_5":14121,"_26960":54401,"_2870":54510},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_3383":2007,"_29651":2007,"_5":14473,"_2870":54512,"_30004":54513,"_20578":54514,"_26960":2007},"Certificates",[48280,49748,53750,53751],[],{"_3383":2008,"_29651":2007,"_20578":54516,"_5":14121,"_26960":2007,"_2870":54517},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_3383":2009,"_29651":2007,"_5":30001,"_20578":54519,"_26960":54520,"_2870":54521},[],"/docs/pr-preview/pr-55/platform/pki/certificates#find-a-certificate","Find a certificate",{"_3383":2010,"_29651":2007,"_5":30001,"_20578":54523,"_26960":54524,"_2870":54525},[],"/docs/pr-preview/pr-55/platform/pki/certificates#download-the-certificate","Download the certificate",{"_3383":2011,"_29651":2007,"_5":30001,"_20578":54527,"_26960":54528,"_2870":54529},[],"/docs/pr-preview/pr-55/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_3383":2012,"_29651":2007,"_5":30001,"_20578":54531,"_26960":54532,"_2870":54533},[],"/docs/pr-preview/pr-55/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_3383":2013,"_29651":2007,"_5":30001,"_20578":54535,"_26960":54536,"_2870":54537},[],"/docs/pr-preview/pr-55/platform/pki/certificates#open-the-action","Open the action",{"_3383":2014,"_29651":2007,"_5":30001,"_20578":54539,"_26960":54540,"_2870":54541},[],"/docs/pr-preview/pr-55/platform/pki/certificates#choose-a-reason","Choose a reason",{"_3383":2015,"_29651":2007,"_5":30001,"_20578":54543,"_26960":54544,"_2870":54545},[],"/docs/pr-preview/pr-55/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_3383":2016,"_29651":2007,"_5":30001,"_20578":54547,"_26960":54548,"_2870":54549},[],"/docs/pr-preview/pr-55/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_3383":2017,"_29651":2007,"_5":30001,"_20578":54551,"_26960":54552,"_2870":54553},[],"/docs/pr-preview/pr-55/platform/pki/certificates#continue","Continue",{"_3383":2018,"_29651":2007,"_20578":54555,"_5":14121,"_26960":2007,"_2870":54556},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_3383":2019,"_29651":2007,"_20578":54558,"_5":14121,"_26960":54520,"_2870":54559},[],"Filter by `Common Name`, serial, status and issuer. A certificate does not contain its private key, so the private-key surfaces answer which certificates have their key held in Lamassu’s KMS:",{"_3383":2020,"_29651":2007,"_20578":54561,"_5":14121,"_26960":54520,"_2870":54562},[],"The advanced **Private Key** filter, available on the Certificates page and on a CA’s **Issued Certificates** tab, narrows the list to **All Certificates**, **With Private Key** or **Without Private Key**.",{"_3383":2021,"_29651":2007,"_20578":54564,"_5":14121,"_26960":54520,"_2870":54565},[],"The sortable **Private Key** column — shown by default, hidden on narrow screens — marks a key held in the KMS with a green check mark and otherwise shows `-`.",{"_3383":2022,"_29651":2007,"_20578":54567,"_5":14121,"_26960":54520,"_2870":54568},[],"In certificate details, the **Information** tab shows a **Private Key** row in the **Key & Signature** section. When the certificate reports a private key and its KMS engine and key IDs are available, the row links to the key (tooltip: **Open private key in KMS**). Otherwise, it shows **Present** if the certificate reports a private key, or **Not available** if it does not. This does not establish whether a key exists outside Lamassu.",{"_3383":2023,"_29651":2007,"_20578":54570,"_5":14121,"_26960":54520,"_2870":54571},[],"Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_3383":2024,"_29651":2007,"_20578":54573,"_5":14121,"_26960":54520,"_2870":54574},[],"Certificate details include the key reference (`key_id`) and whether the private key is managed (`has_private_key`); certificate lists can be filtered on `has_private_key`.",{"_3383":2025,"_29651":2007,"_20578":54576,"_5":14121,"_26960":54520,"_2870":54577},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_3383":2026,"_29651":2007,"_20578":54579,"_5":14121,"_26960":54524,"_2870":54580},[],"Download the PEM and inspect it:",{"_3383":2027,"_29651":2007,"_20578":54582,"_5":14121,"_26960":54524,"_2870":54583},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_3383":2028,"_29651":2007,"_20578":54585,"_5":14121,"_26960":54528,"_2870":54586},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_3383":2029,"_29651":2007,"_20578":54588,"_5":14121,"_26960":54528,"_2870":54589},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_3383":2030,"_29651":2007,"_20578":54591,"_5":14121,"_26960":54528,"_2870":54592},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_3383":2031,"_29651":2007,"_20578":54594,"_5":14121,"_26960":54528,"_2870":54595},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_3383":2032,"_29651":2007,"_20578":54597,"_5":14121,"_26960":54528,"_2870":54598},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_3383":2033,"_29651":2007,"_20578":54600,"_5":14121,"_26960":54528,"_2870":54601},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_3383":2034,"_29651":2007,"_20578":54603,"_5":14121,"_26960":54528,"_2870":54604},[],"For browser key generation, follow Issue your first certificate.",{"_3383":2035,"_29651":2007,"_20578":54606,"_5":14121,"_26960":54532,"_2870":54607},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_3383":2036,"_29651":2007,"_20578":54609,"_5":14121,"_26960":54536,"_2870":54610},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_3383":2037,"_29651":2007,"_20578":54612,"_5":14121,"_26960":54540,"_2870":54613},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_3383":2038,"_29651":2007,"_20578":54615,"_5":14121,"_26960":54544,"_2870":54616},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_3383":2039,"_29651":2007,"_20578":54618,"_5":14121,"_26960":54544,"_2870":54619},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_3383":2040,"_29651":2007,"_20578":54621,"_5":14121,"_26960":54544,"_2870":54622},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_3383":2041,"_29651":2007,"_20578":54624,"_5":14121,"_26960":54548,"_2870":54625},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_3383":2042,"_29651":2007,"_20578":54627,"_5":14121,"_26960":54548,"_2870":54628},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_3383":2043,"_29651":2007,"_20578":54630,"_5":14121,"_26960":54548,"_2870":54631},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_3383":2044,"_29651":2007,"_20578":54633,"_5":14121,"_26960":54552,"_2870":54634},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_3383":2045,"_29651":2007,"_20578":54636,"_5":14121,"_26960":54552,"_2870":54637},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_3383":2046,"_29651":2046,"_5":14473,"_2870":54639,"_30004":54640,"_20578":54642,"_26960":2046},"Certificate lifecycle",[48280,49748,53750,54641],"Concepts",[],{"_3383":2047,"_29651":2046,"_20578":54644,"_5":14121,"_26960":2046,"_2870":54645},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_3383":2048,"_29651":2046,"_5":30001,"_20578":54647,"_26960":54648,"_2870":54649},[],"/docs/pr-preview/pr-55/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_3383":2049,"_29651":2046,"_5":30001,"_20578":54651,"_26960":54652,"_2870":54653},[],"/docs/pr-preview/pr-55/platform/pki/concepts/certificate-lifecycle#request","Request",{"_3383":2050,"_29651":2046,"_5":30001,"_20578":54655,"_26960":54656,"_2870":54657},[],"/docs/pr-preview/pr-55/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_3383":2051,"_29651":2046,"_5":30001,"_20578":54659,"_26960":54660,"_2870":54661},[],"/docs/pr-preview/pr-55/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_3383":2052,"_29651":2046,"_5":30001,"_20578":54663,"_26960":54664,"_2870":54665},[],"/docs/pr-preview/pr-55/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_3383":2053,"_29651":2046,"_5":30001,"_20578":54667,"_26960":54668,"_2870":54669},[],"/docs/pr-preview/pr-55/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_3383":2054,"_29651":2046,"_5":30001,"_20578":54671,"_26960":54672,"_2870":54673},[],"/docs/pr-preview/pr-55/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_3383":2055,"_29651":2046,"_5":30001,"_20578":54675,"_26960":54676,"_2870":54677},[],"/docs/pr-preview/pr-55/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_3383":2056,"_29651":2046,"_5":30001,"_20578":54679,"_26960":54680,"_2870":54681},[],"/docs/pr-preview/pr-55/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_3383":2057,"_29651":2046,"_5":30001,"_20578":54683,"_26960":54684,"_2870":54685},[],"/docs/pr-preview/pr-55/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_3383":2058,"_29651":2046,"_20578":54687,"_5":14121,"_26960":2046,"_2870":54688},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_3383":2059,"_29651":2046,"_20578":54690,"_5":14121,"_26960":54652,"_2870":54691},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_3383":2060,"_29651":2046,"_20578":54693,"_5":14121,"_26960":54656,"_2870":54694},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_3383":2061,"_29651":2046,"_20578":54696,"_5":14121,"_26960":54660,"_2870":54697},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_3383":2062,"_29651":2046,"_20578":54699,"_5":14121,"_26960":54664,"_2870":54700},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_3383":2063,"_29651":2046,"_20578":54702,"_5":14121,"_26960":54668,"_2870":54703},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_3383":2064,"_29651":2046,"_20578":54705,"_5":14121,"_26960":54672,"_2870":54706},[],"Lamassu persists four X.509 states:",{"_3383":2065,"_29651":2046,"_20578":54708,"_5":14121,"_26960":54672,"_2870":54709},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_3383":2066,"_29651":2046,"_20578":54711,"_5":14121,"_26960":54672,"_2870":54712},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_3383":2067,"_29651":2046,"_20578":54714,"_5":14121,"_26960":54672,"_2870":54715},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_3383":2068,"_29651":2046,"_20578":54717,"_5":14121,"_26960":54672,"_2870":54718},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_3383":2069,"_29651":2046,"_20578":54720,"_5":14121,"_26960":54672,"_2870":54721},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_3383":2070,"_29651":2046,"_20578":54723,"_5":14121,"_26960":54676,"_2870":54724},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_3383":2071,"_29651":2046,"_20578":54726,"_5":14121,"_26960":54676,"_2870":54727},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_3383":2072,"_29651":2046,"_20578":54729,"_5":14121,"_26960":54676,"_2870":54730},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_3383":2073,"_29651":2046,"_20578":54732,"_5":14121,"_26960":54680,"_2870":54733},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_3383":2074,"_29651":2046,"_20578":54735,"_5":14121,"_26960":54680,"_2870":54736},[],"Before confirming:",{"_3383":2075,"_29651":2046,"_20578":54738,"_5":14121,"_26960":54680,"_2870":54739},[],"Identify DMSs, devices and services that trust that chain.",{"_3383":2076,"_29651":2046,"_20578":54741,"_5":14121,"_26960":54680,"_2870":54742},[],"Distribute the new chain of trust.",{"_3383":2077,"_29651":2046,"_20578":54744,"_5":14121,"_26960":54680,"_2870":54745},[],"Reissue the necessary identities.",{"_3383":2078,"_29651":2046,"_20578":54747,"_5":14121,"_26960":54680,"_2870":54748},[],"Check OCSP and CRL from a real consumer.",{"_3383":2079,"_29651":2046,"_20578":54750,"_5":14121,"_26960":54680,"_2870":54751},[],"Revoke the old CA once no legitimate traffic remains.",{"_3383":2080,"_29651":2046,"_20578":54753,"_5":14121,"_26960":54680,"_2870":54754},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_3383":2081,"_29651":2046,"_20578":54756,"_5":14121,"_26960":54684,"_2870":54757},[],"Certificates entering the preventive or critical renewal window.",{"_3383":2082,"_29651":2046,"_20578":54759,"_5":14121,"_26960":54684,"_2870":54760},[],"Repeated enrollment or re-enrollment failures.",{"_3383":2083,"_29651":2046,"_20578":54762,"_5":14121,"_26960":54684,"_2870":54763},[],"Status changes and revocation reasons.",{"_3383":2084,"_29651":2046,"_20578":54765,"_5":14121,"_26960":54684,"_2870":54766},[],"OCSP and CRL publication and validity.",{"_3383":2085,"_29651":2046,"_20578":54768,"_5":14121,"_26960":54684,"_2870":54769},[],"Dependencies still presenting a replaced certificate.",{"_3383":2086,"_29651":2046,"_20578":54771,"_5":14121,"_26960":54684,"_2870":54772},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_3383":2087,"_29651":2087,"_5":14473,"_2870":54774,"_30004":54775,"_20578":54776,"_26960":2087},"Trust model",[48280,49748,53750,54641],[],{"_3383":2088,"_29651":2087,"_20578":54778,"_5":14121,"_26960":2087,"_2870":54779},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_3383":2089,"_29651":2087,"_5":30001,"_20578":54781,"_26960":54782,"_2870":54783},[],"/docs/pr-preview/pr-55/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_3383":2090,"_29651":2087,"_5":30001,"_20578":54785,"_26960":54786,"_2870":54787},[],"/docs/pr-preview/pr-55/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_3383":2091,"_29651":2087,"_5":30001,"_20578":54789,"_26960":54790,"_2870":54791},[],"/docs/pr-preview/pr-55/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_3383":2092,"_29651":2087,"_5":30001,"_20578":54793,"_26960":54794,"_2870":54795},[],"/docs/pr-preview/pr-55/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_3383":2093,"_29651":2087,"_5":30001,"_20578":54797,"_26960":54798,"_2870":54799},[],"/docs/pr-preview/pr-55/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_3383":2094,"_29651":2087,"_5":30001,"_20578":54801,"_26960":54802,"_2870":54803},[],"/docs/pr-preview/pr-55/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_3383":2095,"_29651":2087,"_5":30001,"_20578":54805,"_26960":54806,"_2870":54807},[],"/docs/pr-preview/pr-55/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_3383":2096,"_29651":2087,"_5":30001,"_20578":54809,"_26960":54810,"_2870":54811},[],"/docs/pr-preview/pr-55/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_3383":2097,"_29651":2087,"_5":30001,"_20578":54813,"_26960":54814,"_2870":54815},[],"/docs/pr-preview/pr-55/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_3383":2098,"_29651":2087,"_5":30001,"_20578":54817,"_26960":54818,"_2870":54819},[],"/docs/pr-preview/pr-55/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_3383":2099,"_29651":2087,"_20578":54821,"_5":14121,"_26960":2087,"_2870":54822},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_3383":2100,"_29651":2087,"_20578":54824,"_5":14121,"_26960":54786,"_2870":54825},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_3383":2101,"_29651":2087,"_20578":54827,"_5":14121,"_26960":54790,"_2870":54828},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_3383":2102,"_29651":2087,"_20578":54830,"_5":14121,"_26960":54794,"_2870":54831},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_3383":2103,"_29651":2087,"_20578":54833,"_5":14121,"_26960":54798,"_2870":54834},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_3383":2104,"_29651":2087,"_20578":54836,"_5":14121,"_26960":54802,"_2870":54837},[],"The device proves it can enroll according to the DMS policy.",{"_3383":2105,"_29651":2087,"_20578":54839,"_5":14121,"_26960":54802,"_2870":54840},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_3383":2106,"_29651":2087,"_20578":54842,"_5":14121,"_26960":54802,"_2870":54843},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_3383":2107,"_29651":2087,"_20578":54845,"_5":14121,"_26960":54802,"_2870":54846},[],"The device installs the certificate and the chain it needs.",{"_3383":2108,"_29651":2087,"_20578":54848,"_5":14121,"_26960":54802,"_2870":54849},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_3383":2109,"_29651":2087,"_20578":54851,"_5":14121,"_26960":54802,"_2870":54852},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_3383":2110,"_29651":2087,"_20578":54854,"_5":14121,"_26960":54806,"_2870":54855},[],"A DMS relates three sets that are worth designing separately:",{"_3383":2111,"_29651":2087,"_20578":54857,"_5":14121,"_26960":54806,"_2870":54858},[],"**Enrollment CA:** signs the new identities.",{"_3383":2112,"_29651":2087,"_20578":54860,"_5":14121,"_26960":54806,"_2870":54861},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, the enrollment CA is always trusted and Lamassu then tries the validation CAs configured in the re-enrollment block; those are optional.",{"_3383":2113,"_29651":2087,"_20578":54863,"_5":14121,"_26960":54806,"_2870":54864},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_3383":2114,"_29651":2087,"_20578":54866,"_5":14121,"_26960":54806,"_2870":54867},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_3383":2115,"_29651":2087,"_20578":54869,"_5":14121,"_26960":54810,"_2870":54870},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_3383":2116,"_29651":2087,"_20578":54872,"_5":14121,"_26960":54810,"_2870":54873},[],"that the current date is between `Not Before` and `Not After`;",{"_3383":2117,"_29651":2087,"_20578":54875,"_5":14121,"_26960":54810,"_2870":54876},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_3383":2118,"_29651":2087,"_20578":54878,"_5":14121,"_26960":54810,"_2870":54879},[],"that names, SANs and subject match the expected identity;",{"_3383":2119,"_29651":2087,"_20578":54881,"_5":14121,"_26960":54810,"_2870":54882},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_3383":2120,"_29651":2087,"_20578":54884,"_5":14121,"_26960":54810,"_2870":54885},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_3383":2121,"_29651":2087,"_20578":54887,"_5":14121,"_26960":54810,"_2870":54888},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_3383":2122,"_29651":2087,"_20578":54890,"_5":14121,"_26960":54814,"_2870":54891},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_3383":2123,"_29651":2087,"_20578":54893,"_5":14121,"_26960":54818,"_2870":54894},[],"Keep the root out of daily operations, or with very restricted access.",{"_3383":2124,"_29651":2087,"_20578":54896,"_5":14121,"_26960":54818,"_2870":54897},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_3383":2125,"_29651":2087,"_20578":54899,"_5":14121,"_26960":54818,"_2870":54900},[],"Assign explicit profiles to every use case.",{"_3383":2126,"_29651":2087,"_20578":54902,"_5":14121,"_26960":54818,"_2870":54903},[],"Distribute the new trust before starting a rotation.",{"_3383":2127,"_29651":2087,"_20578":54905,"_5":14121,"_26960":54818,"_2870":54906},[],"Keep enough overlap to renew a disconnected fleet.",{"_3383":2128,"_29651":2087,"_20578":54908,"_5":14121,"_26960":54818,"_2870":54909},[],"Validate from the consuming system, not only from the Lamassu console.",{"_3383":2129,"_29651":2087,"_20578":54911,"_5":14121,"_26960":54818,"_2870":54912},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_3383":2130,"_29651":2130,"_5":14473,"_2870":54914,"_30004":54915,"_20578":54916,"_26960":2130},"Revocation lists (CRL)",[48280,49748,53750,54386],[],{"_3383":2131,"_29651":2130,"_20578":54918,"_5":14121,"_26960":2130,"_2870":54919},[],"Generate and distribute signed lists to validate certificates offline.",{"_3383":2132,"_29651":2130,"_5":30001,"_20578":54921,"_26960":54922,"_2870":54923},[],"/docs/pr-preview/pr-55/platform/pki/crl#va-role-and-per-ca-configuration","VA role and per-CA configuration",{"_3383":2133,"_29651":2130,"_5":30001,"_20578":54925,"_26960":54926,"_2870":54927},[],"/docs/pr-preview/pr-55/platform/pki/crl#cas-that-share-a-key","CAs that share a key",{"_3383":2134,"_29651":2130,"_5":30001,"_20578":54929,"_26960":54930,"_2870":54931},[],"/docs/pr-preview/pr-55/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_3383":2135,"_29651":2130,"_5":30001,"_20578":54933,"_26960":54934,"_2870":54935},[],"/docs/pr-preview/pr-55/platform/pki/crl#crl-contents","CRL contents",{"_3383":2136,"_29651":2130,"_5":30001,"_20578":54937,"_26960":54938,"_2870":54939},[],"/docs/pr-preview/pr-55/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_3383":2137,"_29651":2130,"_5":30001,"_20578":54941,"_26960":54942,"_2870":54943},[],"/docs/pr-preview/pr-55/platform/pki/crl#va-role-management-api","VA role management API",{"_3383":2138,"_29651":2130,"_5":30001,"_20578":54945,"_26960":54946,"_2870":54947},[],"/docs/pr-preview/pr-55/platform/pki/crl#common-va-role-errors","Common VA role errors",{"_3383":2139,"_29651":2130,"_5":30001,"_20578":54949,"_26960":54950,"_2870":54951},[],"/docs/pr-preview/pr-55/platform/pki/crl#from-the-interface","From the interface",{"_3383":2140,"_29651":2130,"_5":30001,"_20578":54953,"_26960":54954,"_2870":54955},[],"/docs/pr-preview/pr-55/platform/pki/crl#references","References",{"_3383":2141,"_29651":2130,"_20578":54957,"_5":14121,"_26960":2130,"_2870":54958},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its SKI and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_3383":2142,"_29651":2130,"_20578":54960,"_5":14121,"_26960":54922,"_2870":54961},[],"The VA role stores configuration and metadata for the latest list published for a CA’s SKI. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_3383":2143,"_29651":2130,"_20578":54963,"_5":14121,"_26960":54922,"_2870":54964},[],"`crl_options` field",{"_3383":2144,"_29651":2130,"_20578":54966,"_5":14121,"_26960":54922,"_2870":48670},[],{"_3383":2145,"_29651":2130,"_20578":54968,"_5":14121,"_26960":54922,"_2870":54969},[],"Backend initial value",{"_3383":2146,"_29651":2130,"_20578":54971,"_5":14121,"_26960":54922,"_2870":54972},[],"`validity`",{"_3383":2147,"_29651":2130,"_20578":54974,"_5":14121,"_26960":54922,"_2870":54975},[],"Time from `thisUpdate` to `nextUpdate`.",{"_3383":2148,"_29651":2130,"_20578":54977,"_5":14121,"_26960":54922,"_2870":54978},[],"7 days.",{"_3383":2149,"_29651":2130,"_20578":54980,"_5":14121,"_26960":54922,"_2870":54981},[],"`refresh_interval`",{"_3383":2150,"_29651":2130,"_20578":54983,"_5":14121,"_26960":54922,"_2870":54984},[],"Time since the issuance of the latest published CRL that triggers scheduled renewal; `0` disables only this trigger (see Periodic and automatic regeneration).",{"_3383":2151,"_29651":2130,"_20578":54986,"_5":14121,"_26960":54922,"_2870":54987},[],"6 days and 23 hours.",{"_3383":2152,"_29651":2130,"_20578":54989,"_5":14121,"_26960":54922,"_2870":54990},[],"`regenerate_on_revoke`",{"_3383":2153,"_29651":2130,"_20578":54992,"_5":14121,"_26960":54922,"_2870":54993},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_3383":2154,"_29651":2130,"_20578":54995,"_5":14121,"_26960":54922,"_2870":54996},[],"`true`.",{"_3383":2155,"_29651":2130,"_20578":54998,"_5":14121,"_26960":54922,"_2870":54999},[],"`signer_certificate_serial_number`",{"_3383":2156,"_29651":2130,"_20578":55001,"_5":14121,"_26960":54922,"_2870":55002},[],"Serial number of the existing certificate that signs the CRL.",{"_3383":2157,"_29651":2130,"_20578":55004,"_5":14121,"_26960":54922,"_2870":55005},[],"Serial number of the CA’s current certificate.",{"_3383":2158,"_29651":2130,"_20578":55007,"_5":14121,"_26960":54922,"_2870":55008},[],"The signer must be an existing certificate with the `cRLSign` key usage and the same subject and public key as the CA. Certificates from before a reissue qualify. A delegated signer is not supported: a certificate with the CA’s subject but a different key is rejected.",{"_3383":2159,"_29651":2130,"_20578":55010,"_5":14121,"_26960":54922,"_2870":55011},[],"When a CA is reissued and the role’s signer is the superseded CA certificate, the VA moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. If the signer is any other certificate with the CA’s subject and key, it is deliberately left unchanged; the previous certificate then cannot be deleted while the role uses it, and to retire it you update the signer with `PUT`.",{"_3383":2160,"_29651":2130,"_20578":55013,"_5":14121,"_26960":54922,"_2870":55014},[],"When a CA is deleted, its VA role is kept and cannot be removed through the API. If no other CA with the same SKI remains, the role can be read but any `PUT` returns 404, and the renewal job logs a warning on every cycle because it no longer finds the CA. The API offers no way out; it can only be fixed by editing the database. If another CA with that SKI remains, the role is still editable (see CAs that share a key). Adjust validity and signer before deleting the CA.",{"_3383":2161,"_29651":2130,"_20578":55016,"_5":14121,"_26960":54922,"_2870":55017},[],"A CA whose certificate lacks `cRLSign` cannot generate its CRL or edit its role (400 error). Since 4.0 the VA requires this usage. Check before importing with `openssl x509 -noout -ext keyUsage` and, if it is missing, obtain a certificate for the same CA and key that includes it and set it as the signer with `PUT`. After reissuing a CA, also check the key usage of the new certificate: it may not keep the original’s usages, and without `cRLSign` the role keeps its previous signer.",{"_3383":2162,"_29651":2130,"_20578":55019,"_5":14121,"_26960":54922,"_2870":55020},[],"`PUT` always validates the signer, even when the request does not change it. If the stored signer is no longer valid, no field of the role can be modified, not even the validity, until a valid one is set.",{"_3383":2163,"_29651":2130,"_20578":55022,"_5":14121,"_26960":54922,"_2870":55023},[],"Sharing a key between CAs can prevent CRL validation. See CAs that share a key.",{"_3383":2164,"_29651":2130,"_20578":55025,"_5":14121,"_26960":54922,"_2870":55026},[],"`latest_crl` contains version, validity start and end. Versions are kept as PEM in object storage at `pki/va/crl/{subject_key_id}/{version}.crl`; the public endpoint returns DER.",{"_3383":2165,"_29651":2130,"_20578":55028,"_5":14121,"_26960":54926,"_2870":55029},[],"The VA identifies each CRL by the CA’s SKI, and the SKI is derived from its key. Two CAs with the same key have the same SKI and share a single VA role and a single CRL. This happens when a CA is created on an existing KMS key, or when a CA is imported whose certificate declares an SKI already in use. Lamassu takes the SKI of an imported certificate as-is and does not check that it corresponds to its public key. The first CA creates the role and the others keep it.",{"_3383":2166,"_29651":2130,"_20578":55031,"_5":14121,"_26960":54926,"_2870":55032},[],"The certificates of all of them point to `/crl/{ski}`, but the published list has the first CA as issuer and only includes its revocations. A verifier compares the CRL issuer with the issuer of the certificate it validates (RFC 5280, §6.3.2) and rejects the list if they differ. Depending on its policy, the certificate is blocked (*hard-fail*) or accepted even though it is revoked (*soft-fail*). Revocations of the secondary CAs do not appear in any list.",{"_3383":2167,"_29651":2130,"_20578":55034,"_5":14121,"_26960":54926,"_2870":55035},[],"If the first CA is deleted, CRL generation for the remaining one fails because the configured signer no longer matches a CA with that name. Until the role’s signer is updated to a certificate of the remaining CA, the last published list keeps being served until it expires (7 days by default).",{"_3383":2168,"_29651":2130,"_20578":55037,"_5":14121,"_26960":54926,"_2870":55038},[],"Before upgrading, review CAs that share a key. To detect the problem, compare the SKI of the CAs in the inventory: two with the same SKI are affected. To fix it, create a CA with its own key and reissue its certificates; those already issued keep the old URL and are not corrected until reissued. A CA imported with an SKI already in use does not replace the existing one as CRL issuer, because the issuer is resolved from the role’s signer. However, its own certificates point to that same URL and its revocations are not published. Until Lamassu rejects these imports, restrict the permission to import CAs as an interim control; it covers only the import path. Creating a CA with &#x2A;*Create New CA (Existing Key)** on a KMS key another CA already uses produces the same collision, so also avoid reusing keys across CAs. A per-CA CRL and the rejection of imports whose SKI collides with an existing CA are both proposed in lamassuiot#834, and neither is implemented yet.",{"_3383":2169,"_29651":2130,"_20578":55040,"_5":14121,"_26960":54930,"_2870":55041},[],"The VA scheduled job checks every role on each run and requests a new list when either of these conditions is met:",{"_3383":2170,"_29651":2130,"_20578":55043,"_5":14121,"_26960":54930,"_2870":55044},[],"**The list is about to expire:** the remaining validity of `latest_crl` is less than the interval between job runs. This condition always applies and cannot be disabled.",{"_3383":2171,"_29651":2130,"_20578":55046,"_5":14121,"_26960":54930,"_2870":55047},[],"**The refresh interval has elapsed:** the time since the issuance of the latest published CRL reaches `refresh_interval`. Setting `refresh_interval` to `0` disables only this condition; the list is still regenerated when it is about to expire.",{"_3383":2172,"_29651":2130,"_20578":55049,"_5":14121,"_26960":54930,"_2870":55050},[],"Setting `refresh_interval` to `0` therefore does not freeze regeneration. With the default 7-day validity and an hourly job, a CRL is renewed up to an hour before it expires even if `refresh_interval` is `0`.",{"_3383":2173,"_29651":2130,"_20578":55052,"_5":14121,"_26960":54930,"_2870":55053},[],"The job frequency is set in Helm with `services.va.job.crl.frequency` (default `0 * * * *`) and accepts a duration (`1h`) or a cron expression. A cron expression is converted into a constant interval equal to the time left until its next firing when the service starts, so it is not aligned with the clock. Keep `validity` well above that interval: with a shorter validity, the list is regenerated on every cycle.",{"_3383":2174,"_29651":2130,"_20578":55055,"_5":14121,"_26960":54930,"_2870":55056},[],"If generation fails (for example, because of a role without a CA or an invalid signer), the job logs the warning `something went wrong while calculating CRL for CA <ski>` and retries on the next cycle. There is no other renewal path until the cause is fixed, and the last published list keeps being served until it expires. All of this depends on working jobs, storage and signing.",{"_3383":2175,"_29651":2130,"_20578":55058,"_5":14121,"_26960":54930,"_2870":55059},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths: if it fails (missing role, invalid signer), the event is retried and, once retries are exhausted, moves to the failed-events queue. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_3383":2176,"_29651":2130,"_20578":55061,"_5":14121,"_26960":54930,"_2870":55062},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_3383":2177,"_29651":2130,"_20578":55064,"_5":14121,"_26960":54934,"_2870":55065},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_3383":2178,"_29651":2130,"_20578":55067,"_5":14121,"_26960":54934,"_2870":55068},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_3383":2179,"_29651":2130,"_20578":55070,"_5":14121,"_26960":54938,"_2870":55071},[],"The VA service exposes `GET /crl/{subject_key_id}` without management authorization. Use the **issuing CA’s** SKI, not the end-entity certificate’s SKI or serial. First inspect the certificate’s CDP:",{"_3383":2180,"_29651":2130,"_20578":55073,"_5":14121,"_26960":54938,"_2870":55074},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_3383":2181,"_29651":2130,"_20578":55076,"_5":14121,"_26960":54938,"_2870":55077},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. An accepted signer certificate has the same subject and public key as the CA, so this signature check also works when the role points to an earlier certificate for that CA and key. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_3383":2182,"_29651":2130,"_20578":55079,"_5":14121,"_26960":54938,"_2870":55080},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_3383":2183,"_29651":2130,"_20578":55082,"_5":14121,"_26960":54938,"_2870":55083},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_3383":2184,"_29651":2130,"_20578":55085,"_5":14121,"_26960":54942,"_2870":55086},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_3383":2185,"_29651":2130,"_20578":55088,"_5":14121,"_26960":54942,"_2870":51515},[],{"_3383":2186,"_29651":2130,"_20578":55090,"_5":14121,"_26960":54942,"_2870":55091},[],"Relative path",{"_3383":2187,"_29651":2130,"_20578":55093,"_5":14121,"_26960":54942,"_2870":51512},[],{"_3383":2188,"_29651":2130,"_20578":55095,"_5":14121,"_26960":54942,"_2870":55096},[],"`GET`",{"_3383":2189,"_29651":2130,"_20578":55098,"_5":14121,"_26960":54942,"_2870":55099},[],"`/v1/roles/{ca-ski}`",{"_3383":2190,"_29651":2130,"_20578":55101,"_5":14121,"_26960":54942,"_2870":55102},[],"Read `crl_options` and `latest_crl`.",{"_3383":2191,"_29651":2130,"_20578":55104,"_5":14121,"_26960":54942,"_2870":55105},[],"`PUT`",{"_3383":2192,"_29651":2130,"_20578":55107,"_5":14121,"_26960":54942,"_2870":55099},[],{"_3383":2193,"_29651":2130,"_20578":55109,"_5":14121,"_26960":54942,"_2870":55110},[],"Replace CRL configuration.",{"_3383":2194,"_29651":2130,"_20578":55112,"_5":14121,"_26960":54942,"_2870":55113},[],"You need authentication and role read or update permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract: the backend replaces `crl_options`; it does not merge omitted fields.",{"_3383":2195,"_29651":2130,"_20578":55115,"_5":14121,"_26960":54942,"_2870":55116},[],"After a change, check saved configuration and the next list actually published. Updating the role alone does not establish regeneration or client acceptance.",{"_3383":2196,"_29651":2130,"_20578":55118,"_5":14121,"_26960":54946,"_2870":55119},[],"Symptom",{"_3383":2197,"_29651":2130,"_20578":55121,"_5":14121,"_26960":54946,"_2870":55122},[],"Cause",{"_3383":2198,"_29651":2130,"_20578":55124,"_5":14121,"_26960":54946,"_2870":55125},[],"Action",{"_3383":2199,"_29651":2130,"_20578":55127,"_5":14121,"_26960":54946,"_2870":55128},[],"`PUT /v1/roles/{ca-ski}` returns 404 and `GET` returns 200.",{"_3383":2200,"_29651":2130,"_20578":55130,"_5":14121,"_26960":54946,"_2870":55131},[],"The role’s CA was deleted and no other CA with the same SKI remains.",{"_3383":2201,"_29651":2130,"_20578":55133,"_5":14121,"_26960":54946,"_2870":55134},[],"There is no API way out; it requires database intervention. Avoid it by adjusting the role before deleting the CA.",{"_3383":2202,"_29651":2130,"_20578":55136,"_5":14121,"_26960":54946,"_2870":55137},[],"`PUT` returns 400.",{"_3383":2203,"_29651":2130,"_20578":55139,"_5":14121,"_26960":54946,"_2870":55140},[],"The signer lacks `cRLSign`, or its subject and key match no CA with that SKI (for example, after deleting the first of two CAs that share a key).",{"_3383":2204,"_29651":2130,"_20578":55142,"_5":14121,"_26960":54946,"_2870":55143},[],"Use `PUT` to set the serial number of a valid certificate of the remaining CA.",{"_3383":2205,"_29651":2130,"_20578":55145,"_5":14121,"_26960":54946,"_2870":55146},[],"`PUT` returns 400 from a 3.x client.",{"_3383":2206,"_29651":2130,"_20578":55148,"_5":14121,"_26960":54946,"_2870":55149},[],"`crl_options.subject_key_id_signer` was replaced by `signer_certificate_serial_number`, which is required.",{"_3383":2207,"_29651":2130,"_20578":55151,"_5":14121,"_26960":54946,"_2870":55152},[],"Update the client to send the new field.",{"_3383":2208,"_29651":2130,"_20578":55154,"_5":14121,"_26960":54946,"_2870":55155},[],"The CRL does not change after revoking a certificate.",{"_3383":2209,"_29651":2130,"_20578":55157,"_5":14121,"_26960":54946,"_2870":55158},[],"`regenerate_on_revoke` is `false`, or the event failed because of a missing role or an invalid signer.",{"_3383":2210,"_29651":2130,"_20578":55160,"_5":14121,"_26960":54946,"_2870":55161},[],"Check the VA logs and the failed-events queue; fix the signer.",{"_3383":2211,"_29651":2130,"_20578":55163,"_5":14121,"_26960":54946,"_2870":55164},[],"A verifier rejects the CRL because of the issuer.",{"_3383":2212,"_29651":2130,"_20578":55166,"_5":14121,"_26960":54946,"_2870":55167},[],"Several CAs share an SKI.",{"_3383":2213,"_29651":2130,"_20578":55169,"_5":14121,"_26960":54946,"_2870":55170},[],"See CAs that share a key.",{"_3383":2214,"_29651":2130,"_20578":55172,"_5":14121,"_26960":54950,"_2870":55173},[],"The CA view lets you inspect and download the available list. Compare version, issuer and timestamps with the copy downloaded from the public endpoint. The CA’s VA settings also let you select the CRL signer: the certificate picker only offers certificates that have a private key and carry the `cRLSign` key usage. If a configured signer’s certificate cannot be resolved, the interface shows `Unknown Certificate (Serial: X)` or `Certificate details unavailable (Serial: X)`. Diagnose differences using PKI troubleshooting.",{"_3383":2215,"_29651":2130,"_20578":55175,"_5":14121,"_26960":54954,"_2870":55176},[],"RFC 5280: X.509 and CRL profile.",{"_3383":2216,"_29651":2130,"_20578":55178,"_5":14121,"_26960":54954,"_2870":55179},[],"OpenSSL: openssl-crl.",{"_3383":2217,"_29651":2130,"_20578":55181,"_5":14121,"_26960":54954,"_2870":55182},[],"OpenSSL: openssl-verify.",{"_3383":2218,"_29651":2130,"_20578":55184,"_5":14121,"_26960":54954,"_2870":55185},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_3383":2219,"_29651":2130,"_20578":55187,"_5":14121,"_26960":54954,"_2870":55188},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3383":2220,"_29651":2220,"_5":14473,"_2870":55190,"_30004":55191,"_20578":55192,"_26960":2220},"Keys and cryptographic engines",[48280,49748,53750,53751],[],{"_3383":2221,"_29651":2220,"_20578":55194,"_5":14121,"_26960":2220,"_2870":55195},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_3383":2222,"_29651":2220,"_5":30001,"_20578":55197,"_26960":55198,"_2870":55199},[],"/docs/pr-preview/pr-55/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_3383":2223,"_29651":2220,"_5":30001,"_20578":55201,"_26960":55202,"_2870":55203},[],"/docs/pr-preview/pr-55/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_3383":2224,"_29651":2220,"_5":30001,"_20578":55205,"_26960":55206,"_2870":55207},[],"/docs/pr-preview/pr-55/platform/pki/key-management#file-system","File System",{"_3383":2225,"_29651":2220,"_5":30001,"_20578":55209,"_26960":55210,"_2870":55211},[],"/docs/pr-preview/pr-55/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3383":2226,"_29651":2220,"_5":30001,"_20578":55213,"_26960":55214,"_2870":55215},[],"/docs/pr-preview/pr-55/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3383":2227,"_29651":2220,"_5":30001,"_20578":55217,"_26960":55218,"_2870":55219},[],"/docs/pr-preview/pr-55/platform/pki/key-management#aws-kms","AWS KMS",{"_3383":2228,"_29651":2220,"_5":30001,"_20578":55221,"_26960":55222,"_2870":55223},[],"/docs/pr-preview/pr-55/platform/pki/key-management#pkcs11","PKCS#11",{"_3383":2229,"_29651":2220,"_5":30001,"_20578":55225,"_26960":55226,"_2870":55227},[],"/docs/pr-preview/pr-55/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_3383":2230,"_29651":2220,"_5":30001,"_20578":55229,"_26960":55230,"_2870":55231},[],"/docs/pr-preview/pr-55/platform/pki/key-management#key-inventory","Key inventory",{"_3383":2231,"_29651":2220,"_5":30001,"_20578":55233,"_26960":55234,"_2870":55235},[],"/docs/pr-preview/pr-55/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_3383":2232,"_29651":2220,"_5":30001,"_20578":55237,"_26960":55238,"_2870":55239},[],"/docs/pr-preview/pr-55/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_3383":2233,"_29651":2220,"_5":30001,"_20578":55241,"_26960":55242,"_2870":55243},[],"/docs/pr-preview/pr-55/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_3383":2234,"_29651":2220,"_5":30001,"_20578":55245,"_26960":55246,"_2870":55247},[],"/docs/pr-preview/pr-55/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_3383":2235,"_29651":2220,"_5":30001,"_20578":55249,"_26960":55250,"_2870":55251},[],"/docs/pr-preview/pr-55/platform/pki/key-management#view-details","View details",{"_3383":2236,"_29651":2220,"_5":30001,"_20578":55253,"_26960":55254,"_2870":55255},[],"/docs/pr-preview/pr-55/platform/pki/key-management#sign-and-verify","Sign and verify",{"_3383":2237,"_29651":2220,"_5":30001,"_20578":55257,"_26960":55258,"_2870":55259},[],"/docs/pr-preview/pr-55/platform/pki/key-management#sign","Sign",{"_3383":2238,"_29651":2220,"_5":30001,"_20578":55261,"_26960":55262,"_2870":55263},[],"/docs/pr-preview/pr-55/platform/pki/key-management#verify","Verify",{"_3383":2239,"_29651":2220,"_5":30001,"_20578":55265,"_26960":55266,"_2870":55267},[],"/docs/pr-preview/pr-55/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_3383":2240,"_29651":2220,"_5":30001,"_20578":55269,"_26960":55270,"_2870":55271},[],"/docs/pr-preview/pr-55/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_3383":2241,"_29651":2220,"_5":30001,"_20578":55273,"_26960":55274,"_2870":55275},[],"/docs/pr-preview/pr-55/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_3383":2242,"_29651":2220,"_20578":55277,"_5":14121,"_26960":2220,"_2870":55278},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_3383":2243,"_29651":2220,"_20578":55280,"_5":14121,"_26960":2220,"_2870":55281},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_3383":2244,"_29651":2220,"_20578":55283,"_5":14121,"_26960":55198,"_2870":55284},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_3383":2245,"_29651":2220,"_20578":55286,"_5":14121,"_26960":55198,"_2870":55287},[],"In practice, it lets you:",{"_3383":2246,"_29651":2220,"_20578":55289,"_5":14121,"_26960":55198,"_2870":55290},[],"Generate new key pairs from Lamassu IoT.",{"_3383":2247,"_29651":2220,"_20578":55292,"_5":14121,"_26960":55198,"_2870":55293},[],"Import keys created externally.",{"_3383":2248,"_29651":2220,"_20578":55295,"_5":14121,"_26960":55198,"_2870":55296},[],"Delegate custody and cryptographic operations to external engines.",{"_3383":2249,"_29651":2220,"_20578":55298,"_5":14121,"_26960":55198,"_2870":55299},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_3383":2250,"_29651":2220,"_20578":55301,"_5":14121,"_26960":55202,"_2870":55302},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_3383":2251,"_29651":2220,"_20578":55304,"_5":14121,"_26960":55202,"_2870":55305},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_3383":2252,"_29651":2220,"_20578":55307,"_5":14121,"_26960":55202,"_2870":55308},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_3383":2253,"_29651":2220,"_20578":55310,"_5":14121,"_26960":55206,"_2870":55311},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_3383":2254,"_29651":2220,"_20578":55313,"_5":14121,"_26960":55210,"_2870":55314},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_3383":2255,"_29651":2220,"_20578":55316,"_5":14121,"_26960":55210,"_2870":55317},[],"The adapter reaches Vault over its configured HTTP(S) endpoint. The Vault server certificate is verified against the system trust store; a Vault signed by a private CA is trusted by adding its CA certificate to the engine's `ca_cert_file` (PEM-encoded). `insecure_skip_verify=true` disables verification and is a last resort; agree the transport settings with the deployment owner.",{"_3383":2256,"_29651":2220,"_20578":55319,"_5":14121,"_26960":55214,"_2870":55320},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_3383":2257,"_29651":2220,"_20578":55322,"_5":14121,"_26960":55218,"_2870":55323},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_3383":2258,"_29651":2220,"_20578":55325,"_5":14121,"_26960":55222,"_2870":55326},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_3383":2259,"_29651":2220,"_20578":55328,"_5":14121,"_26960":55226,"_2870":55329},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_3383":2260,"_29651":2220,"_20578":55331,"_5":14121,"_26960":55226,"_2870":55332},[],"Lamassu shows the enabled engines in the console.",{"_3383":2261,"_29651":2220,"_20578":55334,"_5":14121,"_26960":55226,"_2870":55335},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_3383":2262,"_29651":2220,"_20578":55337,"_5":14121,"_26960":55226,"_2870":55338},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_3383":2263,"_29651":2220,"_20578":55340,"_5":14121,"_26960":55230,"_2870":55341},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_3383":2264,"_29651":2220,"_20578":55343,"_5":14121,"_26960":55230,"_2870":55344},[],"The table includes the following fields:",{"_3383":2265,"_29651":2220,"_20578":55346,"_5":14121,"_26960":55230,"_2870":55347},[],"**Name**: descriptive name of the key.",{"_3383":2266,"_29651":2220,"_20578":55349,"_5":14121,"_26960":55230,"_2870":55350},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_3383":2267,"_29651":2220,"_20578":55352,"_5":14121,"_26960":55230,"_2870":55353},[],"**Strength**: visual indicator of cryptographic strength.",{"_3383":2268,"_29651":2220,"_20578":55355,"_5":14121,"_26960":55230,"_2870":55356},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_3383":2269,"_29651":2220,"_20578":55358,"_5":14121,"_26960":55230,"_2870":55359},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_3383":2270,"_29651":2220,"_20578":55361,"_5":14121,"_26960":55230,"_2870":55362},[],"**Aliases**: alternative names associated with the key.",{"_3383":2271,"_29651":2220,"_20578":55364,"_5":14121,"_26960":55230,"_2870":55365},[],"**Tags**: labels for classification and search.",{"_3383":2272,"_29651":2220,"_20578":55367,"_5":14121,"_26960":55230,"_2870":55368},[],"**Related Entities**: certificates or other entities linked to that key.",{"_3383":2273,"_29651":2220,"_20578":55370,"_5":14121,"_26960":55230,"_2870":55371},[],"From this view you also reach the most common actions:",{"_3383":2274,"_29651":2220,"_20578":55373,"_5":14121,"_26960":55230,"_2870":55374},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_3383":2275,"_29651":2220,"_20578":55376,"_5":14121,"_26960":55230,"_2870":55377},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_3383":2276,"_29651":2220,"_20578":55379,"_5":14121,"_26960":55230,"_2870":55380},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_3383":2277,"_29651":2220,"_20578":55382,"_5":14121,"_26960":55230,"_2870":55383},[],"**Delete Key** to remove the key from the system.",{"_3383":2278,"_29651":2220,"_20578":55385,"_5":14121,"_26960":55234,"_2870":55386},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_3383":2279,"_29651":2220,"_20578":55388,"_5":14121,"_26960":55238,"_2870":55389},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_3383":2280,"_29651":2220,"_20578":55391,"_5":14121,"_26960":55238,"_2870":55392},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_3383":2281,"_29651":2220,"_20578":55394,"_5":14121,"_26960":55238,"_2870":55395},[],"**Key Name**: unique and descriptive name.",{"_3383":2282,"_29651":2220,"_20578":55397,"_5":14121,"_26960":55238,"_2870":55398},[],"**Crypto Engine**: engine that will keep the key.",{"_3383":2283,"_29651":2220,"_20578":55400,"_5":14121,"_26960":55238,"_2870":55401},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_3383":2284,"_29651":2220,"_20578":55403,"_5":14121,"_26960":55238,"_2870":55404},[],"**Tags**: metadata to classify the key.",{"_3383":2285,"_29651":2220,"_20578":55406,"_5":14121,"_26960":55238,"_2870":55407},[],"**Metadata**: additional information for advanced uses.",{"_3383":2286,"_29651":2220,"_20578":55409,"_5":14121,"_26960":55242,"_2870":55410},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_3383":2287,"_29651":2220,"_20578":55412,"_5":14121,"_26960":55242,"_2870":55413},[],"When you have an exportable private key and the destination engine supports import.",{"_3383":2288,"_29651":2220,"_20578":55415,"_5":14121,"_26960":55242,"_2870":55416},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_3383":2289,"_29651":2220,"_20578":55418,"_5":14121,"_26960":55242,"_2870":55419},[],"When Lamassu must operate with a root of trust created by a third party.",{"_3383":2290,"_29651":2220,"_20578":55421,"_5":14121,"_26960":55242,"_2870":55422},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_3383":2291,"_29651":2220,"_20578":55424,"_5":14121,"_26960":55242,"_2870":55425},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_3383":2292,"_29651":2220,"_20578":55427,"_5":14121,"_26960":55242,"_2870":55428},[],"**Crypto Engine**: engine that will keep the imported key.",{"_3383":2293,"_29651":2220,"_20578":55430,"_5":14121,"_26960":55242,"_2870":55431},[],"**Tags**: labels for organization and search.",{"_3383":2294,"_29651":2220,"_20578":55433,"_5":14121,"_26960":55242,"_2870":55434},[],"**Metadata**: additional optional information.",{"_3383":2295,"_29651":2220,"_20578":55436,"_5":14121,"_26960":55242,"_2870":55437},[],"**Private Key (PEM)**: private key in PEM format.",{"_3383":2296,"_29651":2220,"_20578":55439,"_5":14121,"_26960":55242,"_2870":55440},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_3383":2297,"_29651":2220,"_20578":55442,"_5":14121,"_26960":55246,"_2870":55443},[],"Each registered key has a detail view and several operational actions.",{"_3383":2298,"_29651":2220,"_20578":55445,"_5":14121,"_26960":55250,"_2870":55446},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_3383":2299,"_29651":2220,"_20578":55448,"_5":14121,"_26960":55250,"_2870":55449},[],"The **Overview** tab shows, among others, these fields:",{"_3383":2300,"_29651":2220,"_20578":55451,"_5":14121,"_26960":55250,"_2870":55452},[],"**Key Name**: descriptive name.",{"_3383":2301,"_29651":2220,"_20578":55454,"_5":14121,"_26960":55250,"_2870":55455},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_3383":2302,"_29651":2220,"_20578":55457,"_5":14121,"_26960":55250,"_2870":55458},[],"**Tags**: associated labels.",{"_3383":2303,"_29651":2220,"_20578":55460,"_5":14121,"_26960":55250,"_2870":55461},[],"**Aliases**: alternative names.",{"_3383":2304,"_29651":2220,"_20578":55463,"_5":14121,"_26960":55250,"_2870":55464},[],"**Crypto Engine**: engine where the key resides.",{"_3383":2305,"_29651":2220,"_20578":55466,"_5":14121,"_26960":55250,"_2870":55467},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_3383":2306,"_29651":2220,"_20578":55469,"_5":14121,"_26960":55250,"_2870":55470},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_3383":2307,"_29651":2220,"_20578":55472,"_5":14121,"_26960":55250,"_2870":55473},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_3383":2308,"_29651":2220,"_20578":55475,"_5":14121,"_26960":55254,"_2870":55476},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_3383":2309,"_29651":2220,"_20578":55478,"_5":14121,"_26960":55254,"_2870":55479},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_3383":2310,"_29651":2220,"_20578":55481,"_5":14121,"_26960":55254,"_2870":55482},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_3383":2311,"_29651":2220,"_20578":55484,"_5":14121,"_26960":55258,"_2870":55485},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_3383":2312,"_29651":2220,"_20578":55487,"_5":14121,"_26960":55258,"_2870":55488},[],"Main fields:",{"_3383":2313,"_29651":2220,"_20578":55490,"_5":14121,"_26960":55258,"_2870":55491},[],"**Algorithm**: signing algorithm available for the key type.",{"_3383":2314,"_29651":2220,"_20578":55493,"_5":14121,"_26960":55258,"_2870":55494},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_3383":2315,"_29651":2220,"_20578":55496,"_5":14121,"_26960":55258,"_2870":55497},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_3383":2316,"_29651":2220,"_20578":55499,"_5":14121,"_26960":55258,"_2870":55500},[],"**Message**: content to sign.",{"_3383":2317,"_29651":2220,"_20578":55502,"_5":14121,"_26960":55258,"_2870":55503},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_3383":2318,"_29651":2220,"_20578":55505,"_5":14121,"_26960":55262,"_2870":55506},[],"This tab checks whether a signature corresponds to the associated public key.",{"_3383":2319,"_29651":2220,"_20578":55508,"_5":14121,"_26960":55262,"_2870":55488},[],{"_3383":2320,"_29651":2220,"_20578":55510,"_5":14121,"_26960":55262,"_2870":55511},[],"**Algorithm**: must match the algorithm used for the signature.",{"_3383":2321,"_29651":2220,"_20578":55513,"_5":14121,"_26960":55262,"_2870":55514},[],"**Message Type**: `Raw` or `Digest`.",{"_3383":2322,"_29651":2220,"_20578":55516,"_5":14121,"_26960":55262,"_2870":55517},[],"**Payload Encoding**: encoding of the message.",{"_3383":2323,"_29651":2220,"_20578":55519,"_5":14121,"_26960":55262,"_2870":55520},[],"**Message**: original message or hash.",{"_3383":2324,"_29651":2220,"_20578":55522,"_5":14121,"_26960":55262,"_2870":55523},[],"**Signature**: signature to check.",{"_3383":2325,"_29651":2220,"_20578":55525,"_5":14121,"_26960":55262,"_2870":55526},[],"**Result**: indicator of the validation result.",{"_3383":2326,"_29651":2220,"_20578":55528,"_5":14121,"_26960":55266,"_2870":55529},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_3383":2327,"_29651":2220,"_20578":55531,"_5":14121,"_26960":55266,"_2870":55532},[],"This flow is useful for:",{"_3383":2328,"_29651":2220,"_20578":55534,"_5":14121,"_26960":55266,"_2870":55535},[],"Requesting certificates from an external CA.",{"_3383":2329,"_29651":2220,"_20578":55537,"_5":14121,"_26960":55266,"_2870":55538},[],"Renewing an identity while keeping the same key.",{"_3383":2330,"_29651":2220,"_20578":55540,"_5":14121,"_26960":55266,"_2870":55541},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_3383":2331,"_29651":2220,"_20578":55543,"_5":14121,"_26960":55266,"_2870":55544},[],"**Common Name (CN)**: main name of the identity.",{"_3383":2332,"_29651":2220,"_20578":55546,"_5":14121,"_26960":55266,"_2870":55547},[],"**Organization (O)**: organization or company.",{"_3383":2333,"_29651":2220,"_20578":55549,"_5":14121,"_26960":55266,"_2870":55550},[],"**Organizational Unit (OU)**: department or unit.",{"_3383":2334,"_29651":2220,"_20578":55552,"_5":14121,"_26960":55266,"_2870":55553},[],"**Country (C)**: two-letter country code.",{"_3383":2335,"_29651":2220,"_20578":55555,"_5":14121,"_26960":55266,"_2870":55556},[],"**State / Province (ST)**: state or province.",{"_3383":2336,"_29651":2220,"_20578":55558,"_5":14121,"_26960":55266,"_2870":55559},[],"**Locality (L)**: city or locality.",{"_3383":2337,"_29651":2220,"_20578":55561,"_5":14121,"_26960":55266,"_2870":55562},[],"**Email Address**: contact email.",{"_3383":2338,"_29651":2220,"_20578":55564,"_5":14121,"_26960":55266,"_2870":55565},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_3383":2339,"_29651":2220,"_20578":55567,"_5":14121,"_26960":55266,"_2870":55568},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_3383":2340,"_29651":2220,"_20578":55570,"_5":14121,"_26960":55270,"_2870":55571},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_3383":2341,"_29651":2220,"_20578":55573,"_5":14121,"_26960":55270,"_2870":55574},[],"It requires the module, token and permissions of the corresponding provider. Check that the Lamassu identifier matches the object accessible from that module. Module configuration belongs to the client environment or Deployment.",{"_3383":2342,"_29651":2220,"_20578":55576,"_5":14121,"_26960":55274,"_2870":55577},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_3383":2343,"_29651":2220,"_20578":55579,"_5":14121,"_26960":55274,"_2870":55580},[],"The KMS refuses to delete a key that certificates still reference. Deleting a CA releases the references from its own current certificate and linked reissued certificates, then attempts to delete the key. If other certificates still reference the key, such as another CA sharing it, the KMS keeps it. Revoking certificates issued by the deleted CA does not release their own key references. Legacy references retained by the upgrade migration are described in the upgrade guide.",{"_3383":2344,"_29651":2344,"_5":14473,"_2870":55582,"_30004":55583,"_20578":55584,"_26960":2344},"Online validation with OCSP",[48280,49748,53750,54386],[],{"_3383":2345,"_29651":2344,"_20578":55586,"_5":14121,"_26960":2344,"_2870":55587},[],"Query signed status and verify the responder’s response.",{"_3383":2346,"_29651":2344,"_5":30001,"_20578":55589,"_26960":55590,"_2870":55591},[],"/docs/pr-preview/pr-55/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_3383":2347,"_29651":2344,"_5":30001,"_20578":55593,"_26960":55594,"_2870":55595},[],"/docs/pr-preview/pr-55/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_3383":2348,"_29651":2344,"_5":30001,"_20578":55597,"_26960":55598,"_2870":55599},[],"/docs/pr-preview/pr-55/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_3383":2349,"_29651":2344,"_5":30001,"_20578":55601,"_26960":55602,"_2870":55603},[],"/docs/pr-preview/pr-55/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_3383":2350,"_29651":2344,"_5":30001,"_20578":55605,"_26960":55606,"_2870":55607},[],"/docs/pr-preview/pr-55/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_3383":2351,"_29651":2344,"_5":30001,"_20578":55609,"_26960":55610,"_2870":54955},[],"/docs/pr-preview/pr-55/platform/pki/ocsp#references",{"_3383":2352,"_29651":2344,"_20578":55612,"_5":14121,"_26960":2344,"_2870":55613},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_3383":2353,"_29651":2344,"_20578":55615,"_5":14121,"_26960":55590,"_2870":55616},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_3383":2354,"_29651":2344,"_20578":55618,"_5":14121,"_26960":55590,"_2870":55619},[],"Record status",{"_3383":2355,"_29651":2344,"_20578":55621,"_5":14121,"_26960":55590,"_2870":55622},[],"Signed response",{"_3383":2356,"_29651":2344,"_20578":55624,"_5":14121,"_26960":55590,"_2870":52887},[],{"_3383":2357,"_29651":2344,"_20578":55626,"_5":14121,"_26960":55590,"_2870":55627},[],"`Good`.",{"_3383":2358,"_29651":2344,"_20578":55629,"_5":14121,"_26960":55590,"_2870":52904},[],{"_3383":2359,"_29651":2344,"_20578":55631,"_5":14121,"_26960":55590,"_2870":55632},[],"`Revoked`, with revocation reason and timestamp.",{"_3383":2360,"_29651":2344,"_20578":55634,"_5":14121,"_26960":55590,"_2870":55635},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_3383":2361,"_29651":2344,"_20578":55637,"_5":14121,"_26960":55590,"_2870":55638},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_3383":2362,"_29651":2344,"_20578":55640,"_5":14121,"_26960":55590,"_2870":55641},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_3383":2363,"_29651":2344,"_20578":55643,"_5":14121,"_26960":55590,"_2870":55644},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_3383":2364,"_29651":2344,"_20578":55646,"_5":14121,"_26960":55590,"_2870":55647},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_3383":2365,"_29651":2344,"_20578":55649,"_5":14121,"_26960":55594,"_2870":55650},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_3383":2366,"_29651":2344,"_20578":55652,"_5":14121,"_26960":55594,"_2870":55653},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_3383":2367,"_29651":2344,"_20578":55655,"_5":14121,"_26960":55598,"_2870":55656},[],"The service accepts:",{"_3383":2368,"_29651":2344,"_20578":55658,"_5":14121,"_26960":55598,"_2870":51515},[],{"_3383":2369,"_29651":2344,"_20578":55660,"_5":14121,"_26960":55598,"_2870":55661},[],"VA service path",{"_3383":2370,"_29651":2344,"_20578":55663,"_5":14121,"_26960":55598,"_2870":55664},[],"Format",{"_3383":2371,"_29651":2344,"_20578":55666,"_5":14121,"_26960":55598,"_2870":55667},[],"`POST`",{"_3383":2372,"_29651":2344,"_20578":55669,"_5":14121,"_26960":55598,"_2870":55670},[],"`/ocsp`",{"_3383":2373,"_29651":2344,"_20578":55672,"_5":14121,"_26960":55598,"_2870":55673},[],"DER request, `Content-Type: application/ocsp-request`.",{"_3383":2374,"_29651":2344,"_20578":55675,"_5":14121,"_26960":55598,"_2870":55096},[],{"_3383":2375,"_29651":2344,"_20578":55677,"_5":14121,"_26960":55598,"_2870":55678},[],"`/ocsp/{ocsp_request}`",{"_3383":2376,"_29651":2344,"_20578":55680,"_5":14121,"_26960":55598,"_2870":55681},[],"DER request encoded using padded URL Base64.",{"_3383":2377,"_29651":2344,"_20578":55683,"_5":14121,"_26960":55598,"_2870":55684},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_3383":2378,"_29651":2344,"_20578":55686,"_5":14121,"_26960":55602,"_2870":55687},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_3383":2379,"_29651":2344,"_20578":55689,"_5":14121,"_26960":55602,"_2870":55690},[],"Generate the request:",{"_3383":2380,"_29651":2344,"_20578":55692,"_5":14121,"_26960":55602,"_2870":55693},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_3383":2381,"_29651":2344,"_20578":55695,"_5":14121,"_26960":55602,"_2870":55696},[],"Replace the example URL with the inspected endpoint:",{"_3383":2382,"_29651":2344,"_20578":55698,"_5":14121,"_26960":55602,"_2870":55699},[],"Verify the returned DER:",{"_3383":2383,"_29651":2344,"_20578":55701,"_5":14121,"_26960":55602,"_2870":55702},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_3383":2384,"_29651":2344,"_20578":55704,"_5":14121,"_26960":55606,"_2870":55705},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_3383":2385,"_29651":2344,"_20578":55707,"_5":14121,"_26960":55606,"_2870":55708},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_3383":2386,"_29651":2344,"_20578":55710,"_5":14121,"_26960":55610,"_2870":55711},[],"RFC 6960: OCSP.",{"_3383":2387,"_29651":2344,"_20578":55713,"_5":14121,"_26960":55610,"_2870":55714},[],"OpenSSL: openssl-ocsp.",{"_3383":2388,"_29651":2344,"_20578":55716,"_5":14121,"_26960":55610,"_2870":55717},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_3383":2389,"_29651":2344,"_20578":55719,"_5":14121,"_26960":55610,"_2870":55188},[],{"_3383":2390,"_29651":2390,"_5":14473,"_2870":53750,"_30004":55721,"_20578":55722,"_26960":2390},[48280,49748,53750],[],{"_3383":2391,"_29651":2390,"_20578":55724,"_5":14121,"_26960":2390,"_2870":55725},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_3383":2392,"_29651":2390,"_5":30001,"_20578":55727,"_26960":55728,"_2870":53062},[],"/docs/pr-preview/pr-55/platform/pki/overview#start-here",{"_3383":2393,"_29651":2390,"_5":30001,"_20578":55730,"_26960":55731,"_2870":55732},[],"/docs/pr-preview/pr-55/platform/pki/overview#what-you-need","What you need",{"_3383":2394,"_29651":2390,"_5":30001,"_20578":55734,"_26960":55735,"_2870":53594},[],"/docs/pr-preview/pr-55/platform/pki/overview#core-capabilities",{"_3383":2395,"_29651":2390,"_5":30001,"_20578":55737,"_26960":55738,"_2870":53598},[],"/docs/pr-preview/pr-55/platform/pki/overview#build-your-trust-hierarchy",{"_3383":2396,"_29651":2390,"_5":30001,"_20578":55740,"_26960":55741,"_2870":53602},[],"/docs/pr-preview/pr-55/platform/pki/overview#protect-cryptographic-keys",{"_3383":2397,"_29651":2390,"_5":30001,"_20578":55743,"_26960":55744,"_2870":53606},[],"/docs/pr-preview/pr-55/platform/pki/overview#issue-and-control-certificates",{"_3383":2398,"_29651":2390,"_5":30001,"_20578":55746,"_26960":55747,"_2870":53614},[],"/docs/pr-preview/pr-55/platform/pki/overview#publish-validation-status",{"_3383":2399,"_29651":2390,"_5":30001,"_20578":55749,"_26960":55750,"_2870":55751},[],"/docs/pr-preview/pr-55/platform/pki/overview#how-to-check-the-result","How to check the result",{"_3383":2400,"_29651":2390,"_5":30001,"_20578":55753,"_26960":55754,"_2870":54553},[],"/docs/pr-preview/pr-55/platform/pki/overview#continue",{"_3383":2401,"_29651":2390,"_20578":55756,"_5":14121,"_26960":2390,"_2870":55757},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_3383":2402,"_29651":2390,"_20578":55759,"_5":14121,"_26960":55728,"_2870":55760},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_3383":2403,"_29651":2390,"_20578":55762,"_5":14121,"_26960":55728,"_2870":55763},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_3383":2404,"_29651":2390,"_20578":55765,"_5":14121,"_26960":55731,"_2870":55766},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_3383":2405,"_29651":2390,"_20578":55768,"_5":14121,"_26960":55731,"_2870":55769},[],"An available cryptographic engine to keep the authority's key.",{"_3383":2406,"_29651":2390,"_20578":55771,"_5":14121,"_26960":55731,"_2870":55772},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_3383":2407,"_29651":2390,"_20578":55774,"_5":14121,"_26960":55731,"_2870":55775},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_3383":2408,"_29651":2390,"_20578":55777,"_5":14121,"_26960":55731,"_2870":55778},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_3383":2409,"_29651":2390,"_20578":55780,"_5":14121,"_26960":55738,"_2870":55781},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_3383":2410,"_29651":2390,"_20578":55783,"_5":14121,"_26960":55741,"_2870":55784},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_3383":2411,"_29651":2390,"_20578":55786,"_5":14121,"_26960":55744,"_2870":55787},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_3383":2412,"_29651":2390,"_20578":55789,"_5":14121,"_26960":55747,"_2870":55790},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_3383":2413,"_29651":2390,"_20578":55792,"_5":14121,"_26960":55750,"_2870":55793},[],"An active certificate in the console is one part of the check. Also verify that:",{"_3383":2414,"_29651":2390,"_20578":55795,"_5":14121,"_26960":55750,"_2870":55796},[],"its subject and extensions identify the expected client;",{"_3383":2415,"_29651":2390,"_20578":55798,"_5":14121,"_26960":55750,"_2870":55799},[],"its public key matches the client's private key;",{"_3383":2416,"_29651":2390,"_20578":55801,"_5":14121,"_26960":55750,"_2870":55802},[],"its chain reaches a root trusted by the consumer;",{"_3383":2417,"_29651":2390,"_20578":55804,"_5":14121,"_26960":55750,"_2870":55805},[],"its dates and usages allow the operation;",{"_3383":2418,"_29651":2390,"_20578":55807,"_5":14121,"_26960":55750,"_2870":55808},[],"the consumer applies revocation checks and authorization.",{"_3383":2419,"_29651":2390,"_20578":55810,"_5":14121,"_26960":55750,"_2870":55811},[],"The issuance path includes the first independent checks.",{"_3383":2420,"_29651":2390,"_20578":55813,"_5":14121,"_26960":55754,"_2870":55814},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3383":2421,"_29651":2390,"_20578":55816,"_5":14121,"_26960":55754,"_2870":55817},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3383":2422,"_29651":2390,"_20578":55819,"_5":14121,"_26960":55754,"_2870":55820},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3383":2423,"_29651":2423,"_5":14473,"_2870":55822,"_30004":55823,"_20578":55824,"_26960":2423},"Create your first CA",[48280,49748,53750,53187],[],{"_3383":2424,"_29651":2423,"_20578":55826,"_5":14121,"_26960":2423,"_2870":55827},[],"Create an evaluation root and check its certificate before issuing.",{"_3383":2425,"_29651":2423,"_5":30001,"_20578":55829,"_26960":55830,"_2870":48290},[],"/docs/pr-preview/pr-55/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_3383":2426,"_29651":2423,"_5":30001,"_20578":55832,"_26960":55833,"_2870":55834},[],"/docs/pr-preview/pr-55/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard-toc","Open the creation wizard [!toc]",{"_3383":2427,"_29651":2423,"_5":30001,"_20578":55836,"_26960":55837,"_2870":55838},[],"/docs/pr-preview/pr-55/platform/pki/quickstarts/create-certificate-authority#select-the-key-toc","Select the key [!toc]",{"_3383":2428,"_29651":2423,"_5":30001,"_20578":55840,"_26960":55841,"_2870":55842},[],"/docs/pr-preview/pr-55/platform/pki/quickstarts/create-certificate-authority#define-the-authority-toc","Define the authority [!toc]",{"_3383":2429,"_29651":2423,"_5":30001,"_20578":55844,"_26960":55845,"_2870":55846},[],"/docs/pr-preview/pr-55/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca-toc","Review and create the CA [!toc]",{"_3383":2430,"_29651":2423,"_5":30001,"_20578":55848,"_26960":55849,"_2870":55850},[],"/docs/pr-preview/pr-55/platform/pki/quickstarts/create-certificate-authority#verify-the-result-toc","Verify the result [!toc]",{"_3383":2431,"_29651":2423,"_5":30001,"_20578":55852,"_26960":55853,"_2870":55854},[],"/docs/pr-preview/pr-55/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_3383":2432,"_29651":2423,"_5":30001,"_20578":55856,"_26960":55857,"_2870":53444},[],"/docs/pr-preview/pr-55/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_3383":2433,"_29651":2423,"_5":30001,"_20578":55859,"_26960":55860,"_2870":48314},[],"/docs/pr-preview/pr-55/platform/pki/quickstarts/create-certificate-authority#next-step",{"_3383":2434,"_29651":2423,"_20578":55862,"_5":14121,"_26960":2423,"_2870":55863},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_3383":2435,"_29651":2423,"_20578":55865,"_5":14121,"_26960":55830,"_2870":55866},[],"Console access and permission to create keys and authorities.",{"_3383":2436,"_29651":2423,"_20578":55868,"_5":14121,"_26960":55830,"_2870":55869},[],"An available cryptographic engine that supports the chosen algorithm.",{"_3383":2437,"_29651":2423,"_20578":55871,"_5":14121,"_26960":55830,"_2870":55872},[],"OpenSSL 3.x to check the downloaded certificate.",{"_3383":2438,"_29651":2423,"_20578":55874,"_5":14121,"_26960":55830,"_2870":55875},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_3383":2439,"_29651":2423,"_20578":55877,"_5":14121,"_26960":55833,"_2870":55878},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_3383":2440,"_29651":2423,"_20578":55880,"_5":14121,"_26960":55833,"_2870":55881},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_3383":2441,"_29651":2423,"_20578":55883,"_5":14121,"_26960":55837,"_2870":55884},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_3383":2442,"_29651":2423,"_20578":55886,"_5":14121,"_26960":55837,"_2870":55887},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_3383":2443,"_29651":2423,"_20578":55889,"_5":14121,"_26960":55841,"_2870":55890},[],"Select **Root CA** and complete:",{"_3383":2444,"_29651":2423,"_20578":55892,"_5":14121,"_26960":55841,"_2870":55893},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_3383":2445,"_29651":2423,"_20578":55895,"_5":14121,"_26960":55841,"_2870":55896},[],"**Subject**: organization and country details for your evaluation.",{"_3383":2446,"_29651":2423,"_20578":55898,"_5":14121,"_26960":55841,"_2870":55899},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_3383":2447,"_29651":2423,"_20578":55901,"_5":14121,"_26960":55841,"_2870":55902},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_3383":2448,"_29651":2423,"_20578":55904,"_5":14121,"_26960":55841,"_2870":55905},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_3383":2449,"_29651":2423,"_20578":55907,"_5":14121,"_26960":55845,"_2870":55908},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_3383":2450,"_29651":2423,"_20578":55910,"_5":14121,"_26960":55849,"_2870":55911},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_3383":2451,"_29651":2423,"_20578":55913,"_5":14121,"_26960":55849,"_2870":55914},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_3383":2452,"_29651":2423,"_20578":55916,"_5":14121,"_26960":55853,"_2870":55917},[],"Run from the directory where you saved `ca.pem`:",{"_3383":2453,"_29651":2423,"_20578":55919,"_5":14121,"_26960":55853,"_2870":55920},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_3383":2454,"_29651":2423,"_20578":55922,"_5":14121,"_26960":55853,"_2870":55923},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_3383":2455,"_29651":2423,"_20578":55925,"_5":14121,"_26960":55857,"_2870":55926},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_3383":2456,"_29651":2423,"_20578":55928,"_5":14121,"_26960":55857,"_2870":55929},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_3383":2457,"_29651":2423,"_20578":55931,"_5":14121,"_26960":55857,"_2870":55932},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_3383":2458,"_29651":2423,"_20578":55934,"_5":14121,"_26960":55857,"_2870":55935},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_3383":2459,"_29651":2423,"_20578":55937,"_5":14121,"_26960":55860,"_2870":55938},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_3383":2460,"_29651":2460,"_5":14473,"_2870":55940,"_30004":55941,"_20578":55942,"_26960":2460},"Issue and verify a certificate",[48280,49748,53750,53187],[],{"_3383":2461,"_29651":2460,"_20578":55944,"_5":14121,"_26960":2460,"_2870":55945},[],"Issue a client certificate and check content, chain and key correspondence.",{"_3383":2462,"_29651":2460,"_5":30001,"_20578":55947,"_26960":55948,"_2870":48290},[],"/docs/pr-preview/pr-55/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_3383":2463,"_29651":2460,"_5":30001,"_20578":55950,"_26960":55951,"_2870":55952},[],"/docs/pr-preview/pr-55/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_3383":2464,"_29651":2460,"_5":30001,"_20578":55954,"_26960":55955,"_2870":55956},[],"/docs/pr-preview/pr-55/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_3383":2465,"_29651":2460,"_5":30001,"_20578":55958,"_26960":55959,"_2870":55960},[],"/docs/pr-preview/pr-55/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_3383":2466,"_29651":2460,"_5":30001,"_20578":55962,"_26960":55963,"_2870":55964},[],"/docs/pr-preview/pr-55/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_3383":2467,"_29651":2460,"_5":30001,"_20578":55966,"_26960":55967,"_2870":55968},[],"/docs/pr-preview/pr-55/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_3383":2468,"_29651":2460,"_5":30001,"_20578":55970,"_26960":55971,"_2870":55972},[],"/docs/pr-preview/pr-55/platform/pki/quickstarts/issue-certificate#verify-the-result","Verify the result",{"_3383":2469,"_29651":2460,"_5":30001,"_20578":55974,"_26960":55975,"_2870":55976},[],"/docs/pr-preview/pr-55/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_3383":2470,"_29651":2460,"_5":30001,"_20578":55978,"_26960":55979,"_2870":55980},[],"/docs/pr-preview/pr-55/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_3383":2471,"_29651":2460,"_5":30001,"_20578":55982,"_26960":55983,"_2870":55984},[],"/docs/pr-preview/pr-55/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_3383":2472,"_29651":2460,"_5":30001,"_20578":55986,"_26960":55987,"_2870":53444},[],"/docs/pr-preview/pr-55/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_3383":2473,"_29651":2460,"_5":30001,"_20578":55989,"_26960":55990,"_2870":48314},[],"/docs/pr-preview/pr-55/platform/pki/quickstarts/issue-certificate#next-step",{"_3383":2474,"_29651":2460,"_20578":55992,"_5":14121,"_26960":2460,"_2870":55993},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_3383":2475,"_29651":2460,"_20578":55995,"_5":14121,"_26960":55948,"_2870":55996},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_3383":2476,"_29651":2460,"_20578":55998,"_5":14121,"_26960":55948,"_2870":55999},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_3383":2477,"_29651":2460,"_20578":56001,"_5":14121,"_26960":55948,"_2870":56002},[],"OpenSSL 3.x and a working directory with restricted access.",{"_3383":2478,"_29651":2460,"_20578":56004,"_5":14121,"_26960":55948,"_2870":56005},[],"A client identifier: here we use `device-001`.",{"_3383":2479,"_29651":2460,"_20578":56007,"_5":14121,"_26960":55948,"_2870":56008},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_3383":2480,"_29651":2460,"_20578":56010,"_5":14121,"_26960":55951,"_2870":56011},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_3383":2481,"_29651":2460,"_20578":56013,"_5":14121,"_26960":55955,"_2870":56014},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_3383":2482,"_29651":2460,"_20578":56016,"_5":14121,"_26960":55955,"_2870":56017},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_3383":2483,"_29651":2460,"_20578":56019,"_5":14121,"_26960":55959,"_2870":56020},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_3383":2484,"_29651":2460,"_20578":56022,"_5":14121,"_26960":55959,"_2870":56023},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_3383":2485,"_29651":2460,"_20578":56025,"_5":14121,"_26960":55963,"_2870":56026},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_3383":2486,"_29651":2460,"_20578":56028,"_5":14121,"_26960":55963,"_2870":56029},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_3383":2487,"_29651":2460,"_20578":56031,"_5":14121,"_26960":55967,"_2870":56032},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_3383":2488,"_29651":2460,"_20578":56034,"_5":14121,"_26960":55971,"_2870":56035},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_3383":2489,"_29651":2460,"_20578":56037,"_5":14121,"_26960":55975,"_2870":56038},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_3383":2490,"_29651":2460,"_20578":56040,"_5":14121,"_26960":55979,"_2870":56041},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_3383":2491,"_29651":2460,"_20578":56043,"_5":14121,"_26960":55979,"_2870":56044},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_3383":2492,"_29651":2460,"_20578":56046,"_5":14121,"_26960":55979,"_2870":56047},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_3383":2493,"_29651":2460,"_20578":56049,"_5":14121,"_26960":55983,"_2870":56050},[],"In Bash, compare the two public-key digests:",{"_3383":2494,"_29651":2460,"_20578":56052,"_5":14121,"_26960":55983,"_2870":56053},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_3383":2495,"_29651":2460,"_20578":56055,"_5":14121,"_26960":55983,"_2870":56056},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_3383":2496,"_29651":2460,"_20578":56058,"_5":14121,"_26960":55987,"_2870":53528},[],{"_3383":2497,"_29651":2460,"_20578":56060,"_5":14121,"_26960":55987,"_2870":56061},[],"What to review",{"_3383":2498,"_29651":2460,"_20578":56063,"_5":14121,"_26960":55987,"_2870":56064},[],"The CA rejects issuance",{"_3383":2499,"_29651":2460,"_20578":56066,"_5":14121,"_26960":55987,"_2870":56067},[],"Permissions, CA state and key, algorithm and profile.",{"_3383":2500,"_29651":2460,"_20578":56069,"_5":14121,"_26960":55987,"_2870":56070},[],"Different subject or usages",{"_3383":2501,"_29651":2460,"_20578":56072,"_5":14121,"_26960":55987,"_2870":56073},[],"Applied profile and requested values.",{"_3383":2502,"_29651":2460,"_20578":56075,"_5":14121,"_26960":55987,"_2870":56076},[],"Issuer cannot be found",{"_3383":2503,"_29651":2460,"_20578":56078,"_5":14121,"_26960":55987,"_2870":56079},[],"Downloaded CA and required intermediate chain.",{"_3383":2504,"_29651":2460,"_20578":56081,"_5":14121,"_26960":55987,"_2870":56082},[],"Validity fails",{"_3383":2505,"_29651":2460,"_20578":56084,"_5":14121,"_26960":55987,"_2870":56085},[],"Certificate and CA dates, and the computer's clock.",{"_3383":2506,"_29651":2460,"_20578":56087,"_5":14121,"_26960":55987,"_2870":56088},[],"Public-key digests differ",{"_3383":2507,"_29651":2460,"_20578":56090,"_5":14121,"_26960":55987,"_2870":56091},[],"Certificate and key files from the same issuance.",{"_3383":2508,"_29651":2460,"_20578":56093,"_5":14121,"_26960":55987,"_2870":56094},[],"See PKI diagnostics to narrow an issuance failure.",{"_3383":2509,"_29651":2460,"_20578":56096,"_5":14121,"_26960":55990,"_2870":56097},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_3383":2510,"_29651":2460,"_20578":56099,"_5":14121,"_26960":55990,"_2870":56100},[],"Manage certificates for inspection, status and revocation.",{"_3383":2511,"_29651":2460,"_20578":56102,"_5":14121,"_26960":55990,"_2870":56103},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_3383":2512,"_29651":2460,"_20578":56105,"_5":14121,"_26960":55990,"_2870":56106},[],"Prepare EST for the device to request its next identities.",{"_3383":2513,"_29651":2460,"_20578":56108,"_5":14121,"_26960":55990,"_2870":56109},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_3383":2514,"_29651":2514,"_5":14473,"_2870":56111,"_30004":56112,"_20578":56113,"_26960":2514},"PKI getting started",[48280,49748,53750,53187],[],{"_3383":2515,"_29651":2514,"_20578":56115,"_5":14121,"_26960":2514,"_2870":56116},[],"Create a CA, issue a client certificate and check its chain and key.",{"_3383":2516,"_29651":2514,"_5":30001,"_20578":56118,"_26960":56119,"_2870":48290},[],"/docs/pr-preview/pr-55/platform/pki/quickstarts/overview#before-you-begin",{"_3383":2517,"_29651":2514,"_5":30001,"_20578":56121,"_26960":56122,"_2870":56123},[],"/docs/pr-preview/pr-55/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_3383":2518,"_29651":2514,"_5":30001,"_20578":56125,"_26960":56126,"_2870":53379},[],"/docs/pr-preview/pr-55/platform/pki/quickstarts/overview#expected-result",{"_3383":2519,"_29651":2514,"_5":30001,"_20578":56128,"_26960":56129,"_2870":56130},[],"/docs/pr-preview/pr-55/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_3383":2520,"_29651":2514,"_20578":56132,"_5":14121,"_26960":2514,"_2870":56133},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_3383":2521,"_29651":2514,"_20578":56135,"_5":14121,"_26960":56119,"_2870":56136},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_3383":2522,"_29651":2514,"_20578":56138,"_5":14121,"_26960":56119,"_2870":56139},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_3383":2523,"_29651":2514,"_20578":56141,"_5":14121,"_26960":56119,"_2870":56142},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_3383":2524,"_29651":2514,"_20578":56144,"_5":14121,"_26960":56119,"_2870":56145},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_3383":2525,"_29651":2514,"_20578":56147,"_5":14121,"_26960":56119,"_2870":56148},[],"A working directory with restricted access for the downloaded key.",{"_3383":2526,"_29651":2514,"_20578":56150,"_5":14121,"_26960":56122,"_2870":56151},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3383":2527,"_29651":2514,"_20578":56153,"_5":14121,"_26960":56122,"_2870":56154},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3383":2528,"_29651":2514,"_20578":56156,"_5":14121,"_26960":56122,"_2870":56157},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_3383":2529,"_29651":2514,"_20578":56159,"_5":14121,"_26960":56122,"_2870":56160},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_3383":2530,"_29651":2514,"_20578":56162,"_5":14121,"_26960":56126,"_2870":56163},[],"File or resource",{"_3383":2531,"_29651":2514,"_20578":56165,"_5":14121,"_26960":56126,"_2870":53376},[],{"_3383":2532,"_29651":2514,"_20578":56167,"_5":14121,"_26960":56126,"_2870":56168},[],"Active root CA and `ca.pem`",{"_3383":2533,"_29651":2514,"_20578":56170,"_5":14121,"_26960":56126,"_2870":56171},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_3383":2534,"_29651":2514,"_20578":56173,"_5":14121,"_26960":56126,"_2870":56174},[],"End-entity certificate and `device.crt`",{"_3383":2535,"_29651":2514,"_20578":56176,"_5":14121,"_26960":56126,"_2870":56177},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_3383":2536,"_29651":2514,"_20578":56179,"_5":14121,"_26960":56126,"_2870":56180},[],"Private key `device.key`",{"_3383":2537,"_29651":2514,"_20578":56182,"_5":14121,"_26960":56126,"_2870":56183},[],"Its public key matches the one included in `device.crt`.",{"_3383":2538,"_29651":2514,"_20578":56185,"_5":14121,"_26960":56126,"_2870":56186},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_3383":2539,"_29651":2514,"_20578":56188,"_5":14121,"_26960":56129,"_2870":56189},[],"To operate certificates, continue with Certificates and Validation.",{"_3383":2540,"_29651":2514,"_20578":56191,"_5":14121,"_26960":56129,"_2870":56192},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_3383":2541,"_29651":2514,"_20578":56194,"_5":14121,"_26960":56129,"_2870":56195},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_3383":2542,"_29651":2542,"_5":14473,"_2870":56197,"_30004":56198,"_20578":56199,"_26960":2542},"PKI troubleshooting",[48280,49748,53750,52325],[],{"_3383":2543,"_29651":2542,"_20578":56201,"_5":14121,"_26960":2542,"_2870":56202},[],"Diagnose certificate issuance, OCSP and CRL.",{"_3383":2544,"_29651":2542,"_5":30001,"_20578":56204,"_26960":56205,"_2870":56206},[],"/docs/pr-preview/pr-55/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_3383":2545,"_29651":2542,"_5":30001,"_20578":56208,"_26960":56209,"_2870":56210},[],"/docs/pr-preview/pr-55/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_3383":2546,"_29651":2542,"_5":30001,"_20578":56212,"_26960":56213,"_2870":56214},[],"/docs/pr-preview/pr-55/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_3383":2547,"_29651":2542,"_20578":56216,"_5":14121,"_26960":2542,"_2870":56217},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_3383":2548,"_29651":2542,"_20578":56219,"_5":14121,"_26960":2542,"_2870":56220},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_3383":2549,"_29651":2542,"_20578":56222,"_5":14121,"_26960":56205,"_2870":53376},[],{"_3383":2550,"_29651":2542,"_20578":56224,"_5":14121,"_26960":56205,"_2870":56225},[],"What to inspect",{"_3383":2551,"_29651":2542,"_20578":56227,"_5":14121,"_26960":56205,"_2870":48314},[],{"_3383":2552,"_29651":2542,"_20578":56229,"_5":14121,"_26960":56205,"_2870":52592},[],{"_3383":2553,"_29651":2542,"_20578":56231,"_5":14121,"_26960":56205,"_2870":56232},[],"Exists, is active and has usable dates.",{"_3383":2554,"_29651":2542,"_20578":56234,"_5":14121,"_26960":56205,"_2870":56235},[],"Authorities.",{"_3383":2555,"_29651":2542,"_20578":56237,"_5":14121,"_26960":56205,"_2870":56238},[],"Key",{"_3383":2556,"_29651":2542,"_20578":56240,"_5":14121,"_26960":56205,"_2870":56241},[],"The record has a usable private key and the engine can sign.",{"_3383":2557,"_29651":2542,"_20578":56243,"_5":14121,"_26960":56205,"_2870":56244},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_3383":2558,"_29651":2542,"_20578":56246,"_5":14121,"_26960":56205,"_2870":56247},[],"CSR",{"_3383":2559,"_29651":2542,"_20578":56249,"_5":14121,"_26960":56205,"_2870":56250},[],"Correct PEM and verifiable signature.",{"_3383":2560,"_29651":2542,"_20578":56252,"_5":14121,"_26960":56205,"_2870":56253},[],"`openssl req -in request.csr -noout -verify -text`.",{"_3383":2561,"_29651":2542,"_20578":56255,"_5":14121,"_26960":56205,"_2870":56256},[],"Profile",{"_3383":2562,"_29651":2542,"_20578":56258,"_5":14121,"_26960":56205,"_2870":56259},[],"Selected source, existing ID, allowed algorithm and size.",{"_3383":2563,"_29651":2542,"_20578":56261,"_5":14121,"_26960":56205,"_2870":56262},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_3383":2564,"_29651":2542,"_20578":56264,"_5":14121,"_26960":56205,"_2870":53528},[],{"_3383":2565,"_29651":2542,"_20578":56266,"_5":14121,"_26960":56205,"_2870":56267},[],"Appropriate subject, SAN, usages and dates.",{"_3383":2566,"_29651":2542,"_20578":56269,"_5":14121,"_26960":56205,"_2870":56270},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_3383":2567,"_29651":2542,"_20578":56272,"_5":14121,"_26960":56205,"_2870":56273},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_3383":2568,"_29651":2542,"_20578":56275,"_5":14121,"_26960":56205,"_2870":56276},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation.",{"_3383":2569,"_29651":2542,"_20578":56278,"_5":14121,"_26960":56209,"_2870":56279},[],"Check each boundary independently:",{"_3383":2570,"_29651":2542,"_20578":56281,"_5":14121,"_26960":56209,"_2870":56282},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_3383":2571,"_29651":2542,"_20578":56284,"_5":14121,"_26960":56209,"_2870":56285},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_3383":2572,"_29651":2542,"_20578":56287,"_5":14121,"_26960":56209,"_2870":56288},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_3383":2573,"_29651":2542,"_20578":56290,"_5":14121,"_26960":56209,"_2870":56291},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_3383":2574,"_29651":2542,"_20578":56293,"_5":14121,"_26960":56209,"_2870":56294},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_3383":2575,"_29651":2542,"_20578":56296,"_5":14121,"_26960":56209,"_2870":56297},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_3383":2576,"_29651":2542,"_20578":56299,"_5":14121,"_26960":56213,"_2870":56300},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_3383":2577,"_29651":2542,"_20578":56302,"_5":14121,"_26960":56213,"_2870":56303},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_3383":2578,"_29651":2578,"_5":14473,"_2870":56305,"_30004":56306,"_20578":56307,"_26960":2578},"Security",[48280],[],{"_3383":2579,"_29651":2578,"_20578":56309,"_5":14121,"_26960":2578,"_2870":56310},[],"How to report a security vulnerability in Lamassu privately, what to include in a report and which releases receive security fixes.",{"_3383":2580,"_29651":2578,"_5":30001,"_20578":56312,"_26960":56313,"_2870":56314},[],"/docs/pr-preview/pr-55/security#report-a-vulnerability","Report a vulnerability",{"_3383":2581,"_29651":2578,"_5":30001,"_20578":56316,"_26960":56317,"_2870":56318},[],"/docs/pr-preview/pr-55/security#what-to-include-in-a-report","What to include in a report",{"_3383":2582,"_29651":2578,"_5":30001,"_20578":56320,"_26960":56321,"_2870":56322},[],"/docs/pr-preview/pr-55/security#supported-versions","Supported versions",{"_3383":2583,"_29651":2578,"_5":30001,"_20578":56324,"_26960":56325,"_2870":56326},[],"/docs/pr-preview/pr-55/security#responsible-disclosure","Responsible disclosure",{"_3383":2584,"_29651":2578,"_20578":56328,"_5":14121,"_26960":2578,"_2870":56329},[],"Found a security vulnerability in lamassuiot, lamassu-dashboard, or lamassu-helm? This page explains how to report it privately, what to include in your report and which releases receive security fixes.",{"_3383":2585,"_29651":2578,"_20578":56331,"_5":14121,"_26960":56313,"_2870":56332},[],"Do not report security vulnerabilities through public GitHub issues, discussions, or pull requests. Public reports disclose the problem before maintainers can fix it.",{"_3383":2586,"_29651":2578,"_20578":56334,"_5":14121,"_26960":56313,"_2870":56335},[],"Instead, report privately using GitHub Security Advisories for the affected repository:",{"_3383":2587,"_29651":2578,"_20578":56337,"_5":14121,"_26960":56313,"_2870":14740},[],{"_3383":2588,"_29651":2578,"_20578":56339,"_5":14121,"_26960":56313,"_2870":14686},[],{"_3383":2589,"_29651":2578,"_20578":56341,"_5":14121,"_26960":56313,"_2870":14733},[],{"_3383":2590,"_29651":2578,"_20578":56343,"_5":14121,"_26960":56313,"_2870":56344},[],"This lets maintainers assess and address the issue before it is publicly disclosed.",{"_3383":2591,"_29651":2578,"_20578":56346,"_5":14121,"_26960":56313,"_2870":56347},[],"If private vulnerability reporting is not enabled for that repository, report the vulnerability privately to lamassuiot\\@lksnext.com before disclosing any details publicly.",{"_3383":2592,"_29651":2578,"_20578":56349,"_5":14121,"_26960":56317,"_2870":56350},[],"Describe the vulnerability, its potential impact, and steps to reproduce it using non-sensitive, redacted examples.",{"_3383":2593,"_29651":2578,"_20578":56352,"_5":14121,"_26960":56317,"_2870":56353},[],"Do not include in the report:",{"_3383":2594,"_29651":2578,"_20578":56355,"_5":14121,"_26960":56317,"_2870":56356},[],"Credentials, tokens, or private keys",{"_3383":2595,"_29651":2578,"_20578":56358,"_5":14121,"_26960":56317,"_2870":56359},[],"Customer data or customer-identifiable information",{"_3383":2596,"_29651":2578,"_20578":56361,"_5":14121,"_26960":56317,"_2870":56362},[],"Confidential architecture or internal infrastructure details",{"_3383":2597,"_29651":2578,"_20578":56364,"_5":14121,"_26960":56321,"_2870":56365},[],"Only the latest stable release receives security support. Support for a stable release ends when the next stable release is published. Older releases and pre-releases are not supported.",{"_3383":2598,"_29651":2578,"_20578":56367,"_5":14121,"_26960":56321,"_2870":56368},[],"For upgrade guidance, see Upgrades.",{"_3383":2599,"_29651":2578,"_20578":56370,"_5":14121,"_26960":56325,"_2870":56371},[],"Give maintainers reasonable time to investigate and address a reported vulnerability before any public disclosure.",{"_3383":2600,"_29651":2578,"_20578":56373,"_5":14121,"_26960":56325,"_2870":56374},[],"Avoid privacy violations, data destruction, and service disruption while researching a vulnerability.",{"_3383":2601,"_29651":2578,"_20578":56376,"_5":14121,"_26960":56325,"_2870":56377},[],"Only interact with accounts or data you own, or for which you have explicit permission.",{"_3383":2602,"_29651":2578,"_20578":56379,"_5":14121,"_26960":56325,"_2870":56380},[],"Maintainers acknowledge reports in a timely manner and keep you informed of remediation progress.",{"_3383":2603,"_29651":2578,"_20578":56382,"_5":14121,"_26960":56325,"_2870":56383},[],"This policy covers the source code, configuration, and CI/CD workflows of the lamassuiot, lamassu-dashboard, and lamassu-helm repositories.",{"_3383":2604,"_29651":2604,"_5":14473,"_2870":56385,"_30004":56386,"_20578":56388,"_26960":2604},"3.8.0 to 4.0.0",[48280,56387],"Upgrades",[],{"_3383":2605,"_29651":2604,"_20578":56390,"_5":14121,"_26960":2604,"_2870":56391},[],"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result.",{"_3383":2606,"_29651":2604,"_5":30001,"_20578":56393,"_26960":56394,"_2870":56395},[],"/docs/pr-preview/pr-55/upgrades/3-8-0-to-4-0-0#architecture-changes","Architecture changes",{"_3383":2607,"_29651":2604,"_5":30001,"_20578":56397,"_26960":56398,"_2870":56399},[],"/docs/pr-preview/pr-55/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_3383":2608,"_29651":2604,"_5":30001,"_20578":56401,"_26960":56402,"_2870":56403},[],"/docs/pr-preview/pr-55/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_3383":2609,"_29651":2604,"_5":30001,"_20578":56405,"_26960":56406,"_2870":56407},[],"/docs/pr-preview/pr-55/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_3383":2610,"_29651":2604,"_5":30001,"_20578":56409,"_26960":56410,"_2870":56411},[],"/docs/pr-preview/pr-55/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_3383":2611,"_29651":2604,"_5":30001,"_20578":56413,"_26960":56414,"_2870":56415},[],"/docs/pr-preview/pr-55/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_3383":2612,"_29651":2604,"_5":30001,"_20578":56417,"_26960":56418,"_2870":56419},[],"/docs/pr-preview/pr-55/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_3383":2613,"_29651":2604,"_5":30001,"_20578":56421,"_26960":56422,"_2870":56423},[],"/docs/pr-preview/pr-55/upgrades/3-8-0-to-4-0-0#helm-chart-and-values","Helm chart and values",{"_3383":2614,"_29651":2604,"_5":30001,"_20578":56425,"_26960":56426,"_2870":56427},[],"/docs/pr-preview/pr-55/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_3383":2615,"_29651":2604,"_5":30001,"_20578":56429,"_26960":56430,"_2870":56431},[],"/docs/pr-preview/pr-55/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_3383":2616,"_29651":2604,"_5":30001,"_20578":56433,"_26960":56434,"_2870":56435},[],"/docs/pr-preview/pr-55/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_3383":2617,"_29651":2604,"_5":30001,"_20578":56437,"_26960":56438,"_2870":56439},[],"/docs/pr-preview/pr-55/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_3383":2618,"_29651":2604,"_5":30001,"_20578":56441,"_26960":56442,"_2870":56443},[],"/docs/pr-preview/pr-55/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_3383":2619,"_29651":2604,"_5":30001,"_20578":56445,"_26960":56446,"_2870":56447},[],"/docs/pr-preview/pr-55/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_3383":2620,"_29651":2604,"_5":30001,"_20578":56449,"_26960":56450,"_2870":56451},[],"/docs/pr-preview/pr-55/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_3383":2621,"_29651":2604,"_5":30001,"_20578":56453,"_26960":56454,"_2870":56455},[],"/docs/pr-preview/pr-55/upgrades/3-8-0-to-4-0-0#data-and-storage","Data and storage",{"_3383":2622,"_29651":2604,"_5":30001,"_20578":56457,"_26960":56458,"_2870":56459},[],"/docs/pr-preview/pr-55/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_3383":2623,"_29651":2604,"_5":30001,"_20578":56461,"_26960":56462,"_2870":56463},[],"/docs/pr-preview/pr-55/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","SQLite storage removed",{"_3383":2624,"_29651":2604,"_5":30001,"_20578":56465,"_26960":56466,"_2870":56467},[],"/docs/pr-preview/pr-55/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_3383":2625,"_29651":2604,"_5":30001,"_20578":56469,"_26960":56470,"_2870":56471},[],"/docs/pr-preview/pr-55/upgrades/3-8-0-to-4-0-0#references-between-certificates-keys-and-va-roles","References between certificates, keys and VA roles",{"_3383":2626,"_29651":2604,"_5":30001,"_20578":56473,"_26960":56474,"_2870":56475},[],"/docs/pr-preview/pr-55/upgrades/3-8-0-to-4-0-0#apis-and-stored-configuration","APIs and stored configuration",{"_3383":2627,"_29651":2604,"_5":30001,"_20578":56477,"_26960":56478,"_2870":56479},[],"/docs/pr-preview/pr-55/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_3383":2628,"_29651":2604,"_5":30001,"_20578":56481,"_26960":56482,"_2870":56483},[],"/docs/pr-preview/pr-55/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_3383":2629,"_29651":2604,"_5":30001,"_20578":56485,"_26960":56486,"_2870":56487},[],"/docs/pr-preview/pr-55/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_3383":2630,"_29651":2604,"_5":30001,"_20578":56489,"_26960":56490,"_2870":56491},[],"/docs/pr-preview/pr-55/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_3383":2631,"_29651":2604,"_5":30001,"_20578":56493,"_26960":56494,"_2870":56495},[],"/docs/pr-preview/pr-55/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_3383":2632,"_29651":2604,"_5":30001,"_20578":56497,"_26960":56498,"_2870":56499},[],"/docs/pr-preview/pr-55/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_3383":2633,"_29651":2604,"_5":30001,"_20578":56501,"_26960":56502,"_2870":56503},[],"/docs/pr-preview/pr-55/upgrades/3-8-0-to-4-0-0#va-role-signer-field","VA role signer field",{"_3383":2634,"_29651":2604,"_5":30001,"_20578":56505,"_26960":56506,"_2870":56507},[],"/docs/pr-preview/pr-55/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_3383":2635,"_29651":2604,"_5":30001,"_20578":56509,"_26960":56510,"_2870":56511},[],"/docs/pr-preview/pr-55/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_3383":2636,"_29651":2604,"_5":30001,"_20578":56513,"_26960":56514,"_2870":56515},[],"/docs/pr-preview/pr-55/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_3383":2637,"_29651":2604,"_5":30001,"_20578":56517,"_26960":56518,"_2870":56519},[],"/docs/pr-preview/pr-55/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_3383":2638,"_29651":2604,"_5":30001,"_20578":56521,"_26960":56522,"_2870":56523},[],"/docs/pr-preview/pr-55/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_3383":2639,"_29651":2604,"_5":30001,"_20578":56525,"_26960":56526,"_2870":56527},[],"/docs/pr-preview/pr-55/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_3383":2640,"_29651":2604,"_5":30001,"_20578":56529,"_26960":56530,"_2870":56531},[],"/docs/pr-preview/pr-55/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_3383":2641,"_29651":2604,"_5":30001,"_20578":56533,"_26960":56534,"_2870":52325},[],"/docs/pr-preview/pr-55/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_3383":2642,"_29651":2604,"_5":30001,"_20578":56536,"_26960":56537,"_2870":56538},[],"/docs/pr-preview/pr-55/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_3383":2643,"_29651":2604,"_5":30001,"_20578":56540,"_26960":56541,"_2870":56542},[],"/docs/pr-preview/pr-55/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_3383":2644,"_29651":2604,"_20578":56544,"_5":14121,"_26960":2604,"_2870":56545},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_3383":2645,"_29651":2604,"_20578":56547,"_5":14121,"_26960":2604,"_2870":56548},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_3383":2646,"_29651":2604,"_20578":56550,"_5":14121,"_26960":2604,"_2870":56551},[],"Architecture changes: what is different in 4.0.0 and what the upgrade migrates on its own.",{"_3383":2647,"_29651":2604,"_20578":56553,"_5":14121,"_26960":2604,"_2870":56554},[],"Breaking changes: every change that can break a 3.8.0 deployment, who it affects and what to do.",{"_3383":2648,"_29651":2604,"_20578":56556,"_5":14121,"_26960":2604,"_2870":56557},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_3383":2649,"_29651":2604,"_20578":56559,"_5":14121,"_26960":2604,"_2870":56560},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_3383":2650,"_29651":2604,"_20578":56562,"_5":14121,"_26960":2604,"_2870":56563},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_3383":2651,"_29651":2604,"_20578":56565,"_5":14121,"_26960":56398,"_2870":56566},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_3383":2652,"_29651":2604,"_20578":56568,"_5":14121,"_26960":56398,"_2870":56569},[],"PostgreSQL is now the only storage engine. SQLite support is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0.",{"_3383":2653,"_29651":2604,"_20578":56571,"_5":14121,"_26960":56402,"_2870":56572},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_3383":2654,"_29651":2604,"_20578":56574,"_5":14121,"_26960":56402,"_2870":56575},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and VA roles. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_3383":2655,"_29651":2604,"_20578":56577,"_5":14121,"_26960":56406,"_2870":56578},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. The events endpoint can also stream events over Server-Sent Events (SSE); to fan events out across service instances, each Device Manager instance binds its own durable AMQP queue.",{"_3383":2656,"_29651":2604,"_20578":56580,"_5":14121,"_26960":56410,"_2870":56581},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_3383":2657,"_29651":2604,"_20578":56583,"_5":14121,"_26960":56410,"_2870":56584},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_3383":2658,"_29651":2604,"_20578":56586,"_5":14121,"_26960":56410,"_2870":56587},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_3383":2659,"_29651":2604,"_20578":56589,"_5":14121,"_26960":56410,"_2870":56590},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_3383":2660,"_29651":2604,"_20578":56592,"_5":14121,"_26960":56410,"_2870":56593},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_3383":2661,"_29651":2604,"_20578":56595,"_5":14121,"_26960":56414,"_2870":56596},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_3383":2662,"_29651":2604,"_20578":56598,"_5":14121,"_26960":56414,"_2870":56599},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_3383":2663,"_29651":2604,"_20578":56601,"_5":14121,"_26960":56414,"_2870":56602},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_3383":2664,"_29651":2604,"_20578":56604,"_5":14121,"_26960":56414,"_2870":56605},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_3383":2665,"_29651":2604,"_20578":56607,"_5":14121,"_26960":56414,"_2870":56608},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_3383":2666,"_29651":2604,"_20578":56610,"_5":14121,"_26960":56418,"_2870":56611},[],"Change",{"_3383":2667,"_29651":2604,"_20578":56613,"_5":14121,"_26960":56418,"_2870":56614},[],"Who is affected",{"_3383":2668,"_29651":2604,"_20578":56616,"_5":14121,"_26960":56418,"_2870":56617},[],"Severity",{"_3383":2669,"_29651":2604,"_20578":56619,"_5":14121,"_26960":56418,"_2870":55125},[],{"_3383":2670,"_29651":2604,"_20578":56621,"_5":14121,"_26960":56418,"_2870":56427},[],{"_3383":2671,"_29651":2604,"_20578":56623,"_5":14121,"_26960":56418,"_2870":56624},[],"Helm releases with a filesystem KMS engine or local VA CRL storage",{"_3383":2672,"_29651":2604,"_20578":56626,"_5":14121,"_26960":56418,"_2870":56627},[],"High: KMS and VA start on empty volumes",{"_3383":2673,"_29651":2604,"_20578":56629,"_5":14121,"_26960":56418,"_2870":56630},[],"Copy the data into the new volumes",{"_3383":2674,"_29651":2604,"_20578":56632,"_5":14121,"_26960":56418,"_2870":56431},[],{"_3383":2675,"_29651":2604,"_20578":56634,"_5":14121,"_26960":56418,"_2870":56635},[],"Every Helm release",{"_3383":2676,"_29651":2604,"_20578":56637,"_5":14121,"_26960":56418,"_2870":56638},[],"High: `helm upgrade` fails",{"_3383":2677,"_29651":2604,"_20578":56640,"_5":14121,"_26960":56418,"_2870":56641},[],"Remove or rename legacy keys",{"_3383":2678,"_29651":2604,"_20578":56643,"_5":14121,"_26960":56418,"_2870":56435},[],{"_3383":2679,"_29651":2604,"_20578":56645,"_5":14121,"_26960":56418,"_2870":56646},[],"Every deployment",{"_3383":2680,"_29651":2604,"_20578":56648,"_5":14121,"_26960":56418,"_2870":56649},[],"High: without a bootstrap principal there is no administrator",{"_3383":2681,"_29651":2604,"_20578":56651,"_5":14121,"_26960":56418,"_2870":56652},[],"Configure `services.authz`",{"_3383":2682,"_29651":2604,"_20578":56654,"_5":14121,"_26960":56418,"_2870":56439},[],{"_3383":2683,"_29651":2604,"_20578":56656,"_5":14121,"_26960":56418,"_2870":56635},[],{"_3383":2684,"_29651":2604,"_20578":56658,"_5":14121,"_26960":56418,"_2870":56659},[],"High: `helm upgrade` fails on the old keys",{"_3383":2685,"_29651":2604,"_20578":56661,"_5":14121,"_26960":56418,"_2870":56662},[],"Move JWKS and roles into `services.authz`",{"_3383":2686,"_29651":2604,"_20578":56664,"_5":14121,"_26960":56418,"_2870":56459},[],{"_3383":2687,"_29651":2604,"_20578":56666,"_5":14121,"_26960":56418,"_2870":56667},[],"3.8.0 deployments with per-service databases",{"_3383":2688,"_29651":2604,"_20578":56669,"_5":14121,"_26960":56418,"_2870":56670},[],"High: services find no data, or a migration aborts",{"_3383":2689,"_29651":2604,"_20578":56672,"_5":14121,"_26960":56418,"_2870":56673},[],"Clean duplicate CA IDs and empty `engine_id` values first; move data manually outside Helm",{"_3383":2690,"_29651":2604,"_20578":56675,"_5":14121,"_26960":56418,"_2870":56463},[],{"_3383":2691,"_29651":2604,"_20578":56677,"_5":14121,"_26960":56418,"_2870":56678},[],"Deployments on SQLite, `couch_db` or `dynamo_db`",{"_3383":2692,"_29651":2604,"_20578":56680,"_5":14121,"_26960":56418,"_2870":56681},[],"High: the backend no longer starts with them",{"_3383":2693,"_29651":2604,"_20578":56683,"_5":14121,"_26960":56418,"_2870":56684},[],"Move to PostgreSQL before upgrading",{"_3383":2694,"_29651":2604,"_20578":56686,"_5":14121,"_26960":56418,"_2870":56687},[],"Webhooks with file references",{"_3383":2695,"_29651":2604,"_20578":56689,"_5":14121,"_26960":56418,"_2870":56690},[],"DMSs whose webhook mTLS certificate or key were file paths",{"_3383":2696,"_29651":2604,"_20578":56692,"_5":14121,"_26960":56418,"_2870":56693},[],"High: enrollments calling the webhook fail",{"_3383":2697,"_29651":2604,"_20578":56695,"_5":14121,"_26960":56418,"_2870":56696},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_3383":2698,"_29651":2604,"_20578":56698,"_5":14121,"_26960":56418,"_2870":56443},[],{"_3383":2699,"_29651":2604,"_20578":56700,"_5":14121,"_26960":56418,"_2870":56701},[],"Releases with per-service identity overrides or mounted key material",{"_3383":2700,"_29651":2604,"_20578":56703,"_5":14121,"_26960":56418,"_2870":56704},[],"Medium: services cannot read their files",{"_3383":2701,"_29651":2604,"_20578":56706,"_5":14121,"_26960":56418,"_2870":56707},[],"Remove the overrides and fix volume ownership",{"_3383":2702,"_29651":2604,"_20578":56709,"_5":14121,"_26960":56418,"_2870":56447},[],{"_3383":2703,"_29651":2604,"_20578":56711,"_5":14121,"_26960":56418,"_2870":56712},[],"Releases that set `amqp.tls`",{"_3383":2704,"_29651":2604,"_20578":56714,"_5":14121,"_26960":56418,"_2870":56715},[],"Medium: clients connect to the wrong port",{"_3383":2705,"_29651":2604,"_20578":56717,"_5":14121,"_26960":56418,"_2870":56718},[],"Point `amqp.port` at the TLS listener, or disable TLS",{"_3383":2706,"_29651":2604,"_20578":56720,"_5":14121,"_26960":56418,"_2870":56467},[],{"_3383":2707,"_29651":2604,"_20578":56722,"_5":14121,"_26960":56418,"_2870":56723},[],"Installations whose CA keys predate the KMS",{"_3383":2708,"_29651":2604,"_20578":56725,"_5":14121,"_26960":56418,"_2870":56726},[],"Medium: CA keys stay unmanaged",{"_3383":2709,"_29651":2604,"_20578":56728,"_5":14121,"_26960":56418,"_2870":56729},[],"Run the CA-to-KMS migration",{"_3383":2710,"_29651":2604,"_20578":56731,"_5":14121,"_26960":56418,"_2870":56732},[],"Receiver certificate verification",{"_3383":2711,"_29651":2604,"_20578":56734,"_5":14121,"_26960":56418,"_2870":56735},[],"DMSs whose webhook had `validate_server_cert: false`",{"_3383":2712,"_29651":2604,"_20578":56737,"_5":14121,"_26960":56418,"_2870":56738},[],"Medium: credentials go to an unverified receiver",{"_3383":2713,"_29651":2604,"_20578":56740,"_5":14121,"_26960":56418,"_2870":56741},[],"Set `insecure_skip_verify` to `false`",{"_3383":2714,"_29651":2604,"_20578":56743,"_5":14121,"_26960":56418,"_2870":56483},[],{"_3383":2715,"_29651":2604,"_20578":56745,"_5":14121,"_26960":56418,"_2870":56746},[],"Scripts and consoles that edit DMSs through the API",{"_3383":2716,"_29651":2604,"_20578":56748,"_5":14121,"_26960":56418,"_2870":56749},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_3383":2717,"_29651":2604,"_20578":56751,"_5":14121,"_26960":56418,"_2870":56752},[],"Read the DMS before editing and use the new field",{"_3383":2718,"_29651":2604,"_20578":56754,"_5":14121,"_26960":56418,"_2870":56503},[],{"_3383":2719,"_29651":2604,"_20578":56756,"_5":14121,"_26960":56418,"_2870":56757},[],"Clients that create or update VA roles through the API",{"_3383":2720,"_29651":2604,"_20578":56759,"_5":14121,"_26960":56418,"_2870":56760},[],"Medium: requests with the old field return an error",{"_3383":2721,"_29651":2604,"_20578":56762,"_5":14121,"_26960":56418,"_2870":56763},[],"Replace `crl_options.subject_key_id_signer` with the required `crl_options.signer_certificate_serial_number`",{"_3383":2722,"_29651":2604,"_20578":56765,"_5":14121,"_26960":56418,"_2870":56499},[],{"_3383":2723,"_29651":2604,"_20578":56767,"_5":14121,"_26960":56418,"_2870":56768},[],"Consumers that read the device `events` field",{"_3383":2724,"_29651":2604,"_20578":56770,"_5":14121,"_26960":56418,"_2870":56771},[],"Medium: the field disappears",{"_3383":2725,"_29651":2604,"_20578":56773,"_5":14121,"_26960":56418,"_2870":56774},[],"Use the new event endpoints",{"_3383":2726,"_29651":2604,"_20578":56776,"_5":14121,"_26960":56418,"_2870":56451},[],{"_3383":2727,"_29651":2604,"_20578":56778,"_5":14121,"_26960":56418,"_2870":56779},[],"Releases that override `toolbox`, `services.connectors`, ports, probes or scheduling",{"_3383":2728,"_29651":2604,"_20578":56781,"_5":14121,"_26960":56418,"_2870":56782},[],"Low to medium: validation errors or changed defaults",{"_3383":2729,"_29651":2604,"_20578":56784,"_5":14121,"_26960":56418,"_2870":56785},[],"Update the values file",{"_3383":2730,"_29651":2604,"_20578":56787,"_5":14121,"_26960":56418,"_2870":56491},[],{"_3383":2731,"_29651":2604,"_20578":56789,"_5":14121,"_26960":56418,"_2870":56790},[],"Clients that send the DMS ID in the update body",{"_3383":2732,"_29651":2604,"_20578":56792,"_5":14121,"_26960":56418,"_2870":56793},[],"Low: the ID in the URL wins",{"_3383":2733,"_29651":2604,"_20578":56795,"_5":14121,"_26960":56418,"_2870":56796},[],"Send the ID in the URL",{"_3383":2734,"_29651":2604,"_20578":56798,"_5":14121,"_26960":56418,"_2870":56495},[],{"_3383":2735,"_29651":2604,"_20578":56800,"_5":14121,"_26960":56418,"_2870":56801},[],"Consumers that match on certificate `type`",{"_3383":2736,"_29651":2604,"_20578":56803,"_5":14121,"_26960":56418,"_2870":56804},[],"Low: two values are renamed",{"_3383":2737,"_29651":2604,"_20578":56806,"_5":14121,"_26960":56418,"_2870":56807},[],"Adapt consumers",{"_3383":2738,"_29651":2604,"_20578":56809,"_5":14121,"_26960":56418,"_2870":56487},[],{"_3383":2739,"_29651":2604,"_20578":56811,"_5":14121,"_26960":56418,"_2870":56812},[],"Any DMS",{"_3383":2740,"_29651":2604,"_20578":56814,"_5":14121,"_26960":56418,"_2870":56815},[],"Low: informational",{"_3383":2741,"_29651":2604,"_20578":56817,"_5":14121,"_26960":56418,"_2870":56818},[],"Read both blocks before editing",{"_3383":2742,"_29651":2604,"_20578":56820,"_5":14121,"_26960":56426,"_2870":56821},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_3383":2743,"_29651":2604,"_20578":56823,"_5":14121,"_26960":56426,"_2870":56824},[],"Step 4 of the migration guide copies the data.",{"_3383":2744,"_29651":2604,"_20578":56826,"_5":14121,"_26960":56430,"_2870":56827},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_3383":2745,"_29651":2604,"_20578":56829,"_5":14121,"_26960":56434,"_2870":56830},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_3383":2746,"_29651":2604,"_20578":56832,"_5":14121,"_26960":56438,"_2870":56833},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_3383":2747,"_29651":2604,"_20578":56835,"_5":14121,"_26960":56442,"_2870":56836},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_3383":2748,"_29651":2604,"_20578":56838,"_5":14121,"_26960":56442,"_2870":56839},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_3383":2749,"_29651":2604,"_20578":56841,"_5":14121,"_26960":56446,"_2870":56842},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_3383":2750,"_29651":2604,"_20578":56844,"_5":14121,"_26960":56450,"_2870":56845},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_3383":2751,"_29651":2604,"_20578":56847,"_5":14121,"_26960":56450,"_2870":56848},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_3383":2752,"_29651":2604,"_20578":56850,"_5":14121,"_26960":56450,"_2870":56851},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_3383":2753,"_29651":2604,"_20578":56853,"_5":14121,"_26960":56450,"_2870":56854},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_3383":2754,"_29651":2604,"_20578":56856,"_5":14121,"_26960":56450,"_2870":56857},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_3383":2755,"_29651":2604,"_20578":56859,"_5":14121,"_26960":56450,"_2870":56860},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_3383":2756,"_29651":2604,"_20578":56862,"_5":14121,"_26960":56458,"_2870":56863},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_3383":2757,"_29651":2604,"_20578":56865,"_5":14121,"_26960":56458,"_2870":56866},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_3383":2758,"_29651":2604,"_20578":56868,"_5":14121,"_26960":56458,"_2870":56869},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_3383":2759,"_29651":2604,"_20578":56871,"_5":14121,"_26960":56458,"_2870":56872},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_3383":2760,"_29651":2604,"_20578":56874,"_5":14121,"_26960":56458,"_2870":56875},[],"The same KMS migration deletes, with a `NOTICE`, aliases that equal an existing key ID, because identifiers now resolve as a key ID before an alias. Affected aliases are dropped, not redirected.",{"_3383":2761,"_29651":2604,"_20578":56877,"_5":14121,"_26960":56462,"_2870":56878},[],"The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_3383":2762,"_29651":2604,"_20578":56880,"_5":14121,"_26960":56466,"_2870":56881},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_3383":2763,"_29651":2604,"_20578":56883,"_5":14121,"_26960":56466,"_2870":56884},[],"The `key_id` is the certificate's `subject_key_id` (SHA-256 of the public key).",{"_3383":2764,"_29651":2604,"_20578":56886,"_5":14121,"_26960":56466,"_2870":56887},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_3383":2765,"_29651":2604,"_20578":56889,"_5":14121,"_26960":56466,"_2870":56890},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_3383":2766,"_29651":2604,"_20578":56892,"_5":14121,"_26960":56466,"_2870":56893},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_3383":2767,"_29651":2604,"_20578":56895,"_5":14121,"_26960":56466,"_2870":56896},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_3383":2768,"_29651":2604,"_20578":56898,"_5":14121,"_26960":56466,"_2870":56899},[],"Once legacy keys are registered, starting the KMS with the backend configuration option `crypto_engines.migrate_keys_format` renames keys whose name is not the public-key SHA-256 digest, keeps the old name as an alias and moves certificate references along. It is safe to re-run and can be disabled afterwards.",{"_3383":2769,"_29651":2604,"_20578":56901,"_5":14121,"_26960":56470,"_2870":56902},[],"Certificates now reference their KMS key, and VA roles reference their signer certificate, so a key or certificate in use cannot be deleted. The KMS migration drops the legacy `lamassu.io/kms/binded-resources` key metadata. Before 4.0.0, deleting a CA could remove its key while leaving key references in its retained certificate records. The CA migration registers those missing keys in the KMS with only their public key to satisfy the retained references. These entries cannot be deleted while the retained certificates reference them; they do not restore the private key. In 4.0.0, deleting a CA releases the references from its own current certificate and linked reissued certificates before attempting to delete the key; other certificates that still reference it prevent deletion.",{"_3383":2770,"_29651":2604,"_20578":56904,"_5":14121,"_26960":56478,"_2870":56905},[],"Stored webhook configs are rewritten to the current layout and their fields renamed:",{"_3383":2771,"_29651":2604,"_20578":56907,"_5":14121,"_26960":56478,"_2870":56908},[],"Field in 3.8.0",{"_3383":2772,"_29651":2604,"_20578":56910,"_5":14121,"_26960":56478,"_2870":56911},[],"Field in 4.0.0",{"_3383":2773,"_29651":2604,"_20578":56913,"_5":14121,"_26960":56478,"_2870":56914},[],"`validate_server_cert`",{"_3383":2774,"_29651":2604,"_20578":56916,"_5":14121,"_26960":56478,"_2870":56917},[],"`insecure_skip_verify` (value negated)",{"_3383":2775,"_29651":2604,"_20578":56919,"_5":14121,"_26960":56478,"_2870":56920},[],"`oidc`",{"_3383":2776,"_29651":2604,"_20578":56922,"_5":14121,"_26960":56478,"_2870":56923},[],"`jwt_options`",{"_3383":2777,"_29651":2604,"_20578":56925,"_5":14121,"_26960":56478,"_2870":56926},[],"`apikey`",{"_3383":2778,"_29651":2604,"_20578":56928,"_5":14121,"_26960":56478,"_2870":56929},[],"`apikey_options`",{"_3383":2779,"_29651":2604,"_20578":56931,"_5":14121,"_26960":56478,"_2870":56932},[],"`mtls`",{"_3383":2780,"_29651":2604,"_20578":56934,"_5":14121,"_26960":56478,"_2870":56935},[],"`mtls_options`",{"_3383":2781,"_29651":2604,"_20578":56937,"_5":14121,"_26960":56478,"_2870":56938},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. Two cases do need it.",{"_3383":2782,"_29651":2604,"_20578":56940,"_5":14121,"_26960":56478,"_2870":56941},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_3383":2783,"_29651":2604,"_20578":56943,"_5":14121,"_26960":56478,"_2870":56944},[],"**Receiver certificate verification.** A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_3383":2784,"_29651":2604,"_20578":56946,"_5":14121,"_26960":56482,"_2870":56947},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3383":2785,"_29651":2604,"_20578":56949,"_5":14121,"_26960":56482,"_2870":56950},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_3383":2786,"_29651":2604,"_20578":56952,"_5":14121,"_26960":56482,"_2870":56953},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_3383":2787,"_29651":2604,"_20578":56955,"_5":14121,"_26960":56486,"_2870":56956},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but read both blocks before editing a DMS so that you do not modify one while believing you are editing the other. The console exposes independent editors for both blocks; the DMS guide describes their fields, and you can also edit them through the DMS API.",{"_3383":2788,"_29651":2604,"_20578":56958,"_5":14121,"_26960":56490,"_2870":56959},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_3383":2789,"_29651":2604,"_20578":56961,"_5":14121,"_26960":56494,"_2870":56962},[],"Stored certificate type values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Adapt consumers that read or match on those values.",{"_3383":2790,"_29651":2604,"_20578":56964,"_5":14121,"_26960":56498,"_2870":56965},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_3383":2791,"_29651":2604,"_20578":56967,"_5":14121,"_26960":56498,"_2870":56968},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_3383":2792,"_29651":2604,"_20578":56970,"_5":14121,"_26960":56498,"_2870":56971},[],"`POST /v1/devices/:id/events` creates an event.",{"_3383":2793,"_29651":2604,"_20578":56973,"_5":14121,"_26960":56498,"_2870":56974},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Each Device Manager instance binds a durable AMQP queue named after its service ID, `device-manager-sse-<uuid>`. Queues from crashed or replaced instances linger until removed, so configure an expiration or cleanup policy on the broker.",{"_3383":2794,"_29651":2604,"_20578":56976,"_5":14121,"_26960":56502,"_2870":56977},[],"`crl_options.subject_key_id_signer` is replaced by the required `crl_options.signer_certificate_serial_number`, the serial number of the existing certificate that signs the CRL. A new role's initial value is the CA's current certificate serial number. Requests that still carry `subject_key_id_signer` return an error. Custom authorization policies that filter on the old field must be updated: the filter `crl_subject_key_id_signer` is renamed to `crl_signer_certificate_serial_number` and takes serial-number values.",{"_3383":2795,"_29651":2604,"_20578":56979,"_5":14121,"_26960":56506,"_2870":56980},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_3383":2796,"_29651":2604,"_20578":56982,"_5":14121,"_26960":56510,"_2870":56983},[],"Take a verifiable backup of PostgreSQL and schedule downtime. The upgrade moves every service's data into `pki`.",{"_3383":2797,"_29651":2604,"_20578":56985,"_5":14121,"_26960":56510,"_2870":56986},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_3383":2798,"_29651":2604,"_20578":56988,"_5":14121,"_26960":56510,"_2870":56989},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_3383":2799,"_29651":2604,"_20578":56991,"_5":14121,"_26960":56510,"_2870":56992},[],"Record the names of your local-storage PVCs:",{"_3383":2800,"_29651":2604,"_20578":56994,"_5":14121,"_26960":56510,"_2870":56995},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_3383":2801,"_29651":2604,"_20578":56997,"_5":14121,"_26960":56514,"_2870":56998},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_3383":2802,"_29651":2604,"_20578":57000,"_5":14121,"_26960":56514,"_2870":57001},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_3383":2803,"_29651":2604,"_20578":57003,"_5":14121,"_26960":56514,"_2870":57004},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is read; the connection always uses the global `postgres.hostname`, `postgres.port`, `postgres.username` and `postgres.password` values.",{"_3383":2804,"_29651":2604,"_20578":57006,"_5":14121,"_26960":56514,"_2870":57007},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_3383":2805,"_29651":2604,"_20578":57009,"_5":14121,"_26960":56514,"_2870":57010},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_3383":2806,"_29651":2604,"_20578":57012,"_5":14121,"_26960":56514,"_2870":57013},[],"**Rename `toolbox` to `connectivityTest`:**",{"_3383":2807,"_29651":2604,"_20578":57015,"_5":14121,"_26960":56514,"_2870":57016},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3383":2808,"_29651":2604,"_20578":57018,"_5":14121,"_26960":56514,"_2870":57019},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_3383":2809,"_29651":2604,"_20578":57021,"_5":14121,"_26960":56514,"_2870":57022},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_3383":2810,"_29651":2604,"_20578":57024,"_5":14121,"_26960":56514,"_2870":57025},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_3383":2811,"_29651":2604,"_20578":57027,"_5":14121,"_26960":56514,"_2870":57028},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_3383":2812,"_29651":2604,"_20578":57030,"_5":14121,"_26960":56514,"_2870":57031},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown.",{"_3383":2813,"_29651":2604,"_20578":57033,"_5":14121,"_26960":56518,"_2870":57034},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_3383":2814,"_29651":2604,"_20578":57036,"_5":14121,"_26960":56518,"_2870":57037},[],"If the deployment uses local KMS or VA storage, those pods fail until you complete step 4, so `--wait` cannot succeed: Helm waits for them to become ready, times out, exits with an error and marks the release `failed`. The hooks have already run by then, and every manifest, including the new StatefulSets and their PVCs, has been applied. Helm does not roll anything back without `--atomic`. Continue with step 4, then re-run the same `helm upgrade` command so it completes and Helm records the release as `deployed`. Both hooks are idempotent, so they are safe to run again.",{"_3383":2815,"_29651":2604,"_20578":57039,"_5":14121,"_26960":56522,"_2870":57040},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_3383":2816,"_29651":2604,"_20578":57042,"_5":14121,"_26960":56522,"_2870":57043},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_3383":2817,"_29651":2604,"_20578":57045,"_5":14121,"_26960":56522,"_2870":57046},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If `claims_ok` prints `ABORT`, the block stops before listing the claims: either a StatefulSet lookup failed, or a new claim resolves to the 3.8.0 claim. In the second case the copy would verify against itself and the final cleanup would delete the live volume. The chart always appends `-kms` and `-va` to the release-scoped name, so a collision means the claims are not what this guide expects; investigate before going on. Item 3 runs the same check and refuses to create the helper pod, so nothing touches the volumes. The check returns instead of calling `exit`, which would close your shell and lose the variables set so far. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_3383":2818,"_29651":2604,"_20578":57048,"_5":14121,"_26960":56522,"_2870":57049},[],"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:",{"_3383":2819,"_29651":2604,"_20578":57051,"_5":14121,"_26960":56522,"_2870":57052},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_3383":2820,"_29651":2604,"_20578":57054,"_5":14121,"_26960":56522,"_2870":57055},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_3383":2821,"_29651":2604,"_20578":57057,"_5":14121,"_26960":56522,"_2870":57058},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_3383":2822,"_29651":2604,"_20578":57060,"_5":14121,"_26960":56522,"_2870":57061},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_3383":2823,"_29651":2604,"_20578":57063,"_5":14121,"_26960":56522,"_2870":57064},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_3383":2824,"_29651":2604,"_20578":57066,"_5":14121,"_26960":56522,"_2870":57067},[],"**Remove the helper and restore the recorded replica counts:**",{"_3383":2825,"_29651":2604,"_20578":57069,"_5":14121,"_26960":56522,"_2870":57070},[],"**Re-run the step 3 `helm upgrade` command.** The KMS and VA pods now start against the copied data, so `--wait` succeeds and the release moves from `failed` to `deployed`.",{"_3383":2826,"_29651":2604,"_20578":57072,"_5":14121,"_26960":56526,"_2870":57073},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_3383":2827,"_29651":2604,"_20578":57075,"_5":14121,"_26960":56526,"_2870":57076},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_3383":2828,"_29651":2604,"_20578":57078,"_5":14121,"_26960":56530,"_2870":57079},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_3383":2829,"_29651":2604,"_20578":57081,"_5":14121,"_26960":56530,"_2870":57082},[],"Run the migrations in the required order, one schema at a time: `kms` first, then the `ca-to-kms-migration` tool (needed only for legacy deployments whose CA keys are named by SKI), then `ca`, then `va`. The `devicemanager`, `dmsmanager` and `alerts` schemas are independent and can be migrated in any order. With Helm, the chart's pre-install job applies the schemas in the correct order automatically.",{"_3383":2830,"_29651":2604,"_20578":57084,"_5":14121,"_26960":56530,"_2870":57085},[],"The schemas reference each other, so the PostgreSQL role running the migrations needs cross-schema privileges: the `ca` schema needs `USAGE` on `kms` plus `SELECT`, `REFERENCES` and `INSERT` on `kms.kms_keys`, and the `va` schema needs `USAGE` on `ca` plus `SELECT` and `REFERENCES` on `ca.certificates` and `SELECT` on `ca.ca_certificates`. If your services connect with a different user than the one that ran the migrations, grant that user `SELECT` on `ca.certificates_view` after the migrations.",{"_3383":2831,"_29651":2604,"_20578":57087,"_5":14121,"_26960":56530,"_2870":57088},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_3383":2832,"_29651":2604,"_20578":57090,"_5":14121,"_26960":56530,"_2870":57091},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_3383":2833,"_29651":2604,"_20578":57093,"_5":14121,"_26960":56530,"_2870":57094},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository.",{"_3383":2834,"_29651":2604,"_20578":57096,"_5":14121,"_26960":56530,"_2870":57097},[],"Both tools' READMEs document the 4.0.0 `pki` layout and match this page: `goose-lamassu` uses `dbname=pki` examples and does not validate the database name, and the `ca-to-kms-migration` README describes the single `pki` database and the migration order.",{"_3383":2835,"_29651":2604,"_20578":57099,"_5":14121,"_26960":56534,"_2870":57100},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_3383":2836,"_29651":2604,"_20578":57102,"_5":14121,"_26960":56534,"_2870":57103},[],"**`helm upgrade --wait` times out and `helm status` reports the release as `failed`.** With local KMS or VA storage this is expected on the first run: the new pods cannot become ready before their data is copied. The hooks ran and the manifests and PVCs were applied, so complete step 4 and re-run the same `helm upgrade` command. If other pods are also not ready, check their logs, because something else is wrong.",{"_3383":2837,"_29651":2604,"_20578":57105,"_5":14121,"_26960":56534,"_2870":57106},[],"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait.",{"_3383":2838,"_29651":2604,"_20578":57108,"_5":14121,"_26960":56534,"_2870":57109},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_3383":2839,"_29651":2604,"_20578":57111,"_5":14121,"_26960":56534,"_2870":57112},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted on duplicate CA IDs or missing `engine_id` values. Check the job logs, fix the privileges or the data, and re-run the upgrade.",{"_3383":2840,"_29651":2604,"_20578":57114,"_5":14121,"_26960":56534,"_2870":57115},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_3383":2841,"_29651":2604,"_20578":57117,"_5":14121,"_26960":56534,"_2870":57118},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_3383":2842,"_29651":2604,"_20578":57120,"_5":14121,"_26960":56534,"_2870":57121},[],"**A migration aborts with `kms schema not found`.** The schemas must be migrated in order: run the `kms` schema migration before the `ca` schema migration.",{"_3383":2843,"_29651":2604,"_20578":57123,"_5":14121,"_26960":56534,"_2870":57124},[],"**A migration aborts with `ca schema not found`.** Run the `ca` schema migration before the `va` schema migration.",{"_3383":2844,"_29651":2604,"_20578":57126,"_5":14121,"_26960":56534,"_2870":57127},[],"**The VA migration fails with `cannot resolve signer certificate for VA role ... N candidates`.** The migration cannot uniquely identify a signer certificate from the SKI stored on the role. Review the SKI and candidate certificates reported in the error; correct the pre-migration data with a verified backup and rerun the migration. The new `signer_certificate_serial_number` field is created during that migration, so it cannot be set through the VA API while the migration is failing.",{"_3383":2845,"_29651":2604,"_20578":57129,"_5":14121,"_26960":56534,"_2870":57130},[],"**A migration or service fails with `permission denied for table ...`.** The PostgreSQL role is missing the cross-schema privileges listed in Deployments without Helm; this includes `certificates_view` when the post-migration `GRANT SELECT` was skipped. Grant the missing privileges and re-run.",{"_3383":2846,"_29651":2604,"_20578":57132,"_5":14121,"_26960":56537,"_2870":57133},[],"After the upgrade, check in this order:",{"_3383":2847,"_29651":2604,"_20578":57135,"_5":14121,"_26960":56537,"_2870":57136},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations and the foreign-key migrations that run per schema in the required order.",{"_3383":2848,"_29651":2604,"_20578":57138,"_5":14121,"_26960":56537,"_2870":57139},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_3383":2849,"_29651":2604,"_20578":57141,"_5":14121,"_26960":56537,"_2870":57142},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_3383":2850,"_29651":2604,"_20578":57144,"_5":14121,"_26960":56537,"_2870":57145},[],"**Existing CRLs are served.** `GET /crl/<ca-ski>` on VA returns a previously issued CRL, and new CRLs are issued.",{"_3383":2851,"_29651":2604,"_20578":57147,"_5":14121,"_26960":56537,"_2870":57148},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS.",{"_3383":2852,"_29651":2604,"_20578":57150,"_5":14121,"_26960":56537,"_2870":57151},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_3383":2853,"_29651":2604,"_20578":57153,"_5":14121,"_26960":56537,"_2870":57154},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_3383":2854,"_29651":2604,"_20578":57156,"_5":14121,"_26960":56537,"_2870":57157},[],"**AMQP.** The backend connects to the broker with the expected TLS settings, and the cleanup policy for SSE queues is in place.",{"_3383":2855,"_29651":2604,"_20578":57159,"_5":14121,"_26960":56537,"_2870":57160},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_3383":2856,"_29651":2604,"_20578":57162,"_5":14121,"_26960":56537,"_2870":57163},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_3383":2857,"_29651":2604,"_20578":57165,"_5":14121,"_26960":56537,"_2870":57166},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_3383":2858,"_29651":2604,"_20578":57168,"_5":14121,"_26960":56537,"_2870":57169},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_3383":2859,"_29651":2604,"_20578":57171,"_5":14121,"_26960":56537,"_2870":57172},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_3383":2860,"_29651":2604,"_20578":57174,"_5":14121,"_26960":56537,"_2870":57175},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_3383":2861,"_29651":2604,"_20578":57177,"_5":14121,"_26960":56541,"_2870":57178},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy. These are the fixed 3.8.0 names recorded in step 1; before deleting, confirm that neither is mounted by a running pod, for example with `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, where `Used By` must be `<none>`:",{"_3383":2862,"_29651":2604,"_20578":57180,"_5":14121,"_26960":56541,"_2870":57181},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_3383":2863,"_29651":2604,"_20578":57183,"_5":14121,"_26960":56541,"_2870":57184},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3383":2864,"_29651":2604,"_20578":57186,"_5":14121,"_26960":56541,"_2870":57187},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_3383":2865,"_29651":2604,"_20578":57189,"_5":14121,"_26960":56541,"_2870":57190},[],"<Card title=\"Configure a DMS\" description=\"Enrollment, re-enrollment and webhook settings.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />","sorting",{"_57193":57194,"_57195":57196,"_57197":57198,"_57199":57200,"_17818":2905,"_68618":2905},"language","english","sortableProperties",[2870,29651,5,26960],"sortablePropertiesWithTypes",{"_2870":24582,"_29651":24582,"_5":24582,"_26960":24582},"sorts",{"_2870":57201,"_29651":60056,"_5":62910,"_26960":65764},{"_4548":57202,"_57203":57204,"_5":24582},{"_14197":3558,"_14578":4978,"_14597":6809,"_28654":3227,"_14584":7463,"_19532":15248,"_14218":3258,"_14225":5048,"_28596":3989,"_29005":7501,"_29026":4319,"_28630":4397,"_33959":5840,"_28733":7357,"_29070":7365,"_33966":3102,"_33969":6918,"_33972":6101,"_33975":8871,"_29477":2954,"_33980":14657,"_33982":3559,"_29507":17910,"_14593":24929,"_33986":23352,"_33989":4793,"_33991":6073,"_29054":7450,"_29472":4651,"_29520":3623,"_33996":4015,"_33998":3248,"_34000":5055,"_28750":2969,"_34003":18120,"_34005":3331,"_34007":9421,"_34009":3573,"_34011":19815,"_28667":20159,"_34014":11013,"_34016":22397,"_28661":6833,"_29091":7314,"_34020":7246,"_34022":7672,"_34025":2980,"_28707":7537,"_34029":2981,"_28587":14045,"_34032":4278,"_28635":