5":30001,"_20578":113775,"_26960":113776,"_2870":113777},[],"/docs/pr-preview/pr-55/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_3383":68629,"_29651":68625,"_5":30001,"_20578":113779,"_26960":113780,"_2870":113781},[],"/docs/pr-preview/pr-55/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3383":68630,"_29651":68625,"_5":30001,"_20578":113783,"_26960":113784,"_2870":113785},[],"/docs/pr-preview/pr-55/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3383":68631,"_29651":68625,"_5":30001,"_20578":113787,"_26960":113788,"_2870":113789},[],"/docs/pr-preview/pr-55/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3383":68632,"_29651":68625,"_5":30001,"_20578":113791,"_26960":113792,"_2870":113793},[],"/docs/pr-preview/pr-55/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3383":68633,"_29651":68625,"_5":30001,"_20578":113795,"_26960":113796,"_2870":113797},[],"/docs/pr-preview/pr-55/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3383":68634,"_29651":68625,"_20578":113799,"_5":14121,"_26960":68625,"_2870":113800},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3383":68635,"_29651":68625,"_20578":113802,"_5":14121,"_26960":113772,"_2870":113803},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3383":68636,"_29651":68625,"_20578":113805,"_5":14121,"_26960":113772,"_2870":113806},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3383":68637,"_29651":68625,"_20578":113808,"_5":14121,"_26960":113772,"_2870":113809},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3383":68638,"_29651":68625,"_20578":113811,"_5":14121,"_26960":113776,"_2870":113812},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3383":68639,"_29651":68625,"_20578":113814,"_5":14121,"_26960":113776,"_2870":113815},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3383":68640,"_29651":68625,"_20578":113817,"_5":14121,"_26960":113776,"_2870":113818},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3383":68641,"_29651":68625,"_20578":113820,"_5":14121,"_26960":113780,"_2870":113821},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3383":68642,"_29651":68625,"_20578":113823,"_5":14121,"_26960":113784,"_2870":113824},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3383":68643,"_29651":68625,"_20578":113826,"_5":14121,"_26960":113788,"_2870":113827},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3383":68644,"_29651":68625,"_20578":113829,"_5":14121,"_26960":113792,"_2870":113830},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3383":68645,"_29651":68625,"_20578":113832,"_5":14121,"_26960":113796,"_2870":113833},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3383":68646,"_29651":68646,"_5":14473,"_2870":113835,"_30004":113836,"_20578":113837,"_26960":68646},"Despliega Lamassu",[48280,113764],[],{"_3383":68647,"_29651":68646,"_20578":113839,"_5":14121,"_26960":68646,"_2870":113840},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3383":68648,"_29651":68646,"_5":30001,"_20578":113842,"_26960":113843,"_2870":113844},[],"/docs/pr-preview/pr-55/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3383":68649,"_29651":68646,"_5":30001,"_20578":113846,"_26960":113847,"_2870":113848},[],"/docs/pr-preview/pr-55/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3383":68650,"_29651":68646,"_5":30001,"_20578":113850,"_26960":113851,"_2870":113852},[],"/docs/pr-preview/pr-55/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3383":68651,"_29651":68646,"_20578":113854,"_5":14121,"_26960":68646,"_2870":113855},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3383":68652,"_29651":68646,"_20578":113857,"_5":14121,"_26960":113843,"_2870":113858},[],"Modelo",{"_3383":68653,"_29651":68646,"_20578":113860,"_5":14121,"_26960":113843,"_2870":113861},[],"Recomendado para",{"_3383":68654,"_29651":68646,"_20578":113863,"_5":14121,"_26960":113843,"_2870":113864},[],"Quién opera la infraestructura",{"_3383":68655,"_29651":68646,"_20578":113866,"_5":14121,"_26960":113843,"_2870":113867},[],"Punto de partida",{"_3383":68656,"_29651":68646,"_20578":113869,"_5":14121,"_26960":113843,"_2870":48387},[],{"_3383":68657,"_29651":68646,"_20578":113871,"_5":14121,"_26960":113843,"_2870":113872},[],"Producción, entornos regulados y despliegues personalizados",{"_3383":68658,"_29651":68646,"_20578":113874,"_5":14121,"_26960":113843,"_2870":113875},[],"Tu equipo",{"_3383":68659,"_29651":68646,"_20578":113877,"_5":14121,"_26960":113843,"_2870":113878},[],"Helm o Fastlane",{"_3383":68660,"_29651":68646,"_20578":113880,"_5":14121,"_26960":113843,"_2870":48399},[],{"_3383":68661,"_29651":68646,"_20578":113882,"_5":14121,"_26960":113843,"_2870":113883},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3383":68662,"_29651":68646,"_20578":113885,"_5":14121,"_26960":113843,"_2870":113875},[],{"_3383":68663,"_29651":68646,"_20578":113887,"_5":14121,"_26960":113843,"_2870":113888},[],"Imagen preconfigurada en EC2",{"_3383":68664,"_29651":68646,"_20578":113890,"_5":14121,"_26960":113843,"_2870":48410},[],{"_3383":68665,"_29651":68646,"_20578":113892,"_5":14121,"_26960":113843,"_2870":113893},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3383":68666,"_29651":68646,"_20578":113895,"_5":14121,"_26960":113843,"_2870":48416},[],{"_3383":68667,"_29651":68646,"_20578":113897,"_5":14121,"_26960":113843,"_2870":113898},[],"Suscripción gestionada",{"_3383":68668,"_29651":68646,"_20578":113900,"_5":14121,"_26960":113843,"_2870":113901},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3383":68669,"_29651":68646,"_20578":113903,"_5":14121,"_26960":113843,"_2870":113904},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3383":68670,"_29651":68646,"_20578":113906,"_5":14121,"_26960":113843,"_2870":113907},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3383":68671,"_29651":68646,"_20578":113909,"_5":14121,"_26960":113847,"_2870":113910},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3383":68672,"_29651":68646,"_20578":113912,"_5":14121,"_26960":113851,"_2870":113913},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3383":68673,"_29651":68673,"_5":14473,"_2870":113915,"_30004":113916,"_20578":113917,"_26960":68673},"Utiliza Lamassu como SaaS",[48280,113764,113765],[],{"_3383":68674,"_29651":68673,"_20578":113919,"_5":14121,"_26960":68673,"_2870":113920},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3383":68675,"_29651":68673,"_5":30001,"_20578":113922,"_26960":113923,"_2870":113924},[],"/docs/pr-preview/pr-55/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3383":68676,"_29651":68673,"_5":30001,"_20578":113926,"_26960":113927,"_2870":113928},[],"/docs/pr-preview/pr-55/es/deployment/saas#planes","Planes",{"_3383":68677,"_29651":68673,"_5":30001,"_20578":113930,"_26960":113931,"_2870":113932},[],"/docs/pr-preview/pr-55/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3383":68678,"_29651":68673,"_20578":113934,"_5":14121,"_26960":68673,"_2870":113935},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3383":68679,"_29651":68673,"_20578":113937,"_5":14121,"_26960":113923,"_2870":113938},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3383":68680,"_29651":68673,"_20578":113940,"_5":14121,"_26960":113923,"_2870":113941},[],"Copias de seguridad automáticas.",{"_3383":68681,"_29651":68673,"_20578":113943,"_5":14121,"_26960":113923,"_2870":113944},[],"Actualizaciones de versión.",{"_3383":68682,"_29651":68673,"_20578":113946,"_5":14121,"_26960":113923,"_2870":113947},[],"Soporte técnico y SLA según el plan contratado.",{"_3383":68683,"_29651":68673,"_20578":113949,"_5":14121,"_26960":113927,"_2870":48471},[],{"_3383":68684,"_29651":68673,"_20578":113951,"_5":14121,"_26960":113927,"_2870":113952},[],"Dispositivos",{"_3383":68685,"_29651":68673,"_20578":113954,"_5":14121,"_26960":113927,"_2870":113955},[],"Soporte",{"_3383":68686,"_29651":68673,"_20578":113957,"_5":14121,"_26960":113927,"_2870":48480},[],{"_3383":68687,"_29651":68673,"_20578":113959,"_5":14121,"_26960":113927,"_2870":48483},[],{"_3383":68688,"_29651":68673,"_20578":113961,"_5":14121,"_26960":113927,"_2870":113962},[],"Hasta 1.000",{"_3383":68689,"_29651":68673,"_20578":113964,"_5":14121,"_26960":113927,"_2870":48489},[],{"_3383":68690,"_29651":68673,"_20578":113966,"_5":14121,"_26960":113927,"_2870":113967},[],"99,5 %",{"_3383":68691,"_29651":68673,"_20578":113969,"_5":14121,"_26960":113927,"_2870":48495},[],{"_3383":68692,"_29651":68673,"_20578":113971,"_5":14121,"_26960":113927,"_2870":113972},[],"Hasta 10.000",{"_3383":68693,"_29651":68673,"_20578":113974,"_5":14121,"_26960":113927,"_2870":113975},[],"Email y chat",{"_3383":68694,"_29651":68673,"_20578":113977,"_5":14121,"_26960":113927,"_2870":113978},[],"99,9 %",{"_3383":68695,"_29651":68673,"_20578":113980,"_5":14121,"_26960":113927,"_2870":48507},[],{"_3383":68696,"_29651":68673,"_20578":113982,"_5":14121,"_26960":113927,"_2870":113983},[],"Ilimitados",{"_3383":68697,"_29651":68673,"_20578":113985,"_5":14121,"_26960":113927,"_2870":113986},[],"Dedicado",{"_3383":68698,"_29651":68673,"_20578":113988,"_5":14121,"_26960":113927,"_2870":113989},[],"99,99 %",{"_3383":68699,"_29651":68673,"_20578":113991,"_5":14121,"_26960":113931,"_2870":113992},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3383":68700,"_29651":68673,"_20578":113994,"_5":14121,"_26960":113931,"_2870":113995},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3383":68701,"_29651":68701,"_5":14473,"_2870":48524,"_30004":113997,"_20578":113999,"_26960":68701},[48280,113764,113998],"Kubernetes autogestionado",[],{"_3383":68702,"_29651":68701,"_20578":114001,"_5":14121,"_26960":68701,"_2870":114002},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3383":68703,"_29651":68701,"_5":30001,"_20578":114004,"_26960":114005,"_2870":114006},[],"/docs/pr-preview/pr-55/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3383":68704,"_29651":68701,"_5":30001,"_20578":114008,"_26960":114009,"_2870":114010},[],"/docs/pr-preview/pr-55/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3383":68705,"_29651":68701,"_5":30001,"_20578":114012,"_26960":114013,"_2870":114014},[],"/docs/pr-preview/pr-55/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3383":68706,"_29651":68701,"_5":30001,"_20578":114016,"_26960":114017,"_2870":114018},[],"/docs/pr-preview/pr-55/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3383":68707,"_29651":68701,"_5":30001,"_20578":114020,"_26960":114021,"_2870":114022},[],"/docs/pr-preview/pr-55/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3383":68708,"_29651":68701,"_5":30001,"_20578":114024,"_26960":114025,"_2870":114026},[],"/docs/pr-preview/pr-55/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3383":68709,"_29651":68701,"_5":30001,"_20578":114028,"_26960":114029,"_2870":114030},[],"/docs/pr-preview/pr-55/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3383":68710,"_29651":68701,"_5":30001,"_20578":114032,"_26960":114033,"_2870":114034},[],"/docs/pr-preview/pr-55/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3383":68711,"_29651":68701,"_5":30001,"_20578":114036,"_26960":114037,"_2870":114038},[],"/docs/pr-preview/pr-55/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3383":68712,"_29651":68701,"_5":30001,"_20578":114040,"_26960":114041,"_2870":114042},[],"/docs/pr-preview/pr-55/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3383":68713,"_29651":68701,"_5":30001,"_20578":114044,"_26960":114045,"_2870":114046},[],"/docs/pr-preview/pr-55/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3383":68714,"_29651":68701,"_20578":114048,"_5":14121,"_26960":114005,"_2870":114049},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3383":68715,"_29651":68701,"_20578":114051,"_5":14121,"_26960":114005,"_2870":114052},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3383":68716,"_29651":68701,"_20578":114054,"_5":14121,"_26960":114009,"_2870":114055},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3383":68717,"_29651":68701,"_20578":114057,"_5":14121,"_26960":114009,"_2870":114058},[],"Fastlane instala o configura",{"_3383":68718,"_29651":68701,"_20578":114060,"_5":14121,"_26960":114009,"_2870":114061},[],"Tú sigues proporcionando",{"_3383":68719,"_29651":68701,"_20578":114063,"_5":14121,"_26960":114009,"_2870":114064},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3383":68720,"_29651":68701,"_20578":114066,"_5":14121,"_26960":114009,"_2870":114067},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3383":68721,"_29651":68701,"_20578":114069,"_5":14121,"_26960":114009,"_2870":114070},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3383":68722,"_29651":68701,"_20578":114072,"_5":14121,"_26960":114009,"_2870":114073},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3383":68723,"_29651":68701,"_20578":114075,"_5":14121,"_26960":114009,"_2870":114076},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_3383":68724,"_29651":68701,"_20578":114078,"_5":14121,"_26960":114009,"_2870":114079},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3383":68725,"_29651":68701,"_20578":114081,"_5":14121,"_26960":114009,"_2870":114082},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3383":68726,"_29651":68701,"_20578":114084,"_5":14121,"_26960":114009,"_2870":114085},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3383":68727,"_29651":68701,"_20578":114087,"_5":14121,"_26960":114009,"_2870":114088},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3383":68728,"_29651":68701,"_20578":114090,"_5":14121,"_26960":114013,"_2870":114091},[],"Necesitas:",{"_3383":68729,"_29651":68701,"_20578":114093,"_5":14121,"_26960":114013,"_2870":114094},[],"un clúster Kubernetes existente",{"_3383":68730,"_29651":68701,"_20578":114096,"_5":14121,"_26960":114013,"_2870":114097},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3383":68731,"_29651":68701,"_20578":114099,"_5":14121,"_26960":114013,"_2870":48626},[],{"_3383":68732,"_29651":68701,"_20578":114101,"_5":14121,"_26960":114013,"_2870":23259},[],{"_3383":68733,"_29651":68701,"_20578":114103,"_5":14121,"_26960":114013,"_2870":114104},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3383":68734,"_29651":68701,"_20578":114106,"_5":14121,"_26960":114013,"_2870":114107},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3383":68735,"_29651":68701,"_20578":114109,"_5":14121,"_26960":114013,"_2870":114110},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3383":68736,"_29651":68701,"_20578":114112,"_5":14121,"_26960":114013,"_2870":114113},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3383":68737,"_29651":68701,"_20578":114115,"_5":14121,"_26960":114013,"_2870":114116},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3383":68738,"_29651":68701,"_20578":114118,"_5":14121,"_26960":114017,"_2870":114119},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3383":68739,"_29651":68701,"_20578":114121,"_5":14121,"_26960":114017,"_2870":114122},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3383":68740,"_29651":68701,"_20578":114124,"_5":14121,"_26960":114021,"_2870":114125},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3383":68741,"_29651":68701,"_20578":114127,"_5":14121,"_26960":114021,"_2870":114128},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3383":68742,"_29651":68701,"_20578":114130,"_5":14121,"_26960":114021,"_2870":114131},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3383":68743,"_29651":68701,"_20578":114133,"_5":14121,"_26960":114021,"_2870":114134},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3383":68744,"_29651":68701,"_20578":114136,"_5":14121,"_26960":114025,"_2870":114137},[],"Opción",{"_3383":68745,"_29651":68701,"_20578":114139,"_5":14121,"_26960":114025,"_2870":114140},[],"Valor predeterminado",{"_3383":68746,"_29651":68701,"_20578":114142,"_5":14121,"_26960":114025,"_2870":114143},[],"Propósito",{"_3383":68747,"_29651":68701,"_20578":114145,"_5":14121,"_26960":114025,"_2870":48673},[],{"_3383":68748,"_29651":68701,"_20578":114147,"_5":14121,"_26960":114025,"_2870":48676},[],{"_3383":68749,"_29651":68701,"_20578":114149,"_5":14121,"_26960":114025,"_2870":114150},[],"Muestra la ayuda",{"_3383":68750,"_29651":68701,"_20578":114152,"_5":14121,"_26960":114025,"_2870":48682},[],{"_3383":68751,"_29651":68701,"_20578":114154,"_5":14121,"_26960":114025,"_2870":114155},[],"contexto actual",{"_3383":68752,"_29651":68701,"_20578":114157,"_5":14121,"_26960":114025,"_2870":114158},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3383":68753,"_29651":68701,"_20578":114160,"_5":14121,"_26960":114025,"_2870":48691},[],{"_3383":68754,"_29651":68701,"_20578":114162,"_5":14121,"_26960":114025,"_2870":6408},[],{"_3383":68755,"_29651":68701,"_20578":114164,"_5":14121,"_26960":114025,"_2870":114165},[],"Omite prompts y genera credenciales para las dependencias",{"_3383":68756,"_29651":68701,"_20578":114167,"_5":14121,"_26960":114025,"_2870":48699},[],{"_3383":68757,"_29651":68701,"_20578":114169,"_5":14121,"_26960":114025,"_2870":48702},[],{"_3383":68758,"_29651":68701,"_20578":114171,"_5":14121,"_26960":114025,"_2870":114172},[],"Namespace de la instalación",{"_3383":68759,"_29651":68701,"_20578":114174,"_5":14121,"_26960":114025,"_2870":48708},[],{"_3383":68760,"_29651":68701,"_20578":114176,"_5":14121,"_26960":114025,"_2870":48711},[],{"_3383":68761,"_29651":68701,"_20578":114178,"_5":14121,"_26960":114025,"_2870":114179},[],"Dominio usado por la UI, OIDC y el certificado",{"_3383":68762,"_29651":68701,"_20578":114181,"_5":14121,"_26960":114025,"_2870":48717},[],{"_3383":68763,"_29651":68701,"_20578":114183,"_5":14121,"_26960":114025,"_2870":14807},[],{"_3383":68764,"_29651":68701,"_20578":114185,"_5":14121,"_26960":114025,"_2870":114186},[],"Versión del chart de Lamassu",{"_3383":68765,"_29651":68701,"_20578":114188,"_5":14121,"_26960":114025,"_2870":48725},[],{"_3383":68766,"_29651":68701,"_20578":114190,"_5":14121,"_26960":114025,"_2870":48728},[],{"_3383":68767,"_29651":68701,"_20578":114192,"_5":14121,"_26960":114025,"_2870":114193},[],"Puerto del listener HTTPS",{"_3383":68768,"_29651":68701,"_20578":114195,"_5":14121,"_26960":114025,"_2870":48734},[],{"_3383":68769,"_29651":68701,"_20578":114197,"_5":14121,"_26960":114025,"_2870":48737},[],{"_3383":68770,"_29651":68701,"_20578":114199,"_5":14121,"_26960":114025,"_2870":114200},[],"Puerto del listener HTTP",{"_3383":68771,"_29651":68701,"_20578":114202,"_5":14121,"_26960":114025,"_2870":48743},[],{"_3383":68772,"_29651":68701,"_20578":114204,"_5":14121,"_26960":114025,"_2870":48676},[],{"_3383":68773,"_29651":68701,"_20578":114206,"_5":14121,"_26960":114025,"_2870":114207},[],"Certificado PEM para TLS downstream",{"_3383":68774,"_29651":68701,"_20578":114209,"_5":14121,"_26960":114025,"_2870":48751},[],{"_3383":68775,"_29651":68701,"_20578":114211,"_5":14121,"_26960":114025,"_2870":48676},[],{"_3383":68776,"_29651":68701,"_20578":114213,"_5":14121,"_26960":114025,"_2870":114214},[],"Clave privada PEM para TLS downstream",{"_3383":68777,"_29651":68701,"_20578":114216,"_5":14121,"_26960":114025,"_2870":48759},[],{"_3383":68778,"_29651":68701,"_20578":114218,"_5":14121,"_26960":114025,"_2870":114219},[],"chart del repositorio",{"_3383":68779,"_29651":68701,"_20578":114221,"_5":14121,"_26960":114025,"_2870":114222},[],"Usa un chart local de Lamassu sin empaquetar",{"_3383":68780,"_29651":68701,"_20578":114224,"_5":14121,"_26960":114025,"_2870":48768},[],{"_3383":68781,"_29651":68701,"_20578":114226,"_5":14121,"_26960":114025,"_2870":114227},[],"detección automática",{"_3383":68782,"_29651":68701,"_20578":114229,"_5":14121,"_26960":114025,"_2870":114230},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3383":68783,"_29651":68701,"_20578":114232,"_5":14121,"_26960":114025,"_2870":48776},[],{"_3383":68784,"_29651":68701,"_20578":114234,"_5":14121,"_26960":114025,"_2870":6408},[],{"_3383":68785,"_29651":68701,"_20578":114236,"_5":14121,"_26960":114025,"_2870":114237},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3383":68786,"_29651":68701,"_20578":114239,"_5":14121,"_26960":114025,"_2870":48784},[],{"_3383":68787,"_29651":68701,"_20578":114241,"_5":14121,"_26960":114025,"_2870":6408},[],{"_3383":68788,"_29651":68701,"_20578":114243,"_5":14121,"_26960":114025,"_2870":114244},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3383":68789,"_29651":68701,"_20578":114246,"_5":14121,"_26960":114025,"_2870":48792},[],{"_3383":68790,"_29651":68701,"_20578":114248,"_5":14121,"_26960":114025,"_2870":6408},[],{"_3383":68791,"_29651":68701,"_20578":114250,"_5":14121,"_26960":114025,"_2870":114251},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3383":68792,"_29651":68701,"_20578":114253,"_5":14121,"_26960":114025,"_2870":48800},[],{"_3383":68793,"_29651":68701,"_20578":114255,"_5":14121,"_26960":114025,"_2870":6408},[],{"_3383":68794,"_29651":68701,"_20578":114257,"_5":14121,"_26960":114025,"_2870":114258},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3383":68795,"_29651":68701,"_20578":114260,"_5":14121,"_26960":114025,"_2870":48808},[],{"_3383":68796,"_29651":68701,"_20578":114262,"_5":14121,"_26960":114025,"_2870":48811},[],{"_3383":68797,"_29651":68701,"_20578":114264,"_5":14121,"_26960":114025,"_2870":114265},[],"Usa otro chart local de SoftHSM",{"_3383":68798,"_29651":68701,"_20578":114267,"_5":14121,"_26960":114025,"_2870":114268},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3383":68799,"_29651":68701,"_20578":114270,"_5":14121,"_26960":114029,"_2870":114271},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3383":68800,"_29651":68701,"_20578":114273,"_5":14121,"_26960":114029,"_2870":114274},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3383":68801,"_29651":68701,"_20578":114276,"_5":14121,"_26960":114029,"_2870":114277},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3383":68802,"_29651":68701,"_20578":114279,"_5":14121,"_26960":114029,"_2870":114280},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3383":68803,"_29651":68701,"_20578":114282,"_5":14121,"_26960":114029,"_2870":114283},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3383":68804,"_29651":68701,"_20578":114285,"_5":14121,"_26960":114029,"_2870":114286},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3383":68805,"_29651":68701,"_20578":114288,"_5":14121,"_26960":114033,"_2870":48838},[],{"_3383":68806,"_29651":68701,"_20578":114290,"_5":14121,"_26960":114033,"_2870":114291},[],"valida las herramientas locales y el clúster seleccionado",{"_3383":68807,"_29651":68701,"_20578":114293,"_5":14121,"_26960":114033,"_2870":114294},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3383":68808,"_29651":68701,"_20578":114296,"_5":14121,"_26960":114033,"_2870":114297},[],"crea el namespace",{"_3383":68809,"_29651":68701,"_20578":114299,"_5":14121,"_26960":114033,"_2870":114300},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3383":68810,"_29651":68701,"_20578":114302,"_5":14121,"_26960":114033,"_2870":114303},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3383":68811,"_29651":68701,"_20578":114305,"_5":14121,"_26960":114033,"_2870":114306},[],"instala RabbitMQ",{"_3383":68812,"_29651":68701,"_20578":114308,"_5":14121,"_26960":114033,"_2870":114309},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3383":68813,"_29651":68701,"_20578":114311,"_5":14121,"_26960":114033,"_2870":114312},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_3383":68814,"_29651":68701,"_20578":114314,"_5":14121,"_26960":114033,"_2870":114315},[],"carga datos de ejemplo opcionalmente",{"_3383":68815,"_29651":68701,"_20578":114317,"_5":14121,"_26960":114033,"_2870":114318},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3383":68816,"_29651":68701,"_20578":114320,"_5":14121,"_26960":114037,"_2870":114321},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3383":68817,"_29651":68701,"_20578":114323,"_5":14121,"_26960":114037,"_2870":114324},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3383":68818,"_29651":68701,"_20578":114326,"_5":14121,"_26960":114041,"_2870":114327},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3383":68819,"_29651":68701,"_20578":114329,"_5":14121,"_26960":114041,"_2870":114330},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_3383":68820,"_29651":68701,"_20578":114332,"_5":14121,"_26960":114041,"_2870":114333},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3383":68821,"_29651":68701,"_20578":114335,"_5":14121,"_26960":114045,"_2870":114336},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3383":68822,"_29651":68822,"_5":14473,"_2870":114338,"_30004":114339,"_20578":114340,"_26960":68822},"Instala con Helm",[48280,113764,113998],[],{"_3383":68823,"_29651":68822,"_20578":114342,"_5":14121,"_26960":68822,"_2870":114343},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3383":68824,"_29651":68822,"_5":30001,"_20578":114345,"_26960":114346,"_2870":114347},[],"/docs/pr-preview/pr-55/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3383":68825,"_29651":68822,"_5":30001,"_20578":114349,"_26960":114350,"_2870":114014},[],"/docs/pr-preview/pr-55/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3383":68826,"_29651":68822,"_5":30001,"_20578":114352,"_26960":114353,"_2870":114354},[],"/docs/pr-preview/pr-55/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3383":68827,"_29651":68822,"_5":30001,"_20578":114356,"_26960":114357,"_2870":114358},[],"/docs/pr-preview/pr-55/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3383":68828,"_29651":68822,"_5":30001,"_20578":114360,"_26960":114361,"_2870":114362},[],"/docs/pr-preview/pr-55/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3383":68829,"_29651":68822,"_5":30001,"_20578":114364,"_26960":114365,"_2870":114366},[],"/docs/pr-preview/pr-55/es/deployment/self-hosted/helm#tls-de-amqp-amqps","TLS de AMQP (AMQPS)",{"_3383":68830,"_29651":68822,"_5":30001,"_20578":114368,"_26960":114369,"_2870":114370},[],"/docs/pr-preview/pr-55/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3383":68831,"_29651":68822,"_5":30001,"_20578":114372,"_26960":114373,"_2870":114374},[],"/docs/pr-preview/pr-55/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3383":68832,"_29651":68822,"_5":30001,"_20578":114376,"_26960":114377,"_2870":114378},[],"/docs/pr-preview/pr-55/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3383":68833,"_29651":68822,"_5":30001,"_20578":114380,"_26960":114381,"_2870":114382},[],"/docs/pr-preview/pr-55/es/deployment/self-hosted/helm#actualiza-lamassu","Actualiza Lamassu",{"_3383":68834,"_29651":68822,"_5":30001,"_20578":114384,"_26960":114385,"_2870":114386},[],"/docs/pr-preview/pr-55/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3383":68835,"_29651":68822,"_20578":114388,"_5":14121,"_26960":114346,"_2870":114389},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3383":68836,"_29651":68822,"_20578":114391,"_5":14121,"_26960":114350,"_2870":114392},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3383":68837,"_29651":68822,"_20578":114394,"_5":14121,"_26960":114350,"_2870":114395},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3383":68838,"_29651":68822,"_20578":114397,"_5":14121,"_26960":114350,"_2870":114398},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3383":68839,"_29651":68822,"_20578":114400,"_5":14121,"_26960":114350,"_2870":114401},[],"un broker RabbitMQ accesible y sus credenciales",{"_3383":68840,"_29651":68822,"_20578":114403,"_5":14121,"_26960":114350,"_2870":114404},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3383":68841,"_29651":68822,"_20578":114406,"_5":14121,"_26960":114350,"_2870":114407},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3383":68842,"_29651":68822,"_20578":114409,"_5":14121,"_26960":114350,"_2870":114410},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3383":68843,"_29651":68822,"_20578":114412,"_5":14121,"_26960":114350,"_2870":114413},[],"una StorageClass y un diseño de tráfico externo",{"_3383":68844,"_29651":68822,"_20578":114415,"_5":14121,"_26960":114350,"_2870":114416},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3383":68845,"_29651":68822,"_20578":114418,"_5":14121,"_26960":114350,"_2870":114419},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3383":68846,"_29651":68822,"_20578":114421,"_5":14121,"_26960":114350,"_2870":114422},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3383":68847,"_29651":68822,"_20578":114424,"_5":14121,"_26960":114353,"_2870":114425},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3383":68848,"_29651":68822,"_20578":114427,"_5":14121,"_26960":114353,"_2870":114428},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3383":68849,"_29651":68822,"_20578":114430,"_5":14121,"_26960":114353,"_2870":114431},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_3383":68850,"_29651":68822,"_20578":114433,"_5":14121,"_26960":114357,"_2870":114434},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3383":68851,"_29651":68822,"_20578":114436,"_5":14121,"_26960":114357,"_2870":114437},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3383":68852,"_29651":68822,"_20578":114439,"_5":14121,"_26960":114357,"_2870":114440},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3383":68853,"_29651":68822,"_20578":114442,"_5":14121,"_26960":114357,"_2870":114443},[],"Si tu archivo de valores aún contiene los ajustes heredados de validación JWT del Gateway — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` o `auth.authorization.roles.admin` — elimínalos. La guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documenta su eliminación sin alias de compatibilidad, y `values.schema.json` rechaza los bloques residuales en lugar de ignorarlos silenciosamente. Los reemplazos son `services.authz.jwkUrl` y `services.authz.bootstrap`, que ya aparecen en el ejemplo anterior.",{"_3383":68854,"_29651":68822,"_20578":114445,"_5":14121,"_26960":114361,"_2870":114446},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_3383":68855,"_29651":68822,"_20578":114448,"_5":14121,"_26960":114365,"_2870":114449},[],"`amqp.tls: true` selecciona AMQPS en todos los bloques de configuración del bus de eventos. El puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS, así que define `amqp.port` con el listener TLS del broker, normalmente `5671`.",{"_3383":68856,"_29651":68822,"_20578":114451,"_5":14121,"_26960":114365,"_2870":114452},[],"Sin un Secret de CA configurado, los clientes del bus de eventos usan las CA de confianza del sistema. Para confiar en una CA privada, crea un Secret en el namespace del release con el certificado de la CA en formato PEM y define `amqp.ca.secretName` (y `amqp.ca.certificateKey` si la clave de datos no es `ca.crt`).",{"_3383":68857,"_29651":68822,"_20578":114454,"_5":14121,"_26960":114365,"_2870":114455},[],"Para brokers que exijan TLS mutuo, crea un Secret con el certificado de cliente y su clave privada y define `amqp.client.secretName` (con `amqp.client.certificateKey` y `amqp.client.privateKeyKey` si las claves de datos no son `tls.crt` y `tls.key`).",{"_3383":68858,"_29651":68822,"_20578":114457,"_5":14121,"_26960":114365,"_2870":114458},[],"El chart monta los Secrets configurados en modo de solo lectura en todas las cargas de trabajo que consumen AMQP: el certificado de la CA en `/etc/lamassu/amqp/ca` y el certificado y la clave de cliente en `/etc/lamassu/amqp/client`. Los nombres de los archivos montados son siempre `ca.crt`, `tls.crt` y `tls.key` — los valores `certificateKey` y `privateKeyKey` renombran solo las claves de datos del Secret, nunca las rutas en disco. La clave privada del cliente se monta con permisos restrictivos (`defaultMode: 0440`; el volumen de la CA usa `0444`), que funcionan porque el chart añade `fsGroup` al security context del pod cuando `amqp.client.secretName` está definido — usa el `runAsGroup` del contenedor (por defecto `65532`) cuando `fsGroup` no está ya definido.",{"_3383":68859,"_29651":68822,"_20578":114460,"_5":14121,"_26960":114365,"_2870":114461},[],"Ambas opciones de Secret exigen `amqp.tls: true`: `values.schema.json` rechaza un `secretName` no vacío cuando `tls` es false, rechaza claves desconocidas y rechaza nombres de clave de datos fuera de `^[A-Za-z0-9._-]+$`. El Secret referenciado debe existir en el namespace del release o los pods consumidores no llegan a arrancar.",{"_3383":68860,"_29651":68822,"_20578":114463,"_5":14121,"_26960":114365,"_2870":114464},[],"El cliente AMQP carga los certificados al arrancar, así que reinicia los pods consumidores tras actualizar cualquiera de los dos Secrets. Cambiar cualquier valor de `amqp` reinicia las cargas de trabajo consumidoras mediante la anotación `checksum/config`, pero cambiar solo el contenido de un Secret no desencadena un rollout.",{"_3383":68861,"_29651":68822,"_20578":114466,"_5":14121,"_26960":114365,"_2870":114467},[],"Según la guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: en 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos usaban AMQP en claro; desde 4.0.0, `amqp.tls: true` los cambia a AMQPS. Define `amqp.port` con el listener TLS del broker antes del upgrade, o usa `amqp.tls: false` para mantener AMQP en claro. `amqp.tls: false` envía las credenciales del broker y todo el tráfico del bus de eventos en claro.",{"_3383":68862,"_29651":68822,"_20578":114469,"_5":14121,"_26960":114369,"_2870":114470},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3383":68863,"_29651":68822,"_20578":114472,"_5":14121,"_26960":114369,"_2870":114473},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3383":68864,"_29651":68822,"_20578":114475,"_5":14121,"_26960":114369,"_2870":114476},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3383":68865,"_29651":68822,"_20578":114478,"_5":14121,"_26960":114369,"_2870":114479},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3383":68866,"_29651":68822,"_20578":114481,"_5":14121,"_26960":114373,"_2870":114482},[],"Para instalar un checkout local:",{"_3383":68867,"_29651":68822,"_20578":114484,"_5":14121,"_26960":114377,"_2870":114485},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3383":68868,"_29651":68822,"_20578":114487,"_5":14121,"_26960":114377,"_2870":114488},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3383":68869,"_29651":68822,"_20578":114490,"_5":14121,"_26960":114381,"_2870":114491},[],"Los pasos de upgrade específicos de cada versión se mantienen en `charts/lamassu/CHANGELOG/` dentro del repositorio Helm. El chart también incluye un job de pre-upgrade opcional que migra las claves privadas de CA existentes al motor KMS configurado para el release. Está desactivado por defecto (`migrations.caToKms.enabled: false`) y solo es necesario cuando actualizas desde una versión anterior a 3.7.0.",{"_3383":68870,"_29651":68822,"_20578":114493,"_5":14121,"_26960":114381,"_2870":114494},[],"Mientras el flag esté activo, cada `helm upgrade` crea el job `<chart fullname>-ca-to-kms-migration` (`lamassu-ca-to-kms-migration` para el release `lamassu`); una instalación nueva no lo crea. Su hook weight es `-10`, por lo que se ejecuta antes de los otros hooks de pre-upgrade: la configuración de bootstrap de autorización (peso `-4`) y el job de migración de base de datos (peso `-3`).",{"_3383":68871,"_29651":68822,"_20578":114496,"_5":14121,"_26960":114381,"_2870":114497},[],"El job consume la misma configuración del servicio KMS que el chart renderiza en el ConfigMap de KMS, incluidos los motores de `services.kms.cryptoEngines`, y ejecuta la imagen de la herramienta de migración definida en `migrations.caToKms.image`. La monta en modo read-only en `/etc/lamassuiot/config.yml` desde la clave `config` del ConfigMap, así que configura el motor de destino en tus valores antes del upgrade que realiza la migración.",{"_3383":68872,"_29651":68822,"_20578":114499,"_5":14121,"_26960":114381,"_2870":114500},[],"El job resuelve su configuración mediante un volumen proyectado con dos fuentes opcionales: el ConfigMap `<chart fullname>-kms-config`, cuyo nombre incorpora el release (`lamassu-kms-config` para el release `lamassu`, `prod-lamassu-kms-config` para el release `prod`), y el ConfigMap legacy `kms-config`, sin el nombre del release, creado por versiones anteriores del chart. La configuración legacy mantiene la autoridad mientras siga presente y el job usa el ConfigMap del release una vez el legacy desaparece. Ambas fuentes son opcionales, por lo que un ConfigMap ausente nunca deja el pod del upgrade en `ContainerCreating`.",{"_3383":68873,"_29651":68822,"_20578":114502,"_5":14121,"_26960":114381,"_2870":114503},[],"Mantén `migrations.caToKms.enabled: true` en el upgrade que realiza la migración y elimina después el flag de tus valores una vez completada la migración; su valor por defecto es `false`.",{"_3383":68874,"_29651":68822,"_20578":114505,"_5":14121,"_26960":114385,"_2870":114506},[],"Antes de pasar a producción, revisa:",{"_3383":68875,"_29651":68822,"_20578":114508,"_5":14121,"_26960":114385,"_2870":114509},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3383":68876,"_29651":68822,"_20578":114511,"_5":14121,"_26960":114385,"_2870":114512},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3383":68877,"_29651":68822,"_20578":114514,"_5":14121,"_26960":114385,"_2870":114515},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3383":68878,"_29651":68822,"_20578":114517,"_5":14121,"_26960":114385,"_2870":114518},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3383":68879,"_29651":68822,"_20578":114520,"_5":14121,"_26960":114385,"_2870":114521},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3383":68880,"_29651":68822,"_20578":114523,"_5":14121,"_26960":114385,"_2870":114524},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3383":68881,"_29651":68822,"_20578":114526,"_5":14121,"_26960":114385,"_2870":114527},[],"SMTP, observabilidad y entrega de alertas",{"_3383":68882,"_29651":68822,"_20578":114529,"_5":14121,"_26960":114385,"_2870":114530},[],"las guías de actualización entre versiones y las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade, incluido el hook opcional de migración CA-to-KMS descrito arriba",{"_3383":68883,"_29651":68822,"_20578":114532,"_5":14121,"_26960":114385,"_2870":114533},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3383":68884,"_29651":68884,"_5":14473,"_2870":114535,"_30004":114536,"_20578":114537,"_26960":68884},"Expón el Gateway",[48280,113764,113998],[],{"_3383":68885,"_29651":68884,"_20578":114539,"_5":14121,"_26960":68884,"_2870":114540},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3383":68886,"_29651":68884,"_5":30001,"_20578":114542,"_26960":114543,"_2870":114544},[],"/docs/pr-preview/pr-55/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3383":68887,"_29651":68884,"_5":30001,"_20578":114546,"_26960":114547,"_2870":114548},[],"/docs/pr-preview/pr-55/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3383":68888,"_29651":68884,"_5":30001,"_20578":114550,"_26960":114551,"_2870":114552},[],"/docs/pr-preview/pr-55/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3383":68889,"_29651":68884,"_5":30001,"_20578":114554,"_26960":114555,"_2870":49106},[],"/docs/pr-preview/pr-55/es/deployment/self-hosted/networking#k3s",{"_3383":68890,"_29651":68884,"_5":30001,"_20578":114557,"_26960":114558,"_2870":114559},[],"/docs/pr-preview/pr-55/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3383":68891,"_29651":68884,"_5":30001,"_20578":114561,"_26960":114562,"_2870":114563},[],"/docs/pr-preview/pr-55/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3383":68892,"_29651":68884,"_5":30001,"_20578":114565,"_26960":114566,"_2870":114567},[],"/docs/pr-preview/pr-55/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3383":68893,"_29651":68884,"_5":30001,"_20578":114569,"_26960":114570,"_2870":114571},[],"/docs/pr-preview/pr-55/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3383":68894,"_29651":68884,"_5":30001,"_20578":114573,"_26960":114574,"_2870":114575},[],"/docs/pr-preview/pr-55/es/deployment/self-hosted/networking#proxy-de-salida","Proxy de salida",{"_3383":68895,"_29651":68884,"_5":30001,"_20578":114577,"_26960":114578,"_2870":114579},[],"/docs/pr-preview/pr-55/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3383":68896,"_29651":68884,"_20578":114581,"_5":14121,"_26960":114543,"_2870":114582},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3383":68897,"_29651":68884,"_20578":114584,"_5":14121,"_26960":114543,"_2870":114585},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3383":68898,"_29651":68884,"_20578":114587,"_5":14121,"_26960":114547,"_2870":114588},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3383":68899,"_29651":68884,"_20578":114590,"_5":14121,"_26960":114547,"_2870":114591},[],"Defínelo únicamente cuando:",{"_3383":68900,"_29651":68884,"_20578":114593,"_5":14121,"_26960":114547,"_2870":114594},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3383":68901,"_29651":68884,"_20578":114596,"_5":14121,"_26960":114547,"_2870":114597},[],"esa dirección está asignada a este Gateway",{"_3383":68902,"_29651":68884,"_20578":114599,"_5":14121,"_26960":114547,"_2870":114600},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3383":68903,"_29651":68884,"_20578":114602,"_5":14121,"_26960":114547,"_2870":114603},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3383":68904,"_29651":68884,"_20578":114605,"_5":14121,"_26960":114547,"_2870":114606},[],"No confundas estos valores:",{"_3383":68905,"_29651":68884,"_20578":114608,"_5":14121,"_26960":114547,"_2870":114609},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3383":68906,"_29651":68884,"_20578":114611,"_5":14121,"_26960":114547,"_2870":114612},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3383":68907,"_29651":68884,"_20578":114614,"_5":14121,"_26960":114547,"_2870":114615},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3383":68908,"_29651":68884,"_20578":114617,"_5":14121,"_26960":114551,"_2870":114618},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3383":68909,"_29651":68884,"_20578":114620,"_5":14121,"_26960":114551,"_2870":114621},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3383":68910,"_29651":68884,"_20578":114623,"_5":14121,"_26960":114555,"_2870":114624},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3383":68911,"_29651":68884,"_20578":114626,"_5":14121,"_26960":114555,"_2870":114627},[],"Para el diseño recomendado:",{"_3383":68912,"_29651":68884,"_20578":114629,"_5":14121,"_26960":114555,"_2870":114630},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3383":68913,"_29651":68884,"_20578":114632,"_5":14121,"_26960":114555,"_2870":114633},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3383":68914,"_29651":68884,"_20578":114635,"_5":14121,"_26960":114555,"_2870":114636},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3383":68915,"_29651":68884,"_20578":114638,"_5":14121,"_26960":114555,"_2870":114639},[],"Apunta DNS a la dirección accesible de la VM.",{"_3383":68916,"_29651":68884,"_20578":114641,"_5":14121,"_26960":114555,"_2870":114642},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3383":68917,"_29651":68884,"_20578":114644,"_5":14121,"_26960":114558,"_2870":114645},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3383":68918,"_29651":68884,"_20578":114647,"_5":14121,"_26960":114562,"_2870":114648},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3383":68919,"_29651":68884,"_20578":114650,"_5":14121,"_26960":114562,"_2870":114651},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3383":68920,"_29651":68884,"_20578":114653,"_5":14121,"_26960":114566,"_2870":114654},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3383":68921,"_29651":68884,"_20578":114656,"_5":14121,"_26960":114566,"_2870":114657},[],"Requisito",{"_3383":68922,"_29651":68884,"_20578":114659,"_5":14121,"_26960":114566,"_2870":114660},[],"Diseño recomendado",{"_3383":68923,"_29651":68884,"_20578":114662,"_5":14121,"_26960":114566,"_2870":114663},[],"Consecuencia",{"_3383":68924,"_29651":68884,"_20578":114665,"_5":14121,"_26960":114566,"_2870":114666},[],"Varias URL o servicios de Lamassu",{"_3383":68925,"_29651":68884,"_20578":114668,"_5":14121,"_26960":114566,"_2870":114669},[],"Un Gateway con varias rutas",{"_3383":68926,"_29651":68884,"_20578":114671,"_5":14121,"_26960":114566,"_2870":114672},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3383":68927,"_29651":68884,"_20578":114674,"_5":14121,"_26960":114566,"_2870":114675},[],"Gateways independientes e IP externas distintas",{"_3383":68928,"_29651":68884,"_20578":114677,"_5":14121,"_26960":114566,"_2870":114678},[],"Una VIP por Gateway",{"_3383":68929,"_29651":68884,"_20578":114680,"_5":14121,"_26960":114566,"_2870":114681},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3383":68930,"_29651":68884,"_20578":114683,"_5":14121,"_26960":114566,"_2870":114684},[],"Gateways independientes, un nodo y una IP",{"_3383":68931,"_29651":68884,"_20578":114686,"_5":14121,"_26960":114566,"_2870":114687},[],"Puertos externos diferentes",{"_3383":68932,"_29651":68884,"_20578":114689,"_5":14121,"_26960":114566,"_2870":114690},[],"Los clientes deben indicar puertos no estándar",{"_3383":68933,"_29651":68884,"_20578":114692,"_5":14121,"_26960":114566,"_2870":114693},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3383":68934,"_29651":68884,"_20578":114695,"_5":14121,"_26960":114566,"_2870":114696},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3383":68935,"_29651":68884,"_20578":114698,"_5":14121,"_26960":114566,"_2870":114699},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3383":68936,"_29651":68884,"_20578":114701,"_5":14121,"_26960":114566,"_2870":114702},[],"Recursos Gateway separados pero proxy compartido",{"_3383":68937,"_29651":68884,"_20578":114704,"_5":14121,"_26960":114566,"_2870":114705},[],"Modo merged Gateway de Envoy",{"_3383":68938,"_29651":68884,"_20578":114707,"_5":14121,"_26960":114566,"_2870":114708},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3383":68939,"_29651":68884,"_20578":114710,"_5":14121,"_26960":114566,"_2870":114711},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3383":68940,"_29651":68884,"_20578":114713,"_5":14121,"_26960":114566,"_2870":114714},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3383":68941,"_29651":68884,"_20578":114716,"_5":14121,"_26960":114566,"_2870":114717},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3383":68942,"_29651":68884,"_20578":114719,"_5":14121,"_26960":114566,"_2870":114720},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3383":68943,"_29651":68884,"_20578":114722,"_5":14121,"_26960":114570,"_2870":114723},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3383":68944,"_29651":68884,"_20578":114725,"_5":14121,"_26960":114570,"_2870":114726},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3383":68945,"_29651":68884,"_20578":114728,"_5":14121,"_26960":114570,"_2870":114729},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3383":68946,"_29651":68884,"_20578":114731,"_5":14121,"_26960":114570,"_2870":114732},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3383":68947,"_29651":68884,"_20578":114734,"_5":14121,"_26960":114570,"_2870":114735},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3383":68948,"_29651":68884,"_20578":114737,"_5":14121,"_26960":114574,"_2870":114738},[],"Los clientes internos de Lamassu — la conexión con el motor de Vault, las llamadas entre servicios y los webhooks salientes — respetan las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY`. La excepción es el conector del motor de autorización: usa su propio transporte y no consulta estas variables de proxy. Si tu despliegue enruta el tráfico de salida por un proxy, incluye los nombres de servicio internos del clúster en `NO_PROXY` (por ejemplo `.svc,.cluster.local`) para que el tráfico interno permanezca dentro del clúster. El tráfico de loopback nunca se envía por un proxy.",{"_3383":68949,"_29651":68884,"_20578":114740,"_5":14121,"_26960":114574,"_2870":114741},[],"El transporte predeterminado de estos clientes acota el timeout de conexión (30 segundos), el handshake TLS (10 segundos) y la reutilización de conexiones inactivas (90 segundos), de modo que una dependencia inalcanzable falla rápido en lugar de bloquearse; estos valores son los predeterminados del transporte de Go, no configuración de Lamassu. HTTP/2 se negocia cuando el otro extremo lo soporta. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada.",{"_3383":68950,"_29651":68884,"_20578":114743,"_5":14121,"_26960":114578,"_2870":114744},[],"Comprueba, en orden:",{"_3383":68951,"_29651":68884,"_20578":114746,"_5":14121,"_26960":114578,"_2870":114747},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3383":68952,"_29651":68884,"_20578":114749,"_5":14121,"_26960":114578,"_2870":114750},[],"Su estado contiene la dirección esperada.",{"_3383":68953,"_29651":68884,"_20578":114752,"_5":14121,"_26960":114578,"_2870":114753},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3383":68954,"_29651":68884,"_20578":114755,"_5":14121,"_26960":114578,"_2870":114756},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3383":68955,"_29651":68884,"_20578":114758,"_5":14121,"_26960":114578,"_2870":114759},[],"DNS resuelve al endpoint accesible externamente.",{"_3383":68956,"_29651":68884,"_20578":114761,"_5":14121,"_26960":114578,"_2870":114762},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3383":68957,"_29651":68884,"_20578":114764,"_5":14121,"_26960":114578,"_2870":114765},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3383":68958,"_29651":68958,"_5":14473,"_2870":48387,"_30004":114767,"_20578":114768,"_26960":68958},[48280,113764,113998],[],{"_3383":68959,"_29651":68958,"_20578":114770,"_5":14121,"_26960":68958,"_2870":114771},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3383":68960,"_29651":68958,"_5":30001,"_20578":114773,"_26960":114774,"_2870":114775},[],"/docs/pr-preview/pr-55/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3383":68961,"_29651":68958,"_5":30001,"_20578":114777,"_26960":114778,"_2870":114779},[],"/docs/pr-preview/pr-55/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3383":68962,"_29651":68958,"_5":30001,"_20578":114781,"_26960":114782,"_2870":114783},[],"/docs/pr-preview/pr-55/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3383":68963,"_29651":68958,"_5":30001,"_20578":114785,"_26960":114786,"_2870":114787},[],"/docs/pr-preview/pr-55/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3383":68964,"_29651":68958,"_5":30001,"_20578":114789,"_26960":114790,"_2870":114791},[],"/docs/pr-preview/pr-55/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3383":68965,"_29651":68958,"_5":30001,"_20578":114793,"_26960":114794,"_2870":114795},[],"/docs/pr-preview/pr-55/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3383":68966,"_29651":68958,"_20578":114797,"_5":14121,"_26960":114774,"_2870":114798},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3383":68967,"_29651":68958,"_20578":114800,"_5":14121,"_26960":114778,"_2870":114801},[],"Flujo",{"_3383":68968,"_29651":68958,"_20578":114803,"_5":14121,"_26960":114778,"_2870":114804},[],"Úsalo para",{"_3383":68969,"_29651":68958,"_20578":114806,"_5":14121,"_26960":114778,"_2870":114807},[],"Qué instala",{"_3383":68970,"_29651":68958,"_20578":114809,"_5":14121,"_26960":114778,"_2870":49361},[],{"_3383":68971,"_29651":68958,"_20578":114811,"_5":14121,"_26960":114778,"_2870":114812},[],"Producción y entornos controlados",{"_3383":68972,"_29651":68958,"_20578":114814,"_5":14121,"_26960":114778,"_2870":114815},[],"Servicios de Lamassu y recursos de Gateway API",{"_3383":68973,"_29651":68958,"_20578":114817,"_5":14121,"_26960":114778,"_2870":48524},[],{"_3383":68974,"_29651":68958,"_20578":114819,"_5":14121,"_26960":114778,"_2870":114820},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3383":68975,"_29651":68958,"_20578":114822,"_5":14121,"_26960":114778,"_2870":114823},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3383":68976,"_29651":68958,"_20578":114825,"_5":14121,"_26960":114782,"_2870":114826},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3383":68977,"_29651":68958,"_20578":114828,"_5":14121,"_26960":114782,"_2870":114829},[],"Área",{"_3383":68978,"_29651":68958,"_20578":114831,"_5":14121,"_26960":114782,"_2870":114832},[],"El chart de Lamassu proporciona",{"_3383":68979,"_29651":68958,"_20578":114834,"_5":14121,"_26960":114782,"_2870":114835},[],"Tú proporcionas",{"_3383":68980,"_29651":68958,"_20578":114837,"_5":14121,"_26960":114782,"_2870":114838},[],"Aplicaciones Lamassu",{"_3383":68981,"_29651":68958,"_20578":114840,"_5":14121,"_26960":114782,"_2870":114841},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3383":68982,"_29651":68958,"_20578":114843,"_5":14121,"_26960":114782,"_2870":114844},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3383":68983,"_29651":68958,"_20578":114846,"_5":14121,"_26960":114782,"_2870":114847},[],"Datos PostgreSQL",{"_3383":68984,"_29651":68958,"_20578":114849,"_5":14121,"_26960":114782,"_2870":114850},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3383":68985,"_29651":68958,"_20578":114852,"_5":14121,"_26960":114782,"_2870":114853},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3383":68986,"_29651":68958,"_20578":114855,"_5":14121,"_26960":114782,"_2870":114856},[],"Mensajería",{"_3383":68987,"_29651":68958,"_20578":114858,"_5":14121,"_26960":114782,"_2870":114859},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu; la conexión puede usar AMQPS, con una CA privada y un certificado de cliente opcionales, definidos mediante valores del chart",{"_3383":68988,"_29651":68958,"_20578":114861,"_5":14121,"_26960":114782,"_2870":114862},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3383":68989,"_29651":68958,"_20578":114864,"_5":14121,"_26960":114782,"_2870":114865},[],"Identidad",{"_3383":68990,"_29651":68958,"_20578":114867,"_5":14121,"_26960":114782,"_2870":114868},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3383":68991,"_29651":68958,"_20578":114870,"_5":14121,"_26960":114782,"_2870":114871},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3383":68992,"_29651":68958,"_20578":114873,"_5":14121,"_26960":114782,"_2870":114874},[],"Enrutamiento externo",{"_3383":68993,"_29651":68958,"_20578":114876,"_5":14121,"_26960":114782,"_2870":114877},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3383":68994,"_29651":68958,"_20578":114879,"_5":14121,"_26960":114782,"_2870":114880},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3383":68995,"_29651":68958,"_20578":114882,"_5":14121,"_26960":114782,"_2870":49435},[],{"_3383":68996,"_29651":68958,"_20578":114884,"_5":14121,"_26960":114782,"_2870":114885},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_3383":68997,"_29651":68958,"_20578":114887,"_5":14121,"_26960":114782,"_2870":114888},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3383":68998,"_29651":68958,"_20578":114890,"_5":14121,"_26960":114782,"_2870":114891},[],"Datos persistentes de la aplicación",{"_3383":68999,"_29651":68958,"_20578":114893,"_5":14121,"_26960":114782,"_2870":114894},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3383":69000,"_29651":68958,"_20578":114896,"_5":14121,"_26960":114782,"_2870":114897},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3383":69001,"_29651":68958,"_20578":114899,"_5":14121,"_26960":114782,"_2870":114900},[],"Integraciones opcionales",{"_3383":69002,"_29651":68958,"_20578":114902,"_5":14121,"_26960":114782,"_2870":114903},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3383":69003,"_29651":68958,"_20578":114905,"_5":14121,"_26960":114782,"_2870":114906},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3383":69004,"_29651":68958,"_20578":114908,"_5":14121,"_26960":114782,"_2870":114909},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3383":69005,"_29651":68958,"_20578":114911,"_5":14121,"_26960":114782,"_2870":114912},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3383":69006,"_29651":68958,"_20578":114914,"_5":14121,"_26960":114786,"_2870":114915},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3383":69007,"_29651":68958,"_20578":114917,"_5":14121,"_26960":114786,"_2870":114918},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3383":69008,"_29651":68958,"_20578":114920,"_5":14121,"_26960":114790,"_2870":114921},[],"Kubernetes 1.24 o posterior",{"_3383":69009,"_29651":68958,"_20578":114923,"_5":14121,"_26960":114790,"_2870":114924},[],"Helm 3.2 o posterior",{"_3383":69010,"_29651":68958,"_20578":114926,"_5":14121,"_26960":114790,"_2870":114927},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3383":69011,"_29651":68958,"_20578":114929,"_5":14121,"_26960":114790,"_2870":114930},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_3383":69012,"_29651":68958,"_20578":114932,"_5":14121,"_26960":114790,"_2870":114933},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3383":69013,"_29651":68958,"_20578":114935,"_5":14121,"_26960":114790,"_2870":114936},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3383":69014,"_29651":68958,"_20578":114938,"_5":14121,"_26960":114790,"_2870":114939},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3383":69015,"_29651":68958,"_20578":114941,"_5":14121,"_26960":114794,"_2870":114942},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3383":69016,"_29651":68958,"_20578":114944,"_5":14121,"_26960":114794,"_2870":114945},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3383":69017,"_29651":68958,"_20578":114947,"_5":14121,"_26960":114794,"_2870":114948},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3383":69018,"_29651":68958,"_20578":114950,"_5":14121,"_26960":114794,"_2870":114951},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3383":69019,"_29651":69019,"_5":14473,"_2870":114953,"_30004":114954,"_20578":114956,"_26960":69019},"Resolución de problemas de despliegue",[48280,113764,114955],"Operación",[],{"_3383":69020,"_29651":69019,"_20578":114958,"_5":14121,"_26960":69019,"_2870":114959},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3383":69021,"_29651":69019,"_5":30001,"_20578":114961,"_26960":114962,"_2870":114963},[],"/docs/pr-preview/pr-55/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3383":69022,"_29651":69019,"_5":30001,"_20578":114965,"_26960":114966,"_2870":114967},[],"/docs/pr-preview/pr-55/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3383":69023,"_29651":69019,"_5":30001,"_20578":114969,"_26960":114970,"_2870":114971},[],"/docs/pr-preview/pr-55/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3383":69024,"_29651":69019,"_5":30001,"_20578":114973,"_26960":114974,"_2870":114975},[],"/docs/pr-preview/pr-55/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3383":69025,"_29651":69019,"_5":30001,"_20578":114977,"_26960":114978,"_2870":114979},[],"/docs/pr-preview/pr-55/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3383":69026,"_29651":69019,"_5":30001,"_20578":114981,"_26960":114982,"_2870":114983},[],"/docs/pr-preview/pr-55/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3383":69027,"_29651":69019,"_5":30001,"_20578":114985,"_26960":114986,"_2870":114987},[],"/docs/pr-preview/pr-55/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3383":69028,"_29651":69019,"_5":30001,"_20578":114989,"_26960":114990,"_2870":114991},[],"/docs/pr-preview/pr-55/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3383":69029,"_29651":69019,"_5":30001,"_20578":114993,"_26960":114994,"_2870":114995},[],"/docs/pr-preview/pr-55/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3383":69030,"_29651":69019,"_5":30001,"_20578":114997,"_26960":114998,"_2870":114999},[],"/docs/pr-preview/pr-55/es/deployment/troubleshooting#errores-500-de-la-api","Errores 500 de la API",{"_3383":69031,"_29651":69019,"_5":30001,"_20578":115001,"_26960":115002,"_2870":115003},[],"/docs/pr-preview/pr-55/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3383":69032,"_29651":69019,"_5":30001,"_20578":115005,"_26960":115006,"_2870":115007},[],"/docs/pr-preview/pr-55/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3383":69033,"_29651":69019,"_5":30001,"_20578":115009,"_26960":115010,"_2870":115011},[],"/docs/pr-preview/pr-55/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3383":69034,"_29651":69019,"_20578":115013,"_5":14121,"_26960":69019,"_2870":115014},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3383":69035,"_29651":69019,"_20578":115016,"_5":14121,"_26960":114966,"_2870":115017},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3383":69036,"_29651":69019,"_20578":115019,"_5":14121,"_26960":114970,"_2870":115020},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3383":69037,"_29651":69019,"_20578":115022,"_5":14121,"_26960":114974,"_2870":115023},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3383":69038,"_29651":69019,"_20578":115025,"_5":14121,"_26960":114978,"_2870":115026},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3383":69039,"_29651":69019,"_20578":115028,"_5":14121,"_26960":114982,"_2870":115029},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3383":69040,"_29651":69019,"_20578":115031,"_5":14121,"_26960":114986,"_2870":115032},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3383":69041,"_29651":69019,"_20578":115034,"_5":14121,"_26960":114986,"_2870":115035},[],"Ejecuta también la prueba de conectividad del chart:",{"_3383":69042,"_29651":69019,"_20578":115037,"_5":14121,"_26960":114986,"_2870":115038},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3383":69043,"_29651":69019,"_20578":115040,"_5":14121,"_26960":114986,"_2870":115041},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3383":69044,"_29651":69019,"_20578":115043,"_5":14121,"_26960":114990,"_2870":115044},[],"Si recibes un 401:",{"_3383":69045,"_29651":69019,"_20578":115046,"_5":14121,"_26960":114990,"_2870":115047},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3383":69046,"_29651":69019,"_20578":115049,"_5":14121,"_26960":114990,"_2870":115050},[],"verifica emisor, audiencia y expiración del token;",{"_3383":69047,"_29651":69019,"_20578":115052,"_5":14121,"_26960":114990,"_2870":115053},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3383":69048,"_29651":69019,"_20578":115055,"_5":14121,"_26960":114990,"_2870":115056},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3383":69049,"_29651":69019,"_20578":115058,"_5":14121,"_26960":114990,"_2870":115059},[],"Si el login termina pero las APIs devuelven 403:",{"_3383":69050,"_29651":69019,"_20578":115061,"_5":14121,"_26960":114990,"_2870":115062},[],"inspecciona los claims reales del token;",{"_3383":69051,"_29651":69019,"_20578":115064,"_5":14121,"_26960":114990,"_2870":115065},[],"confirma que coinciden con un principal activo;",{"_3383":69052,"_29651":69019,"_20578":115067,"_5":14121,"_26960":114990,"_2870":115068},[],"revisa las políticas concedidas al principal;",{"_3383":69053,"_29651":69019,"_20578":115070,"_5":14121,"_26960":114990,"_2870":115071},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3383":69054,"_29651":69019,"_20578":115073,"_5":14121,"_26960":114990,"_2870":115074},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3383":69055,"_29651":69019,"_20578":115076,"_5":14121,"_26960":114994,"_2870":115077},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3383":69056,"_29651":69019,"_20578":115079,"_5":14121,"_26960":114994,"_2870":115080},[],"Localiza el pod y Service de authz.",{"_3383":69057,"_29651":69019,"_20578":115082,"_5":14121,"_26960":114994,"_2870":115083},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3383":69058,"_29651":69019,"_20578":115085,"_5":14121,"_26960":114994,"_2870":115086},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3383":69059,"_29651":69019,"_20578":115088,"_5":14121,"_26960":114994,"_2870":115089},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3383":69060,"_29651":69019,"_20578":115091,"_5":14121,"_26960":114994,"_2870":115092},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3383":69061,"_29651":69019,"_20578":115094,"_5":14121,"_26960":114998,"_2870":115095},[],"Un 500 indica un fallo interno, como una base de datos no disponible. El cuerpo `{\"err\": ...}` incluye hoy el texto del error interno, que puede contener nombres de esquema, tabla y restricción y, en fallos de conexión, el host y el usuario de la base de datos (no la contraseña). Localiza la causa en el log del servicio con la hora de la petición, y no reenvíes el cuerpo a terceros ni lo muestres a usuarios finales. Es un defecto conocido de divulgación de información: está previsto devolver un mensaje genérico en los 500 y dejar el detalle solo en el log del servicio (seguimiento en lamassuiot#814). El conector de autorización también devuelve el error interno, en el campo `details.error`. Algunos errores de petición, como un tamaño de clave que el motor no admite, se devuelven también como 500.",{"_3383":69062,"_29651":69019,"_20578":115097,"_5":14121,"_26960":115002,"_2870":115098},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3383":69063,"_29651":69019,"_20578":115100,"_5":14121,"_26960":115002,"_2870":115101},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3383":69064,"_29651":69019,"_20578":115103,"_5":14121,"_26960":115002,"_2870":115104},[],"un Secret de CA o de certificado de cliente de AMQP inexistente referenciado por `amqp.ca.secretName` o `amqp.client.secretName`;",{"_3383":69065,"_29651":69019,"_20578":115106,"_5":14121,"_26960":115002,"_2870":115107},[],"volumen persistente sin enlazar;",{"_3383":69066,"_29651":69019,"_20578":115109,"_5":14121,"_26960":115002,"_2870":115110},[],"imagen inaccesible o política de pull incorrecta;",{"_3383":69067,"_29651":69019,"_20578":115112,"_5":14121,"_26960":115002,"_2870":115113},[],"configuración inválida del motor criptográfico;",{"_3383":69068,"_29651":69019,"_20578":115115,"_5":14121,"_26960":115002,"_2870":115116},[],"límites de CPU o memoria demasiado bajos;",{"_3383":69069,"_29651":69019,"_20578":115118,"_5":14121,"_26960":115002,"_2870":115119},[],"migración previa incompleta.",{"_3383":69070,"_29651":69019,"_20578":115121,"_5":14121,"_26960":115002,"_2870":115122},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3383":69071,"_29651":69019,"_20578":115124,"_5":14121,"_26960":115002,"_2870":115125},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3383":69072,"_29651":69019,"_20578":115127,"_5":14121,"_26960":115002,"_2870":115128},[],"Las llamadas internas ahora fallan rápido en lugar de bloquearse para los clientes cubiertos por Proxy de salida: los intentos de conexión agotan el tiempo tras 30 segundos y los handshakes TLS tras 10 segundos. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada. Si un proxy de salida gestiona el tráfico de salida del clúster, comprueba las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY` del pod e incluye los nombres de servicio internos en `NO_PROXY`.",{"_3383":69073,"_29651":69019,"_20578":115130,"_5":14121,"_26960":115006,"_2870":115131},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3383":69074,"_29651":69019,"_20578":115133,"_5":14121,"_26960":115006,"_2870":115134},[],"verifica que esté habilitado en el servicio emisor;",{"_3383":69075,"_29651":69019,"_20578":115136,"_5":14121,"_26960":115006,"_2870":115137},[],"comprueba conectividad y credenciales AMQP;",{"_3383":69076,"_29651":69019,"_20578":115139,"_5":14121,"_26960":115006,"_2870":115140},[],"revisa exchange, routing key, colas y consumidores;",{"_3383":69077,"_29651":69019,"_20578":115142,"_5":14121,"_26960":115006,"_2870":115143},[],"inspecciona dead-letter queues;",{"_3383":69078,"_29651":69019,"_20578":115145,"_5":14121,"_26960":115006,"_2870":115146},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3383":69079,"_29651":69019,"_20578":115148,"_5":14121,"_26960":115006,"_2870":115149},[],"Si `amqp.tls` está habilitado, revisa también la parte TLS:",{"_3383":69080,"_29651":69019,"_20578":115151,"_5":14121,"_26960":115006,"_2870":115152},[],"confirma que el listener del broker hable AMQPS en el puerto configurado — el puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS;",{"_3383":69081,"_29651":69019,"_20578":115154,"_5":14121,"_26960":115006,"_2870":115155},[],"si defines `amqp.ca.secretName`, confirma que el Secret exista en el namespace del release y que su clave de datos coincida con `amqp.ca.certificateKey` (por defecto `ca.crt`); si no defines `amqp.ca.secretName`, los clientes confían en las CA del sistema;",{"_3383":69082,"_29651":69019,"_20578":115157,"_5":14121,"_26960":115006,"_2870":115158},[],"recuerda que un Secret referenciado inexistente impide arrancar los pods consumidores;",{"_3383":69083,"_29651":69019,"_20578":115160,"_5":14121,"_26960":115006,"_2870":115161},[],"tras actualizar el Secret de la CA o del certificado de cliente, reinicia los pods consumidores: el cliente AMQP carga los certificados al arrancar.",{"_3383":69084,"_29651":69019,"_20578":115163,"_5":14121,"_26960":115006,"_2870":115164},[],"Consulta TLS de AMQP (AMQPS) para la configuración completa.",{"_3383":69085,"_29651":69019,"_20578":115166,"_5":14121,"_26960":115006,"_2870":115167},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3383":69086,"_29651":69019,"_20578":115169,"_5":14121,"_26960":115010,"_2870":115170},[],"El chart puede habilitar la instrumentación OpenTelemetry para los servicios que la admiten, incluido authz; no configura OpenTelemetry para el AWS Connector, wfx ni la UI. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, servicio y dependencia.",{"_3383":69087,"_29651":69019,"_20578":115172,"_5":14121,"_26960":115010,"_2870":115173},[],"Antes de cerrar una incidencia, guarda:",{"_3383":69088,"_29651":69019,"_20578":115175,"_5":14121,"_26960":115010,"_2870":115176},[],"causa confirmada;",{"_3383":69089,"_29651":69019,"_20578":115178,"_5":14121,"_26960":115010,"_2870":115179},[],"alcance temporal y recursos afectados;",{"_3383":69090,"_29651":69019,"_20578":115181,"_5":14121,"_26960":115010,"_2870":115182},[],"comandos o consultas utilizados;",{"_3383":69091,"_29651":69019,"_20578":115184,"_5":14121,"_26960":115010,"_2870":115185},[],"cambio aplicado y forma de revertirlo;",{"_3383":69092,"_29651":69019,"_20578":115187,"_5":14121,"_26960":115010,"_2870":115188},[],"validación desde un consumidor;",{"_3383":69093,"_29651":69019,"_20578":115190,"_5":14121,"_26960":115010,"_2870":115191},[],"acción preventiva y propietario.",{"_3383":69094,"_29651":69094,"_5":14473,"_2870":115193,"_30004":115194,"_20578":115197,"_26960":69094},"Control de acceso",[48280,115195,115196],"Plataforma","Administración",[],{"_3383":69095,"_29651":69094,"_20578":115199,"_5":14121,"_26960":69094,"_2870":115200},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3383":69096,"_29651":69094,"_5":30001,"_20578":115202,"_26960":115203,"_2870":115204},[],"/docs/pr-preview/pr-55/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3383":69097,"_29651":69094,"_5":30001,"_20578":115206,"_26960":115207,"_2870":115208},[],"/docs/pr-preview/pr-55/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3383":69098,"_29651":69094,"_5":30001,"_20578":115210,"_26960":115211,"_2870":115212},[],"/docs/pr-preview/pr-55/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3383":69099,"_29651":69094,"_5":30001,"_20578":115214,"_26960":115215,"_2870":115216},[],"/docs/pr-preview/pr-55/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3383":69100,"_29651":69094,"_5":30001,"_20578":115218,"_26960":115219,"_2870":115220},[],"/docs/pr-preview/pr-55/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3383":69101,"_29651":69094,"_5":30001,"_20578":115222,"_26960":115223,"_2870":115224},[],"/docs/pr-preview/pr-55/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3383":69102,"_29651":69094,"_5":30001,"_20578":115226,"_26960":115227,"_2870":115228},[],"/docs/pr-preview/pr-55/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3383":69103,"_29651":69094,"_5":30001,"_20578":115230,"_26960":115231,"_2870":115232},[],"/docs/pr-preview/pr-55/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3383":69104,"_29651":69094,"_5":30001,"_20578":115234,"_26960":115235,"_2870":115236},[],"/docs/pr-preview/pr-55/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3383":69105,"_29651":69094,"_5":30001,"_20578":115238,"_26960":115239,"_2870":115240},[],"/docs/pr-preview/pr-55/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3383":69106,"_29651":69094,"_5":30001,"_20578":115242,"_26960":115243,"_2870":115244},[],"/docs/pr-preview/pr-55/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3383":69107,"_29651":69094,"_5":30001,"_20578":115246,"_26960":115247,"_2870":115248},[],"/docs/pr-preview/pr-55/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3383":69108,"_29651":69094,"_5":30001,"_20578":115250,"_26960":115251,"_2870":115252},[],"/docs/pr-preview/pr-55/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3383":69109,"_29651":69094,"_5":30001,"_20578":115254,"_26960":115255,"_2870":115256},[],"/docs/pr-preview/pr-55/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3383":69110,"_29651":69094,"_5":30001,"_20578":115258,"_26960":115259,"_2870":115260},[],"/docs/pr-preview/pr-55/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3383":69111,"_29651":69094,"_5":30001,"_20578":115262,"_26960":115263,"_2870":114370},[],"/docs/pr-preview/pr-55/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3383":69112,"_29651":69094,"_5":30001,"_20578":115265,"_26960":115266,"_2870":115267},[],"/docs/pr-preview/pr-55/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3383":69113,"_29651":69094,"_5":30001,"_20578":115269,"_26960":115270,"_2870":115271},[],"/docs/pr-preview/pr-55/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_3383":69114,"_29651":69094,"_5":30001,"_20578":115273,"_26960":115274,"_2870":115275},[],"/docs/pr-preview/pr-55/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3383":69115,"_29651":69094,"_5":30001,"_20578":115277,"_26960":115278,"_2870":115279},[],"/docs/pr-preview/pr-55/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3383":69116,"_29651":69094,"_5":30001,"_20578":115281,"_26960":115282,"_2870":115283},[],"/docs/pr-preview/pr-55/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3383":69117,"_29651":69094,"_5":30001,"_20578":115285,"_26960":115286,"_2870":115287},[],"/docs/pr-preview/pr-55/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3383":69118,"_29651":69094,"_5":30001,"_20578":115289,"_26960":115290,"_2870":115291},[],"/docs/pr-preview/pr-55/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3383":69119,"_29651":69094,"_5":30001,"_20578":115293,"_26960":115294,"_2870":115295},[],"/docs/pr-preview/pr-55/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3383":69120,"_29651":69094,"_5":30001,"_20578":115297,"_26960":115298,"_2870":115299},[],"/docs/pr-preview/pr-55/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3383":69121,"_29651":69094,"_5":30001,"_20578":115301,"_26960":115302,"_2870":115303},[],"/docs/pr-preview/pr-55/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3383":69122,"_29651":69094,"_5":30001,"_20578":115305,"_26960":115306,"_2870":115307},[],"/docs/pr-preview/pr-55/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3383":69123,"_29651":69094,"_5":30001,"_20578":115309,"_26960":115310,"_2870":115311},[],"/docs/pr-preview/pr-55/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3383":69124,"_29651":69094,"_5":30001,"_20578":115313,"_26960":115314,"_2870":115315},[],"/docs/pr-preview/pr-55/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3383":69125,"_29651":69094,"_5":30001,"_20578":115317,"_26960":115318,"_2870":115319},[],"/docs/pr-preview/pr-55/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3383":69126,"_29651":69094,"_5":30001,"_20578":115321,"_26960":115322,"_2870":115323},[],"/docs/pr-preview/pr-55/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3383":69127,"_29651":69094,"_20578":115325,"_5":14121,"_26960":69094,"_2870":115326},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3383":69128,"_29651":69094,"_20578":115328,"_5":14121,"_26960":69094,"_2870":115329},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3383":69129,"_29651":69094,"_20578":115331,"_5":14121,"_26960":69094,"_2870":115332},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3383":69130,"_29651":69094,"_20578":115334,"_5":14121,"_26960":115203,"_2870":115335},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3383":69131,"_29651":69094,"_20578":115337,"_5":14121,"_26960":115203,"_2870":115338},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3383":69132,"_29651":69094,"_20578":115340,"_5":14121,"_26960":115203,"_2870":115341},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3383":69133,"_29651":69094,"_20578":115343,"_5":14121,"_26960":115203,"_2870":115344},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3383":69134,"_29651":69094,"_20578":115346,"_5":14121,"_26960":115203,"_2870":115347},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3383":69135,"_29651":69094,"_20578":115349,"_5":14121,"_26960":115203,"_2870":115350},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3383":69136,"_29651":69094,"_20578":115352,"_5":14121,"_26960":115207,"_2870":115353},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3383":69137,"_29651":69094,"_20578":115355,"_5":14121,"_26960":115207,"_2870":115356},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3383":69138,"_29651":69094,"_20578":115358,"_5":14121,"_26960":115211,"_2870":115359},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3383":69139,"_29651":69094,"_20578":115361,"_5":14121,"_26960":115211,"_2870":115362},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3383":69140,"_29651":69094,"_20578":115364,"_5":14121,"_26960":115211,"_2870":115365},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3383":69141,"_29651":69094,"_20578":115367,"_5":14121,"_26960":115211,"_2870":115368},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3383":69142,"_29651":69094,"_20578":115370,"_5":14121,"_26960":115211,"_2870":115371},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3383":69143,"_29651":69094,"_20578":115373,"_5":14121,"_26960":115211,"_2870":115374},[],"Carga por separado las políticas concedidas a cada principal.",{"_3383":69144,"_29651":69094,"_20578":115376,"_5":14121,"_26960":115211,"_2870":115377},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3383":69145,"_29651":69094,"_20578":115379,"_5":14121,"_26960":115211,"_2870":115380},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3383":69146,"_29651":69094,"_20578":115382,"_5":14121,"_26960":115211,"_2870":115383},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3383":69147,"_29651":69094,"_20578":115385,"_5":14121,"_26960":115211,"_2870":115386},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3383":69148,"_29651":69094,"_20578":115388,"_5":14121,"_26960":115211,"_2870":115389},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad.",{"_3383":69149,"_29651":69094,"_20578":115391,"_5":14121,"_26960":115211,"_2870":115392},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3383":69150,"_29651":69094,"_20578":115394,"_5":14121,"_26960":115215,"_2870":115395},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3383":69151,"_29651":69094,"_20578":115397,"_5":14121,"_26960":115215,"_2870":115398},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3383":69152,"_29651":69094,"_20578":115400,"_5":14121,"_26960":115215,"_2870":115401},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3383":69153,"_29651":69094,"_20578":115403,"_5":14121,"_26960":115215,"_2870":115404},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3383":69154,"_29651":69094,"_20578":115406,"_5":14121,"_26960":115215,"_2870":115407},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3383":69155,"_29651":69094,"_20578":115409,"_5":14121,"_26960":115215,"_2870":115410},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3383":69156,"_29651":69094,"_20578":115412,"_5":14121,"_26960":115215,"_2870":115413},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3383":69157,"_29651":69094,"_20578":115415,"_5":14121,"_26960":115215,"_2870":115416},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3383":69158,"_29651":69094,"_20578":115418,"_5":14121,"_26960":115219,"_2870":115419},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3383":69159,"_29651":69094,"_20578":115421,"_5":14121,"_26960":115219,"_2870":115422},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3383":69160,"_29651":69094,"_20578":115424,"_5":14121,"_26960":115219,"_2870":115425},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3383":69161,"_29651":69094,"_20578":115427,"_5":14121,"_26960":115219,"_2870":115428},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3383":69162,"_29651":69094,"_20578":115430,"_5":14121,"_26960":115219,"_2870":115431},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3383":69163,"_29651":69094,"_20578":115433,"_5":14121,"_26960":115219,"_2870":115434},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3383":69164,"_29651":69094,"_20578":115436,"_5":14121,"_26960":115219,"_2870":115437},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3383":69165,"_29651":69094,"_20578":115439,"_5":14121,"_26960":115219,"_2870":115440},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3383":69166,"_29651":69094,"_20578":115442,"_5":14121,"_26960":115219,"_2870":115443},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3383":69167,"_29651":69094,"_20578":115445,"_5":14121,"_26960":115219,"_2870":115446},[],"Las acciones se dividen en dos grupos:",{"_3383":69168,"_29651":69094,"_20578":115448,"_5":14121,"_26960":115219,"_2870":115449},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3383":69169,"_29651":69094,"_20578":115451,"_5":14121,"_26960":115219,"_2870":115452},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3383":69170,"_29651":69094,"_20578":115454,"_5":14121,"_26960":115219,"_2870":115455},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3383":69171,"_29651":69094,"_20578":115457,"_5":14121,"_26960":115223,"_2870":115458},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3383":69172,"_29651":69094,"_20578":115460,"_5":14121,"_26960":115223,"_2870":115461},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3383":69173,"_29651":69094,"_20578":115463,"_5":14121,"_26960":115223,"_2870":115464},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3383":69174,"_29651":69094,"_20578":115466,"_5":14121,"_26960":115227,"_2870":115467},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3383":69175,"_29651":69094,"_20578":115469,"_5":14121,"_26960":115227,"_2870":115470},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3383":69176,"_29651":69094,"_20578":115472,"_5":14121,"_26960":115227,"_2870":115473},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3383":69177,"_29651":69094,"_20578":115475,"_5":14121,"_26960":115227,"_2870":115476},[],"Los operadores implementados son:",{"_3383":69178,"_29651":69094,"_20578":115478,"_5":14121,"_26960":115227,"_2870":115479},[],"`equals`, para igualdad exacta;",{"_3383":69179,"_29651":69094,"_20578":115481,"_5":14121,"_26960":115227,"_2870":115482},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3383":69180,"_29651":69094,"_20578":115484,"_5":14121,"_26960":115227,"_2870":115485},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3383":69181,"_29651":69094,"_20578":115487,"_5":14121,"_26960":115227,"_2870":115488},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3383":69182,"_29651":69094,"_20578":115490,"_5":14121,"_26960":115231,"_2870":115491},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3383":69183,"_29651":69094,"_20578":115493,"_5":14121,"_26960":115231,"_2870":115494},[],"Los modos disponibles son:",{"_3383":69184,"_29651":69094,"_20578":115496,"_5":14121,"_26960":115231,"_2870":115497},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3383":69185,"_29651":69094,"_20578":115499,"_5":14121,"_26960":115231,"_2870":115500},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3383":69186,"_29651":69094,"_20578":115502,"_5":14121,"_26960":115231,"_2870":115503},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3383":69187,"_29651":69094,"_20578":115505,"_5":14121,"_26960":115231,"_2870":115506},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3383":69188,"_29651":69094,"_20578":115508,"_5":14121,"_26960":115231,"_2870":115509},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3383":69189,"_29651":69094,"_20578":115511,"_5":14121,"_26960":115231,"_2870":115512},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3383":69190,"_29651":69094,"_20578":115514,"_5":14121,"_26960":115235,"_2870":115515},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3383":69191,"_29651":69094,"_20578":115517,"_5":14121,"_26960":115235,"_2870":115518},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3383":69192,"_29651":69094,"_20578":115520,"_5":14121,"_26960":115235,"_2870":115521},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3383":69193,"_29651":69094,"_20578":115523,"_5":14121,"_26960":115235,"_2870":115524},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3383":69194,"_29651":69094,"_20578":115526,"_5":14121,"_26960":115243,"_2870":115527},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3383":69195,"_29651":69094,"_20578":115529,"_5":14121,"_26960":115243,"_2870":115530},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3383":69196,"_29651":69094,"_20578":115532,"_5":14121,"_26960":115247,"_2870":115533},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora y la de un dispositivo con su DMS. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3383":69197,"_29651":69094,"_20578":115535,"_5":14121,"_26960":115247,"_2870":115536},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3383":69198,"_29651":69094,"_20578":115538,"_5":14121,"_26960":115251,"_2870":115539},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3383":69199,"_29651":69094,"_20578":115541,"_5":14121,"_26960":115251,"_2870":115542},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3383":69200,"_29651":69094,"_20578":115544,"_5":14121,"_26960":115251,"_2870":115545},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3383":69201,"_29651":69094,"_20578":115547,"_5":14121,"_26960":115255,"_2870":115548},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3383":69202,"_29651":69094,"_20578":115550,"_5":14121,"_26960":115255,"_2870":115551},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3383":69203,"_29651":69094,"_20578":115553,"_5":14121,"_26960":115255,"_2870":115554},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3383":69204,"_29651":69094,"_20578":115556,"_5":14121,"_26960":115255,"_2870":115557},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3383":69205,"_29651":69094,"_20578":115559,"_5":14121,"_26960":115255,"_2870":115560},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3383":69206,"_29651":69094,"_20578":115562,"_5":14121,"_26960":115255,"_2870":115563},[],"Ten en cuenta que:",{"_3383":69207,"_29651":69094,"_20578":115565,"_5":14121,"_26960":115255,"_2870":115566},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3383":69208,"_29651":69094,"_20578":115568,"_5":14121,"_26960":115255,"_2870":115569},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3383":69209,"_29651":69094,"_20578":115571,"_5":14121,"_26960":115255,"_2870":115572},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3383":69210,"_29651":69094,"_20578":115574,"_5":14121,"_26960":115259,"_2870":115575},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3383":69211,"_29651":69094,"_20578":115577,"_5":14121,"_26960":115259,"_2870":115578},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3383":69212,"_29651":69094,"_20578":115580,"_5":14121,"_26960":115259,"_2870":115581},[],"acceso completo y de solo lectura a KMS;",{"_3383":69213,"_29651":69094,"_20578":115583,"_5":14121,"_26960":115259,"_2870":115584},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3383":69214,"_29651":69094,"_20578":115586,"_5":14121,"_26960":115259,"_2870":115587},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3383":69215,"_29651":69094,"_20578":115589,"_5":14121,"_26960":115259,"_2870":115590},[],"acceso a la interfaz;",{"_3383":69216,"_29651":69094,"_20578":115592,"_5":14121,"_26960":115259,"_2870":115593},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3383":69217,"_29651":69094,"_20578":115595,"_5":14121,"_26960":115259,"_2870":115596},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3383":69218,"_29651":69094,"_20578":115598,"_5":14121,"_26960":115259,"_2870":115599},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3383":69219,"_29651":69094,"_20578":115601,"_5":14121,"_26960":115263,"_2870":115602},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3383":69220,"_29651":69094,"_20578":115604,"_5":14121,"_26960":115263,"_2870":115605},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3383":69221,"_29651":69094,"_20578":115607,"_5":14121,"_26960":115263,"_2870":115608},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3383":69222,"_29651":69094,"_20578":115610,"_5":14121,"_26960":115266,"_2870":115611},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3383":69223,"_29651":69094,"_20578":115613,"_5":14121,"_26960":115270,"_2870":115614},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_3383":69224,"_29651":69094,"_20578":115616,"_5":14121,"_26960":115270,"_2870":115617},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_3383":69225,"_29651":69094,"_20578":115619,"_5":14121,"_26960":115274,"_2870":115620},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3383":69226,"_29651":69094,"_20578":115622,"_5":14121,"_26960":115278,"_2870":115623},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3383":69227,"_29651":69094,"_20578":115625,"_5":14121,"_26960":115282,"_2870":115626},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3383":69228,"_29651":69094,"_20578":115628,"_5":14121,"_26960":115286,"_2870":115629},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3383":69229,"_29651":69094,"_20578":115631,"_5":14121,"_26960":115286,"_2870":115632},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3383":69230,"_29651":69094,"_20578":115634,"_5":14121,"_26960":115290,"_2870":115635},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3383":69231,"_29651":69094,"_20578":115637,"_5":14121,"_26960":115290,"_2870":115638},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3383":69232,"_29651":69094,"_20578":115640,"_5":14121,"_26960":115290,"_2870":115641},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3383":69233,"_29651":69094,"_20578":115643,"_5":14121,"_26960":115290,"_2870":115644},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3383":69234,"_29651":69094,"_20578":115646,"_5":14121,"_26960":115290,"_2870":115647},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3383":69235,"_29651":69094,"_20578":115649,"_5":14121,"_26960":115290,"_2870":115650},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3383":69236,"_29651":69094,"_20578":115652,"_5":14121,"_26960":115290,"_2870":115653},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3383":69237,"_29651":69094,"_20578":115655,"_5":14121,"_26960":115290,"_2870":115656},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3383":69238,"_29651":69094,"_20578":115658,"_5":14121,"_26960":115294,"_2870":115659},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3383":69239,"_29651":69094,"_20578":115661,"_5":14121,"_26960":115294,"_2870":115662},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3383":69240,"_29651":69094,"_20578":115664,"_5":14121,"_26960":115294,"_2870":115665},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3383":69241,"_29651":69094,"_20578":115667,"_5":14121,"_26960":115298,"_2870":115668},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3383":69242,"_29651":69094,"_20578":115670,"_5":14121,"_26960":115298,"_2870":115671},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3383":69243,"_29651":69094,"_20578":115673,"_5":14121,"_26960":115298,"_2870":115674},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3383":69244,"_29651":69094,"_20578":115676,"_5":14121,"_26960":115298,"_2870":115677},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3383":69245,"_29651":69094,"_20578":115679,"_5":14121,"_26960":115298,"_2870":115680},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3383":69246,"_29651":69094,"_20578":115682,"_5":14121,"_26960":115298,"_2870":115683},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3383":69247,"_29651":69094,"_20578":115685,"_5":14121,"_26960":115298,"_2870":115686},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3383":69248,"_29651":69094,"_20578":115688,"_5":14121,"_26960":115298,"_2870":115689},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3383":69249,"_29651":69094,"_20578":115691,"_5":14121,"_26960":115306,"_2870":115692},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3383":69250,"_29651":69094,"_20578":115694,"_5":14121,"_26960":115310,"_2870":115695},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3383":69251,"_29651":69094,"_20578":115697,"_5":14121,"_26960":115310,"_2870":115698},[],"que exista un principal activo del tipo correcto;",{"_3383":69252,"_29651":69094,"_20578":115700,"_5":14121,"_26960":115310,"_2870":115701},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3383":69253,"_29651":69094,"_20578":115703,"_5":14121,"_26960":115310,"_2870":115704},[],"que todas las condiciones del principal se cumplan;",{"_3383":69254,"_29651":69094,"_20578":115706,"_5":14121,"_26960":115310,"_2870":115707},[],"que el principal tenga concedida la política esperada;",{"_3383":69255,"_29651":69094,"_20578":115709,"_5":14121,"_26960":115310,"_2870":115710},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3383":69256,"_29651":69094,"_20578":115712,"_5":14121,"_26960":115310,"_2870":115713},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3383":69257,"_29651":69094,"_20578":115715,"_5":14121,"_26960":115310,"_2870":115716},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con las trazas OpenTelemetry habilitadas, una solicitud que llega al motor de políticas genera un span `engine.CheckHTTPRequest` cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente. Para correlacionarlo con la traza del Gateway, el contexto de traza debe propagarse hasta authz.",{"_3383":69258,"_29651":69094,"_20578":115718,"_5":14121,"_26960":115314,"_2870":115719},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3383":69259,"_29651":69094,"_20578":115721,"_5":14121,"_26960":115318,"_2870":115722},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3383":69260,"_29651":69094,"_20578":115724,"_5":14121,"_26960":115322,"_2870":115725},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3383":69261,"_29651":69094,"_20578":115727,"_5":14121,"_26960":115322,"_2870":115728},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3383":69262,"_29651":69262,"_5":14473,"_2870":115730,"_30004":115731,"_20578":115732,"_26960":69262},"Alertas y suscripciones",[48280,115195,115196],[],{"_3383":69263,"_29651":69262,"_20578":115734,"_5":14121,"_26960":69262,"_2870":115735},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3383":69264,"_29651":69262,"_5":30001,"_20578":115737,"_26960":115738,"_2870":115739},[],"/docs/pr-preview/pr-55/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3383":69265,"_29651":69262,"_5":30001,"_20578":115741,"_26960":115742,"_2870":115743},[],"/docs/pr-preview/pr-55/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3383":69266,"_29651":69262,"_5":30001,"_20578":115745,"_26960":115746,"_2870":115747},[],"/docs/pr-preview/pr-55/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3383":69267,"_29651":69262,"_5":30001,"_20578":115749,"_26960":115750,"_2870":115751},[],"/docs/pr-preview/pr-55/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3383":69268,"_29651":69262,"_5":30001,"_20578":115753,"_26960":115754,"_2870":115755},[],"/docs/pr-preview/pr-55/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3383":69269,"_29651":69262,"_5":30001,"_20578":115757,"_26960":115758,"_2870":115759},[],"/docs/pr-preview/pr-55/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3383":69270,"_29651":69262,"_5":30001,"_20578":115761,"_26960":115762,"_2870":115763},[],"/docs/pr-preview/pr-55/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3383":69271,"_29651":69262,"_5":30001,"_20578":115765,"_26960":115766,"_2870":115767},[],"/docs/pr-preview/pr-55/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","Configura el cliente HTTP del webhook",{"_3383":69272,"_29651":69262,"_5":30001,"_20578":115769,"_26960":115770,"_2870":115771},[],"/docs/pr-preview/pr-55/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3383":69273,"_29651":69262,"_5":30001,"_20578":115773,"_26960":115774,"_2870":115775},[],"/docs/pr-preview/pr-55/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3383":69274,"_29651":69262,"_5":30001,"_20578":115777,"_26960":115778,"_2870":115779},[],"/docs/pr-preview/pr-55/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3383":69275,"_29651":69262,"_20578":115781,"_5":14121,"_26960":69262,"_2870":115782},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3383":69276,"_29651":69262,"_20578":115784,"_5":14121,"_26960":115738,"_2870":115785},[],"Un servicio publica un evento de dominio.",{"_3383":69277,"_29651":69262,"_20578":115787,"_5":14121,"_26960":115738,"_2870":115788},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3383":69278,"_29651":69262,"_20578":115790,"_5":14121,"_26960":115738,"_2870":115791},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3383":69279,"_29651":69262,"_20578":115793,"_5":14121,"_26960":115738,"_2870":115794},[],"Lamassu entrega el evento al canal configurado.",{"_3383":69280,"_29651":69262,"_20578":115796,"_5":14121,"_26960":115738,"_2870":115797},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3383":69281,"_29651":69262,"_20578":115799,"_5":14121,"_26960":115742,"_2870":115800},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3383":69282,"_29651":69262,"_20578":115802,"_5":14121,"_26960":115742,"_2870":115803},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3383":69283,"_29651":69262,"_20578":115805,"_5":14121,"_26960":115742,"_2870":115806},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3383":69284,"_29651":69262,"_20578":115808,"_5":14121,"_26960":115742,"_2870":115809},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3383":69285,"_29651":69262,"_20578":115811,"_5":14121,"_26960":115742,"_2870":115812},[],"`apikey_options` necesita `header` y `key`.",{"_3383":69286,"_29651":69262,"_20578":115814,"_5":14121,"_26960":115742,"_2870":115815},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3383":69287,"_29651":69262,"_20578":115817,"_5":14121,"_26960":115742,"_2870":115818},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3383":69288,"_29651":69262,"_20578":115820,"_5":14121,"_26960":115742,"_2870":115821},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3383":69289,"_29651":69262,"_20578":115823,"_5":14121,"_26960":115750,"_2870":115824},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3383":69290,"_29651":69262,"_20578":115826,"_5":14121,"_26960":115754,"_2870":115827},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3383":69291,"_29651":69262,"_20578":115829,"_5":14121,"_26960":115758,"_2870":115830},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3383":69292,"_29651":69262,"_20578":115832,"_5":14121,"_26960":115758,"_2870":115833},[],"**None** notifica todas las instancias del evento.",{"_3383":69293,"_29651":69262,"_20578":115835,"_5":14121,"_26960":115758,"_2870":115836},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3383":69294,"_29651":69262,"_20578":115838,"_5":14121,"_26960":115758,"_2870":115839},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3383":69295,"_29651":69262,"_20578":115841,"_5":14121,"_26960":115758,"_2870":115842},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3383":69296,"_29651":69262,"_20578":115844,"_5":14121,"_26960":115758,"_2870":115845},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3383":69297,"_29651":69262,"_20578":115847,"_5":14121,"_26960":115758,"_2870":115848},[],"La consola evalúa el filtro contra el JSON del editor **Input Event**, que está prellenado con el último evento, e indica si coincide. Para los filtros JSON Path y JavaScript, muestra **The filter matches this Cloud Event** o **The filter does not match this Cloud Event**. Las expresiones JSON Path se evalúan sobre el Cloud Event completo, así que el valor por defecto, `$.data`, selecciona el campo `data` del evento, y la expresión debe empezar por `$`.",{"_3383":69298,"_29651":69262,"_20578":115850,"_5":14121,"_26960":115762,"_2870":115851},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3383":69299,"_29651":69262,"_20578":115853,"_5":14121,"_26960":115766,"_2870":115854},[],"Los canales Webhook y Microsoft Teams muestran esta configuración en el formulario de suscripción, en el paso del canal, y de nuevo al editar una suscripción; Email no la utiliza. Los campos se corresponden con el bloque opcional `http_client` descrito arriba:",{"_3383":69300,"_29651":69262,"_20578":115856,"_5":14121,"_26960":115766,"_2870":115857},[],"**Log Level** selecciona `debug`, `info`, `warn` o `error`; `info` es el valor por defecto.",{"_3383":69301,"_29651":69262,"_20578":115859,"_5":14121,"_26960":115766,"_2870":115860},[],"**Call Timeout** es de 10 segundos por defecto. La consola rechaza un valor superior a 30 segundos con `Webhook timeout must be at most 30s.`; la API ajusta ese mismo valor al tope en lugar de rechazarlo (ver Las llamadas están limitadas).",{"_3383":69302,"_29651":69262,"_20578":115862,"_5":14121,"_26960":115766,"_2870":115863},[],"No hay interruptor de verificación TLS para estos canales, porque el servicio siempre verifica el certificado del receptor (ver TLS siempre se verifica).",{"_3383":69303,"_29651":69262,"_20578":115865,"_5":14121,"_26960":115766,"_2870":115866},[],"**HTTP Authentication** selecciona `No Authentication` (por defecto), `API Key` (valor de la API key y Header Name, `X-API-Key` por defecto), `OIDC Client Credentials` (Client ID, Client Secret y Well-Known URL) o `Mutual TLS` (Client Certificate y Client Private Key pegados como PEM). Una clave privada guardada permanece oculta hasta que seleccionas **Show**.",{"_3383":69304,"_29651":69262,"_20578":115868,"_5":14121,"_26960":115766,"_2870":115869},[],"Una URL `http://` muestra en la consola la advertencia `Unencrypted HTTP connection` (ver la llamada Credenciales sobre http\\:// más abajo).",{"_3383":69305,"_29651":69262,"_20578":115871,"_5":14121,"_26960":115766,"_2870":115872},[],"Los campos se validan en línea con las mismas reglas de entrega: la URL del webhook y la Well-Known URL de OIDC deben ser URLs absolutas `http` o `https`, una cabecera API-key no puede usar un nombre reservado y el certificado y la clave mTLS deben ser contenido PEM, no rutas de ficheros.",{"_3383":69306,"_29651":69262,"_20578":115874,"_5":14121,"_26960":115766,"_2870":115875},[],"El resumen del paso de confirmación muestra la autenticación como `None`, `OIDC client credentials`, `API key` o `Mutual TLS`. Los detalles de la suscripción muestran la autenticación, el nombre de la cabecera API-key (nunca el valor), la URL del emisor OIDC, mTLS como `Configured` y una fila fija `TLS verification: Verified`. La API key, el client secret y la clave privada no se muestran en los detalles de la suscripción.",{"_3383":69307,"_29651":69262,"_20578":115877,"_5":14121,"_26960":115770,"_2870":115878},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3383":69308,"_29651":69262,"_20578":115880,"_5":14121,"_26960":115770,"_2870":115881},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3383":69309,"_29651":69262,"_20578":115883,"_5":14121,"_26960":115770,"_2870":115884},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3383":69310,"_29651":69262,"_20578":115886,"_5":14121,"_26960":115770,"_2870":115887},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3383":69311,"_29651":69262,"_20578":115889,"_5":14121,"_26960":115770,"_2870":115890},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3383":69312,"_29651":69262,"_20578":115892,"_5":14121,"_26960":115770,"_2870":115893},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3383":69313,"_29651":69262,"_20578":115895,"_5":14121,"_26960":115770,"_2870":115896},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3383":69314,"_29651":69262,"_20578":115898,"_5":14121,"_26960":115770,"_2870":115899},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3383":69315,"_29651":69262,"_20578":115901,"_5":14121,"_26960":115774,"_2870":115902},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3383":69316,"_29651":69262,"_20578":115904,"_5":14121,"_26960":115774,"_2870":115905},[],"Las suscripciones creadas con versiones anteriores de la consola pueden guardar el destino del webhook en `url` y `method` en lugar de `webhook_url` y `webhook_method`. El servicio entrega solo a través de `webhook_url` y `webhook_method`, así que una suscripción así no entrega aunque los detalles de la suscripción muestren el destino guardado. Abre la suscripción y vuelve a guardarla: el formulario de edición precarga el destino guardado, y al guardar se reescribe la configuración del canal con el formato actual.",{"_3383":69317,"_29651":69262,"_20578":115907,"_5":14121,"_26960":115778,"_2870":115908},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3383":69318,"_29651":69262,"_20578":115910,"_5":14121,"_26960":115778,"_2870":115911},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3383":69319,"_29651":69262,"_20578":115913,"_5":14121,"_26960":115778,"_2870":115914},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3383":69320,"_29651":69262,"_20578":115916,"_5":14121,"_26960":115778,"_2870":115917},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3383":69321,"_29651":69262,"_20578":115919,"_5":14121,"_26960":115778,"_2870":115920},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3383":69322,"_29651":69262,"_20578":115922,"_5":14121,"_26960":115778,"_2870":115923},[],"**Validación:** `va.role.crl.create`.",{"_3383":69323,"_29651":69262,"_20578":115925,"_5":14121,"_26960":115778,"_2870":115926},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3383":69324,"_29651":69262,"_20578":115928,"_5":14121,"_26960":115778,"_2870":115929},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3383":69325,"_29651":69325,"_5":14473,"_2870":115931,"_30004":115932,"_20578":115933,"_26960":69325},"Registros de auditoría",[48280,115195,115196],[],{"_3383":69326,"_29651":69325,"_20578":115935,"_5":14121,"_26960":69325,"_2870":115936},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3383":69327,"_29651":69325,"_5":30001,"_20578":115938,"_26960":115939,"_2870":115940},[],"/docs/pr-preview/pr-55/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3383":69328,"_29651":69325,"_5":30001,"_20578":115942,"_26960":115943,"_2870":115944},[],"/docs/pr-preview/pr-55/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3383":69329,"_29651":69325,"_5":30001,"_20578":115946,"_26960":115947,"_2870":115948},[],"/docs/pr-preview/pr-55/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3383":69330,"_29651":69325,"_5":30001,"_20578":115950,"_26960":115951,"_2870":115952},[],"/docs/pr-preview/pr-55/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3383":69331,"_29651":69325,"_5":30001,"_20578":115954,"_26960":115955,"_2870":115956},[],"/docs/pr-preview/pr-55/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3383":69332,"_29651":69325,"_5":30001,"_20578":115958,"_26960":115959,"_2870":115960},[],"/docs/pr-preview/pr-55/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3383":69333,"_29651":69325,"_5":30001,"_20578":115962,"_26960":115963,"_2870":115964},[],"/docs/pr-preview/pr-55/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3383":69334,"_29651":69325,"_5":30001,"_20578":115966,"_26960":115967,"_2870":115968},[],"/docs/pr-preview/pr-55/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3383":69335,"_29651":69325,"_5":30001,"_20578":115970,"_26960":115971,"_2870":115972},[],"/docs/pr-preview/pr-55/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3383":69336,"_29651":69325,"_5":30001,"_20578":115974,"_26960":115975,"_2870":115976},[],"/docs/pr-preview/pr-55/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3383":69337,"_29651":69325,"_5":30001,"_20578":115978,"_26960":115979,"_2870":115980},[],"/docs/pr-preview/pr-55/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3383":69338,"_29651":69325,"_20578":115982,"_5":14121,"_26960":69325,"_2870":115983},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3383":69339,"_29651":69325,"_20578":115985,"_5":14121,"_26960":115939,"_2870":115986},[],"El cuerpo de auditoría incluye:",{"_3383":69340,"_29651":69325,"_20578":115988,"_5":14121,"_26960":115939,"_2870":115989},[],"input: datos recibidos por la operación;",{"_3383":69341,"_29651":69325,"_20578":115991,"_5":14121,"_26960":115939,"_2870":115992},[],"has\\_error: indica si el servicio devolvió un error;",{"_3383":69342,"_29651":69325,"_20578":115994,"_5":14121,"_26960":115939,"_2870":115995},[],"output: resultado producido o mensaje de error;",{"_3383":69343,"_29651":69325,"_20578":115997,"_5":14121,"_26960":115939,"_2870":115998},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3383":69344,"_29651":69325,"_20578":116000,"_5":14121,"_26960":115939,"_2870":116001},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3383":69345,"_29651":69325,"_20578":116003,"_5":14121,"_26960":115939,"_2870":116004},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3383":69346,"_29651":69325,"_20578":116006,"_5":14121,"_26960":115943,"_2870":116007},[],"El backend aplica auditoría a mutaciones de:",{"_3383":69347,"_29651":69325,"_20578":116009,"_5":14121,"_26960":115943,"_2870":116010},[],"autoridades, certificados y perfiles de emisión;",{"_3383":69348,"_29651":69325,"_20578":116012,"_5":14121,"_26960":115943,"_2870":116013},[],"claves y motores KMS;",{"_3383":69349,"_29651":69325,"_20578":116015,"_5":14121,"_26960":115943,"_2870":116016},[],"dispositivos e identidades;",{"_3383":69350,"_29651":69325,"_20578":116018,"_5":14121,"_26960":115943,"_2870":116019},[],"DMS y operaciones de enrolamiento;",{"_3383":69351,"_29651":69325,"_20578":116021,"_5":14121,"_26960":115943,"_2870":116022},[],"funciones de validación y CRL;",{"_3383":69352,"_29651":69325,"_20578":116024,"_5":14121,"_26960":115943,"_2870":116025},[],"principales, políticas y concesiones de autorización.",{"_3383":69353,"_29651":69325,"_20578":116027,"_5":14121,"_26960":115943,"_2870":116028},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3383":69354,"_29651":69325,"_20578":116030,"_5":14121,"_26960":115947,"_2870":116031},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3383":69355,"_29651":69325,"_20578":116033,"_5":14121,"_26960":115947,"_2870":116034},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3383":69356,"_29651":69325,"_20578":116036,"_5":14121,"_26960":115947,"_2870":116037},[],"Diseña el consumidor para:",{"_3383":69357,"_29651":69325,"_20578":116039,"_5":14121,"_26960":115947,"_2870":116040},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3383":69358,"_29651":69325,"_20578":116042,"_5":14121,"_26960":115947,"_2870":116043},[],"conservar el CloudEvent completo sin modificar;",{"_3383":69359,"_29651":69325,"_20578":116045,"_5":14121,"_26960":115947,"_2870":116046},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3383":69360,"_29651":69325,"_20578":116048,"_5":14121,"_26960":115947,"_2870":116049},[],"cifrar en tránsito y en reposo;",{"_3383":69361,"_29651":69325,"_20578":116051,"_5":14121,"_26960":115947,"_2870":116052},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3383":69362,"_29651":69325,"_20578":116054,"_5":14121,"_26960":115947,"_2870":116055},[],"aplicar una política explícita de retención y legal hold;",{"_3383":69363,"_29651":69325,"_20578":116057,"_5":14121,"_26960":115947,"_2870":116058},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3383":69364,"_29651":69325,"_20578":116060,"_5":14121,"_26960":115951,"_2870":116061},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3383":69365,"_29651":69325,"_20578":116063,"_5":14121,"_26960":115951,"_2870":116064},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3383":69366,"_29651":69325,"_20578":116066,"_5":14121,"_26960":115959,"_2870":116067},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3383":69367,"_29651":69325,"_20578":116069,"_5":14121,"_26960":115963,"_2870":116070},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3383":69368,"_29651":69325,"_20578":116072,"_5":14121,"_26960":115967,"_2870":116073},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3383":69369,"_29651":69325,"_20578":116075,"_5":14121,"_26960":115971,"_2870":116076},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3383":69370,"_29651":69325,"_20578":116078,"_5":14121,"_26960":115975,"_2870":116079},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3383":69371,"_29651":69325,"_20578":116081,"_5":14121,"_26960":115979,"_2870":116082},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3383":69372,"_29651":69325,"_20578":116084,"_5":14121,"_26960":115979,"_2870":116085},[],"aparece un evento de auditoría correcto;",{"_3383":69373,"_29651":69325,"_20578":116087,"_5":14121,"_26960":115979,"_2870":116088},[],"el principal coincide con la identidad utilizada;",{"_3383":69374,"_29651":69325,"_20578":116090,"_5":14121,"_26960":115979,"_2870":116091},[],"el consumidor lo persiste una sola vez;",{"_3383":69375,"_29651":69325,"_20578":116093,"_5":14121,"_26960":115979,"_2870":116094},[],"puede recuperarse por recurso, actor y periodo;",{"_3383":69376,"_29651":69325,"_20578":116096,"_5":14121,"_26960":115979,"_2870":116097},[],"una interrupción del consumidor produce una alerta.",{"_3383":69377,"_29651":69325,"_20578":116099,"_5":14121,"_26960":115979,"_2870":116100},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3383":69378,"_29651":69378,"_5":14473,"_2870":116102,"_30004":116103,"_20578":116104,"_26960":69378},"Arquitectura de la plataforma",[48280,115195],[],{"_3383":69379,"_29651":69378,"_20578":116106,"_5":14121,"_26960":69378,"_2870":116107},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3383":69380,"_29651":69378,"_5":30001,"_20578":116109,"_26960":116110,"_2870":116111},[],"/docs/pr-preview/pr-55/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3383":69381,"_29651":69378,"_5":30001,"_20578":116113,"_26960":116114,"_2870":116115},[],"/docs/pr-preview/pr-55/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3383":69382,"_29651":69378,"_5":30001,"_20578":116117,"_26960":116118,"_2870":116119},[],"/docs/pr-preview/pr-55/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3383":69383,"_29651":69378,"_5":30001,"_20578":116121,"_26960":116122,"_2870":116123},[],"/docs/pr-preview/pr-55/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3383":69384,"_29651":69378,"_5":30001,"_20578":116125,"_26960":116126,"_2870":116127},[],"/docs/pr-preview/pr-55/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3383":69385,"_29651":69378,"_20578":116129,"_5":14121,"_26960":69378,"_2870":116130},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3383":69386,"_29651":69378,"_20578":116132,"_5":14121,"_26960":69378,"_2870":116133},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3383":69387,"_29651":69378,"_20578":116135,"_5":14121,"_26960":116110,"_2870":116136},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3383":69388,"_29651":69378,"_20578":116138,"_5":14121,"_26960":116114,"_2870":116139},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3383":69389,"_29651":69378,"_20578":116141,"_5":14121,"_26960":116118,"_2870":116142},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3383":69390,"_29651":69378,"_20578":116144,"_5":14121,"_26960":116122,"_2870":116145},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3383":69391,"_29651":69378,"_20578":116147,"_5":14121,"_26960":116126,"_2870":116148},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3383":69392,"_29651":69392,"_5":14473,"_2870":116150,"_30004":116151,"_20578":116152,"_26960":69392},"Cómo funciona Lamassu",[48280,115195],[],{"_3383":69393,"_29651":69392,"_20578":116154,"_5":14121,"_26960":69392,"_2870":116155},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3383":69394,"_29651":69392,"_5":30001,"_20578":116157,"_26960":116158,"_2870":116159},[],"/docs/pr-preview/pr-55/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3383":69395,"_29651":69392,"_5":30001,"_20578":116161,"_26960":116162,"_2870":116163},[],"/docs/pr-preview/pr-55/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3383":69396,"_29651":69392,"_20578":116165,"_5":14121,"_26960":69392,"_2870":116166},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3383":69397,"_29651":69392,"_20578":116168,"_5":14121,"_26960":116158,"_2870":116169},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3383":69398,"_29651":69392,"_20578":116171,"_5":14121,"_26960":116158,"_2870":116172},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3383":69399,"_29651":69392,"_20578":116174,"_5":14121,"_26960":116158,"_2870":116175},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3383":69400,"_29651":69392,"_20578":116177,"_5":14121,"_26960":116158,"_2870":116178},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3383":69401,"_29651":69392,"_20578":116180,"_5":14121,"_26960":116158,"_2870":116181},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3383":69402,"_29651":69392,"_20578":116183,"_5":14121,"_26960":116162,"_2870":116184},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3383":69403,"_29651":69392,"_20578":116186,"_5":14121,"_26960":116162,"_2870":116187},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3383":69404,"_29651":69392,"_20578":116189,"_5":14121,"_26960":116162,"_2870":116190},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3383":69405,"_29651":69392,"_20578":116192,"_5":14121,"_26960":116162,"_2870":116193},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3383":69406,"_29651":69392,"_20578":116195,"_5":14121,"_26960":116162,"_2870":116196},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3383":69407,"_29651":69392,"_20578":116198,"_5":14121,"_26960":116162,"_2870":116199},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3383":69408,"_29651":69392,"_20578":116201,"_5":14121,"_26960":116162,"_2870":116202},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3383":69409,"_29651":69409,"_5":14473,"_2870":116204,"_30004":116205,"_20578":116206,"_26960":69409},"Dispositivos e identidades",[48280,115195,50759,116204],[],{"_3383":69410,"_29651":69409,"_20578":116208,"_5":14121,"_26960":69409,"_2870":116209},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3383":69411,"_29651":69409,"_5":30001,"_20578":116211,"_26960":116212,"_2870":116213},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3383":69412,"_29651":69409,"_5":30001,"_20578":116215,"_26960":116216,"_2870":116217},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3383":69413,"_29651":69409,"_5":30001,"_20578":116219,"_26960":116220,"_2870":116221},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3383":69414,"_29651":69409,"_5":30001,"_20578":116223,"_26960":116224,"_2870":116225},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3383":69415,"_29651":69409,"_5":30001,"_20578":116227,"_26960":116228,"_2870":116229},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3383":69416,"_29651":69409,"_5":30001,"_20578":116231,"_26960":116232,"_2870":116233},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3383":69417,"_29651":69409,"_5":30001,"_20578":116235,"_26960":116236,"_2870":116237},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3383":69418,"_29651":69409,"_5":30001,"_20578":116239,"_26960":116240,"_2870":116241},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3383":69419,"_29651":69409,"_5":30001,"_20578":116243,"_26960":116244,"_2870":116245},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3383":69420,"_29651":69409,"_5":30001,"_20578":116247,"_26960":116248,"_2870":116249},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3383":69421,"_29651":69409,"_5":30001,"_20578":116251,"_26960":116252,"_2870":116253},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3383":69422,"_29651":69409,"_20578":116255,"_5":14121,"_26960":69409,"_2870":116256},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3383":69423,"_29651":69409,"_20578":116258,"_5":14121,"_26960":69409,"_2870":116259},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3383":69424,"_29651":69409,"_20578":116261,"_5":14121,"_26960":116212,"_2870":116262},[],"Vista operativa",{"_3383":69425,"_29651":69409,"_20578":116264,"_5":14121,"_26960":116212,"_2870":116265},[],"Interpretación",{"_3383":69426,"_29651":69409,"_20578":116267,"_5":14121,"_26960":116212,"_2870":50822},[],{"_3383":69427,"_29651":69409,"_20578":116269,"_5":14121,"_26960":116212,"_2870":116270},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3383":69428,"_29651":69409,"_20578":116272,"_5":14121,"_26960":116212,"_2870":50828},[],{"_3383":69429,"_29651":69409,"_20578":116274,"_5":14121,"_26960":116212,"_2870":116275},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3383":69430,"_29651":69409,"_20578":116277,"_5":14121,"_26960":116212,"_2870":50834},[],{"_3383":69431,"_29651":69409,"_20578":116279,"_5":14121,"_26960":116212,"_2870":116280},[],"La identidad está en la ventana operativa de renovación.",{"_3383":69432,"_29651":69409,"_20578":116282,"_5":14121,"_26960":116212,"_2870":50840},[],{"_3383":69433,"_29651":69409,"_20578":116284,"_5":14121,"_26960":116212,"_2870":116285},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3383":69434,"_29651":69409,"_20578":116287,"_5":14121,"_26960":116212,"_2870":50846},[],{"_3383":69435,"_29651":69409,"_20578":116289,"_5":14121,"_26960":116212,"_2870":116290},[],"La identidad ha vencido.",{"_3383":69436,"_29651":69409,"_20578":116292,"_5":14121,"_26960":116212,"_2870":50852},[],{"_3383":69437,"_29651":69409,"_20578":116294,"_5":14121,"_26960":116212,"_2870":116295},[],"La identidad está marcada como revocada.",{"_3383":69438,"_29651":69409,"_20578":116297,"_5":14121,"_26960":116212,"_2870":50858},[],{"_3383":69439,"_29651":69409,"_20578":116299,"_5":14121,"_26960":116212,"_2870":116300},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3383":69440,"_29651":69409,"_20578":116302,"_5":14121,"_26960":116212,"_2870":116303},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3383":69441,"_29651":69409,"_20578":116305,"_5":14121,"_26960":116216,"_2870":116306},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3383":69442,"_29651":69409,"_20578":116308,"_5":14121,"_26960":116216,"_2870":116309},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3383":69443,"_29651":69409,"_20578":116311,"_5":14121,"_26960":116216,"_2870":116312},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3383":69444,"_29651":69409,"_20578":116314,"_5":14121,"_26960":116216,"_2870":116315},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3383":69445,"_29651":69409,"_20578":116317,"_5":14121,"_26960":116220,"_2870":116318},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3383":69446,"_29651":69409,"_20578":116320,"_5":14121,"_26960":116224,"_2870":116321},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3383":69447,"_29651":69409,"_20578":116323,"_5":14121,"_26960":116228,"_2870":116324},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3383":69448,"_29651":69409,"_20578":116326,"_5":14121,"_26960":116232,"_2870":116327},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3383":69449,"_29651":69409,"_20578":116329,"_5":14121,"_26960":116236,"_2870":116330},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3383":69450,"_29651":69409,"_20578":116332,"_5":14121,"_26960":116236,"_2870":116333},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3383":69451,"_29651":69409,"_20578":116335,"_5":14121,"_26960":116240,"_2870":116336},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3383":69452,"_29651":69409,"_20578":116338,"_5":14121,"_26960":116240,"_2870":116339},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3383":69453,"_29651":69409,"_20578":116341,"_5":14121,"_26960":116240,"_2870":116342},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3383":69454,"_29651":69409,"_20578":116344,"_5":14121,"_26960":116240,"_2870":116345},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3383":69455,"_29651":69409,"_20578":116347,"_5":14121,"_26960":116240,"_2870":116348},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3383":69456,"_29651":69409,"_20578":116350,"_5":14121,"_26960":116240,"_2870":116351},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3383":69457,"_29651":69409,"_20578":116353,"_5":14121,"_26960":116244,"_2870":116354},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3383":69458,"_29651":69409,"_20578":116356,"_5":14121,"_26960":116244,"_2870":116357},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3383":69459,"_29651":69409,"_20578":116359,"_5":14121,"_26960":116248,"_2870":116360},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3383":69460,"_29651":69409,"_20578":116362,"_5":14121,"_26960":116248,"_2870":116363},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3383":69461,"_29651":69409,"_20578":116365,"_5":14121,"_26960":116248,"_2870":116366},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3383":69462,"_29651":69409,"_20578":116368,"_5":14121,"_26960":116248,"_2870":116369},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3383":69463,"_29651":69409,"_20578":116371,"_5":14121,"_26960":116252,"_2870":116372},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3383":69464,"_29651":69409,"_20578":116374,"_5":14121,"_26960":116252,"_2870":116375},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3383":69465,"_29651":69465,"_5":14473,"_2870":116377,"_30004":116378,"_20578":116380,"_26960":69465},"Identidad inicial y autenticación",[48280,115195,50759,116204,116379],"Enrolamiento con PKI",[],{"_3383":69466,"_29651":69465,"_20578":116382,"_5":14121,"_26960":69465,"_2870":116383},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_3383":69467,"_29651":69465,"_5":30001,"_20578":116385,"_26960":116386,"_2870":116387},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3383":69468,"_29651":69465,"_5":30001,"_20578":116389,"_26960":116390,"_2870":116391},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3383":69469,"_29651":69465,"_5":30001,"_20578":116393,"_26960":116394,"_2870":116395},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_3383":69470,"_29651":69465,"_5":30001,"_20578":116397,"_26960":116398,"_2870":116399},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3383":69471,"_29651":69465,"_5":30001,"_20578":116401,"_26960":116402,"_2870":116403},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3383":69472,"_29651":69465,"_20578":116405,"_5":14121,"_26960":69465,"_2870":116406},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3383":69473,"_29651":69465,"_20578":116408,"_5":14121,"_26960":116386,"_2870":116409},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3383":69474,"_29651":69465,"_20578":116411,"_5":14121,"_26960":116386,"_2870":116412},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3383":69475,"_29651":69465,"_20578":116414,"_5":14121,"_26960":116390,"_2870":116415},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3383":69476,"_29651":69465,"_20578":116417,"_5":14121,"_26960":116390,"_2870":116418},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3383":69477,"_29651":69465,"_20578":116420,"_5":14121,"_26960":116390,"_2870":116421},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3383":69478,"_29651":69465,"_20578":116423,"_5":14121,"_26960":116394,"_2870":116424},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3383":69479,"_29651":69465,"_20578":116426,"_5":14121,"_26960":116394,"_2870":116427},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3383":69480,"_29651":69465,"_20578":116429,"_5":14121,"_26960":116398,"_2870":116430},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3383":69481,"_29651":69465,"_20578":116432,"_5":14121,"_26960":116398,"_2870":116433},[],"Ejemplo de cuerpo:",{"_3383":69482,"_29651":69465,"_20578":116435,"_5":14121,"_26960":116398,"_2870":116436},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3383":69483,"_29651":69465,"_20578":116438,"_5":14121,"_26960":116398,"_2870":116439},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3383":69484,"_29651":69465,"_20578":116441,"_5":14121,"_26960":116398,"_2870":116442},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3383":69485,"_29651":69465,"_20578":116444,"_5":14121,"_26960":116398,"_2870":116445},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3383":69486,"_29651":69465,"_20578":116447,"_5":14121,"_26960":116402,"_2870":116448},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_3383":69487,"_29651":69465,"_20578":116450,"_5":14121,"_26960":116402,"_2870":116451},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3383":69488,"_29651":69488,"_5":14473,"_2870":116453,"_30004":116454,"_20578":116455,"_26960":69488},"Configura y opera el DMS",[48280,115195,50759,116204,116379],[],{"_3383":69489,"_29651":69488,"_20578":116457,"_5":14121,"_26960":69488,"_2870":116458},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3383":69490,"_29651":69488,"_5":30001,"_20578":116460,"_26960":116461,"_2870":113773},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3383":69491,"_29651":69488,"_5":30001,"_20578":116463,"_26960":116464,"_2870":116465},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3383":69492,"_29651":69488,"_5":30001,"_20578":116467,"_26960":116468,"_2870":116469},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3383":69493,"_29651":69488,"_5":30001,"_20578":116471,"_26960":116472,"_2870":116473},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3383":69494,"_29651":69488,"_5":30001,"_20578":116475,"_26960":116476,"_2870":116477},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3383":69495,"_29651":69488,"_5":30001,"_20578":116479,"_26960":116480,"_2870":116481},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3383":69496,"_29651":69488,"_5":30001,"_20578":116483,"_26960":116484,"_2870":116485},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3383":69497,"_29651":69488,"_5":30001,"_20578":116487,"_26960":116488,"_2870":116489},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_3383":69498,"_29651":69488,"_5":30001,"_20578":116491,"_26960":116492,"_2870":51054},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_3383":69499,"_29651":69488,"_5":30001,"_20578":116494,"_26960":116495,"_2870":51058},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_3383":69500,"_29651":69488,"_5":30001,"_20578":116497,"_26960":116498,"_2870":116499},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_3383":69501,"_29651":69488,"_5":30001,"_20578":116501,"_26960":116502,"_2870":116503},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3383":69502,"_29651":69488,"_5":30001,"_20578":116505,"_26960":116506,"_2870":116507},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_3383":69503,"_29651":69488,"_5":30001,"_20578":116509,"_26960":116510,"_2870":116511},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3383":69504,"_29651":69488,"_5":30001,"_20578":116513,"_26960":116514,"_2870":51078},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_3383":69505,"_29651":69488,"_5":30001,"_20578":116516,"_26960":116517,"_2870":116518},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_3383":69506,"_29651":69488,"_5":30001,"_20578":116520,"_26960":116521,"_2870":116522},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3383":69507,"_29651":69488,"_5":30001,"_20578":116524,"_26960":116525,"_2870":116526},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3383":69508,"_29651":69488,"_20578":116528,"_5":14121,"_26960":69488,"_2870":116529},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3383":69509,"_29651":69488,"_20578":116531,"_5":14121,"_26960":116461,"_2870":116532},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3383":69510,"_29651":69488,"_20578":116534,"_5":14121,"_26960":116461,"_2870":116535},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3383":69511,"_29651":69488,"_20578":116537,"_5":14121,"_26960":116468,"_2870":116538},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3383":69512,"_29651":69488,"_20578":116540,"_5":14121,"_26960":116472,"_2870":116541},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3383":69513,"_29651":69488,"_20578":116543,"_5":14121,"_26960":116476,"_2870":116544},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3383":69514,"_29651":69488,"_20578":116546,"_5":14121,"_26960":116480,"_2870":116547},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3383":69515,"_29651":69488,"_20578":116549,"_5":14121,"_26960":116484,"_2870":116550},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3383":69516,"_29651":69488,"_20578":116552,"_5":14121,"_26960":116492,"_2870":116553},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_3383":69517,"_29651":69488,"_20578":116555,"_5":14121,"_26960":116492,"_2870":116556},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3383":69518,"_29651":69488,"_20578":116558,"_5":14121,"_26960":116495,"_2870":116559},[],"Campo de `settings.enrollment_settings`",{"_3383":69519,"_29651":69488,"_20578":116561,"_5":14121,"_26960":116495,"_2870":116562},[],"Decisión",{"_3383":69520,"_29651":69488,"_20578":116564,"_5":14121,"_26960":116495,"_2870":51129},[],{"_3383":69521,"_29651":69488,"_20578":116566,"_5":14121,"_26960":116495,"_2870":116567},[],"`EST_RFC7030` para estas operaciones.",{"_3383":69522,"_29651":69488,"_20578":116569,"_5":14121,"_26960":116495,"_2870":51135},[],{"_3383":69523,"_29651":69488,"_20578":116571,"_5":14121,"_26960":116495,"_2870":116572},[],"ID de la CA que firmará.",{"_3383":69524,"_29651":69488,"_20578":116574,"_5":14121,"_26960":116495,"_2870":51141},[],{"_3383":69525,"_29651":69488,"_20578":116576,"_5":14121,"_26960":116495,"_2870":116577},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3383":69526,"_29651":69488,"_20578":116579,"_5":14121,"_26960":116495,"_2870":51147},[],{"_3383":69527,"_29651":69488,"_20578":116581,"_5":14121,"_26960":116495,"_2870":116582},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3383":69528,"_29651":69488,"_20578":116584,"_5":14121,"_26960":116495,"_2870":51153},[],{"_3383":69529,"_29651":69488,"_20578":116586,"_5":14121,"_26960":116495,"_2870":116587},[],"Uno de los cuatro modos de autenticación.",{"_3383":69530,"_29651":69488,"_20578":116589,"_5":14121,"_26960":116495,"_2870":116590},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3383":69531,"_29651":69488,"_20578":116592,"_5":14121,"_26960":116498,"_2870":116593},[],"Los bloques son independientes:",{"_3383":69532,"_29651":69488,"_20578":116595,"_5":14121,"_26960":116498,"_2870":116596},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3383":69533,"_29651":69488,"_20578":116598,"_5":14121,"_26960":116498,"_2870":116599},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3383":69534,"_29651":69488,"_20578":116601,"_5":14121,"_26960":116498,"_2870":51171},[],{"_3383":69535,"_29651":69488,"_20578":116603,"_5":14121,"_26960":116498,"_2870":116604},[],"Control aplicado en la operación configurada",{"_3383":69536,"_29651":69488,"_20578":116606,"_5":14121,"_26960":116498,"_2870":51177},[],{"_3383":69537,"_29651":69488,"_20578":116608,"_5":14121,"_26960":116498,"_2870":116609},[],"Validación del certificado presentado.",{"_3383":69538,"_29651":69488,"_20578":116611,"_5":14121,"_26960":116498,"_2870":51183},[],{"_3383":69539,"_29651":69488,"_20578":116613,"_5":14121,"_26960":116498,"_2870":116614},[],"Autorización del webhook configurado.",{"_3383":69540,"_29651":69488,"_20578":116616,"_5":14121,"_26960":116498,"_2870":51189},[],{"_3383":69541,"_29651":69488,"_20578":116618,"_5":14121,"_26960":116498,"_2870":116619},[],"Validación del certificado y, después, aprobación del webhook.",{"_3383":69542,"_29651":69488,"_20578":116621,"_5":14121,"_26960":116498,"_2870":51195},[],{"_3383":69543,"_29651":69488,"_20578":116623,"_5":14121,"_26960":116498,"_2870":116624},[],"Sin autenticación del solicitante por el DMS.",{"_3383":69544,"_29651":69488,"_20578":116626,"_5":14121,"_26960":116498,"_2870":116627},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3383":69545,"_29651":69488,"_20578":116629,"_5":14121,"_26960":116498,"_2870":116630},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3383":69546,"_29651":69488,"_20578":116632,"_5":14121,"_26960":116498,"_2870":116633},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`.",{"_3383":69547,"_29651":69488,"_20578":116635,"_5":14121,"_26960":116498,"_2870":116636},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3383":69548,"_29651":69488,"_20578":116638,"_5":14121,"_26960":116502,"_2870":116639},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3383":69549,"_29651":69488,"_20578":116641,"_5":14121,"_26960":116502,"_2870":116642},[],"Campo de `external_webhook_settings`",{"_3383":69550,"_29651":69488,"_20578":116644,"_5":14121,"_26960":116502,"_2870":116562},[],{"_3383":69551,"_29651":69488,"_20578":116646,"_5":14121,"_26960":116502,"_2870":51221},[],{"_3383":69552,"_29651":69488,"_20578":116648,"_5":14121,"_26960":116502,"_2870":116649},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3383":69553,"_29651":69488,"_20578":116651,"_5":14121,"_26960":116502,"_2870":51227},[],{"_3383":69554,"_29651":69488,"_20578":116653,"_5":14121,"_26960":116502,"_2870":116654},[],"`POST` o `PUT`; `POST` por defecto.",{"_3383":69555,"_29651":69488,"_20578":116656,"_5":14121,"_26960":116502,"_2870":51233},[],{"_3383":69556,"_29651":69488,"_20578":116658,"_5":14121,"_26960":116502,"_2870":116659},[],"Etiqueta usada en los logs del servicio.",{"_3383":69557,"_29651":69488,"_20578":116661,"_5":14121,"_26960":116502,"_2870":51239},[],{"_3383":69558,"_29651":69488,"_20578":116663,"_5":14121,"_26960":116502,"_2870":116664},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3383":69559,"_29651":69488,"_20578":116666,"_5":14121,"_26960":116502,"_2870":51245},[],{"_3383":69560,"_29651":69488,"_20578":116668,"_5":14121,"_26960":116502,"_2870":116669},[],"Nivel de log de la llamada del webhook: `debug`, `info`, `warn` o `error`; `info` por defecto.",{"_3383":69561,"_29651":69488,"_20578":116671,"_5":14121,"_26960":116502,"_2870":51251},[],{"_3383":69562,"_29651":69488,"_20578":116673,"_5":14121,"_26960":116502,"_2870":116674},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3383":69563,"_29651":69488,"_20578":116676,"_5":14121,"_26960":116502,"_2870":51257},[],{"_3383":69564,"_29651":69488,"_20578":116678,"_5":14121,"_26960":116502,"_2870":116679},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3383":69565,"_29651":69488,"_20578":116681,"_5":14121,"_26960":116502,"_2870":51263},[],{"_3383":69566,"_29651":69488,"_20578":116683,"_5":14121,"_26960":116502,"_2870":116684},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3383":69567,"_29651":69488,"_20578":116686,"_5":14121,"_26960":116502,"_2870":51269},[],{"_3383":69568,"_29651":69488,"_20578":116688,"_5":14121,"_26960":116502,"_2870":116689},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3383":69569,"_29651":69488,"_20578":116691,"_5":14121,"_26960":116502,"_2870":51275},[],{"_3383":69570,"_29651":69488,"_20578":116693,"_5":14121,"_26960":116502,"_2870":116694},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3383":69571,"_29651":69488,"_20578":116696,"_5":14121,"_26960":116502,"_2870":116697},[],"Reglas de esa configuración:",{"_3383":69572,"_29651":69488,"_20578":116699,"_5":14121,"_26960":116502,"_2870":116700},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3383":69573,"_29651":69488,"_20578":116702,"_5":14121,"_26960":116502,"_2870":116703},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3383":69574,"_29651":69488,"_20578":116705,"_5":14121,"_26960":116502,"_2870":116706},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3383":69575,"_29651":69488,"_20578":116708,"_5":14121,"_26960":116502,"_2870":116709},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3383":69576,"_29651":69488,"_20578":116711,"_5":14121,"_26960":116502,"_2870":116712},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3383":69577,"_29651":69488,"_20578":116714,"_5":14121,"_26960":116502,"_2870":116715},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3383":69578,"_29651":69488,"_20578":116717,"_5":14121,"_26960":116502,"_2870":116718},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento, con los mismos campos Log Level, Call Timeout, HTTP Authentication y credenciales que los canales webhook, además de un interruptor **Skip TLS Verification** (desactivado por defecto, así que la verificación permanece activa; la consola avisa cuando lo activas).",{"_3383":69579,"_29651":69488,"_20578":116720,"_5":14121,"_26960":116502,"_2870":116721},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Para corregirlo en la consola, abre el DMS, sustituye cualquier valor de ruta de fichero por contenido PEM — el editor rechaza las rutas de fichero con un error en el propio campo — y guarda. Al guardar se reescribe `external_webhook_settings.config` con las claves actuales, y la consola lee tanto el PEM sin codificar como el codificado en Base64 de las configuraciones migradas, y almacena el material codificado en Base64. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3383":69580,"_29651":69488,"_20578":116723,"_5":14121,"_26960":116502,"_2870":116724},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3383":69581,"_29651":69488,"_20578":116726,"_5":14121,"_26960":116506,"_2870":116727},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3383":69582,"_29651":69488,"_20578":116729,"_5":14121,"_26960":116510,"_2870":116730},[],"Campo de `settings.reenrollment_settings`",{"_3383":69583,"_29651":69488,"_20578":116732,"_5":14121,"_26960":116510,"_2870":116733},[],"Función",{"_3383":69584,"_29651":69488,"_20578":116735,"_5":14121,"_26960":116510,"_2870":51319},[],{"_3383":69585,"_29651":69488,"_20578":116737,"_5":14121,"_26960":116510,"_2870":116738},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3383":69586,"_29651":69488,"_20578":116740,"_5":14121,"_26960":116510,"_2870":51325},[],{"_3383":69587,"_29651":69488,"_20578":116742,"_5":14121,"_26960":116510,"_2870":116743},[],"Umbral operativo preventivo de monitorización.",{"_3383":69588,"_29651":69488,"_20578":116745,"_5":14121,"_26960":116510,"_2870":51331},[],{"_3383":69589,"_29651":69488,"_20578":116747,"_5":14121,"_26960":116510,"_2870":116748},[],"Umbral operativo crítico de monitorización.",{"_3383":69590,"_29651":69488,"_20578":116750,"_5":14121,"_26960":116510,"_2870":51337},[],{"_3383":69591,"_29651":69488,"_20578":116752,"_5":14121,"_26960":116510,"_2870":116753},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3383":69592,"_29651":69488,"_20578":116755,"_5":14121,"_26960":116510,"_2870":51343},[],{"_3383":69593,"_29651":69488,"_20578":116757,"_5":14121,"_26960":116510,"_2870":116758},[],"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3383":69594,"_29651":69488,"_20578":116760,"_5":14121,"_26960":116510,"_2870":51349},[],{"_3383":69595,"_29651":69488,"_20578":116762,"_5":14121,"_26960":116510,"_2870":116763},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3383":69596,"_29651":69488,"_20578":116765,"_5":14121,"_26960":116510,"_2870":116766},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_3383":69597,"_29651":69488,"_20578":116768,"_5":14121,"_26960":116514,"_2870":116769},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_3383":69598,"_29651":69488,"_20578":116771,"_5":14121,"_26960":116517,"_2870":114137},[],{"_3383":69599,"_29651":69488,"_20578":116773,"_5":14121,"_26960":116517,"_2870":116774},[],"Qué publica",{"_3383":69600,"_29651":69488,"_20578":116776,"_5":14121,"_26960":116517,"_2870":51366},[],{"_3383":69601,"_29651":69488,"_20578":116778,"_5":14121,"_26960":116517,"_2870":116779},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3383":69602,"_29651":69488,"_20578":116781,"_5":14121,"_26960":116517,"_2870":51372},[],{"_3383":69603,"_29651":69488,"_20578":116783,"_5":14121,"_26960":116517,"_2870":116784},[],"Certificado de la CA emisora seleccionada.",{"_3383":69604,"_29651":69488,"_20578":116786,"_5":14121,"_26960":116517,"_2870":51378},[],{"_3383":69605,"_29651":69488,"_20578":116788,"_5":14121,"_26960":116517,"_2870":116789},[],"Certificados de las CAs elegidas explícitamente.",{"_3383":69606,"_29651":69488,"_20578":116791,"_5":14121,"_26960":116517,"_2870":116792},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_3383":69607,"_29651":69488,"_20578":116794,"_5":14121,"_26960":116521,"_2870":116795},[],"**Edit** cambia nombre, ajustes y metadatos. Las actualizaciones se realizan mediante la API de DMS. `PUT /v1/dms/{id}` siempre actúa sobre el DMS identificado en la ruta de la URL: el cuerpo no lleva campo `id`, y cualquier `id` o `creation_ts` que contenga se ignora silenciosamente; la autorización se evalúa contra ese mismo identificador de la ruta. El cuerpo debe incluir un `name` no vacío y un objeto `settings`; si falta alguno, la respuesta es HTTP 400 y el DMS almacenado no se modifica. `name` y `settings` se sustituyen siempre por completo, así que lee el DMS antes de enviar una edición por API para no perder campos. `metadata` es opcional: si se omite o se envía `null`, se conservan los metadatos almacenados; un objeto suministrado los sustituye por completo; `{}` los borra (una consulta GET posterior devuelve un objeto vacío, no `null`). Los cuerpos al estilo antiguo que transportan el DMS completo siguen funcionando mientras incluyan `name` y `settings`; los campos desconocidos se ignoran. La actualización rechaza un `name` vacío con HTTP 400: un DMS cuyo nombre almacenado quedó vacío por una actualización anterior debe renombrarse antes de que cualquier cliente lo vuelva a leer y reenviar, incluida la escritura de vuelta del conector de AWS IoT en modo JITP. Si el objeto no incluye la clave del conector de AWS IoT (`lamassu.io/iot/{connector_id}`), el conector ignora los eventos siguientes del DMS.",{"_3383":69608,"_29651":69488,"_20578":116797,"_5":14121,"_26960":116521,"_2870":116798},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3383":69609,"_29651":69488,"_20578":116800,"_5":14121,"_26960":116521,"_2870":116801},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3383":69610,"_29651":69488,"_20578":116803,"_5":14121,"_26960":116525,"_2870":116804},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3383":69611,"_29651":69611,"_5":14473,"_2870":116806,"_30004":116807,"_20578":116808,"_26960":69611},"Integra el cliente EST",[48280,115195,50759,116204,116379],[],{"_3383":69612,"_29651":69611,"_20578":116810,"_5":14121,"_26960":69611,"_2870":116811},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_3383":69613,"_29651":69611,"_5":30001,"_20578":116813,"_26960":116814,"_2870":113773},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_3383":69614,"_29651":69611,"_5":30001,"_20578":116816,"_26960":116817,"_2870":116818},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_3383":69615,"_29651":69611,"_5":30001,"_20578":116820,"_26960":116821,"_2870":116822},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_3383":69616,"_29651":69611,"_5":30001,"_20578":116824,"_26960":116825,"_2870":116826},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_3383":69617,"_29651":69611,"_5":30001,"_20578":116828,"_26960":116829,"_2870":116830},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_3383":69618,"_29651":69611,"_5":30001,"_20578":116832,"_26960":116833,"_2870":116834},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_3383":69619,"_29651":69611,"_20578":116836,"_5":14121,"_26960":69611,"_2870":116837},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_3383":69620,"_29651":69611,"_20578":116839,"_5":14121,"_26960":116814,"_2870":116840},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3383":69621,"_29651":69611,"_20578":116842,"_5":14121,"_26960":116814,"_2870":116843},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3383":69622,"_29651":69611,"_20578":116845,"_5":14121,"_26960":116814,"_2870":116846},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3383":69623,"_29651":69611,"_20578":116848,"_5":14121,"_26960":116817,"_2870":116849},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_3383":69624,"_29651":69611,"_20578":116851,"_5":14121,"_26960":116817,"_2870":116852},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3383":69625,"_29651":69611,"_20578":116854,"_5":14121,"_26960":116821,"_2870":116855},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3383":69626,"_29651":69611,"_20578":116857,"_5":14121,"_26960":116821,"_2870":116858},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3383":69627,"_29651":69611,"_20578":116860,"_5":14121,"_26960":116825,"_2870":116861},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3383":69628,"_29651":69611,"_20578":116863,"_5":14121,"_26960":116825,"_2870":116864},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3383":69629,"_29651":69611,"_20578":116866,"_5":14121,"_26960":116829,"_2870":116867},[],"Para el caso de una raíz que emite directamente:",{"_3383":69630,"_29651":69611,"_20578":116869,"_5":14121,"_26960":116829,"_2870":116870},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3383":69631,"_29651":69611,"_20578":116872,"_5":14121,"_26960":116829,"_2870":116873},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3383":69632,"_29651":69611,"_20578":116875,"_5":14121,"_26960":116833,"_2870":116876},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_3383":69633,"_29651":69633,"_5":14473,"_2870":116878,"_30004":116879,"_20578":116880,"_26960":69633},"Referencia EST",[48280,115195,50759,116204,116379],[],{"_3383":69634,"_29651":69633,"_20578":116882,"_5":14121,"_26960":69633,"_2870":116883},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_3383":69635,"_29651":69633,"_5":30001,"_20578":116885,"_26960":116886,"_2870":116887},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_3383":69636,"_29651":69633,"_5":30001,"_20578":116889,"_26960":116890,"_2870":22306},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3383":69637,"_29651":69633,"_5":30001,"_20578":116892,"_26960":116893,"_2870":25596},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3383":69638,"_29651":69633,"_5":30001,"_20578":116895,"_26960":116896,"_2870":25603},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3383":69639,"_29651":69633,"_5":30001,"_20578":116898,"_26960":116899,"_2870":24926},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3383":69640,"_29651":69633,"_5":30001,"_20578":116901,"_26960":116902,"_2870":116903},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_3383":69641,"_29651":69633,"_5":30001,"_20578":116905,"_26960":116906,"_2870":116907},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_3383":69642,"_29651":69633,"_5":30001,"_20578":116909,"_26960":116910,"_2870":116911},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_3383":69643,"_29651":69633,"_20578":116913,"_5":14121,"_26960":69633,"_2870":116914},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_3383":69644,"_29651":69633,"_20578":116916,"_5":14121,"_26960":116886,"_2870":116917},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3383":69645,"_29651":69633,"_20578":116919,"_5":14121,"_26960":116886,"_2870":114955},[],{"_3383":69646,"_29651":69633,"_20578":116921,"_5":14121,"_26960":116886,"_2870":116922},[],"Método",{"_3383":69647,"_29651":69633,"_20578":116924,"_5":14121,"_26960":116886,"_2870":116925},[],"Autenticación y condición",{"_3383":69648,"_29651":69633,"_20578":116927,"_5":14121,"_26960":116886,"_2870":51521},[],{"_3383":69649,"_29651":69633,"_20578":116929,"_5":14121,"_26960":116886,"_2870":51524},[],{"_3383":69650,"_29651":69633,"_20578":116931,"_5":14121,"_26960":116886,"_2870":116932},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3383":69651,"_29651":69633,"_20578":116934,"_5":14121,"_26960":116886,"_2870":51530},[],{"_3383":69652,"_29651":69633,"_20578":116936,"_5":14121,"_26960":116886,"_2870":51533},[],{"_3383":69653,"_29651":69633,"_20578":116938,"_5":14121,"_26960":116886,"_2870":116939},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3383":69654,"_29651":69633,"_20578":116941,"_5":14121,"_26960":116886,"_2870":51539},[],{"_3383":69655,"_29651":69633,"_20578":116943,"_5":14121,"_26960":116886,"_2870":51533},[],{"_3383":69656,"_29651":69633,"_20578":116945,"_5":14121,"_26960":116886,"_2870":116946},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3383":69657,"_29651":69633,"_20578":116948,"_5":14121,"_26960":116886,"_2870":51547},[],{"_3383":69658,"_29651":69633,"_20578":116950,"_5":14121,"_26960":116886,"_2870":51533},[],{"_3383":69659,"_29651":69633,"_20578":116952,"_5":14121,"_26960":116886,"_2870":116953},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_3383":69660,"_29651":69633,"_20578":116955,"_5":14121,"_26960":116886,"_2870":116956},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3383":69661,"_29651":69633,"_20578":116958,"_5":14121,"_26960":116890,"_2870":116959},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_3383":69662,"_29651":69633,"_20578":116961,"_5":14121,"_26960":116890,"_2870":116962},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_3383":69663,"_29651":69633,"_20578":116964,"_5":14121,"_26960":116893,"_2870":116965},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_3383":69664,"_29651":69633,"_20578":116967,"_5":14121,"_26960":116893,"_2870":116968},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_3383":69665,"_29651":69633,"_20578":116970,"_5":14121,"_26960":116896,"_2870":116971},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_3383":69666,"_29651":69633,"_20578":116973,"_5":14121,"_26960":116896,"_2870":116974},[],"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_3383":69667,"_29651":69633,"_20578":116976,"_5":14121,"_26960":116899,"_2870":116977},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_3383":69668,"_29651":69633,"_20578":116979,"_5":14121,"_26960":116899,"_2870":116980},[],"El código admite RSA y ECDSA, y el valor `bits` del ajuste de clave del DMS significa algo distinto en cada caso. En ECDSA selecciona la curva: 224, 256, 384 o 521 corresponden a P-224, P-256, P-384 y P-521, y un tamaño no reconocido produce fallback a P-256, así que elige explícitamente un tamaño compatible y comprueba la clave resultante. En RSA se usa directamente como tamaño del módulo; la consola ofrece 2048, 3072 y 4096 bits. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_3383":69669,"_29651":69633,"_20578":116982,"_5":14121,"_26960":116902,"_2870":116983},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3383":69670,"_29651":69633,"_20578":116985,"_5":14121,"_26960":116902,"_2870":116986},[],"Parte",{"_3383":69671,"_29651":69633,"_20578":116988,"_5":14121,"_26960":116902,"_2870":116989},[],"Contenido tras decodificar su Base64",{"_3383":69672,"_29651":69633,"_20578":116991,"_5":14121,"_26960":116902,"_2870":51591},[],{"_3383":69673,"_29651":69633,"_20578":116993,"_5":14121,"_26960":116902,"_2870":116994},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3383":69674,"_29651":69633,"_20578":116996,"_5":14121,"_26960":116902,"_2870":51597},[],{"_3383":69675,"_29651":69633,"_20578":116998,"_5":14121,"_26960":116902,"_2870":116999},[],"PKCS#7 DER con el certificado emitido.",{"_3383":69676,"_29651":69633,"_20578":117001,"_5":14121,"_26960":116902,"_2870":117002},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3383":69677,"_29651":69633,"_20578":117004,"_5":14121,"_26960":116906,"_2870":117005},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3383":69678,"_29651":69633,"_20578":117007,"_5":14121,"_26960":116906,"_2870":117008},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_3383":69679,"_29651":69633,"_20578":117010,"_5":14121,"_26960":116906,"_2870":117011},[],"Convierte y comprueba el resultado:",{"_3383":69680,"_29651":69633,"_20578":117013,"_5":14121,"_26960":116906,"_2870":117014},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_3383":69681,"_29651":69633,"_20578":117016,"_5":14121,"_26960":116910,"_2870":117017},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3383":69682,"_29651":69633,"_20578":117019,"_5":14121,"_26960":116910,"_2870":117020},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3383":69683,"_29651":69683,"_5":14473,"_2870":116379,"_30004":117022,"_20578":117023,"_26960":69683},[48280,115195,50759,116204,116379],[],{"_3383":69684,"_29651":69683,"_20578":117025,"_5":14121,"_26960":69683,"_2870":117026},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_3383":69685,"_29651":69683,"_5":30001,"_20578":117028,"_26960":117029,"_2870":117030},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3383":69686,"_29651":69683,"_5":30001,"_20578":117032,"_26960":117033,"_2870":117034},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3383":69687,"_29651":69683,"_5":30001,"_20578":117036,"_26960":117037,"_2870":117038},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3383":69688,"_29651":69683,"_5":30001,"_20578":117040,"_26960":117041,"_2870":117042},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_3383":69689,"_29651":69683,"_20578":117044,"_5":14121,"_26960":69683,"_2870":117045},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3383":69690,"_29651":69683,"_20578":117047,"_5":14121,"_26960":117029,"_2870":117048},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3383":69691,"_29651":69683,"_20578":117050,"_5":14121,"_26960":117029,"_2870":117051},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3383":69692,"_29651":69683,"_20578":117053,"_5":14121,"_26960":117029,"_2870":117054},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3383":69693,"_29651":69683,"_20578":117056,"_5":14121,"_26960":117029,"_2870":117057},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3383":69694,"_29651":69683,"_20578":117059,"_5":14121,"_26960":117029,"_2870":117060},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3383":69695,"_29651":69683,"_20578":117062,"_5":14121,"_26960":117029,"_2870":117063},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3383":69696,"_29651":69683,"_20578":117065,"_5":14121,"_26960":117033,"_2870":117066},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3383":69697,"_29651":69683,"_20578":117068,"_5":14121,"_26960":117033,"_2870":117069},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3383":69698,"_29651":69683,"_20578":117071,"_5":14121,"_26960":117033,"_2870":117072},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3383":69699,"_29651":69683,"_20578":117074,"_5":14121,"_26960":117033,"_2870":117075},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3383":69700,"_29651":69683,"_20578":117077,"_5":14121,"_26960":117037,"_2870":117078},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3383":69701,"_29651":69683,"_20578":117080,"_5":14121,"_26960":117037,"_2870":117081},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3383":69702,"_29651":69683,"_20578":117083,"_5":14121,"_26960":117037,"_2870":117084},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3383":69703,"_29651":69683,"_20578":117086,"_5":14121,"_26960":117037,"_2870":117087},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3383":69704,"_29651":69683,"_20578":117089,"_5":14121,"_26960":117041,"_2870":117090},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_3383":69705,"_29651":69683,"_20578":117092,"_5":14121,"_26960":117041,"_2870":117093},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3383":69706,"_29651":69706,"_5":14473,"_2870":117095,"_30004":117096,"_20578":117097,"_26960":69706},"Estrategias de aprovisionamiento",[48280,115195,50759,116204,116379],[],{"_3383":69707,"_29651":69706,"_20578":117099,"_5":14121,"_26960":69706,"_2870":117100},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3383":69708,"_29651":69706,"_5":30001,"_20578":117102,"_26960":117103,"_2870":117104},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3383":69709,"_29651":69706,"_5":30001,"_20578":117106,"_26960":117107,"_2870":117108},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3383":69710,"_29651":69706,"_5":30001,"_20578":117110,"_26960":117111,"_2870":117112},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3383":69711,"_29651":69706,"_5":30001,"_20578":117114,"_26960":117115,"_2870":117116},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3383":69712,"_29651":69706,"_5":30001,"_20578":117118,"_26960":117119,"_2870":117120},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3383":69713,"_29651":69706,"_20578":117122,"_5":14121,"_26960":69706,"_2870":117123},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3383":69714,"_29651":69706,"_20578":117125,"_5":14121,"_26960":117103,"_2870":117126},[],"Recorrido",{"_3383":69715,"_29651":69706,"_20578":117128,"_5":14121,"_26960":117103,"_2870":117129},[],"Cuándo existe el dispositivo",{"_3383":69716,"_29651":69706,"_20578":117131,"_5":14121,"_26960":117103,"_2870":117132},[],"Qué compruebas",{"_3383":69717,"_29651":69706,"_20578":117134,"_5":14121,"_26960":117103,"_2870":117135},[],"Asignación manual",{"_3383":69718,"_29651":69706,"_20578":117137,"_5":14121,"_26960":117103,"_2870":117138},[],"El operador lo crea antes de asociar un certificado.",{"_3383":69719,"_29651":69706,"_20578":117140,"_5":14121,"_26960":117103,"_2870":117141},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3383":69720,"_29651":69706,"_20578":117143,"_5":14121,"_26960":117103,"_2870":117144},[],"EST con `JITP`",{"_3383":69721,"_29651":69706,"_20578":117146,"_5":14121,"_26960":117103,"_2870":117147},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3383":69722,"_29651":69706,"_20578":117149,"_5":14121,"_26960":117103,"_2870":117150},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3383":69723,"_29651":69706,"_20578":117152,"_5":14121,"_26960":117103,"_2870":117153},[],"EST con `PRE_REGISTRATION`",{"_3383":69724,"_29651":69706,"_20578":117155,"_5":14121,"_26960":117103,"_2870":117156},[],"Debe existir antes de `/simpleenroll`.",{"_3383":69725,"_29651":69706,"_20578":117158,"_5":14121,"_26960":117103,"_2870":117159},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3383":69726,"_29651":69706,"_20578":117161,"_5":14121,"_26960":117103,"_2870":117162},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3383":69727,"_29651":69706,"_20578":117164,"_5":14121,"_26960":117103,"_2870":117165},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3383":69728,"_29651":69706,"_20578":117167,"_5":14121,"_26960":117107,"_2870":117168},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3383":69729,"_29651":69706,"_20578":117170,"_5":14121,"_26960":117107,"_2870":117171},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3383":69730,"_29651":69706,"_20578":117173,"_5":14121,"_26960":117107,"_2870":117174},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3383":69731,"_29651":69706,"_20578":117176,"_5":14121,"_26960":117111,"_2870":117177},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3383":69732,"_29651":69706,"_20578":117179,"_5":14121,"_26960":117111,"_2870":117180},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3383":69733,"_29651":69706,"_20578":117182,"_5":14121,"_26960":117111,"_2870":117183},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3383":69734,"_29651":69706,"_20578":117185,"_5":14121,"_26960":117111,"_2870":117186},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3383":69735,"_29651":69706,"_20578":117188,"_5":14121,"_26960":117111,"_2870":117189},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3383":69736,"_29651":69706,"_20578":117191,"_5":14121,"_26960":117111,"_2870":117192},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3383":69737,"_29651":69706,"_20578":117194,"_5":14121,"_26960":117115,"_2870":114137},[],{"_3383":69738,"_29651":69706,"_20578":117196,"_5":14121,"_26960":117115,"_2870":117197},[],"Material que atraviesa EST",{"_3383":69739,"_29651":69706,"_20578":117199,"_5":14121,"_26960":117115,"_2870":117200},[],"Clave generada por el dispositivo",{"_3383":69740,"_29651":69706,"_20578":117202,"_5":14121,"_26960":117115,"_2870":117203},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3383":69741,"_29651":69706,"_20578":117205,"_5":14121,"_26960":117115,"_2870":117206},[],"Clave ya disponible en el dispositivo",{"_3383":69742,"_29651":69706,"_20578":117208,"_5":14121,"_26960":117115,"_2870":117209},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3383":69743,"_29651":69706,"_20578":117211,"_5":14121,"_26960":117115,"_2870":51078},[],{"_3383":69744,"_29651":69706,"_20578":117213,"_5":14121,"_26960":117115,"_2870":117214},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3383":69745,"_29651":69706,"_20578":117216,"_5":14121,"_26960":117115,"_2870":117217},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3383":69746,"_29651":69706,"_20578":117219,"_5":14121,"_26960":117119,"_2870":117220},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3383":69747,"_29651":69747,"_5":14473,"_2870":117222,"_30004":117223,"_20578":117224,"_26960":69747},"Renovación y recuperación",[48280,115195,50759,116204,116379],[],{"_3383":69748,"_29651":69747,"_20578":117226,"_5":14121,"_26960":69747,"_2870":117227},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_3383":69749,"_29651":69747,"_5":30001,"_20578":117229,"_26960":117230,"_2870":117231},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_3383":69750,"_29651":69747,"_5":30001,"_20578":117233,"_26960":117234,"_2870":117235},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_3383":69751,"_29651":69747,"_5":30001,"_20578":117237,"_26960":117238,"_2870":117239},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_3383":69752,"_29651":69747,"_5":30001,"_20578":117241,"_26960":117242,"_2870":117243},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_3383":69753,"_29651":69747,"_5":30001,"_20578":117245,"_26960":117246,"_2870":117247},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_3383":69754,"_29651":69747,"_20578":117249,"_5":14121,"_26960":69747,"_2870":117250},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_3383":69755,"_29651":69747,"_20578":117252,"_5":14121,"_26960":117230,"_2870":117253},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3383":69756,"_29651":69747,"_20578":117255,"_5":14121,"_26960":117230,"_2870":117256},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3383":69757,"_29651":69747,"_20578":117258,"_5":14121,"_26960":117230,"_2870":117259},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3383":69758,"_29651":69747,"_20578":117261,"_5":14121,"_26960":117230,"_2870":117262},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3383":69759,"_29651":69747,"_20578":117264,"_5":14121,"_26960":117234,"_2870":117265},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3383":69760,"_29651":69747,"_20578":117267,"_5":14121,"_26960":117234,"_2870":117268},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3383":69761,"_29651":69747,"_20578":117270,"_5":14121,"_26960":117238,"_2870":117271},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3383":69762,"_29651":69747,"_20578":117273,"_5":14121,"_26960":117238,"_2870":117274},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3383":69763,"_29651":69747,"_20578":117276,"_5":14121,"_26960":117238,"_2870":117277},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3383":69764,"_29651":69747,"_20578":117279,"_5":14121,"_26960":117242,"_2870":117280},[],"Situación",{"_3383":69765,"_29651":69747,"_20578":117282,"_5":14121,"_26960":117242,"_2870":117283},[],"Procedimiento",{"_3383":69766,"_29651":69747,"_20578":117285,"_5":14121,"_26960":117242,"_2870":117286},[],"Certificado vigente, fuera de ventana",{"_3383":69767,"_29651":69747,"_20578":117288,"_5":14121,"_26960":117242,"_2870":117289},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3383":69768,"_29651":69747,"_20578":117291,"_5":14121,"_26960":117242,"_2870":117292},[],"Certificado vencido, clave disponible",{"_3383":69769,"_29651":69747,"_20578":117294,"_5":14121,"_26960":117242,"_2870":117295},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3383":69770,"_29651":69747,"_20578":117297,"_5":14121,"_26960":117242,"_2870":117298},[],"Renovación por webhook o `NO_AUTH`",{"_3383":69771,"_29651":69747,"_20578":117300,"_5":14121,"_26960":117242,"_2870":117301},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3383":69772,"_29651":69747,"_20578":117303,"_5":14121,"_26960":117242,"_2870":117304},[],"Clave perdida o inaccesible",{"_3383":69773,"_29651":69747,"_20578":117306,"_5":14121,"_26960":117242,"_2870":117307},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3383":69774,"_29651":69747,"_20578":117309,"_5":14121,"_26960":117242,"_2870":117310},[],"Identidad actual revocada",{"_3383":69775,"_29651":69747,"_20578":117312,"_5":14121,"_26960":117242,"_2870":117313},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3383":69776,"_29651":69747,"_20578":117315,"_5":14121,"_26960":117242,"_2870":117316},[],"Dispositivo sin identidad",{"_3383":69777,"_29651":69747,"_20578":117318,"_5":14121,"_26960":117242,"_2870":117319},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3383":69778,"_29651":69747,"_20578":117321,"_5":14121,"_26960":117242,"_2870":117322},[],"Dispositivo retirado",{"_3383":69779,"_29651":69747,"_20578":117324,"_5":14121,"_26960":117242,"_2870":117325},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3383":69780,"_29651":69747,"_20578":117327,"_5":14121,"_26960":117242,"_2870":117328},[],"Timeout, HTTP 500 o fallo de instalación",{"_3383":69781,"_29651":69747,"_20578":117330,"_5":14121,"_26960":117242,"_2870":117331},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3383":69782,"_29651":69747,"_20578":117333,"_5":14121,"_26960":117246,"_2870":117334},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3383":69783,"_29651":69747,"_20578":117336,"_5":14121,"_26960":117246,"_2870":117337},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3383":69784,"_29651":69784,"_5":14473,"_2870":117339,"_30004":117340,"_20578":117341,"_26960":69784},"Diagnóstico de enrolamiento",[48280,115195,50759,116204,116379],[],{"_3383":69785,"_29651":69784,"_20578":117343,"_5":14121,"_26960":69784,"_2870":117344},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3383":69786,"_29651":69784,"_5":30001,"_20578":117346,"_26960":117347,"_2870":117348},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3383":69787,"_29651":69784,"_5":30001,"_20578":117350,"_26960":117351,"_2870":117352},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3383":69788,"_29651":69784,"_5":30001,"_20578":117354,"_26960":117355,"_2870":116911},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_3383":69789,"_29651":69784,"_5":30001,"_20578":117357,"_26960":117358,"_2870":117359},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3383":69790,"_29651":69784,"_20578":117361,"_5":14121,"_26960":69784,"_2870":117362},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3383":69791,"_29651":69784,"_20578":117364,"_5":14121,"_26960":117351,"_2870":117365},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3383":69792,"_29651":69784,"_20578":117367,"_5":14121,"_26960":117351,"_2870":117368},[],"Síntoma o mensaje",{"_3383":69793,"_29651":69784,"_20578":117370,"_5":14121,"_26960":117351,"_2870":117371},[],"Qué revisar",{"_3383":69794,"_29651":69784,"_20578":117373,"_5":14121,"_26960":117351,"_2870":117374},[],"curl rechaza TLS, nombre o emisor",{"_3383":69795,"_29651":69784,"_20578":117376,"_5":14121,"_26960":117351,"_2870":117377},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3383":69796,"_29651":69784,"_20578":117379,"_5":14121,"_26960":117351,"_2870":117380},[],"404 o APS ausente",{"_3383":69797,"_29651":69784,"_20578":117382,"_5":14121,"_26960":117351,"_2870":117383},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3383":69798,"_29651":69784,"_20578":117385,"_5":14121,"_26960":117351,"_2870":117386},[],"400, error de CSR o formato",{"_3383":69799,"_29651":69784,"_20578":117388,"_5":14121,"_26960":117351,"_2870":117389},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3383":69800,"_29651":69784,"_20578":117391,"_5":14121,"_26960":117351,"_2870":117392},[],"Credencial ausente o certificado no válido",{"_3383":69801,"_29651":69784,"_20578":117394,"_5":14121,"_26960":117351,"_2870":117395},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3383":69802,"_29651":69784,"_20578":117397,"_5":14121,"_26960":117351,"_2870":117398},[],"Webhook deniega, expira o responde sin autorización",{"_3383":69803,"_29651":69784,"_20578":117400,"_5":14121,"_26960":117351,"_2870":117401},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3383":69804,"_29651":69784,"_20578":117403,"_5":14121,"_26960":117351,"_2870":52004},[],{"_3383":69805,"_29651":69784,"_20578":117405,"_5":14121,"_26960":117351,"_2870":117406},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3383":69806,"_29651":69784,"_20578":117408,"_5":14121,"_26960":117351,"_2870":52010},[],{"_3383":69807,"_29651":69784,"_20578":117410,"_5":14121,"_26960":117351,"_2870":117411},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3383":69808,"_29651":69784,"_20578":117413,"_5":14121,"_26960":117351,"_2870":52016},[],{"_3383":69809,"_29651":69784,"_20578":117415,"_5":14121,"_26960":117351,"_2870":117416},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3383":69810,"_29651":69784,"_20578":117418,"_5":14121,"_26960":117351,"_2870":52022},[],{"_3383":69811,"_29651":69784,"_20578":117420,"_5":14121,"_26960":117351,"_2870":117421},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3383":69812,"_29651":69784,"_20578":117423,"_5":14121,"_26960":117351,"_2870":52028},[],{"_3383":69813,"_29651":69784,"_20578":117425,"_5":14121,"_26960":117351,"_2870":117426},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3383":69814,"_29651":69784,"_20578":117428,"_5":14121,"_26960":117351,"_2870":117429},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3383":69815,"_29651":69784,"_20578":117431,"_5":14121,"_26960":117351,"_2870":117432},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3383":69816,"_29651":69784,"_20578":117434,"_5":14121,"_26960":117351,"_2870":117435},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3383":69817,"_29651":69784,"_20578":117437,"_5":14121,"_26960":117351,"_2870":117438},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3383":69818,"_29651":69784,"_20578":117440,"_5":14121,"_26960":117351,"_2870":52046},[],{"_3383":69819,"_29651":69784,"_20578":117442,"_5":14121,"_26960":117351,"_2870":117443},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3383":69820,"_29651":69784,"_20578":117445,"_5":14121,"_26960":117351,"_2870":52052},[],{"_3383":69821,"_29651":69784,"_20578":117447,"_5":14121,"_26960":117351,"_2870":117448},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3383":69822,"_29651":69784,"_20578":117450,"_5":14121,"_26960":117351,"_2870":117451},[],"DMS propietario distinto",{"_3383":69823,"_29651":69784,"_20578":117453,"_5":14121,"_26960":117351,"_2870":117454},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3383":69824,"_29651":69784,"_20578":117456,"_5":14121,"_26960":117351,"_2870":52064},[],{"_3383":69825,"_29651":69784,"_20578":117458,"_5":14121,"_26960":117351,"_2870":117459},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3383":69826,"_29651":69784,"_20578":117461,"_5":14121,"_26960":117351,"_2870":52070},[],{"_3383":69827,"_29651":69784,"_20578":117463,"_5":14121,"_26960":117351,"_2870":117464},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3383":69828,"_29651":69784,"_20578":117466,"_5":14121,"_26960":117351,"_2870":117467},[],"Certificado actual revocado",{"_3383":69829,"_29651":69784,"_20578":117469,"_5":14121,"_26960":117351,"_2870":117470},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3383":69830,"_29651":69784,"_20578":117472,"_5":14121,"_26960":117351,"_2870":117473},[],"Error de CA, perfil o firma",{"_3383":69831,"_29651":69784,"_20578":117475,"_5":14121,"_26960":117351,"_2870":117476},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3383":69832,"_29651":69784,"_20578":117478,"_5":14121,"_26960":117351,"_2870":117479},[],"HTTP 200 sin conexión del dispositivo",{"_3383":69833,"_29651":69784,"_20578":117481,"_5":14121,"_26960":117351,"_2870":117482},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3383":69834,"_29651":69784,"_20578":117484,"_5":14121,"_26960":117351,"_2870":117485},[],"Timeout o error después de emitir",{"_3383":69835,"_29651":69784,"_20578":117487,"_5":14121,"_26960":117351,"_2870":117488},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3383":69836,"_29651":69784,"_20578":117490,"_5":14121,"_26960":117355,"_2870":117491},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3383":69837,"_29651":69784,"_20578":117493,"_5":14121,"_26960":117355,"_2870":117494},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_3383":69838,"_29651":69784,"_20578":117496,"_5":14121,"_26960":117358,"_2870":117497},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3383":69839,"_29651":69784,"_20578":117499,"_5":14121,"_26960":117358,"_2870":117500},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3383":69840,"_29651":69784,"_20578":117502,"_5":14121,"_26960":117358,"_2870":117503},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3383":69841,"_29651":69784,"_20578":117505,"_5":14121,"_26960":117358,"_2870":117506},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3383":69842,"_29651":69784,"_20578":117508,"_5":14121,"_26960":117358,"_2870":117509},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3383":69843,"_29651":69784,"_20578":117511,"_5":14121,"_26960":117358,"_2870":117512},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3383":69844,"_29651":69784,"_20578":117514,"_5":14121,"_26960":117358,"_2870":117515},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3383":69845,"_29651":69845,"_5":14473,"_2870":117517,"_30004":117518,"_20578":117519,"_26960":69845},"Distribución y actualización de confianza",[48280,115195,50759,116204,116379],[],{"_3383":69846,"_29651":69845,"_20578":117521,"_5":14121,"_26960":69845,"_2870":117522},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_3383":69847,"_29651":69845,"_5":30001,"_20578":117524,"_26960":117525,"_2870":117526},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_3383":69848,"_29651":69845,"_5":30001,"_20578":117528,"_26960":117529,"_2870":117530},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_3383":69849,"_29651":69845,"_5":30001,"_20578":117532,"_26960":117533,"_2870":117534},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_3383":69850,"_29651":69845,"_5":30001,"_20578":117536,"_26960":117537,"_2870":117538},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_3383":69851,"_29651":69845,"_5":30001,"_20578":117540,"_26960":117541,"_2870":117542},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_3383":69852,"_29651":69845,"_20578":117544,"_5":14121,"_26960":69845,"_2870":117545},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_3383":69853,"_29651":69845,"_20578":117547,"_5":14121,"_26960":117525,"_2870":117548},[],"Relación",{"_3383":69854,"_29651":69845,"_20578":117550,"_5":14121,"_26960":117525,"_2870":117551},[],"Material que prepara el responsable",{"_3383":69855,"_29651":69845,"_20578":117553,"_5":14121,"_26960":117525,"_2870":117554},[],"Dispositivo → servidor EST",{"_3383":69856,"_29651":69845,"_20578":117556,"_5":14121,"_26960":117525,"_2870":117557},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_3383":69857,"_29651":69845,"_20578":117559,"_5":14121,"_26960":117525,"_2870":117560},[],"DMS → solicitante",{"_3383":69858,"_29651":69845,"_20578":117562,"_5":14121,"_26960":117525,"_2870":117563},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_3383":69859,"_29651":69845,"_20578":117565,"_5":14121,"_26960":117525,"_2870":117566},[],"Consumidor → dispositivo",{"_3383":69860,"_29651":69845,"_20578":117568,"_5":14121,"_26960":117525,"_2870":117569},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_3383":69861,"_29651":69845,"_20578":117571,"_5":14121,"_26960":117525,"_2870":117572},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_3383":69862,"_29651":69845,"_20578":117574,"_5":14121,"_26960":117529,"_2870":117575},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3383":69863,"_29651":69845,"_20578":117577,"_5":14121,"_26960":117529,"_2870":117578},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3383":69864,"_29651":69845,"_20578":117580,"_5":14121,"_26960":117533,"_2870":117581},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_3383":69865,"_29651":69845,"_20578":117583,"_5":14121,"_26960":117533,"_2870":117584},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_3383":69866,"_29651":69845,"_20578":117586,"_5":14121,"_26960":117533,"_2870":117587},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_3383":69867,"_29651":69845,"_20578":117589,"_5":14121,"_26960":117533,"_2870":117590},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_3383":69868,"_29651":69845,"_20578":117592,"_5":14121,"_26960":117533,"_2870":117593},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_3383":69869,"_29651":69845,"_20578":117595,"_5":14121,"_26960":117533,"_2870":117596},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_3383":69870,"_29651":69845,"_20578":117598,"_5":14121,"_26960":117537,"_2870":117599},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_3383":69871,"_29651":69845,"_20578":117601,"_5":14121,"_26960":117537,"_2870":117602},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_3383":69872,"_29651":69845,"_20578":117604,"_5":14121,"_26960":117537,"_2870":117605},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_3383":69873,"_29651":69845,"_20578":117607,"_5":14121,"_26960":117541,"_2870":117608},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_3383":69874,"_29651":69874,"_5":14473,"_2870":52219,"_30004":117610,"_20578":117612,"_26960":69874},[48280,115195,50759,116204,117611],"Integraciones",[],{"_3383":69875,"_29651":69874,"_20578":117614,"_5":14121,"_26960":69874,"_2870":117615},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3383":69876,"_29651":69874,"_5":30001,"_20578":117617,"_26960":117618,"_2870":117619},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3383":69877,"_29651":69874,"_5":30001,"_20578":117621,"_26960":117622,"_2870":117623},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3383":69878,"_29651":69874,"_5":30001,"_20578":117625,"_26960":117626,"_2870":117627},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3383":69879,"_29651":69874,"_5":30001,"_20578":117629,"_26960":117630,"_2870":117631},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3383":69880,"_29651":69874,"_5":30001,"_20578":117633,"_26960":117634,"_2870":117635},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","Eventos y recursos de AWS",{"_3383":69881,"_29651":69874,"_5":30001,"_20578":117637,"_26960":117638,"_2870":117639},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3383":69882,"_29651":69874,"_5":30001,"_20578":117641,"_26960":117642,"_2870":117643},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3383":69883,"_29651":69874,"_5":30001,"_20578":117645,"_26960":117646,"_2870":117647},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","Estados del registro de la CA",{"_3383":69884,"_29651":69874,"_5":30001,"_20578":117649,"_26960":117650,"_2870":52261},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3383":69885,"_29651":69874,"_5":30001,"_20578":117652,"_26960":117653,"_2870":52265},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3383":69886,"_29651":69874,"_5":30001,"_20578":117655,"_26960":117656,"_2870":117657},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3383":69887,"_29651":69874,"_5":30001,"_20578":117659,"_26960":117660,"_2870":117661},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3383":69888,"_29651":69874,"_5":30001,"_20578":117663,"_26960":117664,"_2870":117665},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3383":69889,"_29651":69874,"_5":30001,"_20578":117667,"_26960":117668,"_2870":117669},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3383":69890,"_29651":69874,"_5":30001,"_20578":117671,"_26960":117672,"_2870":117673},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","Estados del modo de registro del DMS",{"_3383":69891,"_29651":69874,"_5":30001,"_20578":117675,"_26960":117676,"_2870":117677},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3383":69892,"_29651":69874,"_5":30001,"_20578":117679,"_26960":117680,"_2870":117681},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","Ciclo de vida del Thing",{"_3383":69893,"_29651":69874,"_5":30001,"_20578":117683,"_26960":117684,"_2870":117685},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3383":69894,"_29651":69874,"_5":30001,"_20578":117687,"_26960":117688,"_2870":117689},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3383":69895,"_29651":69874,"_5":30001,"_20578":117691,"_26960":117692,"_2870":117693},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","Estados del certificado",{"_3383":69896,"_29651":69874,"_5":30001,"_20578":117695,"_26960":117696,"_2870":117697},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3383":69897,"_29651":69874,"_5":30001,"_20578":117699,"_26960":117700,"_2870":117701},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3383":69898,"_29651":69874,"_5":30001,"_20578":117703,"_26960":117704,"_2870":117705},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3383":69899,"_29651":69874,"_5":30001,"_20578":117707,"_26960":117708,"_2870":117709},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3383":69900,"_29651":69874,"_5":30001,"_20578":117711,"_26960":117712,"_2870":117713},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3383":69901,"_29651":69874,"_20578":117715,"_5":14121,"_26960":69874,"_2870":117716},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3383":69902,"_29651":69874,"_20578":117718,"_5":14121,"_26960":69874,"_2870":117719},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3383":69903,"_29651":69874,"_20578":117721,"_5":14121,"_26960":69874,"_2870":117722},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3383":69904,"_29651":69874,"_20578":117724,"_5":14121,"_26960":117618,"_2870":117725},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3383":69905,"_29651":69874,"_20578":117727,"_5":14121,"_26960":117618,"_2870":117728},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3383":69906,"_29651":69874,"_20578":117730,"_5":14121,"_26960":117618,"_2870":117731},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3383":69907,"_29651":69874,"_20578":117733,"_5":14121,"_26960":117618,"_2870":117734},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3383":69908,"_29651":69874,"_20578":117736,"_5":14121,"_26960":117622,"_2870":117737},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3383":69909,"_29651":69874,"_20578":117739,"_5":14121,"_26960":117626,"_2870":117740},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3383":69910,"_29651":69874,"_20578":117742,"_5":14121,"_26960":117626,"_2870":117743},[],"Acción IAM",{"_3383":69911,"_29651":69874,"_20578":117745,"_5":14121,"_26960":117626,"_2870":114143},[],{"_3383":69912,"_29651":69874,"_20578":117747,"_5":14121,"_26960":117626,"_2870":52360},[],{"_3383":69913,"_29651":69874,"_20578":117749,"_5":14121,"_26960":117626,"_2870":117750},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3383":69914,"_29651":69874,"_20578":117752,"_5":14121,"_26960":117626,"_2870":52366},[],{"_3383":69915,"_29651":69874,"_20578":117754,"_5":14121,"_26960":117626,"_2870":117755},[],"Registrar la CA en AWS IoT",{"_3383":69916,"_29651":69874,"_20578":117757,"_5":14121,"_26960":117626,"_2870":52372},[],{"_3383":69917,"_29651":69874,"_20578":117759,"_5":14121,"_26960":117626,"_2870":117760},[],"Consultar el estado del registro de la CA",{"_3383":69918,"_29651":69874,"_20578":117762,"_5":14121,"_26960":117626,"_2870":52378},[],{"_3383":69919,"_29651":69874,"_20578":117764,"_5":14121,"_26960":117626,"_2870":117765},[],"Crear o actualizar Things en IoT Core",{"_3383":69920,"_29651":69874,"_20578":117767,"_5":14121,"_26960":117626,"_2870":52384},[],{"_3383":69921,"_29651":69874,"_20578":117769,"_5":14121,"_26960":117626,"_2870":117770},[],"Aprovisionar Things mediante plantilla",{"_3383":69922,"_29651":69874,"_20578":117772,"_5":14121,"_26960":117626,"_2870":52390},[],{"_3383":69923,"_29651":69874,"_20578":117774,"_5":14121,"_26960":117626,"_2870":117775},[],"Registrar certificados de dispositivo",{"_3383":69924,"_29651":69874,"_20578":117777,"_5":14121,"_26960":117626,"_2870":52396},[],{"_3383":69925,"_29651":69874,"_20578":117779,"_5":14121,"_26960":117626,"_2870":117780},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3383":69926,"_29651":69874,"_20578":117782,"_5":14121,"_26960":117626,"_2870":52402},[],{"_3383":69927,"_29651":69874,"_20578":117784,"_5":14121,"_26960":117626,"_2870":117785},[],"Crear y adjuntar políticas IoT",{"_3383":69928,"_29651":69874,"_20578":117787,"_5":14121,"_26960":117626,"_2870":52408},[],{"_3383":69929,"_29651":69874,"_20578":117789,"_5":14121,"_26960":117626,"_2870":117790},[],"Gestionar grupos de Things",{"_3383":69930,"_29651":69874,"_20578":117792,"_5":14121,"_26960":117626,"_2870":52414},[],{"_3383":69931,"_29651":69874,"_20578":117794,"_5":14121,"_26960":117626,"_2870":117795},[],"Crear plantillas JITP",{"_3383":69932,"_29651":69874,"_20578":117797,"_5":14121,"_26960":117626,"_2870":52420},[],{"_3383":69933,"_29651":69874,"_20578":117799,"_5":14121,"_26960":117626,"_2870":117800},[],"Leer y escribir el Device Shadow",{"_3383":69934,"_29651":69874,"_20578":117802,"_5":14121,"_26960":117626,"_2870":117803},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3383":69935,"_29651":69874,"_20578":117805,"_5":14121,"_26960":117630,"_2870":117806},[],"Parámetro",{"_3383":69936,"_29651":69874,"_20578":117808,"_5":14121,"_26960":117630,"_2870":117809},[],"Tipo",{"_3383":69937,"_29651":69874,"_20578":117811,"_5":14121,"_26960":117630,"_2870":117812},[],"Requerido",{"_3383":69938,"_29651":69874,"_20578":117814,"_5":14121,"_26960":117630,"_2870":117815},[],"Descripción",{"_3383":69939,"_29651":69874,"_20578":117817,"_5":14121,"_26960":117630,"_2870":52441},[],{"_3383":69940,"_29651":69874,"_20578":117819,"_5":14121,"_26960":117630,"_2870":24582},[],{"_3383":69941,"_29651":69874,"_20578":117821,"_5":14121,"_26960":117630,"_2870":117822},[],"Sí",{"_3383":69942,"_29651":69874,"_20578":117824,"_5":14121,"_26960":117630,"_2870":117825},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3383":69943,"_29651":69874,"_20578":117827,"_5":14121,"_26960":117630,"_2870":52452},[],{"_3383":69944,"_29651":69874,"_20578":117829,"_5":14121,"_26960":117630,"_2870":24582},[],{"_3383":69945,"_29651":69874,"_20578":117831,"_5":14121,"_26960":117630,"_2870":117822},[],{"_3383":69946,"_29651":69874,"_20578":117833,"_5":14121,"_26960":117630,"_2870":117834},[],"Región AWS donde opera el conector.",{"_3383":69947,"_29651":69874,"_20578":117836,"_5":14121,"_26960":117630,"_2870":52462},[],{"_3383":69948,"_29651":69874,"_20578":117838,"_5":14121,"_26960":117630,"_2870":24582},[],{"_3383":69949,"_29651":69874,"_20578":117840,"_5":14121,"_26960":117630,"_2870":117822},[],{"_3383":69950,"_29651":69874,"_20578":117842,"_5":14121,"_26960":117630,"_2870":117843},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3383":69951,"_29651":69874,"_20578":117845,"_5":14121,"_26960":117630,"_2870":52472},[],{"_3383":69952,"_29651":69874,"_20578":117847,"_5":14121,"_26960":117630,"_2870":24582},[],{"_3383":69953,"_29651":69874,"_20578":117849,"_5":14121,"_26960":117630,"_2870":117850},[],"Solo con `auth_method=static`",{"_3383":69954,"_29651":69874,"_20578":117852,"_5":14121,"_26960":117630,"_2870":117853},[],"Clave de acceso AWS.",{"_3383":69955,"_29651":69874,"_20578":117855,"_5":14121,"_26960":117630,"_2870":52483},[],{"_3383":69956,"_29651":69874,"_20578":117857,"_5":14121,"_26960":117630,"_2870":24582},[],{"_3383":69957,"_29651":69874,"_20578":117859,"_5":14121,"_26960":117630,"_2870":117850},[],{"_3383":69958,"_29651":69874,"_20578":117861,"_5":14121,"_26960":117630,"_2870":117862},[],"Clave secreta AWS.",{"_3383":69959,"_29651":69874,"_20578":117864,"_5":14121,"_26960":117630,"_2870":52493},[],{"_3383":69960,"_29651":69874,"_20578":117866,"_5":14121,"_26960":117630,"_2870":24582},[],{"_3383":69961,"_29651":69874,"_20578":117868,"_5":14121,"_26960":117630,"_2870":52498},[],{"_3383":69962,"_29651":69874,"_20578":117870,"_5":14121,"_26960":117630,"_2870":117871},[],"Token de sesión (con `auth_method=static`).",{"_3383":69963,"_29651":69874,"_20578":117873,"_5":14121,"_26960":117630,"_2870":52504},[],{"_3383":69964,"_29651":69874,"_20578":117875,"_5":14121,"_26960":117630,"_2870":24582},[],{"_3383":69965,"_29651":69874,"_20578":117877,"_5":14121,"_26960":117630,"_2870":117878},[],"Solo con `auth_method=role`",{"_3383":69966,"_29651":69874,"_20578":117880,"_5":14121,"_26960":117630,"_2870":117881},[],"ARN del rol a asumir.",{"_3383":69967,"_29651":69874,"_20578":117883,"_5":14121,"_26960":117630,"_2870":52515},[],{"_3383":69968,"_29651":69874,"_20578":117885,"_5":14121,"_26960":117630,"_2870":24582},[],{"_3383":69969,"_29651":69874,"_20578":117887,"_5":14121,"_26960":117630,"_2870":52498},[],{"_3383":69970,"_29651":69874,"_20578":117889,"_5":14121,"_26960":117630,"_2870":117890},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3383":69971,"_29651":69874,"_20578":117892,"_5":14121,"_26960":117630,"_2870":52525},[],{"_3383":69972,"_29651":69874,"_20578":117894,"_5":14121,"_26960":117630,"_2870":87787},[],{"_3383":69973,"_29651":69874,"_20578":117896,"_5":14121,"_26960":117630,"_2870":117822},[],{"_3383":69974,"_29651":69874,"_20578":117898,"_5":14121,"_26960":117630,"_2870":117899},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3383":69975,"_29651":69874,"_20578":117901,"_5":14121,"_26960":117630,"_2870":52535},[],{"_3383":69976,"_29651":69874,"_20578":117903,"_5":14121,"_26960":117630,"_2870":24582},[],{"_3383":69977,"_29651":69874,"_20578":117905,"_5":14121,"_26960":117630,"_2870":117822},[],{"_3383":69978,"_29651":69874,"_20578":117907,"_5":14121,"_26960":117630,"_2870":117908},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3383":69979,"_29651":69874,"_20578":117910,"_5":14121,"_26960":117630,"_2870":52545},[],{"_3383":69980,"_29651":69874,"_20578":117912,"_5":14121,"_26960":117630,"_2870":24582},[],{"_3383":69981,"_29651":69874,"_20578":117914,"_5":14121,"_26960":117630,"_2870":117822},[],{"_3383":69982,"_29651":69874,"_20578":117916,"_5":14121,"_26960":117630,"_2870":117917},[],"URL HTTP del Device Manager de Lamassu.",{"_3383":69983,"_29651":69874,"_20578":117919,"_5":14121,"_26960":117630,"_2870":52555},[],{"_3383":69984,"_29651":69874,"_20578":117921,"_5":14121,"_26960":117630,"_2870":24582},[],{"_3383":69985,"_29651":69874,"_20578":117923,"_5":14121,"_26960":117630,"_2870":117822},[],{"_3383":69986,"_29651":69874,"_20578":117925,"_5":14121,"_26960":117630,"_2870":117926},[],"URL HTTP del servicio de CA de Lamassu.",{"_3383":69987,"_29651":69874,"_20578":117928,"_5":14121,"_26960":117634,"_2870":117929},[],"El conector gestiona el lado AWS de cuatro tipos de recursos: CAs, plantillas de aprovisionamiento de DMS (JITP), certificados de dispositivo y Things. Esta sección mapea los eventos del bus que consume el conector a los recursos de AWS que toca y a las llamadas AWS que ejecuta cada flujo. La máquina de estados de cada recurso está junto a su explicación detallada; la última columna enlaza a ella. Los recursos de AWS se referencian con la notación `IoTCore/<recurso>`.",{"_3383":69988,"_29651":69874,"_20578":117931,"_5":14121,"_26960":117634,"_2870":117932},[],"La columna **Tipo de CloudEvent** lista el nombre del evento en el bus interno de Lamassu; la columna **Acciones IAM** lista las operaciones exactas del SDK de AWS que invoca cada flujo, para que los permisos necesarios se deriven directamente de esta tabla.",{"_3383":69989,"_29651":69874,"_20578":117934,"_5":14121,"_26960":117634,"_2870":117935},[],"Tipo de CloudEvent",{"_3383":69990,"_29651":69874,"_20578":117937,"_5":14121,"_26960":117634,"_2870":117938},[],"Recurso en Lamassu",{"_3383":69991,"_29651":69874,"_20578":117940,"_5":14121,"_26960":117634,"_2870":117941},[],"Recurso AWS",{"_3383":69992,"_29651":69874,"_20578":117943,"_5":14121,"_26960":117634,"_2870":117944},[],"Acciones IAM",{"_3383":69993,"_29651":69874,"_20578":117946,"_5":14121,"_26960":117634,"_2870":117947},[],"Llamadas AWS y efecto",{"_3383":69994,"_29651":69874,"_20578":117949,"_5":14121,"_26960":117634,"_2870":117950},[],"Dónde en esta página",{"_3383":69995,"_29651":69874,"_20578":117952,"_5":14121,"_26960":117634,"_2870":52589},[],{"_3383":69996,"_29651":69874,"_20578":117954,"_5":14121,"_26960":117634,"_2870":52592},[],{"_3383":69997,"_29651":69874,"_20578":117956,"_5":14121,"_26960":117634,"_2870":52595},[],{"_3383":69998,"_29651":69874,"_20578":117958,"_5":14121,"_26960":117634,"_2870":52598},[],{"_3383":69999,"_29651":69874,"_20578":117960,"_5":14121,"_26960":117634,"_2870":117961},[],"Carga la CA en el estado del conector; una escritura de `registration.status = REQUESTED` dispara el flujo de registro (Primary con certificado de verificación, o SNI-only) y escribe `SUCCEEDED` o `FAILED` en los metadatos de la CA.",{"_3383":70000,"_29651":69874,"_20578":117963,"_5":14121,"_26960":117634,"_2870":117647},[],{"_3383":70001,"_29651":69874,"_20578":117965,"_5":14121,"_26960":117634,"_2870":52606},[],{"_3383":70002,"_29651":69874,"_20578":117967,"_5":14121,"_26960":117634,"_2870":52609},[],{"_3383":70003,"_29651":69874,"_20578":117969,"_5":14121,"_26960":117634,"_2870":52612},[],{"_3383":70004,"_29651":69874,"_20578":117971,"_5":14121,"_26960":117634,"_2870":52615},[],{"_3383":70005,"_29651":69874,"_20578":117973,"_5":14121,"_26960":117634,"_2870":117974},[],"En modo `jitp`, intenta crear la plantilla de aprovisionamiento y la adjunta a la CA registrada. No idempotente: una edición `PUT /v1/dms/{id}` reintenta la creación y acaba en `lamassu-dlq` tras 3 reintentos. Idempotente para `none` y `auto` (solo configuración).",{"_3383":70006,"_29651":69874,"_20578":117976,"_5":14121,"_26960":117634,"_2870":117673},[],{"_3383":70007,"_29651":69874,"_20578":117978,"_5":14121,"_26960":117634,"_2870":52623},[],{"_3383":70008,"_29651":69874,"_20578":117980,"_5":14121,"_26960":117634,"_2870":117981},[],"Dispositivo",{"_3383":70009,"_29651":69874,"_20578":117983,"_5":14121,"_26960":117634,"_2870":52629},[],{"_3383":70010,"_29651":69874,"_20578":117985,"_5":14121,"_26960":117634,"_2870":52632},[],{"_3383":70011,"_29651":69874,"_20578":117987,"_5":14121,"_26960":117634,"_2870":117988},[],"En modo `auto`: crea/actualiza políticas, asegura los grupos de Things, revoca principals obsoletos y aprovisiona el Thing vía `iot:RegisterThing`. En modo `jitp`: no hay llamadas AWS; AWS ejecuta la plantilla JITP en la primera conexión.",{"_3383":70012,"_29651":69874,"_20578":117990,"_5":14121,"_26960":117634,"_2870":117681},[],{"_3383":70013,"_29651":69874,"_20578":117992,"_5":14121,"_26960":117634,"_2870":52640},[],{"_3383":70014,"_29651":69874,"_20578":117994,"_5":14121,"_26960":117634,"_2870":117995},[],"Certificado",{"_3383":70015,"_29651":69874,"_20578":117997,"_5":14121,"_26960":117634,"_2870":52646},[],{"_3383":70016,"_29651":69874,"_20578":117999,"_5":14121,"_26960":117634,"_2870":118000},[],"`iot:UpdateCertificate`, `iot:Connect` (plano de datos)",{"_3383":70017,"_29651":69874,"_20578":118002,"_5":14121,"_26960":117634,"_2870":118003},[],"Mapea el estado a AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), llama a `iot:UpdateCertificate` y fuerza una desconexión MQTT al revocar.",{"_3383":70018,"_29651":69874,"_20578":118005,"_5":14121,"_26960":117634,"_2870":117693},[],{"_3383":70019,"_29651":69874,"_20578":118007,"_5":14121,"_26960":117634,"_2870":52657},[],{"_3383":70020,"_29651":69874,"_20578":118009,"_5":14121,"_26960":117634,"_2870":118010},[],"Certificado / Dispositivo",{"_3383":70021,"_29651":69874,"_20578":118012,"_5":14121,"_26960":117634,"_2870":52663},[],{"_3383":70022,"_29651":69874,"_20578":118014,"_5":14121,"_26960":117634,"_2870":48676},[],{"_3383":70023,"_29651":69874,"_20578":118016,"_5":14121,"_26960":117634,"_2870":118017},[],"Refresca el estado interno; el conector ignora los eventos cuyo campo CloudEvent `source` coincide con su propia URI para evitar bucles autodisparados.",{"_3383":70024,"_29651":69874,"_20578":118019,"_5":14121,"_26960":117634,"_2870":117701},[],{"_3383":70025,"_29651":69874,"_20578":118021,"_5":14121,"_26960":117638,"_2870":118022},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3383":70026,"_29651":69874,"_20578":118024,"_5":14121,"_26960":117642,"_2870":118025},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3383":70027,"_29651":69874,"_20578":118027,"_5":14121,"_26960":117642,"_2870":118028},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3383":70028,"_29651":69874,"_20578":118030,"_5":14121,"_26960":117646,"_2870":118031},[],"El flujo de registro de la CA se gobierna por el campo `registration.status` de los metadatos del conector en la CA:",{"_3383":70029,"_29651":69874,"_20578":118033,"_5":14121,"_26960":117646,"_2870":118034},[],"Transición",{"_3383":70030,"_29651":69874,"_20578":118036,"_5":14121,"_26960":117646,"_2870":118037},[],"Llamadas AWS",{"_3383":70031,"_29651":69874,"_20578":118039,"_5":14121,"_26960":117646,"_2870":118040},[],"`NoRegistrada` → `Solicitada`",{"_3383":70032,"_29651":69874,"_20578":118042,"_5":14121,"_26960":117646,"_2870":118043},[],"ninguna (solo escritura de metadatos)",{"_3383":70033,"_29651":69874,"_20578":118045,"_5":14121,"_26960":117646,"_2870":118046},[],"`Solicitada` → `Registrando`",{"_3383":70034,"_29651":69874,"_20578":118048,"_5":14121,"_26960":117646,"_2870":118049},[],"`iot:GetRegistrationCode` (solo Primary Account)",{"_3383":70035,"_29651":69874,"_20578":118051,"_5":14121,"_26960":117646,"_2870":118052},[],"`Registrando` → `Completada`",{"_3383":70036,"_29651":69874,"_20578":118054,"_5":14121,"_26960":117646,"_2870":118055},[],"`iot:RegisterCACertificate` (Primary: prueba de posesión con clave efímera; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3383":70037,"_29651":69874,"_20578":118057,"_5":14121,"_26960":117646,"_2870":118058},[],"`Registrando` → `Fallida`",{"_3383":70038,"_29651":69874,"_20578":118060,"_5":14121,"_26960":117646,"_2870":118061},[],"`iot:RegisterCACertificate` fallida; el detalle del error se escribe en los metadatos de la CA",{"_3383":70039,"_29651":69874,"_20578":118063,"_5":14121,"_26960":117646,"_2870":118064},[],"`Fallida` / `Completada` → `Solicitada`",{"_3383":70040,"_29651":69874,"_20578":118066,"_5":14121,"_26960":117646,"_2870":118067},[],"ninguna (una nueva escritura `REQUESTED` reejecuta el flujo)",{"_3383":70041,"_29651":69874,"_20578":118069,"_5":14121,"_26960":117650,"_2870":118070},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3383":70042,"_29651":69874,"_20578":118072,"_5":14121,"_26960":117650,"_2870":118073},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3383":70043,"_29651":69874,"_20578":118075,"_5":14121,"_26960":117650,"_2870":118076},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3383":70044,"_29651":69874,"_20578":118078,"_5":14121,"_26960":117650,"_2870":118079},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3383":70045,"_29651":69874,"_20578":118081,"_5":14121,"_26960":117650,"_2870":118082},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3383":70046,"_29651":69874,"_20578":118084,"_5":14121,"_26960":117650,"_2870":118085},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3383":70047,"_29651":69874,"_20578":118087,"_5":14121,"_26960":117653,"_2870":118088},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3383":70048,"_29651":69874,"_20578":118090,"_5":14121,"_26960":117656,"_2870":118091},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3383":70049,"_29651":69874,"_20578":118093,"_5":14121,"_26960":117656,"_2870":118094},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3383":70050,"_29651":69874,"_20578":118096,"_5":14121,"_26960":117660,"_2870":118097},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3383":70051,"_29651":69874,"_20578":118099,"_5":14121,"_26960":117664,"_2870":118100},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3383":70052,"_29651":69874,"_20578":118102,"_5":14121,"_26960":117664,"_2870":118103},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3383":70053,"_29651":69874,"_20578":118105,"_5":14121,"_26960":117664,"_2870":118106},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3383":70054,"_29651":69874,"_20578":118108,"_5":14121,"_26960":117664,"_2870":118109},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3383":70055,"_29651":69874,"_20578":118111,"_5":14121,"_26960":117664,"_2870":118112},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3383":70056,"_29651":69874,"_20578":118114,"_5":14121,"_26960":117664,"_2870":118115},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3383":70057,"_29651":69874,"_20578":118117,"_5":14121,"_26960":117668,"_2870":118118},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. El conector intenta crear esta plantilla cuando el DMS se crea y de nuevo en cada edición completa del DMS (`PUT /v1/dms/{id}`) - no en el momento del enrolamiento del dispositivo. El intento no es idempotente: cuando ya existe una plantilla nombrada con el ID del DMS, la llamada de creación falla, el evento se reintenta tres veces y acaba en la cola de mensajes fallidos `lamassu-dlq` (ver Solución de problemas). La plantilla se crea una sola vez; las ediciones posteriores nunca actualizan su contenido. Una actualización del DMS que omite `metadata` o envía `null` conserva los metadatos almacenados, así que la clave del conector `lamassu.io/iot/{connector_id}` sigue presente y el intento se sigue disparando. Un cuerpo que suministra un objeto `metadata` sustituye por completo los metadatos almacenados: si ese objeto no lleva la clave del conector, la clave se elimina y el conector omite silenciosamente los eventos futuros del DMS. Una vez adjuntada la plantilla, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3383":70058,"_29651":69874,"_20578":118120,"_5":14121,"_26960":117668,"_2870":118121},[],"El conector crea la plantilla, nombrada con el ID del DMS, una sola vez. Cada edición posterior del DMS que conserve la clave del conector intenta crearla de nuevo y falla, porque el conector no actualiza plantillas existentes. Los cambios posteriores en `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` o en los grupos y políticas que la plantilla referencia deben aplicarse a mano en AWS IoT Core.",{"_3383":70059,"_29651":69874,"_20578":118123,"_5":14121,"_26960":117668,"_2870":118124},[],"El evento fallido se reintenta y termina en `lamassu-dlq`. Los grupos y las políticas se registran antes del fallo, pero se omiten la asignación de la plantilla a la CA registrada, la escritura del ARN en el DMS y la actualización de las shadows al cambiar `ManagedCAs`.",{"_3383":70060,"_29651":69874,"_20578":118126,"_5":14121,"_26960":117668,"_2870":118127},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3383":70061,"_29651":69874,"_20578":118129,"_5":14121,"_26960":117668,"_2870":118130},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3383":70062,"_29651":69874,"_20578":118132,"_5":14121,"_26960":117672,"_2870":118133},[],"El `registration_mode` del DMS determina qué hace el conector en el lado AWS cuando el DMS se crea o se edita por completo:",{"_3383":70063,"_29651":69874,"_20578":118135,"_5":14121,"_26960":117672,"_2870":118034},[],{"_3383":70064,"_29651":69874,"_20578":118137,"_5":14121,"_26960":117672,"_2870":118037},[],{"_3383":70065,"_29651":69874,"_20578":118139,"_5":14121,"_26960":117672,"_2870":118140},[],"`SinConfigurar` → `None` / `Auto`",{"_3383":70066,"_29651":69874,"_20578":118142,"_5":14121,"_26960":117672,"_2870":118143},[],"ninguna (solo configuración)",{"_3383":70067,"_29651":69874,"_20578":118145,"_5":14121,"_26960":117672,"_2870":52800},[],{"_3383":70068,"_29651":69874,"_20578":118147,"_5":14121,"_26960":117672,"_2870":118143},[],{"_3383":70069,"_29651":69874,"_20578":118149,"_5":14121,"_26960":117672,"_2870":118150},[],"Cualquiera → `Jitp`",{"_3383":70070,"_29651":69874,"_20578":118152,"_5":14121,"_26960":117672,"_2870":118153},[],"`iot:CreateProvisioningTemplate` (no idempotente: falla si la plantilla ya existe; tras 3 reintentos el evento acaba en `lamassu-dlq`)",{"_3383":70071,"_29651":69874,"_20578":118155,"_5":14121,"_26960":117672,"_2870":52811},[],{"_3383":70072,"_29651":69874,"_20578":118157,"_5":14121,"_26960":117672,"_2870":118158},[],"ninguna (la plantilla permanece en la cuenta AWS)",{"_3383":70073,"_29651":69874,"_20578":118160,"_5":14121,"_26960":117676,"_2870":118161},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3383":70074,"_29651":69874,"_20578":118163,"_5":14121,"_26960":117676,"_2870":118164},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3383":70075,"_29651":69874,"_20578":118166,"_5":14121,"_26960":117676,"_2870":118167},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3383":70076,"_29651":69874,"_20578":118169,"_5":14121,"_26960":117680,"_2870":118170},[],"Los Things solo existen en modo `auto`; en modo `jitp` AWS crea el Thing por sí mismo cuando el dispositivo se conecta por primera vez. El nombre del Thing es siempre el CN del certificado del dispositivo:",{"_3383":70077,"_29651":69874,"_20578":118172,"_5":14121,"_26960":117680,"_2870":118034},[],{"_3383":70078,"_29651":69874,"_20578":118174,"_5":14121,"_26960":117680,"_2870":118037},[],{"_3383":70079,"_29651":69874,"_20578":118176,"_5":14121,"_26960":117680,"_2870":118177},[],"`Ausente` → `Aprovisionado`",{"_3383":70080,"_29651":69874,"_20578":118179,"_5":14121,"_26960":117680,"_2870":118180},[],"políticas creadas/actualizadas, grupos de Things asegurados, `iot:RegisterThing` (crea el Thing, registra el certificado, adjunta políticas)",{"_3383":70081,"_29651":69874,"_20578":118182,"_5":14121,"_26960":117680,"_2870":118183},[],"`Aprovisionado` → `Aprovisionado` (re-enrolamiento)",{"_3383":70082,"_29651":69874,"_20578":118185,"_5":14121,"_26960":117680,"_2870":118186},[],"principals obsoletos marcados como `REVOKED`, nueva ejecución de `iot:RegisterThing`; el nuevo ARN del certificado sustituye al anterior en los metadatos de Lamassu",{"_3383":70083,"_29651":69874,"_20578":118188,"_5":14121,"_26960":117680,"_2870":118189},[],"En modo `jitp` el conector no hace llamadas de aprovisionamiento: AWS ejecuta la plantilla JITP en la primera conexión del dispositivo y crea el Thing, registra el certificado y lo activa por su cuenta.",{"_3383":70084,"_29651":69874,"_20578":118191,"_5":14121,"_26960":117684,"_2870":118192},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3383":70085,"_29651":69874,"_20578":118194,"_5":14121,"_26960":117684,"_2870":118195},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3383":70086,"_29651":69874,"_20578":118197,"_5":14121,"_26960":117684,"_2870":118198},[],"Para que el flujo JITP funcione correctamente:",{"_3383":70087,"_29651":69874,"_20578":118200,"_5":14121,"_26960":117684,"_2870":118201},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3383":70088,"_29651":69874,"_20578":118203,"_5":14121,"_26960":117684,"_2870":118204},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3383":70089,"_29651":69874,"_20578":118206,"_5":14121,"_26960":117684,"_2870":118207},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3383":70090,"_29651":69874,"_20578":118209,"_5":14121,"_26960":117684,"_2870":118210},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3383":70091,"_29651":69874,"_20578":118212,"_5":14121,"_26960":117688,"_2870":118213},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3383":70092,"_29651":69874,"_20578":118215,"_5":14121,"_26960":117688,"_2870":118216},[],"Estado en Lamassu",{"_3383":70093,"_29651":69874,"_20578":118218,"_5":14121,"_26960":117688,"_2870":118219},[],"Razón de revocación",{"_3383":70094,"_29651":69874,"_20578":118221,"_5":14121,"_26960":117688,"_2870":118222},[],"Estado en AWS IoT Core",{"_3383":70095,"_29651":69874,"_20578":118224,"_5":14121,"_26960":117688,"_2870":52881},[],{"_3383":70096,"_29651":69874,"_20578":118226,"_5":14121,"_26960":117688,"_2870":118227},[],"Ninguna",{"_3383":70097,"_29651":69874,"_20578":118229,"_5":14121,"_26960":117688,"_2870":52887},[],{"_3383":70098,"_29651":69874,"_20578":118231,"_5":14121,"_26960":117688,"_2870":52890},[],{"_3383":70099,"_29651":69874,"_20578":118233,"_5":14121,"_26960":117688,"_2870":52893},[],{"_3383":70100,"_29651":69874,"_20578":118235,"_5":14121,"_26960":117688,"_2870":52896},[],{"_3383":70101,"_29651":69874,"_20578":118237,"_5":14121,"_26960":117688,"_2870":52890},[],{"_3383":70102,"_29651":69874,"_20578":118239,"_5":14121,"_26960":117688,"_2870":118240},[],"Cualquier otra razón",{"_3383":70103,"_29651":69874,"_20578":118242,"_5":14121,"_26960":117688,"_2870":52904},[],{"_3383":70104,"_29651":69874,"_20578":118244,"_5":14121,"_26960":117688,"_2870":118245},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3383":70105,"_29651":69874,"_20578":118247,"_5":14121,"_26960":117692,"_2870":118248},[],"Los certificados con la clave de metadatos del conector sincronizan su estado; los aprovisionados vía JITP no tienen clave de metadatos y quedan fuera de esta máquina:",{"_3383":70106,"_29651":69874,"_20578":118250,"_5":14121,"_26960":117692,"_2870":118034},[],{"_3383":70107,"_29651":69874,"_20578":118252,"_5":14121,"_26960":117692,"_2870":118037},[],{"_3383":70108,"_29651":69874,"_20578":118254,"_5":14121,"_26960":117692,"_2870":118255},[],"`NoSincronizado` → `Active`",{"_3383":70109,"_29651":69874,"_20578":118257,"_5":14121,"_26960":117692,"_2870":52396},[],{"_3383":70110,"_29651":69874,"_20578":118259,"_5":14121,"_26960":117692,"_2870":52922},[],{"_3383":70111,"_29651":69874,"_20578":118261,"_5":14121,"_26960":117692,"_2870":118262},[],"`iot:UpdateCertificate` + desconexión MQTT forzada",{"_3383":70112,"_29651":69874,"_20578":118264,"_5":14121,"_26960":117692,"_2870":52928},[],{"_3383":70113,"_29651":69874,"_20578":118266,"_5":14121,"_26960":117692,"_2870":118262},[],{"_3383":70114,"_29651":69874,"_20578":118268,"_5":14121,"_26960":117692,"_2870":52933},[],{"_3383":70115,"_29651":69874,"_20578":118270,"_5":14121,"_26960":117692,"_2870":52396},[],{"_3383":70116,"_29651":69874,"_20578":118272,"_5":14121,"_26960":117692,"_2870":52938},[],{"_3383":70117,"_29651":69874,"_20578":118274,"_5":14121,"_26960":117692,"_2870":118275},[],"ninguna (estos estados no se sincronizan con AWS)",{"_3383":70118,"_29651":69874,"_20578":118277,"_5":14121,"_26960":117696,"_2870":118278},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3383":70119,"_29651":69874,"_20578":118280,"_5":14121,"_26960":117696,"_2870":118281},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3383":70120,"_29651":69874,"_20578":118283,"_5":14121,"_26960":117696,"_2870":118284},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3383":70121,"_29651":69874,"_20578":118286,"_5":14121,"_26960":117700,"_2870":118287},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3383":70122,"_29651":69874,"_20578":118289,"_5":14121,"_26960":117700,"_2870":118290},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3383":70123,"_29651":69874,"_20578":118292,"_5":14121,"_26960":117704,"_2870":118293},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3383":70124,"_29651":69874,"_20578":118295,"_5":14121,"_26960":117704,"_2870":118296},[],"Existen dos tipos de acciones:",{"_3383":70125,"_29651":69874,"_20578":118298,"_5":14121,"_26960":117704,"_2870":118299},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3383":70126,"_29651":69874,"_20578":118301,"_5":14121,"_26960":117704,"_2870":118302},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3383":70127,"_29651":69874,"_20578":118304,"_5":14121,"_26960":117704,"_2870":118305},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3383":70128,"_29651":69874,"_20578":118307,"_5":14121,"_26960":117708,"_2870":118308},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3383":70129,"_29651":69874,"_20578":118310,"_5":14121,"_26960":117708,"_2870":118311},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3383":70130,"_29651":69874,"_20578":118313,"_5":14121,"_26960":117708,"_2870":118314},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3383":70131,"_29651":69874,"_20578":118316,"_5":14121,"_26960":117712,"_2870":118317},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3383":70132,"_29651":69874,"_20578":118319,"_5":14121,"_26960":117712,"_2870":118320},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3383":70133,"_29651":69874,"_20578":118322,"_5":14121,"_26960":117712,"_2870":118323},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3383":70134,"_29651":69874,"_20578":118325,"_5":14121,"_26960":117712,"_2870":118326},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3383":70135,"_29651":69874,"_20578":118328,"_5":14121,"_26960":117712,"_2870":118329},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3383":70136,"_29651":69874,"_20578":118331,"_5":14121,"_26960":117712,"_2870":118332},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3383":70137,"_29651":69874,"_20578":118334,"_5":14121,"_26960":117712,"_2870":118335},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3383":70138,"_29651":69874,"_20578":118337,"_5":14121,"_26960":117712,"_2870":118338},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3383":70139,"_29651":69874,"_20578":118340,"_5":14121,"_26960":117712,"_2870":118341},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3383":70140,"_29651":69874,"_20578":118343,"_5":14121,"_26960":117712,"_2870":118344},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3383":70141,"_29651":69874,"_20578":118346,"_5":14121,"_26960":117712,"_2870":118347},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3383":70142,"_29651":69874,"_20578":118349,"_5":14121,"_26960":117712,"_2870":118350},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3383":70143,"_29651":69874,"_20578":118352,"_5":14121,"_26960":117712,"_2870":118353},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3383":70144,"_29651":69874,"_20578":118355,"_5":14121,"_26960":117712,"_2870":118356},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3383":70145,"_29651":69874,"_20578":118358,"_5":14121,"_26960":117712,"_2870":118359},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3383":70146,"_29651":69874,"_20578":118361,"_5":14121,"_26960":117712,"_2870":118362},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3383":70147,"_29651":69874,"_20578":118364,"_5":14121,"_26960":117712,"_2870":118365},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3383":70148,"_29651":69874,"_20578":118367,"_5":14121,"_26960":117712,"_2870":118368},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3383":70149,"_29651":69874,"_20578":118370,"_5":14121,"_26960":117712,"_2870":118371},[],"**Síntoma:** Tras editar un DMS en modo `jitp`, aparecen mensajes de actualización del DMS en `lamassu-dlq`, o los cambios de configuración JITP no tienen efecto en AWS.",{"_3383":70150,"_29651":69874,"_20578":118373,"_5":14121,"_26960":117712,"_2870":118374},[],"**Causa:** Cada edición completa del DMS (`PUT /v1/dms/{id}`) dispara un nuevo intento de `CreateProvisioningTemplate` para la plantilla nombrada con el ID del DMS, y la llamada no es idempotente: cuando la plantilla ya existe, falla, el evento se reintenta tres veces y acaba en `lamassu-dlq`. Se omiten los pasos posteriores del conector.",{"_3383":70151,"_29651":69874,"_20578":118376,"_5":14121,"_26960":117712,"_2870":118377},[],"**Resolución:** Comprobar que la plantilla nombrada con el ID del DMS existe en AWS IoT Core y que el enrolamiento JITP funciona. Si se cambió la configuración JITP, aplicarla a mano en la plantilla de AWS.",{"_3383":70152,"_29651":69874,"_20578":118379,"_5":14121,"_26960":117712,"_2870":118380},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3383":70153,"_29651":69874,"_20578":118382,"_5":14121,"_26960":117712,"_2870":118383},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3383":70154,"_29651":69874,"_20578":118385,"_5":14121,"_26960":117712,"_2870":118386},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3383":70155,"_29651":70155,"_5":14473,"_2870":50759,"_30004":118388,"_20578":118389,"_26960":70155},[48280,115195,50759],[],{"_3383":70156,"_29651":70155,"_20578":118391,"_5":14121,"_26960":70155,"_2870":118392},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3383":70157,"_29651":70155,"_5":30001,"_20578":118394,"_26960":118395,"_2870":118396},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3383":70158,"_29651":70155,"_5":30001,"_20578":118398,"_26960":118399,"_2870":116204},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3383":70159,"_29651":70155,"_5":30001,"_20578":118401,"_26960":118402,"_2870":116379},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3383":70160,"_29651":70155,"_5":30001,"_20578":118404,"_26960":118405,"_2870":117611},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/overview#integraciones",{"_3383":70161,"_29651":70155,"_5":30001,"_20578":118407,"_26960":118408,"_2870":118409},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3383":70162,"_29651":70155,"_20578":118411,"_5":14121,"_26960":70155,"_2870":118412},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3383":70163,"_29651":70155,"_20578":118414,"_5":14121,"_26960":118395,"_2870":118415},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3383":70164,"_29651":70155,"_20578":118417,"_5":14121,"_26960":118395,"_2870":118418},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3383":70165,"_29651":70155,"_20578":118420,"_5":14121,"_26960":118399,"_2870":118421},[],"Recurso",{"_3383":70166,"_29651":70155,"_20578":118423,"_5":14121,"_26960":118399,"_2870":118424},[],"Qué representa",{"_3383":70167,"_29651":70155,"_20578":118426,"_5":14121,"_26960":118399,"_2870":118427},[],"**Dispositivo**",{"_3383":70168,"_29651":70155,"_20578":118429,"_5":14121,"_26960":118399,"_2870":118430},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3383":70169,"_29651":70155,"_20578":118432,"_5":14121,"_26960":118399,"_2870":118433},[],"**Identidad**",{"_3383":70170,"_29651":70155,"_20578":118435,"_5":14121,"_26960":118399,"_2870":118436},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3383":70171,"_29651":70155,"_20578":118438,"_5":14121,"_26960":118399,"_2870":53105},[],{"_3383":70172,"_29651":70155,"_20578":118440,"_5":14121,"_26960":118399,"_2870":118441},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3383":70173,"_29651":70155,"_20578":118443,"_5":14121,"_26960":118399,"_2870":118444},[],"**Flota**",{"_3383":70174,"_29651":70155,"_20578":118446,"_5":14121,"_26960":118399,"_2870":118447},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3383":70175,"_29651":70155,"_20578":118449,"_5":14121,"_26960":118399,"_2870":118450},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3383":70176,"_29651":70155,"_20578":118452,"_5":14121,"_26960":118399,"_2870":118453},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3383":70177,"_29651":70155,"_20578":118455,"_5":14121,"_26960":118402,"_2870":118456},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3383":70178,"_29651":70155,"_20578":118458,"_5":14121,"_26960":118402,"_2870":118459},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3383":70179,"_29651":70155,"_20578":118461,"_5":14121,"_26960":118402,"_2870":118462},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3383":70180,"_29651":70155,"_20578":118464,"_5":14121,"_26960":118402,"_2870":118465},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3383":70181,"_29651":70155,"_20578":118467,"_5":14121,"_26960":118402,"_2870":118468},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3383":70182,"_29651":70155,"_20578":118470,"_5":14121,"_26960":118402,"_2870":118471},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3383":70183,"_29651":70155,"_20578":118473,"_5":14121,"_26960":118402,"_2870":118474},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3383":70184,"_29651":70155,"_20578":118476,"_5":14121,"_26960":118402,"_2870":118477},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3383":70185,"_29651":70155,"_20578":118479,"_5":14121,"_26960":118405,"_2870":118480},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3383":70186,"_29651":70155,"_20578":118482,"_5":14121,"_26960":118405,"_2870":118483},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3383":70187,"_29651":70155,"_20578":118485,"_5":14121,"_26960":118408,"_2870":118486},[],"Participante",{"_3383":70188,"_29651":70155,"_20578":118488,"_5":14121,"_26960":118408,"_2870":118489},[],"Responsabilidad",{"_3383":70189,"_29651":70155,"_20578":118491,"_5":14121,"_26960":118408,"_2870":118492},[],"Administrador PKI",{"_3383":70190,"_29651":70155,"_20578":118494,"_5":14121,"_26960":118408,"_2870":118495},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3383":70191,"_29651":70155,"_20578":118497,"_5":14121,"_26960":118408,"_2870":118498},[],"Administrador del aprovisionamiento",{"_3383":70192,"_29651":70155,"_20578":118500,"_5":14121,"_26960":118408,"_2870":118501},[],"DMS, admisión, autenticación por operación e inventario.",{"_3383":70193,"_29651":70155,"_20578":118503,"_5":14121,"_26960":118408,"_2870":118504},[],"Integrador del dispositivo",{"_3383":70194,"_29651":70155,"_20578":118506,"_5":14121,"_26960":118408,"_2870":118507},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3383":70195,"_29651":70155,"_20578":118509,"_5":14121,"_26960":118408,"_2870":118510},[],"Integrador del consumidor",{"_3383":70196,"_29651":70155,"_20578":118512,"_5":14121,"_26960":118408,"_2870":118513},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3383":70197,"_29651":70155,"_20578":118515,"_5":14121,"_26960":118408,"_2870":118516},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3383":70198,"_29651":70198,"_5":14473,"_2870":118518,"_30004":118519,"_20578":118521,"_26960":70198},"Enrola y conecta tu primer dispositivo",[48280,115195,50759,118520],"Primeros pasos",[],{"_3383":70199,"_29651":70198,"_20578":118523,"_5":14121,"_26960":70198,"_2870":118524},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3383":70200,"_29651":70198,"_5":30001,"_20578":118526,"_26960":118527,"_2870":113773},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3383":70201,"_29651":70198,"_5":30001,"_20578":118529,"_26960":118530,"_2870":118531},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3383":70202,"_29651":70198,"_5":30001,"_20578":118533,"_26960":118534,"_2870":118535},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3383":70203,"_29651":70198,"_5":30001,"_20578":118537,"_26960":118538,"_2870":118539},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3383":70204,"_29651":70198,"_5":30001,"_20578":118541,"_26960":118542,"_2870":118543},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3383":70205,"_29651":70198,"_5":30001,"_20578":118545,"_26960":118546,"_2870":118547},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3383":70206,"_29651":70198,"_5":30001,"_20578":118549,"_26960":118550,"_2870":118551},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3383":70207,"_29651":70198,"_5":30001,"_20578":118553,"_26960":118554,"_2870":118555},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3383":70208,"_29651":70198,"_20578":118557,"_5":14121,"_26960":70198,"_2870":118558},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3383":70209,"_29651":70198,"_20578":118560,"_5":14121,"_26960":118527,"_2870":118561},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3383":70210,"_29651":70198,"_20578":118563,"_5":14121,"_26960":118527,"_2870":118564},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3383":70211,"_29651":70198,"_20578":118566,"_5":14121,"_26960":118527,"_2870":118567},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3383":70212,"_29651":70198,"_20578":118569,"_5":14121,"_26960":118527,"_2870":118570},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3383":70213,"_29651":70198,"_20578":118572,"_5":14121,"_26960":118527,"_2870":118573},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3383":70214,"_29651":70198,"_20578":118575,"_5":14121,"_26960":118530,"_2870":118576},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3383":70215,"_29651":70198,"_20578":118578,"_5":14121,"_26960":118530,"_2870":118579},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3383":70216,"_29651":70198,"_20578":118581,"_5":14121,"_26960":118534,"_2870":118582},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3383":70217,"_29651":70198,"_20578":118584,"_5":14121,"_26960":118534,"_2870":118585},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3383":70218,"_29651":70198,"_20578":118587,"_5":14121,"_26960":118534,"_2870":118588},[],"Ajuste",{"_3383":70219,"_29651":70198,"_20578":118590,"_5":14121,"_26960":118534,"_2870":118591},[],"Valor de evaluación",{"_3383":70220,"_29651":70198,"_20578":118593,"_5":14121,"_26960":118534,"_2870":53261},[],{"_3383":70221,"_29651":70198,"_20578":118595,"_5":14121,"_26960":118534,"_2870":118596},[],"Raíz emisora de `device-root.pem`.",{"_3383":70222,"_29651":70198,"_20578":118598,"_5":14121,"_26960":118534,"_2870":116507},[],{"_3383":70223,"_29651":70198,"_20578":118600,"_5":14121,"_26960":118534,"_2870":118601},[],"Perfil final de 1 hora que acabas de preparar.",{"_3383":70224,"_29651":70198,"_20578":118603,"_5":14121,"_26960":118534,"_2870":53272},[],{"_3383":70225,"_29651":70198,"_20578":118605,"_5":14121,"_26960":118534,"_2870":53275},[],{"_3383":70226,"_29651":70198,"_20578":118607,"_5":14121,"_26960":118534,"_2870":53278},[],{"_3383":70227,"_29651":70198,"_20578":118609,"_5":14121,"_26960":118534,"_2870":118610},[],"Habilitado.",{"_3383":70228,"_29651":70198,"_20578":118612,"_5":14121,"_26960":118534,"_2870":53284},[],{"_3383":70229,"_29651":70198,"_20578":118614,"_5":14121,"_26960":118534,"_2870":118615},[],"Deshabilitado; el ID debe ser nuevo.",{"_3383":70230,"_29651":70198,"_20578":118617,"_5":14121,"_26960":118534,"_2870":118618},[],"Autenticación inicial",{"_3383":70231,"_29651":70198,"_20578":118620,"_5":14121,"_26960":118534,"_2870":118621},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3383":70232,"_29651":70198,"_20578":118623,"_5":14121,"_26960":118534,"_2870":118624},[],"Autenticación de renovación",{"_3383":70233,"_29651":70198,"_20578":118626,"_5":14121,"_26960":118534,"_2870":118627},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3383":70234,"_29651":70198,"_20578":118629,"_5":14121,"_26960":118534,"_2870":53302},[],{"_3383":70235,"_29651":70198,"_20578":118631,"_5":14121,"_26960":118534,"_2870":118632},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_3383":70236,"_29651":70198,"_20578":118634,"_5":14121,"_26960":118534,"_2870":53308},[],{"_3383":70237,"_29651":70198,"_20578":118636,"_5":14121,"_26960":118534,"_2870":118637},[],"1 hora.",{"_3383":70238,"_29651":70198,"_20578":118639,"_5":14121,"_26960":118534,"_2870":53314},[],{"_3383":70239,"_29651":70198,"_20578":118641,"_5":14121,"_26960":118534,"_2870":118642},[],"30 minutos / 10 minutos.",{"_3383":70240,"_29651":70198,"_20578":118644,"_5":14121,"_26960":118534,"_2870":53320},[],{"_3383":70241,"_29651":70198,"_20578":118646,"_5":14121,"_26960":118534,"_2870":118647},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3383":70242,"_29651":70198,"_20578":118649,"_5":14121,"_26960":118534,"_2870":51078},[],{"_3383":70243,"_29651":70198,"_20578":118651,"_5":14121,"_26960":118534,"_2870":118652},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3383":70244,"_29651":70198,"_20578":118654,"_5":14121,"_26960":118534,"_2870":53331},[],{"_3383":70245,"_29651":70198,"_20578":118656,"_5":14121,"_26960":118534,"_2870":118657},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3383":70246,"_29651":70198,"_20578":118659,"_5":14121,"_26960":118534,"_2870":118660},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento; la guía DMS describe sus campos, y también puedes comprobar el recurso mediante la API DMS.",{"_3383":70247,"_29651":70198,"_20578":118662,"_5":14121,"_26960":118538,"_2870":118663},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3383":70248,"_29651":70198,"_20578":118665,"_5":14121,"_26960":118538,"_2870":118666},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3383":70249,"_29651":70198,"_20578":118668,"_5":14121,"_26960":118542,"_2870":118669},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3383":70250,"_29651":70198,"_20578":118671,"_5":14121,"_26960":118542,"_2870":118672},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3383":70251,"_29651":70198,"_20578":118674,"_5":14121,"_26960":118542,"_2870":118675},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3383":70252,"_29651":70198,"_20578":118677,"_5":14121,"_26960":118546,"_2870":118678},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3383":70253,"_29651":70198,"_20578":118680,"_5":14121,"_26960":118546,"_2870":118681},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3383":70254,"_29651":70198,"_20578":118683,"_5":14121,"_26960":118550,"_2870":118684},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3383":70255,"_29651":70198,"_20578":118686,"_5":14121,"_26960":118550,"_2870":118687},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3383":70256,"_29651":70198,"_20578":118689,"_5":14121,"_26960":118550,"_2870":118690},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3383":70257,"_29651":70198,"_20578":118692,"_5":14121,"_26960":118550,"_2870":118693},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3383":70258,"_29651":70198,"_20578":118695,"_5":14121,"_26960":118550,"_2870":118696},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3383":70259,"_29651":70198,"_20578":118698,"_5":14121,"_26960":118554,"_2870":118699},[],"Comprobación",{"_3383":70260,"_29651":70198,"_20578":118701,"_5":14121,"_26960":118554,"_2870":118702},[],"Resultado esperado",{"_3383":70261,"_29651":70198,"_20578":118704,"_5":14121,"_26960":118554,"_2870":118705},[],"Registro",{"_3383":70262,"_29651":70198,"_20578":118707,"_5":14121,"_26960":118554,"_2870":118708},[],"ID creado automáticamente y DMS correcto.",{"_3383":70263,"_29651":70198,"_20578":118710,"_5":14121,"_26960":118554,"_2870":117995},[],{"_3383":70264,"_29651":70198,"_20578":118712,"_5":14121,"_26960":118554,"_2870":118713},[],"CN, perfil, serie y clave verificados.",{"_3383":70265,"_29651":70198,"_20578":118715,"_5":14121,"_26960":118554,"_2870":118716},[],"Inventario",{"_3383":70266,"_29651":70198,"_20578":118718,"_5":14121,"_26960":118554,"_2870":118719},[],"Serie recibida visible como identidad actual y en el historial.",{"_3383":70267,"_29651":70198,"_20578":118721,"_5":14121,"_26960":118554,"_2870":118722},[],"Consumidor",{"_3383":70268,"_29651":70198,"_20578":118724,"_5":14121,"_26960":118554,"_2870":118725},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3383":70269,"_29651":70198,"_20578":118727,"_5":14121,"_26960":118554,"_2870":118728},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3383":70270,"_29651":70198,"_20578":118730,"_5":14121,"_26960":118554,"_2870":118731},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3383":70271,"_29651":70271,"_5":14473,"_2870":116221,"_30004":118733,"_20578":118734,"_26960":70271},[48280,115195,50759,118520],[],{"_3383":70272,"_29651":70271,"_20578":118736,"_5":14121,"_26960":70271,"_2870":118737},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3383":70273,"_29651":70271,"_5":30001,"_20578":118739,"_26960":118740,"_2870":113773},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3383":70274,"_29651":70271,"_5":30001,"_20578":118742,"_26960":118743,"_2870":118744},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3383":70275,"_29651":70271,"_5":30001,"_20578":118746,"_26960":118747,"_2870":118748},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3383":70276,"_29651":70271,"_5":30001,"_20578":118750,"_26960":118751,"_2870":118752},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3383":70277,"_29651":70271,"_5":30001,"_20578":118754,"_26960":118755,"_2870":118756},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3383":70278,"_29651":70271,"_5":30001,"_20578":118758,"_26960":118759,"_2870":118760},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3383":70279,"_29651":70271,"_5":30001,"_20578":118762,"_26960":118763,"_2870":118702},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3383":70280,"_29651":70271,"_5":30001,"_20578":118765,"_26960":118766,"_2870":118767},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3383":70281,"_29651":70271,"_5":30001,"_20578":118769,"_26960":118770,"_2870":118771},[],"/docs/pr-preview/pr-55/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3383":70282,"_29651":70271,"_20578":118773,"_5":14121,"_26960":70271,"_2870":118774},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3383":70283,"_29651":70271,"_20578":118776,"_5":14121,"_26960":70271,"_2870":118777},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3383":70284,"_29651":70271,"_20578":118779,"_5":14121,"_26960":118740,"_2870":118780},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3383":70285,"_29651":70271,"_20578":118782,"_5":14121,"_26960":118740,"_2870":118783},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3383":70286,"_29651":70271,"_20578":118785,"_5":14121,"_26960":118740,"_2870":118786},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3383":70287,"_29651":70271,"_20578":118788,"_5":14121,"_26960":118740,"_2870":118789},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3383":70288,"_29651":70271,"_20578":118791,"_5":14121,"_26960":118743,"_2870":118792},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3383":70289,"_29651":70271,"_20578":118794,"_5":14121,"_26960":118743,"_2870":118795},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3383":70290,"_29651":70271,"_20578":118797,"_5":14121,"_26960":118743,"_2870":118798},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3383":70291,"_29651":70271,"_20578":118800,"_5":14121,"_26960":118743,"_2870":118801},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3383":70292,"_29651":70271,"_20578":118803,"_5":14121,"_26960":118743,"_2870":118804},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_3383":70293,"_29651":70271,"_20578":118806,"_5":14121,"_26960":118743,"_2870":118807},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3383":70294,"_29651":70271,"_20578":118809,"_5":14121,"_26960":118743,"_2870":118810},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3383":70295,"_29651":70271,"_20578":118812,"_5":14121,"_26960":118743,"_2870":118813},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3383":70296,"_29651":70271,"_20578":118815,"_5":14121,"_26960":118747,"_2870":118816},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3383":70297,"_29651":70271,"_20578":118818,"_5":14121,"_26960":118747,"_2870":53496},[],{"_3383":70298,"_29651":70271,"_20578":118820,"_5":14121,"_26960":118747,"_2870":118821},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3383":70299,"_29651":70271,"_20578":118823,"_5":14121,"_26960":118747,"_2870":118824},[],"**Icon** y **Tags**: clasificación opcional.",{"_3383":70300,"_29651":70271,"_20578":118826,"_5":14121,"_26960":118747,"_2870":118827},[],"Confirma el registro.",{"_3383":70301,"_29651":70271,"_20578":118829,"_5":14121,"_26960":118751,"_2870":118830},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3383":70302,"_29651":70271,"_20578":118832,"_5":14121,"_26960":118751,"_2870":118833},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3383":70303,"_29651":70271,"_20578":118835,"_5":14121,"_26960":118755,"_2870":118836},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3383":70304,"_29651":70271,"_20578":118838,"_5":14121,"_26960":118755,"_2870":118839},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3383":70305,"_29651":70271,"_20578":118841,"_5":14121,"_26960":118759,"_2870":118842},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3383":70306,"_29651":70271,"_20578":118844,"_5":14121,"_26960":118759,"_2870":118845},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3383":70307,"_29651":70271,"_20578":118847,"_5":14121,"_26960":118763,"_2870":118699},[],{"_3383":70308,"_29651":70271,"_20578":118849,"_5":14121,"_26960":118763,"_2870":118850},[],"Resultado",{"_3383":70309,"_29651":70271,"_20578":118852,"_5":14121,"_26960":118763,"_2870":117981},[],{"_3383":70310,"_29651":70271,"_20578":118854,"_5":14121,"_26960":118763,"_2870":118855},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3383":70311,"_29651":70271,"_20578":118857,"_5":14121,"_26960":118763,"_2870":118858},[],"Identidad actual",{"_3383":70312,"_29651":70271,"_20578":118860,"_5":14121,"_26960":118763,"_2870":118861},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3383":70313,"_29651":70271,"_20578":118863,"_5":14121,"_26960":118763,"_2870":118864},[],"Historial",{"_3383":70314,"_29651":70271,"_20578":118866,"_5":14121,"_26960":118763,"_2870":118867},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3383":70315,"_29651":70271,"_20578":118869,"_5":14121,"_26960":118763,"_2870":118870},[],"Clave y certificado",{"_3383":70316,"_29651":70271,"_20578":118872,"_5":14121,"_26960":118763,"_2870":118873},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3383":70317,"_29651":70271,"_20578":118875,"_5":14121,"_26960":118766,"_2870":118876},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3383":70318,"_29651":70271,"_20578":118878,"_5":14121,"_26960":118766,"_2870":118879},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3383":70319,"_29651":70271,"_20578":118881,"_5":14121,"_26960":118766,"_2870":118882},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3383":70320,"_29651":70271,"_20578":118884,"_5":14121,"_26960":118766,"_2870":118885},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3383":70321,"_29651":70271,"_20578":118887,"_5":14121,"_26960":118770,"_2870":118888},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3383":70322,"_29651":70271,"_20578":118890,"_5":14121,"_26960":118770,"_2870":118891},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3383":70323,"_29651":70271,"_20578":118893,"_5":14121,"_26960":118770,"_2870":118894},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3383":70324,"_29651":70324,"_5":14473,"_2870":118896,"_30004":118897,"_20578":118898,"_26960":70324},"Plataforma Lamassu IoT",[48280,115195],[],{"_3383":70325,"_29651":70324,"_20578":118900,"_5":14121,"_26960":70324,"_2870":118901},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3383":70326,"_29651":70324,"_5":30001,"_20578":118903,"_26960":118904,"_2870":118396},[],"/docs/pr-preview/pr-55/es/platform/overview#empieza-aquí",{"_3383":70327,"_29651":70324,"_5":30001,"_20578":118906,"_26960":118907,"_2870":118908},[],"/docs/pr-preview/pr-55/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3383":70328,"_29651":70324,"_5":30001,"_20578":118910,"_26960":118911,"_2870":118912},[],"/docs/pr-preview/pr-55/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3383":70329,"_29651":70324,"_5":30001,"_20578":118914,"_26960":118915,"_2870":118916},[],"/docs/pr-preview/pr-55/es/platform/overview#capacidades-principales","Capacidades principales",{"_3383":70330,"_29651":70324,"_5":30001,"_20578":118918,"_26960":118919,"_2870":118920},[],"/docs/pr-preview/pr-55/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3383":70331,"_29651":70324,"_5":30001,"_20578":118922,"_26960":118923,"_2870":118924},[],"/docs/pr-preview/pr-55/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3383":70332,"_29651":70324,"_5":30001,"_20578":118926,"_26960":118927,"_2870":118928},[],"/docs/pr-preview/pr-55/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3383":70333,"_29651":70324,"_5":30001,"_20578":118930,"_26960":118931,"_2870":118932},[],"/docs/pr-preview/pr-55/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3383":70334,"_29651":70324,"_5":30001,"_20578":118934,"_26960":118935,"_2870":118936},[],"/docs/pr-preview/pr-55/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3383":70335,"_29651":70324,"_5":30001,"_20578":118938,"_26960":118939,"_2870":118940},[],"/docs/pr-preview/pr-55/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3383":70336,"_29651":70324,"_5":30001,"_20578":118942,"_26960":118943,"_2870":118944},[],"/docs/pr-preview/pr-55/es/platform/overview#referencia-operativa","Referencia operativa",{"_3383":70337,"_29651":70324,"_20578":118946,"_5":14121,"_26960":70324,"_2870":118947},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3383":70338,"_29651":70324,"_20578":118949,"_5":14121,"_26960":118904,"_2870":118950},[],"Elige el resultado que necesitas obtener:",{"_3383":70339,"_29651":70324,"_20578":118952,"_5":14121,"_26960":118904,"_2870":118953},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3383":70340,"_29651":70324,"_20578":118955,"_5":14121,"_26960":118904,"_2870":118956},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3383":70341,"_29651":70324,"_20578":118958,"_5":14121,"_26960":118904,"_2870":118959},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3383":70342,"_29651":70324,"_20578":118961,"_5":14121,"_26960":118907,"_2870":118962},[],"Bloque",{"_3383":70343,"_29651":70324,"_20578":118964,"_5":14121,"_26960":118907,"_2870":118965},[],"Qué gestionas",{"_3383":70344,"_29651":70324,"_20578":118967,"_5":14121,"_26960":118907,"_2870":118968},[],"Punto de entrada",{"_3383":70345,"_29651":70324,"_20578":118970,"_5":14121,"_26960":118907,"_2870":53649},[],{"_3383":70346,"_29651":70324,"_20578":118972,"_5":14121,"_26960":118907,"_2870":118973},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3383":70347,"_29651":70324,"_20578":118975,"_5":14121,"_26960":118907,"_2870":118976},[],"Visión general de PKI",{"_3383":70348,"_29651":70324,"_20578":118978,"_5":14121,"_26960":118907,"_2870":53658},[],{"_3383":70349,"_29651":70324,"_20578":118980,"_5":14121,"_26960":118907,"_2870":118981},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3383":70350,"_29651":70324,"_20578":118983,"_5":14121,"_26960":118907,"_2870":118984},[],"Visión general de IoT Fleets",{"_3383":70351,"_29651":70324,"_20578":118986,"_5":14121,"_26960":118907,"_2870":118987},[],"**Administración**",{"_3383":70352,"_29651":70324,"_20578":118989,"_5":14121,"_26960":118907,"_2870":118990},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3383":70353,"_29651":70324,"_20578":118992,"_5":14121,"_26960":118907,"_2870":115193},[],{"_3383":70354,"_29651":70324,"_20578":118994,"_5":14121,"_26960":118907,"_2870":118995},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3383":70355,"_29651":70324,"_20578":118997,"_5":14121,"_26960":118911,"_2870":118998},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3383":70356,"_29651":70324,"_20578":119000,"_5":14121,"_26960":118911,"_2870":119001},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3383":70357,"_29651":70324,"_20578":119003,"_5":14121,"_26960":118911,"_2870":119004},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3383":70358,"_29651":70324,"_20578":119006,"_5":14121,"_26960":118911,"_2870":119007},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3383":70359,"_29651":70324,"_20578":119009,"_5":14121,"_26960":118911,"_2870":119010},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3383":70360,"_29651":70324,"_20578":119012,"_5":14121,"_26960":118911,"_2870":119013},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3383":70361,"_29651":70324,"_20578":119015,"_5":14121,"_26960":118919,"_2870":119016},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3383":70362,"_29651":70324,"_20578":119018,"_5":14121,"_26960":118923,"_2870":119019},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3383":70363,"_29651":70324,"_20578":119021,"_5":14121,"_26960":118927,"_2870":119022},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3383":70364,"_29651":70324,"_20578":119024,"_5":14121,"_26960":118931,"_2870":119025},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3383":70365,"_29651":70324,"_20578":119027,"_5":14121,"_26960":118935,"_2870":119028},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3383":70366,"_29651":70324,"_20578":119030,"_5":14121,"_26960":118939,"_2870":119031},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3383":70367,"_29651":70324,"_20578":119033,"_5":14121,"_26960":118943,"_2870":118489},[],{"_3383":70368,"_29651":70324,"_20578":119035,"_5":14121,"_26960":118943,"_2870":119036},[],"Qué prepara o comprueba",{"_3383":70369,"_29651":70324,"_20578":119038,"_5":14121,"_26960":118943,"_2870":118492},[],{"_3383":70370,"_29651":70324,"_20578":119040,"_5":14121,"_26960":118943,"_2870":119041},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3383":70371,"_29651":70324,"_20578":119043,"_5":14121,"_26960":118943,"_2870":119044},[],"Administrador de la flota",{"_3383":70372,"_29651":70324,"_20578":119046,"_5":14121,"_26960":118943,"_2870":119047},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3383":70373,"_29651":70324,"_20578":119049,"_5":14121,"_26960":118943,"_2870":118504},[],{"_3383":70374,"_29651":70324,"_20578":119051,"_5":14121,"_26960":118943,"_2870":119052},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3383":70375,"_29651":70324,"_20578":119054,"_5":14121,"_26960":118943,"_2870":118510},[],{"_3383":70376,"_29651":70324,"_20578":119056,"_5":14121,"_26960":118943,"_2870":119057},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3383":70377,"_29651":70324,"_20578":119059,"_5":14121,"_26960":118943,"_2870":119060},[],"Operador de infraestructura",{"_3383":70378,"_29651":70324,"_20578":119062,"_5":14121,"_26960":118943,"_2870":119063},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3383":70379,"_29651":70324,"_20578":119065,"_5":14121,"_26960":118943,"_2870":119066},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3383":70380,"_29651":70380,"_5":14473,"_2870":119068,"_30004":119069,"_20578":119071,"_26960":70380},"Jerarquía y rotación de CAs",[48280,115195,53750,119070],"Claves, autoridades y certificados",[],{"_3383":70381,"_29651":70380,"_20578":119073,"_5":14121,"_26960":70380,"_2870":119074},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3383":70382,"_29651":70380,"_5":30001,"_20578":119076,"_26960":119077,"_2870":119078},[],"/docs/pr-preview/pr-55/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3383":70383,"_29651":70380,"_5":30001,"_20578":119080,"_26960":119081,"_2870":119082},[],"/docs/pr-preview/pr-55/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3383":70384,"_29651":70380,"_5":30001,"_20578":119084,"_26960":119085,"_2870":119086},[],"/docs/pr-preview/pr-55/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3383":70385,"_29651":70380,"_5":30001,"_20578":119088,"_26960":119089,"_2870":119090},[],"/docs/pr-preview/pr-55/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3383":70386,"_29651":70380,"_5":30001,"_20578":119092,"_26960":119093,"_2870":119094},[],"/docs/pr-preview/pr-55/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3383":70387,"_29651":70380,"_5":30001,"_20578":119096,"_26960":119097,"_2870":119098},[],"/docs/pr-preview/pr-55/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3383":70388,"_29651":70380,"_5":30001,"_20578":119100,"_26960":119101,"_2870":119102},[],"/docs/pr-preview/pr-55/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3383":70389,"_29651":70380,"_5":30001,"_20578":119104,"_26960":119105,"_2870":119106},[],"/docs/pr-preview/pr-55/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3383":70390,"_29651":70380,"_5":30001,"_20578":119108,"_26960":119109,"_2870":119110},[],"/docs/pr-preview/pr-55/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3383":70391,"_29651":70380,"_5":30001,"_20578":119112,"_26960":119113,"_2870":119114},[],"/docs/pr-preview/pr-55/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3383":70392,"_29651":70380,"_5":30001,"_20578":119116,"_26960":119117,"_2870":119118},[],"/docs/pr-preview/pr-55/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3383":70393,"_29651":70380,"_5":30001,"_20578":119120,"_26960":119121,"_2870":119122},[],"/docs/pr-preview/pr-55/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3383":70394,"_29651":70380,"_20578":119124,"_5":14121,"_26960":70380,"_2870":119125},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3383":70395,"_29651":70380,"_20578":119127,"_5":14121,"_26960":70380,"_2870":119128},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3383":70396,"_29651":70380,"_20578":119130,"_5":14121,"_26960":119077,"_2870":119131},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3383":70397,"_29651":70380,"_20578":119133,"_5":14121,"_26960":119077,"_2870":119134},[],"entorno, como producción y preproducción;",{"_3383":70398,"_29651":70380,"_20578":119136,"_5":14121,"_26960":119077,"_2870":119137},[],"propietario o equipo operador;",{"_3383":70399,"_29651":70380,"_20578":119139,"_5":14121,"_26960":119077,"_2870":119140},[],"familia de dispositivos o proceso de fabricación;",{"_3383":70400,"_29651":70380,"_20578":119142,"_5":14121,"_26960":119077,"_2870":119143},[],"región o requisito regulatorio;",{"_3383":70401,"_29651":70380,"_20578":119145,"_5":14121,"_26960":119077,"_2870":119146},[],"motor criptográfico o política de clave;",{"_3383":70402,"_29651":70380,"_20578":119148,"_5":14121,"_26960":119077,"_2870":119149},[],"ventana de mantenimiento y ritmo de renovación.",{"_3383":70403,"_29651":70380,"_20578":119151,"_5":14121,"_26960":119077,"_2870":119152},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3383":70404,"_29651":70380,"_20578":119154,"_5":14121,"_26960":119077,"_2870":119155},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3383":70405,"_29651":70380,"_20578":119157,"_5":14121,"_26960":119081,"_2870":119158},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3383":70406,"_29651":70380,"_20578":119160,"_5":14121,"_26960":119081,"_2870":119161},[],"Si un rol VA de CRL de la CA está firmado por el certificado de la CA sustituido, al reemitir el firmante se mueve al certificado nuevo, siempre que incluya `cRLSign`, y se republica la CRL. En caso contrario, y para un rol firmado por otro certificado, el rol conserva su firmante, así que comprueba el uso de clave del certificado nuevo tras reemitir; consulta la guía de CRL.",{"_3383":70407,"_29651":70380,"_20578":119163,"_5":14121,"_26960":119081,"_2870":119164},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3383":70408,"_29651":70380,"_20578":119166,"_5":14121,"_26960":119081,"_2870":119167},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_3383":70409,"_29651":70380,"_20578":119169,"_5":14121,"_26960":119085,"_2870":119170},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3383":70410,"_29651":70380,"_20578":119172,"_5":14121,"_26960":119085,"_2870":119173},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3383":70411,"_29651":70380,"_20578":119175,"_5":14121,"_26960":119085,"_2870":119176},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3383":70412,"_29651":70380,"_20578":119178,"_5":14121,"_26960":119085,"_2870":119179},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3383":70413,"_29651":70380,"_20578":119181,"_5":14121,"_26960":119093,"_2870":119182},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3383":70414,"_29651":70380,"_20578":119184,"_5":14121,"_26960":119097,"_2870":119185},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3383":70415,"_29651":70380,"_20578":119187,"_5":14121,"_26960":119101,"_2870":119188},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3383":70416,"_29651":70380,"_20578":119190,"_5":14121,"_26960":119105,"_2870":119191},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_3383":70417,"_29651":70380,"_20578":119193,"_5":14121,"_26960":119109,"_2870":119194},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3383":70418,"_29651":70380,"_20578":119196,"_5":14121,"_26960":119113,"_2870":119197},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_3383":70419,"_29651":70380,"_20578":119199,"_5":14121,"_26960":119117,"_2870":119200},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3383":70420,"_29651":70380,"_20578":119202,"_5":14121,"_26960":119117,"_2870":119203},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3383":70421,"_29651":70380,"_20578":119205,"_5":14121,"_26960":119117,"_2870":119206},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_3383":70422,"_29651":70380,"_20578":119208,"_5":14121,"_26960":119117,"_2870":119209},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3383":70423,"_29651":70380,"_20578":119211,"_5":14121,"_26960":119121,"_2870":119212},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3383":70424,"_29651":70380,"_20578":119214,"_5":14121,"_26960":119121,"_2870":119215},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3383":70425,"_29651":70380,"_20578":119217,"_5":14121,"_26960":119121,"_2870":119218},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3383":70426,"_29651":70380,"_20578":119220,"_5":14121,"_26960":119121,"_2870":119221},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3383":70427,"_29651":70380,"_20578":119223,"_5":14121,"_26960":119121,"_2870":119224},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3383":70428,"_29651":70380,"_20578":119226,"_5":14121,"_26960":119121,"_2870":119227},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3383":70429,"_29651":70380,"_20578":119229,"_5":14121,"_26960":119121,"_2870":119230},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3383":70430,"_29651":70430,"_5":14473,"_2870":119232,"_30004":119233,"_20578":119234,"_26960":70430},"Autoridades de certificación",[48280,115195,53750,119070],[],{"_3383":70431,"_29651":70430,"_20578":119236,"_5":14121,"_26960":70430,"_2870":119237},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3383":70432,"_29651":70430,"_5":30001,"_20578":119239,"_26960":119240,"_2870":119241},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3383":70433,"_29651":70430,"_5":30001,"_20578":119243,"_26960":119244,"_2870":119245},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3383":70434,"_29651":70430,"_5":30001,"_20578":119247,"_26960":119248,"_2870":113773},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3383":70435,"_29651":70430,"_5":30001,"_20578":119250,"_26960":119251,"_2870":119252},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3383":70436,"_29651":70430,"_5":30001,"_20578":119254,"_26960":119255,"_2870":119256},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3383":70437,"_29651":70430,"_5":30001,"_20578":119258,"_26960":119259,"_2870":119260},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3383":70438,"_29651":70430,"_5":30001,"_20578":119262,"_26960":119263,"_2870":119264},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3383":70439,"_29651":70430,"_5":30001,"_20578":119266,"_26960":119267,"_2870":119268},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3383":70440,"_29651":70430,"_5":30001,"_20578":119270,"_26960":119271,"_2870":119272},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3383":70441,"_29651":70430,"_5":30001,"_20578":119274,"_26960":119275,"_2870":119276},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3383":70442,"_29651":70430,"_5":30001,"_20578":119278,"_26960":119279,"_2870":119280},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3383":70443,"_29651":70430,"_5":30001,"_20578":119282,"_26960":119283,"_2870":119284},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3383":70444,"_29651":70430,"_5":30001,"_20578":119286,"_26960":119287,"_2870":119288},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3383":70445,"_29651":70430,"_5":30001,"_20578":119290,"_26960":119291,"_2870":119292},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3383":70446,"_29651":70430,"_5":30001,"_20578":119294,"_26960":119295,"_2870":119296},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3383":70447,"_29651":70430,"_5":30001,"_20578":119298,"_26960":119299,"_2870":119300},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3383":70448,"_29651":70430,"_5":30001,"_20578":119302,"_26960":119303,"_2870":119304},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3383":70449,"_29651":70430,"_5":30001,"_20578":119306,"_26960":119307,"_2870":119308},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3383":70450,"_29651":70430,"_5":30001,"_20578":119310,"_26960":119311,"_2870":119312},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3383":70451,"_29651":70430,"_5":30001,"_20578":119314,"_26960":119315,"_2870":119316},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3383":70452,"_29651":70430,"_5":30001,"_20578":119318,"_26960":119319,"_2870":119320},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3383":70453,"_29651":70430,"_5":30001,"_20578":119322,"_26960":119323,"_2870":119324},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3383":70454,"_29651":70430,"_5":30001,"_20578":119326,"_26960":119327,"_2870":119328},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-authorities#elimina-una-ca","Elimina una CA",{"_3383":70455,"_29651":70430,"_20578":119330,"_5":14121,"_26960":70430,"_2870":119331},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3383":70456,"_29651":70430,"_20578":119333,"_5":14121,"_26960":70430,"_2870":119334},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3383":70457,"_29651":70430,"_20578":119336,"_5":14121,"_26960":70430,"_2870":119337},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3383":70458,"_29651":70430,"_20578":119339,"_5":14121,"_26960":119240,"_2870":119340},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3383":70459,"_29651":70430,"_20578":119342,"_5":14121,"_26960":119240,"_2870":119343},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3383":70460,"_29651":70430,"_20578":119345,"_5":14121,"_26960":119240,"_2870":119346},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3383":70461,"_29651":70430,"_20578":119348,"_5":14121,"_26960":119240,"_2870":119349},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3383":70462,"_29651":70430,"_20578":119351,"_5":14121,"_26960":119240,"_2870":119352},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3383":70463,"_29651":70430,"_20578":119354,"_5":14121,"_26960":119248,"_2870":119355},[],"Decide si la CA será raíz o intermedia.",{"_3383":70464,"_29651":70430,"_20578":119357,"_5":14121,"_26960":119248,"_2870":119358},[],"Elige el motor que custodiará la clave.",{"_3383":70465,"_29651":70430,"_20578":119360,"_5":14121,"_26960":119248,"_2870":119361},[],"Define una validez superior a la de los certificados que emitirá.",{"_3383":70466,"_29651":70430,"_20578":119363,"_5":14121,"_26960":119248,"_2870":119364},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3383":70467,"_29651":70430,"_20578":119366,"_5":14121,"_26960":119251,"_2870":119367},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3383":70468,"_29651":70430,"_20578":119369,"_5":14121,"_26960":119255,"_2870":119370},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3383":70469,"_29651":70430,"_20578":119372,"_5":14121,"_26960":119255,"_2870":119373},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3383":70470,"_29651":70430,"_20578":119375,"_5":14121,"_26960":119259,"_2870":119376},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3383":70471,"_29651":70430,"_20578":119378,"_5":14121,"_26960":119263,"_2870":119379},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3383":70472,"_29651":70430,"_20578":119381,"_5":14121,"_26960":119263,"_2870":119382},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3383":70473,"_29651":70430,"_20578":119384,"_5":14121,"_26960":119263,"_2870":119385},[],"`ST`: estado o provincia.",{"_3383":70474,"_29651":70430,"_20578":119387,"_5":14121,"_26960":119263,"_2870":119388},[],"`L`: localidad.",{"_3383":70475,"_29651":70430,"_20578":119390,"_5":14121,"_26960":119263,"_2870":119391},[],"`O`: organización.",{"_3383":70476,"_29651":70430,"_20578":119393,"_5":14121,"_26960":119263,"_2870":119394},[],"`OU`: unidad organizativa.",{"_3383":70477,"_29651":70430,"_20578":119396,"_5":14121,"_26960":119263,"_2870":119397},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3383":70478,"_29651":70430,"_20578":119399,"_5":14121,"_26960":119267,"_2870":119400},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3383":70479,"_29651":70430,"_20578":119402,"_5":14121,"_26960":119267,"_2870":119403},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3383":70480,"_29651":70430,"_20578":119405,"_5":14121,"_26960":119271,"_2870":119406},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3383":70481,"_29651":70430,"_20578":119408,"_5":14121,"_26960":119271,"_2870":119409},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3383":70482,"_29651":70430,"_20578":119411,"_5":14121,"_26960":119275,"_2870":119412},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3383":70483,"_29651":70430,"_20578":119414,"_5":14121,"_26960":119275,"_2870":119415},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3383":70484,"_29651":70430,"_20578":119417,"_5":14121,"_26960":119279,"_2870":119418},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma (incluido `cRLSign`, sin el cual la CA no puede publicar su CRL) y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3383":70485,"_29651":70430,"_20578":119420,"_5":14121,"_26960":119279,"_2870":119421},[],"El backend rechaza una importación cuyo certificado carece de la restricción básica de CA (`basicConstraints cA flag is not set`), cuyo número de serie coincide con el de un certificado almacenado con contenido distinto, o cuyo certificado idéntico ya pertenece a una CA existente. El registro de certificado de una CA eliminada se conserva y puede reutilizarse al reimportar el mismo certificado, incluido su estado anterior. Reimportar otro certificado con ese número de serie se rechaza; comprueba el certificado y su estado tras reimportarlo.",{"_3383":70486,"_29651":70430,"_20578":119423,"_5":14121,"_26960":119279,"_2870":119424},[],"Eliminar una CA libera las referencias a la clave de su propio certificado actual y de sus certificados reemitidos vinculados, pero conserva esos registros para la CRL y el OCSP de su emisor. Después intenta eliminar la clave; el KMS la conserva si otros certificados todavía la referencian, como los de otra CA que comparte la clave. Revocar los certificados emitidos por la CA eliminada no libera sus propias referencias a claves.",{"_3383":70487,"_29651":70430,"_20578":119426,"_5":14121,"_26960":119283,"_2870":119427},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3383":70488,"_29651":70430,"_20578":119429,"_5":14121,"_26960":119287,"_2870":119430},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3383":70489,"_29651":70430,"_20578":119432,"_5":14121,"_26960":119291,"_2870":119433},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3383":70490,"_29651":70430,"_20578":119435,"_5":14121,"_26960":119295,"_2870":119436},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3383":70491,"_29651":70430,"_20578":119438,"_5":14121,"_26960":119295,"_2870":119439},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3383":70492,"_29651":70430,"_20578":119441,"_5":14121,"_26960":119299,"_2870":119442},[],"Abre una CA desde el inventario para consultar:",{"_3383":70493,"_29651":70430,"_20578":119444,"_5":14121,"_26960":119299,"_2870":119445},[],"Estado y periodo de validez.",{"_3383":70494,"_29651":70430,"_20578":119447,"_5":14121,"_26960":119299,"_2870":119448},[],"Certificado y cadena en formato PEM.",{"_3383":70495,"_29651":70430,"_20578":119450,"_5":14121,"_26960":119299,"_2870":119451},[],"Número de certificados activos, expirados y revocados.",{"_3383":70496,"_29651":70430,"_20578":119453,"_5":14121,"_26960":119299,"_2870":119454},[],"Certificados emitidos en **Issued Certificates**.",{"_3383":70497,"_29651":70430,"_20578":119456,"_5":14121,"_26960":119299,"_2870":119457},[],"CRL vinculada a la autoridad.",{"_3383":70498,"_29651":70430,"_20578":119459,"_5":14121,"_26960":119299,"_2870":119460},[],"Metadatos y motor criptográfico asociado.",{"_3383":70499,"_29651":70430,"_20578":119462,"_5":14121,"_26960":119299,"_2870":119463},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3383":70500,"_29651":70430,"_20578":119465,"_5":14121,"_26960":119303,"_2870":119466},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3383":70501,"_29651":70430,"_20578":119468,"_5":14121,"_26960":119303,"_2870":119469},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3383":70502,"_29651":70430,"_20578":119471,"_5":14121,"_26960":119303,"_2870":119472},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3383":70503,"_29651":70430,"_20578":119474,"_5":14121,"_26960":119303,"_2870":119475},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3383":70504,"_29651":70430,"_20578":119477,"_5":14121,"_26960":119307,"_2870":119478},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_3383":70505,"_29651":70430,"_20578":119480,"_5":14121,"_26960":119311,"_2870":119481},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3383":70506,"_29651":70430,"_20578":119483,"_5":14121,"_26960":119315,"_2870":119484},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3383":70507,"_29651":70430,"_20578":119486,"_5":14121,"_26960":119319,"_2870":119487},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3383":70508,"_29651":70430,"_20578":119489,"_5":14121,"_26960":119323,"_2870":119490},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3383":70509,"_29651":70430,"_20578":119492,"_5":14121,"_26960":119327,"_2870":119493},[],"La eliminación permanente solo está disponible con la CA revocada o caducada; una CA importada sin clave puede eliminarse en cualquier estado. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3383":70510,"_29651":70430,"_20578":119495,"_5":14121,"_26960":119327,"_2870":119496},[],"El rol VA de la CA se conserva. Si no queda otra CA con el mismo SKI, deja de ser editable (consulta CRL), así que ajusta antes su validez y su firmante. La clave de la CA se libera, pero el KMS la conserva mientras otros certificados la referencien.",{"_3383":70511,"_29651":70430,"_20578":119498,"_5":14121,"_26960":119327,"_2870":119499},[],"Lamassu conserva el registro del certificado de una CA eliminada. Si se importa de nuevo ese mismo certificado, la importación termina bien y reutiliza el registro: actualiza el tipo, el emisor y la clave, pero conserva el estado, así que la CA reaparece con el que tenía al eliminarse (normalmente revocada o caducada). Un certificado distinto con el mismo número de serie se rechaza con error 400, y un certificado que ya pertenece a una CA existente, con error 409. Para no heredar el estado anterior, usa un certificado con otro número de serie y comprueba el resultado tras importar. Si el certificado nuevo usa la misma clave, comparte el SKI con el rol VA retenido de la CA eliminada, cuyo firmante es el certificado antiguo: comprueba que la CRL se genera y, si no es así, asigna con `PUT` un firmante de la CA nueva (consulta CRL).",{"_3383":70512,"_29651":70512,"_5":14473,"_2870":119501,"_30004":119502,"_20578":119503,"_26960":70512},"Perfiles de certificado",[48280,115195,53750,119070],[],{"_3383":70513,"_29651":70512,"_20578":119505,"_5":14121,"_26960":70512,"_2870":119506},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3383":70514,"_29651":70512,"_5":30001,"_20578":119508,"_26960":119509,"_2870":119510},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3383":70515,"_29651":70512,"_5":30001,"_20578":119512,"_26960":119513,"_2870":119514},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-profiles#validez","Validez",{"_3383":70516,"_29651":70512,"_5":30001,"_20578":119516,"_26960":119517,"_2870":119518},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3383":70517,"_29651":70512,"_5":30001,"_20578":119520,"_26960":119521,"_2870":119522},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3383":70518,"_29651":70512,"_5":30001,"_20578":119524,"_26960":119525,"_2870":119526},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3383":70519,"_29651":70512,"_5":30001,"_20578":119528,"_26960":119529,"_2870":119530},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3383":70520,"_29651":70512,"_5":30001,"_20578":119532,"_26960":119533,"_2870":119534},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3383":70521,"_29651":70512,"_5":30001,"_20578":119536,"_26960":119537,"_2870":119538},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3383":70522,"_29651":70512,"_5":30001,"_20578":119540,"_26960":119541,"_2870":119542},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3383":70523,"_29651":70512,"_5":30001,"_20578":119544,"_26960":119545,"_2870":119546},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3383":70524,"_29651":70512,"_5":30001,"_20578":119548,"_26960":119549,"_2870":119550},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3383":70525,"_29651":70512,"_5":30001,"_20578":119552,"_26960":119553,"_2870":119554},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3383":70526,"_29651":70512,"_5":30001,"_20578":119556,"_26960":119557,"_2870":119558},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3383":70527,"_29651":70512,"_5":30001,"_20578":119560,"_26960":119561,"_2870":119562},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3383":70528,"_29651":70512,"_5":30001,"_20578":119564,"_26960":119565,"_2870":119566},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3383":70529,"_29651":70512,"_5":30001,"_20578":119568,"_26960":119569,"_2870":119570},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3383":70530,"_29651":70512,"_20578":119572,"_5":14121,"_26960":70512,"_2870":119573},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3383":70531,"_29651":70512,"_20578":119575,"_5":14121,"_26960":70512,"_2870":119576},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3383":70532,"_29651":70512,"_20578":119578,"_5":14121,"_26960":119513,"_2870":119579},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3383":70533,"_29651":70512,"_20578":119581,"_5":14121,"_26960":119513,"_2870":119582},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3383":70534,"_29651":70512,"_20578":119584,"_5":14121,"_26960":119517,"_2870":119585},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Actívalo solo en perfiles destinados a crear o reemitir CAs subordinadas.",{"_3383":70535,"_29651":70512,"_20578":119587,"_5":14121,"_26960":119521,"_2870":119588},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3383":70536,"_29651":70512,"_20578":119590,"_5":14121,"_26960":119521,"_2870":119591},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3383":70537,"_29651":70512,"_20578":119593,"_5":14121,"_26960":119521,"_2870":119594},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3383":70538,"_29651":70512,"_20578":119596,"_5":14121,"_26960":119525,"_2870":119597},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3383":70539,"_29651":70512,"_20578":119599,"_5":14121,"_26960":119529,"_2870":119600},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3383":70540,"_29651":70512,"_20578":119602,"_5":14121,"_26960":119529,"_2870":119603},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3383":70541,"_29651":70512,"_20578":119605,"_5":14121,"_26960":119533,"_2870":119606},[],"La aplicación criptográfica puede:",{"_3383":70542,"_29651":70512,"_20578":119608,"_5":14121,"_26960":119533,"_2870":119609},[],"permitir o bloquear claves RSA;",{"_3383":70543,"_29651":70512,"_20578":119611,"_5":14121,"_26960":119533,"_2870":119612},[],"limitar los tamaños RSA admitidos;",{"_3383":70544,"_29651":70512,"_20578":119614,"_5":14121,"_26960":119533,"_2870":119615},[],"permitir o bloquear claves ECDSA;",{"_3383":70545,"_29651":70512,"_20578":119617,"_5":14121,"_26960":119533,"_2870":119618},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3383":70546,"_29651":70512,"_20578":119620,"_5":14121,"_26960":119533,"_2870":119621},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3383":70547,"_29651":70512,"_20578":119623,"_5":14121,"_26960":119537,"_2870":119624},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3383":70548,"_29651":70512,"_20578":119626,"_5":14121,"_26960":119537,"_2870":114955},[],{"_3383":70549,"_29651":70512,"_20578":119628,"_5":14121,"_26960":119537,"_2870":119629},[],"Primera opción",{"_3383":70550,"_29651":70512,"_20578":119631,"_5":14121,"_26960":119537,"_2870":119632},[],"Segunda opción",{"_3383":70551,"_29651":70512,"_20578":119634,"_5":14121,"_26960":119537,"_2870":119635},[],"Si no hay ninguna",{"_3383":70552,"_29651":70512,"_20578":119637,"_5":14121,"_26960":119537,"_2870":119638},[],"Firma directa con una CA",{"_3383":70553,"_29651":70512,"_20578":119640,"_5":14121,"_26960":119537,"_2870":119641},[],"`issuance_profile` incluido en la solicitud",{"_3383":70554,"_29651":70512,"_20578":119643,"_5":14121,"_26960":119537,"_2870":119644},[],"`issuance_profile_id` de la solicitud",{"_3383":70555,"_29651":70512,"_20578":119646,"_5":14121,"_26960":119537,"_2870":119647},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3383":70556,"_29651":70512,"_20578":119649,"_5":14121,"_26960":119537,"_2870":119650},[],"Emisión mediante DMS",{"_3383":70557,"_29651":70512,"_20578":119652,"_5":14121,"_26960":119537,"_2870":54334},[],{"_3383":70558,"_29651":70512,"_20578":119654,"_5":14121,"_26960":119537,"_2870":119655},[],"`settings.issuance_profile` incluido en el DMS",{"_3383":70559,"_29651":70512,"_20578":119657,"_5":14121,"_26960":119537,"_2870":119658},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3383":70560,"_29651":70512,"_20578":119660,"_5":14121,"_26960":119537,"_2870":119661},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3383":70561,"_29651":70512,"_20578":119663,"_5":14121,"_26960":119537,"_2870":119664},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3383":70562,"_29651":70512,"_20578":119666,"_5":14121,"_26960":119545,"_2870":119667},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3383":70563,"_29651":70512,"_20578":119669,"_5":14121,"_26960":119549,"_2870":119670},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3383":70564,"_29651":70512,"_20578":119672,"_5":14121,"_26960":119553,"_2870":119673},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3383":70565,"_29651":70512,"_20578":119675,"_5":14121,"_26960":119557,"_2870":119676},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3383":70566,"_29651":70512,"_20578":119678,"_5":14121,"_26960":119561,"_2870":119679},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3383":70567,"_29651":70512,"_20578":119681,"_5":14121,"_26960":119561,"_2870":119682},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3383":70568,"_29651":70512,"_20578":119684,"_5":14121,"_26960":119565,"_2870":119685},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3383":70569,"_29651":70512,"_20578":119687,"_5":14121,"_26960":119565,"_2870":119688},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3383":70570,"_29651":70512,"_20578":119690,"_5":14121,"_26960":119565,"_2870":119691},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3383":70571,"_29651":70512,"_20578":119693,"_5":14121,"_26960":119565,"_2870":119694},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3383":70572,"_29651":70512,"_20578":119696,"_5":14121,"_26960":119569,"_2870":119697},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3383":70573,"_29651":70512,"_20578":119699,"_5":14121,"_26960":119569,"_2870":119700},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3383":70574,"_29651":70574,"_5":14473,"_2870":119702,"_30004":119703,"_20578":119705,"_26960":70574},"Validación de certificados",[48280,115195,53750,119704],"Validación",[],{"_3383":70575,"_29651":70574,"_20578":119707,"_5":14121,"_26960":70574,"_2870":119708},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3383":70576,"_29651":70574,"_5":30001,"_20578":119710,"_26960":119711,"_2870":119712},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3383":70577,"_29651":70574,"_5":30001,"_20578":119714,"_26960":119715,"_2870":119716},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3383":70578,"_29651":70574,"_5":30001,"_20578":119718,"_26960":119719,"_2870":119720},[],"/docs/pr-preview/pr-55/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3383":70579,"_29651":70574,"_20578":119722,"_5":14121,"_26960":70574,"_2870":119723},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3383":70580,"_29651":70574,"_20578":119725,"_5":14121,"_26960":119711,"_2870":119726},[],"Verifica estos criterios juntos:",{"_3383":70581,"_29651":70574,"_20578":119728,"_5":14121,"_26960":119711,"_2870":118699},[],{"_3383":70582,"_29651":70574,"_20578":119730,"_5":14121,"_26960":119711,"_2870":119731},[],"Resultado necesario",{"_3383":70583,"_29651":70574,"_20578":119733,"_5":14121,"_26960":119711,"_2870":119734},[],"Cadena y firma",{"_3383":70584,"_29651":70574,"_20578":119736,"_5":14121,"_26960":119711,"_2870":119737},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3383":70585,"_29651":70574,"_20578":119739,"_5":14121,"_26960":119711,"_2870":119740},[],"Fechas",{"_3383":70586,"_29651":70574,"_20578":119742,"_5":14121,"_26960":119711,"_2870":119743},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3383":70587,"_29651":70574,"_20578":119745,"_5":14121,"_26960":119711,"_2870":114865},[],{"_3383":70588,"_29651":70574,"_20578":119747,"_5":14121,"_26960":119711,"_2870":119748},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3383":70589,"_29651":70574,"_20578":119750,"_5":14121,"_26960":119711,"_2870":119751},[],"Uso",{"_3383":70590,"_29651":70574,"_20578":119753,"_5":14121,"_26960":119711,"_2870":119754},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3383":70591,"_29651":70574,"_20578":119756,"_5":14121,"_26960":119711,"_2870":119757},[],"Revocación",{"_3383":70592,"_29651":70574,"_20578":119759,"_5":14121,"_26960":119711,"_2870":119760},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3383":70593,"_29651":70574,"_20578":119762,"_5":14121,"_26960":119711,"_2870":119763},[],"Autorización",{"_3383":70594,"_29651":70574,"_20578":119765,"_5":14121,"_26960":119711,"_2870":119766},[],"La aplicación permite la acción a esa identidad.",{"_3383":70595,"_29651":70574,"_20578":119768,"_5":14121,"_26960":119711,"_2870":119769},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3383":70596,"_29651":70574,"_20578":119771,"_5":14121,"_26960":119715,"_2870":119772},[],"Mecanismo",{"_3383":70597,"_29651":70574,"_20578":119774,"_5":14121,"_26960":119715,"_2870":119775},[],"Cuándo utilizarlo",{"_3383":70598,"_29651":70574,"_20578":119777,"_5":14121,"_26960":119715,"_2870":119778},[],"Qué debes mantener",{"_3383":70599,"_29651":70574,"_20578":119780,"_5":14121,"_26960":119715,"_2870":54462},[],{"_3383":70600,"_29651":70574,"_20578":119782,"_5":14121,"_26960":119715,"_2870":119783},[],"Consulta del estado de un certificado concreto.",{"_3383":70601,"_29651":70574,"_20578":119785,"_5":14121,"_26960":119715,"_2870":119786},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3383":70602,"_29651":70574,"_20578":119788,"_5":14121,"_26960":119715,"_2870":54471},[],{"_3383":70603,"_29651":70574,"_20578":119790,"_5":14121,"_26960":119715,"_2870":119791},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3383":70604,"_29651":70574,"_20578":119793,"_5":14121,"_26960":119715,"_2870":119794},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3383":70605,"_29651":70574,"_20578":119796,"_5":14121,"_26960":119715,"_2870":119797},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3383":70606,"_29651":70574,"_20578":119799,"_5":14121,"_26960":119715,"_2870":119800},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3383":70607,"_29651":70574,"_20578":119802,"_5":14121,"_26960":119719,"_2870":119803},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3383":70608,"_29651":70574,"_20578":119805,"_5":14121,"_26960":119719,"_2870":119806},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3383":70609,"_29651":70574,"_20578":119808,"_5":14121,"_26960":119719,"_2870":119809},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3383":70610,"_29651":70574,"_20578":119811,"_5":14121,"_26960":119719,"_2870":119812},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3383":70611,"_29651":70574,"_20578":119814,"_5":14121,"_26960":119719,"_2870":119815},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3383":70612,"_29651":70574,"_20578":119817,"_5":14121,"_26960":119719,"_2870":119818},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3383":70613,"_29651":70574,"_20578":119820,"_5":14121,"_26960":119719,"_2870":119821},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3383":70614,"_29651":70574,"_20578":119823,"_5":14121,"_26960":119719,"_2870":119824},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3383":70615,"_29651":70574,"_20578":119826,"_5":14121,"_26960":119719,"_2870":119827},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3383":70616,"_29651":70616,"_5":14473,"_2870":119829,"_30004":119830,"_20578":119831,"_26960":70616},"Certificados",[48280,115195,53750,119070],[],{"_3383":70617,"_29651":70616,"_20578":119833,"_5":14121,"_26960":70616,"_2870":119834},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3383":70618,"_29651":70616,"_5":30001,"_20578":119836,"_26960":119837,"_2870":119838},[],"/docs/pr-preview/pr-55/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3383":70619,"_29651":70616,"_5":30001,"_20578":119840,"_26960":119841,"_2870":119842},[],"/docs/pr-preview/pr-55/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3383":70620,"_29651":70616,"_5":30001,"_20578":119844,"_26960":119845,"_2870":119846},[],"/docs/pr-preview/pr-55/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3383":70621,"_29651":70616,"_5":30001,"_20578":119848,"_26960":119849,"_2870":119850},[],"/docs/pr-preview/pr-55/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3383":70622,"_29651":70616,"_5":30001,"_20578":119852,"_26960":119853,"_2870":119854},[],"/docs/pr-preview/pr-55/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3383":70623,"_29651":70616,"_5":30001,"_20578":119856,"_26960":119857,"_2870":119858},[],"/docs/pr-preview/pr-55/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3383":70624,"_29651":70616,"_5":30001,"_20578":119860,"_26960":119861,"_2870":119862},[],"/docs/pr-preview/pr-55/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3383":70625,"_29651":70616,"_5":30001,"_20578":119864,"_26960":119865,"_2870":119866},[],"/docs/pr-preview/pr-55/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3383":70626,"_29651":70616,"_5":30001,"_20578":119868,"_26960":119869,"_2870":119870},[],"/docs/pr-preview/pr-55/es/platform/pki/certificates#continúa","Continúa",{"_3383":70627,"_29651":70616,"_20578":119872,"_5":14121,"_26960":70616,"_2870":119873},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3383":70628,"_29651":70616,"_20578":119875,"_5":14121,"_26960":119837,"_2870":119876},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Un certificado no contiene su clave privada, así que las superficies de clave privada responden qué certificados tienen su clave custodiada en el KMS de Lamassu:",{"_3383":70629,"_29651":70616,"_20578":119878,"_5":14121,"_26960":119837,"_2870":119879},[],"El filtro avanzado **Private Key**, disponible en la página Certificates y en la pestaña **Issued Certificates** de una CA, limita la lista a **All Certificates**, **With Private Key** o **Without Private Key**.",{"_3383":70630,"_29651":70616,"_20578":119881,"_5":14121,"_26960":119837,"_2870":119882},[],"La columna ordenable **Private Key** — visible por defecto y oculta en pantallas estrechas — marca con una marca de verificación verde la clave custodiada en el KMS y muestra `-` en los demás casos.",{"_3383":70631,"_29651":70616,"_20578":119884,"_5":14121,"_26960":119837,"_2870":119885},[],"En los detalles del certificado, la pestaña **Information** muestra una fila **Private Key** en la sección **Key & Signature**. Cuando el certificado indica que tiene clave privada y están disponibles los identificadores de la clave y del motor del KMS, la fila enlaza a la clave (tooltip: **Open private key in KMS**). En caso contrario, muestra **Present** si el certificado indica que tiene clave privada o **Not available** si no lo indica. Esto no determina si existe una clave fuera de Lamassu.",{"_3383":70632,"_29651":70616,"_20578":119887,"_5":14121,"_26960":119837,"_2870":119888},[],"Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_3383":70633,"_29651":70616,"_20578":119890,"_5":14121,"_26960":119837,"_2870":119891},[],"Los detalles del certificado incluyen la referencia a la clave (`key_id`) y si la clave privada está gestionada (`has_private_key`); las listas de certificados pueden filtrarse por `has_private_key`.",{"_3383":70634,"_29651":70616,"_20578":119893,"_5":14121,"_26960":119837,"_2870":119894},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3383":70635,"_29651":70616,"_20578":119896,"_5":14121,"_26960":119841,"_2870":119897},[],"Descarga el PEM e inspecciónalo:",{"_3383":70636,"_29651":70616,"_20578":119899,"_5":14121,"_26960":119841,"_2870":119900},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3383":70637,"_29651":70616,"_20578":119902,"_5":14121,"_26960":119845,"_2870":119903},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3383":70638,"_29651":70616,"_20578":119905,"_5":14121,"_26960":119845,"_2870":119906},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3383":70639,"_29651":70616,"_20578":119908,"_5":14121,"_26960":119845,"_2870":119909},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3383":70640,"_29651":70616,"_20578":119911,"_5":14121,"_26960":119845,"_2870":119912},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3383":70641,"_29651":70616,"_20578":119914,"_5":14121,"_26960":119845,"_2870":119915},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3383":70642,"_29651":70616,"_20578":119917,"_5":14121,"_26960":119845,"_2870":119918},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3383":70643,"_29651":70616,"_20578":119920,"_5":14121,"_26960":119845,"_2870":119921},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3383":70644,"_29651":70616,"_20578":119923,"_5":14121,"_26960":119849,"_2870":119924},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3383":70645,"_29651":70616,"_20578":119926,"_5":14121,"_26960":119853,"_2870":119927},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3383":70646,"_29651":70616,"_20578":119929,"_5":14121,"_26960":119857,"_2870":119930},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3383":70647,"_29651":70616,"_20578":119932,"_5":14121,"_26960":119861,"_2870":119933},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3383":70648,"_29651":70616,"_20578":119935,"_5":14121,"_26960":119861,"_2870":119936},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3383":70649,"_29651":70616,"_20578":119938,"_5":14121,"_26960":119861,"_2870":119939},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3383":70650,"_29651":70616,"_20578":119941,"_5":14121,"_26960":119865,"_2870":119942},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3383":70651,"_29651":70616,"_20578":119944,"_5":14121,"_26960":119865,"_2870":119945},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3383":70652,"_29651":70616,"_20578":119947,"_5":14121,"_26960":119865,"_2870":119948},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_3383":70653,"_29651":70616,"_20578":119950,"_5":14121,"_26960":119869,"_2870":119951},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3383":70654,"_29651":70616,"_20578":119953,"_5":14121,"_26960":119869,"_2870":119954},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3383":70655,"_29651":70655,"_5":14473,"_2870":119956,"_30004":119957,"_20578":119959,"_26960":70655},"Ciclo de vida de un certificado",[48280,115195,53750,119958],"Conceptos",[],{"_3383":70656,"_29651":70655,"_20578":119961,"_5":14121,"_26960":70655,"_2870":119962},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3383":70657,"_29651":70655,"_5":30001,"_20578":119964,"_26960":119965,"_2870":119966},[],"/docs/pr-preview/pr-55/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3383":70658,"_29651":70655,"_5":30001,"_20578":119968,"_26960":119969,"_2870":119970},[],"/docs/pr-preview/pr-55/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3383":70659,"_29651":70655,"_5":30001,"_20578":119972,"_26960":119973,"_2870":119974},[],"/docs/pr-preview/pr-55/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3383":70660,"_29651":70655,"_5":30001,"_20578":119976,"_26960":119977,"_2870":119978},[],"/docs/pr-preview/pr-55/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3383":70661,"_29651":70655,"_5":30001,"_20578":119980,"_26960":119981,"_2870":119982},[],"/docs/pr-preview/pr-55/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3383":70662,"_29651":70655,"_5":30001,"_20578":119984,"_26960":119985,"_2870":119986},[],"/docs/pr-preview/pr-55/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3383":70663,"_29651":70655,"_5":30001,"_20578":119988,"_26960":119989,"_2870":117693},[],"/docs/pr-preview/pr-55/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado",{"_3383":70664,"_29651":70655,"_5":30001,"_20578":119991,"_26960":119992,"_2870":119993},[],"/docs/pr-preview/pr-55/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3383":70665,"_29651":70655,"_5":30001,"_20578":119995,"_26960":119996,"_2870":119997},[],"/docs/pr-preview/pr-55/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3383":70666,"_29651":70655,"_5":30001,"_20578":119999,"_26960":120000,"_2870":120001},[],"/docs/pr-preview/pr-55/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3383":70667,"_29651":70655,"_20578":120003,"_5":14121,"_26960":70655,"_2870":120004},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3383":70668,"_29651":70655,"_20578":120006,"_5":14121,"_26960":119969,"_2870":120007},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3383":70669,"_29651":70655,"_20578":120009,"_5":14121,"_26960":119973,"_2870":120010},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3383":70670,"_29651":70655,"_20578":120012,"_5":14121,"_26960":119977,"_2870":120013},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3383":70671,"_29651":70655,"_20578":120015,"_5":14121,"_26960":119981,"_2870":120016},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3383":70672,"_29651":70655,"_20578":120018,"_5":14121,"_26960":119985,"_2870":120019},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3383":70673,"_29651":70655,"_20578":120021,"_5":14121,"_26960":119989,"_2870":120022},[],"Lamassu persiste cuatro estados X.509:",{"_3383":70674,"_29651":70655,"_20578":120024,"_5":14121,"_26960":119989,"_2870":120025},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3383":70675,"_29651":70655,"_20578":120027,"_5":14121,"_26960":119989,"_2870":120028},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3383":70676,"_29651":70655,"_20578":120030,"_5":14121,"_26960":119989,"_2870":120031},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3383":70677,"_29651":70655,"_20578":120033,"_5":14121,"_26960":119989,"_2870":120034},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3383":70678,"_29651":70655,"_20578":120036,"_5":14121,"_26960":119989,"_2870":120037},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3383":70679,"_29651":70655,"_20578":120039,"_5":14121,"_26960":119992,"_2870":120040},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3383":70680,"_29651":70655,"_20578":120042,"_5":14121,"_26960":119992,"_2870":120043},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3383":70681,"_29651":70655,"_20578":120045,"_5":14121,"_26960":119992,"_2870":120046},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3383":70682,"_29651":70655,"_20578":120048,"_5":14121,"_26960":119996,"_2870":120049},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3383":70683,"_29651":70655,"_20578":120051,"_5":14121,"_26960":119996,"_2870":120052},[],"Antes de confirmar:",{"_3383":70684,"_29651":70655,"_20578":120054,"_5":14121,"_26960":119996,"_2870":120055},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3383":70685,"_29651":70655,"_20578":120057,"_5":14121,"_26960":119996,"_2870":120058},[],"Distribuye la nueva cadena de confianza.",{"_3383":70686,"_29651":70655,"_20578":120060,"_5":14121,"_26960":119996,"_2870":120061},[],"Reemite las identidades necesarias.",{"_3383":70687,"_29651":70655,"_20578":120063,"_5":14121,"_26960":119996,"_2870":120064},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3383":70688,"_29651":70655,"_20578":120066,"_5":14121,"_26960":119996,"_2870":120067},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3383":70689,"_29651":70655,"_20578":120069,"_5":14121,"_26960":119996,"_2870":120070},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3383":70690,"_29651":70655,"_20578":120072,"_5":14121,"_26960":120000,"_2870":120073},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3383":70691,"_29651":70655,"_20578":120075,"_5":14121,"_26960":120000,"_2870":120076},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3383":70692,"_29651":70655,"_20578":120078,"_5":14121,"_26960":120000,"_2870":120079},[],"Cambios de estado y razones de revocación.",{"_3383":70693,"_29651":70655,"_20578":120081,"_5":14121,"_26960":120000,"_2870":120082},[],"Publicación y vigencia de OCSP y CRLs.",{"_3383":70694,"_29651":70655,"_20578":120084,"_5":14121,"_26960":120000,"_2870":120085},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3383":70695,"_29651":70655,"_20578":120087,"_5":14121,"_26960":120000,"_2870":120088},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3383":70696,"_29651":70696,"_5":14473,"_2870":120090,"_30004":120091,"_20578":120092,"_26960":70696},"Modelo de confianza",[48280,115195,53750,119958],[],{"_3383":70697,"_29651":70696,"_20578":120094,"_5":14121,"_26960":70696,"_2870":120095},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3383":70698,"_29651":70696,"_5":30001,"_20578":120097,"_26960":120098,"_2870":120099},[],"/docs/pr-preview/pr-55/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3383":70699,"_29651":70696,"_5":30001,"_20578":120101,"_26960":120102,"_2870":120103},[],"/docs/pr-preview/pr-55/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3383":70700,"_29651":70696,"_5":30001,"_20578":120105,"_26960":120106,"_2870":120107},[],"/docs/pr-preview/pr-55/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3383":70701,"_29651":70696,"_5":30001,"_20578":120109,"_26960":120110,"_2870":120111},[],"/docs/pr-preview/pr-55/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3383":70702,"_29651":70696,"_5":30001,"_20578":120113,"_26960":120114,"_2870":120115},[],"/docs/pr-preview/pr-55/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3383":70703,"_29651":70696,"_5":30001,"_20578":120117,"_26960":120118,"_2870":120119},[],"/docs/pr-preview/pr-55/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3383":70704,"_29651":70696,"_5":30001,"_20578":120121,"_26960":120122,"_2870":120123},[],"/docs/pr-preview/pr-55/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3383":70705,"_29651":70696,"_5":30001,"_20578":120125,"_26960":120126,"_2870":120127},[],"/docs/pr-preview/pr-55/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3383":70706,"_29651":70696,"_5":30001,"_20578":120129,"_26960":120130,"_2870":120131},[],"/docs/pr-preview/pr-55/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3383":70707,"_29651":70696,"_5":30001,"_20578":120133,"_26960":120134,"_2870":120135},[],"/docs/pr-preview/pr-55/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3383":70708,"_29651":70696,"_20578":120137,"_5":14121,"_26960":70696,"_2870":120138},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3383":70709,"_29651":70696,"_20578":120140,"_5":14121,"_26960":120102,"_2870":120141},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3383":70710,"_29651":70696,"_20578":120143,"_5":14121,"_26960":120106,"_2870":120144},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3383":70711,"_29651":70696,"_20578":120146,"_5":14121,"_26960":120110,"_2870":120147},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3383":70712,"_29651":70696,"_20578":120149,"_5":14121,"_26960":120114,"_2870":120150},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3383":70713,"_29651":70696,"_20578":120152,"_5":14121,"_26960":120118,"_2870":120153},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3383":70714,"_29651":70696,"_20578":120155,"_5":14121,"_26960":120118,"_2870":120156},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3383":70715,"_29651":70696,"_20578":120158,"_5":14121,"_26960":120118,"_2870":120159},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3383":70716,"_29651":70696,"_20578":120161,"_5":14121,"_26960":120118,"_2870":120162},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3383":70717,"_29651":70696,"_20578":120164,"_5":14121,"_26960":120118,"_2870":120165},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3383":70718,"_29651":70696,"_20578":120167,"_5":14121,"_26960":120118,"_2870":120168},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3383":70719,"_29651":70696,"_20578":120170,"_5":14121,"_26960":120122,"_2870":120171},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3383":70720,"_29651":70696,"_20578":120173,"_5":14121,"_26960":120122,"_2870":120174},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3383":70721,"_29651":70696,"_20578":120176,"_5":14121,"_26960":120122,"_2870":120177},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_3383":70722,"_29651":70696,"_20578":120179,"_5":14121,"_26960":120122,"_2870":120180},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3383":70723,"_29651":70696,"_20578":120182,"_5":14121,"_26960":120122,"_2870":120183},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3383":70724,"_29651":70696,"_20578":120185,"_5":14121,"_26960":120126,"_2870":120186},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3383":70725,"_29651":70696,"_20578":120188,"_5":14121,"_26960":120126,"_2870":120189},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3383":70726,"_29651":70696,"_20578":120191,"_5":14121,"_26960":120126,"_2870":120192},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3383":70727,"_29651":70696,"_20578":120194,"_5":14121,"_26960":120126,"_2870":120195},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3383":70728,"_29651":70696,"_20578":120197,"_5":14121,"_26960":120126,"_2870":120198},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3383":70729,"_29651":70696,"_20578":120200,"_5":14121,"_26960":120126,"_2870":120201},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3383":70730,"_29651":70696,"_20578":120203,"_5":14121,"_26960":120126,"_2870":120204},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_3383":70731,"_29651":70696,"_20578":120206,"_5":14121,"_26960":120130,"_2870":120207},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3383":70732,"_29651":70696,"_20578":120209,"_5":14121,"_26960":120134,"_2870":120210},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3383":70733,"_29651":70696,"_20578":120212,"_5":14121,"_26960":120134,"_2870":120213},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3383":70734,"_29651":70696,"_20578":120215,"_5":14121,"_26960":120134,"_2870":120216},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3383":70735,"_29651":70696,"_20578":120218,"_5":14121,"_26960":120134,"_2870":120219},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3383":70736,"_29651":70696,"_20578":120221,"_5":14121,"_26960":120134,"_2870":120222},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3383":70737,"_29651":70696,"_20578":120224,"_5":14121,"_26960":120134,"_2870":120225},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3383":70738,"_29651":70696,"_20578":120227,"_5":14121,"_26960":120134,"_2870":120228},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3383":70739,"_29651":70739,"_5":14473,"_2870":120230,"_30004":120231,"_20578":120232,"_26960":70739},"Listas de revocación (CRL)",[48280,115195,53750,119704],[],{"_3383":70740,"_29651":70739,"_20578":120234,"_5":14121,"_26960":70739,"_2870":120235},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3383":70741,"_29651":70739,"_5":30001,"_20578":120237,"_26960":120238,"_2870":120239},[],"/docs/pr-preview/pr-55/es/platform/pki/crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_3383":70742,"_29651":70739,"_5":30001,"_20578":120241,"_26960":120242,"_2870":120243},[],"/docs/pr-preview/pr-55/es/platform/pki/crl#cas-que-comparten-clave","CAs que comparten clave",{"_3383":70743,"_29651":70739,"_5":30001,"_20578":120245,"_26960":120246,"_2870":120247},[],"/docs/pr-preview/pr-55/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3383":70744,"_29651":70739,"_5":30001,"_20578":120249,"_26960":120250,"_2870":120251},[],"/docs/pr-preview/pr-55/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3383":70745,"_29651":70739,"_5":30001,"_20578":120253,"_26960":120254,"_2870":120255},[],"/docs/pr-preview/pr-55/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3383":70746,"_29651":70739,"_5":30001,"_20578":120257,"_26960":120258,"_2870":120259},[],"/docs/pr-preview/pr-55/es/platform/pki/crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_3383":70747,"_29651":70739,"_5":30001,"_20578":120261,"_26960":120262,"_2870":120263},[],"/docs/pr-preview/pr-55/es/platform/pki/crl#errores-frecuentes-del-rol-va","Errores frecuentes del rol VA",{"_3383":70748,"_29651":70739,"_5":30001,"_20578":120265,"_26960":120266,"_2870":120267},[],"/docs/pr-preview/pr-55/es/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_3383":70749,"_29651":70739,"_5":30001,"_20578":120269,"_26960":120270,"_2870":120271},[],"/docs/pr-preview/pr-55/es/platform/pki/crl#referencias","Referencias",{"_3383":70750,"_29651":70739,"_20578":120273,"_5":14121,"_26960":70739,"_2870":120274},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su SKI y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3383":70751,"_29651":70739,"_20578":120276,"_5":14121,"_26960":120238,"_2870":120277},[],"El rol VA guarda la configuración y los metadatos de la última lista publicada para el SKI de una CA. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3383":70752,"_29651":70739,"_20578":120279,"_5":14121,"_26960":120238,"_2870":120280},[],"Campo de `crl_options`",{"_3383":70753,"_29651":70739,"_20578":120282,"_5":14121,"_26960":120238,"_2870":116733},[],{"_3383":70754,"_29651":70739,"_20578":120284,"_5":14121,"_26960":120238,"_2870":120285},[],"Valor inicial del backend",{"_3383":70755,"_29651":70739,"_20578":120287,"_5":14121,"_26960":120238,"_2870":54972},[],{"_3383":70756,"_29651":70739,"_20578":120289,"_5":14121,"_26960":120238,"_2870":120290},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3383":70757,"_29651":70739,"_20578":120292,"_5":14121,"_26960":120238,"_2870":120293},[],"7 días.",{"_3383":70758,"_29651":70739,"_20578":120295,"_5":14121,"_26960":120238,"_2870":54981},[],{"_3383":70759,"_29651":70739,"_20578":120297,"_5":14121,"_26960":120238,"_2870":120298},[],"Tiempo desde la emisión de la última CRL publicada que activa la renovación programada; `0` desactiva solo este disparador (consulta Regeneración periódica y automática).",{"_3383":70760,"_29651":70739,"_20578":120300,"_5":14121,"_26960":120238,"_2870":120301},[],"6 días y 23 horas.",{"_3383":70761,"_29651":70739,"_20578":120303,"_5":14121,"_26960":120238,"_2870":54990},[],{"_3383":70762,"_29651":70739,"_20578":120305,"_5":14121,"_26960":120238,"_2870":120306},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3383":70763,"_29651":70739,"_20578":120308,"_5":14121,"_26960":120238,"_2870":54996},[],{"_3383":70764,"_29651":70739,"_20578":120310,"_5":14121,"_26960":120238,"_2870":54999},[],{"_3383":70765,"_29651":70739,"_20578":120312,"_5":14121,"_26960":120238,"_2870":120313},[],"Número de serie del certificado existente que firma la CRL.",{"_3383":70766,"_29651":70739,"_20578":120315,"_5":14121,"_26960":120238,"_2870":120316},[],"Número de serie del certificado actual de la CA.",{"_3383":70767,"_29651":70739,"_20578":120318,"_5":14121,"_26960":120238,"_2870":120319},[],"El firmante debe ser un certificado existente con el uso `cRLSign`, el mismo sujeto y la misma clave pública que la CA. Quedan incluidos los certificados anteriores a una reemisión. No se admite un firmante delegado: un certificado con el sujeto de la CA pero con otra clave se rechaza.",{"_3383":70768,"_29651":70739,"_20578":120321,"_5":14121,"_26960":120238,"_2870":120322},[],"Al reemitir una CA, si el firmante del rol es el certificado de la CA sustituido, la VA lo mueve al certificado nuevo — siempre que incluya `cRLSign` — y republica la CRL. Si el firmante es cualquier otro certificado con el sujeto y la clave de la CA, se deja deliberadamente sin cambios; en ese caso el certificado anterior no puede eliminarse mientras el rol lo use, y para retirarlo actualizas el firmante con `PUT`.",{"_3383":70769,"_29651":70739,"_20578":120324,"_5":14121,"_26960":120238,"_2870":120325},[],"Al eliminar una CA, su rol VA se conserva y no puede borrarse por API. Si no queda ninguna otra CA con el mismo SKI, el rol puede consultarse pero cualquier `PUT` devuelve 404, y el trabajo de renovación registra un aviso en cada ciclo porque ya no encuentra la CA. La API no ofrece salida; solo se corrige editando la base de datos. Si queda otra CA con ese SKI, el rol sigue siendo editable (consulta CAs que comparten clave). Ajusta validez y firmante antes de eliminar la CA.",{"_3383":70770,"_29651":70739,"_20578":120327,"_5":14121,"_26960":120238,"_2870":120328},[],"Una CA cuyo certificado no tiene `cRLSign` no puede generar su CRL ni editar su rol (error 400). Desde 4.0 la VA exige este uso. Comprueba antes de importar con `openssl x509 -noout -ext keyUsage` y, si falta, obtén un certificado de la misma CA y clave que lo incluya y asígnalo como firmante con `PUT`. Tras reemitir una CA, comprueba también el uso de clave del certificado nuevo: puede no conservar los usos del original, y sin `cRLSign` el rol conserva su firmante anterior.",{"_3383":70771,"_29651":70739,"_20578":120330,"_5":14121,"_26960":120238,"_2870":120331},[],"El `PUT` valida siempre el firmante, aunque la petición no lo cambie. Si el firmante guardado ya no es válido, no se puede modificar ningún campo del rol, ni siquiera la validez, hasta asignar uno válido.",{"_3383":70772,"_29651":70739,"_20578":120333,"_5":14121,"_26960":120238,"_2870":120334},[],"Compartir una clave entre CA puede impedir la validación de las CRL. Consulta CAs que comparten clave.",{"_3383":70773,"_29651":70739,"_20578":120336,"_5":14121,"_26960":120238,"_2870":120337},[],"`latest_crl` contiene versión, inicio y fin de validez. Las versiones se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/{subject_key_id}/{version}.crl`; el endpoint público entrega DER.",{"_3383":70774,"_29651":70739,"_20578":120339,"_5":14121,"_26960":120242,"_2870":120340},[],"La VA identifica cada CRL por el SKI de la CA, y el SKI se deriva de su clave. Dos CAs con la misma clave tienen el mismo SKI y comparten un único rol VA y una única CRL. Ocurre al crear una CA sobre una clave ya existente del KMS, o al importar una CA cuyo certificado declara un SKI en uso. Lamassu toma el SKI del certificado importado tal cual y no comprueba que corresponda a su clave pública. El rol lo crea la primera CA y las demás lo conservan.",{"_3383":70775,"_29651":70739,"_20578":120342,"_5":14121,"_26960":120242,"_2870":120343},[],"Los certificados de todas ellas apuntan a `/crl/{ski}`, pero la lista publicada tiene como emisor a la primera CA y solo incluye sus revocaciones. Un verificador compara el emisor de la CRL con el del certificado que valida (RFC 5280, §6.3.2) y rechaza la lista si no coinciden. Según su política, el certificado queda bloqueado (*hard-fail*) o se acepta aunque esté revocado (*soft-fail*). Las revocaciones de las CAs secundarias no aparecen en ninguna lista.",{"_3383":70776,"_29651":70739,"_20578":120345,"_5":14121,"_26960":120242,"_2870":120346},[],"Si la primera CA se elimina, la generación de CRL de la restante falla porque el firmante configurado ya no corresponde a una CA con ese nombre. Hasta que se actualice el firmante del rol a un certificado de la CA restante, se sigue sirviendo la última lista publicada hasta que venza (7 días por defecto).",{"_3383":70777,"_29651":70739,"_20578":120348,"_5":14121,"_26960":120242,"_2870":120349},[],"Antes de actualizar, revisa las CAs que comparten clave. Para detectar el problema, compara el SKI de las CAs en el inventario: dos con el mismo SKI están afectadas. Para resolverlo, crea una CA con clave propia y reemite sus certificados; los ya emitidos conservan la URL antigua y no se corrigen hasta reemitirlos. Una CA importada con un SKI ya en uso no sustituye a la existente como emisora de la CRL, porque el emisor se resuelve a partir del firmante del rol. Sin embargo, sus propios certificados apuntan a esa misma URL y sus revocaciones no se publican. Hasta que Lamassu rechace estas importaciones, limita el permiso de importar CAs como control provisional; cubre solo la vía de importación. Crear una CA con &#x2A;*Create New CA (Existing Key)** sobre una clave KMS que otra CA ya usa produce la misma colisión, así que tampoco reutilices claves entre CAs. Una CRL por CA y el rechazo de importaciones cuyo SKI colisiona con el de una CA existente están planteados en lamassuiot#834, y ninguno está implementado todavía.",{"_3383":70778,"_29651":70739,"_20578":120351,"_5":14121,"_26960":120246,"_2870":120352},[],"El trabajo programado de la VA revisa todos los roles en cada ejecución y solicita una lista nueva cuando se cumple alguna de estas condiciones:",{"_3383":70779,"_29651":70739,"_20578":120354,"_5":14121,"_26960":120246,"_2870":120355},[],"**La lista está a punto de vencer:** a `latest_crl` le queda menos validez que el intervalo entre ejecuciones del trabajo. Esta condición se aplica siempre y no puede desactivarse.",{"_3383":70780,"_29651":70739,"_20578":120357,"_5":14121,"_26960":120246,"_2870":120358},[],"**Ha transcurrido el intervalo de renovación:** el tiempo desde la emisión de la última CRL publicada alcanza `refresh_interval`. Con `refresh_interval` a `0` se desactiva solo esta condición; la lista se sigue regenerando cuando está a punto de vencer.",{"_3383":70781,"_29651":70739,"_20578":120360,"_5":14121,"_26960":120246,"_2870":120361},[],"Poner `refresh_interval` a `0` no congela, por tanto, la regeneración. Con la validez por defecto de 7 días y un trabajo cada hora, la CRL se renueva hasta una hora antes de vencer aunque `refresh_interval` sea `0`.",{"_3383":70782,"_29651":70739,"_20578":120363,"_5":14121,"_26960":120246,"_2870":120364},[],"La frecuencia del trabajo se configura en Helm con `services.va.job.crl.frequency` (por defecto `0 * * * *`) y admite una duración (`1h`) o una expresión cron. Una expresión cron se convierte en un intervalo constante igual al tiempo que falta para su siguiente disparo cuando arranca el servicio, así que no se alinea con el reloj. Mantén `validity` claramente por encima de ese intervalo: con una validez menor, la lista se regenera en cada ciclo.",{"_3383":70783,"_29651":70739,"_20578":120366,"_5":14121,"_26960":120246,"_2870":120367},[],"Si la generación falla (por ejemplo, por un rol sin CA o un firmante inválido), el trabajo registra el aviso `something went wrong while calculating CRL for CA <ski>` y lo reintenta en el ciclo siguiente. No hay otra vía de renovación hasta corregir la causa, y la última lista publicada se sigue sirviendo hasta vencer. Todo ello depende de que el trabajo, el almacenamiento y la firma funcionen.",{"_3383":70784,"_29651":70739,"_20578":120369,"_5":14121,"_26960":120246,"_2870":120370},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores: si falla (rol inexistente, firmante inválido), el evento se reintenta y, agotados los reintentos, pasa a la cola de eventos fallidos. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3383":70785,"_29651":70739,"_20578":120372,"_5":14121,"_26960":120246,"_2870":120373},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3383":70786,"_29651":70739,"_20578":120375,"_5":14121,"_26960":120250,"_2870":120376},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3383":70787,"_29651":70739,"_20578":120378,"_5":14121,"_26960":120250,"_2870":120379},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3383":70788,"_29651":70739,"_20578":120381,"_5":14121,"_26960":120254,"_2870":120382},[],"El servicio VA expone `GET /crl/{subject_key_id}` sin autorización de gestión. Usa el SKI de la **CA emisora**, no el SKI del certificado final ni su número de serie. Inspecciona primero el CDP del certificado:",{"_3383":70789,"_29651":70739,"_20578":120384,"_5":14121,"_26960":120254,"_2870":120385},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3383":70790,"_29651":70739,"_20578":120387,"_5":14121,"_26960":120254,"_2870":120388},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Un certificado firmante aceptado tiene el mismo sujeto y la misma clave pública que la CA, por lo que esta comprobación de firma también funciona cuando el rol apunta a un certificado anterior de esa CA y clave. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3383":70791,"_29651":70739,"_20578":120390,"_5":14121,"_26960":120254,"_2870":120391},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3383":70792,"_29651":70739,"_20578":120393,"_5":14121,"_26960":120254,"_2870":120394},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3383":70793,"_29651":70739,"_20578":120396,"_5":14121,"_26960":120258,"_2870":120397},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3383":70794,"_29651":70739,"_20578":120399,"_5":14121,"_26960":120258,"_2870":116922},[],{"_3383":70795,"_29651":70739,"_20578":120401,"_5":14121,"_26960":120258,"_2870":120402},[],"Path relativo",{"_3383":70796,"_29651":70739,"_20578":120404,"_5":14121,"_26960":120258,"_2870":114955},[],{"_3383":70797,"_29651":70739,"_20578":120406,"_5":14121,"_26960":120258,"_2870":55096},[],{"_3383":70798,"_29651":70739,"_20578":120408,"_5":14121,"_26960":120258,"_2870":55099},[],{"_3383":70799,"_29651":70739,"_20578":120410,"_5":14121,"_26960":120258,"_2870":120411},[],"Consultar `crl_options` y `latest_crl`.",{"_3383":70800,"_29651":70739,"_20578":120413,"_5":14121,"_26960":120258,"_2870":55105},[],{"_3383":70801,"_29651":70739,"_20578":120415,"_5":14121,"_26960":120258,"_2870":55099},[],{"_3383":70802,"_29651":70739,"_20578":120417,"_5":14121,"_26960":120258,"_2870":120418},[],"Sustituir la configuración de CRL.",{"_3383":70803,"_29651":70739,"_20578":120420,"_5":14121,"_26960":120258,"_2870":120421},[],"Necesitas autenticación y permisos de lectura o actualización del rol. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato: el backend sustituye `crl_options`; no fusiona campos omitidos.",{"_3383":70804,"_29651":70739,"_20578":120423,"_5":14121,"_26960":120258,"_2870":120424},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar el rol no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3383":70805,"_29651":70739,"_20578":120426,"_5":14121,"_26960":120262,"_2870":120427},[],"Síntoma",{"_3383":70806,"_29651":70739,"_20578":120429,"_5":14121,"_26960":120262,"_2870":120430},[],"Causa",{"_3383":70807,"_29651":70739,"_20578":120432,"_5":14121,"_26960":120262,"_2870":120433},[],"Acción",{"_3383":70808,"_29651":70739,"_20578":120435,"_5":14121,"_26960":120262,"_2870":120436},[],"`PUT /v1/roles/{ca-ski}` devuelve 404 y `GET` devuelve 200.",{"_3383":70809,"_29651":70739,"_20578":120438,"_5":14121,"_26960":120262,"_2870":120439},[],"Se eliminó la CA del rol y no queda otra con el mismo SKI.",{"_3383":70810,"_29651":70739,"_20578":120441,"_5":14121,"_26960":120262,"_2870":120442},[],"No hay salida por API; requiere intervención en la base de datos. Evítalo ajustando el rol antes de eliminar la CA.",{"_3383":70811,"_29651":70739,"_20578":120444,"_5":14121,"_26960":120262,"_2870":120445},[],"`PUT` devuelve 400.",{"_3383":70812,"_29651":70739,"_20578":120447,"_5":14121,"_26960":120262,"_2870":120448},[],"El firmante no tiene `cRLSign`, o su sujeto y su clave no coinciden con ninguna CA de ese SKI (por ejemplo, tras eliminar la primera de dos CAs que comparten clave).",{"_3383":70813,"_29651":70739,"_20578":120450,"_5":14121,"_26960":120262,"_2870":120451},[],"Asigna con `PUT` el número de serie de un certificado válido de la CA restante.",{"_3383":70814,"_29651":70739,"_20578":120453,"_5":14121,"_26960":120262,"_2870":120454},[],"`PUT` devuelve 400 desde un cliente de 3.x.",{"_3383":70815,"_29651":70739,"_20578":120456,"_5":14121,"_26960":120262,"_2870":120457},[],"`crl_options.subject_key_id_signer` se sustituyó por `signer_certificate_serial_number`, que es obligatorio.",{"_3383":70816,"_29651":70739,"_20578":120459,"_5":14121,"_26960":120262,"_2870":120460},[],"Actualiza el cliente para enviar el campo nuevo.",{"_3383":70817,"_29651":70739,"_20578":120462,"_5":14121,"_26960":120262,"_2870":120463},[],"La CRL no cambia tras revocar un certificado.",{"_3383":70818,"_29651":70739,"_20578":120465,"_5":14121,"_26960":120262,"_2870":120466},[],"`regenerate_on_revoke` es `false`, o el evento falló por falta de rol o por un firmante inválido.",{"_3383":70819,"_29651":70739,"_20578":120468,"_5":14121,"_26960":120262,"_2870":120469},[],"Revisa los logs de la VA y la cola de eventos fallidos; corrige el firmante.",{"_3383":70820,"_29651":70739,"_20578":120471,"_5":14121,"_26960":120262,"_2870":120472},[],"Un verificador rechaza la CRL por el emisor.",{"_3383":70821,"_29651":70739,"_20578":120474,"_5":14121,"_26960":120262,"_2870":120475},[],"Varias CAs comparten SKI.",{"_3383":70822,"_29651":70739,"_20578":120477,"_5":14121,"_26960":120262,"_2870":120478},[],"Consulta CAs que comparten clave.",{"_3383":70823,"_29651":70739,"_20578":120480,"_5":14121,"_26960":120266,"_2870":120481},[],"La vista de la CA permite inspeccionar y descargar la lista disponible. Compara versión, emisor y tiempos con la copia descargada desde el endpoint público. Los ajustes VA de la CA también permiten seleccionar el firmante de la CRL: el selector de certificados solo ofrece certificados que tienen clave privada y el uso de clave `cRLSign`. Si el certificado de un firmante configurado no puede resolverse, la interfaz muestra `Unknown Certificate (Serial: X)` o `Certificate details unavailable (Serial: X)`. Para diagnosticar una diferencia, sigue Diagnóstico PKI.",{"_3383":70824,"_29651":70739,"_20578":120483,"_5":14121,"_26960":120270,"_2870":120484},[],"RFC 5280: perfil X.509 y CRL.",{"_3383":70825,"_29651":70739,"_20578":120486,"_5":14121,"_26960":120270,"_2870":55179},[],{"_3383":70826,"_29651":70739,"_20578":120488,"_5":14121,"_26960":120270,"_2870":55182},[],{"_3383":70827,"_29651":70739,"_20578":120490,"_5":14121,"_26960":120270,"_2870":120491},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3383":70828,"_29651":70739,"_20578":120493,"_5":14121,"_26960":120270,"_2870":120494},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3383":70829,"_29651":70829,"_5":14473,"_2870":120496,"_30004":120497,"_20578":120498,"_26960":70829},"Claves y motores criptográficos",[48280,115195,53750,119070],[],{"_3383":70830,"_29651":70829,"_20578":120500,"_5":14121,"_26960":70829,"_2870":120501},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3383":70831,"_29651":70829,"_5":30001,"_20578":120503,"_26960":120504,"_2870":120505},[],"/docs/pr-preview/pr-55/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3383":70832,"_29651":70829,"_5":30001,"_20578":120507,"_26960":120508,"_2870":120509},[],"/docs/pr-preview/pr-55/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3383":70833,"_29651":70829,"_5":30001,"_20578":120511,"_26960":120512,"_2870":55207},[],"/docs/pr-preview/pr-55/es/platform/pki/key-management#file-system",{"_3383":70834,"_29651":70829,"_5":30001,"_20578":120514,"_26960":120515,"_2870":55211},[],"/docs/pr-preview/pr-55/es/platform/pki/key-management#hashicorp-vault",{"_3383":70835,"_29651":70829,"_5":30001,"_20578":120517,"_26960":120518,"_2870":55215},[],"/docs/pr-preview/pr-55/es/platform/pki/key-management#aws-secrets-manager",{"_3383":70836,"_29651":70829,"_5":30001,"_20578":120520,"_26960":120521,"_2870":55219},[],"/docs/pr-preview/pr-55/es/platform/pki/key-management#aws-kms",{"_3383":70837,"_29651":70829,"_5":30001,"_20578":120523,"_26960":120524,"_2870":55223},[],"/docs/pr-preview/pr-55/es/platform/pki/key-management#pkcs11",{"_3383":70838,"_29651":70829,"_5":30001,"_20578":120526,"_26960":120527,"_2870":55227},[],"/docs/pr-preview/pr-55/es/platform/pki/key-management#azure-key-vault",{"_3383":70839,"_29651":70829,"_5":30001,"_20578":120529,"_26960":120530,"_2870":120531},[],"/docs/pr-preview/pr-55/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3383":70840,"_29651":70829,"_5":30001,"_20578":120533,"_26960":120534,"_2870":120535},[],"/docs/pr-preview/pr-55/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3383":70841,"_29651":70829,"_5":30001,"_20578":120537,"_26960":120538,"_2870":120539},[],"/docs/pr-preview/pr-55/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3383":70842,"_29651":70829,"_5":30001,"_20578":120541,"_26960":120542,"_2870":120543},[],"/docs/pr-preview/pr-55/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3383":70843,"_29651":70829,"_5":30001,"_20578":120545,"_26960":120546,"_2870":120547},[],"/docs/pr-preview/pr-55/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3383":70844,"_29651":70829,"_5":30001,"_20578":120549,"_26960":120550,"_2870":120551},[],"/docs/pr-preview/pr-55/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3383":70845,"_29651":70829,"_5":30001,"_20578":120553,"_26960":120554,"_2870":120555},[],"/docs/pr-preview/pr-55/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3383":70846,"_29651":70829,"_5":30001,"_20578":120557,"_26960":120558,"_2870":55259},[],"/docs/pr-preview/pr-55/es/platform/pki/key-management#sign",{"_3383":70847,"_29651":70829,"_5":30001,"_20578":120560,"_26960":120561,"_2870":55263},[],"/docs/pr-preview/pr-55/es/platform/pki/key-management#verify",{"_3383":70848,"_29651":70829,"_5":30001,"_20578":120563,"_26960":120564,"_2870":120565},[],"/docs/pr-preview/pr-55/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3383":70849,"_29651":70829,"_5":30001,"_20578":120567,"_26960":120568,"_2870":120569},[],"/docs/pr-preview/pr-55/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3383":70850,"_29651":70829,"_5":30001,"_20578":120571,"_26960":120572,"_2870":120573},[],"/docs/pr-preview/pr-55/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3383":70851,"_29651":70829,"_20578":120575,"_5":14121,"_26960":70829,"_2870":120576},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3383":70852,"_29651":70829,"_20578":120578,"_5":14121,"_26960":70829,"_2870":120579},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3383":70853,"_29651":70829,"_20578":120581,"_5":14121,"_26960":120504,"_2870":120582},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3383":70854,"_29651":70829,"_20578":120584,"_5":14121,"_26960":120504,"_2870":120585},[],"En la práctica, permite:",{"_3383":70855,"_29651":70829,"_20578":120587,"_5":14121,"_26960":120504,"_2870":120588},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3383":70856,"_29651":70829,"_20578":120590,"_5":14121,"_26960":120504,"_2870":120591},[],"Importar claves creadas externamente.",{"_3383":70857,"_29651":70829,"_20578":120593,"_5":14121,"_26960":120504,"_2870":120594},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3383":70858,"_29651":70829,"_20578":120596,"_5":14121,"_26960":120504,"_2870":120597},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3383":70859,"_29651":70829,"_20578":120599,"_5":14121,"_26960":120508,"_2870":120600},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3383":70860,"_29651":70829,"_20578":120602,"_5":14121,"_26960":120508,"_2870":120603},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3383":70861,"_29651":70829,"_20578":120605,"_5":14121,"_26960":120508,"_2870":120606},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3383":70862,"_29651":70829,"_20578":120608,"_5":14121,"_26960":120512,"_2870":120609},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3383":70863,"_29651":70829,"_20578":120611,"_5":14121,"_26960":120515,"_2870":120612},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3383":70864,"_29651":70829,"_20578":120614,"_5":14121,"_26960":120515,"_2870":120615},[],"El adaptador se comunica con Vault a través de su endpoint HTTP(S) configurado. El certificado del servidor de Vault se verifica contra el almacén de confianza del sistema; para confiar en un Vault con certificado emitido por una CA privada, añade ese certificado de CA al `ca_cert_file` del motor (codificado en PEM). `insecure_skip_verify=true` desactiva la verificación y es un último recurso; acuerda los ajustes de transporte con el responsable de Despliegue.",{"_3383":70865,"_29651":70829,"_20578":120617,"_5":14121,"_26960":120518,"_2870":120618},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3383":70866,"_29651":70829,"_20578":120620,"_5":14121,"_26960":120521,"_2870":120621},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3383":70867,"_29651":70829,"_20578":120623,"_5":14121,"_26960":120524,"_2870":120624},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3383":70868,"_29651":70829,"_20578":120626,"_5":14121,"_26960":120527,"_2870":120627},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3383":70869,"_29651":70829,"_20578":120629,"_5":14121,"_26960":120527,"_2870":120630},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3383":70870,"_29651":70829,"_20578":120632,"_5":14121,"_26960":120527,"_2870":120633},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3383":70871,"_29651":70829,"_20578":120635,"_5":14121,"_26960":120527,"_2870":120636},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3383":70872,"_29651":70829,"_20578":120638,"_5":14121,"_26960":120530,"_2870":120639},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3383":70873,"_29651":70829,"_20578":120641,"_5":14121,"_26960":120530,"_2870":120642},[],"La tabla incluye los siguientes campos:",{"_3383":70874,"_29651":70829,"_20578":120644,"_5":14121,"_26960":120530,"_2870":120645},[],"**Name**: nombre descriptivo de la clave.",{"_3383":70875,"_29651":70829,"_20578":120647,"_5":14121,"_26960":120530,"_2870":120648},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3383":70876,"_29651":70829,"_20578":120650,"_5":14121,"_26960":120530,"_2870":120651},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3383":70877,"_29651":70829,"_20578":120653,"_5":14121,"_26960":120530,"_2870":120654},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3383":70878,"_29651":70829,"_20578":120656,"_5":14121,"_26960":120530,"_2870":120657},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3383":70879,"_29651":70829,"_20578":120659,"_5":14121,"_26960":120530,"_2870":120660},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3383":70880,"_29651":70829,"_20578":120662,"_5":14121,"_26960":120530,"_2870":120663},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3383":70881,"_29651":70829,"_20578":120665,"_5":14121,"_26960":120530,"_2870":120666},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3383":70882,"_29651":70829,"_20578":120668,"_5":14121,"_26960":120530,"_2870":120669},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3383":70883,"_29651":70829,"_20578":120671,"_5":14121,"_26960":120530,"_2870":120672},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3383":70884,"_29651":70829,"_20578":120674,"_5":14121,"_26960":120530,"_2870":120675},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3383":70885,"_29651":70829,"_20578":120677,"_5":14121,"_26960":120530,"_2870":120678},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3383":70886,"_29651":70829,"_20578":120680,"_5":14121,"_26960":120530,"_2870":120681},[],"**Delete Key** para eliminar la clave del sistema.",{"_3383":70887,"_29651":70829,"_20578":120683,"_5":14121,"_26960":120534,"_2870":120684},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3383":70888,"_29651":70829,"_20578":120686,"_5":14121,"_26960":120538,"_2870":120687},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3383":70889,"_29651":70829,"_20578":120689,"_5":14121,"_26960":120538,"_2870":120690},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3383":70890,"_29651":70829,"_20578":120692,"_5":14121,"_26960":120538,"_2870":120693},[],"**Key Name**: nombre único y descriptivo.",{"_3383":70891,"_29651":70829,"_20578":120695,"_5":14121,"_26960":120538,"_2870":120696},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3383":70892,"_29651":70829,"_20578":120698,"_5":14121,"_26960":120538,"_2870":120699},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3383":70893,"_29651":70829,"_20578":120701,"_5":14121,"_26960":120538,"_2870":120702},[],"**Tags**: metadatos para clasificar la clave.",{"_3383":70894,"_29651":70829,"_20578":120704,"_5":14121,"_26960":120538,"_2870":120705},[],"**Metadata**: información adicional para usos avanzados.",{"_3383":70895,"_29651":70829,"_20578":120707,"_5":14121,"_26960":120542,"_2870":120708},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3383":70896,"_29651":70829,"_20578":120710,"_5":14121,"_26960":120542,"_2870":120711},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3383":70897,"_29651":70829,"_20578":120713,"_5":14121,"_26960":120542,"_2870":120714},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3383":70898,"_29651":70829,"_20578":120716,"_5":14121,"_26960":120542,"_2870":120717},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3383":70899,"_29651":70829,"_20578":120719,"_5":14121,"_26960":120542,"_2870":120720},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3383":70900,"_29651":70829,"_20578":120722,"_5":14121,"_26960":120542,"_2870":120723},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3383":70901,"_29651":70829,"_20578":120725,"_5":14121,"_26960":120542,"_2870":120726},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3383":70902,"_29651":70829,"_20578":120728,"_5":14121,"_26960":120542,"_2870":120729},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3383":70903,"_29651":70829,"_20578":120731,"_5":14121,"_26960":120542,"_2870":120732},[],"**Metadata**: información adicional opcional.",{"_3383":70904,"_29651":70829,"_20578":120734,"_5":14121,"_26960":120542,"_2870":120735},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3383":70905,"_29651":70829,"_20578":120737,"_5":14121,"_26960":120542,"_2870":120738},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3383":70906,"_29651":70829,"_20578":120740,"_5":14121,"_26960":120546,"_2870":120741},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3383":70907,"_29651":70829,"_20578":120743,"_5":14121,"_26960":120550,"_2870":120744},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3383":70908,"_29651":70829,"_20578":120746,"_5":14121,"_26960":120550,"_2870":120747},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3383":70909,"_29651":70829,"_20578":120749,"_5":14121,"_26960":120550,"_2870":120750},[],"**Key Name**: nombre descriptivo.",{"_3383":70910,"_29651":70829,"_20578":120752,"_5":14121,"_26960":120550,"_2870":120753},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3383":70911,"_29651":70829,"_20578":120755,"_5":14121,"_26960":120550,"_2870":120756},[],"**Tags**: etiquetas asociadas.",{"_3383":70912,"_29651":70829,"_20578":120758,"_5":14121,"_26960":120550,"_2870":120759},[],"**Aliases**: nombres alternativos.",{"_3383":70913,"_29651":70829,"_20578":120761,"_5":14121,"_26960":120550,"_2870":120762},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3383":70914,"_29651":70829,"_20578":120764,"_5":14121,"_26960":120550,"_2870":120765},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3383":70915,"_29651":70829,"_20578":120767,"_5":14121,"_26960":120550,"_2870":120768},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3383":70916,"_29651":70829,"_20578":120770,"_5":14121,"_26960":120550,"_2870":120771},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3383":70917,"_29651":70829,"_20578":120773,"_5":14121,"_26960":120554,"_2870":120774},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3383":70918,"_29651":70829,"_20578":120776,"_5":14121,"_26960":120554,"_2870":120777},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3383":70919,"_29651":70829,"_20578":120779,"_5":14121,"_26960":120554,"_2870":120780},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3383":70920,"_29651":70829,"_20578":120782,"_5":14121,"_26960":120558,"_2870":120783},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3383":70921,"_29651":70829,"_20578":120785,"_5":14121,"_26960":120558,"_2870":120786},[],"Campos principales:",{"_3383":70922,"_29651":70829,"_20578":120788,"_5":14121,"_26960":120558,"_2870":120789},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3383":70923,"_29651":70829,"_20578":120791,"_5":14121,"_26960":120558,"_2870":120792},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3383":70924,"_29651":70829,"_20578":120794,"_5":14121,"_26960":120558,"_2870":120795},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3383":70925,"_29651":70829,"_20578":120797,"_5":14121,"_26960":120558,"_2870":120798},[],"**Message**: contenido que se va a firmar.",{"_3383":70926,"_29651":70829,"_20578":120800,"_5":14121,"_26960":120558,"_2870":120801},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3383":70927,"_29651":70829,"_20578":120803,"_5":14121,"_26960":120561,"_2870":120804},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3383":70928,"_29651":70829,"_20578":120806,"_5":14121,"_26960":120561,"_2870":120786},[],{"_3383":70929,"_29651":70829,"_20578":120808,"_5":14121,"_26960":120561,"_2870":120809},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3383":70930,"_29651":70829,"_20578":120811,"_5":14121,"_26960":120561,"_2870":120812},[],"**Message Type**: `Raw` o `Digest`.",{"_3383":70931,"_29651":70829,"_20578":120814,"_5":14121,"_26960":120561,"_2870":120815},[],"**Payload Encoding**: codificación del mensaje.",{"_3383":70932,"_29651":70829,"_20578":120817,"_5":14121,"_26960":120561,"_2870":120818},[],"**Message**: mensaje original o hash.",{"_3383":70933,"_29651":70829,"_20578":120820,"_5":14121,"_26960":120561,"_2870":120821},[],"**Signature**: firma que se desea comprobar.",{"_3383":70934,"_29651":70829,"_20578":120823,"_5":14121,"_26960":120561,"_2870":120824},[],"**Result**: indicador del resultado de la validación.",{"_3383":70935,"_29651":70829,"_20578":120826,"_5":14121,"_26960":120564,"_2870":120827},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3383":70936,"_29651":70829,"_20578":120829,"_5":14121,"_26960":120564,"_2870":120830},[],"Este flujo es útil para:",{"_3383":70937,"_29651":70829,"_20578":120832,"_5":14121,"_26960":120564,"_2870":120833},[],"Solicitar certificados a una CA externa.",{"_3383":70938,"_29651":70829,"_20578":120835,"_5":14121,"_26960":120564,"_2870":120836},[],"Renovar una identidad manteniendo la misma clave.",{"_3383":70939,"_29651":70829,"_20578":120838,"_5":14121,"_26960":120564,"_2870":120839},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3383":70940,"_29651":70829,"_20578":120841,"_5":14121,"_26960":120564,"_2870":120842},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3383":70941,"_29651":70829,"_20578":120844,"_5":14121,"_26960":120564,"_2870":120845},[],"**Organization (O)**: organización o empresa.",{"_3383":70942,"_29651":70829,"_20578":120847,"_5":14121,"_26960":120564,"_2870":120848},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3383":70943,"_29651":70829,"_20578":120850,"_5":14121,"_26960":120564,"_2870":120851},[],"**Country (C)**: código de país de dos letras.",{"_3383":70944,"_29651":70829,"_20578":120853,"_5":14121,"_26960":120564,"_2870":120854},[],"**State / Province (ST)**: estado o provincia.",{"_3383":70945,"_29651":70829,"_20578":120856,"_5":14121,"_26960":120564,"_2870":120857},[],"**Locality (L)**: ciudad o localidad.",{"_3383":70946,"_29651":70829,"_20578":120859,"_5":14121,"_26960":120564,"_2870":120860},[],"**Email Address**: correo de contacto.",{"_3383":70947,"_29651":70829,"_20578":120862,"_5":14121,"_26960":120564,"_2870":120863},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3383":70948,"_29651":70829,"_20578":120865,"_5":14121,"_26960":120564,"_2870":120866},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3383":70949,"_29651":70829,"_20578":120868,"_5":14121,"_26960":120568,"_2870":120869},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3383":70950,"_29651":70829,"_20578":120871,"_5":14121,"_26960":120568,"_2870":120872},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3383":70951,"_29651":70829,"_20578":120874,"_5":14121,"_26960":120572,"_2870":120875},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3383":70952,"_29651":70829,"_20578":120877,"_5":14121,"_26960":120572,"_2870":120878},[],"El KMS se niega a eliminar una clave que todavía está referenciada por certificados. Eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados, y después intenta eliminar la clave. Si otros certificados todavía la referencian, como los de otra CA que la comparte, el KMS la conserva. Revocar los certificados emitidos por la CA eliminada no libera sus propias referencias a claves. La guía de actualización describe las referencias heredadas que conserva la migración.",{"_3383":70953,"_29651":70953,"_5":14473,"_2870":120880,"_30004":120881,"_20578":120882,"_26960":70953},"Validación online con OCSP",[48280,115195,53750,119704],[],{"_3383":70954,"_29651":70953,"_20578":120884,"_5":14121,"_26960":70953,"_2870":120885},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3383":70955,"_29651":70953,"_5":30001,"_20578":120887,"_26960":120888,"_2870":120889},[],"/docs/pr-preview/pr-55/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3383":70956,"_29651":70953,"_5":30001,"_20578":120891,"_26960":120892,"_2870":120893},[],"/docs/pr-preview/pr-55/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3383":70957,"_29651":70953,"_5":30001,"_20578":120895,"_26960":120896,"_2870":120897},[],"/docs/pr-preview/pr-55/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3383":70958,"_29651":70953,"_5":30001,"_20578":120899,"_26960":120900,"_2870":120901},[],"/docs/pr-preview/pr-55/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3383":70959,"_29651":70953,"_5":30001,"_20578":120903,"_26960":120904,"_2870":120905},[],"/docs/pr-preview/pr-55/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3383":70960,"_29651":70953,"_5":30001,"_20578":120907,"_26960":120908,"_2870":120271},[],"/docs/pr-preview/pr-55/es/platform/pki/ocsp#referencias",{"_3383":70961,"_29651":70953,"_20578":120910,"_5":14121,"_26960":70953,"_2870":120911},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3383":70962,"_29651":70953,"_20578":120913,"_5":14121,"_26960":120888,"_2870":120914},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3383":70963,"_29651":70953,"_20578":120916,"_5":14121,"_26960":120888,"_2870":120917},[],"Estado del registro",{"_3383":70964,"_29651":70953,"_20578":120919,"_5":14121,"_26960":120888,"_2870":120920},[],"Respuesta firmada",{"_3383":70965,"_29651":70953,"_20578":120922,"_5":14121,"_26960":120888,"_2870":52887},[],{"_3383":70966,"_29651":70953,"_20578":120924,"_5":14121,"_26960":120888,"_2870":55627},[],{"_3383":70967,"_29651":70953,"_20578":120926,"_5":14121,"_26960":120888,"_2870":52904},[],{"_3383":70968,"_29651":70953,"_20578":120928,"_5":14121,"_26960":120888,"_2870":120929},[],"`Revoked`, con razón y fecha de revocación.",{"_3383":70969,"_29651":70953,"_20578":120931,"_5":14121,"_26960":120888,"_2870":120932},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3383":70970,"_29651":70953,"_20578":120934,"_5":14121,"_26960":120888,"_2870":120935},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3383":70971,"_29651":70953,"_20578":120937,"_5":14121,"_26960":120888,"_2870":120938},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3383":70972,"_29651":70953,"_20578":120940,"_5":14121,"_26960":120888,"_2870":120941},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3383":70973,"_29651":70953,"_20578":120943,"_5":14121,"_26960":120888,"_2870":120944},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3383":70974,"_29651":70953,"_20578":120946,"_5":14121,"_26960":120892,"_2870":120947},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3383":70975,"_29651":70953,"_20578":120949,"_5":14121,"_26960":120892,"_2870":120950},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3383":70976,"_29651":70953,"_20578":120952,"_5":14121,"_26960":120896,"_2870":120953},[],"El servicio acepta:",{"_3383":70977,"_29651":70953,"_20578":120955,"_5":14121,"_26960":120896,"_2870":116922},[],{"_3383":70978,"_29651":70953,"_20578":120957,"_5":14121,"_26960":120896,"_2870":120958},[],"Ruta del servicio VA",{"_3383":70979,"_29651":70953,"_20578":120960,"_5":14121,"_26960":120896,"_2870":120961},[],"Formato",{"_3383":70980,"_29651":70953,"_20578":120963,"_5":14121,"_26960":120896,"_2870":55667},[],{"_3383":70981,"_29651":70953,"_20578":120965,"_5":14121,"_26960":120896,"_2870":55670},[],{"_3383":70982,"_29651":70953,"_20578":120967,"_5":14121,"_26960":120896,"_2870":120968},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3383":70983,"_29651":70953,"_20578":120970,"_5":14121,"_26960":120896,"_2870":55096},[],{"_3383":70984,"_29651":70953,"_20578":120972,"_5":14121,"_26960":120896,"_2870":55678},[],{"_3383":70985,"_29651":70953,"_20578":120974,"_5":14121,"_26960":120896,"_2870":120975},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3383":70986,"_29651":70953,"_20578":120977,"_5":14121,"_26960":120896,"_2870":120978},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3383":70987,"_29651":70953,"_20578":120980,"_5":14121,"_26960":120900,"_2870":120981},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3383":70988,"_29651":70953,"_20578":120983,"_5":14121,"_26960":120900,"_2870":120984},[],"Genera la solicitud:",{"_3383":70989,"_29651":70953,"_20578":120986,"_5":14121,"_26960":120900,"_2870":120987},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3383":70990,"_29651":70953,"_20578":120989,"_5":14121,"_26960":120900,"_2870":120990},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3383":70991,"_29651":70953,"_20578":120992,"_5":14121,"_26960":120900,"_2870":120993},[],"Verifica el DER recibido:",{"_3383":70992,"_29651":70953,"_20578":120995,"_5":14121,"_26960":120900,"_2870":120996},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3383":70993,"_29651":70953,"_20578":120998,"_5":14121,"_26960":120904,"_2870":120999},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3383":70994,"_29651":70953,"_20578":121001,"_5":14121,"_26960":120904,"_2870":121002},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3383":70995,"_29651":70953,"_20578":121004,"_5":14121,"_26960":120908,"_2870":55711},[],{"_3383":70996,"_29651":70953,"_20578":121006,"_5":14121,"_26960":120908,"_2870":55714},[],{"_3383":70997,"_29651":70953,"_20578":121008,"_5":14121,"_26960":120908,"_2870":121009},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3383":70998,"_29651":70953,"_20578":121011,"_5":14121,"_26960":120908,"_2870":120494},[],{"_3383":70999,"_29651":70999,"_5":14473,"_2870":53750,"_30004":121013,"_20578":121014,"_26960":70999},[48280,115195,53750],[],{"_3383":71000,"_29651":70999,"_20578":121016,"_5":14121,"_26960":70999,"_2870":121017},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3383":71001,"_29651":70999,"_5":30001,"_20578":121019,"_26960":121020,"_2870":118396},[],"/docs/pr-preview/pr-55/es/platform/pki/overview#empieza-aquí",{"_3383":71002,"_29651":70999,"_5":30001,"_20578":121022,"_26960":121023,"_2870":121024},[],"/docs/pr-preview/pr-55/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3383":71003,"_29651":70999,"_5":30001,"_20578":121026,"_26960":121027,"_2870":118916},[],"/docs/pr-preview/pr-55/es/platform/pki/overview#capacidades-principales",{"_3383":71004,"_29651":70999,"_5":30001,"_20578":121029,"_26960":121030,"_2870":118920},[],"/docs/pr-preview/pr-55/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3383":71005,"_29651":70999,"_5":30001,"_20578":121032,"_26960":121033,"_2870":118924},[],"/docs/pr-preview/pr-55/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3383":71006,"_29651":70999,"_5":30001,"_20578":121035,"_26960":121036,"_2870":118928},[],"/docs/pr-preview/pr-55/es/platform/pki/overview#emite-y-controla-certificados",{"_3383":71007,"_29651":70999,"_5":30001,"_20578":121038,"_26960":121039,"_2870":118936},[],"/docs/pr-preview/pr-55/es/platform/pki/overview#publica-el-estado-de-validación",{"_3383":71008,"_29651":70999,"_5":30001,"_20578":121041,"_26960":121042,"_2870":121043},[],"/docs/pr-preview/pr-55/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3383":71009,"_29651":70999,"_5":30001,"_20578":121045,"_26960":121046,"_2870":119870},[],"/docs/pr-preview/pr-55/es/platform/pki/overview#continúa",{"_3383":71010,"_29651":70999,"_20578":121048,"_5":14121,"_26960":70999,"_2870":121049},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3383":71011,"_29651":70999,"_20578":121051,"_5":14121,"_26960":121020,"_2870":121052},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3383":71012,"_29651":70999,"_20578":121054,"_5":14121,"_26960":121020,"_2870":121055},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3383":71013,"_29651":70999,"_20578":121057,"_5":14121,"_26960":121023,"_2870":121058},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3383":71014,"_29651":70999,"_20578":121060,"_5":14121,"_26960":121023,"_2870":121061},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3383":71015,"_29651":70999,"_20578":121063,"_5":14121,"_26960":121023,"_2870":121064},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3383":71016,"_29651":70999,"_20578":121066,"_5":14121,"_26960":121023,"_2870":121067},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3383":71017,"_29651":70999,"_20578":121069,"_5":14121,"_26960":121023,"_2870":121070},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3383":71018,"_29651":70999,"_20578":121072,"_5":14121,"_26960":121030,"_2870":121073},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3383":71019,"_29651":70999,"_20578":121075,"_5":14121,"_26960":121033,"_2870":121076},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3383":71020,"_29651":70999,"_20578":121078,"_5":14121,"_26960":121036,"_2870":121079},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3383":71021,"_29651":70999,"_20578":121081,"_5":14121,"_26960":121039,"_2870":121082},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3383":71022,"_29651":70999,"_20578":121084,"_5":14121,"_26960":121042,"_2870":121085},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3383":71023,"_29651":70999,"_20578":121087,"_5":14121,"_26960":121042,"_2870":121088},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3383":71024,"_29651":70999,"_20578":121090,"_5":14121,"_26960":121042,"_2870":121091},[],"su clave pública corresponda a la clave privada del cliente;",{"_3383":71025,"_29651":70999,"_20578":121093,"_5":14121,"_26960":121042,"_2870":121094},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3383":71026,"_29651":70999,"_20578":121096,"_5":14121,"_26960":121042,"_2870":121097},[],"sus fechas y usos permitan la operación;",{"_3383":71027,"_29651":70999,"_20578":121099,"_5":14121,"_26960":121042,"_2870":121100},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3383":71028,"_29651":70999,"_20578":121102,"_5":14121,"_26960":121042,"_2870":121103},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3383":71029,"_29651":70999,"_20578":121105,"_5":14121,"_26960":121046,"_2870":121106},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3383":71030,"_29651":70999,"_20578":121108,"_5":14121,"_26960":121046,"_2870":121109},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3383":71031,"_29651":70999,"_20578":121111,"_5":14121,"_26960":121046,"_2870":121112},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3383":71032,"_29651":71032,"_5":14473,"_2870":121114,"_30004":121115,"_20578":121116,"_26960":71032},"Crea tu primera CA",[48280,115195,53750,118520],[],{"_3383":71033,"_29651":71032,"_20578":121118,"_5":14121,"_26960":71032,"_2870":121119},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3383":71034,"_29651":71032,"_5":30001,"_20578":121121,"_26960":121122,"_2870":113773},[],"/docs/pr-preview/pr-55/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3383":71035,"_29651":71032,"_5":30001,"_20578":121124,"_26960":121125,"_2870":121126},[],"/docs/pr-preview/pr-55/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación-toc","Abre el asistente de creación [!toc]",{"_3383":71036,"_29651":71032,"_5":30001,"_20578":121128,"_26960":121129,"_2870":121130},[],"/docs/pr-preview/pr-55/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave-toc","Selecciona la clave [!toc]",{"_3383":71037,"_29651":71032,"_5":30001,"_20578":121132,"_26960":121133,"_2870":121134},[],"/docs/pr-preview/pr-55/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad-toc","Define la autoridad [!toc]",{"_3383":71038,"_29651":71032,"_5":30001,"_20578":121136,"_26960":121137,"_2870":121138},[],"/docs/pr-preview/pr-55/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca-toc","Revisa y crea la CA [!toc]",{"_3383":71039,"_29651":71032,"_5":30001,"_20578":121140,"_26960":121141,"_2870":121142},[],"/docs/pr-preview/pr-55/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado-toc","Verifica el resultado [!toc]",{"_3383":71040,"_29651":71032,"_5":30001,"_20578":121144,"_26960":121145,"_2870":121146},[],"/docs/pr-preview/pr-55/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3383":71041,"_29651":71032,"_5":30001,"_20578":121148,"_26960":121149,"_2870":118767},[],"/docs/pr-preview/pr-55/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3383":71042,"_29651":71032,"_5":30001,"_20578":121151,"_26960":121152,"_2870":113797},[],"/docs/pr-preview/pr-55/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3383":71043,"_29651":71032,"_20578":121154,"_5":14121,"_26960":71032,"_2870":121155},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3383":71044,"_29651":71032,"_20578":121157,"_5":14121,"_26960":121122,"_2870":121158},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3383":71045,"_29651":71032,"_20578":121160,"_5":14121,"_26960":121122,"_2870":121161},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3383":71046,"_29651":71032,"_20578":121163,"_5":14121,"_26960":121122,"_2870":121164},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3383":71047,"_29651":71032,"_20578":121166,"_5":14121,"_26960":121122,"_2870":121167},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3383":71048,"_29651":71032,"_20578":121169,"_5":14121,"_26960":121125,"_2870":121170},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_3383":71049,"_29651":71032,"_20578":121172,"_5":14121,"_26960":121125,"_2870":121173},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_3383":71050,"_29651":71032,"_20578":121175,"_5":14121,"_26960":121129,"_2870":121176},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_3383":71051,"_29651":71032,"_20578":121178,"_5":14121,"_26960":121129,"_2870":121179},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_3383":71052,"_29651":71032,"_20578":121181,"_5":14121,"_26960":121133,"_2870":121182},[],"Selecciona **Root CA** y completa:",{"_3383":71053,"_29651":71032,"_20578":121184,"_5":14121,"_26960":121133,"_2870":55893},[],{"_3383":71054,"_29651":71032,"_20578":121186,"_5":14121,"_26960":121133,"_2870":121187},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_3383":71055,"_29651":71032,"_20578":121189,"_5":14121,"_26960":121133,"_2870":121190},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_3383":71056,"_29651":71032,"_20578":121192,"_5":14121,"_26960":121133,"_2870":121193},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_3383":71057,"_29651":71032,"_20578":121195,"_5":14121,"_26960":121133,"_2870":121196},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_3383":71058,"_29651":71032,"_20578":121198,"_5":14121,"_26960":121137,"_2870":121199},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_3383":71059,"_29651":71032,"_20578":121201,"_5":14121,"_26960":121141,"_2870":121202},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_3383":71060,"_29651":71032,"_20578":121204,"_5":14121,"_26960":121141,"_2870":121205},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_3383":71061,"_29651":71032,"_20578":121207,"_5":14121,"_26960":121145,"_2870":121208},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3383":71062,"_29651":71032,"_20578":121210,"_5":14121,"_26960":121145,"_2870":121211},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3383":71063,"_29651":71032,"_20578":121213,"_5":14121,"_26960":121145,"_2870":121214},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3383":71064,"_29651":71032,"_20578":121216,"_5":14121,"_26960":121149,"_2870":121217},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3383":71065,"_29651":71032,"_20578":121219,"_5":14121,"_26960":121149,"_2870":121220},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3383":71066,"_29651":71032,"_20578":121222,"_5":14121,"_26960":121149,"_2870":121223},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3383":71067,"_29651":71032,"_20578":121225,"_5":14121,"_26960":121149,"_2870":121226},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3383":71068,"_29651":71032,"_20578":121228,"_5":14121,"_26960":121152,"_2870":121229},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3383":71069,"_29651":71069,"_5":14473,"_2870":121231,"_30004":121232,"_20578":121233,"_26960":71069},"Emite y verifica un certificado",[48280,115195,53750,118520],[],{"_3383":71070,"_29651":71069,"_20578":121235,"_5":14121,"_26960":71069,"_2870":121236},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3383":71071,"_29651":71069,"_5":30001,"_20578":121238,"_26960":121239,"_2870":113773},[],"/docs/pr-preview/pr-55/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3383":71072,"_29651":71069,"_5":30001,"_20578":121241,"_26960":121242,"_2870":121243},[],"/docs/pr-preview/pr-55/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3383":71073,"_29651":71069,"_5":30001,"_20578":121245,"_26960":121246,"_2870":121247},[],"/docs/pr-preview/pr-55/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3383":71074,"_29651":71069,"_5":30001,"_20578":121249,"_26960":121250,"_2870":121251},[],"/docs/pr-preview/pr-55/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3383":71075,"_29651":71069,"_5":30001,"_20578":121253,"_26960":121254,"_2870":121255},[],"/docs/pr-preview/pr-55/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3383":71076,"_29651":71069,"_5":30001,"_20578":121257,"_26960":121258,"_2870":121259},[],"/docs/pr-preview/pr-55/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3383":71077,"_29651":71069,"_5":30001,"_20578":121261,"_26960":121262,"_2870":121263},[],"/docs/pr-preview/pr-55/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado","Verifica el resultado",{"_3383":71078,"_29651":71069,"_5":30001,"_20578":121265,"_26960":121266,"_2870":121267},[],"/docs/pr-preview/pr-55/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3383":71079,"_29651":71069,"_5":30001,"_20578":121269,"_26960":121270,"_2870":121271},[],"/docs/pr-preview/pr-55/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3383":71080,"_29651":71069,"_5":30001,"_20578":121273,"_26960":121274,"_2870":121275},[],"/docs/pr-preview/pr-55/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3383":71081,"_29651":71069,"_5":30001,"_20578":121277,"_26960":121278,"_2870":118767},[],"/docs/pr-preview/pr-55/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3383":71082,"_29651":71069,"_5":30001,"_20578":121280,"_26960":121281,"_2870":113797},[],"/docs/pr-preview/pr-55/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3383":71083,"_29651":71069,"_20578":121283,"_5":14121,"_26960":71069,"_2870":121284},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3383":71084,"_29651":71069,"_20578":121286,"_5":14121,"_26960":121239,"_2870":121287},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3383":71085,"_29651":71069,"_20578":121289,"_5":14121,"_26960":121239,"_2870":121290},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3383":71086,"_29651":71069,"_20578":121292,"_5":14121,"_26960":121239,"_2870":121293},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3383":71087,"_29651":71069,"_20578":121295,"_5":14121,"_26960":121239,"_2870":121296},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3383":71088,"_29651":71069,"_20578":121298,"_5":14121,"_26960":121239,"_2870":121299},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3383":71089,"_29651":71069,"_20578":121301,"_5":14121,"_26960":121242,"_2870":121302},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3383":71090,"_29651":71069,"_20578":121304,"_5":14121,"_26960":121246,"_2870":121305},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3383":71091,"_29651":71069,"_20578":121307,"_5":14121,"_26960":121246,"_2870":121308},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3383":71092,"_29651":71069,"_20578":121310,"_5":14121,"_26960":121250,"_2870":121311},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3383":71093,"_29651":71069,"_20578":121313,"_5":14121,"_26960":121250,"_2870":121314},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3383":71094,"_29651":71069,"_20578":121316,"_5":14121,"_26960":121254,"_2870":121317},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3383":71095,"_29651":71069,"_20578":121319,"_5":14121,"_26960":121254,"_2870":121320},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3383":71096,"_29651":71069,"_20578":121322,"_5":14121,"_26960":121258,"_2870":121323},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3383":71097,"_29651":71069,"_20578":121325,"_5":14121,"_26960":121262,"_2870":121326},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3383":71098,"_29651":71069,"_20578":121328,"_5":14121,"_26960":121266,"_2870":121329},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3383":71099,"_29651":71069,"_20578":121331,"_5":14121,"_26960":121270,"_2870":121332},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3383":71100,"_29651":71069,"_20578":121334,"_5":14121,"_26960":121270,"_2870":121335},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3383":71101,"_29651":71069,"_20578":121337,"_5":14121,"_26960":121270,"_2870":121338},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3383":71102,"_29651":71069,"_20578":121340,"_5":14121,"_26960":121274,"_2870":121341},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3383":71103,"_29651":71069,"_20578":121343,"_5":14121,"_26960":121274,"_2870":121344},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3383":71104,"_29651":71069,"_20578":121346,"_5":14121,"_26960":121274,"_2870":121347},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3383":71105,"_29651":71069,"_20578":121349,"_5":14121,"_26960":121278,"_2870":118850},[],{"_3383":71106,"_29651":71069,"_20578":121351,"_5":14121,"_26960":121278,"_2870":117371},[],{"_3383":71107,"_29651":71069,"_20578":121353,"_5":14121,"_26960":121278,"_2870":121354},[],"La CA rechaza la emisión",{"_3383":71108,"_29651":71069,"_20578":121356,"_5":14121,"_26960":121278,"_2870":121357},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3383":71109,"_29651":71069,"_20578":121359,"_5":14121,"_26960":121278,"_2870":121360},[],"Sujeto o usos diferentes",{"_3383":71110,"_29651":71069,"_20578":121362,"_5":14121,"_26960":121278,"_2870":121363},[],"Perfil aplicado y valores solicitados.",{"_3383":71111,"_29651":71069,"_20578":121365,"_5":14121,"_26960":121278,"_2870":121366},[],"No se encuentra el emisor",{"_3383":71112,"_29651":71069,"_20578":121368,"_5":14121,"_26960":121278,"_2870":121369},[],"CA descargada y cadena intermedia necesaria.",{"_3383":71113,"_29651":71069,"_20578":121371,"_5":14121,"_26960":121278,"_2870":121372},[],"Falla la vigencia",{"_3383":71114,"_29651":71069,"_20578":121374,"_5":14121,"_26960":121278,"_2870":121375},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3383":71115,"_29651":71069,"_20578":121377,"_5":14121,"_26960":121278,"_2870":121378},[],"Los resúmenes de clave difieren",{"_3383":71116,"_29651":71069,"_20578":121380,"_5":14121,"_26960":121278,"_2870":121381},[],"Archivos de certificado y clave de la misma emisión.",{"_3383":71117,"_29651":71069,"_20578":121383,"_5":14121,"_26960":121278,"_2870":121384},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3383":71118,"_29651":71069,"_20578":121386,"_5":14121,"_26960":121281,"_2870":121387},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3383":71119,"_29651":71069,"_20578":121389,"_5":14121,"_26960":121281,"_2870":121390},[],"Gestionar certificados para inspección, estado y revocación.",{"_3383":71120,"_29651":71069,"_20578":121392,"_5":14121,"_26960":121281,"_2870":121393},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3383":71121,"_29651":71069,"_20578":121395,"_5":14121,"_26960":121281,"_2870":121396},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3383":71122,"_29651":71069,"_20578":121398,"_5":14121,"_26960":121281,"_2870":121399},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3383":71123,"_29651":71123,"_5":14473,"_2870":121401,"_30004":121402,"_20578":121403,"_26960":71123},"Primeros pasos de PKI",[48280,115195,53750,118520],[],{"_3383":71124,"_29651":71123,"_20578":121405,"_5":14121,"_26960":71123,"_2870":121406},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3383":71125,"_29651":71123,"_5":30001,"_20578":121408,"_26960":121409,"_2870":113773},[],"/docs/pr-preview/pr-55/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3383":71126,"_29651":71123,"_5":30001,"_20578":121411,"_26960":121412,"_2870":121413},[],"/docs/pr-preview/pr-55/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3383":71127,"_29651":71123,"_5":30001,"_20578":121415,"_26960":121416,"_2870":118702},[],"/docs/pr-preview/pr-55/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3383":71128,"_29651":71123,"_5":30001,"_20578":121418,"_26960":121419,"_2870":121420},[],"/docs/pr-preview/pr-55/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3383":71129,"_29651":71123,"_20578":121422,"_5":14121,"_26960":71123,"_2870":121423},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3383":71130,"_29651":71123,"_20578":121425,"_5":14121,"_26960":121409,"_2870":121426},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3383":71131,"_29651":71123,"_20578":121428,"_5":14121,"_26960":121409,"_2870":121429},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3383":71132,"_29651":71123,"_20578":121431,"_5":14121,"_26960":121409,"_2870":121432},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3383":71133,"_29651":71123,"_20578":121434,"_5":14121,"_26960":121409,"_2870":121435},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3383":71134,"_29651":71123,"_20578":121437,"_5":14121,"_26960":121409,"_2870":121438},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3383":71135,"_29651":71123,"_20578":121440,"_5":14121,"_26960":121412,"_2870":121441},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3383":71136,"_29651":71123,"_20578":121443,"_5":14121,"_26960":121412,"_2870":121444},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3383":71137,"_29651":71123,"_20578":121446,"_5":14121,"_26960":121412,"_2870":121447},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3383":71138,"_29651":71123,"_20578":121449,"_5":14121,"_26960":121412,"_2870":121450},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3383":71139,"_29651":71123,"_20578":121452,"_5":14121,"_26960":121416,"_2870":121453},[],"Archivo o recurso",{"_3383":71140,"_29651":71123,"_20578":121455,"_5":14121,"_26960":121416,"_2870":118699},[],{"_3383":71141,"_29651":71123,"_20578":121457,"_5":14121,"_26960":121416,"_2870":121458},[],"CA raíz activa y `ca.pem`",{"_3383":71142,"_29651":71123,"_20578":121460,"_5":14121,"_26960":121416,"_2870":121461},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3383":71143,"_29651":71123,"_20578":121463,"_5":14121,"_26960":121416,"_2870":121464},[],"Certificado final y `device.crt`",{"_3383":71144,"_29651":71123,"_20578":121466,"_5":14121,"_26960":121416,"_2870":121467},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3383":71145,"_29651":71123,"_20578":121469,"_5":14121,"_26960":121416,"_2870":121470},[],"Clave privada `device.key`",{"_3383":71146,"_29651":71123,"_20578":121472,"_5":14121,"_26960":121416,"_2870":121473},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3383":71147,"_29651":71123,"_20578":121475,"_5":14121,"_26960":121416,"_2870":121476},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3383":71148,"_29651":71123,"_20578":121478,"_5":14121,"_26960":121419,"_2870":121479},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3383":71149,"_29651":71123,"_20578":121481,"_5":14121,"_26960":121419,"_2870":121482},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3383":71150,"_29651":71123,"_20578":121484,"_5":14121,"_26960":121419,"_2870":121485},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3383":71151,"_29651":71151,"_5":14473,"_2870":121487,"_30004":121488,"_20578":121490,"_26960":71151},"Resolución de problemas PKI",[48280,115195,53750,121489],"Resolución de problemas",[],{"_3383":71152,"_29651":71151,"_20578":121492,"_5":14121,"_26960":71151,"_2870":121493},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3383":71153,"_29651":71151,"_5":30001,"_20578":121495,"_26960":121496,"_2870":121497},[],"/docs/pr-preview/pr-55/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3383":71154,"_29651":71151,"_5":30001,"_20578":121499,"_26960":121500,"_2870":121501},[],"/docs/pr-preview/pr-55/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3383":71155,"_29651":71151,"_5":30001,"_20578":121503,"_26960":121504,"_2870":121505},[],"/docs/pr-preview/pr-55/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3383":71156,"_29651":71151,"_20578":121507,"_5":14121,"_26960":71151,"_2870":121508},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3383":71157,"_29651":71151,"_20578":121510,"_5":14121,"_26960":71151,"_2870":121511},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3383":71158,"_29651":71151,"_20578":121513,"_5":14121,"_26960":121496,"_2870":118699},[],{"_3383":71159,"_29651":71151,"_20578":121515,"_5":14121,"_26960":121496,"_2870":117371},[],{"_3383":71160,"_29651":71151,"_20578":121517,"_5":14121,"_26960":121496,"_2870":113797},[],{"_3383":71161,"_29651":71151,"_20578":121519,"_5":14121,"_26960":121496,"_2870":52592},[],{"_3383":71162,"_29651":71151,"_20578":121521,"_5":14121,"_26960":121496,"_2870":121522},[],"Existe, está activa y sus fechas son utilizables.",{"_3383":71163,"_29651":71151,"_20578":121524,"_5":14121,"_26960":121496,"_2870":121525},[],"Autoridades.",{"_3383":71164,"_29651":71151,"_20578":121527,"_5":14121,"_26960":121496,"_2870":121528},[],"Clave",{"_3383":71165,"_29651":71151,"_20578":121530,"_5":14121,"_26960":121496,"_2870":121531},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3383":71166,"_29651":71151,"_20578":121533,"_5":14121,"_26960":121496,"_2870":121534},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3383":71167,"_29651":71151,"_20578":121536,"_5":14121,"_26960":121496,"_2870":56247},[],{"_3383":71168,"_29651":71151,"_20578":121538,"_5":14121,"_26960":121496,"_2870":121539},[],"PEM correcto y firma verificable.",{"_3383":71169,"_29651":71151,"_20578":121541,"_5":14121,"_26960":121496,"_2870":56253},[],{"_3383":71170,"_29651":71151,"_20578":121543,"_5":14121,"_26960":121496,"_2870":121544},[],"Perfil",{"_3383":71171,"_29651":71151,"_20578":121546,"_5":14121,"_26960":121496,"_2870":121547},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3383":71172,"_29651":71151,"_20578":121549,"_5":14121,"_26960":121496,"_2870":121550},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3383":71173,"_29651":71151,"_20578":121552,"_5":14121,"_26960":121496,"_2870":118850},[],{"_3383":71174,"_29651":71151,"_20578":121554,"_5":14121,"_26960":121496,"_2870":121555},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3383":71175,"_29651":71151,"_20578":121557,"_5":14121,"_26960":121496,"_2870":121558},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3383":71176,"_29651":71151,"_20578":121560,"_5":14121,"_26960":121496,"_2870":121561},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3383":71177,"_29651":71151,"_20578":121563,"_5":14121,"_26960":121496,"_2870":121564},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3383":71178,"_29651":71151,"_20578":121566,"_5":14121,"_26960":121500,"_2870":121567},[],"Revisa cada frontera por separado:",{"_3383":71179,"_29651":71151,"_20578":121569,"_5":14121,"_26960":121500,"_2870":121570},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3383":71180,"_29651":71151,"_20578":121572,"_5":14121,"_26960":121500,"_2870":121573},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3383":71181,"_29651":71151,"_20578":121575,"_5":14121,"_26960":121500,"_2870":121576},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3383":71182,"_29651":71151,"_20578":121578,"_5":14121,"_26960":121500,"_2870":121579},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3383":71183,"_29651":71151,"_20578":121581,"_5":14121,"_26960":121500,"_2870":121582},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3383":71184,"_29651":71151,"_20578":121584,"_5":14121,"_26960":121500,"_2870":121585},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_3383":71185,"_29651":71151,"_20578":121587,"_5":14121,"_26960":121504,"_2870":121588},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3383":71186,"_29651":71151,"_20578":121590,"_5":14121,"_26960":121504,"_2870":121591},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3383":71187,"_29651":71187,"_5":14473,"_2870":121593,"_30004":121594,"_20578":121595,"_26960":71187},"Seguridad",[48280],[],{"_3383":71188,"_29651":71187,"_20578":121597,"_5":14121,"_26960":71187,"_2870":121598},[],"Cómo reportar de forma privada una vulnerabilidad de seguridad en Lamassu, qué incluir en el reporte y qué releases reciben correcciones de seguridad.",{"_3383":71189,"_29651":71187,"_5":30001,"_20578":121600,"_26960":121601,"_2870":121602},[],"/docs/pr-preview/pr-55/es/security#cómo-reportar-una-vulnerabilidad","Cómo reportar una vulnerabilidad",{"_3383":71190,"_29651":71187,"_5":30001,"_20578":121604,"_26960":121605,"_2870":121606},[],"/docs/pr-preview/pr-55/es/security#qué-incluir-en-un-reporte","Qué incluir en un reporte",{"_3383":71191,"_29651":71187,"_5":30001,"_20578":121608,"_26960":121609,"_2870":121610},[],"/docs/pr-preview/pr-55/es/security#versiones-soportadas","Versiones soportadas",{"_3383":71192,"_29651":71187,"_5":30001,"_20578":121612,"_26960":121613,"_2870":121614},[],"/docs/pr-preview/pr-55/es/security#divulgación-responsable","Divulgación responsable",{"_3383":71193,"_29651":71187,"_20578":121616,"_5":14121,"_26960":71187,"_2870":121617},[],"¿Has encontrado una vulnerabilidad de seguridad en lamassuiot, lamassu-dashboard o lamassu-helm? Esta página explica cómo reportarla de forma privada, qué incluir en tu reporte y qué releases reciben correcciones de seguridad.",{"_3383":71194,"_29651":71187,"_20578":121619,"_5":14121,"_26960":121601,"_2870":121620},[],"No reportes vulnerabilidades de seguridad mediante issues, discusiones o pull requests públicos de GitHub. Un reporte público divulga el problema antes de que los mantenedores puedan corregirlo.",{"_3383":71195,"_29651":71187,"_20578":121622,"_5":14121,"_26960":121601,"_2870":121623},[],"En su lugar, reporta de forma privada mediante GitHub Security Advisories para el repositorio afectado:",{"_3383":71196,"_29651":71187,"_20578":121625,"_5":14121,"_26960":121601,"_2870":14740},[],{"_3383":71197,"_29651":71187,"_20578":121627,"_5":14121,"_26960":121601,"_2870":14686},[],{"_3383":71198,"_29651":71187,"_20578":121629,"_5":14121,"_26960":121601,"_2870":14733},[],{"_3383":71199,"_29651":71187,"_20578":121631,"_5":14121,"_26960":121601,"_2870":121632},[],"Así los mantenedores pueden evaluar y resolver el problema antes de que se publique.",{"_3383":71200,"_29651":71187,"_20578":121634,"_5":14121,"_26960":121601,"_2870":121635},[],"Si el reporte privado de vulnerabilidades no está habilitado en ese repositorio, reporta la vulnerabilidad de forma privada a lamassuiot\\@lksnext.com antes de divulgar cualquier detalle públicamente.",{"_3383":71201,"_29651":71187,"_20578":121637,"_5":14121,"_26960":121605,"_2870":121638},[],"Describe la vulnerabilidad, su impacto potencial y los pasos para reproducirla usando ejemplos no sensibles y anonimizados.",{"_3383":71202,"_29651":71187,"_20578":121640,"_5":14121,"_26960":121605,"_2870":121641},[],"No incluyas en el reporte:",{"_3383":71203,"_29651":71187,"_20578":121643,"_5":14121,"_26960":121605,"_2870":121644},[],"Credenciales, tokens o claves privadas",{"_3383":71204,"_29651":71187,"_20578":121646,"_5":14121,"_26960":121605,"_2870":121647},[],"Datos de clientes o información identificable de clientes",{"_3383":71205,"_29651":71187,"_20578":121649,"_5":14121,"_26960":121605,"_2870":121650},[],"Detalles confidenciales de arquitectura o de infraestructura interna",{"_3383":71206,"_29651":71187,"_20578":121652,"_5":14121,"_26960":121609,"_2870":121653},[],"Solo el último release estable recibe soporte de seguridad. El soporte de un release estable termina cuando se publica el siguiente release estable. Los releases anteriores y los pre-releases no tienen soporte.",{"_3383":71207,"_29651":71187,"_20578":121655,"_5":14121,"_26960":121609,"_2870":121656},[],"Para saber cómo actualizar, consulta Actualizaciones.",{"_3383":71208,"_29651":71187,"_20578":121658,"_5":14121,"_26960":121613,"_2870":121659},[],"Da a los mantenedores un tiempo razonable para investigar y resolver la vulnerabilidad reportada antes de cualquier divulgación pública.",{"_3383":71209,"_29651":71187,"_20578":121661,"_5":14121,"_26960":121613,"_2870":121662},[],"Evita violaciones de privacidad, destrucción de datos e interrupciones de servicio mientras investigas la vulnerabilidad.",{"_3383":71210,"_29651":71187,"_20578":121664,"_5":14121,"_26960":121613,"_2870":121665},[],"Interactúa solo con cuentas o datos que sean tuyos o sobre los que tengas permiso explícito.",{"_3383":71211,"_29651":71187,"_20578":121667,"_5":14121,"_26960":121613,"_2870":121668},[],"Los mantenedores reconocen los reportes en un tiempo razonable y te mantienen informado del progreso de la remediación.",{"_3383":71212,"_29651":71187,"_20578":121670,"_5":14121,"_26960":121613,"_2870":121671},[],"Esta política cubre el código fuente, la configuración y los flujos de CI/CD de los repositorios lamassuiot, lamassu-dashboard y lamassu-helm.",{"_3383":71213,"_29651":71213,"_5":14473,"_2870":121673,"_30004":121674,"_20578":121676,"_26960":71213},"3.8.0 a 4.0.0",[48280,121675],"Actualizaciones",[],{"_3383":71214,"_29651":71213,"_20578":121678,"_5":14121,"_26960":71213,"_2870":121679},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3383":71215,"_29651":71213,"_5":30001,"_20578":121681,"_26960":121682,"_2870":121683},[],"/docs/pr-preview/pr-55/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_3383":71216,"_29651":71213,"_5":30001,"_20578":121685,"_26960":121686,"_2870":121687},[],"/docs/pr-preview/pr-55/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3383":71217,"_29651":71213,"_5":30001,"_20578":121689,"_26960":121690,"_2870":121691},[],"/docs/pr-preview/pr-55/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3383":71218,"_29651":71213,"_5":30001,"_20578":121693,"_26960":121694,"_2870":121695},[],"/docs/pr-preview/pr-55/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3383":71219,"_29651":71213,"_5":30001,"_20578":121697,"_26960":121698,"_2870":121699},[],"/docs/pr-preview/pr-55/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3383":71220,"_29651":71213,"_5":30001,"_20578":121701,"_26960":121702,"_2870":121703},[],"/docs/pr-preview/pr-55/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3383":71221,"_29651":71213,"_5":30001,"_20578":121705,"_26960":121706,"_2870":56419},[],"/docs/pr-preview/pr-55/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3383":71222,"_29651":71213,"_5":30001,"_20578":121708,"_26960":121709,"_2870":121710},[],"/docs/pr-preview/pr-55/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_3383":71223,"_29651":71213,"_5":30001,"_20578":121712,"_26960":121713,"_2870":121714},[],"/docs/pr-preview/pr-55/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3383":71224,"_29651":71213,"_5":30001,"_20578":121716,"_26960":121717,"_2870":121718},[],"/docs/pr-preview/pr-55/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3383":71225,"_29651":71213,"_5":30001,"_20578":121720,"_26960":121721,"_2870":121722},[],"/docs/pr-preview/pr-55/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3383":71226,"_29651":71213,"_5":30001,"_20578":121724,"_26960":121725,"_2870":121726},[],"/docs/pr-preview/pr-55/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3383":71227,"_29651":71213,"_5":30001,"_20578":121728,"_26960":121729,"_2870":121730},[],"/docs/pr-preview/pr-55/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3383":71228,"_29651":71213,"_5":30001,"_20578":121732,"_26960":121733,"_2870":121734},[],"/docs/pr-preview/pr-55/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3383":71229,"_29651":71213,"_5":30001,"_20578":121736,"_26960":121737,"_2870":121738},[],"/docs/pr-preview/pr-55/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3383":71230,"_29651":71213,"_5":30001,"_20578":121740,"_26960":121741,"_2870":121742},[],"/docs/pr-preview/pr-55/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_3383":71231,"_29651":71213,"_5":30001,"_20578":121744,"_26960":121745,"_2870":121746},[],"/docs/pr-preview/pr-55/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3383":71232,"_29651":71213,"_5":30001,"_20578":121748,"_26960":121749,"_2870":121750},[],"/docs/pr-preview/pr-55/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3383":71233,"_29651":71213,"_5":30001,"_20578":121752,"_26960":121753,"_2870":121754},[],"/docs/pr-preview/pr-55/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3383":71234,"_29651":71213,"_5":30001,"_20578":121756,"_26960":121757,"_2870":121758},[],"/docs/pr-preview/pr-55/es/upgrades/3-8-0-to-4-0-0#referencias-entre-certificados-claves-y-roles-va","Referencias entre certificados, claves y roles VA",{"_3383":71235,"_29651":71213,"_5":30001,"_20578":121760,"_26960":121761,"_2870":121762},[],"/docs/pr-preview/pr-55/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_3383":71236,"_29651":71213,"_5":30001,"_20578":121764,"_26960":121765,"_2870":121766},[],"/docs/pr-preview/pr-55/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3383":71237,"_29651":71213,"_5":30001,"_20578":121768,"_26960":121769,"_2870":121770},[],"/docs/pr-preview/pr-55/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3383":71238,"_29651":71213,"_5":30001,"_20578":121772,"_26960":121773,"_2870":121774},[],"/docs/pr-preview/pr-55/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3383":71239,"_29651":71213,"_5":30001,"_20578":121776,"_26960":121777,"_2870":121778},[],"/docs/pr-preview/pr-55/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3383":71240,"_29651":71213,"_5":30001,"_20578":121780,"_26960":121781,"_2870":121782},[],"/docs/pr-preview/pr-55/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3383":71241,"_29651":71213,"_5":30001,"_20578":121784,"_26960":121785,"_2870":121786},[],"/docs/pr-preview/pr-55/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3383":71242,"_29651":71213,"_5":30001,"_20578":121788,"_26960":121789,"_2870":121790},[],"/docs/pr-preview/pr-55/es/upgrades/3-8-0-to-4-0-0#campo-firmante-del-rol-va","Campo firmante del rol VA",{"_3383":71243,"_29651":71213,"_5":30001,"_20578":121792,"_26960":121793,"_2870":121794},[],"/docs/pr-preview/pr-55/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3383":71244,"_29651":71213,"_5":30001,"_20578":121796,"_26960":121797,"_2870":121798},[],"/docs/pr-preview/pr-55/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3383":71245,"_29651":71213,"_5":30001,"_20578":121800,"_26960":121801,"_2870":121802},[],"/docs/pr-preview/pr-55/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3383":71246,"_29651":71213,"_5":30001,"_20578":121804,"_26960":121805,"_2870":121806},[],"/docs/pr-preview/pr-55/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3383":71247,"_29651":71213,"_5":30001,"_20578":121808,"_26960":121809,"_2870":121810},[],"/docs/pr-preview/pr-55/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3383":71248,"_29651":71213,"_5":30001,"_20578":121812,"_26960":121813,"_2870":121814},[],"/docs/pr-preview/pr-55/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3383":71249,"_29651":71213,"_5":30001,"_20578":121816,"_26960":121817,"_2870":121818},[],"/docs/pr-preview/pr-55/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3383":71250,"_29651":71213,"_5":30001,"_20578":121820,"_26960":121821,"_2870":117713},[],"/docs/pr-preview/pr-55/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3383":71251,"_29651":71213,"_5":30001,"_20578":121823,"_26960":121824,"_2870":121825},[],"/docs/pr-preview/pr-55/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3383":71252,"_29651":71213,"_5":30001,"_20578":121827,"_26960":121828,"_2870":121829},[],"/docs/pr-preview/pr-55/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3383":71253,"_29651":71213,"_20578":121831,"_5":14121,"_26960":71213,"_2870":121832},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3383":71254,"_29651":71213,"_20578":121834,"_5":14121,"_26960":71213,"_2870":121835},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3383":71255,"_29651":71213,"_20578":121837,"_5":14121,"_26960":71213,"_2870":121838},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_3383":71256,"_29651":71213,"_20578":121840,"_5":14121,"_26960":71213,"_2870":121841},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_3383":71257,"_29651":71213,"_20578":121843,"_5":14121,"_26960":71213,"_2870":121844},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3383":71258,"_29651":71213,"_20578":121846,"_5":14121,"_26960":71213,"_2870":121847},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3383":71259,"_29651":71213,"_20578":121849,"_5":14121,"_26960":71213,"_2870":121850},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3383":71260,"_29651":71213,"_20578":121852,"_5":14121,"_26960":121686,"_2870":121853},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3383":71261,"_29651":71213,"_20578":121855,"_5":14121,"_26960":121686,"_2870":121856},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_3383":71262,"_29651":71213,"_20578":121858,"_5":14121,"_26960":121690,"_2870":121859},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3383":71263,"_29651":71213,"_20578":121861,"_5":14121,"_26960":121690,"_2870":121862},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y roles de la VA. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3383":71264,"_29651":71213,"_20578":121864,"_5":14121,"_26960":121694,"_2870":121865},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera.",{"_3383":71265,"_29651":71213,"_20578":121867,"_5":14121,"_26960":121698,"_2870":121868},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3383":71266,"_29651":71213,"_20578":121870,"_5":14121,"_26960":121698,"_2870":121871},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3383":71267,"_29651":71213,"_20578":121873,"_5":14121,"_26960":121698,"_2870":121874},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_3383":71268,"_29651":71213,"_20578":121876,"_5":14121,"_26960":121698,"_2870":121877},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3383":71269,"_29651":71213,"_20578":121879,"_5":14121,"_26960":121698,"_2870":121880},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3383":71270,"_29651":71213,"_20578":121882,"_5":14121,"_26960":121702,"_2870":121883},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3383":71271,"_29651":71213,"_20578":121885,"_5":14121,"_26960":121702,"_2870":121886},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3383":71272,"_29651":71213,"_20578":121888,"_5":14121,"_26960":121702,"_2870":121889},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3383":71273,"_29651":71213,"_20578":121891,"_5":14121,"_26960":121702,"_2870":121892},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3383":71274,"_29651":71213,"_20578":121894,"_5":14121,"_26960":121702,"_2870":121895},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3383":71275,"_29651":71213,"_20578":121897,"_5":14121,"_26960":121706,"_2870":121898},[],"Cambio",{"_3383":71276,"_29651":71213,"_20578":121900,"_5":14121,"_26960":121706,"_2870":121901},[],"A quién afecta",{"_3383":71277,"_29651":71213,"_20578":121903,"_5":14121,"_26960":121706,"_2870":121904},[],"Gravedad",{"_3383":71278,"_29651":71213,"_20578":121906,"_5":14121,"_26960":121706,"_2870":120433},[],{"_3383":71279,"_29651":71213,"_20578":121908,"_5":14121,"_26960":121706,"_2870":121714},[],{"_3383":71280,"_29651":71213,"_20578":121910,"_5":14121,"_26960":121706,"_2870":121911},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_3383":71281,"_29651":71213,"_20578":121913,"_5":14121,"_26960":121706,"_2870":121914},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_3383":71282,"_29651":71213,"_20578":121916,"_5":14121,"_26960":121706,"_2870":121917},[],"Copiar los datos a los volúmenes nuevos",{"_3383":71283,"_29651":71213,"_20578":121919,"_5":14121,"_26960":121706,"_2870":121718},[],{"_3383":71284,"_29651":71213,"_20578":121921,"_5":14121,"_26960":121706,"_2870":121922},[],"Todas las releases de Helm",{"_3383":71285,"_29651":71213,"_20578":121924,"_5":14121,"_26960":121706,"_2870":121925},[],"Alta: `helm upgrade` falla",{"_3383":71286,"_29651":71213,"_20578":121927,"_5":14121,"_26960":121706,"_2870":121928},[],"Eliminar o renombrar las claves heredadas",{"_3383":71287,"_29651":71213,"_20578":121930,"_5":14121,"_26960":121706,"_2870":121722},[],{"_3383":71288,"_29651":71213,"_20578":121932,"_5":14121,"_26960":121706,"_2870":121933},[],"Todos los despliegues",{"_3383":71289,"_29651":71213,"_20578":121935,"_5":14121,"_26960":121706,"_2870":121936},[],"Alta: sin principal de bootstrap no hay administrador",{"_3383":71290,"_29651":71213,"_20578":121938,"_5":14121,"_26960":121706,"_2870":121939},[],"Configurar `services.authz`",{"_3383":71291,"_29651":71213,"_20578":121941,"_5":14121,"_26960":121706,"_2870":121726},[],{"_3383":71292,"_29651":71213,"_20578":121943,"_5":14121,"_26960":121706,"_2870":121922},[],{"_3383":71293,"_29651":71213,"_20578":121945,"_5":14121,"_26960":121706,"_2870":121946},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_3383":71294,"_29651":71213,"_20578":121948,"_5":14121,"_26960":121706,"_2870":121949},[],"Mover JWKS y roles a `services.authz`",{"_3383":71295,"_29651":71213,"_20578":121951,"_5":14121,"_26960":121706,"_2870":121746},[],{"_3383":71296,"_29651":71213,"_20578":121953,"_5":14121,"_26960":121706,"_2870":121954},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_3383":71297,"_29651":71213,"_20578":121956,"_5":14121,"_26960":121706,"_2870":121957},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_3383":71298,"_29651":71213,"_20578":121959,"_5":14121,"_26960":121706,"_2870":121960},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_3383":71299,"_29651":71213,"_20578":121962,"_5":14121,"_26960":121706,"_2870":121750},[],{"_3383":71300,"_29651":71213,"_20578":121964,"_5":14121,"_26960":121706,"_2870":121965},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_3383":71301,"_29651":71213,"_20578":121967,"_5":14121,"_26960":121706,"_2870":121968},[],"Alta: el backend ya no arranca con ellos",{"_3383":71302,"_29651":71213,"_20578":121970,"_5":14121,"_26960":121706,"_2870":121971},[],"Pasar a PostgreSQL antes de actualizar",{"_3383":71303,"_29651":71213,"_20578":121973,"_5":14121,"_26960":121706,"_2870":121974},[],"Webhooks con referencias a archivos",{"_3383":71304,"_29651":71213,"_20578":121976,"_5":14121,"_26960":121706,"_2870":121977},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3383":71305,"_29651":71213,"_20578":121979,"_5":14121,"_26960":121706,"_2870":121980},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_3383":71306,"_29651":71213,"_20578":121982,"_5":14121,"_26960":121706,"_2870":121983},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3383":71307,"_29651":71213,"_20578":121985,"_5":14121,"_26960":121706,"_2870":121730},[],{"_3383":71308,"_29651":71213,"_20578":121987,"_5":14121,"_26960":121706,"_2870":121988},[],"Releases con identidades por servicio o material de claves montado",{"_3383":71309,"_29651":71213,"_20578":121990,"_5":14121,"_26960":121706,"_2870":121991},[],"Media: los servicios no pueden leer sus archivos",{"_3383":71310,"_29651":71213,"_20578":121993,"_5":14121,"_26960":121706,"_2870":121994},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_3383":71311,"_29651":71213,"_20578":121996,"_5":14121,"_26960":121706,"_2870":121734},[],{"_3383":71312,"_29651":71213,"_20578":121998,"_5":14121,"_26960":121706,"_2870":121999},[],"Releases que definen `amqp.tls`",{"_3383":71313,"_29651":71213,"_20578":122001,"_5":14121,"_26960":121706,"_2870":122002},[],"Media: los clientes se conectan al puerto equivocado",{"_3383":71314,"_29651":71213,"_20578":122004,"_5":14121,"_26960":121706,"_2870":122005},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_3383":71315,"_29651":71213,"_20578":122007,"_5":14121,"_26960":121706,"_2870":121754},[],{"_3383":71316,"_29651":71213,"_20578":122009,"_5":14121,"_26960":121706,"_2870":122010},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3383":71317,"_29651":71213,"_20578":122012,"_5":14121,"_26960":121706,"_2870":122013},[],"Media: las claves de CA quedan sin gestionar",{"_3383":71318,"_29651":71213,"_20578":122015,"_5":14121,"_26960":121706,"_2870":122016},[],"Ejecutar la migración de CA a KMS",{"_3383":71319,"_29651":71213,"_20578":122018,"_5":14121,"_26960":121706,"_2870":122019},[],"Verificación del certificado del receptor",{"_3383":71320,"_29651":71213,"_20578":122021,"_5":14121,"_26960":121706,"_2870":122022},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_3383":71321,"_29651":71213,"_20578":122024,"_5":14121,"_26960":121706,"_2870":122025},[],"Media: las credenciales viajan a un receptor sin verificar",{"_3383":71322,"_29651":71213,"_20578":122027,"_5":14121,"_26960":121706,"_2870":122028},[],"Poner `insecure_skip_verify` a `false`",{"_3383":71323,"_29651":71213,"_20578":122030,"_5":14121,"_26960":121706,"_2870":121770},[],{"_3383":71324,"_29651":71213,"_20578":122032,"_5":14121,"_26960":121706,"_2870":122033},[],"Scripts y consolas que editan DMS por API",{"_3383":71325,"_29651":71213,"_20578":122035,"_5":14121,"_26960":121706,"_2870":122036},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3383":71326,"_29651":71213,"_20578":122038,"_5":14121,"_26960":121706,"_2870":122039},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3383":71327,"_29651":71213,"_20578":122041,"_5":14121,"_26960":121706,"_2870":121790},[],{"_3383":71328,"_29651":71213,"_20578":122043,"_5":14121,"_26960":121706,"_2870":122044},[],"Clientes que crean o actualizan roles VA por API",{"_3383":71329,"_29651":71213,"_20578":122046,"_5":14121,"_26960":121706,"_2870":122047},[],"Media: las peticiones con el campo antiguo devuelven un error",{"_3383":71330,"_29651":71213,"_20578":122049,"_5":14121,"_26960":121706,"_2870":122050},[],"Sustituir `crl_options.subject_key_id_signer` por el obligatorio `crl_options.signer_certificate_serial_number`",{"_3383":71331,"_29651":71213,"_20578":122052,"_5":14121,"_26960":121706,"_2870":121786},[],{"_3383":71332,"_29651":71213,"_20578":122054,"_5":14121,"_26960":121706,"_2870":122055},[],"Consumidores que leen el campo `events` del dispositivo",{"_3383":71333,"_29651":71213,"_20578":122057,"_5":14121,"_26960":121706,"_2870":122058},[],"Media: el campo desaparece",{"_3383":71334,"_29651":71213,"_20578":122060,"_5":14121,"_26960":121706,"_2870":122061},[],"Usar los nuevos endpoints de eventos",{"_3383":71335,"_29651":71213,"_20578":122063,"_5":14121,"_26960":121706,"_2870":121738},[],{"_3383":71336,"_29651":71213,"_20578":122065,"_5":14121,"_26960":121706,"_2870":122066},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_3383":71337,"_29651":71213,"_20578":122068,"_5":14121,"_26960":121706,"_2870":122069},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_3383":71338,"_29651":71213,"_20578":122071,"_5":14121,"_26960":121706,"_2870":122072},[],"Actualizar el archivo de values",{"_3383":71339,"_29651":71213,"_20578":122074,"_5":14121,"_26960":121706,"_2870":121778},[],{"_3383":71340,"_29651":71213,"_20578":122076,"_5":14121,"_26960":121706,"_2870":122077},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3383":71341,"_29651":71213,"_20578":122079,"_5":14121,"_26960":121706,"_2870":122080},[],"Baja: prevalece el ID de la URL",{"_3383":71342,"_29651":71213,"_20578":122082,"_5":14121,"_26960":121706,"_2870":122083},[],"Enviar el ID en la URL",{"_3383":71343,"_29651":71213,"_20578":122085,"_5":14121,"_26960":121706,"_2870":121782},[],{"_3383":71344,"_29651":71213,"_20578":122087,"_5":14121,"_26960":121706,"_2870":122088},[],"Consumidores que comparan el `type` del certificado",{"_3383":71345,"_29651":71213,"_20578":122090,"_5":14121,"_26960":121706,"_2870":122091},[],"Baja: dos valores cambian de nombre",{"_3383":71346,"_29651":71213,"_20578":122093,"_5":14121,"_26960":121706,"_2870":122094},[],"Adaptar los consumidores",{"_3383":71347,"_29651":71213,"_20578":122096,"_5":14121,"_26960":121706,"_2870":121774},[],{"_3383":71348,"_29651":71213,"_20578":122098,"_5":14121,"_26960":121706,"_2870":122099},[],"Cualquier DMS",{"_3383":71349,"_29651":71213,"_20578":122101,"_5":14121,"_26960":121706,"_2870":122102},[],"Baja: solo informativo",{"_3383":71350,"_29651":71213,"_20578":122104,"_5":14121,"_26960":121706,"_2870":122105},[],"Revisar ambos bloques antes de editar",{"_3383":71351,"_29651":71213,"_20578":122107,"_5":14121,"_26960":121713,"_2870":122108},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3383":71352,"_29651":71213,"_20578":122110,"_5":14121,"_26960":121713,"_2870":122111},[],"El paso 4 de la guía de migración copia los datos.",{"_3383":71353,"_29651":71213,"_20578":122113,"_5":14121,"_26960":121717,"_2870":122114},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3383":71354,"_29651":71213,"_20578":122116,"_5":14121,"_26960":121721,"_2870":122117},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3383":71355,"_29651":71213,"_20578":122119,"_5":14121,"_26960":121725,"_2870":122120},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3383":71356,"_29651":71213,"_20578":122122,"_5":14121,"_26960":121729,"_2870":122123},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3383":71357,"_29651":71213,"_20578":122125,"_5":14121,"_26960":121729,"_2870":122126},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3383":71358,"_29651":71213,"_20578":122128,"_5":14121,"_26960":121733,"_2870":122129},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3383":71359,"_29651":71213,"_20578":122131,"_5":14121,"_26960":121737,"_2870":122132},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3383":71360,"_29651":71213,"_20578":122134,"_5":14121,"_26960":121737,"_2870":122135},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3383":71361,"_29651":71213,"_20578":122137,"_5":14121,"_26960":121737,"_2870":122138},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3383":71362,"_29651":71213,"_20578":122140,"_5":14121,"_26960":121737,"_2870":122141},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3383":71363,"_29651":71213,"_20578":122143,"_5":14121,"_26960":121737,"_2870":122144},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3383":71364,"_29651":71213,"_20578":122146,"_5":14121,"_26960":121737,"_2870":122147},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3383":71365,"_29651":71213,"_20578":122149,"_5":14121,"_26960":121745,"_2870":122150},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3383":71366,"_29651":71213,"_20578":122152,"_5":14121,"_26960":121745,"_2870":122153},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3383":71367,"_29651":71213,"_20578":122155,"_5":14121,"_26960":121745,"_2870":122156},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3383":71368,"_29651":71213,"_20578":122158,"_5":14121,"_26960":121745,"_2870":122159},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3383":71369,"_29651":71213,"_20578":122161,"_5":14121,"_26960":121745,"_2870":122162},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_3383":71370,"_29651":71213,"_20578":122164,"_5":14121,"_26960":121749,"_2870":122165},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3383":71371,"_29651":71213,"_20578":122167,"_5":14121,"_26960":121753,"_2870":122168},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3383":71372,"_29651":71213,"_20578":122170,"_5":14121,"_26960":121753,"_2870":122171},[],"El `key_id` es el `subject_key_id` del certificado (SHA-256 de la clave pública).",{"_3383":71373,"_29651":71213,"_20578":122173,"_5":14121,"_26960":121753,"_2870":122174},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3383":71374,"_29651":71213,"_20578":122176,"_5":14121,"_26960":121753,"_2870":122177},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3383":71375,"_29651":71213,"_20578":122179,"_5":14121,"_26960":121753,"_2870":122180},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3383":71376,"_29651":71213,"_20578":122182,"_5":14121,"_26960":121753,"_2870":122183},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3383":71377,"_29651":71213,"_20578":122185,"_5":14121,"_26960":121753,"_2870":122186},[],"Una vez registradas las claves heredadas, arrancar el KMS con la opción de configuración del backend `crypto_engines.migrate_keys_format` renombra las claves cuyo nombre no es el digest SHA-256 de la clave pública, conserva el nombre antiguo como alias y traslada consigo las referencias de certificados. Es seguro volver a ejecutarla y puede desactivarse después.",{"_3383":71378,"_29651":71213,"_20578":122188,"_5":14121,"_26960":121757,"_2870":122189},[],"Los certificados referencian ahora su clave del KMS, y los roles VA referencian su certificado firmante, de modo que no se puede eliminar una clave o un certificado en uso. La migración del KMS descarta los metadatos de clave heredados `lamassu.io/kms/binded-resources`. Antes de 4.0.0, eliminar una CA podía borrar su clave y dejar referencias a ella en los registros de certificado conservados. La migración de CA registra esas claves ausentes en el KMS solo con su clave pública para satisfacer las referencias conservadas. Estas entradas no pueden eliminarse mientras los certificados conservados las referencien; no recuperan la clave privada. En 4.0.0, eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados antes de intentar eliminar la clave; los demás certificados que todavía la referencien impiden su eliminación.",{"_3383":71379,"_29651":71213,"_20578":122191,"_5":14121,"_26960":121765,"_2870":122192},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_3383":71380,"_29651":71213,"_20578":122194,"_5":14121,"_26960":121765,"_2870":122195},[],"Campo en 3.8.0",{"_3383":71381,"_29651":71213,"_20578":122197,"_5":14121,"_26960":121765,"_2870":122198},[],"Campo en 4.0.0",{"_3383":71382,"_29651":71213,"_20578":122200,"_5":14121,"_26960":121765,"_2870":56914},[],{"_3383":71383,"_29651":71213,"_20578":122202,"_5":14121,"_26960":121765,"_2870":122203},[],"`insecure_skip_verify` (con el valor negado)",{"_3383":71384,"_29651":71213,"_20578":122205,"_5":14121,"_26960":121765,"_2870":56920},[],{"_3383":71385,"_29651":71213,"_20578":122207,"_5":14121,"_26960":121765,"_2870":56923},[],{"_3383":71386,"_29651":71213,"_20578":122209,"_5":14121,"_26960":121765,"_2870":56926},[],{"_3383":71387,"_29651":71213,"_20578":122211,"_5":14121,"_26960":121765,"_2870":56929},[],{"_3383":71388,"_29651":71213,"_20578":122213,"_5":14121,"_26960":121765,"_2870":56932},[],{"_3383":71389,"_29651":71213,"_20578":122215,"_5":14121,"_26960":121765,"_2870":56935},[],{"_3383":71390,"_29651":71213,"_20578":122217,"_5":14121,"_26960":121765,"_2870":122218},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_3383":71391,"_29651":71213,"_20578":122220,"_5":14121,"_26960":121765,"_2870":122221},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3383":71392,"_29651":71213,"_20578":122223,"_5":14121,"_26960":121765,"_2870":122224},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3383":71393,"_29651":71213,"_20578":122226,"_5":14121,"_26960":121769,"_2870":122227},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3383":71394,"_29651":71213,"_20578":122229,"_5":14121,"_26960":121769,"_2870":122230},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3383":71395,"_29651":71213,"_20578":122232,"_5":14121,"_26960":121769,"_2870":122233},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3383":71396,"_29651":71213,"_20578":122235,"_5":14121,"_26960":121773,"_2870":122236},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. La consola expone editores independientes para ambos bloques; la guía de DMS describe sus campos, y también puedes editarlos mediante la API DMS.",{"_3383":71397,"_29651":71213,"_20578":122238,"_5":14121,"_26960":121777,"_2870":122239},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3383":71398,"_29651":71213,"_20578":122241,"_5":14121,"_26960":121781,"_2870":122242},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_3383":71399,"_29651":71213,"_20578":122244,"_5":14121,"_26960":121785,"_2870":122245},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3383":71400,"_29651":71213,"_20578":122247,"_5":14121,"_26960":121785,"_2870":122248},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3383":71401,"_29651":71213,"_20578":122250,"_5":14121,"_26960":121785,"_2870":122251},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3383":71402,"_29651":71213,"_20578":122253,"_5":14121,"_26960":121785,"_2870":122254},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza.",{"_3383":71403,"_29651":71213,"_20578":122256,"_5":14121,"_26960":121789,"_2870":122257},[],"`crl_options.subject_key_id_signer` se sustituye por el obligatorio `crl_options.signer_certificate_serial_number`, el número de serie del certificado existente que firma la CRL. El valor inicial de un rol nuevo es el número de serie del certificado actual de la CA. Las peticiones que aún contienen `subject_key_id_signer` devuelven un error. Las políticas de autorización personalizadas que filtran por el campo antiguo deben actualizarse: el filtro `crl_subject_key_id_signer` se renombra a `crl_signer_certificate_serial_number` y toma valores de número de serie.",{"_3383":71404,"_29651":71213,"_20578":122259,"_5":14121,"_26960":121793,"_2870":122260},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3383":71405,"_29651":71213,"_20578":122262,"_5":14121,"_26960":121797,"_2870":122263},[],"Haz una copia de seguridad verificable de PostgreSQL y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`.",{"_3383":71406,"_29651":71213,"_20578":122265,"_5":14121,"_26960":121797,"_2870":122266},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3383":71407,"_29651":71213,"_20578":122268,"_5":14121,"_26960":121797,"_2870":122269},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3383":71408,"_29651":71213,"_20578":122271,"_5":14121,"_26960":121797,"_2870":122272},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3383":71409,"_29651":71213,"_20578":122274,"_5":14121,"_26960":121797,"_2870":122275},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3383":71410,"_29651":71213,"_20578":122277,"_5":14121,"_26960":121801,"_2870":122278},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3383":71411,"_29651":71213,"_20578":122280,"_5":14121,"_26960":121801,"_2870":122281},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3383":71412,"_29651":71213,"_20578":122283,"_5":14121,"_26960":121801,"_2870":122284},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se lee el campo `database` de cada entrada; la conexión usa siempre los values globales `postgres.hostname`, `postgres.port`, `postgres.username` y `postgres.password`.",{"_3383":71413,"_29651":71213,"_20578":122286,"_5":14121,"_26960":121801,"_2870":122287},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3383":71414,"_29651":71213,"_20578":122289,"_5":14121,"_26960":121801,"_2870":122290},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3383":71415,"_29651":71213,"_20578":122292,"_5":14121,"_26960":121801,"_2870":122293},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3383":71416,"_29651":71213,"_20578":122295,"_5":14121,"_26960":121801,"_2870":122296},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3383":71417,"_29651":71213,"_20578":122298,"_5":14121,"_26960":121801,"_2870":122299},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3383":71418,"_29651":71213,"_20578":122301,"_5":14121,"_26960":121801,"_2870":122302},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3383":71419,"_29651":71213,"_20578":122304,"_5":14121,"_26960":121801,"_2870":122305},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3383":71420,"_29651":71213,"_20578":122307,"_5":14121,"_26960":121801,"_2870":122308},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3383":71421,"_29651":71213,"_20578":122310,"_5":14121,"_26960":121801,"_2870":122311},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida.",{"_3383":71422,"_29651":71213,"_20578":122313,"_5":14121,"_26960":121805,"_2870":122314},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_3383":71423,"_29651":71213,"_20578":122316,"_5":14121,"_26960":121805,"_2870":122317},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_3383":71424,"_29651":71213,"_20578":122319,"_5":14121,"_26960":121809,"_2870":122320},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3383":71425,"_29651":71213,"_20578":122322,"_5":14121,"_26960":121809,"_2870":122323},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3383":71426,"_29651":71213,"_20578":122325,"_5":14121,"_26960":121809,"_2870":122326},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3383":71427,"_29651":71213,"_20578":122328,"_5":14121,"_26960":121809,"_2870":122329},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_3383":71428,"_29651":71213,"_20578":122331,"_5":14121,"_26960":121809,"_2870":122332},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3383":71429,"_29651":71213,"_20578":122334,"_5":14121,"_26960":121809,"_2870":122335},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3383":71430,"_29651":71213,"_20578":122337,"_5":14121,"_26960":121809,"_2870":122338},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3383":71431,"_29651":71213,"_20578":122340,"_5":14121,"_26960":121809,"_2870":122341},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3383":71432,"_29651":71213,"_20578":122343,"_5":14121,"_26960":121809,"_2870":122344},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3383":71433,"_29651":71213,"_20578":122346,"_5":14121,"_26960":121809,"_2870":122347},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3383":71434,"_29651":71213,"_20578":122349,"_5":14121,"_26960":121809,"_2870":122350},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_3383":71435,"_29651":71213,"_20578":122352,"_5":14121,"_26960":121813,"_2870":122353},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3383":71436,"_29651":71213,"_20578":122355,"_5":14121,"_26960":121813,"_2870":122356},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3383":71437,"_29651":71213,"_20578":122358,"_5":14121,"_26960":121817,"_2870":122359},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3383":71438,"_29651":71213,"_20578":122361,"_5":14121,"_26960":121817,"_2870":122362},[],"Ejecuta las migraciones en el orden obligatorio, un esquema cada vez: primero `kms`, después la herramienta `ca-to-kms-migration` (necesaria solo en despliegues heredados cuyas claves de CA se nombran por SKI), luego `ca` y por último `va`. Los esquemas `devicemanager`, `dmsmanager` y `alerts` son independientes y pueden migrarse en cualquier orden. Con Helm, el job de preinstalación del chart aplica los esquemas en el orden correcto automáticamente.",{"_3383":71439,"_29651":71213,"_20578":122364,"_5":14121,"_26960":121817,"_2870":122365},[],"Los esquemas se referencian entre sí, así que el rol de PostgreSQL que ejecuta las migraciones necesita privilegios entre esquemas: el esquema `ca` necesita `USAGE` sobre `kms` más `SELECT`, `REFERENCES` e `INSERT` sobre `kms.kms_keys`, y el esquema `va` necesita `USAGE` sobre `ca` más `SELECT` y `REFERENCES` sobre `ca.certificates` y `SELECT` sobre `ca.ca_certificates`. Si tus servicios se conectan con un usuario distinto del que ejecutó las migraciones, concédele tras las migraciones `SELECT` sobre `ca.certificates_view`.",{"_3383":71440,"_29651":71213,"_20578":122367,"_5":14121,"_26960":121817,"_2870":122368},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3383":71441,"_29651":71213,"_20578":122370,"_5":14121,"_26960":121817,"_2870":122371},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3383":71442,"_29651":71213,"_20578":122373,"_5":14121,"_26960":121817,"_2870":122374},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_3383":71443,"_29651":71213,"_20578":122376,"_5":14121,"_26960":121817,"_2870":122377},[],"Los README de ambas herramientas documentan el formato de 4.0.0 con la base `pki` y coinciden con esta página: `goose-lamassu` usa ejemplos con `dbname=pki` y no valida el nombre de la base de datos, y el README de `ca-to-kms-migration` describe la base única `pki` y el orden de migración.",{"_3383":71444,"_29651":71213,"_20578":122379,"_5":14121,"_26960":121821,"_2870":122380},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3383":71445,"_29651":71213,"_20578":122382,"_5":14121,"_26960":121821,"_2870":122383},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_3383":71446,"_29651":71213,"_20578":122385,"_5":14121,"_26960":121821,"_2870":122386},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_3383":71447,"_29651":71213,"_20578":122388,"_5":14121,"_26960":121821,"_2870":122389},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3383":71448,"_29651":71213,"_20578":122391,"_5":14121,"_26960":121821,"_2870":122392},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó por IDs de CA duplicados o por valores de `engine_id` vacíos. Revisa los logs del job, corrige los permisos o los datos y vuelve a ejecutar la actualización.",{"_3383":71449,"_29651":71213,"_20578":122394,"_5":14121,"_26960":121821,"_2870":122395},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3383":71450,"_29651":71213,"_20578":122397,"_5":14121,"_26960":121821,"_2870":122398},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3383":71451,"_29651":71213,"_20578":122400,"_5":14121,"_26960":121821,"_2870":122401},[],"**Una migración aborta con `kms schema not found`.** Los esquemas deben migrarse en orden: ejecuta la migración del esquema `kms` antes que la del esquema `ca`.",{"_3383":71452,"_29651":71213,"_20578":122403,"_5":14121,"_26960":121821,"_2870":122404},[],"**Una migración aborta con `ca schema not found`.** Ejecuta la migración del esquema `ca` antes que la del esquema `va`.",{"_3383":71453,"_29651":71213,"_20578":122406,"_5":14121,"_26960":121821,"_2870":122407},[],"**La migración de VA falla con `cannot resolve signer certificate for VA role ... N candidates`.** La migración no puede identificar un certificado firmante de forma única a partir del SKI guardado en el rol. Revisa el SKI y los certificados candidatos indicados en el error; corrige los datos anteriores a la migración con una copia de seguridad verificada y vuelve a ejecutar la migración. El nuevo campo `signer_certificate_serial_number` se crea durante esa migración, por lo que no se puede configurar mediante la API de VA mientras esta falla.",{"_3383":71454,"_29651":71213,"_20578":122409,"_5":14121,"_26960":121821,"_2870":122410},[],"**Una migración o un servicio falla con `permission denied for table ...`.** Al rol de PostgreSQL le faltan los privilegios entre esquemas listados en Despliegues sin Helm; incluye `certificates_view` cuando se omitió el `GRANT SELECT` posterior a la migración. Concede los privilegios que falten y vuelve a ejecutar.",{"_3383":71455,"_29651":71213,"_20578":122412,"_5":14121,"_26960":121824,"_2870":122413},[],"Tras la actualización, comprueba en este orden:",{"_3383":71456,"_29651":71213,"_20578":122415,"_5":14121,"_26960":121824,"_2870":122416},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS, y las migraciones de claves foráneas que se ejecutan por esquema en el orden obligatorio.",{"_3383":71457,"_29651":71213,"_20578":122418,"_5":14121,"_26960":121824,"_2870":122419},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3383":71458,"_29651":71213,"_20578":122421,"_5":14121,"_26960":121824,"_2870":122422},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3383":71459,"_29651":71213,"_20578":122424,"_5":14121,"_26960":121824,"_2870":122425},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-ski>` sobre la VA devuelve una CRL emitida anteriormente, y se emiten CRLs nuevas.",{"_3383":71460,"_29651":71213,"_20578":122427,"_5":14121,"_26960":121824,"_2870":122428},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS.",{"_3383":71461,"_29651":71213,"_20578":122430,"_5":14121,"_26960":121824,"_2870":122431},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3383":71462,"_29651":71213,"_20578":122433,"_5":14121,"_26960":121824,"_2870":122434},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3383":71463,"_29651":71213,"_20578":122436,"_5":14121,"_26960":121824,"_2870":122437},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha.",{"_3383":71464,"_29651":71213,"_20578":122439,"_5":14121,"_26960":121824,"_2870":122440},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3383":71465,"_29651":71213,"_20578":122442,"_5":14121,"_26960":121824,"_2870":122443},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3383":71466,"_29651":71213,"_20578":122445,"_5":14121,"_26960":121824,"_2870":122446},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3383":71467,"_29651":71213,"_20578":122448,"_5":14121,"_26960":121824,"_2870":122449},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3383":71468,"_29651":71213,"_20578":122451,"_5":14121,"_26960":121824,"_2870":122452},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3383":71469,"_29651":71213,"_20578":122454,"_5":14121,"_26960":121824,"_2870":122455},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3383":71470,"_29651":71213,"_20578":122457,"_5":14121,"_26960":121828,"_2870":122458},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_3383":71471,"_29651":71213,"_20578":122460,"_5":14121,"_26960":121828,"_2870":122461},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3383":71472,"_29651":71213,"_20578":122463,"_5":14121,"_26960":121828,"_2870":122464},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3383":71473,"_29651":71213,"_20578":122466,"_5":14121,"_26960":121828,"_2870":122467},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_3383":71474,"_29651":71213,"_20578":122469,"_5":14121,"_26960":121828,"_2870":122470},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_57193":122472,"_57195":122473,"_57197":122474,"_57199":122475,"_17818":2905,"_68618":2905},"spanish",[2870,29651,5,26960],{"_2870":24582,"_29651":24582,"_5":24582,"_26960":24582},{"_2870":122476,"_29651":125329,"_5":128182,"_26960":131035},{"_4548":122477,"_57203":122478,"_5":24582},{"_14197":5016,"_14578":4233,"_14597":4793,"_28654":3297,"_14584":4106,"_19532":3151,"_14218":7467,"_14225":7152,"_28596":10239,"_29005":4639,"_29026":3072,"_28630":6895,"_33959":6169,"_28733":19990,"_29070":9686,"_33966":5816,"_33969":3329,"_33972":4956,"_33975":5005,"_29477":4638,"_33980":4358,"_33982":3727,"_29507":6916,"_14593":6918,"_33986":7354,"_33989":3172,"_33991":2955,"_29054":5886,"_29472":9933,"_29520":7255,"_33996":7987,"_33998":9199,"_34000":6862,"_28750":3313,"_34003":3428,"_34005":3910,"_34007":14160,"_34009":6892,"_34011":15755,"_28667":7064,"_34014":3606,"_34016":16316,"_28661":12242,"_29091":6096,"_34020":19806,"_34022":12663,"_34025":8864,"_28707":3920,"_34029":6220,"_28587":5860,"_34032":3731,"_28635":5335,"_34035":6267,"_34037":5879,"_29710":4510,"_14587":14657,"_34042":3680,"_34044":7517,"_34047":4767,"_34049":5417,"_34051":6887,"_34053":5367,"_34055":19995,"_19535":5463,"_34058":18120,"_34060":6792,"_28608":7339,"_29048":3427,"_34064":5028