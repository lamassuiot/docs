ets/integrations/meta.json","<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-cloud shrink-0\" aria-hidden=\"true\"><path d=\"M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z\"></path></svg>","es:platform/iot-fleets",{"_196":319},"platform/iot-fleets/meta.json","<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-cpu shrink-0\" aria-hidden=\"true\"><path d=\"M12 20v2\"></path><path d=\"M12 2v2\"></path><path d=\"M17 20v2\"></path><path d=\"M17 2v2\"></path><path d=\"M2 12h2\"></path><path d=\"M2 17h2\"></path><path d=\"M2 7h2\"></path><path d=\"M20 12h2\"></path><path d=\"M20 17h2\"></path><path d=\"M20 7h2\"></path><path d=\"M7 20v2\"></path><path d=\"M7 2v2\"></path><rect x=\"4\" y=\"4\" width=\"16\" height=\"16\" rx=\"2\"></rect><rect x=\"8\" y=\"8\" width=\"8\" height=\"8\" rx=\"1\"></rect></svg>",{"_40":322,"_47":58,"_42":207,"_52":323,"_61":-7,"_12":324,"_63":325},"es:platform/iot-fleets/overview.mdx","Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.","/docs/pr-preview/pr-55/es/platform/iot-fleets/overview",{"_65":326},"platform/iot-fleets/overview.mdx",{"_47":48,"_42":328,"_49":-7,"_51":-7,"_52":-7,"_54":-7,"_44":329,"_40":351,"_63":352,"_61":-7},"Administración",[330,337,344],{"_40":331,"_47":58,"_42":332,"_52":333,"_61":-7,"_12":334,"_63":335},"es:platform/administration/access-control.mdx","Control de acceso","Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.","/docs/pr-preview/pr-55/es/platform/administration/access-control",{"_65":336},"platform/administration/access-control.mdx",{"_40":338,"_47":58,"