/pr-preview/pr-56/platform/updates/guides/native-curl","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#3-upload-the-sw-description-and-the-artifact","content":"3\\. Upload the sw-description and the artifact"},"3384":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-5","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#4-build-the-swu","content":"4\\. Build the `.swu`"},"3385":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-6","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#5-preview-then-create-the-launch","content":"5\\. Preview, then create the launch"},"3386":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-7","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#6-roll-out-the-canary","content":"6\\. Roll out the canary"},"3387":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-8","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#7-play-the-device","content":"7\\. Play the device"},"3388":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-9","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#8-roll-out-the-rest","content":"8\\. Roll out the rest"},"3389":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-10","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#9-check-the-result","content":"9\\. Check the result"},"3390":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-11","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#variations","content":"Variations"},"3391":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-12","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#let-the-service-release-the-batches","content":"Let the service release the batches"},"3392":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-13","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#pause-resume-retry-and-cancel","content":"Pause, resume, retry and cancel"},"3393":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-14","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#schedule-a-launch","content":"Schedule a launch"},"3394":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-15","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#require-a-version-before-updating","content":"Require a version before updating"},"3395":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-16","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#update-one-device-to-a-version","content":"Update one device to a version"},"3396":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-17","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#a-new-version","content":"A new version"},"3397":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-18","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#encrypt-with-a-shared-key","content":"Encrypt with a shared key"},"3398":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-19","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#encrypt-per-device","content":"Encrypt per device"},"3399":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-20","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#sign-the-package","content":"Sign the package"},"3400":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-21","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#troubleshooting","content":"Troubleshooting"},"3401":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-22","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#next-steps","content":"Next steps"},"3402":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-23","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","content":"A complete update, request by request: create a pack, build it, send it to a group in batches, play the device, and follow progress. Every command was run against a native-mode stack, and the responses are real, trimmed where long, except where a section says it was not run: those examples were checked against the code only."},"3403":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-24","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","content":"If you use the hawkBit backend the flow differs, mainly in how a pack is built and how devices report. For the screens that do the same, see the dashboard guide."},"3404":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-25","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#before-you-begin","content":"The stack is running in native mode: the service, Postgres, WFX and the Lamassu device manager."},"3405":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-26","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#before-you-begin","content":"A device group exists in Lamassu with devices in it. This guide uses the group `fleet-a` with the devices `dev-001` to `dev-004`."},"3406":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-27","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#before-you-begin","content":"`curl` and `jq` are installed. `jq` is only used to pull values out of responses."},"3407":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-28","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#before-you-begin","content":"These are the addresses of the Docker Compose stack in the repository. Through a Lamassu gateway the API is usually `https://lamassu.example.com/api/updates/v1`, and every call then needs the credential your gateway requires, for example `-H \"Authorization: Bearer $TOKEN\"`. The service itself does no authentication. See Security."},"3408":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-29","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#2-create-the-pack","content":"The pack is `draft`. It stays editable until it is built. `name`, `version` (semver) and `group_id` are required; the name must be unique in the group, or the request answers `409`."},"3409":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-30","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#3-upload-the-sw-description-and-the-artifact","content":"The sw-description tells SWUpdate what to install. This minimal one installs a web page. See the sw-description rules in Publish and roll out an update."},"3410":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-31","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#3-upload-the-sw-description-and-the-artifact","content":"The artifact name is global: all packs share one catalog, and a name can only be reused with a **higher** `version`. Uploading `index.html` again as `1.0.0` fails with `version 1.0.0 must be greater than the current latest version`. A file named `.swu` or `.tar.gz` must really be one, or the upload answers `400`."},"3411":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-32","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#4-build-the-swu","content":"`selected_artifact_ids` is what puts artifacts into the build. Without it the build fails."},"3412":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-33","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#4-build-the-swu","content":"The `uri` starts with the service's `update_domain`. In the Compose stack that is `http://updates:10090/updates/v1/` (`config-docker.yml`), a name that resolves only inside the Compose network, because it is the address devices use. From your host, call the same path on `localhost:10090`, as the next command does."},"3413":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-34","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#4-build-the-swu","content":"The pack is now `built`: artifacts can no longer be added or linked to it. You can fetch the shared package (this one is not encrypted):"},"3414":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-35","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#4-build-the-swu","content":"Downloads support `Range` and `HEAD`, so a client can learn the size first and resume an interrupted transfer, for example with `curl -C - -o water.swu $P/swu/download`. With S3 storage and presigning enabled, the same request can answer `302` to a short-lived signed URL, which `curl -L` follows."},"3415":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-36","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#4-build-the-swu","content":"If the build fails, the pack gets the status `build_failed` and `last_build_error` holds the reason. It stays editable: fix the cause and build again."},"3416":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-37","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#5-preview-then-create-the-launch","content":"A dry run shows who would receive the update, without creating anything:"},"3417":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-38","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#5-preview-then-create-the-launch","content":"Create it. `test_device_id` is the canary: it goes alone first and must succeed before anyone else is touched. `rollout_value` 2 means batches of two devices."},"3418":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-39","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#5-preview-then-create-the-launch","content":"A small helper makes the launch easy to follow in the next steps:"},"3419":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-40","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#6-roll-out-the-canary","content":"An empty `status` means running. Only the canary is active. The service created one WFX job for `dev-001`:"},"3420":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-41","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#7-play-the-device","content":"A real device does this by itself. These commands are what it sends to WFX, so you can drive a test device by hand. First the device asks WFX for its job:"},"3421":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-42","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#7-play-the-device","content":"The device downloads the `uri`, installs it, and reports each step:"},"3422":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-43","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#7-play-the-device","content":"The `direct` workflow is `INSTALL → INSTALLING → INSTALLED → ACTIVATE → ACTIVATING → ACTIVATED`. WFX itself makes the `INSTALLED → ACTIVATE` step. To report a failure, move a job to `TERMINATED`."},"3423":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-44","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#7-play-the-device","content":"The service hears about every change from WFX through its event stream and updates the launch. This takes a moment, so if `status` still shows the device as active, run it again after a second:"},"3424":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-45","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#8-roll-out-the-rest","content":"The canary passed. Each `rollout` call now sends the next batch of two:"},"3425":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-46","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#8-roll-out-the-rest","content":"Walk those devices through steps like in step 7, then call `rollout` again for the last device. When nothing is pending or active the launch completes by itself:"},"3426":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-47","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#8-roll-out-the-rest","content":"`completed_count` counts only successes: a failed device is counted in `failed_count`. A launch is marked `completed` once nothing is pending or active, even if some devices failed, so check `failed_count` before you call the update a success."},"3427":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-48","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#9-check-the-result","content":"To track drift, declare the version devices should be on, then read compliance:"},"3428":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-49","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#9-check-the-result","content":"The fleet-wide view of the last attempt per device and pack, including attempts outside any launch, is one call. Not run here; the brackets of a filter need `curl -g`:"},"3429":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-50","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#let-the-service-release-the-batches","content":"With `auto` on, the service sends the next batch itself once enough of the current one succeeded. `approval_threshold` is the percentage of the batch that must succeed (0 or 100 mean all of it). `error_threshold` applies to every launch, `auto` or not: the launch is cancelled once the number of failed devices reaches that percentage of **all** devices, rounded up. With 4 devices at 75%, the third failure cancels it."},"3430":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-51","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#let-the-service-release-the-batches","content":"This example uses a second pack, `valve-panel`, created and built like `water-panel` (steps 2 to 4). Artifact names are global and a name that already exists must get a higher version, so give this one its own file name:"},"3431":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-52","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#let-the-service-release-the-batches","content":"Call `rollout` once to start. A second call is refused:"},"3432":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-53","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#let-the-service-release-the-batches","content":"If one device of the first batch fails (`TERMINATED`) and the other succeeds, 50% succeeded meets the threshold and the next batch is dispatched on its own."},"3433":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-54","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#pause-resume-retry-and-cancel","content":"A pause lets the batch in flight finish and holds the next one. `retry-failed` puts the failed devices back in the pending pool and releases the next batch. That batch is drawn at random from all pending devices, so it can also contain devices that were never sent, and if more devices failed than fit in a batch only one batch goes out. It answers `400` when nothing failed, and it re-opens a completed or cancelled launch (`\"status\":\"running\"`). A failed canary pauses the launch by itself, and `resume` then sends the canary again. A cancelled launch cannot be resumed, and in-flight devices finish their current job."},"3434":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-55","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#schedule-a-launch","content":"Not run here. `scheduled_at` (RFC 3339) delays the first batch. The service checks for due launches about every 30 seconds, so the start can be up to that late. A `rollout` call before the time does nothing."},"3435":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-56","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#schedule-a-launch","content":"The schedule survives a restart and runs on whichever replica currently holds the leader role, so a scheduled launch is dispatched once even with several replicas."},"3436":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-57","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#require-a-version-before-updating","content":"Not run here. A pack can require that a device already carries another pack, or a module, at a minimum version. The rule lives on the pack you launch. Devices that fail it are left out, and the dry run lists them:"},"3437":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-58","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#require-a-version-before-updating","content":"Each failure names the `device_id`, the `distribution_set_name` (and `module_key` for a module rule), the `current_version` the device has (empty if none) and the `required` constraint, for example `>=1.0.0`. Use `required_module_key` with a `type:name` value to require a module instead. `force_preconditions: true` in the launch body deploys to every device anyway and records the failures."},"3438":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-59","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#update-one-device-to-a-version","content":"Not run here. `force-version` launches a single device to an exact pack version, outside any campaign, and answers `202`. The device must be a member of the pack's group:"},"3439":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-60","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#update-one-device-to-a-version","content":"Without `workflow`, a `swu` pack uses `phased`. Only the pack's current version can be forced, unless the pack was created with `allow_previous_version_download`."},"3440":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-61","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#a-new-version","content":"The version must be higher than the current one, and the pack keeps its id. The new version starts as `draft`. The artifact links and the module composition carry over, but the sw-description does not: upload it again. Then build with `selected_artifact_ids` (a build replaces the carried links with the ones you select), after uploading a new artifact version if the file changed."},"3441":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-62","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#encrypt-with-a-shared-key","content":"One key encrypts the `.swu` for every device. The sw-description must mark the files to encrypt with `encrypted = true;`. Use a separate pack for each encryption variant: a new version inherits the previous version's encryption settings, and a plain build does not clear them. Rebuilding an already built pack with other settings leaves stale fields too. See Limitations."},"3442":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-63","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#encrypt-with-a-shared-key","content":"This helper creates a pack, uploads a sw-description that marks its file `encrypted = true;`, and uploads the artifact. It prints the artifact id."},"3443":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-64","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#encrypt-with-a-shared-key","content":"The pack then reports `\"encryption_mode\":\"shared\"`. The device needs the same key and algorithm. See Signing and encryption."},"3444":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-65","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#encrypt-per-device","content":"Each device gets its own package and key. This is another pack, built with the same helper. The sw-description must mark a file `encrypted = true;`, or the build is refused."},"3445":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-66","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#encrypt-per-device","content":"If a device has no key at build time, the build still succeeds and the pack records the gap. If **no** device has a key, the build fails instead."},"3446":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-67","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#encrypt-per-device","content":"A launch on that pack is refused, dry runs included, and `force_preconditions` does not override it:"},"3447":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-68","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#encrypt-per-device","content":"Coverage is recorded when the pack is built, so assigning the missing key is not enough. Build the pack again (a new version) with a key for every device."},"3448":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-69","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#sign-the-package","content":"Add the KMS signing fields to the build body. They need a signing key and certificate in the Lamassu KMS, with `kms_endpoint` and `sign_script_path` set. This request was not run here, because it needs a KMS. See Signing and encryption."},"3449":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-70","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#troubleshooting","content":"Symptom"},"3450":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-71","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#troubleshooting","content":"Cause and fix"},"3451":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-72","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#troubleshooting","content":"`409` on `artifact/upload` or `artifact/link`"},"3452":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-73","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#troubleshooting","content":"The pack version is already `built`. Create a new version with `POST .../new`"},"3453":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-74","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#troubleshooting","content":"`409` on `POST .../distribution-sets`"},"3454":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-75","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#troubleshooting","content":"A pack with that name already exists in the group"},"3455":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-76","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#troubleshooting","content":"`400 version ... must be greater than the current latest version`"},"3456":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-77","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#troubleshooting","content":"An artifact name is global and its version must increase. Upload with a higher `version`"},"3457":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-78","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#troubleshooting","content":"The build fails with an empty binaries directory"},"3458":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-79","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#troubleshooting","content":"The build received no `selected_artifact_ids`"},"3459":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-80","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#troubleshooting","content":"`400` creating a launch: pack has not been built"},"3460":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-81","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#troubleshooting","content":"Build it first. A pack in `build_failed` is not launchable either"},"3461":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-82","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#troubleshooting","content":"`400 ... is per-device encrypted and only N of M devices have a package`"},"3462":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-83","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#troubleshooting","content":"Some devices have no `firmware-encryption` key. Assign keys and build a new version"},"3463":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-84","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#troubleshooting","content":"`rollout` answers `400` with `rolls out automatically`"},"3464":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-85","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#troubleshooting","content":"The launch has `auto` on and already started. Wait for the approval threshold, or pause it"},"3465":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-86","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#troubleshooting","content":"`rollout` answers `400` with `test device ... failed`"},"3466":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-87","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#troubleshooting","content":"The canary failed. Resume the launch to retry it, or cancel"},"3467":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-88","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#troubleshooting","content":"`413` on an upload"},"3468":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-89","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#troubleshooting","content":"The file is over `max_artifact_size_mb` (10 GiB by default), or the gateway or ingress limit in front of the service is lower"},"3469":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-90","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#troubleshooting","content":"`501` on a module route"},"3470":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-91","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#troubleshooting","content":"Native mode has no per-module deliverables. Build the pack instead"},"3471":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-92","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#next-steps","content":"Update flow with curl, hawkBit backend"},"3472":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-93","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#next-steps","content":"Connect a device for what a real device must implement"},"3473":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-94","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#next-steps","content":"API reference"},"3474":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl-95","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#next-steps","content":"Troubleshooting"},"3475":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","type":"page","content":"Publish and roll out an update","breadcrumbs":["Docs","Platform","[Enterprise] Updates","Guides"],"tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out"},"3476":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-0","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","content":"Create an update pack, attach an artifact, build the deliverable and roll it out to a device group in batches."},"3477":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-1","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#before-you-begin","content":"Before you begin"},"3478":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-2","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#1-create-the-pack","content":"1\\. Create the pack"},"3479":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-3","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#2-upload-the-sw-description-and-the-artifact","content":"2\\. Upload the sw-description and the artifact"},"3480":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-4","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#compose-a-pack-from-several-modules-optional","content":"Compose a pack from several modules (optional)"},"3481":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-5","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#3-build-the-deliverable","content":"3\\. Build the deliverable"},"3482":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-6","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#4-create-the-launch","content":"4\\. Create the launch"},"3483":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-7","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#5-roll-it-out","content":"5\\. Roll it out"},"3484":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-8","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#verify-the-result","content":"Verify the result"},"3485":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-9","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#ship-the-next-version","content":"Ship the next version"},"3486":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-10","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#hawkbit-mode","content":"hawkBit mode"},"3487":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-11","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#troubleshooting","content":"Troubleshooting"},"3488":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-12","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#next-steps","content":"Next steps"},"3489":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-13","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","content":"This guide takes one update from nothing to devices: create an update pack, attach an artifact and a `sw-description`, build the deliverable, create a launch (a campaign in the dashboard) and release it batch by batch. The requests use native mode. hawkBit mode builds and creates packs in a different order, described in hawkBit mode. To do the same through screens, follow Use the dashboard."},"3490":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-14","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#before-you-begin","content":"The stack is running and `curl localhost:10090/health` answers."},"3491":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-15","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#before-you-begin","content":"A Lamassu IoT device group that contains the devices you want to update. Its ID is `$GROUP`. A pack belongs to one group and can only be launched to that group's devices."},"3492":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-16","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#before-you-begin","content":"The binary to deliver and, for an SWU pack, a `sw-description` file."},"3493":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-17","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#before-you-begin","content":"Devices that can receive the update. See Connect a device."},"3494":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-18","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#before-you-begin","content":"The service has no built-in authentication, so these examples send none. Put a gateway that authenticates callers in front of it: see Security."},"3495":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-19","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#1-create-the-pack","content":"The response is `201` with the pack, including its `id`. A pack starts as `draft`."},"3496":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-20","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#1-create-the-pack","content":"Field"},"3497":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-21","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#1-create-the-pack","content":"Notes"},"3498":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-22","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#1-create-the-pack","content":"`name`"},"3499":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-23","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#1-create-the-pack","content":"Required. Unique within the group; a duplicate answers `409`. Native mode uses it as a path segment, so it may contain only letters, digits, `.`, `_` and `-` (no spaces)"},"3500":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-24","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#1-create-the-pack","content":"`version`"},"3501":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-25","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#1-create-the-pack","content":"Required. Strict semver `x.y.z`, set by you"},"3502":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-26","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#1-create-the-pack","content":"`group_id`"},"3503":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-27","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#1-create-the-pack","content":"Required in the body. Use the same value as in the path"},"3504":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-28","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#1-create-the-pack","content":"`type`"},"3505":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-29","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#1-create-the-pack","content":"`rawfile` or `firmware`. Recorded on the pack and sent to the device in the job; the dashboard also offers `both` and `other`. Not validated at creation"},"3506":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-30","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#1-create-the-pack","content":"`packaging`"},"3507":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-31","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#1-create-the-pack","content":"`swu` (default) or `non-swu`. A `non-swu` pack delivers its files as a `.tar.gz` and uses the `download-install` workflow"},"3508":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-32","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#1-create-the-pack","content":"`allow_previous_version_download`"},"3509":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-33","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#1-create-the-pack","content":"Optional. Lets devices download older versions of the pack"},"3510":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-34","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#1-create-the-pack","content":"`preconditions`"},"3511":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-35","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#1-create-the-pack","content":"Optional rules a device must meet to receive the pack. See Concepts"},"3512":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-36","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#1-create-the-pack","content":"`modules`"},"3513":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-37","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#1-create-the-pack","content":"**hawkBit mode only**: the pack's composition, as built catalog modules. Native ignores it"},"3514":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-38","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#2-upload-the-sw-description-and-the-artifact","content":"The `sw-description` is an SWUpdate file that lists what the device installs. Its format is SWUpdate's, and the SWUpdate documentation is the reference. When the service builds the `.swu`, `swugenerator` reads this file and the staged binaries, so the `filename` of every image must be the name of an uploaded file. A minimal one:"},"3515":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-39","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#2-upload-the-sw-description-and-the-artifact","content":"`swugenerator` fills in the final `filename` (with `.zlib` added, and `.enc` for encrypted files), the `sha256` and, for encrypted files, the `ivt` property. For an encrypted build, add `encrypted = true;` to each image that must be encrypted. Two rules cause most failures:"},"3516":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-40","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#2-upload-the-sw-description-and-the-artifact","content":"`encrypted = true` must appear only in a build that supplies a key (the build fails without one), and a per-device build refuses a description in which no image has it."},"3517":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-41","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#2-upload-the-sw-description-and-the-artifact","content":"Compressed images need `decompressed-size`."},"3518":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-42","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#2-upload-the-sw-description-and-the-artifact","content":"If you build the `.swu` yourself and upload it as a prebuilt deliverable, you fill in `sha256` and `ivt` yourself, and the `sha256` is over the bytes the device downloads, because SWUpdate hashes before it decrypts."},"3519":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-43","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#2-upload-the-sw-description-and-the-artifact","content":"`artifact_name` defaults to the file name without its extension. `version` is optional; when you upload a new file under an existing `artifact_name` it must be strictly higher than the highest version already stored under that name."},"3520":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-44","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#2-upload-the-sw-description-and-the-artifact","content":"The artifact is stored as a global artifact and linked to this pack. The response contains its `id`. To reuse an artifact that is already uploaded, link it with `POST .../artifact/link` and `{\"artifact_id\":\"<id>\"}`."},"3521":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-45","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#2-upload-the-sw-description-and-the-artifact","content":"The largest accepted file is `max_artifact_size_mb` (10 GiB by default). A bigger upload answers `413`."},"3522":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-46","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#2-upload-the-sw-description-and-the-artifact","content":"Once the pack is built, uploads and links answer `409`: create a new version first."},"3523":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-47","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#compose-a-pack-from-several-modules-optional","content":"A native pack is a composition of software modules: one `os` module plus any number of `application` modules. A pack with no declared modules behaves as a single implicit `os` module that owns the artifacts you uploaded above. To add an application module and give it its own files:"},"3524":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-48","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#compose-a-pack-from-several-modules-optional","content":"The module key is `<type>:<name>`. Native still builds one `.swu` for the whole pack, from every module's artifacts and the pack's single `sw-description`. You can also compose from a module that already exists with `POST .../modules/import`; in native mode that copies the module, while in hawkBit mode it links the same module. See Concepts for the model."},"3525":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-49","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#3-build-the-deliverable","content":"`selected_artifact_ids` is what puts artifacts into the build: only the listed artifacts are staged. With an empty list the build fails because no binaries were staged, and the pack becomes `build_failed`. Take the ID from the artifact upload response, or from `GET $API/artifacts`."},"3526":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-50","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#3-build-the-deliverable","content":"The body above builds an unencrypted, unsigned `.swu`. To sign or encrypt, add fields as described in Signing and encryption."},"3527":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-51","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#3-build-the-deliverable","content":"For a `non-swu` pack, call `POST .../package` instead of `.../swu`. With no `selected_artifact_ids` it packages the artifacts linked to the pack."},"3528":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-52","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#3-build-the-deliverable","content":"To deliver a file you built elsewhere, upload it to `POST .../swu/upload` (or `.../package/upload`) as a multipart `file`. It is stored and served unchanged, so it must already be signed and encrypted the way your devices expect. Native mode only."},"3529":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-53","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#3-build-the-deliverable","content":"When the build succeeds, the pack becomes `built` and its artifacts and composition are immutable. If it fails, the pack becomes `build_failed` and `last_build_error` holds the reason: fix the input and build again. A build that runs while another one holds the same pack answers `409`."},"3530":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-54","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#4-create-the-launch","content":"The launch targets every device of the group at the moment you create it, and it needs a built pack. The response is `201` with `launch_id`, `precondition_failures`, `forced`, and, in hawkBit mode, `superseded_devices` and `never_seen_devices`."},"3531":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-55","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#4-create-the-launch","content":"Field"},"3532":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-56","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#4-create-the-launch","content":"Notes"},"3533":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-57","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#4-create-the-launch","content":"`distribution_set_name`, `workflow_type`, `rollout_type`, `rollout_value`"},"3534":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-58","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#4-create-the-launch","content":"Required. `rollout_value` must be greater than 0"},"3535":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-59","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#4-create-the-launch","content":"`rollout_type`"},"3536":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-60","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#4-create-the-launch","content":"`percentage` of the group per batch, or `fixed` (a device count). Any value other than `percentage` is read as a count"},"3537":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-61","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#4-create-the-launch","content":"`workflow_type`"},"3538":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-62","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#4-create-the-launch","content":"Native: `direct`, `phased`, `download-install`, or the full name of another workflow registered in WFX (`GET $API/workflows`). hawkBit: `phased` creates a soft action, anything else a forced one"},"3539":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-63","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#4-create-the-launch","content":"`test_device_id`"},"3540":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-64","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#4-create-the-launch","content":"Optional canary: a member of the group that is updated first and must succeed before any other device is touched"},"3541":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-65","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#4-create-the-launch","content":"`auto`, `approval_threshold`, `error_threshold`"},"3542":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-66","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#4-create-the-launch","content":"Optional. `auto` releases later batches by itself. Both thresholds are percentages from 0 to 100"},"3543":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-67","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#4-create-the-launch","content":"`scheduled_at`"},"3544":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-68","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#4-create-the-launch","content":"Optional RFC 3339 time. The first batch is delayed until then"},"3545":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-69","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#4-create-the-launch","content":"`name`, `description`, `weight`"},"3546":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-70","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#4-create-the-launch","content":"Optional. `name` defaults to the pack's name. `weight` (0 to 1000) is stored but nothing reads it"},"3547":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-71","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#4-create-the-launch","content":"`force_preconditions`"},"3548":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-72","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#4-create-the-launch","content":"Deploy to devices that fail the pack's preconditions anyway. The failures are still recorded"},"3549":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-73","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#4-create-the-launch","content":"Choose the workflow to match the pack:"},"3550":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-74","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#4-create-the-launch","content":"Use `direct` for SWU packs unless you drive WFX yourself. The `phased` workflow has steps that WFX or an operator must confirm, and this service does not advance them. A `phased` launch stays at its first state until someone confirms it through WFX."},"3551":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-75","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#4-create-the-launch","content":"For a `non-swu` pack set `workflow_type` to `download-install`. The launch uses the value you give verbatim, so `direct` would run the SWU workflow and the update would look stuck after the device finished."},"3552":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-76","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#4-create-the-launch","content":"In hawkBit mode there is no WFX. The choice is hawkBit's install mode."},"3553":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-77","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#4-create-the-launch","content":"If the pack has preconditions, preview who qualifies before creating anything by adding `?dry_run=true` to the same request. It answers `200` with `qualifying_devices`, `precondition_failures`, `superseded_devices` and `never_seen_devices`, and creates nothing."},"3554":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-78","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#4-create-the-launch","content":"**Approval and error thresholds.** With `auto: true`, the next batch is released once at least `approval_threshold` percent of the current batch has succeeded (0 means the whole batch). In native mode the campaign is cancelled when `error_threshold` percent of all its devices have failed; in hawkBit mode it stops when more than that percentage of a batch fails. A failed canary pauses a native campaign instead: resume it to retry the canary."},"3555":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-79","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#4-create-the-launch","content":"Take the launch ID from the response. It is `$LAUNCH` below."},"3556":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-80","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#5-roll-it-out","content":"Without `auto`, each call dispatches the next batch (the canary first, if you set one). With `auto: true`, call it once to start the first batch: the service then releases the later batches itself as the approval threshold is met, and further calls answer `400`. If the launch has a future `scheduled_at`, the call is accepted but does nothing: the service starts it by itself at that time (native checks every 30 seconds; hawkBit's own scheduler starts the rollout)."},"3557":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-81","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#5-roll-it-out","content":"A native launch moves through these statuses:"},"3558":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-82","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#5-roll-it-out","content":"You can steer a launch while it runs:"},"3559":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-83","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#5-roll-it-out","content":"Action"},"3560":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-84","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#5-roll-it-out","content":"Request"},"3561":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-85","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#5-roll-it-out","content":"Effect"},"3562":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-86","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#5-roll-it-out","content":"Pause"},"3563":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-87","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#5-roll-it-out","content":"`POST $API/groups/$GROUP/launch/$LAUNCH/pause`"},"3564":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-88","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#5-roll-it-out","content":"No further batches until resumed. Devices already in flight finish"},"3565":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-89","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#5-roll-it-out","content":"Resume"},"3566":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-90","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#5-roll-it-out","content":"`POST .../resume`"},"3567":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-91","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#5-roll-it-out","content":"Native: an automatic campaign releases its next batch at once if the current one already met the threshold, and resuming after a failed canary retries it"},"3568":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-92","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#5-roll-it-out","content":"Retry failed devices"},"3569":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-93","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#5-roll-it-out","content":"`POST .../retry-failed`"},"3570":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-94","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#5-roll-it-out","content":"Re-queues the failed devices and dispatches them. Answers `400` when there is none"},"3571":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-95","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#5-roll-it-out","content":"Cancel (terminal)"},"3572":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-96","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#5-roll-it-out","content":"`POST .../cancel`"},"3573":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-97","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#5-roll-it-out","content":"Pending devices are not updated"},"3574":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-98","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#5-roll-it-out","content":"Mark complete (terminal)"},"3575":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-99","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#5-roll-it-out","content":"`POST .../complete`"},"3576":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-100","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#5-roll-it-out","content":"Not available in hawkBit mode"},"3577":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-101","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#5-roll-it-out","content":"Read or change the strategy"},"3578":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-102","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#5-roll-it-out","content":"`GET`, `PUT .../strategy`"},"3579":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-103","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#5-roll-it-out","content":"Changing it is not available in hawkBit mode"},"3580":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-104","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#5-roll-it-out","content":"In hawkBit mode a rollout can only be paused after it has started dispatching."},"3581":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-105","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#verify-the-result","content":"The launch list answers `{\"list\":[...],\"next\":\"...\"}`. A launch is done when `pending_count` and `active_count` are zero; a native launch then sets its `status` to `completed` by itself. Devices end as `completed` (job state `ACTIVATED`, or `INSTALLED` for `non-swu`) or `failed` (`TERMINATED`)."},"3582":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-106","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#ship-the-next-version","content":"A built pack version is immutable. To change it, create the next version, upload what changed and build again:"},"3583":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-107","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#ship-the-next-version","content":"The version must be strictly higher than the current one. The new version starts unbuilt and carries the current artifacts forward."},"3584":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-108","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#ship-the-next-version","content":"To update one device to an exact version without a campaign, use `POST $API/devices/<device-id>/force-version` with `{\"distribution_set_id\":\"<pack id>\",\"version\":\"1.1.0\"}`; in native mode it creates a one-device launch and defaults to the `phased` workflow for SWU packs (`download-install` for `non-swu`) unless you pass a `workflow`."},"3585":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-109","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#hawkbit-mode","content":"hawkBit packs are assembled from built catalog modules, so the pack-side steps 2 and 3 move to the catalog:"},"3586":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-110","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#hawkbit-mode","content":"Create the module: `POST $API/softwaremodules` with `type` (`os` or `application`), `name`, `version` and a `delivery_intent`: `swu-build`, `swu-prebuilt` or `raw`. `undecided` is accepted, but a module cannot join a pack until you choose."},"3587":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-111","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#hawkbit-mode","content":"Upload the file with `POST $API/softwaremodules/by-id/<id>/artifacts`. For `swu-build`, also upload the `sw-description` to `.../descriptor` and call `POST $API/softwaremodules/by-id/<id>/build`. For `swu-prebuilt`, uploading the `.swu` is the build. For `raw`, call `.../build` to make the files the deliverable; signing and encryption are optional."},"3588":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-112","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#hawkbit-mode","content":"Create the pack with `\"modules\":[{\"source_module_id\":\"<id>\"}]`. It is created already built."},"3589":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-113","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#hawkbit-mode","content":"Then continue at step 4. Details, including the delivery intents, are in hawkBit mode, and a full request sequence is in hawkBit curl guide."},"3590":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-114","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#troubleshooting","content":"Symptom"},"3591":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-115","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#troubleshooting","content":"Likely cause"},"3592":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-116","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#troubleshooting","content":"A call returns `501 Not Implemented`"},"3593":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-117","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#troubleshooting","content":"The active backend does not support it. Check Capabilities"},"3594":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-118","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#troubleshooting","content":"`400` \"has not been built yet\" when creating a launch"},"3595":{"id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out-119","page_id":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#troubleshooting","content":"