nment"},"2705":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-33","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#update-packs","content":"A pack has a **version** (semantic, `x.y.z`) and a **status**:"},"2706":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-34","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#update-packs","content":"Status"},"2707":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-35","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#update-packs","content":"Meaning"},"2708":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-36","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#update-packs","content":"`draft`"},"2709":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-37","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#update-packs","content":"Editable. Artifacts can be added or replaced. Not built yet."},"2710":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-38","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#update-packs","content":"`built`"},"2711":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-39","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#update-packs","content":"The deliverable exists. The version is immutable. Create a new version to change it."},"2712":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-40","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#update-packs","content":"`build_failed`"},"2713":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-41","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#update-packs","content":"A build was attempted and failed. Still editable and retryable. The reason is in `last_build_error`."},"2714":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-42","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#update-packs","content":"A pack has one **packaging**:"},"2715":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-43","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#update-packs","content":"Packaging"},"2716":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-44","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#update-packs","content":"Delivered as"},"2717":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-45","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#update-packs","content":"Workflow terminal state"},"2718":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-46","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#update-packs","content":"`swu`"},"2719":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-47","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#update-packs","content":"A `.swu` built with swugenerator, optionally signed and encrypted"},"2720":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-48","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#update-packs","content":"`ACTIVATED`"},"2721":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-49","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#update-packs","content":"`non-swu`"},"2722":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-50","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#update-packs","content":"The raw artifacts. Native mode builds a `.tar.gz` package (optionally encrypted, `.tar.gz.enc`). hawkBit mode delivers a `raw` module's single file as uploaded (optionally encrypted), and archives several files as `<name>.tar.gz`"},"2723":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-51","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#update-packs","content":"`INSTALLED`"},"2724":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-52","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#update-packs","content":"A pack can also carry **preconditions**: rules such as \"the device must already have pack X at version 1.2.0 or higher\", or \"the module `os:gateway-fw` at version 2.1.0 or higher\". Each precondition names exactly one pack (`required_distribution_set_name`) or one module (`required_module_key`) and a semantic `min_version`. A device that fails a precondition is not deployable, unless an operator forces the launch. Each launch records which devices failed and why."},"2725":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-53","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#software-modules","content":"A pack is a composition of modules. A pack holds one `os` module (the mandatory anchor) and any number of `application` modules. In native mode a pack without module rows is shown with one implicit module `os:<pack name>`, and the files you upload to the pack belong to it. A module holds its own files and, optionally, release notes. You can:"},"2726":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-54","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#software-modules","content":"create a module on its own in the **catalog** (`POST /updates/v1/softwaremodules`) and compose packs from it later,"},"2727":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-55","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#software-modules","content":"add a module to a pack directly, or"},"2728":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-56","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#software-modules","content":"import a module that another pack already has."},"2729":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-57","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#software-modules","content":"A module's **delivery intent** says how it will ship: `undecided` (default), `swu-build`, `swu-prebuilt` or `raw`."},"2730":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-58","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#software-modules","content":"How modules relate to the build differs by backend:"},"2731":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-59","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#software-modules","content":"**native**: modules are *build inputs*. The pack builds one `.swu` from all of them, and a launch sends each device a single download address."},"2732":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-60","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#software-modules","content":"**hawkbit**: each module has its *own deliverable*, built in the module catalog before the pack exists. Only built modules can be linked into a pack, and a linked module is frozen. hawkBit hands every module's artifacts to the device, so a pack with several modules installs as several independent SWUpdate transactions. SWUpdate cannot roll back across several `.swu` files."},"2733":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-61","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#software-modules","content":"Importing a module also differs. In hawkBit mode the import **links** it, so both packs share the module and a rebuild is seen by both. In native mode it **copies** it, so the two diverge afterwards. The listing of reusable modules tells you which one you will get (`shared`)."},"2734":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-62","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#launch-campaigns","content":"A launch rolls one pack version out to a group's devices in **batches**."},"2735":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-63","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#strategy","content":"Field"},"2736":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-64","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#strategy","content":"Meaning"},"2737":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-65","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#strategy","content":"`rollout_type`"},"2738":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-66","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#strategy","content":"How a batch is sized. Only `percentage` makes `rollout_value` a percentage. Any other value (`fixed`, or `numeric`, which the dashboard sends) makes it a device count"},"2739":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-67","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#strategy","content":"`rollout_value`"},"2740":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-68","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#strategy","content":"The percentage, or the device count. Must be greater than 0"},"2741":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-69","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#strategy","content":"`workflow_type`"},"2742":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-70","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#strategy","content":"The WFX workflow: `direct` (no confirmation), `phased` (confirmation steps) or `download-install`. Use `download-install` for `non-swu` packs. Any other value is passed to WFX as a full workflow name, such as `wfx.workflow.dau.simple`. In hawkBit mode there is no WFX: `phased` becomes a hawkBit soft action (the device confirms or postpones) and every other value a forced action"},"2743":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-71","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#strategy","content":"`test_device_id`"},"2744":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-72","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#strategy","content":"A canary. The first batch is this one device, and it must succeed before anyone else is touched"},"2745":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-73","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#strategy","content":"`auto`"},"2746":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-74","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#strategy","content":"Release the next batch automatically when conditions are met"},"2747":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-75","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#strategy","content":"`approval_threshold`"},"2748":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-76","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#strategy","content":"% of the current batch that must succeed before the next batch starts (0 to 100). Unset, 0 or 100 means the whole batch"},"2749":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-77","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#strategy","content":"`error_threshold`"},"2750":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-78","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#strategy","content":"The launch is cancelled once this % of all devices have failed (rounded up, so 10% of 100 devices cancels at the 10th failure). `0` means no limit"},"2751":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-79","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#strategy","content":"`scheduled_at`"},"2752":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-80","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#strategy","content":"Planned start time (RFC 3339). Native mode starts the first batch when it passes (polled every 30 seconds); hawkBit mode hands it to hawkBit as the rollout's start time"},"2753":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-81","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#strategy","content":"`name`, `description`"},"2754":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-82","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#strategy","content":"Display name (defaults to the pack name) and free-text notes"},"2755":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-83","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#strategy","content":"`weight`"},"2756":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-84","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#strategy","content":"A stored priority hint, 0 to 1000. Nothing reads it"},"2757":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-85","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#lifecycle","content":"A launch is `running`, `paused` (resumable), `cancelled` (terminal) or `completed` (terminal). A device inside it goes `pending` → `active` → `completed` or `failed`. You can retry only the failed devices (`retry-failed`). In native mode this also reopens a finished or cancelled launch. The operator controls are `rollout`, `pause`, `resume`, `cancel`, `complete` and `retry-failed`, and the strategy can be edited while the launch exists. Native mode supports all of them. hawkBit mode has no `complete` and no strategy edit, because a rollout's groups and thresholds are fixed at creation (see Capabilities)."},"2758":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-86","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#versions-compliance-and-inventory","content":"Beyond one-off launches you can declare the **latest version** of a pack for a group. The service then reports **drift**: devices that are not on the latest version. You can force one device to the latest version, or to an exact one. See the API reference."},"2759":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-87","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#versions-compliance-and-inventory","content":"The service also keeps a **device inventory**: which pack version each device carries now, with the artifacts that version's manifest declares, and the history of update attempts. Both are filled as the service's launches run."},"2760":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-88","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#how-an-update-reaches-a-device-native-mode","content":"The device-side state machine is a WFX workflow, in `wfx/workflow/dau/` of the repository:"},"2761":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-89","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#how-an-update-reaches-a-device-native-mode","content":"Workflow file"},"2762":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-90","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#how-an-update-reaches-a-device-native-mode","content":"States"},"2763":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-91","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#how-an-update-reaches-a-device-native-mode","content":"Use"},"2764":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-92","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#how-an-update-reaches-a-device-native-mode","content":"`wfx.workflow.dau.direct.yml`"},"2765":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-93","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#how-an-update-reaches-a-device-native-mode","content":"INSTALL → INSTALLING → INSTALLED → ACTIVATE → ACTIVATING → ACTIVATED"},"2766":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-94","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#how-an-update-reaches-a-device-native-mode","content":"SWU packs, no confirmation"},"2767":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-95","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#how-an-update-reaches-a-device-native-mode","content":"`wfx.workflow.dau.phased.yml`"},"2768":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-96","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#how-an-update-reaches-a-device-native-mode","content":"CREATED → DOWNLOAD → … → ACTIVATED"},"2769":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-97","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#how-an-update-reaches-a-device-native-mode","content":"SWU packs, with confirmation steps"},"2770":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-98","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#how-an-update-reaches-a-device-native-mode","content":"`wfx.workflow.dau.download-install.yml`"},"2771":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-99","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#how-an-update-reaches-a-device-native-mode","content":"DOWNLOAD → DOWNLOADING → DOWNLOADED → INSTALL → INSTALLING → INSTALLED"},"2772":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-100","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#how-an-update-reaches-a-device-native-mode","content":"`non-swu` packs. Select it with `workflow_type`: a launch does not choose it for you"},"2773":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-101","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#how-an-update-reaches-a-device-native-mode","content":"`wfx.workflow.dau.simple.yml`"},"2774":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-102","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#how-an-update-reaches-a-device-native-mode","content":"DOWNLOAD → INSTALL → INSTALLED or TERMINATED"},"2775":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-103","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#how-an-update-reaches-a-device-native-mode","content":"Minimal flow"},"2776":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-104","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#how-an-update-reaches-a-device-native-mode","content":"Every workflow ends in `TERMINATED` on failure. The service registers the four files at startup. `workflow_file` must name the `direct` file, and the other three are looked up next to it by replacing `direct` in the file name (see Configuration). In hawkBit mode there are no WFX jobs: see hawkBit mode."},"2777":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-105","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#next-steps","content":"<Card