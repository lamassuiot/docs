c"},"4043":{"id":"/docs/pr-preview/pr-56/platform/updates/reference/api-32","page_id":"/docs/pr-preview/pr-56/platform/updates/reference/api","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/reference/api#conventions","content":"Behaviour"},"4044":{"id":"/docs/pr-preview/pr-56/platform/updates/reference/api-33","page_id":"/docs/pr-preview/pr-56/platform/updates/reference/api","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/reference/api#conventions","content":"Bodies"},"4045":{"id":"/docs/pr-preview/pr-56/platform/updates/reference/api-34","page_id":"/docs/pr-preview/pr-56/platform/updates/reference/api","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/reference/api#conventions","content":"JSON, except uploads, which are `multipart/form-data` with the file in the field `file`"},"4046":{"id":"/docs/pr-preview/pr-56/platform/updates/reference/api-35","page_id":"/docs/pr-preview/pr-56/platform/updates/reference/api","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/reference/api#conventions","content":"Errors"},"4047":{"id":"/docs/pr-preview/pr-56/platform/updates/reference/api-36","page_id":"/docs/pr-preview/pr-56/platform/updates/reference/api","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/reference/api#conventions","content":"The body is `{\"err\":\"<message>\"}`"},"4048":{"id":"/docs/pr-preview/pr-56/platform/updates/reference/api-37","page_id":"/docs/pr-preview/pr-56/platform/updates/reference/api","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/reference/api#conventions","content":"Health"},"4049":{"id":"/docs/pr-preview/pr-56/platform/updates/reference/api-38","page_id":"/docs/pr-preview/pr-56/platform/updates/reference/api","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/reference/api#conventions","content":"`GET /health` returns `{\"status\":\"ok\"}`, outside `/updates/v1`"},"4050":{"id":"/docs/pr-previe