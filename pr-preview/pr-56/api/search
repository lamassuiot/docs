es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#breaking-changes","content":"Enviar el ID en la URL"},"5696":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-129","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#breaking-changes","content":"Valores de tipo de certificado"},"5697":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-130","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#breaking-changes","content":"Consumidores que comparan el `type` del certificado"},"5698":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-131","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#breaking-changes","content":"Baja: dos valores cambian de nombre"},"5699":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-132","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#breaking-changes","content":"Adaptar los consumidores"},"5700":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-133","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#breaking-changes","content":"Autenticación de reenrolamiento independiente"},"5701":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-134","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#breaking-changes","content":"Cualquier DMS"},"5702":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-135","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#breaking-changes","content":"Baja: solo informativo"},"5703":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-136","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#breaking-changes","content":"Revisar ambos bloques antes de editar"},"5704":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-137","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","content":"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos."},"5705":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-138","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","content":"El paso 4 de la guía de migración copia los datos."},"5706":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-139","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","content":"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios."},"5707":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-140","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","content":"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI."},"5708":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-141","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","content":"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia."},"5709":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-142","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","content":"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod."},"5710":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-143","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","content":"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad."},"5711":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-144","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","content":"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker."},"5712":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-145","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","content":"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest."},"5713":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-146","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","content":"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista."},"5714":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-147","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","content":"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root."},"5715":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-148","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","content":"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`."},"5716":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-149","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","content":"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer."},"5717":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-150","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","content":"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`."},"5718":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-151","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","content":"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm)."},"5719":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-152","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","content":"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:"},"5720":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-153","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","content":"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos."},"5721":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-154","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","content":"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`."},"5722":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-155","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","content":"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen."},"5723":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-156","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","content":"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar."},"5724":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-157","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","content":"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:"},"5725":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-158","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","content":"El `key_id` es el `subject_key_id` del certificado (SHA-256 de la clave pública)."},"5726":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-159","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","content":"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces."},"5727":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-160","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","content":"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados."},"5728":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-161","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","content":"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla."},"5729":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-162","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","content":"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano."},"5730":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-163","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","content":"Una vez registradas las claves heredadas, arrancar el KMS con la opción de configuración del backend `crypto_engines.migrate_keys_format` renombra las claves cuyo nombre no es el digest SHA-256 de la clave pública, conserva el nombre antiguo como alias y traslada consigo las referencias de certificados. Es seguro volver a ejecutarla y puede desactivarse después."},"5731":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-164","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#referencias-entre-certificados-claves-y-roles-va","content":"Los certificados referencian ahora su clave del KMS, y los roles VA referencian su certificado firmante, de modo que no se puede eliminar una clave o un certificado en uso. La migración del KMS descarta los metadatos de clave heredados `lamassu.io/kms/binded-resources`. Antes de 4.0.0, eliminar una CA podía borrar su clave y dejar referencias a ella en los registros de certificado conservados. La migración de CA registra esas claves ausentes en el KMS solo con su clave pública para satisfacer las referencias conservadas. Estas entradas no pueden eliminarse mientras los certificados conservados las referencien; no recuperan la clave privada. En 4.0.0, eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados antes de intentar eliminar la clave; los demás certificados que todavía la referencien impiden su eliminación."},"5732":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-165","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","content":"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:"},"5733":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-166","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","content":"Campo en 3.8.0"},"5734":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-167","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","content":"Campo en 4.0.0"},"5735":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-168","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","content":"`validate_server_cert`"},"5736":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-169","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","content":"`insecure_skip_verify` (con el valor negado)"},"5737":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-170","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","content":"`oidc`"},"5738":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-171","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","content":"`jwt_options`"},"5739":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-172","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","content":"`apikey`"},"5740":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-173","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","content":"`apikey_options`"},"5741":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-174","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","content":"`mtls`"},"5742":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-175","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","content":"`mtls_options`"},"5743":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-176","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","content":"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren."},"5744":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-177","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","content":"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM."},"5745":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-178","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","content":"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada."},"5746":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-179","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","content":"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:"},"5747":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-180","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","content":"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía."},"5748":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-181","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","content":"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API."},"5749":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-182","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","content":"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. La consola expone editores independientes para ambos bloques; la guía de DMS describe sus campos, y también puedes editarlos mediante la API DMS."},"5750":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-183","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","content":"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él."},"5751":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-184","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","content":"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores."},"5752":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-185","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","content":"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:"},"5753":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-186","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","content":"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo."},"5754":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-187","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","content":"`POST /v1/devices/:id/events` crea un evento."},"5755":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-188","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","content":"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza."},"5756":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-189","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#campo-firmante-del-rol-va","content":"`crl_options.subject_key_id_signer` se sustituye por el obligatorio `crl_options.signer_certificate_serial_number`, el número de serie del certificado existente que firma la CRL. El valor inicial de un rol nuevo es el número de serie del certificado actual de la CA. Las peticiones que aún contienen `subject_key_id_signer` devuelven un error. Las políticas de autorización personalizadas que filtran por el campo antiguo deben actualizarse: el filtro `crl_subject_key_id_signer` se renombra a `crl_signer_certificate_serial_number` y toma valores de número de serie."},"5757":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-190","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","content":"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm."},"5758":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-191","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","content":"Haz una copia de seguridad verificable de PostgreSQL y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`."},"5759":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-192","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","content":"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL."},"5760":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-193","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","content":"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL."},"5761":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-194","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","content":"Anota los nombres de tus PVC de almacenamiento local:"},"5762":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-195","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","content":"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde."},"5763":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-196","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","content":"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:"},"5764":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-197","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","content":"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio."},"5765":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-198","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","content":"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se lee el campo `database` de cada entrada; la conexión usa siempre los values globales `postgres.hostname`, `postgres.port`, `postgres.username` y `postgres.password`."},"5766":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-199","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","content":"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos."},"5767":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-200","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","content":"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:"},"5768":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-201","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","content":"**Renombra `toolbox` a `connectivityTest`:**"},"5769":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-202","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","content":"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`."},"5770":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-203","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","content":"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:"},"5771":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-204","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","content":"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano."},"5772":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-205","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","content":"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:"},"5773":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-206","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","content":"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno."},"5774":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-207","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","content":"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida."},"5775":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-208","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","content":"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar."},"5776":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-209","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","content":"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos."},"5777":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-210","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","content":"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`."},"5778":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-211","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","content":"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:"},"5779":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-212","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","content":"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes."},"5780":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-213","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","content":"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:"},"5781":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-214","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","content":"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:"},"5782":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-215","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","content":"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:"},"5783":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-216","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","content":"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido."},"5784":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-217","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","content":"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:"},"5785":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-218","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","content":"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen."},"5786":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-219","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","content":"**Elimina el auxiliar y restaura el número de réplicas anotado:**"},"5787":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-220","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","content":"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`."},"5788":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-221","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","content":"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`."},"5789":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-222","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","content":"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes."},"5790":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-223","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","content":"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada."},"5791":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-224","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","content":"Ejecuta las migraciones en el orden obligatorio, un esquema cada vez: primero `kms`, después la herramienta `ca-to-kms-migration` (necesaria solo en despliegues heredados cuyas claves de CA se nombran por SKI), luego `ca` y por último `va`. Los esquemas `devicemanager`, `dmsmanager` y `alerts` son independientes y pueden migrarse en cualquier orden. Con Helm, el job de preinstalación del chart aplica los esquemas en el orden correcto automáticamente."},"5792":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-225","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","content":"Los esquemas se referencian entre sí, así que el rol de PostgreSQL que ejecuta las migraciones necesita privilegios entre esquemas: el esquema `ca` necesita `USAGE` sobre `kms` más `SELECT`, `REFERENCES` e `INSERT` sobre `kms.kms_keys`, y el esquema `va` necesita `USAGE` sobre `ca` más `SELECT` y `REFERENCES` sobre `ca.certificates` y `SELECT` sobre `ca.ca_certificates`. Si tus servicios se conectan con un usuario distinto del que ejecutó las migraciones, concédele tras las migraciones `SELECT` sobre `ca.certificates_view`."},"5793":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-226","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","content":"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:"},"5794":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-227","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","content":"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:"},"5795":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-228","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","content":"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`."},"5796":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-229","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","content":"Los README de ambas herramientas documentan el formato de 4.0.0 con la base `pki` y coinciden con esta página: `goose-lamassu` usa ejemplos con `dbname=pki` y no valida el nombre de la base de datos, y el README de `ca-to-kms-migration` describe la base única `pki` y el orden de migración."},"5797":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-230","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas","content":"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC."},"5798":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-231","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas","content":"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más."},"5799":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-232","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas","content":"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait."},"5800":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-233","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas","content":"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce."},"5801":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-234","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas","content":"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó por IDs de CA duplicados o por valores de `engine_id` vacíos. Revisa los logs del job, corrige los permisos o los datos y vuelve a ejecutar la actualización."},"5802":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-235","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas","content":"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar."},"5803":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-236","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas","content":"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó."},"5804":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-237","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas","content":"**Una migración aborta con `kms schema not found`.** Los esquemas deben migrarse en orden: ejecuta la migración del esquema `kms` antes que la del esquema `ca`."},"5805":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-238","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas","content":"**Una migración aborta con `ca schema not found`.** Ejecuta la migración del esquema `ca` antes que la del esquema `va`."},"5806":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-239","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas","content":"**La migración de VA falla con `cannot resolve signer certificate for VA role ... N candidates`.** La migración no puede identificar un certificado firmante de forma única a partir del SKI guardado en el rol. Revisa el SKI y los certificados candidatos indicados en el error; corrige los datos anteriores a la migración con una copia de seguridad verificada y vuelve a ejecutar la migración. El nuevo campo `signer_certificate_serial_number` se crea durante esa migración, por lo que no se puede configurar mediante la API de VA mientras esta falla."},"5807":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-240","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas","content":"**Una migración o un servicio falla con `permission denied for table ...`.** Al rol de PostgreSQL le faltan los privilegios entre esquemas listados en Despliegues sin Helm; incluye `certificates_view` cuando se omitió el `GRANT SELECT` posterior a la migración. Concede los privilegios que falten y vuelve a ejecutar."},"5808":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-241","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","content":"Tras la actualización, comprueba en este orden:"},"5809":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-242","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","content":"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS, y las migraciones de claves foráneas que se ejecutan por esquema en el orden obligatorio."},"5810":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-243","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","content":"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`."},"5811":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-244","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","content":"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado."},"5812":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-245","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","content":"**Las CRLs existentes se sirven.** `GET /crl/<ca-ski>` sobre la VA devuelve una CRL emitida anteriormente, y se emiten CRLs nuevas."},"5813":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-246","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","content":"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS."},"5814":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-247","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","content":"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI."},"5815":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-248","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","content":"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones."},"5816":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-249","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","content":"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha."},"5817":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-250","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","content":"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía."},"5818":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-251","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","content":"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`."},"5819":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-252","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","content":"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada."},"5820":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-253","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","content":"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización."},"5821":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-254","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","content":"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación."},"5822":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-255","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","content":"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado."},"5823":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-256","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","content":"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:"},"5824":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-257","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","content":"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL."},"5825":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-258","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","content":"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />"},"5826":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-259","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","content":"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />"},"5827":{"id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0-260","page_id":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","content":"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamien