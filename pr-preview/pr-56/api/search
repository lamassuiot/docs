,"3676":{"id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode-54","page_id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode#create-the-pack-from-the-built-modules","content":"Cannot be built or linked. Choose an intent first with `PUT /softwaremodules/by-id/:moduleID`."},"3677":{"id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode-55","page_id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode#create-the-pack-from-the-built-modules","content":"none"},"3678":{"id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode-56","page_id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode#create-the-pack-from-the-built-modules","content":"A build **replaces** the module's input files with the deliverable, so a built module cannot be built again: release a new version of the module."},"3679":{"id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode-57","page_id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode#create-the-pack-from-the-built-modules","content":"Operations that make no sense for a built, frozen pack answer as follows:"},"3680":{"id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode-58","page_id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode#create-the-pack-from-the-built-modules","content":"Request"},"3681":{"id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode-59","page_id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode#create-the-pack-from-the-built-modules","content":"Answer"},"3682":{"id":"/docs/pr-pre