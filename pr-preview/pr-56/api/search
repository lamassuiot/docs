/updates/concepts-18","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#vocabulary","content":"Software module"},"2682":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-19","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#vocabulary","content":"One typed, named component inside a pack, such as an application. Identified by the key `type:name`, where `type` is `os` or `application`"},"2683":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-20","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#vocabulary","content":"`softwaremodule`"},"2684":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-21","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#vocabulary","content":"Artifact"},"2685":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-22","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#vocabulary","content":"A file (binary) attached to a module or pack"},"2686":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-23","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#vocabulary","content":"`artifact`"},"2687":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-24","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#vocabulary","content":"Device group"},"2688":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-25","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#vocabulary","content":"A set of devices registered in Lamassu IoT. A pack belongs to a group"},"2689":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-26","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#vocabulary","content":"`groupID`"},"2690":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-27","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#vocabulary","content":"Launch campaign"},"2691":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-28","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#vocabulary","content":"One rollout of one pack version to the devices of a group"},"2692":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-29","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#vocabulary","content":"`launch`"},"2693":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-30","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#vocabulary","content":"Job"},"2694":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-31","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#vocabulary","content":"One device's update inside a launch"},"2695":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-32","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#vocabulary","content":"job, device assignment"},"2696":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-33","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#update-packs","content":"A pack has a **version** (semantic, `x.y.z`) and a **status**:"},"2697":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-34","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#update-packs","content":"Status"},"2698":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-35","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#update-packs","content":"Meaning"},"2699":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-36","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#update-packs","content":"`draft`"},"2700":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-37","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#update-packs","content":"Editable. Artifacts can be added or replaced. Not built yet."},"2701":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-38","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#update-packs","content":"`built`"},"2702":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-39","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#update-packs","content":"The deliverable exists. The version is immutable. Create a new version to change it."},"2703":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-40","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#update-packs","content":"`build_failed`"},"2704":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-41","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#update-packs","content":"A build was attempted and failed. Still editable and retryable. The reason is in `last_build_error`."},"2705":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-42","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#update-packs","content":"A pack has one **packaging**:"},"2706":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-43","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#update-packs","content":"Packaging"},"2707":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-44","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#update-packs","content":"Delivered as"},"2708":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-45","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#update-packs","content":"Workflow terminal state"},"2709":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-46","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#update-packs","content":"`swu`"},"2710":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-47","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#update-packs","content":"A `.swu` built with swugenerator, optionally signed and encrypted"},"2711":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-48","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#update-packs","content":"`ACTIVATED`"},"2712":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-49","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#update-packs","content":"`non-swu`"},"2713":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-50","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#update-packs","content":"The raw artifacts. Native mode builds a `.tar.gz` package (optionally encrypted, `.tar.gz.enc`). hawkBit mode delivers a `raw` module's single file as uploaded (optionally encrypted), and archives several files as `<name>.tar.gz`"},"2714":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-51","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#update-packs","content":"`INSTALLED`"},"2715":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-52","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#update-packs","content":"A pack can also carry **preconditions**: rules such as \"the device must already have pack X at version 1.2.0 or higher\", or \"the module `os:gateway-fw` at version 2.1.0 or higher\". Each precondition names exactly one pack (`required_distribution_set_name`) or one module (`required_module_key`) and a semantic `min_version`. A device that fails a precondition is not deployable, unless an operator forces the launch. Each launch records which devices failed and why."},"2716":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-53","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#software-modules","content":"A pack is a composition of modules. A pack holds one `os` module (the mandatory anchor) and any number of `application` modules. In native mode a pack without module rows is shown with one implicit module `os:<pack name>`, and the files you upload to the pack belong to it. A module holds its own files and, optionally, release notes. You can:"},"2717":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-54","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#software-modules","content":"create a module on its own in the **catalog** (`POST /updates/v1/softwaremodules`) and compose packs from it later,"},"2718":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-55","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#software-modules","content":"add a module to a pack directly, or"},"2719":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-56","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#software-modules","content":"import a module that another pack already has."},"2720":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-57","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#software-modules","content":"A module's **delivery intent** says how it will ship: `undecided` (default), `swu-build`, `swu-prebuilt` or `raw`."},"2721":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-58","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#software-modules","content":"How modules relate to the build differs by backend:"},"2722":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-59","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#software-modules","content":"**native**: modules are *build inputs*. The pack builds one `.swu` from all of them, and a launch sends each device a single download address."},"2723":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-60","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#software-modules","content":"**hawkbit**: each module has its *own deliverable*, built in the module catalog before the pack exists. Only built modules can be linked into a pack, and a linked module is frozen. hawkBit hands every module's artifacts to the device, so a pack with several modules installs as several independent SWUpdate transactions. SWUpdate cannot roll back across several `.swu` files."},"2724":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-61","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#software-modules","content":"Importing a module also differs. In hawkBit mode the import **links** it, so both packs share the module and a rebuild is seen by both. In native mode it **copies** it, so the two diverge afterwards. The listing of reusable modules tells you which one you will get (`shared`)."},"2725":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-62","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#launch-campaigns","content":"A launch rolls one pack version out to a group's devices in **batches**."},"2726":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-63","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#strategy","content":"Field"},"2727":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-64","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#strategy","content":"Meaning"},"2728":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-65","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#strategy","content":"`rollout_type`"},"2729":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-66","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#strategy","content":"How a batch is sized. Only `percentage` makes `rollout_value` a percentage. Any other value (`fixed`, or `numeric`, which the dashboard sends) makes it a device count"},"2730":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-67","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#strategy","content":"`rollout_value`"},"2731":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-68","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#strategy","content":"The percentage, or the device count. Must be greater than 0"},"2732":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-69","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#strategy","content":"`workflow_type`"},"2733":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-70","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#strategy","content":"The WFX workflow: `direct` (no confirmation), `phased` (confirmation steps) or `download-install`. Use `download-install` for `non-swu` packs. Any other value is passed to WFX as a full workflow name, such as `wfx.workflow.dau.simple`. In hawkBit mode there is no WFX: `phased` becomes a hawkBit soft action (the device confirms or postpones) and every other value a forced action"},"2734":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-71","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#strategy","content":"`test_device_id`"},"2735":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-72","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#strategy","content":"A canary. The first batch is this one device, and it must succeed before anyone else is touched"},"2736":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-73","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#strategy","content":"`auto`"},"2737":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-74","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#strategy","content":"Release the next batch automatically when conditions are met"},"2738":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-75","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#strategy","content":"`approval_threshold`"},"2739":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-76","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#strategy","content":"% of the current batch that must succeed before the next batch starts (0 to 100). Unset, 0 or 100 means the whole batch"},"2740":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-77","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#strategy","content":"`error_threshold`"},"2741":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-78","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#strategy","content":"The launch is cancelled once this % of all devices have failed (rounded up, so 10% of 100 devices cancels at the 10th failure). `0` means no limit"},"2742":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-79","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#strategy","content":"`scheduled_at`"},"2743":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-80","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#strategy","content":"Planned start time (RFC 3339). Native mode starts the first batch when it passes (polled every 30 seconds); hawkBit mode hands it to hawkBit as the rollout's start time"},"2744":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-81","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#strategy","content":"`name`, `description`"},"2745":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-82","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#strategy","content":"Display name (defaults to the pack name) and free-text notes"},"2746":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-83","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#strategy","content":"`weight`"},"2747":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-84","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#strategy","content":"A stored priority hint, 0 to 1000. Nothing reads it"},"2748":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-85","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#lifecycle","content":"A launch is `running`, `paused` (resumable), `cancelled` (terminal) or `completed` (terminal). A device inside it goes `pending` → `active` → `completed` or `failed`. You can retry only the failed devices (`retry-failed`). In native mode this also reopens a finished or cancelled launch. The operator controls are `rollout`, `pause`, `resume`, `cancel`, `complete` and `retry-failed`, and the strategy can be edited while the launch exists. Native mode supports all of them. hawkBit mode has no `complete` and no strategy edit, because a rollout's groups and thresholds are fixed at creation (see Capabilities)."},"2749":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-86","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#versions-compliance-and-inventory","content":"Beyond one-off launches you can declare the **latest version** of a pack for a group. The service then reports **drift**: devices that are not on the latest version. You can force one device to the latest version, or to an exact one. See the API reference."},"2750":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-87","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#versions-compliance-and-inventory","content":"The service also keeps a **device inventory**: which pack version each device carries now, with the artifacts that version's manifest declares, and the history of update attempts. Both are filled as the service's launches run."},"2751":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-88","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#how-an-update-reaches-a-device-native-mode","content":"The device-side state machine is a WFX workflow, in `wfx/workflow/dau/` of the repository:"},"2752":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-89","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#how-an-update-reaches-a-device-native-mode","content":"Workflow file"},"2753":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-90","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#how-an-update-reaches-a-device-native-mode","content":"States"},"2754":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-91","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#how-an-update-reaches-a-device-native-mode","content":"Use"},"2755":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-92","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#how-an-update-reaches-a-device-native-mode","content":"`wfx.workflow.dau.direct.yml`"},"2756":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-93","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#how-an-update-reaches-a-device-native-mode","content":"INSTALL → INSTALLING → INSTALLED → ACTIVATE → ACTIVATING → ACTIVATED"},"2757":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-94","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#how-an-update-reaches-a-device-native-mode","content":"SWU packs, no confirmation"},"2758":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-95","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#how-an-update-reaches-a-device-native-mode","content":"`wfx.workflow.dau.phased.yml`"},"2759":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-96","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#how-an-update-reaches-a-device-native-mode","content":"CREATED → DOWNLOAD → … → ACTIVATED"},"2760":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-97","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#how-an-update-reaches-a-device-native-mode","content":"SWU packs, with confirmation steps"},"2761":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-98","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#how-an-update-reaches-a-device-native-mode","content":"`wfx.workflow.dau.download-install.yml`"},"2762":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-99","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#how-an-update-reaches-a-device-native-mode","content":"DOWNLOAD → DOWNLOADING → DOWNLOADED → INSTALL → INSTALLING → INSTALLED"},"2763":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-100","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#how-an-update-reaches-a-device-native-mode","content":"`non-swu` packs. Select it with `workflow_type`: a launch does not choose it for you"},"2764":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-101","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#how-an-update-reaches-a-device-native-mode","content":"`wfx.workflow.dau.simple.yml`"},"2765":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-102","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#how-an-update-reaches-a-device-native-mode","content":"DOWNLOAD → INSTALL → INSTALLED or TERMINATED"},"2766":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-103","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#how-an-update-reaches-a-device-native-mode","content":"Minimal flow"},"2767":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-104","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#how-an-update-reaches-a-device-native-mode","content":"Every workflow ends in `TERMINATED` on failure. The service registers the four files at startup. `workflow_file` must name the `direct` file, and the other three are looked up next to it by replacing `direct` in the file name (see Configuration). In hawkBit mode there are no WFX jobs: see hawkBit mode."},"2768":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-105","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#next-steps","content":"<Card title=\"Architecture\" description=\"The components and what runs inside the service.\" href=\"/docs/platform/updates/architecture\" />"},"2769":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-106","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#next-steps","content":"<Card title=\"Flows\" description=\"Sequence diagrams of every important operation.\" href=\"/docs/platform/updates/flows\" />"},"2770":{"id":"/docs/pr-preview/pr-56/platform/updates/concepts-107","page_id":"/docs/pr-preview/pr-56/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/concepts#next-steps","content":"<Card title=\"Publish and roll out an update\" description=\"Do it end to end.\" href=\"/docs/platform/updates/guides/publish-and-roll-out\" />"},"2771":{"id":"/docs/pr-preview/pr-56/platform/updates/data-model","page_id":"/docs/pr-preview/pr-56/platform/updates/data-model","type":"page","content":"Data model","breadcrumbs":["Docs","Platform","Updates","Concepts"],"tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/data-model"},"2772":{"id":"/docs/pr-preview/pr-56/platform/updates/data-model-0","page_id":"/docs/pr-preview/pr-56/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/data-model","content":"The tables the service keeps, how they relate, and how the schema is created and migrated."},"2773":{"id":"/docs/pr-preview/pr-56/platform/updates/data-model-1","page_id":"/docs/pr-preview/pr-56/platform/updates/data-model","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/data-model#native-mode-tables","content":"Native mode tables"},"2774":{"id":"/docs/pr-preview/pr-56/platform/updates/data-model-2","page_id":"/docs/pr-preview/pr-56/platform/updates/data-model","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/data-model#hawkbit-mode-tables","content":"hawkBit mode tables"},"2775":{"id":"/docs/pr-preview/pr-56/platform/updates/data-model-3","page_id":"/docs/pr-preview/pr-56/platform/updates/data-model","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/data-model#entity-relationship-diagrams","content":"Entity-relationship diagrams"},"2776":{"id":"/docs/pr-preview/pr-56/platform/updates/data-model-4","page_id":"/docs/pr-preview/pr-56/platform/updates/data-model","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/data-model#packs-modules-and-artifacts","content":"Packs, modules and artifacts"},"2777":{"id":"/docs/pr-preview/pr-56/platform/updates/data-model-5","page_id":"/docs/pr-preview/pr-56/platform/updates/data-model","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/data-model#launches-and-devices","content":"Launches and devices"},"2778":{"id":"/docs/pr-preview/pr-56/platform/updates/data-model-6","page_id":"/docs/pr-preview/pr-56/platform/updates/data-model","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/data-model#reading-the-diagram","content":"Reading the diagram"},"2779":{"id":"/docs/pr-preview/pr-56/platform/updates/data-model-7","page_id":"/docs/pr-preview/pr-56/platform/updates/data-model","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/data-model#schema-creation-and-migrations","content":"Schema creation and migrations"},"2780":{"id":"/docs/pr-preview/pr-56/platform/updates/data-model-8","page_id":"/docs/pr-preview/pr-56/platform/updates/data-model","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/data-model#next-steps","content":"Next steps"},"2781":{"id":"/docs/pr-preview/pr-56/platform/updates/data-model-9","page_id":"/docs/pr-preview/pr-56/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/data-model","content":"The tables Lamassu Updates keeps in Postgres, how they relate, and how the schema is created and migrated. This is a reference for operators and integrators who query the database, size it, or plan an upgrade."},"2782":{"id":"/docs/pr-preview/pr-56/platform/updates/data-model-10","page_id":"/docs/pr-preview/pr-56/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/data-model#native-mode-tables","content":"Created in Postgres at startup, in the `updates` database. The Go types are in `pkg/models/updates.go` of the ota repository."},"2783":{"id":"/docs/pr-preview/pr-56/platform/updates/data-model-11","page_id":"/docs/pr-preview/pr-56/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/data-model#native-mode-tables","content":"Table"},"2784":{"id":"/docs/pr-preview/pr-56/platform/updates/data-model-12","page_id":"/docs/pr-preview/pr-56/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/data-model#native-mode-tables","content":"Holds"},"2785":{"id":"/docs/pr-preview/pr-56/platform/updates/data-model-13","page_id":"/docs/pr-preview/pr-56/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/data-model#native-mode-tables","content":"`distribution_set`"},"2786":{"id":"/docs/pr-preview/pr-56/platform/updates/data-model-14","page_id":"/docs/pr-preview/pr-56/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/data-model#native-mode-tables","content":"An update pack: name, version, group, type, packaging, status, the sw-description (`sw_descriptor`), preconditions, encryption and signature settings, and the per-device build coverage"},"2787":{"id":"/docs/pr-preview/pr-56/platform/updates/data-model-15","page_id":"/docs/pr-preview/pr-56/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/data-model#native-mode-tables","content":"`distribution_set_version`"},"2788":{"id":"/docs/pr-preview/pr-56/platform/updates/data-model-16","page_id":"/docs/pr-preview/pr-56/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/data-model#native-mode-tables","content":"A snapshot of each built version, with its signed manifest"},"2789":{"id":"/docs/pr-preview/pr-56/platform/updates/data-model-17","page_id":"/docs/pr-preview/pr-56/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/data-model#native-mode-tables","content":"`distribution_set_module`"},"2790":{"id":"/docs/pr-preview/pr-56/platform/updates/data-model-18","page_id":"/docs/pr-preview/pr-56/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/data-model#native-mode-tables","content":"The modules of a pack version, keyed by pack, version, module type and name. It also holds catalog modules that belong to no pack, with an empty pack ID"},"2791":{"id":"/docs/pr-preview/pr-56/platform/updates/data-model-19","page_id":"/docs/pr-preview/pr-56/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/data-model#native-mode-tables","content":"`artifact`"},"2792":{"id":"/docs/pr-preview/pr-56/platform/updates/data-model-20","page_id":"/docs/pr-preview/pr-56/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/data-model#native-mode-tables","content":"A global artifact: the catalog entry for an uploaded file, unique by name and version"},"2793":{"id":"/docs/pr-preview/pr-56/platform/updates/data-model-21","page_id":"/docs/pr-preview/pr-56/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/data-model#native-mode-tables","content":"`distribution_set_artifact`"},"2794":{"id":"/docs/pr-preview/pr-56/platform/updates/data-model-22","page_id":"/docs/pr-preview/pr-56/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/data-model#native-mode-tables","content":"The link between a pack version, an artifact and optionally one module"},"2795":{"id":"/docs/pr-preview/pr-56/platform/updates/data-model-23","page_id":"/docs/pr-preview/pr-56/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/data-model#native-mode-tables","content":"`launchtrack`"},"2796":{"id":"/docs/pr-preview/pr-56/platform/updates/data-model-24","page_id":"/docs/pr-preview/pr-56/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/data-model#native-mode-tables","content":"A launch campaign: strategy, status, thresholds and batch bookkeeping"},"2797":{"id":"/docs/pr-preview/pr-56/platform/updates/data-model-25","page_id":"/docs/pr-preview/pr-56/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/data-model#native-mode-tables","content":"`launch_device_assignments`"},"2798":{"id":"/docs/pr-preview/pr-56/platform/updates/data-model-26","page_id":"/docs/pr-preview/pr-56/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/data-model#native-mode-tables","content":"Each device's status within a launch: `pending`, `active`, `completed` or `failed`"},"2799":{"id":"/docs/pr-preview/pr-56/platform/updates/data-model-27","page_id":"/docs/pr-preview/pr-56/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/data-model#native-mode-tables","content":"`device_distribution_set_version`"},"2800":{"id":"/docs/pr-preview/pr-56/platform/updates/data-model-28","page_id":"/docs/pr-preview/pr-56/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/data-model#native-mode-tables","content":"Which pack version a device currently carries"},"2801":{"id":"/docs/pr-preview/pr-56/platform/updates/data-model-29","page_id":"/docs/pr-preview/pr-56/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/data-model#native-mode-tables","content":"`device_distribution_set_update`"},"2802":{"id":"/docs/pr-preview/pr-56/platform/updates/data-model-30","page_id":"/docs/pr-preview/pr-56/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/data-model#native-mode-tables","content":"A device's update history"},"2803":{"id":"/docs/pr-preview/pr-56/platform/updates/data-model-31","page_id":"/docs/pr-preview/pr-56/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/data-model#native-mode-tables","content":"`latest_distribution_set_version`"},"2804":{"id":"/docs/pr-preview/pr-56/platform/updates/data-model-32","page_id":"/docs/pr-preview/pr-56/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/data-model#native-mode-tables","content":"The declared latest version per group and pack"},"2805":{"id":"/docs/pr-preview/pr-56/platform/updates/data-model-33","page_id":"/docs/pr-preview/pr-56/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/data-model#native-mode-tables","content":"`updates_schema_migrations`"},"2806":{"id":"/docs/pr-preview/pr-56/platform/updates/data-model-34","page_id":"/docs/pr-preview/pr-56/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/data-model#native-mode-tables","content":"One row per data migration that must run only once (the approval-threshold migration)"},"2807":{"id":"/docs/pr-preview/pr-56/platform/updates/data-model-35","page_id":"/docs/pr-preview/pr-56/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/data-model#native-mode-tables","content":"File bytes (artifacts, builds, keys) are not in Postgres. They live in the blob stores described under Configuration. The sw-description is in Postgres (a column of the pack and of each module)."},"2808":{"id":"/docs/pr-preview/pr-56/platform/updates/data-model-36","page_id":"/docs/pr-preview/pr-56/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/data-model#hawkbit-mode-tables","content":"In hawkBit mode, packs, rollouts and jobs live in hawkBit. This service keeps only the following in the same Postgres (the `updates` database), for the things hawkBit has no equivalent of:"},"2809":{"id":"/docs/pr-preview/pr-56/platform/updates/data-model-37","page_id":"/docs/pr-preview/pr-56/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/data-model#hawkbit-mode-tables","content":"Table"},"2810":{"id":"/docs/pr-preview/pr-56/platform/updates/data-model-38","page_id":"/docs/pr-preview/pr-56/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/data-model#hawkbit-mode-tables","content":"Holds"},"2811":{"id":"/docs/pr-preview/pr-56/platform/updates/data-model-39","page_id":"/docs/pr-preview/pr-56/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/data-model#hawkbit-mode-tables","content":"`hawkbit_staged_artifact`"},"2812":{"id":"/docs/pr-preview/pr-56/platform/updates/data-model-40","page_id":"/docs/pr-preview/pr-56/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/data-model#hawkbit-mode-tables","content":"Bytes from `POST /artifacts`. Uploads older than 30 minutes are discarded the next time anyone uploads an artifact, and stay readable until then. They cannot be linked to a pack in this mode"},"2813":{"id":"/docs/pr-preview/pr-56/platform/updates/data-model-41","page_id":"/docs/pr-preview/pr-56/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/data-model#hawkbit-mode-tables","content":"`hawkbit_artifact_alias`"},"2814":{"id":"/docs/pr-preview/pr-56/platform/updates/data-model-42","page_id":"/docs/pr-preview/pr-56/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/data-model#hawkbit-mode-tables","content":"Read when resolving an artifact ID, but nothing writes it any more"},"2815":{"id":"/docs/pr-preview/pr-56/platform/updates/data-model-43","page_id":"/docs/pr-preview/pr-56/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/data-model#hawkbit-mode-tables","content":"`hawkbit_sw_descriptor_v2`"},"2816":{"id":"/docs/pr-preview/pr-56/platform/updates/data-model-44","page_id":"/docs/pr-preview/pr-56/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/data-model#hawkbit-mode-tables","content":"sw-descriptions, launch preconditions and rollout flags (a general key-value text store, keyed by instance, kind and ID)"},"2817":{"id":"/docs/pr-preview/pr-56/platform/updates/data-model-45","page_id":"/docs/pr-preview/pr-56/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/data-model#hawkbit-mode-tables","content":"`hawkbit_set_manifest_v2`"},"2818":{"id":"/docs/pr-preview/pr-56/platform/updates/data-model-46","page_id":"/docs/pr-preview/pr-56/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/data-model#hawkbit-mode-tables","content":"Signed manifests of built sets"},"2819":{"id":"/docs/pr-preview/pr-56/platform/updates/data-model-47","page_id":"/docs/pr-preview/pr-56/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/data-model#hawkbit-mode-tables","content":"`hawkbit_cancelled_rollout_v2`"},"2820":{"id":"/docs/pr-preview/pr-56/platform/updates/data-model-48","page_id":"/docs/pr-preview/pr-56/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/data-model#hawkbit-mode-tables","content":"Rollouts cancelled through this service"},"2821":{"id":"/docs/pr-preview/pr-56/platform/updates/data-model-49","page_id":"/docs/pr-preview/pr-56/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/data-model#hawkbit-mode-tables","content":"`latest_distribution_set_version`"},"2822":{"id":"/docs/pr-preview/pr-56/platform/updates/data-model-50","page_id":"/docs/pr-preview/pr-56/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/data-model#hawkbit-mode-tables","content":"Declared latest versions (shared with native mode)"},"2823":{"id":"/docs/pr-preview/pr-56/platform/updates/data-model-51","page_id":"/docs/pr-preview/pr-56/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/data-model#hawkbit-mode-tables","content":"Rows keyed by a hawkBit ID carry an `instance_id`, a marker of the hawkBit data they describe. If hawkBit loses its data and starts again, IDs repeat, and the service stops reading rows written for the old instance. The service re-checks the marker every 30 seconds."},"2824":{"id":"/docs/pr-preview/pr-56/platform/updates/data-model-52","page_id":"/docs/pr-preview/pr-56/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/data-model#hawkbit-mode-tables","content":"hawkBit keeps its own schema in its own `hawkbit` database. In the Docker Compose stack, `init.sql` creates both databases when the Postgres container first starts."},"2825":{"id":"/docs/pr-preview/pr-56/platform/updates/data-model-53","page_id":"/docs/pr-preview/pr-56/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/data-model#entity-relationship-diagrams","content":"The native-mode tables, with their main columns. `*_id` columns that point at another table are drawn as the relationship lines. These are logical references: the service creates no database foreign-key constraints, and `FK` only marks which column holds the reference."},"2826":{"id":"/docs/pr-preview/pr-56/platform/updates/data-model-54","page_id":"/docs/pr-preview/pr-56/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/data-model#launches-and-devices","content":"Values worth knowing:"},"2827":{"id":"/docs/pr-preview/pr-56/platform/updates/data-model-55","page_id":"/docs/pr-preview/pr-56/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/data-model#launches-and-devices","content":"`distribution_set.status` is `draft`, `built` or `build_failed`. `packaging` is `swu` or `non-swu`. `encryption_mode` is empty, `shared` or `per-device`."},"2828":{"id":"/docs/pr-preview/pr-56/platform/updates/data-model-56","page_id":"/docs/pr-preview/pr-56/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/data-model#launches-and-devices","content":"`launchtrack.status` is `running`, `paused`, `cancelled` or `completed`. A new launch is stored with an empty status, which means running. `aborted` is true for a cancelled launch (operator or error threshold) and stops every rollout path. The precondition outcome of the launch (`forced_preconditions`, `precondition_failures`) is stored on the row, but not the preconditions themselves: those live on the pack."},"2829":{"id":"/docs/pr-preview/pr-56/platform/updates/data-model-57","page_id":"/docs/pr-preview/pr-56/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/data-model#launches-and-devices","content":"`rollout_type` is not validated: only the value `percentage` makes `rollout_value` a percentage, and any other value (the dashboard sends `numeric`, the examples use `fixed`) makes it a device count."},"2830":{"id":"/docs/pr-preview/pr-56/platform/updates/data-model-58","page_id":"/docs/pr-preview/pr-56/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/data-model#launches-and-devices","content":"`launch_device_assignments.status` is `pending`, `active`, `completed` or `failed`. (`cancelled` also exists as a value, but only hawkBit mode reports it, for a canary whose launch was cancelled; it is never stored.)"},"2831":{"id":"/docs/pr-preview/pr-56/platform/updates/data-model-59","page_id":"/docs/pr-preview/pr-56/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/data-model#launches-and-devices","content":"`device_distribution_set_update.status` is `pending`, `running`, `success` or `failed` (hawkBit mode can also report `cancelled`), and its `source` is `service`."},"2832":{"id":"/docs/pr-preview/pr-56/platform/updates/data-model-60","page_id":"/docs/pr-preview/pr-56/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/data-model#launches-and-devices","content":"`distribution_set_module` is unique by pack, pack version, type and name. A standalone catalog module has an empty `distribution_set_id`, and its `distribution_set_version` equals its own `version`."},"2833":{"id":"/docs/pr-preview/pr-56/platform/updates/data-model-61","page_id":"/docs/pr-preview/pr-56/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/data-model#launches-and-devices","content":"`distribution_set_version` is unique by pack and version, and `distribution_set_artifact` by pack, version and artifact."},"2834":{"id":"/docs/pr-preview/pr-56/platform/updates/data-model-62","page_id":"/docs/pr-preview/pr-56/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/data-model#launches-and-devices","content":"Not drawn: `updates_schema_migrations`, a marker table the start-up data migrations use, and the hawkBit-mode tables listed above."},"2835":{"id":"/docs/pr-preview/pr-56/platform/updates/data-model-63","page_id":"/docs/pr-preview/pr-56/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/data-model#reading-the-diagram","content":"A **pack** (`distribution_set`) is one row that moves through versions. Each built version is snapshotted into `distribution_set_version`, with its signed manifest."},"2836":{"id":"/docs/pr-preview/pr-56/platform/updates/data-model-64","page_id":"/docs/pr-preview/pr-56/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/data-model#reading-the-diagram","content":"**Modules** and **artifacts** are separate: an artifact is a file in the global catalog, and `distribution_set_artifact` links it to a pack version (and optionally to one module). A module whose `distribution_set_id` is empty is a catalog module that no pack holds yet."},"2837":{"id":"/docs/pr-preview/pr-56/platform/updates/data-model-65","page_id":"/docs/pr-preview/pr-56/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/data-model#reading-the-diagram","content":"A **launch** (`launchtrack`) targets a group through one assignment row per device. The assignment moves `pending` → `active` → `completed` or `failed`, and `batch_index` records which batch dispatched it."},"2838":{"id":"/docs/pr-preview/pr-56/platform/updates/data-model-66","page_id":"/docs/pr-preview/pr-56/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/data-model#reading-the-diagram","content":"Two device tables answer different questions. `device_distribution_set_version` is what a device carries **now**. `device_distribution_set_update` is the **history** of attempts, with `version_from` and `version_to`."},"2839":{"id":"/docs/pr-preview/pr-56/platform/updates/data-model-67","page_id":"/docs/pr-preview/pr-56/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/data-model#reading-the-diagram","content":"`latest_distribution_set_version` is the version an operator declared devices of a group should be on, used for drift and compliance."},"2840":{"id":"/docs/pr-preview/pr-56/platform/updates/data-model-68","page_id":"/docs/pr-preview/pr-56/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/data-model#schema-creation-and-migrations","content":"There are no migration files. In native mode the service creates and upgrades its own schema when it starts, holding a Postgres lock so that replicas starting together do not race. It runs these steps in order (hawkBit mode only creates its six tables):"},"2841":{"id":"/docs/pr-preview/pr-56/platform/updates/data-model-69","page_id":"/docs/pr-preview/pr-56/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/data-model#schema-creation-and-migrations","content":"**Rename step** (`MigrateDistributionSetNaming`). Databases created before the \"update pack\" → \"distribution set\" rename have their tables and columns renamed. It runs before step 2 so that the new tables are not created empty beside the old ones."},"2842":{"id":"/docs/pr-preview/pr-56/platform/updates/data-model-70","page_id":"/docs/pr-preview/pr-56/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/data-model#schema-creation-and-migrations","content":"**Create and add** (GORM `AutoMigrate`). Missing tables and columns are created. It never drops or renames anything."},"2843":{"id":"/docs/pr-preview/pr-56/platform/updates/data-model-71","page_id":"/docs/pr-preview/pr-56/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/data-model#schema-creation-and-migrations","content":"**Data migrations.** Standalone modules (`software_module_definition` rows move into the module and artifact tables, keeping IDs and files, and the old table is dropped), device assignments (rebuilt from the legacy launch columns), and approval-threshold semantics."},"2844":{"id":"/docs/pr-preview/pr-56/platform/updates/data-model-72","page_id":"/docs/pr-preview/pr-56/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/data-model#schema-creation-and-migrations","content":"Most steps check the current schema instead of a version number, and the approval-threshold migration records a row in `updates_schema_migrations` so it runs only once. Repeated starts are safe, and a new database has nothing to migrate. After the schema steps the service also copies binaries from the legacy pack-scoped layout on disk into the artifact store, skipping any that are already there."},"2845":{"id":"/docs/pr-preview/pr-56/platform/updates/data-model-73","page_id":"/docs/pr-preview/pr-56/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/data-model#schema-creation-and-migrations","content":"`init.sql` is a Docker Compose seed: it creates the `updates` and `hawkbit` databases and still contains older table definitions, so do not use it to define the schema yourself."},"2846":{"id":"/docs/pr-preview/pr-56/platform/updates/data-model-74","page_id":"/docs/pr-preview/pr-56/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/data-model#schema-creation-and-migrations","content":"See Operations for what to do before upgrading."},"2847":{"id":"/docs/pr-preview/pr-56/platform/updates/data-model-75","page_id":"/docs/pr-preview/pr-56/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/data-model#next-steps","content":"<Card title=\"Configuration\" description=\"Blob stores, storage and every config field.\" href=\"/docs/platform/updates/reference/configuration\" />"},"2848":{"id":"/docs/pr-preview/pr-56/platform/updates/data-model-76","page_id":"/docs/pr-preview/pr-56/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/data-model#next-steps","content":"<Card title=\"Operations\" description=\"Back up, scale and upgrade the database.\" href=\"/docs/platform/updates/operations\" />"},"2849":{"id":"/docs/pr-preview/pr-56/platform/updates/flows","page_id":"/docs/pr-preview/pr-56/platform/updates/flows","type":"page","content":"Flows","breadcrumbs":["Docs","Platform","Updates","Concepts"],"tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/flows"},"2850":{"id":"/docs/pr-preview/pr-56/platform/updates/flows-0","page_id":"/docs/pr-preview/pr-56/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/flows","content":"Sequence diagrams of the important operations, for the native and hawkBit backends."},"2851":{"id":"/docs/pr-preview/pr-56/platform/updates/flows-1","page_id":"/docs/pr-preview/pr-56/platform/updates/flows","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/flows#native-mode","content":"Native mode"},"2852":{"id":"/docs/pr-preview/pr-56/platform/updates/flows-2","page_id":"/docs/pr-preview/pr-56/platform/updates/flows","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/flows#1-publish-and-build-a-pack","content":"1\\. Publish and build a pack"},"2853":{"id":"/docs/pr-preview/pr-56/platform/updates/flows-3","page_id":"/docs/pr-preview/pr-56/platform/updates/flows","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/flows#2-create-a-launch","content":"2\\. Create a launch"},"2854":{"id":"/docs/pr-preview/pr-56/platform/updates/flows-4","page_id":"/docs/pr-preview/pr-56/platform/updates/flows","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/flows#3-roll-out-a-batch-and-update-a-device","content":"3\\. Roll out a batch and update a device"},"2855":{"id":"/docs/pr-preview/pr-56/platform/updates/flows-5","page_id":"/docs/pr-preview/pr-56/platform/updates/flows","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/flows#4-react-to-a-device-finishing","content":"4\\. React to a device finishing"},"2856":{"id":"/docs/pr-preview/pr-56/platform/updates/flows-6","page_id":"/docs/pr-preview/pr-56/platform/updates/flows","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/flows#5-build-a-per-device-encrypted-pack","content":"5\\. Build a per-device encrypted pack"},"2857":{"id":"/docs/pr-preview/pr-56/platform/updates/flows-7","page_id":"/docs/pr-preview/pr-56/platform/updates/flows","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/flows#hawkbit-mode","content":"hawkBit mode"},"2858":{"id":"/docs/pr-preview/pr-56/platform/updates/flows-8","page_id":"/docs/pr-preview/pr-56/platform/updates/flows","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/flows#6-build-a-module-and-create-a-pack","content":"6\\. Build a module and create a pack"},"2859":{"id":"/docs/pr-preview/pr-56/platform/updates/flows-9","page_id":"/docs/pr-preview/pr-56/platform/updates/flows","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/flows#7-launch-and-device-update","content":"7\\. Launch and device update"},"2860":{"id":"/docs/pr-preview/pr-56/platform/updates/flows-10","page_id":"/docs/pr-preview/pr-56/platform/updates/flows","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/flows#next-steps","content":"Next steps"},"2861":{"id":"/docs/pr-preview/pr-56/platform/updates/flows-11","page_id":"/docs/pr-preview/pr-56/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/flows","content":"These diagrams follow what the service does, step by step. Routes are relative to `/updates/v1`. For runnable commands see the native and hawkBit curl guides, and the API reference for every route and body."},"2862":{"id":"/docs/pr-preview/pr-56/platform/updates/flows-12","page_id":"/docs/pr-preview/pr-56/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/flows#1-publish-and-build-a-pack","content":"Building turns the uploaded artifacts and the sw-description into one `.swu`. Nothing is signed or encrypted unless the build request asks for it."},"2863":{"id":"/docs/pr-preview/pr-56/platform/updates/flows-13","page_id":"/docs/pr-preview/pr-56/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/flows#1-publish-and-build-a-pack","content":"Things to know about the build:"},"2864":{"id":"/docs/pr-preview/pr-56/platform/updates/flows-14","page_id":"/docs/pr-preview/pr-56/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/flows#1-publish-and-build-a-pack","content":"The pack is created with a name, a semantic `version`, a `group_id`, a `type` and an optional `packaging`. A duplicate name in the group is a `409`."},"2865":{"id":"/docs/pr-preview/pr-56/platform/updates/flows-15","page_id":"/docs/pr-preview/pr-56/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/flows#1-publish-and-build-a-pack","content":"Uploading an artifact (or a prebuilt deliverable) to a version that is already built is refused with `409`: create a new version first. A build or change that collides with another one on the same pack answers `409` too."},"2866":{"id":"/docs/pr-preview/pr-56/platform/updates/flows-16","page_id":"/docs/pr-preview/pr-56/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/flows#1-publish-and-build-a-pack","content":"A file larger than `max_artifact_size_mb` (10240 MiB by default) is refused with `413`."},"2867":{"id":"/docs/pr-preview/pr-56/platform/updates/flows-17","page_id":"/docs/pr-preview/pr-56/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/flows#1-publish-and-build-a-pack","content":"Encryption is chosen by the build body: `user` plus `encryption_key_name` is shared-key encryption, and `encryption_alg_name` alone is per-device encryption (flow 5)."},"2868":{"id":"/docs/pr-preview/pr-56/platform/updates/flows-18","page_id":"/docs/pr-preview/pr-56/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/flows#1-publish-and-build-a-pack","content":"If the build fails, the pack becomes `build_failed`, `last_build_error` says why, and the pack stays editable. The selected artifacts replace the pack version's earlier artifact links."},"2869":{"id":"/docs/pr-preview/pr-56/platform/updates/flows-19","page_id":"/docs/pr-preview/pr-56/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/flows#1-publish-and-build-a-pack","content":"Without signing fields the manifest is stored unsigned. If a signing key is given but no certificate, the build fails instead."},"2870":{"id":"/docs/pr-preview/pr-56/platform/updates/flows-20","page_id":"/docs/pr-preview/pr-56/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/flows#1-publish-and-build-a-pack","content":"A `non-swu` pack is built with `POST .../package` into a `.tar.gz`, and a deliverable built elsewhere is attached with `POST .../swu/upload` or `.../package/upload`."},"2871":{"id":"/docs/pr-preview/pr-56/platform/updates/flows-21","page_id":"/docs/pr-preview/pr-56/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/flows#2-create-a-launch","content":"Creating a launch decides who is targeted, and checks the pack is deliverable. Nothing is sent to a device yet."},"2872":{"id":"/docs/pr-preview/pr-56/platform/updates/flows-22","page_id":"/docs/pr-preview/pr-56/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/flows#2-create-a-launch","content":"`?dry_run=true` stops after the precondition check and answers `200` with `qualifying_devices`, `precondition_failures`, `superseded_devices` and `never_seen_devices`. `force_preconditions` targets every device of the group and still records who failed. `distribution_set_name`, `workflow_type` and `rollout_type` are required, and so is a `rollout_value` above zero. `approval_threshold` and `error_threshold` must be between 0 and 100, and each violation is a `400`. A launch can also carry `auto`, `scheduled_at`, `name`, `description` and `weight` (see Concepts)."},"2873":{"id":"/docs/pr-preview/pr-56/platform/updates/flows-23","page_id":"/docs/pr-preview/pr-56/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/flows#3-roll-out-a-batch-and-update-a-device","content":"One `rollout` call sends the next batch. The canary goes alone first, then batches of the configured size, chosen at random from the devices still pending. The device side below is the `direct` workflow, where a job starts in `INSTALL`."},"2874":{"id":"/docs/pr-preview/pr-56/platform/updates/flows-24","page_id":"/docs/pr-preview/pr-56/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/flows#3-roll-out-a-batch-and-update-a-device","content":"With the `phased` workflow a job starts in `CREATED`, and some transitions need a person or system to confirm them in WFX. This service does not advance them. The `download-install` workflow, used by `non-swu` packs, runs `DOWNLOAD → DOWNLOADING → DOWNLOADED → INSTALL → INSTALLING → INSTALLED`."},"2875":{"id":"/docs/pr-preview/pr-56/platform/updates/flows-25","page_id":"/docs/pr-preview/pr-56/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/flows#3-roll-out-a-batch-and-update-a-device","content":"With `auto` on, one `rollout` call starts the launch and the following batches are released by flow 4. A launch with `scheduled_at` is started by the scheduled-launch trigger on the leader replica once that time passes."},"2876":{"id":"/docs/pr-preview/pr-56/platform/updates/flows-26","page_id":"/docs/pr-preview/pr-56/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/flows#3-roll-out-a-batch-and-update-a-device","content":"The `rollout` call is not always a plain `200`:"},"2877":{"id":"/docs/pr-preview/pr-56/platform/updates/flows-27","page_id":"/docs/pr-preview/pr-56/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/flows#3-roll-out-a-batch-and-update-a-device","content":"It is refused with `400` when the launch is paused, cancelled, completed or aborted, and on an `auto` launch once any batch has gone out."},"2878":{"id":"/docs/pr-preview/pr-56/platform/updates/flows-28","page_id":"/docs/pr-preview/pr-56/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/flows#3-roll-out-a-batch-and-update-a-device","content":"It does nothing and answers `200` while `scheduled_at` is still in the future, and while the canary is still active. It returns an error if the canary failed."},"2879":{"id":"/docs/pr-preview/pr-56/platform/updates/flows-29","page_id":"/docs/pr-preview/pr-56/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/flows#3-roll-out-a-batch-and-update-a-device","content":"If some jobs cannot be created, those devices stay `pending` and the call returns a \"partial rollout\" error (`500`)."},"2880":{"id":"/docs/pr-preview/pr-56/platform/updates/flows-30","page_id":"/docs/pr-preview/pr-56/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/flows#4-react-to-a-device-finishing","content":"Every state change WFX reports runs the same logic. This is what makes automatic batching, the canary gate and the error threshold work."},"2881":{"id":"/docs/pr-preview/pr-56/platform/updates/flows-31","page_id":"/docs/pr-preview/pr-56/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/flows#4-react-to-a-device-finishing","content":"On **every** event the service updates the device's update history and writes the event to the device's metadata in Lamassu. Then, only if the state is a terminal one of the workflow, it runs these checks in order, and the first one that applies decides what happens:"},"2882":{"id":"/docs/pr-preview/pr-56/platform/updates/flows-32","page_id":"/docs/pr-preview/pr-56/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/flows#4-react-to-a-device-finishing","content":"#"},"2883":{"id":"/docs/pr-preview/pr-56/platform/updates/flows-33","page_id":"/docs/pr-preview/pr-56/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/flows#4-react-to-a-device-finishing","content":"Check"},"2884":{"id":"/docs/pr-preview/pr-56/platform/updates/flows-34","page_id":"/docs/pr-preview/pr-56/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/flows#4-react-to-a-device-finishing","content":"If it applies"},"2885":{"id":"/docs/pr-preview/pr-56/platform/updates/flows-35","page_id":"/docs/pr-preview/pr-56/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/flows#4-react-to-a-device-finishing","content":"1"},"2886":{"id":"/docs/pr-preview/pr-56/platform/updates/flows-36","page_id":"/docs/pr-preview/pr-56/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/flows#4-react-to-a-device-finishing","content":"Is the state terminal in the workflow?"},"2887":{"id":"/docs/pr-preview/pr-56/platform/updates/flows-37","page_id":"/docs/pr-preview/pr-56/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/flows#4-react-to-a-device-finishing","content":"If not, nothing more happens"},"2888":{"id":"/docs/pr-preview/pr-56/platform/updates/flows-38","page_id":"/docs/pr-preview/pr-56/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/flows#4-react-to-a-device-finishing","content":"2"},"2889":{"id":"/docs/pr-preview/pr-56/platform/updates/flows-39","page_id":"/docs/pr-preview/pr-56/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/flows#4-react-to-a-device-finishing","content":"(always)"},"2890":{"id":"/docs/pr-preview/pr-56/platform/updates/flows-40","page_id":"/docs/pr-preview/pr-56/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/flows#4-react-to-a-device-finishing","content":"Mark the device's assignment `completed` or `failed`. On success, record the installed version"},"2891":{"id":"/docs/pr-preview/pr-56/platform/updates/flows-41","page_id":"/docs/pr-preview/pr-56/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/flows#4-react-to-a-device-finishing","content":"3"},"2892":{"id":"/docs/pr-preview/pr-56/platform/updates/flows-42","page_id":"/docs/pr-preview/pr-56/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/flows#4-react-to-a-device-finishing","content":"Did the canary device fail?"},"2893":{"id":"/docs/pr-preview/pr-56/platform/updates/flows-43","page_id":"/docs/pr-preview/pr-56/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/flows#4-react-to-a-device-finishing","content":"Pause the launch. Resume to retry"},"2894":{"id":"/docs/pr-preview/pr-56/platform/updates/flows-44","page_id":"/docs/pr-preview/pr-56/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/flows#4-react-to-a-device-finishing","content":"4"},"2895":{"id":"/docs/pr-preview/pr-56/platform/updates/flows-45","page_id":"/docs/pr-preview/pr-56/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/flows#4-react-to-a-device-finishing","content":"Is the launch paused, cancelled or completed?"},"2896":{"id":"/docs/pr-preview/pr-56/platform/updates/flows-46","page_id":"/docs/pr-preview/pr-56/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/flows#4-react-to-a-device-finishing","content":"Stop: no further batches"},"2897":{"id":"/docs/pr-preview/pr-56/platform/updates/flows-47","page_id":"/docs/pr-preview/pr-56/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/flows#4-react-to-a-device-finishing","content":"5"},"2898":{"id":"/docs/pr-preview/pr-56/platform/updates/flows-48","page_id":"/docs/pr-preview/pr-56/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/flows#4-react-to-a-device-finishing","content":"Is `error_threshold` set, and have failures reached that share of all devices (rounded up)?"},"2899":{"id":"/docs/pr-preview/pr-56/platform/updates/flows-49","page_id":"/docs/pr-preview/pr-56/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/flows#4-react-to-a-device-finishing","content":"Cancel the launch. Pending devices are not sent"},"2900":{"id":"/docs/pr-preview/pr-56/platform/updates/flows-50","page_id":"/docs/pr-preview/pr-56/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/flows#4-react-to-a-device-finishing","content":"6"},"2901":{"id":"/docs/pr-preview/pr-56/platform/updates/flows-51","page_id":"/docs/pr-preview/pr-56/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/flows#4-react-to-a-device-finishing","content":"Is nothing pending and nothing active?"},"2902":{"id":"/docs/pr-preview/pr-56/platform/updates/flows-52","page_id":"/docs/pr-preview/pr-56/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/flows#4-react-to-a-device-finishing","content":"Mark the launch `completed`"},"2903":{"id":"/docs/pr-preview/pr-56/platform/updates/flows-53","page_id":"/docs/pr-preview/pr-56/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/flows#4-react-to-a-device-finishing","content":"7"},"2904":{"id":"/docs/pr-preview/pr-56/platform/updates/flows-54","page_id":"/docs/pr-preview/pr-56/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/flows#4-react-to-a-device-finishing","content":"Is `auto` off, or is nothing left to send?"},"2905":{"id":"/docs/pr-preview/pr-56/platform/updates/flows-55","page_id":"/docs/pr-preview/pr-56/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/flows#4-react-to-a-device-finishing","content":"Wait for the operator's next `rollout` call, or for the devices still in flight"},"2906":{"id":"/docs/pr-preview/pr-56/platform/updates/flows-56","page_id":"/docs/pr-preview/pr-56/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/flows#4-react-to-a-device-finishing","content":"8"},"2907":{"id":"/docs/pr-preview/pr-56/platform/updates/flows-57","page_id":"/docs/pr-preview/pr-56/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/flows#4-react-to-a-device-finishing","content":"Did at least `approval_threshold` of this batch succeed? (0 or 100 or more means all of it)"},"2908":{"id":"/docs/pr-preview/pr-56/platform/updates/flows-58","page_id":"/docs/pr-preview/pr-56/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/flows#4-react-to-a-device-finishing","content":"Dispatch the next batch. Otherwise wait for more results"},"2909":{"id":"/docs/pr-preview/pr-56/platform/updates/flows-59","page_id":"/docs/pr-preview/pr-56/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/flows#4-react-to-a-device-finishing","content":"Only devices dispatched in the current batch count toward its approval: a straggler from an earlier batch never does. The checks move the launch between these states:"},"2910":{"id":"/docs/pr-preview/pr-56/platform/updates/flows-60","page_id":"/docs/pr-preview/pr-56/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/flows#4-react-to-a-device-finishing","content":"A new launch is stored with an empty status, which means `running`. Resuming after a failed canary re-queues the canary so it is tried again. Cancelling stops further batches but does not recall jobs that are already running on devices."},"2911":{"id":"/docs/pr-preview/pr-56/platform/updates/flows-61","page_id":"/docs/pr-preview/pr-56/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/flows#5-build-a-per-device-encrypted-pack","content":"Each device gets its own package, encrypted with its own key. The build first resolves every device's key, then builds. A device without a key is skipped, and a launch on a pack with skipped devices is refused."},"2912":{"id":"/docs/pr-preview/pr-56/platform/updates/flows-62","page_id":"/docs/pr-preview/pr-56/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/flows#5-build-a-per-device-encrypted-pack","content":"`uncovered_devices` lists devices without a key and also devices whose own build failed. A build where no device got a package leaves the pack `build_failed`."},"2913":{"id":"/docs/pr-preview/pr-56/platform/updates/flows-63","page_id":"/docs/pr-preview/pr-56/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/flows#6-build-a-module-and-create-a-pack","content":"hawkBit itself has no notion of a built module, and this service links only built modules into a hawkBit distribution set. A set is never built directly: `POST .../swu` and `.../package` answer `501` in this mode. The module is built first, in the catalog, and the pack is created from it. The diagram shows the `swu-build` intent."},"2914":{"id":"/docs/pr-preview/pr-56/platform/updates/flows-64","page_id":"/docs/pr-preview/pr-56/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/flows#6-build-a-module-and-create-a-pack","content":"The other delivery intents skip steps: `swu-prebuilt` only uploads the finished `.swu`, which is what builds the module, and `raw` only encrypts or signs the files, with no swugenerator and no sw-description (signing adds a `.sha256` checksum document and its detached signature as extra artifacts). A build can sign through the KMS and encrypt with a shared SymKMS key. Per-device encryption is refused in hawkBit mode. A linked module is frozen: to change it, edit and build it in the catalog, then link it again."},"2915":{"id":"/docs/pr-preview/pr-56/platform/updates/flows-65","page_id":"/docs/pr-preview/pr-56/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/flows#7-launch-and-device-update","content":"The device talks to hawkBit, not to this service. The service reads progress back from hawkBit whenever it is asked."},"2916":{"id":"/docs/pr-preview/pr-56/platform/updates/flows-66","page_id":"/docs/pr-preview/pr-56/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/flows#7-launch-and-device-update","content":"A canary group exists only when `test_device_id` is given. hawkBit decides when a group succeeds and the next group starts, using the approval and error thresholds the service gave it. With `auto` off, hawkBit pauses after each group and the next `rollout` call releases the following one. The launch response also lists `superseded_devices` (devices whose in-flight update the new rollout replaces) and `never_seen_devices` (devices that have never polled, which can stall a group that must reach its success threshold)."},"2917":{"id":"/docs/pr-preview/pr-56/platform/updates/flows-67","page_id":"/docs/pr-preview/pr-56/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/flows#7-launch-and-device-update","content":"The `rollout` call depends on the rollout's state:"},"2918":{"id":"/docs/pr-preview/pr-56/platform/updates/flows-68","page_id":"/docs/pr-preview/pr-56/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/flows#7-launch-and-device-update","content":"A `ready` rollout is started, and nothing happens while its start time is in the future."},"2919":{"id":"/docs/pr-preview/pr-56/platform/updates/flows-69","page_id":"/docs/pr-preview/pr-56/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/flows#7-launch-and-device-update","content":"A paused rollout is resumed only if it is paused between batches. An operator pause needs `resume`, and a rollout stopped by its error threshold cannot be resumed."},"2920":{"id":"/docs/pr-preview/pr-56/platform/updates/flows-70","page_id":"/docs/pr-preview/pr-56/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/flows#7-launch-and-device-update","content":"A running manual rollout releases its next group."},"2921":{"id":"/docs/pr-preview/pr-56/platform/updates/flows-71","page_id":"/docs/pr-preview/pr-56/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/flows#7-launch-and-device-update","content":"An `auto` rollout that is already running is refused with `400`."},"2922":{"id":"/docs/pr-preview/pr-56/platform/updates/flows-72","page_id":"/docs/pr-preview/pr-56/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/flows#7-launch-and-device-update","content":"A second `rollout` on the same launch while one is in progress answers `409`."},"2923":{"id":"/docs/pr-preview/pr-56/platform/updates/flows-73","page_id":"/docs/pr-preview/pr-56/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/flows#7-launch-and-device-update","content":"Device authentication is a hawkBit tenant setting. Target security tokens are off by default. See Connect a device."},"2924":{"id":"/docs/pr-preview/pr-56/platform/updates/flows-74","page_id":"/docs/pr-preview/pr-56/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/flows#next-steps","content":"<Card title=\"Publish and roll out an update\" description=\"Run flows 1 to 4 end to end.\" href=\"/docs/platform/updates/guides/publish-and-roll-out\" />"},"2925":{"id":"/docs/pr-preview/pr-56/platform/updates/flows-75","page_id":"/docs/pr-preview/pr-56/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/flows#next-steps","content":"<Card title=\"Data model\" description=\"The tables behind these flows.\" href=\"/docs/platform/updates/data-model\" />"},"2926":{"id":"/docs/pr-preview/pr-56/platform/updates/flows-76","page_id":"/docs/pr-preview/pr-56/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/flows#next-steps","content":"<Card title=\"Signing and encryption\" description=\"Keys, signatures and the manifest.\" href=\"/docs/platform/updates/signing-and-encryption\" />"},"2927":{"id":"/docs/pr-preview/pr-56/platform/updates/getting-started","page_id":"/docs/pr-preview/pr-56/platform/updates/getting-started","type":"page","content":"Get started with Lamassu Updates","breadcrumbs":["Docs","Platform","Updates","Get started"],"tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/getting-started"},"2928":{"id":"/docs/pr-preview/pr-56/platform/updates/getting-started-0","page_id":"/docs/pr-preview/pr-56/platform/updates/getting-started","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/getting-started","content":"Run Lamassu Updates and its dependencies locally with Docker Compose and check that the API answers."},"2929":{"id":"/docs/pr-preview/pr-56/platform/updates/getting-started-1","page_id":"/docs/pr-preview/pr-56/platform/updates/getting-started","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/getting-started#before-you-begin","content":"Before you begin"},"2930":{"id":"/docs/pr-preview/pr-56/platform/updates/getting-started-2","page_id":"/docs/pr-preview/pr-56/platform/updates/getting-started","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/getting-started#start-the-stack","content":"Start the stack"},"2931":{"id":"/docs/pr-preview/pr-56/platform/updates/getting-started-3","page_id":"/docs/pr-preview/pr-56/platform/updates/getting-started","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/getting-started#clone-the-repository","content":"Clone the repository"},"2932":{"id":"/docs/pr-preview/pr-56/platform/updates/getting-started-4","page_id":"/docs/pr-preview/pr-56/platform/updates/getting-started","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/getting-started#set-the-host-address","content":"Set the host address"},"2933":{"id":"/docs/pr-preview/pr-56/platform/updates/getting-started-5","page_id":"/docs/pr-preview/pr-56/platform/updates/getting-started","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/getting-started#create-the-network-and-start","content":"Create the network and start"},"2934":{"id":"/docs/pr-preview/pr-56/platform/updates/getting-started-6","page_id":"/docs/pr-preview/pr-56/platform/updates/getting-started","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/getting-started#services","content":"Services"},"2935":{"id":"/docs/pr-preview/pr-56/platform/updates/getting-started-7","page_id":"/docs/pr-preview/pr-56/platform/updates/getting-started","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/getting-started#verify-the-api","content":"Verify the API"},"2936":{"id":"/docs/pr-preview/pr-56/platform/updates/getting-started-8","page_id":"/docs/pr-preview/pr-56/platform/updates/getting-started","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/getting-started#run-without-docker","content":"Run without Docker"},"2937":{"id":"/docs/pr-preview/pr-56/platform/updates/getting-started-9","page_id":"/docs/pr-preview/pr-56/platform/updates/getting-started","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/getting-started#try-hawkbit-mode","content":"Try hawkBit mode"},"2938":{"id":"/docs/pr-preview/pr-56/platform/updates/getting-started-10","page_id":"/docs/pr-preview/pr-56/platform/updates/getting-started","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/getting-started#troubleshooting","content":"Troubleshooting"},"2939":{"id":"/docs/pr-preview/pr-56/platform/updates/getting-started-11","page_id":"/docs/pr-preview/pr-56/platform/updates/getting-started","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/getting-started#next-steps","content":"Next steps"},"2940":{"id":"/docs/pr-preview/pr-56/platform/updates/getting-started-12","page_id":"/docs/pr-preview/pr-56/platform/updates/getting-started","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/getting-started","content":"This guide starts Lamassu Updates (the OTA Update Service) with Docker Compose, in its default native mode, and checks that the API answers. It takes about ten minutes plus the image build. When it works, continue with Publish and roll out an update."},"2941":{"id":"/docs/pr-preview/pr-56/platform/updates/getting-started-13","page_id":"/docs/pr-preview/pr-56/platform/updates/getting-started","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/getting-started#before-you-begin","content":"Docker with the Compose plugin."},"2942":{"id":"/docs/pr-preview/pr-56/platform/updates/getting-started-14","page_id":"/docs/pr-preview/pr-56/platform/updates/getting-started","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/getting-started#before-you-begin","content":"A running Lamassu IoT instance that the containers can reach. The service reads device groups and their devices from its Device Manager (`dms_endpoint`), and signs with its KMS (`kms_endpoint`) only when you ask for signed builds."},"2943":{"id":"/docs/pr-preview/pr-56/platform/updates/getting-started-15","page_id":"/docs/pr-preview/pr-56/platform/updates/getting-started","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/getting-started#before-you-begin","content":"A checkout of the `ota` repository with the Lamassu `core` and `sdk` modules next to it. `go.mod` replaces `lamassuiot/core` and `lamassuiot/sdk` with local paths, and the Docker build copies them from the **parent directory** of the checkout (`context: ..` in `docker-compose.yml`), so that directory must contain both `ota/` and `lamassuiot/`."},"2944":{"id":"/docs/pr-preview/pr-56/platform/updates/getting-started-16","page_id":"/docs/pr-preview/pr-56/platform/updates/getting-started","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/getting-started#before-you-begin","content":"Access to the `ghcr.io/lamassuiot/wfx:otaq` image, which the `custom-wfx` service uses."},"2945":{"id":"/docs/pr-preview/pr-56/platform/updates/getting-started-17","page_id":"/docs/pr-preview/pr-56/platform/updates/getting-started","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/getting-started#before-you-begin","content":"Optional, for hawkBit mode: a hawkBit server. Compose builds one from `docker/hawkbit`: hawkBit 1.1.0 plus an S3 artifact plugin, tagged `lamassu/hawkbit-update-server:1.1.0-s3` locally. That image is built locally and not published."},"2946":{"id":"/docs/pr-preview/pr-56/platform/updates/getting-started-18","page_id":"/docs/pr-preview/pr-56/platform/updates/getting-started","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/getting-started#before-you-begin","content":"Optional, to run the service outside Docker: Go 1.26.2 or newer, and Python 3.8 or newer with the `swugenerator` requirements installed. The Docker image already contains the compiled binary and Python with `swugenerator`."},"2947":{"id":"/docs/pr-preview/pr-56/platform/updates/getting-started-19","page_id":"/docs/pr-preview/pr-56/platform/updates/getting-started","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/getting-started#set-the-host-address","content":"The `updates` container reaches Lamassu through `host.docker.internal`, which `docker-compose.yml` overrides with `HOST_IP`. On WSL2 the default `host.docker.internal` points at the Docker Desktop gateway, not at the WSL host, so set your own address:"},"2948":{"id":"/docs/pr-preview/pr-56/platform/updates/getting-started-20","page_id":"/docs/pr-preview/pr-56/platform/updates/getting-started","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/getting-started#set-the-host-address","content":"Then check that `dms_endpoint` and `kms_endpoint` in `config-docker.yml` point at your Lamassu API (they default to `http://host.docker.internal:8080/api/...`)."},"2949":{"id":"/docs/pr-preview/pr-56/platform/updates/getting-started-21","page_id":"/docs/pr-preview/pr-56/platform/updates/getting-started","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/getting-started#create-the-network-and-start","content":"`docker-compose.yml` attaches to an existing network named `ota-net` and refuses to start without it."},"2950":{"id":"/docs/pr-preview/pr-56/platform/updates/getting-started-22","page_id":"/docs/pr-preview/pr-56/platform/updates/getting-started","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/getting-started#services","content":"Service"},"2951":{"id":"/docs/pr-preview/pr-56/platform/updates/getting-started-23","page_id":"/docs/pr-preview/pr-56/platform/updates/getting-started","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/getting-started#services","content":"Host port"},"2952":{"id":"/docs/pr-preview/pr-56/platform/updates/getting-started-24","page_id":"/docs/pr-preview/pr-56/platform/updates/getting-started","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/getting-started#services","content":"What it is"},"2953":{"id":"/docs/pr-preview/pr-56/platform/updates/getting-started-25","page_id":"/docs/pr-preview/pr-56/platform/updates/getting-started","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/getting-started#services","content":"`updates`"},"2954":{"id":"/docs/pr-preview/pr-56/platform/updates/getting-started-26","page_id":"/docs/pr-preview/pr-56/platform/updates/getting-started","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/getting-started#services","content":"`10090`"},"2955":{"id":"/docs/pr-preview/pr-56/platform/updates/getting-started-27","page_id":"/docs/pr-preview/pr-56/platform/updates/getting-started","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/getting-started#services","content":"The Updates API, with SymKMS embedded"},"2956":{"id":"/docs/pr-preview/pr-56/platform/updates/getting-started-28","page_id":"/docs/pr-preview/pr-56/platform/updates/getting-started","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/getting-started#services","content":"`custom-wfx`"},"2957":{"id":"/docs/pr-preview/pr-56/platform/updates/getting-started-29","page_id":"/docs/pr-preview/pr-56/platform/updates/getting-started","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/getting-started#services","content":"`9080` (client), `9081` (management)"},"2958":{"id":"/docs/pr-preview/pr-56/platform/updates/getting-started-30","page_id":"/docs/pr-preview/pr-56/platform/updates/getting-started","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/getting-started#services","content":"WFX, th