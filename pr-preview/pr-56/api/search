dates/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/troubleshooting#api-calls","content":"The pack is still a draft"},"5392":{"id":"/docs/pr-preview/pr-56/platform/updates/troubleshooting-106","page_id":"/docs/pr-preview/pr-56/platform/updates/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/troubleshooting#api-calls","content":"Build it first."},"5393":{"id":"/docs/pr-preview/pr-56/platform/updates/troubleshooting-107","page_id":"/docs/pr-preview/pr-56/platform/updates/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/troubleshooting#api-calls","content":"`Cannot create launch: update pack \"x\" is per-device encrypted and only N of M devices have a package` (`400`)"},"5394":{"id":"/docs/pr-preview/pr-56/platform/updates/troubleshooting-108","page_id":"/docs/pr-preview/pr-56/platform/updates/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/troubleshooting#api-calls","content":"Some devices have no key"},"5395":{"id":"/docs/pr-preview/pr-56/platform/updates/troubleshooting-109","page_id":"/docs/pr-preview/pr-56/platform/updates/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/troubleshooting#api-calls","content":"Assign the missing keys and build again. There is no override."},"5396":{"id":"/docs/pr-preview/pr-56/platform/updates/troubleshooting-110","page_id":"/docs/pr-preview/pr-56/platform/updates/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/troubleshooting#api-calls","content":"`approval_threshold and error_threshold must be between 0 and 100`"},"5397":{"id":"/docs/pr-preview/pr-56/platform/updates/troubleshooting-111","page_id":"/docs/pr-preview/pr-56/platform/updates/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/troubleshooting#api-calls","content":"Thresholds are percentages"},"5398