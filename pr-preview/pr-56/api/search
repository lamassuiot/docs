ite la acción a esa identidad."},"1967":{"id":"/docs/pr-preview/pr-56/es/platform/pki/certificate-validation-20","page_id":"/docs/pr-preview/pr-56/es/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","content":"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios."},"1968":{"id":"/docs/pr-preview/pr-56/es/platform/pki/certificate-validation-21","page_id":"/docs/pr-preview/pr-56/es/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/pki/certificate-validation#elige-un-mecanismo","content":"Mecanismo"},"1969":{"id":"/docs/pr-preview/pr-56/es/platform/pki/certificate-validation-22","page_id":"/docs/pr-preview/pr-56/es/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/pki/certificate-validation#elige-un-mecanismo","content":"Cuándo utilizarlo"},"1970":{"id":"/docs/pr-preview/pr-56/es/platform/pki/certificate-validation-23","page_id":"/docs/pr-preview/pr-56/es/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/pki/certificate-validation#elige-un-mecanismo","content":"Qué debes mantener"},"1971":{"id":"/docs/pr-preview/pr-56/es/platform/pki/certificate-validation-24","page_id":"/docs/pr-preview/pr-56/es/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/pki/certificate-validation#elige-un-mecanismo","content":"OCSP"},"1972":{"id":"/docs/pr-preview/pr-56/es/platform/pki/certificate-validation-25","page_id":"/docs/pr-preview/pr-56/es/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/pki/certificate-validation#elige-un-mecanismo","co