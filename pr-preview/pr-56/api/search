t","url":"/docs/pr-preview/pr-56/deployment/self-hosted/fastlane#what-the-script-configures","content":"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`"},"184":{"id":"/docs/pr-preview/pr-56/deployment/self-hosted/fastlane-106","page_id":"/docs/pr-preview/pr-56/deployment/self-hosted/fastlane","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/self-hosted/fastlane#what-the-script-configures","content":"creates the namespace"},"185":{"id":"/docs/pr-preview/pr-56/deployment/self-hosted/fastlane-107","page_id":"/docs/pr-preview/pr-56/deployment/self-hosted/fastlane","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/self-hosted/fastlane#what-the-script-configures","content":"installs PostgreSQL and creates the required databases"},"186":{"id":"/docs/pr-preview/pr-56/deployment/self-hosted/fastlane-108","page_id":"/docs/pr-preview/pr-56/deployment/self-hosted/fastlane","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/self-hosted/fastlane#what-the-script-configures","content":"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user"},"187":{"id":"/docs/pr-preview/pr-56/deployment/self-hosted/fastlane-109","page_id":"/docs/pr-preview/pr-56/deployment/self-hosted/fastlane","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/self-hosted/fastlane#what-the-script-configures","content":"installs RabbitMQ"},"188":{"id":"/docs/pr-preview/pr-56/deployment/self-hosted/fastlane-110","page_id":"/docs/pr-preview/pr-56/deployment/self-hosted/fastlane","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/self-hosted/fastlane#what-the-script-configures","content":"optionally installs observability and lab HSM components"},"189":{"id":"/docs/pr-preview/pr-56/deployment/self-hosted/fastlane-111","page_id":"/docs/pr-preview/pr-56/deployment/self-hosted/fastlane","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/self-hosted/fastlane#what-the-s