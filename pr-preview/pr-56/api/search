},"3688":{"id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode-66","page_id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode#create-the-pack-from-the-built-modules","content":"Creating a module inside a pack"},"3689":{"id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode-67","page_id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode#create-the-pack-from-the-built-modules","content":"Not possible. Create it in the catalog."},"3690":{"id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode-68","page_id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode#create-the-pack-from-the-built-modules","content":"Changing the composition of a pack already assigned to devices"},"3691":{"id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode-69","page_id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode#create-the-pack-from-the-built-modules","content":"`400`: create a new version."},"3692":{"id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode-70","page_id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode#create-the-pack-from-the-built-modules","content":"See the publish and roll out guide for the full procedure."},"3693":{"id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode-71","page_id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode#how-it-maps","content":"Lamassu Updates"},"3694":{"id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode-72","page_id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode#how-it-maps","content":"hawkBit"},"3695":{"id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode-73","page_id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode#how-it-maps","content":"Update pack version"},"3696":{"id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode-74","page_id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode#how-it-maps","content":"Distribution set. Every version is its own distribution set."},"3697":{"id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode-75","page_id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode#how-it-maps","content":"Software module"},"3698":{"id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode-76","page_id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode#how-it-maps","content":"Software module"},"3699":{"id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode-77","page_id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode#how-it-maps","content":"Module artifact"},"3700":{"id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode-78","page_id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode#how-it-maps","content":"Software module artifact"},"3701":{"id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode-79","page_id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode#how-it-maps","content":"Device"},"3702":{"id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode-80","page_id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode#how-it-maps","content":"Target. The controller ID is the device ID."},"3703":{"id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode-81","page_id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode#how-it-maps","content":"Device group"},"3704":{"id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode-82","page_id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode#how-it-maps","content":"Target tag `group:<id>`"},"3705":{"id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode-83","page_id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode#how-it-maps","content":"Launch campaign"},"3706":{"id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode-84","page_id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode#how-it-maps","content":"Rollout (static)"},"3707":{"id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode-85","page_id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode#how-it-maps","content":"Per-device job"},"3708":{"id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode-86","page_id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode#how-it-maps","content":"Rollout action"},"3709":{"id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode-87","page_id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode#how-it-maps","content":"Scheduled launch"},"3710":{"id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode-88","page_id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode#how-it-maps","content":"The rollout's start time (hawkBit's scheduler starts it)"},"3711":{"id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode-89","page_id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode#what-lives-where","content":"hawkBit stores packs, rollouts and jobs. The service still needs Postgres (the `updates` database) for what hawkBit has no equivalent of: staged artifact uploads and aliases, sw-descriptions, signed set manifests, cancelled rollouts and declared latest-version pins. Keeping them in Postgres, not in memory, is what makes running several replicas safe."},"3712":{"id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode-90","page_id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode#what-lives-where","content":"**sw-descriptions** live in Postgres, not in hawkBit metadata, because hawkBit caps a metadata value at 4000 characters. Descriptors written there by older versions are still read."},"3713":{"id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode-91","page_id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode#what-lives-where","content":"**Rows are scoped to a hawkBit instance.** hawkBit ids repeat across servers and after its database is wiped, so the service tags the hawkBit it talks to with a marker (a distribution-set tag named `lamassu:instance`) and ignores rows that belong to another instance. Do not delete that tag."},"3714":{"id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode-92","page_id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode#what-lives-where","content":"**Staged uploads are heavy.** `POST /updates/v1/artifacts` (the global artifact upload) reads the whole file into memory and keeps it in Postgres for 30 minutes unless a pack links it, and hawkBit mode refuses to link files to packs. For large files, always upload through the catalog route of the previous section, which streams to hawkBit."},"3715":{"id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode-93","page_id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode#devices-and-targets","content":"Devices poll hawkBit, not this service. A pack launched against a hawkBit with no registered targets is never downloaded by anything."},"3716":{"id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode-94","page_id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode#devices-and-targets","content":"With `dms_endpoint` set, every read of a group's devices creates the missing targets (controller ID = device ID) and tags them `group:<id>`. A device that cannot be reconciled is excluded from that read and logged. Without `dms_endpoint`, groups are the existing `group:<id>` tags."},"3717":{"id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode-95","page_id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode#devices-and-targets","content":"The first launch with a `test_device_id` (canary) fails with `test device X cannot act as this group's canary` until the group's devices exist in hawkBit. Run a dry run first (`POST .../launch?dry_run=true`), which registers them."},"3718":{"id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode-96","page_id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode#device-authentication-in-production","content":"hawkBit decides how devices authenticate, not this service. hawkBit 1.1.0 has no anonymous mode: a deployment must enable at least one of the target security token, the gateway security token, or the reverse-proxy header authenticator (`X-Controller-Id` plus `X-Authority`). Pick one and enable it as a hawkBit tenant setting; an installation where all of them are off answers `401` to every device. Recommended for production:"},"3719":{"id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode-97","page_id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode#device-authentication-in-production","content":"Terminate device mTLS at a gateway, have it set the header authenticator's headers from the device certificate, and let hawkBit trust those headers only from the gateway's addresses (hawkBit's trusted-proxy setting). Anything that can reach hawkBit directly could otherwise impersonate any device."},"3720":{"id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode-98","page_id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode#device-authentication-in-production","content":"Or enable target security tokens (`authentication.targettoken.enabled`) and configure each device with its own token; SWUpdate sends it as `Authorization: TargetToken <token>`."},"3721":{"id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode-99","page_id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode#device-authentication-in-production","content":"Never expose the Management API to devices. Use a strong password for the Management API user (`HAWKBIT_SECURITY_USER_ADMIN_PASSWORD` in the image) and serve it over HTTPS. If the gateway publishes the DDI under a path prefix, set `hawkbit.ddi_url` to the public DDI URL so the artifact links devices receive are reachable."},"3722":{"id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode-100","page_id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode#artifact-storage-and-downloads","content":"By default hawkBit stores artifact bytes on its own filesystem. The `docker/hawkbit` directory of the repository builds a hawkBit image with an **S3 artifact storage plugin**, selected with `HAWKBIT_ARTIFACT_STORAGE=s3` (`fs` is the default) and the `HAWKBIT_ARTIFACT_S3_*` variables (bucket, endpoint, region, path-style access, key prefix; credentials come from the AWS default chain). hawkBit refuses to start if S3 is selected but the bucket is unreachable: it never falls back to local disk silently. Metadata stays in Postgres either way. The plugin and its build and test instructions are in `docker/hawkbit`; the image is built locally and is not published to a registry."},"3723":{"id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode-101","page_id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode#artifact-storage-and-downloads","content":"With the plugin and `hawkbit.artifact_store.presign` configured, downloads of module artifacts are answered `302` to a short-lived signed URL of the bucket instead of streaming through hawkBit or this service. Devices keep the artifact link hawkBit gave them: the adapter serves that one DDI route (`<ddi path>/:tenant/controller/v1/:controllerId/softwaremodules/:id/artifacts/:filename`), checks that the module is assigned to or installed on that device (otherwise `404`) and redirects. For this to work, the gateway must route that path to Lamassu Updates and the rest of the DDI to hawkBit. See Configuration and Security."},"3724":{"id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode-102","page_id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode#artifact-storage-and-downloads","content":"hawkBit has its own artifact limits. The image of this repository raises them to 11 GiB per file and 1 TiB in total, to match the default `max_artifact_size_mb` of 10 GiB (`SPRING_SERVLET_MULTIPART_MAXFILESIZE`, `SPRING_SERVLET_MULTIPART_MAXREQUESTSIZE`, `HAWKBIT_SERVER_SECURITY_DOS_MAXARTIFACTSIZE` and `HAWKBIT_SERVER_SECURITY_DOS_MAXARTIFACTSTORAGE`). With stock hawkBit the limit is 1 GiB per file and 20 GiB in total. hawkBit writes an upload to a temporary file first, so give it that much free disk."},"3725":{"id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode-103","page_id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode#artifact-storage-and-downloads","content":"The hawkBit image sizes its JVM with the environment variables `X_MS` and `X_MX` (default `768m` each), plus `XX_MAX_METASPACE_SIZE`, `XSS` and `GC`. `JAVA_OPTS` does not set the heap. Lowering `X_MX` lowers the ceiling, not the steady memory use."},"3726":{"id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode-104","page_id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode#what-differs-from-native-mode","content":"Area"},"3727":{"id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode-105","page_id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode#what-differs-from-native-mode","content":"`hawkbit` mode"},"3728":{"id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode-106","page_id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode#what-differs-from-native-mode","content":"Who devices poll"},"3729":{"id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode-107","page_id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode#what-differs-from-native-mode","content":"hawkBit (DDI), not this service."},"3730":{"id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode-108","page_id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode#what-differs-from-native-mode","content":"Capabilities"},"3731":{"id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode-109","page_id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode#what-differs-from-native-mode","content":"Not every native feature exists. `GET /updates/v1/capabilities` lists what the active backend supports: in `hawkbit` mode there are no custom workflows, no strategy editing after creation, no early completion of a campaign, no adding devices to a running campaign, no push events and no per-device encryption. See Capabilities."},"3732":{"id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode-110","page_id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode#what-differs-from-native-mode","content":"Encryption"},"3733":{"id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode-111","page_id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode#what-differs-from-native-mode","content":"**Shared key only.** A distribution set serves identical artifacts to every target, so there is nowhere to put a different payload per device. Use `native` mode for per-device encryption."},"3734":{"id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode-112","page_id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode#what-differs-from-native-mode","content":"Multi-module packs"},"3735":{"id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode-113","page_id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode#what-differs-from-native-mode","content":"Each module has its own deliverable, so a pack with several modules installs as **several independent SWUpdate transactions**. SWUpdate cannot roll back across several `.swu` files. See Concepts."},"3736":{"id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode-114","page_id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode#what-differs-from-native-mode","content":"Names"},"3737":{"id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode-115","page_id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode#what-differs-from-native-mode","content":"hawkBit soft-deletes software modules, so the name and version of a module that was ever assigned to a device are taken forever. Bump the version."},"3738":{"id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode-116","page_id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode#what-differs-from-native-mode","content":"Launch strategy"},"3739":{"id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode-117","page_id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode#what-differs-from-native-mode","content":"Read back from the rollout's groups, so a fixed batch can read back as a percentage. It cannot be edited after creation."},"3740":{"id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode-118","page_id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode#what-differs-from-native-mode","content":"Concurrent changes"},"3741":{"id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode-119","page_id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode#what-differs-from-native-mode","content":"Building or changing the same module from two requests answers `409` (`software module N is being built or changed by another request`)."},"3742":{"id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode-120","page_id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode#what-differs-from-native-mode","content":"Scaling"},"3743":{"id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode-121","page_id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode#what-differs-from-native-mode","content":"hawkBit is its own service with its own database. The Helm chart of this repository does not deploy or manage it."},"3744":{"id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode-122","page_id":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode#scaling","content":"In `hawkbit` mode nothing is elected and there are no local files to share, so any number of replicas can run: state is in Postgres and hawkBit, and module and launch operations take Postgres locks. If you use shared-key encryption, put SymKMS key storage (`symkms.storage`) on shared storage or S3. See Operations."},"3745":{"id":"/docs/pr-preview/pr-56/platform/updates/limitations","page_id":"/docs/pr-preview/pr-56/platform/updates/limitations","type":"page","content":"Limitations and known issues","breadcrumbs":["Docs","Platform","[Enterprise] Updates","Operate"],"tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/limitations"},"3746":{"id":"/docs/pr-preview/pr-56/platform/updates/limitations-0","page_id":"/docs/pr-preview/pr-56/platform/updates/limitations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/limitations","content":"What Lamassu Updates does not support or does not do yet, collected in one place with the page that explains each item."},"3747":{"id":"/docs/pr-preview/pr-56/platform/updates/limitations-1","page_id":"/docs/pr-preview/pr-56/platform/updates/limitations","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/limitations#security","content":"Security"},"3748":{"id":"/docs/pr-preview/pr-56/platform/updates/limitations-2","page_id":"/docs/pr-preview/pr-56/platform/updates/limitations","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/limitations#backends","content":"Backends"},"3749":{"id":"/docs/pr-preview/pr-56/platform/updates/limitations-3","page_id":"/docs/pr-preview/pr-56/platform/updates/limitations","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/limitations#packs-and-versions","content":"Packs and versions"},"3750":{"id":"/docs/pr-preview/pr-56/platform/updates/limitations-4","page_id":"/docs/pr-preview/pr-56/platform/updates/limitations","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/limitations#scaling-and-resources","content":"Scaling and resources"},"3751":{"id":"/docs/pr-preview/pr-56/platform/updates/limitations-5","page_id":"/docs/pr-preview/pr-56/platform/updates/limitations","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/limitations#signing-and-encryption","content":"Signing and encryption"},"3752":{"id":"/docs/pr-preview/pr-56/platform/updates/limitations-6","page_id":"/docs/pr-preview/pr-56/platform/updates/limitations","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/limitations#deployment-and-configuration","content":"Deployment and configuration"},"3753":{"id":"/docs/pr-preview/pr-56/platform/updates/limitations-7","page_id":"/docs/pr-preview/pr-56/platform/updates/limitations","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/limitations#observability","content":"Observability"},"3754":{"id":"/docs/pr-preview/pr-56/platform/updates/limitations-8","page_id":"/docs/pr-preview/pr-56/platform/updates/limitations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/limitations","content":"This page collects what is unsupported, partial or surprising, so you can check it before you design a rollout. Each item points to the page that explains it."},"3755":{"id":"/docs/pr-preview/pr-56/platform/updates/limitations-9","page_id":"/docs/pr-preview/pr-56/platform/updates/limitations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/limitations#security","content":"The service has no authentication, authorization, TLS or mTLS. Use a gateway. See Security."},"3756":{"id":"/docs/pr-preview/pr-56/platform/updates/limitations-10","page_id":"/docs/pr-preview/pr-56/platform/updates/limitations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/limitations#security","content":"The `app.server.cert_file`, `key_file` and `authentication.mutual_tls.*` keys have no effect."},"3757":{"id":"/docs/pr-preview/pr-56/platform/updates/limitations-11","page_id":"/docs/pr-preview/pr-56/platform/updates/limitations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/limitations#security","content":"The connection to Postgres always uses `sslmode=disable`. In `native` mode the service does not verify the TLS certificate of the KMS, and the SWU signer script calls `curl -k`."},"3758":{"id":"/docs/pr-preview/pr-56/platform/updates/limitations-12","page_id":"/docs/pr-preview/pr-56/platform/updates/limitations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/limitations#security","content":"The service sends the fixed identity `X-Principal-ID: admin-mode` to the Device Manager and the KMS, and its SymKMS calls carry no credential."},"3759":{"id":"/docs/pr-preview/pr-56/platform/updates/limitations-13","page_id":"/docs/pr-preview/pr-56/platform/updates/limitations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/limitations#security","content":"There is no rate limiting."},"3760":{"id":"/docs/pr-preview/pr-56/platform/updates/limitations-14","page_id":"/docs/pr-preview/pr-56/platform/updates/limitations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/limitations#backends","content":"The two backends differ in features. See Capabilities. Notably, `hawkbit` mode has no per-device encryption, no custom workflows, no editing of a launch strategy after creation, no early completion of a campaign, no adding devices to a running campaign, no push events and no set-level prebuilt upload. A `swu-prebuilt` catalog module does accept a finished `.swu`. `native` mode builds one deliverable per pack and has no per-module deliverables."},"3761":{"id":"/docs/pr-preview/pr-56/platform/updates/limitations-15","page_id":"/docs/pr-preview/pr-56/platform/updates/limitations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/limitations#backends","content":"In `hawkbit` mode, a pack with several modules installs as several independent SWUpdate transactions. SWUpdate cannot roll back across several `.swu` files."},"3762":{"id":"/docs/pr-preview/pr-56/platform/updates/limitations-16","page_id":"/docs/pr-preview/pr-56/platform/updates/limitations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/limitations#backends","content":"hawkBit reserves the name and version of a module that was ever assigned to a device. Bump the version."},"3763":{"id":"/docs/pr-preview/pr-56/platform/updates/limitations-17","page_id":"/docs/pr-preview/pr-56/platform/updates/limitations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/limitations#backends","content":"In `hawkbit` mode a module build replaces the module's input files with the deliverable, so a module cannot be built twice: release a new version."},"3764":{"id":"/docs/pr-preview/pr-56/platform/updates/limitations-18","page_id":"/docs/pr-preview/pr-56/platform/updates/limitations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/limitations#backends","content":"hawkBit rollouts are created static: devices added to a group after a launch is created are not picked up by that launch."},"3765":{"id":"/docs/pr-preview/pr-56/platform/updates/limitations-19","page_id":"/docs/pr-preview/pr-56/platform/updates/limitations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/limitations#backends","content":"`hawkbit` mode reads a launch's strategy back from the rollout's groups, so a launch created with a fixed batch can read back as a percentage."},"3766":{"id":"/docs/pr-preview/pr-56/platform/updates/limitations-20","page_id":"/docs/pr-preview/pr-56/platform/updates/limitations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/limitations#backends","content":"A first `hawkbit` launch with a `test_device_id` fails until the group's devices exist in hawkBit. See Troubleshooting."},"3767":{"id":"/docs/pr-preview/pr-56/platform/updates/limitations-21","page_id":"/docs/pr-preview/pr-56/platform/updates/limitations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/limitations#backends","content":"`POST /updates/v1/artifacts` in `hawkbit` mode holds the whole file in memory and in Postgres for 30 minutes and cannot be linked to a pack. Upload through the catalog route instead. See hawkBit mode."},"3768":{"id":"/docs/pr-preview/pr-56/platform/updates/limitations-22","page_id":"/docs/pr-preview/pr-56/platform/updates/limitations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/limitations#backends","content":"hawkBit's own artifact limits (1 GiB per file, 20 GiB in total) apply unless you use the image of this repository or raise them. The image with the S3 artifact plugin is built from `docker/hawkbit` and is not published to a registry."},"3769":{"id":"/docs/pr-preview/pr-56/platform/updates/limitations-23","page_id":"/docs/pr-preview/pr-56/platform/updates/limitations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/limitations#packs-and-versions","content":"**A new `native` pack version inherits the previous version's encryption settings for `.swu` builds.** `POST .../new` copies them, and a `.swu` build with no encryption fields does not clear them. After a per-device build, every later version of that pack still reports `per-device`, keeps the old `uncovered_devices`, and device downloads fail with `404` (`SWU not available for device ...`). Use a separate pack for each encryption variant. (`.../package` builds reset these fields.)"},"3770":{"id":"/docs/pr-preview/pr-56/platform/updates/limitations-24","page_id":"/docs/pr-preview/pr-56/platform/updates/limitations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/limitations#packs-and-versions","content":"`POST .../new` does not carry the pack's sw-description over: each version needs its own upload."},"3771":{"id":"/docs/pr-preview/pr-56/platform/updates/limitations-25","page_id":"/docs/pr-preview/pr-56/platform/updates/limitations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/limitations#packs-and-versions","content":"**Artifact names are global.** A name can only be reused with a higher `version`, and the API answers a violation with `500`, not a `4xx`."},"3772":{"id":"/docs/pr-preview/pr-56/platform/updates/limitations-26","page_id":"/docs/pr-preview/pr-56/platform/updates/limitations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/limitations#packs-and-versions","content":"A built version is immutable. To change it, create a new version."},"3773":{"id":"/docs/pr-preview/pr-56/platform/updates/limitations-27","page_id":"/docs/pr-preview/pr-56/platform/updates/limitations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/limitations#scaling-and-resources","content":"With local storage on one `ReadWriteOnce` volume, only one `native` replica can run. Move `artifacts`, `builds` and `symkms` to S3 to scale out. See Operations."},"3774":{"id":"/docs/pr-preview/pr-56/platform/updates/limitations-28","page_id":"/docs/pr-preview/pr-56/platform/updates/limitations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/limitations#scaling-and-resources","content":"SymKMS keys also default to local storage: point `symkms.storage` at S3, or share a volume, or they are lost."},"3775":{"id":"/docs/pr-preview/pr-56/platform/updates/limitations-29","page_id":"/docs/pr-preview/pr-56/platform/updates/limitations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/limitations#scaling-and-resources","content":"Per-device builds are CPU bound and grow with the number of devices. See Signing and encryption."},"3776":{"id":"/docs/pr-preview/pr-56/platform/updates/limitations-30","page_id":"/docs/pr-preview/pr-56/platform/updates/limitations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/limitations#scaling-and-resources","content":"Encrypting needs the file in memory (`swugenerator`, AES-GCM packages and raw modules, and any store with at-rest encryption), so very large encrypted files need proportionally large memory. Signing a raw module streams the file."},"3777":{"id":"/docs/pr-preview/pr-56/platform/updates/limitations-31","page_id":"/docs/pr-preview/pr-56/platform/updates/limitations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/limitations#scaling-and-resources","content":"Each in-flight upload needs free temporary disk as large as the file."},"3778":{"id":"/docs/pr-preview/pr-56/platform/updates/limitations-32","page_id":"/docs/pr-preview/pr-56/platform/updates/limitations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/limitations#signing-and-encryption","content":"Signing needs a KMS that returns CMS (`PKCS7 SignedData`). The service refuses a non-CMS answer when it signs manifests and raw-module checksums, but the SWU signer script does not check it: with a KMS without CMS support a `.swu` build can succeed and still be rejected by a device that sets `public-key-file`. See Signing and encryption."},"3779":{"id":"/docs/pr-preview/pr-56/platform/updates/limitations-33","page_id":"/docs/pr-preview/pr-56/platform/updates/limitations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/limitations#signing-and-encryption","content":"`non-swu` packages and raw modules are always AES-GCM, whatever algorithm name you send, and an Ascon-80pq key is refused for them."},"3780":{"id":"/docs/pr-preview/pr-56/platform/updates/limitations-34","page_id":"/docs/pr-preview/pr-56/platform/updates/limitations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/limitations#signing-and-encryption","content":"SymKMS does not enforce key purposes: any purpose is accepted and an empty one is a wildcard (an intentional placeholder). It refuses a caller-supplied IV for GCM, CTR and Ascon."},"3781":{"id":"/docs/pr-preview/pr-56/platform/updates/limitations-35","page_id":"/docs/pr-preview/pr-56/platform/updates/limitations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/limitations#signing-and-encryption","content":"Algorithm names are not normalised end to end: SymKMS ignores case and `_` versus `-`, but `swugenerator` needs hyphens (`aes-256-gcm`), and `ascon128a` is not `ASCON-128A`."},"3782":{"id":"/docs/pr-preview/pr-56/platform/updates/limitations-36","page_id":"/docs/pr-preview/pr-56/platform/updates/limitations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/limitations#deployment-and-configuration","content":"`app.server.protocol`, `app.server.log_level`, `app.server.health_check` and the `health_check_logging` of the examples are accepted but not read. The request log is always on."},"3783":{"id":"/docs/pr-preview/pr-56/platform/updates/limitations-37","page_id":"/docs/pr-preview/pr-56/platform/updates/limitations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/limitations#deployment-and-configuration","content":"The database is always named `updates`, and the service does not create it."},"3784":{"id":"/docs/pr-preview/pr-56/platform/updates/limitations-38","page_id":"/docs/pr-preview/pr-56/platform/updates/limitations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/limitations#deployment-and-configuration","content":"The example configuration files contain developer-machine values and development secrets."},"3785":{"id":"/docs/pr-preview/pr-56/platform/updates/limitations-39","page_id":"/docs/pr-preview/pr-56/platform/updates/limitations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/limitations#deployment-and-configuration","content":"The Helm chart's `config.update_domain` default (`http://updates:10090/v1/`) lacks the `/updates` prefix: the value must be the full API base ending in `/updates/v1/`, or the download URLs do not resolve."},"3786":{"id":"/docs/pr-preview/pr-56/platform/updates/limitations-40","page_id":"/docs/pr-preview/pr-56/platform/updates/limitations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/limitations#deployment-and-configuration","content":"The Helm chart declares `postgresql.*` and `ingress.*` values but deploys no PostgreSQL and has no ingress template. It always uses the `Recreate` strategy, renders all of `config` (passwords included) into a ConfigMap, and has no value to add environment variables, volumes or an existing Secret."},"3787":{"id":"/docs/pr-preview/pr-56/platform/updates/limitations-41","page_id":"/docs/pr-preview/pr-56/platform/updates/limitations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/limitations#deployment-and-configuration","content":"The container image does not drop privileges, and it ships a developer `config.yml`: mount your own."},"3788":{"id":"/docs/pr-preview/pr-56/platform/updates/limitations-42","page_id":"/docs/pr-preview/pr-56/platform/updates/limitations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/limitations#deployment-and-configuration","content":"To build the Docker image yourself, the build context must contain the `lamassuiot/core` and `lamassuiot/sdk` checkouts next to `ota/`."},"3789":{"id":"/docs/pr-preview/pr-56/platform/updates/limitations-43","page_id":"/docs/pr-preview/pr-56/platform/updates/limitations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/limitations#deployment-and-configuration","content":"`GET /health` does not check the database, WFX or hawkBit."},"3790":{"id":"/docs/pr-preview/pr-56/platform/updates/limitations-44","page_id":"/docs/pr-preview/pr-56/platform/updates/limitations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/limitations#observability","content":"The service exports no traces, metrics or logs, and has no metrics endpoint. See Operations."},"3791":{"id":"/docs/pr-preview/pr-56/platform/updates/operations","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","type":"page","content":"Operations","breadcrumbs":["Docs","Platform","[Enterprise] Updates","Operate"],"tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/operations"},"3792":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-0","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations","content":"Deploy Lamassu Updates with Docker Compose or Helm, scale it out, size it, observe it, back it up and upgrade it."},"3793":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-1","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/operations#deploy","content":"Deploy"},"3794":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-2","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/operations#the-container-image","content":"The container image"},"3795":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-3","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/operations#docker-compose","content":"Docker Compose"},"3796":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-4","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/operations#helm","content":"Helm"},"3797":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-5","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/operations#secrets-with-helm","content":"Secrets with Helm"},"3798":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-6","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/operations#scale-out","content":"Scale out"},"3799":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-7","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/operations#resource-sizing","content":"Resource sizing"},"3800":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-8","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/operations#upload-size-and-proxies","content":"Upload size and proxies"},"3801":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-9","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/operations#health-logging-and-shutdown","content":"Health, logging and shutdown"},"3802":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-10","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/operations#observability","content":"Observability"},"3803":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-11","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/operations#backup-and-restore","content":"Backup and restore"},"3804":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-12","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/operations#upgrades","content":"Upgrades"},"3805":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-13","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/operations#back-up","content":"Back up"},"3806":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-14","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/operations#deploy-the-new-image","content":"Deploy the new image"},"3807":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-15","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/operations#verify","content":"Verify"},"3808":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-16","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/operations#hawkbit-operations","content":"hawkBit operations"},"3809":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-17","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/operations#security-checklist","content":"Security checklist"},"3810":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-18","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations","content":"This page is for whoever runs the service: how to deploy it, what to put around it, how it behaves with several replicas, what to back up and how to upgrade. Configuration keys are documented in the configuration reference; the threat model is in Security."},"3811":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-19","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#the-container-image","content":"Release images are published to `ghcr.io/lamassuiot/ota`. The image runs one process, the monolith (the Updates API and SymKMS), on port `10090`. It contains the `swugenerator` tool, the signer scripts (`/app/sign_kms.sh`) and the WFX workflow files (`/app/wfx/workflow/dau/`). It does not set a non-root user."},"3812":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-20","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#the-container-image","content":"The image includes the repository's developer `config.yml` at `/etc/lamassuiot/config.yml`: always mount your own file over it, or point `OTA_CONFIG_FILE` at yours (see how the configuration is loaded). To build the image yourself, the Dockerfile expects its context to be the parent directory of the `ota` checkout, which must also contain `lamassuiot/core` and `lamassuiot/sdk`."},"3813":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-21","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#docker-compose","content":"`docker-compose.yml` is for local and demonstration use. It needs the external network `ota-net` (`docker network create ota-net`) and a `.env` file (copy `.env.example`; `HOST_IP` lets containers reach Lamassu on the host). It defines these named volumes:"},"3814":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-22","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#docker-compose","content":"Volume"},"3815":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-23","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#docker-compose","content":"Holds"},"3816":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-24","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#docker-compose","content":"`pgdata`"},"3817":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-25","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#docker-compose","content":"Postgres data: the `updates` and `hawkbit` databases, and the `wfx` database that holds device jobs in `native` mode"},"3818":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-26","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#docker-compose","content":"`update_files`"},"3819":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-27","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#docker-compose","content":"Build scratch and local update files of the `updates` service"},"3820":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-28","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#docker-compose","content":"`sym_keys`"},"3821":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-29","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#docker-compose","content":"SymKMS key material"},"3822":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-30","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#docker-compose","content":"`hawkbit_artifacts`"},"3823":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-31","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#docker-compose","content":"hawkBit's artifact files, with `HAWKBIT_ARTIFACT_STORAGE=fs`"},"3824":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-32","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#docker-compose","content":"`rustfs_data`"},"3825":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-33","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#docker-compose","content":"The local S3 store, with `--profile s3`"},"3826":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-34","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#docker-compose","content":"`docker compose --profile s3 up -d` also starts RustFS (S3 API on port `9000`) and an `s3-init` job that creates one bucket, `ota-updates`, with default server-side encryption turned on. By convention each backend uses a prefix: `hawkbit/` for hawkBit's artifacts and `ota/artifacts/` and `ota/builds/` for `native` mode. To keep artifacts and builds in S3, add the `artifacts` and `builds` blocks shown in `config.yml`, and set `HAWKBIT_ARTIFACT_STORAGE=s3` for hawkBit."},"3827":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-35","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#helm","content":"The chart is `helm/updates-monolithic` in the repository. It deploys the `updates` service only: Postgres, WFX, Lamassu and, in `hawkbit` mode, hawkBit are external."},"3828":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-36","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#helm","content":"Value"},"3829":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-37","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#helm","content":"Default"},"3830":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-38","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#helm","content":"Meaning"},"3831":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-39","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#helm","content":"`image.repository`, `image.tag`"},"3832":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-40","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#helm","content":"`updates-monolithic`, `latest`"},"3833":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-41","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#helm","content":"The image to run. Set `ghcr.io/lamassuiot/ota` and a release tag."},"3834":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-42","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#helm","content":"`replicaCount`"},"3835":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-43","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#helm","content":"`1`"},"3836":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-44","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#helm","content":"Replicas. See Scale out."},"3837":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-45","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#helm","content":"`service.type`, `service.port`"},"3838":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-46","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#helm","content":"`ClusterIP`, `10090`"},"3839":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-47","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#helm","content":"The chart has no ingress template: `ingress.*` in `values.yaml` has no effect. Expose the service with your own ingress or gateway."},"3840":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-48","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#helm","content":"`resources`"},"3841":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-49","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#helm","content":"limits `2000m` CPU, `4Gi`; requests `500m`, `1Gi`"},"3842":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-50","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#helm","content":"See Resource sizing."},"3843":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-51","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#helm","content":"`persistence.*`"},"3844":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-52","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#helm","content":"enabled, `ReadWriteOnce`, `10Gi`"},"3845":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-53","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#helm","content":"The volume mounted at `/data`: build scratch and, by default, local update files."},"3846":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-54","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#helm","content":"`leaderElection.enabled`, `leaderElection.mode`"},"3847":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-55","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#helm","content":"`true`, `kubernetes`"},"3848":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-56","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#helm","content":"See Scale out. The chart injects `leader_election.mode` into the configuration for you."},"3849":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-57","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#helm","content":"`config.*`"},"3850":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-58","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#helm","content":"see `values.yaml`"},"3851":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-59","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#helm","content":"The whole service configuration, rendered into a ConfigMap."},"3852":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-60","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#helm","content":"`serviceAccount.create`"},"3853":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-61","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#helm","content":"`true`"},"3854":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-62","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#helm","content":"Creates the service account and, with leader election enabled, a Role on `leases` (`get`, `list`, `watch`, `create`, `update`, `patch`)."},"3855":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-63","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#helm","content":"`podSecurityContext`, `securityContext`"},"3856":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-64","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#helm","content":"empty"},"3857":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-65","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#helm","content":"Not set by default."},"3858":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-66","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#helm","content":"`postgresql.*`"},"3859":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-67","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#helm","content":"not used"},"3860":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-68","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#helm","content":"Declared but nothing deploys PostgreSQL: use an external database."},"3861":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-69","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#helm","content":"Fixed by the templates: the deployment strategy is &#x2A;*`Recreate`** (a deploy has a short outage), the pod's termination grace period is 120 s with a 5 s `preStop` sleep, probes call `GET /health`, and a change in `config` rolls the pods (a checksum annotation)."},"3862":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-70","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#helm","content":"Point `config.*` at the dependencies. In particular, create the `updates` database in your Postgres first. The service creates its tables, not the database. The chart default `config.update_domain` is `http://updates:10090/v1/`, which lacks the `/updates` prefix: set it to the full API base ending in `/updates/v1/` as devices reach it, or the download URLs stored on packs will not resolve."},"3863":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-71","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#secrets-with-helm","content":"The chart renders the whole `config` value, including `storage.password`, `encryption.local_key`, S3 keys and `hawkbit.password`, into a ConfigMap. It has no `existingSecret` option, and no value to add environment variables or volumes, so the service's environment-variable overrides and its `*_file` credentials cannot be fed from a Kubernetes Secret without patching or wrapping the chart. Until then:"},"3864":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-72","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#secrets-with-helm","content":"Keep the real values in a values file that is not committed (`-f secrets.values.yaml`), or generate it from your secret manager at deploy time."},"3865":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-73","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#secrets-with-helm","content":"Restrict who can read ConfigMaps and Helm release secrets in the namespace."},"3866":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-74","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#secrets-with-helm","content":"Prefer credentials that avoid static keys: leave the S3 access keys out to use the AWS default credential chain (IRSA or an instance profile)."},"3867":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-75","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#secrets-with-helm","content":"Override the placeholder database password the chart ships in `config.storage`."},"3868":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-76","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#secrets-with-helm","content":"`helm/updates.yaml` is a values override for the umbrella Lamassu chart, used as `helm upgrade lamassu lamassu/lamassu -f lamassu.yaml -f updates.yaml`. It sets the image, replicas, resources, persistence and `config` of the `updates` service there. Its example resource limit (`500m` CPU) is lower than the chart's: see Resource sizing."},"3869":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-77","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#scale-out","content":"Serving HTTP works on any number of replicas in both modes. What differs is the state each replica needs."},"3870":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-78","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#scale-out","content":"`native`"},"3871":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-79","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#scale-out","content":"`hawkbit`"},"3872":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-80","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#scale-out","content":"Background work"},"3873":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-81","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#scale-out","content":"Elected: the WFX event consumer and the scheduled-launch trigger run on one replica"},"3874":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-82","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#scale-out","content":"None"},"3875":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-83","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#scale-out","content":"State"},"3876":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-84","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#scale-out","content":"Postgres, WFX, the `artifacts`, `builds` and `symkms` stores"},"3877":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-85","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#scale-out","content":"Postgres and hawkBit"},"3878":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-86","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#scale-out","content":"Local files"},"3879":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-87","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#scale-out","content":"Build scratch only (rebuilt by each replica)"},"3880":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-88","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#scale-out","content":"None"},"3881":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-89","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#scale-out","content":"Extra requirement"},"3882":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-90","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#scale-out","content":"S3 stores and leader election"},"3883":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-91","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#scale-out","content":"Shared or S3 `symkms.storage` if you use shared-key encryption"},"3884":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-92","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#scale-out","content":"To run more than one `native` replica:"},"3885":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-93","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#scale-out","content":"**Shared storage.** The default is a `ReadWriteOnce` volume, which cannot be mounted by pods on different nodes, so it limits the deployment to one replica regardless of `replicaCount`. Point `config.artifacts`, `config.builds` and `config.symkms.storage` at S3 and set `persistence.enabled: false`. SymKMS keys also default to local storage, and would not be shared between replicas. The service logs a warning at start-up when build outputs are on local storage. sw-descriptions are stored in Postgres, so nothing local is needed by another replica."},"3886":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-94","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#scale-out","content":"**Leader election.** Leave `leaderElection.enabled: true`. The WFX event consumer advances a campaign's batches on every job completion, and the trigger starts due scheduled launches and repairs interrupted batches. With several replicas and no election, each one counts the same completions and releases the next batch before the current one succeeded."},"3887":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-95","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#scale-out","content":"`leaderElection.mode` (`leader_election.mode` in the file) is:"},"3888":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-96","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#scale-out","content":"Value"},"3889":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-97","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#scale-out","content":"Behaviour"},"3890":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-98","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#scale-out","content":"empty (auto)"},"3891":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-99","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#scale-out","content":"Kubernetes Leases inside a cluster; otherwise a Postgres advisory lock. This is the default of the binary."},"3892":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-100","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#scale-out","content":"`kubernetes`"},"3893":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-101","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#scale-out","content":"Leases, required. Startup fails if the service account cannot use them. This is the chart default."},"3894":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-102","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#scale-out","content":"`database`"},"3895":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-103","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#scale-out","content":"A Postgres advisory lock, for when granting RBAC is not an option."},"3896":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-104","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#scale-out","content":"With Leases, one Lease per role is created in the pod's namespace (`lamassu-updates-wfx-event-consumer` and `lamassu-updates-scheduled-launch-trigger`), and `kubectl get lease` shows the pod that leads (`POD_NAME` is the holder). The lease lasts 15 s and is renewed within 10 s, so a failover takes about that long. With the database lock, a standby retries every 15 s and the leader verifies every 5 s that its connection is still alive."},"3897":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-105","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#scale-out","content":"Other multi-replica guarantees: builds and version changes of the same pack take a Postgres lock (a concurrent request answers `409`), schema migrations take one too, and a campaign batch is claimed atomically so it is not released twice. Each replica keeps up to 25 database connections: budget `25 x replicas` against Postgres `max_connections`."},"3898":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-106","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#scale-out","content":"In `hawkbit` mode there is nothing to elect and no local files to share. The chart still mounts the `ReadWriteOnce` volume while `persistence.enabled` is true, so set it to `false` to run replicas on different nodes."},"3899":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-107","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#scale-out","content":"Because the chart uses the `Recreate` strategy, a deploy stops every replica before starting the new ones, even with `replicaCount` above 1."},"3900":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-108","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#resource-sizing","content":"**CPU** is the lever on per-device build time. A build runs one `swugenerator` per device, and the parallelism is derived from the container's CPU limit, not the node's cores: a `500m` limit collapses it to half a core. The chart's default of `2000m` is a starting point for groups in the hundreds."},"3901":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-109","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#resource-sizing","content":"**Memory.** Uploads, downloads and non-encrypting builds are streamed, so memory does not grow with the file (the maintainers measured a peak of about 150 MiB resident for a 10 GiB upload and for a 10 GiB download). Encrypting needs the file in memory: `swugenerator` reads an artifact into memory to encrypt it, AES-GCM of `non-swu` packages and `raw` modules works on one buffer, and a store with at-rest encryption enabled decrypts whole objects in memory. Size memory for the largest file you encrypt times the concurrent builds. In `hawkbit` mode, `build_memory_limit_mb` refuses such a build before the pod is killed."},"3902":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-110","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#resource-sizing","content":"**Disk.** Each in-flight upload is written to a temporary file under `TMPDIR` before it is stored, so overlapping uploads need that much free disk. Build scratch also uses `update_files_base_dir` (`/data` in the chart). Give the volume room for several simultaneous uploads (the umbrella example uses `50Gi`). The chart exposes no environment values, so setting `TMPDIR` to the volume needs a patched or wrapped chart."},"3903":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-111","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#upload-size-and-proxies","content":"`max_artifact_size_mb` (default 10 GiB) caps one uploaded file. Anything in front of the service must allow the same size and keep the connection open as long as the transfer takes: the service itself uses 6-hour read and write timeouts and closes idle connections after 5 minutes. For ingress-nginx:"},"3904":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-112","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#upload-size-and-proxies","content":"nginx's default body limit is 1 MiB, which is what rejects \"a few MB\" uploads before they reach the service. A file above the service's own limit gets `413` naming the limit."},"3905":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-113","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#health-logging-and-shutdown","content":"What"},"3906":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-114","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#health-logging-and-shutdown","content":"How"},"3907":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-115","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#health-logging-and-shutdown","content":"Liveness and readiness"},"3908":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-116","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#health-logging-and-shutdown","content":"`GET /health` returns `{\"status\":\"ok\"}` without checking Postgres, WFX or hawkBit, so it shows only that the process answers. The chart uses it for both probes, and the Docker image runs it every 30 seconds."},"3909":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-117","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#health-logging-and-shutdown","content":"Capabilities"},"3910":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-118","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#health-logging-and-shutdown","content":"`GET /updates/v1/capabilities` shows the active backend and what it supports. It is unauthenticated and has no side effects, but in `hawkbit` mode it asks hawkBit, so do not use it as a probe."},"3911":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-119","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#health-logging-and-shutdown","content":"Logs"},"3912":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-120","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#health-logging-and-shutdown","content":"Written to standard output: the application log (level `app.logs.level`) and an access log of every request. At `debug` the start-up log includes the whole configuration, secrets too."},"3913":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-121","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#health-logging-and-shutdown","content":"Shutdown"},"3914":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-122","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#health-logging-and-shutdown","content":"On `SIGTERM` or `SIGINT` the service stops accepting requests, drains in-flight ones for up to `app.server.shutdown_timeout` (60 s), hands over leadership and, in `native` mode, waits up to 30 s more for a batch dispatch under way. The chart's grace period (120 s) covers this."},"3915":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-123","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#observability","content":"The service does not export traces, metrics or logs. Its outgoing HTTP clients (the SymKMS client) and its database layer are instrumented with OpenTelemetry, but no tracer provider or exporter is configured, and there is no metrics endpoint. The `otel/` directory of the repository holds a local development stack (Grafana Alloy with OTLP receivers on 4317 and 4318, Loki, Tempo, Prometheus, Grafana; Jaeger in `otel/jaeger/`) that nothing feeds today. Until exporters are added, monitor the process log and `/health`, and watch Kubernetes events and Leases."},"3916":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-124","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#backup-and-restore","content":"Back up"},"3917":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-125","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#backup-and-restore","content":"Why"},"3918":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-126","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#backup-and-restore","content":"Postgres: the `updates` database, plus `wfx` in `native` mode (the device jobs) and `hawkbit` in `hawkbit` mode"},"3919":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-127","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#backup-and-restore","content":"Packs, launches, device history and, in `hawkbit` mode, sw-descriptions, signed manifests and staged state"},"3920":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-128","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#backup-and-restore","content":"The `artifacts` and `builds` S3 buckets (or the `update_files` volume)"},"3921":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-129","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#backup-and-restore","content":"Artifact binaries and build outputs. Builds can be rebuilt from artifacts and the sw-description (stored in Postgres); the artifacts themselves cannot be recreated."},"3922":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-130","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#backup-and-restore","content":"The `symkms` store (S3 bucket or the `sym_keys` volume)"},"3923":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-131","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#backup-and-restore","content":"Device and shared encryption keys. If they are lost, packages already delivered cannot be rebuilt identically, and devices cannot decrypt new ones."},"3924":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-132","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#backup-and-restore","content":"`encryption.local_key` (or the AWS KMS key)"},"3925":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-133","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#backup-and-restore","content":"Every blob stored with at-rest encryption is unreadable without it. Store it separately from the data."},"3926":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-134","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#backup-and-restore","content":"hawkBit's artifact store (volume or bucket), `hawkbit` mode"},"3927":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-135","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#backup-and-restore","content":"The artifact files"},"3928":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-136","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#backup-and-restore","content":"Restore the database and the blob stores from the same point in time: a database that references an artifact missing from storage returns errors on download and rebuild. In `hawkbit` mode, also keep the `updates` and `hawkbit` databases consistent: rows of the `updates` database are scoped to the hawkBit instance that wrote them, and are ignored if hawkBit comes back from a different data set."},"3929":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-137","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#back-up","content":"Take the backups above, mainly the `updates` database."},"3930":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-138","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#deploy-the-new-image","content":"There are no migration files. At start-up the service renames, creates and migrates its own tables under a Postgres advisory lock, so replicas starting together do not race. Among others it renames the tables and columns of the former \"update pack\" vocabulary to the \"distribution set\" ones, folds the standalone-module table into the module tables, backfills device assignments and converts approval thresholds. See Data model."},"3931":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-139","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#verify","content":"Check `GET /health` and `GET /updates/v1/capabilities`, and read the start-up log for migration errors."},"3932":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-140","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#verify","content":"There is no automated rollback, and migrations are one-way: an older image does not understand renamed tables. To go back, restore the database and the blob stores from the backup, and run the previous image."},"3933":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-141","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#hawkbit-operations","content":"For `hawkbit` mode, hawkBit is a separate service you operate. Its JVM heap is set with `X_MS` and `X_MX` (the image default is `768m` each; `JAVA_OPTS` does not set it), its artifact limits with the `SPRING_SERVLET_MULTIPART_*` and `HAWKBIT_SERVER_SECURITY_DOS_*` variables, and its artifact store with `HAWKBIT_ARTIFACT_STORAGE`. See hawkBit mode."},"3934":{"id":"/docs/pr-preview/pr-56/platform/updates/operations-142","page_id":"/docs/pr-preview/pr-56/platform/updates/operations","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/operations#security-checklist","content":"See Security. In short: put a gateway with TLS and authentication in front of the service, keep `enable_test_endpoints: false`, restrict the SymKMS key routes, keep Postgres, WFX management, the KMS and hawkBit on private networks, and keep secrets out of the repository and the logs."},"3935":{"id":"/docs/pr-preview/pr-56/platform/updates/overview","page_id":"/docs/pr-preview/pr-56/platform/updates/overview","type":"page","content":"Lamassu Updates","breadcrumbs":["Docs","Platform","[Enterprise] Updates"],"tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/overview"},"3936":{"id":"/docs/pr-preview/pr-56/platform/updates/overview-0","page_id":"/docs/pr-preview/pr-56/platform/updates/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/overview","content":"What the service does, how it fits with Lamassu IoT, WFX and hawkBit, and where to start."},"3937":{"id":"/docs/pr-preview/pr-56/platform/updates/overview-1","page_id":"/docs/pr-preview/pr-56/platform/updates/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/overview#what-it-connects-to","content":"What it connects to"},"3938":{"id":"/docs/pr-preview/pr-56/platform/updates/overview-2","page_id":"/docs/pr-preview/pr-56/platform/updates/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/overview#choose-your-backend","content":"Choose your backend"},"3939":{"id":"/docs/pr-preview/pr-56/platform/updates/overview-3","page_id":"/docs/pr-preview/pr-56/platform/updates/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/overview#where-to-go-next","content":"Where to go next"},"3940":{"id":"/docs/pr-preview/pr-56/platform/updates/overview-4","page_id":"/docs/pr-preview/pr-56/platform/updates/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/overview","content":"Lamassu Updates (also called the OTA Update Service) orchestrates over-the-air software updates for IoT fleets. You publish an update, choose which devices receive it, and watch the rollout. The service builds the package that SWUpdate clients install, and can sign and encrypt it."},"3941":{"id":"/docs/pr-preview/pr-56/platform/updates/overview-5","page_id":"/docs/pr-preview/pr-56/platform/updates/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/overview","content":"There is one HTTP API and two interchangeable backends behind it, chosen with the `mode` setting. The backend decides which update server the devices talk to, so the systems around the service depend on it."},"3942":{"id":"/docs/pr-preview/pr-56/platform/updates/overview-6","page_id":"/docs/pr-preview/pr-56/platform/updates/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/overview#what-it-connects-to","content":"System"},"3943":{"id":"/docs/pr-preview/pr-56/platform/updates/overview-7","page_id":"/docs/pr-preview/pr-56/platform/updates/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/overview#what-it-connects-to","content":"What it does"},"3944":{"id":"/docs/pr-preview/pr-56/platform/updates/overview-8","page_id":"/docs/pr-preview/pr-56/platform/updates/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/overview#what-it-connects-to","content":"`native`"},"3945":{"id":"/docs/pr-preview/pr-56/platform/updates/overview-9","page_id":"/docs/pr-preview/pr-56/platform/updates/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/overview#what-it-connects-to","content":"`hawkbit`"},"3946":{"id":"/docs/pr-preview/pr-56/platform/updates/overview-10","page_id":"/docs/pr-preview/pr-56/platform/updates/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/overview#what-it-connects-to","content":"Lamassu IoT"},"3947":{"id":"/docs/pr-preview/pr-56/platform/updates/overview-11","page_id":"/docs/pr-preview/pr-56/platform/updates/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/overview#what-it-connects-to","content":"Device registry (device groups) and KMS. Signing keys live in its KMS"},"3948":{"id":"/docs/pr-preview/pr-56/platform/updates/overview-12","page_id":"/docs/pr-preview/pr-56/platform/updates/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/overview#what-it-connects-to","content":"Required"},"3949":{"id":"/docs/pr-preview/pr-56/platform/updates/overview-13","page_id":"/docs/pr-preview/pr-56/platform/updates/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/overview#what-it-connects-to","content":"Optional: without it, groups are read from the `group:<id>` tags on hawkBit's own targets"},"3950":{"id":"/docs/pr-preview/pr-56/platform/updates/overview-14","page_id":"/docs/pr-preview/pr-56/platform/updates/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/overview#what-it-connects-to","content":"WFX"},"3951":{"id":"/docs/pr-preview/pr-56/platform/updates/over