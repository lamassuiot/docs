tform/pki/quickstarts/overview#expected-result","content":"Check"},"2512":{"id":"/docs/pr-preview/pr-56/platform/pki/quickstarts/overview-17","page_id":"/docs/pr-preview/pr-56/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/quickstarts/overview#expected-result","content":"Active root CA and `ca.pem`"},"2513":{"id":"/docs/pr-preview/pr-56/platform/pki/quickstarts/overview-18","page_id":"/docs/pr-preview/pr-56/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/quickstarts/overview#expected-result","content":"It is a CA certificate, is currently valid and its self-signature verifies."},"2514":{"id":"/docs/pr-preview/pr-56/platform/pki/quickstarts/overview-19","page_id":"/docs/pr-preview/pr-56/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/quickstarts/overview#expected-result","content":"End-entity certificate and `device.crt`"},"2515":{"id":"/docs/pr-preview/pr-56/platform/pki/quickstarts/overview-20","page_id":"/docs/pr-preview/pr-56/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/quickstarts/overview#expected-result","content":"It identifies `device-001`, supports client authentication and verifies against `ca.pem`."},"2516":{"id":"/docs/pr-preview/pr-56/platform/pki/quickstarts/overview-21","page_id":"/docs/pr-preview/pr-56/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/quickstarts/overview#expected-result","content":"Private key `device.key`"},"2517":{"id":"/docs/pr-preview/pr-56/platform/pki/quickstarts/overview-22","page_id":"/docs/pr-preview/pr-56/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/quickstarts/overview#expected-result","content":"Its public key matches the one included in `device.crt`."},"2518":{"id":"/docs/pr-preview/pr-56/platform/pki/quickstarts/overview-23","page_id":"/docs/pr-preview/pr-56/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/quickstarts/overview#expected-result","content":"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration."},"2519":{"id":"/docs/pr-preview/pr-56/platform/pki/quickstarts/overview-24","page_id":"/docs/pr-preview/pr-56/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/quickstarts/overview#continue-according-to-your-goal","content":"To operate certificates, continue with Certificates and Validation."},"2520":{"id":"/docs/pr-preview/pr-56/platform/pki/quickstarts/overview-25","page_id":"/docs/pr-preview/pr-56/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/quickstarts/overview#continue-according-to-your-goal","content":"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation."},"2521":{"id":"/docs/pr-preview/pr-56/platform/pki/quickstarts/overview-26","page_id":"/docs/pr-preview/pr-56/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/quickstarts/overview#continue-according-to-your-goal","content":"For the device to request its certificate, prepare the DMS and EST client."},"2522":{"id":"/docs/pr-preview/pr-56/platform/pki/troubleshooting","page_id":"/docs/pr-preview/pr-56/platform/pki/troubleshooting","type":"page","content":"PKI troubleshooting","breadcrumbs":["Docs","Platform","PKI","Troubleshooting"],"tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/troubleshooting"},"2523":{"id":"/docs/pr-preview/pr-56/platform/pki/troubleshooting-0","page_id":"/docs/pr-preview/pr-56/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/troubleshooting","content":"Diagnose certificate issuance, OCSP and CRL."},"2524":{"id":"/docs/pr-preview/pr-56/platform/pki/troubleshooting-1","page_id":"/docs/pr-preview/pr-56/platform/pki/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/troubleshooting#issuance-fails","content":"Issuance fails"},"2525":{"id":"/docs/pr-preview/pr-56/platform/pki/troubleshooting-2","page_id":"/docs/pr-preview/pr-56/platform/pki/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","content":"OCSP or CRL do not reflect a change"},"2526":{"id":"/docs/pr-preview/pr-56/platform/pki/troubleshooting-3","page_id":"/docs/pr-preview/pr-56/platform/pki/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","content":"The chain validates but the connection fails"},"2527":{"id":"/docs/pr-preview/pr-56/platform/pki/troubleshooting-4","page_id":"/docs/pr-preview/pr-56/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/troubleshooting","content":"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics."},"2528":{"id":"/docs/pr-preview/pr-56/platform/pki/troubleshooting-5","page_id":"/docs/pr-preview/pr-56/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/troubleshooting","content":"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics."},"2529":{"id":"/docs/pr-preview/pr-56/platform/pki/troubleshooting-6","page_id":"/docs/pr-preview/pr-56/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/troubleshooting#issuance-fails","content":"Check"},"2530":{"id":"/docs/pr-preview/pr-56/platform/pki/troubleshooting-7","page_id":"/docs/pr-preview/pr-56/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/troubleshooting#issuance-fails","content":"What to inspect"},"2531":{"id":"/docs/pr-preview/pr-56/platform/pki/troubleshooting-8","page_id":"/docs/pr-preview/pr-56/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/troubleshooting#issuance-fails","content":"Next step"},"2532":{"id":"/docs/pr-preview/pr-56/platform/pki/troubleshooting-9","page_id":"/docs/pr-preview/pr-56/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/troubleshooting#issuance-fails","content":"CA"},"2533":{"id":"/docs/pr-preview/pr-56/platform/pki/troubleshooting-10","page_id":"/docs/pr-preview/pr-56/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/troubleshooting#issuance-fails","content":"Exists, is active and has usable dates."},"2534":{"id":"/docs/pr-preview/pr-56/platform/pki/troubleshooting-11","page_id":"/docs/pr-preview/pr-56/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/troubleshooting#issuance-fails","content":"Authorities."},"2535":{"id":"/docs/pr-preview/pr-56/platform/pki/troubleshooting-12","page_id":"/docs/pr-preview/pr-56/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/troubleshooting#issuance-fails","content":"Key"},"2536":{"id":"/docs/pr-preview/pr-56/platform/pki/troubleshooting-13","page_id":"/docs/pr-preview/pr-56/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/troubleshooting#issuance-fails","content":"The record has a usable private key and the engine can sign."},"2537":{"id":"/docs/pr-preview/pr-56/platform/pki/troubleshooting-14","page_id":"/docs/pr-preview/pr-56/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/troubleshooting#issuance-fails","content":"Try **Sign / Verify** in KMS; check provider permissions and availability."},"2538":{"id":"/docs/pr-preview/pr-56/platform/pki/troubleshooting-15","page_id":"/docs/pr-preview/pr-56/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/troubleshooting#issuance-fails","content":"CSR"},"2539":{"id":"/docs/pr-preview/pr-56/platform/pki/troubleshooting-16","page_id":"/docs/pr-preview/pr-56/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/troubleshooting#issuance-fails","content":"Correct PEM and verifiable signature."},"2540":{"id":"/docs/pr-preview/pr-56/platform/pki/troubleshooting-17","page_id":"/docs/pr-preview/pr-56/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/troubleshooting#issuance-fails","content":"`openssl req -in request.csr -noout -verify -text`."},"2541":{"id":"/docs/pr-preview/pr-56/platform/pki/troubleshooting-18","page_id":"/docs/pr-preview/pr-56/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/troubleshooting#issuance-fails","content":"Profile"},"2542":{"id":"/docs/pr-preview/pr-56/platform/pki/troubleshooting-19","page_id":"/docs/pr-preview/pr-56/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/troubleshooting#issuance-fails","content":"Selected source, existing ID, allowed algorithm and size."},"2543":{"id":"/docs/pr-preview/pr-56/platform/pki/troubleshooting-20","page_id":"/docs/pr-preview/pr-56/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/troubleshooting#issuance-fails","content":"Check Profiles precedence; CA and DMS resolve differently."},"2544":{"id":"/docs/pr-preview/pr-56/platform/pki/troubleshooting-21","page_id":"/docs/pr-preview/pr-56/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/troubleshooting#issuance-fails","content":"Result"},"2545":{"id":"/docs/pr-preview/pr-56/platform/pki/troubleshooting-22","page_id":"/docs/pr-preview/pr-56/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/troubleshooting#issuance-fails","content":"Appropriate subject, SAN, usages and dates."},"2546":{"id":"/docs/pr-preview/pr-56/platform/pki/troubleshooting-23","page_id":"/docs/pr-preview/pr-56/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/troubleshooting#issuance-fails","content":"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance."},"2547":{"id":"/docs/pr-preview/pr-56/platform/pki/troubleshooting-24","page_id":"/docs/pr-preview/pr-56/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/troubleshooting#issuance-fails","content":"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration."},"2548":{"id":"/docs/pr-preview/pr-56/platform/pki/troubleshooting-25","page_id":"/docs/pr-preview/pr-56/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/troubleshooting#issuance-fails","content":"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation."},"2549":{"id":"/docs/pr-preview/pr-56/platform/pki/troubleshooting-26","page_id":"/docs/pr-preview/pr-56/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","content":"Check each boundary independently:"},"2550":{"id":"/docs/pr-preview/pr-56/platform/pki/troubleshooting-27","page_id":"/docs/pr-preview/pr-56/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","content":"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions."},"2551":{"id":"/docs/pr-preview/pr-56/platform/pki/troubleshooting-28","page_id":"/docs/pr-preview/pr-56/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","content":"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy."},"2552":{"id":"/docs/pr-preview/pr-56/platform/pki/troubleshooting-29","page_id":"/docs/pr-preview/pr-56/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","content":"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`."},"2553":{"id":"/docs/pr-preview/pr-56/platform/pki/troubleshooting-30","page_id":"/docs/pr-preview/pr-56/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","content":"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator."},"2554":{"id":"/docs/pr-preview/pr-56/platform/pki/troubleshooting-31","page_id":"/docs/pr-preview/pr-56/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","content":"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection."},"2555":{"id":"/docs/pr-preview/pr-56/platform/pki/troubleshooting-32","page_id":"/docs/pr-preview/pr-56/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","content":"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure."},"2556":{"id":"/docs/pr-preview/pr-56/platform/pki/troubleshooting-33","page_id":"/docs/pr-preview/pr-56/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","content":"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests."},"2557":{"id":"/docs/pr-preview/pr-56/platform/pki/troubleshooting-34","page_id":"/docs/pr-preview/pr-56/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","content":"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures."},"2558":{"id":"/docs/pr-preview/pr-56/platform/updates/architecture","page_id":"/docs/pr-preview/pr-56/platform/updates/architecture","type":"page","content":"Architecture","breadcrumbs":["Docs","Platform","[Enterprise] Updates","Concepts"],"tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/architecture"},"2559":{"id":"/docs/pr-preview/pr-56/platform/updates/architecture-0","page_id":"/docs/pr-preview/pr-56/platform/updates/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/architecture","content":"The components of Lamassu Updates, how they connect in each backend, and what runs in the background."},"2560":{"id":"/docs/pr-preview/pr-56/platform/updates/architecture-1","page_id":"/docs/pr-preview/pr-56/platform/updates/architecture","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/architecture#native-mode","content":"Native mode"},"2561":{"id":"/docs/pr-preview/pr-56/platform/updates/architecture-2","page_id":"/docs/pr-preview/pr-56/platform/updates/architecture","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/architecture#how-devices-connect","content":"How devices connect"},"2562":{"id":"/docs/pr-preview/pr-56/platform/updates/architecture-3","page_id":"/docs/pr-preview/pr-56/platform/updates/architecture","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/architecture#hawkbit-mode","content":"hawkBit mode"},"2563":{"id":"/docs/pr-preview/pr-56/platform/updates/architecture-4","page_id":"/docs/pr-preview/pr-56/platform/updates/architecture","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/architecture#how-devices-connect-1","content":"How devices connect"},"2564":{"id":"/docs/pr-preview/pr-56/platform/updates/architecture-5","page_id":"/docs/pr-preview/pr-56/platform/updates/architecture","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/architecture#what-runs-inside-the-service","content":"What runs inside the service"},"2565":{"id":"/docs/pr-preview/pr-56/platform/updates/architecture-6","page_id":"/docs/pr-preview/pr-56/platform/updates/architecture","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/architecture#dependencies","content":"Dependencies"},"2566":{"id":"/docs/pr-preview/pr-56/platform/updates/architecture-7","page_id":"/docs/pr-preview/pr-56/platform/updates/architecture","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/architecture#where-things-are-stored","content":"Where things are stored"},"2567":{"id":"/docs/pr-preview/pr-56/platform/updates/architecture-8","page_id":"/docs/pr-preview/pr-56/platform/updates/architecture","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/architecture#running-more-than-one-replica","content":"Running more than one replica"},"2568":{"id":"/docs/pr-preview/pr-56/platform/updates/architecture-9","page_id":"/docs/pr-preview/pr-56/platform/updates/architecture","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/architecture#next-steps","content":"Next steps"},"2569":{"id":"/docs/pr-preview/pr-56/platform/updates/architecture-10","page_id":"/docs/pr-preview/pr-56/platform/updates/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/architecture","content":"Lamassu Updates is one process that serves the Updates API (`/updates/v1`) and, embedded in it, SymKMS (`/symkms/v1`). It also answers `GET /health`. Behind the API there are two interchangeable backends. The `mode` setting picks one when the service starts. Clients, including the Lamassu dashboard, cannot tell them apart except through capabilities."},"2570":{"id":"/docs/pr-preview/pr-56/platform/updates/architecture-11","page_id":"/docs/pr-preview/pr-56/platform/updates/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/architecture#native-mode","content":"In native mode the service owns the data. Postgres holds packs, launches and device history, WFX holds one job per device, and the service drives both."},"2571":{"id":"/docs/pr-preview/pr-56/platform/updates/architecture-12","page_id":"/docs/pr-preview/pr-56/platform/updates/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/architecture#native-mode","content":"The service is one process. Its parts, and which of them use which dependency, are in What runs inside the service."},"2572":{"id":"/docs/pr-preview/pr-56/platform/updates/architecture-13","page_id":"/docs/pr-preview/pr-56/platform/updates/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/architecture#how-devices-connect","content":"A device never talks to the service except to download its package. It polls WFX for jobs and reports each state change to WFX. The service learns about the changes from WFX's event stream."},"2573":{"id":"/docs/pr-preview/pr-56/platform/updates/architecture-14","page_id":"/docs/pr-preview/pr-56/platform/updates/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/architecture#how-devices-connect","content":"The download address in each job is the pack's download route under `update_domain`, with the device ID appended so per-device packages and gateway authorization work. When the `builds` blob store is on S3 with presigned downloads enabled, a download is answered with a `302` to a short-lived signed URL of the object instead of streaming the bytes through the service. Local storage always streams. Both support `Range` requests, so an interrupted download resumes."},"2574":{"id":"/docs/pr-preview/pr-56/platform/updates/architecture-15","page_id":"/docs/pr-preview/pr-56/platform/updates/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/architecture#hawkbit-mode","content":"In hawkBit mode the service is a gateway. Packs become distribution sets, launches become rollouts, and hawkBit owns that data and is read live on every request. The service keeps in Postgres only what hawkBit has no place for. See Data model."},"2575":{"id":"/docs/pr-preview/pr-56/platform/updates/architecture-16","page_id":"/docs/pr-preview/pr-56/platform/updates/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/architecture#how-devices-connect-1","content":"Devices talk to hawkBit and never to this service for polling. They poll hawkBit's DDI API and send their feedback to it. The service reads progress back from hawkBit whenever it is asked, and has no event stream to follow."},"2576":{"id":"/docs/pr-preview/pr-56/platform/updates/architecture-17","page_id":"/docs/pr-preview/pr-56/platform/updates/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/architecture#how-devices-connect-1","content":"The artifact download can also go through this service. It serves hawkBit's device artifact route (`/{tenant}/controller/v1/{controllerId}/softwaremodules/{id}/artifacts/{filename}`, under the path of `hawkbit.ddi_url`) unrewritten, so a gateway in front of both keeps matching its authorization rules. The service answers only for a module assigned to, or installed on, that device, and otherwise returns `404`. With presigning enabled on `hawkbit.artifact_store` it redirects (`302`) to a signed URL of hawkBit's S3 bucket. See Connect a device."},"2577":{"id":"/docs/pr-preview/pr-56/platform/updates/architecture-18","page_id":"/docs/pr-preview/pr-56/platform/updates/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/architecture#what-runs-inside-the-service","content":"Part"},"2578":{"id":"/docs/pr-preview/pr-56/platform/updates/architecture-19","page_id":"/docs/pr-preview/pr-56/platform/updates/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/architecture#what-runs-inside-the-service","content":"What it does"},"2579":{"id":"/docs/pr-preview/pr-56/platform/updates/architecture-20","page_id":"/docs/pr-preview/pr-56/platform/updates/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/architecture#what-runs-inside-the-service","content":"Native"},"2580":{"id":"/docs/pr-preview/pr-56/platform/updates/architecture-21","page_id":"/docs/pr-preview/pr-56/platform/updates/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/architecture#what-runs-inside-the-service","content":"hawkBit"},"2581":{"id":"/docs/pr-preview/pr-56/platform/updates/architecture-22","page_id":"/docs/pr-preview/pr-56/platform/updates/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/architecture#what-runs-inside-the-service","content":"Updates API"},"2582":{"id":"/docs/pr-preview/pr-56/platform/updates/architecture-23","page_id":"/docs/pr-preview/pr-56/platform/updates/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/architecture#what-runs-inside-the-service","content":"Packs, modules, artifacts, launches, device inventory, version compliance"},"2583":{"id":"/docs/pr-preview/pr-56/platform/updates/architecture-24","page_id":"/docs/pr-preview/pr-56/platform/updates/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/architecture#what-runs-inside-the-service","content":"Yes"},"2584":{"id":"/docs/pr-preview/pr-56/platform/updates/architecture-25","page_id":"/docs/pr-preview/pr-56/platform/updates/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/architecture#what-runs-inside-the-service","content":"Yes (translated to hawkBit calls)"},"2585":{"id":"/docs/pr-preview/pr-56/platform/updates/architecture-26","page_id":"/docs/pr-preview/pr-56/platform/updates/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/architecture#what-runs-inside-the-service","content":"SymKMS"},"2586":{"id":"/docs/pr-preview/pr-56/platform/updates/architecture-27","page_id":"/docs/pr-preview/pr-56/platform/updates/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/architecture#what-runs-inside-the-service","content":"Stores symmetric keys and assigns them to devices. Used by shared and per-device encryption"},"2587":{"id":"/docs/pr-preview/pr-56/platform/updates/architecture-28","page_id":"/docs/pr-preview/pr-56/platform/up