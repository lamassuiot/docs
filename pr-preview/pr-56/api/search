view/pr-56/es/platform/iot-fleets/quickstarts/enroll-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar","content":"Antes de empezar"},"1581":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device-2","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","content":"Prepara la credencial inicial"},"1582":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device-3","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","content":"Configura el DMS de evaluación"},"1583":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device-4","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","content":"Prepara el cliente y comprueba cacerts"},"1584":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device-5","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","content":"Enrola el dispositivo"},"1585":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device-6","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","content":"Verifica la identidad obtenida"},"1586":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device-7","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","content":"Demuestra una conexión mTLS"},"1587":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device-8","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","content":"Resultado y continuidad"},"1588":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device-9","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device","content":"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo."},"1589":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device-10","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar","content":"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados."},"1590":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device-11","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar","content":"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido."},"1591":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device-12","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar","content":"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`."},"1592":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device-13","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar","content":"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola."},"1593":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device-14","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar","content":"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue."},"1594":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device-15","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","content":"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena."},"1595":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device-16","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","content":"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población."},"1596":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device-17","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","content":"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles."},"1597":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device-18","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","content":"Crea el DMS `Acme EST Evaluation` con esta configuración:"},"1598":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device-19","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","content":"Ajuste"},"1599":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device-20","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","content":"Valor de evaluación"},"1600":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device-21","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","content":"Enrollment CA"},"1601":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device-22","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","content":"Raíz emisora de `device-root.pem`."},"1602":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device-23","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","content":"Perfil de emisión"},"1603":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device-24","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","content":"Perfil final de 1 hora que acabas de preparar."},"1604":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device-25","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","content":"Protocol / Registration Mode"},"1605":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device-26","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","content":"`EST_RFC7030` / `JITP`."},"1606":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device-27","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","content":"Verify CSR Signature"},"1607":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device-28","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","content":"Habilitado."},"1608":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device-29","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","content":"Enable Replaceable Enrollment"},"1609":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device-30","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","content":"Deshabilitado; el ID debe ser nuevo."},"1610":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/