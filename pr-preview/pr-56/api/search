56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#vocabulario","content":"Un despliegue de una versión de un paquete sobre los dispositivos de un grupo"},"2700":{"id":"/docs/pr-preview/pr-56/es/platform/updates/concepts-29","page_id":"/docs/pr-preview/pr-56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#vocabulario","content":"`launch`"},"2701":{"id":"/docs/pr-preview/pr-56/es/platform/updates/concepts-30","page_id":"/docs/pr-preview/pr-56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#vocabulario","content":"Trabajo (job)"},"2702":{"id":"/docs/pr-preview/pr-56/es/platform/updates/concepts-31","page_id":"/docs/pr-preview/pr-56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#vocabulario","content":"La actualización de un dispositivo dentro de un lanzamiento"},"2703":{"id":"/docs/pr-preview/pr-56/es/platform/updates/concepts-32","page_id":"/docs/pr-preview/pr-56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#vocabulario","content":"job, device assignment"},"2704":{"id":"/docs/pr-preview/pr-56/es/platform/updates/concepts-33","page_id":"/docs/pr-preview/pr-56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#paquetes-de-actualización","content":"Un paquete tiene una **versión** (semántica, `x.y.z`) y un **estado**:"},"2705":{"id":"/docs/pr-preview/pr-56/es/platform/updates/concepts-34","page_id":"/docs/pr-preview/pr-56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#paquetes-de-actualización","content":"Estado"},"2706":{"id":"/docs/pr-preview/pr-56/es/platform/updates/concepts-35","page_id":"/docs/pr-preview/pr-56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#paquetes-de-actualización","content":"Significado"},"2707":{"id":"/docs/pr-preview/pr-56/es/platform/updates/concepts-36","page_id":"/docs/pr-preview/pr-56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#paquetes-de-actualización","content":"`draft`"},"2708":{"id":"/docs/pr-preview/pr-56/es/platform/updates/concepts-37","page_id":"/docs/pr-preview/pr-56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#paquetes-de-actualización","content":"Editable. Se pueden añadir o reemplazar artefactos. Aún no está construido."},"2709":{"id":"/docs/pr-preview/pr-56/es/platform/updates/concepts-38","page_id":"/docs/pr-preview/pr-56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#paquetes-de-actualización","content":"`built`"},"2710":{"id":"/docs/pr-preview/pr-56/es/platform/updates/concepts-39","page_id":"/docs/pr-preview/pr-56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#paquetes-de-actualización","content":"El entregable existe. La versión es inmutable. Crea una versión nueva para cambiarla."},"2711":{"id":"/docs/pr-preview/pr-56/es/platform/updates/concepts-40","page_id":"/docs/pr-preview/pr-56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#paquetes-de-actualización","content":"`build_failed`"},"2712":{"id":"/docs/pr-preview/pr-56/es/platform/updates/concepts-41","page_id":"/docs/pr-preview/pr-56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#paquetes-de-actualización","content":"Se intentó construir y falló. Sigue siendo editable y se puede reintentar. El motivo está en `last_build_error`."},"2713":{"id":"/docs/pr-preview/pr-56/es/platform/updates/concepts-42","page_id":"/docs/pr-preview/pr-56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#paquetes-de-actualización","content":"Un paquete tiene un **empaquetado** (packaging):"},"2714":{"id":"/docs/pr-preview/pr-56/es/platform/updates/concepts-43","page_id":"/docs/pr-preview/pr-56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#paquetes-de-actualización","content":"Empaquetado"},"2715":{"id":"/docs/pr-preview/pr-56/es/platform/updates/concepts-44","page_id":"/docs/pr-preview/pr-56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#paquetes-de-actualización","content":"Se entrega como"},"2716":{"id":"/docs/pr-preview/pr-56/es/platform/updates/concepts-45","page_id":"/docs/pr-preview/pr-56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#paquetes-de-actualización","content":"Estado terminal del workflow"},"2717":{"id":"/docs/pr-preview/pr-56/es/platform/updates/concepts-46","page_id":"/docs/pr-preview/pr-56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#paquetes-de-actualización","content":"`swu`"},"2718":{"id":"/docs/pr-preview/pr-56/es/platform/updates/concepts-47","page_id":"/docs/pr-preview/pr-56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#paquetes-de-actualización","content":"Un `.swu` construido con swugenerator, opcionalmente firmado y cifrado"},"2719":{"id":"/docs/pr-preview/pr-56/es/platform/updates/concepts-48","page_id":"/docs/pr-preview/pr-56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#paquetes-de-actualización","content":"`ACTIVATED`"},"2720":{"id":"/docs/pr-preview/pr-56/es/platform/updates/concepts-49","page_id":"/docs/pr-preview/pr-56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#paquetes-de-actualización","content":"`non-swu`"},"2721":{"id":"/docs/pr-preview/pr-56/es/platform/updates/concepts-50","page_id":"/docs/pr-preview/pr-56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#paquetes-de-actualización","content":"Los artefactos en bruto. El modo nativo construye un paquete `.tar.gz` (opcionalmente cifrado, `.tar.gz.enc`). El modo hawkBit entrega el único fichero de un módulo `raw` tal como se subió (opcionalmente cifrado) y archiva varios ficheros como `<name>.tar.gz`"},"2722":{"id":"/docs/pr-preview/pr-56/es/platform/updates/concepts-51","page_id":"/docs/pr-preview/pr-56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#paquetes-de-actualización","content":"`INSTALLED`"},"2723":{"id":"/docs/pr-preview/pr-56/es/platform/updates/concepts-52","page_id":"/docs/pr-preview/pr-56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#paquetes-de-actualización","content":"Un paquete también puede llevar **precondiciones**: reglas como «el dispositivo ya debe tener el paquete X en la versión 1.2.0 o superior», o «el módulo `os:gateway-fw` en la versión 2.1.0 o superior». Cada precondición nombra exactamente un paquete (`required_distribution_set_name`) o un módulo (`required_module_key`) y una `min_version` semántica. Un dispositivo que no cumple una precondición no es desplegable, salvo que un operador fuerce el lanzamiento. Cada lanzamiento registra qué dispositivos fallaron y por qué."},"2724":{"id":"/docs/pr-preview/pr-56/es/platform/updates/concepts-53","page_id":"/docs/pr-preview/pr-56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#módulos-de-software","content":"Un paquete es una composición de módulos. Contiene un módulo `os` (el ancla obligatoria) y cualquier número de módulos `application`. En modo nativo, un paquete sin filas de módulo se muestra con un módulo implícito `os:<nombre del paquete>`, y los ficheros que subes al paquete le pertenecen. Un módulo guarda sus propios ficheros y, opcionalmente, notas de versión. Puedes:"},"2725":{"id":"/docs/pr-preview/pr-56/es/platform/updates/concepts-54","page_id":"/docs/pr-preview/pr-56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#módulos-de-software","content":"crear un módulo por separado en el **catálogo** (`POST /updates/v1/softwaremodules`) y componer paquetes con él más adelante,"},"2726":{"id":"/docs/pr-preview/pr-56/es/platform/updates/concepts-55","page_id":"/docs/pr-preview/pr-56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#módulos-de-software","content":"añadir un módulo directamente a un paquete, o"},"2727":{"id":"/docs/pr-preview/pr-56/es/platform/updates/concepts-56","page_id":"/docs/pr-preview/pr-56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#módulos-de-software","content":"importar un módulo que ya tiene otro paquete."},"2728":{"id":"/docs/pr-preview/pr-56/es/platform/updates/concepts-57","page_id":"/docs/pr-preview/pr-56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#módulos-de-software","content":"La **intención de entrega** (delivery intent) de un módulo indica cómo se enviará: `undecided` (por defecto), `swu-build`, `swu-prebuilt` o `raw`."},"2729":{"id":"/docs/pr-preview/pr-56/es/platform/updates/concepts-58","page_id":"/docs/pr-preview/pr-56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#módulos-de-software","content":"Cómo se relacionan los módulos con la construcción depende del backend:"},"2730":{"id":"/docs/pr-preview/pr-56/es/platform/updates/concepts-59","page_id":"/docs/pr-preview/pr-56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#módulos-de-software","content":"**native**: los módulos son *entradas de la construcción*. El paquete construye un único `.swu` con todos ellos, y un lanzamiento envía a cada dispositivo una única dirección de descarga."},"2731":{"id":"/docs/pr-preview/pr-56/es/platform/updates/concepts-60","page_id":"/docs/pr-preview/pr-56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#módulos-de-software","content":"**hawkbit**: cada módulo tiene su *propio entregable*, construido en el catálogo de módulos antes de que exista el paquete. Solo los módulos ya construidos se pueden enlazar a un paquete, y un módulo enlazado queda congelado. hawkBit entrega al dispositivo los artefactos de cada módulo, de modo que un paquete con varios módulos se instala como varias transacciones SWUpdate independientes. SWUpdate no puede hacer rollback entre varios ficheros `.swu`."},"2732":{"id":"/docs/pr-preview/pr-56/es/platform/updates/concepts-61","page_id":"/docs/pr-preview/pr-56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#módulos-de-software","content":"La importación de un módulo también difiere. En modo hawkBit la importación lo **enlaza**, así que ambos paquetes comparten el módulo y una reconstrucción se ve en los dos. En modo nativo lo **copia**, así que los dos divergen después. El listado de módulos reutilizables te indica cuál obtendrás (`shared`)."},"2733":{"id":"/docs/pr-preview/pr-56/es/platform/updates/concepts-62","page_id":"/docs/pr-preview/pr-56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#campañas-de-lanzamiento","content":"Un lanzamiento despliega una versión de un paquete sobre los dispositivos de un grupo en **lotes**."},"2734":{"id":"/docs/pr-preview/pr-56/es/platform/updates/concepts-63","page_id":"/docs/pr-preview/pr-56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#estrategia","content":"Campo"},"2735":{"id":"/docs/pr-preview/pr-56/es/platform/updates/concepts-64","page_id":"/docs/pr-preview/pr-56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#estrategia","content":"Significado"},"2736":{"id":"/docs/pr-preview/pr-56/es/platform/updates/concepts-65","page_id":"/docs/pr-preview/pr-56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#estrategia","content":"`rollout_type`"},"2737":{"id":"/docs/pr-preview/pr-56/es/platform/updates/concepts-66","page_id":"/docs/pr-preview/pr-56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#estrategia","content":"Cómo se dimensiona un lote. Solo `percentage` hace que `rollout_value` sea un porcentaje. Cualquier otro valor (`fixed`, o `numeric`, que es el que envía el dashboard) lo convierte en un número de dispositivos"},"2738":{"id":"/docs/pr-preview/pr-56/es/platform/updates/concepts-67","page_id":"/docs/pr-preview/pr-56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#estrategia","content":"`rollout_value`"},"2739":{"id":"/docs/pr-preview/pr-56/es/platform/updates/concepts-68","page_id":"/docs/pr-preview/pr-56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#estrategia","content":"El porcentaje o el número de dispositivos. Debe ser mayor que 0"},"2740":{"id":"/docs/pr-preview/pr-56/es/platform/updates/concepts-69","page_id":"/docs/pr-preview/pr-56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#estrategia","content":"`workflow_type`"},"2741":{"id":"/docs/pr-preview/pr-56/es/platform/updates/concepts-70","page_id":"/docs/pr-preview/pr-56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#estrategia","content":"El workflow de WFX: `direct` (sin confirmación), `phased` (con pasos de confirmación) o `download-install`. Usa `download-install` para paquetes `non-swu`. Cualquier otro valor se pasa a WFX como nombre completo de workflow, como `wfx.workflow.dau.simple`. En modo hawkBit no hay WFX: `phased` se convierte en una acción soft de hawkBit (el dispositivo confirma o pospone) y cualquier otro valor en una acción forced"},"2742":{"id":"/docs/pr-preview/pr-56/es/platform/updates/concepts-71","page_id":"/docs/pr-preview/pr-56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#estrategia","content":"`test_device_id`"},"2743":{"id":"/docs/pr-preview/pr-56/es/platform/updates/concepts-72","page_id":"/docs/pr-preview/pr-56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#estrategia","content":"Un canario. El primer lote es este único dispositivo, y debe tener éxito antes de tocar a ningún otro"},"2744":{"id":"/docs/pr-preview/pr-56/es/platform/updates/concepts-73","page_id":"/docs/pr-preview/pr-56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#estrategia","content":"`auto`"},"2745":{"id":"/docs/pr-preview/pr-56/es/platform/updates/concepts-74","page_id":"/docs/pr-preview/pr-56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#estrategia","content":"Libera el siguiente lote automáticamente cuando se cumplen las condiciones"},"2746":{"id":"/docs/pr-preview/pr-56/es/platform/updates/concepts-75","page_id":"/docs/pr-preview/pr-56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#estrategia","content":"`approval_threshold`"},"2747":{"id":"/docs/pr-preview/pr-56/es/platform/updates/concepts-76","page_id":"/docs/pr-preview/pr-56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#estrategia","content":"% del lote actual que debe tener éxito antes de empezar el siguiente (0 a 100). Sin definir, 0 o 100 significa el lote completo"},"2748":{"id":"/docs/pr-preview/pr-56/es/platform/updates/concepts-77","page_id":"/docs/pr-preview/pr-56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#estrategia","content":"`error_threshold`"},"2749":{"id":"/docs/pr-preview/pr-56/es/platform/updates/concepts-78","page_id":"/docs/pr-preview/pr-56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#estrategia","content":"El lanzamiento se cancela cuando este % de todos los dispositivos ha fallado (redondeado hacia arriba: con el 10 % de 100 dispositivos se cancela en el décimo fallo). `0` significa sin límite"},"2750":{"id":"/docs/pr-preview/pr-56/es/platform/updates/concepts-79","page_id":"/docs/pr-preview/pr-56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#estrategia","content":"`scheduled_at`"},"2751":{"id":"/docs/pr-preview/pr-56/es/platform/updates/concepts-80","page_id":"/docs/pr-preview/pr-56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#estrategia","content":"Hora de inicio prevista (RFC 3339). El modo nativo lanza el primer lote cuando pasa esa hora (consulta cada 30 segundos); el modo hawkBit se la entrega a hawkBit como hora de inicio del rollout"},"2752":{"id":"/docs/pr-preview/pr-56/es/platform/updates/concepts-81","page_id":"/docs/pr-preview/pr-56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#estrategia","content":"`name`, `description`"},"2753":{"id":"/docs/pr-preview/pr-56/es/platform/updates/concepts-82","page_id":"/docs/pr-preview/pr-56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#estrategia","content":"Nombre para mostrar (por defecto, el nombre del paquete) y notas de texto libre"},"2754":{"id":"/docs/pr-preview/pr-56/es/platform/updates/concepts-83","page_id":"/docs/pr-preview/pr-56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#estrategia","content":"`weight`"},"2755":{"id":"/docs/pr-preview/pr-56/es/platform/updates/concepts-84","page_id":"/docs/pr-preview/pr-56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#estrategia","content":"Una pista de prioridad almacenada, de 0 a 1000. Nada la lee"},"2756":{"id":"/docs/pr-preview/pr-56/es/platform/updates/concepts-85","page_id":"/docs/pr-preview/pr-56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#ciclo-de-vida","content":"Un lanzamiento está `running`, `paused` (se puede reanudar), `cancelled` (terminal) o `completed` (terminal). Un dispositivo dentro de él pasa de `pending` → `active` → `completed` o `failed`. Puedes reintentar solo los dispositivos fallidos (`retry-failed`). En modo nativo esto también reabre un lanzamiento terminado o cancelado. Los controles del operador son `rollout`, `pause`, `resume`, `cancel`, `complete` y `retry-failed`, y la estrategia se puede editar mientras el lanzamiento exista. El modo nativo los soporta todos. El modo hawkBit no tiene `complete` ni edición de la estrategia, porque los grupos y umbrales de un rollout se fijan al crearlo (consulta Capacidades)."},"2757":{"id":"/docs/pr-preview/pr-56/es/platform/updates/concepts-86","page_id":"/docs/pr-preview/pr-56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#versiones-cumplimiento-e-inventario","content":"Además de los lanzamientos puntuales, puedes declarar la **última versión** de un paquete para un grupo. El servicio informa entonces de la **desviación** (drift): los dispositivos que no están en la última versión. Puedes forzar un dispositivo a la última versión, o a una exacta. Consulta la referencia de la API."},"2758":{"id":"/docs/pr-preview/pr-56/es/platform/updates/concepts-87","page_id":"/docs/pr-preview/pr-56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#versiones-cumplimiento-e-inventario","content":"El servicio también mantiene un **inventario de dispositivos**: qué versión de paquete lleva ahora cada dispositivo, con los artefactos que declara el manifiesto de esa versión, y el historial de intentos de actualización. Ambos se rellenan a medida que se ejecutan los lanzamientos del servicio."},"2759":{"id":"/docs/pr-preview/pr-56/es/platform/updates/concepts-88","page_id":"/docs/pr-preview/pr-56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#cómo-llega-una-actualización-a-un-dispositivo-modo-nativo","content":"La máquina de estados del lado del dispositivo es un workflow de WFX, en `wfx/workflow/dau/` del repositorio:"},"2760":{"id":"/docs/pr-preview/pr-56/es/platform/updates/concepts-89","page_id":"/docs/pr-preview/pr-56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#cómo-llega-una-actualización-a-un-dispositivo-modo-nativo","content":"Fichero de workflow"},"2761":{"id":"/docs/pr-preview/pr-56/es/platform/updates/concepts-90","page_id":"/docs/pr-preview/pr-56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#cómo-llega-una-actualización-a-un-dispositivo-modo-nativo","content":"Estados"},"2762":{"id":"/docs/pr-preview/pr-56/es/platform/updates/concepts-91","page_id":"/docs/pr-preview/pr-56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#cómo-llega-una-actualización-a-un-dispositivo-modo-nativo","content":"Uso"},"2763":{"id":"/docs/pr-preview/pr-56/es/platform/updates/concepts-92","page_id":"/docs/pr-preview/pr-56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#cómo-llega-una-actualización-a-un-dispositivo-modo-nativo","content":"`wfx.workflow.dau.direct.yml`"},"2764":{"id":"/docs/pr-preview/pr-56/es/platform/updates/concepts-93","page_id":"/docs/pr-preview/pr-56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#cómo-llega-una-actualización-a-un-dispositivo-modo-nativo","content":"INSTALL → INSTALLING → INSTALLED → ACTIVATE → ACTIVATING → ACTIVATED"},"2765":{"id":"/docs/pr-preview/pr-56/es/platform/updates/concepts-94","page_id":"/docs/pr-preview/pr-56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#cómo-llega-una-actualización-a-un-dispositivo-modo-nativo","content":"Paquetes SWU, sin confirmación"},"2766":{"id":"/docs/pr-preview/pr-56/es/platform/updates/concepts-95","page_id":"/docs/pr-preview/pr-56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#cómo-llega-una-actualización-a-un-dispositivo-modo-nativo","content":"`wfx.workflow.dau.phased.yml`"},"2767":{"id":"/docs/pr-preview/pr-56/es/platform/updates/concepts-96","page_id":"/docs/pr-preview/pr-56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#cómo-llega-una-actualización-a-un-dispositivo-modo-nativo","content":"CREATED → DOWNLOAD → … → ACTIVATED"},"2768":{"id":"/docs/pr-preview/pr-56/es/platform/updates/concepts-97","page_id":"/docs/pr-preview/pr-56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#cómo-llega-una-actualización-a-un-dispositivo-modo-nativo","content":"Paquetes SWU, con pasos de confirmación"},"2769":{"id":"/docs/pr-preview/pr-56/es/platform/updates/concepts-98","page_id":"/docs/pr-preview/pr-56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#cómo-llega-una-actualización-a-un-dispositivo-modo-nativo","content":"`wfx.workflow.dau.download-install.yml`"},"2770":{"id":"/docs/pr-preview/pr-56/es/platform/updates/concepts-99","page_id":"/docs/pr-preview/pr-56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#cómo-llega-una-actualización-a-un-dispositivo-modo-nativo","content":"DOWNLOAD → DOWNLOADING → DOWNLOADED → INSTALL → INSTALLING → INSTALLED"},"2771":{"id":"/docs/pr-preview/pr-56/es/platform/updates/concepts-100","page_id":"/docs/pr-preview/pr-56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#cómo-llega-una-actualización-a-un-dispositivo-modo-nativo","content":"Paquetes `non-swu`. Se selecciona con `workflow_type`: un lanzamiento no lo elige por ti"},"2772":{"id":"/docs/pr-preview/pr-56/es/platform/updates/concepts-101","page_id":"/docs/pr-preview/pr-56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#cómo-llega-una-actualización-a-un-dispositivo-modo-nativo","content":"`wfx.workflow.dau.simple.yml`"},"2773":{"id":"/docs/pr-preview/pr-56/es/platform/updates/concepts-102","page_id":"/docs/pr-preview/pr-56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#cómo-llega-una-actualización-a-un-dispositivo-modo-nativo","content":"DOWNLOAD → INSTALL → INSTALLED o TERMINATED"},"2774":{"id":"/docs/pr-preview/pr-56/es/platform/updates/concepts-103","page_id":"/docs/pr-preview/pr-56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#cómo-llega-una-actualización-a-un-dispositivo-modo-nativo","content":"Flujo mínimo"},"2775":{"id":"/docs/pr-preview/pr-56/es/platform/updates/concepts-104","page_id":"/docs/pr-preview/pr-56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#cómo-llega-una-actualización-a-un-dispositivo-modo-nativo","content":"Todos los workflows terminan en `TERMINATED` si hay un fallo. El servicio registra los cuatro ficheros al arrancar. `workflow_file` debe nombrar el fichero `direct`, y los otros tres se buscan a su lado sustituyendo `direct` en el nombre del fichero (consulta Configuración). En modo hawkBit no hay jobs de WFX: consulta Modo hawkBit."},"2776":{"id":"/docs/pr-preview/pr-56/es/platform/updates/concepts-105","page_id":"/docs/pr-preview/pr-56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#siguientes-pasos","content":"<Card title=\"Arquitectura\" description=\"Los componentes y lo que se ejecuta dentro del servicio.\" href=\"/docs/platform/updates/architecture\" />"},"2777":{"id":"/docs/pr-preview/pr-56/es/platform/updates/concepts-106","page_id":"/docs/pr-preview/pr-56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#siguientes-pasos","content":"<Card title=\"Flujos\" description=\"Diagramas de secuencia de cada operación importante.\" href=\"/docs/platform/updates/flows\" />"},"2778":{"id":"/docs/pr-preview/pr-56/es/platform/updates/concepts-107","page_id":"/docs/pr-preview/pr-56/es/platform/updates/concepts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/concepts#siguientes-pasos","content":"<Card title=\"Publicar y desplegar una actualización\" description=\"Hazlo de principio a fin.\" href=\"/docs/platform/updates/guides/publish-and-roll-out\" />"},"2779":{"id":"/docs/pr-preview/pr-56/es/platform/updates/data-model","page_id":"/docs/pr-preview/pr-56/es/platform/updates/data-model","type":"page","content":"Modelo de datos","breadcrumbs":["Docs","Plataforma","[Enterprise] Actualizaciones","Conceptos"],"tags":[],"url":"/docs/pr-preview/pr-56/es/platform/updates/data-model"},"2780":{"id":"/docs/pr-preview/pr-56/es/platform/updates/data-model-0","page_id":"/docs/pr-preview/pr-56/es/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/data-model","content":"Las tablas que guarda el servicio, cómo se relacionan y cómo se crea y migra el esquema."},"2781":{"id":"/docs/pr-preview/pr-56/es/platform/updates/data-model-1","page_id":"/docs/pr-preview/pr-56/es/platform/updates/data-model","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/updates/data-model#tablas-del-modo-nativo","content":"Tablas del modo nativo"},"2782":{"id":"/docs/pr-preview/pr-56/es/platform/updates/data-model-2","page_id":"/docs/pr-preview/pr-56/es/platform/updates/data-model","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/updates/data-model#tablas-del-modo-hawkbit","content":"Tablas del modo hawkBit"},"2783":{"id":"/docs/pr-preview/pr-56/es/platform/updates/data-model-3","page_id":"/docs/pr-preview/pr-56/es/platform/updates/data-model","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/updates/data-model#diagramas-entidad-relación","content":"Diagramas entidad-relación"},"2784":{"id":"/docs/pr-preview/pr-56/es/platform/updates/data-mo