de pack publicada, o hawkBit lo bloqueó) queda bloqueado: su contenido está protegido, mientras que las notas de versión siguen siendo editables. En modo native el pack compila un único `.swu` a partir de las entradas de todos sus módulos, y un SWU precompilado se sube al pack completo en lugar de importarse como entrada de un módulo."},"4403":{"id":"/docs/pr-preview/pr-56/es/platform/updates/reference/api-393","page_id":"/docs/pr-preview/pr-56/es/platform/updates/reference/api","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/reference/api#cuerpos-de-las-peticiones-1","content":"Ruta"},"4404":{"id":"/docs/pr-preview/pr-56/es/platform/updates/reference/api-394","page_id":"/docs/pr-preview/pr-56/es/platform/updates/reference/api","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/reference/api#cuerpos-de-las-peticiones-1","content":"Cuerpo"},"4405":{"id":"/docs/pr-preview/pr-56/es/platform/updates/reference/api-395","page_id":"/docs/pr-preview/pr-56/es/platform/updates/reference/api","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/reference/api#cuerpos-de-las-peticiones-1","content":"`POST .../modules`, `POST /softwaremodules`"},"4406":{"id":"/docs/pr-preview/pr-56/es/platform/updates/reference/api-396","page_id":"/docs/pr-preview/pr-56/es/platform/updates/reference/api","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/reference/api#cuerpos-de-las-peticiones-1","content":"`type` (`os` o `application`), `name` (sin `/` ni `:`), `version`, `delivery_intent`"},"4407":{"id":"/docs/pr-preview/pr-56/es/platform/updates/reference/api-397","page_id":"/docs/pr-preview/pr-56/es/platform/updates/reference/api","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/reference/api#cuerpos-de-las-peticiones-1","content":"`POST .../modules/import`"},"4408":{"id":"/docs/pr-preview/pr-56/es/platform/updates/reference/api-398","page_id":"/docs/pr-preview/pr-56/es/platfo