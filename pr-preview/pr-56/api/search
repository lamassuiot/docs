-fleets/quickstarts/register-device#si-el-resultado-falla","content":"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura."},"1698":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/register-device-46","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","content":"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista."},"1699":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/register-device-47","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","content":"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido."},"1700":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/register-device-48","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","content":"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades."},"1701":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/register-device-49","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","content":"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente."},"1702":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/register-device-50","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","content":"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo."},"1703":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/register-device-51","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","content":"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios."},"1704":{"id":"/docs/pr-preview/pr-56/es/platform/overview","page_id":"/docs/pr-preview/pr-56/es/platform/overview","type":"page","content":"Plataforma Lamassu IoT","breadcrumbs":["Docs","Plataforma"],"tags":[],"url":"/docs/pr-preview/pr-56/es/platform/overview"},"1705":{"id":"/docs/pr-preview/pr-56/es/platform/overview-0","page_id":"/docs/pr-preview/pr-56/es/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/overview","content":"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos."},"1706":{"id":"/docs/pr-preview/pr-56/es/platform/overview-1","page_id":"/docs/pr-preview/pr-56/es/platform/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/overview#empieza-aquí","content":"Empieza aquí"},"1707":{"id":"/docs/pr-preview/pr-56/es/platform/overview-2","page_id":"/docs/pr-prev