ey`"},"4985":{"id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration-243","page_id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/reference/configuration#at-rest-encryption-encryption","content":"none"},"4986":{"id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration-244","page_id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/reference/configuration#at-rest-encryption-encryption","content":"Required for `local`: a hex-encoded 32-byte key."},"4987":{"id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration-245","page_id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/reference/configuration#at-rest-encryption-encryption","content":"`awskms_key_id`"},"4988":{"id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration-246","page_id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/reference/configuration#at-rest-encryption-encryption","content":"none"},"4989":{"id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration-247","page_id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/reference/configuration#at-rest-encryption-encryption","content":"Required for `awskms`: key ARN or alias."},"4990":{"id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration-248","page_id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/reference/configuration#at-rest-encryption-encryption","content":"`awskms_region`"},"4991":{"id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration-249","page_id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/reference/configuration#at-rest-encryption-encryption","content":"`us-east-1`"},"4992":{"id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration-250","page_id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/reference/configuration#at-rest-encryption-encryption","content":"Region of the AWS KMS key."},"4993":{"id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration-251","page_id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/reference/configuration#at-rest-encryption-encryption","content":"An encrypted object is encrypted and decrypted whole, in memory: with at-rest encryption, reading or writing a 10 GiB artifact needs that much memory, and byte ranges are cut from the decrypted copy. A store with encryption enabled cannot use presigned downloads. For large files, prefer encrypting at the store (for example S3 server-side encryption) instead."},"4994":{"id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration-252","page_id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/reference/configuration#presigned-downloads-presign","content":"With S3 storage, a download can be answered with `302` to a short-lived signed URL of the store instead of streaming the bytes through the service. The caller is authorized first, as for any download. Native mode signs build outputs (`builds.presign`); `hawkbit` mode signs the objects of hawkBit's S3 plugin (`hawkbit.artifact_store.presign`). Artifact downloads by ID in `native` mode are always streamed."},"4995":{"id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration-253","page_id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/reference/configuration#presigned-downloads-presign","content":"Key"},"4996":{"id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration-254","page_id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/reference/configuration#presigned-downloads-presign","content":"Default"},"4997":{"id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration-255","page_id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/reference/configuration#presigned-downloads-presign","content":"Description"},"4998":{"id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration-256","page_id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/reference/configuration#presigned-downloads-presign","content":"`enabled`"},"4999":{"id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration-257","page_id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/reference/configuration#presigned-downloads-presign","content":"`false`"},"5000":{"id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration-258","page_id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/reference/configuration#presigned-downloads-presign","content":"Turns the feature on."},"5001":{"id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration-259","page_id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/reference/configuration#presigned-downloads-presign","content":"`public_endpoint`"},"5002":{"id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration-260","page_id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/reference/configuration#presigned-downloads-presign","content":"the storage `s3_endpoint`"},"5003":{"id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration-261","page_id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/reference/configuration#presigned-downloads-presign","content":"Origin of the store **as devices reach it**, without a path (for example the gateway that publishes the bucket). It is what gets signed: the signature covers the `Host` header, so a URL signed for an in-cluster address is refused when a device fetches it through the gateway. Required unless devices reach the store at its own endpoint (for example AWS S3)."},"5004":{"id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration-262","page_id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/reference/configuration#presigned-downloads-presign","content":"`ttl`"},"5005":{"id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration-263","page_id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/reference/configuration#presigned-downloads-presign","content":"`60s`"},"5006":{"id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration-264","page_id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/reference/configuration#presigned-downloads-presign","content":"How long a URL can **start** a download. Between `1s` and 7 days. A transfer already under way is not cut when it expires."},"5007":{"id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration-265","page_id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/reference/configuration#presigned-downloads-presign","content":"`min_remaining`"},"5008":{"id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration-266","page_id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/reference/configuration#presigned-downloads-presign","content":"`min(25s, ttl/2)`"},"5009":{"id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration-267","page_id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/reference/configuration#presigned-downloads-presign","content":"A URL already signed for the same object is handed out again while it has at least this much validity left, so a retry or resume never gets a URL about to expire. Negative signs a fresh URL on every request. Must be lower than `ttl`."},"5010":{"id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration-268","page_id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/reference/configuration#presigned-downloads-presign","content":"`access_key_id`, `secret_access_key` (or the `_file` variants)"},"5011":{"id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration-269","page_id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/reference/configuration#presigned-downloads-presign","content":"none"},"5012":{"id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration-270","page_id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/reference/configuration#presigned-downloads-presign","content":"The credential that signs. &#x2A;*Required, and it must be a read-only credential different from the storage one.**"},"5013":{"id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration-271","page_id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/reference/configuration#presigned-downloads-presign","content":"At start-up the service refuses to run when the signing credential is the storage credential, when it can write to the bucket (it probes with a write), when the store rejects it (it waits up to 2 minutes for the store to accept it), or when `encryption.type` is not `none` (devices would receive ciphertext). If the store cannot be asked at all, it logs a warning and continues. The device must still be able to resolve and reach `public_endpoint`. See Security."},"5014":{"id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration-272","page_id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/reference/configuration#hawkbit-block","content":"Used only when `mode: hawkbit`."},"5015":{"id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration-273","page_id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/reference/configuration#hawkbit-block","content":"Key"},"5016":{"id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration-274","page_id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/reference/configuration#hawkbit-block","content":"Default"},"5017":{"id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration-275","page_id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/reference/configuration#hawkbit-block","content":"Description"},"5018":{"id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration-276","page_id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/reference/configuration#hawkbit-block","content":"`hawkbit.base_url`"},"5019":{"id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration-277","page_id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/reference/configuration#hawkbit-block","content":"none (required)"},"5020":{"id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration-278","page_id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/reference/configuration#hawkbit-block","content":"hawkBit Management API root, for example `http://hawkbit:8080`. Startup fails if it is empty. Calls time out after 30 s; artifact transfers after 6 h."},"5021":{"id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration-279","page_id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/reference/configuration#hawkbit-block","content":"`hawkbit.username`, `hawkbit.password`"},"5022":{"id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration-280","page_id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/reference/configuration#hawkbit-block","content":"none"},"5023":{"id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration-281","page_id":"/docs/pr-preview/p