56/es/platform/administration/access-control-13","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#acceso-filtrado-por-atributos","content":"Acceso filtrado por atributos"},"479":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-14","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#reglas-http","content":"Reglas HTTP"},"480":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-15","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#políticas-incluidas","content":"Políticas incluidas"},"481":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-16","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#provisiona-el-primer-administrador","content":"Provisiona el primer administrador"},"482":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-17","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","content":"Prepara el proveedor de identidad"},"483":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-18","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#configura-la-validación-de-tokens","content":"Configura la validación de tokens"},"484":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-19","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","content":"Instala y verifica el acceso administrativo"},"485":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-20","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","content":"Prueba una identidad sin privilegios"},"486":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-21","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","content":"Reduce el uso del administrador de bootstrap"},"487":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-22","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#bootstrap-de-fastlane","content":"Bootstrap de Fastlane"},"488":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-23","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","content":"Diseña roles de mínimo privilegio"},"489":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-24","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#cambios-y-revocación-de-acceso","content":"Cambios y revocación de acceso"},"490":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-25","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#lista-de-comprobación-operativa","content":"Lista de comprobación operativa"},"491":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-26","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#diagnóstico","content":"Diagnóstico"},"492":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-27","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#la-respuesta-es-401","content":"La respuesta es 401"},"493":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-28","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#la-respuesta-es-403","content":"La respuesta es 403"},"494":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-29","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#todo-devuelve-403","content":"Todo devuelve 403"},"495":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-30","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","content":"Aparece acceso sin política concedida"},"496":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-31","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","content":"Todo falla cuando authz no está disponible"},"497":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-32","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control","content":"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**."},"498":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-33","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control","content":"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:"},"499":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-34","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control","content":"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto."},"500":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-35","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#conceptos-esenciales","content":"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado."},"501":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-36","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#conceptos-esenciales","content":"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas."},"502":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-37","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#conceptos-esenciales","content":"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo."},"503":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-38","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#conceptos-esenciales","content":"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro."},"504":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-39","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#conceptos-esenciales","content":"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales."},"505":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-40","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#conceptos-esenciales","content":"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones."},"506":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-41","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#dos-sistemas-de-decisión","content":"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera."},"507":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-42","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#dos-sistemas-de-decisión","content":"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas."},"508":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-43","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#servicios-http-integrados-o-externos","content":"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`."},"509":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-44","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#servicios-http-integrados-o-externos","content":"La decisión se toma **antes de reenviar la petición al servicio**:"},"510":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-45","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#servicios-http-integrados-o-externos","content":"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC."},"511":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-46","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#servicios-http-integrados-o-externos","content":"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`."},"512":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-47","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#servicios-http-integrados-o-externos","content":"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella."},"513":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-48","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#servicios-http-integrados-o-externos","content":"Carga por separado las políticas concedidas a cada principal."},"514":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-49","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#servicios-http-integrados-o-externos","content":"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`."},"515":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-50","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#servicios-http-integrados-o-externos","content":"`authz` busca una regla HTTP que conceda esa acción."},"516":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-51","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#servicios-http-integrados-o-externos","content":"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición."},"517":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-52","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#servicios-http-integrados-o-externos","content":"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway."},"518":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-53","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#servicios-http-integrados-o-externos","content":"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad."},"519":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-54","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#servicios-http-integrados-o-externos","content":"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea."},"520":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-55","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","content":"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:"},"521":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-56","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","content":"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición."},"522":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-57","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","content":"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo."},"523":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-58","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","content":"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:"},"524":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-59","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","content":"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`."},"525":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-60","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","content":"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo."},"526":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-61","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","content":"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar."},"527":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-62","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","content":"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio."},"528":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-63","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","content":"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras."},"529":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-64","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","content":"La decisión se toma con el contexto de la operación de dominio:"},"530":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-65","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","content":"El middleware extrae la credencial y resuelve los principales coincidentes."},"531":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-66","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","content":"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado."},"532":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-67","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","content":"`authz` reúne las reglas de entidad de las políticas concedidas."},"533":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-68","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","content":"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades."},"534":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-69","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","content":"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado."},"535":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-70","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","content":"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta."},"536":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-71","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","content":"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**."},"537":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-72","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","content":"Las acciones se dividen en dos grupos:"},"538":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-73","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","content":"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales."},"539":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-74","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","content":"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida."},"540":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-75","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","content":"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz."},"541":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-76","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","content":"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos."},"542":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-77","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","content":"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad."},"543":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-78","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","content":"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas."},"544":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-79","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#principales-oidc","content":"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens."},"545":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-80","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#principales-oidc","content":"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:"},"546":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-81","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#principales-oidc","content":"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez."},"547":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-82","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#principales-oidc","content":"Los operadores implementados son:"},"548":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-83","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#principales-oidc","content":"`equals`, para igualdad exacta;"},"549":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-84","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#principales-oidc","content":"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar."},"550":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-85","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#principales-oidc","content":"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano."},"551":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-86","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#principales-oidc","content":"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`."},"552":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-87","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#principales-x509","content":"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name."},"553":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-88","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#principales-x509","content":"Los modos disponibles son:"},"554":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-89","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#principales-x509","content":"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;"},"555":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-90","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#principales-x509","content":"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;"},"556":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-91","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#principales-x509","content":"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada."},"557":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-92","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#principales-x509","content":"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:"},"558":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-93","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#principales-x509","content":"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA."},"559":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-94","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#principales-x509","content":"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes."},"560":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-95","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#cuando-coinciden-varios-principales","content":"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa."},"561":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-96","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#cuando-coinciden-varios-principales","content":"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos."},"562":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-97","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#cuando-coinciden-varios-principales","content":"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro."},"563":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-98","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#cuando-coinciden-varios-principales","content":"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real."},"564":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-99","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#acceso-global-y-acceso-directo","content":"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas."},"565":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-100","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#acceso-global-y-acceso-directo","content":"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible."},"566":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-101","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#acceso-heredado-por-relaciones","content":"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora y la de un dispositivo con su DMS. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados."},"567":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-102","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#acceso-heredado-por-relaciones","content":"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política."},"568":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-103","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#acceso-filtrado-por-atributos","content":"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND."},"569":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-104","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#acceso-filtrado-por-atributos","content":"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:"},"570":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-105","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#acceso-filtrado-por-atributos","content":"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados."},"571":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-106","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#reglas-http","content":"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs."},"572":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-107","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#reglas-http","content":"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`."},"573":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-108","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#reglas-http","content":"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos."},"574":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-109","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#reglas-http","content":"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:"},"575":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-110","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#reglas-http","content":"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`."},"576":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-111","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#reglas-http","content":"Ten en cuenta que:"},"577":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-112","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#reglas-http","content":"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`."},"578":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-113","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#reglas-http","content":"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega."},"579":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-114","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#reglas-http","content":"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan."},"580":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-115","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#políticas-incluidas","content":"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:"},"581":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-116","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#políticas-incluidas","content":"acceso completo y de solo lectura a certificados y autoridades;"},"582":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-117","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#políticas-incluidas","content":"acceso completo y de solo lectura a KMS;"},"583":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-118","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#políticas-incluidas","content":"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;"},"584":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-119","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#políticas-incluidas","content":"una política `Auditor` de lectura de PKI y visibilidad de autorización;"},"585":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-120","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#políticas-incluidas","content":"acceso a la interfaz;"},"586":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-121","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#políticas-incluidas","content":"políticas de administración y observación para las APIs NBI y SBI del Job Manager;"},"587":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-122","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#políticas-incluidas","content":"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`."},"588":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-123","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#políticas-incluidas","content":"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal."},"589":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-124","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#provisiona-el-primer-administrador","content":"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma."},"590":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-125","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#provisiona-el-primer-administrador","content":"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI."},"591":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-126","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#provisiona-el-primer-administrador","content":"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones."},"592":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-127","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","content":"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`."},"593":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-128","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#configura-la-validación-de-tokens","content":"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`."},"594":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-129","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#configura-la-validación-de-tokens","content":"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0."},"595":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-130","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","content":"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva."},"596":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-131","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","content":"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales."},"597":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-132","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","content":"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario."},"598":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-133","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#bootstrap-de-fastlane","content":"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`."},"599":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-134","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#bootstrap-de-fastlane","content":"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción."},"600":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-135","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","content":"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:"},"601":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-136","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","content":"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado."},"602":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-137","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","content":"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso."},"603":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-138","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","content":"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización."},"604":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-139","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","content":"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar."},"605":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-140","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","content":"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla."},"606":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-141","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","content":"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente."},"607":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-142","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","content":"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización."},"608":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-143","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#cambios-y-revocación-de-acceso","content":"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia."},"609":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-144","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#cambios-y-revocación-de-acceso","content":"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor."},"610":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-145","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#cambios-y-revocación-de-acceso","content":"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior."},"611":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-146","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#lista-de-comprobación-operativa","content":"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario."},"612":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-147","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#lista-de-comprobación-operativa","content":"Usa grupos o roles estables para personas e identidades independientes para automatizaciones."},"613":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-148","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#lista-de-comprobación-operativa","content":"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente."},"614":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-149","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#lista-de-comprobación-operativa","content":"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP."},"615":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-150","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#lista-de-comprobación-operativa","content":"Busca comodines en políticas antes de actualizar Lamassu."},"616":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-151","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#lista-de-comprobación-operativa","content":"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio."},"617":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-152","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#lista-de-comprobación-operativa","content":"Prueba siempre una operación permitida y otra denegada para cada rol."},"618":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-153","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#lista-de-comprobación-operativa","content":"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría."},"619":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-154","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#la-respuesta-es-401","content":"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial."},"620":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-155","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#la-respuesta-es-403","content":"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:"},"621":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-156","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#la-respuesta-es-403","content":"que exista un principal activo del tipo correcto;"},"622":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-157","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#la-respuesta-es-403","content":"que las rutas de claims y sus valores coincidan exactamente con el token real;"},"623":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-158","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#la-respuesta-es-403","content":"que todas las condiciones del principal se cumplan;"},"624":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-159","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#la-respuesta-es-403","content":"que el principal tenga concedida la política esperada;"},"625":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-160","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#la-respuesta-es-403","content":"que la política incluya la acción y el tipo de recurso o ruta solicitados;"},"626":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-161","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#la-respuesta-es-403","content":"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real."},"627":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-162","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#la-respuesta-es-403","content":"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con la instrumentación OpenTelemetry habilitada, cada decisión genera además un span —`engine.CheckHTTP` en el camino del Gateway— cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente, de forma que puedas correlacionar la denegación con la traza del Gateway."},"628":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-163","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#todo-devuelve-403","content":"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster."},"629":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-164","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","content":"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados."},"630":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-165","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","content":"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización."},"631":{"id":"/docs/pr-preview/pr-56/es/platform/administration/access-control-166","page_id":"/docs/pr-preview/pr-56/es/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","content":"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue."},"632":{"id":"/docs/pr-preview/pr-56/es/platform/administration/alerts","page_id":"/docs/pr-preview/pr-56/es/platform/administration/alerts","type":"page","content":"Alertas y suscripciones","breadcrumbs":["Docs","Plataforma","Administración"],"tags":[],"url":"/docs/pr-preview/pr-56/es/platform/administration/alerts"},"633":{"id":"/docs/pr-preview/pr-56/es/platform/administration/alerts-0","page_id":"/docs/pr-preview/pr-56/es/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/alerts","content":"Envía eventos de la PKI a personas y sistemas externos."},"634":{"id":"/docs/pr-preview/pr-56/es/platform/administration/alerts-1","page_id":"/docs/pr-preview/pr-56/es/platform/administration/alerts","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/administration/alerts#cómo-funciona","content":"Cómo funciona"},"635":{"id":"/docs/pr-preview/pr-56/es/platform/administration/alerts-2","page_id":"/docs/pr-preview/pr-56/es/platform/administration/alerts","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/administration/alerts#canales-disponibles","content":"Canales disponibles"},"636":{"id":"/docs/pr-preview/pr-56/es/platform/administration/alerts-3","page_id":"/docs/pr-preview/pr-56/es/platform/administration/alerts","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/administration/alerts#crea-una-suscripción","content":"Crea una suscripción"},"637":{"id":"/docs/pr-preview/pr-56/es/platform/administration/alerts-4","page_id":"/docs/pr-preview/pr-56/es/platform/administration/alerts","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/administration/alerts#elige-el-evento","content":"Elige el evento"},"638":{"id":"/docs/pr-preview/pr-56/es/platform/administration/alerts-5","page_id":"/docs/pr-preview/pr-56/es/platform/administration/alerts","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/administration/alerts#configura-el-destino","content":"Configura el destino"},"639":{"id":"/docs/pr-preview/pr-56/es/platform/administration/alerts-6","page_id":"/docs/pr-preview/pr-56/es/platform/administration/alerts","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/administration/alerts#limita-las-notificaciones","content":"Limita las notificaciones"},"640":{"id":"/docs/pr-preview/pr-56/es/platform/administration/alerts-7","page_id":"/docs/pr-preview/pr-56/es/platform/administration/alerts","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/administration/alerts#revisa-y-activa","content":"Revisa y activa"},"641":{"id":"/docs/pr-preview/pr-56/es/platform/administration/alerts-8","page_id":"/docs/pr-preview/pr-56/es/platform/administration/alerts","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","content":"Configura el cliente HTTP del webhook"},"642":{"id":"/docs/pr-preview/pr-56/es/platform/administration/alerts-9","page_id":"/docs/pr-preview/pr-56/es/platform/administration/alerts","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/administration/alerts#reglas-de-entrega-del-webhook","content":"Reglas de entrega del webhook"},"643":{"id":"/docs/pr-preview/pr-56/es/platform/administration/alerts-10","page_id":"/docs/pr-preview/pr-56/es/platform/administration/alerts","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/administration/alerts#gestiona-una-suscripción","content":"Gestiona una suscripción"},"644":{"id":"/docs/pr-preview/pr-56/es/platform/administration/alerts-11","page_id":"/docs/pr-preview/pr-56/es/platform/administration/alerts","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/administration/alerts#familias-de-eventos","content":"Familias de eventos"},"645":{"id":"/docs/pr-preview/pr-56/es/platform/administration/alerts-12","page_id":"/docs/pr-preview/pr-56/es/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/alerts","content":"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo."},"646":{"id":"/docs/pr-preview/pr-56/es/platform/administration/alerts-13","page_id":"/docs/pr-preview/pr-56/es/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/alerts#cómo-funciona","content":"Un servicio publica un evento de dominio."},"647":{"id":"/docs/pr-preview/pr-56/es/platform/administration/alerts-14","page_id":"/docs/pr-preview/pr-56/es/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/alerts#cómo-funciona","content":"Lamassu evalúa las suscripciones asociadas a ese tipo de evento."},"648":{"id":"/docs/pr-preview/pr-56/es/platform/administration/alerts-15","page_id":"/docs/pr-preview/pr-56/es/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/alerts#cómo-funciona","content":"El filtro de cada suscripción decide si debe notificarse."},"649":{"id":"/docs/pr-preview/pr-56/es/platform/administration/alerts-16","page_id":"/docs/pr-preview/pr-56/es/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/alerts#cómo-funciona","content":"Lamassu entrega el evento al canal configurado."},"650":{"id":"/docs/pr-preview/pr-56/es/platform/administration/alerts-17","page_id":"/docs/pr-preview/pr-56/es/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/alerts#cómo-funciona","content":"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro."},"651":{"id":"/docs/pr-preview/pr-56/es/platform/administration/alerts-18","page_id":"/docs/pr-preview/pr-56/es/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/alerts#canales-disponibles","content":"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado."},"652":{"id":"/docs/pr-preview/pr-56/es/platform/administration/alerts-19","page_id":"/docs/pr-preview/pr-56/es/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/alerts#canales-disponibles","content":"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook."},"653":{"id":"/docs/pr-preview/pr-56/es/platform/administration/alerts-20","page_id":"/docs/pr-preview/pr-56/es/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/alerts#canales-disponibles","content":"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`."},"654":{"id":"/docs/pr-preview/pr-56/es/platform/administration/alerts-21","page_id":"/docs/pr-preview/pr-56/es/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/alerts#canales-disponibles","content":"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:"},"655":{"id":"/docs/pr-preview/pr-56/es/platform/administration/alerts-22","page_id":"/docs/pr-preview/pr-56/es/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/alerts#canales-disponibles","content":"`apikey_options` necesita `header` y `key`."},"656":{"id":"/docs/pr-preview/pr-56/es/platform/administration/alerts-23","page_id":"/docs/pr-preview/pr-56/es/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/alerts#canales-disponibles","content":"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`."},"657":{"id":"/docs/pr-preview/pr-56/es/platform/administration/alerts-24","page_id":"/docs/pr-preview/pr-56/es/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/alerts#canales-disponibles","content":"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes."},"658":{"id":"/docs/pr-preview/pr-56/es/platform/administration/alerts-25","page_id":"/docs/pr-preview/pr-56/es/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/alerts#canales-disponibles","content":"La referencia de la API de Alerts documenta el esquema completo de `http_client`."},"659":{"id":"/docs/pr-preview/pr-56/es/platform/administration/alerts-26","page_id":"/docs/pr-preview/pr-56/es/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/alerts#elige-el-evento","content":"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar."},"660":{"id":"/docs/pr-preview/pr-56/es/platform/administration/alerts-27","page_id":"/docs/pr-preview/pr-56/es/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/alerts#configura-el-destino","content":"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal."},"661":{"id":"/docs/pr-preview/pr-56/es/platform/administration/alerts-28","page_id":"/docs/pr-preview/pr-56/es/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/alerts#limita-las-notificaciones","content":"Añade un filtro si no quieres recibir todas las instancias del evento."},"662":{"id":"/docs/pr-preview/pr-56/es/platform/administration/alerts-29","page_id":"/docs/pr-preview/pr-56/es/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/alerts#limita-las-notificaciones","content":"**None** notifica todas las instancias del evento."},"663":{"id":"/docs/pr-preview/pr-56/es/platform/administration/alerts-30","page_id":"/docs/pr-preview/pr-56/es/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/alerts#limita-las-notificaciones","content":"**JSON Path** evalúa uno o varios campos concretos."},"664":{"id":"/docs/pr-preview/pr-56/es/platform/administration/alerts-31","page_id":"/docs/pr-preview/pr-56/es/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/alerts#limita-las-notificaciones","content":"**JSON Schema** acepta únicamente payloads con una estructura determinada."},"665":{"id":"/docs/pr-preview/pr-56/es/platform/administration/alerts-32","page_id":"/docs/pr-preview/pr-56/es/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/alerts#limita-las-notificaciones","content":"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`."},"666":{"id":"/docs/pr-preview/pr-56/es/platform/administration/alerts-33","page_id":"/docs/pr-preview/pr-56/es/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/alerts#limita-las-notificaciones","content":"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad."},"667":{"id":"/docs/pr-preview/pr-56/es/platform/administration/alerts-34","page_id":"/docs/pr-preview/pr-56/es/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/alerts#revisa-y-activa","content":"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega."},"668":{"id":"/docs/pr-preview/pr-56/es/platform/administration/alerts-35","page_id":"/docs/pr-preview/pr-56/es/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","content":"Los canales Webhook y Microsoft Teams muestran esta configuración en el formulario de suscripción, en el paso del canal, y de nuevo al editar una suscripción; Email no la utiliza. Los campos se corresponden con el bloque opcional `http_client` descrito arriba:"},"669":{"id":"/docs/pr-preview/pr-56/es/platform/administration/alerts-36","page_id":"/docs/pr-preview/pr-56/es/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","content":"**Log Level** selecciona `debug`, `info`, `warn` o `error`; `info` es el valor por defecto."},"670":{"id":"/docs/pr-preview/pr-56/es/platform/administration/alerts-37","page_id":"/docs/pr-preview/pr-56/es/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","content":"**Call Timeout** es de 10 segundos por defecto. La consola rechaza un valor superior a 30 segundos con `Webhook timeout must be at most 30s.`; la API ajusta ese mismo valor al tope en lugar de rechazarlo (ver Las llamadas están limitadas)."},"671":{"id":"/docs/pr-preview/pr-56/es/platform/administration/alerts-38","page_id":"/docs/pr-preview/pr-56/es/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","content":"No hay interruptor de verificación TLS para estos canales, porque el servicio siempre verifica el certificado del receptor (ver TLS siempre se verifica)."},"672":{"id":"/docs/pr-preview/pr-56/es/platform/administration/alerts-39","page_id":"/docs/pr-preview/pr-56/es/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","content":"**HTTP Authentication** selecciona `No Authentication` (por defecto), `API Key` (valor de la API key y Header Name, `X-API-Key` por defecto), `OIDC Client Credentials` (Client ID, Client Secret y Well-Known URL) o `Mutual TLS` (Client Certificate y Client Private Key pegados como PEM). Una clave privada guardada permanece oculta hasta que seleccionas **Show**."},"673":{"id":"/docs/pr-preview/pr-56/es/platform/administration/alerts-40","page_id":"/docs/pr-preview/pr-56/es/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","content":"Una URL `http://` muestra en la consola la advertencia `Unencrypted HTTP connection` (ver la llamada Credenciales sobre http\\:// más abajo)."},"674":{"id":"/docs/pr-preview/pr-56/es/platform/administration/alerts-41","page_id":"/docs/pr-preview/pr-56/es/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","content":"Los campos se validan en línea con las mismas reglas de entrega: la URL del webhook y la Well-Known URL de OIDC deben ser URLs absolutas `http` o `https`, una cabecera API-key no puede usar un nombre reservado y el certificado y la clave mTLS deben ser contenido PEM, no rutas de ficheros."},"675":{"id":"/docs/pr-preview/pr-56/es/platform/administration/alerts-42","page_id":"/docs/pr-preview/pr-56/es/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","content":"El resumen del paso de confirmación muestra la autenticación como `None`, `OIDC client credentials`, `API key` o `Mutual TLS`. Los detalles de la suscripción muestran la autenticación, el nombre de la cabecera API-key (nunca el valor), la URL del emisor OIDC, mTLS como `Configured` y una fila fija `TLS verification: Verified`. La API key, el client secret y la clave privada no se muestran en los detalles de la suscripción."},"676":{"id":"/docs/pr-preview/pr-56/es/platform/administration/alerts-43","page_id":"/docs/pr-preview/pr-56/es/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/alerts#reglas-de-entrega-del-webhook","content":"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:"},"677":{"id":"/docs/pr-preview/pr-56/es/platform/administration/alerts-44","page_id":"/docs/pr-preview/pr-56/es/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/alerts#reglas-de-entrega-del-webhook","content":"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega."},"678":{"id":"/docs/pr-preview/pr-56/es/platform/administration/alerts-45","page_id":"/docs/pr-preview/pr-56/es/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/alerts#reglas-de-entrega-del-webhook","content":"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar."},"679":{"id":"/docs/pr-preview/pr-56/es/platform/administration/alerts-46","page_id":"/docs/pr-preview/pr-56/es/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/alerts#reglas-de-entrega-del-webhook","content":"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan."},"680":{"id":"/docs/pr-preview/pr-56/es/platform/administration/alerts-47","page_id":"/docs/pr-preview/pr-56/es/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/alerts#reglas-de-entrega-del-webhook","content":"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo."},"681":{"id":"/docs/pr-preview/pr-56/es/platform/administration/alerts-48","page_id":"/docs/pr-preview/pr-56/es/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/alerts#reglas-de-entrega-del-webhook","content":"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas."},"682":{"id":"/docs/pr-preview/pr-56/es/platform/administration/alerts-49","page_id":"/docs/pr-preview/pr-56/es/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/alerts#reglas-de-entrega-del-webhook","content":"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea."},"683":{"id":"/docs/pr-preview/pr-56/es/platform/administration/alerts-50","page_id":"/docs/pr-preview/pr-56/es/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/alerts#reglas-de-entrega-del-webhook","content":"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia."},"684":{"id":"/docs/pr-preview/pr-56/es/platform/administration/alerts-51","page_id":"/docs/pr-preview/pr-56/es/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/alerts#gestiona-una-suscripción","content":"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos."},"685":{"id":"/docs/pr-preview/pr-56/es/platform/administration/alerts-52","page_id":"/docs/pr-preview/pr-56/es/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/alerts#gestiona-una-suscripción","content":"Las suscripciones creadas con versiones anteriores de la consola pueden guardar el destino del webhook en `url` y `method` en lugar de `webhook_url` y `webhook_method`. El servicio entrega solo a través de `webhook_url` y `webhook_method`, así que una suscripción así no entrega aunque los detalles de la suscripción muestren el destino guardado. Abre la suscripción y vuelve a guardarla: el formulario de edición precarga el destino guardado, y al guardar se reescribe la configuración del canal con el formato actual."},"686":{"id":"/docs/pr-preview/pr-56/es/platform/administration/alerts-53","page_id":"/docs/pr-preview/pr-56/es/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/alerts#familias-de-eventos","content":"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`."},"687":{"id":"/docs/pr-preview/pr-56/es/platform/administration/alerts-54","page_id":"/docs/pr-preview/pr-56/es/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/alerts#familias-de-eventos","content":"**Certificados:** `ca.sign.certificate` y `certificate.delete`."},"688":{"id":"/docs/pr-preview/pr-56/es/platform/administration/alerts-55","page_id":"/docs/pr-preview/pr-56/es/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/alerts#familias-de-eventos","content":"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`."},"689":{"id":"/docs/pr-preview/pr-56/es/platform/administration/alerts-56","page_id":"/docs/pr-preview/pr-56/es/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/alerts#familias-de-eventos","content":"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`."},"690":{"id":"/docs/pr-preview/pr-56/es/platform/administration/alerts-57","page_id":"/docs/pr-preview/pr-56/es/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/alerts#familias-de-eventos","content":"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`."},"691":{"id":"/docs/pr-preview/pr-56/es/platform/administration/alerts-58","page_id":"/docs/pr-preview/pr-56/es/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/alerts#familias-de-eventos","content":"**Validación:** `va.role.crl.create`."},"692":{"id":"/docs/pr-preview/pr-56/es/platform/administration/alerts-59","page_id":"/docs/pr-preview/pr-56/es/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/alerts#familias-de-eventos","content":"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`."},"693":{"id":"/docs/pr-preview/pr-56/es/platform/administration/alerts-60","page_id":"/docs/pr-preview/pr-56/es/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/alerts#familias-de-eventos","content":"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada."},"694":{"id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs","page_id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs","type":"page","content":"Registros de auditoría","breadcrumbs":["Docs","Plataforma","Administración"],"tags":[],"url":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs"},"695":{"id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs-0","page_id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs","content":"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable."},"696":{"id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs-1","page_id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs#qué-contiene-un-evento","content":"Qué contiene un evento"},"697":{"id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs-2","page_id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs#cobertura","content":"Cobertura"},"698":{"id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs-3","page_id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs#publicación-y-persistencia","content":"Publicación y persistencia"},"699":{"id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs-4","page_id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs#datos-sensibles","content":"Datos sensibles"},"700":{"id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs-5","page_id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs#una-investigación-reproducible","content":"Una investigación reproducible"},"701":{"id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs-6","page_id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs#acota-el-intervalo","content":"Acota el intervalo"},"702":{"id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs-7","page_id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs#identifica-la-operación","content":"Identifica la operación"},"703":{"id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs-8","page_id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs#atribuye-el-principal","content":"Atribuye el principal"},"704":{"id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs-9","page_id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs#compara-intención-y-resultado","content":"Compara intención y resultado"},"705":{"id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs-10","page_id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs#sigue-el-efecto","content":"Sigue el efecto"},"706":{"id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs-11","page_id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs#verificación-periódica","content":"Verificación periódica"},"707":{"id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs-12","page_id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs","content":"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error."},"708":{"id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs-13","page_id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs#qué-contiene-un-evento","content":"El cuerpo de auditoría incluye:"},"709":{"id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs-14","page_id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs#qué-contiene-un-evento","content":"input: datos recibidos por la operación;"},"710":{"id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs-15","page_id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs#qué-contiene-un-evento","content":"has\\_error: indica si el servicio devolvió un error;"},"711":{"id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs-16","page_id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs#qué-contiene-un-evento","content":"output: resultado producido o mensaje de error;"},"712":{"id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs-17","page_id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs#qué-contiene-un-evento","content":"principals: identificadores de los principales que coincidieron con la petición."},"713":{"id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs-18","page_id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs#qué-contiene-un-evento","content":"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo."},"714":{"id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs-19","page_id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs#qué-contiene-un-evento","content":"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados."},"715":{"id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs-20","page_id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs#cobertura","content":"El backend aplica auditoría a mutaciones de:"},"716":{"id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs-21","page_id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs#cobertura","content":"autoridades, certificados y perfiles de emisión;"},"717":{"id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs-22","page_id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs#cobertura","content":"claves y motores KMS;"},"718":{"id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs-23","page_id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs#cobertura","content":"dispositivos e identidades;"},"719":{"id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs-24","page_id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs#cobertura","content":"DMS y operaciones de enrolamiento;"},"720":{"id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs-25","page_id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs#cobertura","content":"funciones de validación y CRL;"},"721":{"id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs-26","page_id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs#cobertura","content":"principales, políticas y concesiones de autorización."},"722":{"id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs-27","page_id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs#cobertura","content":"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación."},"723":{"id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs-28","page_id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs#publicación-y-persistencia","content":"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo."},"724":{"id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs-29","page_id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs#publicación-y-persistencia","content":"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización."},"725":{"id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs-30","page_id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs#publicación-y-persistencia","content":"Diseña el consumidor para:"},"726":{"id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs-31","page_id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs#publicación-y-persistencia","content":"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;"},"727":{"id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs-32","page_id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs#publicación-y-persistencia","content":"conservar el CloudEvent completo sin modificar;"},"728":{"id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs-33","page_id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs#publicación-y-persistencia","content":"registrar el momento de ingestión y detectar duplicados por ID;"},"729":{"id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs-34","page_id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs#publicación-y-persistencia","content":"cifrar en tránsito y en reposo;"},"730":{"id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs-35","page_id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs#publicación-y-persistencia","content":"limitar lectura y borrado a un rol separado del operador de PKI;"},"731":{"id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs-36","page_id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs#publicación-y-persistencia","content":"aplicar una política explícita de retención y legal hold;"},"732":{"id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs-37","page_id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs#publicación-y-persistencia","content":"alertar si deja de consumir o aumenta la cola pendiente."},"733":{"id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs-38","page_id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs#datos-sensibles","content":"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa."},"734":{"id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs-39","page_id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs#datos-sensibles","content":"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución."},"735":{"id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs-40","page_id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs#acota-el-intervalo","content":"Parte de la hora reportada y normaliza todas las fuentes a UTC."},"736":{"id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs-41","page_id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs#identifica-la-operación","content":"Filtra por tipo de evento, fuente de servicio e identificador del recurso."},"737":{"id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs-42","page_id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs#atribuye-el-principal","content":"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento."},"738":{"id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs-43","page_id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs#compara-intención-y-resultado","content":"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado."},"739":{"id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs-44","page_id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs#sigue-el-efecto","content":"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada."},"740":{"id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs-45","page_id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs#verificación-periódica","content":"Genera una mutación controlada en un entorno de prueba y comprueba que:"},"741":{"id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs-46","page_id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs#verificación-periódica","content":"aparece un evento de auditoría correcto;"},"742":{"id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs-47","page_id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs#verificación-periódica","content":"el principal coincide con la identidad utilizada;"},"743":{"id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs-48","page_id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs#verificación-periódica","content":"el consumidor lo persiste una sola vez;"},"744":{"id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs-49","page_id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs#verificación-periódica","content":"puede recuperarse por recurso, actor y periodo;"},"745":{"id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs-50","page_id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs#verificación-periódica","content":"una interrupción del consumidor produce una alerta."},"746":{"id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs-51","page_id":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/administration/audit-logs#verificación-periódica","content":"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema."},"747":{"id":"/docs/pr-preview/pr-56/es/platform/concepts/architecture","page_id":"/docs/pr-preview/pr-56/es/platform/concepts/architecture","type":"page","content":"Arquitectura de la plataforma","breadcrumbs":["Docs","Plataforma"],"tags":[],"url":"/docs/pr-preview/pr-56/es/platform/concepts/architecture"},"748":{"id":"/docs/pr-preview/pr-56/es/platform/concepts/architecture-0","page_id":"/docs/pr-preview/pr-56/es/platform/concepts/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/concepts/architecture","content":"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos."},"749":{"id":"/docs/pr-preview/pr-56/es/platform/concepts/architecture-1","page_id":"/docs/pr-preview/pr-56/es/platform/concepts/architecture","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/concepts/architecture#plano-de-control","content":"Plano de control"},"750":{"id":"/docs/pr-preview/pr-56/es/platform/concepts/architecture-2","page_id":"/docs/pr-preview/pr-56/es/platform/concepts/architecture","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","content":"Custodia y operaciones criptográficas"},"751":{"id":"/docs/pr-preview/pr-56/es/platform/concepts/architecture-3","page_id":"/docs/pr-preview/pr-56/es/platform/concepts/architecture","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/concepts/architecture#emisión-y-enrolamiento","content":"Emisión y enrolamiento"},"752":{"id":"/docs/pr-preview/pr-56/es/platform/concepts/architecture-4","page_id":"/docs/pr-preview/pr-56/es/platform/concepts/architecture","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/concepts/architecture#estado-y-validación","content":"Estado y validación"},"753":{"id":"/docs/pr-preview/pr-56/es/platform/concepts/architecture-5","page_id":"/docs/pr-preview/pr-56/es/platform/concepts/architecture","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/concepts/architecture#dependencias-de-la-plataforma","content":"Dependencias de la plataforma"},"754":{"id":"/docs/pr-preview/pr-56/es/platform/concepts/architecture-6","page_id":"/docs/pr-preview/pr-56/es/platform/concepts/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/concepts/architecture","content":"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga."},"755":{"id":"/docs/pr-preview/pr-56/es/platform/concepts/architecture-7","page_id":"/docs/pr-preview/pr-56/es/platform/concepts/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/concepts/architecture","content":"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas."},"756":{"id":"/docs/pr-preview/pr-56/es/platform/concepts/architecture-8","page_id":"/docs/pr-preview/pr-56/es/platform/concepts/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/concepts/architecture#plano-de-control","content":"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma."},"757":{"id":"/docs/pr-preview/pr-56/es/platform/concepts/architecture-9","page_id":"/docs/pr-preview/pr-56/es/platform/concepts/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","content":"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación."},"758":{"id":"/docs/pr-preview/pr-56/es/platform/concepts/architecture-10","page_id":"/docs/pr-preview/pr-56/es/platform/concepts/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/concepts/architecture#emisión-y-enrolamiento","content":"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad."},"759":{"id":"/docs/pr-preview/pr-56/es/platform/concepts/architecture-11","page_id":"/docs/pr-preview/pr-56/es/platform/concepts/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/concepts/architecture#estado-y-validación","content":"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado."},"760":{"id":"/docs/pr-preview/pr-56/es/platform/concepts/architecture-12","page_id":"/docs/pr-preview/pr-56/es/platform/concepts/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/concepts/architecture#dependencias-de-la-plataforma","content":"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes."},"761":{"id":"/docs/pr-preview/pr-56/es/platform/concepts/overview","page_id":"/docs/pr-preview/pr-56/es/platform/concepts/overview","type":"page","content":"Cómo funciona Lamassu","breadcrumbs":["Docs","Plataforma"],"tags":[],"url":"/docs/pr-preview/pr-56/es/platform/concepts/overview"},"762":{"id":"/docs/pr-preview/pr-56/es/platform/concepts/overview-0","page_id":"/docs/pr-preview/pr-56/es/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/concepts/overview","content":"El modelo mental de confianza, claves, certificados y dispositivos."},"763":{"id":"/docs/pr-preview/pr-56/es/platform/concepts/overview-1","page_id":"/docs/pr-preview/pr-56/es/platform/concepts/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/concepts/overview#el-modelo-en-cinco-piezas","content":"El modelo en cinco piezas"},"764":{"id":"/docs/pr-preview/pr-56/es/platform/concepts/overview-2","page_id":"/docs/pr-preview/pr-56/es/platform/concepts/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/concepts/overview#del-alta-a-la-operación","content":"Del alta a la operación"},"765":{"id":"/docs/pr-preview/pr-56/es/platform/concepts/overview-3","page_id":"/docs/pr-preview/pr-56/es/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/concepts/overview","content":"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado."},"766":{"id":"/docs/pr-preview/pr-56/es/platform/concepts/overview-4","page_id":"/docs/pr-preview/pr-56/es/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/concepts/overview#el-modelo-en-cinco-piezas","content":"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios."},"767":{"id":"/docs/pr-preview/pr-56/es/platform/concepts/overview-5","page_id":"/docs/pr-preview/pr-56/es/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/concepts/overview#el-modelo-en-cinco-piezas","content":"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza."},"768":{"id":"/docs/pr-preview/pr-56/es/platform/concepts/overview-6","page_id":"/docs/pr-preview/pr-56/es/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/concepts/overview#el-modelo-en-cinco-piezas","content":"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota."},"769":{"id":"/docs/pr-preview/pr-56/es/platform/concepts/overview-7","page_id":"/docs/pr-preview/pr-56/es/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/concepts/overview#el-modelo-en-cinco-piezas","content":"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad."},"770":{"id":"/docs/pr-preview/pr-56/es/platform/concepts/overview-8","page_id":"/docs/pr-preview/pr-56/es/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/concepts/overview#el-modelo-en-cinco-piezas","content":"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL."},"771":{"id":"/docs/pr-preview/pr-56/es/platform/concepts/overview-9","page_id":"/docs/pr-preview/pr-56/es/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/concepts/overview#del-alta-a-la-operación","content":"Un administrador configura un motor criptográfico y crea o importa una CA."},"772":{"id":"/docs/pr-preview/pr-56/es/platform/concepts/overview-10","page_id":"/docs/pr-preview/pr-56/es/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/concepts/overview#del-alta-a-la-operación","content":"Un DMS relaciona esa CA con una política de enrolamiento."},"773":{"id":"/docs/pr-preview/pr-56/es/platform/concepts/overview-11","page_id":"/docs/pr-preview/pr-56/es/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/concepts/overview#del-alta-a-la-operación","content":"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad."},"774":{"id":"/docs/pr-preview/pr-56/es/platform/concepts/overview-12","page_id":"/docs/pr-preview/pr-56/es/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/concepts/overview#del-alta-a-la-operación","content":"Lamassu conserva el inventario, el historial y el estado de la identidad."},"775":{"id":"/docs/pr-preview/pr-56/es/platform/concepts/overview-13","page_id":"/docs/pr-preview/pr-56/es/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/concepts/overview#del-alta-a-la-operación","content":"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia."},"776":{"id":"/docs/pr-preview/pr-56/es/platform/concepts/overview-14","page_id":"/docs/pr-preview/pr-56/es/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/concepts/overview#del-alta-a-la-operación","content":"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />"},"777":{"id":"/docs/pr-preview/pr-56/es/platform/concepts/overview-15","page_id":"/docs/pr-preview/pr-56/es/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/concepts/overview#del-alta-a-la-operación","content":"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />"},"778":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management","type":"page","content":"Dispositivos e identidades","breadcrumbs":["Docs","Plataforma","IoT Fleets","Dispositivos e identidades"],"tags":[],"url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management"},"779":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management-0","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management","content":"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial."},"780":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management-1","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management#estados-del-dispositivo","content":"Estados del dispositivo"},"781":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management-2","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","content":"Inspecciona un dispositivo"},"782":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management-3","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","content":"Registra un dispositivo manualmente"},"783":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management-4","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management#crea-el-dispositivo","content":"Crea el dispositivo"},"784":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management-5","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management#define-su-pertenencia","content":"Define su pertenencia"},"785":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management-6","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","content":"Clasifica el dispositivo"},"786":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management-7","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management#verifica-el-alta","content":"Verifica el alta"},"787":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management-8","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","content":"Asigna una identidad manualmente"},"788":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management-9","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","content":"Revoca la identidad actual"},"789":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management-10","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management#retira-un-dispositivo","content":"Retira un dispositivo"},"790":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management-11","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","content":"Automatiza el enrolamiento"},"791":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management-12","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management","content":"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota»."},"792":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management-13","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management","content":"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo."},"793":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management-14","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management#estados-del-dispositivo","content":"Vista operativa"},"794":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management-15","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management#estados-del-dispositivo","content":"Interpretación"},"795":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management-16","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management#estados-del-dispositivo","content":"**No Identity**"},"796":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management-17","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management#estados-del-dispositivo","content":"Hay registro, pero todavía no hay identidad asociada."},"797":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management-18","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management#estados-del-dispositivo","content":"**Active**"},"798":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management-19","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management#estados-del-dispositivo","content":"El slot está activo; comprueba además las fechas, estado y usos del certificado."},"799":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management-20","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management#estados-del-dispositivo","content":"**Renewal Pending**"},"800":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management-21","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management#estados-del-dispositivo","content":"La identidad está en la ventana operativa de renovación."},"801":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management-22","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management#estados-del-dispositivo","content":"**Expiring Soon**"},"802":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management-23","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management#estados-del-dispositivo","content":"Se aproxima al vencimiento según los umbrales configurados."},"803":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management-24","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management#estados-del-dispositivo","content":"**Expired**"},"804":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management-25","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management#estados-del-dispositivo","content":"La identidad ha vencido."},"805":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management-26","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management#estados-del-dispositivo","content":"**Revoked**"},"806":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management-27","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management#estados-del-dispositivo","content":"La identidad está marcada como revocada."},"807":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management-28","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management#estados-del-dispositivo","content":"**Decommissioned**"},"808":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management-29","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management#estados-del-dispositivo","content":"El registro está retirado y no vuelve al estado operativo mediante una actualización normal."},"809":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management-30","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management#estados-del-dispositivo","content":"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor."},"810":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management-31","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","content":"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual."},"811":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management-32","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","content":"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores."},"812":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management-33","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","content":"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados."},"813":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management-34","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","content":"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto."},"814":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management-35","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","content":"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente."},"815":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management-36","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management#crea-el-dispositivo","content":"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota."},"816":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management-37","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management#define-su-pertenencia","content":"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS."},"817":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management-38","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","content":"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario."},"818":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management-39","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management#verifica-el-alta","content":"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación."},"819":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management-40","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management#verifica-el-alta","content":"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento."},"820":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management-41","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","content":"Desde **No Identity**, utiliza **Assign Identity**:"},"821":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management-42","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","content":"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`."},"822":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management-43","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","content":"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil."},"823":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management-44","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","content":"Confirma y vuelve a consultar serie, versión activa e historial."},"824":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management-45","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","content":"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso."},"825":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management-46","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","content":"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla."},"826":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management-47","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","content":"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados."},"827":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management-48","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","content":"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado."},"828":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management-49","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management#retira-un-dispositivo","content":"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor."},"829":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management-50","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management#retira-un-dispositivo","content":"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie."},"830":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management-51","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management#retira-un-dispositivo","content":"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente."},"831":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management-52","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management#retira-un-dispositivo","content":"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo."},"832":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management-53","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","content":"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />"},"833":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management-54","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","content":"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />"},"834":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/bootstrap-identity","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/bootstrap-identity","type":"page","content":"Identidad inicial y autenticación","breadcrumbs":["Docs","Plataforma","IoT Fleets","Dispositivos e identidades","Enrolamiento con PKI"],"tags":[],"url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/bootstrap-identity"},"835":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/bootstrap-identity-0","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/bootstrap-identity","content":"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll."},"836":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/bootstrap-identity-1","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/bootstrap-identity","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","content":"Confianza inicial del servidor"},"837":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/bootstrap-identity-2","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/bootstrap-identity","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","content":"Credencial bootstrap"},"838":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/bootstrap-identity-3","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/bootstrap-identity","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","content":"Modos por operación"},"839":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/bootstrap-identity-4","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/bootstrap-identity","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","content":"Contrato del webhook"},"840":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/bootstrap-identity-5","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/bootstrap-identity","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","content":"Revocación y comprobaciones"},"841":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/bootstrap-identity-6","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/bootstrap-identity","content":"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto."},"842":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/bootstrap-identity-7","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","content":"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`."},"843":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/bootstrap-identity-8","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","content":"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas."},"844":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/bootstrap-identity-9","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","content":"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio."},"845":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/bootstrap-identity-10","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","content":"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto."},"846":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/bootstrap-identity-11","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","content":"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada."},"847":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/bootstrap-identity-12","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","content":"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca."},"848":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/bootstrap-identity-13","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","content":"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS."},"849":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/bootstrap-identity-14","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","content":"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS."},"850":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/bootstrap-identity-15","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","content":"Ejemplo de cuerpo:"},"851":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/bootstrap-identity-16","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","content":"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada."},"852":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/bootstrap-identity-17","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","content":"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor."},"853":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/bootstrap-identity-18","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","content":"La continuación requiere respuesta HTTP satisfactoria y JSON:"},"854":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/bootstrap-identity-19","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","content":"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook."},"855":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/bootstrap-identity-20","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","content":"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes."},"856":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/bootstrap-identity-21","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","content":"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST."},"857":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms","type":"page","content":"Configura y opera el DMS","breadcrumbs":["Docs","Plataforma","IoT Fleets","Dispositivos e identidades","Enrolamiento con PKI"],"tags":[],"url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms"},"858":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms-0","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms","content":"Define registro, autenticación por operación, emisión, renovación y confianza distribuida."},"859":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms-1","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms#antes-de-empezar","content":"Antes de empezar"},"860":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms-2","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms#configura-un-dms","content":"Configura un DMS"},"861":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms-3","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","content":"Identifica la flota"},"862":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms-4","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","content":"Selecciona la CA de enrolamiento"},"863":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms-5","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms#configura-est","content":"Configura EST"},"864":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms-6","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","content":"Distribuye la confianza"},"865":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms-7","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","content":"Verifica los endpoints"},"866":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms-8","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","content":"Configuración de enrollment"},"867":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms-9","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration","content":"Enrollment Device Registration"},"868":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms-10","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"Enrollment Settings"},"869":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms-11","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","content":"Autenticación por operación"},"870":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms-12","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"Ajustes del webhook externo"},"871":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms-13","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","content":"Perfil de emisión"},"872":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms-14","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","content":"Configuración de re-enrollment"},"873":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms-15","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms#serverkeygen","content":"ServerKeyGen"},"874":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms-16","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","content":"Distribución de confianza"},"875":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms-17","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","content":"Opera el inventario de DMS"},"876":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms-18","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","content":"Integra los dispositivos"},"877":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms-19","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms","content":"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política."},"878":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms-20","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms#antes-de-empezar","content":"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución."},"879":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms-21","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms#antes-de-empezar","content":"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo."},"880":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms-22","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","content":"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario."},"881":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms-23","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","content":"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor."},"882":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms-24","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms#configura-est","content":"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave."},"883":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms-25","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","content":"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza."},"884":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms-26","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","content":"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen."},"885":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms-27","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration","content":"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta."},"886":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms-28","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration","content":"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo."},"887":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms-29","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"Campo de `settings.enrollment_settings`"},"888":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms-30","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"Decisión"},"889":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms-31","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"`protocol`"},"890":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms-32","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"`EST_RFC7030` para estas operaciones."},"891":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms-33","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"`enrollment_ca`"},"892":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms-34","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"ID de la CA que firmará."},"893":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms-35","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"`verify_csr_signature`"},"894":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms-36","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"Mantén `true` para comprobar posesión de la clave de la CSR."},"895":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms-37","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"`enable_replaceable_enrollment`"},"896":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms-38","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico."},"897":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms-39","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"`est_rfc7030_settings.auth_mode`"},"898":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms-40","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"Uno de los cuatro modos de autenticación."},"899":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms-41","page_id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales."},"900":{"id":"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms-42","page_i