s/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/data-model#tablas-del-modo-nativo","content":"Se crean en Postgres al arrancar, en la base de datos `updates`. Los tipos de Go están en `pkg/models/updates.go` del repositorio ota."},"2791":{"id":"/docs/pr-preview/pr-56/es/platform/updates/data-model-11","page_id":"/docs/pr-preview/pr-56/es/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/data-model#tablas-del-modo-nativo","content":"Tabla"},"2792":{"id":"/docs/pr-preview/pr-56/es/platform/updates/data-model-12","page_id":"/docs/pr-preview/pr-56/es/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/data-model#tablas-del-modo-nativo","content":"Contiene"},"2793":{"id":"/docs/pr-preview/pr-56/es/platform/updates/data-model-13","page_id":"/docs/pr-preview/pr-56/es/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/data-model#tablas-del-modo-nativo","content":"`distribution_set`"},"2794":{"id":"/docs/pr-preview/pr-56/es/platform/updates/data-model-14","page_id":"/docs/pr-preview/pr-56/es/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/data-model#tablas-del-modo-nativo","content":"Un paquete de actualización: nombre, versión, grupo, tipo, empaquetado, estado, la sw-description (`sw_descriptor`), precondiciones, ajustes de cifrado y firma, y la cobertura del build por dispositivo"},"2795":{"id":"/docs/pr-preview/pr-56/es/platform/updates/data-model-15","page_id":"/docs/pr-preview/pr-56/es/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/data-model#tablas-del-modo-nativo","content":"`distribution_set_version`"},"2796":{"id":"/docs/pr-preview/pr-56/es/platform/updates/data-model-16","page_id":"/docs/pr-preview/pr-56/es/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/data-model#tablas-del-modo-nativo","content":"Una instantánea de cada versión construida, con su manifiesto firmado"},"2797":{"id":"/docs/pr-preview/pr-56/es/platform/updates/data-model-17","page_id":"/docs/pr-preview/pr-56/es/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/data-model#tablas-del-modo-nativo","content":"`distribution_set_module`"},"2798":{"id":"/docs/pr-preview/pr-56/es/platform/updates/data-model-18","page_id":"/docs/pr-preview/pr-56/es/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/data-model#tablas-del-modo-nativo","content":"Los módulos de una versión de paquete, con clave formada por paquete, versión, tipo de módulo y nombre. También contiene módulos de catálogo que no pertenecen a ningún paquete, con el ID de paquete vacío"},"2799":{"id":"/docs/pr-preview/pr-56/es/platform/updates/data-model-19","page_id":"/docs/pr-preview/pr-56/es/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/data-model#tablas-del-modo-nativo","content":"`artifact`"},"2800":{"id":"/docs/pr-preview/pr-56/es/platform/updates/data-model-20","page_id":"/docs/pr-preview/pr-56/es/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/data-model#tablas-del-modo-nativo","content":"Un artefacto global: la entrada de catálogo de un fichero subido, único por nombre y versión"},"2801":{"id":"/docs/pr-preview/pr-56/es/platform/updates/data-model-21","page_id":"/docs/pr-preview/pr-56/es/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/data-model#tablas-del-modo-nativo","content":"`distribution_set_artifact`"},"2802":{"id":"/docs/pr-preview/pr-56/es/platform/updates/data-model-22","page_id":"/docs/pr-preview/pr-56/es/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/data-model#tablas-del-modo-nativo","content":"El enlace entre una versión de paquete, un artefacto y, opcionalmente, un módulo"},"2803":{"id":"/docs/pr-preview/pr-56/es/platform/updates/data-model-23","page_id":"/docs/pr-preview/pr-56/es/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/data-model#tablas-del-modo-nativo","content":"`launchtrack`"},"2804":{"id":"/docs/pr-preview/pr-56/es/platform/updates/data-model-24","page_id":"/docs/pr-preview/pr-56/es/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/data-model#tablas-del-modo-nativo","content":"Una campaña de lanzamiento: estrategia, estado, umbrales y contabilidad de lotes"},"2805":{"id":"/docs/pr-preview/pr-56/es/platform/updates/data-model-25","page_id":"/docs/pr-preview/pr-56/es/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/data-model#tablas-del-modo-nativo","content":"`launch_device_assignments`"},"2806":{"id":"/docs/pr-preview/pr-56/es/platform/updates/data-model-26","page_id":"/docs/pr-preview/pr-56/es/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/data-model#tablas-del-modo-nativo","content":"El estado de cada dispositivo dentro de un lanzamiento: `pending`, `active`, `completed` o `failed`"},"2807":{"id":"/docs/pr-preview/pr-56/es/platform/updates/data-model-27","page_id":"/docs/pr-preview/pr-56/es/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/data-model#tablas-del-modo-nativo","content":"`device_distribution_set_version`"},"2808":{"id":"/docs/pr-preview/pr-56/es/platform/updates/data-model-28","page_id":"/docs/pr-preview/pr-56/es/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/data-model#tablas-del-modo-nativo","content":"Qué versión de paquete lleva ahora un dispositivo"},"2809":{"id":"/docs/pr-preview/pr-56/es/platform/updates/data-model-29","page_id":"/docs/pr-preview/pr-56/es/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/data-model#tablas-del-modo-nativo","content":"`device_distribution_set_update`"},"2810":{"id":"/docs/pr-preview/pr-56/es/platform/updates/data-model-30","page_id":"/docs/pr-preview/pr-56/es/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/data-model#tablas-del-modo-nativo","content":"El historial de actualizaciones de un dispositivo"},"2811":{"id":"/docs/pr-preview/pr-56/es/platform/updates/data-model-31","page_id":"/docs/pr-preview/pr-56/es/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/data-model#tablas-del-modo-nativo","content":"`latest_distribution_set_version`"},"2812":{"id":"/docs/pr-preview/pr-56/es/platform/updates/data-model-32","page_id":"/docs/pr-preview/pr-56/es/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/data-model#tablas-del-modo-nativo","content":"La última versión declarada por grupo y paquete"},"2813":{"id":"/docs/pr-preview/pr-56/es/platform/updates/data-model-33","page_id":"/docs/pr-preview/pr-56/es/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/data-model#tablas-del-modo-nativo","content":"`updates_schema_migrations`"},"2814":{"id":"/docs/pr-preview/pr-56/es/platform/updates/data-model-34","page_id":"/docs/pr-preview/pr-56/es/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/data-model#tablas-del-modo-nativo","content":"Una fila por cada migración de datos que debe ejecutarse una sola vez (la migración del umbral de aprobación)"},"2815":{"id":"/docs/pr-preview/pr-56/es/platform/updates/data-model-35","page_id":"/docs/pr-preview/pr-56/es/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/data-model#tablas-del-modo-nativo","content":"Los bytes de los ficheros (artefactos, builds, claves) no están en Postgres. Viven en los almacenes de blobs descritos en Configuración. La sw-description está en Postgres (una columna del paquete y de cada módulo)."},"2816":{"id":"/docs/pr-preview/pr-56/es/platform/updates/data-model-36","page_id":"/docs/pr-preview/pr-56/es/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/data-model#tablas-del-modo-hawkbit","content":"En modo hawkBit, los paquetes, rollouts y jobs viven en hawkBit. Este servicio guarda solo lo siguiente en el mismo Postgres (la base de datos `updates`), para aquello para lo que hawkBit no tiene equivalente:"},"2817":{"id":"/docs/pr-preview/pr-56/es/platform/updates/data-model-37","page_id":"/docs/pr-preview/pr-56/es/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/data-model#tablas-del-modo-hawkbit","content":"Tabla"},"2818":{"id":"/docs/pr-preview/pr-56/es/platform/updates/data-model-38","page_id":"/docs/pr-preview/pr-56/es/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/data-model#tablas-del-modo-hawkbit","content":"Contiene"},"2819":{"id":"/docs/pr-preview/pr-56/es/platform/updates/data-model-39","page_id":"/docs/pr-preview/pr-56/es/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/data-model#tablas-del-modo-hawkbit","content":"`hawkbit_staged_artifact`"},"2820":{"id":"/docs/pr-preview/pr-56/es/platform/updates/data-model-40","page_id":"/docs/pr-preview/pr-56/es/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/data-model#tablas-del-modo-hawkbit","content":"Bytes de `POST /artifacts`. Las subidas con más de 30 minutos se descartan la próxima vez que alguien sube un artefacto, y siguen siendo legibles hasta entonces. No se pueden enlazar a un paquete en este modo"},"2821":{"id":"/docs/pr-preview/pr-56/es/platform/updates/data-model-41","page_id":"/docs/pr-preview/pr-56/es/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/data-model#tablas-del-modo-hawkbit","content":"`hawkbit_artifact_alias`"},"2822":{"id":"/docs/pr-preview/pr-56/es/platform/updates/data-model-42","page_id":"/docs/pr-preview/pr-56/es/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/data-model#tablas-del-modo-hawkbit","content":"Se lee al resolver un ID de artefacto, pero ya nada la escribe"},"2823":{"id":"/docs/pr-preview/pr-56/es/platform/updates/data-model-43","page_id":"/docs/pr-preview/pr-56/es/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/data-model#tablas-del-modo-hawkbit","content":"`hawkbit_sw_descriptor_v2`"},"2824":{"id":"/docs/pr-preview/pr-56/es/platform/updates/data-model-44","page_id":"/docs/pr-preview/pr-56/es/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/data-model#tablas-del-modo-hawkbit","content":"sw-descriptions, precondiciones de lanzamiento y banderas de rollout (un almacén de texto clave-valor de uso general, con clave formada por instancia, tipo e ID)"},"2825":{"id":"/docs/pr-preview/pr-56/es/platform/updates/data-model-45","page_id":"/docs/pr-preview/pr-56/es/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/data-model#tablas-del-modo-hawkbit","content":"`hawkbit_set_manifest_v2`"},"2826":{"id":"/docs/pr-preview/pr-56/es/platform/updates/data-model-46","page_id":"/docs/pr-preview/pr-56/es/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/data-model#tablas-del-modo-hawkbit","content":"Manifiestos firmados de los sets construidos"},"2827":{"id":"/docs/pr-preview/pr-56/es/platform/updates/data-model-47","page_id":"/docs/pr-preview/pr-56/es/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/data-model#tablas-del-modo-hawkbit","content":"`hawkbit_cancelled_rollout_v2`"},"2828":{"id":"/docs/pr-preview/pr-56/es/platform/updates/data-model-48","page_id":"/docs/pr-preview/pr-56/es/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/data-model#tablas-del-modo-hawkbit","content":"Rollouts cancelados a través de este servicio"},"2829":{"id":"/docs/pr-preview/pr-56/es/platform/updates/data-model-49","page_id":"/docs/pr-preview/pr-56/es/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/data-model#tablas-del-modo-hawkbit","content":"`latest_distribution_set_version`"},"2830":{"id":"/docs/pr-preview/pr-56/es/platform/updates/data-model-50","page_id":"/docs/pr-preview/pr-56/es/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/data-model#tablas-del-modo-hawkbit","content":"Últimas versiones declaradas (compartida con el modo nativo)"},"2831":{"id":"/docs/pr-preview/pr-56/es/platform/updates/data-model-51","page_id":"/docs/pr-preview/pr-56/es/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/data-model#tablas-del-modo-hawkbit","content":"Las filas con clave formada por un ID de hawkBit llevan un `instance_id`, un marcador de los datos de hawkBit que describen. Si hawkBit pierde sus datos y empieza de nuevo, los IDs se repiten, y el servicio deja de leer las filas escritas para la instancia anterior. El servicio vuelve a comprobar el marcador cada 30 segundos."},"2832":{"id":"/docs/pr-preview/pr-56/es/platform/updates/data-model-52","page_id":"/docs/pr-preview/pr-56/es/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/data-model#tablas-del-modo-hawkbit","content":"hawkBit mantiene su propio esquema en su propia base de datos `hawkbit`. En el stack de Docker Compose, `init.sql` crea ambas bases de datos la primera vez que arranca el contenedor de Postgres."},"2833":{"id":"/docs/pr-preview/pr-56/es/platform/updates/data-model-53","page_id":"/docs/pr-preview/pr-56/es/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/data-model#diagramas-entidad-relación","content":"Las tablas del modo nativo, con sus columnas principales. Las columnas `*_id` que apuntan a otra tabla se dibujan como las líneas de relación. Son referencias lógicas: el servicio no crea restricciones de clave foránea en la base de datos, y `FK` solo marca qué columna contiene la referencia."},"2834":{"id":"/docs/pr-preview/pr-56/es/platform/updates/data-model-54","page_id":"/docs/pr-preview/pr-56/es/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/data-model#lanzamientos-y-dispositivos","content":"Valores que conviene conocer:"},"2835":{"id":"/docs/pr-preview/pr-56/es/platform/updates/data-model-55","page_id":"/docs/pr-preview/pr-56/es/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/data-model#lanzamientos-y-dispositivos","content":"`distribution_set.status` es `draft`, `built` o `build_failed`. `packaging` es `swu` o `non-swu`. `encryption_mode` es vacío, `shared` o `per-device`."},"2836":{"id":"/docs/pr-preview/pr-56/es/platform/updates/data-model-56","page_id":"/docs/pr-preview/pr-56/es/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/data-model#lanzamientos-y-dispositivos","content":"`launchtrack.status` es `running`, `paused`, `cancelled` o `completed`. Un lanzamiento nuevo se guarda con estado vacío, que significa running. `aborted` es verdadero en un lanzamiento cancelado (por el operador o por el umbral de error) y detiene todas las vías de despliegue. El resultado de las precondiciones del lanzamiento (`forced_preconditions`, `precondition_failures`) se guarda en la fila, pero no las precondiciones en sí: esas viven en el paquete."},"2837":{"id":"/docs/pr-preview/pr-56/es/platform/updates/data-model-57","page_id":"/docs/pr-preview/pr-56/es/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/data-model#lanzamientos-y-dispositivos","content":"`rollout_type` no se valida: solo el valor `percentage` hace que `rollout_value` sea un porcentaje, y cualquier otro valor (el dashboard envía `numeric`, los ejemplos usan `fixed`) lo convierte en un número de dispositivos."},"2838":{"id":"/docs/pr-preview/pr-56/es/platform/updates/data-model-58","page_id":"/docs/pr-preview/pr-56/es/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/data-model#lanzamientos-y-dispositivos","content":"`launch_device_assignments.status` es `pending`, `active`, `completed` o `failed`. (`cancelled` también existe como valor, pero solo lo informa el modo hawkBit, para un canario cuyo lanzamiento se canceló; nunca se almacena.)"},"2839":{"id":"/docs/pr-preview/pr-56/es/platform/updates/data-model-59","page_id":"/docs/pr-preview/pr-56/es/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/data-model#lanzamientos-y-dispositivos","content":"`device_distribution_set_update.status` es `pending`, `running`, `success` o `failed` (el modo hawkBit también puede informar `cancelled`), y su `source` es `service`."},"2840":{"id":"/docs/pr-preview/pr-56/es/platform/updates/data-model-60","page_id":"/docs/pr-preview/pr-56/es/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/data-model#lanzamientos-y-dispositivos","content":"`distribution_set_module` es único por paquete, versión de paquete, tipo y nombre. Un módulo de catálogo independiente tiene `distribution_set_id` vacío, y su `distribution_set_version` es igual a su propia `version`."},"2841":{"id":"/docs/pr-preview/pr-56/es/platform/updates/data-model-61","page_id":"/docs/pr-preview/pr-56/es/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/data-model#lanzamientos-y-dispositivos","content":"`distribution_set_version` es único por paquete y versión, y `distribution_set_artifact` por paquete, versión y artefacto."},"2842":{"id":"/docs/pr-preview/pr-56/es/platform/updates/data-model-62","page_id":"/docs/pr-preview/pr-56/es/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/data-model#lanzamientos-y-dispositivos","content":"No dibujadas: `updates_schema_migrations`, una tabla de marcas que usan las migraciones de datos del arranque, y las tablas del modo hawkBit listadas arriba."},"2843":{"id":"/docs/pr-preview/pr-56/es/platform/updates/data-model-63","page_id":"/docs/pr-preview/pr-56/es/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/data-model#cómo-leer-el-diagrama","content":"Un **paquete** (`distribution_set`) es una fila que avanza por versiones. Cada versión construida se guarda como instantánea en `distribution_set_version`, con su manifiesto firmado."},"2844":{"id":"/docs/pr-preview/pr-56/es/platform/updates/data-model-64","page_id":"/docs/pr-preview/pr-56/es/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/data-model#cómo-leer-el-diagrama","content":"Los **módulos** y los **artefactos** son cosas distintas: un artefacto es un fichero del catálogo global, y `distribution_set_artifact` lo enlaza a una versión de paquete (y opcionalmente a un módulo). Un módulo cuyo `distribution_set_id` está vacío es un módulo de catálogo que ningún paquete contiene todavía."},"2845":{"id":"/docs/pr-preview/pr-56/es/platform/updates/data-model-65","page_id":"/docs/pr-preview/pr-56/es/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/data-model#cómo-leer-el-diagrama","content":"Un **lanzamiento** (`launchtrack`) se dirige a un grupo mediante una fila de asignación por dispositivo. La asignación pasa de `pending` → `active` → `completed` o `failed`, y `batch_index` registra qué lote la envió."},"2846":{"id":"/docs/pr-preview/pr-56/es/platform/updates/data-model-66","page_id":"/docs/pr-preview/pr-56/es/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/data-model#cómo-leer-el-diagrama","content":"Dos tablas de dispositivo responden a preguntas distintas. `device_distribution_set_version` es lo que un dispositivo lleva **ahora**. `device_distribution_set_update` es el **historial** de intentos, con `version_from` y `version_to`."},"2847":{"id":"/docs/pr-preview/pr-56/es/platform/updates/data-model-67","page_id":"/docs/pr-preview/pr-56/es/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/data-model#cómo-leer-el-diagrama","content":"`latest_distribution_set_version` es la versión en la que un operador declaró que deben estar los dispositivos de un grupo, y se usa para la desviación y el cumplimiento."},"2848":{"id":"/docs/pr-preview/pr-56/es/platform/updates/data-model-68","page_id":"/docs/pr-preview/pr-56/es/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/data-model#creación-del-esquema-y-migraciones","content":"No hay ficheros de migración. En modo nativo, el servicio crea y actualiza su propio esquema al arrancar, manteniendo un lock de Postgres para que las réplicas que arrancan a la vez no compitan. Ejecuta estos pasos en orden (el modo hawkBit solo crea sus seis tablas):"},"2849":{"id":"/docs/pr-preview/pr-56/es/platform/updates/data-model-69","page_id":"/docs/pr-preview/pr-56/es/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/data-model#creación-del-esquema-y-migraciones","content":"**Paso de renombrado** (`MigrateDistributionSetNaming`). A las bases de datos creadas antes del cambio de nombre «update pack» → «distribution set» se les renombran tablas y columnas. Se ejecuta antes del paso 2 para que las tablas nuevas no se creen vacías junto a las antiguas."},"2850":{"id":"/docs/pr-preview/pr-56/es/platform/updates/data-model-70","page_id":"/docs/pr-preview/pr-56/es/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/data-model#creación-del-esquema-y-migraciones","content":"**Crear y añadir** (GORM `AutoMigrate`). Se crean las tablas y columnas que faltan. Nunca elimina ni renombra nada."},"2851":{"id":"/docs/pr-preview/pr-56/es/platform/updates/data-model-71","page_id":"/docs/pr-preview/pr-56/es/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/data-model#creación-del-esquema-y-migraciones","content":"**Migraciones de datos.** Módulos independientes (las filas de `software_module_definition` pasan a las tablas de módulos y artefactos, conservando IDs y ficheros, y se elimina la tabla antigua), asignaciones de dispositivos (reconstruidas a partir de las columnas heredadas del lanzamiento) y la semántica del umbral de aprobación."},"2852":{"id":"/docs/pr-preview/pr-56/es/platform/updates/data-model-72","page_id":"/docs/pr-preview/pr-56/es/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/data-model#creación-del-esquema-y-migraciones","content":"La mayoría de los pasos comprueban el esquema actual en lugar de un número de versión, y la migración del umbral de aprobación registra una fila en `updates_schema_migrations` para ejecutarse solo una vez. Arrancar varias veces es seguro, y una base de datos nueva no tiene nada que migrar. Tras los pasos de esquema, el servicio también copia al almacén de artefactos los binarios del esquema heredado, organizado por paquete en disco, omitiendo los que ya están allí."},"2853":{"id":"/docs/pr-preview/pr-56/es/platform/updates/data-model-73","page_id":"/docs/pr-preview/pr-56/es/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/data-model#creación-del-esquema-y-migraciones","content":"`init.sql` es una semilla de Docker Compose: crea las bases de datos `updates` y `hawkbit` y aún contiene definiciones de tablas antiguas, así que no lo uses para definir tú mismo el esquema."},"2854":{"id":"/docs/pr-preview/pr-56/es/platform/updates/data-model-74","page_id":"/docs/pr-preview/pr-56/es/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/data-model#creación-del-esquema-y-migraciones","content":"Consulta Operaciones para saber qué hacer antes de actualizar de versión."},"2855":{"id":"/docs/pr-preview/pr-56/es/platform/updates/data-model-75","page_id":"/docs/pr-preview/pr-56/es/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/data-model#siguientes-pasos","content":"<Card title=\"Configuración\" description=\"Almacenes de blobs, storage y cada campo de configuración.\" href=\"/docs/platform/updates/reference/configuration\" />"},"2856":{"id":"/docs/pr-preview/pr-56/es/platform/updates/data-model-76","page_id":"/docs/pr-preview/pr-56/es/platform/updates/data-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/data-model#siguientes-pasos","content":"<Card title=\"Operaciones\" description=\"Respalda, escala y actualiza la base de datos.\" href=\"/docs/platform/updates/operations\" />"},"2857":{"id":"/docs/pr-preview/pr-56/es/platform/updates/flows","page_id":"/docs/pr-preview/pr-56/es/platform/updates/flows","type":"page","content":"Flujos","breadcrumbs":["Docs","Plataforma","[Enterprise] Actualizaciones","Conceptos"],"tags":[],"url":"/docs/pr-preview/pr-56/es/platform/updates/flows"},"2858":{"id":"/docs/pr-preview/pr-56/es/platform/updates/flows-0","page_id":"/docs/pr-preview/pr-56/es/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/flows","content":"Diagramas de secuencia de las operaciones importantes, para los backends nativo y hawkBit."},"2859":{"id":"/docs/pr-preview/pr-56/es/platform/updates/flows-1","page_id":"/docs/pr-preview/pr-56/es/platform/updates/flows","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/updates/flows#modo-nativo","content":"Modo nativo"},"2860":{"id":"/docs/pr-preview/pr-56/es/platform/updates/flows-2","page_id":"/docs/pr-preview/pr-56/es/platform/updates/flows","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/updates/flows#1-publicar-y-construir-un-paquete","content":"1\\. Publicar y construir un paquete"},"2861":{"id":"/docs/pr-preview/pr-56/es/platform/updates/flows-3","page_id":"/docs/pr-preview/pr-56/es/platform/updates/flows","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/updates/flows#2-crear-un-lanzamiento","content":"2\\. Crear un lanzamiento"},"2862":{"id":"/docs/pr-preview/pr-56/es/platform/updates/flows-4","page_id":"/docs/pr-preview/pr-56/es/platform/updates/flows","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/updates/flows#3-desplegar-un-lote-y-actualizar-un-dispositivo","content":"3\\. Desplegar un lote y actualizar un dispositivo"},"2863":{"id":"/docs/pr-preview/pr-56/es/platform/updates/flows-5","page_id":"/docs/pr-preview/pr-56/es/platform/updates/flows","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/updates/flows#4-reaccionar-cuando-un-dispositivo-termina","content":"4\\. Reaccionar cuando un dispositivo termina"},"2864":{"id":"/docs/pr-preview/pr-56/es/platform/updates/flows-6","page_id":"/docs/pr-preview/pr-56/es/platform/updates/flows","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/updates/flows#5-construir-un-paquete-cifrado-por-dispositivo","content":"5\\. Construir un paquete cifrado por dispositivo"},"2865":{"id":"/docs/pr-preview/pr-56/es/platform/updates/flows-7","page_id":"/docs/pr-preview/pr-56/es/platform/updates/flows","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/updates/flows#modo-hawkbit","content":"Modo hawkBit"},"2866":{"id":"/docs/pr-preview/pr-56/es/platform/updates/flows-8","page_id":"/docs/pr-preview/pr-56/es/platform/updates/flows","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/updates/flows#6-construir-un-módulo-y-crear-un-paquete","content":"6\\. Construir un módulo y crear un paquete"},"2867":{"id":"/docs/pr-preview/pr-56/es/platform/updates/flows-9","page_id":"/docs/pr-preview/pr-56/es/platform/updates/flows","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/updates/flows#7-lanzamiento-y-actualización-del-dispositivo","content":"7\\. Lanzamiento y actualización del dispositivo"},"2868":{"id":"/docs/pr-preview/pr-56/es/platform/updates/flows-10","page_id":"/docs/pr-preview/pr-56/es/platform/updates/flows","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/updates/flows#siguientes-pasos","content":"Siguientes pasos"},"2869":{"id":"/docs/pr-preview/pr-56/es/platform/updates/flows-11","page_id":"/docs/pr-preview/pr-56/es/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/flows","content":"Estos diagramas siguen lo que hace el servicio, paso a paso. Las rutas son relativas a `/updates/v1`. Para ver comandos ejecutables consulta las guías de curl nativa y hawkBit, y la referencia de la API para cada ruta y cuerpo."},"2870":{"id":"/docs/pr-preview/pr-56/es/platform/updates/flows-12","page_id":"/docs/pr-preview/pr-56/es/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/flows#1-publicar-y-construir-un-paquete","content":"Construir convierte los artefactos subidos y la sw-description en un único `.swu`. Nada se firma ni se cifra salvo que la petición de build lo pida."},"2871":{"id":"/docs/pr-preview/pr-56/es/platform/updates/flows-13","page_id":"/docs/pr-preview/pr-56/es/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/flows#1-publicar-y-construir-un-paquete","content":"Cosas que conviene saber sobre el build:"},"2872":{"id":"/docs/pr-preview/pr-56/es/platform/updates/flows-14","page_id":"/docs/pr-preview/pr-56/es/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/flows#1-publicar-y-construir-un-paquete","content":"El paquete se crea con un nombre, una `version` semántica, un `group_id`, un `type` y un `packaging` opcional. Un nombre duplicado en el grupo da un `409`."},"2873":{"id":"/docs/pr-preview/pr-56/es/platform/updates/flows-15","page_id":"/docs/pr-preview/pr-56/es/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/flows#1-publicar-y-construir-un-paquete","content":"Subir un artefacto (o un entregable ya construido) a una versión que ya está construida se rechaza con `409`: crea primero una versión nueva. Un build o cambio que colisione con otro sobre el mismo paquete también responde `409`."},"2874":{"id":"/docs/pr-preview/pr-56/es/platform/updates/flows-16","page_id":"/docs/pr-preview/pr-56/es/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/flows#1-publicar-y-construir-un-paquete","content":"Un fichero mayor que `max_artifact_size_mb` (10240 MiB por defecto) se rechaza con `413`."},"2875":{"id":"/docs/pr-preview/pr-56/es/platform/updates/flows-17","page_id":"/docs/pr-preview/pr-56/es/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/flows#1-publicar-y-construir-un-paquete","content":"El cifrado lo decide el cuerpo del build: `user` más `encryption_key_name` es cifrado con clave compartida, y `encryption_alg_name` solo es cifrado por dispositivo (flujo 5)."},"2876":{"id":"/docs/pr-preview/pr-56/es/platform/updates/flows-18","page_id":"/docs/pr-preview/pr-56/es/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/flows#1-publicar-y-construir-un-paquete","content":"Si el build falla, el paquete pasa a `build_failed`, `last_build_error` dice por qué, y el paquete sigue siendo editable. Los artefactos seleccionados reemplazan los enlaces de artefactos anteriores de la versión del paquete."},"2877":{"id":"/docs/pr-preview/pr-56/es/platform/updates/flows-19","page_id":"/docs/pr-preview/pr-56/es/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/flows#1-publicar-y-construir-un-paquete","content":"Sin campos de firma, el manifiesto se guarda sin firmar. Si se indica una clave de firma pero no un certificado, el build falla."},"2878":{"id":"/docs/pr-preview/pr-56/es/platform/updates/flows-20","page_id":"/docs/pr-preview/pr-56/es/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/flows#1-publicar-y-construir-un-paquete","content":"Un paquete `non-swu` se construye con `POST .../package` en un `.tar.gz`, y un entregable construido fuera se adjunta con `POST .../swu/upload` o `.../package/upload`."},"2879":{"id":"/docs/pr-preview/pr-56/es/platform/updates/flows-21","page_id":"/docs/pr-preview/pr-56/es/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/flows#2-crear-un-lanzamiento","content":"Crear un lanzamiento decide a quién se dirige y comprueba que el paquete se puede entregar. Todavía no se envía nada a ningún dispositivo."},"2880":{"id":"/docs/pr-preview/pr-56/es/platform/updates/flows-22","page_id":"/docs/pr-preview/pr-56/es/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/flows#2-crear-un-lanzamiento","content":"`?dry_run=true` se detiene tras la comprobación de precondiciones y responde `200` con `qualifying_devices`, `precondition_failures`, `superseded_devices` y `never_seen_devices`. `force_preconditions` apunta a todos los dispositivos del grupo y aun así registra cuáles fallaron. `distribution_set_name`, `workflow_type` y `rollout_type` son obligatorios, y también un `rollout_value` mayor que cero. `approval_threshold` y `error_threshold` deben estar entre 0 y 100, y cada incumplimiento es un `400`. Un lanzamiento también puede llevar `auto`, `scheduled_at`, `name`, `description` y `weight` (consulta Conceptos)."},"2881":{"id":"/docs/pr-preview/pr-56/es/platform/updates/flows-23","page_id":"/docs/pr-preview/pr-56/es/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/flows#3-desplegar-un-lote-y-actualizar-un-dispositivo","content":"Una llamada `rollout` envía el siguiente lote. El canario va solo primero, y después lotes del tamaño configurado, elegidos al azar entre los dispositivos que siguen pendientes. El lado del dispositivo de abajo es el workflow `direct`, donde un job empieza en `INSTALL`."},"2882":{"id":"/docs/pr-preview/pr-56/es/platform/updates/flows-24","page_id":"/docs/pr-preview/pr-56/es/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/flows#3-desplegar-un-lote-y-actualizar-un-dispositivo","content":"Con el workflow `phased`, un job empieza en `CREATED`, y algunas transiciones necesitan que una persona o un sistema las confirme en WFX. Este servicio no las avanza. El workflow `download-install`, que usan los paquetes `non-swu`, recorre `DOWNLOAD → DOWNLOADING → DOWNLOADED → INSTALL → INSTALLING → INSTALLED`."},"2883":{"id":"/docs/pr-preview/pr-56/es/platform/updates/flows-25","page_id":"/docs/pr-preview/pr-56/es/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/flows#3-desplegar-un-lote-y-actualizar-un-dispositivo","content":"Con `auto` activado, una llamada `rollout` inicia el lanzamiento y los lotes siguientes los libera el flujo 4. Un lanzamiento con `scheduled_at` lo inicia el disparador de lanzamientos programados en la réplica líder cuando pasa esa hora."},"2884":{"id":"/docs/pr-preview/pr-56/es/platform/updates/flows-26","page_id":"/docs/pr-preview/pr-56/es/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/flows#3-desplegar-un-lote-y-actualizar-un-dispositivo","content":"La llamada `rollout` no siempre es un `200` simple:"},"2885":{"id":"/docs/pr-preview/pr-56/es/platform/updates/flows-27","page_id":"/docs/pr-preview/pr-56/es/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/flows#3-desplegar-un-lote-y-actualizar-un-dispositivo","content":"Se rechaza con `400` cuando el lanzamiento está pausado, cancelado, completado o abortado, y en un lanzamiento `auto` una vez que ha salido algún lote."},"2886":{"id":"/docs/pr-preview/pr-56/es/platform/updates/flows-28","page_id":"/docs/pr-preview/pr-56/es/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/flows#3-desplegar-un-lote-y-actualizar-un-dispositivo","content":"No hace nada y responde `200` mientras `scheduled_at` esté todavía en el futuro, y mientras el canario siga activo. Devuelve un error si el canario falló."},"2887":{"id":"/docs/pr-preview/pr-56/es/platform/updates/flows-29","page_id":"/docs/pr-preview/pr-56/es/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/flows#3-desplegar-un-lote-y-actualizar-un-dispositivo","content":"Si no se pueden crear algunos jobs, esos dispositivos siguen `pending` y la llamada devuelve un error de «partial rollout» (`500`)."},"2888":{"id":"/docs/pr-preview/pr-56/es/platform/updates/flows-30","page_id":"/docs/pr-preview/pr-56/es/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/flows#4-reaccionar-cuando-un-dispositivo-termina","content":"Cada cambio de estado que notifica WFX ejecuta la misma lógica. Es lo que hace funcionar el lote automático, la compuerta del canario y el umbral de error."},"2889":{"id":"/docs/pr-preview/pr-56/es/platform/updates/flows-31","page_id":"/docs/pr-preview/pr-56/es/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/flows#4-reaccionar-cuando-un-dispositivo-termina","content":"En **cada** evento, el servicio actualiza el historial de actualizaciones del dispositivo y escribe el evento en los metadatos del dispositivo en Lamassu. Después, solo si el estado es terminal en el workflow, ejecuta estas comprobaciones en orden, y la primera que se cumple decide lo que ocurre:"},"2890":{"id":"/docs/pr-preview/pr-56/es/platform/updates/flows-32","page_id":"/docs/pr-preview/pr-56/es/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/flows#4-reaccionar-cuando-un-dispositivo-termina","content":"#"},"2891":{"id":"/docs/pr-preview/pr-56/es/platform/updates/flows-33","page_id":"/docs/pr-preview/pr-56/es/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/flows#4-reaccionar-cuando-un-dispositivo-termina","content":"Comprobación"},"2892":{"id":"/docs/pr-preview/pr-56/es/platform/updates/flows-34","page_id":"/docs/pr-preview/pr-56/es/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/flows#4-reaccionar-cuando-un-dispositivo-termina","content":"Si se cumple"},"2893":{"id":"/docs/pr-preview/pr-56/es/platform/updates/flows-35","page_id":"/docs/pr-preview/pr-56/es/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/flows#4-reaccionar-cuando-un-dispositivo-termina","content":"1"},"2894":{"id":"/docs/pr-preview/pr-56/es/platform/updates/flows-36","page_id":"/docs/pr-preview/pr-56/es/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/flows#4-reaccionar-cuando-un-dispositivo-termina","content":"¿Es el estado terminal en el workflow?"},"2895":{"id":"/docs/pr-preview/pr-56/es/platform/updates/flows-37","page_id":"/docs/pr-preview/pr-56/es/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/flows#4-reaccionar-cuando-un-dispositivo-termina","content":"Si no, no ocurre nada más"},"2896":{"id":"/docs/pr-preview/pr-56/es/platform/updates/flows-38","page_id":"/docs/pr-preview/pr-56/es/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/flows#4-reaccionar-cuando-un-dispositivo-termina","content":"2"},"2897":{"id":"/docs/pr-preview/pr-56/es/platform/updates/flows-39","page_id":"/docs/pr-preview/pr-56/es/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/flows#4-reaccionar-cuando-un-dispositivo-termina","content":"(siempre)"},"2898":{"id":"/docs/pr-preview/pr-56/es/platform/updates/flows-40","page_id":"/docs/pr-preview/pr-56/es/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/flows#4-reaccionar-cuando-un-dispositivo-termina","content":"Marcar la asignación del dispositivo como `completed` o `failed`. Si tuvo éxito, registrar la versión instalada"},"2899":{"id":"/docs/pr-preview/pr-56/es/platform/updates/flows-41","page_id":"/docs/pr-preview/pr-56/es/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/flows#4-reaccionar-cuando-un-dispositivo-termina","content":"3"},"2900":{"id":"/docs/pr-preview/pr-56/es/platform/updates/flows-42","page_id":"/docs/pr-preview/pr-56/es/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/flows#4-reaccionar-cuando-un-dispositivo-termina","content":"¿Falló el dispositivo canario?"},"2901":{"id":"/docs/pr-preview/pr-56/es/platform/updates/flows-43","page_id":"/docs/pr-preview/pr-56/es/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/flows#4-reaccionar-cuando-un-dispositivo-termina","content":"Pausar el lanzamiento. Reanuda para reintentar"},"2902":{"id":"/docs/pr-preview/pr-56/es/platform/updates/flows-44","page_id":"/docs/pr-preview/pr-56/es/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/flows#4-reaccionar-cuando-un-dispositivo-termina","content":"4"},"2903":{"id":"/docs/pr-preview/pr-56/es/platform/updates/flows-45","page_id":"/docs/pr-preview/pr-56/es/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/flows#4-reaccionar-cuando-un-dispositivo-termina","content":"¿Está el lanzamiento pausado, cancelado o completado?"},"2904":{"id":"/docs/pr-preview/pr-56/es/platform/updates/flows-46","page_id":"/docs/pr-preview/pr-56/es/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/flows#4-reaccionar-cuando-un-dispositivo-termina","content":"Parar: no hay más lotes"},"2905":{"id":"/docs/pr-preview/pr-56/es/platform/updates/flows-47","page_id":"/docs/pr-preview/pr-56/es/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/flows#4-reaccionar-cuando-un-dispositivo-termina","content":"5"},"2906":{"id":"/docs/pr-preview/pr-56/es/platform/updates/flows-48","page_id":"/docs/pr-preview/pr-56/es/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/flows#4-reaccionar-cuando-un-dispositivo-termina","content":"¿Está definido `error_threshold`, y los fallos han alcanzado esa proporción de todos los dispositivos (redondeada hacia arriba)?"},"2907":{"id":"/docs/pr-preview/pr-56/es/platform/updates/flows-49","page_id":"/docs/pr-preview/pr-56/es/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/flows#4-reaccionar-cuando-un-dispositivo-termina","content":"Cancelar el lanzamiento. Los dispositivos pendientes no se envían"},"2908":{"id":"/docs/pr-preview/pr-56/es/platform/updates/flows-50","page_id":"/docs/pr-preview/pr-56/es/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/flows#4-reaccionar-cuando-un-dispositivo-termina","content":"6"},"2909":{"id":"/docs/pr-preview/pr-56/es/platform/updates/flows-51","page_id":"/docs/pr-preview/pr-56/es/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/flows#4-reaccionar-cuando-un-dispositivo-termina","content":"¿No hay nada pendiente ni nada activo?"},"2910":{"id":"/docs/pr-preview/pr-56/es/platform/updates/flows-52","page_id":"/docs/pr-preview/pr-56/es/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/flows#4-reaccionar-cuando-un-dispositivo-termina","content":"Marcar el lanzamiento como `completed`"},"2911":{"id":"/docs/pr-preview/pr-56/es/platform/updates/flows-53","page_id":"/docs/pr-preview/pr-56/es/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/flows#4-reaccionar-cuando-un-dispositivo-termina","content":"7"},"2912":{"id":"/docs/pr-preview/pr-56/es/platform/updates/flows-54","page_id":"/docs/pr-preview/pr-56/es/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/flows#4-reaccionar-cuando-un-dispositivo-termina","content":"¿Está `auto` desactivado, o no queda nada por enviar?"},"2913":{"id":"/docs/pr-preview/pr-56/es/platform/updates/flows-55","page_id":"/docs/pr-preview/pr-56/es/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/flows#4-reaccionar-cuando-un-dispositivo-termina","content":"Esperar a la siguiente llamada `rollout` del operador, o a los dispositivos que siguen en curso"},"2914":{"id":"/docs/pr-preview/pr-56/es/platform/updates/flows-56","page_id":"/docs/pr-preview/pr-56/es/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/flows#4-reaccionar-cuando-un-dispositivo-termina","content":"8"},"2915":{"id":"/docs/pr-preview/pr-56/es/platform/updates/flows-57","page_id":"/docs/pr-preview/pr-56/es/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/flows#4-reaccionar-cuando-un-dispositivo-termina","content":"¿Tuvo éxito al menos `approval_threshold` de este lote? (0, 100 o más significa todo el lote)"},"2916":{"id":"/docs/pr-preview/pr-56/es/platform/updates/flows-58","page_id":"/docs/pr-preview/pr-56/es/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/flows#4-reaccionar-cuando-un-dispositivo-termina","content":"Enviar el siguiente lote. Si no, esperar más resultados"},"2917":{"id":"/docs/pr-preview/pr-56/es/platform/updates/flows-59","page_id":"/docs/pr-preview/pr-56/es/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/flows#4-reaccionar-cuando-un-dispositivo-termina","content":"Solo los dispositivos enviados en el lote actual cuentan para su aprobación: un rezagado de un lote anterior nunca cuenta. Las comprobaciones mueven el lanzamiento entre estos estados:"},"2918":{"id":"/docs/pr-preview/pr-56/es/platform/updates/flows-60","page_id":"/docs/pr-preview/pr-56/es/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/flows#4-reaccionar-cuando-un-dispositivo-termina","content":"Un lanzamiento nuevo se guarda con estado vacío, que significa `running`. Reanudar tras un fallo del canario vuelve a encolar el canario para que se intente de nuevo. Cancelar detiene los lotes siguientes, pero no retira los jobs que ya se están ejecutando en los dispositivos."},"2919":{"id":"/docs/pr-preview/pr-56/es/platform/updates/flows-61","page_id":"/docs/pr-preview/pr-56/es/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/flows#5-construir-un-paquete-cifrado-por-dispositivo","content":"Cada dispositivo recibe su propio paquete, cifrado con su propia clave. El build resuelve primero la clave de cada dispositivo y después construye. Un dispositivo sin clave se omite, y se rechaza un lanzamiento sobre un paquete con dispositivos omitidos."},"2920":{"id":"/docs/pr-preview/pr-56/es/platform/updates/flows-62","page_id":"/docs/pr-preview/pr-56/es/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/flows#5-construir-un-paquete-cifrado-por-dispositivo","content":"`uncovered_devices` lista los dispositivos sin clave y también aquellos cuyo propio build falló. Un build en el que ningún dispositivo obtuvo paquete deja el paquete en `build_failed`."},"2921":{"id":"/docs/pr-preview/pr-56/es/platform/updates/flows-63","page_id":"/docs/pr-preview/pr-56/es/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/flows#6-construir-un-módulo-y-crear-un-paquete","content":"El propio hawkBit no tiene noción de módulo construido, y este servicio solo enlaza módulos construidos a un distribution set de hawkBit. Un set nunca se construye directamente: `POST .../swu` y `.../package` responden `501` en este modo. Primero se construye el módulo, en el catálogo, y el paquete se crea a partir de él. El diagrama muestra la intención `swu-build`."},"2922":{"id":"/docs/pr-preview/pr-56/es/platform/updates/flows-64","page_id":"/docs/pr-preview/pr-56/es/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/flows#6-construir-un-módulo-y-crear-un-paquete","content":"Las otras intenciones de entrega se saltan pasos: `swu-prebuilt` solo sube el `.swu` terminado, que es lo que construye el módulo, y `raw` solo cifra o firma los ficheros, sin swugenerator ni sw-description (firmar añade un documento de checksum `.sha256` y su firma desacoplada como artefactos extra). Un build puede firmar a través del KMS y cifrar con una clave compartida de SymKMS. El cifrado por dispositivo se rechaza en modo hawkBit. Un módulo enlazado queda congelado: para cambiarlo, edítalo y constrúyelo en el catálogo, y vuelve a enlazarlo."},"2923":{"id":"/docs/pr-preview/pr-56/es/platform/updates/flows-65","page_id":"/docs/pr-preview/pr-56/es/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/flows#7-lanzamiento-y-actualización-del-dispositivo","content":"El dispositivo habla con hawkBit, no con este servicio. El servicio lee el progreso de hawkBit cada vez que se le pide."},"2924":{"id":"/docs/pr-preview/pr-56/es/platform/updates/flows-66","page_id":"/docs/pr-preview/pr-56/es/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/flows#7-lanzamiento-y-actualización-del-dispositivo","content":"Un grupo canario existe solo cuando se indica `test_device_id`. hawkBit decide cuándo un grupo tiene éxito y empieza el siguiente, usando los umbrales de aprobación y de error que le dio el servicio. Con `auto` desactivado, hawkBit se pausa tras cada grupo y la siguiente llamada `rollout` libera el siguiente. La respuesta del lanzamiento también lista `superseded_devices` (dispositivos cuya actualización en curso reemplaza el nuevo rollout) y `never_seen_devices` (dispositivos que nunca han consultado, lo que puede bloquear un grupo que debe alcanzar su umbral de éxito)."},"2925":{"id":"/docs/pr-preview/pr-56/es/platform/updates/flows-67","page_id":"/docs/pr-preview/pr-56/es/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/flows#7-lanzamiento-y-actualización-del-dispositivo","content":"La llamada `rollout` depende del estado del rollout:"},"2926":{"id":"/docs/pr-preview/pr-56/es/platform/updates/flows-68","page_id":"/docs/pr-preview/pr-56/es/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/flows#7-lanzamiento-y-actualización-del-dispositivo","content":"Un rollout `ready` se inicia, y no ocurre nada mientras su hora de inicio esté en el futuro."},"2927":{"id":"/docs/pr-preview/pr-56/es/platform/updates/flows-69","page_id":"/docs/pr-preview/pr-56/es/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/flows#7-lanzamiento-y-actualización-del-dispositivo","content":"Un rollout pausado solo se reanuda si está pausado entre lotes. Una pausa del operador necesita `resume`, y un rollout detenido por su umbral de error no se puede reanudar."},"2928":{"id":"/docs/pr-preview/pr-56/es/platform/updates/flows-70","page_id":"/docs/pr-preview/pr-56/es/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/flows#7-lanzamiento-y-actualización-del-dispositivo","content":"Un rollout manual en ejecución libera su siguiente grupo."},"2929":{"id":"/docs/pr-preview/pr-56/es/platform/updates/flows-71","page_id":"/docs/pr-preview/pr-56/es/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/flows#7-lanzamiento-y-actualización-del-dispositivo","content":"Un rollout `auto` que ya está en ejecución se rechaza con `400`."},"2930":{"id":"/docs/pr-preview/pr-56/es/platform/updates/flows-72","page_id":"/docs/pr-preview/pr-56/es/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/flows#7-lanzamiento-y-actualización-del-dispositivo","content":"Un segundo `rollout` sobre el mismo lanzamiento mientras hay otro en curso responde `409`."},"2931":{"id":"/docs/pr-preview/pr-56/es/platform/updates/flows-73","page_id":"/docs/pr-preview/pr-56/es/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/flows#7-lanzamiento-y-actualización-del-dispositivo","content":"La autenticación de dispositivos es un ajuste del tenant de hawkBit. Los tokens de seguridad de target vienen desactivados por defecto. Consulta Conectar un dispositivo."},"2932":{"id":"/docs/pr-preview/pr-56/es/platform/updates/flows-74","page_id":"/docs/pr-preview/pr-56/es/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/flows#siguientes-pasos","content":"<Card title=\"Publicar y desplegar una actualización\" description=\"Recorre los flujos 1 a 4 de principio a fin.\" href=\"/docs/platform/updates/guides/publish-and-roll-out\" />"},"2933":{"id":"/docs/pr-preview/pr-56/es/platform/updates/flows-75","page_id":"/docs/pr-preview/pr-56/es/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/flows#siguientes-pasos","content":"<Card title=\"Modelo de datos\" description=\"Las tablas detrás de estos flujos.\" href=\"/docs/platform/updates/data-model\" />"},"2934":{"id":"/docs/pr-preview/pr-56/es/platform/updates/flows-76","page_id":"/docs/pr-preview/pr-56/es/platform/updates/flows","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/flows#siguientes-pasos","content":"<Card title=\"Firma y cifrado\" description=\"Claves, firmas y el manifiesto.\" href=\"/docs/platform/updates/signing-and-encryption\" />"},"2935":{"id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started","page_id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started","type":"page","content":"Primeros pasos con Lamassu Updates","breadcrumbs":["Docs","Plataforma","[Enterprise] Actualizaciones","Primeros pasos"],"tags":[],"url":"/docs/pr-preview/pr-56/es/platform/updates/getting-started"},"2936":{"id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started-0","page_id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/getting-started","content":"Ejecuta Lamassu Updates y sus dependencias en local con Docker Compose y comprueba que la API responde."},"2937":{"id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started-1","page_id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/updates/getting-started#antes-de-empezar","content":"Antes de empezar"},"2938":{"id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started-2","page_id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/updates/getting-started#arranca-el-stack","content":"Arranca el stack"},"2939":{"id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started-3","page_id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/updates/getting-started#clona-el-repositorio","content":"Clona el repositorio"},"2940":{"id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started-4","page_id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/updates/getting-started#indica-la-dirección-del-host","content":"Indica la dirección del host"},"2941":{"id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started-5","page_id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/updates/getting-started#crea-la-red-y-arranca","content":"Crea la red y arranca"},"2942":{"id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started-6","page_id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/updates/getting-started#servicios","content":"Servicios"},"2943":{"id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started-7","page_id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/updates/getting-started#verifica-la-api","content":"Verifica la API"},"2944":{"id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started-8","page_id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/updates/getting-started#ejecuta-sin-docker","content":"Ejecuta sin Docker"},"2945":{"id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started-9","page_id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/updates/getting-started#prueba-el-modo-hawkbit","content":"Prueba el modo hawkBit"},"2946":{"id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started-10","page_id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/updates/getting-started#solución-de-problemas","content":"Solución de problemas"},"2947":{"id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started-11","page_id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/updates/getting-started#siguientes-pasos","content":"Siguientes pasos"},"2948":{"id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started-12","page_id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/getting-started","content":"Esta guía arranca Lamassu Updates (el OTA Update Service) con Docker Compose, en su modo nativo por defecto, y comprueba que la API responde. Lleva unos diez minutos más la construcción de las imágenes. Cuando funcione, continúa con Publica y lanza una actualización."},"2949":{"id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started-13","page_id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/getting-started#antes-de-empezar","content":"Docker con el plugin Compose."},"2950":{"id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started-14","page_id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/getting-started#antes-de-empezar","content":"Una instancia de Lamassu IoT en ejecución a la que lleguen los contenedores. El servicio lee los grupos de dispositivos y sus dispositivos desde su Device Manager (`dms_endpoint`) y firma con su KMS (`kms_endpoint`) solo cuando pides construcciones firmadas."},"2951":{"id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started-15","page_id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/getting-started#antes-de-empezar","content":"Una copia del repositorio `ota` con los módulos `core` y `sdk` de Lamassu a su lado. `go.mod` sustituye `lamassuiot/core` y `lamassuiot/sdk` por rutas locales, y la construcción de Docker los copia desde el **directorio padre** de la copia (`context: ..` en `docker-compose.yml`), así que ese directorio debe contener `ota/` y `lamassuiot/`."},"2952":{"id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started-16","page_id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/getting-started#antes-de-empezar","content":"Acceso a la imagen `ghcr.io/lamassuiot/wfx:otaq`, que usa el servicio `custom-wfx`."},"2953":{"id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started-17","page_id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/getting-started#antes-de-empezar","content":"Opcional, para el modo hawkBit: un servidor hawkBit. Compose construye uno desde `docker/hawkbit`: hawkBit 1.1.0 más un plugin de artefactos S3, etiquetado en local como `lamassu/hawkbit-update-server:1.1.0-s3`. Esa imagen se construye en local y no está publicada."},"2954":{"id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started-18","page_id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/getting-started#antes-de-empezar","content":"Opcional, para ejecutar el servicio fuera de Docker: Go 1.26.2 o superior y Python 3.8 o superior con los requisitos de `swugenerator` instalados. La imagen de Docker ya contiene el binario compilado y Python con `swugenerator`."},"2955":{"id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started-19","page_id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/getting-started#indica-la-dirección-del-host","content":"El contenedor `updates` llega a Lamassu a través de `host.docker.internal`, que `docker-compose.yml` sustituye por `HOST_IP`. En WSL2, `host.docker.internal` apunta por defecto a la pasarela de Docker Desktop y no al host de WSL, así que indica tu propia dirección:"},"2956":{"id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started-20","page_id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/getting-started#indica-la-dirección-del-host","content":"Después comprueba que `dms_endpoint` y `kms_endpoint` de `config-docker.yml` apuntan a la API de tu Lamassu (por defecto son `http://host.docker.internal:8080/api/...`)."},"2957":{"id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started-21","page_id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/getting-started#crea-la-red-y-arranca","content":"`docker-compose.yml` se conecta a una red existente llamada `ota-net` y no arranca sin ella."},"2958":{"id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started-22","page_id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/getting-started#servicios","content":"Servicio"},"2959":{"id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started-23","page_id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/getting-started#servicios","content":"Puerto del host"},"2960":{"id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started-24","page_id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/getting-started#servicios","content":"Qué es"},"2961":{"id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started-25","page_id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/getting-started#servicios","content":"`updates`"},"2962":{"id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started-26","page_id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/getting-started#servicios","content":"`10090`"},"2963":{"id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started-27","page_id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/getting-started#servicios","content":"La API de Updates, con SymKMS embebido"},"2964":{"id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started-28","page_id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/getting-started#servicios","content":"`custom-wfx`"},"2965":{"id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started-29","page_id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/getting-started#servicios","content":"`9080` (cliente), `9081` (gestión)"},"2966":{"id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started-30","page_id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/getting-started#servicios","content":"WFX, el servidor de trabajos que los dispositivos consultan en modo nativo"},"2967":{"id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started-31","page_id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/getting-started#servicios","content":"`postgres`"},"2968":{"id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started-32","page_id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/getting-started#servicios","content":"`5000` (contenedor `5432`)"},"2969":{"id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started-33","page_id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/getting-started#servicios","content":"Base de datos. `init.sql` crea las bases `updates` y `hawkbit` en el primer arranque"},"2970":{"id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started-34","page_id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/getting-started#servicios","content":"`swupdate-device1`"},"2971":{"id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started-35","page_id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/getting-started#servicios","content":"`80`"},"2972":{"id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started-36","page_id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/getting-started#servicios","content":"Un cliente de dispositivo SWUpdate de ejemplo"},"2973":{"id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started-37","page_id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/getting-started#servicios","content":"`hawkbit`"},"2974":{"id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started-38","page_id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/getting-started#servicios","content":"`8090`"},"2975":{"id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started-39","page_id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/getting-started#servicios","content":"Servidor hawkBit, solo para el modo hawkBit"},"2976":{"id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started-40","page_id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/getting-started#servicios","content":"`rustfs`"},"2977":{"id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started-41","page_id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/getting-started#servicios","content":"`9000` (S3), `9001` (consola)"},"2978":{"id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started-42","page_id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/getting-started#servicios","content":"Almacén S3 local, solo con `--profile s3`"},"2979":{"id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started-43","page_id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/getting-started#servicios","content":"`docker compose --profile s3 up -d` también arranca `rustfs` y `s3-init`, que crea el bucket cifrado `ota-updates` que pueden usar los artefactos, las construcciones y el almacenamiento de artefactos de hawkBit. Sin ese perfil, y con `config-docker.yml`, los artefactos y las construcciones se quedan en el volumen `update_files`."},"2980":{"id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started-44","page_id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/getting-started#verifica-la-api","content":"La segunda llamada informa del backend activo y de lo que admite. En modo nativo se parece a esto (abreviado):"},"2981":{"id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started-45","page_id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/getting-started#verifica-la-api","content":"`supported` tiene una entrada por cada una de las 22 capacidades. Consulta Capacidades para saber qué significa cada una."},"2982":{"id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started-46","page_id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/getting-started#ejecuta-sin-docker","content":"Arranca el punto de entrada monolítico con un fichero de configuración. Ejecuta juntos la API de Updates y SymKMS."},"2983":{"id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started-47","page_id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/getting-started#ejecuta-sin-docker","content":"Si `OTA_CONFIG_FILE` no está definida, el servicio lee `/etc/lamassuiot/config.yml`."},"2984":{"id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started-48","page_id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/getting-started#ejecuta-sin-docker","content":"Para construir ficheros `.swu` fuera de Docker, instala `swugenerator` en el entorno de Python al que apunta la configuración (la imagen hace lo mismo desde `swugenerator/requirements.txt`):"},"2985":{"id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started-49","page_id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/getting-started#ejecuta-sin-docker","content":"El `config.yml` de la raíz del repositorio es un punto de partida para desarrollo local, no un fichero listo para usar:"},"2986":{"id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started-50","page_id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/getting-started#ejecuta-sin-docker","content":"Necesita Postgres (`localhost:5000`) y la API de gestión de WFX (`localhost:9081`), que proporciona `docker compose up -d postgres custom-wfx`."},"2987":{"id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started-51","page_id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/getting-started#ejecuta-sin-docker","content":"Contiene valores de una máquina de desarrollo concreta: rutas absolutas `/home/alvaro/...` para el almacenamiento de artefactos y de SymKMS, el script de firma y `swugenerator`, y una IP de la LAN para los endpoints de Lamassu. Edítalos con rutas que el usuario del servicio pueda crear; el servicio se detiene al arrancar si no puede crear sus directorios."},"2988":{"id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started-52","page_id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/getting-started#ejecuta-sin-docker","content":"Guarda artefactos y salidas de construcción en el bucket local de RustFS (`docker compose --profile s3 up -d`). Para usar disco local en su lugar, elimina los bloques `artifacts:` y `builds:`; cuando no están, los artefactos van por defecto a `{update_files_base_dir}/artifacts`."},"2989":{"id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started-53","page_id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/getting-started#prueba-el-modo-hawkbit","content":"El modo hawkBit sirve la misma API sobre un servidor hawkBit real. Arranca hawkBit y Postgres, espera a que hawkBit responda y arranca el servicio con la configuración de hawkBit:"},"2990":{"id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started-54","page_id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/getting-started#prueba-el-modo-hawkbit","content":"`config-hawkbit.yml` también contiene rutas de una máquina de desarrollo, en los ajustes de construcción de SWU. Un servicio apuntado a un hawkBit sin dispositivos registrados construye y lanza con normalidad, pero nada descarga la actualización, porque en modo hawkBit los dispositivos consultan a hawkBit directamente. Lee el modo hawkBit antes de usarlo."},"2991":{"id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started-55","page_id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/getting-started#solución-de-problemas","content":"Síntoma"},"2992":{"id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started-56","page_id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/getting-started#solución-de-problemas","content":"Causa probable"},"2993":{"id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started-57","page_id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/getting-started#solución-de-problemas","content":"`docker compose up` falla por la red"},"2994":{"id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started-58","page_id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/getting-started#solución-de-problemas","content":"`ota-net` no existe. Ejecuta `docker network create ota-net`"},"2995":{"id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started-59","page_id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/getting-started#solución-de-problemas","content":"El contenedor `updates` no llega a Lamassu"},"2996":{"id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started-60","page_id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/getting-started#solución-de-problemas","content":"`HOST_IP` está vacío en `.env`, o `dms_endpoint` de `config-docker.yml` apunta a una dirección que el contenedor no alcanza"},"2997":{"id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started-61","page_id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/getting-started#solución-de-problemas","content":"`docker compose up --build` falla al copiar `lamassuiot/core`"},"2998":{"id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started-62","page_id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/getting-started#solución-de-problemas","content":"El contexto de construcción (el padre de `ota/`) no contiene `lamassuiot/`"},"2999":{"id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started-63","page_id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/getting-started#solución-de-problemas","content":"El servicio termina al arrancar cuando se ejecuta en el host"},"3000":{"id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started-64","page_id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/getting-started#solución-de-problemas","content":"Un directorio de la configuración (`update_files_base_dir`, `sym_keys_dir`) no se puede crear, o Postgres o WFX no son alcanzables en las direcciones del fichero"},"3001":{"id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started-65","page_id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/getting-started#solución-de-problemas","content":"`capabilities` responde pero los grupos de dispositivos fallan con un error del Device Manager"},"3002":{"id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started-66","page_id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/getting-started#solución-de-problemas","content":"`dms_endpoint` es incorrecto. La API de Updates lee de él los dispositivos de cada grupo"},"3003":{"id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started-67","page_id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/getting-started#siguientes-pasos","content":"<Card title=\"Publica y lanza una actualización\" href=\"/docs/platform/updates/guides/publish-and-roll-out\" description=\"Crea un paquete, constrúyelo y lánzalo a un grupo de dispositivos.\" />"},"3004":{"id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started-68","page_id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/getting-started#siguientes-pasos","content":"<Card title=\"Conecta un dispositivo\" href=\"/docs/platform/updates/guides/connect-a-device\" description=\"Qué debe hacer un dispositivo para recibir actualizaciones en cada backend.\" />"},"3005":{"id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started-69","page_id":"/docs/pr-preview/pr-56/es/platform/updates/getting-started","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/getting-started#siguientes-pasos","content":"<Card title=\"Referencia de configuración\" href=\"/docs/platform/updates/reference/configuration\" description=\"Cada campo de configuración y su valor por defecto.\" />"},"3006":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","type":"page","content":"Conecta un dispositivo","breadcrumbs":["Docs","Plataforma","[Enterprise] Actualizaciones","Guías"],"tags":[],"url":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device"},"3007":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device-0","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","content":"Qué debe hacer un dispositivo para recibir actualizaciones de Lamassu Updates, en modo nativo y en modo hawkBit."},"3008":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device-1","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#antes-de-empezar","content":"Antes de empezar"},"3009":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device-2","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#modo-nativo-el-dispositivo-consulta-a-wfx","content":"Modo nativo: el dispositivo consulta a WFX"},"3010":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device-3","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#el-trabajo-que-recibe-el-dispositivo","content":"El trabajo que recibe el dispositivo"},"3011":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device-4","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#la-descarga","content":"La descarga"},"3012":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device-5","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#los-estados-que-comunica-el-dispositivo","content":"Los estados que comunica el dispositivo"},"3013":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device-6","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#modo-hawkbit-el-dispositivo-consulta-a-hawkbit","content":"Modo hawkBit: el dispositivo consulta a hawkBit"},"3014":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device-7","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#haz-del-dispositivo-un-target-de-hawkbit","content":"Haz del dispositivo un target de hawkBit"},"3015":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device-8","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#configura-swupdate","content":"Configura SWUpdate"},"3016":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device-9","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#apunta-al-hawkbit-correcto","content":"Apunta al hawkBit correcto"},"3017":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device-10","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#imágenes-firmadas-y-cifradas","content":"Imágenes firmadas y cifradas"},"3018":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device-11","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#verifica-el-resultado","content":"Verifica el resultado"},"3019":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device-12","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#solución-de-problemas","content":"Solución de problemas"},"3020":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device-13","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#siguientes-pasos","content":"Siguientes pasos"},"3021":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device-14","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","content":"Esta guía describe el contrato entre un dispositivo y Lamassu Updates, para cada backend. El software del dispositivo es SWUpdate: esta página cubre lo que el dispositivo debe enviar y recibir, no la instalación ni la configuración de SWUpdate, que describe su documentación. Úsala cuando haya un lanzamiento en marcha y ningún dispositivo avance."},"3022":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device-15","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#antes-de-empezar","content":"Un dispositivo con SWUpdate instalado y una forma de ejecutar un cliente de actualización: un agente pequeño o el módulo `suricatta` de SWUpdate."},"3023":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device-16","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#antes-de-empezar","content":"Una identidad de dispositivo: un único ID igual en todas partes. Es el ID de cliente de WFX en modo nativo y el ID de controlador de hawkBit en modo hawkBit, y debe coincidir con el ID del dispositivo en el registro de dispositivos de Lamassu (consulta Dispositivos e identidades)."},"3024":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device-17","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#antes-de-empezar","content":"El dispositivo debe ser miembro de un grupo de dispositivos de Lamassu IoT, porque un paquete pertenece a un grupo y un lanzamiento apunta a los dispositivos del grupo. En modo hawkBit, la pertenencia al grupo también se lee del registro cuando `dms_endpoint` está definido."},"3025":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device-18","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#antes-de-empezar","content":"Solo modo nativo: `update_domain` debe ser una dirección que el dispositivo alcance. Consulta Configuración. En modo hawkBit los dispositivos descargan desde hawkBit."},"3026":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device-19","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#modo-nativo-el-dispositivo-consulta-a-wfx","content":"En modo nativo, un lanzamiento crea un trabajo de WFX por dispositivo. El dispositivo consulta a WFX los trabajos dirigidos a su ID, descarga el entregable de la API de Updates, lo instala y comunica cada estado a WFX. Lamassu Updates lee esos estados de WFX para conducir el lanzamiento."},"3027":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device-20","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#modo-nativo-el-dispositivo-consulta-a-wfx","content":"El dispositivo de ejemplo de `docker-compose.yml` (`swupdate-device1`) muestra la configuración mínima. Usa tres variables: `DEVICE_NAME` (su ID), `WFX_URI` (la API **cliente** de WFX, `http://custom-wfx:8080/api/wfx/v1` dentro de la red de Compose, `localhost:9080` desde el host) y `PORT`. La API de gestión de WFX, en el `9081`, es para el servicio, no para los dispositivos."},"3028":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device-21","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#el-trabajo-que-recibe-el-dispositivo","content":"El trabajo está dirigido al dispositivo (el `clientId` de WFX es el ID del dispositivo), nombra un workflow y lleva etiquetas del lanzamiento (`lms://secure-updates/<launch id>`) y del grupo (`lms://dms/<group id>`). Su definición es así:"},"3029":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device-22","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#el-trabajo-que-recibe-el-dispositivo","content":"Campo"},"3030":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device-23","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#el-trabajo-que-recibe-el-dispositivo","content":"Significado"},"3031":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device-24","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#el-trabajo-que-recibe-el-dispositivo","content":"`type`"},"3032":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device-25","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#el-trabajo-que-recibe-el-dispositivo","content":"El tipo del paquete: `rawfile`, `firmware`, o ambos (`[\"rawfile\",\"firmware\"]`)"},"3033":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device-26","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#el-trabajo-que-recibe-el-dispositivo","content":"`artifacts[0].uri`"},"3034":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device-27","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#el-trabajo-que-recibe-el-dispositivo","content":"Dónde descargar el entregable. El servicio añade el ID del dispositivo, así que cada dispositivo descarga su propio fichero. Un `.swu` para paquetes SWU, un `.tar.gz` para paquetes `non-swu`"},"3035":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device-28","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#el-trabajo-que-recibe-el-dispositivo","content":"`algorithm`, `iv`"},"3036":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device-29","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#el-trabajo-que-recibe-el-dispositivo","content":"Presentes solo en un paquete cifrado: el algoritmo y, en paquetes de clave compartida, el IV o nonce en hexadecimal. Un paquete por dispositivo lleva el algoritmo pero no `iv`"},"3037":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device-30","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#el-trabajo-que-recibe-el-dispositivo","content":"`signature_key_id`, `signature_algorithm`, `signature_certificate`"},"3038":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device-31","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#el-trabajo-que-recibe-el-dispositivo","content":"Presentes solo en un paquete firmado"},"3039":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device-32","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#el-trabajo-que-recibe-el-dispositivo","content":"El dispositivo necesita la clave para descifrar, y la tiene él mismo. En un paquete por dispositivo es la clave que SymKMS asignó a ese dispositivo, y cada dispositivo descarga un fichero distinto."},"3040":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device-33","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#la-descarga","content":"La descarga responde con los bytes, o con `302` a una URL firmada de corta duración cuando las descargas prefirmadas están activadas para el almacén de construcciones. Asegúrate de que el cliente HTTP del dispositivo sigue redirecciones. La ruta también responde a `HEAD` y a peticiones de rango de bytes (`206`), de modo que una descarga interrumpida puede reanudarse. La URL se fija al construir el paquete, así que un dispositivo no ve un `update_domain` nuevo hasta que reconstruyes."},"3041":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device-34","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#los-estados-que-comunica-el-dispositivo","content":"El dispositivo mueve su trabajo por los estados del workflow, y el workflow decide quién puede hacer cada movimiento. Para el workflow `direct`:"},"3042":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device-35","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#los-estados-que-comunica-el-dispositivo","content":"El dispositivo comunica `INSTALLING`, `INSTALLED`, `ACTIVATING` y `ACTIVATED`. El paso `INSTALLED → ACTIVATE` lo hace el propio WFX. Desde `INSTALL`, `INSTALLING`, `ACTIVATE` y `ACTIVATING` el dispositivo puede pasar a `TERMINATED` para comunicar un fallo; `INSTALLED` no tiene transición de fallo."},"3043":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device-36","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#los-estados-que-comunica-el-dispositivo","content":"Workflow"},"3044":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device-37","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#los-estados-que-comunica-el-dispositivo","content":"Se usa para"},"3045":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device-38","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#los-estados-que-comunica-el-dispositivo","content":"Estados terminales"},"3046":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device-39","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#los-estados-que-comunica-el-dispositivo","content":"`wfx.workflow.dau.direct`"},"3047":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device-40","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#los-estados-que-comunica-el-dispositivo","content":"Paquetes SWU, sin confirmación"},"3048":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device-41","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#los-estados-que-comunica-el-dispositivo","content":"`ACTIVATED` (éxito), `TERMINATED` (fallo)"},"3049":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device-42","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#los-estados-que-comunica-el-dispositivo","content":"`wfx.workflow.dau.phased`"},"3050":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device-43","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#los-estados-que-comunica-el-dispositivo","content":"Paquetes SWU con pasos de confirmación (`CREATED → DOWNLOAD → ... → ACTIVATED`)"},"3051":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device-44","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#los-estados-que-comunica-el-dispositivo","content":"`ACTIVATED`, `TERMINATED`"},"3052":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device-45","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#los-estados-que-comunica-el-dispositivo","content":"`wfx.workflow.dau.download-install`"},"3053":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device-46","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#los-estados-que-comunica-el-dispositivo","content":"Paquetes `non-swu`: `DOWNLOAD → ... → INSTALLED`, cada movimiento lo hace el dispositivo"},"3054":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device-47","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#los-estados-que-comunica-el-dispositivo","content":"`INSTALLED`, `TERMINATED`"},"3055":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device-48","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#los-estados-que-comunica-el-dispositivo","content":"`wfx.workflow.dau.simple`"},"3056":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device-49","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#los-estados-que-comunica-el-dispositivo","content":"Mínimo `DOWNLOAD → INSTALL → INSTALLED`"},"3057":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device-50","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#los-estados-que-comunica-el-dispositivo","content":"`INSTALLED`, `TERMINATED`"},"3058":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device-51","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#los-estados-que-comunica-el-dispositivo","content":"Un trabajo `phased` tiene movimientos que hace WFX o un operador, y nada en Lamassu Updates los avanza: se queda en `CREATED` hasta que alguien lo confirma a través de WFX (el botón **Next** del dashboard lo hace). Los endpoints `force-version` y `sync-to-latest` usan `phased` para los paquetes SWU salvo que indiques un `workflow`. Los ficheros de workflow están en `wfx/workflow/dau/` del repositorio. La API HTTP de WFX (listar trabajos, actualizar estado) la documenta WFX."},"3059":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device-52","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#modo-hawkbit-el-dispositivo-consulta-a-hawkbit","content":"En modo hawkBit los dispositivos no consultan a Lamassu Updates. Consultan la API DDI de hawkBit, y Lamassu Updates lee de hawkBit el estado resultante de las acciones."},"3060":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device-53","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#haz-del-dispositivo-un-target-de-hawkbit","content":"El dispositivo necesita un ID de controlador y un target etiquetado `group:<id>` para su grupo. Con `dms_endpoint` definido, el servicio lo hace por sí mismo: cuando lee del registro los dispositivos de un grupo, crea los targets que faltan y los etiqueta. Sin `dms_endpoint`, creas tú los targets y las etiquetas. En ambos casos el dispositivo debe consultar a hawkBit con credenciales válidas."},"3061":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device-54","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#configura-swupdate","content":"Apunta el SWUpdate del dispositivo (`suricatta`) a la URL de hawkBit (`hawkbit.ddi_url`, que por defecto es `hawkbit.base_url`), con el tenant, el ID de controlador y un método de autenticación que acepte tu tenant de hawkBit. hawkBit rechaza por defecto a los dispositivos sin autenticar. Con tokens de seguridad de target, actívalos para el tenant (`PUT /rest/v1/system/configs/authentication.targettoken.enabled` con `{\"value\":true}`) y entrega a cada dispositivo el `securityToken` de su target, que envía como `Authorization: TargetToken <token>`. La guía curl de hawkBit muestra cada petición."},"3062":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device-55","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#apunta-al-hawkbit-correcto","content":"El dispositivo debe consultar el **mismo hawkBit** para el que está configurado el servicio. Un servicio apuntado a un hawkBit sin targets construye y lanza sin error, y nada lo descarga. Consulta Solución de problemas."},"3063":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device-56","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#apunta-al-hawkbit-correcto","content":"hawkBit entrega entonces al dispositivo todos los artefactos de su conjunto de distribución. Un paquete con varios módulos ejecuta varias instalaciones independientes."},"3064":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device-57","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#apunta-al-hawkbit-correcto","content":"Cuando tu pasarela enruta las URL de artefactos de dispositivo de hawkBit (la ruta de `hawkbit.ddi_url`, `.../<tenant>/controller/v1/<controller>/softwaremodules/<id>/artifacts/<file>`) hacia Lamassu Updates, el servicio las sirve solo para módulos asignados o instalados en ese controlador, y responde `404` en los demás casos. Con las descargas prefirmadas activadas, redirige a una URL firmada del bucket S3 de hawkBit en lugar de transmitir el fichero."},"3065":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device-58","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#imágenes-firmadas-y-cifradas","content":"Si el dispositivo verifica firmas, define su clave pública (`public-key-file` en la configuración de SWUpdate) y firma el paquete con la clave correspondiente. Si descifra, necesita la misma clave y el mismo algoritmo con que se construyó el paquete. Una discrepancia es la causa habitual de que una instalación falle en silencio tras una descarga correcta. Firma y cifrado explica qué clave, algoritmo e IV usa cada modo y qué recibe el dispositivo."},"3066":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device-59","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#verifica-el-resultado","content":"Tras un lanzamiento, el trabajo del dispositivo llega a `ACTIVATED` (o a `INSTALLED` en un paquete `non-swu`), los contadores del lanzamiento se actualizan y el inventario del dispositivo lista el paquete:"},"3067":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device-60","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#verifica-el-resultado","content":"Consulta Publica y lanza una actualización para el resto de comprobaciones."},"3068":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device-61","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#solución-de-problemas","content":"Síntoma"},"3069":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device-62","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#solución-de-problemas","content":"Causa probable"},"3070":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device-63","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#solución-de-problemas","content":"El dispositivo nunca ve un trabajo (nativo)"},"3071":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device-64","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#solución-de-problemas","content":"Consulta un endpoint de WFX equivocado o usa un ID distinto del miembro del grupo. El `clientId` de WFX debe coincidir con el ID del dispositivo"},"3072":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device-65","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#solución-de-problemas","content":"El trabajo se queda en `CREATED`"},"3073":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device-66","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#solución-de-problemas","content":"El lanzamiento usa `phased`. Confírmalo a través de WFX o del dashboard, o vuelve a lanzar con `direct`"},"3074":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device-67","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#solución-de-problemas","content":"La descarga falla con `404`"},"3075":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device-68","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#solución-de-problemas","content":"El paquete está cifrado por dispositivo y el dispositivo no tiene clave, o la URL nombra a otro dispositivo. Revisa la cobertura del paquete y que la URL termine con el ID de este dispositivo"},"3076":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device-69","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#solución-de-problemas","content":"La descarga termina bien y la instalación falla"},"3077":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device-70","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#solución-de-problemas","content":"La firma o la clave no coinciden con lo que tiene el dispositivo. Consulta Firma y cifrado"},"3078":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device-71","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#solución-de-problemas","content":"Un lanzamiento `non-swu` parece atascado aunque el dispositivo terminó"},"3079":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device-72","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#solución-de-problemas","content":"Se lanzó con `direct` o `phased`, que esperan `ACTIVATED`. Lanza los paquetes `non-swu` con `download-install`"},"3080":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device-73","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#solución-de-problemas","content":"El lanzamiento nunca avanza (hawkBit)"},"3081":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device-74","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#solución-de-problemas","content":"El dispositivo no consulta este hawkBit, no está etiquetado en el grupo o no puede autenticarse"},"3082":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device-75","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#siguientes-pasos","content":"<Card title=\"Firma y cifrado\" href=\"/docs/platform/updates/signing-and-encryption\" description=\"Claves, algoritmos y qué debe tener el dispositivo.\" />"},"3083":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device-76","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#siguientes-pasos","content":"<Card title=\"Modo hawkBit\" href=\"/docs/platform/updates/hawkbit-mode\" description=\"Cómo el adaptador traduce paquetes y campañas a hawkBit.\" />"},"3084":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device-77","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#siguientes-pasos","content":"<Card title=\"Solución de problemas\" href=\"/docs/platform/updates/troubleshooting\" description=\"Actualizaciones que no llegan a los dispositivos y otros fallos.\" />"},"3085":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","type":"page","content":"Usa el dashboard","breadcrumbs":["Docs","Plataforma","[Enterprise] Actualizaciones","Guías"],"tags":[],"url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard"},"3086":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-0","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","content":"Publica, lanza y sigue una actualización desde el dashboard de Lamassu, pantalla a pantalla."},"3087":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-1","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#antes-de-empezar","content":"Antes de empezar"},"3088":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-2","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#conéctalo-al-servicio","content":"Conéctalo al servicio"},"3089":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-3","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#dónde-está-cada-cosa","content":"Dónde está cada cosa"},"3090":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-4","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#1-crea-un-distribution-set","content":"1\\. Crea un distribution set"},"3091":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-5","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#2-añade-ficheros-y-construye-nativo","content":"2\\. Añade ficheros y construye (nativo)"},"3092":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-6","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#hawkbit-construye-primero-un-módulo","content":"hawkBit: construye primero un módulo"},"3093":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-7","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#3-inicia-una-campaña","content":"3\\. Inicia una campaña"},"3094":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-8","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#4-ejecuta-y-vigila-la-campaña","content":"4\\. Ejecuta y vigila la campaña"},"3095":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-9","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#5-sigue-los-dispositivos","content":"5\\. Sigue los dispositivos"},"3096":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-10","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#qué-cambia-según-el-backend","content":"Qué cambia según el backend"},"3097":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-11","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#lo-que-no-está-en-el-dashboard","content":"Lo que no está en el dashboard"},"3098":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-12","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#solución-de-problemas","content":"Solución de problemas"},"3099":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-13","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#siguientes-pasos","content":"Siguientes pasos"},"3100":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-14","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","content":"El dashboard de Lamassu es la interfaz web de la API de Updates. Esta guía sigue la misma actualización que las guías curl (nativa y hawkBit) a través de las pantallas. Los nombres en negrita son las etiquetas que muestra el dashboard."},"3101":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-15","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","content":"El dashboard es un proyecto aparte (`lamassu-dashboard`). Esta guía lo describe a partir de su código fuente y no tiene capturas, así que una etiqueta puede diferir en una versión más reciente. El dashboard no tiene traducciones: sus etiquetas están en inglés, y aquí se mantienen tal cual."},"3102":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-16","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#antes-de-empezar","content":"Lamassu Updates está en marcha y el dashboard puede alcanzarlo. Consulta Conéctalo al servicio."},"3103":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-17","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#antes-de-empezar","content":"Un **grupo de dispositivos** de Lamassu IoT que contenga los dispositivos que vas a actualizar (**Device Groups** dentro de **IoT**). Los miembros de un grupo son los dispositivos que cumplen sus criterios."},"3104":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-18","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#antes-de-empezar","content":"Para una construcción SWU con firma o cifrado: una clave de firma en **Asymmetric Keys** o una clave simétrica en **Symmetric Keys** (ambas en **KMS**) y, para el cifrado por dispositivo, claves asignadas a los dispositivos en **Device Key Inventory** (en **IoT**)."},"3105":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-19","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#conéctalo-al-servicio","content":"El dashboard habla con la API de Updates en la dirección indicada en `LAMASSU_UPDATES_API`, en su `public/config.js`. En la imagen de contenedor procede de la variable de entorno del mismo nombre."},"3106":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-20","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#conéctalo-al-servicio","content":"El dashboard le añade `/updates/v1` y `/symkms/v1`. Se acepta y se elimina un `/updates/v1` final."},"3107":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-21","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#conéctalo-al-servicio","content":"Si está vacía, el dashboard usa `LAMASSU_API`."},"3108":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-22","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#conéctalo-al-servicio","content":"Cuando la autenticación está activada, cada llamada lleva el bearer token del usuario. El servicio lo ignora, así que pon delante una pasarela que lo compruebe. Consulta Seguridad."},"3109":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-23","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#conéctalo-al-servicio","content":"Debe apuntar a la instancia del servicio que ejecuta el backend que quieres usar. Un servicio ejecuta modo nativo o modo hawkBit, nunca los dos: para usar ambos a la vez ejecutas dos instancias, cada una en su puerto, y apuntas el dashboard a una de ellas."},"3110":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-24","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#conéctalo-al-servicio","content":"El dashboard lee `GET /updates/v1/capabilities` una vez, después de iniciar sesión, y oculta lo que el backend no puede hacer. Por eso las mismas pantallas se ven distintas en modo nativo y en modo hawkBit. Qué cambia según el backend enumera las diferencias. Si la petición de capacidades falla, el dashboard asume que todo está admitido y no oculta nada."},"3111":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-25","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#conéctalo-al-servicio","content":"Para comparar ambos backends, el menú de usuario tiene un selector **Updates backend** con las opciones **Auto**, **native** y **hawkbit**. Aparece solo en compilaciones de desarrollo, o cuando el contenedor del dashboard se ejecuta con `DEV_OPTIONS_ENABLED=true`. Elegir native o hawkbit sustituye `LAMASSU_UPDATES_API` en ese navegador, muestra un campo editable **Updates API base URL** y recarga la página. Los valores por defecto son `http://localhost:10090` (native) y `http://localhost:10091` (hawkbit) en localhost, y `<origin>/api` y `<origin>/api/hawkbit` en cualquier otro host."},"3112":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-26","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#dónde-está-cada-cosa","content":"El grupo de la barra lateral **OTA UPDATES MANAGER** tiene:"},"3113":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-27","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#dónde-está-cada-cosa","content":"Elemento"},"3114":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-28","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#dónde-está-cada-cosa","content":"Ruta"},"3115":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-29","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#dónde-está-cada-cosa","content":"Qué es"},"3116":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-30","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#dónde-está-cada-cosa","content":"**Dashboard**"},"3117":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-31","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#dónde-está-cada-cosa","content":"`/updates/dashboard`"},"3118":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-32","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#dónde-está-cada-cosa","content":"Título de página **OTA Dashboard**: salud de los lanzamientos, campañas que requieren atención, distribución de versiones y próxima planificación"},"3119":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-33","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#dónde-está-cada-cosa","content":"**OTA Devices**"},"3120":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-34","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#dónde-está-cada-cosa","content":"`/updates/devices`"},"3121":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-35","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#dónde-está-cada-cosa","content":"Todos los dispositivos con su versión instalada y su versión objetivo"},"3122":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-36","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#dónde-está-cada-cosa","content":"**OTA Device Groups**"},"3123":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-37","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#dónde-está-cada-cosa","content":"`/updates/device-groups`"},"3124":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-38","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#dónde-está-cada-cosa","content":"Grupos, con cuántos dispositivos van retrasados"},"3125":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-39","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#dónde-está-cada-cosa","content":"**Distribution Set**"},"3126":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-40","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#dónde-está-cada-cosa","content":"`/package-inventory`"},"3127":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-41","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#dónde-está-cada-cosa","content":"Los paquetes de actualización de todos los grupos"},"3128":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-42","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#dónde-está-cada-cosa","content":"**Software Modules**"},"3129":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-43","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#dónde-está-cada-cosa","content":"`/updates/software-modules`"},"3130":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-44","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#dónde-está-cada-cosa","content":"El catálogo de módulos"},"3131":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-45","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#dónde-está-cada-cosa","content":"**Campaigns**"},"3132":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-46","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#dónde-está-cada-cosa","content":"`/updates`"},"3133":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-47","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#dónde-está-cada-cosa","content":"Lanzamientos: lista, creación, ejecución"},"3134":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-48","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#dónde-está-cada-cosa","content":"El grupo **IoT** tiene **Devices**, **Device Groups** (el registro de dispositivos de Lamassu y sus grupos), **Device Key Inventory** y **Platform Integrations**. El grupo **JOB MANAGER** (**Jobs**, **Workflows**) lista trabajos y workflows de WFX en bruto. No usa la API de Updates y no crea lanzamientos."},"3135":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-49","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#dónde-está-cada-cosa","content":"En el dashboard, un paquete es un **distribution set** y un lanzamiento es una **campaign**."},"3136":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-50","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#1-crea-un-distribution-set","content":"Abre **Distribution Set**. La lista muestra los paquetes de todos los grupos, con filtros de grupo de dispositivos y de estado, un cuadro de búsqueda y un botón **Refresh**. Pulsa **New Distribution Set**."},"3137":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-51","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#1-crea-un-distribution-set","content":"Campo"},"3138":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-52","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#1-crea-un-distribution-set","content":"Notas"},"3139":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-53","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#1-crea-un-distribution-set","content":"**Name**"},"3140":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-54","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#1-crea-un-distribution-set","content":"Al menos 3 caracteres, sin espacios. Usa guiones bajos. El modo nativo, además, solo acepta letras, dígitos, `.`, `_` y `-`"},"3141":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-55","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#1-crea-un-distribution-set","content":"**Version**"},"3142":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-56","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#1-crea-un-distribution-set","content":"Semver, por defecto `1.0.0`"},"3143":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-57","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#1-crea-un-distribution-set","content":"**Device Group**"},"3144":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-58","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#1-crea-un-distribution-set","content":"Obligatorio. Un paquete pertenece a un grupo y solo se puede lanzar a sus dispositivos"},"3145":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-59","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#1-crea-un-distribution-set","content":"**Type**"},"3146":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-60","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#1-crea-un-distribution-set","content":"**Raw File** (sin reinicio), **Firmware** (con reinicio), **Both** u **Other Type**"},"3147":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-61","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#1-crea-un-distribution-set","content":"**Driver**"},"3148":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-62","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#1-crea-un-distribution-set","content":"Nativo: **SWU** construye una imagen firmada (la firma es opcional), **Generic** entrega los ficheros tal cual. hawkBit: **SWU** acepta solo módulos SWU, **Generic** acepta binarios y otros ficheros. No se puede cambiar tras crear el paquete"},"3149":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-63","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#1-crea-un-distribution-set","content":"**Allow previous-version download**"},"3150":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-64","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#1-crea-un-distribution-set","content":"Permite que los dispositivos descarguen versiones anteriores de este paquete"},"3151":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-65","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#1-crea-un-distribution-set","content":"**Compatibility**"},"3152":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-66","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#1-crea-un-distribution-set","content":"Precondiciones de lanzamiento opcionales (plegado): los dispositivos ya deben tener otro distribution set, o un módulo de software, en una versión mínima"},"3153":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-67","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#1-crea-un-distribution-set","content":"Pulsa **Create Distribution Set**. Llegas a la página del paquete. Las precondiciones siguen siendo editables allí, en **Launch Preconditions** de la pestaña **Overview** (**Save preconditions**)."},"3154":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-68","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#1-crea-un-distribution-set","content":"En modo hawkBit el formulario tiene una sección más, **Software modules**. Un conjunto de hawkBit enlaza módulos construidos, así que marca al menos un módulo construido, y como mucho un módulo OS. La tabla lista solo los módulos que encajan con el **Driver**: un conjunto SWU oculta los módulos entregados como ficheros en bruto, y uno Generic oculta los módulos entregados como SWU prefabricado. Si no encaja ninguno, dice «No built module fits this driver», y primero construyes uno (consulta hawkBit: construye primero un módulo)."},"3155":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-69","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#1-crea-un-distribution-set","content":"En el backend nativo, el **Driver** decide además qué workflow puede instalar el paquete: los paquetes SWU necesitan **Direct** o **Phased** y los Generic necesitan **Download-Install**. Una discrepancia deja la actualización pareciendo atascada cuando el dispositivo ya terminó."},"3156":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-70","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#2-añade-ficheros-y-construye-nativo","content":"En la página del paquete (`/updates/pack-details`) abre la pestaña **Software Modules**. Un paquete nativo empieza con un módulo OS con el nombre del paquete («Not composed»). Abre el menú de su fila y elige **Add files**, suelta tu fichero y súbelo. El nombre del artefacto es por defecto el del fichero sin su extensión, y la versión es opcional (semver). Para componer el paquete con más módulos, usa **Add module** (un módulo de aplicación nuevo) o **Import module** (copia uno existente); el paquete sigue construyendo un único SWU."},"3157":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-71","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#2-añade-ficheros-y-construye-nativo","content":"Después pulsa **Generate SWU** en la cabecera. La hoja **SWU deliverable** tiene dos pestañas."},"3158":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-72","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#2-añade-ficheros-y-construye-nativo","content":"**Build here** construye el paquete a partir de los artefactos del paquete:"},"3159":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-73","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#2-añade-ficheros-y-construye-nativo","content":"Parte"},"3160":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-74","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#2-añade-ficheros-y-construye-nativo","content":"Qué hacer"},"3161":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-75","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#2-añade-ficheros-y-construye-nativo","content":"**Artifacts to include**"},"3162":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-76","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#2-añade-ficheros-y-construye-nativo","content":"Casillas, todas marcadas por defecto"},"3163":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-77","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#2-añade-ficheros-y-construye-nativo","content":"**sw-descriptor**"},"3164":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-78","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#2-añade-ficheros-y-construye-nativo","content":"Obligatorio. Carga el fichero o escríbelo en el editor. Una lista de comprobación muestra cada fichero que declara la descripción, y un fichero declarado pero no seleccionado bloquea la construcción"},"3165":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-79","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#2-añade-ficheros-y-construye-nativo","content":"**Signing**"},"3166":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-80","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#2-añade-ficheros-y-construye-nativo","content":"**Signing key**: ninguna (sin firmar) o una clave del KMS. Con una clave, elige un **Method** y un **Certificate**"},"3167":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-81","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#2-añade-ficheros-y-construye-nativo","content":"**Encryption**, **Mode**"},"3168":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-82","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#2-añade-ficheros-y-construye-nativo","content":"Ninguno, &#x2A;*Shared (one key for all devices)** o &#x2A;*Per-device (key per device)**"},"3169":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-83","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#2-añade-ficheros-y-construye-nativo","content":"Para el cifrado compartido elige una **Symmetric key** y si cifrar el descriptor (**Encrypt the descriptor**) y todos los ficheros (**Encrypt all files**), o marca ficheros individuales. Para el cifrado por dispositivo elige un **Algorithm** (por defecto `Ascon-128a`). Cada dispositivo usa entonces su propia clave del inventario de claves de dispositivo. Si no eliges ninguna seguridad, la hoja dice «No security selected»."},"3170":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-84","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#2-añade-ficheros-y-construye-nativo","content":"Pulsa **Generate SWU**. La hoja sube el sw-description y después construye. La insignia pasa a **Built** y el botón de la cabecera pasa a decir **Regenerate SWU**. Junto a él aparece **Download SWU**, salvo en un paquete por dispositivo: no hay descarga del conjunto completo, y el paquete de cada dispositivo se descarga por dispositivo."},"3171":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-85","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#2-añade-ficheros-y-construye-nativo","content":"**Upload pre-built** adjunta un `.swu` que construiste por tu cuenta, hasta el `max_artifact_size_mb` del servicio (10 GiB por defecto). Se guarda y se sirve sin cambios, no se firma ni se cifra nada por ti, y la versión pasa a estar construida e inmutable."},"3172":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-86","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#2-añade-ficheros-y-construye-nativo","content":"Un paquete **non-swu** tiene **Generate Package** en su lugar. Construye un `.tar.gz` con los artefactos seleccionados, con firma opcional y cifrado compartido o por dispositivo opcional (el cifrado es AES-GCM), y también tiene una pestaña **Upload pre-built**. **Download Package** descarga el resultado."},"3173":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-87","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#2-añade-ficheros-y-construye-nativo","content":"Para cambiar un paquete construido, crea una versión nueva: usa **New Version** en el menú de fila de la lista de paquetes (el diálogo tiene **Create Version**), o **New Version to Edit** en la pestaña **Artifacts** del paquete. La versión nueva debe ser mayor que la actual, y borra el paquete construido."},"3174":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-88","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#hawkbit-construye-primero-un-módulo","content":"En modo hawkBit, los ficheros de un paquete viven en módulos, construidos en el catálogo."},"3175":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-89","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#hawkbit-construye-primero-un-módulo","content":"Abre **Software Modules** y pulsa **New module**. Rellena **Module name** (no puede contener `/` ni `:`), **Type** (**Application** u **OS / base image**), **Version**, el **Distribution set** (deja **Catalog only — no set** para enlazarlo más tarde) y el **Delivery intent**:"},"3176":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-90","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#hawkbit-construye-primero-un-módulo","content":"Delivery intent"},"3177":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-91","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#hawkbit-construye-primero-un-módulo","content":"Significa"},"3178":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-92","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#hawkbit-construye-primero-un-módulo","content":"**Build SWU from inputs**"},"3179":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-93","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#hawkbit-construye-primero-un-módulo","content":"Aportas ficheros y un sw-description, y el servicio construye un `.swu`"},"3180":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-94","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#hawkbit-construye-primero-un-módulo","content":"**Upload prebuilt SWU**"},"3181":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-95","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#hawkbit-construye-primero-un-módulo","content":"Subes un `.swu` terminado"},"3182":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-96","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#hawkbit-construye-primero-un-módulo","content":"**Deliver files unchanged**"},"3183":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-97","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#hawkbit-construye-primero-un-módulo","content":"Los ficheros se entregan tal cual, y el módulo cuenta como construido tras un paso de construcción que puede cifrarlos y firmarlos de forma opcional"},"3184":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-98","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#hawkbit-construye-primero-un-módulo","content":"**Decide later**"},"3185":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-99","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#hawkbit-construye-primero-un-módulo","content":"Aún no se puede usar"},"3186":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-100","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#hawkbit-construye-primero-un-módulo","content":"Añade los ficheros y, para **Build SWU from inputs**, el sw-description. Las tarjetas de seguridad ofrecen firma y cifrado compartido. Para **Build SWU from inputs**, el interruptor **Build this module now** está activado por defecto: desactívalo para guardar solo los ficheros y construir más tarde desde el menú de fila **Files and build**. Para **Upload prebuilt SWU** no hay interruptor: el módulo queda construido en cuanto se guarda el `.swu`. Para **Deliver files unchanged** el interruptor es **Build now**."},"3187":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-101","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#hawkbit-construye-primero-un-módulo","content":"Pulsa **Create Module**."},"3188":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-102","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#hawkbit-construye-primero-un-módulo","content":"Crea el distribution set y marca el módulo construido."},"3189":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-103","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#hawkbit-construye-primero-un-módulo","content":"Un módulo enlazado a un conjunto queda congelado. Desenlázalo para cambiarlo, o añade una versión nueva desde **Upgrade to a new version** en el menú de su fila del catálogo. Consulta Modo hawkBit."},"3190":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-104","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#hawkbit-construye-primero-un-módulo","content":"El catálogo también funciona en el backend nativo: lista los módulos de todos los paquetes, y **New module** puede dejar un módulo en **Catalog only — no set** hasta que lo añadas a un paquete con **Import module**. La importación nativa copia el módulo, mientras que el enlace de hawkBit lo comparte."},"3191":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-105","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#3-inicia-una-campaña","content":"Pulsa **Start Campaign** en el menú de fila del paquete en **Distribution Set** (habilitado una vez construido el paquete), o **New Campaign** en la página **Campaigns**. El formulario, **Create campaign**, está en `/updates/new`."},"3192":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-106","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#3-inicia-una-campaña","content":"Sección"},"3193":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-107","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#3-inicia-una-campaña","content":"Campos"},"3194":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-108","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#3-inicia-una-campaña","content":"**Campaign basics**"},"3195":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-109","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#3-inicia-una-campaña","content":"**Campaign name (optional)**, **Distribution set**. **Device group** y **Driver** se heredan y son de solo lectura. **Workflow**: en nativo, todos los workflows de WFX registrados (Direct, Phased, Download-Install...), con un aviso cuando no encaja con el driver. En hawkBit el campo es **Install mode**: **Forced** (el dispositivo instala en cuanto consulta) o **Soft** (el dispositivo puede confirmar o posponer)"},"3196":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-110","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#3-inicia-una-campaña","content":"**Schedule**"},"3197":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-111","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#3-inicia-una-campaña","content":"**Start as soon as it is executed** o **Start at a planned time** (fecha y hora, en la zona horaria de tu navegador)"},"3198":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-112","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#3-inicia-una-campaña","content":"**Batching & rollout**"},"3199":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-113","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#3-inicia-una-campaña","content":"**Batch mode** (**Fixed count** o **Percentage**), el tamaño o porcentaje del lote y el interruptor **Auto rollout**"},"3200":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-114","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#3-inicia-una-campaña","content":"**Safety controls**"},"3201":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-115","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#3-inicia-una-campaña","content":"Solo con Auto rollout activado: **Approval threshold** (%) y **Error threshold** (%)"},"3202":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-116","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#3-inicia-una-campaña","content":"**Optional**"},"3203":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-117","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#3-inicia-una-campaña","content":"**Test device** (el canario, que se actualiza primero), las **Preconditions** del conjunto (solo lectura), **Notes**, **Weight**"},"3204":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-118","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#3-inicia-una-campaña","content":"No hay selector de dispositivos. Una campaña apunta a todos los dispositivos del grupo del paquete, y el panel **Campaign summary** muestra cuántos coinciden y el número estimado de lotes."},"3205":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-119","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#3-inicia-una-campaña","content":"Si el paquete tiene precondiciones, el dashboard ejecuta primero una simulación (dry run) y muestra **Campaign preconditions**: cuántos dispositivos cumplen, cuáles no y por qué. Marca &#x2A;*Force deploy to non-qualifying devices (not recommended)** para enviar también a los que no cumplen y después **Confirm campaign**."},"3206":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-120","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#3-inicia-una-campaña","content":"Pulsa **Create campaign**. La campaña se crea pero todavía no se envía nada: vuelves a **Campaigns**."},"3207":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-121","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#4-ejecuta-y-vigila-la-campaña","content":"En **Campaigns** (`/updates`), cada fila tiene el progreso, el estado (como **Scheduled**, **Rolling Out**, **Paused**, **Completed**, **Cancelled**) y el progreso por lotes. Las tarjetas de la parte superior (**Active campaigns**, **Scheduled**, **Rolling out**, **Requires attention**, **Completed**) filtran la lista. La página se actualiza cada cuatro segundos mientras algo se mueve."},"3208":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-122","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#4-ejecuta-y-vigila-la-campaña","content":"El botón principal de la fila libera un lote:"},"3209":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-123","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#4-ejecuta-y-vigila-la-campaña","content":"**Send to test device** envía primero el canario."},"3210":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-124","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#4-ejecuta-y-vigila-la-campaña","content":"**Execute next batch** envía el siguiente lote."},"3211":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-125","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#4-ejecuta-y-vigila-la-campaña","content":"Se oculta cuando la campaña está completada o cancelada, en pausa, programada para más tarde, sin nada pendiente, o es una campaña con **Auto rollout** que ya está en marcha. Mientras se prueba el canario o ha fallado, sigue visible pero deshabilitado. Un canario fallido pausa una campaña nativa: usa **Resume** para reintentarlo. Una campaña programada empieza sola a la hora planificada."},"3212":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-126","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#4-ejecuta-y-vigila-la-campaña","content":"El menú de fila tiene **Open details**, **Resume**, **Pause**, **Retry N failed** y **Cancel campaign** (pregunta «Cancel Campaign?»). **Pause** detiene los lotes siguientes mientras los dispositivos que ya están en curso terminan; **Resume** continúa. No hay botón para marcar una campaña como completada: una campaña nativa se completa sola cuando no queda ningún dispositivo pendiente ni en curso."},"3213":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-127","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#4-ejecuta-y-vigila-la-campaña","content":"Debajo de la tabla, un panel muestra los **Batches** de la campaña seleccionada y una tabla **Device progress**. Sigue la primera fila activa hasta que seleccionas otra. Abre **View** para `/updates/details`:"},"3214":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-128","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#4-ejecuta-y-vigila-la-campaña","content":"**Overview**: identidad, precondiciones y la **Rollout Configuration** (workflow o install mode, tipo y valor del rollout, modo automático, dispositivo de prueba). **Edit** sobre el valor del rollout funciona solo donde el backend admite editar una estrategia en ejecución."},"3215":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-129","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#4-ejecuta-y-vigila-la-campaña","content":"**Device Jobs**: una fila por dispositivo con el estado de su trabajo, un botón **Refresh Jobs** y, en cada fila, un botón **Workflow** que abre la línea de tiempo del dispositivo. Para el workflow Phased, un botón **Next** y una tira de transiciones te permiten confirmar pasos, que es como avanza una campaña `phased`."},"3216":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-130","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#4-ejecuta-y-vigila-la-campaña","content":"La cabecera de la página repite el botón principal (**Execute Campaign**, o **Send to Test Device** antes del canario) y &#x2A;*Retry N failed device(s)**. No tiene pausar, reanudar ni cancelar: están en el menú de fila de la lista. En hawkBit, **Pause** está oculto hasta que la campaña ha empezado a despachar."},"3217":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-131","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#5-sigue-los-dispositivos","content":"Abre **Devices** (en **IoT**) y elige un dispositivo. La página tiene más pestañas que las relacionadas con actualizaciones que se listan aquí:"},"3218":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-132","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#5-sigue-los-dispositivos","content":"Pestaña"},"3219":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-133","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#5-sigue-los-dispositivos","content":"Muestra"},"3220":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-134","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#5-sigue-los-dispositivos","content":"**Information**"},"3221":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-135","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#5-sigue-los-dispositivos","content":"Los distribution sets que lleva, y **Up to date** u **Outdated** respecto al objetivo declarado"},"3222":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-136","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#5-sigue-los-dispositivos","content":"**Update Status**"},"3223":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-137","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#5-sigue-los-dispositivos","content":"Nativo: el workflow de eventos de WFX. hawkBit: la actualización en curso con los pasos Assigned, Installing e Installed"},"3224":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-138","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#5-sigue-los-dispositivos","content":"**Package Inventory**"},"3225":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-139","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#5-sigue-los-dispositivos","content":"**Installed Distribution Sets** con sus artefactos, y el **Pack Update History**"},"3226":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-140","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#5-sigue-los-dispositivos","content":"**Jobs**"},"3227":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-141","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#5-sigue-los-dispositivos","content":"Los trabajos de WFX del dispositivo"},"3228":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-142","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#5-sigue-los-dispositivos","content":"Usa &#x2A;*Launch Update...** en el menú de acciones del dispositivo para enviar una versión a un dispositivo. El diálogo **Launch update for device** pide el grupo de dispositivos (cuando el dispositivo está en varios), el distribution set, la versión y el workflow (o el install mode), y crea un trabajo. El menú de acciones del propio paquete tiene **Targeted Update**, que hace lo mismo con los dispositivos que marques en una lista, siempre con el workflow `direct`, y se habilita cuando el paquete está construido. En **OTA Devices**, selecciona dispositivos de un mismo grupo y pulsa **Update** para hacerlo con muchos dispositivos; el botón está deshabilitado cuando la selección abarca varios grupos."},"3229":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-143","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#5-sigue-los-dispositivos","content":"**OTA Dashboard**, **OTA Devices** y **OTA Device Groups** muestran el cumplimiento de versiones: qué dispositivos están al día, por detrás de un objetivo declarado o sin objetivo. La página de un grupo también lista la versión que ejecuta cada dispositivo frente a la versión publicada del grupo, con un botón **Update to vX** para los desactualizados. Sin soporte de cumplimiento de versiones en el backend, siguen listando dispositivos y campañas, pero las versiones objetivo aparecen como **No target** o con un guion largo, con la alerta «Target versions unavailable on this backend»."},"3230":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-144","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#qué-cambia-según-el-backend","content":"Pantalla"},"3231":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-145","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#qué-cambia-según-el-backend","content":"Nativo"},"3232":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-146","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#qué-cambia-según-el-backend","content":"hawkBit"},"3233":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-147","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#qué-cambia-según-el-backend","content":"Lista de paquetes"},"3234":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-148","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#qué-cambia-según-el-backend","content":"Estado, empaquetado y tarjetas **Built / Not built / Build failed**"},"3235":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-149","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#qué-cambia-según-el-backend","content":"Esas tarjetas, el filtro y la columna de estado se ocultan. Un conjunto no tiene estado de construcción propio: está listo cuando todos sus módulos están construidos, y **Start Campaign** sigue deshabilitado hasta entonces"},"3236":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-150","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#qué-cambia-según-el-backend","content":"Paquete nuevo"},"3237":{"id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard-151","page_id":"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/es/platform/updates/guides/dash