preview/pr-56/platform/updates/reference/configuration","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/reference/configuration#blob-storage-blocks","content":"Blob storage blocks"},"4751":{"id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration-9","page_id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/reference/configuration#storage-storage","content":"Storage (`*.storage`)"},"4752":{"id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration-10","page_id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/reference/configuration#at-rest-encryption-encryption","content":"At-rest encryption (`*.encryption`)"},"4753":{"id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration-11","page_id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/reference/configuration#presigned-downloads-presign","content":"Presigned downloads (`*.presign`)"},"4754":{"id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration-12","page_id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/reference/configuration#hawkbit-block","content":"`hawkbit` block"},"4755":{"id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration-13","page_id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/reference/configuration#environment-variables","content":"Environment variables"},"4756":{"id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration-14","page_id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/reference/configuration#minimal-configurations","content":"Minimal configurations"},"4757":{"id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration-15","page_id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/reference/configuration#symkms-as-its-own-process","content":"SymKMS as its own process"},"4758":{"id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration-16","page_id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/updates/reference/configuration#related-pages","content":"Related pages"},"4759":{"id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration-17","page_id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/reference/configuration","content":"Lamassu Updates reads a single YAML file at start-up. This page lists every key the code reads, its default, and which backend (`native` or `hawkbit`) uses it. Keys that appear in the example files but are not read are listed separately so you do not rely on them."},"4760":{"id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration-18","page_id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/reference/configuration#how-the-configuration-is-loaded","content":"Set the file location with the `OTA_CONFIG_FILE` environment variable. If it is unset, the service reads `/etc/lamassuiot/config.yml`, which is where the Docker image and the Helm chart mount it."},"4761":{"id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration-19","page_id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/reference/configuration#how-the-configuration-is-loaded","content":"If `OTA_CONFIG_FILE` names a file that cannot be loaded (missing, or invalid YAML), the service logs a warning and &#x2A;*falls back to `/etc/lamassuiot/config.yml`**. In the Docker image that path holds the repository's developer `config.yml`, so a typo in the path can start the service with the wrong settings. If the fallback fails too, the service exits."},"4762":{"id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration-20","page_id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/reference/configuration#how-the-configuration-is-loaded","content":"The file is read once. Restart the service after any change."},"4763":{"id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration-21","page_id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/reference/configuration#how-the-configuration-is-loaded","content":"`LAMASSU_CONFIG_FILE`, which the Dockerfile and the Helm chart set, is not read by the code. Only `OTA_CONFIG_FILE` matters."},"4764":{"id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration-22","page_id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/reference/configuration#how-the-configuration-is-loaded","content":"Any key can be overridden by an environment variable. See Environment variables."},"4765":{"id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration-23","page_id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/updates/reference/configuration#how-the-configuration-is-loaded","content":"The repository ships three examples:"},"4766":{"id":"/docs/pr-preview/pr-56/platform/updates/reference/configuration-24"