rm/overview#choose-your-path","content":"IoT Fleets overview"},"1732":{"id":"/docs/pr-preview/pr-56/platform/overview-26","page_id":"/docs/pr-preview/pr-56/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/overview#choose-your-path","content":"**Administration**"},"1733":{"id":"/docs/pr-preview/pr-56/platform/overview-27","page_id":"/docs/pr-preview/pr-56/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/overview#choose-your-path","content":"Operator permissions, audit and event subscriptions."},"1734":{"id":"/docs/pr-preview/pr-56/platform/overview-28","page_id":"/docs/pr-preview/pr-56/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/overview#choose-your-path","content":"Access control"},"1735":{"id":"/docs/pr-preview/pr-56/platform/overview-29","page_id":"/docs/pr-preview/pr-56/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/overview#choose-your-path","content":"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts."},"1736":{"id":"/docs/pr-preview/pr-56/platform/overview-30","page_id":"/docs/pr-preview/pr-56/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/overview#architecture-at-a-glance","content":"An identity's journey connects four responsibilities:"},"1737":{"id":"/docs/pr-preview/pr-56/platform/overview-31","page_id":"/docs/pr-preview/pr-56/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/overview#architecture-at-a-glance","content":"The PKI administrator prepares the authority, its key and issuance rules."},"1738":{"id":"/docs/pr-preview/pr-56/platform/overview-32","page_id":"/docs/pr-preview/pr-56/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/overview#architecture-at-a-glance","content":"The provisioning administrator configures the DMS and initial trust."},"1739":{"id":"/docs/pr-preview/pr-56/platform/overview-33","page_id":"/docs/pr-preview/pr-56/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/overview#architecture-at-a-glance","content":"The device client requests a certificate and installs it with the matching key."},"1740":{"id":"/docs/pr-preview/pr-56/platform/overview-34","page_id":"/docs/pr-preview/pr-56/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/overview#architecture-at-a-glance","content":"The consumer validates the identity and applies its access permissions."},"1741":{"id":"/docs/pr-preview/pr-56/platform/overview-35","page_id":"/docs/pr-preview/pr-56/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/overview#architecture-at-a-glance","content":"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment."},"1742":{"id":"/docs/pr-preview/pr-56/platform/overview-36","page_id":"/docs/pr-preview/pr-56/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/overview#build-your-trust-hierarchy","content":"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize."},"1743":{"id":"/docs/pr-preview/pr-56/platform/overview-37","page_id":"/docs/pr-preview/pr-56/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/overview#protect-cryptographic-keys","content":"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment."},"1744":{"id":"/docs/pr-preview/pr-56/platform/overview-38","page_id":"/docs/pr-preview/pr-56/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/overview#issue-and-control-certificates","content":"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it."},"1745":{"id":"/docs/pr-preview/pr-56/platform/overview-39","page_id":"/docs/pr-preview/pr-56/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/overview#automate-device-identities","content":"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration."},"1746":{"id":"/docs/pr-preview/pr-56/platform/overview-40","page_id":"/docs/pr-preview/pr-56/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/overview#publish-validation-status","content":"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information."},"1747":{"id":"/docs/pr-preview/pr-56/platform/overview-41","page_id":"/docs/pr-preview/pr-56/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/overview#react-to-events","content":"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events."},"1748":{"id":"/docs/pr-preview/pr-56/platform/overview-42","page_id":"/docs/pr-preview/pr-56/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/overview#operational-reference","content":"Responsibility"},"1749":{"id":"/docs/pr-preview/pr-56/platform/overview-43","page_id":"/docs/pr-preview/pr-56/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/overview#operational-reference","content":"What it prepares or checks"},"1750":{"id":"/docs/pr-preview/pr-56/platform/overview-44","page_id":"/docs/pr-preview/pr-56/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/overview#operational-reference","content":"PKI administrator"},"1751":{"id":"/docs/pr-preview/pr-56/platform/overview-45","page_id":"/docs/pr-preview/pr-56/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/overview#operational-reference","content":"Key custody, CA hierarchy, profiles and validation."},"1752":{"id":"/docs/pr-preview/pr-56/platform/overview-46","page_id":"/docs/pr-preview/pr-56/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/overview#operational-reference","content":"Fleet administrator"},"1753":{"id":"/docs/pr-preview/pr-56/platform/overview-47","page_id":"/docs/pr-preview/pr-56/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/overview#operational-reference","content":"DMS, device admission, renewal policy and inventory."},"1754":{"id":"/docs/pr-preview/pr-56/platform/overview-48","page_id":"/docs/pr-preview/pr-56/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/overview#operational-reference","content":"Device integrator"},"1755":{"id":"/docs/pr-preview/pr-56/platform/overview-49","page_id":"/docs/pr-preview/pr-56/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/overview#operational-reference","content":"Initial credential, server trust, EST client, and key and certificate storage."},"1756":{"id":"/docs/pr-preview/pr-56/platform/overview-50","page_id":"/docs/pr-preview/pr-56/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/overview#operational-reference","content":"Consumer integrator"},"1757":{"id":"/docs/pr-preview/pr-56/platform/overview-51","page_id":"/docs/pr-preview/pr-56/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/overview#operational-reference","content":"Issuer trust, certificate validation and permissions in the destination."},"1758":{"id":"/docs/pr-preview/pr-56/platform/overview-52","page_id":"/docs/pr-preview/pr-56/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/overview#operational-reference","content":"Infrastructure operator"},"1759":{"id":"/docs/pr-preview/pr-56/platform/overview-53","page_id":"/docs/pr-preview/pr-56/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/overview#operational-reference","content":"Installation, network, availability, dependencies and deployment diagnosis."},"1760":{"id":"/docs/pr-preview/pr-56/platform/overview-54","page_id":"/docs/pr-preview/pr-56/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/overview#operational-reference","content":"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment."},"1761":{"id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation","page_id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation","type":"page","content":"CA hierarchy and rotation","breadcrumbs":["Docs","Platform","PKI","Keys, authorities and certificates"],"tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation"},"1762":{"id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation-0","page_id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation","content":"Design root and intermediate authorities and replace certificates or keys without breaking trust."},"1763":{"id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation-1","page_id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","content":"Design the hierarchy"},"1764":{"id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation-2","page_id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","content":"Reissuance and rotation are not the same"},"1765":{"id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation-3","page_id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","content":"When to choose each operation"},"1766":{"id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation-4","page_id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","content":"Key rotation procedure"},"1767":{"id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation-5","page_id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","content":"Inventory the dependencies"},"1768":{"id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation-6","page_id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","content":"Create the successor CA"},"1769":{"id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation-7","page_id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","content":"Distribute the new trust"},"1770":{"id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation-8","page_id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation#switch-issuance","content":"Switch issuance"},"1771":{"id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation-9","page_id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","content":"Renew in batches"},"1772":{"id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation-10","page_id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","content":"Close the overlap"},"1773":{"id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation-11","page_id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","content":"Cascading revocation"},"1774":{"id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation-12","page_id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","content":"Checks after the change"},"1775":{"id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation-13","page_id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation","content":"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust."},"1776":{"id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation-14","page_id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation","content":"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap."},"1777":{"id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation-15","page_id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","content":"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:"},"1778":{"id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation-16","page_id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","content":"environment, such as production and preproduction;"},"1779":{"id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation-17","page_id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","content":"owner or operating team;"},"1780":{"id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation-18","page_id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","content":"device family or manufacturing process;"},"1781":{"id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation-19","page_id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","content":"region or regulatory requirement;"},"1782":{"id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation-20","page_id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","content":"cryptographic engine or key policy;"},"1783":{"id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation-21","page_id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","content":"maintenance window and renewal cadence."},"1784":{"id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation-22","page_id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","content":"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew."},"1785":{"id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation-23","page_id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","content":"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates."},"1786":{"id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation-24","page_id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","content":"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata."},"1787":{"id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation-25","page_id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","content":"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies."},"1788":{"id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation-26","page_id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","content":"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions."},"1789":{"id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation-27","page_id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","content":"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate."},"1790":{"id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation-28","page_id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","content":"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine."},"1791":{"id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation-29","page_id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","content":"Create a parallel branch if you cannot update all consumers at the same time."},"1792":{"id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation-30","page_id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","content":"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet."},"1793":{"id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation-31","page_id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","content":"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months."},"1794":{"id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation-32","page_id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","content":"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation."},"1795":{"id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation-33","page_id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","content":"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity."},"1796":{"id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation-34","page_id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation#switch-issuance","content":"Update the enrollment CA and profile of the DMSs. While old-CA cohorts still renew, add the previous enrollment CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`): the new enrollment CA is trusted automatically, but the old one was the enrollment CA and appears in no re-enrollment trust list, so without that entry its certificates can no longer renew. The DMS guide documents the setting."},"1797":{"id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation-35","page_id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","content":"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain."},"1798":{"id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation-36","page_id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","content":"Once no legitimate consumer depends on the previous authority, remove it from issuance, from the re-enrollment validation CAs and from the distributed CAs. Revoke it if policy requires it."},"1799":{"id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation-37","page_id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","content":"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed."},"1800":{"id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation-38","page_id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","content":"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes."},"1801":{"id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation-39","page_id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","content":"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch."},"1802":{"id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation-40","page_id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","content":"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows."},"1803":{"id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation-41","page_id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","content":"The new chain ends in an anchor installed by the consumer."},"1804":{"id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation-42","page_id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","content":"New certificates contain the expected AKI, SKI, KU, EKU and SAN."},"1805":{"id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation-43","page_id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","content":"The DMS delivers the correct chain through EST `/cacerts`."},"1806":{"id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation-44","page_id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","content":"Re-enrollment accepts the old identity during the planned period."},"1807":{"id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation-45","page_id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","content":"OCSP and CRL respond for the authorities that remain active."},"1808":{"id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation-46","page_id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","content":"No DMS is left accidentally issuing from the old CA."},"1809":{"id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation-47","page_id":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","content":"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects."},"1810":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","type":"page","content":"Certification authorities","breadcrumbs":["Docs","Platform","PKI","Keys, authorities and certificates"],"tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities"},"1811":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-0","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","content":"Create, import and operate the authorities that establish your PKI's trust."},"1812":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-1","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#choose-a-flow","content":"Choose a flow"},"1813":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-2","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#create-a-new-authority","content":"Create a new authority"},"1814":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-3","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#before-you-begin","content":"Before you begin"},"1815":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-4","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#open-the-wizard","content":"Open the wizard"},"1816":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-5","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#configure-the-key","content":"Configure the key"},"1817":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-6","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#choose-the-ca-type","content":"Choose the CA type"},"1818":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-7","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#define-the-identity","content":"Define the identity"},"1819":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-8","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#configure-validity-and-uses","content":"Configure validity and uses"},"1820":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-9","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#create-and-verify","content":"Create and verify"},"1821":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-10","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#use-a-key-from-the-kms","content":"Use a key from the KMS"},"1822":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-11","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#import-an-external-ca","content":"Import an external CA"},"1823":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-12","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#select-the-engine","content":"Select the engine"},"1824":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-13","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#load-the-material","content":"Load the material"},"1825":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-14","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#define-the-default-issuance","content":"Define the default issuance"},"1826":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-15","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#verify-the-import","content":"Verify the import"},"1827":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-16","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#inspect-an-authority","content":"Inspect an authority"},"1828":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-17","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#issue-certificates","content":"Issue certificates"},"1829":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-18","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#revoke-a-ca","content":"Revoke a CA"},"1830":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-19","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#assess-the-impact","content":"Assess the impact"},"1831":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-20","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#start-the-revocation","content":"Start the revocation"},"1832":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-21","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#confirm-the-identity","content":"Confirm the identity"},"1833":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-22","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#check-the-publication","content":"Check the publication"},"1834":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-23","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#delete-a-ca","content":"Delete a CA"},"1835":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-24","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","content":"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA."},"1836":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-25","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","content":"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles."},"1837":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-26","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","content":"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately."},"1838":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-27","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#choose-a-flow","content":"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair."},"1839":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-28","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#choose-a-flow","content":"**New CA from the KMS:** reuse a key already registered in the platform."},"1840":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-29","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#choose-a-flow","content":"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with."},"1841":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-30","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#choose-a-flow","content":"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance."},"1842":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-31","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#choose-a-flow","content":"First time here? Follow Create your first CA to complete the minimal journey."},"1843":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-32","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#before-you-begin","content":"Decide whether the CA will be a root or an intermediate."},"1844":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-33","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#before-you-begin","content":"Choose the engine that will keep the key."},"1845":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-34","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#before-you-begin","content":"Define a validity longer than that of the certificates it will issue."},"1846":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-35","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#before-you-begin","content":"For an intermediate CA, make sure the parent CA is active."},"1847":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-36","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#open-the-wizard","content":"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair."},"1848":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-37","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#configure-the-key","content":"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities."},"1849":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-38","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#configure-the-key","content":"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material."},"1850":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-39","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#choose-the-ca-type","content":"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA."},"1851":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-40","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#define-the-identity","content":"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:"},"1852":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-41","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#define-the-identity","content":"`C`: two-letter ISO 3166-1 country code."},"1853":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-42","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#define-the-identity","content":"`ST`: state or province."},"1854":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-43","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#define-the-identity","content":"`L`: locality."},"1855":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-44","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#define-the-identity","content":"`O`: organization."},"1856":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-45","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#define-the-identity","content":"`OU`: organizational unit."},"1857":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-46","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#define-the-identity","content":"The CA's internal identifier is generated automatically and cannot be changed."},"1858":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-47","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#configure-validity-and-uses","content":"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date."},"1859":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-48","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#configure-validity-and-uses","content":"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers."},"1860":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-49","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#create-and-verify","content":"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign."},"1861":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-50","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#create-and-verify","content":"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities."},"1862":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-51","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#use-a-key-from-the-kms","content":"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile."},"1863":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-52","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#use-a-key-from-the-kms","content":"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy."},"1864":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-53","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#import-an-external-ca","content":"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages (including `cRLSign`, without which the CA cannot publish its CRL) and public-key correspondence. The key verification procedure also compares a CA key and certificate."},"1865":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-54","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#import-an-external-ca","content":"The backend rejects an import whose certificate lacks the CA basic constraint (`basicConstraints cA flag is not set`), whose serial number matches a stored certificate with different contents, or whose identical certificate already belongs to an existing CA. A deleted CA's certificate record is kept and can be reused when re-importing the same certificate, including its previous status. Re-importing a different certificate with that serial number is rejected; check the certificate and status after re-importing."},"1866":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-55","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#import-an-external-ca","content":"Deleting a CA releases the key references of its own current certificate and linked reissued certificates, while keeping those records for its issuer's CRL and OCSP. It then attempts to delete the key; the KMS keeps it if other certificates still reference it, such as another CA sharing the key. Revoking certificates issued by the deleted CA does not release their own key references."},"1867":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-56","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#select-the-engine","content":"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS."},"1868":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-57","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#load-the-material","content":"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores."},"1869":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-58","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#define-the-default-issuance","content":"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles."},"1870":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-59","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#verify-the-import","content":"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign."},"1871":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-60","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#verify-the-import","content":"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication."},"1872":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-61","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#inspect-an-authority","content":"Open a CA from the inventory to review:"},"1873":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-62","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#inspect-an-authority","content":"Status and validity period."},"1874":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-63","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#inspect-an-authority","content":"Certificate and chain in PEM format."},"1875":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-64","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#inspect-an-authority","content":"Number of active, expired and revoked certificates."},"1876":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-65","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#inspect-an-authority","content":"Certificates issued in **Issued Certificates**."},"1877":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-66","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#inspect-an-authority","content":"The CRL linked to the authority."},"1878":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-67","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#inspect-an-authority","content":"Metadata and the associated cryptographic engine."},"1879":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-68","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#inspect-an-authority","content":"You can filter the inventory by name, status and CA type."},"1880":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-69","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#issue-certificates","content":"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory."},"1881":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-70","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#issue-certificates","content":"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end."},"1882":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-71","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#issue-certificates","content":"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key."},"1883":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-72","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#issue-certificates","content":"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation."},"1884":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-73","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#revoke-a-ca","content":"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions."},"1885":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-74","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#assess-the-impact","content":"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary."},"1886":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-75","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#start-the-revocation","content":"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`."},"1887":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-76","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#confirm-the-identity","content":"Type the CA's name exactly to enable **Confirm Revocation**."},"1888":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-77","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#check-the-publication","content":"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes."},"1889":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-78","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#delete-a-ca","content":"Permanent deletion is only available with the CA revoked or expired; a CA imported without a key can be deleted in any state. Delete the record only when your retention and audit policy allows it."},"1890":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-79","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#delete-a-ca","content":"The CA’s VA role is kept. If no other CA with the same SKI remains, it can no longer be edited (see CRL), so adjust its validity and signer beforehand. The CA’s key is released, but the KMS keeps it while other certificates still reference it."},"1891":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities-80","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#delete-a-ca","content":"Lamassu keeps the certificate record of a deleted CA. If that same certificate is imported again, the import succeeds and reuses the record: it updates the type, issuer and key but keeps the status, so the CA reappears in the state it had when deleted (normally revoked or expired). A different certificate with the same serial number is rejected with a 400 error, and a certificate that already belongs to an existing CA with a 409 error. To avoid inheriting the previous status, use a certificate with a different serial number and check the result after importing. If the new certificate uses the same key, it shares the SKI with the retained VA role of the deleted CA, whose signer is the old certificate: check that the CRL is generated and, if it is not, use `PUT` to set a signer of the new CA (see CRL)."},"1892":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles","type":"page","content":"Certificate profiles","breadcrumbs":["Docs","Platform","PKI","Keys, authorities and certificates"],"tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles"},"1893":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles-0","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles","content":"Define reusable policies to issue consistent certificates and constrain accepted keys."},"1894":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles-1","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles#what-a-profile-controls","content":"What a profile controls"},"1895":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles-2","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles#validity","content":"Validity"},"1896":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles-3","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","content":"CA certificate or end-entity certificate"},"1897":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles-4","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","content":"Key Usage and Extended Key Usage"},"1898":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles-5","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles#subject","content":"Subject"},"1899":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles-6","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles#csr-extensions","content":"CSR extensions"},"1900":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles-7","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles#cryptographic-constraints","content":"Cryptographic constraints"},"1901":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles-8","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles#profile-precedence","content":"Profile precedence"},"1902":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles-9","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles#create-a-profile","content":"Create a profile"},"1903":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles-10","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles#define-a-single-purpose","content":"Define a single purpose"},"1904":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles-11","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles#choose-the-validity","content":"Choose the validity"},"1905":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles-12","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles#fix-usages-and-subject","content":"Fix usages and subject"},"1906":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles-13","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles#constrain-the-keys","content":"Constrain the keys"},"1907":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles-14","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles#attach-it-and-test","content":"Attach it and test"},"1908":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles-15","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles#design-examples","content":"Design examples"},"1909":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles-16","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles#changes-and-deletion","content":"Changes and deletion"},"1910":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles-17","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles","content":"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance."},"1911":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles-18","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles","content":"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements."},"1912":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles-19","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles#validity","content":"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement."},"1913":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles-20","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles#validity","content":"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either."},"1914":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles-21","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","content":"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Enable it only in profiles intended to create or reissue subordinate CAs."},"1915":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles-22","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","content":"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`."},"1916":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles-23","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","content":"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile."},"1917":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles-24","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","content":"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended."},"1918":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles-25","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles#subject","content":"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept."},"1919":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles-26","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles#csr-extensions","content":"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions."},"1920":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles-27","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles#csr-extensions","content":"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points."},"1921":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles-28","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles#cryptographic-constraints","content":"The cryptographic enforcement can:"},"1922":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles-29","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles#cryptographic-constraints","content":"allow or block RSA keys;"},"1923":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles-30","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles#cryptographic-constraints","content":"limit the supported RSA sizes;"},"1924":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles-31","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles#cryptographic-constraints","content":"allow or block ECDSA keys;"},"1925":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles-32","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles#cryptographic-constraints","content":"limit the supported ECDSA sizes or curves."},"1926":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles-33","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles#cryptographic-constraints","content":"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected."},"1927":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles-34","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles#profile-precedence","content":"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile."},"1928":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles-35","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles#profile-precedence","content":"Operation"},"1929":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles-36","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles#profile-precedence","content":"First choice"},"1930":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles-37","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles#profile-precedence","content":"Second choice"},"1931":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles-38","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles#profile-precedence","content":"If neither is supplied"},"1932":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles-39","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles#profile-precedence","content":"Direct signing with a CA"},"1933":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles-40","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles#profile-precedence","content":"`issuance_profile` embedded in the request"},"1934":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles-41","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles#profile-precedence","content":"Request `issuance_profile_id`"},"1935":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles-42","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles#profile-precedence","content":"CA default profile (`profile_id`)."},"1936":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles-43","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles#profile-precedence","content":"Issuance through a DMS"},"1937":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles-44","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles#profile-precedence","content":"`settings.issuance_profile_id`"},"1938":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles-45","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles#profile-precedence","content":"`settings.issuance_profile` embedded in the DMS"},"1939":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles-46","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles#profile-precedence","content":"Enrollment CA default profile."},"1940":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles-47","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles#profile-precedence","content":"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR."},"1941":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles-48","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles#profile-precedence","content":"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS."},"1942":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles-49","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles#define-a-single-purpose","content":"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use."},"1943":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles-50","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles#choose-the-validity","content":"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration."},"1944":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles-51","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles#fix-usages-and-subject","content":"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it."},"1945":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles-52","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles#constrain-the-keys","content":"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices."},"1946":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles-53","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles#attach-it-and-test","content":"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present."},"1947":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles-54","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles#attach-it-and-test","content":"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer."},"1948":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles-55","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles#design-examples","content":"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device."},"1949":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles-56","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles#design-examples","content":"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use."},"1950":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles-57","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles#design-examples","content":"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints."},"1951":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles-58","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles#design-examples","content":"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer."},"1952":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles-59","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles#changes-and-deletion","content":"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification."},"1953":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles-60","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-profiles#changes-and-deletion","content":"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one."},"1954":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation","type":"page","content":"Certificate validation","breadcrumbs":["Docs","Platform","PKI","Validation"],"tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/certificate-validation"},"1955":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation-0","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-validation","content":"Check chain, identity, purpose and revocation from the consumer."},"1956":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation-1","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/certificate-validation#before-querying-status","content":"Before querying status"},"1957":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation-2","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/certificate-validation#choose-a-mechanism","content":"Choose a mechanism"},"1958":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation-3","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/certificate-validation#check-consumer-behavior","content":"Check consumer behavior"},"1959":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation-4","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-validation","content":"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy."},"1960":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation-5","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-validation#before-querying-status","content":"Verify these criteria together:"},"1961":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation-6","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-validation#before-querying-status","content":"Check"},"1962":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation-7","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-validation#before-querying-status","content":"Required result"},"1963":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation-8","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-validation#before-querying-status","content":"Chain and signature"},"1964":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation-9","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-validation#before-querying-status","content":"Valid chain to a root deliberately installed in the consumer."},"1965":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation-10","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-validation#before-querying-status","content":"Dates"},"1966":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation-11","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-validation#before-querying-status","content":"Current time between `Not Before` and `Not After`, including the CAs in the chain."},"1967":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation-12","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-validation#before-querying-status","content":"Identity"},"1968":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation-13","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-validation#before-querying-status","content":"Name, SAN or identifier matches the expected peer."},"1969":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation-14","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-validation#before-querying-status","content":"Purpose"},"1970":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation-15","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-validation#before-querying-status","content":"KU, EKU and constraints permit the specific operation."},"1971":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation-16","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-validation#before-querying-status","content":"Revocation"},"1972":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation-17","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-validation#before-querying-status","content":"Signed, current evidence corresponding to the queried issuer and certificate."},"1973":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation-18","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-validation#before-querying-status","content":"Authorization"},"1974":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation-19","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-validation#before-querying-status","content":"The application permits that identity to perform the action."},"1975":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation-20","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-validation#before-querying-status","content":"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria."},"1976":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation-21","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-validation#choose-a-mechanism","content":"Mechanism"},"1977":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation-22","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-validation#choose-a-mechanism","content":"When to use it"},"1978":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation-23","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-validation#choose-a-mechanism","content":"What you must maintain"},"1979":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation-24","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-validation#choose-a-mechanism","content":"OCSP"},"1980":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation-25","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-validation#choose-a-mechanism","content":"Status query for a specific certificate."},"1981":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation-26","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-validation#choose-a-mechanism","content":"Responder access, signature verification and cache/freshness policy."},"1982":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation-27","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-validation#choose-a-mechanism","content":"CRL"},"1983":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation-28","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-validation#choose-a-mechanism","content":"Local checks for many certificates or offline operation."},"1984":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation-29","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-validation#choose-a-mechanism","content":"Periodic download of an issuer-signed list and rejection of expired lists."},"1985":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation-30","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-validation#choose-a-mechanism","content":"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved."},"1986":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation-31","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-validation#choose-a-mechanism","content":"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision."},"1987":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation-32","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-validation#check-consumer-behavior","content":"Accept a current, authorized certificate with a known chain."},"1988":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation-33","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-validation#check-consumer-behavior","content":"Reject another certificate with an unknown root or incompatible purpose."},"1989":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation-34","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-validation#check-consumer-behavior","content":"Revoke a test certificate and verify the OCSP response or new CRL."},"1990":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation-35","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-validation#check-consumer-behavior","content":"Check that a new connection with that identity is rejected."},"1991":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation-36","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-validation#check-consumer-behavior","content":"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy."},"1992":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation-37","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-validation#check-consumer-behavior","content":"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it."},"1993":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation-38","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-validation#check-consumer-behavior","content":"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain."},"1994":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation-39","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-validation#check-consumer-behavior","content":"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />"},"1995":{"id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation-40","page_id":"/docs/pr-preview/pr-56/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificate-validation#check-consumer-behavior","content":"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />"},"1996":{"id":"/docs/pr-preview/pr-56/platform/pki/certificates","page_id":"/docs/pr-preview/pr-56/platform/pki/certificates","type":"page","content":"Certificates","breadcrumbs":["Docs","Platform","PKI","Keys, authorities and certificates"],"tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/certificates"},"1997":{"id":"/docs/pr-preview/pr-56/platform/pki/certificates-0","page_id":"/docs/pr-preview/pr-56/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificates","content":"Inspect, download and revoke the certificates issued by Lamassu."},"1998":{"id":"/docs/pr-preview/pr-56/platform/pki/certificates-1","page_id":"/docs/pr-preview/pr-56/platform/pki/certificates","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/certificates#find-a-certificate","content":"Find a certificate"},"1999":{"id":"/docs/pr-preview/pr-56/platform/pki/certificates-2","page_id":"/docs/pr-preview/pr-56/platform/pki/certificates","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/certificates#download-the-certificate","content":"Download the certificate"},"2000":{"id":"/docs/pr-preview/pr-56/platform/pki/certificates-3","page_id":"/docs/pr-preview/pr-56/platform/pki/certificates","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/certificates#issue-from-an-existing-csr","content":"Issue from an existing CSR"},"2001":{"id":"/docs/pr-preview/pr-56/platform/pki/certificates-4","page_id":"/docs/pr-preview/pr-56/platform/pki/certificates","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/certificates#revoke-a-certificate","content":"Revoke a certificate"},"2002":{"id":"/docs/pr-preview/pr-56/platform/pki/certificates-5","page_id":"/docs/pr-preview/pr-56/platform/pki/certificates","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/certificates#open-the-action","content":"Open the action"},"2003":{"id":"/docs/pr-preview/pr-56/platform/pki/certificates-6","page_id":"/docs/pr-preview/pr-56/platform/pki/certificates","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/certificates#choose-a-reason","content":"Choose a reason"},"2004":{"id":"/docs/pr-preview/pr-56/platform/pki/certificates-7","page_id":"/docs/pr-preview/pr-56/platform/pki/certificates","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/certificates#confirm-and-verify","content":"Confirm and verify"},"2005":{"id":"/docs/pr-preview/pr-56/platform/pki/certificates-8","page_id":"/docs/pr-preview/pr-56/platform/pki/certificates","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/certificates#reactivate-a-hold","content":"Reactivate a hold"},"2006":{"id":"/docs/pr-preview/pr-56/platform/pki/certificates-9","page_id":"/docs/pr-preview/pr-56/platform/pki/certificates","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/certificates#continue","content":"Continue"},"2007":{"id":"/docs/pr-preview/pr-56/platform/pki/certificates-10","page_id":"/docs/pr-preview/pr-56/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificates","content":"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer."},"2008":{"id":"/docs/pr-preview/pr-56/platform/pki/certificates-11","page_id":"/docs/pr-preview/pr-56/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificates#find-a-certificate","content":"Filter by `Common Name`, serial, status and issuer. Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata. Certificate details include the key reference (`key_id`) and whether the private key is managed (`has_private_key`), and certificate lists can be filtered on `has_private_key`."},"2009":{"id":"/docs/pr-preview/pr-56/platform/pki/certificates-12","page_id":"/docs/pr-preview/pr-56/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificates#find-a-certificate","content":"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions."},"2010":{"id":"/docs/pr-preview/pr-56/platform/pki/certificates-13","page_id":"/docs/pr-preview/pr-56/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificates#download-the-certificate","content":"Download the PEM and inspect it:"},"2011":{"id":"/docs/pr-preview/pr-56/platform/pki/certificates-14","page_id":"/docs/pr-preview/pr-56/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificates#download-the-certificate","content":"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate."},"2012":{"id":"/docs/pr-preview/pr-56/platform/pki/certificates-15","page_id":"/docs/pr-preview/pr-56/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificates#issue-from-an-existing-csr","content":"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile."},"2013":{"id":"/docs/pr-preview/pr-56/platform/pki/certificates-16","page_id":"/docs/pr-preview/pr-56/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificates#issue-from-an-existing-csr","content":"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity."},"2014":{"id":"/docs/pr-preview/pr-56/platform/pki/certificates-17","page_id":"/docs/pr-preview/pr-56/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificates#issue-from-an-existing-csr","content":"Start issuance from the CA or inventory and select **Upload Existing CSR**."},"2015":{"id":"/docs/pr-preview/pr-56/platform/pki/certificates-18","page_id":"/docs/pr-preview/pr-56/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificates#issue-from-an-existing-csr","content":"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained."},"2016":{"id":"/docs/pr-preview/pr-56/platform/pki/certificates-19","page_id":"/docs/pr-preview/pr-56/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificates#issue-from-an-existing-csr","content":"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system."},"2017":{"id":"/docs/pr-preview/pr-56/platform/pki/certificates-20","page_id":"/docs/pr-preview/pr-56/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificates#issue-from-an-existing-csr","content":"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration."},"2018":{"id":"/docs/pr-preview/pr-56/platform/pki/certificates-21","page_id":"/docs/pr-preview/pr-56/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificates#issue-from-an-existing-csr","content":"For browser key generation, follow Issue your first certificate."},"2019":{"id":"/docs/pr-preview/pr-56/platform/pki/certificates-22","page_id":"/docs/pr-preview/pr-56/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificates#revoke-a-certificate","content":"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement."},"2020":{"id":"/docs/pr-preview/pr-56/platform/pki/certificates-23","page_id":"/docs/pr-preview/pr-56/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificates#open-the-action","content":"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes."},"2021":{"id":"/docs/pr-preview/pr-56/platform/pki/certificates-24","page_id":"/docs/pr-preview/pr-56/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificates#choose-a-reason","content":"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key."},"2022":{"id":"/docs/pr-preview/pr-56/platform/pki/certificates-25","page_id":"/docs/pr-preview/pr-56/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificates#confirm-and-verify","content":"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer."},"2023":{"id":"/docs/pr-preview/pr-56/platform/pki/certificates-26","page_id":"/docs/pr-preview/pr-56/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificates#confirm-and-verify","content":"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps."},"2024":{"id":"/docs/pr-preview/pr-56/platform/pki/certificates-27","page_id":"/docs/pr-preview/pr-56/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificates#confirm-and-verify","content":"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory."},"2025":{"id":"/docs/pr-preview/pr-56/platform/pki/certificates-28","page_id":"/docs/pr-preview/pr-56/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificates#reactivate-a-hold","content":"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu."},"2026":{"id":"/docs/pr-preview/pr-56/platform/pki/certificates-29","page_id":"/docs/pr-preview/pr-56/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificates#reactivate-a-hold","content":"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy."},"2027":{"id":"/docs/pr-preview/pr-56/platform/pki/certificates-30","page_id":"/docs/pr-preview/pr-56/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificates#reactivate-a-hold","content":"This does not undo permanent revocation or a cascade started by revoking a CA."},"2028":{"id":"/docs/pr-preview/pr-56/platform/pki/certificates-31","page_id":"/docs/pr-preview/pr-56/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificates#continue","content":"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />"},"2029":{"id":"/docs/pr-preview/pr-56/platform/pki/certificates-32","page_id":"/docs/pr-preview/pr-56/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/certificates#continue","content":"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />"},"2030":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle","type":"page","content":"Certificate lifecycle","breadcrumbs":["Docs","Platform","PKI","Concepts"],"tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle"},"2031":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle-0","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle","content":"Issuance, use, renewal, revocation and retirement of certificates in Lamassu."},"2032":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle-1","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle#the-full-journey","content":"The full journey"},"2033":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle-2","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle#request","content":"Request"},"2034":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle-3","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle#issuance","content":"Issuance"},"2035":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle-4","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","content":"Use and monitoring"},"2036":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle-5","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","content":"Renewal or re-enrollment"},"2037":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle-6","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","content":"Revocation or retirement"},"2038":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle-7","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle#certificate-states","content":"Certificate states"},"2039":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle-8","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","content":"Renewal and revocation are not equivalent"},"2040":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle-9","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","content":"Effect of revoking a CA"},"2041":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle-10","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","content":"What you should watch"},"2042":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle-11","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle","content":"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to."},"2043":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle-12","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle#request","content":"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it."},"2044":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle-13","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle#issuance","content":"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints."},"2045":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle-14","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","content":"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`."},"2046":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle-15","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","content":"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST."},"2047":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle-16","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","content":"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status."},"2048":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle-17","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle#certificate-states","content":"Lamassu persists four X.509 states:"},"2049":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle-18","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle#certificate-states","content":"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity."},"2050":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle-19","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle#certificate-states","content":"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually."},"2051":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle-20","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle#certificate-states","content":"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp."},"2052":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle-21","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle#certificate-states","content":"**`INACTIVE`**: it is disabled without representing a definitive revocation."},"2053":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle-22","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle#certificate-states","content":"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states."},"2054":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle-23","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","content":"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity."},"2055":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle-24","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","content":"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation."},"2056":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle-25","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","content":"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period."},"2057":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle-26","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","content":"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks."},"2058":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle-27","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","content":"Before confirming:"},"2059":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle-28","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","content":"Identify DMSs, devices and services that trust that chain."},"2060":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle-29","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","content":"Distribute the new chain of trust."},"2061":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle-30","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","content":"Reissue the necessary identities."},"2062":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle-31","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","content":"Check OCSP and CRL from a real consumer."},"2063":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle-32","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","content":"Revoke the old CA once no legitimate traffic remains."},"2064":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle-33","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","content":"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management."},"2065":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle-34","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","content":"Certificates entering the preventive or critical renewal window."},"2066":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle-35","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","content":"Repeated enrollment or re-enrollment failures."},"2067":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle-36","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","content":"Status changes and revocation reasons."},"2068":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle-37","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","content":"OCSP and CRL publication and validity."},"2069":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle-38","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","content":"Dependencies still presenting a replaced certificate."},"2070":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle-39","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","content":"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs."},"2071":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model","type":"page","content":"Trust model","breadcrumbs":["Docs","Platform","PKI","Concepts"],"tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model"},"2072":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model-0","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model","content":"Understand where trust originates, how it is distributed and what each component validates."},"2073":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model-1","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model#the-four-trust-decisions","content":"The four trust decisions"},"2074":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model-2","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model#who-can-issue","content":"Who can issue"},"2075":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model-3","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model#what-can-be-issued","content":"What can be issued"},"2076":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model-4","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model#who-can-request-it","content":"Who can request it"},"2077":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model-5","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model#who-accepts-the-result","content":"Who accepts the result"},"2078":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model-6","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model#identity-flow","content":"Identity flow"},"2079":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model-7","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","content":"Enrollment, validation and distribution CAs"},"2080":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model-8","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model#validation-and-revocation","content":"Validation and revocation"},"2081":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model-9","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model#custody-limits","content":"Custody limits"},"2082":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model-10","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model#recommended-pattern","content":"Recommended pattern"},"2083":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model-11","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model","content":"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid."},"2084":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model-12","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model#who-can-issue","content":"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance."},"2085":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model-13","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model#what-can-be-issued","content":"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy."},"2086":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model-14","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model#who-can-request-it","content":"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity."},"2087":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model-15","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model#who-accepts-the-result","content":"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root."},"2088":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model-16","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model#identity-flow","content":"The device proves it can enroll according to the DMS policy."},"2089":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model-17","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model#identity-flow","content":"The DMS validates the request and forwards the CSR to the enrollment CA."},"2090":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model-18","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model#identity-flow","content":"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key."},"2091":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model-19","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model#identity-flow","content":"The device installs the certificate and the chain it needs."},"2092":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model-20","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model#identity-flow","content":"The system that trusts the device validates the chain, dates, uses and revocation status."},"2093":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model-21","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model#identity-flow","content":"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy."},"2094":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model-22","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","content":"A DMS relates three sets that are worth designing separately:"},"2095":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model-23","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","content":"**Enrollment CA:** signs the new identities."},"2096":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model-24","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","content":"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, the enrollment CA is always trusted and Lamassu then tries the validation CAs configured in the re-enrollment block; those are optional."},"2097":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model-25","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","content":"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors."},"2098":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model-26","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","content":"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap."},"2099":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model-27","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model#validation-and-revocation","content":"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:"},"2100":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model-28","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model#validation-and-revocation","content":"that the current date is between `Not Before` and `Not After`;"},"2101":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model-29","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model#validation-and-revocation","content":"that `Key Usage` and `Extended Key Usage` allow the operation;"},"2102":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model-30","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model#validation-and-revocation","content":"that names, SANs and subject match the expected identity;"},"2103":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model-31","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model#validation-and-revocation","content":"that the certificate does not appear revoked in OCSP or a CRL."},"2104":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model-32","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model#validation-and-revocation","content":"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together."},"2105":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model-33","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model#validation-and-revocation","content":"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production."},"2106":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model-34","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model#custody-limits","content":"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations."},"2107":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model-35","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model#recommended-pattern","content":"Keep the root out of daily operations, or with very restricted access."},"2108":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model-36","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model#recommended-pattern","content":"Issue from intermediate CAs separated by environment or risk domain."},"2109":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model-37","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model#recommended-pattern","content":"Assign explicit profiles to every use case."},"2110":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model-38","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model#recommended-pattern","content":"Distribute the new trust before starting a rotation."},"2111":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model-39","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model#recommended-pattern","content":"Keep enough overlap to renew a disconnected fleet."},"2112":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model-40","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model#recommended-pattern","content":"Validate from the consuming system, not only from the Lamassu console."},"2113":{"id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model-41","page_id":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model#recommended-pattern","content":"Continue with CA hierarchy and rotation to turn this model into an operating procedure."},"2114":{"id":"/docs/pr-preview/pr-56/platform/pki/crl","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","type":"page","content":"Revocation lists (CRL)","breadcrumbs":["Docs","Platform","PKI","Validation"],"tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/crl"},"2115":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-0","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/crl","content":"Generate and distribute signed lists to validate certificates offline."},"2116":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-1","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/crl#va-role-and-per-ca-configuration","content":"VA role and per-CA configuration"},"2117":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-2","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/crl#cas-that-share-a-key","content":"CAs that share a key"},"2118":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-3","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/crl#periodic-and-automatic-regeneration","content":"Periodic and automatic regeneration"},"2119":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-4","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/crl#crl-contents","content":"CRL contents"},"2120":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-5","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/crl#public-download-endpoint","content":"Public download endpoint"},"2121":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-6","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/crl#va-role-management-api","content":"VA role management API"},"2122":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-7","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/crl#common-va-role-errors","content":"Common VA role errors"},"2123":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-8","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/crl#from-the-interface","content":"From the interface"},"2124":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-9","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/crl#references","content":"References"},"2125":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-10","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/crl","content":"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its SKI and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence."},"2126":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-11","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/crl#va-role-and-per-ca-configuration","content":"The VA role stores configuration and metadata for the latest list published for a CA’s SKI. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL."},"2127":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-12","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/crl#va-role-and-per-ca-configuration","content":"`crl_options` field"},"2128":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-13","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/crl#va-role-and-per-ca-configuration","content":"Purpose"},"2129":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-14","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/crl#va-role-and-per-ca-configuration","content":"Backend initial value"},"2130":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-15","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/crl#va-role-and-per-ca-configuration","content":"`validity`"},"2131":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-16","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/crl#va-role-and-per-ca-configuration","content":"Time from `thisUpdate` to `nextUpdate`."},"2132":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-17","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/crl#va-role-and-per-ca-configuration","content":"7 days."},"2133":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-18","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/crl#va-role-and-per-ca-configuration","content":"`refresh_interval`"},"2134":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-19","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/crl#va-role-and-per-ca-configuration","content":"Stored and returned by the API, but the VA does not use it: scheduled renewal does not depend on it (see Periodic and automatic regeneration)."},"2135":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-20","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/crl#va-role-and-per-ca-configuration","content":"6 days and 23 hours."},"2136":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-21","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/crl#va-role-and-per-ca-configuration","content":"`regenerate_on_revoke`"},"2137":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-22","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/crl#va-role-and-per-ca-configuration","content":"Request regeneration on revocation or reactivation from `CertificateHold` events."},"2138":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-23","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/crl#va-role-and-per-ca-configuration","content":"`true`."},"2139":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-24","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/crl#va-role-and-per-ca-configuration","content":"`signer_certificate_serial_number`"},"2140":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-25","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/crl#va-role-and-per-ca-configuration","content":"Serial number of the existing certificate that signs the CRL."},"2141":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-26","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/crl#va-role-and-per-ca-configuration","content":"Serial number of the CA’s current certificate."},"2142":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-27","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/crl#va-role-and-per-ca-configuration","content":"The signer must be an existing certificate with the `cRLSign` key usage and the same subject and public key as the CA. Certificates from before a reissue qualify. A delegated signer is not supported: a certificate with the CA’s subject but a different key is rejected."},"2143":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-28","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/crl#va-role-and-per-ca-configuration","content":"When a CA is reissued, the role keeps pointing at the previous certificate. CRLs remain valid because both certificates share subject and key, but the previous certificate cannot be deleted while the role uses it. To retire it, update the role’s signer."},"2144":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-29","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/crl#va-role-and-per-ca-configuration","content":"When a CA is deleted, its VA role is kept and cannot be removed through the API. If no other CA with the same SKI remains, the role can be read but any `PUT` returns 404, and the renewal job logs a warning on every cycle because it no longer finds the CA. The API offers no way out; it can only be fixed by editing the database. If another CA with that SKI remains, the role is still editable (see CAs that share a key). Adjust validity and signer before deleting the CA."},"2145":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-30","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/crl#va-role-and-per-ca-configuration","content":"A CA whose certificate lacks `cRLSign` cannot generate its CRL or edit its role (400 error). Since 4.0 the VA requires this usage. Check before importing with `openssl x509 -noout -ext keyUsage` and, if it is missing, obtain a certificate for the same CA and key that includes it and set it as the signer with `PUT`. After reissuing a CA, also check the key usage of the new certificate: it may not keep the original’s usages."},"2146":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-31","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/crl#va-role-and-per-ca-configuration","content":"`PUT` always validates the signer, even when the request does not change it. If the stored signer is no longer valid, no field of the role can be modified, not even the validity, until a valid one is set."},"2147":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-32","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/crl#va-role-and-per-ca-configuration","content":"Sharing a key between CAs can prevent CRL validation. See CAs that share a key."},"2148":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-33","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/crl#va-role-and-per-ca-configuration","content":"`latest_crl` contains version, validity start and end. Versions are kept as PEM in object storage at `pki/va/crl/{subject_key_id}/{version}.crl`; the public endpoint returns DER."},"2149":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-34","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/crl#cas-that-share-a-key","content":"The VA identifies each CRL by the CA’s SKI, and the SKI is derived from its key. Two CAs with the same key have the same SKI and share a single VA role and a single CRL. This happens when a CA is created on an existing KMS key, or when a CA is imported whose certificate declares an SKI already in use. Lamassu takes the SKI of an imported certificate as-is and does not check that it corresponds to its public key. The first CA creates the role and the others keep it."},"2150":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-35","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/crl#cas-that-share-a-key","content":"The certificates of all of them point to `/crl/{ski}`, but the published list has the first CA as issuer and only includes its revocations. A verifier compares the CRL issuer with the issuer of the certificate it validates (RFC 5280, §6.3.2) and rejects the list if they differ. Depending on its policy, the certificate is blocked (*hard-fail*) or accepted even though it is revoked (*soft-fail*). Revocations of the secondary CAs do not appear in any list."},"2151":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-36","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/crl#cas-that-share-a-key","content":"If the first CA is deleted, CRL generation for the remaining one fails because the configured signer no longer matches a CA with that name. Until the role’s signer is updated to a certificate of the remaining CA, the last published list keeps being served until it expires (7 days by default)."},"2152":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-37","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/crl#cas-that-share-a-key","content":"Before upgrading, review CAs that share a key. To detect the problem, compare the SKI of the CAs in the inventory: two with the same SKI are affected. To fix it, create a CA with its own key and reissue its certificates; those already issued keep the old URL and are not corrected until reissued. A CA imported with an SKI already in use does not replace the existing one as CRL issuer, because the issuer is resolved from the role’s signer. However, its own certificates point to that same URL and its revocations are not published. Until Lamassu rejects these imports, restrict the permission to import CAs as an interim control; it covers only the import path. Creating a CA with &#x2A;*Create New CA (Existing Key)** on a KMS key another CA already uses produces the same collision, so also avoid reusing keys across CAs. A per-CA CRL and the rejection of imports whose SKI collides with an existing CA are both proposed in lamassuiot#834, and neither is implemented yet."},"2153":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-38","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/crl#periodic-and-automatic-regeneration","content":"The VA scheduled job checks every role on each run and requests another list when the remaining validity of `latest_crl` is less than the interval between runs. The frequency is set in Helm with `services.va.job.crl.frequency` (default `0 * * * *`) and accepts a duration (`1h`) or a cron expression. A cron expression is converted into a constant interval equal to the time left until its next firing when the service starts, so it is not aligned with the clock. `refresh_interval` plays no part. Keep `validity` well above the interval: with a shorter validity, the list is regenerated on every cycle."},"2154":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-39","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/crl#periodic-and-automatic-regeneration","content":"If generation fails (for example, because of a role without a CA or an invalid signer), the job logs the warning `something went wrong while calculating CRL for CA <ski>` and retries on the next cycle. There is no other renewal path until the cause is fixed, and the last published list keeps being served until it expires. All of this depends on working jobs, storage and signing."},"2155":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-40","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/crl#periodic-and-automatic-regeneration","content":"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths: if it fails (missing role, invalid signer), the event is retried and, once retries are exhausted, moves to the failed-events queue. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it."},"2156":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-41","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/crl#periodic-and-automatic-regeneration","content":"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable."},"2157":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-42","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/crl#crl-contents","content":"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents."},"2158":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-43","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/crl#crl-contents","content":"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation."},"2159":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-44","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/crl#public-download-endpoint","content":"The VA service exposes `GET /crl/{subject_key_id}` without management authorization. Use the **issuing CA’s** SKI, not the end-entity certificate’s SKI or serial. First inspect the certificate’s CDP:"},"2160":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-45","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/crl#public-download-endpoint","content":"Replace the following URL with the CDP URL and review exposure in Deployment:"},"2161":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-46","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/crl#public-download-endpoint","content":"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:"},"2162":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-47","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/crl#public-download-endpoint","content":"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them."},"2163":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-48","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/crl#public-download-endpoint","content":"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial."},"2164":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-49","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/crl#va-role-management-api","content":"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints."},"2165":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-50","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/crl#va-role-management-api","content":"Method"},"2166":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-51","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/crl#va-role-management-api","content":"Relative path"},"2167":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-52","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/crl#va-role-management-api","content":"Operation"},"2168":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-53","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/crl#va-role-management-api","content":"`GET`"},"2169":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-54","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/crl#va-role-management-api","content":"`/v1/roles/{ca-ski}`"},"2170":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-55","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/crl#va-role-management-api","content":"Read `crl_options` and `latest_crl`."},"2171":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-56","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/crl#va-role-management-api","content":"`PUT`"},"2172":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-57","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/crl#va-role-management-api","content":"`/v1/roles/{ca-ski}`"},"2173":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-58","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/crl#va-role-management-api","content":"Replace CRL configuration."},"2174":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-59","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/crl#va-role-management-api","content":"You need authentication and role read or update permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract: the backend replaces `crl_options`; it does not merge omitted fields."},"2175":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-60","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/crl#va-role-management-api","content":"After a change, check saved configuration and the next list actually published. Updating the role alone does not establish regeneration or client acceptance."},"2176":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-61","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/crl#common-va-role-errors","content":"Symptom"},"2177":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-62","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/crl#common-va-role-errors","content":"Cause"},"2178":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-63","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/crl#common-va-role-errors","content":"Action"},"2179":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-64","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/crl#common-va-role-errors","content":"`PUT /v1/roles/{ca-ski}` returns 404 and `GET` returns 200."},"2180":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-65","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/crl#common-va-role-errors","content":"The role’s CA was deleted and no other CA with the same SKI remains."},"2181":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-66","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/crl#common-va-role-errors","content":"There is no API way out; it requires database intervention. Avoid it by adjusting the role before deleting the CA."},"2182":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-67","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/crl#common-va-role-errors","content":"`PUT` returns 400."},"2183":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-68","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/crl#common-va-role-errors","content":"The signer lacks `cRLSign`, or its subject and key match no CA with that SKI (for example, after deleting the first of two CAs that share a key)."},"2184":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-69","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/crl#common-va-role-errors","content":"Use `PUT` to set the serial number of a valid certificate of the remaining CA."},"2185":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-70","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/crl#common-va-role-errors","content":"`PUT` returns 400 from a 3.x client."},"2186":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-71","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/crl#common-va-role-errors","content":"`crl_options.subject_key_id_signer` was replaced by `signer_certificate_serial_number`, which is required."},"2187":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-72","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/crl#common-va-role-errors","content":"Update the client to send the new field."},"2188":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-73","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/crl#common-va-role-errors","content":"The CRL does not change after revoking a certificate."},"2189":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-74","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/crl#common-va-role-errors","content":"`regenerate_on_revoke` is `false`, or the event failed because of a missing role or an invalid signer."},"2190":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-75","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/crl#common-va-role-errors","content":"Check the VA logs and the failed-events queue; fix the signer."},"2191":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-76","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/crl#common-va-role-errors","content":"A verifier rejects the CRL because of the issuer."},"2192":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-77","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/crl#common-va-role-errors","content":"Several CAs share an SKI."},"2193":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-78","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/crl#common-va-role-errors","content":"See CAs that share a key."},"2194":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-79","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/crl#from-the-interface","content":"The CA view lets you inspect and download the available list. Compare version, issuer and timestamps with the copy downloaded from the public endpoint. Diagnose differences using PKI troubleshooting."},"2195":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-80","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/crl#references","content":"RFC 5280: X.509 and CRL profile."},"2196":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-81","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/crl#references","content":"OpenSSL: openssl-crl."},"2197":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-82","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/crl#references","content":"OpenSSL: openssl-verify."},"2198":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-83","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/crl#references","content":"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />"},"2199":{"id":"/docs/pr-preview/pr-56/platform/pki/crl-84","page_id":"/docs/pr-preview/pr-56/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/crl#references","content":"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />"},"2200":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","type":"page","content":"Keys and cryptographic engines","breadcrumbs":["Docs","Platform","PKI","Keys, authorities and certificates"],"tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/key-management"},"2201":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-0","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management","content":"Generate, import and operate keys without coupling the PKI to a specific provider."},"2202":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-1","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/key-management#what-the-kms-solves","content":"What the KMS solves"},"2203":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-2","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/key-management#cryptographic-engines","content":"Cryptographic engines"},"2204":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-3","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/key-management#file-system","content":"File System"},"2205":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-4","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/key-management#hashicorp-vault","content":"HashiCorp Vault"},"2206":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-5","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/key-management#aws-secrets-manager","content":"AWS Secrets Manager"},"2207":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-6","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/key-management#aws-kms","content":"AWS KMS"},"2208":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-7","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/key-management#pkcs11","content":"PKCS#11"},"2209":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-8","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/key-management#azure-key-vault","content":"Azure Key Vault"},"2210":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-9","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/key-management#key-inventory","content":"Key inventory"},"2211":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-10","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/key-management#create-or-import-keys","content":"Create or import keys"},"2212":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-11","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/key-management#generate-a-new-key-pair","content":"Generate a new key pair"},"2213":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-12","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/key-management#import-an-existing-pair","content":"Import an existing pair"},"2214":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-13","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/key-management#operations-on-a-key","content":"Operations on a key"},"2215":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-14","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/key-management#view-details","content":"View details"},"2216":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-15","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/key-management#sign-and-verify","content":"Sign and verify"},"2217":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-16","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/key-management#sign","content":"Sign"},"2218":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-17","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/key-management#verify","content":"Verify"},"2219":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-18","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/key-management#generate-a-csr","content":"Generate a CSR"},"2220":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-19","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/key-management#sign-locally-with-pkcs11","content":"Sign locally with PKCS#11"},"2221":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-20","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/key-management#before-deleting-a-key","content":"Before deleting a key"},"2222":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-21","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management","content":"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI."},"2223":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-22","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management","content":"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system."},"2224":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-23","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#what-the-kms-solves","content":"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider."},"2225":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-24","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#what-the-kms-solves","content":"In practice, it lets you:"},"2226":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-25","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#what-the-kms-solves","content":"Generate new key pairs from Lamassu IoT."},"2227":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-26","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#what-the-kms-solves","content":"Import keys created externally."},"2228":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-27","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#what-the-kms-solves","content":"Delegate custody and cryptographic operations to external engines."},"2229":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-28","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#what-the-kms-solves","content":"Reuse existing keys for CAs, CSRs and signing or verification tasks."},"2230":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-29","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#cryptographic-engines","content":"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform."},"2231":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-30","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#cryptographic-engines","content":"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements."},"2232":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-31","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#cryptographic-engines","content":"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration."},"2233":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-32","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#file-system","content":"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files."},"2234":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-33","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#hashicorp-vault","content":"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner."},"2235":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-34","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#hashicorp-vault","content":"The adapter reaches Vault over its configured HTTP(S) endpoint. The Vault server certificate is verified against the system trust store; a Vault signed by a private CA is trusted by adding its CA certificate to the engine's `ca_cert_file` (PEM-encoded). `insecure_skip_verify=true` disables verification and is a last resort; agree the transport settings with the deployment owner."},"2236":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-35","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#aws-secrets-manager","content":"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM."},"2237":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-36","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#aws-kms","content":"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations."},"2238":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-37","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#pkcs11","content":"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody."},"2239":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-38","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#azure-key-vault","content":"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations."},"2240":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-39","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#azure-key-vault","content":"Lamassu shows the enabled engines in the console."},"2241":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-40","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#azure-key-vault","content":"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate."},"2242":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-41","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#azure-key-vault","content":"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA."},"2243":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-42","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#key-inventory","content":"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to."},"2244":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-43","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#key-inventory","content":"The table includes the following fields:"},"2245":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-44","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#key-inventory","content":"**Name**: descriptive name of the key."},"2246":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-45","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#key-inventory","content":"**Type**: algorithm and key size, for example RSA 2048 or EC P-256."},"2247":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-46","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#key-inventory","content":"**Strength**: visual indicator of cryptographic strength."},"2248":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-47","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#key-inventory","content":"**Public/Private**: whether Lamassu manages the full pair or only the public key."},"2249":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-48","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#key-inventory","content":"**Crypto Engine**: cryptographic engine keeping the key."},"2250":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-49","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#key-inventory","content":"**Aliases**: alternative names associated with the key."},"2251":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-50","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#key-inventory","content":"**Tags**: labels for classification and search."},"2252":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-51","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#key-inventory","content":"**Related Entities**: certificates or other entities linked to that key."},"2253":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-52","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#key-inventory","content":"From this view you also reach the most common actions:"},"2254":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-53","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#key-inventory","content":"**View Details** to inspect metadata, identifiers and relationships."},"2255":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-54","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#key-inventory","content":"**Generate CSR** to create a PKCS#10 request with the selected key."},"2256":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-55","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#key-inventory","content":"**Sign / Verify** to test cryptographic operations on the key."},"2257":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-56","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#key-inventory","content":"**Delete Key** to remove the key from the system."},"2258":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-57","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#create-or-import-keys","content":"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import."},"2259":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-58","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#generate-a-new-key-pair","content":"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines."},"2260":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-59","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#generate-a-new-key-pair","content":"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:"},"2261":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-60","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#generate-a-new-key-pair","content":"**Key Name**: unique and descriptive name."},"2262":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-61","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#generate-a-new-key-pair","content":"**Crypto Engine**: engine that will keep the key."},"2263":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-62","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#generate-a-new-key-pair","content":"**Key Type** and **Key Size**: algorithm and size or curve."},"2264":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-63","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#generate-a-new-key-pair","content":"**Tags**: metadata to classify the key."},"2265":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-64","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#generate-a-new-key-pair","content":"**Metadata**: additional information for advanced uses."},"2266":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-65","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#import-an-existing-pair","content":"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production."},"2267":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-66","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#import-an-existing-pair","content":"When you have an exportable private key and the destination engine supports import."},"2268":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-67","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#import-an-existing-pair","content":"When an existing PKI needs to be migrated without reissuing certificates."},"2269":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-68","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#import-an-existing-pair","content":"When Lamassu must operate with a root of trust created by a third party."},"2270":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-69","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#import-an-existing-pair","content":"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:"},"2271":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-70","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#import-an-existing-pair","content":"**Key Name**: descriptive name within Lamassu IoT."},"2272":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-71","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#import-an-existing-pair","content":"**Crypto Engine**: engine that will keep the imported key."},"2273":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-72","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#import-an-existing-pair","content":"**Tags**: labels for organization and search."},"2274":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-73","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#import-an-existing-pair","content":"**Metadata**: additional optional information."},"2275":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-74","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#import-an-existing-pair","content":"**Private Key (PEM)**: private key in PEM format."},"2276":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-75","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#import-an-existing-pair","content":"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through."},"2277":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-76","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#operations-on-a-key","content":"Each registered key has a detail view and several operational actions."},"2278":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-77","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#view-details","content":"The **View Details** screen concentrates the technical and administrative information of the key."},"2279":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-78","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#view-details","content":"The **Overview** tab shows, among others, these fields:"},"2280":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-79","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#view-details","content":"**Key Name**: descriptive name."},"2281":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-80","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#view-details","content":"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats."},"2282":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-81","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#view-details","content":"**Tags**: associated labels."},"2283":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-82","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#view-details","content":"**Aliases**: alternative names."},"2284":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-83","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#view-details","content":"**Crypto Engine**: engine where the key resides."},"2285":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-84","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#view-details","content":"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level."},"2286":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-85","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#view-details","content":"The **Related Entities** section shows which Lamassu objects depend on that key."},"2287":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-86","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#view-details","content":"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it."},"2288":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-87","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#sign-and-verify","content":"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly."},"2289":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-88","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#sign-and-verify","content":"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain."},"2290":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-89","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#sign-and-verify","content":"When you open it, two areas appear: **Sign** and **Verify**."},"2291":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-90","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#sign","content":"This tab uses the private key to generate a digital signature over a message or an already computed *digest*."},"2292":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-91","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#sign","content":"Main fields:"},"2293":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-92","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#sign","content":"**Algorithm**: signing algorithm available for the key type."},"2294":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-93","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#sign","content":"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash."},"2295":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-94","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#sign","content":"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64."},"2296":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-95","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#sign","content":"**Message**: content to sign."},"2297":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-96","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#sign","content":"**Signature**: result of the operation, shown in hexadecimal."},"2298":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-97","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#verify","content":"This tab checks whether a signature corresponds to the associated public key."},"2299":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-98","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#verify","content":"Main fields:"},"2300":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-99","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#verify","content":"**Algorithm**: must match the algorithm used for the signature."},"2301":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-100","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#verify","content":"**Message Type**: `Raw` or `Digest`."},"2302":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-101","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#verify","content":"**Payload Encoding**: encoding of the message."},"2303":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-102","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#verify","content":"**Message**: original message or hash."},"2304":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-103","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#verify","content":"**Signature**: signature to check."},"2305":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-104","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#verify","content":"**Result**: indicator of the validation result."},"2306":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-105","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#generate-a-csr","content":"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine."},"2307":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-106","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#generate-a-csr","content":"This flow is useful for:"},"2308":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-107","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#generate-a-csr","content":"Requesting certificates from an external CA."},"2309":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-108","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#generate-a-csr","content":"Renewing an identity while keeping the same key."},"2310":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-109","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#generate-a-csr","content":"When you open the form, it asks for the subject data and the main certificate attributes:"},"2311":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-110","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#generate-a-csr","content":"**Common Name (CN)**: main name of the identity."},"2312":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-111","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#generate-a-csr","content":"**Organization (O)**: organization or company."},"2313":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-112","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#generate-a-csr","content":"**Organizational Unit (OU)**: department or unit."},"2314":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-113","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#generate-a-csr","content":"**Country (C)**: two-letter country code."},"2315":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-114","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#generate-a-csr","content":"**State / Province (ST)**: state or province."},"2316":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-115","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#generate-a-csr","content":"**Locality (L)**: city or locality."},"2317":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-116","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#generate-a-csr","content":"**Email Address**: contact email."},"2318":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-117","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#generate-a-csr","content":"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP."},"2319":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-118","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#generate-a-csr","content":"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields."},"2320":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-119","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#sign-locally-with-pkcs11","content":"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**."},"2321":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-120","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#sign-locally-with-pkcs11","content":"It requires the module, token and permissions of the corresponding provider. Check that the Lamassu identifier matches the object accessible from that module. Module configuration belongs to the client environment or Deployment."},"2322":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-121","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#before-deleting-a-key","content":"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine."},"2323":{"id":"/docs/pr-preview/pr-56/platform/pki/key-management-122","page_id":"/docs/pr-preview/pr-56/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/key-management#before-deleting-a-key","content":"The KMS refuses to delete a key that certificates still reference. Deleting a CA releases the references from its own current certificate and linked reissued certificates, then attempts to delete the key. If other certificates still reference the key, such as another CA sharing it, the KMS keeps it. Revoking certificates issued by the deleted CA does not release their own key references. Legacy references retained by the upgrade migration are described in the upgrade guide."},"2324":{"id":"/docs/pr-preview/pr-56/platform/pki/ocsp","page_id":"/docs/pr-preview/pr-56/platform/pki/ocsp","type":"page","content":"Online validation with OCSP","breadcrumbs":["Docs","Platform","PKI","Validation"],"tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/ocsp"},"2325":{"id":"/docs/pr-preview/pr-56/platform/pki/ocsp-0","page_id":"/docs/pr-preview/pr-56/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/ocsp","content":"Query signed status and verify the responder’s response."},"2326":{"id":"/docs/pr-preview/pr-56/platform/pki/ocsp-1","page_id":"/docs/pr-preview/pr-56/platform/pki/ocsp","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/ocsp#how-the-responder-works-in-lamassu","content":"How the responder works in Lamassu"},"2327":{"id":"/docs/pr-preview/pr-56/platform/pki/ocsp-2","page_id":"/docs/pr-preview/pr-56/platform/pki/ocsp","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/ocsp#embedding-in-issued-certificates","content":"Embedding in issued certificates"},"2328":{"id":"/docs/pr-preview/pr-56/platform/pki/ocsp-3","page_id":"/docs/pr-preview/pr-56/platform/pki/ocsp","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/ocsp#http-endpoints","content":"HTTP endpoints"},"2329":{"id":"/docs/pr-preview/pr-56/platform/pki/ocsp-4","page_id":"/docs/pr-preview/pr-56/platform/pki/ocsp","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/ocsp#generate-and-verify-a-query","content":"Generate and verify a query"},"2330":{"id":"/docs/pr-preview/pr-56/platform/pki/ocsp-5","page_id":"/docs/pr-preview/pr-56/platform/pki/ocsp","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/ocsp#check-from-the-interface","content":"Check from the interface"},"2331":{"id":"/docs/pr-preview/pr-56/platform/pki/ocsp-6","page_id":"/docs/pr-preview/pr-56/platform/pki/ocsp","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/ocsp#references","content":"References"},"2332":{"id":"/docs/pr-preview/pr-56/platform/pki/ocsp-7","page_id":"/docs/pr-preview/pr-56/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/ocsp","content":"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation."},"2333":{"id":"/docs/pr-preview/pr-56/platform/pki/ocsp-8","page_id":"/docs/pr-preview/pr-56/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/ocsp#how-the-responder-works-in-lamassu","content":"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:"},"2334":{"id":"/docs/pr-preview/pr-56/platform/pki/ocsp-9","page_id":"/docs/pr-preview/pr-56/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/ocsp#how-the-responder-works-in-lamassu","content":"Record status"},"2335":{"id":"/docs/pr-preview/pr-56/platform/pki/ocsp-10","page_id":"/docs/pr-preview/pr-56/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/ocsp#how-the-responder-works-in-lamassu","content":"Signed response"},"2336":{"id":"/docs/pr-preview/pr-56/platform/pki/ocsp-11","page_id":"/docs/pr-preview/pr-56/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/ocsp#how-the-responder-works-in-lamassu","content":"`ACTIVE`"},"2337":{"id":"/docs/pr-preview/pr-56/platform/pki/ocsp-12","page_id":"/docs/pr-preview/pr-56/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/ocsp#how-the-responder-works-in-lamassu","content":"`Good`."},"2338":{"id":"/docs/pr-preview/pr-56/platform/pki/ocsp-13","page_id":"/docs/pr-preview/pr-56/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/ocsp#how-the-responder-works-in-lamassu","content":"`REVOKED`"},"2339":{"id":"/docs/pr-preview/pr-56/platform/pki/ocsp-14","page_id":"/docs/pr-preview/pr-56/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/ocsp#how-the-responder-works-in-lamassu","content":"`Revoked`, with revocation reason and timestamp."},"2340":{"id":"/docs/pr-preview/pr-56/platform/pki/ocsp-15","page_id":"/docs/pr-preview/pr-56/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/ocsp#how-the-responder-works-in-lamassu","content":"Other states, including `INACTIVE` and `EXPIRED`"},"2341":{"id":"/docs/pr-preview/pr-56/platform/pki/ocsp-16","page_id":"/docs/pr-preview/pr-56/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/ocsp#how-the-responder-works-in-lamassu","content":"`Unknown` if the certificate and issuer can be retrieved."},"2342":{"id":"/docs/pr-preview/pr-56/platform/pki/ocsp-17","page_id":"/docs/pr-preview/pr-56/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/ocsp#how-the-responder-works-in-lamassu","content":"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy."},"2343":{"id":"/docs/pr-preview/pr-56/platform/pki/ocsp-18","page_id":"/docs/pr-preview/pr-56/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/ocsp#how-the-responder-works-in-lamassu","content":"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses."},"2344":{"id":"/docs/pr-preview/pr-56/platform/pki/ocsp-19","page_id":"/docs/pr-preview/pr-56/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/ocsp#how-the-responder-works-in-lamassu","content":"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation."},"2345":{"id":"/docs/pr-preview/pr-56/platform/pki/ocsp-20","page_id":"/docs/pr-preview/pr-56/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/ocsp#embedding-in-issued-certificates","content":"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:"},"2346":{"id":"/docs/pr-preview/pr-56/platform/pki/ocsp-21","page_id":"/docs/pr-preview/pr-56/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/ocsp#embedding-in-issued-certificates","content":"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates."},"2347":{"id":"/docs/pr-preview/pr-56/platform/pki/ocsp-22","page_id":"/docs/pr-preview/pr-56/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/ocsp#http-endpoints","content":"The service accepts:"},"2348":{"id":"/docs/pr-preview/pr-56/platform/pki/ocsp-23","page_id":"/docs/pr-preview/pr-56/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/ocsp#http-endpoints","content":"Method"},"2349":{"id":"/docs/pr-preview/pr-56/platform/pki/ocsp-24","page_id":"/docs/pr-preview/pr-56/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/ocsp#http-endpoints","content":"VA service path"},"2350":{"id":"/docs/pr-preview/pr-56/platform/pki/ocsp-25","page_id":"/docs/pr-preview/pr-56/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/ocsp#http-endpoints","content":"Format"},"2351":{"id":"/docs/pr-preview/pr-56/platform/pki/ocsp-26","page_id":"/docs/pr-preview/pr-56/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/ocsp#http-endpoints","content":"`POST`"},"2352":{"id":"/docs/pr-preview/pr-56/platform/pki/ocsp-27","page_id":"/docs/pr-preview/pr-56/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/ocsp#http-endpoints","content":"`/ocsp`"},"2353":{"id":"/docs/pr-preview/pr-56/platform/pki/ocsp-28","page_id":"/docs/pr-preview/pr-56/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/ocsp#http-endpoints","content":"DER request, `Content-Type: application/ocsp-request`."},"2354":{"id":"/docs/pr-preview/pr-56/platform/pki/ocsp-29","page_id":"/docs/pr-preview/pr-56/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/ocsp#http-endpoints","content":"`GET`"},"2355":{"id":"/docs/pr-preview/pr-56/platform/pki/ocsp-30","page_id":"/docs/pr-preview/pr-56/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/ocsp#http-endpoints","content":"`/ocsp/{ocsp_request}`"},"2356":{"id":"/docs/pr-preview/pr-56/platform/pki/ocsp-31","page_id":"/docs/pr-preview/pr-56/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/ocsp#http-endpoints","content":"DER request encoded using padded URL Base64."},"2357":{"id":"/docs/pr-preview/pr-56/platform/pki/ocsp-32","page_id":"/docs/pr-preview/pr-56/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/ocsp#http-endpoints","content":"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator."},"2358":{"id":"/docs/pr-preview/pr-56/platform/pki/ocsp-33","page_id":"/docs/pr-preview/pr-56/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/ocsp#generate-and-verify-a-query","content":"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs."},"2359":{"id":"/docs/pr-preview/pr-56/platform/pki/ocsp-34","page_id":"/docs/pr-preview/pr-56/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/ocsp#generate-and-verify-a-query","content":"Generate the request:"},"2360":{"id":"/docs/pr-preview/pr-56/platform/pki/ocsp-35","page_id":"/docs/pr-preview/pr-56/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/ocsp#generate-and-verify-a-query","content":"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce."},"2361":{"id":"/docs/pr-preview/pr-56/platform/pki/ocsp-36","page_id":"/docs/pr-preview/pr-56/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/ocsp#generate-and-verify-a-query","content":"Replace the example URL with the inspected endpoint:"},"2362":{"id":"/docs/pr-preview/pr-56/platform/pki/ocsp-37","page_id":"/docs/pr-preview/pr-56/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/ocsp#generate-and-verify-a-query","content":"Verify the returned DER:"},"2363":{"id":"/docs/pr-preview/pr-56/platform/pki/ocsp-38","page_id":"/docs/pr-preview/pr-56/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/ocsp#generate-and-verify-a-query","content":"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code."},"2364":{"id":"/docs/pr-preview/pr-56/platform/pki/ocsp-39","page_id":"/docs/pr-preview/pr-56/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/ocsp#check-from-the-interface","content":"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration."},"2365":{"id":"/docs/pr-preview/pr-56/platform/pki/ocsp-40","page_id":"/docs/pr-preview/pr-56/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/ocsp#check-from-the-interface","content":"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting."},"2366":{"id":"/docs/pr-preview/pr-56/platform/pki/ocsp-41","page_id":"/docs/pr-preview/pr-56/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/ocsp#references","content":"RFC 6960: OCSP."},"2367":{"id":"/docs/pr-preview/pr-56/platform/pki/ocsp-42","page_id":"/docs/pr-preview/pr-56/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/ocsp#references","content":"OpenSSL: openssl-ocsp."},"2368":{"id":"/docs/pr-preview/pr-56/platform/pki/ocsp-43","page_id":"/docs/pr-preview/pr-56/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/ocsp#references","content":"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />"},"2369":{"id":"/docs/pr-preview/pr-56/platform/pki/ocsp-44","page_id":"/docs/pr-preview/pr-56/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/ocsp#references","content":"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />"},"2370":{"id":"/docs/pr-preview/pr-56/platform/pki/overview","page_id":"/docs/pr-preview/pr-56/platform/pki/overview","type":"page","content":"PKI","breadcrumbs":["Docs","Platform","PKI"],"tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/overview"},"2371":{"id":"/docs/pr-preview/pr-56/platform/pki/overview-0","page_id":"/docs/pr-preview/pr-56/platform/pki/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/overview","content":"Administer keys and authorities, define issuance and verify the resulting certificates."},"2372":{"id":"/docs/pr-preview/pr-56/platform/pki/overview-1","page_id":"/docs/pr-preview/pr-56/platform/pki/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/overview#start-here","content":"Start here"},"2373":{"id":"/docs/pr-preview/pr-56/platform/pki/overview-2","page_id":"/docs/pr-preview/pr-56/platform/pki/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/overview#what-you-need","content":"What you need"},"2374":{"id":"/docs/pr-preview/pr-56/platform/pki/overview-3","page_id":"/docs/pr-preview/pr-56/platform/pki/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/overview#core-capabilities","content":"Core capabilities"},"2375":{"id":"/docs/pr-preview/pr-56/platform/pki/overview-4","page_id":"/docs/pr-preview/pr-56/platform/pki/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/overview#build-your-trust-hierarchy","content":"Build your trust hierarchy"},"2376":{"id":"/docs/pr-preview/pr-56/platform/pki/overview-5","page_id":"/docs/pr-preview/pr-56/platform/pki/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/overview#protect-cryptographic-keys","content":"Protect cryptographic keys"},"2377":{"id":"/docs/pr-preview/pr-56/platform/pki/overview-6","page_id":"/docs/pr-preview/pr-56/platform/pki/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/overview#issue-and-control-certificates","content":"Issue and control certificates"},"2378":{"id":"/docs/pr-preview/pr-56/platform/pki/overview-7","page_id":"/docs/pr-preview/pr-56/platform/pki/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/overview#publish-validation-status","content":"Publish validation status"},"2379":{"id":"/docs/pr-preview/pr-56/platform/pki/overview-8","page_id":"/docs/pr-preview/pr-56/platform/pki/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/overview#how-to-check-the-result","content":"How to check the result"},"2380":{"id":"/docs/pr-preview/pr-56/platform/pki/overview-9","page_id":"/docs/pr-preview/pr-56/platform/pki/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/overview#continue","content":"Continue"},"2381":{"id":"/docs/pr-preview/pr-56/platform/pki/overview-10","page_id":"/docs/pr-preview/pr-56/platform/pki/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/overview","content":"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system."},"2382":{"id":"/docs/pr-preview/pr-56/platform/pki/overview-11","page_id":"/docs/pr-preview/pr-56/platform/pki/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/overview#start-here","content":"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain."},"2383":{"id":"/docs/pr-preview/pr-56/platform/pki/overview-12","page_id":"/docs/pr-preview/pr-56/platform/pki/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/overview#start-here","content":"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets."},"2384":{"id":"/docs/pr-preview/pr-56/platform/pki/overview-13","page_id":"/docs/pr-preview/pr-56/platform/pki/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/overview#what-you-need","content":"An accessible instance and permission to manage the keys, CAs and certificates you will use."},"2385":{"id":"/docs/pr-preview/pr-56/platform/pki/overview-14","page_id":"/docs/pr-preview/pr-56/platform/pki/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/overview#what-you-need","content":"An available cryptographic engine to keep the authority's key."},"2386":{"id":"/docs/pr-preview/pr-56/platform/pki/overview-15","page_id":"/docs/pr-preview/pr-56/platform/pki/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/overview#what-you-need","content":"The certificate's purpose, such as authenticating a client through mTLS."},"2387":{"id":"/docs/pr-preview/pr-56/platform/pki/overview-16","page_id":"/docs/pr-preview/pr-56/platform/pki/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/overview#what-you-need","content":"Consumer requirements: accepted issuers, algorithms, names and permitted usages."},"2388":{"id":"/docs/pr-preview/pr-56/platform/pki/overview-17","page_id":"/docs/pr-preview/pr-56/platform/pki/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/overview#what-you-need","content":"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices."},"2389":{"id":"/docs/pr-preview/pr-56/platform/pki/overview-18","page_id":"/docs/pr-preview/pr-56/platform/pki/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/overview#build-your-trust-hierarchy","content":"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority."},"2390":{"id":"/docs/pr-preview/pr-56/platform/pki/overview-19","page_id":"/docs/pr-preview/pr-56/platform/pki/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/overview#protect-cryptographic-keys","content":"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method."},"2391":{"id":"/docs/pr-preview/pr-56/platform/pki/overview-20","page_id":"/docs/pr-preview/pr-56/platform/pki/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/overview#issue-and-control-certificates","content":"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status."},"2392":{"id":"/docs/pr-preview/pr-56/platform/pki/overview-21","page_id":"/docs/pr-preview/pr-56/platform/pki/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/overview#publish-validation-status","content":"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status."},"2393":{"id":"/docs/pr-preview/pr-56/platform/pki/overview-22","page_id":"/docs/pr-preview/pr-56/platform/pki/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/overview#how-to-check-the-result","content":"An active certificate in the console is one part of the check. Also verify that:"},"2394":{"id":"/docs/pr-preview/pr-56/platform/pki/overview-23","page_id":"/docs/pr-preview/pr-56/platform/pki/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/overview#how-to-check-the-result","content":"its subject and extensions identify the expected client;"},"2395":{"id":"/docs/pr-preview/pr-56/platform/pki/overview-24","page_id":"/docs/pr-preview/pr-56/platform/pki/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/overview#how-to-check-the-result","content":"its public key matches the client's private key;"},"2396":{"id":"/docs/pr-preview/pr-56/platform/pki/overview-25","page_id":"/docs/pr-preview/pr-56/platform/pki/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/overview#how-to-check-the-result","content":"its chain reaches a root trusted by the consumer;"},"2397":{"id":"/docs/pr-preview/pr-56/platform/pki/overview-26","page_id":"/docs/pr-preview/pr-56/platform/pki/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/overview#how-to-check-the-result","content":"its dates and usages allow the operation;"},"2398":{"id":"/docs/pr-preview/pr-56/platform/pki/overview-27","page_id":"/docs/pr-preview/pr-56/platform/pki/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/overview#how-to-check-the-result","content":"the consumer applies revocation checks and authorization."},"2399":{"id":"/docs/pr-preview/pr-56/platform/pki/overview-28","page_id":"/docs/pr-preview/pr-56/platform/pki/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/overview#how-to-check-the-result","content":"The issuance path includes the first independent checks."},"2400":{"id":"/docs/pr-preview/pr-56/platform/pki/overview-29","page_id":"/docs/pr-preview/pr-56/platform/pki/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/overview#continue","content":"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />"},"2401":{"id":"/docs/pr-preview/pr-56/platform/pki/overview-30","page_id":"/docs/pr-preview/pr-56/platform/pki/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/overview#continue","content":"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />"},"2402":{"id":"/docs/pr-preview/pr-56/platform/pki/overview-31","page_id":"/docs/pr-preview/pr-56/platform/pki/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/overview#continue","content":"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />"},"2403":{"id":"/docs/pr-preview/pr-56/platform/pki/quickstarts/create-certificate-authority","page_id":"/docs/pr-preview/pr-56/platform/pki/quickstarts/create-certificate-authority","type":"page","content":"Create your first CA","breadcrumbs":["Docs","Platform","PKI","Getting started"],"tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/quickstarts/create-certificate-authority"},"2404":{"id":"/docs/pr-preview/pr-56/platform/pki/quickstarts/create-certificate-authority-0","page_id":"/docs/pr-preview/pr-56/platform/pki/quickstarts/create-certificate-authority","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/quickstarts/create-certificate-authority","content":"Create an evaluation root and check its certificate before issuing."},"2405":{"id":"/docs/pr-preview/pr-56/platform/pki/quickstarts/create-certificate-authority-1","page_id":"/docs/pr-preview/pr-56/platform/pki/quickstarts/create-certificate-authority","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/quickstarts/create-certificate-authority#before-you-begin","content":"Before you begin"},"2406":{"id":"/docs/pr-preview/pr-56/platform/pki/quickstarts/create-certificate-authority-2","page_id":"/docs/pr-preview/pr-56/platform/pki/quickstarts/create-certificate-authority","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard-toc","content":"Open the creation wizard [!toc]"},"2407":{"id":"/docs/pr-preview/pr-56/platform/pki/quickstarts/create-certificate-authority-3","page_id":"/docs/pr-preview/pr-56/platform/pki/quickstar