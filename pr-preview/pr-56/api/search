platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/iot-fleets/overview#who-prepares-each-part","content":"Consumer integrator"},"1577":{"id":"/docs/pr-preview/pr-56/platform/iot-fleets/overview-44","page_id":"/docs/pr-preview/pr-56/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/iot-fleets/overview#who-prepares-each-part","content":"Trusted issuers, validation and device permissions in the destination."},"1578":{"id":"/docs/pr-preview/pr-56/platform/iot-fleets/overview-45","page_id":"/docs/pr-preview/pr-56/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/iot-fleets/overview#who-prepares-each-part","content":"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment."},"1579":{"id":"/docs/pr-preview/pr-56/platform/iot-fleets/quickstarts/enroll-device","page_id":"/docs/pr-preview/pr-56/platform/iot-fleets/quickstarts/enroll-device","type":"page","content":"Enroll and connect your first device","breadcrumbs":["Docs","Platform","IoT Fleets","Getting started"],"tags":[],"url":"/docs/pr-preview/pr-56/platform/iot-fleets/quickstarts/enroll-device"},"1580":{"id":"/docs/pr-preview/pr-56/platform/iot-fleets/quickstarts/enroll-device-0","page_id":"/docs/pr-preview/pr-56/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/iot-fleets/quickstarts/enroll-device","content":"Obtain an identity through EST, verify its association and use it in an mTLS connection."},"1581":{"id":"/docs/pr-preview/pr-56/platform/iot-fleets/quickstarts/enroll-device-1","page_id":"/docs/pr-preview/pr-56/platform/iot-fleets/quickstarts/enroll-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/iot-fleets/quickstarts/enroll-device#before-you-begin","content":"Before you begin"},"1582":{"id":"/docs/pr-preview/pr-56/platform/iot-fleets/qui