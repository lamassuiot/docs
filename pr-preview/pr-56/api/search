 certificate and the client's private key."},"2501":{"id":"/docs/pr-preview/pr-56/platform/pki/quickstarts/overview-6","page_id":"/docs/pr-preview/pr-56/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/quickstarts/overview#before-you-begin","content":"A Lamassu instance accessible from your browser. To prepare one, see Deployment."},"2502":{"id":"/docs/pr-preview/pr-56/platform/pki/quickstarts/overview-7","page_id":"/docs/pr-preview/pr-56/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/quickstarts/overview#before-you-begin","content":"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked."},"2503":{"id":"/docs/pr-preview/pr-56/platform/pki/quickstarts/overview-8","page_id":"/docs/pr-preview/pr-56/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/quickstarts/overview#before-you-begin","content":"An available cryptographic engine for the CA key; check the keys and engines inventory."},"2504":{"id":"/docs/pr-preview/pr-56/platform/pki/quickstarts/overview-9","page_id":"/docs/pr-preview/pr-56/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/quickstarts/overview#before-you-begin","content":"OpenSSL 3.x on the computer where you will verify the files."},"2505":{"id":"/docs/pr-preview/pr-56/platform/pki/quickstarts/overview-10","page_id":"/docs/pr-preview/pr-56/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/quickstarts/overview#before-you-begin","content":"A working directory with restricted access for the downloaded key."},"2506":{"id":"/docs/pr-preview/pr-56/platform/pki/quickstarts/overview-11","page_id":"/docs/pr-preview/pr-56/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/pki/quickstarts/overview#recommended-pat