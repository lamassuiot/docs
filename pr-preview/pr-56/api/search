erview-27","page_id":"/docs/pr-preview/pr-56/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"Messaging"},"363":{"id":"/docs/pr-preview/pr-56/deployment/self-hosted/overview-28","page_id":"/docs/pr-preview/pr-56/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"RabbitMQ connection configuration for the Lamassu services; the connection can use AMQPS, with an optional private CA and an optional client certificate, both set through chart values"},"364":{"id":"/docs/pr-preview/pr-56/deployment/self-hosted/overview-29","page_id":"/docs/pr-preview/pr-56/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"A reachable RabbitMQ broker, credentials and its lifecycle"},"365":{"id":"/docs/pr-preview/pr-56/deployment/self-hosted/overview-30","page_id":"/docs/pr-preview/pr-56/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"Identity"},"366":{"id":"/docs/pr-preview/pr-56/deployment/self-hosted/overview-31","page_id":"/docs/pr-preview/pr-56/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals"},"367":{"id":"/docs/pr-preview/pr-56/deployment/self-hosted/overview-32","page_id":"/docs/pr-preview/pr-56/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"An OIDC provider, realm/tenant, client, users, groups and roles"},"368":{"id":"/docs/pr-preview/pr-56/deployment/self-hosted/overview-33","page_id":"/docs/pr-preview/pr-56/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"External routing"},"369":{"id":"/docs/pr-preview/pr-56/deployment/self-hosted/overview-34","page_id":"/docs/pr-preview/pr-56/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies"},"370":{"id":"/docs/pr-preview/pr-56/deployment/self-hosted/overview-35","page_id":"/docs/pr-preview/pr-56/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path"},"371":{"id":"/docs/pr-preview/pr-56/deployment/self-hosted/overview-36","page_id":"/docs/pr-preview/pr-56/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"TLS"},"372":{"id":"/docs/pr-preview/pr-56/deployment/self-hosted/overview-37","page_id":"/docs/pr-preview/pr-56/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"In the default `tls.type: certManager` mode, cert-manager `Issuer` and CA `Certificate` resources and a chart-managed downstream `Certificate`; in the `tls.type: external` mode, a reference to your TLS Secret"},"373":{"id":"/docs/pr-preview/pr-56/deployment/self-hosted/overview-38","page_id":"/docs/pr-preview/pr-56/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"cert-manager only for the default `tls.type: certManager` mode; for trusted TLS, a trusted issuer or a populated TLS Secret"},"374":{"id":"/docs/pr-preview/pr-56/deployment/self-hosted/overview-39","page_id":"/docs/pr-preview/pr-56/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"Persistent application data"},"375":{"id":"/docs/pr-preview/pr-56/deployment/self-hosted/overview-40","page_id":"/docs/pr-preview/pr-56/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"PersistentVolumeClaims required by the default local KMS and VA storage"},"376":{"id":"/docs/pr-preview/pr-56/deployment/self-hosted/overview-41","page_id":"/docs/pr-preview/pr-56/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one"},"377":{"id":"/docs/pr-preview/pr-56/deployment/self-hosted/overview-42","page_id":"/docs/pr-preview/pr-56/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"Optional integrations"},"378":{"id":"/docs/pr-preview/pr-56/deployment/self-hosted/overview-43","page_id":"/docs/pr-preview/pr-56/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity"},"379":{"id":"/docs/pr-preview/pr-56/deployment/self-hosted/overview-44","page_id":"/docs/pr-preview/pr-56/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"The observability backends, cloud credentials and production HSM or external key service"},"380":{"id":"/docs/pr-preview/pr-56/deployment/self-hosted/overview-45","page_id":"/docs/pr-preview/pr-56/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network."},"381":{"id":"/docs/pr-preview/pr-56/deployment/self-hosted/overview-46","page_id":"/docs/pr-preview/pr-56/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service."},"382":{"id":"/docs/pr-preview/pr-56/deployment/self-hosted/overview-47","page_id":"/docs/pr-preview/pr-56/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/self-hosted/overview#how-the-deployment-fits-together","content":"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway."},"383":{"id":"/docs/pr-preview/pr-56/deployment/self-hosted/overview-48","page_id":"/docs/pr-preview/pr-56/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/self-hosted/overview#how-the-deployment-fits-together","content":"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it."},"384":{"id":"/docs/pr-preview/pr-56/deployment/self-hosted/overview-49","page_id":"/docs/pr-preview/pr-56/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/self-hosted/overview#platform-requirements","content":"Kubernetes 1.24 or newer"},"385":{"id":"/docs/pr-preview/pr-56/deployment/self-hosted/overview-50","page_id":"/docs/pr-preview/pr-56/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/self-hosted/overview#platform-requirements","content":"Helm 3.2 or newer"},"386":{"id":"/docs/pr-preview/pr-56/deployment/self-hosted/overview-51","page_id":"/docs/pr-preview/pr-56/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/self-hosted/overview#platform-requirements","content":"Envoy Gateway 1.8 or newer and a `GatewayClass`"},"387":{"id":"/docs/pr-preview/pr-56/deployment/self-hosted/overview-52","page_id":"/docs/pr-preview/pr-56/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/self-hosted/overview#platform-requirements","content":"cert-manager 1.14 or newer; required only for the default `tls.type: certManager` TLS mode, not for `tls.type: external`"},"388":{"id":"/docs/pr-preview/pr-56/deployment/self-hosted/overview-53","page_id":"/docs/pr-preview/pr-56/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/self-hosted/overview#platform-requirements","content":"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration"},"389":{"id":"/docs/pr-preview/pr-56/deployment/self-hosted/overview-54","page_id":"/docs/pr-preview/pr-56/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/self-hosted/overview#platform-requirements","content":"a load-balancer implementation or another deliberate path from clients to the Gateway"},"390":{"id":"/docs/pr-preview/pr-56/deployment/self-hosted/overview-55","page_id":"/docs/pr-preview/pr-56/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/self-hosted/overview#platform-requirements","content":"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations."},"391":{"id":"/docs/pr-preview/pr-56/deployment/self-hosted/overview-56","page_id":"/docs/pr-preview/pr-56/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/self-hosted/overview#choose-the-next-page","content":"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />"},"392":{"id":"/docs/pr-preview/pr-56/deployment/self-hosted/overview-57","page_id":"/docs/pr-preview/pr-56/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/self-hosted/overview#choose-the-next-page","content":"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />"},"393":{"id":"/docs/pr-preview/pr-56/deployment/self-hosted/overview-58","page_id":"/docs/pr-preview/pr-56/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/self-hosted/overview#choose-the-next-page","content":"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />"},"394":{"id":"/docs/pr-preview/pr-56/deployment/self-hosted/overview-59","page_id":"/docs/pr-preview/pr-56/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/self-hosted/overview#choose-the-next-page","content":"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />"},"395":{"id":"/docs/pr-preview/pr-56/deployment/troubleshooting","page_id":"/docs/pr-preview/pr-56/deployment/troubleshooting","type":"page","content":"Deployment troubleshooting","breadcrumbs":["Docs","Deployment","Operations"],"tags":[],"url":"/docs/pr-preview/pr-56/deployment/troubleshooting"},"396":{"id":"/docs/pr-preview/pr-56/deployment/troubleshooting-0","page_id":"/docs/pr-preview/pr-56/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/troubleshooting","content":"Diagnose access, service health and infrastructure dependencies."},"397":{"id":"/docs/pr-preview/pr-56/deployment/troubleshooting-1","page_id":"/docs/pr-preview/pr-56/deployment/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/deployment/troubleshooting#diagnostic-sequence","content":"Diagnostic sequence"},"398":{"id":"/docs/pr-preview/pr-56/deployment/troubleshooting-2","page_id":"/docs/pr-preview/pr-56/deployment/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/deployment/troubleshooting#reproduce-a-single-operation","content":"Reproduce a single operation"},"399":{"id":"/docs/pr-preview/pr-56/deployment/troubleshooting-3","page_id":"/docs/pr-preview/pr-56/deployment/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/deployment/troubleshooting#separate-client-gateway-and-service","content":"Separate client, Gateway and service"},"400":{"id":"/docs/pr-preview/pr-56/deployment/troubleshooting-4","page_id":"/docs/pr-preview/pr-56/deployment/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/deployment/troubleshooting#review-kubernetes-status","content":"Review Kubernetes status"},"401":{"id":"/docs/pr-preview/pr-56/deployment/troubleshooting-5","page_id":"/docs/pr-preview/pr-56/deployment/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/deployment/troubleshooting#query-the-affected-service","content":"Query the affected service"},"402":{"id":"/docs/pr-preview/pr-56/deployment/troubleshooting-6","page_id":"/docs/pr-preview/pr-56/deployment/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/deployment/troubleshooting#validate-the-result-from-outside","content":"Validate the result from outside"},"403":{"id":"/docs/pr-preview/pr-56/deployment/troubleshooting-7","page_id":"/docs/pr-preview/pr-56/deployment/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/deployment/troubleshooting#minimal-evidence-collection","content":"Minimal evidence collection"},"404":{"id":"/docs/pr-preview/pr-56/deployment/troubleshooting-8","page_id":"/docs/pr-preview/pr-56/deployment/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/deployment/troubleshooting#i-cannot-sign-in","content":"I cannot sign in"},"405":{"id":"/docs/pr-preview/pr-56/deployment/troubleshooting-9","page_id":"/docs/pr-preview/pr-56/deployment/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/deployment/troubleshooting#everything-returns-403-or-5xx","content":"Everything returns 403 or 5xx"},"406":{"id":"/docs/pr-preview/pr-56/deployment/troubleshooting-10","page_id":"/docs/pr-preview/pr-56/deployment/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/deployment/troubleshooting#api-500-errors","content":"API 500 errors"},"407":{"id":"/docs/pr-preview/pr-56/deployment/troubleshooting-11","page_id":"/docs/pr-preview/pr-56/deployment/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/deployment/troubleshooting#a-pod-is-not-ready","content":"A pod is not Ready"},"408":{"id":"/docs/pr-preview/pr-56/deployment/troubleshooting-12","page_id":"/docs/pr-preview/pr-56/deployment/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/deployment/troubleshooting#events-are-not-arriving","content":"Events are not arriving"},"409":{"id":"/docs/pr-preview/pr-56/deployment/troubleshooting-13","page_id":"/docs/pr-preview/pr-56/deployment/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/deployment/troubleshooting#observability","content":"Observability"},"410":{"id":"/docs/pr-preview/pr-56/deployment/troubleshooting-14","page_id":"/docs/pr-preview/pr-56/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/troubleshooting","content":"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics."},"411":{"id":"/docs/pr-preview/pr-56/deployment/troubleshooting-15","page_id":"/docs/pr-preview/pr-56/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/troubleshooting#reproduce-a-single-operation","content":"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion."},"412":{"id":"/docs/pr-preview/pr-56/deployment/troubleshooting-16","page_id":"/docs/pr-preview/pr-56/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/troubleshooting#separate-client-gateway-and-service","content":"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency."},"413":{"id":"/docs/pr-preview/pr-56/deployment/troubleshooting-17","page_id":"/docs/pr-preview/pr-56/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/troubleshooting#review-kubernetes-status","content":"Locate unready pods, restarts, recent events and the state of the release."},"414":{"id":"/docs/pr-preview/pr-56/deployment/troubleshooting-18","page_id":"/docs/pr-preview/pr-56/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/troubleshooting#query-the-affected-service","content":"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine."},"415":{"id":"/docs/pr-preview/pr-56/deployment/troubleshooting-19","page_id":"/docs/pr-preview/pr-56/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/troubleshooting#validate-the-result-from-outside","content":"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses."},"416":{"id":"/docs/pr-preview/pr-56/deployment/troubleshooting-20","page_id":"/docs/pr-preview/pr-56/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/troubleshooting#minimal-evidence-collection","content":"Replace the placeholders with your real release, namespace and deployment."},"417":{"id":"/docs/pr-preview/pr-56/deployment/troubleshooting-21","page_id":"/docs/pr-preview/pr-56/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/troubleshooting#minimal-evidence-collection","content":"Also run the chart's connectivity test:"},"418":{"id":"/docs/pr-preview/pr-56/deployment/troubleshooting-22","page_id":"/docs/pr-preview/pr-56/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/troubleshooting#minimal-evidence-collection","content":"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow."},"419":{"id":"/docs/pr-preview/pr-56/deployment/troubleshooting-23","page_id":"/docs/pr-preview/pr-56/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/troubleshooting#minimal-evidence-collection","content":"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails."},"420":{"id":"/docs/pr-preview/pr-56/deployment/troubleshooting-24","page_id":"/docs/pr-preview/pr-56/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/troubleshooting#i-cannot-sign-in","content":"If you receive a 401:"},"421":{"id":"/docs/pr-preview/pr-56/deployment/troubleshooting-25","page_id":"/docs/pr-preview/pr-56/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/troubleshooting#i-cannot-sign-in","content":"check that the UI's OIDC authority is reachable from the browser;"},"422":{"id":"/docs/pr-preview/pr-56/deployment/troubleshooting-26","page_id":"/docs/pr-preview/pr-56/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/troubleshooting#i-cannot-sign-in","content":"verify issuer, audience and expiration of the token;"},"423":{"id":"/docs/pr-preview/pr-56/deployment/troubleshooting-27","page_id":"/docs/pr-preview/pr-56/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/troubleshooting#i-cannot-sign-in","content":"confirm the Gateway can fetch the keys from the JWKS URI;"},"424":{"id":"/docs/pr-preview/pr-56/deployment/troubleshooting-28","page_id":"/docs/pr-preview/pr-56/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/troubleshooting#i-cannot-sign-in","content":"check that the provider's public and internal routes point to the same realm."},"425":{"id":"/docs/pr-preview/pr-56/deployment/troubleshooting-29","page_id":"/docs/pr-preview/pr-56/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/troubleshooting#i-cannot-sign-in","content":"If login succeeds but the APIs return 403:"},"426":{"id":"/docs/pr-preview/pr-56/deployment/troubleshooting-30","page_id":"/docs/pr-preview/pr-56/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/troubleshooting#i-cannot-sign-in","content":"inspect the token's real claims;"},"427":{"id":"/docs/pr-preview/pr-56/deployment/troubleshooting-31","page_id":"/docs/pr-preview/pr-56/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/troubleshooting#i-cannot-sign-in","content":"confirm they match an active principal;"},"428":{"id":"/docs/pr-preview/pr-56/deployment/troubleshooting-32","page_id":"/docs/pr-preview/pr-56/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/troubleshooting#i-cannot-sign-in","content":"review the policies granted to that principal;"},"429":{"id":"/docs/pr-preview/pr-56/deployment/troubleshooting-33","page_id":"/docs/pr-preview/pr-56/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/troubleshooting#i-cannot-sign-in","content":"verify that authz reaches PostgreSQL and its JWKS."},"430":{"id":"/docs/pr-preview/pr-56/deployment/troubleshooting-34","page_id":"/docs/pr-preview/pr-56/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/troubleshooting#i-cannot-sign-in","content":"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap."},"431":{"id":"/docs/pr-preview/pr-56/deployment/troubleshooting-35","page_id":"/docs/pr-preview/pr-56/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/troubleshooting#everything-returns-403-or-5xx","content":"External authorization fails closed by default. If authz is unavailable, protected routes are blocked."},"432":{"id":"/docs/pr-preview/pr-56/deployment/troubleshooting-36","page_id":"/docs/pr-preview/pr-56/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/troubleshooting#everything-returns-403-or-5xx","content":"Locate the authz pod and Service."},"433":{"id":"/docs/pr-preview/pr-56/deployment/troubleshooting-37","page_id":"/docs/pr-preview/pr-56/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/troubleshooting#everything-returns-403-or-5xx","content":"Check /health, logs and its database connection."},"434":{"id":"/docs/pr-preview/pr-56/deployment/troubleshooting-38","page_id":"/docs/pr-preview/pr-56/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/troubleshooting#everything-returns-403-or-5xx","content":"Verify the DNS and port configured in externalAuthorization."},"435":{"id":"/docs/pr-preview/pr-56/deployment/troubleshooting-39","page_id":"/docs/pr-preview/pr-56/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/troubleshooting#everything-returns-403-or-5xx","content":"Check the check route is /v1/ext\\_authz/check."},"436":{"id":"/docs/pr-preview/pr-56/deployment/troubleshooting-40","page_id":"/docs/pr-preview/pr-56/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/troubleshooting#everything-returns-403-or-5xx","content":"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage."},"437":{"id":"/docs/pr-preview/pr-56/deployment/troubleshooting-41","page_id":"/docs/pr-preview/pr-56/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/troubleshooting#api-500-errors","content":"A 500 indicates an internal failure, such as an unavailable database. The `{\"err\": ...}` body currently includes the text of the internal error, which can contain schema, table and constraint names and, on connection failures, the database host and user (not the password). Find the cause in the service log using the request time, and do not forward the body to third parties or show it to end users. This is a known information-disclosure defect: generic messages are planned for 500 responses, keeping the detail only in the service log (tracked in lamassuiot#814). The authorization connector also returns the internal error, in the `details.error` field. Some request errors, such as a key size the engine does not support, are also returned as 500."},"438":{"id":"/docs/pr-preview/pr-56/deployment/troubleshooting-42","page_id":"/docs/pr-preview/pr-56/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/troubleshooting#a-pod-is-not-ready","content":"Review kubectl describe pod first. Common causes are:"},"439":{"id":"/docs/pr-preview/pr-56/deployment/troubleshooting-43","page_id":"/docs/pr-preview/pr-56/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/troubleshooting#a-pod-is-not-ready","content":"wrong credentials or DNS for PostgreSQL or RabbitMQ;"},"440":{"id":"/docs/pr-preview/pr-56/deployment/troubleshooting-44","page_id":"/docs/pr-preview/pr-56/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/troubleshooting#a-pod-is-not-ready","content":"a missing AMQP CA or client certificate Secret referenced by `amqp.ca.secretName` or `amqp.client.secretName`;"},"441":{"id":"/docs/pr-preview/pr-56/deployment/troubleshooting-45","page_id":"/docs/pr-preview/pr-56/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/troubleshooting#a-pod-is-not-ready","content":"unbound persistent volume;"},"442":{"id":"/docs/pr-preview/pr-56/deployment/troubleshooting-46","page_id":"/docs/pr-preview/pr-56/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/troubleshooting#a-pod-is-not-ready","content":"inaccessible image or incorrect pull policy;"},"443":{"id":"/docs/pr-preview/pr-56/deployment/troubleshooting-47","page_id":"/docs/pr-preview/pr-56/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/troubleshooting#a-pod-is-not-ready","content":"invalid cryptographic engine configuration;"},"444":{"id":"/docs/pr-preview/pr-56/deployment/troubleshooting-48","page_id":"/docs/pr-preview/pr-56/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/troubleshooting#a-pod-is-not-ready","content":"CPU or memory limits set too low;"},"445":{"id":"/docs/pr-preview/pr-56/deployment/troubleshooting-49","page_id":"/docs/pr-preview/pr-56/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/troubleshooting#a-pod-is-not-ready","content":"an incomplete prior migration."},"446":{"id":"/docs/pr-preview/pr-56/deployment/troubleshooting-50","page_id":"/docs/pr-preview/pr-56/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/troubleshooting#a-pod-is-not-ready","content":"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups."},"447":{"id":"/docs/pr-preview/pr-56/deployment/troubleshooting-51","page_id":"/docs/pr-preview/pr-56/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/troubleshooting#a-pod-is-not-ready","content":"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling."},"448":{"id":"/docs/pr-preview/pr-56/deployment/troubleshooting-52","page_id":"/docs/pr-preview/pr-56/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/troubleshooting#a-pod-is-not-ready","content":"Internal calls now fail fast instead of hanging for the clients covered by Egress proxy: connection attempts time out after 30 seconds and TLS handshakes after 10 seconds. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call. If an egress proxy handles the cluster's outbound traffic, check the pod's `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables and list in-cluster service names in `NO_PROXY`."},"449":{"id":"/docs/pr-preview/pr-56/deployment/troubleshooting-53","page_id":"/docs/pr-preview/pr-56/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/troubleshooting#events-are-not-arriving","content":"Domain and audit events depend on the bus publisher:"},"450":{"id":"/docs/pr-preview/pr-56/deployment/troubleshooting-54","page_id":"/docs/pr-preview/pr-56/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/troubleshooting#events-are-not-arriving","content":"verify it is enabled in the emitting service;"},"451":{"id":"/docs/pr-preview/pr-56/deployment/troubleshooting-55","page_id":"/docs/pr-preview/pr-56/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/troubleshooting#events-are-not-arriving","content":"check AMQP connectivity and credentials;"},"452":{"id":"/docs/pr-preview/pr-56/deployment/troubleshooting-56","page_id":"/docs/pr-preview/pr-56/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/troubleshooting#events-are-not-arriving","content":"review exchange, routing key, queues and consumers;"},"453":{"id":"/docs/pr-preview/pr-56/deployment/troubleshooting-57","page_id":"/docs/pr-preview/pr-56/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/troubleshooting#events-are-not-arriving","content":"inspect dead-letter queues;"},"454":{"id":"/docs/pr-preview/pr-56/deployment/troubleshooting-58","page_id":"/docs/pr-preview/pr-56/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/troubleshooting#events-are-not-arriving","content":"alert on orphan durable queues and backlog growth."},"455":{"id":"/docs/pr-preview/pr-56/deployment/troubleshooting-59","page_id":"/docs/pr-preview/pr-56/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/troubleshooting#events-are-not-arriving","content":"If `amqp.tls` is enabled, verify the TLS side as well:"},"456":{"id":"/docs/pr-preview/pr-56/deployment/troubleshooting-60","page_id":"/docs/pr-preview/pr-56/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/troubleshooting#events-are-not-arriving","content":"confirm the broker listener speaks AMQPS on the configured port — the default port stays `5672` and does not follow TLS automatically;"},"457":{"id":"/docs/pr-preview/pr-56/deployment/troubleshooting-61","page_id":"/docs/pr-preview/pr-56/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/troubleshooting#events-are-not-arriving","content":"if you set `amqp.ca.secretName`, confirm the Secret exists in the release namespace and its data key matches `amqp.ca.certificateKey` (default `ca.crt`); if `amqp.ca.secretName` is not set, the clients trust the system CAs;"},"458":{"id":"/docs/pr-preview/pr-56/deployment/troubleshooting-62","page_id":"/docs/pr-preview/pr-56/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/troubleshooting#events-are-not-arriving","content":"remember that a missing referenced Secret prevents the consuming pods from starting;"},"459":{"id":"/docs/pr-preview/pr-56/deployment/troubleshooting-63","page_id":"/docs/pr-preview/pr-56/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/troubleshooting#events-are-not-arriving","content":"after updating the CA or client certificate Secret, restart the consuming pods: the AMQP client loads certificates at startup."},"460":{"id":"/docs/pr-preview/pr-56/deployment/troubleshooting-64","page_id":"/docs/pr-preview/pr-56/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/troubleshooting#events-are-not-arriving","content":"See AMQP TLS (AMQPS) for the full configuration."},"461":{"id":"/docs/pr-preview/pr-56/deployment/troubleshooting-65","page_id":"/docs/pr-preview/pr-56/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/troubleshooting#events-are-not-arriving","content":"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs."},"462":{"id":"/docs/pr-preview/pr-56/deployment/troubleshooting-66","page_id":"/docs/pr-preview/pr-56/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/troubleshooting#observability","content":"The chart can enable OpenTelemetry instrumentation for the services that support it, including authz; it does not configure OpenTelemetry for AWS Connector, wfx or the UI. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, service and dependency."},"463":{"id":"/docs/pr-preview/pr-56/deployment/troubleshooting-67","page_id":"/docs/pr-preview/pr-56/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/troubleshooting#observability","content":"Before closing an incident, record:"},"464":{"id":"/docs/pr-preview/pr-56/deployment/troubleshooting-68","page_id":"/docs/pr-preview/pr-56/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/troubleshooting#observability","content":"the confirmed cause;"},"465":{"id":"/docs/pr-preview/pr-56/deployment/troubleshooting-69","page_id":"/docs/pr-preview/pr-56/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/troubleshooting#observability","content":"the time scope and affected resources;"},"466":{"id":"/docs/pr-preview/pr-56/deployment/troubleshooting-70","page_id":"/docs/pr-preview/pr-56/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/troubleshooting#observability","content":"the commands or queries used;"},"467":{"id":"/docs/pr-preview/pr-56/deployment/troubleshooting-71","page_id":"/docs/pr-preview/pr-56/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/troubleshooting#observability","content":"the applied change and how to revert it;"},"468":{"id":"/docs/pr-preview/pr-56/deployment/troubleshooting-72","page_id":"/docs/pr-preview/pr-56/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/troubleshooting#observability","content":"validation from a consumer;"},"469":{"id":"/docs/pr-preview/pr-56/deployment/troubleshooting-73","page_id":"/docs/pr-preview/pr-56/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/deployment/troubleshooting#observability","content":"the preventive action and its owner."},"470":{"id":"/docs/pr-preview/pr-56/platform/administration/access-control","page_id":"/docs/pr-preview/pr-56/platform/administration/access-control","type":"page","content":"Access control","breadcrumbs":["Docs","Platform","Administration"],"tags":[],"url":"/docs/pr-preview/pr-56/platform/administration/access-control"},"471":{"id":"/docs/pr-preview/pr-56/platform/administration/access-control-0","page_id":"/docs/pr-preview/pr-56/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-56/platform/administration/access-control","content":"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization."},"472":{"id":"/docs/pr-preview/pr-56/platform/administration/access-control-1","page_id":"/docs/pr-preview/pr-56/platform/administration/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/administration/access-control#essential-concepts","content":"Essential concepts"},"473":{"id":"/docs/pr-preview/pr-56/platform/administration/access-control-2","page_id":"/docs/pr-preview/pr-56/platform/administration/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/administration/access-control#two-decision-systems","content":"Two decision systems"},"474":{"id":"/docs/pr-preview/pr-56/platform/administration/access-control-3","page_id":"/docs/pr-preview/pr-56/platform/administration/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/administration/access-control#integrated-or-external-http-services","content":"Integrated or external HTTP services"},"475":{"id":"/docs/pr-preview/pr-56/platform/administration/access-control-4","page_id":"/docs/pr-preview/pr-56/platform/administration/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","content":"Authentication-only routes and unmapped paths"},"476":{"id":"/docs/pr-preview/pr-56/platform/administration/access-control-5","page_id":"/docs/pr-preview/pr-56/platform/administration/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-56/platform/administration/access-control#services-developed-by-lamassu","content":"Services developed by Lamassu"}