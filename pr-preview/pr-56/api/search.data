5,"_42174":15,"_5":21817,"_5797":77246,"_42654":77247,"_29767":77251,"_28235":15},"Deploy from AWS Marketplace",[77248,77249,77250],"Docs","Deployment","Other models",[],{"_6892":16,"_42174":15,"_29767":77253,"_5":21387,"_28235":15,"_5797":77254},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_6892":17,"_42174":15,"_5":42651,"_29767":77256,"_28235":77257,"_5797":77258},[],"/docs/pr-preview/pr-56/deployment/aws-marketplace#before-you-begin","Before you begin",{"_6892":18,"_42174":15,"_5":42651,"_29767":77260,"_28235":77261,"_5797":77262},[],"/docs/pr-preview/pr-56/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_6892":19,"_42174":15,"_5":42651,"_29767":77264,"_28235":77265,"_5797":77266},[],"/docs/pr-preview/pr-56/deployment/aws-marketplace#open-the-offer","Open the offer",{"_6892":20,"_42174":15,"_5":42651,"_29767":77268,"_28235":77269,"_5797":77270},[],"/docs/pr-preview/pr-56/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_6892":21,"_42174":15,"_5":42651,"_29767":77272,"_28235":77273,"_5797":77274},[],"/docs/pr-preview/pr-56/deployment/aws-marketplace#limit-network-access","Limit network access",{"_6892":22,"_42174":15,"_5":42651,"_29767":77276,"_28235":77277,"_5797":77278},[],"/docs/pr-preview/pr-56/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_6892":23,"_42174":15,"_5":42651,"_29767":77280,"_28235":77281,"_5797":77282},[],"/docs/pr-preview/pr-56/deployment/aws-marketplace#next-step","Next step",{"_6892":24,"_42174":15,"_29767":77284,"_5":21387,"_28235":15,"_5797":77285},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_6892":25,"_42174":15,"_29767":77287,"_5":21387,"_28235":77257,"_5797":77288},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_6892":26,"_42174":15,"_29767":77290,"_5":21387,"_28235":77257,"_5797":77291},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_6892":27,"_42174":15,"_29767":77293,"_5":21387,"_28235":77257,"_5797":77294},[],"A security group allowing the necessary endpoints.",{"_6892":28,"_42174":15,"_29767":77296,"_5":21387,"_28235":77261,"_5797":77297},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_6892":29,"_42174":15,"_29767":77299,"_5":21387,"_28235":77261,"_5797":77300},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_6892":30,"_42174":15,"_29767":77302,"_5":21387,"_28235":77261,"_5797":77303},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_6892":31,"_42174":15,"_29767":77305,"_5":21387,"_28235":77265,"_5797":77306},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_6892":32,"_42174":15,"_29767":77308,"_5":21387,"_28235":77269,"_5797":77309},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_6892":33,"_42174":15,"_29767":77311,"_5":21387,"_28235":77273,"_5797":77312},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_6892":34,"_42174":15,"_29767":77314,"_5":21387,"_28235":77277,"_5797":77315},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_6892":35,"_42174":15,"_29767":77317,"_5":21387,"_28235":77281,"_5797":77318},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_6892":36,"_42174":36,"_5":21817,"_5797":77320,"_42654":77321,"_29767":77322,"_28235":36},"Deploy Lamassu",[77248,77249],[],{"_6892":37,"_42174":36,"_29767":77324,"_5":21387,"_28235":36,"_5797":77325},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_6892":38,"_42174":36,"_5":42651,"_29767":77327,"_28235":77328,"_5797":77329},[],"/docs/pr-preview/pr-56/deployment/overview#choose-a-model","Choose a model",{"_6892":39,"_42174":36,"_5":42651,"_29767":77331,"_28235":77332,"_5797":77333},[],"/docs/pr-preview/pr-56/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_6892":40,"_42174":36,"_5":42651,"_29767":77335,"_28235":77336,"_5797":77337},[],"/docs/pr-preview/pr-56/deployment/overview#after-deployment","After deployment",{"_6892":41,"_42174":36,"_29767":77339,"_5":21387,"_28235":36,"_5797":77340},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_6892":42,"_42174":36,"_29767":77342,"_5":21387,"_28235":77328,"_5797":77343},[],"Model",{"_6892":43,"_42174":36,"_29767":77345,"_5":21387,"_28235":77328,"_5797":77346},[],"Recommended for",{"_6892":44,"_42174":36,"_29767":77348,"_5":21387,"_28235":77328,"_5797":77349},[],"Who operates the infrastructure",{"_6892":45,"_42174":36,"_29767":77351,"_5":21387,"_28235":77328,"_5797":77352},[],"Starting point",{"_6892":46,"_42174":36,"_29767":77354,"_5":21387,"_28235":77328,"_5797":77355},[],"Kubernetes self-managed",{"_6892":47,"_42174":36,"_29767":77357,"_5":21387,"_28235":77328,"_5797":77358},[],"Production, regulated environments and custom deployments",{"_6892":48,"_42174":36,"_29767":77360,"_5":21387,"_28235":77328,"_5797":77361},[],"Your team",{"_6892":49,"_42174":36,"_29767":77363,"_5":21387,"_28235":77328,"_5797":77364},[],"Helm or Fastlane",{"_6892":50,"_42174":36,"_29767":77366,"_5":21387,"_28235":77328,"_5797":77367},[],"AWS Marketplace",{"_6892":51,"_42174":36,"_29767":77369,"_5":21387,"_28235":77328,"_5797":77370},[],"Evaluation or a dedicated deployment inside an AWS account",{"_6892":52,"_42174":36,"_29767":77372,"_5":21387,"_28235":77328,"_5797":77361},[],{"_6892":53,"_42174":36,"_29767":77374,"_5":21387,"_28235":77328,"_5797":77375},[],"Preconfigured image on EC2",{"_6892":54,"_42174":36,"_29767":77377,"_5":21387,"_28235":77328,"_5797":77378},[],"SaaS",{"_6892":55,"_42174":36,"_29767":77380,"_5":21387,"_28235":77328,"_5797":77381},[],"Teams that want to use the platform without operating it",{"_6892":56,"_42174":36,"_29767":77383,"_5":21387,"_28235":77328,"_5797":77384},[],"Lamassu",{"_6892":57,"_42174":36,"_29767":77386,"_5":21387,"_28235":77328,"_5797":77387},[],"Managed subscription",{"_6892":58,"_42174":36,"_29767":77389,"_5":21387,"_28235":77328,"_5797":77390},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_6892":59,"_42174":36,"_29767":77392,"_5":21387,"_28235":77328,"_5797":77393},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_6892":60,"_42174":36,"_29767":77395,"_5":21387,"_28235":77328,"_5797":77396},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_6892":61,"_42174":36,"_29767":77398,"_5":21387,"_28235":77332,"_5797":77399},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_6892":62,"_42174":36,"_29767":77401,"_5":21387,"_28235":77336,"_5797":77402},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_6892":63,"_42174":63,"_5":21817,"_5797":77404,"_42654":77405,"_29767":77406,"_28235":63},"Use Lamassu as SaaS",[77248,77249,77250],[],{"_6892":64,"_42174":63,"_29767":77408,"_5":21387,"_28235":63,"_5797":77409},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_6892":65,"_42174":63,"_5":42651,"_29767":77411,"_28235":77412,"_5797":77413},[],"/docs/pr-preview/pr-56/deployment/saas#what-the-service-manages","What the service manages",{"_6892":66,"_42174":63,"_5":42651,"_29767":77415,"_28235":77416,"_5797":77417},[],"/docs/pr-preview/pr-56/deployment/saas#plans","Plans",{"_6892":67,"_42174":63,"_5":42651,"_29767":77419,"_28235":77420,"_5797":77421},[],"/docs/pr-preview/pr-56/deployment/saas#request-access","Request access",{"_6892":68,"_42174":63,"_29767":77423,"_5":21387,"_28235":63,"_5797":77424},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_6892":69,"_42174":63,"_29767":77426,"_5":21387,"_28235":77412,"_5797":77427},[],"Platform availability and maintenance.",{"_6892":70,"_42174":63,"_29767":77429,"_5":21387,"_28235":77412,"_5797":77430},[],"Automatic backups.",{"_6892":71,"_42174":63,"_29767":77432,"_5":21387,"_28235":77412,"_5797":77433},[],"Version upgrades.",{"_6892":72,"_42174":63,"_29767":77435,"_5":21387,"_28235":77412,"_5797":77436},[],"Technical support and SLA according to your plan.",{"_6892":73,"_42174":63,"_29767":77438,"_5":21387,"_28235":77416,"_5797":77439},[],"Plan",{"_6892":74,"_42174":63,"_29767":77441,"_5":21387,"_28235":77416,"_5797":77442},[],"Devices",{"_6892":75,"_42174":63,"_29767":77444,"_5":21387,"_28235":77416,"_5797":77445},[],"Support",{"_6892":76,"_42174":63,"_29767":77447,"_5":21387,"_28235":77416,"_5797":77448},[],"SLA",{"_6892":77,"_42174":63,"_29767":77450,"_5":21387,"_28235":77416,"_5797":77451},[],"Starter",{"_6892":78,"_42174":63,"_29767":77453,"_5":21387,"_28235":77416,"_5797":77454},[],"Up to 1,000",{"_6892":79,"_42174":63,"_29767":77456,"_5":21387,"_28235":77416,"_5797":77457},[],"Email",{"_6892":80,"_42174":63,"_29767":77459,"_5":21387,"_28235":77416,"_5797":77460},[],"99.5 %",{"_6892":81,"_42174":63,"_29767":77462,"_5":21387,"_28235":77416,"_5797":77463},[],"Professional",{"_6892":82,"_42174":63,"_29767":77465,"_5":21387,"_28235":77416,"_5797":77466},[],"Up to 10,000",{"_6892":83,"_42174":63,"_29767":77468,"_5":21387,"_28235":77416,"_5797":77469},[],"Email and chat",{"_6892":84,"_42174":63,"_29767":77471,"_5":21387,"_28235":77416,"_5797":77472},[],"99.9 %",{"_6892":85,"_42174":63,"_29767":77474,"_5":21387,"_28235":77416,"_5797":77475},[],"Enterprise",{"_6892":86,"_42174":63,"_29767":77477,"_5":21387,"_28235":77416,"_5797":77478},[],"Unlimited",{"_6892":87,"_42174":63,"_29767":77480,"_5":21387,"_28235":77416,"_5797":77481},[],"Dedicated",{"_6892":88,"_42174":63,"_29767":77483,"_5":21387,"_28235":77416,"_5797":77484},[],"99.99 %",{"_6892":89,"_42174":63,"_29767":77486,"_5":21387,"_28235":77420,"_5797":77487},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_6892":90,"_42174":63,"_29767":77489,"_5":21387,"_28235":77420,"_5797":77490},[],"When you receive your instance's credentials, continue with Get started.",{"_6892":91,"_42174":91,"_5":21817,"_5797":77492,"_42654":77493,"_29767":77494,"_28235":91},"Fastlane",[77248,77249,77355],[],{"_6892":92,"_42174":91,"_29767":77496,"_5":21387,"_28235":91,"_5797":77497},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_6892":93,"_42174":91,"_5":42651,"_29767":77499,"_28235":77500,"_5797":77501},[],"/docs/pr-preview/pr-56/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_6892":94,"_42174":91,"_5":42651,"_29767":77503,"_28235":77504,"_5797":77505},[],"/docs/pr-preview/pr-56/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_6892":95,"_42174":91,"_5":42651,"_29767":77507,"_28235":77508,"_5797":77258},[],"/docs/pr-preview/pr-56/deployment/self-hosted/fastlane#before-you-begin",{"_6892":96,"_42174":91,"_5":42651,"_29767":77510,"_28235":77511,"_5797":77512},[],"/docs/pr-preview/pr-56/deployment/self-hosted/fastlane#quick-start","Quick start",{"_6892":97,"_42174":91,"_5":42651,"_29767":77514,"_28235":77515,"_5797":77516},[],"/docs/pr-preview/pr-56/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_6892":98,"_42174":91,"_5":42651,"_29767":77518,"_28235":77519,"_5797":77520},[],"/docs/pr-preview/pr-56/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_6892":99,"_42174":91,"_5":42651,"_29767":77522,"_28235":77523,"_5797":77524},[],"/docs/pr-preview/pr-56/deployment/self-hosted/fastlane#development-mode","Development mode",{"_6892":100,"_42174":91,"_5":42651,"_29767":77526,"_28235":77527,"_5797":77528},[],"/docs/pr-preview/pr-56/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_6892":101,"_42174":91,"_5":42651,"_29767":77530,"_28235":77531,"_5797":77532},[],"/docs/pr-preview/pr-56/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_6892":102,"_42174":91,"_5":42651,"_29767":77534,"_28235":77535,"_5797":77536},[],"/docs/pr-preview/pr-56/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_6892":103,"_42174":91,"_5":42651,"_29767":77538,"_28235":77539,"_5797":77540},[],"/docs/pr-preview/pr-56/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_6892":104,"_42174":91,"_29767":77542,"_5":21387,"_28235":77500,"_5797":77543},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_6892":105,"_42174":91,"_29767":77545,"_5":21387,"_28235":77500,"_5797":77546},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_6892":106,"_42174":91,"_29767":77548,"_5":21387,"_28235":77504,"_5797":77549},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_6892":107,"_42174":91,"_29767":77551,"_5":21387,"_28235":77504,"_5797":77552},[],"Fastlane installs or configures",{"_6892":108,"_42174":91,"_29767":77554,"_5":21387,"_28235":77504,"_5797":77555},[],"You still provide",{"_6892":109,"_42174":91,"_29767":77557,"_5":21387,"_28235":77504,"_5797":77558},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_6892":110,"_42174":91,"_29767":77560,"_5":21387,"_28235":77504,"_5797":77561},[],"The Kubernetes cluster, nodes and persistent storage",{"_6892":111,"_42174":91,"_29767":77563,"_5":21387,"_28235":77504,"_5797":77564},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_6892":112,"_42174":91,"_29767":77566,"_5":21387,"_28235":77504,"_5797":77567},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_6892":113,"_42174":91,"_29767":77569,"_5":21387,"_28235":77504,"_5797":77570},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_6892":114,"_42174":91,"_29767":77572,"_5":21387,"_28235":77504,"_5797":77573},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_6892":115,"_42174":91,"_29767":77575,"_5":21387,"_28235":77504,"_5797":77576},[],"Optional observability and lab HSM components",{"_6892":116,"_42174":91,"_29767":77578,"_5":21387,"_28235":77504,"_5797":77579},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_6892":117,"_42174":91,"_29767":77581,"_5":21387,"_28235":77504,"_5797":77582},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_6892":118,"_42174":91,"_29767":77584,"_5":21387,"_28235":77508,"_5797":77585},[],"You need:",{"_6892":119,"_42174":91,"_29767":77587,"_5":21387,"_28235":77508,"_5797":77588},[],"an existing Kubernetes cluster",{"_6892":120,"_42174":91,"_29767":77590,"_5":21387,"_28235":77508,"_5797":77591},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_6892":121,"_42174":91,"_29767":77593,"_5":21387,"_28235":77508,"_5797":77594},[],"`yq`",{"_6892":122,"_42174":91,"_29767":77596,"_5":21387,"_28235":77508,"_5797":33016},[],{"_6892":123,"_42174":91,"_29767":77598,"_5":21387,"_28235":77508,"_5797":77599},[],"`jq` only when using `--sample-data` or `--development`",{"_6892":124,"_42174":91,"_29767":77601,"_5":21387,"_28235":77508,"_5797":77602},[],"`ssh-keygen` only when using `--with-hsm`",{"_6892":125,"_42174":91,"_29767":77604,"_5":21387,"_28235":77508,"_5797":77605},[],"free external ports 80 and 443 on a single-node K3s host",{"_6892":126,"_42174":91,"_29767":77607,"_5":21387,"_28235":77508,"_5797":77608},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_6892":127,"_42174":91,"_29767":77610,"_5":21387,"_28235":77508,"_5797":77611},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_6892":128,"_42174":91,"_29767":77613,"_5":21387,"_28235":77511,"_5797":77614},[],"Run the script from a clone of the Helm repository:",{"_6892":129,"_42174":91,"_29767":77616,"_5":21387,"_28235":77511,"_5797":77617},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_6892":130,"_42174":91,"_29767":77619,"_5":21387,"_28235":77515,"_5797":77620},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_6892":131,"_42174":91,"_29767":77622,"_5":21387,"_28235":77515,"_5797":77623},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_6892":132,"_42174":91,"_29767":77625,"_5":21387,"_28235":77515,"_5797":77626},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_6892":133,"_42174":91,"_29767":77628,"_5":21387,"_28235":77515,"_5797":77629},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_6892":134,"_42174":91,"_29767":77631,"_5":21387,"_28235":77519,"_5797":77632},[],"Option",{"_6892":135,"_42174":91,"_29767":77634,"_5":21387,"_28235":77519,"_5797":77635},[],"Default",{"_6892":136,"_42174":91,"_29767":77637,"_5":21387,"_28235":77519,"_5797":77638},[],"Purpose",{"_6892":137,"_42174":91,"_29767":77640,"_5":21387,"_28235":77519,"_5797":77641},[],"`-h`, `--help`",{"_6892":138,"_42174":91,"_29767":77643,"_5":21387,"_28235":77519,"_5797":77644},[],"—",{"_6892":139,"_42174":91,"_29767":77646,"_5":21387,"_28235":77519,"_5797":77647},[],"Show help",{"_6892":140,"_42174":91,"_29767":77649,"_5":21387,"_28235":77519,"_5797":77650},[],"`-c`, `--context`",{"_6892":141,"_42174":91,"_29767":77652,"_5":21387,"_28235":77519,"_5797":77653},[],"current context",{"_6892":142,"_42174":91,"_29767":77655,"_5":21387,"_28235":77519,"_5797":77656},[],"Select the kubeconfig context for kubectl and Helm",{"_6892":143,"_42174":91,"_29767":77658,"_5":21387,"_28235":77519,"_5797":77659},[],"`-n`, `--non-interactive`",{"_6892":144,"_42174":91,"_29767":77661,"_5":21387,"_28235":77519,"_5797":11300},[],{"_6892":145,"_42174":91,"_29767":77663,"_5":21387,"_28235":77519,"_5797":77664},[],"Skip prompts and generate dependency credentials",{"_6892":146,"_42174":91,"_29767":77666,"_5":21387,"_28235":77519,"_5797":77667},[],"`-ns`, `--namespace`",{"_6892":147,"_42174":91,"_29767":77669,"_5":21387,"_28235":77519,"_5797":77670},[],"`lamassu-dev`",{"_6892":148,"_42174":91,"_29767":77672,"_5":21387,"_28235":77519,"_5797":77673},[],"Namespace for the installation",{"_6892":149,"_42174":91,"_29767":77675,"_5":21387,"_28235":77519,"_5797":77676},[],"`-d`, `--domain`",{"_6892":150,"_42174":91,"_29767":77678,"_5":21387,"_28235":77519,"_5797":77679},[],"`dev.lamassu.io`",{"_6892":151,"_42174":91,"_29767":77681,"_5":21387,"_28235":77519,"_5797":77682},[],"Domain used by the UI, OIDC and certificate",{"_6892":152,"_42174":91,"_29767":77684,"_5":21387,"_28235":77519,"_5797":77685},[],"`-v`, `--version`",{"_6892":153,"_42174":91,"_29767":77687,"_5":21387,"_28235":77519,"_5797":22457},[],{"_6892":154,"_42174":91,"_29767":77689,"_5":21387,"_28235":77519,"_5797":77690},[],"Lamassu chart version",{"_6892":155,"_42174":91,"_29767":77692,"_5":21387,"_28235":77519,"_5797":77693},[],"`--https-port`",{"_6892":156,"_42174":91,"_29767":77695,"_5":21387,"_28235":77519,"_5797":77696},[],"`443`",{"_6892":157,"_42174":91,"_29767":77698,"_5":21387,"_28235":77519,"_5797":77699},[],"Gateway HTTPS listener port",{"_6892":158,"_42174":91,"_29767":77701,"_5":21387,"_28235":77519,"_5797":77702},[],"`--http-port`",{"_6892":159,"_42174":91,"_29767":77704,"_5":21387,"_28235":77519,"_5797":77705},[],"`80`",{"_6892":160,"_42174":91,"_29767":77707,"_5":21387,"_28235":77519,"_5797":77708},[],"Gateway HTTP listener port",{"_6892":161,"_42174":91,"_29767":77710,"_5":21387,"_28235":77519,"_5797":77711},[],"`--tls-crt`",{"_6892":162,"_42174":91,"_29767":77713,"_5":21387,"_28235":77519,"_5797":77644},[],{"_6892":163,"_42174":91,"_29767":77715,"_5":21387,"_28235":77519,"_5797":77716},[],"PEM certificate for downstream TLS",{"_6892":164,"_42174":91,"_29767":77718,"_5":21387,"_28235":77519,"_5797":77719},[],"`--tls-key`",{"_6892":165,"_42174":91,"_29767":77721,"_5":21387,"_28235":77519,"_5797":77644},[],{"_6892":166,"_42174":91,"_29767":77723,"_5":21387,"_28235":77519,"_5797":77724},[],"PEM private key for downstream TLS",{"_6892":167,"_42174":91,"_29767":77726,"_5":21387,"_28235":77519,"_5797":77727},[],"`-l`, `--local-chart-path`",{"_6892":168,"_42174":91,"_29767":77729,"_5":21387,"_28235":77519,"_5797":77730},[],"repository chart",{"_6892":169,"_42174":91,"_29767":77732,"_5":21387,"_28235":77519,"_5797":77733},[],"Use an unpacked local Lamassu chart",{"_6892":170,"_42174":91,"_29767":77735,"_5":21387,"_28235":77519,"_5797":77736},[],"`-ip`, `--gateway-ip`",{"_6892":171,"_42174":91,"_29767":77738,"_5":21387,"_28235":77519,"_5797":14229},[],{"_6892":172,"_42174":91,"_29767":77740,"_5":21387,"_28235":77519,"_5797":77741},[],"Override the address written to `gateway.addresses`",{"_6892":173,"_42174":91,"_29767":77743,"_5":21387,"_28235":77519,"_5797":77744},[],"`--otel`",{"_6892":174,"_42174":91,"_29767":77746,"_5":21387,"_28235":77519,"_5797":11300},[],{"_6892":175,"_42174":91,"_29767":77748,"_5":21387,"_28235":77519,"_5797":77749},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_6892":176,"_42174":91,"_29767":77751,"_5":21387,"_28235":77519,"_5797":77752},[],"`--development`",{"_6892":177,"_42174":91,"_29767":77754,"_5":21387,"_28235":77519,"_5797":11300},[],{"_6892":178,"_42174":91,"_29767":77756,"_5":21387,"_28235":77519,"_5797":77757},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_6892":179,"_42174":91,"_29767":77759,"_5":21387,"_28235":77519,"_5797":77760},[],"`--sample-data`",{"_6892":180,"_42174":91,"_29767":77762,"_5":21387,"_28235":77519,"_5797":11300},[],{"_6892":181,"_42174":91,"_29767":77764,"_5":21387,"_28235":77519,"_5797":77765},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_6892":182,"_42174":91,"_29767":77767,"_5":21387,"_28235":77519,"_5797":77768},[],"`--with-hsm`",{"_6892":183,"_42174":91,"_29767":77770,"_5":21387,"_28235":77519,"_5797":11300},[],{"_6892":184,"_42174":91,"_29767":77772,"_5":21387,"_28235":77519,"_5797":77773},[],"Install lab HSM components and configure KMS for PKCS#11",{"_6892":185,"_42174":91,"_29767":77775,"_5":21387,"_28235":77519,"_5797":77776},[],"`--softhsm-chart-path`",{"_6892":186,"_42174":91,"_29767":77778,"_5":21387,"_28235":77519,"_5797":77779},[],"`./charts/softhsm`",{"_6892":187,"_42174":91,"_29767":77781,"_5":21387,"_28235":77519,"_5797":77782},[],"Use a different local SoftHSM chart",{"_6892":188,"_42174":91,"_29767":77784,"_5":21387,"_28235":77519,"_5797":77785},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_6892":189,"_42174":91,"_29767":77787,"_5":21387,"_28235":77523,"_5797":77788},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_6892":190,"_42174":91,"_29767":77790,"_5":21387,"_28235":77523,"_5797":77791},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_6892":191,"_42174":91,"_29767":77793,"_5":21387,"_28235":77523,"_5797":77794},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_6892":192,"_42174":91,"_29767":77796,"_5":21387,"_28235":77523,"_5797":77797},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_6892":193,"_42174":91,"_29767":77799,"_5":21387,"_28235":77523,"_5797":77800},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_6892":194,"_42174":91,"_29767":77802,"_5":21387,"_28235":77523,"_5797":77803},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_6892":195,"_42174":91,"_29767":77805,"_5":21387,"_28235":77527,"_5797":77806},[],"Fastlane:",{"_6892":196,"_42174":91,"_29767":77808,"_5":21387,"_28235":77527,"_5797":77809},[],"validates local tools and the selected cluster",{"_6892":197,"_42174":91,"_29767":77811,"_5":21387,"_28235":77527,"_5797":77812},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_6892":198,"_42174":91,"_29767":77814,"_5":21387,"_28235":77527,"_5797":77815},[],"creates the namespace",{"_6892":199,"_42174":91,"_29767":77817,"_5":21387,"_28235":77527,"_5797":77818},[],"installs PostgreSQL and creates the required databases",{"_6892":200,"_42174":91,"_29767":77820,"_5":21387,"_28235":77527,"_5797":77821},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_6892":201,"_42174":91,"_29767":77823,"_5":21387,"_28235":77527,"_5797":77824},[],"installs RabbitMQ",{"_6892":202,"_42174":91,"_29767":77826,"_5":21387,"_28235":77527,"_5797":77827},[],"optionally installs observability and lab HSM components",{"_6892":203,"_42174":91,"_29767":77829,"_5":21387,"_28235":77527,"_5797":77830},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_6892":204,"_42174":91,"_29767":77832,"_5":21387,"_28235":77527,"_5797":77833},[],"optionally loads sample data",{"_6892":205,"_42174":91,"_29767":77835,"_5":21387,"_28235":77527,"_5797":77836},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_6892":206,"_42174":91,"_29767":77838,"_5":21387,"_28235":77531,"_5797":77839},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_6892":207,"_42174":91,"_29767":77841,"_5":21387,"_28235":77531,"_5797":77842},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_6892":208,"_42174":91,"_29767":77844,"_5":21387,"_28235":77535,"_5797":77845},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_6892":209,"_42174":91,"_29767":77847,"_5":21387,"_28235":77535,"_5797":77848},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_6892":210,"_42174":91,"_29767":77850,"_5":21387,"_28235":77535,"_5797":77851},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_6892":211,"_42174":91,"_29767":77853,"_5":21387,"_28235":77539,"_5797":77854},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_6892":212,"_42174":212,"_5":21817,"_5797":77856,"_42654":77857,"_29767":77858,"_28235":212},"Install with Helm",[77248,77249,77355],[],{"_6892":213,"_42174":212,"_29767":77860,"_5":21387,"_28235":212,"_5797":77861},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_6892":214,"_42174":212,"_5":42651,"_29767":77863,"_28235":77864,"_5797":77865},[],"/docs/pr-preview/pr-56/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_6892":215,"_42174":212,"_5":42651,"_29767":77867,"_28235":77868,"_5797":77258},[],"/docs/pr-preview/pr-56/deployment/self-hosted/helm#before-you-begin",{"_6892":216,"_42174":212,"_5":42651,"_29767":77870,"_28235":77871,"_5797":77872},[],"/docs/pr-preview/pr-56/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_6892":217,"_42174":212,"_5":42651,"_29767":77874,"_28235":77875,"_5797":77876},[],"/docs/pr-preview/pr-56/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_6892":218,"_42174":212,"_5":42651,"_29767":77878,"_28235":77879,"_5797":77880},[],"/docs/pr-preview/pr-56/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_6892":219,"_42174":212,"_5":42651,"_29767":77882,"_28235":77883,"_5797":77884},[],"/docs/pr-preview/pr-56/deployment/self-hosted/helm#amqp-tls-amqps","AMQP TLS (AMQPS)",{"_6892":220,"_42174":212,"_5":42651,"_29767":77886,"_28235":77887,"_5797":77888},[],"/docs/pr-preview/pr-56/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_6892":221,"_42174":212,"_5":42651,"_29767":77890,"_28235":77891,"_5797":77892},[],"/docs/pr-preview/pr-56/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_6892":222,"_42174":212,"_5":42651,"_29767":77894,"_28235":77895,"_5797":77896},[],"/docs/pr-preview/pr-56/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_6892":223,"_42174":212,"_5":42651,"_29767":77898,"_28235":77899,"_5797":77900},[],"/docs/pr-preview/pr-56/deployment/self-hosted/helm#production-decisions","Production decisions",{"_6892":224,"_42174":212,"_29767":77902,"_5":21387,"_28235":77864,"_5797":77903},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_6892":225,"_42174":212,"_29767":77905,"_5":21387,"_28235":77868,"_5797":77906},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_6892":226,"_42174":212,"_29767":77908,"_5":21387,"_28235":77868,"_5797":77909},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_6892":227,"_42174":212,"_29767":77911,"_5":21387,"_28235":77868,"_5797":77912},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_6892":228,"_42174":212,"_29767":77914,"_5":21387,"_28235":77868,"_5797":77915},[],"a reachable RabbitMQ broker and credentials",{"_6892":229,"_42174":212,"_29767":77917,"_5":21387,"_28235":77868,"_5797":77918},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_6892":230,"_42174":212,"_29767":77920,"_5":21387,"_28235":77868,"_5797":77921},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_6892":231,"_42174":212,"_29767":77923,"_5":21387,"_28235":77868,"_5797":77924},[],"cert-manager 1.14+ (only for the default `tls.type: certManager` mode); for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_6892":232,"_42174":212,"_29767":77926,"_5":21387,"_28235":77868,"_5797":77927},[],"a StorageClass and an external traffic design",{"_6892":233,"_42174":212,"_29767":77929,"_5":21387,"_28235":77868,"_5797":77930},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_6892":234,"_42174":212,"_29767":77932,"_5":21387,"_28235":77868,"_5797":77933},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_6892":235,"_42174":212,"_29767":77935,"_5":21387,"_28235":77868,"_5797":77936},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_6892":236,"_42174":212,"_29767":77938,"_5":21387,"_28235":77871,"_5797":77939},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_6892":237,"_42174":212,"_29767":77941,"_5":21387,"_28235":77871,"_5797":77942},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_6892":238,"_42174":212,"_29767":77944,"_5":21387,"_28235":77871,"_5797":77945},[],"Install cert-manager separately before Lamassu, but only for the default `tls.type: certManager` mode. In that mode the chart renders its self-signed Issuer and CA Certificate resources regardless of whether `tls.certManagerOptions.clusterIssuer` is set, so cert-manager stays a prerequisite. With `tls.type: external`, the chart renders no cert-manager resources and the Gateway terminates TLS with an existing Secret you provide instead.",{"_6892":239,"_42174":212,"_29767":77947,"_5":21387,"_28235":77875,"_5797":77948},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_6892":240,"_42174":212,"_29767":77950,"_5":21387,"_28235":77875,"_5797":77951},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_6892":241,"_42174":212,"_29767":77953,"_5":21387,"_28235":77875,"_5797":77954},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_6892":242,"_42174":212,"_29767":77956,"_5":21387,"_28235":77875,"_5797":77957},[],"If your values file still carries the legacy gateway JWT validation settings — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` or `auth.authorization.roles.admin` — remove them. The migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documents their removal with no compatibility aliases, and `values.schema.json` rejects the leftover blocks instead of silently ignoring them. The replacements are `services.authz.jwkUrl` and `services.authz.bootstrap`, already shown in the example above.",{"_6892":243,"_42174":212,"_29767":77959,"_5":21387,"_28235":77879,"_5797":77960},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it. The Secret must already exist before installing: in `external` mode the chart renders no cert-manager resources and never creates this Secret.",{"_6892":244,"_42174":212,"_29767":77962,"_5":21387,"_28235":77883,"_5797":77963},[],"`amqp.tls: true` selects AMQPS in every event-bus configuration block. The default port stays `5672` and does not change automatically when TLS is enabled, so set `amqp.port` to the broker's TLS listener, commonly `5671`.",{"_6892":245,"_42174":212,"_29767":77965,"_5":21387,"_28235":77883,"_5797":77966},[],"With no CA Secret configured, the event-bus clients use the system-trusted CAs. To trust a private CA, create a Secret in the release namespace containing the CA certificate in PEM format and set `amqp.ca.secretName` (and `amqp.ca.certificateKey` if the data key is not `ca.crt`).",{"_6892":246,"_42174":212,"_29767":77968,"_5":21387,"_28235":77883,"_5797":77969},[],"For brokers that require mutual TLS, create a Secret containing the client certificate and private key and set `amqp.client.secretName` (with `amqp.client.certificateKey` and `amqp.client.privateKeyKey` if the data keys are not `tls.crt` and `tls.key`).",{"_6892":247,"_42174":212,"_29767":77971,"_5":21387,"_28235":77883,"_5797":77972},[],"The chart mounts configured Secrets read-only into every AMQP-consuming workload: the CA certificate under `/etc/lamassu/amqp/ca` and the client certificate and key under `/etc/lamassu/amqp/client`. The mounted file names are always `ca.crt`, `tls.crt` and `tls.key` — the `certificateKey` and `privateKeyKey` values rename only the Secret data keys, never the on-disk paths. The client private key is mounted with restrictive permissions (`defaultMode: 0440`; the CA volume uses `0444`), which works because the chart adds `fsGroup` to the pod security context when `amqp.client.secretName` is set — it uses the container `runAsGroup` (default `65532`) when `fsGroup` is not already set.",{"_6892":248,"_42174":212,"_29767":77974,"_5":21387,"_28235":77883,"_5797":77975},[],"Both Secret options require `amqp.tls: true`: `values.schema.json` rejects a non-empty `secretName` when `tls` is false, rejects unknown keys and rejects data-key names outside `^[A-Za-z0-9._-]+$`. The referenced Secret must exist in the release namespace or the consuming pods fail to start.",{"_6892":249,"_42174":212,"_29767":77977,"_5":21387,"_28235":77883,"_5797":77978},[],"The AMQP client loads certificates at startup, so restart the consuming pods after updating either Secret. Changing any `amqp` value rolls the consuming pods through the `checksum/config` annotation, but a change to Secret content alone does not trigger a rollout.",{"_6892":250,"_42174":212,"_29767":77980,"_5":21387,"_28235":77883,"_5797":77981},[],"Per the migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: in 3.8.0 `amqp.tls` was not applied and event-bus clients used plaintext AMQP; from 4.0.0, `amqp.tls: true` switches them to AMQPS. Set `amqp.port` to the broker TLS listener before upgrading, or set `amqp.tls: false` to keep plaintext AMQP. `amqp.tls: false` sends the broker credentials and all event-bus traffic in cleartext.",{"_6892":251,"_42174":212,"_29767":77983,"_5":21387,"_28235":77887,"_5797":77984},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_6892":252,"_42174":212,"_29767":77986,"_5":21387,"_28235":77887,"_5797":77987},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_6892":253,"_42174":212,"_29767":77989,"_5":21387,"_28235":77887,"_5797":77990},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_6892":254,"_42174":212,"_29767":77992,"_5":21387,"_28235":77887,"_5797":77993},[],"See Access control for the principal and policy model.",{"_6892":255,"_42174":212,"_29767":77995,"_5":21387,"_28235":77891,"_5797":77996},[],"To install a local checkout instead:",{"_6892":256,"_42174":212,"_29767":77998,"_5":21387,"_28235":77895,"_5797":77999},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_6892":257,"_42174":212,"_29767":78001,"_5":21387,"_28235":77895,"_5797":78002},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_6892":258,"_42174":212,"_29767":78004,"_5":21387,"_28235":77899,"_5797":78005},[],"Before going live, review:",{"_6892":259,"_42174":212,"_29767":78007,"_5":21387,"_28235":77899,"_5797":78008},[],"backup and recovery for PostgreSQL and persistent volumes",{"_6892":260,"_42174":212,"_29767":78010,"_5":21387,"_28235":77899,"_5797":78011},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_6892":261,"_42174":212,"_29767":78013,"_5":21387,"_28235":77899,"_5797":78014},[],"shared VA storage before increasing VA replicas",{"_6892":262,"_42174":212,"_29767":78016,"_5":21387,"_28235":77899,"_5797":78017},[],"managed OIDC roles and removal of evaluation credentials",{"_6892":263,"_42174":212,"_29767":78019,"_5":21387,"_28235":77899,"_5797":78020},[],"a trusted TLS issuer or externally managed certificate",{"_6892":264,"_42174":212,"_29767":78022,"_5":21387,"_28235":77899,"_5797":78023},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_6892":265,"_42174":212,"_29767":78025,"_5":21387,"_28235":77899,"_5797":78026},[],"SMTP, observability and alert delivery",{"_6892":266,"_42174":212,"_29767":78028,"_5":21387,"_28235":77899,"_5797":78029},[],"the version upgrade guides and the notes in `charts/lamassu/CHANGELOG/` before every upgrade",{"_6892":267,"_42174":212,"_29767":78031,"_5":21387,"_28235":77899,"_5797":78032},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_6892":268,"_42174":268,"_5":21817,"_5797":78034,"_42654":78035,"_29767":78036,"_28235":268},"Expose the Gateway",[77248,77249,77355],[],{"_6892":269,"_42174":268,"_29767":78038,"_5":21387,"_28235":268,"_5797":78039},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_6892":270,"_42174":268,"_5":42651,"_29767":78041,"_28235":78042,"_5797":78043},[],"/docs/pr-preview/pr-56/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_6892":271,"_42174":268,"_5":42651,"_29767":78045,"_28235":78046,"_5797":78047},[],"/docs/pr-preview/pr-56/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_6892":272,"_42174":268,"_5":42651,"_29767":78049,"_28235":78050,"_5797":78051},[],"/docs/pr-preview/pr-56/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_6892":273,"_42174":268,"_5":42651,"_29767":78053,"_28235":78054,"_5797":78055},[],"/docs/pr-preview/pr-56/deployment/self-hosted/networking#k3s","K3s",{"_6892":274,"_42174":268,"_5":42651,"_29767":78057,"_28235":78058,"_5797":78059},[],"/docs/pr-preview/pr-56/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_6892":275,"_42174":268,"_5":42651,"_29767":78061,"_28235":78062,"_5797":78063},[],"/docs/pr-preview/pr-56/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_6892":276,"_42174":268,"_5":42651,"_29767":78065,"_28235":78066,"_5797":78067},[],"/docs/pr-preview/pr-56/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_6892":277,"_42174":268,"_5":42651,"_29767":78069,"_28235":78070,"_5797":78071},[],"/docs/pr-preview/pr-56/deployment/self-hosted/networking#decision-guide","Decision guide",{"_6892":278,"_42174":268,"_5":42651,"_29767":78073,"_28235":78074,"_5797":78075},[],"/docs/pr-preview/pr-56/deployment/self-hosted/networking#egress-proxy","Egress proxy",{"_6892":279,"_42174":268,"_5":42651,"_29767":78077,"_28235":78078,"_5797":78079},[],"/docs/pr-preview/pr-56/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_6892":280,"_42174":268,"_29767":78081,"_5":21387,"_28235":78042,"_5797":78082},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_6892":281,"_42174":268,"_29767":78084,"_5":21387,"_28235":78042,"_5797":78085},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_6892":282,"_42174":268,"_29767":78087,"_5":21387,"_28235":78046,"_5797":78088},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_6892":283,"_42174":268,"_29767":78090,"_5":21387,"_28235":78046,"_5797":78091},[],"Set it only when:",{"_6892":284,"_42174":268,"_29767":78093,"_5":21387,"_28235":78046,"_5797":78094},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_6892":285,"_42174":268,"_29767":78096,"_5":21387,"_28235":78046,"_5797":78097},[],"that address is allocated to this Gateway",{"_6892":286,"_42174":268,"_29767":78099,"_5":21387,"_28235":78046,"_5797":78100},[],"the surrounding network already routes traffic for it to the cluster",{"_6892":287,"_42174":268,"_29767":78102,"_5":21387,"_28235":78046,"_5797":78103},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_6892":288,"_42174":268,"_29767":78105,"_5":21387,"_28235":78046,"_5797":78106},[],"Keep these two settings separate:",{"_6892":289,"_42174":268,"_29767":78108,"_5":21387,"_28235":78046,"_5797":78109},[],"`gateway.addresses` requests an address for the Gateway.",{"_6892":290,"_42174":268,"_29767":78111,"_5":21387,"_28235":78046,"_5797":78112},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_6892":291,"_42174":268,"_29767":78114,"_5":21387,"_28235":78046,"_5797":78115},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_6892":292,"_42174":268,"_29767":78117,"_5":21387,"_28235":78050,"_5797":78118},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_6892":293,"_42174":268,"_29767":78120,"_5":21387,"_28235":78050,"_5797":78121},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_6892":294,"_42174":268,"_29767":78123,"_5":21387,"_28235":78054,"_5797":78124},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_6892":295,"_42174":268,"_29767":78126,"_5":21387,"_28235":78054,"_5797":78127},[],"For the recommended design:",{"_6892":296,"_42174":268,"_29767":78129,"_5":21387,"_28235":78054,"_5797":78130},[],"Use only one externally exposed Lamassu Gateway.",{"_6892":297,"_42174":268,"_29767":78132,"_5":21387,"_28235":78054,"_5797":78133},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_6892":298,"_42174":268,"_29767":78135,"_5":21387,"_28235":78054,"_5797":78136},[],"Allow those ports through the VM firewall and any upstream security group.",{"_6892":299,"_42174":268,"_29767":78138,"_5":21387,"_28235":78054,"_5797":78139},[],"Point DNS at the VM's reachable address.",{"_6892":300,"_42174":268,"_29767":78141,"_5":21387,"_28235":78054,"_5797":78142},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_6892":301,"_42174":268,"_29767":78144,"_5":21387,"_28235":78058,"_5797":78145},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_6892":302,"_42174":268,"_29767":78147,"_5":21387,"_28235":78062,"_5797":78148},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_6892":303,"_42174":268,"_29767":78150,"_5":21387,"_28235":78062,"_5797":78151},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_6892":304,"_42174":268,"_29767":78153,"_5":21387,"_28235":78066,"_5797":78154},[],"First decide whether you need three independent data planes or only three hostnames.",{"_6892":305,"_42174":268,"_29767":78156,"_5":21387,"_28235":78066,"_5797":78157},[],"Requirement",{"_6892":306,"_42174":268,"_29767":78159,"_5":21387,"_28235":78066,"_5797":78160},[],"Recommended design",{"_6892":307,"_42174":268,"_29767":78162,"_5":21387,"_28235":78066,"_5797":78163},[],"Consequence",{"_6892":308,"_42174":268,"_29767":78165,"_5":21387,"_28235":78066,"_5797":78166},[],"Several Lamassu URLs or services",{"_6892":309,"_42174":268,"_29767":78168,"_5":21387,"_28235":78066,"_5797":78169},[],"One Gateway with multiple routes",{"_6892":310,"_42174":268,"_29767":78171,"_5":21387,"_28235":78066,"_5797":78172},[],"One IP and one proxy fleet; this is the chart default",{"_6892":311,"_42174":268,"_29767":78174,"_5":21387,"_28235":78066,"_5797":78175},[],"Independent Gateways and separate external IPs",{"_6892":312,"_42174":268,"_29767":78177,"_5":21387,"_28235":78066,"_5797":78178},[],"One VIP per Gateway",{"_6892":313,"_42174":268,"_29767":78180,"_5":21387,"_28235":78066,"_5797":78181},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_6892":314,"_42174":268,"_29767":78183,"_5":21387,"_28235":78066,"_5797":78184},[],"Independent Gateways on one node and one IP",{"_6892":315,"_42174":268,"_29767":78186,"_5":21387,"_28235":78066,"_5797":78187},[],"Use different external ports",{"_6892":316,"_42174":268,"_29767":78189,"_5":21387,"_28235":78066,"_5797":78190},[],"Clients must include non-standard ports",{"_6892":317,"_42174":268,"_29767":78192,"_5":21387,"_28235":78066,"_5797":78193},[],"Separate TLS/mTLS termination behind one IP",{"_6892":318,"_42174":268,"_29767":78195,"_5":21387,"_28235":78066,"_5797":78196},[],"Front-door SNI routing to internal Gateways",{"_6892":319,"_42174":268,"_29767":78198,"_5":21387,"_28235":78066,"_5797":78199},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_6892":320,"_42174":268,"_29767":78201,"_5":21387,"_28235":78066,"_5797":78202},[],"Separate Gateway resources but shared proxy infrastructure",{"_6892":321,"_42174":268,"_29767":78204,"_5":21387,"_28235":78066,"_5797":78205},[],"Envoy merged-Gateway mode",{"_6892":322,"_42174":268,"_29767":78207,"_5":21387,"_28235":78066,"_5797":78208},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_6892":323,"_42174":268,"_29767":78210,"_5":21387,"_28235":78066,"_5797":78211},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_6892":324,"_42174":268,"_29767":78213,"_5":21387,"_28235":78066,"_5797":78214},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_6892":325,"_42174":268,"_29767":78216,"_5":21387,"_28235":78066,"_5797":78217},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_6892":326,"_42174":268,"_29767":78219,"_5":21387,"_28235":78066,"_5797":78220},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_6892":327,"_42174":268,"_29767":78222,"_5":21387,"_28235":78070,"_5797":78223},[],"If one Gateway can own TLS and routing, use the chart default.",{"_6892":328,"_42174":268,"_29767":78225,"_5":21387,"_28235":78070,"_5797":78226},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_6892":329,"_42174":268,"_29767":78228,"_5":21387,"_28235":78070,"_5797":78229},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_6892":330,"_42174":268,"_29767":78231,"_5":21387,"_28235":78070,"_5797":78232},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_6892":331,"_42174":268,"_29767":78234,"_5":21387,"_28235":78070,"_5797":78235},[],"If none of those are possible, use different external ports or change the external network design.",{"_6892":332,"_42174":268,"_29767":78237,"_5":21387,"_28235":78074,"_5797":78238},[],"Internal Lamassu clients — the Vault engine connection, service-to-service calls and webhook deliveries — honor the `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables. The exception is the authorization-engine connector: it uses its own transport and does not consult these proxy variables. If your deployment routes egress through a proxy, list in-cluster service names in `NO_PROXY` (for example `.svc,.cluster.local`) so internal traffic stays inside the cluster. Loopback traffic is never sent through a proxy.",{"_6892":333,"_42174":268,"_29767":78240,"_5":21387,"_28235":78074,"_5797":78241},[],"The default transport of these clients bounds the dial timeout (30 seconds), the TLS handshake (10 seconds) and idle connection reuse (90 seconds) so an unreachable dependency fails fast instead of hanging; these values are Go transport defaults, not Lamassu settings. HTTP/2 is negotiated when the peer supports it. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call.",{"_6892":334,"_42174":268,"_29767":78243,"_5":21387,"_28235":78078,"_5797":78244},[],"Check, in order:",{"_6892":335,"_42174":268,"_29767":78246,"_5":21387,"_28235":78078,"_5797":78247},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_6892":336,"_42174":268,"_29767":78249,"_5":21387,"_28235":78078,"_5797":78250},[],"Its status contains the expected address.",{"_6892":337,"_42174":268,"_29767":78252,"_5":21387,"_28235":78078,"_5797":78253},[],"The generated `LoadBalancer` Service has a usable external address.",{"_6892":338,"_42174":268,"_29767":78255,"_5":21387,"_28235":78078,"_5797":78256},[],"Port 443 reaches that address from the client network.",{"_6892":339,"_42174":268,"_29767":78258,"_5":21387,"_28235":78078,"_5797":78259},[],"DNS resolves to the externally reachable endpoint.",{"_6892":340,"_42174":268,"_29767":78261,"_5":21387,"_28235":78078,"_5797":78262},[],"The certificate contains the DNS name or IP used by the client.",{"_6892":341,"_42174":268,"_29767":78264,"_5":21387,"_28235":78078,"_5797":78265},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_6892":342,"_42174":342,"_5":21817,"_5797":77355,"_42654":78267,"_29767":78268,"_28235":342},[77248,77249,77355],[],{"_6892":343,"_42174":342,"_29767":78270,"_5":21387,"_28235":342,"_5797":78271},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_6892":344,"_42174":342,"_5":42651,"_29767":78273,"_28235":78274,"_5797":78275},[],"/docs/pr-preview/pr-56/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_6892":345,"_42174":342,"_5":42651,"_29767":78277,"_28235":78278,"_5797":78279},[],"/docs/pr-preview/pr-56/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_6892":346,"_42174":342,"_5":42651,"_29767":78281,"_28235":78282,"_5797":78283},[],"/docs/pr-preview/pr-56/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_6892":347,"_42174":342,"_5":42651,"_29767":78285,"_28235":78286,"_5797":78287},[],"/docs/pr-preview/pr-56/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_6892":348,"_42174":342,"_5":42651,"_29767":78289,"_28235":78290,"_5797":78291},[],"/docs/pr-preview/pr-56/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_6892":349,"_42174":342,"_5":42651,"_29767":78293,"_28235":78294,"_5797":78295},[],"/docs/pr-preview/pr-56/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_6892":350,"_42174":342,"_29767":78297,"_5":21387,"_28235":78274,"_5797":78298},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_6892":351,"_42174":342,"_29767":78300,"_5":21387,"_28235":78278,"_5797":78301},[],"Workflow",{"_6892":352,"_42174":342,"_29767":78303,"_5":21387,"_28235":78278,"_5797":78304},[],"Use it for",{"_6892":353,"_42174":342,"_29767":78306,"_5":21387,"_28235":78278,"_5797":78307},[],"What it installs",{"_6892":354,"_42174":342,"_29767":78309,"_5":21387,"_28235":78278,"_5797":78310},[],"Helm",{"_6892":355,"_42174":342,"_29767":78312,"_5":21387,"_28235":78278,"_5797":78313},[],"Production and controlled environments",{"_6892":356,"_42174":342,"_29767":78315,"_5":21387,"_28235":78278,"_5797":78316},[],"Lamassu services and Gateway API resources",{"_6892":357,"_42174":342,"_29767":78318,"_5":21387,"_28235":78278,"_5797":77492},[],{"_6892":358,"_42174":342,"_29767":78320,"_5":21387,"_28235":78278,"_5797":78321},[],"Evaluation, demos, CI and small lab clusters",{"_6892":359,"_42174":342,"_29767":78323,"_5":21387,"_28235":78278,"_5797":78324},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_6892":360,"_42174":342,"_29767":78326,"_5":21387,"_28235":78282,"_5797":78327},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_6892":361,"_42174":342,"_29767":78329,"_5":21387,"_28235":78282,"_5797":78330},[],"Area",{"_6892":362,"_42174":342,"_29767":78332,"_5":21387,"_28235":78282,"_5797":78333},[],"The Lamassu chart provides",{"_6892":363,"_42174":342,"_29767":78335,"_5":21387,"_28235":78282,"_5797":78336},[],"You provide",{"_6892":364,"_42174":342,"_29767":78338,"_5":21387,"_28235":78282,"_5797":78339},[],"Lamassu applications",{"_6892":365,"_42174":342,"_29767":78341,"_5":21387,"_28235":78282,"_5797":78342},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_6892":366,"_42174":342,"_29767":78344,"_5":21387,"_28235":78282,"_5797":78345},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_6892":367,"_42174":342,"_29767":78347,"_5":21387,"_28235":78282,"_5797":78348},[],"PostgreSQL data",{"_6892":368,"_42174":342,"_29767":78350,"_5":21387,"_28235":78282,"_5797":78351},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_6892":369,"_42174":342,"_29767":78353,"_5":21387,"_28235":78282,"_5797":78354},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_6892":370,"_42174":342,"_29767":78356,"_5":21387,"_28235":78282,"_5797":78357},[],"Messaging",{"_6892":371,"_42174":342,"_29767":78359,"_5":21387,"_28235":78282,"_5797":78360},[],"RabbitMQ connection configuration for the Lamassu services; the connection can use AMQPS, with an optional private CA and an optional client certificate, both set through chart values",{"_6892":372,"_42174":342,"_29767":78362,"_5":21387,"_28235":78282,"_5797":78363},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_6892":373,"_42174":342,"_29767":78365,"_5":21387,"_28235":78282,"_5797":78366},[],"Identity",{"_6892":374,"_42174":342,"_29767":78368,"_5":21387,"_28235":78282,"_5797":78369},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_6892":375,"_42174":342,"_29767":78371,"_5":21387,"_28235":78282,"_5797":78372},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_6892":376,"_42174":342,"_29767":78374,"_5":21387,"_28235":78282,"_5797":78375},[],"External routing",{"_6892":377,"_42174":342,"_29767":78377,"_5":21387,"_28235":78282,"_5797":78378},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_6892":378,"_42174":342,"_29767":78380,"_5":21387,"_28235":78282,"_5797":78381},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_6892":379,"_42174":342,"_29767":78383,"_5":21387,"_28235":78282,"_5797":78384},[],"TLS",{"_6892":380,"_42174":342,"_29767":78386,"_5":21387,"_28235":78282,"_5797":78387},[],"In the default `tls.type: certManager` mode, cert-manager `Issuer` and CA `Certificate` resources and a chart-managed downstream `Certificate`; in the `tls.type: external` mode, a reference to your TLS Secret",{"_6892":381,"_42174":342,"_29767":78389,"_5":21387,"_28235":78282,"_5797":78390},[],"cert-manager only for the default `tls.type: certManager` mode; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_6892":382,"_42174":342,"_29767":78392,"_5":21387,"_28235":78282,"_5797":78393},[],"Persistent application data",{"_6892":383,"_42174":342,"_29767":78395,"_5":21387,"_28235":78282,"_5797":78396},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_6892":384,"_42174":342,"_29767":78398,"_5":21387,"_28235":78282,"_5797":78399},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_6892":385,"_42174":342,"_29767":78401,"_5":21387,"_28235":78282,"_5797":78402},[],"Optional integrations",{"_6892":386,"_42174":342,"_29767":78404,"_5":21387,"_28235":78282,"_5797":78405},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_6892":387,"_42174":342,"_29767":78407,"_5":21387,"_28235":78282,"_5797":78408},[],"The observability backends, cloud credentials and production HSM or external key service",{"_6892":388,"_42174":342,"_29767":78410,"_5":21387,"_28235":78282,"_5797":78411},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_6892":389,"_42174":342,"_29767":78413,"_5":21387,"_28235":78282,"_5797":78414},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_6892":390,"_42174":342,"_29767":78416,"_5":21387,"_28235":78286,"_5797":78417},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_6892":391,"_42174":342,"_29767":78419,"_5":21387,"_28235":78286,"_5797":78420},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_6892":392,"_42174":342,"_29767":78422,"_5":21387,"_28235":78290,"_5797":78423},[],"Kubernetes 1.24 or newer",{"_6892":393,"_42174":342,"_29767":78425,"_5":21387,"_28235":78290,"_5797":78426},[],"Helm 3.2 or newer",{"_6892":394,"_42174":342,"_29767":78428,"_5":21387,"_28235":78290,"_5797":78429},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_6892":395,"_42174":342,"_29767":78431,"_5":21387,"_28235":78290,"_5797":78432},[],"cert-manager 1.14 or newer; required only for the default `tls.type: certManager` TLS mode, not for `tls.type: external`",{"_6892":396,"_42174":342,"_29767":78434,"_5":21387,"_28235":78290,"_5797":78435},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_6892":397,"_42174":342,"_29767":78437,"_5":21387,"_28235":78290,"_5797":78438},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_6892":398,"_42174":342,"_29767":78440,"_5":21387,"_28235":78290,"_5797":78441},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_6892":399,"_42174":342,"_29767":78443,"_5":21387,"_28235":78294,"_5797":78444},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_6892":400,"_42174":342,"_29767":78446,"_5":21387,"_28235":78294,"_5797":78447},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_6892":401,"_42174":342,"_29767":78449,"_5":21387,"_28235":78294,"_5797":78450},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_6892":402,"_42174":342,"_29767":78452,"_5":21387,"_28235":78294,"_5797":78453},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_6892":403,"_42174":403,"_5":21817,"_5797":78455,"_42654":78456,"_29767":78458,"_28235":403},"Deployment troubleshooting",[77248,77249,78457],"Operations",[],{"_6892":404,"_42174":403,"_29767":78460,"_5":21387,"_28235":403,"_5797":78461},[],"Diagnose access, service health and infrastructure dependencies.",{"_6892":405,"_42174":403,"_5":42651,"_29767":78463,"_28235":78464,"_5797":78465},[],"/docs/pr-preview/pr-56/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_6892":406,"_42174":403,"_5":42651,"_29767":78467,"_28235":78468,"_5797":78469},[],"/docs/pr-preview/pr-56/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_6892":407,"_42174":403,"_5":42651,"_29767":78471,"_28235":78472,"_5797":78473},[],"/docs/pr-preview/pr-56/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_6892":408,"_42174":403,"_5":42651,"_29767":78475,"_28235":78476,"_5797":78477},[],"/docs/pr-preview/pr-56/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_6892":409,"_42174":403,"_5":42651,"_29767":78479,"_28235":78480,"_5797":78481},[],"/docs/pr-preview/pr-56/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_6892":410,"_42174":403,"_5":42651,"_29767":78483,"_28235":78484,"_5797":78485},[],"/docs/pr-preview/pr-56/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_6892":411,"_42174":403,"_5":42651,"_29767":78487,"_28235":78488,"_5797":78489},[],"/docs/pr-preview/pr-56/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_6892":412,"_42174":403,"_5":42651,"_29767":78491,"_28235":78492,"_5797":78493},[],"/docs/pr-preview/pr-56/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_6892":413,"_42174":403,"_5":42651,"_29767":78495,"_28235":78496,"_5797":78497},[],"/docs/pr-preview/pr-56/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_6892":414,"_42174":403,"_5":42651,"_29767":78499,"_28235":78500,"_5797":78501},[],"/docs/pr-preview/pr-56/deployment/troubleshooting#api-500-errors","API 500 errors",{"_6892":415,"_42174":403,"_5":42651,"_29767":78503,"_28235":78504,"_5797":78505},[],"/docs/pr-preview/pr-56/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_6892":416,"_42174":403,"_5":42651,"_29767":78507,"_28235":78508,"_5797":78509},[],"/docs/pr-preview/pr-56/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_6892":417,"_42174":403,"_5":42651,"_29767":78511,"_28235":78512,"_5797":78513},[],"/docs/pr-preview/pr-56/deployment/troubleshooting#observability","Observability",{"_6892":418,"_42174":403,"_29767":78515,"_5":21387,"_28235":403,"_5797":78516},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_6892":419,"_42174":403,"_29767":78518,"_5":21387,"_28235":78468,"_5797":78519},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_6892":420,"_42174":403,"_29767":78521,"_5":21387,"_28235":78472,"_5797":78522},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_6892":421,"_42174":403,"_29767":78524,"_5":21387,"_28235":78476,"_5797":78525},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_6892":422,"_42174":403,"_29767":78527,"_5":21387,"_28235":78480,"_5797":78528},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_6892":423,"_42174":403,"_29767":78530,"_5":21387,"_28235":78484,"_5797":78531},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_6892":424,"_42174":403,"_29767":78533,"_5":21387,"_28235":78488,"_5797":78534},[],"Replace the placeholders with your real release, namespace and deployment.",{"_6892":425,"_42174":403,"_29767":78536,"_5":21387,"_28235":78488,"_5797":78537},[],"Also run the chart's connectivity test:",{"_6892":426,"_42174":403,"_29767":78539,"_5":21387,"_28235":78488,"_5797":78540},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_6892":427,"_42174":403,"_29767":78542,"_5":21387,"_28235":78488,"_5797":78543},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_6892":428,"_42174":403,"_29767":78545,"_5":21387,"_28235":78492,"_5797":78546},[],"If you receive a 401:",{"_6892":429,"_42174":403,"_29767":78548,"_5":21387,"_28235":78492,"_5797":78549},[],"check that the UI's OIDC authority is reachable from the browser;",{"_6892":430,"_42174":403,"_29767":78551,"_5":21387,"_28235":78492,"_5797":78552},[],"verify issuer, audience and expiration of the token;",{"_6892":431,"_42174":403,"_29767":78554,"_5":21387,"_28235":78492,"_5797":78555},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_6892":432,"_42174":403,"_29767":78557,"_5":21387,"_28235":78492,"_5797":78558},[],"check that the provider's public and internal routes point to the same realm.",{"_6892":433,"_42174":403,"_29767":78560,"_5":21387,"_28235":78492,"_5797":78561},[],"If login succeeds but the APIs return 403:",{"_6892":434,"_42174":403,"_29767":78563,"_5":21387,"_28235":78492,"_5797":78564},[],"inspect the token's real claims;",{"_6892":435,"_42174":403,"_29767":78566,"_5":21387,"_28235":78492,"_5797":78567},[],"confirm they match an active principal;",{"_6892":436,"_42174":403,"_29767":78569,"_5":21387,"_28235":78492,"_5797":78570},[],"review the policies granted to that principal;",{"_6892":437,"_42174":403,"_29767":78572,"_5":21387,"_28235":78492,"_5797":78573},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_6892":438,"_42174":403,"_29767":78575,"_5":21387,"_28235":78492,"_5797":78576},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_6892":439,"_42174":403,"_29767":78578,"_5":21387,"_28235":78496,"_5797":78579},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_6892":440,"_42174":403,"_29767":78581,"_5":21387,"_28235":78496,"_5797":78582},[],"Locate the authz pod and Service.",{"_6892":441,"_42174":403,"_29767":78584,"_5":21387,"_28235":78496,"_5797":78585},[],"Check /health, logs and its database connection.",{"_6892":442,"_42174":403,"_29767":78587,"_5":21387,"_28235":78496,"_5797":78588},[],"Verify the DNS and port configured in externalAuthorization.",{"_6892":443,"_42174":403,"_29767":78590,"_5":21387,"_28235":78496,"_5797":78591},[],"Check the check route is /v1/ext\\_authz/check.",{"_6892":444,"_42174":403,"_29767":78593,"_5":21387,"_28235":78496,"_5797":78594},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_6892":445,"_42174":403,"_29767":78596,"_5":21387,"_28235":78500,"_5797":78597},[],"A 500 indicates an internal failure, such as an unavailable database. The `{\"err\": ...}` body currently includes the text of the internal error, which can contain schema, table and constraint names and, on connection failures, the database host and user (not the password). Find the cause in the service log using the request time, and do not forward the body to third parties or show it to end users. This is a known information-disclosure defect: generic messages are planned for 500 responses, keeping the detail only in the service log (tracked in lamassuiot#814). The authorization connector also returns the internal error, in the `details.error` field. Some request errors, such as a key size the engine does not support, are also returned as 500.",{"_6892":446,"_42174":403,"_29767":78599,"_5":21387,"_28235":78504,"_5797":78600},[],"Review kubectl describe pod first. Common causes are:",{"_6892":447,"_42174":403,"_29767":78602,"_5":21387,"_28235":78504,"_5797":78603},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_6892":448,"_42174":403,"_29767":78605,"_5":21387,"_28235":78504,"_5797":78606},[],"a missing AMQP CA or client certificate Secret referenced by `amqp.ca.secretName` or `amqp.client.secretName`;",{"_6892":449,"_42174":403,"_29767":78608,"_5":21387,"_28235":78504,"_5797":78609},[],"unbound persistent volume;",{"_6892":450,"_42174":403,"_29767":78611,"_5":21387,"_28235":78504,"_5797":78612},[],"inaccessible image or incorrect pull policy;",{"_6892":451,"_42174":403,"_29767":78614,"_5":21387,"_28235":78504,"_5797":78615},[],"invalid cryptographic engine configuration;",{"_6892":452,"_42174":403,"_29767":78617,"_5":21387,"_28235":78504,"_5797":78618},[],"CPU or memory limits set too low;",{"_6892":453,"_42174":403,"_29767":78620,"_5":21387,"_28235":78504,"_5797":78621},[],"an incomplete prior migration.",{"_6892":454,"_42174":403,"_29767":78623,"_5":21387,"_28235":78504,"_5797":78624},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_6892":455,"_42174":403,"_29767":78626,"_5":21387,"_28235":78504,"_5797":78627},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_6892":456,"_42174":403,"_29767":78629,"_5":21387,"_28235":78504,"_5797":78630},[],"Internal calls now fail fast instead of hanging for the clients covered by Egress proxy: connection attempts time out after 30 seconds and TLS handshakes after 10 seconds. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call. If an egress proxy handles the cluster's outbound traffic, check the pod's `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables and list in-cluster service names in `NO_PROXY`.",{"_6892":457,"_42174":403,"_29767":78632,"_5":21387,"_28235":78508,"_5797":78633},[],"Domain and audit events depend on the bus publisher:",{"_6892":458,"_42174":403,"_29767":78635,"_5":21387,"_28235":78508,"_5797":78636},[],"verify it is enabled in the emitting service;",{"_6892":459,"_42174":403,"_29767":78638,"_5":21387,"_28235":78508,"_5797":78639},[],"check AMQP connectivity and credentials;",{"_6892":460,"_42174":403,"_29767":78641,"_5":21387,"_28235":78508,"_5797":78642},[],"review exchange, routing key, queues and consumers;",{"_6892":461,"_42174":403,"_29767":78644,"_5":21387,"_28235":78508,"_5797":78645},[],"inspect dead-letter queues;",{"_6892":462,"_42174":403,"_29767":78647,"_5":21387,"_28235":78508,"_5797":78648},[],"alert on orphan durable queues and backlog growth.",{"_6892":463,"_42174":403,"_29767":78650,"_5":21387,"_28235":78508,"_5797":78651},[],"If `amqp.tls` is enabled, verify the TLS side as well:",{"_6892":464,"_42174":403,"_29767":78653,"_5":21387,"_28235":78508,"_5797":78654},[],"confirm the broker listener speaks AMQPS on the configured port — the default port stays `5672` and does not follow TLS automatically;",{"_6892":465,"_42174":403,"_29767":78656,"_5":21387,"_28235":78508,"_5797":78657},[],"if you set `amqp.ca.secretName`, confirm the Secret exists in the release namespace and its data key matches `amqp.ca.certificateKey` (default `ca.crt`); if `amqp.ca.secretName` is not set, the clients trust the system CAs;",{"_6892":466,"_42174":403,"_29767":78659,"_5":21387,"_28235":78508,"_5797":78660},[],"remember that a missing referenced Secret prevents the consuming pods from starting;",{"_6892":467,"_42174":403,"_29767":78662,"_5":21387,"_28235":78508,"_5797":78663},[],"after updating the CA or client certificate Secret, restart the consuming pods: the AMQP client loads certificates at startup.",{"_6892":468,"_42174":403,"_29767":78665,"_5":21387,"_28235":78508,"_5797":78666},[],"See AMQP TLS (AMQPS) for the full configuration.",{"_6892":469,"_42174":403,"_29767":78668,"_5":21387,"_28235":78508,"_5797":78669},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_6892":470,"_42174":403,"_29767":78671,"_5":21387,"_28235":78512,"_5797":78672},[],"The chart can enable OpenTelemetry instrumentation. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, authz, service and dependency.",{"_6892":471,"_42174":403,"_29767":78674,"_5":21387,"_28235":78512,"_5797":78675},[],"Before closing an incident, record:",{"_6892":472,"_42174":403,"_29767":78677,"_5":21387,"_28235":78512,"_5797":78678},[],"the confirmed cause;",{"_6892":473,"_42174":403,"_29767":78680,"_5":21387,"_28235":78512,"_5797":78681},[],"the time scope and affected resources;",{"_6892":474,"_42174":403,"_29767":78683,"_5":21387,"_28235":78512,"_5797":78684},[],"the commands or queries used;",{"_6892":475,"_42174":403,"_29767":78686,"_5":21387,"_28235":78512,"_5797":78687},[],"the applied change and how to revert it;",{"_6892":476,"_42174":403,"_29767":78689,"_5":21387,"_28235":78512,"_5797":78690},[],"validation from a consumer;",{"_6892":477,"_42174":403,"_29767":78692,"_5":21387,"_28235":78512,"_5797":78693},[],"the preventive action and its owner.",{"_6892":478,"_42174":478,"_5":21817,"_5797":78695,"_42654":78696,"_29767":78699,"_28235":478},"Access control",[77248,78697,78698],"Platform","Administration",[],{"_6892":479,"_42174":478,"_29767":78701,"_5":21387,"_28235":478,"_5797":78702},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_6892":480,"_42174":478,"_5":42651,"_29767":78704,"_28235":78705,"_5797":78706},[],"/docs/pr-preview/pr-56/platform/administration/access-control#essential-concepts","Essential concepts",{"_6892":481,"_42174":478,"_5":42651,"_29767":78708,"_28235":78709,"_5797":78710},[],"/docs/pr-preview/pr-56/platform/administration/access-control#two-decision-systems","Two decision systems",{"_6892":482,"_42174":478,"_5":42651,"_29767":78712,"_28235":78713,"_5797":78714},[],"/docs/pr-preview/pr-56/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_6892":483,"_42174":478,"_5":42651,"_29767":78716,"_28235":78717,"_5797":78718},[],"/docs/pr-preview/pr-56/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_6892":484,"_42174":478,"_5":42651,"_29767":78720,"_28235":78721,"_5797":78722},[],"/docs/pr-preview/pr-56/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_6892":485,"_42174":478,"_5":42651,"_29767":78724,"_28235":78725,"_5797":78726},[],"/docs/pr-preview/pr-56/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_6892":486,"_42174":478,"_5":42651,"_29767":78728,"_28235":78729,"_5797":78730},[],"/docs/pr-preview/pr-56/platform/administration/access-control#oidc-principals","OIDC principals",{"_6892":487,"_42174":478,"_5":42651,"_29767":78732,"_28235":78733,"_5797":78734},[],"/docs/pr-preview/pr-56/platform/administration/access-control#x509-principals","X.509 principals",{"_6892":488,"_42174":478,"_5":42651,"_29767":78736,"_28235":78737,"_5797":78738},[],"/docs/pr-preview/pr-56/platform/administration/access-control#when-several-principals-match","When several principals match",{"_6892":489,"_42174":478,"_5":42651,"_29767":78740,"_28235":78741,"_5797":78742},[],"/docs/pr-preview/pr-56/platform/administration/access-control#how-policies-express-access","How policies express access",{"_6892":490,"_42174":478,"_5":42651,"_29767":78744,"_28235":78745,"_5797":78746},[],"/docs/pr-preview/pr-56/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_6892":491,"_42174":478,"_5":42651,"_29767":78748,"_28235":78749,"_5797":78750},[],"/docs/pr-preview/pr-56/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_6892":492,"_42174":478,"_5":42651,"_29767":78752,"_28235":78753,"_5797":78754},[],"/docs/pr-preview/pr-56/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_6892":493,"_42174":478,"_5":42651,"_29767":78756,"_28235":78757,"_5797":78758},[],"/docs/pr-preview/pr-56/platform/administration/access-control#http-rules","HTTP rules",{"_6892":494,"_42174":478,"_5":42651,"_29767":78760,"_28235":78761,"_5797":78762},[],"/docs/pr-preview/pr-56/platform/administration/access-control#included-policies","Included policies",{"_6892":495,"_42174":478,"_5":42651,"_29767":78764,"_28235":78765,"_5797":77888},[],"/docs/pr-preview/pr-56/platform/administration/access-control#provision-the-first-administrator",{"_6892":496,"_42174":478,"_5":42651,"_29767":78767,"_28235":78768,"_5797":78769},[],"/docs/pr-preview/pr-56/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_6892":497,"_42174":478,"_5":42651,"_29767":78771,"_28235":78772,"_5797":78773},[],"/docs/pr-preview/pr-56/platform/administration/access-control#configure-token-validation","Configure token validation",{"_6892":498,"_42174":478,"_5":42651,"_29767":78775,"_28235":78776,"_5797":78777},[],"/docs/pr-preview/pr-56/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_6892":499,"_42174":478,"_5":42651,"_29767":78779,"_28235":78780,"_5797":78781},[],"/docs/pr-preview/pr-56/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_6892":500,"_42174":478,"_5":42651,"_29767":78783,"_28235":78784,"_5797":78785},[],"/docs/pr-preview/pr-56/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_6892":501,"_42174":478,"_5":42651,"_29767":78787,"_28235":78788,"_5797":78789},[],"/docs/pr-preview/pr-56/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_6892":502,"_42174":478,"_5":42651,"_29767":78791,"_28235":78792,"_5797":78793},[],"/docs/pr-preview/pr-56/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_6892":503,"_42174":478,"_5":42651,"_29767":78795,"_28235":78796,"_5797":78797},[],"/docs/pr-preview/pr-56/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_6892":504,"_42174":478,"_5":42651,"_29767":78799,"_28235":78800,"_5797":78801},[],"/docs/pr-preview/pr-56/platform/administration/access-control#operational-checklist","Operational checklist",{"_6892":505,"_42174":478,"_5":42651,"_29767":78803,"_28235":78804,"_5797":78805},[],"/docs/pr-preview/pr-56/platform/administration/access-control#diagnostics","Diagnostics",{"_6892":506,"_42174":478,"_5":42651,"_29767":78807,"_28235":78808,"_5797":78809},[],"/docs/pr-preview/pr-56/platform/administration/access-control#the-response-is-401","The response is 401",{"_6892":507,"_42174":478,"_5":42651,"_29767":78811,"_28235":78812,"_5797":78813},[],"/docs/pr-preview/pr-56/platform/administration/access-control#the-response-is-403","The response is 403",{"_6892":508,"_42174":478,"_5":42651,"_29767":78815,"_28235":78816,"_5797":78817},[],"/docs/pr-preview/pr-56/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_6892":509,"_42174":478,"_5":42651,"_29767":78819,"_28235":78820,"_5797":78821},[],"/docs/pr-preview/pr-56/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_6892":510,"_42174":478,"_5":42651,"_29767":78823,"_28235":78824,"_5797":78825},[],"/docs/pr-preview/pr-56/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_6892":511,"_42174":478,"_29767":78827,"_5":21387,"_28235":478,"_5797":78828},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_6892":512,"_42174":478,"_29767":78830,"_5":21387,"_28235":478,"_5797":78831},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_6892":513,"_42174":478,"_29767":78833,"_5":21387,"_28235":478,"_5797":78834},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_6892":514,"_42174":478,"_29767":78836,"_5":21387,"_28235":78705,"_5797":78837},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_6892":515,"_42174":478,"_29767":78839,"_5":21387,"_28235":78705,"_5797":78840},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_6892":516,"_42174":478,"_29767":78842,"_5":21387,"_28235":78705,"_5797":78843},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_6892":517,"_42174":478,"_29767":78845,"_5":21387,"_28235":78705,"_5797":78846},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_6892":518,"_42174":478,"_29767":78848,"_5":21387,"_28235":78705,"_5797":78849},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_6892":519,"_42174":478,"_29767":78851,"_5":21387,"_28235":78705,"_5797":78852},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_6892":520,"_42174":478,"_29767":78854,"_5":21387,"_28235":78709,"_5797":78855},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_6892":521,"_42174":478,"_29767":78857,"_5":21387,"_28235":78709,"_5797":78858},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_6892":522,"_42174":478,"_29767":78860,"_5":21387,"_28235":78713,"_5797":78861},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_6892":523,"_42174":478,"_29767":78863,"_5":21387,"_28235":78713,"_5797":78864},[],"The decision is made **before forwarding the request to the service**:",{"_6892":524,"_42174":478,"_29767":78866,"_5":21387,"_28235":78713,"_5797":78867},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_6892":525,"_42174":478,"_29767":78869,"_5":21387,"_28235":78713,"_5797":78870},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_6892":526,"_42174":478,"_29767":78872,"_5":21387,"_28235":78713,"_5797":78873},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_6892":527,"_42174":478,"_29767":78875,"_5":21387,"_28235":78713,"_5797":78876},[],"It separately loads the policies granted to each principal.",{"_6892":528,"_42174":478,"_29767":78878,"_5":21387,"_28235":78713,"_5797":78879},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_6892":529,"_42174":478,"_29767":78881,"_5":21387,"_28235":78713,"_5797":78882},[],"`authz` looks for an HTTP rule granting that action.",{"_6892":530,"_42174":478,"_29767":78884,"_5":21387,"_28235":78713,"_5797":78885},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_6892":531,"_42174":478,"_29767":78887,"_5":21387,"_28235":78713,"_5797":78888},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_6892":532,"_42174":478,"_29767":78890,"_5":21387,"_28235":78713,"_5797":78891},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context.",{"_6892":533,"_42174":478,"_29767":78893,"_5":21387,"_28235":78713,"_5797":78894},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_6892":534,"_42174":478,"_29767":78896,"_5":21387,"_28235":78717,"_5797":78897},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_6892":535,"_42174":478,"_29767":78899,"_5":21387,"_28235":78717,"_5797":78900},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_6892":536,"_42174":478,"_29767":78902,"_5":21387,"_28235":78717,"_5797":78903},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_6892":537,"_42174":478,"_29767":78905,"_5":21387,"_28235":78717,"_5797":78906},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_6892":538,"_42174":478,"_29767":78908,"_5":21387,"_28235":78717,"_5797":78909},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_6892":539,"_42174":478,"_29767":78911,"_5":21387,"_28235":78717,"_5797":78912},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_6892":540,"_42174":478,"_29767":78914,"_5":21387,"_28235":78717,"_5797":78915},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_6892":541,"_42174":478,"_29767":78917,"_5":21387,"_28235":78717,"_5797":78918},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_6892":542,"_42174":478,"_29767":78920,"_5":21387,"_28235":78721,"_5797":78921},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_6892":543,"_42174":478,"_29767":78923,"_5":21387,"_28235":78721,"_5797":78924},[],"The decision is made with the domain operation context:",{"_6892":544,"_42174":478,"_29767":78926,"_5":21387,"_28235":78721,"_5797":78927},[],"The middleware extracts the credential and resolves the matching principals.",{"_6892":545,"_42174":478,"_29767":78929,"_5":21387,"_28235":78721,"_5797":78930},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_6892":546,"_42174":478,"_29767":78932,"_5":21387,"_28235":78721,"_5797":78933},[],"`authz` gathers the entity rules of the granted policies.",{"_6892":547,"_42174":478,"_29767":78935,"_5":21387,"_28235":78721,"_5797":78936},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_6892":548,"_42174":478,"_29767":78938,"_5":21387,"_28235":78721,"_5797":78939},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_6892":549,"_42174":478,"_29767":78941,"_5":21387,"_28235":78721,"_5797":78942},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_6892":550,"_42174":478,"_29767":78944,"_5":21387,"_28235":78721,"_5797":78945},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_6892":551,"_42174":478,"_29767":78947,"_5":21387,"_28235":78721,"_5797":78948},[],"Actions fall into two groups:",{"_6892":552,"_42174":478,"_29767":78950,"_5":21387,"_28235":78721,"_5797":78951},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_6892":553,"_42174":478,"_29767":78953,"_5":21387,"_28235":78721,"_5797":78954},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_6892":554,"_42174":478,"_29767":78956,"_5":21387,"_28235":78721,"_5797":78957},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_6892":555,"_42174":478,"_29767":78959,"_5":21387,"_28235":78725,"_5797":78960},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_6892":556,"_42174":478,"_29767":78962,"_5":21387,"_28235":78725,"_5797":78963},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_6892":557,"_42174":478,"_29767":78965,"_5":21387,"_28235":78725,"_5797":78966},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_6892":558,"_42174":478,"_29767":78968,"_5":21387,"_28235":78729,"_5797":78969},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_6892":559,"_42174":478,"_29767":78971,"_5":21387,"_28235":78729,"_5797":78972},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_6892":560,"_42174":478,"_29767":78974,"_5":21387,"_28235":78729,"_5797":78975},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_6892":561,"_42174":478,"_29767":78977,"_5":21387,"_28235":78729,"_5797":78978},[],"The implemented operators are:",{"_6892":562,"_42174":478,"_29767":78980,"_5":21387,"_28235":78729,"_5797":78981},[],"`equals`, for exact equality;",{"_6892":563,"_42174":478,"_29767":78983,"_5":21387,"_28235":78729,"_5797":78984},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_6892":564,"_42174":478,"_29767":78986,"_5":21387,"_28235":78729,"_5797":78987},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_6892":565,"_42174":478,"_29767":78989,"_5":21387,"_28235":78729,"_5797":78990},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_6892":566,"_42174":478,"_29767":78992,"_5":21387,"_28235":78733,"_5797":78993},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_6892":567,"_42174":478,"_29767":78995,"_5":21387,"_28235":78733,"_5797":78996},[],"The available modes are:",{"_6892":568,"_42174":478,"_29767":78998,"_5":21387,"_28235":78733,"_5797":78999},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_6892":569,"_42174":478,"_29767":79001,"_5":21387,"_28235":78733,"_5797":79002},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_6892":570,"_42174":478,"_29767":79004,"_5":21387,"_28235":78733,"_5797":79005},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_6892":571,"_42174":478,"_29767":79007,"_5":21387,"_28235":78733,"_5797":79008},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_6892":572,"_42174":478,"_29767":79010,"_5":21387,"_28235":78733,"_5797":79011},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_6892":573,"_42174":478,"_29767":79013,"_5":21387,"_28235":78733,"_5797":79014},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_6892":574,"_42174":478,"_29767":79016,"_5":21387,"_28235":78737,"_5797":79017},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_6892":575,"_42174":478,"_29767":79019,"_5":21387,"_28235":78737,"_5797":79020},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_6892":576,"_42174":478,"_29767":79022,"_5":21387,"_28235":78737,"_5797":79023},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_6892":577,"_42174":478,"_29767":79025,"_5":21387,"_28235":78737,"_5797":79026},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_6892":578,"_42174":478,"_29767":79028,"_5":21387,"_28235":78745,"_5797":79029},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_6892":579,"_42174":478,"_29767":79031,"_5":21387,"_28235":78745,"_5797":79032},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_6892":580,"_42174":478,"_29767":79034,"_5":21387,"_28235":78749,"_5797":79035},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA and of a device to its DMS. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_6892":581,"_42174":478,"_29767":79037,"_5":21387,"_28235":78749,"_5797":79038},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_6892":582,"_42174":478,"_29767":79040,"_5":21387,"_28235":78753,"_5797":79041},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_6892":583,"_42174":478,"_29767":79043,"_5":21387,"_28235":78753,"_5797":79044},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_6892":584,"_42174":478,"_29767":79046,"_5":21387,"_28235":78753,"_5797":79047},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_6892":585,"_42174":478,"_29767":79049,"_5":21387,"_28235":78757,"_5797":79050},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_6892":586,"_42174":478,"_29767":79052,"_5":21387,"_28235":78757,"_5797":79053},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_6892":587,"_42174":478,"_29767":79055,"_5":21387,"_28235":78757,"_5797":79056},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_6892":588,"_42174":478,"_29767":79058,"_5":21387,"_28235":78757,"_5797":79059},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_6892":589,"_42174":478,"_29767":79061,"_5":21387,"_28235":78757,"_5797":79062},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_6892":590,"_42174":478,"_29767":79064,"_5":21387,"_28235":78757,"_5797":79065},[],"Note that:",{"_6892":591,"_42174":478,"_29767":79067,"_5":21387,"_28235":78757,"_5797":79068},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_6892":592,"_42174":478,"_29767":79070,"_5":21387,"_28235":78757,"_5797":79071},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_6892":593,"_42174":478,"_29767":79073,"_5":21387,"_28235":78757,"_5797":79074},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_6892":594,"_42174":478,"_29767":79076,"_5":21387,"_28235":78761,"_5797":79077},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_6892":595,"_42174":478,"_29767":79079,"_5":21387,"_28235":78761,"_5797":79080},[],"full and read-only access to certificates and authorities;",{"_6892":596,"_42174":478,"_29767":79082,"_5":21387,"_28235":78761,"_5797":79083},[],"full and read-only access to the KMS;",{"_6892":597,"_42174":478,"_29767":79085,"_5":21387,"_28235":78761,"_5797":79086},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_6892":598,"_42174":478,"_29767":79088,"_5":21387,"_28235":78761,"_5797":79089},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_6892":599,"_42174":478,"_29767":79091,"_5":21387,"_28235":78761,"_5797":79092},[],"console access;",{"_6892":600,"_42174":478,"_29767":79094,"_5":21387,"_28235":78761,"_5797":79095},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_6892":601,"_42174":478,"_29767":79097,"_5":21387,"_28235":78761,"_5797":79098},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_6892":602,"_42174":478,"_29767":79100,"_5":21387,"_28235":78761,"_5797":79101},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_6892":603,"_42174":478,"_29767":79103,"_5":21387,"_28235":78765,"_5797":79104},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_6892":604,"_42174":478,"_29767":79106,"_5":21387,"_28235":78765,"_5797":79107},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_6892":605,"_42174":478,"_29767":79109,"_5":21387,"_28235":78765,"_5797":79110},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_6892":606,"_42174":478,"_29767":79112,"_5":21387,"_28235":78768,"_5797":79113},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_6892":607,"_42174":478,"_29767":79115,"_5":21387,"_28235":78772,"_5797":79116},[],"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`.",{"_6892":608,"_42174":478,"_29767":79118,"_5":21387,"_28235":78772,"_5797":79119},[],"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0.",{"_6892":609,"_42174":478,"_29767":79121,"_5":21387,"_28235":78776,"_5797":79122},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_6892":610,"_42174":478,"_29767":79124,"_5":21387,"_28235":78780,"_5797":79125},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_6892":611,"_42174":478,"_29767":79127,"_5":21387,"_28235":78784,"_5797":79128},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_6892":612,"_42174":478,"_29767":79130,"_5":21387,"_28235":78788,"_5797":79131},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_6892":613,"_42174":478,"_29767":79133,"_5":21387,"_28235":78788,"_5797":79134},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_6892":614,"_42174":478,"_29767":79136,"_5":21387,"_28235":78792,"_5797":79137},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_6892":615,"_42174":478,"_29767":79139,"_5":21387,"_28235":78792,"_5797":79140},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_6892":616,"_42174":478,"_29767":79142,"_5":21387,"_28235":78792,"_5797":79143},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_6892":617,"_42174":478,"_29767":79145,"_5":21387,"_28235":78792,"_5797":79146},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_6892":618,"_42174":478,"_29767":79148,"_5":21387,"_28235":78792,"_5797":79149},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_6892":619,"_42174":478,"_29767":79151,"_5":21387,"_28235":78792,"_5797":79152},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_6892":620,"_42174":478,"_29767":79154,"_5":21387,"_28235":78792,"_5797":79155},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_6892":621,"_42174":478,"_29767":79157,"_5":21387,"_28235":78792,"_5797":79158},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_6892":622,"_42174":478,"_29767":79160,"_5":21387,"_28235":78796,"_5797":79161},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_6892":623,"_42174":478,"_29767":79163,"_5":21387,"_28235":78796,"_5797":79164},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_6892":624,"_42174":478,"_29767":79166,"_5":21387,"_28235":78796,"_5797":79167},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_6892":625,"_42174":478,"_29767":79169,"_5":21387,"_28235":78800,"_5797":79170},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_6892":626,"_42174":478,"_29767":79172,"_5":21387,"_28235":78800,"_5797":79173},[],"Use groups or stable roles for people and independent identities for automations.",{"_6892":627,"_42174":478,"_29767":79175,"_5":21387,"_28235":78800,"_5797":79176},[],"Keep at least two recovery administrators and test their access periodically.",{"_6892":628,"_42174":478,"_29767":79178,"_5":21387,"_28235":78800,"_5797":79179},[],"Review active principals, their matches and their grants after IdP changes.",{"_6892":629,"_42174":478,"_29767":79181,"_5":21387,"_28235":78800,"_5797":79182},[],"Search for wildcards in policies before upgrading Lamassu.",{"_6892":630,"_42174":478,"_29767":79184,"_5":21387,"_28235":78800,"_5797":79185},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_6892":631,"_42174":478,"_29767":79187,"_5":21387,"_28235":78800,"_5797":79188},[],"Always test one allowed and one denied operation for each role.",{"_6892":632,"_42174":478,"_29767":79190,"_5":21387,"_28235":78800,"_5797":79191},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_6892":633,"_42174":478,"_29767":79193,"_5":21387,"_28235":78808,"_5797":79194},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_6892":634,"_42174":478,"_29767":79196,"_5":21387,"_28235":78812,"_5797":79197},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_6892":635,"_42174":478,"_29767":79199,"_5":21387,"_28235":78812,"_5797":79200},[],"that an active principal of the correct type exists;",{"_6892":636,"_42174":478,"_29767":79202,"_5":21387,"_28235":78812,"_5797":79203},[],"that the claim paths and values match the real token exactly;",{"_6892":637,"_42174":478,"_29767":79205,"_5":21387,"_28235":78812,"_5797":79206},[],"that all of the principal's conditions hold;",{"_6892":638,"_42174":478,"_29767":79208,"_5":21387,"_28235":78812,"_5797":79209},[],"that the principal has the expected policy granted;",{"_6892":639,"_42174":478,"_29767":79211,"_5":21387,"_28235":78812,"_5797":79212},[],"that the policy includes the action and the requested resource type or route;",{"_6892":640,"_42174":478,"_29767":79214,"_5":21387,"_28235":78812,"_5797":79215},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_6892":641,"_42174":478,"_29767":79217,"_5":21387,"_28235":78812,"_5797":79218},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry instrumentation enabled, each decision also produces a span — `engine.CheckHTTP` on the Gateway path — whose attributes record `authz.allowed`, the matched policy and the matched principal, so you can correlate the denial with the Gateway trace.",{"_6892":642,"_42174":478,"_29767":79220,"_5":21387,"_28235":78816,"_5797":79221},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_6892":643,"_42174":478,"_29767":79223,"_5":21387,"_28235":78820,"_5797":79224},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_6892":644,"_42174":478,"_29767":79226,"_5":21387,"_28235":78824,"_5797":79227},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_6892":645,"_42174":478,"_29767":79229,"_5":21387,"_28235":78824,"_5797":79230},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_6892":646,"_42174":646,"_5":21817,"_5797":79232,"_42654":79233,"_29767":79234,"_28235":646},"Alerts and subscriptions",[77248,78697,78698],[],{"_6892":647,"_42174":646,"_29767":79236,"_5":21387,"_28235":646,"_5797":79237},[],"Send PKI events to people and external systems.",{"_6892":648,"_42174":646,"_5":42651,"_29767":79239,"_28235":79240,"_5797":79241},[],"/docs/pr-preview/pr-56/platform/administration/alerts#how-it-works","How it works",{"_6892":649,"_42174":646,"_5":42651,"_29767":79243,"_28235":79244,"_5797":79245},[],"/docs/pr-preview/pr-56/platform/administration/alerts#available-channels","Available channels",{"_6892":650,"_42174":646,"_5":42651,"_29767":79247,"_28235":79248,"_5797":79249},[],"/docs/pr-preview/pr-56/platform/administration/alerts#create-a-subscription","Create a subscription",{"_6892":651,"_42174":646,"_5":42651,"_29767":79251,"_28235":79252,"_5797":79253},[],"/docs/pr-preview/pr-56/platform/administration/alerts#choose-the-event","Choose the event",{"_6892":652,"_42174":646,"_5":42651,"_29767":79255,"_28235":79256,"_5797":79257},[],"/docs/pr-preview/pr-56/platform/administration/alerts#configure-the-destination","Configure the destination",{"_6892":653,"_42174":646,"_5":42651,"_29767":79259,"_28235":79260,"_5797":79261},[],"/docs/pr-preview/pr-56/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_6892":654,"_42174":646,"_5":42651,"_29767":79263,"_28235":79264,"_5797":79265},[],"/docs/pr-preview/pr-56/platform/administration/alerts#review-and-activate","Review and activate",{"_6892":655,"_42174":646,"_5":42651,"_29767":79267,"_28235":79268,"_5797":79269},[],"/docs/pr-preview/pr-56/platform/administration/alerts#configure-the-webhook-http-client","Configure the webhook HTTP client",{"_6892":656,"_42174":646,"_5":42651,"_29767":79271,"_28235":79272,"_5797":79273},[],"/docs/pr-preview/pr-56/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_6892":657,"_42174":646,"_5":42651,"_29767":79275,"_28235":79276,"_5797":79277},[],"/docs/pr-preview/pr-56/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_6892":658,"_42174":646,"_5":42651,"_29767":79279,"_28235":79280,"_5797":79281},[],"/docs/pr-preview/pr-56/platform/administration/alerts#event-families","Event families",{"_6892":659,"_42174":646,"_29767":79283,"_5":21387,"_28235":646,"_5797":79284},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_6892":660,"_42174":646,"_29767":79286,"_5":21387,"_28235":79240,"_5797":79287},[],"A service publishes a domain event.",{"_6892":661,"_42174":646,"_29767":79289,"_5":21387,"_28235":79240,"_5797":79290},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_6892":662,"_42174":646,"_29767":79292,"_5":21387,"_28235":79240,"_5797":79293},[],"Each subscription's filter decides whether it should be notified.",{"_6892":663,"_42174":646,"_29767":79295,"_5":21387,"_28235":79240,"_5797":79296},[],"Lamassu delivers the event to the configured channel.",{"_6892":664,"_42174":646,"_29767":79298,"_5":21387,"_28235":79240,"_5797":79299},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_6892":665,"_42174":646,"_29767":79301,"_5":21387,"_28235":79244,"_5797":79302},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_6892":666,"_42174":646,"_29767":79304,"_5":21387,"_28235":79244,"_5797":79305},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_6892":667,"_42174":646,"_29767":79307,"_5":21387,"_28235":79244,"_5797":79308},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_6892":668,"_42174":646,"_29767":79310,"_5":21387,"_28235":79244,"_5797":79311},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_6892":669,"_42174":646,"_29767":79313,"_5":21387,"_28235":79244,"_5797":79314},[],"`apikey_options` requires `header` and `key`.",{"_6892":670,"_42174":646,"_29767":79316,"_5":21387,"_28235":79244,"_5797":79317},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_6892":671,"_42174":646,"_29767":79319,"_5":21387,"_28235":79244,"_5797":79320},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_6892":672,"_42174":646,"_29767":79322,"_5":21387,"_28235":79244,"_5797":79323},[],"The alerts API reference documents the full `http_client` schema.",{"_6892":673,"_42174":646,"_29767":79325,"_5":21387,"_28235":79252,"_5797":79326},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_6892":674,"_42174":646,"_29767":79328,"_5":21387,"_28235":79256,"_5797":79329},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_6892":675,"_42174":646,"_29767":79331,"_5":21387,"_28235":79260,"_5797":79332},[],"Add a filter if you don't want to receive every instance of the event.",{"_6892":676,"_42174":646,"_29767":79334,"_5":21387,"_28235":79260,"_5797":79335},[],"**None** notifies all instances of the event.",{"_6892":677,"_42174":646,"_29767":79337,"_5":21387,"_28235":79260,"_5797":79338},[],"**JSON Path** evaluates one or more specific fields.",{"_6892":678,"_42174":646,"_29767":79340,"_5":21387,"_28235":79260,"_5797":79341},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_6892":679,"_42174":646,"_29767":79343,"_5":21387,"_28235":79260,"_5797":79344},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_6892":680,"_42174":646,"_29767":79346,"_5":21387,"_28235":79260,"_5797":79347},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_6892":681,"_42174":646,"_29767":79349,"_5":21387,"_28235":79264,"_5797":79350},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_6892":682,"_42174":646,"_29767":79352,"_5":21387,"_28235":79268,"_5797":79353},[],"The Webhook and Microsoft Teams channels show this configuration in the subscribe form, at the channel step, and again when editing a subscription; Email does not use it. The fields map to the optional `http_client` block described above:",{"_6892":683,"_42174":646,"_29767":79355,"_5":21387,"_28235":79268,"_5797":79356},[],"**Log Level** selects `debug`, `info`, `warn` or `error`; `info` is the default.",{"_6892":684,"_42174":646,"_29767":79358,"_5":21387,"_28235":79268,"_5797":79359},[],"**Call Timeout** defaults to 10 seconds. The console rejects a value above 30 seconds with `Webhook timeout must be at most 30s.`; the API clamps the same value to the cap instead (see Calls are bounded).",{"_6892":685,"_42174":646,"_29767":79361,"_5":21387,"_28235":79268,"_5797":79362},[],"There is no TLS-verification switch for these channels, because the service always verifies the receiver certificate (see TLS is always verified).",{"_6892":686,"_42174":646,"_29767":79364,"_5":21387,"_28235":79268,"_5797":79365},[],"**HTTP Authentication** selects `No Authentication` (the default), `API Key` (API key value and Header Name, `X-API-Key` by default), `OIDC Client Credentials` (Client ID, Client Secret and Well-Known URL) or `Mutual TLS` (Client Certificate and Client Private Key pasted as PEM). A stored private key stays hidden until you select **Show**.",{"_6892":687,"_42174":646,"_29767":79367,"_5":21387,"_28235":79268,"_5797":79368},[],"A `http://` URL shows the console warning `Unencrypted HTTP connection` (see the Credentials over http\\:// callout below).",{"_6892":688,"_42174":646,"_29767":79370,"_5":21387,"_28235":79268,"_5797":79371},[],"The form validates inline against the same delivery rules: the webhook URL and the OIDC Well-Known URL must be absolute `http` or `https` URLs, an API-key header may not use a reserved name, and the mTLS certificate and key must be PEM content, not file paths.",{"_6892":689,"_42174":646,"_29767":79373,"_5":21387,"_28235":79268,"_5797":79374},[],"The summary in the Confirm step shows the authentication as `None`, `OIDC client credentials`, `API key` or `Mutual TLS`. The subscription details show the authentication, the API key header name (never the value), the OIDC issuer URL, mTLS as `Configured` and a fixed `TLS verification: Verified` row. The API key, client secret and private key are not shown in the subscription details.",{"_6892":690,"_42174":646,"_29767":79376,"_5":21387,"_28235":79272,"_5797":79377},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_6892":691,"_42174":646,"_29767":79379,"_5":21387,"_28235":79272,"_5797":79380},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_6892":692,"_42174":646,"_29767":79382,"_5":21387,"_28235":79272,"_5797":79383},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_6892":693,"_42174":646,"_29767":79385,"_5":21387,"_28235":79272,"_5797":79386},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_6892":694,"_42174":646,"_29767":79388,"_5":21387,"_28235":79272,"_5797":79389},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_6892":695,"_42174":646,"_29767":79391,"_5":21387,"_28235":79272,"_5797":79392},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_6892":696,"_42174":646,"_29767":79394,"_5":21387,"_28235":79272,"_5797":79395},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_6892":697,"_42174":646,"_29767":79397,"_5":21387,"_28235":79272,"_5797":79398},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_6892":698,"_42174":646,"_29767":79400,"_5":21387,"_28235":79276,"_5797":79401},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_6892":699,"_42174":646,"_29767":79403,"_5":21387,"_28235":79276,"_5797":79404},[],"Subscriptions created with older console versions may store the webhook target under `url` and `method` instead of `webhook_url` and `webhook_method`. The service delivers only through `webhook_url` and `webhook_method`, so such a subscription does not deliver even though the subscription details show the stored target. Open the subscription and save it again: the edit form prefills the stored target, and saving rewrites the channel configuration in the current layout.",{"_6892":700,"_42174":646,"_29767":79406,"_5":21387,"_28235":79280,"_5797":79407},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_6892":701,"_42174":646,"_29767":79409,"_5":21387,"_28235":79280,"_5797":79410},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_6892":702,"_42174":646,"_29767":79412,"_5":21387,"_28235":79280,"_5797":79413},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_6892":703,"_42174":646,"_29767":79415,"_5":21387,"_28235":79280,"_5797":79416},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_6892":704,"_42174":646,"_29767":79418,"_5":21387,"_28235":79280,"_5797":79419},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_6892":705,"_42174":646,"_29767":79421,"_5":21387,"_28235":79280,"_5797":79422},[],"**Validation:** `va.role.crl.create`.",{"_6892":706,"_42174":646,"_29767":79424,"_5":21387,"_28235":79280,"_5797":79425},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_6892":707,"_42174":646,"_29767":79427,"_5":21387,"_28235":79280,"_5797":79428},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_6892":708,"_42174":708,"_5":21817,"_5797":79430,"_42654":79431,"_29767":79432,"_28235":708},"Audit logs",[77248,78697,78698],[],{"_6892":709,"_42174":708,"_29767":79434,"_5":21387,"_28235":708,"_5797":79435},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_6892":710,"_42174":708,"_5":42651,"_29767":79437,"_28235":79438,"_5797":79439},[],"/docs/pr-preview/pr-56/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_6892":711,"_42174":708,"_5":42651,"_29767":79441,"_28235":79442,"_5797":79443},[],"/docs/pr-preview/pr-56/platform/administration/audit-logs#coverage","Coverage",{"_6892":712,"_42174":708,"_5":42651,"_29767":79445,"_28235":79446,"_5797":79447},[],"/docs/pr-preview/pr-56/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_6892":713,"_42174":708,"_5":42651,"_29767":79449,"_28235":79450,"_5797":79451},[],"/docs/pr-preview/pr-56/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_6892":714,"_42174":708,"_5":42651,"_29767":79453,"_28235":79454,"_5797":79455},[],"/docs/pr-preview/pr-56/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_6892":715,"_42174":708,"_5":42651,"_29767":79457,"_28235":79458,"_5797":79459},[],"/docs/pr-preview/pr-56/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_6892":716,"_42174":708,"_5":42651,"_29767":79461,"_28235":79462,"_5797":79463},[],"/docs/pr-preview/pr-56/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_6892":717,"_42174":708,"_5":42651,"_29767":79465,"_28235":79466,"_5797":79467},[],"/docs/pr-preview/pr-56/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_6892":718,"_42174":708,"_5":42651,"_29767":79469,"_28235":79470,"_5797":79471},[],"/docs/pr-preview/pr-56/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_6892":719,"_42174":708,"_5":42651,"_29767":79473,"_28235":79474,"_5797":79475},[],"/docs/pr-preview/pr-56/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_6892":720,"_42174":708,"_5":42651,"_29767":79477,"_28235":79478,"_5797":79479},[],"/docs/pr-preview/pr-56/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_6892":721,"_42174":708,"_29767":79481,"_5":21387,"_28235":708,"_5797":79482},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_6892":722,"_42174":708,"_29767":79484,"_5":21387,"_28235":79438,"_5797":79485},[],"The audit body includes:",{"_6892":723,"_42174":708,"_29767":79487,"_5":21387,"_28235":79438,"_5797":79488},[],"input: data received by the operation;",{"_6892":724,"_42174":708,"_29767":79490,"_5":21387,"_28235":79438,"_5797":79491},[],"has\\_error: whether the service returned an error;",{"_6892":725,"_42174":708,"_29767":79493,"_5":21387,"_28235":79438,"_5797":79494},[],"output: produced result or error message;",{"_6892":726,"_42174":708,"_29767":79496,"_5":21387,"_28235":79438,"_5797":79497},[],"principals: identifiers of the principals that matched the request.",{"_6892":727,"_42174":708,"_29767":79499,"_5":21387,"_28235":79438,"_5797":79500},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_6892":728,"_42174":708,"_29767":79502,"_5":21387,"_28235":79438,"_5797":79503},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_6892":729,"_42174":708,"_29767":79505,"_5":21387,"_28235":79442,"_5797":79506},[],"The backend applies auditing to mutations of:",{"_6892":730,"_42174":708,"_29767":79508,"_5":21387,"_28235":79442,"_5797":79509},[],"authorities, certificates and issuance profiles;",{"_6892":731,"_42174":708,"_29767":79511,"_5":21387,"_28235":79442,"_5797":79512},[],"keys and KMS engines;",{"_6892":732,"_42174":708,"_29767":79514,"_5":21387,"_28235":79442,"_5797":79515},[],"devices and identities;",{"_6892":733,"_42174":708,"_29767":79517,"_5":21387,"_28235":79442,"_5797":79518},[],"DMSs and enrollment operations;",{"_6892":734,"_42174":708,"_29767":79520,"_5":21387,"_28235":79442,"_5797":79521},[],"validation functions and CRL;",{"_6892":735,"_42174":708,"_29767":79523,"_5":21387,"_28235":79442,"_5797":79524},[],"principals, policies and authorization grants.",{"_6892":736,"_42174":708,"_29767":79526,"_5":21387,"_28235":79442,"_5797":79527},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_6892":737,"_42174":708,"_29767":79529,"_5":21387,"_28235":79446,"_5797":79530},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_6892":738,"_42174":708,"_29767":79532,"_5":21387,"_28235":79446,"_5797":79533},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_6892":739,"_42174":708,"_29767":79535,"_5":21387,"_28235":79446,"_5797":79536},[],"Design the consumer to:",{"_6892":740,"_42174":708,"_29767":79538,"_5":21387,"_28235":79446,"_5797":79539},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_6892":741,"_42174":708,"_29767":79541,"_5":21387,"_28235":79446,"_5797":79542},[],"keep the complete CloudEvent unmodified;",{"_6892":742,"_42174":708,"_29767":79544,"_5":21387,"_28235":79446,"_5797":79545},[],"record the ingestion time and detect duplicates by ID;",{"_6892":743,"_42174":708,"_29767":79547,"_5":21387,"_28235":79446,"_5797":79548},[],"encrypt in transit and at rest;",{"_6892":744,"_42174":708,"_29767":79550,"_5":21387,"_28235":79446,"_5797":79551},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_6892":745,"_42174":708,"_29767":79553,"_5":21387,"_28235":79446,"_5797":79554},[],"apply an explicit retention and legal hold policy;",{"_6892":746,"_42174":708,"_29767":79556,"_5":21387,"_28235":79446,"_5797":79557},[],"alert if it stops consuming or the pending queue grows.",{"_6892":747,"_42174":708,"_29767":79559,"_5":21387,"_28235":79450,"_5797":79560},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_6892":748,"_42174":708,"_29767":79562,"_5":21387,"_28235":79450,"_5797":79563},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_6892":749,"_42174":708,"_29767":79565,"_5":21387,"_28235":79458,"_5797":79566},[],"Start from the reported time and normalize every source to UTC.",{"_6892":750,"_42174":708,"_29767":79568,"_5":21387,"_28235":79462,"_5797":79569},[],"Filter by event type, service source and resource identifier.",{"_6892":751,"_42174":708,"_29767":79571,"_5":21387,"_28235":79466,"_5797":79572},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_6892":752,"_42174":708,"_29767":79574,"_5":21387,"_28235":79470,"_5797":79575},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_6892":753,"_42174":708,"_29767":79577,"_5":21387,"_28235":79474,"_5797":79578},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_6892":754,"_42174":708,"_29767":79580,"_5":21387,"_28235":79478,"_5797":79581},[],"Generate a controlled mutation in a test environment and check that:",{"_6892":755,"_42174":708,"_29767":79583,"_5":21387,"_28235":79478,"_5797":79584},[],"a successful audit event appears;",{"_6892":756,"_42174":708,"_29767":79586,"_5":21387,"_28235":79478,"_5797":79587},[],"the principal matches the identity used;",{"_6892":757,"_42174":708,"_29767":79589,"_5":21387,"_28235":79478,"_5797":79590},[],"the consumer persists it exactly once;",{"_6892":758,"_42174":708,"_29767":79592,"_5":21387,"_28235":79478,"_5797":79593},[],"it can be retrieved by resource, actor and period;",{"_6892":759,"_42174":708,"_29767":79595,"_5":21387,"_28235":79478,"_5797":79596},[],"a consumer outage raises an alert.",{"_6892":760,"_42174":708,"_29767":79598,"_5":21387,"_28235":79478,"_5797":79599},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_6892":761,"_42174":761,"_5":21817,"_5797":79601,"_42654":79602,"_29767":79603,"_28235":761},"Platform architecture",[77248,78697],[],{"_6892":762,"_42174":761,"_29767":79605,"_5":21387,"_28235":761,"_5797":79606},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_6892":763,"_42174":761,"_5":42651,"_29767":79608,"_28235":79609,"_5797":79610},[],"/docs/pr-preview/pr-56/platform/concepts/architecture#control-plane","Control plane",{"_6892":764,"_42174":761,"_5":42651,"_29767":79612,"_28235":79613,"_5797":79614},[],"/docs/pr-preview/pr-56/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_6892":765,"_42174":761,"_5":42651,"_29767":79616,"_28235":79617,"_5797":79618},[],"/docs/pr-preview/pr-56/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_6892":766,"_42174":761,"_5":42651,"_29767":79620,"_28235":79621,"_5797":79622},[],"/docs/pr-preview/pr-56/platform/concepts/architecture#status-and-validation","Status and validation",{"_6892":767,"_42174":761,"_5":42651,"_29767":79624,"_28235":79625,"_5797":79626},[],"/docs/pr-preview/pr-56/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_6892":768,"_42174":761,"_29767":79628,"_5":21387,"_28235":761,"_5797":79629},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_6892":769,"_42174":761,"_29767":79631,"_5":21387,"_28235":761,"_5797":79632},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_6892":770,"_42174":761,"_29767":79634,"_5":21387,"_28235":79609,"_5797":79635},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_6892":771,"_42174":761,"_29767":79637,"_5":21387,"_28235":79613,"_5797":79638},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_6892":772,"_42174":761,"_29767":79640,"_5":21387,"_28235":79617,"_5797":79641},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_6892":773,"_42174":761,"_29767":79643,"_5":21387,"_28235":79621,"_5797":79644},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_6892":774,"_42174":761,"_29767":79646,"_5":21387,"_28235":79625,"_5797":79647},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_6892":775,"_42174":775,"_5":21817,"_5797":79649,"_42654":79650,"_29767":79651,"_28235":775},"How Lamassu works",[77248,78697],[],{"_6892":776,"_42174":775,"_29767":79653,"_5":21387,"_28235":775,"_5797":79654},[],"The mental model of trust, keys, certificates and devices.",{"_6892":777,"_42174":775,"_5":42651,"_29767":79656,"_28235":79657,"_5797":79658},[],"/docs/pr-preview/pr-56/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_6892":778,"_42174":775,"_5":42651,"_29767":79660,"_28235":79661,"_5797":79662},[],"/docs/pr-preview/pr-56/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_6892":779,"_42174":775,"_29767":79664,"_5":21387,"_28235":775,"_5797":79665},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_6892":780,"_42174":775,"_29767":79667,"_5":21387,"_28235":79657,"_5797":79668},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_6892":781,"_42174":775,"_29767":79670,"_5":21387,"_28235":79657,"_5797":79671},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_6892":782,"_42174":775,"_29767":79673,"_5":21387,"_28235":79657,"_5797":79674},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_6892":783,"_42174":775,"_29767":79676,"_5":21387,"_28235":79657,"_5797":79677},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_6892":784,"_42174":775,"_29767":79679,"_5":21387,"_28235":79657,"_5797":79680},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_6892":785,"_42174":775,"_29767":79682,"_5":21387,"_28235":79661,"_5797":79683},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_6892":786,"_42174":775,"_29767":79685,"_5":21387,"_28235":79661,"_5797":79686},[],"A DMS relates that CA to an enrollment policy.",{"_6892":787,"_42174":775,"_29767":79688,"_5":21387,"_28235":79661,"_5797":79689},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_6892":788,"_42174":775,"_29767":79691,"_5":21387,"_28235":79661,"_5797":79692},[],"Lamassu keeps the inventory, history and status of the identity.",{"_6892":789,"_42174":775,"_29767":79694,"_5":21387,"_28235":79661,"_5797":79695},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_6892":790,"_42174":775,"_29767":79697,"_5":21387,"_28235":79661,"_5797":79698},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_6892":791,"_42174":775,"_29767":79700,"_5":21387,"_28235":79661,"_5797":79701},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_6892":792,"_42174":792,"_5":21817,"_5797":79703,"_42654":79704,"_29767":79706,"_28235":792},"Devices and identities",[77248,78697,79705,79703],"IoT Fleets",[],{"_6892":793,"_42174":792,"_29767":79708,"_5":21387,"_28235":792,"_5797":79709},[],"Register, inspect and retire devices while checking their current identity and history.",{"_6892":794,"_42174":792,"_5":42651,"_29767":79711,"_28235":79712,"_5797":79713},[],"/docs/pr-preview/pr-56/platform/iot-fleets/device-management#device-states","Device states",{"_6892":795,"_42174":792,"_5":42651,"_29767":79715,"_28235":79716,"_5797":79717},[],"/docs/pr-preview/pr-56/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_6892":796,"_42174":792,"_5":42651,"_29767":79719,"_28235":79720,"_5797":79721},[],"/docs/pr-preview/pr-56/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_6892":797,"_42174":792,"_5":42651,"_29767":79723,"_28235":79724,"_5797":79725},[],"/docs/pr-preview/pr-56/platform/iot-fleets/device-management#create-the-device","Create the device",{"_6892":798,"_42174":792,"_5":42651,"_29767":79727,"_28235":79728,"_5797":79729},[],"/docs/pr-preview/pr-56/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_6892":799,"_42174":792,"_5":42651,"_29767":79731,"_28235":79732,"_5797":79733},[],"/docs/pr-preview/pr-56/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_6892":800,"_42174":792,"_5":42651,"_29767":79735,"_28235":79736,"_5797":79737},[],"/docs/pr-preview/pr-56/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_6892":801,"_42174":792,"_5":42651,"_29767":79739,"_28235":79740,"_5797":79741},[],"/docs/pr-preview/pr-56/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_6892":802,"_42174":792,"_5":42651,"_29767":79743,"_28235":79744,"_5797":79745},[],"/docs/pr-preview/pr-56/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_6892":803,"_42174":792,"_5":42651,"_29767":79747,"_28235":79748,"_5797":79749},[],"/docs/pr-preview/pr-56/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_6892":804,"_42174":792,"_5":42651,"_29767":79751,"_28235":79752,"_5797":79753},[],"/docs/pr-preview/pr-56/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_6892":805,"_42174":792,"_29767":79755,"_5":21387,"_28235":792,"_5797":79756},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_6892":806,"_42174":792,"_29767":79758,"_5":21387,"_28235":792,"_5797":79759},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_6892":807,"_42174":792,"_29767":79761,"_5":21387,"_28235":79712,"_5797":79762},[],"Operational view",{"_6892":808,"_42174":792,"_29767":79764,"_5":21387,"_28235":79712,"_5797":79765},[],"Meaning",{"_6892":809,"_42174":792,"_29767":79767,"_5":21387,"_28235":79712,"_5797":79768},[],"**No Identity**",{"_6892":810,"_42174":792,"_29767":79770,"_5":21387,"_28235":79712,"_5797":79771},[],"A record exists without an associated identity.",{"_6892":811,"_42174":792,"_29767":79773,"_5":21387,"_28235":79712,"_5797":79774},[],"**Active**",{"_6892":812,"_42174":792,"_29767":79776,"_5":21387,"_28235":79712,"_5797":79777},[],"The slot is active; also check certificate dates, status and usages.",{"_6892":813,"_42174":792,"_29767":79779,"_5":21387,"_28235":79712,"_5797":79780},[],"**Renewal Pending**",{"_6892":814,"_42174":792,"_29767":79782,"_5":21387,"_28235":79712,"_5797":79783},[],"The identity is in the operational renewal window.",{"_6892":815,"_42174":792,"_29767":79785,"_5":21387,"_28235":79712,"_5797":79786},[],"**Expiring Soon**",{"_6892":816,"_42174":792,"_29767":79788,"_5":21387,"_28235":79712,"_5797":79789},[],"Expiration is approaching according to configured thresholds.",{"_6892":817,"_42174":792,"_29767":79791,"_5":21387,"_28235":79712,"_5797":79792},[],"**Expired**",{"_6892":818,"_42174":792,"_29767":79794,"_5":21387,"_28235":79712,"_5797":79795},[],"The identity has expired.",{"_6892":819,"_42174":792,"_29767":79797,"_5":21387,"_28235":79712,"_5797":79798},[],"**Revoked**",{"_6892":820,"_42174":792,"_29767":79800,"_5":21387,"_28235":79712,"_5797":79801},[],"The identity is marked revoked.",{"_6892":821,"_42174":792,"_29767":79803,"_5":21387,"_28235":79712,"_5797":79804},[],"**Decommissioned**",{"_6892":822,"_42174":792,"_29767":79806,"_5":21387,"_28235":79712,"_5797":79807},[],"The record is retired and ordinary updates do not restore operation.",{"_6892":823,"_42174":792,"_29767":79809,"_5":21387,"_28235":79712,"_5797":79810},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_6892":824,"_42174":792,"_29767":79812,"_5":21387,"_28235":79716,"_5797":79813},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_6892":825,"_42174":792,"_29767":79815,"_5":21387,"_28235":79716,"_5797":79816},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_6892":826,"_42174":792,"_29767":79818,"_5":21387,"_28235":79716,"_5797":79819},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_6892":827,"_42174":792,"_29767":79821,"_5":21387,"_28235":79716,"_5797":79822},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_6892":828,"_42174":792,"_29767":79824,"_5":21387,"_28235":79720,"_5797":79825},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_6892":829,"_42174":792,"_29767":79827,"_5":21387,"_28235":79724,"_5797":79828},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_6892":830,"_42174":792,"_29767":79830,"_5":21387,"_28235":79728,"_5797":79831},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_6892":831,"_42174":792,"_29767":79833,"_5":21387,"_28235":79732,"_5797":79834},[],"Add model, environment or location tags and an icon according to your inventory.",{"_6892":832,"_42174":792,"_29767":79836,"_5":21387,"_28235":79736,"_5797":79837},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_6892":833,"_42174":792,"_29767":79839,"_5":21387,"_28235":79736,"_5797":79840},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_6892":834,"_42174":792,"_29767":79842,"_5":21387,"_28235":79740,"_5797":79843},[],"From **No Identity**, use **Assign Identity**:",{"_6892":835,"_42174":792,"_29767":79845,"_5":21387,"_28235":79740,"_5797":79846},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_6892":836,"_42174":792,"_29767":79848,"_5":21387,"_28235":79740,"_5797":79849},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_6892":837,"_42174":792,"_29767":79851,"_5":21387,"_28235":79740,"_5797":79852},[],"Confirm and read the serial, active version and history again.",{"_6892":838,"_42174":792,"_29767":79854,"_5":21387,"_28235":79740,"_5797":79855},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_6892":839,"_42174":792,"_29767":79857,"_5":21387,"_28235":79740,"_5797":79858},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_6892":840,"_42174":792,"_29767":79860,"_5":21387,"_28235":79744,"_5797":79861},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_6892":841,"_42174":792,"_29767":79863,"_5":21387,"_28235":79744,"_5797":79864},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_6892":842,"_42174":792,"_29767":79866,"_5":21387,"_28235":79748,"_5797":79867},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_6892":843,"_42174":792,"_29767":79869,"_5":21387,"_28235":79748,"_5797":79870},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_6892":844,"_42174":792,"_29767":79872,"_5":21387,"_28235":79748,"_5797":79873},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_6892":845,"_42174":792,"_29767":79875,"_5":21387,"_28235":79748,"_5797":79876},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_6892":846,"_42174":792,"_29767":79878,"_5":21387,"_28235":79752,"_5797":79879},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_6892":847,"_42174":792,"_29767":79881,"_5":21387,"_28235":79752,"_5797":79882},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_6892":848,"_42174":848,"_5":21817,"_5797":79884,"_42654":79885,"_29767":79887,"_28235":848},"Bootstrap identity and authentication",[77248,78697,79705,79703,79886],"Enrollment with PKI",[],{"_6892":849,"_42174":848,"_29767":79889,"_5":21387,"_28235":848,"_5797":79890},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_6892":850,"_42174":848,"_5":42651,"_29767":79892,"_28235":79893,"_5797":79894},[],"/docs/pr-preview/pr-56/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_6892":851,"_42174":848,"_5":42651,"_29767":79896,"_28235":79897,"_5797":79898},[],"/docs/pr-preview/pr-56/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_6892":852,"_42174":848,"_5":42651,"_29767":79900,"_28235":79901,"_5797":79902},[],"/docs/pr-preview/pr-56/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_6892":853,"_42174":848,"_5":42651,"_29767":79904,"_28235":79905,"_5797":79906},[],"/docs/pr-preview/pr-56/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_6892":854,"_42174":848,"_5":42651,"_29767":79908,"_28235":79909,"_5797":79910},[],"/docs/pr-preview/pr-56/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_6892":855,"_42174":848,"_29767":79912,"_5":21387,"_28235":848,"_5797":79913},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_6892":856,"_42174":848,"_29767":79915,"_5":21387,"_28235":79893,"_5797":79916},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_6892":857,"_42174":848,"_29767":79918,"_5":21387,"_28235":79893,"_5797":79919},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_6892":858,"_42174":848,"_29767":79921,"_5":21387,"_28235":79897,"_5797":79922},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_6892":859,"_42174":848,"_29767":79924,"_5":21387,"_28235":79897,"_5797":79925},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_6892":860,"_42174":848,"_29767":79927,"_5":21387,"_28235":79897,"_5797":79928},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_6892":861,"_42174":848,"_29767":79930,"_5":21387,"_28235":79901,"_5797":79931},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_6892":862,"_42174":848,"_29767":79933,"_5":21387,"_28235":79901,"_5797":79934},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_6892":863,"_42174":848,"_29767":79936,"_5":21387,"_28235":79905,"_5797":79937},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_6892":864,"_42174":848,"_29767":79939,"_5":21387,"_28235":79905,"_5797":79940},[],"Example body:",{"_6892":865,"_42174":848,"_29767":79942,"_5":21387,"_28235":79905,"_5797":79943},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_6892":866,"_42174":848,"_29767":79945,"_5":21387,"_28235":79905,"_5797":79946},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_6892":867,"_42174":848,"_29767":79948,"_5":21387,"_28235":79905,"_5797":79949},[],"Continuation requires a successful HTTP response and JSON:",{"_6892":868,"_42174":848,"_29767":79951,"_5":21387,"_28235":79905,"_5797":79952},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_6892":869,"_42174":848,"_29767":79954,"_5":21387,"_28235":79909,"_5797":79955},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_6892":870,"_42174":848,"_29767":79957,"_5":21387,"_28235":79909,"_5797":79958},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_6892":871,"_42174":871,"_5":21817,"_5797":79960,"_42654":79961,"_29767":79962,"_28235":871},"Configure and operate the DMS",[77248,78697,79705,79703,79886],[],{"_6892":872,"_42174":871,"_29767":79964,"_5":21387,"_28235":871,"_5797":79965},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_6892":873,"_42174":871,"_5":42651,"_29767":79967,"_28235":79968,"_5797":77258},[],"/docs/pr-preview/pr-56/platform/iot-fleets/enrollment/dms#before-you-begin",{"_6892":874,"_42174":871,"_5":42651,"_29767":79970,"_28235":79971,"_5797":79972},[],"/docs/pr-preview/pr-56/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_6892":875,"_42174":871,"_5":42651,"_29767":79974,"_28235":79975,"_5797":79976},[],"/docs/pr-preview/pr-56/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_6892":876,"_42174":871,"_5":42651,"_29767":79978,"_28235":79979,"_5797":79980},[],"/docs/pr-preview/pr-56/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_6892":877,"_42174":871,"_5":42651,"_29767":79982,"_28235":79983,"_5797":79984},[],"/docs/pr-preview/pr-56/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_6892":878,"_42174":871,"_5":42651,"_29767":79986,"_28235":79987,"_5797":79988},[],"/docs/pr-preview/pr-56/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_6892":879,"_42174":871,"_5":42651,"_29767":79990,"_28235":79991,"_5797":79992},[],"/docs/pr-preview/pr-56/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_6892":880,"_42174":871,"_5":42651,"_29767":79994,"_28235":79995,"_5797":79996},[],"/docs/pr-preview/pr-56/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_6892":881,"_42174":871,"_5":42651,"_29767":79998,"_28235":79999,"_5797":80000},[],"/docs/pr-preview/pr-56/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_6892":882,"_42174":871,"_5":42651,"_29767":80002,"_28235":80003,"_5797":80004},[],"/docs/pr-preview/pr-56/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_6892":883,"_42174":871,"_5":42651,"_29767":80006,"_28235":80007,"_5797":80008},[],"/docs/pr-preview/pr-56/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_6892":884,"_42174":871,"_5":42651,"_29767":80010,"_28235":80011,"_5797":80012},[],"/docs/pr-preview/pr-56/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_6892":885,"_42174":871,"_5":42651,"_29767":80014,"_28235":80015,"_5797":80016},[],"/docs/pr-preview/pr-56/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_6892":886,"_42174":871,"_5":42651,"_29767":80018,"_28235":80019,"_5797":80020},[],"/docs/pr-preview/pr-56/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_6892":887,"_42174":871,"_5":42651,"_29767":80022,"_28235":80023,"_5797":80024},[],"/docs/pr-preview/pr-56/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_6892":888,"_42174":871,"_5":42651,"_29767":80026,"_28235":80027,"_5797":80028},[],"/docs/pr-preview/pr-56/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_6892":889,"_42174":871,"_5":42651,"_29767":80030,"_28235":80031,"_5797":80032},[],"/docs/pr-preview/pr-56/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_6892":890,"_42174":871,"_5":42651,"_29767":80034,"_28235":80035,"_5797":80036},[],"/docs/pr-preview/pr-56/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_6892":891,"_42174":871,"_29767":80038,"_5":21387,"_28235":871,"_5797":80039},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_6892":892,"_42174":871,"_29767":80041,"_5":21387,"_28235":79968,"_5797":80042},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_6892":893,"_42174":871,"_29767":80044,"_5":21387,"_28235":79968,"_5797":80045},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_6892":894,"_42174":871,"_29767":80047,"_5":21387,"_28235":79975,"_5797":80048},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_6892":895,"_42174":871,"_29767":80050,"_5":21387,"_28235":79979,"_5797":80051},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_6892":896,"_42174":871,"_29767":80053,"_5":21387,"_28235":79983,"_5797":80054},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_6892":897,"_42174":871,"_29767":80056,"_5":21387,"_28235":79987,"_5797":80057},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_6892":898,"_42174":871,"_29767":80059,"_5":21387,"_28235":79991,"_5797":80060},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_6892":899,"_42174":871,"_29767":80062,"_5":21387,"_28235":79999,"_5797":80063},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_6892":900,"_42174":871,"_29767":80065,"_5":21387,"_28235":79999,"_5797":80066},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_6892":901,"_42174":871,"_29767":80068,"_5":21387,"_28235":80003,"_5797":80069},[],"`settings.enrollment_settings` field",{"_6892":902,"_42174":871,"_29767":80071,"_5":21387,"_28235":80003,"_5797":80072},[],"Decision",{"_6892":903,"_42174":871,"_29767":80074,"_5":21387,"_28235":80003,"_5797":80075},[],"`protocol`",{"_6892":904,"_42174":871,"_29767":80077,"_5":21387,"_28235":80003,"_5797":80078},[],"`EST_RFC7030` for these operations.",{"_6892":905,"_42174":871,"_29767":80080,"_5":21387,"_28235":80003,"_5797":80081},[],"`enrollment_ca`",{"_6892":906,"_42174":871,"_29767":80083,"_5":21387,"_28235":80003,"_5797":80084},[],"ID of the signing CA.",{"_6892":907,"_42174":871,"_29767":80086,"_5":21387,"_28235":80003,"_5797":80087},[],"`verify_csr_signature`",{"_6892":908,"_42174":871,"_29767":80089,"_5":21387,"_28235":80003,"_5797":80090},[],"Keep `true` to verify CSR key possession.",{"_6892":909,"_42174":871,"_29767":80092,"_5":21387,"_28235":80003,"_5797":80093},[],"`enable_replaceable_enrollment`",{"_6892":910,"_42174":871,"_29767":80095,"_5":21387,"_28235":80003,"_5797":80096},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_6892":911,"_42174":871,"_29767":80098,"_5":21387,"_28235":80003,"_5797":80099},[],"`est_rfc7030_settings.auth_mode`",{"_6892":912,"_42174":871,"_29767":80101,"_5":21387,"_28235":80003,"_5797":80102},[],"One of the four authentication modes.",{"_6892":913,"_42174":871,"_29767":80104,"_5":21387,"_28235":80003,"_5797":80105},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_6892":914,"_42174":871,"_29767":80107,"_5":21387,"_28235":80007,"_5797":80108},[],"The blocks are independent:",{"_6892":915,"_42174":871,"_29767":80110,"_5":21387,"_28235":80007,"_5797":80111},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_6892":916,"_42174":871,"_29767":80113,"_5":21387,"_28235":80007,"_5797":80114},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_6892":917,"_42174":871,"_29767":80116,"_5":21387,"_28235":80007,"_5797":80117},[],"`auth_mode`",{"_6892":918,"_42174":871,"_29767":80119,"_5":21387,"_28235":80007,"_5797":80120},[],"Control applied in the configured operation",{"_6892":919,"_42174":871,"_29767":80122,"_5":21387,"_28235":80007,"_5797":80123},[],"`CLIENT_CERTIFICATE`",{"_6892":920,"_42174":871,"_29767":80125,"_5":21387,"_28235":80007,"_5797":80126},[],"Presented certificate validation.",{"_6892":921,"_42174":871,"_29767":80128,"_5":21387,"_28235":80007,"_5797":80129},[],"`EXTERNAL_WEBHOOK`",{"_6892":922,"_42174":871,"_29767":80131,"_5":21387,"_28235":80007,"_5797":80132},[],"Configured webhook authorization.",{"_6892":923,"_42174":871,"_29767":80134,"_5":21387,"_28235":80007,"_5797":80135},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_6892":924,"_42174":871,"_29767":80137,"_5":21387,"_28235":80007,"_5797":80138},[],"Certificate validation followed by webhook approval.",{"_6892":925,"_42174":871,"_29767":80140,"_5":21387,"_28235":80007,"_5797":80141},[],"`NO_AUTH`",{"_6892":926,"_42174":871,"_29767":80143,"_5":21387,"_28235":80007,"_5797":80144},[],"No DMS requester authentication.",{"_6892":927,"_42174":871,"_29767":80146,"_5":21387,"_28235":80007,"_5797":80147},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_6892":928,"_42174":871,"_29767":80149,"_5":21387,"_28235":80007,"_5797":80150},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_6892":929,"_42174":871,"_29767":80152,"_5":21387,"_28235":80007,"_5797":80153},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs. That list is optional because the enrollment CA is always trusted for re-enrollment, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`.",{"_6892":930,"_42174":871,"_29767":80155,"_5":21387,"_28235":80007,"_5797":80156},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_6892":931,"_42174":871,"_29767":80158,"_5":21387,"_28235":80011,"_5797":80159},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_6892":932,"_42174":871,"_29767":80161,"_5":21387,"_28235":80011,"_5797":80162},[],"`external_webhook_settings` field",{"_6892":933,"_42174":871,"_29767":80164,"_5":21387,"_28235":80011,"_5797":80072},[],{"_6892":934,"_42174":871,"_29767":80166,"_5":21387,"_28235":80011,"_5797":80167},[],"`url`",{"_6892":935,"_42174":871,"_29767":80169,"_5":21387,"_28235":80011,"_5797":80170},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_6892":936,"_42174":871,"_29767":80172,"_5":21387,"_28235":80011,"_5797":80173},[],"`method`",{"_6892":937,"_42174":871,"_29767":80175,"_5":21387,"_28235":80011,"_5797":80176},[],"`POST` or `PUT`; `POST` by default.",{"_6892":938,"_42174":871,"_29767":80178,"_5":21387,"_28235":80011,"_5797":80179},[],"`name`",{"_6892":939,"_42174":871,"_29767":80181,"_5":21387,"_28235":80011,"_5797":80182},[],"Label used in service logs.",{"_6892":940,"_42174":871,"_29767":80184,"_5":21387,"_28235":80011,"_5797":80185},[],"`config.auth_mode`",{"_6892":941,"_42174":871,"_29767":80187,"_5":21387,"_28235":80011,"_5797":80188},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_6892":942,"_42174":871,"_29767":80190,"_5":21387,"_28235":80011,"_5797":80191},[],"`config.log_level`",{"_6892":943,"_42174":871,"_29767":80193,"_5":21387,"_28235":80011,"_5797":80194},[],"Log level of the webhook call: `debug`, `info`, `warn` or `error`; `info` by default.",{"_6892":944,"_42174":871,"_29767":80196,"_5":21387,"_28235":80011,"_5797":80197},[],"`config.apikey_options`",{"_6892":945,"_42174":871,"_29767":80199,"_5":21387,"_28235":80011,"_5797":80200},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_6892":946,"_42174":871,"_29767":80202,"_5":21387,"_28235":80011,"_5797":80203},[],"`config.jwt_options`",{"_6892":947,"_42174":871,"_29767":80205,"_5":21387,"_28235":80011,"_5797":80206},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_6892":948,"_42174":871,"_29767":80208,"_5":21387,"_28235":80011,"_5797":80209},[],"`config.mtls_options`",{"_6892":949,"_42174":871,"_29767":80211,"_5":21387,"_28235":80011,"_5797":80212},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_6892":950,"_42174":871,"_29767":80214,"_5":21387,"_28235":80011,"_5797":80215},[],"`config.insecure_skip_verify`",{"_6892":951,"_42174":871,"_29767":80217,"_5":21387,"_28235":80011,"_5797":80218},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_6892":952,"_42174":871,"_29767":80220,"_5":21387,"_28235":80011,"_5797":80221},[],"`config.call_timeout`",{"_6892":953,"_42174":871,"_29767":80223,"_5":21387,"_28235":80011,"_5797":80224},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_6892":954,"_42174":871,"_29767":80226,"_5":21387,"_28235":80011,"_5797":80227},[],"Rules for that configuration:",{"_6892":955,"_42174":871,"_29767":80229,"_5":21387,"_28235":80011,"_5797":80230},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_6892":956,"_42174":871,"_29767":80232,"_5":21387,"_28235":80011,"_5797":80233},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_6892":957,"_42174":871,"_29767":80235,"_5":21387,"_28235":80011,"_5797":80236},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_6892":958,"_42174":871,"_29767":80238,"_5":21387,"_28235":80011,"_5797":80239},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_6892":959,"_42174":871,"_29767":80241,"_5":21387,"_28235":80011,"_5797":80242},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_6892":960,"_42174":871,"_29767":80244,"_5":21387,"_28235":80011,"_5797":80245},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_6892":961,"_42174":871,"_29767":80247,"_5":21387,"_28235":80011,"_5797":80248},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing. The console exposes independent editors for the enrollment and re-enrollment authentication, with the same Log Level, Call Timeout, HTTP Authentication and credential fields as the webhook channels, plus a **Skip TLS Verification** switch (off by default, so verification stays on; the console warns when you enable it).",{"_6892":962,"_42174":871,"_29767":80250,"_5":21387,"_28235":80011,"_5797":80251},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. To fix it in the console, open the DMS, replace any file-path value with PEM content — the editor rejects file paths with an inline field error — and save. Saving rewrites `external_webhook_settings.config` with the current keys, and the console reads both plain and Base64-encoded PEM from migrated configurations and stores the material Base64-encoded. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_6892":963,"_42174":871,"_29767":80253,"_5":21387,"_28235":80011,"_5797":80254},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_6892":964,"_42174":871,"_29767":80256,"_5":21387,"_28235":80015,"_5797":80257},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_6892":965,"_42174":871,"_29767":80259,"_5":21387,"_28235":80019,"_5797":80260},[],"`settings.reenrollment_settings` field",{"_6892":966,"_42174":871,"_29767":80262,"_5":21387,"_28235":80019,"_5797":77638},[],{"_6892":967,"_42174":871,"_29767":80264,"_5":21387,"_28235":80019,"_5797":80265},[],"`reenrollment_delta`",{"_6892":968,"_42174":871,"_29767":80267,"_5":21387,"_28235":80019,"_5797":80268},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_6892":969,"_42174":871,"_29767":80270,"_5":21387,"_28235":80019,"_5797":80271},[],"`preventive_delta`",{"_6892":970,"_42174":871,"_29767":80273,"_5":21387,"_28235":80019,"_5797":80274},[],"Preventive operational monitoring threshold.",{"_6892":971,"_42174":871,"_29767":80276,"_5":21387,"_28235":80019,"_5797":80277},[],"`critical_delta`",{"_6892":972,"_42174":871,"_29767":80279,"_5":21387,"_28235":80019,"_5797":80280},[],"Critical operational monitoring threshold.",{"_6892":973,"_42174":871,"_29767":80282,"_5":21387,"_28235":80019,"_5797":80283},[],"`enable_expired_renewal`",{"_6892":974,"_42174":871,"_29767":80285,"_5":21387,"_28235":80019,"_5797":80286},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_6892":975,"_42174":871,"_29767":80288,"_5":21387,"_28235":80019,"_5797":80289},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_6892":976,"_42174":871,"_29767":80291,"_5":21387,"_28235":80019,"_5797":80292},[],"Re-enrollment validation CAs for the renewal mTLS credential, tried after the enrollment CA; optional, because the enrollment CA is always trusted. Typically populated during CA rotation while old-CA cohorts renew.",{"_6892":977,"_42174":871,"_29767":80294,"_5":21387,"_28235":80019,"_5797":80295},[],"`revoke_on_reenrollment`",{"_6892":978,"_42174":871,"_29767":80297,"_5":21387,"_28235":80019,"_5797":80298},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_6892":979,"_42174":871,"_29767":80300,"_5":21387,"_28235":80019,"_5797":80301},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_6892":980,"_42174":871,"_29767":80303,"_5":21387,"_28235":80023,"_5797":80304},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. The console exposes it through an **Enable server-side key generation** switch and a **Key type** selection: `ECDSA` P-256, P-384 or P-521, or `RSA` with 2048, 3072 or 4096 bits; the defaults are P-256 for `ECDSA` and 4096 bit for `RSA`. Algorithm and size come from its `key` field, stored as `{type,bits}` where P-256, P-384 and P-521 map to `bits` 256, 384 and 521; `key` is omitted when disabled. The profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_6892":981,"_42174":871,"_29767":80306,"_5":21387,"_28235":80027,"_5797":77632},[],{"_6892":982,"_42174":871,"_29767":80308,"_5":21387,"_28235":80027,"_5797":80309},[],"Published material",{"_6892":983,"_42174":871,"_29767":80311,"_5":21387,"_28235":80027,"_5797":80312},[],"**Include Lamassu System CA**",{"_6892":984,"_42174":871,"_29767":80314,"_5":21387,"_28235":80027,"_5797":80315},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_6892":985,"_42174":871,"_29767":80317,"_5":21387,"_28235":80027,"_5797":80318},[],"**Include Enrollment CA**",{"_6892":986,"_42174":871,"_29767":80320,"_5":21387,"_28235":80027,"_5797":80321},[],"Selected issuing CA certificate.",{"_6892":987,"_42174":871,"_29767":80323,"_5":21387,"_28235":80027,"_5797":80324},[],"**Managed CAs**",{"_6892":988,"_42174":871,"_29767":80326,"_5":21387,"_28235":80027,"_5797":80327},[],"Explicitly selected CA certificates.",{"_6892":989,"_42174":871,"_29767":80329,"_5":21387,"_28235":80027,"_5797":80330},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_6892":990,"_42174":871,"_29767":80332,"_5":21387,"_28235":80031,"_5797":80333},[],"**Edit** changes name, settings and metadata. Updates go through the DMS API. `PUT /v1/dms/{id}` always targets the DMS identified by the URL path: the body carries no `id` field, and any `id` or `creation_ts` in it is silently ignored — authorization is evaluated against the same URL identifier. The body must include a non-empty `name` and a `settings` object; missing either returns HTTP 400 and leaves the stored DMS unchanged. `name` and `settings` are always full replacements, so read the DMS before sending API edits to avoid losing fields. `metadata` is optional: omitting it or sending `null` keeps the stored metadata, a supplied object replaces it entirely, and `{}` clears it (a later GET returns an empty object, not `null`). Old-style bodies that carry the full DMS object keep working while they include `name` and `settings`; unknown fields are ignored. Updates reject an empty `name` with HTTP 400: a DMS whose stored name was zeroed by an earlier update must be renamed before any client round-trips it — the AWS IoT connector’s JITP writeback included. If the object does not include the AWS IoT connector key (`lamassu.io/iot/{connector_id}`), the connector ignores the DMS's later events.",{"_6892":991,"_42174":871,"_29767":80335,"_5":21387,"_28235":80031,"_5797":80336},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_6892":992,"_42174":871,"_29767":80338,"_5":21387,"_28235":80031,"_5797":80339},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_6892":993,"_42174":871,"_29767":80341,"_5":21387,"_28235":80035,"_5797":80342},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_6892":994,"_42174":994,"_5":21817,"_5797":80344,"_42654":80345,"_29767":80346,"_28235":994},"Integrate the EST client",[77248,78697,79705,79703,79886],[],{"_6892":995,"_42174":994,"_29767":80348,"_5":21387,"_28235":994,"_5797":80349},[],"Prepare trust, send a CSR and check the identity you receive.",{"_6892":996,"_42174":994,"_5":42651,"_29767":80351,"_28235":80352,"_5797":77258},[],"/docs/pr-preview/pr-56/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_6892":997,"_42174":994,"_5":42651,"_29767":80354,"_28235":80355,"_5797":80356},[],"/docs/pr-preview/pr-56/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_6892":998,"_42174":994,"_5":42651,"_29767":80358,"_28235":80359,"_5797":80360},[],"/docs/pr-preview/pr-56/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_6892":999,"_42174":994,"_5":42651,"_29767":80362,"_28235":80363,"_5797":80364},[],"/docs/pr-preview/pr-56/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_6892":1000,"_42174":994,"_5":42651,"_29767":80366,"_28235":80367,"_5797":80368},[],"/docs/pr-preview/pr-56/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_6892":1001,"_42174":994,"_5":42651,"_29767":80370,"_28235":80371,"_5797":80372},[],"/docs/pr-preview/pr-56/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_6892":1002,"_42174":994,"_29767":80374,"_5":21387,"_28235":994,"_5797":80375},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_6892":1003,"_42174":994,"_29767":80377,"_5":21387,"_28235":80352,"_5797":80378},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_6892":1004,"_42174":994,"_29767":80380,"_5":21387,"_28235":80352,"_5797":80381},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_6892":1005,"_42174":994,"_29767":80383,"_5":21387,"_28235":80352,"_5797":80384},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_6892":1006,"_42174":994,"_29767":80386,"_5":21387,"_28235":80355,"_5797":80387},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_6892":1007,"_42174":994,"_29767":80389,"_5":21387,"_28235":80355,"_5797":80390},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_6892":1008,"_42174":994,"_29767":80392,"_5":21387,"_28235":80359,"_5797":80393},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_6892":1009,"_42174":994,"_29767":80395,"_5":21387,"_28235":80359,"_5797":80396},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_6892":1010,"_42174":994,"_29767":80398,"_5":21387,"_28235":80363,"_5797":80399},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_6892":1011,"_42174":994,"_29767":80401,"_5":21387,"_28235":80363,"_5797":80402},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_6892":1012,"_42174":994,"_29767":80404,"_5":21387,"_28235":80367,"_5797":80405},[],"For a root that issues directly:",{"_6892":1013,"_42174":994,"_29767":80407,"_5":21387,"_28235":80367,"_5797":80408},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_6892":1014,"_42174":994,"_29767":80410,"_5":21387,"_28235":80367,"_5797":80411},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_6892":1015,"_42174":994,"_29767":80413,"_5":21387,"_28235":80371,"_5797":80414},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_6892":1016,"_42174":1016,"_5":21817,"_5797":80416,"_42654":80417,"_29767":80418,"_28235":1016},"EST reference",[77248,78697,79705,79703,79886],[],{"_6892":1017,"_42174":1016,"_29767":80420,"_5":21387,"_28235":1016,"_5797":80421},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_6892":1018,"_42174":1016,"_5":42651,"_29767":80423,"_28235":80424,"_5797":80425},[],"/docs/pr-preview/pr-56/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_6892":1019,"_42174":1016,"_5":42651,"_29767":80427,"_28235":80428,"_5797":31944},[],"/docs/pr-preview/pr-56/platform/iot-fleets/enrollment/est-reference#cacerts",{"_6892":1020,"_42174":1016,"_5":42651,"_29767":80430,"_28235":80431,"_5797":36148},[],"/docs/pr-preview/pr-56/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_6892":1021,"_42174":1016,"_5":42651,"_29767":80433,"_28235":80434,"_5797":36155},[],"/docs/pr-preview/pr-56/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_6892":1022,"_42174":1016,"_5":42651,"_29767":80436,"_28235":80437,"_5797":35249},[],"/docs/pr-preview/pr-56/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_6892":1023,"_42174":1016,"_5":42651,"_29767":80439,"_28235":80440,"_5797":80441},[],"/docs/pr-preview/pr-56/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_6892":1024,"_42174":1016,"_5":42651,"_29767":80443,"_28235":80444,"_5797":80445},[],"/docs/pr-preview/pr-56/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_6892":1025,"_42174":1016,"_5":42651,"_29767":80447,"_28235":80448,"_5797":80449},[],"/docs/pr-preview/pr-56/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_6892":1026,"_42174":1016,"_29767":80451,"_5":21387,"_28235":1016,"_5797":80452},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_6892":1027,"_42174":1016,"_29767":80454,"_5":21387,"_28235":80424,"_5797":80455},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_6892":1028,"_42174":1016,"_29767":80457,"_5":21387,"_28235":80424,"_5797":80458},[],"Operation",{"_6892":1029,"_42174":1016,"_29767":80460,"_5":21387,"_28235":80424,"_5797":80461},[],"Method",{"_6892":1030,"_42174":1016,"_29767":80463,"_5":21387,"_28235":80424,"_5797":80464},[],"Authentication and condition",{"_6892":1031,"_42174":1016,"_29767":80466,"_5":21387,"_28235":80424,"_5797":80467},[],"`/cacerts`",{"_6892":1032,"_42174":1016,"_29767":80469,"_5":21387,"_28235":80424,"_5797":80470},[],"GET",{"_6892":1033,"_42174":1016,"_29767":80472,"_5":21387,"_28235":80424,"_5797":80473},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_6892":1034,"_42174":1016,"_29767":80475,"_5":21387,"_28235":80424,"_5797":80476},[],"`/simpleenroll`",{"_6892":1035,"_42174":1016,"_29767":80478,"_5":21387,"_28235":80424,"_5797":80479},[],"POST",{"_6892":1036,"_42174":1016,"_29767":80481,"_5":21387,"_28235":80424,"_5797":80482},[],"Initial authentication and DMS registration/replacement policy.",{"_6892":1037,"_42174":1016,"_29767":80484,"_5":21387,"_28235":80424,"_5797":80485},[],"`/simplereenroll`",{"_6892":1038,"_42174":1016,"_29767":80487,"_5":21387,"_28235":80424,"_5797":80479},[],{"_6892":1039,"_42174":1016,"_29767":80489,"_5":21387,"_28235":80424,"_5797":80490},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_6892":1040,"_42174":1016,"_29767":80492,"_5":21387,"_28235":80424,"_5797":80493},[],"`/serverkeygen`",{"_6892":1041,"_42174":1016,"_29767":80495,"_5":21387,"_28235":80424,"_5797":80479},[],{"_6892":1042,"_42174":1016,"_29767":80497,"_5":21387,"_28235":80424,"_5797":80498},[],"Initial authentication and admission; server generation enabled.",{"_6892":1043,"_42174":1016,"_29767":80500,"_5":21387,"_28235":80424,"_5797":80501},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_6892":1044,"_42174":1016,"_29767":80503,"_5":21387,"_28235":80428,"_5797":80504},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_6892":1045,"_42174":1016,"_29767":80506,"_5":21387,"_28235":80428,"_5797":80507},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_6892":1046,"_42174":1016,"_29767":80509,"_5":21387,"_28235":80431,"_5797":80510},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_6892":1047,"_42174":1016,"_29767":80512,"_5":21387,"_28235":80431,"_5797":80513},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_6892":1048,"_42174":1016,"_29767":80515,"_5":21387,"_28235":80434,"_5797":80516},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_6892":1049,"_42174":1016,"_29767":80518,"_5":21387,"_28235":80434,"_5797":80519},[],"In mTLS mode, the enrollment CA always validates the re-enrollment credential; certificates from other issuers are accepted only if they are listed as validation CAs in the re-enrollment block. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_6892":1050,"_42174":1016,"_29767":80521,"_5":21387,"_28235":80437,"_5797":80522},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_6892":1051,"_42174":1016,"_29767":80524,"_5":21387,"_28235":80437,"_5797":80525},[],"The code supports RSA and ECDSA, and the `bits` value of the DMS key setting means something different for each. For ECDSA it selects the curve: 224, 256, 384 or 521 map to P-224, P-256, P-384 and P-521, and an unrecognized size falls back to P-256, so explicitly select a compatible size and check the resulting key. For RSA it is used directly as the modulus size; the console offers 2048, 3072 and 4096 bits. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_6892":1052,"_42174":1016,"_29767":80527,"_5":21387,"_28235":80440,"_5797":80528},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_6892":1053,"_42174":1016,"_29767":80530,"_5":21387,"_28235":80440,"_5797":80531},[],"Part",{"_6892":1054,"_42174":1016,"_29767":80533,"_5":21387,"_28235":80440,"_5797":80534},[],"Content after decoding its Base64",{"_6892":1055,"_42174":1016,"_29767":80536,"_5":21387,"_28235":80440,"_5797":80537},[],"`application/pkcs8`",{"_6892":1056,"_42174":1016,"_29767":80539,"_5":21387,"_28235":80440,"_5797":80540},[],"Unencrypted DER PKCS#8 private key.",{"_6892":1057,"_42174":1016,"_29767":80542,"_5":21387,"_28235":80440,"_5797":80543},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_6892":1058,"_42174":1016,"_29767":80545,"_5":21387,"_28235":80440,"_5797":80546},[],"DER PKCS#7 containing the issued certificate.",{"_6892":1059,"_42174":1016,"_29767":80548,"_5":21387,"_28235":80440,"_5797":80549},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_6892":1060,"_42174":1016,"_29767":80551,"_5":21387,"_28235":80444,"_5797":80552},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_6892":1061,"_42174":1016,"_29767":80554,"_5":21387,"_28235":80444,"_5797":80555},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_6892":1062,"_42174":1016,"_29767":80557,"_5":21387,"_28235":80444,"_5797":80558},[],"Convert and check the result:",{"_6892":1063,"_42174":1016,"_29767":80560,"_5":21387,"_28235":80444,"_5797":80561},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_6892":1064,"_42174":1016,"_29767":80563,"_5":21387,"_28235":80448,"_5797":80564},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_6892":1065,"_42174":1016,"_29767":80566,"_5":21387,"_28235":80448,"_5797":80567},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_6892":1066,"_42174":1066,"_5":21817,"_5797":79886,"_42654":80569,"_29767":80570,"_28235":1066},[77248,78697,79705,79703,79886],[],{"_6892":1067,"_42174":1066,"_29767":80572,"_5":21387,"_28235":1066,"_5797":80573},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_6892":1068,"_42174":1066,"_5":42651,"_29767":80575,"_28235":80576,"_5797":80577},[],"/docs/pr-preview/pr-56/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_6892":1069,"_42174":1066,"_5":42651,"_29767":80579,"_28235":80580,"_5797":80581},[],"/docs/pr-preview/pr-56/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_6892":1070,"_42174":1066,"_5":42651,"_29767":80583,"_28235":80584,"_5797":80585},[],"/docs/pr-preview/pr-56/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_6892":1071,"_42174":1066,"_5":42651,"_29767":80587,"_28235":80588,"_5797":80589},[],"/docs/pr-preview/pr-56/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_6892":1072,"_42174":1066,"_29767":80591,"_5":21387,"_28235":1066,"_5797":80592},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_6892":1073,"_42174":1066,"_29767":80594,"_5":21387,"_28235":80576,"_5797":80595},[],"The administrator prepares the CA, issuance profile and DMS.",{"_6892":1074,"_42174":1066,"_29767":80597,"_5":21387,"_28235":80576,"_5797":80598},[],"The integrator installs initial EST server trust and an admission credential.",{"_6892":1075,"_42174":1066,"_29767":80600,"_5":21387,"_28235":80576,"_5797":80601},[],"The client requests an identity for its `Device ID` through EST.",{"_6892":1076,"_42174":1066,"_29767":80603,"_5":21387,"_28235":80576,"_5797":80604},[],"Certificate, device binding and key/certificate installation are checked.",{"_6892":1077,"_42174":1066,"_29767":80606,"_5":21387,"_28235":80576,"_5797":80607},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_6892":1078,"_42174":1066,"_29767":80609,"_5":21387,"_28235":80576,"_5797":80610},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_6892":1079,"_42174":1066,"_29767":80612,"_5":21387,"_28235":80580,"_5797":80613},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_6892":1080,"_42174":1066,"_29767":80615,"_5":21387,"_28235":80580,"_5797":80616},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_6892":1081,"_42174":1066,"_29767":80618,"_5":21387,"_28235":80580,"_5797":80619},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_6892":1082,"_42174":1066,"_29767":80621,"_5":21387,"_28235":80580,"_5797":80622},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_6892":1083,"_42174":1066,"_29767":80624,"_5":21387,"_28235":80584,"_5797":80625},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_6892":1084,"_42174":1066,"_29767":80627,"_5":21387,"_28235":80584,"_5797":80628},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_6892":1085,"_42174":1066,"_29767":80630,"_5":21387,"_28235":80584,"_5797":80631},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_6892":1086,"_42174":1066,"_29767":80633,"_5":21387,"_28235":80584,"_5797":80634},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_6892":1087,"_42174":1066,"_29767":80636,"_5":21387,"_28235":80588,"_5797":80637},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_6892":1088,"_42174":1066,"_29767":80639,"_5":21387,"_28235":80588,"_5797":80640},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_6892":1089,"_42174":1089,"_5":21817,"_5797":80642,"_42654":80643,"_29767":80644,"_28235":1089},"Provisioning strategies",[77248,78697,79705,79703,79886],[],{"_6892":1090,"_42174":1089,"_29767":80646,"_5":21387,"_28235":1089,"_5797":80647},[],"Choose device registration, identity authorization and key generation.",{"_6892":1091,"_42174":1089,"_5":42651,"_29767":80649,"_28235":80650,"_5797":80651},[],"/docs/pr-preview/pr-56/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_6892":1092,"_42174":1089,"_5":42651,"_29767":80653,"_28235":80654,"_5797":80655},[],"/docs/pr-preview/pr-56/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_6892":1093,"_42174":1089,"_5":42651,"_29767":80657,"_28235":80658,"_5797":80659},[],"/docs/pr-preview/pr-56/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_6892":1094,"_42174":1089,"_5":42651,"_29767":80661,"_28235":80662,"_5797":80663},[],"/docs/pr-preview/pr-56/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_6892":1095,"_42174":1089,"_5":42651,"_29767":80665,"_28235":80666,"_5797":80667},[],"/docs/pr-preview/pr-56/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_6892":1096,"_42174":1089,"_29767":80669,"_5":21387,"_28235":1089,"_5797":80670},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_6892":1097,"_42174":1089,"_29767":80672,"_5":21387,"_28235":80650,"_5797":80673},[],"Path",{"_6892":1098,"_42174":1089,"_29767":80675,"_5":21387,"_28235":80650,"_5797":80676},[],"When the device exists",{"_6892":1099,"_42174":1089,"_29767":80678,"_5":21387,"_28235":80650,"_5797":80679},[],"What to check",{"_6892":1100,"_42174":1089,"_29767":80681,"_5":21387,"_28235":80650,"_5797":80682},[],"Manual assignment",{"_6892":1101,"_42174":1089,"_29767":80684,"_5":21387,"_28235":80650,"_5797":80685},[],"An operator creates it before associating a certificate.",{"_6892":1102,"_42174":1089,"_29767":80687,"_5":21387,"_28235":80650,"_5797":80688},[],"ID, owning DMS, certificate CN and bound serial.",{"_6892":1103,"_42174":1089,"_29767":80690,"_5":21387,"_28235":80650,"_5797":80691},[],"EST with `JITP`",{"_6892":1104,"_42174":1089,"_29767":80693,"_5":21387,"_28235":80650,"_5797":80694},[],"Created for an unknown CN during `/simpleenroll`.",{"_6892":1105,"_42174":1089,"_29767":80696,"_5":21387,"_28235":80650,"_5797":80697},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_6892":1106,"_42174":1089,"_29767":80699,"_5":21387,"_28235":80650,"_5797":80700},[],"EST with `PRE_REGISTRATION`",{"_6892":1107,"_42174":1089,"_29767":80702,"_5":21387,"_28235":80650,"_5797":80703},[],"Must exist before `/simpleenroll`.",{"_6892":1108,"_42174":1089,"_29767":80705,"_5":21387,"_28235":80650,"_5797":80706},[],"Approved record, same DMS and replacement conditions for your version.",{"_6892":1109,"_42174":1089,"_29767":80708,"_5":21387,"_28235":80650,"_5797":80709},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_6892":1110,"_42174":1089,"_29767":80711,"_5":21387,"_28235":80650,"_5797":80712},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_6892":1111,"_42174":1089,"_29767":80714,"_5":21387,"_28235":80654,"_5797":80715},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_6892":1112,"_42174":1089,"_29767":80717,"_5":21387,"_28235":80654,"_5797":80718},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_6892":1113,"_42174":1089,"_29767":80720,"_5":21387,"_28235":80654,"_5797":80721},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_6892":1114,"_42174":1089,"_29767":80723,"_5":21387,"_28235":80658,"_5797":80724},[],"Decide initial enrollment and re-enrollment separately:",{"_6892":1115,"_42174":1089,"_29767":80726,"_5":21387,"_28235":80658,"_5797":80727},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_6892":1116,"_42174":1089,"_29767":80729,"_5":21387,"_28235":80658,"_5797":80730},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_6892":1117,"_42174":1089,"_29767":80732,"_5":21387,"_28235":80658,"_5797":80733},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_6892":1118,"_42174":1089,"_29767":80735,"_5":21387,"_28235":80658,"_5797":80736},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_6892":1119,"_42174":1089,"_29767":80738,"_5":21387,"_28235":80658,"_5797":80739},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_6892":1120,"_42174":1089,"_29767":80741,"_5":21387,"_28235":80662,"_5797":77632},[],{"_6892":1121,"_42174":1089,"_29767":80743,"_5":21387,"_28235":80662,"_5797":80744},[],"Material crossing EST",{"_6892":1122,"_42174":1089,"_29767":80746,"_5":21387,"_28235":80662,"_5797":80747},[],"Device-generated key",{"_6892":1123,"_42174":1089,"_29767":80749,"_5":21387,"_28235":80662,"_5797":80750},[],"Public CSR and certificate; the key stays on the client.",{"_6892":1124,"_42174":1089,"_29767":80752,"_5":21387,"_28235":80662,"_5797":80753},[],"Existing device key",{"_6892":1125,"_42174":1089,"_29767":80755,"_5":21387,"_28235":80662,"_5797":80756},[],"CSR signed with that key and a new certificate.",{"_6892":1126,"_42174":1089,"_29767":80758,"_5":21387,"_28235":80662,"_5797":80024},[],{"_6892":1127,"_42174":1089,"_29767":80760,"_5":21387,"_28235":80662,"_5797":80761},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_6892":1128,"_42174":1089,"_29767":80763,"_5":21387,"_28235":80662,"_5797":80764},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_6892":1129,"_42174":1089,"_29767":80766,"_5":21387,"_28235":80666,"_5797":80767},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_6892":1130,"_42174":1130,"_5":21817,"_5797":80769,"_42654":80770,"_29767":80771,"_28235":1130},"Renewal and recovery",[77248,78697,79705,79703,79886],[],{"_6892":1131,"_42174":1130,"_29767":80773,"_5":21387,"_28235":1130,"_5797":80774},[],"Renew without losing the identity and recover devices according to their actual state.",{"_6892":1132,"_42174":1130,"_5":42651,"_29767":80776,"_28235":80777,"_5797":80778},[],"/docs/pr-preview/pr-56/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_6892":1133,"_42174":1130,"_5":42651,"_29767":80780,"_28235":80781,"_5797":80782},[],"/docs/pr-preview/pr-56/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_6892":1134,"_42174":1130,"_5":42651,"_29767":80784,"_28235":80785,"_5797":80786},[],"/docs/pr-preview/pr-56/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_6892":1135,"_42174":1130,"_5":42651,"_29767":80788,"_28235":80789,"_5797":80790},[],"/docs/pr-preview/pr-56/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_6892":1136,"_42174":1130,"_5":42651,"_29767":80792,"_28235":80793,"_5797":80794},[],"/docs/pr-preview/pr-56/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_6892":1137,"_42174":1130,"_29767":80796,"_5":21387,"_28235":1130,"_5797":80797},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_6892":1138,"_42174":1130,"_29767":80799,"_5":21387,"_28235":80777,"_5797":80800},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_6892":1139,"_42174":1130,"_29767":80802,"_5":21387,"_28235":80777,"_5797":80803},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_6892":1140,"_42174":1130,"_29767":80805,"_5":21387,"_28235":80777,"_5797":80806},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_6892":1141,"_42174":1130,"_29767":80808,"_5":21387,"_28235":80777,"_5797":80809},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_6892":1142,"_42174":1130,"_29767":80811,"_5":21387,"_28235":80781,"_5797":80812},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_6892":1143,"_42174":1130,"_29767":80814,"_5":21387,"_28235":80781,"_5797":80815},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_6892":1144,"_42174":1130,"_29767":80817,"_5":21387,"_28235":80785,"_5797":80818},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_6892":1145,"_42174":1130,"_29767":80820,"_5":21387,"_28235":80785,"_5797":80821},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_6892":1146,"_42174":1130,"_29767":80823,"_5":21387,"_28235":80785,"_5797":80824},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_6892":1147,"_42174":1130,"_29767":80826,"_5":21387,"_28235":80789,"_5797":80827},[],"Situation",{"_6892":1148,"_42174":1130,"_29767":80829,"_5":21387,"_28235":80789,"_5797":80830},[],"Procedure",{"_6892":1149,"_42174":1130,"_29767":80832,"_5":21387,"_28235":80789,"_5797":80833},[],"Valid certificate, outside the window",{"_6892":1150,"_42174":1130,"_29767":80835,"_5":21387,"_28235":80789,"_5797":80836},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_6892":1151,"_42174":1130,"_29767":80838,"_5":21387,"_28235":80789,"_5797":80839},[],"Expired certificate, key available",{"_6892":1152,"_42174":1130,"_29767":80841,"_5":21387,"_28235":80789,"_5797":80842},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_6892":1153,"_42174":1130,"_29767":80844,"_5":21387,"_28235":80789,"_5797":80845},[],"Renewal through webhook or `NO_AUTH`",{"_6892":1154,"_42174":1130,"_29767":80847,"_5":21387,"_28235":80789,"_5797":80848},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_6892":1155,"_42174":1130,"_29767":80850,"_5":21387,"_28235":80789,"_5797":80851},[],"Lost or inaccessible key",{"_6892":1156,"_42174":1130,"_29767":80853,"_5":21387,"_28235":80789,"_5797":80854},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_6892":1157,"_42174":1130,"_29767":80856,"_5":21387,"_28235":80789,"_5797":80857},[],"Current identity revoked",{"_6892":1158,"_42174":1130,"_29767":80859,"_5":21387,"_28235":80789,"_5797":80860},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_6892":1159,"_42174":1130,"_29767":80862,"_5":21387,"_28235":80789,"_5797":80863},[],"Device without an identity",{"_6892":1160,"_42174":1130,"_29767":80865,"_5":21387,"_28235":80789,"_5797":80866},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_6892":1161,"_42174":1130,"_29767":80868,"_5":21387,"_28235":80789,"_5797":80869},[],"Retired device",{"_6892":1162,"_42174":1130,"_29767":80871,"_5":21387,"_28235":80789,"_5797":80872},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_6892":1163,"_42174":1130,"_29767":80874,"_5":21387,"_28235":80789,"_5797":80875},[],"Timeout, HTTP 500 or installation failure",{"_6892":1164,"_42174":1130,"_29767":80877,"_5":21387,"_28235":80789,"_5797":80878},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_6892":1165,"_42174":1130,"_29767":80880,"_5":21387,"_28235":80793,"_5797":80881},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_6892":1166,"_42174":1130,"_29767":80883,"_5":21387,"_28235":80793,"_5797":80884},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_6892":1167,"_42174":1167,"_5":21817,"_5797":80886,"_42654":80887,"_29767":80888,"_28235":1167},"Enrollment troubleshooting",[77248,78697,79705,79703,79886],[],{"_6892":1168,"_42174":1167,"_29767":80890,"_5":21387,"_28235":1167,"_5797":80891},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_6892":1169,"_42174":1167,"_5":42651,"_29767":80893,"_28235":80894,"_5797":80895},[],"/docs/pr-preview/pr-56/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_6892":1170,"_42174":1167,"_5":42651,"_29767":80897,"_28235":80898,"_5797":80899},[],"/docs/pr-preview/pr-56/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_6892":1171,"_42174":1167,"_5":42651,"_29767":80901,"_28235":80902,"_5797":80449},[],"/docs/pr-preview/pr-56/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_6892":1172,"_42174":1167,"_5":42651,"_29767":80904,"_28235":80905,"_5797":80906},[],"/docs/pr-preview/pr-56/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_6892":1173,"_42174":1167,"_29767":80908,"_5":21387,"_28235":1167,"_5797":80909},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_6892":1174,"_42174":1167,"_29767":80911,"_5":21387,"_28235":80898,"_5797":80912},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_6892":1175,"_42174":1167,"_29767":80914,"_5":21387,"_28235":80898,"_5797":80915},[],"Symptom or message",{"_6892":1176,"_42174":1167,"_29767":80917,"_5":21387,"_28235":80898,"_5797":80679},[],{"_6892":1177,"_42174":1167,"_29767":80919,"_5":21387,"_28235":80898,"_5797":80920},[],"curl rejects TLS, name or issuer",{"_6892":1178,"_42174":1167,"_29767":80922,"_5":21387,"_28235":80898,"_5797":80923},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_6892":1179,"_42174":1167,"_29767":80925,"_5":21387,"_28235":80898,"_5797":80926},[],"404 or missing APS",{"_6892":1180,"_42174":1167,"_29767":80928,"_5":21387,"_28235":80898,"_5797":80929},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_6892":1181,"_42174":1167,"_29767":80931,"_5":21387,"_28235":80898,"_5797":80932},[],"400, CSR or format error",{"_6892":1182,"_42174":1167,"_29767":80934,"_5":21387,"_28235":80898,"_5797":80935},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_6892":1183,"_42174":1167,"_29767":80937,"_5":21387,"_28235":80898,"_5797":80938},[],"Missing credential or invalid certificate",{"_6892":1184,"_42174":1167,"_29767":80940,"_5":21387,"_28235":80898,"_5797":80941},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_6892":1185,"_42174":1167,"_29767":80943,"_5":21387,"_28235":80898,"_5797":80944},[],"Webhook denies, times out or responds without authorization",{"_6892":1186,"_42174":1167,"_29767":80946,"_5":21387,"_28235":80898,"_5797":80947},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_6892":1187,"_42174":1167,"_29767":80949,"_5":21387,"_28235":80898,"_5797":80950},[],"`unexpected status code: <n>: redirects are not followed`",{"_6892":1188,"_42174":1167,"_29767":80952,"_5":21387,"_28235":80898,"_5797":80953},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_6892":1189,"_42174":1167,"_29767":80955,"_5":21387,"_28235":80898,"_5797":80956},[],"`webhook response exceeds 1048576 bytes`",{"_6892":1190,"_42174":1167,"_29767":80958,"_5":21387,"_28235":80898,"_5797":80959},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_6892":1191,"_42174":1167,"_29767":80961,"_5":21387,"_28235":80898,"_5797":80962},[],"`webhook config must not reference files`",{"_6892":1192,"_42174":1167,"_29767":80964,"_5":21387,"_28235":80898,"_5797":80965},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_6892":1193,"_42174":1167,"_29767":80967,"_5":21387,"_28235":80898,"_5797":80968},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_6892":1194,"_42174":1167,"_29767":80970,"_5":21387,"_28235":80898,"_5797":80971},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_6892":1195,"_42174":1167,"_29767":80973,"_5":21387,"_28235":80898,"_5797":80974},[],"`webhook mTLS certificate and key are invalid: …`",{"_6892":1196,"_42174":1167,"_29767":80976,"_5":21387,"_28235":80898,"_5797":80977},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_6892":1197,"_42174":1167,"_29767":80979,"_5":21387,"_28235":80898,"_5797":80980},[],"400 `struct validation error` creating or updating a DMS",{"_6892":1198,"_42174":1167,"_29767":80982,"_5":21387,"_28235":80898,"_5797":80983},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_6892":1199,"_42174":1167,"_29767":80985,"_5":21387,"_28235":80898,"_5797":80986},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_6892":1200,"_42174":1167,"_29767":80988,"_5":21387,"_28235":80898,"_5797":80989},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_6892":1201,"_42174":1167,"_29767":80991,"_5":21387,"_28235":80898,"_5797":80992},[],"`device not preregistered`",{"_6892":1202,"_42174":1167,"_29767":80994,"_5":21387,"_28235":80898,"_5797":80995},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_6892":1203,"_42174":1167,"_29767":80997,"_5":21387,"_28235":80898,"_5797":80998},[],"`forbiddenNewEnrollment`",{"_6892":1204,"_42174":1167,"_29767":81000,"_5":21387,"_28235":80898,"_5797":81001},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_6892":1205,"_42174":1167,"_29767":81003,"_5":21387,"_28235":80898,"_5797":81004},[],"Different owning DMS",{"_6892":1206,"_42174":1167,"_29767":81006,"_5":21387,"_28235":80898,"_5797":81007},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_6892":1207,"_42174":1167,"_29767":81009,"_5":21387,"_28235":80898,"_5797":81010},[],"`invalid RawSubject bytes`",{"_6892":1208,"_42174":1167,"_29767":81012,"_5":21387,"_28235":80898,"_5797":81013},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_6892":1209,"_42174":1167,"_29767":81015,"_5":21387,"_28235":80898,"_5797":81016},[],"`invalid reenroll window`",{"_6892":1210,"_42174":1167,"_29767":81018,"_5":21387,"_28235":80898,"_5797":81019},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_6892":1211,"_42174":1167,"_29767":81021,"_5":21387,"_28235":80898,"_5797":81022},[],"Current certificate revoked",{"_6892":1212,"_42174":1167,"_29767":81024,"_5":21387,"_28235":80898,"_5797":81025},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_6892":1213,"_42174":1167,"_29767":81027,"_5":21387,"_28235":80898,"_5797":81028},[],"CA, profile or signing error",{"_6892":1214,"_42174":1167,"_29767":81030,"_5":21387,"_28235":80898,"_5797":81031},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_6892":1215,"_42174":1167,"_29767":81033,"_5":21387,"_28235":80898,"_5797":81034},[],"HTTP 200 without a device connection",{"_6892":1216,"_42174":1167,"_29767":81036,"_5":21387,"_28235":80898,"_5797":81037},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_6892":1217,"_42174":1167,"_29767":81039,"_5":21387,"_28235":80898,"_5797":81040},[],"Timeout or error after issuance",{"_6892":1218,"_42174":1167,"_29767":81042,"_5":21387,"_28235":80898,"_5797":81043},[],"New certificates, current slot and previous identity's state before retrying.",{"_6892":1219,"_42174":1167,"_29767":81045,"_5":21387,"_28235":80902,"_5797":81046},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_6892":1220,"_42174":1167,"_29767":81048,"_5":21387,"_28235":80902,"_5797":81049},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_6892":1221,"_42174":1167,"_29767":81051,"_5":21387,"_28235":80905,"_5797":81052},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_6892":1222,"_42174":1167,"_29767":81054,"_5":21387,"_28235":80905,"_5797":81055},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_6892":1223,"_42174":1167,"_29767":81057,"_5":21387,"_28235":80905,"_5797":81058},[],"Verify the CSR locally and relate its CN to the inventory.",{"_6892":1224,"_42174":1167,"_29767":81060,"_5":21387,"_28235":80905,"_5797":81061},[],"Make one request, save headers/body and query the device and certificates.",{"_6892":1225,"_42174":1167,"_29767":81063,"_5":21387,"_28235":80905,"_5797":81064},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_6892":1226,"_42174":1167,"_29767":81066,"_5":21387,"_28235":80905,"_5797":81067},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_6892":1227,"_42174":1167,"_29767":81069,"_5":21387,"_28235":80905,"_5797":81070},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_6892":1228,"_42174":1228,"_5":21817,"_5797":81072,"_42654":81073,"_29767":81074,"_28235":1228},"Trust distribution and updates",[77248,78697,79705,79703,79886],[],{"_6892":1229,"_42174":1228,"_29767":81076,"_5":21387,"_28235":1228,"_5797":81077},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_6892":1230,"_42174":1228,"_5":42651,"_29767":81079,"_28235":81080,"_5797":81081},[],"/docs/pr-preview/pr-56/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_6892":1231,"_42174":1228,"_5":42651,"_29767":81083,"_28235":81084,"_5797":81085},[],"/docs/pr-preview/pr-56/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_6892":1232,"_42174":1228,"_5":42651,"_29767":81087,"_28235":81088,"_5797":81089},[],"/docs/pr-preview/pr-56/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_6892":1233,"_42174":1228,"_5":42651,"_29767":81091,"_28235":81092,"_5797":81093},[],"/docs/pr-preview/pr-56/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_6892":1234,"_42174":1228,"_5":42651,"_29767":81095,"_28235":81096,"_5797":81097},[],"/docs/pr-preview/pr-56/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_6892":1235,"_42174":1228,"_29767":81099,"_5":21387,"_28235":1228,"_5797":81100},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_6892":1236,"_42174":1228,"_29767":81102,"_5":21387,"_28235":81080,"_5797":81103},[],"Relationship",{"_6892":1237,"_42174":1228,"_29767":81105,"_5":21387,"_28235":81080,"_5797":81106},[],"Material prepared by its owner",{"_6892":1238,"_42174":1228,"_29767":81108,"_5":21387,"_28235":81080,"_5797":81109},[],"Device → EST server",{"_6892":1239,"_42174":1228,"_29767":81111,"_5":21387,"_28235":81080,"_5797":81112},[],"Previously verified server root, chain or pin and TLS name.",{"_6892":1240,"_42174":1228,"_29767":81114,"_5":21387,"_28235":81080,"_5797":81115},[],"DMS → requester",{"_6892":1241,"_42174":1228,"_29767":81117,"_5":21387,"_28235":81080,"_5797":81118},[],"CAs and rules authorizing initial or renewal credentials.",{"_6892":1242,"_42174":1228,"_29767":81120,"_5":21387,"_28235":81080,"_5797":81121},[],"Consumer → device",{"_6892":1243,"_42174":1228,"_29767":81123,"_5":21387,"_28235":81080,"_5797":81124},[],"Operational identity roots, intermediates, validation and permissions.",{"_6892":1244,"_42174":1228,"_29767":81126,"_5":21387,"_28235":81080,"_5797":81127},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_6892":1245,"_42174":1228,"_29767":81129,"_5":21387,"_28235":81084,"_5797":81130},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_6892":1246,"_42174":1228,"_29767":81132,"_5":21387,"_28235":81084,"_5797":81133},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_6892":1247,"_42174":1228,"_29767":81135,"_5":21387,"_28235":81088,"_5797":81136},[],"Keep initial EST server trust separate from identity consumer trust.",{"_6892":1248,"_42174":1228,"_29767":81138,"_5":21387,"_28235":81088,"_5797":81139},[],"Select policy-approved roots as anchors.",{"_6892":1249,"_42174":1228,"_29767":81141,"_5":21387,"_28235":81088,"_5797":81142},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_6892":1250,"_42174":1228,"_29767":81144,"_5":21387,"_28235":81088,"_5797":81145},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_6892":1251,"_42174":1228,"_29767":81147,"_5":21387,"_28235":81088,"_5797":81148},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_6892":1252,"_42174":1228,"_29767":81150,"_5":21387,"_28235":81088,"_5797":81151},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_6892":1253,"_42174":1228,"_29767":81153,"_5":21387,"_28235":81092,"_5797":81154},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_6892":1254,"_42174":1228,"_29767":81156,"_5":21387,"_28235":81092,"_5797":81157},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. That list is optional because the enrollment CA always validates re-enrollment credentials, but when switching the enrollment CA, add the previous issuance CA to it so old-CA identities keep re-enrolling during overlap. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_6892":1255,"_42174":1228,"_29767":81159,"_5":21387,"_28235":81092,"_5797":81160},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_6892":1256,"_42174":1228,"_29767":81162,"_5":21387,"_28235":81096,"_5797":81163},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_6892":1257,"_42174":1257,"_5":21817,"_5797":81165,"_42654":81166,"_29767":81168,"_28235":1257},"AWS IoT Core",[77248,78697,79705,79703,81167],"Integrations",[],{"_6892":1258,"_42174":1257,"_29767":81170,"_5":21387,"_28235":1257,"_5797":81171},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_6892":1259,"_42174":1257,"_5":42651,"_29767":81173,"_28235":81174,"_5797":81175},[],"/docs/pr-preview/pr-56/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_6892":1260,"_42174":1257,"_5":42651,"_29767":81177,"_28235":81178,"_5797":81179},[],"/docs/pr-preview/pr-56/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_6892":1261,"_42174":1257,"_5":42651,"_29767":81181,"_28235":81182,"_5797":81183},[],"/docs/pr-preview/pr-56/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_6892":1262,"_42174":1257,"_5":42651,"_29767":81185,"_28235":81186,"_5797":81187},[],"/docs/pr-preview/pr-56/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_6892":1263,"_42174":1257,"_5":42651,"_29767":81189,"_28235":81190,"_5797":81191},[],"/docs/pr-preview/pr-56/platform/iot-fleets/integrations/aws-iot-core#resource-state-machine","Resource state machine",{"_6892":1264,"_42174":1257,"_5":42651,"_29767":81193,"_28235":81194,"_5797":81195},[],"/docs/pr-preview/pr-56/platform/iot-fleets/integrations/aws-iot-core#events-the-connector-handles","Events the connector handles",{"_6892":1265,"_42174":1257,"_5":42651,"_29767":81197,"_28235":81198,"_5797":81199},[],"/docs/pr-preview/pr-56/platform/iot-fleets/integrations/aws-iot-core#ca-registration-states","CA registration states",{"_6892":1266,"_42174":1257,"_5":42651,"_29767":81201,"_28235":81202,"_5797":81203},[],"/docs/pr-preview/pr-56/platform/iot-fleets/integrations/aws-iot-core#dms-registration-mode-states","DMS registration-mode states",{"_6892":1267,"_42174":1257,"_5":42651,"_29767":81205,"_28235":81206,"_5797":81207},[],"/docs/pr-preview/pr-56/platform/iot-fleets/integrations/aws-iot-core#certificate-status-states","Certificate status states",{"_6892":1268,"_42174":1257,"_5":42651,"_29767":81209,"_28235":81210,"_5797":81211},[],"/docs/pr-preview/pr-56/platform/iot-fleets/integrations/aws-iot-core#thing-lifecycle","Thing lifecycle",{"_6892":1269,"_42174":1257,"_5":42651,"_29767":81213,"_28235":81214,"_5797":81215},[],"/docs/pr-preview/pr-56/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_6892":1270,"_42174":1257,"_5":42651,"_29767":81217,"_28235":81218,"_5797":81219},[],"/docs/pr-preview/pr-56/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_6892":1271,"_42174":1257,"_5":42651,"_29767":81221,"_28235":81222,"_5797":81223},[],"/docs/pr-preview/pr-56/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_6892":1272,"_42174":1257,"_5":42651,"_29767":81225,"_28235":81226,"_5797":81227},[],"/docs/pr-preview/pr-56/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_6892":1273,"_42174":1257,"_5":42651,"_29767":81229,"_28235":81230,"_5797":81231},[],"/docs/pr-preview/pr-56/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_6892":1274,"_42174":1257,"_5":42651,"_29767":81233,"_28235":81234,"_5797":81235},[],"/docs/pr-preview/pr-56/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_6892":1275,"_42174":1257,"_5":42651,"_29767":81237,"_28235":81238,"_5797":81239},[],"/docs/pr-preview/pr-56/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_6892":1276,"_42174":1257,"_5":42651,"_29767":81241,"_28235":81242,"_5797":81243},[],"/docs/pr-preview/pr-56/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_6892":1277,"_42174":1257,"_5":42651,"_29767":81245,"_28235":81246,"_5797":81247},[],"/docs/pr-preview/pr-56/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_6892":1278,"_42174":1257,"_5":42651,"_29767":81249,"_28235":81250,"_5797":81251},[],"/docs/pr-preview/pr-56/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_6892":1279,"_42174":1257,"_5":42651,"_29767":81253,"_28235":81254,"_5797":81255},[],"/docs/pr-preview/pr-56/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_6892":1280,"_42174":1257,"_5":42651,"_29767":81257,"_28235":81258,"_5797":81259},[],"/docs/pr-preview/pr-56/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_6892":1281,"_42174":1257,"_5":42651,"_29767":81261,"_28235":81262,"_5797":81263},[],"/docs/pr-preview/pr-56/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_6892":1282,"_42174":1257,"_5":42651,"_29767":81265,"_28235":81266,"_5797":81267},[],"/docs/pr-preview/pr-56/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_6892":1283,"_42174":1257,"_5":42651,"_29767":81269,"_28235":81270,"_5797":81271},[],"/docs/pr-preview/pr-56/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_6892":1284,"_42174":1257,"_5":42651,"_29767":81273,"_28235":81274,"_5797":81275},[],"/docs/pr-preview/pr-56/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_6892":1285,"_42174":1257,"_29767":81277,"_5":21387,"_28235":1257,"_5797":81278},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_6892":1286,"_42174":1257,"_29767":81280,"_5":21387,"_28235":1257,"_5797":81281},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_6892":1287,"_42174":1257,"_29767":81283,"_5":21387,"_28235":1257,"_5797":81284},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_6892":1288,"_42174":1257,"_29767":81286,"_5":21387,"_28235":81174,"_5797":81287},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_6892":1289,"_42174":1257,"_29767":81289,"_5":21387,"_28235":81174,"_5797":81290},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_6892":1290,"_42174":1257,"_29767":81292,"_5":21387,"_28235":81174,"_5797":81293},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_6892":1291,"_42174":1257,"_29767":81295,"_5":21387,"_28235":81174,"_5797":81296},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_6892":1292,"_42174":1257,"_29767":81298,"_5":21387,"_28235":81178,"_5797":81299},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_6892":1293,"_42174":1257,"_29767":81301,"_5":21387,"_28235":81182,"_5797":81302},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_6892":1294,"_42174":1257,"_29767":81304,"_5":21387,"_28235":81182,"_5797":81305},[],"IAM action",{"_6892":1295,"_42174":1257,"_29767":81307,"_5":21387,"_28235":81182,"_5797":77638},[],{"_6892":1296,"_42174":1257,"_29767":81309,"_5":21387,"_28235":81182,"_5797":81310},[],"`iot:GetRegistrationCode`",{"_6892":1297,"_42174":1257,"_29767":81312,"_5":21387,"_28235":81182,"_5797":81313},[],"Obtain the verification code for CA registration in the Primary Account",{"_6892":1298,"_42174":1257,"_29767":81315,"_5":21387,"_28235":81182,"_5797":81316},[],"`iot:RegisterCACertificate`",{"_6892":1299,"_42174":1257,"_29767":81318,"_5":21387,"_28235":81182,"_5797":81319},[],"Register the CA in AWS IoT",{"_6892":1300,"_42174":1257,"_29767":81321,"_5":21387,"_28235":81182,"_5797":81322},[],"`iot:DescribeCACertificate`",{"_6892":1301,"_42174":1257,"_29767":81324,"_5":21387,"_28235":81182,"_5797":81325},[],"Check the CA registration status",{"_6892":1302,"_42174":1257,"_29767":81327,"_5":21387,"_28235":81182,"_5797":81328},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_6892":1303,"_42174":1257,"_29767":81330,"_5":21387,"_28235":81182,"_5797":81331},[],"Create or update Things in IoT Core",{"_6892":1304,"_42174":1257,"_29767":81333,"_5":21387,"_28235":81182,"_5797":81334},[],"`iot:RegisterThing`",{"_6892":1305,"_42174":1257,"_29767":81336,"_5":21387,"_28235":81182,"_5797":81337},[],"Provision Things through a template",{"_6892":1306,"_42174":1257,"_29767":81339,"_5":21387,"_28235":81182,"_5797":81340},[],"`iot:RegisterCertificate`",{"_6892":1307,"_42174":1257,"_29767":81342,"_5":21387,"_28235":81182,"_5797":81343},[],"Register device certificates",{"_6892":1308,"_42174":1257,"_29767":81345,"_5":21387,"_28235":81182,"_5797":81346},[],"`iot:UpdateCertificate`",{"_6892":1309,"_42174":1257,"_29767":81348,"_5":21387,"_28235":81182,"_5797":81349},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_6892":1310,"_42174":1257,"_29767":81351,"_5":21387,"_28235":81182,"_5797":81352},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_6892":1311,"_42174":1257,"_29767":81354,"_5":21387,"_28235":81182,"_5797":81355},[],"Create and attach IoT policies",{"_6892":1312,"_42174":1257,"_29767":81357,"_5":21387,"_28235":81182,"_5797":81358},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_6892":1313,"_42174":1257,"_29767":81360,"_5":21387,"_28235":81182,"_5797":81361},[],"Manage Thing groups",{"_6892":1314,"_42174":1257,"_29767":81363,"_5":21387,"_28235":81182,"_5797":81364},[],"`iot:CreateProvisioningTemplate`",{"_6892":1315,"_42174":1257,"_29767":81366,"_5":21387,"_28235":81182,"_5797":81367},[],"Create JITP templates",{"_6892":1316,"_42174":1257,"_29767":81369,"_5":21387,"_28235":81182,"_5797":81370},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_6892":1317,"_42174":1257,"_29767":81372,"_5":21387,"_28235":81182,"_5797":81373},[],"Read and write the Device Shadow",{"_6892":1318,"_42174":1257,"_29767":81375,"_5":21387,"_28235":81182,"_5797":81376},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_6892":1319,"_42174":1257,"_29767":81378,"_5":21387,"_28235":81186,"_5797":81379},[],"Parameter",{"_6892":1320,"_42174":1257,"_29767":81381,"_5":21387,"_28235":81186,"_5797":81382},[],"Type",{"_6892":1321,"_42174":1257,"_29767":81384,"_5":21387,"_28235":81186,"_5797":81385},[],"Required",{"_6892":1322,"_42174":1257,"_29767":81387,"_5":21387,"_28235":81186,"_5797":81388},[],"Description",{"_6892":1323,"_42174":1257,"_29767":81390,"_5":21387,"_28235":81186,"_5797":81391},[],"`connector_id`",{"_6892":1324,"_42174":1257,"_29767":81393,"_5":21387,"_28235":81186,"_5797":34761},[],{"_6892":1325,"_42174":1257,"_29767":81395,"_5":21387,"_28235":81186,"_5797":81396},[],"Yes",{"_6892":1326,"_42174":1257,"_29767":81398,"_5":21387,"_28235":81186,"_5797":81399},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_6892":1327,"_42174":1257,"_29767":81401,"_5":21387,"_28235":81186,"_5797":81402},[],"`aws_config.region`",{"_6892":1328,"_42174":1257,"_29767":81404,"_5":21387,"_28235":81186,"_5797":34761},[],{"_6892":1329,"_42174":1257,"_29767":81406,"_5":21387,"_28235":81186,"_5797":81396},[],{"_6892":1330,"_42174":1257,"_29767":81408,"_5":21387,"_28235":81186,"_5797":81409},[],"AWS region where the connector operates.",{"_6892":1331,"_42174":1257,"_29767":81411,"_5":21387,"_28235":81186,"_5797":81412},[],"`aws_config.auth_method`",{"_6892":1332,"_42174":1257,"_29767":81414,"_5":21387,"_28235":81186,"_5797":34761},[],{"_6892":1333,"_42174":1257,"_29767":81416,"_5":21387,"_28235":81186,"_5797":81396},[],{"_6892":1334,"_42174":1257,"_29767":81418,"_5":21387,"_28235":81186,"_5797":81419},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_6892":1335,"_42174":1257,"_29767":81421,"_5":21387,"_28235":81186,"_5797":81422},[],"`aws_config.access_key_id`",{"_6892":1336,"_42174":1257,"_29767":81424,"_5":21387,"_28235":81186,"_5797":34761},[],{"_6892":1337,"_42174":1257,"_29767":81426,"_5":21387,"_28235":81186,"_5797":81427},[],"Only with `auth_method=static`",{"_6892":1338,"_42174":1257,"_29767":81429,"_5":21387,"_28235":81186,"_5797":81430},[],"AWS access key.",{"_6892":1339,"_42174":1257,"_29767":81432,"_5":21387,"_28235":81186,"_5797":81433},[],"`aws_config.secret_access_key`",{"_6892":1340,"_42174":1257,"_29767":81435,"_5":21387,"_28235":81186,"_5797":34761},[],{"_6892":1341,"_42174":1257,"_29767":81437,"_5":21387,"_28235":81186,"_5797":81427},[],{"_6892":1342,"_42174":1257,"_29767":81439,"_5":21387,"_28235":81186,"_5797":81440},[],"AWS secret key.",{"_6892":1343,"_42174":1257,"_29767":81442,"_5":21387,"_28235":81186,"_5797":81443},[],"`aws_config.session_token`",{"_6892":1344,"_42174":1257,"_29767":81445,"_5":21387,"_28235":81186,"_5797":34761},[],{"_6892":1345,"_42174":1257,"_29767":81447,"_5":21387,"_28235":81186,"_5797":81448},[],"No",{"_6892":1346,"_42174":1257,"_29767":81450,"_5":21387,"_28235":81186,"_5797":81451},[],"Session token (with `auth_method=static`).",{"_6892":1347,"_42174":1257,"_29767":81453,"_5":21387,"_28235":81186,"_5797":81454},[],"`aws_config.role_arn`",{"_6892":1348,"_42174":1257,"_29767":81456,"_5":21387,"_28235":81186,"_5797":34761},[],{"_6892":1349,"_42174":1257,"_29767":81458,"_5":21387,"_28235":81186,"_5797":81459},[],"Only with `auth_method=role`",{"_6892":1350,"_42174":1257,"_29767":81461,"_5":21387,"_28235":81186,"_5797":81462},[],"ARN of the role to assume.",{"_6892":1351,"_42174":1257,"_29767":81464,"_5":21387,"_28235":81186,"_5797":81465},[],"`aws_config.endpoint_url`",{"_6892":1352,"_42174":1257,"_29767":81467,"_5":21387,"_28235":81186,"_5797":34761},[],{"_6892":1353,"_42174":1257,"_29767":81469,"_5":21387,"_28235":81186,"_5797":81448},[],{"_6892":1354,"_42174":1257,"_29767":81471,"_5":21387,"_28235":81186,"_5797":81472},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_6892":1355,"_42174":1257,"_29767":81474,"_5":21387,"_28235":81186,"_5797":81475},[],"`subscriber_event_bus`",{"_6892":1356,"_42174":1257,"_29767":81477,"_5":21387,"_28235":81186,"_5797":25562},[],{"_6892":1357,"_42174":1257,"_29767":81479,"_5":21387,"_28235":81186,"_5797":81396},[],{"_6892":1358,"_42174":1257,"_29767":81481,"_5":21387,"_28235":81186,"_5797":81482},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_6892":1359,"_42174":1257,"_29767":81484,"_5":21387,"_28235":81186,"_5797":81485},[],"`dms_manager_client`",{"_6892":1360,"_42174":1257,"_29767":81487,"_5":21387,"_28235":81186,"_5797":34761},[],{"_6892":1361,"_42174":1257,"_29767":81489,"_5":21387,"_28235":81186,"_5797":81396},[],{"_6892":1362,"_42174":1257,"_29767":81491,"_5":21387,"_28235":81186,"_5797":81492},[],"HTTP URL of Lamassu's DMS Manager service.",{"_6892":1363,"_42174":1257,"_29767":81494,"_5":21387,"_28235":81186,"_5797":81495},[],"`device_manager_client`",{"_6892":1364,"_42174":1257,"_29767":81497,"_5":21387,"_28235":81186,"_5797":34761},[],{"_6892":1365,"_42174":1257,"_29767":81499,"_5":21387,"_28235":81186,"_5797":81396},[],{"_6892":1366,"_42174":1257,"_29767":81501,"_5":21387,"_28235":81186,"_5797":81502},[],"HTTP URL of Lamassu's Device Manager.",{"_6892":1367,"_42174":1257,"_29767":81504,"_5":21387,"_28235":81186,"_5797":81505},[],"`ca_client`",{"_6892":1368,"_42174":1257,"_29767":81507,"_5":21387,"_28235":81186,"_5797":34761},[],{"_6892":1369,"_42174":1257,"_29767":81509,"_5":21387,"_28235":81186,"_5797":81396},[],{"_6892":1370,"_42174":1257,"_29767":81511,"_5":21387,"_28235":81186,"_5797":81512},[],"HTTP URL of Lamassu's CA service.",{"_6892":1371,"_42174":1257,"_29767":81514,"_5":21387,"_28235":81190,"_5797":81515},[],"The connector owns the AWS side of four resource types — CAs, DMS provisioning templates (JITP), device certificates and Things. This section maps the bus events the connector consumes to the AWS resources they touch and to the AWS calls each transition performs. AWS resources are referenced with the notation `IoTCore/<resource>`.",{"_6892":1372,"_42174":1257,"_29767":81517,"_5":21387,"_28235":81194,"_5797":81518},[],"The **CloudEvent type** column lists the event name on Lamassu's internal event bus; the **IAM actions** column lists the exact AWS SDK operations each flow invokes, so the required permissions can be derived directly from this table.",{"_6892":1373,"_42174":1257,"_29767":81520,"_5":21387,"_28235":81194,"_5797":81521},[],"CloudEvent type",{"_6892":1374,"_42174":1257,"_29767":81523,"_5":21387,"_28235":81194,"_5797":81524},[],"Lamassu resource",{"_6892":1375,"_42174":1257,"_29767":81526,"_5":21387,"_28235":81194,"_5797":81527},[],"AWS Resource",{"_6892":1376,"_42174":1257,"_29767":81529,"_5":21387,"_28235":81194,"_5797":81530},[],"IAM actions",{"_6892":1377,"_42174":1257,"_29767":81532,"_5":21387,"_28235":81194,"_5797":81533},[],"AWS calls and effect",{"_6892":1378,"_42174":1257,"_29767":81535,"_5":21387,"_28235":81194,"_5797":81536},[],"Where in this page",{"_6892":1379,"_42174":1257,"_29767":81538,"_5":21387,"_28235":81194,"_5797":81539},[],"`EventCreateCAKey` / `EventImportCAKey` / `EventUpdateCAMetadataKey`",{"_6892":1380,"_42174":1257,"_29767":81541,"_5":21387,"_28235":81194,"_5797":81542},[],"CA",{"_6892":1381,"_42174":1257,"_29767":81544,"_5":21387,"_28235":81194,"_5797":81545},[],"`IoTCore/CACertificate`",{"_6892":1382,"_42174":1257,"_29767":81547,"_5":21387,"_28235":81194,"_5797":81548},[],"`iot:GetRegistrationCode`, `iot:RegisterCACertificate`, `iot:DescribeCACertificate`, `iot:ListCACertificates`",{"_6892":1383,"_42174":1257,"_29767":81550,"_5":21387,"_28235":81194,"_5797":81551},[],"Loads the CA into connector state; a `registration.status = REQUESTED` write fires the registration flow (Primary with verification certificate, or SNI-only) and writes `SUCCEEDED` or `FAILED` back to the CA's metadata.",{"_6892":1384,"_42174":1257,"_29767":81553,"_5":21387,"_28235":81194,"_5797":81199},[],{"_6892":1385,"_42174":1257,"_29767":81555,"_5":21387,"_28235":81194,"_5797":81556},[],"`EventCreateDMSKey` / `EventUpdateDMSKey`",{"_6892":1386,"_42174":1257,"_29767":81558,"_5":21387,"_28235":81194,"_5797":81559},[],"DMS",{"_6892":1387,"_42174":1257,"_29767":81561,"_5":21387,"_28235":81194,"_5797":81562},[],"`IoTCore/ProvisioningTemplate`",{"_6892":1388,"_42174":1257,"_29767":81564,"_5":21387,"_28235":81194,"_5797":81565},[],"`iot:CreateProvisioningTemplate`, `iot:UpdateCACertificate`",{"_6892":1389,"_42174":1257,"_29767":81567,"_5":21387,"_28235":81194,"_5797":81568},[],"In `jitp` mode, attempts to create the provisioning template and attaches it to the registered CA. Non-idempotent: a `PUT /v1/dms/{id}` edit retries the creation and lands in `lamassu-dlq` after 3 retries. Idempotent for `none` and `auto` (configuration only).",{"_6892":1390,"_42174":1257,"_29767":81570,"_5":21387,"_28235":81194,"_5797":81203},[],{"_6892":1391,"_42174":1257,"_29767":81572,"_5":21387,"_28235":81194,"_5797":81573},[],"`EventBindDeviceIdentityKey`",{"_6892":1392,"_42174":1257,"_29767":81575,"_5":21387,"_28235":81194,"_5797":81576},[],"Device",{"_6892":1393,"_42174":1257,"_29767":81578,"_5":21387,"_28235":81194,"_5797":81579},[],"`IoTCore/Policy`, `IoTCore/ThingGroup`, `IoTCore/Thing`",{"_6892":1394,"_42174":1257,"_29767":81581,"_5":21387,"_28235":81194,"_5797":81582},[],"`iot:CreatePolicy` / `iot:DeletePolicyVersion`, `iot:GetPolicy` / `iot:ListPolicyVersions`, `iot:CreateThingGroup`, `iot:DescribeThing` / `iot:ListThingPrincipals`, `iot:RegisterThing`",{"_6892":1395,"_42174":1257,"_29767":81584,"_5":21387,"_28235":81194,"_5797":81585},[],"In `auto` mode: creates/updates policies, ensures Thing groups, revokes stale principals and provisions the Thing via `iot:RegisterThing`. In `jitp` mode: no AWS calls; AWS runs the JITP template on first connection.",{"_6892":1396,"_42174":1257,"_29767":81587,"_5":21387,"_28235":81194,"_5797":81211},[],{"_6892":1397,"_42174":1257,"_29767":81589,"_5":21387,"_28235":81194,"_5797":81590},[],"`EventUpdateCertificateStatusKey`",{"_6892":1398,"_42174":1257,"_29767":81592,"_5":21387,"_28235":81194,"_5797":81593},[],"Certificate",{"_6892":1399,"_42174":1257,"_29767":81595,"_5":21387,"_28235":81194,"_5797":81596},[],"`IoTCore/Certificate`",{"_6892":1400,"_42174":1257,"_29767":81598,"_5":21387,"_28235":81194,"_5797":81599},[],"`iot:UpdateCertificate`, `iot:Connect` (data plane)",{"_6892":1401,"_42174":1257,"_29767":81601,"_5":21387,"_28235":81194,"_5797":81602},[],"Maps status to AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), calls `iot:UpdateCertificate` and forces an MQTT disconnect on revoke.",{"_6892":1402,"_42174":1257,"_29767":81604,"_5":21387,"_28235":81194,"_5797":81207},[],{"_6892":1403,"_42174":1257,"_29767":81606,"_5":21387,"_28235":81194,"_5797":81607},[],"`EventUpdateCertificateMetadataKey` / `EventUpdateDeviceMetadataKey`",{"_6892":1404,"_42174":1257,"_29767":81609,"_5":21387,"_28235":81194,"_5797":81610},[],"Certificate / Device",{"_6892":1405,"_42174":1257,"_29767":81612,"_5":21387,"_28235":81194,"_5797":81613},[],"`IoTCore/Certificate`, `IoTCore/Thing`",{"_6892":1406,"_42174":1257,"_29767":81615,"_5":21387,"_28235":81194,"_5797":77644},[],{"_6892":1407,"_42174":1257,"_29767":81617,"_5":21387,"_28235":81194,"_5797":81618},[],"Refreshes internal state; the connector ignores events whose CloudEvent `source` matches its own URI to avoid self-triggered loops.",{"_6892":1408,"_42174":1257,"_29767":81620,"_5":21387,"_28235":81194,"_5797":81263},[],{"_6892":1409,"_42174":1257,"_29767":81622,"_5":21387,"_28235":81198,"_5797":81623},[],"The CA registration flow is driven by the `registration.status` field of the CA's connector metadata:",{"_6892":1410,"_42174":1257,"_29767":81625,"_5":21387,"_28235":81198,"_5797":81626},[],"by the `registration.status` field of the CA's connector metadata:",{"_6892":1411,"_42174":1257,"_29767":81628,"_5":21387,"_28235":81198,"_5797":81629},[],"Transition",{"_6892":1412,"_42174":1257,"_29767":81631,"_5":21387,"_28235":81198,"_5797":81632},[],"AWS calls",{"_6892":1413,"_42174":1257,"_29767":81634,"_5":21387,"_28235":81198,"_5797":81635},[],"`NotRegistered` → `Requested`",{"_6892":1414,"_42174":1257,"_29767":81637,"_5":21387,"_28235":81198,"_5797":81638},[],"none (metadata write only)",{"_6892":1415,"_42174":1257,"_29767":81640,"_5":21387,"_28235":81198,"_5797":81641},[],"`Requested` → `Registering`",{"_6892":1416,"_42174":1257,"_29767":81643,"_5":21387,"_28235":81198,"_5797":81644},[],"`iot:GetRegistrationCode` (Primary Account only)",{"_6892":1417,"_42174":1257,"_29767":81646,"_5":21387,"_28235":81198,"_5797":81647},[],"`Registering` → `Succeeded`",{"_6892":1418,"_42174":1257,"_29767":81649,"_5":21387,"_28235":81198,"_5797":81650},[],"`iot:RegisterCACertificate` (Primary: proof-of-possession with an ephemeral key; SNI-only: `CertificateMode: SNI_ONLY`)",{"_6892":1419,"_42174":1257,"_29767":81652,"_5":21387,"_28235":81198,"_5797":81653},[],"`Registering` → `Failed`",{"_6892":1420,"_42174":1257,"_29767":81655,"_5":21387,"_28235":81198,"_5797":81656},[],"failed `iot:RegisterCACertificate`; the error detail is written to the CA's metadata",{"_6892":1421,"_42174":1257,"_29767":81658,"_5":21387,"_28235":81198,"_5797":81659},[],"`Failed` / `Succeeded` → `Requested`",{"_6892":1422,"_42174":1257,"_29767":81661,"_5":21387,"_28235":81198,"_5797":81662},[],"none (a new `REQUESTED` write re-runs the flow)",{"_6892":1423,"_42174":1257,"_29767":81664,"_5":21387,"_28235":81202,"_5797":81665},[],"The DMS's `registration_mode` determines what the connector does on the AWS side when the DMS is created or fully edited:",{"_6892":1424,"_42174":1257,"_29767":81667,"_5":21387,"_28235":81202,"_5797":81629},[],{"_6892":1425,"_42174":1257,"_29767":81669,"_5":21387,"_28235":81202,"_5797":81632},[],{"_6892":1426,"_42174":1257,"_29767":81671,"_5":21387,"_28235":81202,"_5797":81672},[],"`Unconfigured` → `None` / `Auto`",{"_6892":1427,"_42174":1257,"_29767":81674,"_5":21387,"_28235":81202,"_5797":81675},[],"none (configuration only)",{"_6892":1428,"_42174":1257,"_29767":81677,"_5":21387,"_28235":81202,"_5797":81678},[],"`None` ↔ `Auto`",{"_6892":1429,"_42174":1257,"_29767":81680,"_5":21387,"_28235":81202,"_5797":81675},[],{"_6892":1430,"_42174":1257,"_29767":81682,"_5":21387,"_28235":81202,"_5797":81683},[],"Any → `Jitp`",{"_6892":1431,"_42174":1257,"_29767":81685,"_5":21387,"_28235":81202,"_5797":81686},[],"`iot:CreateProvisioningTemplate` (non-idempotent: it fails when the template already exists; after 3 retries the event lands in `lamassu-dlq`)",{"_6892":1432,"_42174":1257,"_29767":81688,"_5":21387,"_28235":81202,"_5797":81689},[],"`Jitp` → `None` / `Auto`",{"_6892":1433,"_42174":1257,"_29767":81691,"_5":21387,"_28235":81202,"_5797":81692},[],"none (the template stays in the AWS account)",{"_6892":1434,"_42174":1257,"_29767":81694,"_5":21387,"_28235":81206,"_5797":81695},[],"Certificates holding the connector's metadata key sync their status; certificates provisioned via JITP have no metadata key and stay out of this machine:",{"_6892":1435,"_42174":1257,"_29767":81697,"_5":21387,"_28235":81206,"_5797":81629},[],{"_6892":1436,"_42174":1257,"_29767":81699,"_5":21387,"_28235":81206,"_5797":81632},[],{"_6892":1437,"_42174":1257,"_29767":81701,"_5":21387,"_28235":81206,"_5797":81702},[],"`NotSynced` → `Active`",{"_6892":1438,"_42174":1257,"_29767":81704,"_5":21387,"_28235":81206,"_5797":81346},[],{"_6892":1439,"_42174":1257,"_29767":81706,"_5":21387,"_28235":81206,"_5797":81707},[],"`Active` → `Inactive`",{"_6892":1440,"_42174":1257,"_29767":81709,"_5":21387,"_28235":81206,"_5797":81710},[],"`iot:UpdateCertificate` + forced MQTT disconnect",{"_6892":1441,"_42174":1257,"_29767":81712,"_5":21387,"_28235":81206,"_5797":81713},[],"`Active` → `Revoked`",{"_6892":1442,"_42174":1257,"_29767":81715,"_5":21387,"_28235":81206,"_5797":81710},[],{"_6892":1443,"_42174":1257,"_29767":81717,"_5":21387,"_28235":81206,"_5797":81718},[],"`Inactive` / `Revoked` → `Active`",{"_6892":1444,"_42174":1257,"_29767":81720,"_5":21387,"_28235":81206,"_5797":81346},[],{"_6892":1445,"_42174":1257,"_29767":81722,"_5":21387,"_28235":81206,"_5797":81723},[],"`RenewalWindow` / `AboutToExpire` / `Expired`",{"_6892":1446,"_42174":1257,"_29767":81725,"_5":21387,"_28235":81206,"_5797":81726},[],"none (these states are not synced to AWS)",{"_6892":1447,"_42174":1257,"_29767":81728,"_5":21387,"_28235":81210,"_5797":81729},[],"Things only exist under `auto` mode; in `jitp` mode AWS creates the Thing itself when the device first connects. The Thing name is always the device certificate's CN:",{"_6892":1448,"_42174":1257,"_29767":81731,"_5":21387,"_28235":81210,"_5797":81629},[],{"_6892":1449,"_42174":1257,"_29767":81733,"_5":21387,"_28235":81210,"_5797":81632},[],{"_6892":1450,"_42174":1257,"_29767":81735,"_5":21387,"_28235":81210,"_5797":81736},[],"`Absent` → `Provisioned`",{"_6892":1451,"_42174":1257,"_29767":81738,"_5":21387,"_28235":81210,"_5797":81739},[],"policies created/updated, Thing groups ensured, `iot:RegisterThing` (creates the Thing, registers the certificate, attaches policies)",{"_6892":1452,"_42174":1257,"_29767":81741,"_5":21387,"_28235":81210,"_5797":81742},[],"`Provisioned` → `Provisioned` (re-enrollment)",{"_6892":1453,"_42174":1257,"_29767":81744,"_5":21387,"_28235":81210,"_5797":81745},[],"stale principals marked `REVOKED`, new `iot:RegisterThing` run; the new certificate ARN replaces the old one in Lamassu metadata",{"_6892":1454,"_42174":1257,"_29767":81747,"_5":21387,"_28235":81210,"_5797":81748},[],"In `jitp` mode the connector makes no provisioning calls: AWS executes the JITP template on the device's first connection and creates the Thing, registers the certificate and activates it on its own.",{"_6892":1455,"_42174":1257,"_29767":81750,"_5":21387,"_28235":81214,"_5797":81751},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_6892":1456,"_42174":1257,"_29767":81753,"_5":21387,"_28235":81218,"_5797":81754},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_6892":1457,"_42174":1257,"_29767":81756,"_5":21387,"_28235":81218,"_5797":81757},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_6892":1458,"_42174":1257,"_29767":81759,"_5":21387,"_28235":81222,"_5797":81760},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_6892":1459,"_42174":1257,"_29767":81762,"_5":21387,"_28235":81222,"_5797":81763},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_6892":1460,"_42174":1257,"_29767":81765,"_5":21387,"_28235":81222,"_5797":81766},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_6892":1461,"_42174":1257,"_29767":81768,"_5":21387,"_28235":81222,"_5797":81769},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_6892":1462,"_42174":1257,"_29767":81771,"_5":21387,"_28235":81222,"_5797":81772},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_6892":1463,"_42174":1257,"_29767":81774,"_5":21387,"_28235":81222,"_5797":81775},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_6892":1464,"_42174":1257,"_29767":81777,"_5":21387,"_28235":81226,"_5797":81778},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_6892":1465,"_42174":1257,"_29767":81780,"_5":21387,"_28235":81230,"_5797":81781},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_6892":1466,"_42174":1257,"_29767":81783,"_5":21387,"_28235":81230,"_5797":81784},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_6892":1467,"_42174":1257,"_29767":81786,"_5":21387,"_28235":81234,"_5797":81787},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_6892":1468,"_42174":1257,"_29767":81789,"_5":21387,"_28235":81238,"_5797":81790},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_6892":1469,"_42174":1257,"_29767":81792,"_5":21387,"_28235":81238,"_5797":81793},[],"Creates or updates the IoT policies configured in the DMS.",{"_6892":1470,"_42174":1257,"_29767":81795,"_5":21387,"_28235":81238,"_5797":81796},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_6892":1471,"_42174":1257,"_29767":81798,"_5":21387,"_28235":81238,"_5797":81799},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_6892":1472,"_42174":1257,"_29767":81801,"_5":21387,"_28235":81238,"_5797":81802},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_6892":1473,"_42174":1257,"_29767":81804,"_5":21387,"_28235":81238,"_5797":81805},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_6892":1474,"_42174":1257,"_29767":81807,"_5":21387,"_28235":81238,"_5797":81808},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_6892":1475,"_42174":1257,"_29767":81810,"_5":21387,"_28235":81242,"_5797":81811},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. The connector attempts to create this template when the DMS is created and again on every full DMS edit (`PUT /v1/dms/{id}`) — not at device enrollment time. The attempt is not idempotent: when a template named after the DMS ID already exists, the creation call fails, the event is retried three times and finally lands in the `lamassu-dlq` poison queue (see Troubleshooting). The template is created once; later DMS edits never update its content. A DMS update that omits `metadata` or sends `null` keeps the stored metadata, so the connector key `lamassu.io/iot/{connector_id}` remains present and the attempt is still triggered. A body that supplies a `metadata` object replaces the stored metadata entirely: if that object does not carry the connector key, the key is dropped and the connector silently skips the DMS's future events. Once the template is attached, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_6892":1476,"_42174":1257,"_29767":81813,"_5":21387,"_28235":81242,"_5797":81814},[],"The connector creates the template, named after the DMS ID, only once. Each later edit of the DMS that keeps the connector key tries to create it again and fails, because the connector does not update existing templates. Later changes to `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` or to the groups and policies the template references must be applied by hand in AWS IoT Core.",{"_6892":1477,"_42174":1257,"_29767":81816,"_5":21387,"_28235":81242,"_5797":81817},[],"The failed event is retried and ends in `lamassu-dlq`. Groups and policies are registered before the failure, but the assignment of the template to the registered CA, the write-back of the ARN to the DMS and the shadow update when `ManagedCAs` changes are skipped.",{"_6892":1478,"_42174":1257,"_29767":81819,"_5":21387,"_28235":81242,"_5797":81820},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_6892":1479,"_42174":1257,"_29767":81822,"_5":21387,"_28235":81242,"_5797":81823},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_6892":1480,"_42174":1257,"_29767":81825,"_5":21387,"_28235":81246,"_5797":81826},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_6892":1481,"_42174":1257,"_29767":81828,"_5":21387,"_28235":81246,"_5797":81829},[],"The full flow from the device's perspective is:",{"_6892":1482,"_42174":1257,"_29767":81831,"_5":21387,"_28235":81246,"_5797":81832},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_6892":1483,"_42174":1257,"_29767":81834,"_5":21387,"_28235":81250,"_5797":81835},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_6892":1484,"_42174":1257,"_29767":81837,"_5":21387,"_28235":81250,"_5797":81838},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_6892":1485,"_42174":1257,"_29767":81840,"_5":21387,"_28235":81250,"_5797":81841},[],"For the JITP flow to work correctly:",{"_6892":1486,"_42174":1257,"_29767":81843,"_5":21387,"_28235":81250,"_5797":81844},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_6892":1487,"_42174":1257,"_29767":81846,"_5":21387,"_28235":81250,"_5797":81847},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_6892":1488,"_42174":1257,"_29767":81849,"_5":21387,"_28235":81250,"_5797":81850},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_6892":1489,"_42174":1257,"_29767":81852,"_5":21387,"_28235":81250,"_5797":81853},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_6892":1490,"_42174":1257,"_29767":81855,"_5":21387,"_28235":81254,"_5797":81856},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_6892":1491,"_42174":1257,"_29767":81858,"_5":21387,"_28235":81254,"_5797":81859},[],"Status in Lamassu",{"_6892":1492,"_42174":1257,"_29767":81861,"_5":21387,"_28235":81254,"_5797":81862},[],"Revocation reason",{"_6892":1493,"_42174":1257,"_29767":81864,"_5":21387,"_28235":81254,"_5797":81865},[],"Status in AWS IoT Core",{"_6892":1494,"_42174":1257,"_29767":81867,"_5":21387,"_28235":81254,"_5797":81868},[],"`Active`",{"_6892":1495,"_42174":1257,"_29767":81870,"_5":21387,"_28235":81254,"_5797":81871},[],"None",{"_6892":1496,"_42174":1257,"_29767":81873,"_5":21387,"_28235":81254,"_5797":81874},[],"`ACTIVE`",{"_6892":1497,"_42174":1257,"_29767":81876,"_5":21387,"_28235":81254,"_5797":81877},[],"`Revoked`",{"_6892":1498,"_42174":1257,"_29767":81879,"_5":21387,"_28235":81254,"_5797":81880},[],"`certificateHold`",{"_6892":1499,"_42174":1257,"_29767":81882,"_5":21387,"_28235":81254,"_5797":81883},[],"`INACTIVE`",{"_6892":1500,"_42174":1257,"_29767":81885,"_5":21387,"_28235":81254,"_5797":81877},[],{"_6892":1501,"_42174":1257,"_29767":81887,"_5":21387,"_28235":81254,"_5797":81888},[],"Any other reason",{"_6892":1502,"_42174":1257,"_29767":81890,"_5":21387,"_28235":81254,"_5797":81891},[],"`REVOKED`",{"_6892":1503,"_42174":1257,"_29767":81893,"_5":21387,"_28235":81254,"_5797":81894},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_6892":1504,"_42174":1257,"_29767":81896,"_5":21387,"_28235":81258,"_5797":81897},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_6892":1505,"_42174":1257,"_29767":81899,"_5":21387,"_28235":81258,"_5797":81900},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_6892":1506,"_42174":1257,"_29767":81902,"_5":21387,"_28235":81258,"_5797":81903},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_6892":1507,"_42174":1257,"_29767":81905,"_5":21387,"_28235":81262,"_5797":81906},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_6892":1508,"_42174":1257,"_29767":81908,"_5":21387,"_28235":81262,"_5797":81909},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_6892":1509,"_42174":1257,"_29767":81911,"_5":21387,"_28235":81266,"_5797":81912},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_6892":1510,"_42174":1257,"_29767":81914,"_5":21387,"_28235":81266,"_5797":81915},[],"There are two action types:",{"_6892":1511,"_42174":1257,"_29767":81917,"_5":21387,"_28235":81266,"_5797":81918},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_6892":1512,"_42174":1257,"_29767":81920,"_5":21387,"_28235":81266,"_5797":81921},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_6892":1513,"_42174":1257,"_29767":81923,"_5":21387,"_28235":81266,"_5797":81924},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_6892":1514,"_42174":1257,"_29767":81926,"_5":21387,"_28235":81270,"_5797":81927},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_6892":1515,"_42174":1257,"_29767":81929,"_5":21387,"_28235":81270,"_5797":81930},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_6892":1516,"_42174":1257,"_29767":81932,"_5":21387,"_28235":81270,"_5797":81933},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_6892":1517,"_42174":1257,"_29767":81935,"_5":21387,"_28235":81274,"_5797":81936},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_6892":1518,"_42174":1257,"_29767":81938,"_5":21387,"_28235":81274,"_5797":81939},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_6892":1519,"_42174":1257,"_29767":81941,"_5":21387,"_28235":81274,"_5797":81942},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_6892":1520,"_42174":1257,"_29767":81944,"_5":21387,"_28235":81274,"_5797":81945},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_6892":1521,"_42174":1257,"_29767":81947,"_5":21387,"_28235":81274,"_5797":81948},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_6892":1522,"_42174":1257,"_29767":81950,"_5":21387,"_28235":81274,"_5797":81951},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_6892":1523,"_42174":1257,"_29767":81953,"_5":21387,"_28235":81274,"_5797":81954},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_6892":1524,"_42174":1257,"_29767":81956,"_5":21387,"_28235":81274,"_5797":81957},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_6892":1525,"_42174":1257,"_29767":81959,"_5":21387,"_28235":81274,"_5797":81960},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_6892":1526,"_42174":1257,"_29767":81962,"_5":21387,"_28235":81274,"_5797":81963},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_6892":1527,"_42174":1257,"_29767":81965,"_5":21387,"_28235":81274,"_5797":81966},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_6892":1528,"_42174":1257,"_29767":81968,"_5":21387,"_28235":81274,"_5797":81969},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_6892":1529,"_42174":1257,"_29767":81971,"_5":21387,"_28235":81274,"_5797":81972},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_6892":1530,"_42174":1257,"_29767":81974,"_5":21387,"_28235":81274,"_5797":81975},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_6892":1531,"_42174":1257,"_29767":81977,"_5":21387,"_28235":81274,"_5797":81978},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_6892":1532,"_42174":1257,"_29767":81980,"_5":21387,"_28235":81274,"_5797":81981},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_6892":1533,"_42174":1257,"_29767":81983,"_5":21387,"_28235":81274,"_5797":81984},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_6892":1534,"_42174":1257,"_29767":81986,"_5":21387,"_28235":81274,"_5797":81987},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_6892":1535,"_42174":1257,"_29767":81989,"_5":21387,"_28235":81274,"_5797":81990},[],"**Symptom:** After editing a DMS in `jitp` mode, DMS update messages appear in `lamassu-dlq`, or JITP configuration changes have no effect in AWS.",{"_6892":1536,"_42174":1257,"_29767":81992,"_5":21387,"_28235":81274,"_5797":81993},[],"**Cause:** Every full DMS edit (`PUT /v1/dms/{id}`) triggers a `CreateProvisioningTemplate` attempt for the template named after the DMS ID, and the call is not idempotent: when the template already exists, it fails, the event is retried three times and finally lands in `lamassu-dlq`. The connector’s later steps are skipped.",{"_6892":1537,"_42174":1257,"_29767":81995,"_5":21387,"_28235":81274,"_5797":81996},[],"**Resolution:** Check that the template named with the DMS ID exists in AWS IoT Core and that JITP enrollment works. If the JITP configuration was changed, apply it by hand to the AWS template.",{"_6892":1538,"_42174":1257,"_29767":81998,"_5":21387,"_28235":81274,"_5797":81999},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_6892":1539,"_42174":1257,"_29767":82001,"_5":21387,"_28235":81274,"_5797":82002},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_6892":1540,"_42174":1257,"_29767":82004,"_5":21387,"_28235":81274,"_5797":82005},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_6892":1541,"_42174":1541,"_5":21817,"_5797":79705,"_42654":82007,"_29767":82008,"_28235":1541},[77248,78697,79705],[],{"_6892":1542,"_42174":1541,"_29767":82010,"_5":21387,"_28235":1541,"_5797":82011},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_6892":1543,"_42174":1541,"_5":42651,"_29767":82013,"_28235":82014,"_5797":82015},[],"/docs/pr-preview/pr-56/platform/iot-fleets/overview#start-here","Start here",{"_6892":1544,"_42174":1541,"_5":42651,"_29767":82017,"_28235":82018,"_5797":79703},[],"/docs/pr-preview/pr-56/platform/iot-fleets/overview#devices-and-identities",{"_6892":1545,"_42174":1541,"_5":42651,"_29767":82020,"_28235":82021,"_5797":79886},[],"/docs/pr-preview/pr-56/platform/iot-fleets/overview#enrollment-with-pki",{"_6892":1546,"_42174":1541,"_5":42651,"_29767":82023,"_28235":82024,"_5797":81167},[],"/docs/pr-preview/pr-56/platform/iot-fleets/overview#integrations",{"_6892":1547,"_42174":1541,"_5":42651,"_29767":82026,"_28235":82027,"_5797":82028},[],"/docs/pr-preview/pr-56/platform/iot-fleets/overview#software-updates","Software updates",{"_6892":1548,"_42174":1541,"_5":42651,"_29767":82030,"_28235":82031,"_5797":82032},[],"/docs/pr-preview/pr-56/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_6892":1549,"_42174":1541,"_29767":82034,"_5":21387,"_28235":1541,"_5797":82035},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_6892":1550,"_42174":1541,"_29767":82037,"_5":21387,"_28235":82014,"_5797":82038},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_6892":1551,"_42174":1541,"_29767":82040,"_5":21387,"_28235":82014,"_5797":82041},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_6892":1552,"_42174":1541,"_29767":82043,"_5":21387,"_28235":82018,"_5797":82044},[],"Resource",{"_6892":1553,"_42174":1541,"_29767":82046,"_5":21387,"_28235":82018,"_5797":82047},[],"What it represents",{"_6892":1554,"_42174":1541,"_29767":82049,"_5":21387,"_28235":82018,"_5797":82050},[],"**Device**",{"_6892":1555,"_42174":1541,"_29767":82052,"_5":21387,"_28235":82018,"_5797":82053},[],"An inventory entry with an identifier, owning DMS and classification.",{"_6892":1556,"_42174":1541,"_29767":82055,"_5":21387,"_28235":82018,"_5797":82056},[],"**Identity**",{"_6892":1557,"_42174":1541,"_29767":82058,"_5":21387,"_28235":82018,"_5797":82059},[],"The device's association with its certificates: an active version and a history.",{"_6892":1558,"_42174":1541,"_29767":82061,"_5":21387,"_28235":82018,"_5797":82062},[],"**DMS**",{"_6892":1559,"_42174":1541,"_29767":82064,"_5":21387,"_28235":82018,"_5797":82065},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_6892":1560,"_42174":1541,"_29767":82067,"_5":21387,"_28235":82018,"_5797":82068},[],"**Fleet**",{"_6892":1561,"_42174":1541,"_29767":82070,"_5":21387,"_28235":82018,"_5797":82071},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_6892":1562,"_42174":1541,"_29767":82073,"_5":21387,"_28235":82018,"_5797":82074},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_6892":1563,"_42174":1541,"_29767":82076,"_5":21387,"_28235":82018,"_5797":82077},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_6892":1564,"_42174":1541,"_29767":82079,"_5":21387,"_28235":82021,"_5797":82080},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_6892":1565,"_42174":1541,"_29767":82082,"_5":21387,"_28235":82021,"_5797":82083},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_6892":1566,"_42174":1541,"_29767":82085,"_5":21387,"_28235":82021,"_5797":82086},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_6892":1567,"_42174":1541,"_29767":82088,"_5":21387,"_28235":82021,"_5797":82089},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_6892":1568,"_42174":1541,"_29767":82091,"_5":21387,"_28235":82021,"_5797":82092},[],"**Result:** request the certificate, install it and check its association with the device.",{"_6892":1569,"_42174":1541,"_29767":82094,"_5":21387,"_28235":82021,"_5797":82095},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_6892":1570,"_42174":1541,"_29767":82097,"_5":21387,"_28235":82021,"_5797":82098},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_6892":1571,"_42174":1541,"_29767":82100,"_5":21387,"_28235":82021,"_5797":82101},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_6892":1572,"_42174":1541,"_29767":82103,"_5":21387,"_28235":82024,"_5797":82104},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_6892":1573,"_42174":1541,"_29767":82106,"_5":21387,"_28235":82024,"_5797":82107},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_6892":1574,"_42174":1541,"_29767":82109,"_5":21387,"_28235":82027,"_5797":82110},[],"Once devices hold an identity, Lamassu Updates delivers firmware and software to them over the air. You publish a pack, choose the devices or groups that receive it and watch the rollout; devices install it with SWUpdate, and packages can be signed and encrypted.",{"_6892":1575,"_42174":1541,"_29767":82112,"_5":21387,"_28235":82027,"_5797":82113},[],"<Card title=\"Lamassu Updates\" description=\"Understand the service, its two backends and the update lifecycle.\" href=\"/docs/platform/updates/overview\" />",{"_6892":1576,"_42174":1541,"_29767":82115,"_5":21387,"_28235":82027,"_5797":82116},[],"<Card title=\"Publish and roll out an update\" description=\"Create a pack, build the package and launch it to a group of devices.\" href=\"/docs/platform/updates/guides/publish-and-roll-out\" />",{"_6892":1577,"_42174":1541,"_29767":82118,"_5":21387,"_28235":82031,"_5797":82119},[],"Participant",{"_6892":1578,"_42174":1541,"_29767":82121,"_5":21387,"_28235":82031,"_5797":82122},[],"Responsibility",{"_6892":1579,"_42174":1541,"_29767":82124,"_5":21387,"_28235":82031,"_5797":82125},[],"PKI administrator",{"_6892":1580,"_42174":1541,"_29767":82127,"_5":21387,"_28235":82031,"_5797":82128},[],"CA, issuance profile, chain and revocation publication.",{"_6892":1581,"_42174":1541,"_29767":82130,"_5":21387,"_28235":82031,"_5797":82131},[],"Provisioning administrator",{"_6892":1582,"_42174":1541,"_29767":82133,"_5":21387,"_28235":82031,"_5797":82134},[],"DMS, admission, authentication per operation and inventory.",{"_6892":1583,"_42174":1541,"_29767":82136,"_5":21387,"_28235":82031,"_5797":82137},[],"Device integrator",{"_6892":1584,"_42174":1541,"_29767":82139,"_5":21387,"_28235":82031,"_5797":82140},[],"Initial credential, key, EST client, trust and certificate installation.",{"_6892":1585,"_42174":1541,"_29767":82142,"_5":21387,"_28235":82031,"_5797":82143},[],"Consumer integrator",{"_6892":1586,"_42174":1541,"_29767":82145,"_5":21387,"_28235":82031,"_5797":82146},[],"Trusted issuers, validation and device permissions in the destination.",{"_6892":1587,"_42174":1541,"_29767":82148,"_5":21387,"_28235":82031,"_5797":82149},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_6892":1588,"_42174":1588,"_5":21817,"_5797":82151,"_42654":82152,"_29767":82154,"_28235":1588},"Enroll and connect your first device",[77248,78697,79705,82153],"Getting started",[],{"_6892":1589,"_42174":1588,"_29767":82156,"_5":21387,"_28235":1588,"_5797":82157},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_6892":1590,"_42174":1588,"_5":42651,"_29767":82159,"_28235":82160,"_5797":77258},[],"/docs/pr-preview/pr-56/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_6892":1591,"_42174":1588,"_5":42651,"_29767":82162,"_28235":82163,"_5797":82164},[],"/docs/pr-preview/pr-56/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_6892":1592,"_42174":1588,"_5":42651,"_29767":82166,"_28235":82167,"_5797":82168},[],"/docs/pr-preview/pr-56/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_6892":1593,"_42174":1588,"_5":42651,"_29767":82170,"_28235":82171,"_5797":82172},[],"/docs/pr-preview/pr-56/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_6892":1594,"_42174":1588,"_5":42651,"_29767":82174,"_28235":82175,"_5797":82176},[],"/docs/pr-preview/pr-56/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_6892":1595,"_42174":1588,"_5":42651,"_29767":82178,"_28235":82179,"_5797":82180},[],"/docs/pr-preview/pr-56/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_6892":1596,"_42174":1588,"_5":42651,"_29767":82182,"_28235":82183,"_5797":82184},[],"/docs/pr-preview/pr-56/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_6892":1597,"_42174":1588,"_5":42651,"_29767":82186,"_28235":82187,"_5797":82188},[],"/docs/pr-preview/pr-56/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_6892":1598,"_42174":1588,"_29767":82190,"_5":21387,"_28235":1588,"_5797":82191},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_6892":1599,"_42174":1588,"_29767":82193,"_5":21387,"_28235":82160,"_5797":82194},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_6892":1600,"_42174":1588,"_29767":82196,"_5":21387,"_28235":82160,"_5797":82197},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_6892":1601,"_42174":1588,"_29767":82199,"_5":21387,"_28235":82160,"_5797":82200},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_6892":1602,"_42174":1588,"_29767":82202,"_5":21387,"_28235":82160,"_5797":82203},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_6892":1603,"_42174":1588,"_29767":82205,"_5":21387,"_28235":82160,"_5797":82206},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_6892":1604,"_42174":1588,"_29767":82208,"_5":21387,"_28235":82163,"_5797":82209},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_6892":1605,"_42174":1588,"_29767":82211,"_5":21387,"_28235":82163,"_5797":82212},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_6892":1606,"_42174":1588,"_29767":82214,"_5":21387,"_28235":82167,"_5797":82215},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_6892":1607,"_42174":1588,"_29767":82217,"_5":21387,"_28235":82167,"_5797":82218},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_6892":1608,"_42174":1588,"_29767":82220,"_5":21387,"_28235":82167,"_5797":82221},[],"Setting",{"_6892":1609,"_42174":1588,"_29767":82223,"_5":21387,"_28235":82167,"_5797":82224},[],"Evaluation value",{"_6892":1610,"_42174":1588,"_29767":82226,"_5":21387,"_28235":82167,"_5797":82227},[],"Enrollment CA",{"_6892":1611,"_42174":1588,"_29767":82229,"_5":21387,"_28235":82167,"_5797":82230},[],"Issuing root from `device-root.pem`.",{"_6892":1612,"_42174":1588,"_29767":82232,"_5":21387,"_28235":82167,"_5797":80016},[],{"_6892":1613,"_42174":1588,"_29767":82234,"_5":21387,"_28235":82167,"_5797":82235},[],"The 1-hour leaf profile you just prepared.",{"_6892":1614,"_42174":1588,"_29767":82237,"_5":21387,"_28235":82167,"_5797":82238},[],"Protocol / Registration Mode",{"_6892":1615,"_42174":1588,"_29767":82240,"_5":21387,"_28235":82167,"_5797":82241},[],"`EST_RFC7030` / `JITP`.",{"_6892":1616,"_42174":1588,"_29767":82243,"_5":21387,"_28235":82167,"_5797":82244},[],"Verify CSR Signature",{"_6892":1617,"_42174":1588,"_29767":82246,"_5":21387,"_28235":82167,"_5797":82247},[],"Enabled.",{"_6892":1618,"_42174":1588,"_29767":82249,"_5":21387,"_28235":82167,"_5797":82250},[],"Enable Replaceable Enrollment",{"_6892":1619,"_42174":1588,"_29767":82252,"_5":21387,"_28235":82167,"_5797":82253},[],"Disabled; the ID must be new.",{"_6892":1620,"_42174":1588,"_29767":82255,"_5":21387,"_28235":82167,"_5797":82256},[],"Initial authentication",{"_6892":1621,"_42174":1588,"_29767":82258,"_5":21387,"_28235":82167,"_5797":82259},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_6892":1622,"_42174":1588,"_29767":82261,"_5":21387,"_28235":82167,"_5797":82262},[],"Renewal authentication",{"_6892":1623,"_42174":1588,"_29767":82264,"_5":21387,"_28235":82167,"_5797":82265},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_6892":1624,"_42174":1588,"_29767":82267,"_5":21387,"_28235":82167,"_5797":82268},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_6892":1625,"_42174":1588,"_29767":82270,"_5":21387,"_28235":82167,"_5797":82271},[],"Not needed for this direct issuance; the Enrollment CA is always trusted for re-enrollment / disabled.",{"_6892":1626,"_42174":1588,"_29767":82273,"_5":21387,"_28235":82167,"_5797":82274},[],"Re-enrollment Delta",{"_6892":1627,"_42174":1588,"_29767":82276,"_5":21387,"_28235":82167,"_5797":82277},[],"1 hour.",{"_6892":1628,"_42174":1588,"_29767":82279,"_5":21387,"_28235":82167,"_5797":82280},[],"Preventive / Critical Delta",{"_6892":1629,"_42174":1588,"_29767":82282,"_5":21387,"_28235":82167,"_5797":82283},[],"30 minutes / 10 minutes.",{"_6892":1630,"_42174":1588,"_29767":82285,"_5":21387,"_28235":82167,"_5797":82286},[],"Revoke on Re-enrollment",{"_6892":1631,"_42174":1588,"_29767":82288,"_5":21387,"_28235":82167,"_5797":82289},[],"Disabled to test the successor before retiring the previous identity.",{"_6892":1632,"_42174":1588,"_29767":82291,"_5":21387,"_28235":82167,"_5797":80024},[],{"_6892":1633,"_42174":1588,"_29767":82293,"_5":21387,"_28235":82167,"_5797":82294},[],"Disabled; the operational key is generated in the client.",{"_6892":1634,"_42174":1588,"_29767":82296,"_5":21387,"_28235":82167,"_5797":82297},[],"CA Distribution",{"_6892":1635,"_42174":1588,"_29767":82299,"_5":21387,"_28235":82167,"_5797":82300},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_6892":1636,"_42174":1588,"_29767":82302,"_5":21387,"_28235":82167,"_5797":82303},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. The console exposes independent editors for the enrollment and re-enrollment authentication; the DMS guide describes their fields, and you can also check the resource through the DMS API.",{"_6892":1637,"_42174":1588,"_29767":82305,"_5":21387,"_28235":82171,"_5797":82306},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_6892":1638,"_42174":1588,"_29767":82308,"_5":21387,"_28235":82171,"_5797":82309},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_6892":1639,"_42174":1588,"_29767":82311,"_5":21387,"_28235":82175,"_5797":82312},[],"Generate a new key and CSR with the selected identifier:",{"_6892":1640,"_42174":1588,"_29767":82314,"_5":21387,"_28235":82175,"_5797":82315},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_6892":1641,"_42174":1588,"_29767":82317,"_5":21387,"_28235":82175,"_5797":82318},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_6892":1642,"_42174":1588,"_29767":82320,"_5":21387,"_28235":82179,"_5797":82321},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_6892":1643,"_42174":1588,"_29767":82323,"_5":21387,"_28235":82179,"_5797":82324},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_6892":1644,"_42174":1588,"_29767":82326,"_5":21387,"_28235":82183,"_5797":82327},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_6892":1645,"_42174":1588,"_29767":82329,"_5":21387,"_28235":82183,"_5797":82330},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_6892":1646,"_42174":1588,"_29767":82332,"_5":21387,"_28235":82183,"_5797":82333},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_6892":1647,"_42174":1588,"_29767":82335,"_5":21387,"_28235":82183,"_5797":82336},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_6892":1648,"_42174":1588,"_29767":82338,"_5":21387,"_28235":82183,"_5797":82339},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_6892":1649,"_42174":1588,"_29767":82341,"_5":21387,"_28235":82187,"_5797":82342},[],"Check",{"_6892":1650,"_42174":1588,"_29767":82344,"_5":21387,"_28235":82187,"_5797":82345},[],"Expected result",{"_6892":1651,"_42174":1588,"_29767":82347,"_5":21387,"_28235":82187,"_5797":82348},[],"Registration",{"_6892":1652,"_42174":1588,"_29767":82350,"_5":21387,"_28235":82187,"_5797":82351},[],"ID created automatically and correct DMS.",{"_6892":1653,"_42174":1588,"_29767":82353,"_5":21387,"_28235":82187,"_5797":81593},[],{"_6892":1654,"_42174":1588,"_29767":82355,"_5":21387,"_28235":82187,"_5797":82356},[],"CN, profile, serial and key verified.",{"_6892":1655,"_42174":1588,"_29767":82358,"_5":21387,"_28235":82187,"_5797":82359},[],"Inventory",{"_6892":1656,"_42174":1588,"_29767":82361,"_5":21387,"_28235":82187,"_5797":82362},[],"Received serial visible as the current identity and in history.",{"_6892":1657,"_42174":1588,"_29767":82364,"_5":21387,"_28235":82187,"_5797":82365},[],"Consumer",{"_6892":1658,"_42174":1588,"_29767":82367,"_5":21387,"_28235":82187,"_5797":82368},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_6892":1659,"_42174":1588,"_29767":82370,"_5":21387,"_28235":82187,"_5797":82371},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_6892":1660,"_42174":1588,"_29767":82373,"_5":21387,"_28235":82187,"_5797":82374},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_6892":1661,"_42174":1661,"_5":21817,"_5797":79721,"_42654":82376,"_29767":82377,"_28235":1661},[77248,78697,79705,82153],[],{"_6892":1662,"_42174":1661,"_29767":82379,"_5":21387,"_28235":1661,"_5797":82380},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_6892":1663,"_42174":1661,"_5":42651,"_29767":82382,"_28235":82383,"_5797":77258},[],"/docs/pr-preview/pr-56/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_6892":1664,"_42174":1661,"_5":42651,"_29767":82385,"_28235":82386,"_5797":82387},[],"/docs/pr-preview/pr-56/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_6892":1665,"_42174":1661,"_5":42651,"_29767":82389,"_28235":82390,"_5797":82391},[],"/docs/pr-preview/pr-56/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_6892":1666,"_42174":1661,"_5":42651,"_29767":82393,"_28235":82394,"_5797":82395},[],"/docs/pr-preview/pr-56/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_6892":1667,"_42174":1661,"_5":42651,"_29767":82397,"_28235":82398,"_5797":82399},[],"/docs/pr-preview/pr-56/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_6892":1668,"_42174":1661,"_5":42651,"_29767":82401,"_28235":82402,"_5797":82403},[],"/docs/pr-preview/pr-56/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_6892":1669,"_42174":1661,"_5":42651,"_29767":82405,"_28235":82406,"_5797":82345},[],"/docs/pr-preview/pr-56/platform/iot-fleets/quickstarts/register-device#expected-result",{"_6892":1670,"_42174":1661,"_5":42651,"_29767":82408,"_28235":82409,"_5797":82410},[],"/docs/pr-preview/pr-56/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_6892":1671,"_42174":1661,"_5":42651,"_29767":82412,"_28235":82413,"_5797":82414},[],"/docs/pr-preview/pr-56/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_6892":1672,"_42174":1661,"_29767":82416,"_5":21387,"_28235":1661,"_5797":82417},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_6892":1673,"_42174":1661,"_29767":82419,"_5":21387,"_28235":1661,"_5797":82420},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_6892":1674,"_42174":1661,"_29767":82422,"_5":21387,"_28235":82383,"_5797":82423},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_6892":1675,"_42174":1661,"_29767":82425,"_5":21387,"_28235":82383,"_5797":82426},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_6892":1676,"_42174":1661,"_29767":82428,"_5":21387,"_28235":82383,"_5797":82429},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_6892":1677,"_42174":1661,"_29767":82431,"_5":21387,"_28235":82383,"_5797":82432},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_6892":1678,"_42174":1661,"_29767":82434,"_5":21387,"_28235":82386,"_5797":82435},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_6892":1679,"_42174":1661,"_29767":82437,"_5":21387,"_28235":82386,"_5797":82438},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_6892":1680,"_42174":1661,"_29767":82440,"_5":21387,"_28235":82386,"_5797":82441},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_6892":1681,"_42174":1661,"_29767":82443,"_5":21387,"_28235":82386,"_5797":82444},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_6892":1682,"_42174":1661,"_29767":82446,"_5":21387,"_28235":82386,"_5797":82447},[],"In the authentication section, enable **Require client certificate** and leave **Call external webhook** off. Under **Require client certificate**, add the CA whose initial certificates you will accept to **Validation CAs**; for this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and leave **Enable server-side key generation** off if you will not use it.",{"_6892":1683,"_42174":1661,"_29767":82449,"_5":21387,"_28235":82386,"_5797":82450},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_6892":1684,"_42174":1661,"_29767":82452,"_5":21387,"_28235":82386,"_5797":82453},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_6892":1685,"_42174":1661,"_29767":82455,"_5":21387,"_28235":82386,"_5797":82456},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_6892":1686,"_42174":1661,"_29767":82458,"_5":21387,"_28235":82390,"_5797":82459},[],"Open **Managed Devices** and the registration action. Complete:",{"_6892":1687,"_42174":1661,"_29767":82461,"_5":21387,"_28235":82390,"_5797":82462},[],"**Device ID**: `device-001`.",{"_6892":1688,"_42174":1661,"_29767":82464,"_5":21387,"_28235":82390,"_5797":82465},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_6892":1689,"_42174":1661,"_29767":82467,"_5":21387,"_28235":82390,"_5797":82468},[],"**Icon** and **Tags**: optional classification.",{"_6892":1690,"_42174":1661,"_29767":82470,"_5":21387,"_28235":82390,"_5797":82471},[],"Confirm registration.",{"_6892":1691,"_42174":1661,"_29767":82473,"_5":21387,"_28235":82394,"_5797":82474},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_6892":1692,"_42174":1661,"_29767":82476,"_5":21387,"_28235":82394,"_5797":82477},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_6892":1693,"_42174":1661,"_29767":82479,"_5":21387,"_28235":82398,"_5797":82480},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_6892":1694,"_42174":1661,"_29767":82482,"_5":21387,"_28235":82398,"_5797":82483},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_6892":1695,"_42174":1661,"_29767":82485,"_5":21387,"_28235":82402,"_5797":82486},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_6892":1696,"_42174":1661,"_29767":82488,"_5":21387,"_28235":82402,"_5797":82489},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_6892":1697,"_42174":1661,"_29767":82491,"_5":21387,"_28235":82406,"_5797":82342},[],{"_6892":1698,"_42174":1661,"_29767":82493,"_5":21387,"_28235":82406,"_5797":82494},[],"Result",{"_6892":1699,"_42174":1661,"_29767":82496,"_5":21387,"_28235":82406,"_5797":81576},[],{"_6892":1700,"_42174":1661,"_29767":82498,"_5":21387,"_28235":82406,"_5797":82499},[],"`device-001` appears in inventory with the expected DMS.",{"_6892":1701,"_42174":1661,"_29767":82501,"_5":21387,"_28235":82406,"_5797":82502},[],"Current identity",{"_6892":1702,"_42174":1661,"_29767":82504,"_5":21387,"_28235":82406,"_5797":82505},[],"The associated certificate matches the one you verified in PKI.",{"_6892":1703,"_42174":1661,"_29767":82507,"_5":21387,"_28235":82406,"_5797":82508},[],"History",{"_6892":1704,"_42174":1661,"_29767":82510,"_5":21387,"_28235":82406,"_5797":82511},[],"The associated issuance appears with its serial number and dates.",{"_6892":1705,"_42174":1661,"_29767":82513,"_5":21387,"_28235":82406,"_5797":82514},[],"Key and certificate",{"_6892":1706,"_42174":1661,"_29767":82516,"_5":21387,"_28235":82406,"_5797":82517},[],"You have the verified pair ready to install on the device.",{"_6892":1707,"_42174":1661,"_29767":82519,"_5":21387,"_28235":82409,"_5797":82520},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_6892":1708,"_42174":1661,"_29767":82522,"_5":21387,"_28235":82409,"_5797":82523},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_6892":1709,"_42174":1661,"_29767":82525,"_5":21387,"_28235":82409,"_5797":82526},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_6892":1710,"_42174":1661,"_29767":82528,"_5":21387,"_28235":82409,"_5797":82529},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_6892":1711,"_42174":1661,"_29767":82531,"_5":21387,"_28235":82413,"_5797":82532},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_6892":1712,"_42174":1661,"_29767":82534,"_5":21387,"_28235":82413,"_5797":82535},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_6892":1713,"_42174":1661,"_29767":82537,"_5":21387,"_28235":82413,"_5797":82538},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_6892":1714,"_42174":1714,"_5":21817,"_5797":82540,"_42654":82541,"_29767":82542,"_28235":1714},"Lamassu IoT Platform",[77248,78697],[],{"_6892":1715,"_42174":1714,"_29767":82544,"_5":21387,"_28235":1714,"_5797":82545},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_6892":1716,"_42174":1714,"_5":42651,"_29767":82547,"_28235":82548,"_5797":82015},[],"/docs/pr-preview/pr-56/platform/overview#start-here",{"_6892":1717,"_42174":1714,"_5":42651,"_29767":82550,"_28235":82551,"_5797":82552},[],"/docs/pr-preview/pr-56/platform/overview#choose-your-path","Choose your path",{"_6892":1718,"_42174":1714,"_5":42651,"_29767":82554,"_28235":82555,"_5797":82556},[],"/docs/pr-preview/pr-56/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_6892":1719,"_42174":1714,"_5":42651,"_29767":82558,"_28235":82559,"_5797":82560},[],"/docs/pr-preview/pr-56/platform/overview#core-capabilities","Core capabilities",{"_6892":1720,"_42174":1714,"_5":42651,"_29767":82562,"_28235":82563,"_5797":82564},[],"/docs/pr-preview/pr-56/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_6892":1721,"_42174":1714,"_5":42651,"_29767":82566,"_28235":82567,"_5797":82568},[],"/docs/pr-preview/pr-56/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_6892":1722,"_42174":1714,"_5":42651,"_29767":82570,"_28235":82571,"_5797":82572},[],"/docs/pr-preview/pr-56/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_6892":1723,"_42174":1714,"_5":42651,"_29767":82574,"_28235":82575,"_5797":82576},[],"/docs/pr-preview/pr-56/platform/overview#automate-device-identities","Automate device identities",{"_6892":1724,"_42174":1714,"_5":42651,"_29767":82578,"_28235":82579,"_5797":82580},[],"/docs/pr-preview/pr-56/platform/overview#publish-validation-status","Publish validation status",{"_6892":1725,"_42174":1714,"_5":42651,"_29767":82582,"_28235":82583,"_5797":82584},[],"/docs/pr-preview/pr-56/platform/overview#react-to-events","React to events",{"_6892":1726,"_42174":1714,"_5":42651,"_29767":82586,"_28235":82587,"_5797":82588},[],"/docs/pr-preview/pr-56/platform/overview#operational-reference","Operational reference",{"_6892":1727,"_42174":1714,"_29767":82590,"_5":21387,"_28235":1714,"_5797":82591},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_6892":1728,"_42174":1714,"_29767":82593,"_5":21387,"_28235":82548,"_5797":82594},[],"Choose the result you need:",{"_6892":1729,"_42174":1714,"_29767":82596,"_5":21387,"_28235":82548,"_5797":82597},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_6892":1730,"_42174":1714,"_29767":82599,"_5":21387,"_28235":82548,"_5797":82600},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_6892":1731,"_42174":1714,"_29767":82602,"_5":21387,"_28235":82548,"_5797":82603},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_6892":1732,"_42174":1714,"_29767":82605,"_5":21387,"_28235":82551,"_5797":82606},[],"Section",{"_6892":1733,"_42174":1714,"_29767":82608,"_5":21387,"_28235":82551,"_5797":82609},[],"What you manage",{"_6892":1734,"_42174":1714,"_29767":82611,"_5":21387,"_28235":82551,"_5797":82612},[],"Entry point",{"_6892":1735,"_42174":1714,"_29767":82614,"_5":21387,"_28235":82551,"_5797":82615},[],"**PKI**",{"_6892":1736,"_42174":1714,"_29767":82617,"_5":21387,"_28235":82551,"_5797":82618},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_6892":1737,"_42174":1714,"_29767":82620,"_5":21387,"_28235":82551,"_5797":82621},[],"PKI overview",{"_6892":1738,"_42174":1714,"_29767":82623,"_5":21387,"_28235":82551,"_5797":82624},[],"**IoT Fleets**",{"_6892":1739,"_42174":1714,"_29767":82626,"_5":21387,"_28235":82551,"_5797":82627},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_6892":1740,"_42174":1714,"_29767":82629,"_5":21387,"_28235":82551,"_5797":82630},[],"IoT Fleets overview",{"_6892":1741,"_42174":1714,"_29767":82632,"_5":21387,"_28235":82551,"_5797":82633},[],"**Administration**",{"_6892":1742,"_42174":1714,"_29767":82635,"_5":21387,"_28235":82551,"_5797":82636},[],"Operator permissions, audit and event subscriptions.",{"_6892":1743,"_42174":1714,"_29767":82638,"_5":21387,"_28235":82551,"_5797":78695},[],{"_6892":1744,"_42174":1714,"_29767":82640,"_5":21387,"_28235":82551,"_5797":82641},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_6892":1745,"_42174":1714,"_29767":82643,"_5":21387,"_28235":82555,"_5797":82644},[],"An identity's journey connects four responsibilities:",{"_6892":1746,"_42174":1714,"_29767":82646,"_5":21387,"_28235":82555,"_5797":82647},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_6892":1747,"_42174":1714,"_29767":82649,"_5":21387,"_28235":82555,"_5797":82650},[],"The provisioning administrator configures the DMS and initial trust.",{"_6892":1748,"_42174":1714,"_29767":82652,"_5":21387,"_28235":82555,"_5797":82653},[],"The device client requests a certificate and installs it with the matching key.",{"_6892":1749,"_42174":1714,"_29767":82655,"_5":21387,"_28235":82555,"_5797":82656},[],"The consumer validates the identity and applies its access permissions.",{"_6892":1750,"_42174":1714,"_29767":82658,"_5":21387,"_28235":82555,"_5797":82659},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_6892":1751,"_42174":1714,"_29767":82661,"_5":21387,"_28235":82563,"_5797":82662},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_6892":1752,"_42174":1714,"_29767":82664,"_5":21387,"_28235":82567,"_5797":82665},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_6892":1753,"_42174":1714,"_29767":82667,"_5":21387,"_28235":82571,"_5797":82668},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_6892":1754,"_42174":1714,"_29767":82670,"_5":21387,"_28235":82575,"_5797":82671},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_6892":1755,"_42174":1714,"_29767":82673,"_5":21387,"_28235":82579,"_5797":82674},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_6892":1756,"_42174":1714,"_29767":82676,"_5":21387,"_28235":82583,"_5797":82677},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_6892":1757,"_42174":1714,"_29767":82679,"_5":21387,"_28235":82587,"_5797":82122},[],{"_6892":1758,"_42174":1714,"_29767":82681,"_5":21387,"_28235":82587,"_5797":82682},[],"What it prepares or checks",{"_6892":1759,"_42174":1714,"_29767":82684,"_5":21387,"_28235":82587,"_5797":82125},[],{"_6892":1760,"_42174":1714,"_29767":82686,"_5":21387,"_28235":82587,"_5797":82687},[],"Key custody, CA hierarchy, profiles and validation.",{"_6892":1761,"_42174":1714,"_29767":82689,"_5":21387,"_28235":82587,"_5797":82690},[],"Fleet administrator",{"_6892":1762,"_42174":1714,"_29767":82692,"_5":21387,"_28235":82587,"_5797":82693},[],"DMS, device admission, renewal policy and inventory.",{"_6892":1763,"_42174":1714,"_29767":82695,"_5":21387,"_28235":82587,"_5797":82137},[],{"_6892":1764,"_42174":1714,"_29767":82697,"_5":21387,"_28235":82587,"_5797":82698},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_6892":1765,"_42174":1714,"_29767":82700,"_5":21387,"_28235":82587,"_5797":82143},[],{"_6892":1766,"_42174":1714,"_29767":82702,"_5":21387,"_28235":82587,"_5797":82703},[],"Issuer trust, certificate validation and permissions in the destination.",{"_6892":1767,"_42174":1714,"_29767":82705,"_5":21387,"_28235":82587,"_5797":82706},[],"Infrastructure operator",{"_6892":1768,"_42174":1714,"_29767":82708,"_5":21387,"_28235":82587,"_5797":82709},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_6892":1769,"_42174":1714,"_29767":82711,"_5":21387,"_28235":82587,"_5797":82712},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_6892":1770,"_42174":1770,"_5":21817,"_5797":82714,"_42654":82715,"_29767":82718,"_28235":1770},"CA hierarchy and rotation",[77248,78697,82716,82717],"PKI","Keys, authorities and certificates",[],{"_6892":1771,"_42174":1770,"_29767":82720,"_5":21387,"_28235":1770,"_5797":82721},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_6892":1772,"_42174":1770,"_5":42651,"_29767":82723,"_28235":82724,"_5797":82725},[],"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_6892":1773,"_42174":1770,"_5":42651,"_29767":82727,"_28235":82728,"_5797":82729},[],"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_6892":1774,"_42174":1770,"_5":42651,"_29767":82731,"_28235":82732,"_5797":82733},[],"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_6892":1775,"_42174":1770,"_5":42651,"_29767":82735,"_28235":82736,"_5797":82737},[],"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_6892":1776,"_42174":1770,"_5":42651,"_29767":82739,"_28235":82740,"_5797":82741},[],"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_6892":1777,"_42174":1770,"_5":42651,"_29767":82743,"_28235":82744,"_5797":82745},[],"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_6892":1778,"_42174":1770,"_5":42651,"_29767":82747,"_28235":82748,"_5797":82749},[],"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_6892":1779,"_42174":1770,"_5":42651,"_29767":82751,"_28235":82752,"_5797":82753},[],"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_6892":1780,"_42174":1770,"_5":42651,"_29767":82755,"_28235":82756,"_5797":82757},[],"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_6892":1781,"_42174":1770,"_5":42651,"_29767":82759,"_28235":82760,"_5797":82761},[],"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_6892":1782,"_42174":1770,"_5":42651,"_29767":82763,"_28235":82764,"_5797":82765},[],"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_6892":1783,"_42174":1770,"_5":42651,"_29767":82767,"_28235":82768,"_5797":82769},[],"/docs/pr-preview/pr-56/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_6892":1784,"_42174":1770,"_29767":82771,"_5":21387,"_28235":1770,"_5797":82772},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_6892":1785,"_42174":1770,"_29767":82774,"_5":21387,"_28235":1770,"_5797":82775},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_6892":1786,"_42174":1770,"_29767":82777,"_5":21387,"_28235":82724,"_5797":82778},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_6892":1787,"_42174":1770,"_29767":82780,"_5":21387,"_28235":82724,"_5797":82781},[],"environment, such as production and preproduction;",{"_6892":1788,"_42174":1770,"_29767":82783,"_5":21387,"_28235":82724,"_5797":82784},[],"owner or operating team;",{"_6892":1789,"_42174":1770,"_29767":82786,"_5":21387,"_28235":82724,"_5797":82787},[],"device family or manufacturing process;",{"_6892":1790,"_42174":1770,"_29767":82789,"_5":21387,"_28235":82724,"_5797":82790},[],"region or regulatory requirement;",{"_6892":1791,"_42174":1770,"_29767":82792,"_5":21387,"_28235":82724,"_5797":82793},[],"cryptographic engine or key policy;",{"_6892":1792,"_42174":1770,"_29767":82795,"_5":21387,"_28235":82724,"_5797":82796},[],"maintenance window and renewal cadence.",{"_6892":1793,"_42174":1770,"_29767":82798,"_5":21387,"_28235":82724,"_5797":82799},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_6892":1794,"_42174":1770,"_29767":82801,"_5":21387,"_28235":82724,"_5797":82802},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_6892":1795,"_42174":1770,"_29767":82804,"_5":21387,"_28235":82728,"_5797":82805},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_6892":1796,"_42174":1770,"_29767":82807,"_5":21387,"_28235":82728,"_5797":82808},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_6892":1797,"_42174":1770,"_29767":82810,"_5":21387,"_28235":82728,"_5797":82811},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_6892":1798,"_42174":1770,"_29767":82813,"_5":21387,"_28235":82732,"_5797":82814},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_6892":1799,"_42174":1770,"_29767":82816,"_5":21387,"_28235":82732,"_5797":82817},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_6892":1800,"_42174":1770,"_29767":82819,"_5":21387,"_28235":82732,"_5797":82820},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_6892":1801,"_42174":1770,"_29767":82822,"_5":21387,"_28235":82732,"_5797":82823},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_6892":1802,"_42174":1770,"_29767":82825,"_5":21387,"_28235":82740,"_5797":82826},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_6892":1803,"_42174":1770,"_29767":82828,"_5":21387,"_28235":82744,"_5797":82829},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_6892":1804,"_42174":1770,"_29767":82831,"_5":21387,"_28235":82748,"_5797":82832},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_6892":1805,"_42174":1770,"_29767":82834,"_5":21387,"_28235":82752,"_5797":82835},[],"Update the enrollment CA and profile of the DMSs. While old-CA cohorts still renew, add the previous enrollment CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`): the new enrollment CA is trusted automatically, but the old one was the enrollment CA and appears in no re-enrollment trust list, so without that entry its certificates can no longer renew. The DMS guide documents the setting.",{"_6892":1806,"_42174":1770,"_29767":82837,"_5":21387,"_28235":82756,"_5797":82838},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_6892":1807,"_42174":1770,"_29767":82840,"_5":21387,"_28235":82760,"_5797":82841},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance, from the re-enrollment validation CAs and from the distributed CAs. Revoke it if policy requires it.",{"_6892":1808,"_42174":1770,"_29767":82843,"_5":21387,"_28235":82764,"_5797":82844},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_6892":1809,"_42174":1770,"_29767":82846,"_5":21387,"_28235":82764,"_5797":82847},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_6892":1810,"_42174":1770,"_29767":82849,"_5":21387,"_28235":82764,"_5797":82850},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_6892":1811,"_42174":1770,"_29767":82852,"_5":21387,"_28235":82764,"_5797":82853},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_6892":1812,"_42174":1770,"_29767":82855,"_5":21387,"_28235":82768,"_5797":82856},[],"The new chain ends in an anchor installed by the consumer.",{"_6892":1813,"_42174":1770,"_29767":82858,"_5":21387,"_28235":82768,"_5797":82859},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_6892":1814,"_42174":1770,"_29767":82861,"_5":21387,"_28235":82768,"_5797":82862},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_6892":1815,"_42174":1770,"_29767":82864,"_5":21387,"_28235":82768,"_5797":82865},[],"Re-enrollment accepts the old identity during the planned period.",{"_6892":1816,"_42174":1770,"_29767":82867,"_5":21387,"_28235":82768,"_5797":82868},[],"OCSP and CRL respond for the authorities that remain active.",{"_6892":1817,"_42174":1770,"_29767":82870,"_5":21387,"_28235":82768,"_5797":82871},[],"No DMS is left accidentally issuing from the old CA.",{"_6892":1818,"_42174":1770,"_29767":82873,"_5":21387,"_28235":82768,"_5797":82874},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_6892":1819,"_42174":1819,"_5":21817,"_5797":82876,"_42654":82877,"_29767":82878,"_28235":1819},"Certification authorities",[77248,78697,82716,82717],[],{"_6892":1820,"_42174":1819,"_29767":82880,"_5":21387,"_28235":1819,"_5797":82881},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_6892":1821,"_42174":1819,"_5":42651,"_29767":82883,"_28235":82884,"_5797":82885},[],"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_6892":1822,"_42174":1819,"_5":42651,"_29767":82887,"_28235":82888,"_5797":82889},[],"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_6892":1823,"_42174":1819,"_5":42651,"_29767":82891,"_28235":82892,"_5797":77258},[],"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#before-you-begin",{"_6892":1824,"_42174":1819,"_5":42651,"_29767":82894,"_28235":82895,"_5797":82896},[],"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_6892":1825,"_42174":1819,"_5":42651,"_29767":82898,"_28235":82899,"_5797":82900},[],"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_6892":1826,"_42174":1819,"_5":42651,"_29767":82902,"_28235":82903,"_5797":82904},[],"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_6892":1827,"_42174":1819,"_5":42651,"_29767":82906,"_28235":82907,"_5797":82908},[],"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_6892":1828,"_42174":1819,"_5":42651,"_29767":82910,"_28235":82911,"_5797":82912},[],"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_6892":1829,"_42174":1819,"_5":42651,"_29767":82914,"_28235":82915,"_5797":82916},[],"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_6892":1830,"_42174":1819,"_5":42651,"_29767":82918,"_28235":82919,"_5797":82920},[],"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_6892":1831,"_42174":1819,"_5":42651,"_29767":82922,"_28235":82923,"_5797":82924},[],"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_6892":1832,"_42174":1819,"_5":42651,"_29767":82926,"_28235":82927,"_5797":82928},[],"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_6892":1833,"_42174":1819,"_5":42651,"_29767":82930,"_28235":82931,"_5797":82932},[],"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#load-the-material","Load the material",{"_6892":1834,"_42174":1819,"_5":42651,"_29767":82934,"_28235":82935,"_5797":82936},[],"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_6892":1835,"_42174":1819,"_5":42651,"_29767":82938,"_28235":82939,"_5797":82940},[],"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_6892":1836,"_42174":1819,"_5":42651,"_29767":82942,"_28235":82943,"_5797":82944},[],"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_6892":1837,"_42174":1819,"_5":42651,"_29767":82946,"_28235":82947,"_5797":82948},[],"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_6892":1838,"_42174":1819,"_5":42651,"_29767":82950,"_28235":82951,"_5797":82952},[],"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_6892":1839,"_42174":1819,"_5":42651,"_29767":82954,"_28235":82955,"_5797":82956},[],"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_6892":1840,"_42174":1819,"_5":42651,"_29767":82958,"_28235":82959,"_5797":82960},[],"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_6892":1841,"_42174":1819,"_5":42651,"_29767":82962,"_28235":82963,"_5797":82964},[],"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_6892":1842,"_42174":1819,"_5":42651,"_29767":82966,"_28235":82967,"_5797":82968},[],"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_6892":1843,"_42174":1819,"_5":42651,"_29767":82970,"_28235":82971,"_5797":82972},[],"/docs/pr-preview/pr-56/platform/pki/certificate-authorities#delete-a-ca","Delete a CA",{"_6892":1844,"_42174":1819,"_29767":82974,"_5":21387,"_28235":1819,"_5797":82975},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_6892":1845,"_42174":1819,"_29767":82977,"_5":21387,"_28235":1819,"_5797":82978},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_6892":1846,"_42174":1819,"_29767":82980,"_5":21387,"_28235":1819,"_5797":82981},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_6892":1847,"_42174":1819,"_29767":82983,"_5":21387,"_28235":82884,"_5797":82984},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_6892":1848,"_42174":1819,"_29767":82986,"_5":21387,"_28235":82884,"_5797":82987},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_6892":1849,"_42174":1819,"_29767":82989,"_5":21387,"_28235":82884,"_5797":82990},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_6892":1850,"_42174":1819,"_29767":82992,"_5":21387,"_28235":82884,"_5797":82993},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_6892":1851,"_42174":1819,"_29767":82995,"_5":21387,"_28235":82884,"_5797":82996},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_6892":1852,"_42174":1819,"_29767":82998,"_5":21387,"_28235":82892,"_5797":82999},[],"Decide whether the CA will be a root or an intermediate.",{"_6892":1853,"_42174":1819,"_29767":83001,"_5":21387,"_28235":82892,"_5797":83002},[],"Choose the engine that will keep the key.",{"_6892":1854,"_42174":1819,"_29767":83004,"_5":21387,"_28235":82892,"_5797":83005},[],"Define a validity longer than that of the certificates it will issue.",{"_6892":1855,"_42174":1819,"_29767":83007,"_5":21387,"_28235":82892,"_5797":83008},[],"For an intermediate CA, make sure the parent CA is active.",{"_6892":1856,"_42174":1819,"_29767":83010,"_5":21387,"_28235":82895,"_5797":83011},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_6892":1857,"_42174":1819,"_29767":83013,"_5":21387,"_28235":82899,"_5797":83014},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_6892":1858,"_42174":1819,"_29767":83016,"_5":21387,"_28235":82899,"_5797":83017},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_6892":1859,"_42174":1819,"_29767":83019,"_5":21387,"_28235":82903,"_5797":83020},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_6892":1860,"_42174":1819,"_29767":83022,"_5":21387,"_28235":82907,"_5797":83023},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_6892":1861,"_42174":1819,"_29767":83025,"_5":21387,"_28235":82907,"_5797":83026},[],"`C`: two-letter ISO 3166-1 country code.",{"_6892":1862,"_42174":1819,"_29767":83028,"_5":21387,"_28235":82907,"_5797":83029},[],"`ST`: state or province.",{"_6892":1863,"_42174":1819,"_29767":83031,"_5":21387,"_28235":82907,"_5797":83032},[],"`L`: locality.",{"_6892":1864,"_42174":1819,"_29767":83034,"_5":21387,"_28235":82907,"_5797":83035},[],"`O`: organization.",{"_6892":1865,"_42174":1819,"_29767":83037,"_5":21387,"_28235":82907,"_5797":83038},[],"`OU`: organizational unit.",{"_6892":1866,"_42174":1819,"_29767":83040,"_5":21387,"_28235":82907,"_5797":83041},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_6892":1867,"_42174":1819,"_29767":83043,"_5":21387,"_28235":82911,"_5797":83044},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_6892":1868,"_42174":1819,"_29767":83046,"_5":21387,"_28235":82911,"_5797":83047},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_6892":1869,"_42174":1819,"_29767":83049,"_5":21387,"_28235":82915,"_5797":83050},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_6892":1870,"_42174":1819,"_29767":83052,"_5":21387,"_28235":82915,"_5797":83053},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_6892":1871,"_42174":1819,"_29767":83055,"_5":21387,"_28235":82919,"_5797":83056},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_6892":1872,"_42174":1819,"_29767":83058,"_5":21387,"_28235":82919,"_5797":83059},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_6892":1873,"_42174":1819,"_29767":83061,"_5":21387,"_28235":82923,"_5797":83062},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages (including `cRLSign`, without which the CA cannot publish its CRL) and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_6892":1874,"_42174":1819,"_29767":83064,"_5":21387,"_28235":82927,"_5797":83065},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_6892":1875,"_42174":1819,"_29767":83067,"_5":21387,"_28235":82931,"_5797":83068},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_6892":1876,"_42174":1819,"_29767":83070,"_5":21387,"_28235":82935,"_5797":83071},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_6892":1877,"_42174":1819,"_29767":83073,"_5":21387,"_28235":82939,"_5797":83074},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_6892":1878,"_42174":1819,"_29767":83076,"_5":21387,"_28235":82939,"_5797":83077},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_6892":1879,"_42174":1819,"_29767":83079,"_5":21387,"_28235":82943,"_5797":83080},[],"Open a CA from the inventory to review:",{"_6892":1880,"_42174":1819,"_29767":83082,"_5":21387,"_28235":82943,"_5797":83083},[],"Status and validity period.",{"_6892":1881,"_42174":1819,"_29767":83085,"_5":21387,"_28235":82943,"_5797":83086},[],"Certificate and chain in PEM format.",{"_6892":1882,"_42174":1819,"_29767":83088,"_5":21387,"_28235":82943,"_5797":83089},[],"Number of active, expired and revoked certificates.",{"_6892":1883,"_42174":1819,"_29767":83091,"_5":21387,"_28235":82943,"_5797":83092},[],"Certificates issued in **Issued Certificates**.",{"_6892":1884,"_42174":1819,"_29767":83094,"_5":21387,"_28235":82943,"_5797":83095},[],"The CRL linked to the authority.",{"_6892":1885,"_42174":1819,"_29767":83097,"_5":21387,"_28235":82943,"_5797":83098},[],"Metadata and the associated cryptographic engine.",{"_6892":1886,"_42174":1819,"_29767":83100,"_5":21387,"_28235":82943,"_5797":83101},[],"You can filter the inventory by name, status and CA type.",{"_6892":1887,"_42174":1819,"_29767":83103,"_5":21387,"_28235":82947,"_5797":83104},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_6892":1888,"_42174":1819,"_29767":83106,"_5":21387,"_28235":82947,"_5797":83107},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_6892":1889,"_42174":1819,"_29767":83109,"_5":21387,"_28235":82947,"_5797":83110},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_6892":1890,"_42174":1819,"_29767":83112,"_5":21387,"_28235":82947,"_5797":83113},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_6892":1891,"_42174":1819,"_29767":83115,"_5":21387,"_28235":82951,"_5797":83116},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_6892":1892,"_42174":1819,"_29767":83118,"_5":21387,"_28235":82955,"_5797":83119},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_6892":1893,"_42174":1819,"_29767":83121,"_5":21387,"_28235":82959,"_5797":83122},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_6892":1894,"_42174":1819,"_29767":83124,"_5":21387,"_28235":82963,"_5797":83125},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_6892":1895,"_42174":1819,"_29767":83127,"_5":21387,"_28235":82967,"_5797":83128},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_6892":1896,"_42174":1819,"_29767":83130,"_5":21387,"_28235":82971,"_5797":83131},[],"Permanent deletion is only available with the CA revoked or expired; a CA imported without a key can be deleted in any state. Delete the record only when your retention and audit policy allows it.",{"_6892":1897,"_42174":1819,"_29767":83133,"_5":21387,"_28235":82971,"_5797":83134},[],"The CA’s VA role is kept. If no other CA with the same SKI remains, it can no longer be edited (see CRL), so adjust its validity and signer beforehand. The CA’s key is released, but the KMS keeps it while other certificates still reference it.",{"_6892":1898,"_42174":1819,"_29767":83136,"_5":21387,"_28235":82971,"_5797":83137},[],"Lamassu keeps the certificate record of a deleted CA. If that same certificate is imported again, the import succeeds and reuses the record: it updates the type, issuer and key but keeps the status, so the CA reappears in the state it had when deleted (normally revoked or expired). A different certificate with the same serial number is rejected with a 400 error, and a certificate that already belongs to an existing CA with a 409 error. To avoid inheriting the previous status, use a certificate with a different serial number and check the result after importing. If the new certificate uses the same key, it shares the SKI with the retained VA role of the deleted CA, whose signer is the old certificate: check that the CRL is generated and, if it is not, use `PUT` to set a signer of the new CA (see CRL).",{"_6892":1899,"_42174":1899,"_5":21817,"_5797":83139,"_42654":83140,"_29767":83141,"_28235":1899},"Certificate profiles",[77248,78697,82716,82717],[],{"_6892":1900,"_42174":1899,"_29767":83143,"_5":21387,"_28235":1899,"_5797":83144},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_6892":1901,"_42174":1899,"_5":42651,"_29767":83146,"_28235":83147,"_5797":83148},[],"/docs/pr-preview/pr-56/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_6892":1902,"_42174":1899,"_5":42651,"_29767":83150,"_28235":83151,"_5797":83152},[],"/docs/pr-preview/pr-56/platform/pki/certificate-profiles#validity","Validity",{"_6892":1903,"_42174":1899,"_5":42651,"_29767":83154,"_28235":83155,"_5797":83156},[],"/docs/pr-preview/pr-56/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_6892":1904,"_42174":1899,"_5":42651,"_29767":83158,"_28235":83159,"_5797":83160},[],"/docs/pr-preview/pr-56/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_6892":1905,"_42174":1899,"_5":42651,"_29767":83162,"_28235":83163,"_5797":83164},[],"/docs/pr-preview/pr-56/platform/pki/certificate-profiles#subject","Subject",{"_6892":1906,"_42174":1899,"_5":42651,"_29767":83166,"_28235":83167,"_5797":83168},[],"/docs/pr-preview/pr-56/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_6892":1907,"_42174":1899,"_5":42651,"_29767":83170,"_28235":83171,"_5797":83172},[],"/docs/pr-preview/pr-56/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_6892":1908,"_42174":1899,"_5":42651,"_29767":83174,"_28235":83175,"_5797":83176},[],"/docs/pr-preview/pr-56/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_6892":1909,"_42174":1899,"_5":42651,"_29767":83178,"_28235":83179,"_5797":83180},[],"/docs/pr-preview/pr-56/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_6892":1910,"_42174":1899,"_5":42651,"_29767":83182,"_28235":83183,"_5797":83184},[],"/docs/pr-preview/pr-56/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_6892":1911,"_42174":1899,"_5":42651,"_29767":83186,"_28235":83187,"_5797":83188},[],"/docs/pr-preview/pr-56/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_6892":1912,"_42174":1899,"_5":42651,"_29767":83190,"_28235":83191,"_5797":83192},[],"/docs/pr-preview/pr-56/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_6892":1913,"_42174":1899,"_5":42651,"_29767":83194,"_28235":83195,"_5797":83196},[],"/docs/pr-preview/pr-56/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_6892":1914,"_42174":1899,"_5":42651,"_29767":83198,"_28235":83199,"_5797":83200},[],"/docs/pr-preview/pr-56/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_6892":1915,"_42174":1899,"_5":42651,"_29767":83202,"_28235":83203,"_5797":83204},[],"/docs/pr-preview/pr-56/platform/pki/certificate-profiles#design-examples","Design examples",{"_6892":1916,"_42174":1899,"_5":42651,"_29767":83206,"_28235":83207,"_5797":83208},[],"/docs/pr-preview/pr-56/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_6892":1917,"_42174":1899,"_29767":83210,"_5":21387,"_28235":1899,"_5797":83211},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_6892":1918,"_42174":1899,"_29767":83213,"_5":21387,"_28235":1899,"_5797":83214},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_6892":1919,"_42174":1899,"_29767":83216,"_5":21387,"_28235":83151,"_5797":83217},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_6892":1920,"_42174":1899,"_29767":83219,"_5":21387,"_28235":83151,"_5797":83220},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_6892":1921,"_42174":1899,"_29767":83222,"_5":21387,"_28235":83155,"_5797":83223},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Enable it only in profiles intended to create or reissue subordinate CAs.",{"_6892":1922,"_42174":1899,"_29767":83225,"_5":21387,"_28235":83159,"_5797":83226},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_6892":1923,"_42174":1899,"_29767":83228,"_5":21387,"_28235":83159,"_5797":83229},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_6892":1924,"_42174":1899,"_29767":83231,"_5":21387,"_28235":83159,"_5797":83232},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_6892":1925,"_42174":1899,"_29767":83234,"_5":21387,"_28235":83163,"_5797":83235},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_6892":1926,"_42174":1899,"_29767":83237,"_5":21387,"_28235":83167,"_5797":83238},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_6892":1927,"_42174":1899,"_29767":83240,"_5":21387,"_28235":83167,"_5797":83241},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_6892":1928,"_42174":1899,"_29767":83243,"_5":21387,"_28235":83171,"_5797":83244},[],"The cryptographic enforcement can:",{"_6892":1929,"_42174":1899,"_29767":83246,"_5":21387,"_28235":83171,"_5797":83247},[],"allow or block RSA keys;",{"_6892":1930,"_42174":1899,"_29767":83249,"_5":21387,"_28235":83171,"_5797":83250},[],"limit the supported RSA sizes;",{"_6892":1931,"_42174":1899,"_29767":83252,"_5":21387,"_28235":83171,"_5797":83253},[],"allow or block ECDSA keys;",{"_6892":1932,"_42174":1899,"_29767":83255,"_5":21387,"_28235":83171,"_5797":83256},[],"limit the supported ECDSA sizes or curves.",{"_6892":1933,"_42174":1899,"_29767":83258,"_5":21387,"_28235":83171,"_5797":83259},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_6892":1934,"_42174":1899,"_29767":83261,"_5":21387,"_28235":83175,"_5797":83262},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_6892":1935,"_42174":1899,"_29767":83264,"_5":21387,"_28235":83175,"_5797":80458},[],{"_6892":1936,"_42174":1899,"_29767":83266,"_5":21387,"_28235":83175,"_5797":83267},[],"First choice",{"_6892":1937,"_42174":1899,"_29767":83269,"_5":21387,"_28235":83175,"_5797":83270},[],"Second choice",{"_6892":1938,"_42174":1899,"_29767":83272,"_5":21387,"_28235":83175,"_5797":83273},[],"If neither is supplied",{"_6892":1939,"_42174":1899,"_29767":83275,"_5":21387,"_28235":83175,"_5797":83276},[],"Direct signing with a CA",{"_6892":1940,"_42174":1899,"_29767":83278,"_5":21387,"_28235":83175,"_5797":83279},[],"`issuance_profile` embedded in the request",{"_6892":1941,"_42174":1899,"_29767":83281,"_5":21387,"_28235":83175,"_5797":83282},[],"Request `issuance_profile_id`",{"_6892":1942,"_42174":1899,"_29767":83284,"_5":21387,"_28235":83175,"_5797":83285},[],"CA default profile (`profile_id`).",{"_6892":1943,"_42174":1899,"_29767":83287,"_5":21387,"_28235":83175,"_5797":83288},[],"Issuance through a DMS",{"_6892":1944,"_42174":1899,"_29767":83290,"_5":21387,"_28235":83175,"_5797":83291},[],"`settings.issuance_profile_id`",{"_6892":1945,"_42174":1899,"_29767":83293,"_5":21387,"_28235":83175,"_5797":83294},[],"`settings.issuance_profile` embedded in the DMS",{"_6892":1946,"_42174":1899,"_29767":83296,"_5":21387,"_28235":83175,"_5797":83297},[],"Enrollment CA default profile.",{"_6892":1947,"_42174":1899,"_29767":83299,"_5":21387,"_28235":83175,"_5797":83300},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_6892":1948,"_42174":1899,"_29767":83302,"_5":21387,"_28235":83175,"_5797":83303},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_6892":1949,"_42174":1899,"_29767":83305,"_5":21387,"_28235":83183,"_5797":83306},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_6892":1950,"_42174":1899,"_29767":83308,"_5":21387,"_28235":83187,"_5797":83309},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_6892":1951,"_42174":1899,"_29767":83311,"_5":21387,"_28235":83191,"_5797":83312},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_6892":1952,"_42174":1899,"_29767":83314,"_5":21387,"_28235":83195,"_5797":83315},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_6892":1953,"_42174":1899,"_29767":83317,"_5":21387,"_28235":83199,"_5797":83318},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_6892":1954,"_42174":1899,"_29767":83320,"_5":21387,"_28235":83199,"_5797":83321},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_6892":1955,"_42174":1899,"_29767":83323,"_5":21387,"_28235":83203,"_5797":83324},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_6892":1956,"_42174":1899,"_29767":83326,"_5":21387,"_28235":83203,"_5797":83327},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_6892":1957,"_42174":1899,"_29767":83329,"_5":21387,"_28235":83203,"_5797":83330},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_6892":1958,"_42174":1899,"_29767":83332,"_5":21387,"_28235":83203,"_5797":83333},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_6892":1959,"_42174":1899,"_29767":83335,"_5":21387,"_28235":83207,"_5797":83336},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_6892":1960,"_42174":1899,"_29767":83338,"_5":21387,"_28235":83207,"_5797":83339},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_6892":1961,"_42174":1961,"_5":21817,"_5797":83341,"_42654":83342,"_29767":83344,"_28235":1961},"Certificate validation",[77248,78697,82716,83343],"Validation",[],{"_6892":1962,"_42174":1961,"_29767":83346,"_5":21387,"_28235":1961,"_5797":83347},[],"Check chain, identity, purpose and revocation from the consumer.",{"_6892":1963,"_42174":1961,"_5":42651,"_29767":83349,"_28235":83350,"_5797":83351},[],"/docs/pr-preview/pr-56/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_6892":1964,"_42174":1961,"_5":42651,"_29767":83353,"_28235":83354,"_5797":83355},[],"/docs/pr-preview/pr-56/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_6892":1965,"_42174":1961,"_5":42651,"_29767":83357,"_28235":83358,"_5797":83359},[],"/docs/pr-preview/pr-56/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_6892":1966,"_42174":1961,"_29767":83361,"_5":21387,"_28235":1961,"_5797":83362},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_6892":1967,"_42174":1961,"_29767":83364,"_5":21387,"_28235":83350,"_5797":83365},[],"Verify these criteria together:",{"_6892":1968,"_42174":1961,"_29767":83367,"_5":21387,"_28235":83350,"_5797":82342},[],{"_6892":1969,"_42174":1961,"_29767":83369,"_5":21387,"_28235":83350,"_5797":83370},[],"Required result",{"_6892":1970,"_42174":1961,"_29767":83372,"_5":21387,"_28235":83350,"_5797":83373},[],"Chain and signature",{"_6892":1971,"_42174":1961,"_29767":83375,"_5":21387,"_28235":83350,"_5797":83376},[],"Valid chain to a root deliberately installed in the consumer.",{"_6892":1972,"_42174":1961,"_29767":83378,"_5":21387,"_28235":83350,"_5797":83379},[],"Dates",{"_6892":1973,"_42174":1961,"_29767":83381,"_5":21387,"_28235":83350,"_5797":83382},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_6892":1974,"_42174":1961,"_29767":83384,"_5":21387,"_28235":83350,"_5797":78366},[],{"_6892":1975,"_42174":1961,"_29767":83386,"_5":21387,"_28235":83350,"_5797":83387},[],"Name, SAN or identifier matches the expected peer.",{"_6892":1976,"_42174":1961,"_29767":83389,"_5":21387,"_28235":83350,"_5797":77638},[],{"_6892":1977,"_42174":1961,"_29767":83391,"_5":21387,"_28235":83350,"_5797":83392},[],"KU, EKU and constraints permit the specific operation.",{"_6892":1978,"_42174":1961,"_29767":83394,"_5":21387,"_28235":83350,"_5797":83395},[],"Revocation",{"_6892":1979,"_42174":1961,"_29767":83397,"_5":21387,"_28235":83350,"_5797":83398},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_6892":1980,"_42174":1961,"_29767":83400,"_5":21387,"_28235":83350,"_5797":83401},[],"Authorization",{"_6892":1981,"_42174":1961,"_29767":83403,"_5":21387,"_28235":83350,"_5797":83404},[],"The application permits that identity to perform the action.",{"_6892":1982,"_42174":1961,"_29767":83406,"_5":21387,"_28235":83350,"_5797":83407},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_6892":1983,"_42174":1961,"_29767":83409,"_5":21387,"_28235":83354,"_5797":83410},[],"Mechanism",{"_6892":1984,"_42174":1961,"_29767":83412,"_5":21387,"_28235":83354,"_5797":83413},[],"When to use it",{"_6892":1985,"_42174":1961,"_29767":83415,"_5":21387,"_28235":83354,"_5797":83416},[],"What you must maintain",{"_6892":1986,"_42174":1961,"_29767":83418,"_5":21387,"_28235":83354,"_5797":83419},[],"OCSP",{"_6892":1987,"_42174":1961,"_29767":83421,"_5":21387,"_28235":83354,"_5797":83422},[],"Status query for a specific certificate.",{"_6892":1988,"_42174":1961,"_29767":83424,"_5":21387,"_28235":83354,"_5797":83425},[],"Responder access, signature verification and cache/freshness policy.",{"_6892":1989,"_42174":1961,"_29767":83427,"_5":21387,"_28235":83354,"_5797":83428},[],"CRL",{"_6892":1990,"_42174":1961,"_29767":83430,"_5":21387,"_28235":83354,"_5797":83431},[],"Local checks for many certificates or offline operation.",{"_6892":1991,"_42174":1961,"_29767":83433,"_5":21387,"_28235":83354,"_5797":83434},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_6892":1992,"_42174":1961,"_29767":83436,"_5":21387,"_28235":83354,"_5797":83437},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_6892":1993,"_42174":1961,"_29767":83439,"_5":21387,"_28235":83354,"_5797":83440},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_6892":1994,"_42174":1961,"_29767":83442,"_5":21387,"_28235":83358,"_5797":83443},[],"Accept a current, authorized certificate with a known chain.",{"_6892":1995,"_42174":1961,"_29767":83445,"_5":21387,"_28235":83358,"_5797":83446},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_6892":1996,"_42174":1961,"_29767":83448,"_5":21387,"_28235":83358,"_5797":83449},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_6892":1997,"_42174":1961,"_29767":83451,"_5":21387,"_28235":83358,"_5797":83452},[],"Check that a new connection with that identity is rejected.",{"_6892":1998,"_42174":1961,"_29767":83454,"_5":21387,"_28235":83358,"_5797":83455},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_6892":1999,"_42174":1961,"_29767":83457,"_5":21387,"_28235":83358,"_5797":83458},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_6892":2000,"_42174":1961,"_29767":83460,"_5":21387,"_28235":83358,"_5797":83461},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_6892":2001,"_42174":1961,"_29767":83463,"_5":21387,"_28235":83358,"_5797":83464},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_6892":2002,"_42174":1961,"_29767":83466,"_5":21387,"_28235":83358,"_5797":83467},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_6892":2003,"_42174":2003,"_5":21817,"_5797":83469,"_42654":83470,"_29767":83471,"_28235":2003},"Certificates",[77248,78697,82716,82717],[],{"_6892":2004,"_42174":2003,"_29767":83473,"_5":21387,"_28235":2003,"_5797":83474},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_6892":2005,"_42174":2003,"_5":42651,"_29767":83476,"_28235":83477,"_5797":83478},[],"/docs/pr-preview/pr-56/platform/pki/certificates#find-a-certificate","Find a certificate",{"_6892":2006,"_42174":2003,"_5":42651,"_29767":83480,"_28235":83481,"_5797":83482},[],"/docs/pr-preview/pr-56/platform/pki/certificates#download-the-certificate","Download the certificate",{"_6892":2007,"_42174":2003,"_5":42651,"_29767":83484,"_28235":83485,"_5797":83486},[],"/docs/pr-preview/pr-56/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_6892":2008,"_42174":2003,"_5":42651,"_29767":83488,"_28235":83489,"_5797":83490},[],"/docs/pr-preview/pr-56/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_6892":2009,"_42174":2003,"_5":42651,"_29767":83492,"_28235":83493,"_5797":83494},[],"/docs/pr-preview/pr-56/platform/pki/certificates#open-the-action","Open the action",{"_6892":2010,"_42174":2003,"_5":42651,"_29767":83496,"_28235":83497,"_5797":83498},[],"/docs/pr-preview/pr-56/platform/pki/certificates#choose-a-reason","Choose a reason",{"_6892":2011,"_42174":2003,"_5":42651,"_29767":83500,"_28235":83501,"_5797":83502},[],"/docs/pr-preview/pr-56/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_6892":2012,"_42174":2003,"_5":42651,"_29767":83504,"_28235":83505,"_5797":83506},[],"/docs/pr-preview/pr-56/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_6892":2013,"_42174":2003,"_5":42651,"_29767":83508,"_28235":83509,"_5797":83510},[],"/docs/pr-preview/pr-56/platform/pki/certificates#continue","Continue",{"_6892":2014,"_42174":2003,"_29767":83512,"_5":21387,"_28235":2003,"_5797":83513},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_6892":2015,"_42174":2003,"_29767":83515,"_5":21387,"_28235":83477,"_5797":83516},[],"Filter by `Common Name`, serial, status and issuer. Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_6892":2016,"_42174":2003,"_29767":83518,"_5":21387,"_28235":83477,"_5797":83519},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_6892":2017,"_42174":2003,"_29767":83521,"_5":21387,"_28235":83481,"_5797":83522},[],"Download the PEM and inspect it:",{"_6892":2018,"_42174":2003,"_29767":83524,"_5":21387,"_28235":83481,"_5797":83525},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_6892":2019,"_42174":2003,"_29767":83527,"_5":21387,"_28235":83485,"_5797":83528},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_6892":2020,"_42174":2003,"_29767":83530,"_5":21387,"_28235":83485,"_5797":83531},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_6892":2021,"_42174":2003,"_29767":83533,"_5":21387,"_28235":83485,"_5797":83534},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_6892":2022,"_42174":2003,"_29767":83536,"_5":21387,"_28235":83485,"_5797":83537},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_6892":2023,"_42174":2003,"_29767":83539,"_5":21387,"_28235":83485,"_5797":83540},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_6892":2024,"_42174":2003,"_29767":83542,"_5":21387,"_28235":83485,"_5797":83543},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_6892":2025,"_42174":2003,"_29767":83545,"_5":21387,"_28235":83485,"_5797":83546},[],"For browser key generation, follow Issue your first certificate.",{"_6892":2026,"_42174":2003,"_29767":83548,"_5":21387,"_28235":83489,"_5797":83549},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_6892":2027,"_42174":2003,"_29767":83551,"_5":21387,"_28235":83493,"_5797":83552},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_6892":2028,"_42174":2003,"_29767":83554,"_5":21387,"_28235":83497,"_5797":83555},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_6892":2029,"_42174":2003,"_29767":83557,"_5":21387,"_28235":83501,"_5797":83558},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_6892":2030,"_42174":2003,"_29767":83560,"_5":21387,"_28235":83501,"_5797":83561},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_6892":2031,"_42174":2003,"_29767":83563,"_5":21387,"_28235":83501,"_5797":83564},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_6892":2032,"_42174":2003,"_29767":83566,"_5":21387,"_28235":83505,"_5797":83567},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_6892":2033,"_42174":2003,"_29767":83569,"_5":21387,"_28235":83505,"_5797":83570},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_6892":2034,"_42174":2003,"_29767":83572,"_5":21387,"_28235":83505,"_5797":83573},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_6892":2035,"_42174":2003,"_29767":83575,"_5":21387,"_28235":83509,"_5797":83576},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_6892":2036,"_42174":2003,"_29767":83578,"_5":21387,"_28235":83509,"_5797":83579},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_6892":2037,"_42174":2037,"_5":21817,"_5797":83581,"_42654":83582,"_29767":83584,"_28235":2037},"Certificate lifecycle",[77248,78697,82716,83583],"Concepts",[],{"_6892":2038,"_42174":2037,"_29767":83586,"_5":21387,"_28235":2037,"_5797":83587},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_6892":2039,"_42174":2037,"_5":42651,"_29767":83589,"_28235":83590,"_5797":83591},[],"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_6892":2040,"_42174":2037,"_5":42651,"_29767":83593,"_28235":83594,"_5797":83595},[],"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle#request","Request",{"_6892":2041,"_42174":2037,"_5":42651,"_29767":83597,"_28235":83598,"_5797":83599},[],"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_6892":2042,"_42174":2037,"_5":42651,"_29767":83601,"_28235":83602,"_5797":83603},[],"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_6892":2043,"_42174":2037,"_5":42651,"_29767":83605,"_28235":83606,"_5797":83607},[],"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_6892":2044,"_42174":2037,"_5":42651,"_29767":83609,"_28235":83610,"_5797":83611},[],"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_6892":2045,"_42174":2037,"_5":42651,"_29767":83613,"_28235":83614,"_5797":83615},[],"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_6892":2046,"_42174":2037,"_5":42651,"_29767":83617,"_28235":83618,"_5797":83619},[],"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_6892":2047,"_42174":2037,"_5":42651,"_29767":83621,"_28235":83622,"_5797":83623},[],"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_6892":2048,"_42174":2037,"_5":42651,"_29767":83625,"_28235":83626,"_5797":83627},[],"/docs/pr-preview/pr-56/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_6892":2049,"_42174":2037,"_29767":83629,"_5":21387,"_28235":2037,"_5797":83630},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_6892":2050,"_42174":2037,"_29767":83632,"_5":21387,"_28235":83594,"_5797":83633},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_6892":2051,"_42174":2037,"_29767":83635,"_5":21387,"_28235":83598,"_5797":83636},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_6892":2052,"_42174":2037,"_29767":83638,"_5":21387,"_28235":83602,"_5797":83639},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_6892":2053,"_42174":2037,"_29767":83641,"_5":21387,"_28235":83606,"_5797":83642},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_6892":2054,"_42174":2037,"_29767":83644,"_5":21387,"_28235":83610,"_5797":83645},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_6892":2055,"_42174":2037,"_29767":83647,"_5":21387,"_28235":83614,"_5797":83648},[],"Lamassu persists four X.509 states:",{"_6892":2056,"_42174":2037,"_29767":83650,"_5":21387,"_28235":83614,"_5797":83651},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_6892":2057,"_42174":2037,"_29767":83653,"_5":21387,"_28235":83614,"_5797":83654},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_6892":2058,"_42174":2037,"_29767":83656,"_5":21387,"_28235":83614,"_5797":83657},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_6892":2059,"_42174":2037,"_29767":83659,"_5":21387,"_28235":83614,"_5797":83660},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_6892":2060,"_42174":2037,"_29767":83662,"_5":21387,"_28235":83614,"_5797":83663},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_6892":2061,"_42174":2037,"_29767":83665,"_5":21387,"_28235":83618,"_5797":83666},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_6892":2062,"_42174":2037,"_29767":83668,"_5":21387,"_28235":83618,"_5797":83669},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_6892":2063,"_42174":2037,"_29767":83671,"_5":21387,"_28235":83618,"_5797":83672},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_6892":2064,"_42174":2037,"_29767":83674,"_5":21387,"_28235":83622,"_5797":83675},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_6892":2065,"_42174":2037,"_29767":83677,"_5":21387,"_28235":83622,"_5797":83678},[],"Before confirming:",{"_6892":2066,"_42174":2037,"_29767":83680,"_5":21387,"_28235":83622,"_5797":83681},[],"Identify DMSs, devices and services that trust that chain.",{"_6892":2067,"_42174":2037,"_29767":83683,"_5":21387,"_28235":83622,"_5797":83684},[],"Distribute the new chain of trust.",{"_6892":2068,"_42174":2037,"_29767":83686,"_5":21387,"_28235":83622,"_5797":83687},[],"Reissue the necessary identities.",{"_6892":2069,"_42174":2037,"_29767":83689,"_5":21387,"_28235":83622,"_5797":83690},[],"Check OCSP and CRL from a real consumer.",{"_6892":2070,"_42174":2037,"_29767":83692,"_5":21387,"_28235":83622,"_5797":83693},[],"Revoke the old CA once no legitimate traffic remains.",{"_6892":2071,"_42174":2037,"_29767":83695,"_5":21387,"_28235":83622,"_5797":83696},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_6892":2072,"_42174":2037,"_29767":83698,"_5":21387,"_28235":83626,"_5797":83699},[],"Certificates entering the preventive or critical renewal window.",{"_6892":2073,"_42174":2037,"_29767":83701,"_5":21387,"_28235":83626,"_5797":83702},[],"Repeated enrollment or re-enrollment failures.",{"_6892":2074,"_42174":2037,"_29767":83704,"_5":21387,"_28235":83626,"_5797":83705},[],"Status changes and revocation reasons.",{"_6892":2075,"_42174":2037,"_29767":83707,"_5":21387,"_28235":83626,"_5797":83708},[],"OCSP and CRL publication and validity.",{"_6892":2076,"_42174":2037,"_29767":83710,"_5":21387,"_28235":83626,"_5797":83711},[],"Dependencies still presenting a replaced certificate.",{"_6892":2077,"_42174":2037,"_29767":83713,"_5":21387,"_28235":83626,"_5797":83714},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_6892":2078,"_42174":2078,"_5":21817,"_5797":83716,"_42654":83717,"_29767":83718,"_28235":2078},"Trust model",[77248,78697,82716,83583],[],{"_6892":2079,"_42174":2078,"_29767":83720,"_5":21387,"_28235":2078,"_5797":83721},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_6892":2080,"_42174":2078,"_5":42651,"_29767":83723,"_28235":83724,"_5797":83725},[],"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_6892":2081,"_42174":2078,"_5":42651,"_29767":83727,"_28235":83728,"_5797":83729},[],"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_6892":2082,"_42174":2078,"_5":42651,"_29767":83731,"_28235":83732,"_5797":83733},[],"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_6892":2083,"_42174":2078,"_5":42651,"_29767":83735,"_28235":83736,"_5797":83737},[],"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_6892":2084,"_42174":2078,"_5":42651,"_29767":83739,"_28235":83740,"_5797":83741},[],"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_6892":2085,"_42174":2078,"_5":42651,"_29767":83743,"_28235":83744,"_5797":83745},[],"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_6892":2086,"_42174":2078,"_5":42651,"_29767":83747,"_28235":83748,"_5797":83749},[],"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_6892":2087,"_42174":2078,"_5":42651,"_29767":83751,"_28235":83752,"_5797":83753},[],"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_6892":2088,"_42174":2078,"_5":42651,"_29767":83755,"_28235":83756,"_5797":83757},[],"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_6892":2089,"_42174":2078,"_5":42651,"_29767":83759,"_28235":83760,"_5797":83761},[],"/docs/pr-preview/pr-56/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_6892":2090,"_42174":2078,"_29767":83763,"_5":21387,"_28235":2078,"_5797":83764},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_6892":2091,"_42174":2078,"_29767":83766,"_5":21387,"_28235":83728,"_5797":83767},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_6892":2092,"_42174":2078,"_29767":83769,"_5":21387,"_28235":83732,"_5797":83770},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_6892":2093,"_42174":2078,"_29767":83772,"_5":21387,"_28235":83736,"_5797":83773},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_6892":2094,"_42174":2078,"_29767":83775,"_5":21387,"_28235":83740,"_5797":83776},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_6892":2095,"_42174":2078,"_29767":83778,"_5":21387,"_28235":83744,"_5797":83779},[],"The device proves it can enroll according to the DMS policy.",{"_6892":2096,"_42174":2078,"_29767":83781,"_5":21387,"_28235":83744,"_5797":83782},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_6892":2097,"_42174":2078,"_29767":83784,"_5":21387,"_28235":83744,"_5797":83785},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_6892":2098,"_42174":2078,"_29767":83787,"_5":21387,"_28235":83744,"_5797":83788},[],"The device installs the certificate and the chain it needs.",{"_6892":2099,"_42174":2078,"_29767":83790,"_5":21387,"_28235":83744,"_5797":83791},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_6892":2100,"_42174":2078,"_29767":83793,"_5":21387,"_28235":83744,"_5797":83794},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_6892":2101,"_42174":2078,"_29767":83796,"_5":21387,"_28235":83748,"_5797":83797},[],"A DMS relates three sets that are worth designing separately:",{"_6892":2102,"_42174":2078,"_29767":83799,"_5":21387,"_28235":83748,"_5797":83800},[],"**Enrollment CA:** signs the new identities.",{"_6892":2103,"_42174":2078,"_29767":83802,"_5":21387,"_28235":83748,"_5797":83803},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, the enrollment CA is always trusted and Lamassu then tries the validation CAs configured in the re-enrollment block; those are optional.",{"_6892":2104,"_42174":2078,"_29767":83805,"_5":21387,"_28235":83748,"_5797":83806},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_6892":2105,"_42174":2078,"_29767":83808,"_5":21387,"_28235":83748,"_5797":83809},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_6892":2106,"_42174":2078,"_29767":83811,"_5":21387,"_28235":83752,"_5797":83812},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_6892":2107,"_42174":2078,"_29767":83814,"_5":21387,"_28235":83752,"_5797":83815},[],"that the current date is between `Not Before` and `Not After`;",{"_6892":2108,"_42174":2078,"_29767":83817,"_5":21387,"_28235":83752,"_5797":83818},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_6892":2109,"_42174":2078,"_29767":83820,"_5":21387,"_28235":83752,"_5797":83821},[],"that names, SANs and subject match the expected identity;",{"_6892":2110,"_42174":2078,"_29767":83823,"_5":21387,"_28235":83752,"_5797":83824},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_6892":2111,"_42174":2078,"_29767":83826,"_5":21387,"_28235":83752,"_5797":83827},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_6892":2112,"_42174":2078,"_29767":83829,"_5":21387,"_28235":83752,"_5797":83830},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_6892":2113,"_42174":2078,"_29767":83832,"_5":21387,"_28235":83756,"_5797":83833},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_6892":2114,"_42174":2078,"_29767":83835,"_5":21387,"_28235":83760,"_5797":83836},[],"Keep the root out of daily operations, or with very restricted access.",{"_6892":2115,"_42174":2078,"_29767":83838,"_5":21387,"_28235":83760,"_5797":83839},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_6892":2116,"_42174":2078,"_29767":83841,"_5":21387,"_28235":83760,"_5797":83842},[],"Assign explicit profiles to every use case.",{"_6892":2117,"_42174":2078,"_29767":83844,"_5":21387,"_28235":83760,"_5797":83845},[],"Distribute the new trust before starting a rotation.",{"_6892":2118,"_42174":2078,"_29767":83847,"_5":21387,"_28235":83760,"_5797":83848},[],"Keep enough overlap to renew a disconnected fleet.",{"_6892":2119,"_42174":2078,"_29767":83850,"_5":21387,"_28235":83760,"_5797":83851},[],"Validate from the consuming system, not only from the Lamassu console.",{"_6892":2120,"_42174":2078,"_29767":83853,"_5":21387,"_28235":83760,"_5797":83854},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_6892":2121,"_42174":2121,"_5":21817,"_5797":83856,"_42654":83857,"_29767":83858,"_28235":2121},"Revocation lists (CRL)",[77248,78697,82716,83343],[],{"_6892":2122,"_42174":2121,"_29767":83860,"_5":21387,"_28235":2121,"_5797":83861},[],"Generate and distribute signed lists to validate certificates offline.",{"_6892":2123,"_42174":2121,"_5":42651,"_29767":83863,"_28235":83864,"_5797":83865},[],"/docs/pr-preview/pr-56/platform/pki/crl#va-role-and-per-ca-configuration","VA role and per-CA configuration",{"_6892":2124,"_42174":2121,"_5":42651,"_29767":83867,"_28235":83868,"_5797":83869},[],"/docs/pr-preview/pr-56/platform/pki/crl#cas-that-share-a-key","CAs that share a key",{"_6892":2125,"_42174":2121,"_5":42651,"_29767":83871,"_28235":83872,"_5797":83873},[],"/docs/pr-preview/pr-56/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_6892":2126,"_42174":2121,"_5":42651,"_29767":83875,"_28235":83876,"_5797":83877},[],"/docs/pr-preview/pr-56/platform/pki/crl#crl-contents","CRL contents",{"_6892":2127,"_42174":2121,"_5":42651,"_29767":83879,"_28235":83880,"_5797":83881},[],"/docs/pr-preview/pr-56/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_6892":2128,"_42174":2121,"_5":42651,"_29767":83883,"_28235":83884,"_5797":83885},[],"/docs/pr-preview/pr-56/platform/pki/crl#va-role-management-api","VA role management API",{"_6892":2129,"_42174":2121,"_5":42651,"_29767":83887,"_28235":83888,"_5797":83889},[],"/docs/pr-preview/pr-56/platform/pki/crl#common-va-role-errors","Common VA role errors",{"_6892":2130,"_42174":2121,"_5":42651,"_29767":83891,"_28235":83892,"_5797":83893},[],"/docs/pr-preview/pr-56/platform/pki/crl#from-the-interface","From the interface",{"_6892":2131,"_42174":2121,"_5":42651,"_29767":83895,"_28235":83896,"_5797":83897},[],"/docs/pr-preview/pr-56/platform/pki/crl#references","References",{"_6892":2132,"_42174":2121,"_29767":83899,"_5":21387,"_28235":2121,"_5797":83900},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its SKI and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_6892":2133,"_42174":2121,"_29767":83902,"_5":21387,"_28235":83864,"_5797":83903},[],"The VA role stores configuration and metadata for the latest list published for a CA’s SKI. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_6892":2134,"_42174":2121,"_29767":83905,"_5":21387,"_28235":83864,"_5797":83906},[],"`crl_options` field",{"_6892":2135,"_42174":2121,"_29767":83908,"_5":21387,"_28235":83864,"_5797":77638},[],{"_6892":2136,"_42174":2121,"_29767":83910,"_5":21387,"_28235":83864,"_5797":83911},[],"Backend initial value",{"_6892":2137,"_42174":2121,"_29767":83913,"_5":21387,"_28235":83864,"_5797":83914},[],"`validity`",{"_6892":2138,"_42174":2121,"_29767":83916,"_5":21387,"_28235":83864,"_5797":83917},[],"Time from `thisUpdate` to `nextUpdate`.",{"_6892":2139,"_42174":2121,"_29767":83919,"_5":21387,"_28235":83864,"_5797":83920},[],"7 days.",{"_6892":2140,"_42174":2121,"_29767":83922,"_5":21387,"_28235":83864,"_5797":83923},[],"`refresh_interval`",{"_6892":2141,"_42174":2121,"_29767":83925,"_5":21387,"_28235":83864,"_5797":83926},[],"Stored and returned by the API, but the VA does not use it: scheduled renewal does not depend on it (see Periodic and automatic regeneration).",{"_6892":2142,"_42174":2121,"_29767":83928,"_5":21387,"_28235":83864,"_5797":83929},[],"6 days and 23 hours.",{"_6892":2143,"_42174":2121,"_29767":83931,"_5":21387,"_28235":83864,"_5797":83932},[],"`regenerate_on_revoke`",{"_6892":2144,"_42174":2121,"_29767":83934,"_5":21387,"_28235":83864,"_5797":83935},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_6892":2145,"_42174":2121,"_29767":83937,"_5":21387,"_28235":83864,"_5797":83938},[],"`true`.",{"_6892":2146,"_42174":2121,"_29767":83940,"_5":21387,"_28235":83864,"_5797":83941},[],"`signer_certificate_serial_number`",{"_6892":2147,"_42174":2121,"_29767":83943,"_5":21387,"_28235":83864,"_5797":83944},[],"Serial number of the existing certificate that signs the CRL.",{"_6892":2148,"_42174":2121,"_29767":83946,"_5":21387,"_28235":83864,"_5797":83947},[],"Serial number of the CA’s current certificate.",{"_6892":2149,"_42174":2121,"_29767":83949,"_5":21387,"_28235":83864,"_5797":83950},[],"The signer must be an existing certificate with the `cRLSign` key usage and the same subject and public key as the CA. Certificates from before a reissue qualify. A delegated signer is not supported: a certificate with the CA’s subject but a different key is rejected.",{"_6892":2150,"_42174":2121,"_29767":83952,"_5":21387,"_28235":83864,"_5797":83953},[],"When a CA is reissued, the role keeps pointing at the previous certificate. CRLs remain valid because both certificates share subject and key, but the previous certificate cannot be deleted while the role uses it. To retire it, update the role’s signer.",{"_6892":2151,"_42174":2121,"_29767":83955,"_5":21387,"_28235":83864,"_5797":83956},[],"When a CA is deleted, its VA role is kept and cannot be removed through the API. If no other CA with the same SKI remains, the role can be read but any `PUT` returns 404, and the renewal job logs a warning on every cycle because it no longer finds the CA. The API offers no way out; it can only be fixed by editing the database. If another CA with that SKI remains, the role is still editable (see CAs that share a key). Adjust validity and signer before deleting the CA.",{"_6892":2152,"_42174":2121,"_29767":83958,"_5":21387,"_28235":83864,"_5797":83959},[],"A CA whose certificate lacks `cRLSign` cannot generate its CRL or edit its role (400 error). Since 4.0 the VA requires this usage. Check before importing with `openssl x509 -noout -ext keyUsage` and, if it is missing, obtain a certificate for the same CA and key that includes it and set it as the signer with `PUT`. After reissuing a CA, also check the key usage of the new certificate: it may not keep the original’s usages.",{"_6892":2153,"_42174":2121,"_29767":83961,"_5":21387,"_28235":83864,"_5797":83962},[],"`PUT` always validates the signer, even when the request does not change it. If the stored signer is no longer valid, no field of the role can be modified, not even the validity, until a valid one is set.",{"_6892":2154,"_42174":2121,"_29767":83964,"_5":21387,"_28235":83864,"_5797":83965},[],"`latest_crl` contains version, validity start and end. Versions are kept as PEM in object storage at `pki/va/crl/{subject_key_id}/{version}.crl`; the public endpoint returns DER.",{"_6892":2155,"_42174":2121,"_29767":83967,"_5":21387,"_28235":83868,"_5797":83968},[],"The VA identifies each CRL by the CA’s SKI, and the SKI is derived from its key. Two CAs with the same key have the same SKI and share a single VA role and a single CRL. This happens when a CA is created on an existing KMS key, or when a CA is imported whose certificate declares an SKI already in use. Lamassu takes the SKI of an imported certificate as-is and does not check that it corresponds to its public key. The first CA creates the role and the others keep it.",{"_6892":2156,"_42174":2121,"_29767":83970,"_5":21387,"_28235":83868,"_5797":83971},[],"The certificates of all of them point to `/crl/{ski}`, but the published list has the first CA as issuer and only includes its revocations. A verifier compares the CRL issuer with the issuer of the certificate it validates (RFC 5280, §6.3.2) and rejects the list if they differ. Depending on its policy, the certificate is blocked (*hard-fail*) or accepted even though it is revoked (*soft-fail*). Revocations of the secondary CAs do not appear in any list.",{"_6892":2157,"_42174":2121,"_29767":83973,"_5":21387,"_28235":83868,"_5797":83974},[],"If the first CA is deleted, CRL generation for the remaining one fails because the configured signer no longer matches a CA with that name. Until the role’s signer is updated to a certificate of the remaining CA, the last published list keeps being served until it expires (7 days by default).",{"_6892":2158,"_42174":2121,"_29767":83976,"_5":21387,"_28235":83868,"_5797":83977},[],"To detect the problem, compare the SKI of the CAs in the inventory: two with the same SKI are affected. To fix it, create a CA with its own key and reissue its certificates; those already issued keep the old URL and are not corrected until reissued. A CA imported with an SKI already in use does not replace the existing one as CRL issuer, because the issuer is resolved from the role’s signer. However, its own certificates point to that same URL and its revocations are not published. Until Lamassu rejects these imports, restrict the permission to import CAs as an interim control; it covers only the import path. Creating a CA with &#x2A;*Create New CA (Existing Key)** on a KMS key another CA already uses produces the same collision, so also avoid reusing keys across CAs. A per-CA CRL and the rejection of imports whose SKI collides with an existing CA are both proposed in lamassuiot#834, and neither is implemented yet.",{"_6892":2159,"_42174":2121,"_29767":83979,"_5":21387,"_28235":83872,"_5797":83980},[],"The VA scheduled job checks every role on each run and requests another list when the remaining validity of `latest_crl` is less than the interval between runs. The frequency is set in Helm with `services.va.job.crl.frequency` (default `0 * * * *`) and accepts a duration (`1h`) or a cron expression. A cron expression is converted into a constant interval equal to the time left until its next firing when the service starts, so it is not aligned with the clock. `refresh_interval` plays no part. Keep `validity` well above the interval: with a shorter validity, the list is regenerated on every cycle.",{"_6892":2160,"_42174":2121,"_29767":83982,"_5":21387,"_28235":83872,"_5797":83983},[],"If generation fails (for example, because of a role without a CA or an invalid signer), the job logs the warning `something went wrong while calculating CRL for CA <ski>` and retries on the next cycle. There is no other renewal path until the cause is fixed, and the last published list keeps being served until it expires. All of this depends on working jobs, storage and signing.",{"_6892":2161,"_42174":2121,"_29767":83985,"_5":21387,"_28235":83872,"_5797":83986},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths: if it fails (missing role, invalid signer), the event is retried and, once retries are exhausted, moves to the failed-events queue. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_6892":2162,"_42174":2121,"_29767":83988,"_5":21387,"_28235":83872,"_5797":83989},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_6892":2163,"_42174":2121,"_29767":83991,"_5":21387,"_28235":83876,"_5797":83992},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_6892":2164,"_42174":2121,"_29767":83994,"_5":21387,"_28235":83876,"_5797":83995},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_6892":2165,"_42174":2121,"_29767":83997,"_5":21387,"_28235":83880,"_5797":83998},[],"The VA service exposes `GET /crl/{subject_key_id}` without management authorization. Use the **issuing CA’s** SKI, not the end-entity certificate’s SKI or serial. First inspect the certificate’s CDP:",{"_6892":2166,"_42174":2121,"_29767":84000,"_5":21387,"_28235":83880,"_5797":84001},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_6892":2167,"_42174":2121,"_29767":84003,"_5":21387,"_28235":83880,"_5797":84004},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_6892":2168,"_42174":2121,"_29767":84006,"_5":21387,"_28235":83880,"_5797":84007},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_6892":2169,"_42174":2121,"_29767":84009,"_5":21387,"_28235":83880,"_5797":84010},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_6892":2170,"_42174":2121,"_29767":84012,"_5":21387,"_28235":83884,"_5797":84013},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_6892":2171,"_42174":2121,"_29767":84015,"_5":21387,"_28235":83884,"_5797":80461},[],{"_6892":2172,"_42174":2121,"_29767":84017,"_5":21387,"_28235":83884,"_5797":84018},[],"Relative path",{"_6892":2173,"_42174":2121,"_29767":84020,"_5":21387,"_28235":83884,"_5797":80458},[],{"_6892":2174,"_42174":2121,"_29767":84022,"_5":21387,"_28235":83884,"_5797":84023},[],"`GET`",{"_6892":2175,"_42174":2121,"_29767":84025,"_5":21387,"_28235":83884,"_5797":84026},[],"`/v1/roles/{ca-ski}`",{"_6892":2176,"_42174":2121,"_29767":84028,"_5":21387,"_28235":83884,"_5797":84029},[],"Read `crl_options` and `latest_crl`.",{"_6892":2177,"_42174":2121,"_29767":84031,"_5":21387,"_28235":83884,"_5797":84032},[],"`PUT`",{"_6892":2178,"_42174":2121,"_29767":84034,"_5":21387,"_28235":83884,"_5797":84026},[],{"_6892":2179,"_42174":2121,"_29767":84036,"_5":21387,"_28235":83884,"_5797":84037},[],"Replace CRL configuration.",{"_6892":2180,"_42174":2121,"_29767":84039,"_5":21387,"_28235":83884,"_5797":84040},[],"You need authentication and role read or update permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract: the backend replaces `crl_options`; it does not merge omitted fields.",{"_6892":2181,"_42174":2121,"_29767":84042,"_5":21387,"_28235":83884,"_5797":84043},[],"After a change, check saved configuration and the next list actually published. Updating the role alone does not establish regeneration or client acceptance.",{"_6892":2182,"_42174":2121,"_29767":84045,"_5":21387,"_28235":83888,"_5797":84046},[],"Symptom",{"_6892":2183,"_42174":2121,"_29767":84048,"_5":21387,"_28235":83888,"_5797":84049},[],"Cause",{"_6892":2184,"_42174":2121,"_29767":84051,"_5":21387,"_28235":83888,"_5797":84052},[],"Action",{"_6892":2185,"_42174":2121,"_29767":84054,"_5":21387,"_28235":83888,"_5797":84055},[],"`PUT /v1/roles/{ca-ski}` returns 404 and `GET` returns 200.",{"_6892":2186,"_42174":2121,"_29767":84057,"_5":21387,"_28235":83888,"_5797":84058},[],"The role’s CA was deleted and no other CA with the same SKI remains.",{"_6892":2187,"_42174":2121,"_29767":84060,"_5":21387,"_28235":83888,"_5797":84061},[],"There is no API way out; it requires database intervention. Avoid it by adjusting the role before deleting the CA.",{"_6892":2188,"_42174":2121,"_29767":84063,"_5":21387,"_28235":83888,"_5797":84064},[],"`PUT` returns 400.",{"_6892":2189,"_42174":2121,"_29767":84066,"_5":21387,"_28235":83888,"_5797":84067},[],"The signer lacks `cRLSign`, or its subject and key match no CA with that SKI (for example, after deleting the first of two CAs that share a key).",{"_6892":2190,"_42174":2121,"_29767":84069,"_5":21387,"_28235":83888,"_5797":84070},[],"Use `PUT` to set the serial number of a valid certificate of the remaining CA.",{"_6892":2191,"_42174":2121,"_29767":84072,"_5":21387,"_28235":83888,"_5797":84073},[],"`PUT` returns 400 from a 3.x client.",{"_6892":2192,"_42174":2121,"_29767":84075,"_5":21387,"_28235":83888,"_5797":84076},[],"`crl_options.subject_key_id_signer` was replaced by `signer_certificate_serial_number`, which is required.",{"_6892":2193,"_42174":2121,"_29767":84078,"_5":21387,"_28235":83888,"_5797":84079},[],"Update the client to send the new field.",{"_6892":2194,"_42174":2121,"_29767":84081,"_5":21387,"_28235":83888,"_5797":84082},[],"The CRL does not change after revoking a certificate.",{"_6892":2195,"_42174":2121,"_29767":84084,"_5":21387,"_28235":83888,"_5797":84085},[],"`regenerate_on_revoke` is `false`, or the event failed because of a missing role or an invalid signer.",{"_6892":2196,"_42174":2121,"_29767":84087,"_5":21387,"_28235":83888,"_5797":84088},[],"Check the VA logs and the failed-events queue; fix the signer.",{"_6892":2197,"_42174":2121,"_29767":84090,"_5":21387,"_28235":83888,"_5797":84091},[],"A verifier rejects the CRL because of the issuer.",{"_6892":2198,"_42174":2121,"_29767":84093,"_5":21387,"_28235":83888,"_5797":84094},[],"Several CAs share an SKI.",{"_6892":2199,"_42174":2121,"_29767":84096,"_5":21387,"_28235":83888,"_5797":84097},[],"See CAs that share a key.",{"_6892":2200,"_42174":2121,"_29767":84099,"_5":21387,"_28235":83892,"_5797":84100},[],"The CA view lets you inspect and download the available list. Compare version, issuer and timestamps with the copy downloaded from the public endpoint. Diagnose differences using PKI troubleshooting.",{"_6892":2201,"_42174":2121,"_29767":84102,"_5":21387,"_28235":83896,"_5797":84103},[],"RFC 5280: X.509 and CRL profile.",{"_6892":2202,"_42174":2121,"_29767":84105,"_5":21387,"_28235":83896,"_5797":84106},[],"OpenSSL: openssl-crl.",{"_6892":2203,"_42174":2121,"_29767":84108,"_5":21387,"_28235":83896,"_5797":84109},[],"OpenSSL: openssl-verify.",{"_6892":2204,"_42174":2121,"_29767":84111,"_5":21387,"_28235":83896,"_5797":84112},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_6892":2205,"_42174":2121,"_29767":84114,"_5":21387,"_28235":83896,"_5797":84115},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_6892":2206,"_42174":2206,"_5":21817,"_5797":84117,"_42654":84118,"_29767":84119,"_28235":2206},"Keys and cryptographic engines",[77248,78697,82716,82717],[],{"_6892":2207,"_42174":2206,"_29767":84121,"_5":21387,"_28235":2206,"_5797":84122},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_6892":2208,"_42174":2206,"_5":42651,"_29767":84124,"_28235":84125,"_5797":84126},[],"/docs/pr-preview/pr-56/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_6892":2209,"_42174":2206,"_5":42651,"_29767":84128,"_28235":84129,"_5797":84130},[],"/docs/pr-preview/pr-56/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_6892":2210,"_42174":2206,"_5":42651,"_29767":84132,"_28235":84133,"_5797":84134},[],"/docs/pr-preview/pr-56/platform/pki/key-management#file-system","File System",{"_6892":2211,"_42174":2206,"_5":42651,"_29767":84136,"_28235":84137,"_5797":84138},[],"/docs/pr-preview/pr-56/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_6892":2212,"_42174":2206,"_5":42651,"_29767":84140,"_28235":84141,"_5797":84142},[],"/docs/pr-preview/pr-56/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_6892":2213,"_42174":2206,"_5":42651,"_29767":84144,"_28235":84145,"_5797":84146},[],"/docs/pr-preview/pr-56/platform/pki/key-management#aws-kms","AWS KMS",{"_6892":2214,"_42174":2206,"_5":42651,"_29767":84148,"_28235":84149,"_5797":84150},[],"/docs/pr-preview/pr-56/platform/pki/key-management#pkcs11","PKCS#11",{"_6892":2215,"_42174":2206,"_5":42651,"_29767":84152,"_28235":84153,"_5797":84154},[],"/docs/pr-preview/pr-56/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_6892":2216,"_42174":2206,"_5":42651,"_29767":84156,"_28235":84157,"_5797":84158},[],"/docs/pr-preview/pr-56/platform/pki/key-management#key-inventory","Key inventory",{"_6892":2217,"_42174":2206,"_5":42651,"_29767":84160,"_28235":84161,"_5797":84162},[],"/docs/pr-preview/pr-56/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_6892":2218,"_42174":2206,"_5":42651,"_29767":84164,"_28235":84165,"_5797":84166},[],"/docs/pr-preview/pr-56/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_6892":2219,"_42174":2206,"_5":42651,"_29767":84168,"_28235":84169,"_5797":84170},[],"/docs/pr-preview/pr-56/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_6892":2220,"_42174":2206,"_5":42651,"_29767":84172,"_28235":84173,"_5797":84174},[],"/docs/pr-preview/pr-56/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_6892":2221,"_42174":2206,"_5":42651,"_29767":84176,"_28235":84177,"_5797":84178},[],"/docs/pr-preview/pr-56/platform/pki/key-management#view-details","View details",{"_6892":2222,"_42174":2206,"_5":42651,"_29767":84180,"_28235":84181,"_5797":84182},[],"/docs/pr-preview/pr-56/platform/pki/key-management#sign-and-verify","Sign and verify",{"_6892":2223,"_42174":2206,"_5":42651,"_29767":84184,"_28235":84185,"_5797":84186},[],"/docs/pr-preview/pr-56/platform/pki/key-management#sign","Sign",{"_6892":2224,"_42174":2206,"_5":42651,"_29767":84188,"_28235":84189,"_5797":84190},[],"/docs/pr-preview/pr-56/platform/pki/key-management#verify","Verify",{"_6892":2225,"_42174":2206,"_5":42651,"_29767":84192,"_28235":84193,"_5797":84194},[],"/docs/pr-preview/pr-56/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_6892":2226,"_42174":2206,"_5":42651,"_29767":84196,"_28235":84197,"_5797":84198},[],"/docs/pr-preview/pr-56/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_6892":2227,"_42174":2206,"_5":42651,"_29767":84200,"_28235":84201,"_5797":84202},[],"/docs/pr-preview/pr-56/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_6892":2228,"_42174":2206,"_29767":84204,"_5":21387,"_28235":2206,"_5797":84205},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_6892":2229,"_42174":2206,"_29767":84207,"_5":21387,"_28235":2206,"_5797":84208},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_6892":2230,"_42174":2206,"_29767":84210,"_5":21387,"_28235":84125,"_5797":84211},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_6892":2231,"_42174":2206,"_29767":84213,"_5":21387,"_28235":84125,"_5797":84214},[],"In practice, it lets you:",{"_6892":2232,"_42174":2206,"_29767":84216,"_5":21387,"_28235":84125,"_5797":84217},[],"Generate new key pairs from Lamassu IoT.",{"_6892":2233,"_42174":2206,"_29767":84219,"_5":21387,"_28235":84125,"_5797":84220},[],"Import keys created externally.",{"_6892":2234,"_42174":2206,"_29767":84222,"_5":21387,"_28235":84125,"_5797":84223},[],"Delegate custody and cryptographic operations to external engines.",{"_6892":2235,"_42174":2206,"_29767":84225,"_5":21387,"_28235":84125,"_5797":84226},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_6892":2236,"_42174":2206,"_29767":84228,"_5":21387,"_28235":84129,"_5797":84229},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_6892":2237,"_42174":2206,"_29767":84231,"_5":21387,"_28235":84129,"_5797":84232},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_6892":2238,"_42174":2206,"_29767":84234,"_5":21387,"_28235":84129,"_5797":84235},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_6892":2239,"_42174":2206,"_29767":84237,"_5":21387,"_28235":84133,"_5797":84238},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_6892":2240,"_42174":2206,"_29767":84240,"_5":21387,"_28235":84137,"_5797":84241},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_6892":2241,"_42174":2206,"_29767":84243,"_5":21387,"_28235":84137,"_5797":84244},[],"The adapter reaches Vault over its configured HTTP(S) endpoint. The Vault server certificate is verified against the system trust store; a Vault signed by a private CA is trusted by adding its CA certificate to the engine's `ca_cert_file` (PEM-encoded). `insecure_skip_verify=true` disables verification and is a last resort; agree the transport settings with the deployment owner.",{"_6892":2242,"_42174":2206,"_29767":84246,"_5":21387,"_28235":84141,"_5797":84247},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_6892":2243,"_42174":2206,"_29767":84249,"_5":21387,"_28235":84145,"_5797":84250},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_6892":2244,"_42174":2206,"_29767":84252,"_5":21387,"_28235":84149,"_5797":84253},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_6892":2245,"_42174":2206,"_29767":84255,"_5":21387,"_28235":84153,"_5797":84256},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_6892":2246,"_42174":2206,"_29767":84258,"_5":21387,"_28235":84153,"_5797":84259},[],"Lamassu shows the enabled engines in the console.",{"_6892":2247,"_42174":2206,"_29767":84261,"_5":21387,"_28235":84153,"_5797":84262},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_6892":2248,"_42174":2206,"_29767":84264,"_5":21387,"_28235":84153,"_5797":84265},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_6892":2249,"_42174":2206,"_29767":84267,"_5":21387,"_28235":84157,"_5797":84268},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_6892":2250,"_42174":2206,"_29767":84270,"_5":21387,"_28235":84157,"_5797":84271},[],"The table includes the following fields:",{"_6892":2251,"_42174":2206,"_29767":84273,"_5":21387,"_28235":84157,"_5797":84274},[],"**Name**: descriptive name of the key.",{"_6892":2252,"_42174":2206,"_29767":84276,"_5":21387,"_28235":84157,"_5797":84277},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_6892":2253,"_42174":2206,"_29767":84279,"_5":21387,"_28235":84157,"_5797":84280},[],"**Strength**: visual indicator of cryptographic strength.",{"_6892":2254,"_42174":2206,"_29767":84282,"_5":21387,"_28235":84157,"_5797":84283},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_6892":2255,"_42174":2206,"_29767":84285,"_5":21387,"_28235":84157,"_5797":84286},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_6892":2256,"_42174":2206,"_29767":84288,"_5":21387,"_28235":84157,"_5797":84289},[],"**Aliases**: alternative names associated with the key.",{"_6892":2257,"_42174":2206,"_29767":84291,"_5":21387,"_28235":84157,"_5797":84292},[],"**Tags**: labels for classification and search.",{"_6892":2258,"_42174":2206,"_29767":84294,"_5":21387,"_28235":84157,"_5797":84295},[],"**Related Entities**: certificates or other entities linked to that key.",{"_6892":2259,"_42174":2206,"_29767":84297,"_5":21387,"_28235":84157,"_5797":84298},[],"From this view you also reach the most common actions:",{"_6892":2260,"_42174":2206,"_29767":84300,"_5":21387,"_28235":84157,"_5797":84301},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_6892":2261,"_42174":2206,"_29767":84303,"_5":21387,"_28235":84157,"_5797":84304},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_6892":2262,"_42174":2206,"_29767":84306,"_5":21387,"_28235":84157,"_5797":84307},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_6892":2263,"_42174":2206,"_29767":84309,"_5":21387,"_28235":84157,"_5797":84310},[],"**Delete Key** to remove the key from the system.",{"_6892":2264,"_42174":2206,"_29767":84312,"_5":21387,"_28235":84161,"_5797":84313},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_6892":2265,"_42174":2206,"_29767":84315,"_5":21387,"_28235":84165,"_5797":84316},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_6892":2266,"_42174":2206,"_29767":84318,"_5":21387,"_28235":84165,"_5797":84319},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_6892":2267,"_42174":2206,"_29767":84321,"_5":21387,"_28235":84165,"_5797":84322},[],"**Key Name**: unique and descriptive name.",{"_6892":2268,"_42174":2206,"_29767":84324,"_5":21387,"_28235":84165,"_5797":84325},[],"**Crypto Engine**: engine that will keep the key.",{"_6892":2269,"_42174":2206,"_29767":84327,"_5":21387,"_28235":84165,"_5797":84328},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_6892":2270,"_42174":2206,"_29767":84330,"_5":21387,"_28235":84165,"_5797":84331},[],"**Tags**: metadata to classify the key.",{"_6892":2271,"_42174":2206,"_29767":84333,"_5":21387,"_28235":84165,"_5797":84334},[],"**Metadata**: additional information for advanced uses.",{"_6892":2272,"_42174":2206,"_29767":84336,"_5":21387,"_28235":84169,"_5797":84337},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_6892":2273,"_42174":2206,"_29767":84339,"_5":21387,"_28235":84169,"_5797":84340},[],"When you have an exportable private key and the destination engine supports import.",{"_6892":2274,"_42174":2206,"_29767":84342,"_5":21387,"_28235":84169,"_5797":84343},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_6892":2275,"_42174":2206,"_29767":84345,"_5":21387,"_28235":84169,"_5797":84346},[],"When Lamassu must operate with a root of trust created by a third party.",{"_6892":2276,"_42174":2206,"_29767":84348,"_5":21387,"_28235":84169,"_5797":84349},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_6892":2277,"_42174":2206,"_29767":84351,"_5":21387,"_28235":84169,"_5797":84352},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_6892":2278,"_42174":2206,"_29767":84354,"_5":21387,"_28235":84169,"_5797":84355},[],"**Crypto Engine**: engine that will keep the imported key.",{"_6892":2279,"_42174":2206,"_29767":84357,"_5":21387,"_28235":84169,"_5797":84358},[],"**Tags**: labels for organization and search.",{"_6892":2280,"_42174":2206,"_29767":84360,"_5":21387,"_28235":84169,"_5797":84361},[],"**Metadata**: additional optional information.",{"_6892":2281,"_42174":2206,"_29767":84363,"_5":21387,"_28235":84169,"_5797":84364},[],"**Private Key (PEM)**: private key in PEM format.",{"_6892":2282,"_42174":2206,"_29767":84366,"_5":21387,"_28235":84169,"_5797":84367},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_6892":2283,"_42174":2206,"_29767":84369,"_5":21387,"_28235":84173,"_5797":84370},[],"Each registered key has a detail view and several operational actions.",{"_6892":2284,"_42174":2206,"_29767":84372,"_5":21387,"_28235":84177,"_5797":84373},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_6892":2285,"_42174":2206,"_29767":84375,"_5":21387,"_28235":84177,"_5797":84376},[],"The **Overview** tab shows, among others, these fields:",{"_6892":2286,"_42174":2206,"_29767":84378,"_5":21387,"_28235":84177,"_5797":84379},[],"**Key Name**: descriptive name.",{"_6892":2287,"_42174":2206,"_29767":84381,"_5":21387,"_28235":84177,"_5797":84382},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_6892":2288,"_42174":2206,"_29767":84384,"_5":21387,"_28235":84177,"_5797":84385},[],"**Tags**: associated labels.",{"_6892":2289,"_42174":2206,"_29767":84387,"_5":21387,"_28235":84177,"_5797":84388},[],"**Aliases**: alternative names.",{"_6892":2290,"_42174":2206,"_29767":84390,"_5":21387,"_28235":84177,"_5797":84391},[],"**Crypto Engine**: engine where the key resides.",{"_6892":2291,"_42174":2206,"_29767":84393,"_5":21387,"_28235":84177,"_5797":84394},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_6892":2292,"_42174":2206,"_29767":84396,"_5":21387,"_28235":84177,"_5797":84397},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_6892":2293,"_42174":2206,"_29767":84399,"_5":21387,"_28235":84177,"_5797":84400},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_6892":2294,"_42174":2206,"_29767":84402,"_5":21387,"_28235":84181,"_5797":84403},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_6892":2295,"_42174":2206,"_29767":84405,"_5":21387,"_28235":84181,"_5797":84406},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_6892":2296,"_42174":2206,"_29767":84408,"_5":21387,"_28235":84181,"_5797":84409},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_6892":2297,"_42174":2206,"_29767":84411,"_5":21387,"_28235":84185,"_5797":84412},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_6892":2298,"_42174":2206,"_29767":84414,"_5":21387,"_28235":84185,"_5797":84415},[],"Main fields:",{"_6892":2299,"_42174":2206,"_29767":84417,"_5":21387,"_28235":84185,"_5797":84418},[],"**Algorithm**: signing algorithm available for the key type.",{"_6892":2300,"_42174":2206,"_29767":84420,"_5":21387,"_28235":84185,"_5797":84421},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_6892":2301,"_42174":2206,"_29767":84423,"_5":21387,"_28235":84185,"_5797":84424},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_6892":2302,"_42174":2206,"_29767":84426,"_5":21387,"_28235":84185,"_5797":84427},[],"**Message**: content to sign.",{"_6892":2303,"_42174":2206,"_29767":84429,"_5":21387,"_28235":84185,"_5797":84430},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_6892":2304,"_42174":2206,"_29767":84432,"_5":21387,"_28235":84189,"_5797":84433},[],"This tab checks whether a signature corresponds to the associated public key.",{"_6892":2305,"_42174":2206,"_29767":84435,"_5":21387,"_28235":84189,"_5797":84415},[],{"_6892":2306,"_42174":2206,"_29767":84437,"_5":21387,"_28235":84189,"_5797":84438},[],"**Algorithm**: must match the algorithm used for the signature.",{"_6892":2307,"_42174":2206,"_29767":84440,"_5":21387,"_28235":84189,"_5797":84441},[],"**Message Type**: `Raw` or `Digest`.",{"_6892":2308,"_42174":2206,"_29767":84443,"_5":21387,"_28235":84189,"_5797":84444},[],"**Payload Encoding**: encoding of the message.",{"_6892":2309,"_42174":2206,"_29767":84446,"_5":21387,"_28235":84189,"_5797":84447},[],"**Message**: original message or hash.",{"_6892":2310,"_42174":2206,"_29767":84449,"_5":21387,"_28235":84189,"_5797":84450},[],"**Signature**: signature to check.",{"_6892":2311,"_42174":2206,"_29767":84452,"_5":21387,"_28235":84189,"_5797":84453},[],"**Result**: indicator of the validation result.",{"_6892":2312,"_42174":2206,"_29767":84455,"_5":21387,"_28235":84193,"_5797":84456},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_6892":2313,"_42174":2206,"_29767":84458,"_5":21387,"_28235":84193,"_5797":84459},[],"This flow is useful for:",{"_6892":2314,"_42174":2206,"_29767":84461,"_5":21387,"_28235":84193,"_5797":84462},[],"Requesting certificates from an external CA.",{"_6892":2315,"_42174":2206,"_29767":84464,"_5":21387,"_28235":84193,"_5797":84465},[],"Renewing an identity while keeping the same key.",{"_6892":2316,"_42174":2206,"_29767":84467,"_5":21387,"_28235":84193,"_5797":84468},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_6892":2317,"_42174":2206,"_29767":84470,"_5":21387,"_28235":84193,"_5797":84471},[],"**Common Name (CN)**: main name of the identity.",{"_6892":2318,"_42174":2206,"_29767":84473,"_5":21387,"_28235":84193,"_5797":84474},[],"**Organization (O)**: organization or company.",{"_6892":2319,"_42174":2206,"_29767":84476,"_5":21387,"_28235":84193,"_5797":84477},[],"**Organizational Unit (OU)**: department or unit.",{"_6892":2320,"_42174":2206,"_29767":84479,"_5":21387,"_28235":84193,"_5797":84480},[],"**Country (C)**: two-letter country code.",{"_6892":2321,"_42174":2206,"_29767":84482,"_5":21387,"_28235":84193,"_5797":84483},[],"**State / Province (ST)**: state or province.",{"_6892":2322,"_42174":2206,"_29767":84485,"_5":21387,"_28235":84193,"_5797":84486},[],"**Locality (L)**: city or locality.",{"_6892":2323,"_42174":2206,"_29767":84488,"_5":21387,"_28235":84193,"_5797":84489},[],"**Email Address**: contact email.",{"_6892":2324,"_42174":2206,"_29767":84491,"_5":21387,"_28235":84193,"_5797":84492},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_6892":2325,"_42174":2206,"_29767":84494,"_5":21387,"_28235":84193,"_5797":84495},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_6892":2326,"_42174":2206,"_29767":84497,"_5":21387,"_28235":84197,"_5797":84498},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_6892":2327,"_42174":2206,"_29767":84500,"_5":21387,"_28235":84197,"_5797":84501},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_6892":2328,"_42174":2206,"_29767":84503,"_5":21387,"_28235":84201,"_5797":84504},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_6892":2329,"_42174":2329,"_5":21817,"_5797":84506,"_42654":84507,"_29767":84508,"_28235":2329},"Online validation with OCSP",[77248,78697,82716,83343],[],{"_6892":2330,"_42174":2329,"_29767":84510,"_5":21387,"_28235":2329,"_5797":84511},[],"Query signed status and verify the responder’s response.",{"_6892":2331,"_42174":2329,"_5":42651,"_29767":84513,"_28235":84514,"_5797":84515},[],"/docs/pr-preview/pr-56/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_6892":2332,"_42174":2329,"_5":42651,"_29767":84517,"_28235":84518,"_5797":84519},[],"/docs/pr-preview/pr-56/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_6892":2333,"_42174":2329,"_5":42651,"_29767":84521,"_28235":84522,"_5797":84523},[],"/docs/pr-preview/pr-56/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_6892":2334,"_42174":2329,"_5":42651,"_29767":84525,"_28235":84526,"_5797":84527},[],"/docs/pr-preview/pr-56/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_6892":2335,"_42174":2329,"_5":42651,"_29767":84529,"_28235":84530,"_5797":84531},[],"/docs/pr-preview/pr-56/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_6892":2336,"_42174":2329,"_5":42651,"_29767":84533,"_28235":84534,"_5797":83897},[],"/docs/pr-preview/pr-56/platform/pki/ocsp#references",{"_6892":2337,"_42174":2329,"_29767":84536,"_5":21387,"_28235":2329,"_5797":84537},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_6892":2338,"_42174":2329,"_29767":84539,"_5":21387,"_28235":84514,"_5797":84540},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_6892":2339,"_42174":2329,"_29767":84542,"_5":21387,"_28235":84514,"_5797":84543},[],"Record status",{"_6892":2340,"_42174":2329,"_29767":84545,"_5":21387,"_28235":84514,"_5797":84546},[],"Signed response",{"_6892":2341,"_42174":2329,"_29767":84548,"_5":21387,"_28235":84514,"_5797":81874},[],{"_6892":2342,"_42174":2329,"_29767":84550,"_5":21387,"_28235":84514,"_5797":84551},[],"`Good`.",{"_6892":2343,"_42174":2329,"_29767":84553,"_5":21387,"_28235":84514,"_5797":81891},[],{"_6892":2344,"_42174":2329,"_29767":84555,"_5":21387,"_28235":84514,"_5797":84556},[],"`Revoked`, with revocation reason and timestamp.",{"_6892":2345,"_42174":2329,"_29767":84558,"_5":21387,"_28235":84514,"_5797":84559},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_6892":2346,"_42174":2329,"_29767":84561,"_5":21387,"_28235":84514,"_5797":84562},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_6892":2347,"_42174":2329,"_29767":84564,"_5":21387,"_28235":84514,"_5797":84565},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_6892":2348,"_42174":2329,"_29767":84567,"_5":21387,"_28235":84514,"_5797":84568},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_6892":2349,"_42174":2329,"_29767":84570,"_5":21387,"_28235":84514,"_5797":84571},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_6892":2350,"_42174":2329,"_29767":84573,"_5":21387,"_28235":84518,"_5797":84574},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_6892":2351,"_42174":2329,"_29767":84576,"_5":21387,"_28235":84518,"_5797":84577},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_6892":2352,"_42174":2329,"_29767":84579,"_5":21387,"_28235":84522,"_5797":84580},[],"The service accepts:",{"_6892":2353,"_42174":2329,"_29767":84582,"_5":21387,"_28235":84522,"_5797":80461},[],{"_6892":2354,"_42174":2329,"_29767":84584,"_5":21387,"_28235":84522,"_5797":84585},[],"VA service path",{"_6892":2355,"_42174":2329,"_29767":84587,"_5":21387,"_28235":84522,"_5797":84588},[],"Format",{"_6892":2356,"_42174":2329,"_29767":84590,"_5":21387,"_28235":84522,"_5797":84591},[],"`POST`",{"_6892":2357,"_42174":2329,"_29767":84593,"_5":21387,"_28235":84522,"_5797":84594},[],"`/ocsp`",{"_6892":2358,"_42174":2329,"_29767":84596,"_5":21387,"_28235":84522,"_5797":84597},[],"DER request, `Content-Type: application/ocsp-request`.",{"_6892":2359,"_42174":2329,"_29767":84599,"_5":21387,"_28235":84522,"_5797":84023},[],{"_6892":2360,"_42174":2329,"_29767":84601,"_5":21387,"_28235":84522,"_5797":84602},[],"`/ocsp/{ocsp_request}`",{"_6892":2361,"_42174":2329,"_29767":84604,"_5":21387,"_28235":84522,"_5797":84605},[],"DER request encoded using padded URL Base64.",{"_6892":2362,"_42174":2329,"_29767":84607,"_5":21387,"_28235":84522,"_5797":84608},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_6892":2363,"_42174":2329,"_29767":84610,"_5":21387,"_28235":84526,"_5797":84611},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_6892":2364,"_42174":2329,"_29767":84613,"_5":21387,"_28235":84526,"_5797":84614},[],"Generate the request:",{"_6892":2365,"_42174":2329,"_29767":84616,"_5":21387,"_28235":84526,"_5797":84617},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_6892":2366,"_42174":2329,"_29767":84619,"_5":21387,"_28235":84526,"_5797":84620},[],"Replace the example URL with the inspected endpoint:",{"_6892":2367,"_42174":2329,"_29767":84622,"_5":21387,"_28235":84526,"_5797":84623},[],"Verify the returned DER:",{"_6892":2368,"_42174":2329,"_29767":84625,"_5":21387,"_28235":84526,"_5797":84626},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_6892":2369,"_42174":2329,"_29767":84628,"_5":21387,"_28235":84530,"_5797":84629},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_6892":2370,"_42174":2329,"_29767":84631,"_5":21387,"_28235":84530,"_5797":84632},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_6892":2371,"_42174":2329,"_29767":84634,"_5":21387,"_28235":84534,"_5797":84635},[],"RFC 6960: OCSP.",{"_6892":2372,"_42174":2329,"_29767":84637,"_5":21387,"_28235":84534,"_5797":84638},[],"OpenSSL: openssl-ocsp.",{"_6892":2373,"_42174":2329,"_29767":84640,"_5":21387,"_28235":84534,"_5797":84641},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_6892":2374,"_42174":2329,"_29767":84643,"_5":21387,"_28235":84534,"_5797":84115},[],{"_6892":2375,"_42174":2375,"_5":21817,"_5797":82716,"_42654":84645,"_29767":84646,"_28235":2375},[77248,78697,82716],[],{"_6892":2376,"_42174":2375,"_29767":84648,"_5":21387,"_28235":2375,"_5797":84649},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_6892":2377,"_42174":2375,"_5":42651,"_29767":84651,"_28235":84652,"_5797":82015},[],"/docs/pr-preview/pr-56/platform/pki/overview#start-here",{"_6892":2378,"_42174":2375,"_5":42651,"_29767":84654,"_28235":84655,"_5797":84656},[],"/docs/pr-preview/pr-56/platform/pki/overview#what-you-need","What you need",{"_6892":2379,"_42174":2375,"_5":42651,"_29767":84658,"_28235":84659,"_5797":82560},[],"/docs/pr-preview/pr-56/platform/pki/overview#core-capabilities",{"_6892":2380,"_42174":2375,"_5":42651,"_29767":84661,"_28235":84662,"_5797":82564},[],"/docs/pr-preview/pr-56/platform/pki/overview#build-your-trust-hierarchy",{"_6892":2381,"_42174":2375,"_5":42651,"_29767":84664,"_28235":84665,"_5797":82568},[],"/docs/pr-preview/pr-56/platform/pki/overview#protect-cryptographic-keys",{"_6892":2382,"_42174":2375,"_5":42651,"_29767":84667,"_28235":84668,"_5797":82572},[],"/docs/pr-preview/pr-56/platform/pki/overview#issue-and-control-certificates",{"_6892":2383,"_42174":2375,"_5":42651,"_29767":84670,"_28235":84671,"_5797":82580},[],"/docs/pr-preview/pr-56/platform/pki/overview#publish-validation-status",{"_6892":2384,"_42174":2375,"_5":42651,"_29767":84673,"_28235":84674,"_5797":84675},[],"/docs/pr-preview/pr-56/platform/pki/overview#how-to-check-the-result","How to check the result",{"_6892":2385,"_42174":2375,"_5":42651,"_29767":84677,"_28235":84678,"_5797":83510},[],"/docs/pr-preview/pr-56/platform/pki/overview#continue",{"_6892":2386,"_42174":2375,"_29767":84680,"_5":21387,"_28235":2375,"_5797":84681},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_6892":2387,"_42174":2375,"_29767":84683,"_5":21387,"_28235":84652,"_5797":84684},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_6892":2388,"_42174":2375,"_29767":84686,"_5":21387,"_28235":84652,"_5797":84687},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_6892":2389,"_42174":2375,"_29767":84689,"_5":21387,"_28235":84655,"_5797":84690},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_6892":2390,"_42174":2375,"_29767":84692,"_5":21387,"_28235":84655,"_5797":84693},[],"An available cryptographic engine to keep the authority's key.",{"_6892":2391,"_42174":2375,"_29767":84695,"_5":21387,"_28235":84655,"_5797":84696},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_6892":2392,"_42174":2375,"_29767":84698,"_5":21387,"_28235":84655,"_5797":84699},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_6892":2393,"_42174":2375,"_29767":84701,"_5":21387,"_28235":84655,"_5797":84702},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_6892":2394,"_42174":2375,"_29767":84704,"_5":21387,"_28235":84662,"_5797":84705},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_6892":2395,"_42174":2375,"_29767":84707,"_5":21387,"_28235":84665,"_5797":84708},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_6892":2396,"_42174":2375,"_29767":84710,"_5":21387,"_28235":84668,"_5797":84711},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_6892":2397,"_42174":2375,"_29767":84713,"_5":21387,"_28235":84671,"_5797":84714},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_6892":2398,"_42174":2375,"_29767":84716,"_5":21387,"_28235":84674,"_5797":84717},[],"An active certificate in the console is one part of the check. Also verify that:",{"_6892":2399,"_42174":2375,"_29767":84719,"_5":21387,"_28235":84674,"_5797":84720},[],"its subject and extensions identify the expected client;",{"_6892":2400,"_42174":2375,"_29767":84722,"_5":21387,"_28235":84674,"_5797":84723},[],"its public key matches the client's private key;",{"_6892":2401,"_42174":2375,"_29767":84725,"_5":21387,"_28235":84674,"_5797":84726},[],"its chain reaches a root trusted by the consumer;",{"_6892":2402,"_42174":2375,"_29767":84728,"_5":21387,"_28235":84674,"_5797":84729},[],"its dates and usages allow the operation;",{"_6892":2403,"_42174":2375,"_29767":84731,"_5":21387,"_28235":84674,"_5797":84732},[],"the consumer applies revocation checks and authorization.",{"_6892":2404,"_42174":2375,"_29767":84734,"_5":21387,"_28235":84674,"_5797":84735},[],"The issuance path includes the first independent checks.",{"_6892":2405,"_42174":2375,"_29767":84737,"_5":21387,"_28235":84678,"_5797":84738},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_6892":2406,"_42174":2375,"_29767":84740,"_5":21387,"_28235":84678,"_5797":84741},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_6892":2407,"_42174":2375,"_29767":84743,"_5":21387,"_28235":84678,"_5797":84744},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_6892":2408,"_42174":2408,"_5":21817,"_5797":84746,"_42654":84747,"_29767":84748,"_28235":2408},"Create your first CA",[77248,78697,82716,82153],[],{"_6892":2409,"_42174":2408,"_29767":84750,"_5":21387,"_28235":2408,"_5797":84751},[],"Create an evaluation root and check its certificate before issuing.",{"_6892":2410,"_42174":2408,"_5":42651,"_29767":84753,"_28235":84754,"_5797":77258},[],"/docs/pr-preview/pr-56/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_6892":2411,"_42174":2408,"_5":42651,"_29767":84756,"_28235":84757,"_5797":84758},[],"/docs/pr-preview/pr-56/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard-toc","Open the creation wizard [!toc]",{"_6892":2412,"_42174":2408,"_5":42651,"_29767":84760,"_28235":84761,"_5797":84762},[],"/docs/pr-preview/pr-56/platform/pki/quickstarts/create-certificate-authority#select-the-key-toc","Select the key [!toc]",{"_6892":2413,"_42174":2408,"_5":42651,"_29767":84764,"_28235":84765,"_5797":84766},[],"/docs/pr-preview/pr-56/platform/pki/quickstarts/create-certificate-authority#define-the-authority-toc","Define the authority [!toc]",{"_6892":2414,"_42174":2408,"_5":42651,"_29767":84768,"_28235":84769,"_5797":84770},[],"/docs/pr-preview/pr-56/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca-toc","Review and create the CA [!toc]",{"_6892":2415,"_42174":2408,"_5":42651,"_29767":84772,"_28235":84773,"_5797":84774},[],"/docs/pr-preview/pr-56/platform/pki/quickstarts/create-certificate-authority#verify-the-result-toc","Verify the result [!toc]",{"_6892":2416,"_42174":2408,"_5":42651,"_29767":84776,"_28235":84777,"_5797":84778},[],"/docs/pr-preview/pr-56/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_6892":2417,"_42174":2408,"_5":42651,"_29767":84780,"_28235":84781,"_5797":82410},[],"/docs/pr-preview/pr-56/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_6892":2418,"_42174":2408,"_5":42651,"_29767":84783,"_28235":84784,"_5797":77282},[],"/docs/pr-preview/pr-56/platform/pki/quickstarts/create-certificate-authority#next-step",{"_6892":2419,"_42174":2408,"_29767":84786,"_5":21387,"_28235":2408,"_5797":84787},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_6892":2420,"_42174":2408,"_29767":84789,"_5":21387,"_28235":84754,"_5797":84790},[],"Console access and permission to create keys and authorities.",{"_6892":2421,"_42174":2408,"_29767":84792,"_5":21387,"_28235":84754,"_5797":84793},[],"An available cryptographic engine that supports the chosen algorithm.",{"_6892":2422,"_42174":2408,"_29767":84795,"_5":21387,"_28235":84754,"_5797":84796},[],"OpenSSL 3.x to check the downloaded certificate.",{"_6892":2423,"_42174":2408,"_29767":84798,"_5":21387,"_28235":84754,"_5797":84799},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_6892":2424,"_42174":2408,"_29767":84801,"_5":21387,"_28235":84757,"_5797":84802},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_6892":2425,"_42174":2408,"_29767":84804,"_5":21387,"_28235":84757,"_5797":84805},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_6892":2426,"_42174":2408,"_29767":84807,"_5":21387,"_28235":84761,"_5797":84808},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_6892":2427,"_42174":2408,"_29767":84810,"_5":21387,"_28235":84761,"_5797":84811},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_6892":2428,"_42174":2408,"_29767":84813,"_5":21387,"_28235":84765,"_5797":84814},[],"Select **Root CA** and complete:",{"_6892":2429,"_42174":2408,"_29767":84816,"_5":21387,"_28235":84765,"_5797":84817},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_6892":2430,"_42174":2408,"_29767":84819,"_5":21387,"_28235":84765,"_5797":84820},[],"**Subject**: organization and country details for your evaluation.",{"_6892":2431,"_42174":2408,"_29767":84822,"_5":21387,"_28235":84765,"_5797":84823},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_6892":2432,"_42174":2408,"_29767":84825,"_5":21387,"_28235":84765,"_5797":84826},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_6892":2433,"_42174":2408,"_29767":84828,"_5":21387,"_28235":84765,"_5797":84829},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_6892":2434,"_42174":2408,"_29767":84831,"_5":21387,"_28235":84769,"_5797":84832},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_6892":2435,"_42174":2408,"_29767":84834,"_5":21387,"_28235":84773,"_5797":84835},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_6892":2436,"_42174":2408,"_29767":84837,"_5":21387,"_28235":84773,"_5797":84838},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_6892":2437,"_42174":2408,"_29767":84840,"_5":21387,"_28235":84777,"_5797":84841},[],"Run from the directory where you saved `ca.pem`:",{"_6892":2438,"_42174":2408,"_29767":84843,"_5":21387,"_28235":84777,"_5797":84844},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_6892":2439,"_42174":2408,"_29767":84846,"_5":21387,"_28235":84777,"_5797":84847},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_6892":2440,"_42174":2408,"_29767":84849,"_5":21387,"_28235":84781,"_5797":84850},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_6892":2441,"_42174":2408,"_29767":84852,"_5":21387,"_28235":84781,"_5797":84853},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_6892":2442,"_42174":2408,"_29767":84855,"_5":21387,"_28235":84781,"_5797":84856},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_6892":2443,"_42174":2408,"_29767":84858,"_5":21387,"_28235":84781,"_5797":84859},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_6892":2444,"_42174":2408,"_29767":84861,"_5":21387,"_28235":84784,"_5797":84862},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_6892":2445,"_42174":2445,"_5":21817,"_5797":84864,"_42654":84865,"_29767":84866,"_28235":2445},"Issue and verify a certificate",[77248,78697,82716,82153],[],{"_6892":2446,"_42174":2445,"_29767":84868,"_5":21387,"_28235":2445,"_5797":84869},[],"Issue a client certificate and check content, chain and key correspondence.",{"_6892":2447,"_42174":2445,"_5":42651,"_29767":84871,"_28235":84872,"_5797":77258},[],"/docs/pr-preview/pr-56/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_6892":2448,"_42174":2445,"_5":42651,"_29767":84874,"_28235":84875,"_5797":84876},[],"/docs/pr-preview/pr-56/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_6892":2449,"_42174":2445,"_5":42651,"_29767":84878,"_28235":84879,"_5797":84880},[],"/docs/pr-preview/pr-56/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_6892":2450,"_42174":2445,"_5":42651,"_29767":84882,"_28235":84883,"_5797":84884},[],"/docs/pr-preview/pr-56/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_6892":2451,"_42174":2445,"_5":42651,"_29767":84886,"_28235":84887,"_5797":84888},[],"/docs/pr-preview/pr-56/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_6892":2452,"_42174":2445,"_5":42651,"_29767":84890,"_28235":84891,"_5797":84892},[],"/docs/pr-preview/pr-56/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_6892":2453,"_42174":2445,"_5":42651,"_29767":84894,"_28235":84895,"_5797":84896},[],"/docs/pr-preview/pr-56/platform/pki/quickstarts/issue-certificate#verify-the-result","Verify the result",{"_6892":2454,"_42174":2445,"_5":42651,"_29767":84898,"_28235":84899,"_5797":84900},[],"/docs/pr-preview/pr-56/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_6892":2455,"_42174":2445,"_5":42651,"_29767":84902,"_28235":84903,"_5797":84904},[],"/docs/pr-preview/pr-56/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_6892":2456,"_42174":2445,"_5":42651,"_29767":84906,"_28235":84907,"_5797":84908},[],"/docs/pr-preview/pr-56/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_6892":2457,"_42174":2445,"_5":42651,"_29767":84910,"_28235":84911,"_5797":82410},[],"/docs/pr-preview/pr-56/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_6892":2458,"_42174":2445,"_5":42651,"_29767":84913,"_28235":84914,"_5797":77282},[],"/docs/pr-preview/pr-56/platform/pki/quickstarts/issue-certificate#next-step",{"_6892":2459,"_42174":2445,"_29767":84916,"_5":21387,"_28235":2445,"_5797":84917},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_6892":2460,"_42174":2445,"_29767":84919,"_5":21387,"_28235":84872,"_5797":84920},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_6892":2461,"_42174":2445,"_29767":84922,"_5":21387,"_28235":84872,"_5797":84923},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_6892":2462,"_42174":2445,"_29767":84925,"_5":21387,"_28235":84872,"_5797":84926},[],"OpenSSL 3.x and a working directory with restricted access.",{"_6892":2463,"_42174":2445,"_29767":84928,"_5":21387,"_28235":84872,"_5797":84929},[],"A client identifier: here we use `device-001`.",{"_6892":2464,"_42174":2445,"_29767":84931,"_5":21387,"_28235":84872,"_5797":84932},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_6892":2465,"_42174":2445,"_29767":84934,"_5":21387,"_28235":84875,"_5797":84935},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_6892":2466,"_42174":2445,"_29767":84937,"_5":21387,"_28235":84879,"_5797":84938},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_6892":2467,"_42174":2445,"_29767":84940,"_5":21387,"_28235":84879,"_5797":84941},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_6892":2468,"_42174":2445,"_29767":84943,"_5":21387,"_28235":84883,"_5797":84944},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_6892":2469,"_42174":2445,"_29767":84946,"_5":21387,"_28235":84883,"_5797":84947},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_6892":2470,"_42174":2445,"_29767":84949,"_5":21387,"_28235":84887,"_5797":84950},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_6892":2471,"_42174":2445,"_29767":84952,"_5":21387,"_28235":84887,"_5797":84953},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_6892":2472,"_42174":2445,"_29767":84955,"_5":21387,"_28235":84891,"_5797":84956},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_6892":2473,"_42174":2445,"_29767":84958,"_5":21387,"_28235":84895,"_5797":84959},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_6892":2474,"_42174":2445,"_29767":84961,"_5":21387,"_28235":84899,"_5797":84962},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_6892":2475,"_42174":2445,"_29767":84964,"_5":21387,"_28235":84903,"_5797":84965},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_6892":2476,"_42174":2445,"_29767":84967,"_5":21387,"_28235":84903,"_5797":84968},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_6892":2477,"_42174":2445,"_29767":84970,"_5":21387,"_28235":84903,"_5797":84971},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_6892":2478,"_42174":2445,"_29767":84973,"_5":21387,"_28235":84907,"_5797":84974},[],"In Bash, compare the two public-key digests:",{"_6892":2479,"_42174":2445,"_29767":84976,"_5":21387,"_28235":84907,"_5797":84977},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_6892":2480,"_42174":2445,"_29767":84979,"_5":21387,"_28235":84907,"_5797":84980},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_6892":2481,"_42174":2445,"_29767":84982,"_5":21387,"_28235":84911,"_5797":82494},[],{"_6892":2482,"_42174":2445,"_29767":84984,"_5":21387,"_28235":84911,"_5797":84985},[],"What to review",{"_6892":2483,"_42174":2445,"_29767":84987,"_5":21387,"_28235":84911,"_5797":84988},[],"The CA rejects issuance",{"_6892":2484,"_42174":2445,"_29767":84990,"_5":21387,"_28235":84911,"_5797":84991},[],"Permissions, CA state and key, algorithm and profile.",{"_6892":2485,"_42174":2445,"_29767":84993,"_5":21387,"_28235":84911,"_5797":84994},[],"Different subject or usages",{"_6892":2486,"_42174":2445,"_29767":84996,"_5":21387,"_28235":84911,"_5797":84997},[],"Applied profile and requested values.",{"_6892":2487,"_42174":2445,"_29767":84999,"_5":21387,"_28235":84911,"_5797":85000},[],"Issuer cannot be found",{"_6892":2488,"_42174":2445,"_29767":85002,"_5":21387,"_28235":84911,"_5797":85003},[],"Downloaded CA and required intermediate chain.",{"_6892":2489,"_42174":2445,"_29767":85005,"_5":21387,"_28235":84911,"_5797":85006},[],"Validity fails",{"_6892":2490,"_42174":2445,"_29767":85008,"_5":21387,"_28235":84911,"_5797":85009},[],"Certificate and CA dates, and the computer's clock.",{"_6892":2491,"_42174":2445,"_29767":85011,"_5":21387,"_28235":84911,"_5797":85012},[],"Public-key digests differ",{"_6892":2492,"_42174":2445,"_29767":85014,"_5":21387,"_28235":84911,"_5797":85015},[],"Certificate and key files from the same issuance.",{"_6892":2493,"_42174":2445,"_29767":85017,"_5":21387,"_28235":84911,"_5797":85018},[],"See PKI diagnostics to narrow an issuance failure.",{"_6892":2494,"_42174":2445,"_29767":85020,"_5":21387,"_28235":84914,"_5797":85021},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_6892":2495,"_42174":2445,"_29767":85023,"_5":21387,"_28235":84914,"_5797":85024},[],"Manage certificates for inspection, status and revocation.",{"_6892":2496,"_42174":2445,"_29767":85026,"_5":21387,"_28235":84914,"_5797":85027},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_6892":2497,"_42174":2445,"_29767":85029,"_5":21387,"_28235":84914,"_5797":85030},[],"Prepare EST for the device to request its next identities.",{"_6892":2498,"_42174":2445,"_29767":85032,"_5":21387,"_28235":84914,"_5797":85033},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_6892":2499,"_42174":2499,"_5":21817,"_5797":85035,"_42654":85036,"_29767":85037,"_28235":2499},"PKI getting started",[77248,78697,82716,82153],[],{"_6892":2500,"_42174":2499,"_29767":85039,"_5":21387,"_28235":2499,"_5797":85040},[],"Create a CA, issue a client certificate and check its chain and key.",{"_6892":2501,"_42174":2499,"_5":42651,"_29767":85042,"_28235":85043,"_5797":77258},[],"/docs/pr-preview/pr-56/platform/pki/quickstarts/overview#before-you-begin",{"_6892":2502,"_42174":2499,"_5":42651,"_29767":85045,"_28235":85046,"_5797":85047},[],"/docs/pr-preview/pr-56/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_6892":2503,"_42174":2499,"_5":42651,"_29767":85049,"_28235":85050,"_5797":82345},[],"/docs/pr-preview/pr-56/platform/pki/quickstarts/overview#expected-result",{"_6892":2504,"_42174":2499,"_5":42651,"_29767":85052,"_28235":85053,"_5797":85054},[],"/docs/pr-preview/pr-56/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_6892":2505,"_42174":2499,"_29767":85056,"_5":21387,"_28235":2499,"_5797":85057},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_6892":2506,"_42174":2499,"_29767":85059,"_5":21387,"_28235":85043,"_5797":85060},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_6892":2507,"_42174":2499,"_29767":85062,"_5":21387,"_28235":85043,"_5797":85063},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_6892":2508,"_42174":2499,"_29767":85065,"_5":21387,"_28235":85043,"_5797":85066},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_6892":2509,"_42174":2499,"_29767":85068,"_5":21387,"_28235":85043,"_5797":85069},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_6892":2510,"_42174":2499,"_29767":85071,"_5":21387,"_28235":85043,"_5797":85072},[],"A working directory with restricted access for the downloaded key.",{"_6892":2511,"_42174":2499,"_29767":85074,"_5":21387,"_28235":85046,"_5797":85075},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_6892":2512,"_42174":2499,"_29767":85077,"_5":21387,"_28235":85046,"_5797":85078},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_6892":2513,"_42174":2499,"_29767":85080,"_5":21387,"_28235":85046,"_5797":85081},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_6892":2514,"_42174":2499,"_29767":85083,"_5":21387,"_28235":85046,"_5797":85084},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_6892":2515,"_42174":2499,"_29767":85086,"_5":21387,"_28235":85050,"_5797":85087},[],"File or resource",{"_6892":2516,"_42174":2499,"_29767":85089,"_5":21387,"_28235":85050,"_5797":82342},[],{"_6892":2517,"_42174":2499,"_29767":85091,"_5":21387,"_28235":85050,"_5797":85092},[],"Active root CA and `ca.pem`",{"_6892":2518,"_42174":2499,"_29767":85094,"_5":21387,"_28235":85050,"_5797":85095},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_6892":2519,"_42174":2499,"_29767":85097,"_5":21387,"_28235":85050,"_5797":85098},[],"End-entity certificate and `device.crt`",{"_6892":2520,"_42174":2499,"_29767":85100,"_5":21387,"_28235":85050,"_5797":85101},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_6892":2521,"_42174":2499,"_29767":85103,"_5":21387,"_28235":85050,"_5797":85104},[],"Private key `device.key`",{"_6892":2522,"_42174":2499,"_29767":85106,"_5":21387,"_28235":85050,"_5797":85107},[],"Its public key matches the one included in `device.crt`.",{"_6892":2523,"_42174":2499,"_29767":85109,"_5":21387,"_28235":85050,"_5797":85110},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_6892":2524,"_42174":2499,"_29767":85112,"_5":21387,"_28235":85053,"_5797":85113},[],"To operate certificates, continue with Certificates and Validation.",{"_6892":2525,"_42174":2499,"_29767":85115,"_5":21387,"_28235":85053,"_5797":85116},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_6892":2526,"_42174":2499,"_29767":85118,"_5":21387,"_28235":85053,"_5797":85119},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_6892":2527,"_42174":2527,"_5":21817,"_5797":85121,"_42654":85122,"_29767":85123,"_28235":2527},"PKI troubleshooting",[77248,78697,82716,81275],[],{"_6892":2528,"_42174":2527,"_29767":85125,"_5":21387,"_28235":2527,"_5797":85126},[],"Diagnose certificate issuance, OCSP and CRL.",{"_6892":2529,"_42174":2527,"_5":42651,"_29767":85128,"_28235":85129,"_5797":85130},[],"/docs/pr-preview/pr-56/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_6892":2530,"_42174":2527,"_5":42651,"_29767":85132,"_28235":85133,"_5797":85134},[],"/docs/pr-preview/pr-56/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_6892":2531,"_42174":2527,"_5":42651,"_29767":85136,"_28235":85137,"_5797":85138},[],"/docs/pr-preview/pr-56/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_6892":2532,"_42174":2527,"_29767":85140,"_5":21387,"_28235":2527,"_5797":85141},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_6892":2533,"_42174":2527,"_29767":85143,"_5":21387,"_28235":2527,"_5797":85144},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_6892":2534,"_42174":2527,"_29767":85146,"_5":21387,"_28235":85129,"_5797":82342},[],{"_6892":2535,"_42174":2527,"_29767":85148,"_5":21387,"_28235":85129,"_5797":85149},[],"What to inspect",{"_6892":2536,"_42174":2527,"_29767":85151,"_5":21387,"_28235":85129,"_5797":77282},[],{"_6892":2537,"_42174":2527,"_29767":85153,"_5":21387,"_28235":85129,"_5797":81542},[],{"_6892":2538,"_42174":2527,"_29767":85155,"_5":21387,"_28235":85129,"_5797":85156},[],"Exists, is active and has usable dates.",{"_6892":2539,"_42174":2527,"_29767":85158,"_5":21387,"_28235":85129,"_5797":85159},[],"Authorities.",{"_6892":2540,"_42174":2527,"_29767":85161,"_5":21387,"_28235":85129,"_5797":85162},[],"Key",{"_6892":2541,"_42174":2527,"_29767":85164,"_5":21387,"_28235":85129,"_5797":85165},[],"The record has a usable private key and the engine can sign.",{"_6892":2542,"_42174":2527,"_29767":85167,"_5":21387,"_28235":85129,"_5797":85168},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_6892":2543,"_42174":2527,"_29767":85170,"_5":21387,"_28235":85129,"_5797":85171},[],"CSR",{"_6892":2544,"_42174":2527,"_29767":85173,"_5":21387,"_28235":85129,"_5797":85174},[],"Correct PEM and verifiable signature.",{"_6892":2545,"_42174":2527,"_29767":85176,"_5":21387,"_28235":85129,"_5797":85177},[],"`openssl req -in request.csr -noout -verify -text`.",{"_6892":2546,"_42174":2527,"_29767":85179,"_5":21387,"_28235":85129,"_5797":85180},[],"Profile",{"_6892":2547,"_42174":2527,"_29767":85182,"_5":21387,"_28235":85129,"_5797":85183},[],"Selected source, existing ID, allowed algorithm and size.",{"_6892":2548,"_42174":2527,"_29767":85185,"_5":21387,"_28235":85129,"_5797":85186},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_6892":2549,"_42174":2527,"_29767":85188,"_5":21387,"_28235":85129,"_5797":82494},[],{"_6892":2550,"_42174":2527,"_29767":85190,"_5":21387,"_28235":85129,"_5797":85191},[],"Appropriate subject, SAN, usages and dates.",{"_6892":2551,"_42174":2527,"_29767":85193,"_5":21387,"_28235":85129,"_5797":85194},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_6892":2552,"_42174":2527,"_29767":85196,"_5":21387,"_28235":85129,"_5797":85197},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_6892":2553,"_42174":2527,"_29767":85199,"_5":21387,"_28235":85129,"_5797":85200},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation.",{"_6892":2554,"_42174":2527,"_29767":85202,"_5":21387,"_28235":85133,"_5797":85203},[],"Check each boundary independently:",{"_6892":2555,"_42174":2527,"_29767":85205,"_5":21387,"_28235":85133,"_5797":85206},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_6892":2556,"_42174":2527,"_29767":85208,"_5":21387,"_28235":85133,"_5797":85209},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_6892":2557,"_42174":2527,"_29767":85211,"_5":21387,"_28235":85133,"_5797":85212},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_6892":2558,"_42174":2527,"_29767":85214,"_5":21387,"_28235":85133,"_5797":85215},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_6892":2559,"_42174":2527,"_29767":85217,"_5":21387,"_28235":85133,"_5797":85218},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_6892":2560,"_42174":2527,"_29767":85220,"_5":21387,"_28235":85133,"_5797":85221},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_6892":2561,"_42174":2527,"_29767":85223,"_5":21387,"_28235":85137,"_5797":85224},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_6892":2562,"_42174":2527,"_29767":85226,"_5":21387,"_28235":85137,"_5797":85227},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_6892":2563,"_42174":2563,"_5":21817,"_5797":85229,"_42654":85230,"_29767":85232,"_28235":2563},"Architecture",[77248,78697,85231,83583],"Updates",[],{"_6892":2564,"_42174":2563,"_29767":85234,"_5":21387,"_28235":2563,"_5797":85235},[],"The components of Lamassu Updates, how they connect in each backend, and what runs in the background.",{"_6892":2565,"_42174":2563,"_5":42651,"_29767":85237,"_28235":85238,"_5797":85239},[],"/docs/pr-preview/pr-56/platform/updates/architecture#native-mode","Native mode",{"_6892":2566,"_42174":2563,"_5":42651,"_29767":85241,"_28235":85242,"_5797":85243},[],"/docs/pr-preview/pr-56/platform/updates/architecture#how-devices-connect","How devices connect",{"_6892":2567,"_42174":2563,"_5":42651,"_29767":85245,"_28235":85246,"_5797":85247},[],"/docs/pr-preview/pr-56/platform/updates/architecture#hawkbit-mode","hawkBit mode",{"_6892":2568,"_42174":2563,"_5":42651,"_29767":85249,"_28235":85250,"_5797":85243},[],"/docs/pr-preview/pr-56/platform/updates/architecture#how-devices-connect-1",{"_6892":2569,"_42174":2563,"_5":42651,"_29767":85252,"_28235":85253,"_5797":85254},[],"/docs/pr-preview/pr-56/platform/updates/architecture#what-runs-inside-the-service","What runs inside the service",{"_6892":2570,"_42174":2563,"_5":42651,"_29767":85256,"_28235":85257,"_5797":85258},[],"/docs/pr-preview/pr-56/platform/updates/architecture#dependencies","Dependencies",{"_6892":2571,"_42174":2563,"_5":42651,"_29767":85260,"_28235":85261,"_5797":85262},[],"/docs/pr-preview/pr-56/platform/updates/architecture#where-things-are-stored","Where things are stored",{"_6892":2572,"_42174":2563,"_5":42651,"_29767":85264,"_28235":85265,"_5797":85266},[],"/docs/pr-preview/pr-56/platform/updates/architecture#running-more-than-one-replica","Running more than one replica",{"_6892":2573,"_42174":2563,"_5":42651,"_29767":85268,"_28235":85269,"_5797":80372},[],"/docs/pr-preview/pr-56/platform/updates/architecture#next-steps",{"_6892":2574,"_42174":2563,"_29767":85271,"_5":21387,"_28235":2563,"_5797":85272},[],"Lamassu Updates is one process that serves the Updates API (`/updates/v1`) and, embedded in it, SymKMS (`/symkms/v1`). It also answers `GET /health`. Behind the API there are two interchangeable backends. The `mode` setting picks one when the service starts. Clients, including the Lamassu dashboard, cannot tell them apart except through capabilities.",{"_6892":2575,"_42174":2563,"_29767":85274,"_5":21387,"_28235":85238,"_5797":85275},[],"In native mode the service owns the data. Postgres holds packs, launches and device history, WFX holds one job per device, and the service drives both.",{"_6892":2576,"_42174":2563,"_29767":85277,"_5":21387,"_28235":85238,"_5797":85278},[],"The service is one process. Its parts, and which of them use which dependency, are in What runs inside the service.",{"_6892":2577,"_42174":2563,"_29767":85280,"_5":21387,"_28235":85242,"_5797":85281},[],"A device never talks to the service except to download its package. It polls WFX for jobs and reports each state change to WFX. The service learns about the changes from WFX's event stream.",{"_6892":2578,"_42174":2563,"_29767":85283,"_5":21387,"_28235":85242,"_5797":85284},[],"The download address in each job is the pack's download route under `update_domain`, with the device ID appended so per-device packages and gateway authorization work. When the `builds` blob store is on S3 with presigned downloads enabled, a download is answered with a `302` to a short-lived signed URL of the object instead of streaming the bytes through the service. Local storage always streams. Both support `Range` requests, so an interrupted download resumes.",{"_6892":2579,"_42174":2563,"_29767":85286,"_5":21387,"_28235":85246,"_5797":85287},[],"In hawkBit mode the service is a gateway. Packs become distribution sets, launches become rollouts, and hawkBit owns that data and is read live on every request. The service keeps in Postgres only what hawkBit has no place for. See Data model.",{"_6892":2580,"_42174":2563,"_29767":85289,"_5":21387,"_28235":85250,"_5797":85290},[],"Devices talk to hawkBit and never to this service for polling. They poll hawkBit's DDI API and send their feedback to it. The service reads progress back from hawkBit whenever it is asked, and has no event stream to follow.",{"_6892":2581,"_42174":2563,"_29767":85292,"_5":21387,"_28235":85250,"_5797":85293},[],"The artifact download can also go through this service. It serves hawkBit's device artifact route (`/{tenant}/controller/v1/{controllerId}/softwaremodules/{id}/artifacts/{filename}`, under the path of `hawkbit.ddi_url`) unrewritten, so a gateway in front of both keeps matching its authorization rules. The service answers only for a module assigned to, or installed on, that device, and otherwise returns `404`. With presigning enabled on `hawkbit.artifact_store` it redirects (`302`) to a signed URL of hawkBit's S3 bucket. See Connect a device.",{"_6892":2582,"_42174":2563,"_29767":85295,"_5":21387,"_28235":85253,"_5797":80531},[],{"_6892":2583,"_42174":2563,"_29767":85297,"_5":21387,"_28235":85253,"_5797":85298},[],"What it does",{"_6892":2584,"_42174":2563,"_29767":85300,"_5":21387,"_28235":85253,"_5797":85301},[],"Native",{"_6892":2585,"_42174":2563,"_29767":85303,"_5":21387,"_28235":85253,"_5797":85304},[],"hawkBit",{"_6892":2586,"_42174":2563,"_29767":85306,"_5":21387,"_28235":85253,"_5797":85307},[],"Updates API",{"_6892":2587,"_42174":2563,"_29767":85309,"_5":21387,"_28235":85253,"_5797":85310},[],"Packs, modules, artifacts, launches, device inventory, version compliance",{"_6892":2588,"_42174":2563,"_29767":85312,"_5":21387,"_28235":85253,"_5797":81396},[],{"_6892":2589,"_42174":2563,"_29767":85314,"_5":21387,"_28235":85253,"_5797":85315},[],"Yes (translated to hawkBit calls)",{"_6892":2590,"_42174":2563,"_29767":85317,"_5":21387,"_28235":85253,"_5797":85318},[],"SymKMS",{"_6892":2591,"_42174":2563,"_29767":85320,"_5":21387,"_28235":85253,"_5797":85321},[],"Stores symmetric keys and assigns them to devices. Used by shared and per-device encryption",{"_6892":2592,"_42174":2563,"_29767":85323,"_5":21387,"_28235":85253,"_5797":81396},[],{"_6892":2593,"_42174":2563,"_29767":85325,"_5":21387,"_28235":85253,"_5797":85326},[],"Yes, for shared-key encryption, when a SymKMS storage or `sym_keys_dir` is configured",{"_6892":2594,"_42174":2563,"_29767":85328,"_5":21387,"_28235":85253,"_5797":85329},[],"SWU builder",{"_6892":2595,"_42174":2563,"_29767":85331,"_5":21387,"_28235":85253,"_5797":85332},[],"Runs `swugenerator` to assemble, sign and encrypt `.swu` packages",{"_6892":2596,"_42174":2563,"_29767":85334,"_5":21387,"_28235":85253,"_5797":81396},[],{"_6892":2597,"_42174":2563,"_29767":85336,"_5":21387,"_28235":85253,"_5797":85337},[],"Yes (per module), when `swugenerator_path` is set",{"_6892":2598,"_42174":2563,"_29767":85339,"_5":21387,"_28235":85253,"_5797":85340},[],"Blob stores",{"_6892":2599,"_42174":2563,"_29767":85342,"_5":21387,"_28235":85253,"_5797":85343},[],"Artifacts, builds and keys, on local disk or S3, optionally encrypted at rest",{"_6892":2600,"_42174":2563,"_29767":85345,"_5":21387,"_28235":85253,"_5797":81396},[],{"_6892":2601,"_42174":2563,"_29767":85347,"_5":21387,"_28235":85253,"_5797":85348},[],"Keys only (artifact bytes live in hawkBit's artifact store)",{"_6892":2602,"_42174":2563,"_29767":85350,"_5":21387,"_28235":85253,"_5797":85351},[],"WFX event consumer",{"_6892":2603,"_42174":2563,"_29767":85353,"_5":21387,"_28235":85253,"_5797":85354},[],"Reads WFX's server-sent event stream, updates each device's state in its launch, releases the next batch",{"_6892":2604,"_42174":2563,"_29767":85356,"_5":21387,"_28235":85253,"_5797":81396},[],{"_6892":2605,"_42174":2563,"_29767":85358,"_5":21387,"_28235":85253,"_5797":81448},[],{"_6892":2606,"_42174":2563,"_29767":85360,"_5":21387,"_28235":85253,"_5797":85361},[],"Scheduled-launch trigger",{"_6892":2607,"_42174":2563,"_29767":85363,"_5":21387,"_28235":85253,"_5797":85364},[],"Starts launches whose `scheduled_at` has passed, polling every 30 seconds, and repairs batches whose dispatch was interrupted",{"_6892":2608,"_42174":2563,"_29767":85366,"_5":21387,"_28235":85253,"_5797":81396},[],{"_6892":2609,"_42174":2563,"_29767":85368,"_5":21387,"_28235":85253,"_5797":85369},[],"No (hawkBit's own scheduler)",{"_6892":2610,"_42174":2563,"_29767":85371,"_5":21387,"_28235":85253,"_5797":85372},[],"Leader election",{"_6892":2611,"_42174":2563,"_29767":85374,"_5":21387,"_28235":85253,"_5797":85375},[],"Makes sure one replica runs the background work",{"_6892":2612,"_42174":2563,"_29767":85377,"_5":21387,"_28235":85253,"_5797":81396},[],{"_6892":2613,"_42174":2563,"_29767":85379,"_5":21387,"_28235":85253,"_5797":85380},[],"Not needed",{"_6892":2614,"_42174":2563,"_29767":85382,"_5":21387,"_28235":85253,"_5797":85383},[],"Reconciliation",{"_6892":2615,"_42174":2563,"_29767":85385,"_5":21387,"_28235":85253,"_5797":85386},[],"Each time the event stream connects (at start-up and after an outage), replays device completions it missed, because the stream has no replay",{"_6892":2616,"_42174":2563,"_29767":85388,"_5":21387,"_28235":85253,"_5797":81396},[],{"_6892":2617,"_42174":2563,"_29767":85390,"_5":21387,"_28235":85253,"_5797":81448},[],{"_6892":2618,"_42174":2563,"_29767":85392,"_5":21387,"_28235":85253,"_5797":85393},[],"Presigned downloads",{"_6892":2619,"_42174":2563,"_29767":85395,"_5":21387,"_28235":85253,"_5797":85396},[],"Answers downloads with a redirect to a signed object-store URL",{"_6892":2620,"_42174":2563,"_29767":85398,"_5":21387,"_28235":85253,"_5797":85399},[],"Builds store",{"_6892":2621,"_42174":2563,"_29767":85401,"_5":21387,"_28235":85253,"_5797":85402},[],"`hawkbit.artifact_store`",{"_6892":2622,"_42174":2563,"_29767":85404,"_5":21387,"_28235":85257,"_5797":85405},[],"System",{"_6892":2623,"_42174":2563,"_29767":85407,"_5":21387,"_28235":85257,"_5797":85408},[],"Role",{"_6892":2624,"_42174":2563,"_29767":85410,"_5":21387,"_28235":85257,"_5797":85411},[],"Needed in",{"_6892":2625,"_42174":2563,"_29767":85413,"_5":21387,"_28235":85257,"_5797":85414},[],"Postgres",{"_6892":2626,"_42174":2563,"_29767":85416,"_5":21387,"_28235":85257,"_5797":85417},[],"The service's own data",{"_6892":2627,"_42174":2563,"_29767":85419,"_5":21387,"_28235":85257,"_5797":85420},[],"Both",{"_6892":2628,"_42174":2563,"_29767":85422,"_5":21387,"_28235":85257,"_5797":85423},[],"Lamassu Device Manager",{"_6892":2629,"_42174":2563,"_29767":85425,"_5":21387,"_28235":85257,"_5797":85426},[],"Source of device groups and devices",{"_6892":2630,"_42174":2563,"_29767":85428,"_5":21387,"_28235":85257,"_5797":85429},[],"Native. Optional in hawkBit mode: without it the service reads the `group:<id>` tags on hawkBit's own targets",{"_6892":2631,"_42174":2563,"_29767":85431,"_5":21387,"_28235":85257,"_5797":85432},[],"Lamassu KMS",{"_6892":2632,"_42174":2563,"_29767":85434,"_5":21387,"_28235":85257,"_5797":85435},[],"Signing keys, for the package and for version manifests",{"_6892":2633,"_42174":2563,"_29767":85437,"_5":21387,"_28235":85257,"_5797":85438},[],"When signing",{"_6892":2634,"_42174":2563,"_29767":85440,"_5":21387,"_28235":85257,"_5797":85441},[],"WFX",{"_6892":2635,"_42174":2563,"_29767":85443,"_5":21387,"_28235":85257,"_5797":85444},[],"Job orchestration",{"_6892":2636,"_42174":2563,"_29767":85446,"_5":21387,"_28235":85257,"_5797":85301},[],{"_6892":2637,"_42174":2563,"_29767":85448,"_5":21387,"_28235":85257,"_5797":85449},[],"Eclipse hawkBit",{"_6892":2638,"_42174":2563,"_29767":85451,"_5":21387,"_28235":85257,"_5797":85452},[],"The update server",{"_6892":2639,"_42174":2563,"_29767":85454,"_5":21387,"_28235":85257,"_5797":85304},[],{"_6892":2640,"_42174":2563,"_29767":85456,"_5":21387,"_28235":85257,"_5797":85457},[],"swugenerator (bundled)",{"_6892":2641,"_42174":2563,"_29767":85459,"_5":21387,"_28235":85257,"_5797":85460},[],"Builds `.swu` files",{"_6892":2642,"_42174":2563,"_29767":85462,"_5":21387,"_28235":85257,"_5797":85463},[],"When building",{"_6892":2643,"_42174":2563,"_29767":85465,"_5":21387,"_28235":85261,"_5797":85466},[],"Data",{"_6892":2644,"_42174":2563,"_29767":85468,"_5":21387,"_28235":85261,"_5797":85301},[],{"_6892":2645,"_42174":2563,"_29767":85470,"_5":21387,"_28235":85261,"_5797":85304},[],{"_6892":2646,"_42174":2563,"_29767":85472,"_5":21387,"_28235":85261,"_5797":85473},[],"Packs, versions, modules",{"_6892":2647,"_42174":2563,"_29767":85475,"_5":21387,"_28235":85261,"_5797":85476},[],"Postgres (`updates`)",{"_6892":2648,"_42174":2563,"_29767":85478,"_5":21387,"_28235":85261,"_5797":85304},[],{"_6892":2649,"_42174":2563,"_29767":85480,"_5":21387,"_28235":85261,"_5797":85481},[],"Artifact bytes",{"_6892":2650,"_42174":2563,"_29767":85483,"_5":21387,"_28235":85261,"_5797":85484},[],"Blob store (`artifacts`)",{"_6892":2651,"_42174":2563,"_29767":85486,"_5":21387,"_28235":85261,"_5797":85487},[],"hawkBit's artifact store",{"_6892":2652,"_42174":2563,"_29767":85489,"_5":21387,"_28235":85261,"_5797":85490},[],"Built `.swu` and packages",{"_6892":2653,"_42174":2563,"_29767":85492,"_5":21387,"_28235":85261,"_5797":85493},[],"Blob store (`builds`)",{"_6892":2654,"_42174":2563,"_29767":85495,"_5":21387,"_28235":85261,"_5797":85496},[],"hawkBit (as module artifacts)",{"_6892":2655,"_42174":2563,"_29767":85498,"_5":21387,"_28235":85261,"_5797":37350},[],{"_6892":2656,"_42174":2563,"_29767":85500,"_5":21387,"_28235":85261,"_5797":85501},[],"Postgres (a column of the pack and of the module)",{"_6892":2657,"_42174":2563,"_29767":85503,"_5":21387,"_28235":85261,"_5797":85414},[],{"_6892":2658,"_42174":2563,"_29767":85505,"_5":21387,"_28235":85261,"_5797":85506},[],"Launches and device assignments",{"_6892":2659,"_42174":2563,"_29767":85508,"_5":21387,"_28235":85261,"_5797":85414},[],{"_6892":2660,"_42174":2563,"_29767":85510,"_5":21387,"_28235":85261,"_5797":85511},[],"hawkBit rollouts and actions",{"_6892":2661,"_42174":2563,"_29767":85513,"_5":21387,"_28235":85261,"_5797":85514},[],"Device jobs",{"_6892":2662,"_42174":2563,"_29767":85516,"_5":21387,"_28235":85261,"_5797":85441},[],{"_6892":2663,"_42174":2563,"_29767":85518,"_5":21387,"_28235":85261,"_5797":85519},[],"hawkBit actions",{"_6892":2664,"_42174":2563,"_29767":85521,"_5":21387,"_28235":85261,"_5797":85522},[],"Device update history",{"_6892":2665,"_42174":2563,"_29767":85524,"_5":21387,"_28235":85261,"_5797":85414},[],{"_6892":2666,"_42174":2563,"_29767":85526,"_5":21387,"_28235":85261,"_5797":85527},[],"Read from hawkBit",{"_6892":2667,"_42174":2563,"_29767":85529,"_5":21387,"_28235":85261,"_5797":85530},[],"Encryption keys",{"_6892":2668,"_42174":2563,"_29767":85532,"_5":21387,"_28235":85261,"_5797":85533},[],"SymKMS blob store",{"_6892":2669,"_42174":2563,"_29767":85535,"_5":21387,"_28235":85261,"_5797":85533},[],{"_6892":2670,"_42174":2563,"_29767":85537,"_5":21387,"_28235":85261,"_5797":85538},[],"Native mode also uses `update_files_base_dir` as build scratch space: it stages a build's inputs there, and the built outputs are published to the `builds` store.",{"_6892":2671,"_42174":2563,"_29767":85540,"_5":21387,"_28235":85265,"_5797":85541},[],"The background work (the WFX event consumer and the scheduled-launch trigger) runs on exactly one replica at a time. Leader election picks it: Kubernetes Leases when running inside a cluster, a Postgres advisory lock elsewhere, configurable with `leader_election.mode` (`\"\"`, `kubernetes` or `database`). Without election every replica would count the same job completions and release batches early, so a failure to configure it stops the service at start-up. Batch dispatch is also protected by a per-launch lock, so two callers never send the same batch twice.",{"_6892":2672,"_42174":2563,"_29767":85543,"_5":21387,"_28235":85265,"_5797":85544},[],"If `builds` is on local disk the service logs a warning and the deployment is limited to one replica, because other replicas could not serve the builds. Put `builds`, `artifacts` and the SymKMS store on S3 to scale out. See Operations.",{"_6892":2673,"_42174":2563,"_29767":85546,"_5":21387,"_28235":85269,"_5797":85547},[],"<Card title=\"Flows\" description=\"The sequence of every important operation.\" href=\"/docs/platform/updates/flows\" />",{"_6892":2674,"_42174":2563,"_29767":85549,"_5":21387,"_28235":85269,"_5797":85550},[],"<Card title=\"Data model\" description=\"The tables the service keeps and how they relate.\" href=\"/docs/platform/updates/data-model\" />",{"_6892":2675,"_42174":2563,"_29767":85552,"_5":21387,"_28235":85269,"_5797":85553},[],"<Card title=\"Operations\" description=\"Deploy, scale, back up and upgrade.\" href=\"/docs/platform/updates/operations\" />",{"_6892":2676,"_42174":2676,"_5":21817,"_5797":83583,"_42654":85555,"_29767":85556,"_28235":2676},[77248,78697,85231,83583],[],{"_6892":2677,"_42174":2676,"_29767":85558,"_5":21387,"_28235":2676,"_5797":85559},[],"Update packs, software modules, launch campaigns, workflows and how an update reaches a device.",{"_6892":2678,"_42174":2676,"_5":42651,"_29767":85561,"_28235":85562,"_5797":85563},[],"/docs/pr-preview/pr-56/platform/updates/concepts#vocabulary","Vocabulary",{"_6892":2679,"_42174":2676,"_5":42651,"_29767":85565,"_28235":85566,"_5797":85567},[],"/docs/pr-preview/pr-56/platform/updates/concepts#update-packs","Update packs",{"_6892":2680,"_42174":2676,"_5":42651,"_29767":85569,"_28235":85570,"_5797":85571},[],"/docs/pr-preview/pr-56/platform/updates/concepts#software-modules","Software modules",{"_6892":2681,"_42174":2676,"_5":42651,"_29767":85573,"_28235":85574,"_5797":85575},[],"/docs/pr-preview/pr-56/platform/updates/concepts#launch-campaigns","Launch campaigns",{"_6892":2682,"_42174":2676,"_5":42651,"_29767":85577,"_28235":85578,"_5797":85579},[],"/docs/pr-preview/pr-56/platform/updates/concepts#strategy","Strategy",{"_6892":2683,"_42174":2676,"_5":42651,"_29767":85581,"_28235":85582,"_5797":85583},[],"/docs/pr-preview/pr-56/platform/updates/concepts#lifecycle","Lifecycle",{"_6892":2684,"_42174":2676,"_5":42651,"_29767":85585,"_28235":85586,"_5797":85587},[],"/docs/pr-preview/pr-56/platform/updates/concepts#versions-compliance-and-inventory","Versions, compliance and inventory",{"_6892":2685,"_42174":2676,"_5":42651,"_29767":85589,"_28235":85590,"_5797":85591},[],"/docs/pr-preview/pr-56/platform/updates/concepts#how-an-update-reaches-a-device-native-mode","How an update reaches a device (native mode)",{"_6892":2686,"_42174":2676,"_5":42651,"_29767":85593,"_28235":85594,"_5797":80372},[],"/docs/pr-preview/pr-56/platform/updates/concepts#next-steps",{"_6892":2687,"_42174":2676,"_29767":85596,"_5":21387,"_28235":2676,"_5797":85597},[],"The terms Lamassu Updates uses, and how they fit together. Read this page before the guides if \"update pack\", \"launch\" or \"module\" is new to you.",{"_6892":2688,"_42174":2676,"_29767":85599,"_5":21387,"_28235":85562,"_5797":85600},[],"The dashboard and this documentation say **update pack**. The REST API and the code say **distribution set** (`/distribution-sets/...`). They are the same thing.",{"_6892":2689,"_42174":2676,"_29767":85602,"_5":21387,"_28235":85562,"_5797":85603},[],"Term",{"_6892":2690,"_42174":2676,"_29767":85605,"_5":21387,"_28235":85562,"_5797":79765},[],{"_6892":2691,"_42174":2676,"_29767":85607,"_5":21387,"_28235":85562,"_5797":85608},[],"API / code name",{"_6892":2692,"_42174":2676,"_29767":85610,"_5":21387,"_28235":85562,"_5797":85611},[],"Update pack",{"_6892":2693,"_42174":2676,"_29767":85613,"_5":21387,"_28235":85562,"_5797":85614},[],"A named, versioned deliverable you send to devices",{"_6892":2694,"_42174":2676,"_29767":85616,"_5":21387,"_28235":85562,"_5797":85617},[],"`distribution-set`",{"_6892":2695,"_42174":2676,"_29767":85619,"_5":21387,"_28235":85562,"_5797":85620},[],"Software module",{"_6892":2696,"_42174":2676,"_29767":85622,"_5":21387,"_28235":85562,"_5797":85623},[],"One typed, named component inside a pack, such as an application. Identified by the key `type:name`, where `type` is `os` or `application`",{"_6892":2697,"_42174":2676,"_29767":85625,"_5":21387,"_28235":85562,"_5797":85626},[],"`softwaremodule`",{"_6892":2698,"_42174":2676,"_29767":85628,"_5":21387,"_28235":85562,"_5797":85629},[],"Artifact",{"_6892":2699,"_42174":2676,"_29767":85631,"_5":21387,"_28235":85562,"_5797":85632},[],"A file (binary) attached to a module or pack",{"_6892":2700,"_42174":2676,"_29767":85634,"_5":21387,"_28235":85562,"_5797":85635},[],"`artifact`",{"_6892":2701,"_42174":2676,"_29767":85637,"_5":21387,"_28235":85562,"_5797":85638},[],"Device group",{"_6892":2702,"_42174":2676,"_29767":85640,"_5":21387,"_28235":85562,"_5797":85641},[],"A set of devices registered in Lamassu IoT. A pack belongs to a group",{"_6892":2703,"_42174":2676,"_29767":85643,"_5":21387,"_28235":85562,"_5797":85644},[],"`groupID`",{"_6892":2704,"_42174":2676,"_29767":85646,"_5":21387,"_28235":85562,"_5797":85647},[],"Launch campaign",{"_6892":2705,"_42174":2676,"_29767":85649,"_5":21387,"_28235":85562,"_5797":85650},[],"One rollout of one pack version to the devices of a group",{"_6892":2706,"_42174":2676,"_29767":85652,"_5":21387,"_28235":85562,"_5797":85653},[],"`launch`",{"_6892":2707,"_42174":2676,"_29767":85655,"_5":21387,"_28235":85562,"_5797":85656},[],"Job",{"_6892":2708,"_42174":2676,"_29767":85658,"_5":21387,"_28235":85562,"_5797":85659},[],"One device's update inside a launch",{"_6892":2709,"_42174":2676,"_29767":85661,"_5":21387,"_28235":85562,"_5797":85662},[],"job, device assignment",{"_6892":2710,"_42174":2676,"_29767":85664,"_5":21387,"_28235":85566,"_5797":85665},[],"A pack has a **version** (semantic, `x.y.z`) and a **status**:",{"_6892":2711,"_42174":2676,"_29767":85667,"_5":21387,"_28235":85566,"_5797":85668},[],"Status",{"_6892":2712,"_42174":2676,"_29767":85670,"_5":21387,"_28235":85566,"_5797":79765},[],{"_6892":2713,"_42174":2676,"_29767":85672,"_5":21387,"_28235":85566,"_5797":85673},[],"`draft`",{"_6892":2714,"_42174":2676,"_29767":85675,"_5":21387,"_28235":85566,"_5797":85676},[],"Editable. Artifacts can be added or replaced. Not built yet.",{"_6892":2715,"_42174":2676,"_29767":85678,"_5":21387,"_28235":85566,"_5797":85679},[],"`built`",{"_6892":2716,"_42174":2676,"_29767":85681,"_5":21387,"_28235":85566,"_5797":85682},[],"The deliverable exists. The version is immutable. Create a new version to change it.",{"_6892":2717,"_42174":2676,"_29767":85684,"_5":21387,"_28235":85566,"_5797":85685},[],"`build_failed`",{"_6892":2718,"_42174":2676,"_29767":85687,"_5":21387,"_28235":85566,"_5797":85688},[],"A build was attempted and failed. Still editable and retryable. The reason is in `last_build_error`.",{"_6892":2719,"_42174":2676,"_29767":85690,"_5":21387,"_28235":85566,"_5797":85691},[],"A pack has one **packaging**:",{"_6892":2720,"_42174":2676,"_29767":85693,"_5":21387,"_28235":85566,"_5797":85694},[],"Packaging",{"_6892":2721,"_42174":2676,"_29767":85696,"_5":21387,"_28235":85566,"_5797":85697},[],"Delivered as",{"_6892":2722,"_42174":2676,"_29767":85699,"_5":21387,"_28235":85566,"_5797":85700},[],"Workflow terminal state",{"_6892":2723,"_42174":2676,"_29767":85702,"_5":21387,"_28235":85566,"_5797":85703},[],"`swu`",{"_6892":2724,"_42174":2676,"_29767":85705,"_5":21387,"_28235":85566,"_5797":85706},[],"A `.swu` built with swugenerator, optionally signed and encrypted",{"_6892":2725,"_42174":2676,"_29767":85708,"_5":21387,"_28235":85566,"_5797":85709},[],"`ACTIVATED`",{"_6892":2726,"_42174":2676,"_29767":85711,"_5":21387,"_28235":85566,"_5797":85712},[],"`non-swu`",{"_6892":2727,"_42174":2676,"_29767":85714,"_5":21387,"_28235":85566,"_5797":85715},[],"The raw artifacts. Native mode builds a `.tar.gz` package (optionally encrypted, `.tar.gz.enc`). hawkBit mode delivers a `raw` module's single file as uploaded (optionally encrypted), and archives several files as `<name>.tar.gz`",{"_6892":2728,"_42174":2676,"_29767":85717,"_5":21387,"_28235":85566,"_5797":85718},[],"`INSTALLED`",{"_6892":2729,"_42174":2676,"_29767":85720,"_5":21387,"_28235":85566,"_5797":85721},[],"A pack can also carry **preconditions**: rules such as \"the device must already have pack X at version 1.2.0 or higher\", or \"the module `os:gateway-fw` at version 2.1.0 or higher\". Each precondition names exactly one pack (`required_distribution_set_name`) or one module (`required_module_key`) and a semantic `min_version`. A device that fails a precondition is not deployable, unless an operator forces the launch. Each launch records which devices failed and why.",{"_6892":2730,"_42174":2676,"_29767":85723,"_5":21387,"_28235":85570,"_5797":85724},[],"A pack is a composition of modules. A pack holds one `os` module (the mandatory anchor) and any number of `application` modules. In native mode a pack without module rows is shown with one implicit module `os:<pack name>`, and the files you upload to the pack belong to it. A module holds its own files and, optionally, release notes. You can:",{"_6892":2731,"_42174":2676,"_29767":85726,"_5":21387,"_28235":85570,"_5797":85727},[],"create a module on its own in the **catalog** (`POST /updates/v1/softwaremodules`) and compose packs from it later,",{"_6892":2732,"_42174":2676,"_29767":85729,"_5":21387,"_28235":85570,"_5797":85730},[],"add a module to a pack directly, or",{"_6892":2733,"_42174":2676,"_29767":85732,"_5":21387,"_28235":85570,"_5797":85733},[],"import a module that another pack already has.",{"_6892":2734,"_42174":2676,"_29767":85735,"_5":21387,"_28235":85570,"_5797":85736},[],"A module's **delivery intent** says how it will ship: `undecided` (default), `swu-build`, `swu-prebuilt` or `raw`.",{"_6892":2735,"_42174":2676,"_29767":85738,"_5":21387,"_28235":85570,"_5797":85739},[],"How modules relate to the build differs by backend:",{"_6892":2736,"_42174":2676,"_29767":85741,"_5":21387,"_28235":85570,"_5797":85742},[],"**native**: modules are *build inputs*. The pack builds one `.swu` from all of them, and a launch sends each device a single download address.",{"_6892":2737,"_42174":2676,"_29767":85744,"_5":21387,"_28235":85570,"_5797":85745},[],"**hawkbit**: each module has its *own deliverable*, built in the module catalog before the pack exists. Only built modules can be linked into a pack, and a linked module is frozen. hawkBit hands every module's artifacts to the device, so a pack with several modules installs as several independent SWUpdate transactions. SWUpdate cannot roll back across several `.swu` files.",{"_6892":2738,"_42174":2676,"_29767":85747,"_5":21387,"_28235":85570,"_5797":85748},[],"Importing a module also differs. In hawkBit mode the import **links** it, so both packs share the module and a rebuild is seen by both. In native mode it **copies** it, so the two diverge afterwards. The listing of reusable modules tells you which one you will get (`shared`).",{"_6892":2739,"_42174":2676,"_29767":85750,"_5":21387,"_28235":85574,"_5797":85751},[],"A launch rolls one pack version out to a group's devices in **batches**.",{"_6892":2740,"_42174":2676,"_29767":85753,"_5":21387,"_28235":85578,"_5797":85754},[],"Field",{"_6892":2741,"_42174":2676,"_29767":85756,"_5":21387,"_28235":85578,"_5797":79765},[],{"_6892":2742,"_42174":2676,"_29767":85758,"_5":21387,"_28235":85578,"_5797":85759},[],"`rollout_type`",{"_6892":2743,"_42174":2676,"_29767":85761,"_5":21387,"_28235":85578,"_5797":85762},[],"How a batch is sized. Only `percentage` makes `rollout_value` a percentage. Any other value (`fixed`, or `numeric`, which the dashboard sends) makes it a device count",{"_6892":2744,"_42174":2676,"_29767":85764,"_5":21387,"_28235":85578,"_5797":85765},[],"`rollout_value`",{"_6892":2745,"_42174":2676,"_29767":85767,"_5":21387,"_28235":85578,"_5797":85768},[],"The percentage, or the device count. Must be greater than 0",{"_6892":2746,"_42174":2676,"_29767":85770,"_5":21387,"_28235":85578,"_5797":85771},[],"`workflow_type`",{"_6892":2747,"_42174":2676,"_29767":85773,"_5":21387,"_28235":85578,"_5797":85774},[],"The WFX workflow: `direct` (no confirmation), `phased` (confirmation steps) or `download-install`. Use `download-install` for `non-swu` packs. Any other value is passed to WFX as a full workflow name, such as `wfx.workflow.dau.simple`. In hawkBit mode there is no WFX: `phased` becomes a hawkBit soft action (the device confirms or postpones) and every other value a forced action",{"_6892":2748,"_42174":2676,"_29767":85776,"_5":21387,"_28235":85578,"_5797":85777},[],"`test_device_id`",{"_6892":2749,"_42174":2676,"_29767":85779,"_5":21387,"_28235":85578,"_5797":85780},[],"A canary. The first batch is this one device, and it must succeed before anyone else is touched",{"_6892":2750,"_42174":2676,"_29767":85782,"_5":21387,"_28235":85578,"_5797":85783},[],"`auto`",{"_6892":2751,"_42174":2676,"_29767":85785,"_5":21387,"_28235":85578,"_5797":85786},[],"Release the next batch automatically when conditions are met",{"_6892":2752,"_42174":2676,"_29767":85788,"_5":21387,"_28235":85578,"_5797":85789},[],"`approval_threshold`",{"_6892":2753,"_42174":2676,"_29767":85791,"_5":21387,"_28235":85578,"_5797":85792},[],"% of the current batch that must succeed before the next batch starts (0 to 100). Unset, 0 or 100 means the whole batch",{"_6892":2754,"_42174":2676,"_29767":85794,"_5":21387,"_28235":85578,"_5797":85795},[],"`error_threshold`",{"_6892":2755,"_42174":2676,"_29767":85797,"_5":21387,"_28235":85578,"_5797":85798},[],"The launch is cancelled once this % of all devices have failed (rounded up, so 10% of 100 devices cancels at the 10th failure). `0` means no limit",{"_6892":2756,"_42174":2676,"_29767":85800,"_5":21387,"_28235":85578,"_5797":85801},[],"`scheduled_at`",{"_6892":2757,"_42174":2676,"_29767":85803,"_5":21387,"_28235":85578,"_5797":85804},[],"Planned start time (RFC 3339). Native mode starts the first batch when it passes (polled every 30 seconds); hawkBit mode hands it to hawkBit as the rollout's start time",{"_6892":2758,"_42174":2676,"_29767":85806,"_5":21387,"_28235":85578,"_5797":85807},[],"`name`, `description`",{"_6892":2759,"_42174":2676,"_29767":85809,"_5":21387,"_28235":85578,"_5797":85810},[],"Display name (defaults to the pack name) and free-text notes",{"_6892":2760,"_42174":2676,"_29767":85812,"_5":21387,"_28235":85578,"_5797":85813},[],"`weight`",{"_6892":2761,"_42174":2676,"_29767":85815,"_5":21387,"_28235":85578,"_5797":85816},[],"A stored priority hint, 0 to 1000. Nothing reads it",{"_6892":2762,"_42174":2676,"_29767":85818,"_5":21387,"_28235":85582,"_5797":85819},[],"A launch is `running`, `paused` (resumable), `cancelled` (terminal) or `completed` (terminal). A device inside it goes `pending` → `active` → `completed` or `failed`. You can retry only the failed devices (`retry-failed`). In native mode this also reopens a finished or cancelled launch. The operator controls are `rollout`, `pause`, `resume`, `cancel`, `complete` and `retry-failed`, and the strategy can be edited while the launch exists. Native mode supports all of them. hawkBit mode has no `complete` and no strategy edit, because a rollout's groups and thresholds are fixed at creation (see Capabilities).",{"_6892":2763,"_42174":2676,"_29767":85821,"_5":21387,"_28235":85586,"_5797":85822},[],"Beyond one-off launches you can declare the **latest version** of a pack for a group. The service then reports **drift**: devices that are not on the latest version. You can force one device to the latest version, or to an exact one. See the API reference.",{"_6892":2764,"_42174":2676,"_29767":85824,"_5":21387,"_28235":85586,"_5797":85825},[],"The service also keeps a **device inventory**: which pack version each device carries now, with the artifacts that version's manifest declares, and the history of update attempts. Both are filled as the service's launches run.",{"_6892":2765,"_42174":2676,"_29767":85827,"_5":21387,"_28235":85590,"_5797":85828},[],"The device-side state machine is a WFX workflow, in `wfx/workflow/dau/` of the repository:",{"_6892":2766,"_42174":2676,"_29767":85830,"_5":21387,"_28235":85590,"_5797":85831},[],"Workflow file",{"_6892":2767,"_42174":2676,"_29767":85833,"_5":21387,"_28235":85590,"_5797":85834},[],"States",{"_6892":2768,"_42174":2676,"_29767":85836,"_5":21387,"_28235":85590,"_5797":85837},[],"Use",{"_6892":2769,"_42174":2676,"_29767":85839,"_5":21387,"_28235":85590,"_5797":85840},[],"`wfx.workflow.dau.direct.yml`",{"_6892":2770,"_42174":2676,"_29767":85842,"_5":21387,"_28235":85590,"_5797":85843},[],"INSTALL → INSTALLING → INSTALLED → ACTIVATE → ACTIVATING → ACTIVATED",{"_6892":2771,"_42174":2676,"_29767":85845,"_5":21387,"_28235":85590,"_5797":85846},[],"SWU packs, no confirmation",{"_6892":2772,"_42174":2676,"_29767":85848,"_5":21387,"_28235":85590,"_5797":85849},[],"`wfx.workflow.dau.phased.yml`",{"_6892":2773,"_42174":2676,"_29767":85851,"_5":21387,"_28235":85590,"_5797":85852},[],"CREATED → DOWNLOAD → … → ACTIVATED",{"_6892":2774,"_42174":2676,"_29767":85854,"_5":21387,"_28235":85590,"_5797":85855},[],"SWU packs, with confirmation steps",{"_6892":2775,"_42174":2676,"_29767":85857,"_5":21387,"_28235":85590,"_5797":85858},[],"`wfx.workflow.dau.download-install.yml`",{"_6892":2776,"_42174":2676,"_29767":85860,"_5":21387,"_28235":85590,"_5797":85861},[],"DOWNLOAD → DOWNLOADING → DOWNLOADED → INSTALL → INSTALLING → INSTALLED",{"_6892":2777,"_42174":2676,"_29767":85863,"_5":21387,"_28235":85590,"_5797":85864},[],"`non-swu` packs. Select it with `workflow_type`: a launch does not choose it for you",{"_6892":2778,"_42174":2676,"_29767":85866,"_5":21387,"_28235":85590,"_5797":85867},[],"`wfx.workflow.dau.simple.yml`",{"_6892":2779,"_42174":2676,"_29767":85869,"_5":21387,"_28235":85590,"_5797":85870},[],"DOWNLOAD → INSTALL → INSTALLED or TERMINATED",{"_6892":2780,"_42174":2676,"_29767":85872,"_5":21387,"_28235":85590,"_5797":85873},[],"Minimal flow",{"_6892":2781,"_42174":2676,"_29767":85875,"_5":21387,"_28235":85590,"_5797":85876},[],"Every workflow ends in `TERMINATED` on failure. The service registers the four files at startup. `workflow_file` must name the `direct` file, and the other three are looked up next to it by replacing `direct` in the file name (see Configuration). In hawkBit mode there are no WFX jobs: see hawkBit mode.",{"_6892":2782,"_42174":2676,"_29767":85878,"_5":21387,"_28235":85594,"_5797":85879},[],"<Card title=\"Architecture\" description=\"The components and what runs inside the service.\" href=\"/docs/platform/updates/architecture\" />",{"_6892":2783,"_42174":2676,"_29767":85881,"_5":21387,"_28235":85594,"_5797":85882},[],"<Card title=\"Flows\" description=\"Sequence diagrams of every important operation.\" href=\"/docs/platform/updates/flows\" />",{"_6892":2784,"_42174":2676,"_29767":85884,"_5":21387,"_28235":85594,"_5797":85885},[],"<Card title=\"Publish and roll out an update\" description=\"Do it end to end.\" href=\"/docs/platform/updates/guides/publish-and-roll-out\" />",{"_6892":2785,"_42174":2785,"_5":21817,"_5797":85887,"_42654":85888,"_29767":85889,"_28235":2785},"Data model",[77248,78697,85231,83583],[],{"_6892":2786,"_42174":2785,"_29767":85891,"_5":21387,"_28235":2785,"_5797":85892},[],"The tables the service keeps, how they relate, and how the schema is created and migrated.",{"_6892":2787,"_42174":2785,"_5":42651,"_29767":85894,"_28235":85895,"_5797":85896},[],"/docs/pr-preview/pr-56/platform/updates/data-model#native-mode-tables","Native mode tables",{"_6892":2788,"_42174":2785,"_5":42651,"_29767":85898,"_28235":85899,"_5797":85900},[],"/docs/pr-preview/pr-56/platform/updates/data-model#hawkbit-mode-tables","hawkBit mode tables",{"_6892":2789,"_42174":2785,"_5":42651,"_29767":85902,"_28235":85903,"_5797":85904},[],"/docs/pr-preview/pr-56/platform/updates/data-model#entity-relationship-diagrams","Entity-relationship diagrams",{"_6892":2790,"_42174":2785,"_5":42651,"_29767":85906,"_28235":85907,"_5797":85908},[],"/docs/pr-preview/pr-56/platform/updates/data-model#packs-modules-and-artifacts","Packs, modules and artifacts",{"_6892":2791,"_42174":2785,"_5":42651,"_29767":85910,"_28235":85911,"_5797":85912},[],"/docs/pr-preview/pr-56/platform/updates/data-model#launches-and-devices","Launches and devices",{"_6892":2792,"_42174":2785,"_5":42651,"_29767":85914,"_28235":85915,"_5797":85916},[],"/docs/pr-preview/pr-56/platform/updates/data-model#reading-the-diagram","Reading the diagram",{"_6892":2793,"_42174":2785,"_5":42651,"_29767":85918,"_28235":85919,"_5797":85920},[],"/docs/pr-preview/pr-56/platform/updates/data-model#schema-creation-and-migrations","Schema creation and migrations",{"_6892":2794,"_42174":2785,"_5":42651,"_29767":85922,"_28235":85923,"_5797":80372},[],"/docs/pr-preview/pr-56/platform/updates/data-model#next-steps",{"_6892":2795,"_42174":2785,"_29767":85925,"_5":21387,"_28235":2785,"_5797":85926},[],"The tables Lamassu Updates keeps in Postgres, how they relate, and how the schema is created and migrated. This is a reference for operators and integrators who query the database, size it, or plan an upgrade.",{"_6892":2796,"_42174":2785,"_29767":85928,"_5":21387,"_28235":85895,"_5797":85929},[],"Created in Postgres at startup, in the `updates` database. The Go types are in `pkg/models/updates.go` of the ota repository.",{"_6892":2797,"_42174":2785,"_29767":85931,"_5":21387,"_28235":85895,"_5797":85932},[],"Table",{"_6892":2798,"_42174":2785,"_29767":85934,"_5":21387,"_28235":85895,"_5797":85935},[],"Holds",{"_6892":2799,"_42174":2785,"_29767":85937,"_5":21387,"_28235":85895,"_5797":85938},[],"`distribution_set`",{"_6892":2800,"_42174":2785,"_29767":85940,"_5":21387,"_28235":85895,"_5797":85941},[],"An update pack: name, version, group, type, packaging, status, the sw-description (`sw_descriptor`), preconditions, encryption and signature settings, and the per-device build coverage",{"_6892":2801,"_42174":2785,"_29767":85943,"_5":21387,"_28235":85895,"_5797":85944},[],"`distribution_set_version`",{"_6892":2802,"_42174":2785,"_29767":85946,"_5":21387,"_28235":85895,"_5797":85947},[],"A snapshot of each built version, with its signed manifest",{"_6892":2803,"_42174":2785,"_29767":85949,"_5":21387,"_28235":85895,"_5797":85950},[],"`distribution_set_module`",{"_6892":2804,"_42174":2785,"_29767":85952,"_5":21387,"_28235":85895,"_5797":85953},[],"The modules of a pack version, keyed by pack, version, module type and name. It also holds catalog modules that belong to no pack, with an empty pack ID",{"_6892":2805,"_42174":2785,"_29767":85955,"_5":21387,"_28235":85895,"_5797":85635},[],{"_6892":2806,"_42174":2785,"_29767":85957,"_5":21387,"_28235":85895,"_5797":85958},[],"A global artifact: the catalog entry for an uploaded file, unique by name and version",{"_6892":2807,"_42174":2785,"_29767":85960,"_5":21387,"_28235":85895,"_5797":85961},[],"`distribution_set_artifact`",{"_6892":2808,"_42174":2785,"_29767":85963,"_5":21387,"_28235":85895,"_5797":85964},[],"The link between a pack version, an artifact and optionally one module",{"_6892":2809,"_42174":2785,"_29767":85966,"_5":21387,"_28235":85895,"_5797":85967},[],"`launchtrack`",{"_6892":2810,"_42174":2785,"_29767":85969,"_5":21387,"_28235":85895,"_5797":85970},[],"A launch campaign: strategy, status, thresholds and batch bookkeeping",{"_6892":2811,"_42174":2785,"_29767":85972,"_5":21387,"_28235":85895,"_5797":85973},[],"`launch_device_assignments`",{"_6892":2812,"_42174":2785,"_29767":85975,"_5":21387,"_28235":85895,"_5797":85976},[],"Each device's status within a launch: `pending`, `active`, `completed` or `failed`",{"_6892":2813,"_42174":2785,"_29767":85978,"_5":21387,"_28235":85895,"_5797":85979},[],"`device_distribution_set_version`",{"_6892":2814,"_42174":2785,"_29767":85981,"_5":21387,"_28235":85895,"_5797":85982},[],"Which pack version a device currently carries",{"_6892":2815,"_42174":2785,"_29767":85984,"_5":21387,"_28235":85895,"_5797":85985},[],"`device_distribution_set_update`",{"_6892":2816,"_42174":2785,"_29767":85987,"_5":21387,"_28235":85895,"_5797":85988},[],"A device's update history",{"_6892":2817,"_42174":2785,"_29767":85990,"_5":21387,"_28235":85895,"_5797":85991},[],"`latest_distribution_set_version`",{"_6892":2818,"_42174":2785,"_29767":85993,"_5":21387,"_28235":85895,"_5797":85994},[],"The declared latest version per group and pack",{"_6892":2819,"_42174":2785,"_29767":85996,"_5":21387,"_28235":85895,"_5797":85997},[],"`updates_schema_migrations`",{"_6892":2820,"_42174":2785,"_29767":85999,"_5":21387,"_28235":85895,"_5797":86000},[],"One row per data migration that must run only once (the approval-threshold migration)",{"_6892":2821,"_42174":2785,"_29767":86002,"_5":21387,"_28235":85895,"_5797":86003},[],"File bytes (artifacts, builds, keys) are not in Postgres. They live in the blob stores described under Configuration. The sw-description is in Postgres (a column of the pack and of each module).",{"_6892":2822,"_42174":2785,"_29767":86005,"_5":21387,"_28235":85899,"_5797":86006},[],"In hawkBit mode, packs, rollouts and jobs live in hawkBit. This service keeps only the following in the same Postgres (the `updates` database), for the things hawkBit has no equivalent of:",{"_6892":2823,"_42174":2785,"_29767":86008,"_5":21387,"_28235":85899,"_5797":85932},[],{"_6892":2824,"_42174":2785,"_29767":86010,"_5":21387,"_28235":85899,"_5797":85935},[],{"_6892":2825,"_42174":2785,"_29767":86012,"_5":21387,"_28235":85899,"_5797":86013},[],"`hawkbit_staged_artifact`",{"_6892":2826,"_42174":2785,"_29767":86015,"_5":21387,"_28235":85899,"_5797":86016},[],"Bytes from `POST /artifacts`. Uploads older than 30 minutes are discarded the next time anyone uploads an artifact, and stay readable until then. They cannot be linked to a pack in this mode",{"_6892":2827,"_42174":2785,"_29767":86018,"_5":21387,"_28235":85899,"_5797":86019},[],"`hawkbit_artifact_alias`",{"_6892":2828,"_42174":2785,"_29767":86021,"_5":21387,"_28235":85899,"_5797":86022},[],"Read when resolving an artifact ID, but nothing writes it any more",{"_6892":2829,"_42174":2785,"_29767":86024,"_5":21387,"_28235":85899,"_5797":86025},[],"`hawkbit_sw_descriptor_v2`",{"_6892":2830,"_42174":2785,"_29767":86027,"_5":21387,"_28235":85899,"_5797":86028},[],"sw-descriptions, launch preconditions and rollout flags (a general key-value text store, keyed by instance, kind and ID)",{"_6892":2831,"_42174":2785,"_29767":86030,"_5":21387,"_28235":85899,"_5797":86031},[],"`hawkbit_set_manifest_v2`",{"_6892":2832,"_42174":2785,"_29767":86033,"_5":21387,"_28235":85899,"_5797":86034},[],"Signed manifests of built sets",{"_6892":2833,"_42174":2785,"_29767":86036,"_5":21387,"_28235":85899,"_5797":86037},[],"`hawkbit_cancelled_rollout_v2`",{"_6892":2834,"_42174":2785,"_29767":86039,"_5":21387,"_28235":85899,"_5797":86040},[],"Rollouts cancelled through this service",{"_6892":2835,"_42174":2785,"_29767":86042,"_5":21387,"_28235":85899,"_5797":85991},[],{"_6892":2836,"_42174":2785,"_29767":86044,"_5":21387,"_28235":85899,"_5797":86045},[],"Declared latest versions (shared with native mode)",{"_6892":2837,"_42174":2785,"_29767":86047,"_5":21387,"_28235":85899,"_5797":86048},[],"Rows keyed by a hawkBit ID carry an `instance_id`, a marker of the hawkBit data they describe. If hawkBit loses its data and starts again, IDs repeat, and the service stops reading rows written for the old instance. The service re-checks the marker every 30 seconds.",{"_6892":2838,"_42174":2785,"_29767":86050,"_5":21387,"_28235":85899,"_5797":86051},[],"hawkBit keeps its own schema in its own `hawkbit` database. In the Docker Compose stack, `init.sql` creates both databases when the Postgres container first starts.",{"_6892":2839,"_42174":2785,"_29767":86053,"_5":21387,"_28235":85903,"_5797":86054},[],"The native-mode tables, with their main columns. `*_id` columns that point at another table are drawn as the relationship lines. These are logical references: the service creates no database foreign-key constraints, and `FK` only marks which column holds the reference.",{"_6892":2840,"_42174":2785,"_29767":86056,"_5":21387,"_28235":85911,"_5797":86057},[],"Values worth knowing:",{"_6892":2841,"_42174":2785,"_29767":86059,"_5":21387,"_28235":85911,"_5797":86060},[],"`distribution_set.status` is `draft`, `built` or `build_failed`. `packaging` is `swu` or `non-swu`. `encryption_mode` is empty, `shared` or `per-device`.",{"_6892":2842,"_42174":2785,"_29767":86062,"_5":21387,"_28235":85911,"_5797":86063},[],"`launchtrack.status` is `running`, `paused`, `cancelled` or `completed`. A new launch is stored with an empty status, which means running. `aborted` is true for a cancelled launch (operator or error threshold) and stops every rollout path. The precondition outcome of the launch (`forced_preconditions`, `precondition_failures`) is stored on the row, but not the preconditions themselves: those live on the pack.",{"_6892":2843,"_42174":2785,"_29767":86065,"_5":21387,"_28235":85911,"_5797":86066},[],"`rollout_type` is not validated: only the value `percentage` makes `rollout_value` a percentage, and any other value (the dashboard sends `numeric`, the examples use `fixed`) makes it a device count.",{"_6892":2844,"_42174":2785,"_29767":86068,"_5":21387,"_28235":85911,"_5797":86069},[],"`launch_device_assignments.status` is `pending`, `active`, `completed` or `failed`. (`cancelled` also exists as a value, but only hawkBit mode reports it, for a canary whose launch was cancelled; it is never stored.)",{"_6892":2845,"_42174":2785,"_29767":86071,"_5":21387,"_28235":85911,"_5797":86072},[],"`device_distribution_set_update.status` is `pending`, `running`, `success` or `failed` (hawkBit mode can also report `cancelled`), and its `source` is `service`.",{"_6892":2846,"_42174":2785,"_29767":86074,"_5":21387,"_28235":85911,"_5797":86075},[],"`distribution_set_module` is unique by pack, pack version, type and name. A standalone catalog module has an empty `distribution_set_id`, and its `distribution_set_version` equals its own `version`.",{"_6892":2847,"_42174":2785,"_29767":86077,"_5":21387,"_28235":85911,"_5797":86078},[],"`distribution_set_version` is unique by pack and version, and `distribution_set_artifact` by pack, version and artifact.",{"_6892":2848,"_42174":2785,"_29767":86080,"_5":21387,"_28235":85911,"_5797":86081},[],"Not drawn: `updates_schema_migrations`, a marker table the start-up data migrations use, and the hawkBit-mode tables listed above.",{"_6892":2849,"_42174":2785,"_29767":86083,"_5":21387,"_28235":85915,"_5797":86084},[],"A **pack** (`distribution_set`) is one row that moves through versions. Each built version is snapshotted into `distribution_set_version`, with its signed manifest.",{"_6892":2850,"_42174":2785,"_29767":86086,"_5":21387,"_28235":85915,"_5797":86087},[],"**Modules** and **artifacts** are separate: an artifact is a file in the global catalog, and `distribution_set_artifact` links it to a pack version (and optionally to one module). A module whose `distribution_set_id` is empty is a catalog module that no pack holds yet.",{"_6892":2851,"_42174":2785,"_29767":86089,"_5":21387,"_28235":85915,"_5797":86090},[],"A **launch** (`launchtrack`) targets a group through one assignment row per device. The assignment moves `pending` → `active` → `completed` or `failed`, and `batch_index` records which batch dispatched it.",{"_6892":2852,"_42174":2785,"_29767":86092,"_5":21387,"_28235":85915,"_5797":86093},[],"Two device tables answer different questions. `device_distribution_set_version` is what a device carries **now**. `device_distribution_set_update` is the **history** of attempts, with `version_from` and `version_to`.",{"_6892":2853,"_42174":2785,"_29767":86095,"_5":21387,"_28235":85915,"_5797":86096},[],"`latest_distribution_set_version` is the version an operator declared devices of a group should be on, used for drift and compliance.",{"_6892":2854,"_42174":2785,"_29767":86098,"_5":21387,"_28235":85919,"_5797":86099},[],"There are no migration files. In native mode the service creates and upgrades its own schema when it starts, holding a Postgres lock so that replicas starting together do not race. It runs these steps in order (hawkBit mode only creates its six tables):",{"_6892":2855,"_42174":2785,"_29767":86101,"_5":21387,"_28235":85919,"_5797":86102},[],"**Rename step** (`MigrateDistributionSetNaming`). Databases created before the \"update pack\" → \"distribution set\" rename have their tables and columns renamed. It runs before step 2 so that the new tables are not created empty beside the old ones.",{"_6892":2856,"_42174":2785,"_29767":86104,"_5":21387,"_28235":85919,"_5797":86105},[],"**Create and add** (GORM `AutoMigrate`). Missing tables and columns are created. It never drops or renames anything.",{"_6892":2857,"_42174":2785,"_29767":86107,"_5":21387,"_28235":85919,"_5797":86108},[],"**Data migrations.** Standalone modules (`software_module_definition` rows move into the module and artifact tables, keeping IDs and files, and the old table is dropped), device assignments (rebuilt from the legacy launch columns), and approval-threshold semantics.",{"_6892":2858,"_42174":2785,"_29767":86110,"_5":21387,"_28235":85919,"_5797":86111},[],"Most steps check the current schema instead of a version number, and the approval-threshold migration records a row in `updates_schema_migrations` so it runs only once. Repeated starts are safe, and a new database has nothing to migrate. After the schema steps the service also copies binaries from the legacy pack-scoped layout on disk into the artifact store, skipping any that are already there.",{"_6892":2859,"_42174":2785,"_29767":86113,"_5":21387,"_28235":85919,"_5797":86114},[],"`init.sql` is a Docker Compose seed: it creates the `updates` and `hawkbit` databases and still contains older table definitions, so do not use it to define the schema yourself.",{"_6892":2860,"_42174":2785,"_29767":86116,"_5":21387,"_28235":85919,"_5797":86117},[],"See Operations for what to do before upgrading.",{"_6892":2861,"_42174":2785,"_29767":86119,"_5":21387,"_28235":85923,"_5797":86120},[],"<Card title=\"Configuration\" description=\"Blob stores, storage and every config field.\" href=\"/docs/platform/updates/reference/configuration\" />",{"_6892":2862,"_42174":2785,"_29767":86122,"_5":21387,"_28235":85923,"_5797":86123},[],"<Card title=\"Operations\" description=\"Back up, scale and upgrade the database.\" href=\"/docs/platform/updates/operations\" />",{"_6892":2863,"_42174":2863,"_5":21817,"_5797":86125,"_42654":86126,"_29767":86127,"_28235":2863},"Flows",[77248,78697,85231,83583],[],{"_6892":2864,"_42174":2863,"_29767":86129,"_5":21387,"_28235":2863,"_5797":86130},[],"Sequence diagrams of the important operations, for the native and hawkBit backends.",{"_6892":2865,"_42174":2863,"_5":42651,"_29767":86132,"_28235":86133,"_5797":85239},[],"/docs/pr-preview/pr-56/platform/updates/flows#native-mode",{"_6892":2866,"_42174":2863,"_5":42651,"_29767":86135,"_28235":86136,"_5797":86137},[],"/docs/pr-preview/pr-56/platform/updates/flows#1-publish-and-build-a-pack","1\\. Publish and build a pack",{"_6892":2867,"_42174":2863,"_5":42651,"_29767":86139,"_28235":86140,"_5797":86141},[],"/docs/pr-preview/pr-56/platform/updates/flows#2-create-a-launch","2\\. Create a launch",{"_6892":2868,"_42174":2863,"_5":42651,"_29767":86143,"_28235":86144,"_5797":86145},[],"/docs/pr-preview/pr-56/platform/updates/flows#3-roll-out-a-batch-and-update-a-device","3\\. Roll out a batch and update a device",{"_6892":2869,"_42174":2863,"_5":42651,"_29767":86147,"_28235":86148,"_5797":86149},[],"/docs/pr-preview/pr-56/platform/updates/flows#4-react-to-a-device-finishing","4\\. React to a device finishing",{"_6892":2870,"_42174":2863,"_5":42651,"_29767":86151,"_28235":86152,"_5797":86153},[],"/docs/pr-preview/pr-56/platform/updates/flows#5-build-a-per-device-encrypted-pack","5\\. Build a per-device encrypted pack",{"_6892":2871,"_42174":2863,"_5":42651,"_29767":86155,"_28235":86156,"_5797":85247},[],"/docs/pr-preview/pr-56/platform/updates/flows#hawkbit-mode",{"_6892":2872,"_42174":2863,"_5":42651,"_29767":86158,"_28235":86159,"_5797":86160},[],"/docs/pr-preview/pr-56/platform/updates/flows#6-build-a-module-and-create-a-pack","6\\. Build a module and create a pack",{"_6892":2873,"_42174":2863,"_5":42651,"_29767":86162,"_28235":86163,"_5797":86164},[],"/docs/pr-preview/pr-56/platform/updates/flows#7-launch-and-device-update","7\\. Launch and device update",{"_6892":2874,"_42174":2863,"_5":42651,"_29767":86166,"_28235":86167,"_5797":80372},[],"/docs/pr-preview/pr-56/platform/updates/flows#next-steps",{"_6892":2875,"_42174":2863,"_29767":86169,"_5":21387,"_28235":2863,"_5797":86170},[],"These diagrams follow what the service does, step by step. Routes are relative to `/updates/v1`. For runnable commands see the native and hawkBit curl guides, and the API reference for every route and body.",{"_6892":2876,"_42174":2863,"_29767":86172,"_5":21387,"_28235":86136,"_5797":86173},[],"Building turns the uploaded artifacts and the sw-description into one `.swu`. Nothing is signed or encrypted unless the build request asks for it.",{"_6892":2877,"_42174":2863,"_29767":86175,"_5":21387,"_28235":86136,"_5797":86176},[],"Things to know about the build:",{"_6892":2878,"_42174":2863,"_29767":86178,"_5":21387,"_28235":86136,"_5797":86179},[],"The pack is created with a name, a semantic `version`, a `group_id`, a `type` and an optional `packaging`. A duplicate name in the group is a `409`.",{"_6892":2879,"_42174":2863,"_29767":86181,"_5":21387,"_28235":86136,"_5797":86182},[],"Uploading an artifact (or a prebuilt deliverable) to a version that is already built is refused with `409`: create a new version first. A build or change that collides with another one on the same pack answers `409` too.",{"_6892":2880,"_42174":2863,"_29767":86184,"_5":21387,"_28235":86136,"_5797":86185},[],"A file larger than `max_artifact_size_mb` (10240 MiB by default) is refused with `413`.",{"_6892":2881,"_42174":2863,"_29767":86187,"_5":21387,"_28235":86136,"_5797":86188},[],"Encryption is chosen by the build body: `user` plus `encryption_key_name` is shared-key encryption, and `encryption_alg_name` alone is per-device encryption (flow 5).",{"_6892":2882,"_42174":2863,"_29767":86190,"_5":21387,"_28235":86136,"_5797":86191},[],"If the build fails, the pack becomes `build_failed`, `last_build_error` says why, and the pack stays editable. The selected artifacts replace the pack version's earlier artifact links.",{"_6892":2883,"_42174":2863,"_29767":86193,"_5":21387,"_28235":86136,"_5797":86194},[],"Without signing fields the manifest is stored unsigned. If a signing key is given but no certificate, the build fails instead.",{"_6892":2884,"_42174":2863,"_29767":86196,"_5":21387,"_28235":86136,"_5797":86197},[],"A `non-swu` pack is built with `POST .../package` into a `.tar.gz`, and a deliverable built elsewhere is attached with `POST .../swu/upload` or `.../package/upload`.",{"_6892":2885,"_42174":2863,"_29767":86199,"_5":21387,"_28235":86140,"_5797":86200},[],"Creating a launch decides who is targeted, and checks the pack is deliverable. Nothing is sent to a device yet.",{"_6892":2886,"_42174":2863,"_29767":86202,"_5":21387,"_28235":86140,"_5797":86203},[],"`?dry_run=true` stops after the precondition check and answers `200` with `qualifying_devices`, `precondition_failures`, `superseded_devices` and `never_seen_devices`. `force_preconditions` targets every device of the group and still records who failed. `distribution_set_name`, `workflow_type` and `rollout_type` are required, and so is a `rollout_value` above zero. `approval_threshold` and `error_threshold` must be between 0 and 100, and each violation is a `400`. A launch can also carry `auto`, `scheduled_at`, `name`, `description` and `weight` (see Concepts).",{"_6892":2887,"_42174":2863,"_29767":86205,"_5":21387,"_28235":86144,"_5797":86206},[],"One `rollout` call sends the next batch. The canary goes alone first, then batches of the configured size, chosen at random from the devices still pending. The device side below is the `direct` workflow, where a job starts in `INSTALL`.",{"_6892":2888,"_42174":2863,"_29767":86208,"_5":21387,"_28235":86144,"_5797":86209},[],"With the `phased` workflow a job starts in `CREATED`, and some transitions need a person or system to confirm them in WFX. This service does not advance them. The `download-install` workflow, used by `non-swu` packs, runs `DOWNLOAD → DOWNLOADING → DOWNLOADED → INSTALL → INSTALLING → INSTALLED`.",{"_6892":2889,"_42174":2863,"_29767":86211,"_5":21387,"_28235":86144,"_5797":86212},[],"With `auto` on, one `rollout` call starts the launch and the following batches are released by flow 4. A launch with `scheduled_at` is started by the scheduled-launch trigger on the leader replica once that time passes.",{"_6892":2890,"_42174":2863,"_29767":86214,"_5":21387,"_28235":86144,"_5797":86215},[],"The `rollout` call is not always a plain `200`:",{"_6892":2891,"_42174":2863,"_29767":86217,"_5":21387,"_28235":86144,"_5797":86218},[],"It is refused with `400` when the launch is paused, cancelled, completed or aborted, and on an `auto` launch once any batch has gone out.",{"_6892":2892,"_42174":2863,"_29767":86220,"_5":21387,"_28235":86144,"_5797":86221},[],"It does nothing and answers `200` while `scheduled_at` is still in the future, and while the canary is still active. It returns an error if the canary failed.",{"_6892":2893,"_42174":2863,"_29767":86223,"_5":21387,"_28235":86144,"_5797":86224},[],"If some jobs cannot be created, those devices stay `pending` and the call returns a \"partial rollout\" error (`500`).",{"_6892":2894,"_42174":2863,"_29767":86226,"_5":21387,"_28235":86148,"_5797":86227},[],"Every state change WFX reports runs the same logic. This is what makes automatic batching, the canary gate and the error threshold work.",{"_6892":2895,"_42174":2863,"_29767":86229,"_5":21387,"_28235":86148,"_5797":86230},[],"On **every** event the service updates the device's update history and writes the event to the device's metadata in Lamassu. Then, only if the state is a terminal one of the workflow, it runs these checks in order, and the first one that applies decides what happens:",{"_6892":2896,"_42174":2863,"_29767":86232,"_5":21387,"_28235":86148,"_5797":86233},[],"#",{"_6892":2897,"_42174":2863,"_29767":86235,"_5":21387,"_28235":86148,"_5797":82342},[],{"_6892":2898,"_42174":2863,"_29767":86237,"_5":21387,"_28235":86148,"_5797":86238},[],"If it applies",{"_6892":2899,"_42174":2863,"_29767":86240,"_5":21387,"_28235":86148,"_5797":7036},[],{"_6892":2900,"_42174":2863,"_29767":86242,"_5":21387,"_28235":86148,"_5797":86243},[],"Is the state terminal in the workflow?",{"_6892":2901,"_42174":2863,"_29767":86245,"_5":21387,"_28235":86148,"_5797":86246},[],"If not, nothing more happens",{"_6892":2902,"_42174":2863,"_29767":86248,"_5":21387,"_28235":86148,"_5797":7050},[],{"_6892":2903,"_42174":2863,"_29767":86250,"_5":21387,"_28235":86148,"_5797":86251},[],"(always)",{"_6892":2904,"_42174":2863,"_29767":86253,"_5":21387,"_28235":86148,"_5797":86254},[],"Mark the device's assignment `completed` or `failed`. On success, record the installed version",{"_6892":2905,"_42174":2863,"_29767":86256,"_5":21387,"_28235":86148,"_5797":7056},[],{"_6892":2906,"_42174":2863,"_29767":86258,"_5":21387,"_28235":86148,"_5797":86259},[],"Did the canary device fail?",{"_6892":2907,"_42174":2863,"_29767":86261,"_5":21387,"_28235":86148,"_5797":86262},[],"Pause the launch. Resume to retry",{"_6892":2908,"_42174":2863,"_29767":86264,"_5":21387,"_28235":86148,"_5797":7043},[],{"_6892":2909,"_42174":2863,"_29767":86266,"_5":21387,"_28235":86148,"_5797":86267},[],"Is the launch paused, cancelled or completed?",{"_6892":2910,"_42174":2863,"_29767":86269,"_5":21387,"_28235":86148,"_5797":86270},[],"Stop: no further batches",{"_6892":2911,"_42174":2863,"_29767":86272,"_5":21387,"_28235":86148,"_5797":16513},[],{"_6892":2912,"_42174":2863,"_29767":86274,"_5":21387,"_28235":86148,"_5797":86275},[],"Is `error_threshold` set, and have failures reached that share of all devices (rounded up)?",{"_6892":2913,"_42174":2863,"_29767":86277,"_5":21387,"_28235":86148,"_5797":86278},[],"Cancel the launch. Pending devices are not sent",{"_6892":2914,"_42174":2863,"_29767":86280,"_5":21387,"_28235":86148,"_5797":28242},[],{"_6892":2915,"_42174":2863,"_29767":86282,"_5":21387,"_28235":86148,"_5797":86283},[],"Is nothing pending and nothing active?",{"_6892":2916,"_42174":2863,"_29767":86285,"_5":21387,"_28235":86148,"_5797":86286},[],"Mark the launch `completed`",{"_6892":2917,"_42174":2863,"_29767":86288,"_5":21387,"_28235":86148,"_5797":21503},[],{"_6892":2918,"_42174":2863,"_29767":86290,"_5":21387,"_28235":86148,"_5797":86291},[],"Is `auto` off, or is nothing left to send?",{"_6892":2919,"_42174":2863,"_29767":86293,"_5":21387,"_28235":86148,"_5797":86294},[],"Wait for the operator's next `rollout` call, or for the devices still in flight",{"_6892":2920,"_42174":2863,"_29767":86296,"_5":21387,"_28235":86148,"_5797":13924},[],{"_6892":2921,"_42174":2863,"_29767":86298,"_5":21387,"_28235":86148,"_5797":86299},[],"Did at least `approval_threshold` of this batch succeed? (0 or 100 or more means all of it)",{"_6892":2922,"_42174":2863,"_29767":86301,"_5":21387,"_28235":86148,"_5797":86302},[],"Dispatch the next batch. Otherwise wait for more results",{"_6892":2923,"_42174":2863,"_29767":86304,"_5":21387,"_28235":86148,"_5797":86305},[],"Only devices dispatched in the current batch count toward its approval: a straggler from an earlier batch never does. The checks move the launch between these states:",{"_6892":2924,"_42174":2863,"_29767":86307,"_5":21387,"_28235":86148,"_5797":86308},[],"A new launch is stored with an empty status, which means `running`. Resuming after a failed canary re-queues the canary so it is tried again. Cancelling stops further batches but does not recall jobs that are already running on devices.",{"_6892":2925,"_42174":2863,"_29767":86310,"_5":21387,"_28235":86152,"_5797":86311},[],"Each device gets its own package, encrypted with its own key. The build first resolves every device's key, then builds. A device without a key is skipped, and a launch on a pack with skipped devices is refused.",{"_6892":2926,"_42174":2863,"_29767":86313,"_5":21387,"_28235":86152,"_5797":86314},[],"`uncovered_devices` lists devices without a key and also devices whose own build failed. A build where no device got a package leaves the pack `build_failed`.",{"_6892":2927,"_42174":2863,"_29767":86316,"_5":21387,"_28235":86159,"_5797":86317},[],"hawkBit itself has no notion of a built module, and this service links only built modules into a hawkBit distribution set. A set is never built directly: `POST .../swu` and `.../package` answer `501` in this mode. The module is built first, in the catalog, and the pack is created from it. The diagram shows the `swu-build` intent.",{"_6892":2928,"_42174":2863,"_29767":86319,"_5":21387,"_28235":86159,"_5797":86320},[],"The other delivery intents skip steps: `swu-prebuilt` only uploads the finished `.swu`, which is what builds the module, and `raw` only encrypts or signs the files, with no swugenerator and no sw-description (signing adds a `.sha256` checksum document and its detached signature as extra artifacts). A build can sign through the KMS and encrypt with a shared SymKMS key. Per-device encryption is refused in hawkBit mode. A linked module is frozen: to change it, edit and build it in the catalog, then link it again.",{"_6892":2929,"_42174":2863,"_29767":86322,"_5":21387,"_28235":86163,"_5797":86323},[],"The device talks to hawkBit, not to this service. The service reads progress back from hawkBit whenever it is asked.",{"_6892":2930,"_42174":2863,"_29767":86325,"_5":21387,"_28235":86163,"_5797":86326},[],"A canary group exists only when `test_device_id` is given. hawkBit decides when a group succeeds and the next group starts, using the approval and error thresholds the service gave it. With `auto` off, hawkBit pauses after each group and the next `rollout` call releases the following one. The launch response also lists `superseded_devices` (devices whose in-flight update the new rollout replaces) and `never_seen_devices` (devices that have never polled, which can stall a group that must reach its success threshold).",{"_6892":2931,"_42174":2863,"_29767":86328,"_5":21387,"_28235":86163,"_5797":86329},[],"The `rollout` call depends on the rollout's state:",{"_6892":2932,"_42174":2863,"_29767":86331,"_5":21387,"_28235":86163,"_5797":86332},[],"A `ready` rollout is started, and nothing happens while its start time is in the future.",{"_6892":2933,"_42174":2863,"_29767":86334,"_5":21387,"_28235":86163,"_5797":86335},[],"A paused rollout is resumed only if it is paused between batches. An operator pause needs `resume`, and a rollout stopped by its error threshold cannot be resumed.",{"_6892":2934,"_42174":2863,"_29767":86337,"_5":21387,"_28235":86163,"_5797":86338},[],"A running manual rollout releases its next group.",{"_6892":2935,"_42174":2863,"_29767":86340,"_5":21387,"_28235":86163,"_5797":86341},[],"An `auto` rollout that is already running is refused with `400`.",{"_6892":2936,"_42174":2863,"_29767":86343,"_5":21387,"_28235":86163,"_5797":86344},[],"A second `rollout` on the same launch while one is in progress answers `409`.",{"_6892":2937,"_42174":2863,"_29767":86346,"_5":21387,"_28235":86163,"_5797":86347},[],"Device authentication is a hawkBit tenant setting. Target security tokens are off by default. See Connect a device.",{"_6892":2938,"_42174":2863,"_29767":86349,"_5":21387,"_28235":86167,"_5797":86350},[],"<Card title=\"Publish and roll out an update\" description=\"Run flows 1 to 4 end to end.\" href=\"/docs/platform/updates/guides/publish-and-roll-out\" />",{"_6892":2939,"_42174":2863,"_29767":86352,"_5":21387,"_28235":86167,"_5797":86353},[],"<Card title=\"Data model\" description=\"The tables behind these flows.\" href=\"/docs/platform/updates/data-model\" />",{"_6892":2940,"_42174":2863,"_29767":86355,"_5":21387,"_28235":86167,"_5797":86356},[],"<Card title=\"Signing and encryption\" description=\"Keys, signatures and the manifest.\" href=\"/docs/platform/updates/signing-and-encryption\" />",{"_6892":2941,"_42174":2941,"_5":21817,"_5797":86358,"_42654":86359,"_29767":86361,"_28235":2941},"Get started with Lamassu Updates",[77248,78697,85231,86360],"Get started",[],{"_6892":2942,"_42174":2941,"_29767":86363,"_5":21387,"_28235":2941,"_5797":86364},[],"Run Lamassu Updates and its dependencies locally with Docker Compose and check that the API answers.",{"_6892":2943,"_42174":2941,"_5":42651,"_29767":86366,"_28235":86367,"_5797":77258},[],"/docs/pr-preview/pr-56/platform/updates/getting-started#before-you-begin",{"_6892":2944,"_42174":2941,"_5":42651,"_29767":86369,"_28235":86370,"_5797":86371},[],"/docs/pr-preview/pr-56/platform/updates/getting-started#start-the-stack","Start the stack",{"_6892":2945,"_42174":2941,"_5":42651,"_29767":86373,"_28235":86374,"_5797":86375},[],"/docs/pr-preview/pr-56/platform/updates/getting-started#clone-the-repository","Clone the repository",{"_6892":2946,"_42174":2941,"_5":42651,"_29767":86377,"_28235":86378,"_5797":86379},[],"/docs/pr-preview/pr-56/platform/updates/getting-started#set-the-host-address","Set the host address",{"_6892":2947,"_42174":2941,"_5":42651,"_29767":86381,"_28235":86382,"_5797":86383},[],"/docs/pr-preview/pr-56/platform/updates/getting-started#create-the-network-and-start","Create the network and start",{"_6892":2948,"_42174":2941,"_5":42651,"_29767":86385,"_28235":86386,"_5797":86387},[],"/docs/pr-preview/pr-56/platform/updates/getting-started#services","Services",{"_6892":2949,"_42174":2941,"_5":42651,"_29767":86389,"_28235":86390,"_5797":86391},[],"/docs/pr-preview/pr-56/platform/updates/getting-started#verify-the-api","Verify the API",{"_6892":2950,"_42174":2941,"_5":42651,"_29767":86393,"_28235":86394,"_5797":86395},[],"/docs/pr-preview/pr-56/platform/updates/getting-started#run-without-docker","Run without Docker",{"_6892":2951,"_42174":2941,"_5":42651,"_29767":86397,"_28235":86398,"_5797":86399},[],"/docs/pr-preview/pr-56/platform/updates/getting-started#try-hawkbit-mode","Try hawkBit mode",{"_6892":2952,"_42174":2941,"_5":42651,"_29767":86401,"_28235":86402,"_5797":81275},[],"/docs/pr-preview/pr-56/platform/updates/getting-started#troubleshooting",{"_6892":2953,"_42174":2941,"_5":42651,"_29767":86404,"_28235":86405,"_5797":80372},[],"/docs/pr-preview/pr-56/platform/updates/getting-started#next-steps",{"_6892":2954,"_42174":2941,"_29767":86407,"_5":21387,"_28235":2941,"_5797":86408},[],"This guide starts Lamassu Updates (the OTA Update Service) with Docker Compose, in its default native mode, and checks that the API answers. It takes about ten minutes plus the image build. When it works, continue with Publish and roll out an update.",{"_6892":2955,"_42174":2941,"_29767":86410,"_5":21387,"_28235":86367,"_5797":86411},[],"Docker with the Compose plugin.",{"_6892":2956,"_42174":2941,"_29767":86413,"_5":21387,"_28235":86367,"_5797":86414},[],"A running Lamassu IoT instance that the containers can reach. The service reads device groups and their devices from its Device Manager (`dms_endpoint`), and signs with its KMS (`kms_endpoint`) only when you ask for signed builds.",{"_6892":2957,"_42174":2941,"_29767":86416,"_5":21387,"_28235":86367,"_5797":86417},[],"A checkout of the `ota` repository with the Lamassu `core` and `sdk` modules next to it. `go.mod` replaces `lamassuiot/core` and `lamassuiot/sdk` with local paths, and the Docker build copies them from the **parent directory** of the checkout (`context: ..` in `docker-compose.yml`), so that directory must contain both `ota/` and `lamassuiot/`.",{"_6892":2958,"_42174":2941,"_29767":86419,"_5":21387,"_28235":86367,"_5797":86420},[],"Access to the `ghcr.io/lamassuiot/wfx:otaq` image, which the `custom-wfx` service uses.",{"_6892":2959,"_42174":2941,"_29767":86422,"_5":21387,"_28235":86367,"_5797":86423},[],"Optional, for hawkBit mode: a hawkBit server. Compose builds one from `docker/hawkbit`: hawkBit 1.1.0 plus an S3 artifact plugin, tagged `lamassu/hawkbit-update-server:1.1.0-s3` locally. That image is built locally and not published.",{"_6892":2960,"_42174":2941,"_29767":86425,"_5":21387,"_28235":86367,"_5797":86426},[],"Optional, to run the service outside Docker: Go 1.26.2 or newer, and Python 3.8 or newer with the `swugenerator` requirements installed. The Docker image already contains the compiled binary and Python with `swugenerator`.",{"_6892":2961,"_42174":2941,"_29767":86428,"_5":21387,"_28235":86378,"_5797":86429},[],"The `updates` container reaches Lamassu through `host.docker.internal`, which `docker-compose.yml` overrides with `HOST_IP`. On WSL2 the default `host.docker.internal` points at the Docker Desktop gateway, not at the WSL host, so set your own address:",{"_6892":2962,"_42174":2941,"_29767":86431,"_5":21387,"_28235":86378,"_5797":86432},[],"Then check that `dms_endpoint` and `kms_endpoint` in `config-docker.yml` point at your Lamassu API (they default to `http://host.docker.internal:8080/api/...`).",{"_6892":2963,"_42174":2941,"_29767":86434,"_5":21387,"_28235":86382,"_5797":86435},[],"`docker-compose.yml` attaches to an existing network named `ota-net` and refuses to start without it.",{"_6892":2964,"_42174":2941,"_29767":86437,"_5":21387,"_28235":86386,"_5797":86438},[],"Service",{"_6892":2965,"_42174":2941,"_29767":86440,"_5":21387,"_28235":86386,"_5797":86441},[],"Host port",{"_6892":2966,"_42174":2941,"_29767":86443,"_5":21387,"_28235":86386,"_5797":86444},[],"What it is",{"_6892":2967,"_42174":2941,"_29767":86446,"_5":21387,"_28235":86386,"_5797":86447},[],"`updates`",{"_6892":2968,"_42174":2941,"_29767":86449,"_5":21387,"_28235":86386,"_5797":86450},[],"`10090`",{"_6892":2969,"_42174":2941,"_29767":86452,"_5":21387,"_28235":86386,"_5797":86453},[],"The Updates API, with SymKMS embedded",{"_6892":2970,"_42174":2941,"_29767":86455,"_5":21387,"_28235":86386,"_5797":86456},[],"`custom-wfx`",{"_6892":2971,"_42174":2941,"_29767":86458,"_5":21387,"_28235":86386,"_5797":86459},[],"`9080` (client), `9081` (management)",{"_6892":2972,"_42174":2941,"_29767":86461,"_5":21387,"_28235":86386,"_5797":86462},[],"WFX, the job server that devices poll in native mode",{"_6892":2973,"_42174":2941,"_29767":86464,"_5":21387,"_28235":86386,"_5797":86465},[],"`postgres`",{"_6892":2974,"_42174":2941,"_29767":86467,"_5":21387,"_28235":86386,"_5797":86468},[],"`5000` (container `5432`)",{"_6892":2975,"_42174":2941,"_29767":86470,"_5":21387,"_28235":86386,"_5797":86471},[],"Database. `init.sql` creates the `updates` and `hawkbit` databases on first start",{"_6892":2976,"_42174":2941,"_29767":86473,"_5":21387,"_28235":86386,"_5797":86474},[],"`swupdate-device1`",{"_6892":2977,"_42174":2941,"_29767":86476,"_5":21387,"_28235":86386,"_5797":77705},[],{"_6892":2978,"_42174":2941,"_29767":86478,"_5":21387,"_28235":86386,"_5797":86479},[],"A sample SWUpdate device client",{"_6892":2979,"_42174":2941,"_29767":86481,"_5":21387,"_28235":86386,"_5797":86482},[],"`hawkbit`",{"_6892":2980,"_42174":2941,"_29767":86484,"_5":21387,"_28235":86386,"_5797":86485},[],"`8090`",{"_6892":2981,"_42174":2941,"_29767":86487,"_5":21387,"_28235":86386,"_5797":86488},[],"hawkBit server, only for hawkBit mode",{"_6892":2982,"_42174":2941,"_29767":86490,"_5":21387,"_28235":86386,"_5797":86491},[],"`rustfs`",{"_6892":2983,"_42174":2941,"_29767":86493,"_5":21387,"_28235":86386,"_5797":86494},[],"`9000` (S3), `9001` (console)",{"_6892":2984,"_42174":2941,"_29767":86496,"_5":21387,"_28235":86386,"_5797":86497},[],"Local S3 store, only with `--profile s3`",{"_6892":2985,"_42174":2941,"_29767":86499,"_5":21387,"_28235":86386,"_5797":86500},[],"`docker compose --profile s3 up -d` also starts `rustfs` and `s3-init`, which creates the encrypted bucket `ota-updates` that artifacts, builds and hawkBit's artifact storage can use. Without that profile, and with `config-docker.yml`, artifacts and builds stay on the `update_files` volume.",{"_6892":2986,"_42174":2941,"_29767":86502,"_5":21387,"_28235":86390,"_5797":86503},[],"The second call reports the active backend and what it supports. In native mode it looks like this (shortened):",{"_6892":2987,"_42174":2941,"_29767":86505,"_5":21387,"_28235":86390,"_5797":86506},[],"`supported` has one entry for each of the 22 capabilities. See Capabilities for what each one means.",{"_6892":2988,"_42174":2941,"_29767":86508,"_5":21387,"_28235":86394,"_5797":86509},[],"Start the monolithic entry point with a config file. It runs the Updates API and SymKMS together.",{"_6892":2989,"_42174":2941,"_29767":86511,"_5":21387,"_28235":86394,"_5797":86512},[],"If `OTA_CONFIG_FILE` is not set, the service reads `/etc/lamassuiot/config.yml`.",{"_6892":2990,"_42174":2941,"_29767":86514,"_5":21387,"_28235":86394,"_5797":86515},[],"To build `.swu` files outside Docker, install `swugenerator` into the Python environment that the config points at (the image does the same from `swugenerator/requirements.txt`):",{"_6892":2991,"_42174":2941,"_29767":86517,"_5":21387,"_28235":86394,"_5797":86518},[],"The `config.yml` at the repository root is a starting point for local development, not a ready-made file:",{"_6892":2992,"_42174":2941,"_29767":86520,"_5":21387,"_28235":86394,"_5797":86521},[],"It needs Postgres (`localhost:5000`) and the WFX management API (`localhost:9081`), which `docker compose up -d postgres custom-wfx` provides.",{"_6892":2993,"_42174":2941,"_29767":86523,"_5":21387,"_28235":86394,"_5797":86524},[],"It contains values for one developer machine: absolute `/home/alvaro/...` paths for artifact and SymKMS storage, the signer script and `swugenerator`, and a LAN IP for the Lamassu endpoints. Edit them to paths the service user can create; the service stops at start-up if it cannot create its directories.",{"_6892":2994,"_42174":2941,"_29767":86526,"_5":21387,"_28235":86394,"_5797":86527},[],"It stores artifacts and build outputs in the local RustFS bucket (`docker compose --profile s3 up -d`). To use local disk instead, remove the `artifacts:` and `builds:` blocks; when they are absent, artifacts default to `{update_files_base_dir}/artifacts`.",{"_6892":2995,"_42174":2941,"_29767":86529,"_5":21387,"_28235":86398,"_5797":86530},[],"hawkBit mode serves the same API on top of a real hawkBit server. Start hawkBit and Postgres, wait until hawkBit answers, then start the service with the hawkBit config:",{"_6892":2996,"_42174":2941,"_29767":86532,"_5":21387,"_28235":86398,"_5797":86533},[],"`config-hawkbit.yml` also contains developer-machine paths, in the SWU build settings. A service pointed at a hawkBit with no registered devices builds and launches normally, but nothing downloads the update, because in hawkBit mode devices poll hawkBit directly. Read hawkBit mode before using it.",{"_6892":2997,"_42174":2941,"_29767":86535,"_5":21387,"_28235":86402,"_5797":84046},[],{"_6892":2998,"_42174":2941,"_29767":86537,"_5":21387,"_28235":86402,"_5797":86538},[],"Likely cause",{"_6892":2999,"_42174":2941,"_29767":86540,"_5":21387,"_28235":86402,"_5797":86541},[],"`docker compose up` fails on the network",{"_6892":3000,"_42174":2941,"_29767":86543,"_5":21387,"_28235":86402,"_5797":86544},[],"`ota-net` does not exist. Run `docker network create ota-net`",{"_6892":3001,"_42174":2941,"_29767":86546,"_5":21387,"_28235":86402,"_5797":86547},[],"The `updates` container cannot reach Lamassu",{"_6892":3002,"_42174":2941,"_29767":86549,"_5":21387,"_28235":86402,"_5797":86550},[],"`HOST_IP` is empty in `.env`, or `dms_endpoint` in `config-docker.yml` points at an address the container cannot reach",{"_6892":3003,"_42174":2941,"_29767":86552,"_5":21387,"_28235":86402,"_5797":86553},[],"`docker compose up --build` fails while copying `lamassuiot/core`",{"_6892":3004,"_42174":2941,"_29767":86555,"_5":21387,"_28235":86402,"_5797":86556},[],"The build context (the parent of `ota/`) does not contain `lamassuiot/`",{"_6892":3005,"_42174":2941,"_29767":86558,"_5":21387,"_28235":86402,"_5797":86559},[],"The service exits at start-up when run on the host",{"_6892":3006,"_42174":2941,"_29767":86561,"_5":21387,"_28235":86402,"_5797":86562},[],"A directory in the config (`update_files_base_dir`, `sym_keys_dir`) cannot be created, or Postgres or WFX is not reachable at the addresses in the file",{"_6892":3007,"_42174":2941,"_29767":86564,"_5":21387,"_28235":86402,"_5797":86565},[],"`capabilities` answers but device groups fail with a Device Manager error",{"_6892":3008,"_42174":2941,"_29767":86567,"_5":21387,"_28235":86402,"_5797":86568},[],"`dms_endpoint` is wrong. The Updates API reads every group's devices from it",{"_6892":3009,"_42174":2941,"_29767":86570,"_5":21387,"_28235":86405,"_5797":86571},[],"<Card title=\"Publish and roll out an update\" href=\"/docs/platform/updates/guides/publish-and-roll-out\" description=\"Create a pack, build it and roll it out to a device group.\" />",{"_6892":3010,"_42174":2941,"_29767":86573,"_5":21387,"_28235":86405,"_5797":86574},[],"<Card title=\"Connect a device\" href=\"/docs/platform/updates/guides/connect-a-device\" description=\"What a device must do to receive updates in each backend.\" />",{"_6892":3011,"_42174":2941,"_29767":86576,"_5":21387,"_28235":86405,"_5797":86577},[],"<Card title=\"Configuration reference\" href=\"/docs/platform/updates/reference/configuration\" description=\"Every config field and its default.\" />",{"_6892":3012,"_42174":3012,"_5":21817,"_5797":86579,"_42654":86580,"_29767":86582,"_28235":3012},"Connect a device",[77248,78697,85231,86581],"Guides",[],{"_6892":3013,"_42174":3012,"_29767":86584,"_5":21387,"_28235":3012,"_5797":86585},[],"What a device must do to receive updates from Lamassu Updates, in native mode and in hawkBit mode.",{"_6892":3014,"_42174":3012,"_5":42651,"_29767":86587,"_28235":86588,"_5797":77258},[],"/docs/pr-preview/pr-56/platform/updates/guides/connect-a-device#before-you-begin",{"_6892":3015,"_42174":3012,"_5":42651,"_29767":86590,"_28235":86591,"_5797":86592},[],"/docs/pr-preview/pr-56/platform/updates/guides/connect-a-device#native-mode-the-device-polls-wfx","Native mode: the device polls WFX",{"_6892":3016,"_42174":3012,"_5":42651,"_29767":86594,"_28235":86595,"_5797":86596},[],"/docs/pr-preview/pr-56/platform/updates/guides/connect-a-device#the-job-the-device-receives","The job the device receives",{"_6892":3017,"_42174":3012,"_5":42651,"_29767":86598,"_28235":86599,"_5797":86600},[],"/docs/pr-preview/pr-56/platform/updates/guides/connect-a-device#downloading","Downloading",{"_6892":3018,"_42174":3012,"_5":42651,"_29767":86602,"_28235":86603,"_5797":86604},[],"/docs/pr-preview/pr-56/platform/updates/guides/connect-a-device#the-states-the-device-reports","The states the device reports",{"_6892":3019,"_42174":3012,"_5":42651,"_29767":86606,"_28235":86607,"_5797":86608},[],"/docs/pr-preview/pr-56/platform/updates/guides/connect-a-device#hawkbit-mode-the-device-polls-hawkbit","hawkBit mode: the device polls hawkBit",{"_6892":3020,"_42174":3012,"_5":42651,"_29767":86610,"_28235":86611,"_5797":86612},[],"/docs/pr-preview/pr-56/platform/updates/guides/connect-a-device#make-the-device-a-hawkbit-target","Make the device a hawkBit target",{"_6892":3021,"_42174":3012,"_5":42651,"_29767":86614,"_28235":86615,"_5797":86616},[],"/docs/pr-preview/pr-56/platform/updates/guides/connect-a-device#configure-swupdate","Configure SWUpdate",{"_6892":3022,"_42174":3012,"_5":42651,"_29767":86618,"_28235":86619,"_5797":86620},[],"/docs/pr-preview/pr-56/platform/updates/guides/connect-a-device#point-it-at-the-right-hawkbit","Point it at the right hawkBit",{"_6892":3023,"_42174":3012,"_5":42651,"_29767":86622,"_28235":86623,"_5797":86624},[],"/docs/pr-preview/pr-56/platform/updates/guides/connect-a-device#signed-and-encrypted-images","Signed and encrypted images",{"_6892":3024,"_42174":3012,"_5":42651,"_29767":86626,"_28235":86627,"_5797":84896},[],"/docs/pr-preview/pr-56/platform/updates/guides/connect-a-device#verify-the-result",{"_6892":3025,"_42174":3012,"_5":42651,"_29767":86629,"_28235":86630,"_5797":81275},[],"/docs/pr-preview/pr-56/platform/updates/guides/connect-a-device#troubleshooting",{"_6892":3026,"_42174":3012,"_5":42651,"_29767":86632,"_28235":86633,"_5797":80372},[],"/docs/pr-preview/pr-56/platform/updates/guides/connect-a-device#next-steps",{"_6892":3027,"_42174":3012,"_29767":86635,"_5":21387,"_28235":3012,"_5797":86636},[],"This guide describes the contract between a device and Lamassu Updates, for each backend. The device software is SWUpdate: this page covers what the device must send and receive, not SWUpdate's own installation and configuration, which its documentation describes. Use it when a launch is running and no device moves.",{"_6892":3028,"_42174":3012,"_29767":86638,"_5":21387,"_28235":86588,"_5797":86639},[],"A device with SWUpdate installed, and a way to run an update client: a small agent, or SWUpdate's `suricatta` module.",{"_6892":3029,"_42174":3012,"_29767":86641,"_5":21387,"_28235":86588,"_5797":86642},[],"A device identity: one ID that is the same everywhere. It is the WFX client ID in native mode and the hawkBit controller ID in hawkBit mode, and it must equal the device's ID in the Lamassu device registry (see Device management).",{"_6892":3030,"_42174":3012,"_29767":86644,"_5":21387,"_28235":86588,"_5797":86645},[],"The device must be a member of a Lamassu IoT device group, because a pack belongs to a group and a launch targets the group's devices. In hawkBit mode group membership is also read from the registry when `dms_endpoint` is set.",{"_6892":3031,"_42174":3012,"_29767":86647,"_5":21387,"_28235":86588,"_5797":86648},[],"Native mode only: `update_domain` must be an address the device can reach. See Configuration. In hawkBit mode devices download from hawkBit.",{"_6892":3032,"_42174":3012,"_29767":86650,"_5":21387,"_28235":86591,"_5797":86651},[],"In native mode a launch creates one WFX job per device. The device polls WFX for jobs addressed to its ID, downloads the deliverable from the Updates API, installs it and reports each state back to WFX. Lamassu Updates reads those states from WFX to drive the launch.",{"_6892":3033,"_42174":3012,"_29767":86653,"_5":21387,"_28235":86591,"_5797":86654},[],"The sample device in `docker-compose.yml` (`swupdate-device1`) shows the minimum configuration. It takes three variables: `DEVICE_NAME` (its ID), `WFX_URI` (the WFX **client** API, `http://custom-wfx:8080/api/wfx/v1` inside the Compose network, `localhost:9080` from the host) and `PORT`. The WFX management API on `9081` is for the service, not for devices.",{"_6892":3034,"_42174":3012,"_29767":86656,"_5":21387,"_28235":86595,"_5797":86657},[],"The job is addressed to the device (the WFX `clientId` is the device ID), names a workflow and is tagged with the launch (`lms://secure-updates/<launch id>`) and the group (`lms://dms/<group id>`). Its definition looks like this:",{"_6892":3035,"_42174":3012,"_29767":86659,"_5":21387,"_28235":86595,"_5797":85754},[],{"_6892":3036,"_42174":3012,"_29767":86661,"_5":21387,"_28235":86595,"_5797":79765},[],{"_6892":3037,"_42174":3012,"_29767":86663,"_5":21387,"_28235":86595,"_5797":86664},[],"`type`",{"_6892":3038,"_42174":3012,"_29767":86666,"_5":21387,"_28235":86595,"_5797":86667},[],"The pack type: `rawfile`, `firmware`, or both (`[\"rawfile\",\"firmware\"]`)",{"_6892":3039,"_42174":3012,"_29767":86669,"_5":21387,"_28235":86595,"_5797":86670},[],"`artifacts[0].uri`",{"_6892":3040,"_42174":3012,"_29767":86672,"_5":21387,"_28235":86595,"_5797":86673},[],"Where to download the deliverable. The service appends the device ID, so each device fetches its own file. A `.swu` for SWU packs, a `.tar.gz` for `non-swu` packs",{"_6892":3041,"_42174":3012,"_29767":86675,"_5":21387,"_28235":86595,"_5797":86676},[],"`algorithm`, `iv`",{"_6892":3042,"_42174":3012,"_29767":86678,"_5":21387,"_28235":86595,"_5797":86679},[],"Present only for an encrypted pack: the algorithm and, for shared-key packs, the hex IV or nonce. A per-device pack carries the algorithm but no `iv`",{"_6892":3043,"_42174":3012,"_29767":86681,"_5":21387,"_28235":86595,"_5797":86682},[],"`signature_key_id`, `signature_algorithm`, `signature_certificate`",{"_6892":3044,"_42174":3012,"_29767":86684,"_5":21387,"_28235":86595,"_5797":86685},[],"Present only for a signed pack",{"_6892":3045,"_42174":3012,"_29767":86687,"_5":21387,"_28235":86595,"_5797":86688},[],"The device needs the key to decrypt, and holds it itself. For a per-device pack it is the key that SymKMS assigned to that device, and each device downloads a different file.",{"_6892":3046,"_42174":3012,"_29767":86690,"_5":21387,"_28235":86599,"_5797":86691},[],"The download answers with the bytes, or with `302` to a short-lived signed URL when presigned downloads are enabled for the build store. Make sure the device's HTTP client follows redirects. The route also answers `HEAD` and byte-range requests (`206`), so an interrupted download can resume. The URL is fixed when the pack is built, so a device never sees a new `update_domain` until you rebuild.",{"_6892":3047,"_42174":3012,"_29767":86693,"_5":21387,"_28235":86603,"_5797":86694},[],"The device moves its job through the workflow's states, and the workflow decides who may make each move. For the `direct` workflow:",{"_6892":3048,"_42174":3012,"_29767":86696,"_5":21387,"_28235":86603,"_5797":86697},[],"The device reports `INSTALLING`, `INSTALLED`, `ACTIVATING` and `ACTIVATED`. WFX itself makes the `INSTALLED → ACTIVATE` step. From `INSTALL`, `INSTALLING`, `ACTIVATE` and `ACTIVATING` the device can move to `TERMINATED` to report a failure; `INSTALLED` has no failure transition.",{"_6892":3049,"_42174":3012,"_29767":86699,"_5":21387,"_28235":86603,"_5797":78301},[],{"_6892":3050,"_42174":3012,"_29767":86701,"_5":21387,"_28235":86603,"_5797":86702},[],"Used for",{"_6892":3051,"_42174":3012,"_29767":86704,"_5":21387,"_28235":86603,"_5797":86705},[],"Terminal states",{"_6892":3052,"_42174":3012,"_29767":86707,"_5":21387,"_28235":86603,"_5797":86708},[],"`wfx.workflow.dau.direct`",{"_6892":3053,"_42174":3012,"_29767":86710,"_5":21387,"_28235":86603,"_5797":85846},[],{"_6892":3054,"_42174":3012,"_29767":86712,"_5":21387,"_28235":86603,"_5797":86713},[],"`ACTIVATED` (success), `TERMINATED` (failure)",{"_6892":3055,"_42174":3012,"_29767":86715,"_5":21387,"_28235":86603,"_5797":86716},[],"`wfx.workflow.dau.phased`",{"_6892":3056,"_42174":3012,"_29767":86718,"_5":21387,"_28235":86603,"_5797":86719},[],"SWU packs with confirmation steps (`CREATED → DOWNLOAD → ... → ACTIVATED`)",{"_6892":3057,"_42174":3012,"_29767":86721,"_5":21387,"_28235":86603,"_5797":86722},[],"`ACTIVATED`, `TERMINATED`",{"_6892":3058,"_42174":3012,"_29767":86724,"_5":21387,"_28235":86603,"_5797":86725},[],"`wfx.workflow.dau.download-install`",{"_6892":3059,"_42174":3012,"_29767":86727,"_5":21387,"_28235":86603,"_5797":86728},[],"`non-swu` packs: `DOWNLOAD → ... → INSTALLED`, every move made by the device",{"_6892":3060,"_42174":3012,"_29767":86730,"_5":21387,"_28235":86603,"_5797":86731},[],"`INSTALLED`, `TERMINATED`",{"_6892":3061,"_42174":3012,"_29767":86733,"_5":21387,"_28235":86603,"_5797":86734},[],"`wfx.workflow.dau.simple`",{"_6892":3062,"_42174":3012,"_29767":86736,"_5":21387,"_28235":86603,"_5797":86737},[],"Minimal `DOWNLOAD → INSTALL → INSTALLED`",{"_6892":3063,"_42174":3012,"_29767":86739,"_5":21387,"_28235":86603,"_5797":86731},[],{"_6892":3064,"_42174":3012,"_29767":86741,"_5":21387,"_28235":86603,"_5797":86742},[],"A `phased` job has moves that WFX or an operator makes, and nothing in Lamassu Updates advances them: it stays at `CREATED` until someone confirms it through WFX (the dashboard's **Next** button does that). The launch endpoints `force-version` and `sync-to-latest` use `phased` for SWU packs unless you pass a `workflow`. The workflow files are in `wfx/workflow/dau/` of the repository. The WFX HTTP API (listing jobs, updating status) is documented by WFX.",{"_6892":3065,"_42174":3012,"_29767":86744,"_5":21387,"_28235":86607,"_5797":86745},[],"In hawkBit mode devices do not poll Lamassu Updates. They poll hawkBit's DDI API, and Lamassu Updates reads the resulting action state from hawkBit.",{"_6892":3066,"_42174":3012,"_29767":86747,"_5":21387,"_28235":86611,"_5797":86748},[],"The device needs a controller ID, and a target tagged `group:<id>` for its group. With `dms_endpoint` set, the service does this itself: when it reads a group's devices from the registry it creates the missing targets and tags them. Without `dms_endpoint` you create the targets and tags yourself. Either way the device must poll hawkBit with valid credentials.",{"_6892":3067,"_42174":3012,"_29767":86750,"_5":21387,"_28235":86615,"_5797":86751},[],"Point the device's SWUpdate (`suricatta`) at hawkBit's URL (`hawkbit.ddi_url`, which defaults to `hawkbit.base_url`), with the tenant, the controller ID and an authentication method that your hawkBit tenant accepts. hawkBit refuses unauthenticated devices by default. With target security tokens, enable them for the tenant (`PUT /rest/v1/system/configs/authentication.targettoken.enabled` with `{\"value\":true}`) and give each device its target's `securityToken`, which it sends as `Authorization: TargetToken <token>`. The hawkBit curl guide shows every request.",{"_6892":3068,"_42174":3012,"_29767":86753,"_5":21387,"_28235":86619,"_5797":86754},[],"The device must poll the **same hawkBit** that the service is configured for. A service pointed at a hawkBit with no targets builds and launches without error, and nothing downloads it. See Troubleshooting.",{"_6892":3069,"_42174":3012,"_29767":86756,"_5":21387,"_28235":86619,"_5797":86757},[],"hawkBit then hands the device every artifact of its distribution set. A pack with several modules runs several independent installs.",{"_6892":3070,"_42174":3012,"_29767":86759,"_5":21387,"_28235":86619,"_5797":86760},[],"When your gateway routes hawkBit's device artifact URLs (the path of `hawkbit.ddi_url`, `.../<tenant>/controller/v1/<controller>/softwaremodules/<id>/artifacts/<file>`) to Lamassu Updates, the service serves them only for modules assigned to or installed on that controller, and answers `404` otherwise. With presigned downloads on, it redirects to a signed URL of hawkBit's S3 bucket instead of streaming the file.",{"_6892":3071,"_42174":3012,"_29767":86762,"_5":21387,"_28235":86623,"_5797":86763},[],"If the device verifies signatures, set its public key (`public-key-file` in SWUpdate's configuration) and sign the package with the matching key. If it decrypts, it needs the same key and algorithm the pack was built with. A mismatch is the usual reason an install fails silently after a successful download. Signing and encryption explains which key, algorithm and IV each mode uses, and what the device receives.",{"_6892":3072,"_42174":3012,"_29767":86765,"_5":21387,"_28235":86627,"_5797":86766},[],"After a launch, the device's job reaches `ACTIVATED` (or `INSTALLED` for a `non-swu` pack), the launch counters update, and the device inventory lists the pack:",{"_6892":3073,"_42174":3012,"_29767":86768,"_5":21387,"_28235":86627,"_5797":86769},[],"See Publish and roll out an update for the rest of the checks.",{"_6892":3074,"_42174":3012,"_29767":86771,"_5":21387,"_28235":86630,"_5797":84046},[],{"_6892":3075,"_42174":3012,"_29767":86773,"_5":21387,"_28235":86630,"_5797":86538},[],{"_6892":3076,"_42174":3012,"_29767":86775,"_5":21387,"_28235":86630,"_5797":86776},[],"The device never sees a job (native)",{"_6892":3077,"_42174":3012,"_29767":86778,"_5":21387,"_28235":86630,"_5797":86779},[],"It polls the wrong WFX endpoint or uses a different ID than the group member. The WFX `clientId` must equal the device ID",{"_6892":3078,"_42174":3012,"_29767":86781,"_5":21387,"_28235":86630,"_5797":86782},[],"The job stays at `CREATED`",{"_6892":3079,"_42174":3012,"_29767":86784,"_5":21387,"_28235":86630,"_5797":86785},[],"The launch uses `phased`. Confirm it through WFX or the dashboard, or relaunch with `direct`",{"_6892":3080,"_42174":3012,"_29767":86787,"_5":21387,"_28235":86630,"_5797":86788},[],"The download fails with `404`",{"_6892":3081,"_42174":3012,"_29767":86790,"_5":21387,"_28235":86630,"_5797":86791},[],"The pack is per-device encrypted and the device has no key, or the URL names another device. Check the pack's coverage and that the URL ends with this device's ID",{"_6892":3082,"_42174":3012,"_29767":86793,"_5":21387,"_28235":86630,"_5797":86794},[],"The download succeeds and the install fails",{"_6892":3083,"_42174":3012,"_29767":86796,"_5":21387,"_28235":86630,"_5797":86797},[],"The signature or the key does not match what the device holds. See Signing and encryption",{"_6892":3084,"_42174":3012,"_29767":86799,"_5":21387,"_28235":86630,"_5797":86800},[],"A `non-swu` launch looks stuck although the device finished",{"_6892":3085,"_42174":3012,"_29767":86802,"_5":21387,"_28235":86630,"_5797":86803},[],"It was launched with `direct` or `phased`, which wait for `ACTIVATED`. Launch `non-swu` packs with `download-install`",{"_6892":3086,"_42174":3012,"_29767":86805,"_5":21387,"_28235":86630,"_5797":86806},[],"The launch never advances (hawkBit)",{"_6892":3087,"_42174":3012,"_29767":86808,"_5":21387,"_28235":86630,"_5797":86809},[],"The device is not polling this hawkBit, is not tagged into the group, or cannot authenticate",{"_6892":3088,"_42174":3012,"_29767":86811,"_5":21387,"_28235":86633,"_5797":86812},[],"<Card title=\"Signing and encryption\" href=\"/docs/platform/updates/signing-and-encryption\" description=\"Keys, algorithms and what the device must hold.\" />",{"_6892":3089,"_42174":3012,"_29767":86814,"_5":21387,"_28235":86633,"_5797":86815},[],"<Card title=\"hawkBit mode\" href=\"/docs/platform/updates/hawkbit-mode\" description=\"How the adapter maps packs and campaigns onto hawkBit.\" />",{"_6892":3090,"_42174":3012,"_29767":86817,"_5":21387,"_28235":86633,"_5797":86818},[],"<Card title=\"Troubleshooting\" href=\"/docs/platform/updates/troubleshooting\" description=\"Updates not reaching devices, and other failures.\" />",{"_6892":3091,"_42174":3091,"_5":21817,"_5797":86820,"_42654":86821,"_29767":86822,"_28235":3091},"Use the dashboard",[77248,78697,85231,86581],[],{"_6892":3092,"_42174":3091,"_29767":86824,"_5":21387,"_28235":3091,"_5797":86825},[],"Publish, roll out and follow an update from the Lamassu dashboard, screen by screen.",{"_6892":3093,"_42174":3091,"_5":42651,"_29767":86827,"_28235":86828,"_5797":77258},[],"/docs/pr-preview/pr-56/platform/updates/guides/dashboard#before-you-begin",{"_6892":3094,"_42174":3091,"_5":42651,"_29767":86830,"_28235":86831,"_5797":86832},[],"/docs/pr-preview/pr-56/platform/updates/guides/dashboard#connect-it-to-the-service","Connect it to the service",{"_6892":3095,"_42174":3091,"_5":42651,"_29767":86834,"_28235":86835,"_5797":86836},[],"/docs/pr-preview/pr-56/platform/updates/guides/dashboard#where-things-are","Where things are",{"_6892":3096,"_42174":3091,"_5":42651,"_29767":86838,"_28235":86839,"_5797":86840},[],"/docs/pr-preview/pr-56/platform/updates/guides/dashboard#1-create-a-distribution-set","1\\. Create a distribution set",{"_6892":3097,"_42174":3091,"_5":42651,"_29767":86842,"_28235":86843,"_5797":86844},[],"/docs/pr-preview/pr-56/platform/updates/guides/dashboard#2-add-files-and-build-native","2\\. Add files and build (native)",{"_6892":3098,"_42174":3091,"_5":42651,"_29767":86846,"_28235":86847,"_5797":86848},[],"/docs/pr-preview/pr-56/platform/updates/guides/dashboard#hawkbit-build-a-module-first","hawkBit: build a module first",{"_6892":3099,"_42174":3091,"_5":42651,"_29767":86850,"_28235":86851,"_5797":86852},[],"/docs/pr-preview/pr-56/platform/updates/guides/dashboard#3-start-a-campaign","3\\. Start a campaign",{"_6892":3100,"_42174":3091,"_5":42651,"_29767":86854,"_28235":86855,"_5797":86856},[],"/docs/pr-preview/pr-56/platform/updates/guides/dashboard#4-run-and-watch-the-campaign","4\\. Run and watch the campaign",{"_6892":3101,"_42174":3091,"_5":42651,"_29767":86858,"_28235":86859,"_5797":86860},[],"/docs/pr-preview/pr-56/platform/updates/guides/dashboard#5-follow-devices","5\\. Follow devices",{"_6892":3102,"_42174":3091,"_5":42651,"_29767":86862,"_28235":86863,"_5797":86864},[],"/docs/pr-preview/pr-56/platform/updates/guides/dashboard#what-changes-with-the-backend","What changes with the backend",{"_6892":3103,"_42174":3091,"_5":42651,"_29767":86866,"_28235":86867,"_5797":86868},[],"/docs/pr-preview/pr-56/platform/updates/guides/dashboard#not-in-the-dashboard","Not in the dashboard",{"_6892":3104,"_42174":3091,"_5":42651,"_29767":86870,"_28235":86871,"_5797":81275},[],"/docs/pr-preview/pr-56/platform/updates/guides/dashboard#troubleshooting",{"_6892":3105,"_42174":3091,"_5":42651,"_29767":86873,"_28235":86874,"_5797":80372},[],"/docs/pr-preview/pr-56/platform/updates/guides/dashboard#next-steps",{"_6892":3106,"_42174":3091,"_29767":86876,"_5":21387,"_28235":3091,"_5797":86877},[],"The Lamassu dashboard is the web interface for the Updates API. This guide follows the same update as the curl guides (native and hawkBit) through the screens. Names in bold are the labels shown in the dashboard.",{"_6892":3107,"_42174":3091,"_29767":86879,"_5":21387,"_28235":3091,"_5797":86880},[],"The dashboard is a separate project (`lamassu-dashboard`). This guide describes it from its source and has no screenshots, so a label can differ in a newer version. The dashboard has no translations: its labels are in English.",{"_6892":3108,"_42174":3091,"_29767":86882,"_5":21387,"_28235":86828,"_5797":86883},[],"Lamassu Updates is running and the dashboard can reach it. See Connect it to the service.",{"_6892":3109,"_42174":3091,"_29767":86885,"_5":21387,"_28235":86828,"_5797":86886},[],"A Lamassu IoT **device group** that contains the devices to update (**Device Groups** under **IoT**). A group's members are the devices that match its criteria.",{"_6892":3110,"_42174":3091,"_29767":86888,"_5":21387,"_28235":86828,"_5797":86889},[],"For an SWU build with signing or encryption: a signing key in **Asymmetric Keys** or a symmetric key in **Symmetric Keys** (both under **KMS**), and, for per-device encryption, keys assigned to the devices in **Device Key Inventory** (under **IoT**).",{"_6892":3111,"_42174":3091,"_29767":86891,"_5":21387,"_28235":86831,"_5797":86892},[],"The dashboard talks to the Updates API at the address in `LAMASSU_UPDATES_API`, in its `public/config.js`. In the container image it comes from the environment variable of the same name.",{"_6892":3112,"_42174":3091,"_29767":86894,"_5":21387,"_28235":86831,"_5797":86895},[],"The dashboard appends `/updates/v1` and `/symkms/v1` to it. A trailing `/updates/v1` is accepted and stripped.",{"_6892":3113,"_42174":3091,"_29767":86897,"_5":21387,"_28235":86831,"_5797":86898},[],"If it is empty, the dashboard uses `LAMASSU_API`.",{"_6892":3114,"_42174":3091,"_29767":86900,"_5":21387,"_28235":86831,"_5797":86901},[],"When authentication is on, every call carries the user's bearer token. The service ignores it, so put a gateway that checks it in front. See Security.",{"_6892":3115,"_42174":3091,"_29767":86903,"_5":21387,"_28235":86831,"_5797":86904},[],"It must point at the service instance that runs the backend you want to use. A service runs either native or hawkBit mode, never both: to use both at once you run two instances, each on its own port, and point the dashboard at one of them.",{"_6892":3116,"_42174":3091,"_29767":86906,"_5":21387,"_28235":86831,"_5797":86907},[],"The dashboard reads `GET /updates/v1/capabilities` once, after you sign in, and hides what the backend cannot do. That is why the same screens look different in native and hawkBit mode. What changes with the backend lists the differences. If the capabilities request fails, the dashboard assumes everything is supported and hides nothing.",{"_6892":3117,"_42174":3091,"_29767":86909,"_5":21387,"_28235":86831,"_5797":86910},[],"To compare both backends, the user menu has an **Updates backend** switch with the options **Auto**, **native** and **hawkbit**. It appears only in development builds, or when the dashboard container runs with `DEV_OPTIONS_ENABLED=true`. Choosing native or hawkbit overrides `LAMASSU_UPDATES_API` for that browser, shows an editable **Updates API base URL** field and reloads the page. The defaults are `http://localhost:10090` (native) and `http://localhost:10091` (hawkbit) on localhost, and `<origin>/api` and `<origin>/api/hawkbit` on any other host.",{"_6892":3118,"_42174":3091,"_29767":86912,"_5":21387,"_28235":86835,"_5797":86913},[],"The sidebar group **OTA UPDATES MANAGER** has:",{"_6892":3119,"_42174":3091,"_29767":86915,"_5":21387,"_28235":86835,"_5797":86916},[],"Item",{"_6892":3120,"_42174":3091,"_29767":86918,"_5":21387,"_28235":86835,"_5797":86919},[],"Route",{"_6892":3121,"_42174":3091,"_29767":86921,"_5":21387,"_28235":86835,"_5797":86444},[],{"_6892":3122,"_42174":3091,"_29767":86923,"_5":21387,"_28235":86835,"_5797":86924},[],"**Dashboard**",{"_6892":3123,"_42174":3091,"_29767":86926,"_5":21387,"_28235":86835,"_5797":86927},[],"`/updates/dashboard`",{"_6892":3124,"_42174":3091,"_29767":86929,"_5":21387,"_28235":86835,"_5797":86930},[],"Page title **OTA Dashboard**: rollout health, campaigns requiring attention, version distribution and the upcoming schedule",{"_6892":3125,"_42174":3091,"_29767":86932,"_5":21387,"_28235":86835,"_5797":86933},[],"**OTA Devices**",{"_6892":3126,"_42174":3091,"_29767":86935,"_5":21387,"_28235":86835,"_5797":86936},[],"`/updates/devices`",{"_6892":3127,"_42174":3091,"_29767":86938,"_5":21387,"_28235":86835,"_5797":86939},[],"Every device with its installed and target version",{"_6892":3128,"_42174":3091,"_29767":86941,"_5":21387,"_28235":86835,"_5797":86942},[],"**OTA Device Groups**",{"_6892":3129,"_42174":3091,"_29767":86944,"_5":21387,"_28235":86835,"_5797":86945},[],"`/updates/device-groups`",{"_6892":3130,"_42174":3091,"_29767":86947,"_5":21387,"_28235":86835,"_5797":86948},[],"Groups, with how many devices are behind",{"_6892":3131,"_42174":3091,"_29767":86950,"_5":21387,"_28235":86835,"_5797":86951},[],"**Distribution Set**",{"_6892":3132,"_42174":3091,"_29767":86953,"_5":21387,"_28235":86835,"_5797":86954},[],"`/package-inventory`",{"_6892":3133,"_42174":3091,"_29767":86956,"_5":21387,"_28235":86835,"_5797":86957},[],"The update packs of every group",{"_6892":3134,"_42174":3091,"_29767":86959,"_5":21387,"_28235":86835,"_5797":86960},[],"**Software Modules**",{"_6892":3135,"_42174":3091,"_29767":86962,"_5":21387,"_28235":86835,"_5797":86963},[],"`/updates/software-modules`",{"_6892":3136,"_42174":3091,"_29767":86965,"_5":21387,"_28235":86835,"_5797":86966},[],"The module catalog",{"_6892":3137,"_42174":3091,"_29767":86968,"_5":21387,"_28235":86835,"_5797":86969},[],"**Campaigns**",{"_6892":3138,"_42174":3091,"_29767":86971,"_5":21387,"_28235":86835,"_5797":86972},[],"`/updates`",{"_6892":3139,"_42174":3091,"_29767":86974,"_5":21387,"_28235":86835,"_5797":86975},[],"Launches: list, create, run",{"_6892":3140,"_42174":3091,"_29767":86977,"_5":21387,"_28235":86835,"_5797":86978},[],"The group **IoT** has **Devices**, **Device Groups** (the Lamassu device registry and its groups), **Device Key Inventory** and **Platform Integrations**. The **JOB MANAGER** group (**Jobs**, **Workflows**) lists raw WFX jobs and workflows. It does not use the Updates API and does not create launches.",{"_6892":3141,"_42174":3091,"_29767":86980,"_5":21387,"_28235":86835,"_5797":86981},[],"In the dashboard, a pack is a **distribution set** and a launch is a **campaign**.",{"_6892":3142,"_42174":3091,"_29767":86983,"_5":21387,"_28235":86839,"_5797":86984},[],"Open **Distribution Set**. The list shows every group's packs, with filters for device group and status, a search box and a **Refresh** button. Press **New Distribution Set**.",{"_6892":3143,"_42174":3091,"_29767":86986,"_5":21387,"_28235":86839,"_5797":85754},[],{"_6892":3144,"_42174":3091,"_29767":86988,"_5":21387,"_28235":86839,"_5797":86989},[],"Notes",{"_6892":3145,"_42174":3091,"_29767":86991,"_5":21387,"_28235":86839,"_5797":86992},[],"**Name**",{"_6892":3146,"_42174":3091,"_29767":86994,"_5":21387,"_28235":86839,"_5797":86995},[],"At least 3 characters, no spaces. Use underscores. Native mode also accepts only letters, digits, `.`, `_` and `-`",{"_6892":3147,"_42174":3091,"_29767":86997,"_5":21387,"_28235":86839,"_5797":86998},[],"**Version**",{"_6892":3148,"_42174":3091,"_29767":87000,"_5":21387,"_28235":86839,"_5797":87001},[],"Semver, default `1.0.0`",{"_6892":3149,"_42174":3091,"_29767":87003,"_5":21387,"_28235":86839,"_5797":87004},[],"**Device Group**",{"_6892":3150,"_42174":3091,"_29767":87006,"_5":21387,"_28235":86839,"_5797":87007},[],"Required. A pack belongs to one group and can only be launched to its devices",{"_6892":3151,"_42174":3091,"_29767":87009,"_5":21387,"_28235":86839,"_5797":87010},[],"**Type**",{"_6892":3152,"_42174":3091,"_29767":87012,"_5":21387,"_28235":86839,"_5797":87013},[],"**Raw File** (no restart), **Firmware** (restart), **Both** or **Other Type**",{"_6892":3153,"_42174":3091,"_29767":87015,"_5":21387,"_28235":86839,"_5797":87016},[],"**Driver**",{"_6892":3154,"_42174":3091,"_29767":87018,"_5":21387,"_28235":86839,"_5797":87019},[],"Native: **SWU** builds one signed image (signing is optional), **Generic** delivers files as they are. hawkBit: **SWU** accepts only SWU modules, **Generic** accepts binaries and other files. Fixed once created",{"_6892":3155,"_42174":3091,"_29767":87021,"_5":21387,"_28235":86839,"_5797":87022},[],"**Allow previous-version download**",{"_6892":3156,"_42174":3091,"_29767":87024,"_5":21387,"_28235":86839,"_5797":87025},[],"Lets devices download older versions of this pack",{"_6892":3157,"_42174":3091,"_29767":87027,"_5":21387,"_28235":86839,"_5797":87028},[],"**Compatibility**",{"_6892":3158,"_42174":3091,"_29767":87030,"_5":21387,"_28235":86839,"_5797":87031},[],"Optional launch preconditions (collapsed): devices must already carry another distribution set, or a software module, at a minimum version",{"_6892":3159,"_42174":3091,"_29767":87033,"_5":21387,"_28235":86839,"_5797":87034},[],"Press **Create Distribution Set**. You land on the pack's page. The preconditions stay editable there, in **Launch Preconditions** on the **Overview** tab (**Save preconditions**).",{"_6892":3160,"_42174":3091,"_29767":87036,"_5":21387,"_28235":86839,"_5797":87037},[],"In hawkBit mode the form has one more section, **Software modules**. A hawkBit set links built modules, so tick at least one built module there, and at most one OS module. The table lists only modules that fit the **Driver**: an SWU set hides modules delivered as raw files, and a Generic set hides modules delivered as a prebuilt SWU. If nothing fits, it says \"No built module fits this driver\", and you build one first (see hawkBit: build a module first).",{"_6892":3161,"_42174":3091,"_29767":87039,"_5":21387,"_28235":86839,"_5797":87040},[],"On the native backend, the **Driver** also decides which workflow can install the pack: SWU packs need **Direct** or **Phased** and Generic packs need **Download-Install**. A mismatch leaves the update looking stuck after the device finishes.",{"_6892":3162,"_42174":3091,"_29767":87042,"_5":21387,"_28235":86843,"_5797":87043},[],"On the pack's page (`/updates/pack-details`) open the **Software Modules** tab. A native pack starts with one OS module named like the pack (\"Not composed\"). Open its row menu and choose **Add files**, drop your file, and upload it. The artifact name defaults to the file name without its extension, and the version is optional (semver). To compose the pack from more modules, use **Add module** (a new application module) or **Import module** (copy an existing one); the pack still builds one SWU.",{"_6892":3163,"_42174":3091,"_29767":87045,"_5":21387,"_28235":86843,"_5797":87046},[],"Then press **Generate SWU** in the header. The sheet **SWU deliverable** has two tabs.",{"_6892":3164,"_42174":3091,"_29767":87048,"_5":21387,"_28235":86843,"_5797":87049},[],"**Build here** builds the package from the pack's artifacts:",{"_6892":3165,"_42174":3091,"_29767":87051,"_5":21387,"_28235":86843,"_5797":80531},[],{"_6892":3166,"_42174":3091,"_29767":87053,"_5":21387,"_28235":86843,"_5797":87054},[],"What to do",{"_6892":3167,"_42174":3091,"_29767":87056,"_5":21387,"_28235":86843,"_5797":87057},[],"**Artifacts to include**",{"_6892":3168,"_42174":3091,"_29767":87059,"_5":21387,"_28235":86843,"_5797":87060},[],"Checkboxes, all selected by default",{"_6892":3169,"_42174":3091,"_29767":87062,"_5":21387,"_28235":86843,"_5797":87063},[],"**sw-descriptor**",{"_6892":3170,"_42174":3091,"_29767":87065,"_5":21387,"_28235":86843,"_5797":87066},[],"Required. Load the file or type it in the editor. A checklist shows each file the description declares, and a file that is declared but not selected blocks the build",{"_6892":3171,"_42174":3091,"_29767":87068,"_5":21387,"_28235":86843,"_5797":87069},[],"**Signing**",{"_6892":3172,"_42174":3091,"_29767":87071,"_5":21387,"_28235":86843,"_5797":87072},[],"**Signing key**: none (unsigned) or a KMS key. With a key, pick a **Method** and a **Certificate**",{"_6892":3173,"_42174":3091,"_29767":87074,"_5":21387,"_28235":86843,"_5797":87075},[],"**Encryption**, **Mode**",{"_6892":3174,"_42174":3091,"_29767":87077,"_5":21387,"_28235":86843,"_5797":87078},[],"None, &#x2A;*Shared (one key for all devices)** or &#x2A;*Per-device (key per device)**",{"_6892":3175,"_42174":3091,"_29767":87080,"_5":21387,"_28235":86843,"_5797":87081},[],"For shared encryption choose a **Symmetric key** and whether to encrypt the descriptor (**Encrypt the descriptor**) and all files (**Encrypt all files**), or tick individual files. For per-device encryption choose an **Algorithm** (default `Ascon-128a`). Each device then uses its own key from the device key inventory. If you choose no security the sheet says \"No security selected\".",{"_6892":3176,"_42174":3091,"_29767":87083,"_5":21387,"_28235":86843,"_5797":87084},[],"Press **Generate SWU**. The sheet uploads the sw-description, then builds. The badge becomes **Built** and the header button now reads **Regenerate SWU**. **Download SWU** appears next to it, except for a per-device pack: there is no download of the whole set, and each device's package is downloaded per device.",{"_6892":3177,"_42174":3091,"_29767":87086,"_5":21387,"_28235":86843,"_5797":87087},[],"**Upload pre-built** attaches a `.swu` you built elsewhere, up to the service's `max_artifact_size_mb` (10 GiB by default). It is stored and served unchanged, nothing is signed or encrypted for you, and the version becomes built and immutable.",{"_6892":3178,"_42174":3091,"_29767":87089,"_5":21387,"_28235":86843,"_5797":87090},[],"A **non-swu** pack has **Generate Package** instead. It builds a `.tar.gz` of the selected artifacts, with optional signing and optional shared or per-device encryption (the cipher is AES-GCM), and it has an **Upload pre-built** tab too. **Download Package** fetches the result.",{"_6892":3179,"_42174":3091,"_29767":87092,"_5":21387,"_28235":86843,"_5797":87093},[],"To change a built pack, create a new version: use **New Version** in the pack list's row menu (the dialog has **Create Version**), or **New Version to Edit** on the pack's **Artifacts** tab. The new version must be higher than the current one, and it clears the built package.",{"_6892":3180,"_42174":3091,"_29767":87095,"_5":21387,"_28235":86847,"_5797":87096},[],"In hawkBit mode a pack's files live in modules, built in the catalog.",{"_6892":3181,"_42174":3091,"_29767":87098,"_5":21387,"_28235":86847,"_5797":87099},[],"Open **Software Modules** and press **New module**. Fill in **Module name** (it cannot contain `/` or `:`), **Type** (**Application** or **OS / base image**), **Version**, the **Distribution set** (leave **Catalog only — no set** to link it later) and the **Delivery intent**:",{"_6892":3182,"_42174":3091,"_29767":87101,"_5":21387,"_28235":86847,"_5797":87102},[],"Delivery intent",{"_6892":3183,"_42174":3091,"_29767":87104,"_5":21387,"_28235":86847,"_5797":87105},[],"Means",{"_6892":3184,"_42174":3091,"_29767":87107,"_5":21387,"_28235":86847,"_5797":87108},[],"**Build SWU from inputs**",{"_6892":3185,"_42174":3091,"_29767":87110,"_5":21387,"_28235":86847,"_5797":87111},[],"You provide files and a sw-description, and the service builds a `.swu`",{"_6892":3186,"_42174":3091,"_29767":87113,"_5":21387,"_28235":86847,"_5797":87114},[],"**Upload prebuilt SWU**",{"_6892":3187,"_42174":3091,"_29767":87116,"_5":21387,"_28235":86847,"_5797":87117},[],"You upload a finished `.swu`",{"_6892":3188,"_42174":3091,"_29767":87119,"_5":21387,"_28235":86847,"_5797":87120},[],"**Deliver files unchanged**",{"_6892":3189,"_42174":3091,"_29767":87122,"_5":21387,"_28235":86847,"_5797":87123},[],"The files are delivered as they are, and the module counts as built after a build step that can optionally encrypt and sign them",{"_6892":3190,"_42174":3091,"_29767":87125,"_5":21387,"_28235":86847,"_5797":87126},[],"**Decide later**",{"_6892":3191,"_42174":3091,"_29767":87128,"_5":21387,"_28235":86847,"_5797":87129},[],"Not usable yet",{"_6892":3192,"_42174":3091,"_29767":87131,"_5":21387,"_28235":86847,"_5797":87132},[],"Add the files and, for **Build SWU from inputs**, the sw-description. The security cards offer signing and shared encryption. For **Build SWU from inputs** the switch **Build this module now** is on by default: turn it off to only store the files and build later from the row menu **Files and build**. For **Upload prebuilt SWU** there is no switch: the module is built as soon as the `.swu` is stored. For **Deliver files unchanged** the switch is **Build now**.",{"_6892":3193,"_42174":3091,"_29767":87134,"_5":21387,"_28235":86847,"_5797":87135},[],"Press **Create Module**.",{"_6892":3194,"_42174":3091,"_29767":87137,"_5":21387,"_28235":86847,"_5797":87138},[],"Create the distribution set and tick the built module.",{"_6892":3195,"_42174":3091,"_29767":87140,"_5":21387,"_28235":86847,"_5797":87141},[],"A module linked into a set is frozen. Unlink it to change it, or add a new version from **Upgrade to a new version** in its catalog row menu. See hawkBit mode.",{"_6892":3196,"_42174":3091,"_29767":87143,"_5":21387,"_28235":86847,"_5797":87144},[],"The catalog also works on the native backend: it lists the modules of every pack, and **New module** can leave a module in **Catalog only — no set** until you add it to a pack with **Import module**. Native import copies the module, while hawkBit linking shares it.",{"_6892":3197,"_42174":3091,"_29767":87146,"_5":21387,"_28235":86851,"_5797":87147},[],"Press **Start Campaign** in the pack's row menu in **Distribution Set** (enabled once the pack is built), or **New Campaign** on the **Campaigns** page. The form, **Create campaign**, is at `/updates/new`.",{"_6892":3198,"_42174":3091,"_29767":87149,"_5":21387,"_28235":86851,"_5797":82606},[],{"_6892":3199,"_42174":3091,"_29767":87151,"_5":21387,"_28235":86851,"_5797":87152},[],"Fields",{"_6892":3200,"_42174":3091,"_29767":87154,"_5":21387,"_28235":86851,"_5797":87155},[],"**Campaign basics**",{"_6892":3201,"_42174":3091,"_29767":87157,"_5":21387,"_28235":86851,"_5797":87158},[],"**Campaign name (optional)**, **Distribution set**. **Device group** and **Driver** are inherited and read-only. **Workflow**: on native, every registered WFX workflow (Direct, Phased, Download-Install...), with a warning when it does not fit the driver. On hawkBit the field is **Install mode**: **Forced** (the device installs as soon as it polls) or **Soft** (the device may confirm or postpone)",{"_6892":3202,"_42174":3091,"_29767":87160,"_5":21387,"_28235":86851,"_5797":87161},[],"**Schedule**",{"_6892":3203,"_42174":3091,"_29767":87163,"_5":21387,"_28235":86851,"_5797":87164},[],"**Start as soon as it is executed** or **Start at a planned time** (date and time, in your browser's time zone)",{"_6892":3204,"_42174":3091,"_29767":87166,"_5":21387,"_28235":86851,"_5797":87167},[],"**Batching & rollout**",{"_6892":3205,"_42174":3091,"_29767":87169,"_5":21387,"_28235":86851,"_5797":87170},[],"**Batch mode** (**Fixed count** or **Percentage**), the batch size or percentage, and the switch **Auto rollout**",{"_6892":3206,"_42174":3091,"_29767":87172,"_5":21387,"_28235":86851,"_5797":87173},[],"**Safety controls**",{"_6892":3207,"_42174":3091,"_29767":87175,"_5":21387,"_28235":86851,"_5797":87176},[],"Only with Auto rollout on: **Approval threshold** (%) and **Error threshold** (%)",{"_6892":3208,"_42174":3091,"_29767":87178,"_5":21387,"_28235":86851,"_5797":87179},[],"**Optional**",{"_6892":3209,"_42174":3091,"_29767":87181,"_5":21387,"_28235":86851,"_5797":87182},[],"**Test device** (the canary, updated first), the set's **Preconditions** (read-only), **Notes**, **Weight**",{"_6892":3210,"_42174":3091,"_29767":87184,"_5":21387,"_28235":86851,"_5797":87185},[],"There is no device picker. A campaign targets every device of the pack's group, and the **Campaign summary** panel shows how many match and the estimated number of batches.",{"_6892":3211,"_42174":3091,"_29767":87187,"_5":21387,"_28235":86851,"_5797":87188},[],"If the pack has preconditions, the dashboard first runs a dry run and shows **Campaign preconditions**: how many devices qualify, who does not and why. Tick &#x2A;*Force deploy to non-qualifying devices (not recommended)** to send to them anyway, then **Confirm campaign**.",{"_6892":3212,"_42174":3091,"_29767":87190,"_5":21387,"_28235":86851,"_5797":87191},[],"Press **Create campaign**. The campaign is created but nothing is sent yet: you return to **Campaigns**.",{"_6892":3213,"_42174":3091,"_29767":87193,"_5":21387,"_28235":86855,"_5797":87194},[],"On **Campaigns** (`/updates`) each row has the progress, the status (such as **Scheduled**, **Rolling Out**, **Paused**, **Completed**, **Cancelled**) and the batch progress. The tiles at the top (**Active campaigns**, **Scheduled**, **Rolling out**, **Requires attention**, **Completed**) filter the list. The page refreshes every four seconds while anything is moving.",{"_6892":3214,"_42174":3091,"_29767":87196,"_5":21387,"_28235":86855,"_5797":87197},[],"The row's main button releases a batch:",{"_6892":3215,"_42174":3091,"_29767":87199,"_5":21387,"_28235":86855,"_5797":87200},[],"**Send to test device** sends the canary first.",{"_6892":3216,"_42174":3091,"_29767":87202,"_5":21387,"_28235":86855,"_5797":87203},[],"**Execute next batch** sends the next batch.",{"_6892":3217,"_42174":3091,"_29767":87205,"_5":21387,"_28235":86855,"_5797":87206},[],"It is hidden when the campaign is completed or cancelled, paused, scheduled for later, has nothing pending, or is an **Auto rollout** campaign that is already running. While the canary is being tested or has failed, it stays visible but disabled. A failed canary pauses a native campaign: use **Resume** to retry it. A scheduled campaign starts by itself at its planned time.",{"_6892":3218,"_42174":3091,"_29767":87208,"_5":21387,"_28235":86855,"_5797":87209},[],"The row menu has **Open details**, **Resume**, **Pause**, **Retry N failed** and **Cancel campaign** (it asks \"Cancel Campaign?\"). **Pause** stops further batches while devices already in flight finish; **Resume** continues. There is no button for marking a campaign complete: a native campaign completes by itself when no device is pending or in progress.",{"_6892":3219,"_42174":3091,"_29767":87211,"_5":21387,"_28235":86855,"_5797":87212},[],"Below the table, a panel shows the selected campaign's **Batches** and a **Device progress** table. It follows the first active row until you select another. Open **View** for `/updates/details`:",{"_6892":3220,"_42174":3091,"_29767":87214,"_5":21387,"_28235":86855,"_5797":87215},[],"**Overview**: identity, preconditions, and the **Rollout Configuration** (workflow or install mode, rollout type and value, auto mode, test device). **Edit** on the rollout value works only where the backend supports editing a running strategy.",{"_6892":3221,"_42174":3091,"_29767":87217,"_5":21387,"_28235":86855,"_5797":87218},[],"**Device Jobs**: one row per device with its job state, a **Refresh Jobs** button and, per row, a **Workflow** button that opens the device's timeline. For the Phased workflow, a **Next** button and a strip of transitions let you confirm steps, which is how a `phased` campaign moves on.",{"_6892":3222,"_42174":3091,"_29767":87220,"_5":21387,"_28235":86855,"_5797":87221},[],"The page header repeats the main button (**Execute Campaign**, or **Send to Test Device** before the canary) and &#x2A;*Retry N failed device(s)**. It has no pause, resume or cancel: those are in the list's row menu. On hawkBit, **Pause** is hidden until the campaign has started dispatching.",{"_6892":3223,"_42174":3091,"_29767":87223,"_5":21387,"_28235":86859,"_5797":87224},[],"Open **Devices** (under **IoT**) and pick a device. The page has more tabs than the update-related ones listed here:",{"_6892":3224,"_42174":3091,"_29767":87226,"_5":21387,"_28235":86859,"_5797":87227},[],"Tab",{"_6892":3225,"_42174":3091,"_29767":87229,"_5":21387,"_28235":86859,"_5797":87230},[],"Shows",{"_6892":3226,"_42174":3091,"_29767":87232,"_5":21387,"_28235":86859,"_5797":87233},[],"**Information**",{"_6892":3227,"_42174":3091,"_29767":87235,"_5":21387,"_28235":86859,"_5797":87236},[],"The distribution sets it carries, and **Up to date** or **Outdated** against the declared target",{"_6892":3228,"_42174":3091,"_29767":87238,"_5":21387,"_28235":86859,"_5797":87239},[],"**Update Status**",{"_6892":3229,"_42174":3091,"_29767":87241,"_5":21387,"_28235":86859,"_5797":87242},[],"Native: the WFX event workflow. hawkBit: the current update with Assigned, Installing and Installed steps",{"_6892":3230,"_42174":3091,"_29767":87244,"_5":21387,"_28235":86859,"_5797":87245},[],"**Package Inventory**",{"_6892":3231,"_42174":3091,"_29767":87247,"_5":21387,"_28235":86859,"_5797":87248},[],"**Installed Distribution Sets** with their artifacts, and the **Pack Update History**",{"_6892":3232,"_42174":3091,"_29767":87250,"_5":21387,"_28235":86859,"_5797":87251},[],"**Jobs**",{"_6892":3233,"_42174":3091,"_29767":87253,"_5":21387,"_28235":86859,"_5797":87254},[],"The device's WFX jobs",{"_6892":3234,"_42174":3091,"_29767":87256,"_5":21387,"_28235":86859,"_5797":87257},[],"Use &#x2A;*Launch Update...** in the device's actions menu to send one version to one device. The dialog **Launch update for device** asks for the device group (when the device is in several), the distribution set, the version and the workflow (or install mode), and creates one job. The pack's own actions menu has **Targeted Update**, which does the same for devices you tick in a list, always with the `direct` workflow, and it is enabled once the pack is built. On **OTA Devices**, select devices of one group and press **Update** to do it for many devices; the button is disabled when the selection spans several groups.",{"_6892":3235,"_42174":3091,"_29767":87259,"_5":21387,"_28235":86859,"_5797":87260},[],"**OTA Dashboard**, **OTA Devices** and **OTA Device Groups** show version compliance: which devices are up to date, behind a declared target, or have no target. A group's page also lists the version each device runs against the group's released version, with an **Update to vX** button for the outdated ones. Without version-compliance support on the backend they still list devices and campaigns, but target versions show as **No target** or an em dash, with the alert \"Target versions unavailable on this backend\".",{"_6892":3236,"_42174":3091,"_29767":87262,"_5":21387,"_28235":86863,"_5797":87263},[],"Screen",{"_6892":3237,"_42174":3091,"_29767":87265,"_5":21387,"_28235":86863,"_5797":85301},[],{"_6892":3238,"_42174":3091,"_29767":87267,"_5":21387,"_28235":86863,"_5797":85304},[],{"_6892":3239,"_42174":3091,"_29767":87269,"_5":21387,"_28235":86863,"_5797":87270},[],"Pack list",{"_6892":3240,"_42174":3091,"_29767":87272,"_5":21387,"_28235":86863,"_5797":87273},[],"Status, packaging and **Built / Not built / Build failed** tiles",{"_6892":3241,"_42174":3091,"_29767":87275,"_5":21387,"_28235":86863,"_5797":87276},[],"Those tiles, the status filter and column are hidden. A set has no build state of its own: it is ready when all its modules are built, and **Start Campaign** stays disabled until then",{"_6892":3242,"_42174":3091,"_29767":87278,"_5":21387,"_28235":86863,"_5797":87279},[],"New pack",{"_6892":3243,"_42174":3091,"_29767":87281,"_5":21387,"_28235":86863,"_5797":87282},[],"No modules section",{"_6892":3244,"_42174":3091,"_29767":87284,"_5":21387,"_28235":86863,"_5797":87285},[],"Required **Software modules** section",{"_6892":3245,"_42174":3091,"_29767":87287,"_5":21387,"_28235":86863,"_5797":87288},[],"Pack page header",{"_6892":3246,"_42174":3091,"_29767":87290,"_5":21387,"_28235":86863,"_5797":87291},[],"**Generate SWU** and **Download SWU** (or **Generate Package** and **Download Package**)",{"_6892":3247,"_42174":3091,"_29767":87293,"_5":21387,"_28235":86863,"_5797":87294},[],"A **Software modules** button instead: build in the catalog",{"_6892":3248,"_42174":3091,"_29767":87296,"_5":21387,"_28235":86863,"_5797":87297},[],"Pack page tabs",{"_6892":3249,"_42174":3091,"_29767":87299,"_5":21387,"_28235":86863,"_5797":87300},[],"**Overview**, **Software Modules**, **Contents**, **Manifest**, **Version History** (composition is supported, so there is no pack-level **Artifacts** tab)",{"_6892":3250,"_42174":3091,"_29767":87302,"_5":21387,"_28235":86863,"_5797":87303},[],"The same. The **Artifacts** tab appears instead only if the hawkBit server lacks the module types",{"_6892":3251,"_42174":3091,"_29767":87305,"_5":21387,"_28235":86863,"_5797":87306},[],"Security",{"_6892":3252,"_42174":3091,"_29767":87308,"_5":21387,"_28235":86863,"_5797":87309},[],"On the **Generate SWU** sheet",{"_6892":3253,"_42174":3091,"_29767":87311,"_5":21387,"_28235":86863,"_5797":87312},[],"Per module",{"_6892":3254,"_42174":3091,"_29767":87314,"_5":21387,"_28235":86863,"_5797":87315},[],"Campaign form",{"_6892":3255,"_42174":3091,"_29767":87317,"_5":21387,"_28235":86863,"_5797":87318},[],"**Workflow**: Direct, Phased or any registered WFX workflow",{"_6892":3256,"_42174":3091,"_29767":87320,"_5":21387,"_28235":86863,"_5797":87321},[],"**Install mode**: **Forced** or **Soft**",{"_6892":3257,"_42174":3091,"_29767":87323,"_5":21387,"_28235":86863,"_5797":87324},[],"Error threshold",{"_6892":3258,"_42174":3091,"_29767":87326,"_5":21387,"_28235":86863,"_5797":87327},[],"The campaign is cancelled once this % of all its devices have failed",{"_6892":3259,"_42174":3091,"_29767":87329,"_5":21387,"_28235":86863,"_5797":87330},[],"The campaign stops when more than this % of a batch fails",{"_6892":3260,"_42174":3091,"_29767":87332,"_5":21387,"_28235":86863,"_5797":87333},[],"**Update Status** tab",{"_6892":3261,"_42174":3091,"_29767":87335,"_5":21387,"_28235":86863,"_5797":87336},[],"WFX event workflow",{"_6892":3262,"_42174":3091,"_29767":87338,"_5":21387,"_28235":86863,"_5797":87339},[],"hawkBit action steps",{"_6892":3263,"_42174":3091,"_29767":87341,"_5":21387,"_28235":86863,"_5797":87342},[],"Edit a running rollout",{"_6892":3264,"_42174":3091,"_29767":87344,"_5":21387,"_28235":86863,"_5797":87345},[],"Supported",{"_6892":3265,"_42174":3091,"_29767":87347,"_5":21387,"_28235":86863,"_5797":87348},[],"Not supported",{"_6892":3266,"_42174":3091,"_29767":87350,"_5":21387,"_28235":86863,"_5797":87351},[],"Module catalog",{"_6892":3267,"_42174":3091,"_29767":87353,"_5":21387,"_28235":86863,"_5797":87354},[],"Modules are created without a set or added to a pack, and import copies them",{"_6892":3268,"_42174":3091,"_29767":87356,"_5":21387,"_28235":86863,"_5797":87357},[],"Modules are built in the catalog, and a pack links them",{"_6892":3269,"_42174":3091,"_29767":87359,"_5":21387,"_28235":86863,"_5797":87360},[],"The **Manifest** tab (the signed version manifest) appears only when the backend supports artifact signatures.",{"_6892":3270,"_42174":3091,"_29767":87362,"_5":21387,"_28235":86867,"_5797":87363},[],"These API features have no screen: marking a campaign complete (`/complete`), syncing all of a device's sets to the group's latest versions at once (`/sync-to-latest`), and declaring a group's latest version. Use the API for them. To push one set to one device, &#x2A;*Launch Update...** and the per-device **Update to vX** button on a group's page do it.",{"_6892":3271,"_42174":3091,"_29767":87365,"_5":21387,"_28235":86871,"_5797":84046},[],{"_6892":3272,"_42174":3091,"_29767":87367,"_5":21387,"_28235":86871,"_5797":86538},[],{"_6892":3273,"_42174":3091,"_29767":87369,"_5":21387,"_28235":86871,"_5797":87370},[],"Screens or buttons that should exist are missing",{"_6892":3274,"_42174":3091,"_29767":87372,"_5":21387,"_28235":86871,"_5797":87373},[],"The capabilities request succeeded and the backend does not support them. Check **Updates backend** in the user menu (development builds) or `GET /updates/v1/capabilities`",{"_6892":3275,"_42174":3091,"_29767":87375,"_5":21387,"_28235":86871,"_5797":87376},[],"Update screens fail to load or show errors",{"_6892":3276,"_42174":3091,"_29767":87378,"_5":21387,"_28235":86871,"_5797":87379},[],"`LAMASSU_UPDATES_API` points at the wrong service or port, or your gateway does not route `/updates/v1`",{"_6892":3277,"_42174":3091,"_29767":87381,"_5":21387,"_28235":86871,"_5797":87382},[],"**Start Campaign** is disabled",{"_6892":3278,"_42174":3091,"_29767":87384,"_5":21387,"_28235":86871,"_5797":87385},[],"The pack is not built (native), or not every module is built (hawkBit)",{"_6892":3279,"_42174":3091,"_29767":87387,"_5":21387,"_28235":86871,"_5797":87388},[],"No device group is offered when creating a pack",{"_6892":3280,"_42174":3091,"_29767":87390,"_5":21387,"_28235":86871,"_5797":87391},[],"No device group exists yet. Create one under **Device Groups**",{"_6892":3281,"_42174":3091,"_29767":87393,"_5":21387,"_28235":86871,"_5797":87394},[],"A campaign looks stuck in **Rolling Out** after devices finished",{"_6892":3282,"_42174":3091,"_29767":87396,"_5":21387,"_28235":86871,"_5797":87397},[],"The workflow does not match the pack's driver. SWU packs need **Direct** or **Phased**; Generic packs need **Download-Install**",{"_6892":3283,"_42174":3091,"_29767":87399,"_5":21387,"_28235":86874,"_5797":87400},[],"<Card title=\"Publish and roll out an update\" href=\"/docs/platform/updates/guides/publish-and-roll-out\" description=\"The same flow as API requests.\" />",{"_6892":3284,"_42174":3091,"_29767":87402,"_5":21387,"_28235":86874,"_5797":87403},[],"<Card title=\"Concepts\" href=\"/docs/platform/updates/concepts\" description=\"Packs, modules, campaigns and workflows.\" />",{"_6892":3285,"_42174":3091,"_29767":87405,"_5":21387,"_28235":86874,"_5797":87406},[],"<Card title=\"Capabilities\" href=\"/docs/platform/updates/reference/capabilities\" description=\"What each backend supports and what the UI hides.\" />",{"_6892":3286,"_42174":3286,"_5":21817,"_5797":87408,"_42654":87409,"_29767":87410,"_28235":3286},"Update flow with curl, hawkBit backend",[77248,78697,85231,86581],[],{"_6892":3287,"_42174":3286,"_29767":87412,"_5":21387,"_28235":3286,"_5797":87413},[],"Every request of a complete update in hawkBit mode, including the device side over DDI, with real responses.",{"_6892":3288,"_42174":3286,"_5":42651,"_29767":87415,"_28235":87416,"_5797":77258},[],"/docs/pr-preview/pr-56/platform/updates/guides/hawkbit-curl#before-you-begin",{"_6892":3289,"_42174":3286,"_5":42651,"_29767":87418,"_28235":87419,"_5797":87420},[],"/docs/pr-preview/pr-56/platform/updates/guides/hawkbit-curl#1-check-the-backend","1\\. Check the backend",{"_6892":3290,"_42174":3286,"_5":42651,"_29767":87422,"_28235":87423,"_5797":87424},[],"/docs/pr-preview/pr-56/platform/updates/guides/hawkbit-curl#2-create-a-module-in-the-catalog","2\\. Create a module in the catalog",{"_6892":3291,"_42174":3286,"_5":42651,"_29767":87426,"_28235":87427,"_5797":87428},[],"/docs/pr-preview/pr-56/platform/updates/guides/hawkbit-curl#3-upload-the-file-and-the-sw-description","3\\. Upload the file and the sw-description",{"_6892":3292,"_42174":3286,"_5":42651,"_29767":87430,"_28235":87431,"_5797":87432},[],"/docs/pr-preview/pr-56/platform/updates/guides/hawkbit-curl#4-build-the-module","4\\. Build the module",{"_6892":3293,"_42174":3286,"_5":42651,"_29767":87434,"_28235":87435,"_5797":87436},[],"/docs/pr-preview/pr-56/platform/updates/guides/hawkbit-curl#5-create-the-pack-from-the-built-module","5\\. Create the pack from the built module",{"_6892":3294,"_42174":3286,"_5":42651,"_29767":87438,"_28235":87439,"_5797":87440},[],"/docs/pr-preview/pr-56/platform/updates/guides/hawkbit-curl#6-preview-the-launch-then-create-it","6\\. Preview the launch, then create it",{"_6892":3295,"_42174":3286,"_5":42651,"_29767":87442,"_28235":87443,"_5797":87444},[],"/docs/pr-preview/pr-56/platform/updates/guides/hawkbit-curl#7-start-the-rollout","7\\. Start the rollout",{"_6892":3296,"_42174":3286,"_5":42651,"_29767":87446,"_28235":87447,"_5797":87448},[],"/docs/pr-preview/pr-56/platform/updates/guides/hawkbit-curl#8-play-the-device-ddi","8\\. Play the device (DDI)",{"_6892":3297,"_42174":3286,"_5":42651,"_29767":87450,"_28235":87451,"_5797":87452},[],"/docs/pr-preview/pr-56/platform/updates/guides/hawkbit-curl#9-release-the-next-batches","9\\. Release the next batches",{"_6892":3298,"_42174":3286,"_5":42651,"_29767":87454,"_28235":87455,"_5797":87456},[],"/docs/pr-preview/pr-56/platform/updates/guides/hawkbit-curl#10-check-the-result","10\\. Check the result",{"_6892":3299,"_42174":3286,"_5":42651,"_29767":87458,"_28235":87459,"_5797":87460},[],"/docs/pr-preview/pr-56/platform/updates/guides/hawkbit-curl#things-that-behave-differently","Things that behave differently",{"_6892":3300,"_42174":3286,"_5":42651,"_29767":87462,"_28235":87463,"_5797":81275},[],"/docs/pr-preview/pr-56/platform/updates/guides/hawkbit-curl#troubleshooting",{"_6892":3301,"_42174":3286,"_5":42651,"_29767":87465,"_28235":87466,"_5797":80372},[],"/docs/pr-preview/pr-56/platform/updates/guides/hawkbit-curl#next-steps",{"_6892":3302,"_42174":3286,"_29767":87468,"_5":21387,"_28235":3286,"_5797":87469},[],"The same update as in the native guide, against the service in hawkBit mode. The management requests go to Lamassu Updates. The device side is a different protocol: devices poll hawkBit's DDI API, not this service and not WFX. The commands were run against a real hawkBit 1.1.0, and the responses are real, trimmed where long. Examples that say they were not run were checked against the code only.",{"_6892":3303,"_42174":3286,"_29767":87471,"_5":21387,"_28235":3286,"_5797":87472},[],"The differences from native mode, in short:",{"_6892":3304,"_42174":3286,"_29767":87474,"_5":21387,"_28235":3286,"_5797":85301},[],{"_6892":3305,"_42174":3286,"_29767":87476,"_5":21387,"_28235":3286,"_5797":85304},[],{"_6892":3306,"_42174":3286,"_29767":87478,"_5":21387,"_28235":3286,"_5797":87479},[],"Build",{"_6892":3307,"_42174":3286,"_29767":87481,"_5":21387,"_28235":3286,"_5797":87482},[],"Upload artifacts and a sw-description to the pack, then build the pack",{"_6892":3308,"_42174":3286,"_29767":87484,"_5":21387,"_28235":3286,"_5797":87485},[],"Build a **module** in the catalog first, then create the pack from it",{"_6892":3309,"_42174":3286,"_29767":87487,"_5":21387,"_28235":3286,"_5797":87488},[],"Pack after creation",{"_6892":3310,"_42174":3286,"_29767":87490,"_5":21387,"_28235":3286,"_5797":85673},[],{"_6892":3311,"_42174":3286,"_29767":87492,"_5":21387,"_28235":3286,"_5797":87493},[],"Already `built`",{"_6892":3312,"_42174":3286,"_29767":87495,"_5":21387,"_28235":3286,"_5797":87496},[],"Who tells the device",{"_6892":3313,"_42174":3286,"_29767":87498,"_5":21387,"_28235":3286,"_5797":87499},[],"WFX job",{"_6892":3314,"_42174":3286,"_29767":87501,"_5":21387,"_28235":3286,"_5797":87502},[],"hawkBit action, read over DDI",{"_6892":3315,"_42174":3286,"_29767":87504,"_5":21387,"_28235":3286,"_5797":87505},[],"Device reports to",{"_6892":3316,"_42174":3286,"_29767":87507,"_5":21387,"_28235":3286,"_5797":85441},[],{"_6892":3317,"_42174":3286,"_29767":87509,"_5":21387,"_28235":3286,"_5797":87510},[],"hawkBit (DDI feedback)",{"_6892":3318,"_42174":3286,"_29767":87512,"_5":21387,"_28235":3286,"_5797":87513},[],"Next batch, with `auto` on",{"_6892":3319,"_42174":3286,"_29767":87515,"_5":21387,"_28235":3286,"_5797":87516},[],"The service, from WFX events",{"_6892":3320,"_42174":3286,"_29767":87518,"_5":21387,"_28235":3286,"_5797":87519},[],"hawkBit, from its rollout groups",{"_6892":3321,"_42174":3286,"_29767":87521,"_5":21387,"_28235":87416,"_5797":87522},[],"The stack is running in hawkBit mode: this service, its Postgres, hawkBit and the Lamassu device manager.",{"_6892":3322,"_42174":3286,"_29767":87524,"_5":21387,"_28235":87416,"_5797":87525},[],"A device group in Lamassu with devices in it. This guide uses `fleet-a` with `dev-001` to `dev-004`.",{"_6892":3323,"_42174":3286,"_29767":87527,"_5":21387,"_28235":87416,"_5797":87528},[],"`curl` and `jq`.",{"_6892":3324,"_42174":3286,"_29767":87530,"_5":21387,"_28235":87416,"_5797":87531},[],"A SWU builder configured (`swugenerator_path`), to build a `swu-build` module. Without one, `POST .../build` on such a module answers `501`.",{"_6892":3325,"_42174":3286,"_29767":87533,"_5":21387,"_28235":87416,"_5797":87534},[],"`config-hawkbit.yml` in the repository serves the API on port `10090`, like the native stack, so run one backend at a time on that port. `config-hawkbit-demo.yml` serves it on `10091`, which the repository's dashboard development setup points at for the hawkBit backend. Set `API` to wherever your instance listens. Through a Lamassu gateway the API is usually `https://lamassu.example.com/api/updates/v1` and each call needs your gateway credential, for example `-H \"Authorization: Bearer $TOKEN\"`.",{"_6892":3326,"_42174":3286,"_29767":87536,"_5":21387,"_28235":87419,"_5797":87537},[],"`artifact_encryption`, `software_module_composition`, `standalone_software_modules` and `software_module_replace` appear in that list too if the build settings or hawkBit's module types are missing. See Capabilities.",{"_6892":3327,"_42174":3286,"_29767":87539,"_5":21387,"_28235":87423,"_5797":87540},[],"A hawkBit distribution set can only link **built** modules, so the module comes first. `delivery_intent` says how it ships: `swu-build` builds a `.swu` from your files and a sw-description. See hawkBit mode for the other intents (`swu-prebuilt`, `raw`).",{"_6892":3328,"_42174":3286,"_29767":87542,"_5":21387,"_28235":87423,"_5797":87543},[],"`type` is `os` or `application`, and `type`, `name` and `version` are required. Without a `delivery_intent` the module is `undecided`, which accepts files but cannot be built or linked until you choose one with `PUT /softwaremodules/by-id/$MID`.",{"_6892":3329,"_42174":3286,"_29767":87545,"_5":21387,"_28235":87427,"_5797":87546},[],"Use the same `index.html` and `sw-description` as in the native guide.",{"_6892":3330,"_42174":3286,"_29767":87548,"_5":21387,"_28235":87427,"_5797":87549},[],"A `swu-build` module refuses a finished `.swu` as input, and a `swu-prebuilt` module takes exactly one `.swu`.",{"_6892":3331,"_42174":3286,"_29767":87551,"_5":21387,"_28235":87431,"_5797":87552},[],"Building replaced the module's input files with the finished `.swu`. The build body is optional. To encrypt or sign, send `user`, `encryption_key_name`, `encryption_alg_name`, `signature_key_id`, `signature_alg_name` and `signature_certificate`, as in the signing and encryption page. A module can be built once: to change it, release a new version of the module.",{"_6892":3332,"_42174":3286,"_29767":87554,"_5":21387,"_28235":87435,"_5797":87555},[],"The pack is built from the start. Its `uri` is a hawkBit download address that devices resolve themselves. In hawkBit mode `modules` takes only `source_module_id` entries, and each module must be built and compatible with the pack's packaging. Several entries make a multi-module pack, and then `GET .../swu/download` answers `400`: download each module's deliverable with `GET .../modules/:moduleKey/artifact/download`.",{"_6892":3333,"_42174":3286,"_29767":87557,"_5":21387,"_28235":87439,"_5797":87558},[],"A group's devices only exist in hawkBit once the service has registered them. The service does that whenever it lists the group's devices, which a launch, a dry run, a job listing or a compliance read all do. The canary check runs **before** that, so on the first launch of a group that has not been listed yet, a `test_device_id` fails:",{"_6892":3334,"_42174":3286,"_29767":87560,"_5":21387,"_28235":87439,"_5797":87561},[],"Run the dry run without a canary first. It registers the group's devices in hawkBit as targets and tags them `group:fleet-a`:",{"_6892":3335,"_42174":3286,"_29767":87563,"_5":21387,"_28235":87439,"_5797":87564},[],"`never_seen_devices` lists targets that have not contacted hawkBit yet. A rollout group cannot finish while its devices never poll, so check this list. `superseded_devices` lists devices that already have an update in flight: creating the launch **cancels** those actions, because hawkBit replaces a target's unfinished actions with the new one. Now create the launch with the canary:",{"_6892":3336,"_42174":3286,"_29767":87566,"_5":21387,"_28235":87439,"_5797":87567},[],"`workflow_type` has no WFX meaning here: `phased` makes a hawkBit `soft` action (the device decides when to install) and anything else a `forced` one. Define a helper to follow the launch:",{"_6892":3337,"_42174":3286,"_29767":87569,"_5":21387,"_28235":87439,"_5797":87570},[],"To start the rollout later, add `scheduled_at` (RFC 3339) to the create body. hawkBit's own scheduler then starts it, and a `rollout` call before that time leaves the schedule alone. Not run here.",{"_6892":3338,"_42174":3286,"_29767":87572,"_5":21387,"_28235":87443,"_5797":87573},[],"The service started a hawkBit rollout: the canary in the first group and the rest after it.",{"_6892":3339,"_42174":3286,"_29767":87575,"_5":21387,"_28235":87447,"_5797":87576},[],"A real device runs SWUpdate's `suricatta`, which does this itself. These are the requests it makes.",{"_6892":3340,"_42174":3286,"_29767":87578,"_5":21387,"_28235":87447,"_5797":87579},[],"First, devices must authenticate. hawkBit's default is to refuse them. Enable security tokens for the tenant once, and read the target's token:",{"_6892":3341,"_42174":3286,"_29767":87581,"_5":21387,"_28235":87447,"_5797":87582},[],"This is the local setup. In a deployment where devices reach hawkBit through the Lamassu gateway, `hawkbit.ddi_url` is the gateway path (for example `https://lamassu.example.com/api/hawkbit-ddi`) and devices authenticate as the gateway requires, typically with their client certificate. See Connect a device.",{"_6892":3342,"_42174":3286,"_29767":87584,"_5":21387,"_28235":87447,"_5797":87585},[],"Poll. When there is work, the answer links to a `deploymentBase`:",{"_6892":3343,"_42174":3286,"_29767":87587,"_5":21387,"_28235":87447,"_5797":87588},[],"Read the deployment and download its artifact:",{"_6892":3344,"_42174":3286,"_29767":87590,"_5":21387,"_28235":87447,"_5797":87591},[],"When the service publishes the device artifact URL (the `ddi_url` path), it serves that same route itself, for modules in the device's assigned or installed set only, and with S3 presigning enabled it answers `302` to a short-lived signed URL. A device does not need to know the difference: it follows the redirect.",{"_6892":3345,"_42174":3286,"_29767":87593,"_5":21387,"_28235":87447,"_5797":87594},[],"Report progress and the result. `closed` with `finished: success` is the end:",{"_6892":3346,"_42174":3286,"_29767":87596,"_5":21387,"_28235":87447,"_5797":87597},[],"The service reads hawkBit when you ask, so the launch is up to date:",{"_6892":3347,"_42174":3286,"_29767":87599,"_5":21387,"_28235":87447,"_5797":87600},[],"To report a failure, send `\"finished\":\"failure\"` in the `closed` feedback.",{"_6892":3348,"_42174":3286,"_29767":87602,"_5":21387,"_28235":87451,"_5797":87603},[],"With `auto` off, hawkBit pauses after each group. Each `rollout` call releases the next one:",{"_6892":3349,"_42174":3286,"_29767":87605,"_5":21387,"_28235":87451,"_5797":87606},[],"Here a hawkBit action is shown as a workflow state: a scheduled action is `CREATED`, a running one `DOWNLOADING` (hawkBit does not report finer steps), a finished one (or one that finished with a warning) `ACTIVATED`, and a failed, cancelled or cancelling one `TERMINATED`. Repeat step 8 for `dev-002` and `dev-003` (the token comes from each target), then call `rollout` once more for `dev-004`. When every action is finished:",{"_6892":3350,"_42174":3286,"_29767":87608,"_5":21387,"_28235":87451,"_5797":87609},[],"hawkBit decides when a batch is finished. After the last device of a batch reports, hawkBit pauses the rollout, and for a moment its group still reads `running`. The service cannot tell that pause from one an operator made, so a `rollout` call in that window answers `400` with `rollout 1 is paused; resume it first`. Call `resume` and hawkBit releases the next batch itself:",{"_6892":3351,"_42174":3286,"_29767":87611,"_5":21387,"_28235":87459,"_5797":87612},[],"**Automatic rollout.** With `auto: true`, hawkBit advances the groups itself once `approval_threshold` is met. The service does not run an event consumer in this mode. The thresholds are set on every rollout group, and hawkBit evaluates both percentages **per group**, not against all devices as native does. An unset or `0` threshold becomes 100, so an unset `error_threshold` never trips. The canary group always needs 100%. They apply with `auto` off too.",{"_6892":3352,"_42174":3286,"_29767":87614,"_5":21387,"_28235":87459,"_5797":87615},[],"**A tripped error threshold.** hawkBit then pauses the rollout, and the service reports the launch as `cancelled`. `resume` and `rollout` both answer `400` for it.",{"_6892":3353,"_42174":3286,"_29767":87617,"_5":21387,"_28235":87459,"_5797":87618},[],"**Pause and resume.** `pause` and `resume` map to hawkBit's rollout pause and resume, but only a pause an operator made can be resumed. hawkBit already holds the rollout between groups when `auto` is off, so `pause` then answers `400` (\"Rollout can only be paused in state running but current state is paused\") and `resume` answers `400` (\"not paused; use Execute to release the next batch\"). Use `rollout` to release the next group.",{"_6892":3354,"_42174":3286,"_29767":87620,"_5":21387,"_28235":87459,"_5797":87621},[],"**Strategy read-back.** The strategy shown for a launch is derived from the hawkBit rollout's groups, not stored. A launch created with a fixed batch of 2 for 4 devices reads back as `percentage` 50.",{"_6892":3355,"_42174":3286,"_29767":87623,"_5":21387,"_28235":87459,"_5797":87624},[],"**Static membership.** A rollout is built from the devices of the group when the launch is created. Devices added to the group later are not picked up (`launch_device_assignment` is unsupported).",{"_6892":3356,"_42174":3286,"_29767":87626,"_5":21387,"_28235":87459,"_5797":87627},[],"**Not available.** Per-device encryption, custom workflows (`GET /workflows` returns an empty list), editing a running strategy, marking a launch complete, pushed job events (progress is polled), set-level prebuilt upload, and building a pack directly. `POST .../swu` answers `501`:",{"_6892":3357,"_42174":3286,"_29767":87629,"_5":21387,"_28235":87463,"_5797":84046},[],{"_6892":3358,"_42174":3286,"_29767":87631,"_5":21387,"_28235":87463,"_5797":87632},[],"Cause and fix",{"_6892":3359,"_42174":3286,"_29767":87634,"_5":21387,"_28235":87463,"_5797":87635},[],"`501` building a module: no SWU builder",{"_6892":3360,"_42174":3286,"_29767":87637,"_5":21387,"_28235":87463,"_5797":87638},[],"`swugenerator_path` is not configured. Configure it, or upload a prebuilt `.swu` with intent `swu-prebuilt`",{"_6892":3361,"_42174":3286,"_29767":87640,"_5":21387,"_28235":87463,"_5797":87641},[],"`501` building a module: no SymKMS or no KMS endpoint",{"_6892":3362,"_42174":3286,"_29767":87643,"_5":21387,"_28235":87463,"_5797":87644},[],"Encryption needs `symkms_endpoint` and signing needs `kms_endpoint`. Build without those fields, or configure them",{"_6892":3363,"_42174":3286,"_29767":87646,"_5":21387,"_28235":87463,"_5797":87647},[],"`400 ... is not built` creating a pack",{"_6892":3364,"_42174":3286,"_29767":87649,"_5":21387,"_28235":87463,"_5797":87650},[],"A module linked into a pack must be built first. Build it in the catalog",{"_6892":3365,"_42174":3286,"_29767":87652,"_5":21387,"_28235":87463,"_5797":87653},[],"`400 ... incompatible with distribution set packaging`",{"_6892":3366,"_42174":3286,"_29767":87655,"_5":21387,"_28235":87463,"_5797":87656},[],"A `raw` module cannot go into a `swu` pack, and a `swu-prebuilt` module cannot go into a `non-swu` pack",{"_6892":3367,"_42174":3286,"_29767":87658,"_5":21387,"_28235":87463,"_5797":87659},[],"`400 ... frozen` changing a module",{"_6892":3368,"_42174":3286,"_29767":87661,"_5":21387,"_28235":87463,"_5797":87662},[],"A module linked to a pack is frozen. Edit and build it in the catalog, then link it again",{"_6892":3369,"_42174":3286,"_29767":87664,"_5":21387,"_28235":87463,"_5797":87665},[],"`400 ... already built`",{"_6892":3370,"_42174":3286,"_29767":87667,"_5":21387,"_28235":87463,"_5797":87668},[],"A module is built once. Release a new version of the module",{"_6892":3371,"_42174":3286,"_29767":87670,"_5":21387,"_28235":87463,"_5797":87671},[],"`409 ... being built or changed by another request`",{"_6892":3372,"_42174":3286,"_29767":87673,"_5":21387,"_28235":87463,"_5797":87674},[],"Another request holds the module. Retry when it finishes",{"_6892":3373,"_42174":3286,"_29767":87676,"_5":21387,"_28235":87463,"_5797":87677},[],"Creating a module answers `400` mentioning that hawkBit reserves the name and version",{"_6892":3374,"_42174":3286,"_29767":87679,"_5":21387,"_28235":87463,"_5797":87680},[],"hawkBit keeps the name and version of a module that was assigned to a device, even after it is deleted. Use a new version",{"_6892":3375,"_42174":3286,"_29767":87682,"_5":21387,"_28235":87463,"_5797":87683},[],"The canary fails with `device ... does not exist`",{"_6892":3376,"_42174":3286,"_29767":87685,"_5":21387,"_28235":87463,"_5797":87686},[],"The group's devices are not in hawkBit yet. Run a dry run without `test_device_id` first",{"_6892":3377,"_42174":3286,"_29767":87688,"_5":21387,"_28235":87463,"_5797":87689},[],"A launch never advances",{"_6892":3378,"_42174":3286,"_29767":87691,"_5":21387,"_28235":87463,"_5797":87692},[],"Check `never_seen_devices`: a device that never polls blocks its rollout group",{"_6892":3379,"_42174":3286,"_29767":87694,"_5":21387,"_28235":87466,"_5797":87695},[],"hawkBit mode for modules, delivery intents and what lives where",{"_6892":3380,"_42174":3286,"_29767":87697,"_5":21387,"_28235":87466,"_5797":87698},[],"Connect a device for the device-side setup",{"_6892":3381,"_42174":3286,"_29767":87700,"_5":21387,"_28235":87466,"_5797":87701},[],"API reference",{"_6892":3382,"_42174":3286,"_29767":87703,"_5":21387,"_28235":87466,"_5797":81275},[],{"_6892":3383,"_42174":3383,"_5":21817,"_5797":87705,"_42654":87706,"_29767":87707,"_28235":3383},"Update flow with curl, native backend",[77248,78697,85231,86581],[],{"_6892":3384,"_42174":3383,"_29767":87709,"_5":21387,"_28235":3383,"_5797":87710},[],"Every request of a complete update in native mode, from creating a pack to the last device, with real responses.",{"_6892":3385,"_42174":3383,"_5":42651,"_29767":87712,"_28235":87713,"_5797":77258},[],"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#before-you-begin",{"_6892":3386,"_42174":3383,"_5":42651,"_29767":87715,"_28235":87716,"_5797":87420},[],"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#1-check-the-backend",{"_6892":3387,"_42174":3383,"_5":42651,"_29767":87718,"_28235":87719,"_5797":87720},[],"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#2-create-the-pack","2\\. Create the pack",{"_6892":3388,"_42174":3383,"_5":42651,"_29767":87722,"_28235":87723,"_5797":87724},[],"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#3-upload-the-sw-description-and-the-artifact","3\\. Upload the sw-description and the artifact",{"_6892":3389,"_42174":3383,"_5":42651,"_29767":87726,"_28235":87727,"_5797":87728},[],"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#4-build-the-swu","4\\. Build the `.swu`",{"_6892":3390,"_42174":3383,"_5":42651,"_29767":87730,"_28235":87731,"_5797":87732},[],"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#5-preview-then-create-the-launch","5\\. Preview, then create the launch",{"_6892":3391,"_42174":3383,"_5":42651,"_29767":87734,"_28235":87735,"_5797":87736},[],"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#6-roll-out-the-canary","6\\. Roll out the canary",{"_6892":3392,"_42174":3383,"_5":42651,"_29767":87738,"_28235":87739,"_5797":87740},[],"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#7-play-the-device","7\\. Play the device",{"_6892":3393,"_42174":3383,"_5":42651,"_29767":87742,"_28235":87743,"_5797":87744},[],"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#8-roll-out-the-rest","8\\. Roll out the rest",{"_6892":3394,"_42174":3383,"_5":42651,"_29767":87746,"_28235":87747,"_5797":87748},[],"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#9-check-the-result","9\\. Check the result",{"_6892":3395,"_42174":3383,"_5":42651,"_29767":87750,"_28235":87751,"_5797":87752},[],"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#variations","Variations",{"_6892":3396,"_42174":3383,"_5":42651,"_29767":87754,"_28235":87755,"_5797":87756},[],"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#let-the-service-release-the-batches","Let the service release the batches",{"_6892":3397,"_42174":3383,"_5":42651,"_29767":87758,"_28235":87759,"_5797":87760},[],"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#pause-resume-retry-and-cancel","Pause, resume, retry and cancel",{"_6892":3398,"_42174":3383,"_5":42651,"_29767":87762,"_28235":87763,"_5797":87764},[],"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#schedule-a-launch","Schedule a launch",{"_6892":3399,"_42174":3383,"_5":42651,"_29767":87766,"_28235":87767,"_5797":87768},[],"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#require-a-version-before-updating","Require a version before updating",{"_6892":3400,"_42174":3383,"_5":42651,"_29767":87770,"_28235":87771,"_5797":87772},[],"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#update-one-device-to-a-version","Update one device to a version",{"_6892":3401,"_42174":3383,"_5":42651,"_29767":87774,"_28235":87775,"_5797":87776},[],"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#a-new-version","A new version",{"_6892":3402,"_42174":3383,"_5":42651,"_29767":87778,"_28235":87779,"_5797":87780},[],"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#encrypt-with-a-shared-key","Encrypt with a shared key",{"_6892":3403,"_42174":3383,"_5":42651,"_29767":87782,"_28235":87783,"_5797":87784},[],"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#encrypt-per-device","Encrypt per device",{"_6892":3404,"_42174":3383,"_5":42651,"_29767":87786,"_28235":87787,"_5797":87788},[],"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#sign-the-package","Sign the package",{"_6892":3405,"_42174":3383,"_5":42651,"_29767":87790,"_28235":87791,"_5797":81275},[],"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#troubleshooting",{"_6892":3406,"_42174":3383,"_5":42651,"_29767":87793,"_28235":87794,"_5797":80372},[],"/docs/pr-preview/pr-56/platform/updates/guides/native-curl#next-steps",{"_6892":3407,"_42174":3383,"_29767":87796,"_5":21387,"_28235":3383,"_5797":87797},[],"A complete update, request by request: create a pack, build it, send it to a group in batches, play the device, and follow progress. Every command was run against a native-mode stack, and the responses are real, trimmed where long, except where a section says it was not run: those examples were checked against the code only.",{"_6892":3408,"_42174":3383,"_29767":87799,"_5":21387,"_28235":3383,"_5797":87800},[],"If you use the hawkBit backend the flow differs, mainly in how a pack is built and how devices report. For the screens that do the same, see the dashboard guide.",{"_6892":3409,"_42174":3383,"_29767":87802,"_5":21387,"_28235":87713,"_5797":87803},[],"The stack is running in native mode: the service, Postgres, WFX and the Lamassu device manager.",{"_6892":3410,"_42174":3383,"_29767":87805,"_5":21387,"_28235":87713,"_5797":87806},[],"A device group exists in Lamassu with devices in it. This guide uses the group `fleet-a` with the devices `dev-001` to `dev-004`.",{"_6892":3411,"_42174":3383,"_29767":87808,"_5":21387,"_28235":87713,"_5797":87809},[],"`curl` and `jq` are installed. `jq` is only used to pull values out of responses.",{"_6892":3412,"_42174":3383,"_29767":87811,"_5":21387,"_28235":87713,"_5797":87812},[],"These are the addresses of the Docker Compose stack in the repository. Through a Lamassu gateway the API is usually `https://lamassu.example.com/api/updates/v1`, and every call then needs the credential your gateway requires, for example `-H \"Authorization: Bearer $TOKEN\"`. The service itself does no authentication. See Security.",{"_6892":3413,"_42174":3383,"_29767":87814,"_5":21387,"_28235":87719,"_5797":87815},[],"The pack is `draft`. It stays editable until it is built. `name`, `version` (semver) and `group_id` are required; the name must be unique in the group, or the request answers `409`.",{"_6892":3414,"_42174":3383,"_29767":87817,"_5":21387,"_28235":87723,"_5797":87818},[],"The sw-description tells SWUpdate what to install. This minimal one installs a web page. See the sw-description rules in Publish and roll out an update.",{"_6892":3415,"_42174":3383,"_29767":87820,"_5":21387,"_28235":87723,"_5797":87821},[],"The artifact name is global: all packs share one catalog, and a name can only be reused with a **higher** `version`. Uploading `index.html` again as `1.0.0` fails with `version 1.0.0 must be greater than the current latest version`. A file named `.swu` or `.tar.gz` must really be one, or the upload answers `400`.",{"_6892":3416,"_42174":3383,"_29767":87823,"_5":21387,"_28235":87727,"_5797":87824},[],"`selected_artifact_ids` is what puts artifacts into the build. Without it the build fails.",{"_6892":3417,"_42174":3383,"_29767":87826,"_5":21387,"_28235":87727,"_5797":87827},[],"The `uri` starts with the service's `update_domain`. In the Compose stack that is `http://updates:10090/updates/v1/` (`config-docker.yml`), a name that resolves only inside the Compose network, because it is the address devices use. From your host, call the same path on `localhost:10090`, as the next command does.",{"_6892":3418,"_42174":3383,"_29767":87829,"_5":21387,"_28235":87727,"_5797":87830},[],"The pack is now `built`: artifacts can no longer be added or linked to it. You can fetch the shared package (this one is not encrypted):",{"_6892":3419,"_42174":3383,"_29767":87832,"_5":21387,"_28235":87727,"_5797":87833},[],"Downloads support `Range` and `HEAD`, so a client can learn the size first and resume an interrupted transfer, for example with `curl -C - -o water.swu $P/swu/download`. With S3 storage and presigning enabled, the same request can answer `302` to a short-lived signed URL, which `curl -L` follows.",{"_6892":3420,"_42174":3383,"_29767":87835,"_5":21387,"_28235":87727,"_5797":87836},[],"If the build fails, the pack gets the status `build_failed` and `last_build_error` holds the reason. It stays editable: fix the cause and build again.",{"_6892":3421,"_42174":3383,"_29767":87838,"_5":21387,"_28235":87731,"_5797":87839},[],"A dry run shows who would receive the update, without creating anything:",{"_6892":3422,"_42174":3383,"_29767":87841,"_5":21387,"_28235":87731,"_5797":87842},[],"Create it. `test_device_id` is the canary: it goes alone first and must succeed before anyone else is touched. `rollout_value` 2 means batches of two devices.",{"_6892":3423,"_42174":3383,"_29767":87844,"_5":21387,"_28235":87731,"_5797":87845},[],"A small helper makes the launch easy to follow in the next steps:",{"_6892":3424,"_42174":3383,"_29767":87847,"_5":21387,"_28235":87735,"_5797":87848},[],"An empty `status` means running. Only the canary is active. The service created one WFX job for `dev-001`:",{"_6892":3425,"_42174":3383,"_29767":87850,"_5":21387,"_28235":87739,"_5797":87851},[],"A real device does this by itself. These commands are what it sends to WFX, so you can drive a test device by hand. First the device asks WFX for its job:",{"_6892":3426,"_42174":3383,"_29767":87853,"_5":21387,"_28235":87739,"_5797":87854},[],"The device downloads the `uri`, installs it, and reports each step:",{"_6892":3427,"_42174":3383,"_29767":87856,"_5":21387,"_28235":87739,"_5797":87857},[],"The `direct` workflow is `INSTALL → INSTALLING → INSTALLED → ACTIVATE → ACTIVATING → ACTIVATED`. WFX itself makes the `INSTALLED → ACTIVATE` step. To report a failure, move a job to `TERMINATED`.",{"_6892":3428,"_42174":3383,"_29767":87859,"_5":21387,"_28235":87739,"_5797":87860},[],"The service hears about every change from WFX through its event stream and updates the launch. This takes a moment, so if `status` still shows the device as active, run it again after a second:",{"_6892":3429,"_42174":3383,"_29767":87862,"_5":21387,"_28235":87743,"_5797":87863},[],"The canary passed. Each `rollout` call now sends the next batch of two:",{"_6892":3430,"_42174":3383,"_29767":87865,"_5":21387,"_28235":87743,"_5797":87866},[],"Walk those devices through steps like in step 7, then call `rollout` again for the last device. When nothing is pending or active the launch completes by itself:",{"_6892":3431,"_42174":3383,"_29767":87868,"_5":21387,"_28235":87743,"_5797":87869},[],"`completed_count` counts only successes: a failed device is counted in `failed_count`. A launch is marked `completed` once nothing is pending or active, even if some devices failed, so check `failed_count` before you call the update a success.",{"_6892":3432,"_42174":3383,"_29767":87871,"_5":21387,"_28235":87747,"_5797":87872},[],"To track drift, declare the version devices should be on, then read compliance:",{"_6892":3433,"_42174":3383,"_29767":87874,"_5":21387,"_28235":87747,"_5797":87875},[],"The fleet-wide view of the last attempt per device and pack, including attempts outside any launch, is one call. Not run here; the brackets of a filter need `curl -g`:",{"_6892":3434,"_42174":3383,"_29767":87877,"_5":21387,"_28235":87755,"_5797":87878},[],"With `auto` on, the service sends the next batch itself once enough of the current one succeeded. `approval_threshold` is the percentage of the batch that must succeed (0 or 100 mean all of it). `error_threshold` applies to every launch, `auto` or not: the launch is cancelled once the number of failed devices reaches that percentage of **all** devices, rounded up. With 4 devices at 75%, the third failure cancels it.",{"_6892":3435,"_42174":3383,"_29767":87880,"_5":21387,"_28235":87755,"_5797":87881},[],"This example uses a second pack, `valve-panel`, created and built like `water-panel` (steps 2 to 4). Artifact names are global and a name that already exists must get a higher version, so give this one its own file name:",{"_6892":3436,"_42174":3383,"_29767":87883,"_5":21387,"_28235":87755,"_5797":87884},[],"Call `rollout` once to start. A second call is refused:",{"_6892":3437,"_42174":3383,"_29767":87886,"_5":21387,"_28235":87755,"_5797":87887},[],"If one device of the first batch fails (`TERMINATED`) and the other succeeds, 50% succeeded meets the threshold and the next batch is dispatched on its own.",{"_6892":3438,"_42174":3383,"_29767":87889,"_5":21387,"_28235":87759,"_5797":87890},[],"A pause lets the batch in flight finish and holds the next one. `retry-failed` puts the failed devices back in the pending pool and releases the next batch. That batch is drawn at random from all pending devices, so it can also contain devices that were never sent, and if more devices failed than fit in a batch only one batch goes out. It answers `400` when nothing failed, and it re-opens a completed or cancelled launch (`\"status\":\"running\"`). A failed canary pauses the launch by itself, and `resume` then sends the canary again. A cancelled launch cannot be resumed, and in-flight devices finish their current job.",{"_6892":3439,"_42174":3383,"_29767":87892,"_5":21387,"_28235":87763,"_5797":87893},[],"Not run here. `scheduled_at` (RFC 3339) delays the first batch. The service checks for due launches about every 30 seconds, so the start can be up to that late. A `rollout` call before the time does nothing.",{"_6892":3440,"_42174":3383,"_29767":87895,"_5":21387,"_28235":87763,"_5797":87896},[],"The schedule survives a restart and runs on whichever replica currently holds the leader role, so a scheduled launch is dispatched once even with several replicas.",{"_6892":3441,"_42174":3383,"_29767":87898,"_5":21387,"_28235":87767,"_5797":87899},[],"Not run here. A pack can require that a device already carries another pack, or a module, at a minimum version. The rule lives on the pack you launch. Devices that fail it are left out, and the dry run lists them:",{"_6892":3442,"_42174":3383,"_29767":87901,"_5":21387,"_28235":87767,"_5797":87902},[],"Each failure names the `device_id`, the `distribution_set_name` (and `module_key` for a module rule), the `current_version` the device has (empty if none) and the `required` constraint, for example `>=1.0.0`. Use `required_module_key` with a `type:name` value to require a module instead. `force_preconditions: true` in the launch body deploys to every device anyway and records the failures.",{"_6892":3443,"_42174":3383,"_29767":87904,"_5":21387,"_28235":87771,"_5797":87905},[],"Not run here. `force-version` launches a single device to an exact pack version, outside any campaign, and answers `202`. The device must be a member of the pack's group:",{"_6892":3444,"_42174":3383,"_29767":87907,"_5":21387,"_28235":87771,"_5797":87908},[],"Without `workflow`, a `swu` pack uses `phased`. Only the pack's current version can be forced, unless the pack was created with `allow_previous_version_download`.",{"_6892":3445,"_42174":3383,"_29767":87910,"_5":21387,"_28235":87775,"_5797":87911},[],"The version must be higher than the current one, and the pack keeps its id. The new version starts as `draft`. The artifact links and the module composition carry over, but the sw-description does not: upload it again. Then build with `selected_artifact_ids` (a build replaces the carried links with the ones you select), after uploading a new artifact version if the file changed.",{"_6892":3446,"_42174":3383,"_29767":87913,"_5":21387,"_28235":87779,"_5797":87914},[],"One key encrypts the `.swu` for every device. The sw-description must mark the files to encrypt with `encrypted = true;`. Use a separate pack for each encryption variant: a new version inherits the previous version's encryption settings, and a plain build does not clear them. Rebuilding an already built pack with other settings leaves stale fields too. See Limitations.",{"_6892":3447,"_42174":3383,"_29767":87916,"_5":21387,"_28235":87779,"_5797":87917},[],"This helper creates a pack, uploads a sw-description that marks its file `encrypted = true;`, and uploads the artifact. It prints the artifact id.",{"_6892":3448,"_42174":3383,"_29767":87919,"_5":21387,"_28235":87779,"_5797":87920},[],"The pack then reports `\"encryption_mode\":\"shared\"`. The device needs the same key and algorithm. See Signing and encryption.",{"_6892":3449,"_42174":3383,"_29767":87922,"_5":21387,"_28235":87783,"_5797":87923},[],"Each device gets its own package and key. This is another pack, built with the same helper. The sw-description must mark a file `encrypted = true;`, or the build is refused.",{"_6892":3450,"_42174":3383,"_29767":87925,"_5":21387,"_28235":87783,"_5797":87926},[],"If a device has no key at build time, the build still succeeds and the pack records the gap. If **no** device has a key, the build fails instead.",{"_6892":3451,"_42174":3383,"_29767":87928,"_5":21387,"_28235":87783,"_5797":87929},[],"A launch on that pack is refused, dry runs included, and `force_preconditions` does not override it:",{"_6892":3452,"_42174":3383,"_29767":87931,"_5":21387,"_28235":87783,"_5797":87932},[],"Coverage is recorded when the pack is built, so assigning the missing key is not enough. Build the pack again (a new version) with a key for every device.",{"_6892":3453,"_42174":3383,"_29767":87934,"_5":21387,"_28235":87787,"_5797":87935},[],"Add the KMS signing fields to the build body. They need a signing key and certificate in the Lamassu KMS, with `kms_endpoint` and `sign_script_path` set. This request was not run here, because it needs a KMS. See Signing and encryption.",{"_6892":3454,"_42174":3383,"_29767":87937,"_5":21387,"_28235":87791,"_5797":84046},[],{"_6892":3455,"_42174":3383,"_29767":87939,"_5":21387,"_28235":87791,"_5797":87632},[],{"_6892":3456,"_42174":3383,"_29767":87941,"_5":21387,"_28235":87791,"_5797":87942},[],"`409` on `artifact/upload` or `artifact/link`",{"_6892":3457,"_42174":3383,"_29767":87944,"_5":21387,"_28235":87791,"_5797":87945},[],"The pack version is already `built`. Create a new version with `POST .../new`",{"_6892":3458,"_42174":3383,"_29767":87947,"_5":21387,"_28235":87791,"_5797":87948},[],"`409` on `POST .../distribution-sets`",{"_6892":3459,"_42174":3383,"_29767":87950,"_5":21387,"_28235":87791,"_5797":87951},[],"A pack with that name already exists in the group",{"_6892":3460,"_42174":3383,"_29767":87953,"_5":21387,"_28235":87791,"_5797":87954},[],"`400 version ... must be greater than the current latest version`",{"_6892":3461,"_42174":3383,"_29767":87956,"_5":21387,"_28235":87791,"_5797":87957},[],"An artifact name is global and its version must increase. Upload with a higher `version`",{"_6892":3462,"_42174":3383,"_29767":87959,"_5":21387,"_28235":87791,"_5797":87960},[],"The build fails with an empty binaries directory",{"_6892":3463,"_42174":3383,"_29767":87962,"_5":21387,"_28235":87791,"_5797":87963},[],"The build received no `selected_artifact_ids`",{"_6892":3464,"_42174":3383,"_29767":87965,"_5":21387,"_28235":87791,"_5797":87966},[],"`400` creating a launch: pack has not been built",{"_6892":3465,"_42174":3383,"_29767":87968,"_5":21387,"_28235":87791,"_5797":87969},[],"Build it first. A pack in `build_failed` is not launchable either",{"_6892":3466,"_42174":3383,"_29767":87971,"_5":21387,"_28235":87791,"_5797":87972},[],"`400 ... is per-device encrypted and only N of M devices have a package`",{"_6892":3467,"_42174":3383,"_29767":87974,"_5":21387,"_28235":87791,"_5797":87975},[],"Some devices have no `firmware-encryption` key. Assign keys and build a new version",{"_6892":3468,"_42174":3383,"_29767":87977,"_5":21387,"_28235":87791,"_5797":87978},[],"`rollout` answers `400` with `rolls out automatically`",{"_6892":3469,"_42174":3383,"_29767":87980,"_5":21387,"_28235":87791,"_5797":87981},[],"The launch has `auto` on and already started. Wait for the approval threshold, or pause it",{"_6892":3470,"_42174":3383,"_29767":87983,"_5":21387,"_28235":87791,"_5797":87984},[],"`rollout` answers `400` with `test device ... failed`",{"_6892":3471,"_42174":3383,"_29767":87986,"_5":21387,"_28235":87791,"_5797":87987},[],"The canary failed. Resume the launch to retry it, or cancel",{"_6892":3472,"_42174":3383,"_29767":87989,"_5":21387,"_28235":87791,"_5797":87990},[],"`413` on an upload",{"_6892":3473,"_42174":3383,"_29767":87992,"_5":21387,"_28235":87791,"_5797":87993},[],"The file is over `max_artifact_size_mb` (10 GiB by default), or the gateway or ingress limit in front of the service is lower",{"_6892":3474,"_42174":3383,"_29767":87995,"_5":21387,"_28235":87791,"_5797":87996},[],"`501` on a module route",{"_6892":3475,"_42174":3383,"_29767":87998,"_5":21387,"_28235":87791,"_5797":87999},[],"Native mode has no per-module deliverables. Build the pack instead",{"_6892":3476,"_42174":3383,"_29767":88001,"_5":21387,"_28235":87794,"_5797":87408},[],{"_6892":3477,"_42174":3383,"_29767":88003,"_5":21387,"_28235":87794,"_5797":88004},[],"Connect a device for what a real device must implement",{"_6892":3478,"_42174":3383,"_29767":88006,"_5":21387,"_28235":87794,"_5797":87701},[],{"_6892":3479,"_42174":3383,"_29767":88008,"_5":21387,"_28235":87794,"_5797":81275},[],{"_6892":3480,"_42174":3480,"_5":21817,"_5797":88010,"_42654":88011,"_29767":88012,"_28235":3480},"Publish and roll out an update",[77248,78697,85231,86581],[],{"_6892":3481,"_42174":3480,"_29767":88014,"_5":21387,"_28235":3480,"_5797":88015},[],"Create an update pack, attach an artifact, build the deliverable and roll it out to a device group in batches.",{"_6892":3482,"_42174":3480,"_5":42651,"_29767":88017,"_28235":88018,"_5797":77258},[],"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#before-you-begin",{"_6892":3483,"_42174":3480,"_5":42651,"_29767":88020,"_28235":88021,"_5797":88022},[],"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#1-create-the-pack","1\\. Create the pack",{"_6892":3484,"_42174":3480,"_5":42651,"_29767":88024,"_28235":88025,"_5797":88026},[],"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#2-upload-the-sw-description-and-the-artifact","2\\. Upload the sw-description and the artifact",{"_6892":3485,"_42174":3480,"_5":42651,"_29767":88028,"_28235":88029,"_5797":88030},[],"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#compose-a-pack-from-several-modules-optional","Compose a pack from several modules (optional)",{"_6892":3486,"_42174":3480,"_5":42651,"_29767":88032,"_28235":88033,"_5797":88034},[],"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#3-build-the-deliverable","3\\. Build the deliverable",{"_6892":3487,"_42174":3480,"_5":42651,"_29767":88036,"_28235":88037,"_5797":88038},[],"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#4-create-the-launch","4\\. Create the launch",{"_6892":3488,"_42174":3480,"_5":42651,"_29767":88040,"_28235":88041,"_5797":88042},[],"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#5-roll-it-out","5\\. Roll it out",{"_6892":3489,"_42174":3480,"_5":42651,"_29767":88044,"_28235":88045,"_5797":84896},[],"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#verify-the-result",{"_6892":3490,"_42174":3480,"_5":42651,"_29767":88047,"_28235":88048,"_5797":88049},[],"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#ship-the-next-version","Ship the next version",{"_6892":3491,"_42174":3480,"_5":42651,"_29767":88051,"_28235":88052,"_5797":85247},[],"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#hawkbit-mode",{"_6892":3492,"_42174":3480,"_5":42651,"_29767":88054,"_28235":88055,"_5797":81275},[],"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#troubleshooting",{"_6892":3493,"_42174":3480,"_5":42651,"_29767":88057,"_28235":88058,"_5797":80372},[],"/docs/pr-preview/pr-56/platform/updates/guides/publish-and-roll-out#next-steps",{"_6892":3494,"_42174":3480,"_29767":88060,"_5":21387,"_28235":3480,"_5797":88061},[],"This guide takes one update from nothing to devices: create an update pack, attach an artifact and a `sw-description`, build the deliverable, create a launch (a campaign in the dashboard) and release it batch by batch. The requests use native mode. hawkBit mode builds and creates packs in a different order, described in hawkBit mode. To do the same through screens, follow Use the dashboard.",{"_6892":3495,"_42174":3480,"_29767":88063,"_5":21387,"_28235":88018,"_5797":88064},[],"The stack is running and `curl localhost:10090/health` answers.",{"_6892":3496,"_42174":3480,"_29767":88066,"_5":21387,"_28235":88018,"_5797":88067},[],"A Lamassu IoT device group that contains the devices you want to update. Its ID is `$GROUP`. A pack belongs to one group and can only be launched to that group's devices.",{"_6892":3497,"_42174":3480,"_29767":88069,"_5":21387,"_28235":88018,"_5797":88070},[],"The binary to deliver and, for an SWU pack, a `sw-description` file.",{"_6892":3498,"_42174":3480,"_29767":88072,"_5":21387,"_28235":88018,"_5797":88073},[],"Devices that can receive the update. See Connect a device.",{"_6892":3499,"_42174":3480,"_29767":88075,"_5":21387,"_28235":88018,"_5797":88076},[],"The service has no built-in authentication, so these examples send none. Put a gateway that authenticates callers in front of it: see Security.",{"_6892":3500,"_42174":3480,"_29767":88078,"_5":21387,"_28235":88021,"_5797":88079},[],"The response is `201` with the pack, including its `id`. A pack starts as `draft`.",{"_6892":3501,"_42174":3480,"_29767":88081,"_5":21387,"_28235":88021,"_5797":85754},[],{"_6892":3502,"_42174":3480,"_29767":88083,"_5":21387,"_28235":88021,"_5797":86989},[],{"_6892":3503,"_42174":3480,"_29767":88085,"_5":21387,"_28235":88021,"_5797":80179},[],{"_6892":3504,"_42174":3480,"_29767":88087,"_5":21387,"_28235":88021,"_5797":88088},[],"Required. Unique within the group; a duplicate answers `409`. Native mode uses it as a path segment, so it may contain only letters, digits, `.`, `_` and `-` (no spaces)",{"_6892":3505,"_42174":3480,"_29767":88090,"_5":21387,"_28235":88021,"_5797":88091},[],"`version`",{"_6892":3506,"_42174":3480,"_29767":88093,"_5":21387,"_28235":88021,"_5797":88094},[],"Required. Strict semver `x.y.z`, set by you",{"_6892":3507,"_42174":3480,"_29767":88096,"_5":21387,"_28235":88021,"_5797":88097},[],"`group_id`",{"_6892":3508,"_42174":3480,"_29767":88099,"_5":21387,"_28235":88021,"_5797":88100},[],"Required in the body. Use the same value as in the path",{"_6892":3509,"_42174":3480,"_29767":88102,"_5":21387,"_28235":88021,"_5797":86664},[],{"_6892":3510,"_42174":3480,"_29767":88104,"_5":21387,"_28235":88021,"_5797":88105},[],"`rawfile` or `firmware`. Recorded on the pack and sent to the device in the job; the dashboard also offers `both` and `other`. Not validated at creation",{"_6892":3511,"_42174":3480,"_29767":88107,"_5":21387,"_28235":88021,"_5797":88108},[],"`packaging`",{"_6892":3512,"_42174":3480,"_29767":88110,"_5":21387,"_28235":88021,"_5797":88111},[],"`swu` (default) or `non-swu`. A `non-swu` pack delivers its files as a `.tar.gz` and uses the `download-install` workflow",{"_6892":3513,"_42174":3480,"_29767":88113,"_5":21387,"_28235":88021,"_5797":88114},[],"`allow_previous_version_download`",{"_6892":3514,"_42174":3480,"_29767":88116,"_5":21387,"_28235":88021,"_5797":88117},[],"Optional. Lets devices download older versions of the pack",{"_6892":3515,"_42174":3480,"_29767":88119,"_5":21387,"_28235":88021,"_5797":88120},[],"`preconditions`",{"_6892":3516,"_42174":3480,"_29767":88122,"_5":21387,"_28235":88021,"_5797":88123},[],"Optional rules a device must meet to receive the pack. See Concepts",{"_6892":3517,"_42174":3480,"_29767":88125,"_5":21387,"_28235":88021,"_5797":88126},[],"`modules`",{"_6892":3518,"_42174":3480,"_29767":88128,"_5":21387,"_28235":88021,"_5797":88129},[],"**hawkBit mode only**: the pack's composition, as built catalog modules. Native ignores it",{"_6892":3519,"_42174":3480,"_29767":88131,"_5":21387,"_28235":88025,"_5797":88132},[],"The `sw-description` is an SWUpdate file that lists what the device installs. Its format is SWUpdate's, and the SWUpdate documentation is the reference. When the service builds the `.swu`, `swugenerator` reads this file and the staged binaries, so the `filename` of every image must be the name of an uploaded file. A minimal one:",{"_6892":3520,"_42174":3480,"_29767":88134,"_5":21387,"_28235":88025,"_5797":88135},[],"`swugenerator` fills in the final `filename` (with `.zlib` added, and `.enc` for encrypted files), the `sha256` and, for encrypted files, the `ivt` property. For an encrypted build, add `encrypted = true;` to each image that must be encrypted. Two rules cause most failures:",{"_6892":3521,"_42174":3480,"_29767":88137,"_5":21387,"_28235":88025,"_5797":88138},[],"`encrypted = true` must appear only in a build that supplies a key (the build fails without one), and a per-device build refuses a description in which no image has it.",{"_6892":3522,"_42174":3480,"_29767":88140,"_5":21387,"_28235":88025,"_5797":88141},[],"Compressed images need `decompressed-size`.",{"_6892":3523,"_42174":3480,"_29767":88143,"_5":21387,"_28235":88025,"_5797":88144},[],"If you build the `.swu` yourself and upload it as a prebuilt deliverable, you fill in `sha256` and `ivt` yourself, and the `sha256` is over the bytes the device downloads, because SWUpdate hashes before it decrypts.",{"_6892":3524,"_42174":3480,"_29767":88146,"_5":21387,"_28235":88025,"_5797":88147},[],"`artifact_name` defaults to the file name without its extension. `version` is optional; when you upload a new file under an existing `artifact_name` it must be strictly higher than the highest version already stored under that name.",{"_6892":3525,"_42174":3480,"_29767":88149,"_5":21387,"_28235":88025,"_5797":88150},[],"The artifact is stored as a global artifact and linked to this pack. The response contains its `id`. To reuse an artifact that is already uploaded, link it with `POST .../artifact/link` and `{\"artifact_id\":\"<id>\"}`.",{"_6892":3526,"_42174":3480,"_29767":88152,"_5":21387,"_28235":88025,"_5797":88153},[],"The largest accepted file is `max_artifact_size_mb` (10 GiB by default). A bigger upload answers `413`.",{"_6892":3527,"_42174":3480,"_29767":88155,"_5":21387,"_28235":88025,"_5797":88156},[],"Once the pack is built, uploads and links answer `409`: create a new version first.",{"_6892":3528,"_42174":3480,"_29767":88158,"_5":21387,"_28235":88029,"_5797":88159},[],"A native pack is a composition of software modules: one `os` module plus any number of `application` modules. A pack with no declared modules behaves as a single implicit `os` module that owns the artifacts you uploaded above. To add an application module and give it its own files:",{"_6892":3529,"_42174":3480,"_29767":88161,"_5":21387,"_28235":88029,"_5797":88162},[],"The module key is `<type>:<name>`. Native still builds one `.swu` for the whole pack, from every module's artifacts and the pack's single `sw-description`. You can also compose from a module that already exists with `POST .../modules/import`; in native mode that copies the module, while in hawkBit mode it links the same module. See Concepts for the model.",{"_6892":3530,"_42174":3480,"_29767":88164,"_5":21387,"_28235":88033,"_5797":88165},[],"`selected_artifact_ids` is what puts artifacts into the build: only the listed artifacts are staged. With an empty list the build fails because no binaries were staged, and the pack becomes `build_failed`. Take the ID from the artifact upload response, or from `GET $API/artifacts`.",{"_6892":3531,"_42174":3480,"_29767":88167,"_5":21387,"_28235":88033,"_5797":88168},[],"The body above builds an unencrypted, unsigned `.swu`. To sign or encrypt, add fields as described in Signing and encryption.",{"_6892":3532,"_42174":3480,"_29767":88170,"_5":21387,"_28235":88033,"_5797":88171},[],"For a `non-swu` pack, call `POST .../package` instead of `.../swu`. With no `selected_artifact_ids` it packages the artifacts linked to the pack.",{"_6892":3533,"_42174":3480,"_29767":88173,"_5":21387,"_28235":88033,"_5797":88174},[],"To deliver a file you built elsewhere, upload it to `POST .../swu/upload` (or `.../package/upload`) as a multipart `file`. It is stored and served unchanged, so it must already be signed and encrypted the way your devices expect. Native mode only.",{"_6892":3534,"_42174":3480,"_29767":88176,"_5":21387,"_28235":88033,"_5797":88177},[],"When the build succeeds, the pack becomes `built` and its artifacts and composition are immutable. If it fails, the pack becomes `build_failed` and `last_build_error` holds the reason: fix the input and build again. A build that runs while another one holds the same pack answers `409`.",{"_6892":3535,"_42174":3480,"_29767":88179,"_5":21387,"_28235":88037,"_5797":88180},[],"The launch targets every device of the group at the moment you create it, and it needs a built pack. The response is `201` with `launch_id`, `precondition_failures`, `forced`, and, in hawkBit mode, `superseded_devices` and `never_seen_devices`.",{"_6892":3536,"_42174":3480,"_29767":88182,"_5":21387,"_28235":88037,"_5797":85754},[],{"_6892":3537,"_42174":3480,"_29767":88184,"_5":21387,"_28235":88037,"_5797":86989},[],{"_6892":3538,"_42174":3480,"_29767":88186,"_5":21387,"_28235":88037,"_5797":88187},[],"`distribution_set_name`, `workflow_type`, `rollout_type`, `rollout_value`",{"_6892":3539,"_42174":3480,"_29767":88189,"_5":21387,"_28235":88037,"_5797":88190},[],"Required. `rollout_value` must be greater than 0",{"_6892":3540,"_42174":3480,"_29767":88192,"_5":21387,"_28235":88037,"_5797":85759},[],{"_6892":3541,"_42174":3480,"_29767":88194,"_5":21387,"_28235":88037,"_5797":88195},[],"`percentage` of the group per batch, or `fixed` (a device count). Any value other than `percentage` is read as a count",{"_6892":3542,"_42174":3480,"_29767":88197,"_5":21387,"_28235":88037,"_5797":85771},[],{"_6892":3543,"_42174":3480,"_29767":88199,"_5":21387,"_28235":88037,"_5797":88200},[],"Native: `direct`, `phased`, `download-install`, or the full name of another workflow registered in WFX (`GET $API/workflows`). hawkBit: `phased` creates a soft action, anything else a forced one",{"_6892":3544,"_42174":3480,"_29767":88202,"_5":21387,"_28235":88037,"_5797":85777},[],{"_6892":3545,"_42174":3480,"_29767":88204,"_5":21387,"_28235":88037,"_5797":88205},[],"Optional canary: a member of the group that is updated first and must succeed before any other device is touched",{"_6892":3546,"_42174":3480,"_29767":88207,"_5":21387,"_28235":88037,"_5797":88208},[],"`auto`, `approval_threshold`, `error_threshold`",{"_6892":3547,"_42174":3480,"_29767":88210,"_5":21387,"_28235":88037,"_5797":88211},[],"Optional. `auto` releases later batches by itself. Both thresholds are percentages from 0 to 100",{"_6892":3548,"_42174":3480,"_29767":88213,"_5":21387,"_28235":88037,"_5797":85801},[],{"_6892":3549,"_42174":3480,"_29767":88215,"_5":21387,"_28235":88037,"_5797":88216},[],"Optional RFC 3339 time. The first batch is delayed until then",{"_6892":3550,"_42174":3480,"_29767":88218,"_5":21387,"_28235":88037,"_5797":88219},[],"`name`, `description`, `weight`",{"_6892":3551,"_42174":3480,"_29767":88221,"_5":21387,"_28235":88037,"_5797":88222},[],"Optional. `name` defaults to the pack's name. `weight` (0 to 1000) is stored but nothing reads it",{"_6892":3552,"_42174":3480,"_29767":88224,"_5":21387,"_28235":88037,"_5797":88225},[],"`force_preconditions`",{"_6892":3553,"_42174":3480,"_29767":88227,"_5":21387,"_28235":88037,"_5797":88228},[],"Deploy to devices that fail the pack's preconditions anyway. The failures are still recorded",{"_6892":3554,"_42174":3480,"_29767":88230,"_5":21387,"_28235":88037,"_5797":88231},[],"Choose the workflow to match the pack:",{"_6892":3555,"_42174":3480,"_29767":88233,"_5":21387,"_28235":88037,"_5797":88234},[],"Use `direct` for SWU packs unless you drive WFX yourself. The `phased` workflow has steps that WFX or an operator must confirm, and this service does not advance them. A `phased` launch stays at its first state until someone confirms it through WFX.",{"_6892":3556,"_42174":3480,"_29767":88236,"_5":21387,"_28235":88037,"_5797":88237},[],"For a `non-swu` pack set `workflow_type` to `download-install`. The launch uses the value you give verbatim, so `direct` would run the SWU workflow and the update would look stuck after the device finished.",{"_6892":3557,"_42174":3480,"_29767":88239,"_5":21387,"_28235":88037,"_5797":88240},[],"In hawkBit mode there is no WFX. The choice is hawkBit's install mode.",{"_6892":3558,"_42174":3480,"_29767":88242,"_5":21387,"_28235":88037,"_5797":88243},[],"If the pack has preconditions, preview who qualifies before creating anything by adding `?dry_run=true` to the same request. It answers `200` with `qualifying_devices`, `precondition_failures`, `superseded_devices` and `never_seen_devices`, and creates nothing.",{"_6892":3559,"_42174":3480,"_29767":88245,"_5":21387,"_28235":88037,"_5797":88246},[],"**Approval and error thresholds.** With `auto: true`, the next batch is released once at least `approval_threshold` percent of the current batch has succeeded (0 means the whole batch). In native mode the campaign is cancelled when `error_threshold` percent of all its devices have failed; in hawkBit mode it stops when more than that percentage of a batch fails. A failed canary pauses a native campaign instead: resume it to retry the canary.",{"_6892":3560,"_42174":3480,"_29767":88248,"_5":21387,"_28235":88037,"_5797":88249},[],"Take the launch ID from the response. It is `$LAUNCH` below.",{"_6892":3561,"_42174":3480,"_29767":88251,"_5":21387,"_28235":88041,"_5797":88252},[],"Without `auto`, each call dispatches the next batch (the canary first, if you set one). With `auto: true`, call it once to start the first batch: the service then releases the later batches itself as the approval threshold is met, and further calls answer `400`. If the launch has a future `scheduled_at`, the call is accepted but does nothing: the service starts it by itself at that time (native checks every 30 seconds; hawkBit's own scheduler starts the rollout).",{"_6892":3562,"_42174":3480,"_29767":88254,"_5":21387,"_28235":88041,"_5797":88255},[],"A native launch moves through these statuses:",{"_6892":3563,"_42174":3480,"_29767":88257,"_5":21387,"_28235":88041,"_5797":88258},[],"You can steer a launch while it runs:",{"_6892":3564,"_42174":3480,"_29767":88260,"_5":21387,"_28235":88041,"_5797":84052},[],{"_6892":3565,"_42174":3480,"_29767":88262,"_5":21387,"_28235":88041,"_5797":83595},[],{"_6892":3566,"_42174":3480,"_29767":88264,"_5":21387,"_28235":88041,"_5797":88265},[],"Effect",{"_6892":3567,"_42174":3480,"_29767":88267,"_5":21387,"_28235":88041,"_5797":88268},[],"Pause",{"_6892":3568,"_42174":3480,"_29767":88270,"_5":21387,"_28235":88041,"_5797":88271},[],"`POST $API/groups/$GROUP/launch/$LAUNCH/pause`",{"_6892":3569,"_42174":3480,"_29767":88273,"_5":21387,"_28235":88041,"_5797":88274},[],"No further batches until resumed. Devices already in flight finish",{"_6892":3570,"_42174":3480,"_29767":88276,"_5":21387,"_28235":88041,"_5797":88277},[],"Resume",{"_6892":3571,"_42174":3480,"_29767":88279,"_5":21387,"_28235":88041,"_5797":88280},[],"`POST .../resume`",{"_6892":3572,"_42174":3480,"_29767":88282,"_5":21387,"_28235":88041,"_5797":88283},[],"Native: an automatic campaign releases its next batch at once if the current one already met the threshold, and resuming after a failed canary retries it",{"_6892":3573,"_42174":3480,"_29767":88285,"_5":21387,"_28235":88041,"_5797":88286},[],"Retry failed devices",{"_6892":3574,"_42174":3480,"_29767":88288,"_5":21387,"_28235":88041,"_5797":88289},[],"`POST .../retry-failed`",{"_6892":3575,"_42174":3480,"_29767":88291,"_5":21387,"_28235":88041,"_5797":88292},[],"Re-queues the failed devices and dispatches them. Answers `400` when there is none",{"_6892":3576,"_42174":3480,"_29767":88294,"_5":21387,"_28235":88041,"_5797":88295},[],"Cancel (terminal)",{"_6892":3577,"_42174":3480,"_29767":88297,"_5":21387,"_28235":88041,"_5797":88298},[],"`POST .../cancel`",{"_6892":3578,"_42174":3480,"_29767":88300,"_5":21387,"_28235":88041,"_5797":88301},[],"Pending devices are not updated",{"_6892":3579,"_42174":3480,"_29767":88303,"_5":21387,"_28235":88041,"_5797":88304},[],"Mark complete (terminal)",{"_6892":3580,"_42174":3480,"_29767":88306,"_5":21387,"_28235":88041,"_5797":88307},[],"`POST .../complete`",{"_6892":3581,"_42174":3480,"_29767":88309,"_5":21387,"_28235":88041,"_5797":88310},[],"Not available in hawkBit mode",{"_6892":3582,"_42174":3480,"_29767":88312,"_5":21387,"_28235":88041,"_5797":88313},[],"Read or change the strategy",{"_6892":3583,"_42174":3480,"_29767":88315,"_5":21387,"_28235":88041,"_5797":88316},[],"`GET`, `PUT .../strategy`",{"_6892":3584,"_42174":3480,"_29767":88318,"_5":21387,"_28235":88041,"_5797":88319},[],"Changing it is not available in hawkBit mode",{"_6892":3585,"_42174":3480,"_29767":88321,"_5":21387,"_28235":88041,"_5797":88322},[],"In hawkBit mode a rollout can only be paused after it has started dispatching.",{"_6892":3586,"_42174":3480,"_29767":88324,"_5":21387,"_28235":88045,"_5797":88325},[],"The launch list answers `{\"list\":[...],\"next\":\"...\"}`. A launch is done when `pending_count` and `active_count` are zero; a native launch then sets its `status` to `completed` by itself. Devices end as `completed` (job state `ACTIVATED`, or `INSTALLED` for `non-swu`) or `failed` (`TERMINATED`).",{"_6892":3587,"_42174":3480,"_29767":88327,"_5":21387,"_28235":88048,"_5797":88328},[],"A built pack version is immutable. To change it, create the next version, upload what changed and build again:",{"_6892":3588,"_42174":3480,"_29767":88330,"_5":21387,"_28235":88048,"_5797":88331},[],"The version must be strictly higher than the current one. The new version starts unbuilt and carries the current artifacts forward.",{"_6892":3589,"_42174":3480,"_29767":88333,"_5":21387,"_28235":88048,"_5797":88334},[],"To update one device to an exact version without a campaign, use `POST $API/devices/<device-id>/force-version` with `{\"distribution_set_id\":\"<pack id>\",\"version\":\"1.1.0\"}`; in native mode it creates a one-device launch and defaults to the `phased` workflow for SWU packs (`download-install` for `non-swu`) unless you pass a `workflow`.",{"_6892":3590,"_42174":3480,"_29767":88336,"_5":21387,"_28235":88052,"_5797":88337},[],"hawkBit packs are assembled from built catalog modules, so the pack-side steps 2 and 3 move to the catalog:",{"_6892":3591,"_42174":3480,"_29767":88339,"_5":21387,"_28235":88052,"_5797":88340},[],"Create the module: `POST $API/softwaremodules` with `type` (`os` or `application`), `name`, `version` and a `delivery_intent`: `swu-build`, `swu-prebuilt` or `raw`. `undecided` is accepted, but a module cannot join a pack until you choose.",{"_6892":3592,"_42174":3480,"_29767":88342,"_5":21387,"_28235":88052,"_5797":88343},[],"Upload the file with `POST $API/softwaremodules/by-id/<id>/artifacts`. For `swu-build`, also upload the `sw-description` to `.../descriptor` and call `POST $API/softwaremodules/by-id/<id>/build`. For `swu-prebuilt`, uploading the `.swu` is the build. For `raw`, call `.../build` to make the files the deliverable; signing and encryption are optional.",{"_6892":3593,"_42174":3480,"_29767":88345,"_5":21387,"_28235":88052,"_5797":88346},[],"Create the pack with `\"modules\":[{\"source_module_id\":\"<id>\"}]`. It is created already built.",{"_6892":3594,"_42174":3480,"_29767":88348,"_5":21387,"_28235":88052,"_5797":88349},[],"Then continue at step 4. Details, including the delivery intents, are in hawkBit mode, and a full request sequence is in hawkBit curl guide.",{"_6892":3595,"_42174":3480,"_29767":88351,"_5":21387,"_28235":88055,"_5797":84046},[],{"_6892":3596,"_42174":3480,"_29767":88353,"_5":21387,"_28235":88055,"_5797":86538},[],{"_6892":3597,"_42174":3480,"_29767":88355,"_5":21387,"_28235":88055,"_5797":88356},[],"A call returns `501 Not Implemented`",{"_6892":3598,"_42174":3480,"_29767":88358,"_5":21387,"_28235":88055,"_5797":88359},[],"The active backend does not support it. Check Capabilities",{"_6892":3599,"_42174":3480,"_29767":88361,"_5":21387,"_28235":88055,"_5797":88362},[],"`400` \"has not been built yet\" when creating a launch",{"_6892":3600,"_42174":3480,"_29767":88364,"_5":21387,"_28235":88055,"_5797":88365},[],"The pack is `draft` or `build_failed`. Build it first",{"_6892":3601,"_42174":3480,"_29767":88367,"_5":21387,"_28235":88055,"_5797":88368},[],"`400` about devices with no package",{"_6892":3602,"_42174":3480,"_29767":88370,"_5":21387,"_28235":88055,"_5797":88371},[],"A per-device encrypted pack was built for only some devices. The message names the devices missing a key; fix them and rebuild",{"_6892":3603,"_42174":3480,"_29767":88373,"_5":21387,"_28235":88055,"_5797":88374},[],"`400` \"group has no devices to launch to\"",{"_6892":3604,"_42174":3480,"_29767":88376,"_5":21387,"_28235":88055,"_5797":88377},[],"The group has no members, or none qualify. Check the group's criteria and the pack's preconditions",{"_6892":3605,"_42174":3480,"_29767":88379,"_5":21387,"_28235":88055,"_5797":88380},[],"Build returns an error about `encrypted = true`",{"_6892":3606,"_42174":3480,"_29767":88382,"_5":21387,"_28235":88055,"_5797":88383},[],"A per-device build needs at least one image marked `encrypted = true` in the `sw-description`",{"_6892":3607,"_42174":3480,"_29767":88385,"_5":21387,"_28235":88055,"_5797":88386},[],"SWU build fails with \"failed to read binaries directory\" or \"binaries directory is empty\"",{"_6892":3608,"_42174":3480,"_29767":88388,"_5":21387,"_28235":88055,"_5797":88389},[],"Nothing was staged: no `selected_artifact_ids` in the build body",{"_6892":3609,"_42174":3480,"_29767":88391,"_5":21387,"_28235":88055,"_5797":88392},[],"`409` on upload, link or build",{"_6892":3610,"_42174":3480,"_29767":88394,"_5":21387,"_28235":88055,"_5797":88395},[],"The version is already built (create a new version), or another request is building the same pack",{"_6892":3611,"_42174":3480,"_29767":88397,"_5":21387,"_28235":88055,"_5797":88398},[],"`413` on upload",{"_6892":3612,"_42174":3480,"_29767":88400,"_5":21387,"_28235":88055,"_5797":88401},[],"The file is larger than `max_artifact_size_mb`",{"_6892":3613,"_42174":3480,"_29767":88403,"_5":21387,"_28235":88055,"_5797":88404},[],"Rollout answers `400` \"paused\" or \"rolls out automatically\"",{"_6892":3614,"_42174":3480,"_29767":88406,"_5":21387,"_28235":88055,"_5797":88407},[],"Resume the launch, or let the automatic campaign release its own batches",{"_6892":3615,"_42174":3480,"_29767":88409,"_5":21387,"_28235":88055,"_5797":88410},[],"Launch stays `running` with no device progress (hawkBit)",{"_6892":3616,"_42174":3480,"_29767":88412,"_5":21387,"_28235":88055,"_5797":88413},[],"Devices never contacted hawkBit. A rollout group cannot advance until its devices poll",{"_6892":3617,"_42174":3480,"_29767":88415,"_5":21387,"_28235":88055,"_5797":88416},[],"Devices cannot download the `.swu` (native)",{"_6892":3618,"_42174":3480,"_29767":88418,"_5":21387,"_28235":88055,"_5797":88419},[],"`update_domain` is not reachable from the device, or is not the full `.../updates/v1/` base with a trailing slash. The download URL is fixed when the pack is built, so rebuild after changing it",{"_6892":3619,"_42174":3480,"_29767":88421,"_5":21387,"_28235":88055,"_5797":88422},[],"Create-pack fails in hawkBit mode",{"_6892":3620,"_42174":3480,"_29767":88424,"_5":21387,"_28235":88055,"_5797":88425},[],"A pack with that name already exists in the group (`409`), a module is not built or not linked by `source_module_id`, or the name and version of an earlier module are reserved. Bump the version",{"_6892":3621,"_42174":3480,"_29767":88427,"_5":21387,"_28235":88055,"_5797":88428},[],"A `non-swu` launch runs the SWU states",{"_6892":3622,"_42174":3480,"_29767":88430,"_5":21387,"_28235":88055,"_5797":88431},[],"The launch was created with `workflow_type: direct`. Use `download-install`",{"_6892":3623,"_42174":3480,"_29767":88433,"_5":21387,"_28235":88058,"_5797":88434},[],"<Card title=\"Concepts\" href=\"/docs/platform/updates/concepts\" description=\"Packs, modules, launches, workflows and preconditions.\" />",{"_6892":3624,"_42174":3480,"_29767":88436,"_5":21387,"_28235":88058,"_5797":88437},[],"<Card title=\"Native curl guide\" href=\"/docs/platform/updates/guides/native-curl\" description=\"Every request of the native flow, in order.\" />",{"_6892":3625,"_42174":3480,"_29767":88439,"_5":21387,"_28235":88058,"_5797":88440},[],"<Card title=\"API reference\" href=\"/docs/platform/updates/reference/api\" description=\"All routes, bodies and status codes.\" />",{"_6892":3626,"_42174":3626,"_5":21817,"_5797":85247,"_42654":88442,"_29767":88443,"_28235":3626},[77248,78697,85231,83583],[],{"_6892":3627,"_42174":3626,"_29767":88445,"_5":21387,"_28235":3626,"_5797":88446},[],"Run the same Lamassu Updates API on top of an Eclipse hawkBit server, what the adapter keeps in Postgres, and what differs from native mode.",{"_6892":3628,"_42174":3626,"_5":42651,"_29767":88448,"_28235":88449,"_5797":81179},[],"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode#prerequisites",{"_6892":3629,"_42174":3626,"_5":42651,"_29767":88451,"_28235":88452,"_5797":88453},[],"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode#enable-it","Enable it",{"_6892":3630,"_42174":3626,"_5":42651,"_29767":88455,"_28235":88456,"_5797":88457},[],"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode#run-it-locally","Run it locally",{"_6892":3631,"_42174":3626,"_5":42651,"_29767":88459,"_28235":88460,"_5797":88461},[],"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode#create-and-build-a-pack","Create and build a pack",{"_6892":3632,"_42174":3626,"_5":42651,"_29767":88463,"_28235":88464,"_5797":88465},[],"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode#create-the-module-in-the-catalog","Create the module in the catalog",{"_6892":3633,"_42174":3626,"_5":42651,"_29767":88467,"_28235":88468,"_5797":88469},[],"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode#upload-its-files","Upload its files",{"_6892":3634,"_42174":3626,"_5":42651,"_29767":88471,"_28235":88472,"_5797":88473},[],"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode#make-it-built","Make it built",{"_6892":3635,"_42174":3626,"_5":42651,"_29767":88475,"_28235":88476,"_5797":88477},[],"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode#create-the-pack-from-the-built-modules","Create the pack from the built modules",{"_6892":3636,"_42174":3626,"_5":42651,"_29767":88479,"_28235":88480,"_5797":88481},[],"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode#how-it-maps","How it maps",{"_6892":3637,"_42174":3626,"_5":42651,"_29767":88483,"_28235":88484,"_5797":88485},[],"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode#what-lives-where","What lives where",{"_6892":3638,"_42174":3626,"_5":42651,"_29767":88487,"_28235":88488,"_5797":88489},[],"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode#devices-and-targets","Devices and targets",{"_6892":3639,"_42174":3626,"_5":42651,"_29767":88491,"_28235":88492,"_5797":88493},[],"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode#device-authentication-in-production","Device authentication in production",{"_6892":3640,"_42174":3626,"_5":42651,"_29767":88495,"_28235":88496,"_5797":88497},[],"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode#artifact-storage-and-downloads","Artifact storage and downloads",{"_6892":3641,"_42174":3626,"_5":42651,"_29767":88499,"_28235":88500,"_5797":88501},[],"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode#what-differs-from-native-mode","What differs from native mode",{"_6892":3642,"_42174":3626,"_5":42651,"_29767":88503,"_28235":88504,"_5797":88505},[],"/docs/pr-preview/pr-56/platform/updates/hawkbit-mode#scaling","Scaling",{"_6892":3643,"_42174":3626,"_29767":88507,"_5":21387,"_28235":3626,"_5797":88508},[],"In `hawkbit` mode, Lamassu Updates serves the same `/updates/v1` API on top of an Eclipse hawkBit server instead of its own Postgres, WFX and SymKMS-based backend. The service becomes an **adapter**: hawkBit owns packs, modules, rollouts and jobs and is read live on every request, and devices talk to hawkBit directly.",{"_6892":3644,"_42174":3626,"_29767":88510,"_5":21387,"_28235":3626,"_5797":88511},[],"Use it when hawkBit is already your fleet's update backend, or to compare the two backends. To choose between them, see the overview.",{"_6892":3645,"_42174":3626,"_29767":88513,"_5":21387,"_28235":88449,"_5797":88514},[],"A reachable hawkBit server (1.x) and its Management API credentials.",{"_6892":3646,"_42174":3626,"_29767":88516,"_5":21387,"_28235":88449,"_5797":88517},[],"Postgres for this service. See What lives where.",{"_6892":3647,"_42174":3626,"_29767":88519,"_5":21387,"_28235":88449,"_5797":88520},[],"Devices that poll hawkBit through SWUpdate's `suricatta` module. With `dms_endpoint` set, the service creates the hawkBit targets of a group's devices and tags them itself (see Devices and targets). Without it, you register and tag them in hawkBit.",{"_6892":3648,"_42174":3626,"_29767":88522,"_5":21387,"_28235":88452,"_5797":88523},[],"`mode` is `native` when unset, so existing configurations are unaffected. Startup fails if `hawkbit.base_url` or `storage.hostname` is empty. An unreachable hawkBit does not stop startup: it shows up as errors on requests.",{"_6892":3649,"_42174":3626,"_29767":88525,"_5":21387,"_28235":88452,"_5797":88526},[],"To build deliverables in this mode, add the pieces you need on top. All are read once at start-up:",{"_6892":3650,"_42174":3626,"_29767":88528,"_5":21387,"_28235":88452,"_5797":88529},[],"You want",{"_6892":3651,"_42174":3626,"_29767":88531,"_5":21387,"_28235":88452,"_5797":88532},[],"Set",{"_6892":3652,"_42174":3626,"_29767":88534,"_5":21387,"_28235":88452,"_5797":88535},[],"`swu-build` modules (assembled `.swu`)",{"_6892":3653,"_42174":3626,"_29767":88537,"_5":21387,"_28235":88452,"_5797":88538},[],"`swugenerator_path`",{"_6892":3654,"_42174":3626,"_29767":88540,"_5":21387,"_28235":88452,"_5797":88541},[],"Signing with the Lamassu KMS",{"_6892":3655,"_42174":3626,"_29767":88543,"_5":21387,"_28235":88452,"_5797":88544},[],"also `sign_script_path` and `kms_endpoint` (raw modules need only `kms_endpoint`)",{"_6892":3656,"_42174":3626,"_29767":88546,"_5":21387,"_28235":88452,"_5797":88547},[],"Shared-key encryption",{"_6892":3657,"_42174":3626,"_29767":88549,"_5":21387,"_28235":88452,"_5797":88550},[],"`symkms_endpoint`, plus the `symkms` block or `sym_keys_dir` so the process registers the `/symkms/v1` routes",{"_6892":3658,"_42174":3626,"_29767":88552,"_5":21387,"_28235":88452,"_5797":88553},[],"See the configuration reference and Signing and encryption. Without these keys, `GET /updates/v1/capabilities` reports `artifact_encryption: false` and the dashboard hides the encryption selector.",{"_6892":3659,"_42174":3626,"_29767":88555,"_5":21387,"_28235":88452,"_5797":88556},[],"The API listens on `app.server.port`, and clients choose it. The dashboard reads its API URL from `LAMASSU_UPDATES_API`, so point that at the instance that runs the mode you want. If you run a native and a `hawkbit` instance side by side, give them different ports, and set each instance's `symkms_endpoint` to **its own** port: it points at the same process.",{"_6892":3660,"_42174":3626,"_29767":88558,"_5":21387,"_28235":88456,"_5797":88559},[],"The repository's `docker-compose.yml` starts a hawkBit (host port `8090`, backed by the `hawkbit` Postgres database) and the Postgres both services use:",{"_6892":3661,"_42174":3626,"_29767":88561,"_5":21387,"_28235":88456,"_5797":88562},[],"`config-hawkbit.yml` contains values for one developer machine: absolute paths for `swugenerator_path`, `sign_script_path` and the SymKMS directories, and a LAN address for `kms_endpoint`. Edit them first, and point them at paths the service user can create. The file has no `dms_endpoint`: add the URL of your Lamassu Device Manager, or the service has no device groups to launch to.",{"_6892":3662,"_42174":3626,"_29767":88564,"_5":21387,"_28235":88456,"_5797":88565},[],"Check the backend:",{"_6892":3663,"_42174":3626,"_29767":88567,"_5":21387,"_28235":88460,"_5797":88568},[],"A hawkBit distribution set can only link **built** software modules, so the order differs from native mode. The flow is catalog-first:",{"_6892":3664,"_42174":3626,"_29767":88570,"_5":21387,"_28235":88464,"_5797":88571},[],"`POST /updates/v1/softwaremodules` with its `type`, `name`, `version` and `delivery_intent`.",{"_6892":3665,"_42174":3626,"_29767":88573,"_5":21387,"_28235":88468,"_5797":88574},[],"`POST /updates/v1/softwaremodules/by-id/:moduleID/artifacts`. This route streams the file to hawkBit.",{"_6892":3666,"_42174":3626,"_29767":88576,"_5":21387,"_28235":88472,"_5797":88577},[],"How depends on the delivery intent (next table).",{"_6892":3667,"_42174":3626,"_29767":88579,"_5":21387,"_28235":88476,"_5797":88580},[],"`POST /updates/v1/groups/:groupID/distribution-sets` with `modules: [{\"source_module_id\": \"<id>\"}]`. The pack is created already built.",{"_6892":3668,"_42174":3626,"_29767":88582,"_5":21387,"_28235":88476,"_5797":88583},[],"`delivery_intent`",{"_6892":3669,"_42174":3626,"_29767":88585,"_5":21387,"_28235":88476,"_5797":88586},[],"How the module becomes built",{"_6892":3670,"_42174":3626,"_29767":88588,"_5":21387,"_28235":88476,"_5797":88589},[],"Joins packs with",{"_6892":3671,"_42174":3626,"_29767":88591,"_5":21387,"_28235":88476,"_5797":88592},[],"`swu-build`",{"_6892":3672,"_42174":3626,"_29767":88594,"_5":21387,"_28235":88476,"_5797":88595},[],"Upload its sw-description with `POST /softwaremodules/by-id/:moduleID/descriptor`, then `POST /softwaremodules/by-id/:moduleID/build`. Needs `swugenerator_path`: without it the build answers `501`. Signing and encryption fields go in the build body.",{"_6892":3673,"_42174":3626,"_29767":88597,"_5":21387,"_28235":88476,"_5797":88598},[],"`swu` (default) or `non-swu`",{"_6892":3674,"_42174":3626,"_29767":88600,"_5":21387,"_28235":88476,"_5797":88601},[],"`swu-prebuilt`",{"_6892":3675,"_42174":3626,"_29767":88603,"_5":21387,"_28235":88476,"_5797":88604},[],"Upload the finished `.swu`: uploading it builds the module. Calling build answers `400`.",{"_6892":3676,"_42174":3626,"_29767":88606,"_5":21387,"_28235":88476,"_5797":85703},[],{"_6892":3677,"_42174":3626,"_29767":88608,"_5":21387,"_28235":88476,"_5797":88609},[],"`raw`",{"_6892":3678,"_42174":3626,"_29767":88611,"_5":21387,"_28235":88476,"_5797":88612},[],"`POST .../build` encrypts (shared key) and/or signs the files; with neither, the files ship unchanged and the service logs a warning. Several files are archived into `<name>.tar.gz`. An encrypted deliverable gets the `.enc` suffix; a signature adds `<file>.sha256` and `<file>.sha256.sig`.",{"_6892":3679,"_42174":3626,"_29767":88614,"_5":21387,"_28235":88476,"_5797":85712},[],{"_6892":3680,"_42174":3626,"_29767":88616,"_5":21387,"_28235":88476,"_5797":88617},[],"`undecided`",{"_6892":3681,"_42174":3626,"_29767":88619,"_5":21387,"_28235":88476,"_5797":88620},[],"Cannot be built or linked. Choose an intent first with `PUT /softwaremodules/by-id/:moduleID`.",{"_6892":3682,"_42174":3626,"_29767":88622,"_5":21387,"_28235":88476,"_5797":33635},[],{"_6892":3683,"_42174":3626,"_29767":88624,"_5":21387,"_28235":88476,"_5797":88625},[],"A build **replaces** the module's input files with the deliverable, so a built module cannot be built again: release a new version of the module.",{"_6892":3684,"_42174":3626,"_29767":88627,"_5":21387,"_28235":88476,"_5797":88628},[],"Operations that make no sense for a built, frozen pack answer as follows:",{"_6892":3685,"_42174":3626,"_29767":88630,"_5":21387,"_28235":88476,"_5797":83595},[],{"_6892":3686,"_42174":3626,"_29767":88632,"_5":21387,"_28235":88476,"_5797":88633},[],"Answer",{"_6892":3687,"_42174":3626,"_29767":88635,"_5":21387,"_28235":88476,"_5797":88636},[],"`POST .../distribution-sets/:name/swu` and `.../package`",{"_6892":3688,"_42174":3626,"_29767":88638,"_5":21387,"_28235":88476,"_5797":88639},[],"`501`: build the modules in the catalog instead.",{"_6892":3689,"_42174":3626,"_29767":88641,"_5":21387,"_28235":88476,"_5797":88642},[],"`.../swu/upload` and `.../package/upload`",{"_6892":3690,"_42174":3626,"_29767":88644,"_5":21387,"_28235":88476,"_5797":88645},[],"`409`: a hawkBit pack is always already built.",{"_6892":3691,"_42174":3626,"_29767":88647,"_5":21387,"_28235":88476,"_5797":88648},[],"Pack-scoped artifact link, sw-description upload, module descriptor, module build, artifact delete",{"_6892":3692,"_42174":3626,"_29767":88650,"_5":21387,"_28235":88476,"_5797":88651},[],"`400`: a linked module is frozen. Unlink it, change and build it in the catalog, link it again.",{"_6892":3693,"_42174":3626,"_29767":88653,"_5":21387,"_28235":88476,"_5797":88654},[],"Creating a module inside a pack",{"_6892":3694,"_42174":3626,"_29767":88656,"_5":21387,"_28235":88476,"_5797":88657},[],"Not possible. Create it in the catalog.",{"_6892":3695,"_42174":3626,"_29767":88659,"_5":21387,"_28235":88476,"_5797":88660},[],"Changing the composition of a pack already assigned to devices",{"_6892":3696,"_42174":3626,"_29767":88662,"_5":21387,"_28235":88476,"_5797":88663},[],"`400`: create a new version.",{"_6892":3697,"_42174":3626,"_29767":88665,"_5":21387,"_28235":88476,"_5797":88666},[],"See the publish and roll out guide for the full procedure.",{"_6892":3698,"_42174":3626,"_29767":88668,"_5":21387,"_28235":88480,"_5797":88669},[],"Lamassu Updates",{"_6892":3699,"_42174":3626,"_29767":88671,"_5":21387,"_28235":88480,"_5797":85304},[],{"_6892":3700,"_42174":3626,"_29767":88673,"_5":21387,"_28235":88480,"_5797":88674},[],"Update pack version",{"_6892":3701,"_42174":3626,"_29767":88676,"_5":21387,"_28235":88480,"_5797":88677},[],"Distribution set. Every version is its own distribution set.",{"_6892":3702,"_42174":3626,"_29767":88679,"_5":21387,"_28235":88480,"_5797":85620},[],{"_6892":3703,"_42174":3626,"_29767":88681,"_5":21387,"_28235":88480,"_5797":85620},[],{"_6892":3704,"_42174":3626,"_29767":88683,"_5":21387,"_28235":88480,"_5797":88684},[],"Module artifact",{"_6892":3705,"_42174":3626,"_29767":88686,"_5":21387,"_28235":88480,"_5797":88687},[],"Software module artifact",{"_6892":3706,"_42174":3626,"_29767":88689,"_5":21387,"_28235":88480,"_5797":81576},[],{"_6892":3707,"_42174":3626,"_29767":88691,"_5":21387,"_28235":88480,"_5797":88692},[],"Target. The controller ID is the device ID.",{"_6892":3708,"_42174":3626,"_29767":88694,"_5":21387,"_28235":88480,"_5797":85638},[],{"_6892":3709,"_42174":3626,"_29767":88696,"_5":21387,"_28235":88480,"_5797":88697},[],"Target tag `group:<id>`",{"_6892":3710,"_42174":3626,"_29767":88699,"_5":21387,"_28235":88480,"_5797":85647},[],{"_6892":3711,"_42174":3626,"_29767":88701,"_5":21387,"_28235":88480,"_5797":88702},[],"Rollout (static)",{"_6892":3712,"_42174":3626,"_29767":88704,"_5":21387,"_28235":88480,"_5797":88705},[],"Per-device job",{"_6892":3713,"_42174":3626,"_29767":88707,"_5":21387,"_28235":88480,"_5797":88708},[],"Rollout action",{"_6892":3714,"_42174":3626,"_29767":88710,"_5":21387,"_28235":88480,"_5797":88711},[],"Scheduled launch",{"_6892":3715,"_42174":3626,"_29767":88713,"_5":21387,"_28235":88480,"_5797":88714},[],"The rollout's start time (hawkBit's scheduler starts it)",{"_6892":3716,"_42174":3626,"_29767":88716,"_5":21387,"_28235":88484,"_5797":88717},[],"hawkBit stores packs, rollouts and jobs. The service still needs Postgres (the `updates` database) for what hawkBit has no equivalent of: staged artifact uploads and aliases, sw-descriptions, signed set manifests, cancelled rollouts and declared latest-version pins. Keeping them in Postgres, not in memory, is what makes running several replicas safe.",{"_6892":3717,"_42174":3626,"_29767":88719,"_5":21387,"_28235":88484,"_5797":88720},[],"**sw-descriptions** live in Postgres, not in hawkBit metadata, because hawkBit caps a metadata value at 4000 characters. Descriptors written there by older versions are still read.",{"_6892":3718,"_42174":3626,"_29767":88722,"_5":21387,"_28235":88484,"_5797":88723},[],"**Rows are scoped to a hawkBit instance.** hawkBit ids repeat across servers and after its database is wiped, so the service tags the hawkBit it talks to with a marker (a distribution-set tag named `lamassu:instance`) and ignores rows that belong to another instance. Do not delete that tag.",{"_6892":3719,"_42174":3626,"_29767":88725,"_5":21387,"_28235":88484,"_5797":88726},[],"**Staged uploads are heavy.** `POST /updates/v1/artifacts` (the global artifact upload) reads the whole file into memory and keeps it in Postgres for 30 minutes unless a pack links it, and hawkBit mode refuses to link files to packs. For large files, always upload through the catalog route of the previous section, which streams to hawkBit.",{"_6892":3720,"_42174":3626,"_29767":88728,"_5":21387,"_28235":88488,"_5797":88729},[],"Devices poll hawkBit, not this service. A pack launched against a hawkBit with no registered targets is never downloaded by anything.",{"_6892":3721,"_42174":3626,"_29767":88731,"_5":21387,"_28235":88488,"_5797":88732},[],"With `dms_endpoint` set, every read of a group's devices creates the missing targets (controller ID = device ID) and tags them `group:<id>`. A device that cannot be reconciled is excluded from that read and logged. Without `dms_endpoint`, groups are the existing `group:<id>` tags.",{"_6892":3722,"_42174":3626,"_29767":88734,"_5":21387,"_28235":88488,"_5797":88735},[],"The first launch with a `test_device_id` (canary) fails with `test device X cannot act as this group's canary` until the group's devices exist in hawkBit. Run a dry run first (`POST .../launch?dry_run=true`), which registers them.",{"_6892":3723,"_42174":3626,"_29767":88737,"_5":21387,"_28235":88492,"_5797":88738},[],"hawkBit decides how devices authenticate, not this service. hawkBit 1.1.0 has no anonymous mode: a deployment must enable at least one of the target security token, the gateway security token, or the reverse-proxy header authenticator (`X-Controller-Id` plus `X-Authority`). Pick one and enable it as a hawkBit tenant setting; an installation where all of them are off answers `401` to every device. Recommended for production:",{"_6892":3724,"_42174":3626,"_29767":88740,"_5":21387,"_28235":88492,"_5797":88741},[],"Terminate device mTLS at a gateway, have it set the header authenticator's headers from the device certificate, and let hawkBit trust those headers only from the gateway's addresses (hawkBit's trusted-proxy setting). Anything that can reach hawkBit directly could otherwise impersonate any device.",{"_6892":3725,"_42174":3626,"_29767":88743,"_5":21387,"_28235":88492,"_5797":88744},[],"Or enable target security tokens (`authentication.targettoken.enabled`) and configure each device with its own token; SWUpdate sends it as `Authorization: TargetToken <token>`.",{"_6892":3726,"_42174":3626,"_29767":88746,"_5":21387,"_28235":88492,"_5797":88747},[],"Never expose the Management API to devices. Use a strong password for the Management API user (`HAWKBIT_SECURITY_USER_ADMIN_PASSWORD` in the image) and serve it over HTTPS. If the gateway publishes the DDI under a path prefix, set `hawkbit.ddi_url` to the public DDI URL so the artifact links devices receive are reachable.",{"_6892":3727,"_42174":3626,"_29767":88749,"_5":21387,"_28235":88496,"_5797":88750},[],"By default hawkBit stores artifact bytes on its own filesystem. The `docker/hawkbit` directory of the repository builds a hawkBit image with an **S3 artifact storage plugin**, selected with `HAWKBIT_ARTIFACT_STORAGE=s3` (`fs` is the default) and the `HAWKBIT_ARTIFACT_S3_*` variables (bucket, endpoint, region, path-style access, key prefix; credentials come from the AWS default chain). hawkBit refuses to start if S3 is selected but the bucket is unreachable: it never falls back to local disk silently. Metadata stays in Postgres either way. The plugin and its build and test instructions are in `docker/hawkbit`; the image is built locally and is not published to a registry.",{"_6892":3728,"_42174":3626,"_29767":88752,"_5":21387,"_28235":88496,"_5797":88753},[],"With the plugin and `hawkbit.artifact_store.presign` configured, downloads of module artifacts are answered `302` to a short-lived signed URL of the bucket instead of streaming through hawkBit or this service. Devices keep the artifact link hawkBit gave them: the adapter serves that one DDI route (`<ddi path>/:tenant/controller/v1/:controllerId/softwaremodules/:id/artifacts/:filename`), checks that the module is assigned to or installed on that device (otherwise `404`) and redirects. For this to work, the gateway must route that path to Lamassu Updates and the rest of the DDI to hawkBit. See Configuration and Security.",{"_6892":3729,"_42174":3626,"_29767":88755,"_5":21387,"_28235":88496,"_5797":88756},[],"hawkBit has its own artifact limits. The image of this repository raises them to 11 GiB per file and 1 TiB in total, to match the default `max_artifact_size_mb` of 10 GiB (`SPRING_SERVLET_MULTIPART_MAXFILESIZE`, `SPRING_SERVLET_MULTIPART_MAXREQUESTSIZE`, `HAWKBIT_SERVER_SECURITY_DOS_MAXARTIFACTSIZE` and `HAWKBIT_SERVER_SECURITY_DOS_MAXARTIFACTSTORAGE`). With stock hawkBit the limit is 1 GiB per file and 20 GiB in total. hawkBit writes an upload to a temporary file first, so give it that much free disk.",{"_6892":3730,"_42174":3626,"_29767":88758,"_5":21387,"_28235":88496,"_5797":88759},[],"The hawkBit image sizes its JVM with the environment variables `X_MS` and `X_MX` (default `768m` each), plus `XX_MAX_METASPACE_SIZE`, `XSS` and `GC`. `JAVA_OPTS` does not set the heap. Lowering `X_MX` lowers the ceiling, not the steady memory use.",{"_6892":3731,"_42174":3626,"_29767":88761,"_5":21387,"_28235":88500,"_5797":78330},[],{"_6892":3732,"_42174":3626,"_29767":88763,"_5":21387,"_28235":88500,"_5797":88764},[],"`hawkbit` mode",{"_6892":3733,"_42174":3626,"_29767":88766,"_5":21387,"_28235":88500,"_5797":88767},[],"Who devices poll",{"_6892":3734,"_42174":3626,"_29767":88769,"_5":21387,"_28235":88500,"_5797":88770},[],"hawkBit (DDI), not this service.",{"_6892":3735,"_42174":3626,"_29767":88772,"_5":21387,"_28235":88500,"_5797":88773},[],"Capabilities",{"_6892":3736,"_42174":3626,"_29767":88775,"_5":21387,"_28235":88500,"_5797":88776},[],"Not every native feature exists. `GET /updates/v1/capabilities` lists what the active backend supports: in `hawkbit` mode there are no custom workflows, no strategy editing after creation, no early completion of a campaign, no adding devices to a running campaign, no push events and no per-device encryption. See Capabilities.",{"_6892":3737,"_42174":3626,"_29767":88778,"_5":21387,"_28235":88500,"_5797":88779},[],"Encryption",{"_6892":3738,"_42174":3626,"_29767":88781,"_5":21387,"_28235":88500,"_5797":88782},[],"**Shared key only.** A distribution set serves identical artifacts to every target, so there is nowhere to put a different payload per device. Use `native` mode for per-device encryption.",{"_6892":3739,"_42174":3626,"_29767":88784,"_5":21387,"_28235":88500,"_5797":88785},[],"Multi-module packs",{"_6892":3740,"_42174":3626,"_29767":88787,"_5":21387,"_28235":88500,"_5797":88788},[],"Each module has its own deliverable, so a pack with several modules installs as **several independent SWUpdate transactions**. SWUpdate cannot roll back across several `.swu` files. See Concepts.",{"_6892":3741,"_42174":3626,"_29767":88790,"_5":21387,"_28235":88500,"_5797":88791},[],"Names",{"_6892":3742,"_42174":3626,"_29767":88793,"_5":21387,"_28235":88500,"_5797":88794},[],"hawkBit soft-deletes software modules, so the name and version of a module that was ever assigned to a device are taken forever. Bump the version.",{"_6892":3743,"_42174":3626,"_29767":88796,"_5":21387,"_28235":88500,"_5797":88797},[],"Launch strategy",{"_6892":3744,"_42174":3626,"_29767":88799,"_5":21387,"_28235":88500,"_5797":88800},[],"Read back from the rollout's groups, so a fixed batch can read back as a percentage. It cannot be edited after creation.",{"_6892":3745,"_42174":3626,"_29767":88802,"_5":21387,"_28235":88500,"_5797":88803},[],"Concurrent changes",{"_6892":3746,"_42174":3626,"_29767":88805,"_5":21387,"_28235":88500,"_5797":88806},[],"Building or changing the same module from two requests answers `409` (`software module N is being built or changed by another request`).",{"_6892":3747,"_42174":3626,"_29767":88808,"_5":21387,"_28235":88500,"_5797":88505},[],{"_6892":3748,"_42174":3626,"_29767":88810,"_5":21387,"_28235":88500,"_5797":88811},[],"hawkBit is its own service with its own database. The Helm chart of this repository does not deploy or manage it.",{"_6892":3749,"_42174":3626,"_29767":88813,"_5":21387,"_28235":88504,"_5797":88814},[],"In `hawkbit` mode nothing is elected and there are no local files to share, so any number of replicas can run: state is in Postgres and hawkBit, and module and launch operations take Postgres locks. If you use shared-key encryption, put SymKMS key storage (`symkms.storage`) on shared storage or S3. See Operations.",{"_6892":3750,"_42174":3750,"_5":21817,"_5797":88816,"_42654":88817,"_29767":88819,"_28235":3750},"Limitations and known issues",[77248,78697,85231,88818],"Operate",[],{"_6892":3751,"_42174":3750,"_29767":88821,"_5":21387,"_28235":3750,"_5797":88822},[],"What Lamassu Updates does not support or does not do yet, collected in one place with the page that explains each item.",{"_6892":3752,"_42174":3750,"_5":42651,"_29767":88824,"_28235":88825,"_5797":87306},[],"/docs/pr-preview/pr-56/platform/updates/limitations#security",{"_6892":3753,"_42174":3750,"_5":42651,"_29767":88827,"_28235":88828,"_5797":88829},[],"/docs/pr-preview/pr-56/platform/updates/limitations#backends","Backends",{"_6892":3754,"_42174":3750,"_5":42651,"_29767":88831,"_28235":88832,"_5797":88833},[],"/docs/pr-preview/pr-56/platform/updates/limitations#packs-and-versions","Packs and versions",{"_6892":3755,"_42174":3750,"_5":42651,"_29767":88835,"_28235":88836,"_5797":88837},[],"/docs/pr-preview/pr-56/platform/updates/limitations#scaling-and-resources","Scaling and resources",{"_6892":3756,"_42174":3750,"_5":42651,"_29767":88839,"_28235":88840,"_5797":88841},[],"/docs/pr-preview/pr-56/platform/updates/limitations#signing-and-encryption","Signing and encryption",{"_6892":3757,"_42174":3750,"_5":42651,"_29767":88843,"_28235":88844,"_5797":88845},[],"/docs/pr-preview/pr-56/platform/updates/limitations#deployment-and-configuration","Deployment and configuration",{"_6892":3758,"_42174":3750,"_5":42651,"_29767":88847,"_28235":88848,"_5797":78513},[],"/docs/pr-preview/pr-56/platform/updates/limitations#observability",{"_6892":3759,"_42174":3750,"_29767":88850,"_5":21387,"_28235":3750,"_5797":88851},[],"This page collects what is unsupported, partial or surprising, so you can check it before you design a rollout. Each item points to the page that explains it.",{"_6892":3760,"_42174":3750,"_29767":88853,"_5":21387,"_28235":88825,"_5797":88854},[],"The service has no authentication, authorization, TLS or mTLS. Use a gateway. See Security.",{"_6892":3761,"_42174":3750,"_29767":88856,"_5":21387,"_28235":88825,"_5797":88857},[],"The `app.server.cert_file`, `key_file` and `authentication.mutual_tls.*` keys have no effect.",{"_6892":3762,"_42174":3750,"_29767":88859,"_5":21387,"_28235":88825,"_5797":88860},[],"The connection to Postgres always uses `sslmode=disable`. In `native` mode the service does not verify the TLS certificate of the KMS, and the SWU signer script calls `curl -k`.",{"_6892":3763,"_42174":3750,"_29767":88862,"_5":21387,"_28235":88825,"_5797":88863},[],"The service sends the fixed identity `X-Principal-ID: admin-mode` to the Device Manager and the KMS, and its SymKMS calls carry no credential.",{"_6892":3764,"_42174":3750,"_29767":88865,"_5":21387,"_28235":88825,"_5797":88866},[],"There is no rate limiting.",{"_6892":3765,"_42174":3750,"_29767":88868,"_5":21387,"_28235":88828,"_5797":88869},[],"The two backends differ in features. See Capabilities. Notably, `hawkbit` mode has no per-device encryption, no custom workflows, no editing of a launch strategy after creation, no early completion of a campaign, no adding devices to a running campaign, no push events and no set-level prebuilt upload. A `swu-prebuilt` catalog module does accept a finished `.swu`. `native` mode builds one deliverable per pack and has no per-module deliverables.",{"_6892":3766,"_42174":3750,"_29767":88871,"_5":21387,"_28235":88828,"_5797":88872},[],"In `hawkbit` mode, a pack with several modules installs as several independent SWUpdate transactions. SWUpdate cannot roll back across several `.swu` files.",{"_6892":3767,"_42174":3750,"_29767":88874,"_5":21387,"_28235":88828,"_5797":88875},[],"hawkBit reserves the name and version of a module that was ever assigned to a device. Bump the version.",{"_6892":3768,"_42174":3750,"_29767":88877,"_5":21387,"_28235":88828,"_5797":88878},[],"In `hawkbit` mode a module build replaces the module's input files with the deliverable, so a module cannot be built twice: release a new version.",{"_6892":3769,"_42174":3750,"_29767":88880,"_5":21387,"_28235":88828,"_5797":88881},[],"hawkBit rollouts are created static: devices added to a group after a launch is created are not picked up by that launch.",{"_6892":3770,"_42174":3750,"_29767":88883,"_5":21387,"_28235":88828,"_5797":88884},[],"`hawkbit` mode reads a launch's strategy back from the rollout's groups, so a launch created with a fixed batch can read back as a percentage.",{"_6892":3771,"_42174":3750,"_29767":88886,"_5":21387,"_28235":88828,"_5797":88887},[],"A first `hawkbit` launch with a `test_device_id` fails until the group's devices exist in hawkBit. See Troubleshooting.",{"_6892":3772,"_42174":3750,"_29767":88889,"_5":21387,"_28235":88828,"_5797":88890},[],"`POST /updates/v1/artifacts` in `hawkbit` mode holds the whole file in memory and in Postgres for 30 minutes and cannot be linked to a pack. Upload through the catalog route instead. See hawkBit mode.",{"_6892":3773,"_42174":3750,"_29767":88892,"_5":21387,"_28235":88828,"_5797":88893},[],"hawkBit's own artifact limits (1 GiB per file, 20 GiB in total) apply unless you use the image of this repository or raise them. The image with the S3 artifact plugin is built from `docker/hawkbit` and is not published to a registry.",{"_6892":3774,"_42174":3750,"_29767":88895,"_5":21387,"_28235":88832,"_5797":88896},[],"**A new `native` pack version inherits the previous version's encryption settings for `.swu` builds.** `POST .../new` copies them, and a `.swu` build with no encryption fields does not clear them. After a per-device build, every later version of that pack still reports `per-device`, keeps the old `uncovered_devices`, and device downloads fail with `404` (`SWU not available for device ...`). Use a separate pack for each encryption variant. (`.../package` builds reset these fields.)",{"_6892":3775,"_42174":3750,"_29767":88898,"_5":21387,"_28235":88832,"_5797":88899},[],"`POST .../new` does not carry the pack's sw-description over: each version needs its own upload.",{"_6892":3776,"_42174":3750,"_29767":88901,"_5":21387,"_28235":88832,"_5797":88902},[],"**Artifact names are global.** A name can only be reused with a higher `version`, and the API answers a violation with `500`, not a `4xx`.",{"_6892":3777,"_42174":3750,"_29767":88904,"_5":21387,"_28235":88832,"_5797":88905},[],"A built version is immutable. To change it, create a new version.",{"_6892":3778,"_42174":3750,"_29767":88907,"_5":21387,"_28235":88836,"_5797":88908},[],"With local storage on one `ReadWriteOnce` volume, only one `native` replica can run. Move `artifacts`, `builds` and `symkms` to S3 to scale out. See Operations.",{"_6892":3779,"_42174":3750,"_29767":88910,"_5":21387,"_28235":88836,"_5797":88911},[],"SymKMS keys also default to local storage: point `symkms.storage` at S3, or share a volume, or they are lost.",{"_6892":3780,"_42174":3750,"_29767":88913,"_5":21387,"_28235":88836,"_5797":88914},[],"Per-device builds are CPU bound and grow with the number of devices. See Signing and encryption.",{"_6892":3781,"_42174":3750,"_29767":88916,"_5":21387,"_28235":88836,"_5797":88917},[],"Encrypting needs the file in memory (`swugenerator`, AES-GCM packages and raw modules, and any store with at-rest encryption), so very large encrypted files need proportionally large memory. Signing a raw module streams the file.",{"_6892":3782,"_42174":3750,"_29767":88919,"_5":21387,"_28235":88836,"_5797":88920},[],"Each in-flight upload needs free temporary disk as large as the file.",{"_6892":3783,"_42174":3750,"_29767":88922,"_5":21387,"_28235":88840,"_5797":88923},[],"Signing needs a KMS that returns CMS (`PKCS7 SignedData`). The service refuses a non-CMS answer when it signs manifests and raw-module checksums, but the SWU signer script does not check it: with a KMS without CMS support a `.swu` build can succeed and still be rejected by a device that sets `public-key-file`. See Signing and encryption.",{"_6892":3784,"_42174":3750,"_29767":88925,"_5":21387,"_28235":88840,"_5797":88926},[],"`non-swu` packages and raw modules are always AES-GCM, whatever algorithm name you send, and an Ascon-80pq key is refused for them.",{"_6892":3785,"_42174":3750,"_29767":88928,"_5":21387,"_28235":88840,"_5797":88929},[],"SymKMS does not enforce key purposes: any purpose is accepted and an empty one is a wildcard (an intentional placeholder). It refuses a caller-supplied IV for GCM, CTR and Ascon.",{"_6892":3786,"_42174":3750,"_29767":88931,"_5":21387,"_28235":88840,"_5797":88932},[],"Algorithm names are not normalised end to end: SymKMS ignores case and `_` versus `-`, but `swugenerator` needs hyphens (`aes-256-gcm`), and `ascon128a` is not `ASCON-128A`.",{"_6892":3787,"_42174":3750,"_29767":88934,"_5":21387,"_28235":88844,"_5797":88935},[],"`app.server.protocol`, `app.server.log_level`, `app.server.health_check` and the `health_check_logging` of the examples are accepted but not read. The request log is always on.",{"_6892":3788,"_42174":3750,"_29767":88937,"_5":21387,"_28235":88844,"_5797":88938},[],"The database is always named `updates`, and the service does not create it.",{"_6892":3789,"_42174":3750,"_29767":88940,"_5":21387,"_28235":88844,"_5797":88941},[],"The example configuration files contain developer-machine values and development secrets.",{"_6892":3790,"_42174":3750,"_29767":88943,"_5":21387,"_28235":88844,"_5797":88944},[],"The Helm chart's `config.update_domain` default (`http://updates:10090/v1/`) lacks the `/updates` prefix: the value must be the full API base ending in `/updates/v1/`, or the download URLs do not resolve.",{"_6892":3791,"_42174":3750,"_29767":88946,"_5":21387,"_28235":88844,"_5797":88947},[],"The Helm chart declares `postgresql.*` and `ingress.*` values but deploys no PostgreSQL and has no ingress template. It always uses the `Recreate` strategy, renders all of `config` (passwords included) into a ConfigMap, and has no value to add environment variables, volumes or an existing Secret.",{"_6892":3792,"_42174":3750,"_29767":88949,"_5":21387,"_28235":88844,"_5797":88950},[],"The container image does not drop privileges, and it ships a developer `config.yml`: mount your own.",{"_6892":3793,"_42174":3750,"_29767":88952,"_5":21387,"_28235":88844,"_5797":88953},[],"To build the Docker image yourself, the build context must contain the `lamassuiot/core` and `lamassuiot/sdk` checkouts next to `ota/`.",{"_6892":3794,"_42174":3750,"_29767":88955,"_5":21387,"_28235":88844,"_5797":88956},[],"`GET /health` does not check the database, WFX or hawkBit.",{"_6892":3795,"_42174":3750,"_29767":88958,"_5":21387,"_28235":88848,"_5797":88959},[],"The service exports no traces, metrics or logs, and has no metrics endpoint. See Operations.",{"_6892":3796,"_42174":3796,"_5":21817,"_5797":78457,"_42654":88961,"_29767":88962,"_28235":3796},[77248,78697,85231,88818],[],{"_6892":3797,"_42174":3796,"_29767":88964,"_5":21387,"_28235":3796,"_5797":88965},[],"Deploy Lamassu Updates with Docker Compose or Helm, scale it out, size it, observe it, back it up and upgrade it.",{"_6892":3798,"_42174":3796,"_5":42651,"_29767":88967,"_28235":88968,"_5797":88969},[],"/docs/pr-preview/pr-56/platform/updates/operations#deploy","Deploy",{"_6892":3799,"_42174":3796,"_5":42651,"_29767":88971,"_28235":88972,"_5797":88973},[],"/docs/pr-preview/pr-56/platform/updates/operations#the-container-image","The container image",{"_6892":3800,"_42174":3796,"_5":42651,"_29767":88975,"_28235":88976,"_5797":88977},[],"/docs/pr-preview/pr-56/platform/updates/operations#docker-compose","Docker Compose",{"_6892":3801,"_42174":3796,"_5":42651,"_29767":88979,"_28235":88980,"_5797":78310},[],"/docs/pr-preview/pr-56/platform/updates/operations#helm",{"_6892":3802,"_42174":3796,"_5":42651,"_29767":88982,"_28235":88983,"_5797":88984},[],"/docs/pr-preview/pr-56/platform/updates/operations#secrets-with-helm","Secrets with Helm",{"_6892":3803,"_42174":3796,"_5":42651,"_29767":88986,"_28235":88987,"_5797":88988},[],"/docs/pr-preview/pr-56/platform/updates/operations#scale-out","Scale out",{"_6892":3804,"_42174":3796,"_5":42651,"_29767":88990,"_28235":88991,"_5797":88992},[],"/docs/pr-preview/pr-56/platform/updates/operations#resource-sizing","Resource sizing",{"_6892":3805,"_42174":3796,"_5":42651,"_29767":88994,"_28235":88995,"_5797":88996},[],"/docs/pr-preview/pr-56/platform/updates/operations#upload-size-and-proxies","Upload size and proxies",{"_6892":3806,"_42174":3796,"_5":42651,"_29767":88998,"_28235":88999,"_5797":89000},[],"/docs/pr-preview/pr-56/platform/updates/operations#health-logging-and-shutdown","Health, logging and shutdown",{"_6892":3807,"_42174":3796,"_5":42651,"_29767":89002,"_28235":89003,"_5797":78513},[],"/docs/pr-preview/pr-56/platform/updates/operations#observability",{"_6892":3808,"_42174":3796,"_5":42651,"_29767":89005,"_28235":89006,"_5797":89007},[],"/docs/pr-preview/pr-56/platform/updates/operations#backup-and-restore","Backup and restore",{"_6892":3809,"_42174":3796,"_5":42651,"_29767":89009,"_28235":89010,"_5797":89011},[],"/docs/pr-preview/pr-56/platform/updates/operations#upgrades","Upgrades",{"_6892":3810,"_42174":3796,"_5":42651,"_29767":89013,"_28235":89014,"_5797":89015},[],"/docs/pr-preview/pr-56/platform/updates/operations#back-up","Back up",{"_6892":3811,"_42174":3796,"_5":42651,"_29767":89017,"_28235":89018,"_5797":89019},[],"/docs/pr-preview/pr-56/platform/updates/operations#deploy-the-new-image","Deploy the new image",{"_6892":3812,"_42174":3796,"_5":42651,"_29767":89021,"_28235":89022,"_5797":84190},[],"/docs/pr-preview/pr-56/platform/updates/operations#verify",{"_6892":3813,"_42174":3796,"_5":42651,"_29767":89024,"_28235":89025,"_5797":89026},[],"/docs/pr-preview/pr-56/platform/updates/operations#hawkbit-operations","hawkBit operations",{"_6892":3814,"_42174":3796,"_5":42651,"_29767":89028,"_28235":89029,"_5797":89030},[],"/docs/pr-preview/pr-56/platform/updates/operations#security-checklist","Security checklist",{"_6892":3815,"_42174":3796,"_29767":89032,"_5":21387,"_28235":3796,"_5797":89033},[],"This page is for whoever runs the service: how to deploy it, what to put around it, how it behaves with several replicas, what to back up and how to upgrade. Configuration keys are documented in the configuration reference; the threat model is in Security.",{"_6892":3816,"_42174":3796,"_29767":89035,"_5":21387,"_28235":88972,"_5797":89036},[],"Release images are published to `ghcr.io/lamassuiot/ota`. The image runs one process, the monolith (the Updates API and SymKMS), on port `10090`. It contains the `swugenerator` tool, the signer scripts (`/app/sign_kms.sh`) and the WFX workflow files (`/app/wfx/workflow/dau/`). It does not set a non-root user.",{"_6892":3817,"_42174":3796,"_29767":89038,"_5":21387,"_28235":88972,"_5797":89039},[],"The image includes the repository's developer `config.yml` at `/etc/lamassuiot/config.yml`: always mount your own file over it, or point `OTA_CONFIG_FILE` at yours (see how the configuration is loaded). To build the image yourself, the Dockerfile expects its context to be the parent directory of the `ota` checkout, which must also contain `lamassuiot/core` and `lamassuiot/sdk`.",{"_6892":3818,"_42174":3796,"_29767":89041,"_5":21387,"_28235":88976,"_5797":89042},[],"`docker-compose.yml` is for local and demonstration use. It needs the external network `ota-net` (`docker network create ota-net`) and a `.env` file (copy `.env.example`; `HOST_IP` lets containers reach Lamassu on the host). It defines these named volumes:",{"_6892":3819,"_42174":3796,"_29767":89044,"_5":21387,"_28235":88976,"_5797":89045},[],"Volume",{"_6892":3820,"_42174":3796,"_29767":89047,"_5":21387,"_28235":88976,"_5797":85935},[],{"_6892":3821,"_42174":3796,"_29767":89049,"_5":21387,"_28235":88976,"_5797":89050},[],"`pgdata`",{"_6892":3822,"_42174":3796,"_29767":89052,"_5":21387,"_28235":88976,"_5797":89053},[],"Postgres data: the `updates` and `hawkbit` databases, and the `wfx` database that holds device jobs in `native` mode",{"_6892":3823,"_42174":3796,"_29767":89055,"_5":21387,"_28235":88976,"_5797":89056},[],"`update_files`",{"_6892":3824,"_42174":3796,"_29767":89058,"_5":21387,"_28235":88976,"_5797":89059},[],"Build scratch and local update files of the `updates` service",{"_6892":3825,"_42174":3796,"_29767":89061,"_5":21387,"_28235":88976,"_5797":89062},[],"`sym_keys`",{"_6892":3826,"_42174":3796,"_29767":89064,"_5":21387,"_28235":88976,"_5797":89065},[],"SymKMS key material",{"_6892":3827,"_42174":3796,"_29767":89067,"_5":21387,"_28235":88976,"_5797":89068},[],"`hawkbit_artifacts`",{"_6892":3828,"_42174":3796,"_29767":89070,"_5":21387,"_28235":88976,"_5797":89071},[],"hawkBit's artifact files, with `HAWKBIT_ARTIFACT_STORAGE=fs`",{"_6892":3829,"_42174":3796,"_29767":89073,"_5":21387,"_28235":88976,"_5797":89074},[],"`rustfs_data`",{"_6892":3830,"_42174":3796,"_29767":89076,"_5":21387,"_28235":88976,"_5797":89077},[],"The local S3 store, with `--profile s3`",{"_6892":3831,"_42174":3796,"_29767":89079,"_5":21387,"_28235":88976,"_5797":89080},[],"`docker compose --profile s3 up -d` also starts RustFS (S3 API on port `9000`) and an `s3-init` job that creates one bucket, `ota-updates`, with default server-side encryption turned on. By convention each backend uses a prefix: `hawkbit/` for hawkBit's artifacts and `ota/artifacts/` and `ota/builds/` for `native` mode. To keep artifacts and builds in S3, add the `artifacts` and `builds` blocks shown in `config.yml`, and set `HAWKBIT_ARTIFACT_STORAGE=s3` for hawkBit.",{"_6892":3832,"_42174":3796,"_29767":89082,"_5":21387,"_28235":88980,"_5797":89083},[],"The chart is `helm/updates-monolithic` in the repository. It deploys the `updates` service only: Postgres, WFX, Lamassu and, in `hawkbit` mode, hawkBit are external.",{"_6892":3833,"_42174":3796,"_29767":89085,"_5":21387,"_28235":88980,"_5797":89086},[],"Value",{"_6892":3834,"_42174":3796,"_29767":89088,"_5":21387,"_28235":88980,"_5797":77635},[],{"_6892":3835,"_42174":3796,"_29767":89090,"_5":21387,"_28235":88980,"_5797":79765},[],{"_6892":3836,"_42174":3796,"_29767":89092,"_5":21387,"_28235":88980,"_5797":89093},[],"`image.repository`, `image.tag`",{"_6892":3837,"_42174":3796,"_29767":89095,"_5":21387,"_28235":88980,"_5797":89096},[],"`updates-monolithic`, `latest`",{"_6892":3838,"_42174":3796,"_29767":89098,"_5":21387,"_28235":88980,"_5797":89099},[],"The image to run. Set `ghcr.io/lamassuiot/ota` and a release tag.",{"_6892":3839,"_42174":3796,"_29767":89101,"_5":21387,"_28235":88980,"_5797":89102},[],"`replicaCount`",{"_6892":3840,"_42174":3796,"_29767":89104,"_5":21387,"_28235":88980,"_5797":89105},[],"`1`",{"_6892":3841,"_42174":3796,"_29767":89107,"_5":21387,"_28235":88980,"_5797":89108},[],"Replicas. See Scale out.",{"_6892":3842,"_42174":3796,"_29767":89110,"_5":21387,"_28235":88980,"_5797":89111},[],"`service.type`, `service.port`",{"_6892":3843,"_42174":3796,"_29767":89113,"_5":21387,"_28235":88980,"_5797":89114},[],"`ClusterIP`, `10090`",{"_6892":3844,"_42174":3796,"_29767":89116,"_5":21387,"_28235":88980,"_5797":89117},[],"The chart has no ingress template: `ingress.*` in `values.yaml` has no effect. Expose the service with your own ingress or gateway.",{"_6892":3845,"_42174":3796,"_29767":89119,"_5":21387,"_28235":88980,"_5797":89120},[],"`resources`",{"_6892":3846,"_42174":3796,"_29767":89122,"_5":21387,"_28235":88980,"_5797":89123},[],"limits `2000m` CPU, `4Gi`; requests `500m`, `1Gi`",{"_6892":3847,"_42174":3796,"_29767":89125,"_5":21387,"_28235":88980,"_5797":89126},[],"See Resource sizing.",{"_6892":3848,"_42174":3796,"_29767":89128,"_5":21387,"_28235":88980,"_5797":89129},[],"`persistence.*`",{"_6892":3849,"_42174":3796,"_29767":89131,"_5":21387,"_28235":88980,"_5797":89132},[],"enabled, `ReadWriteOnce`, `10Gi`",{"_6892":3850,"_42174":3796,"_29767":89134,"_5":21387,"_28235":88980,"_5797":89135},[],"The volume mounted at `/data`: build scratch and, by default, local update files.",{"_6892":3851,"_42174":3796,"_29767":89137,"_5":21387,"_28235":88980,"_5797":89138},[],"`leaderElection.enabled`, `leaderElection.mode`",{"_6892":3852,"_42174":3796,"_29767":89140,"_5":21387,"_28235":88980,"_5797":89141},[],"`true`, `kubernetes`",{"_6892":3853,"_42174":3796,"_29767":89143,"_5":21387,"_28235":88980,"_5797":89144},[],"See Scale out. The chart injects `leader_election.mode` into the configuration for you.",{"_6892":3854,"_42174":3796,"_29767":89146,"_5":21387,"_28235":88980,"_5797":89147},[],"`config.*`",{"_6892":3855,"_42174":3796,"_29767":89149,"_5":21387,"_28235":88980,"_5797":89150},[],"see `values.yaml`",{"_6892":3856,"_42174":3796,"_29767":89152,"_5":21387,"_28235":88980,"_5797":89153},[],"The whole service configuration, rendered into a ConfigMap.",{"_6892":3857,"_42174":3796,"_29767":89155,"_5":21387,"_28235":88980,"_5797":89156},[],"`serviceAccount.create`",{"_6892":3858,"_42174":3796,"_29767":89158,"_5":21387,"_28235":88980,"_5797":89159},[],"`true`",{"_6892":3859,"_42174":3796,"_29767":89161,"_5":21387,"_28235":88980,"_5797":89162},[],"Creates the service account and, with leader election enabled, a Role on `leases` (`get`, `list`, `watch`, `create`, `update`, `patch`).",{"_6892":3860,"_42174":3796,"_29767":89164,"_5":21387,"_28235":88980,"_5797":89165},[],"`podSecurityContext`, `securityContext`",{"_6892":3861,"_42174":3796,"_29767":89167,"_5":21387,"_28235":88980,"_5797":27273},[],{"_6892":3862,"_42174":3796,"_29767":89169,"_5":21387,"_28235":88980,"_5797":89170},[],"Not set by default.",{"_6892":3863,"_42174":3796,"_29767":89172,"_5":21387,"_28235":88980,"_5797":89173},[],"`postgresql.*`",{"_6892":3864,"_42174":3796,"_29767":89175,"_5":21387,"_28235":88980,"_5797":89176},[],"not used",{"_6892":3865,"_42174":3796,"_29767":89178,"_5":21387,"_28235":88980,"_5797":89179},[],"Declared but nothing deploys PostgreSQL: use an external database.",{"_6892":3866,"_42174":3796,"_29767":89181,"_5":21387,"_28235":88980,"_5797":89182},[],"Fixed by the templates: the deployment strategy is &#x2A;*`Recreate`** (a deploy has a short outage), the pod's termination grace period is 120 s with a 5 s `preStop` sleep, probes call `GET /health`, and a change in `config` rolls the pods (a checksum annotation).",{"_6892":3867,"_42174":3796,"_29767":89184,"_5":21387,"_28235":88980,"_5797":89185},[],"Point `config.*` at the dependencies. In particular, create the `updates` database in your Postgres first. The service creates its tables, not the database. The chart default `config.update_domain` is `http://updates:10090/v1/`, which lacks the `/updates` prefix: set it to the full API base ending in `/updates/v1/` as devices reach it, or the download URLs stored on packs will not resolve.",{"_6892":3868,"_42174":3796,"_29767":89187,"_5":21387,"_28235":88983,"_5797":89188},[],"The chart renders the whole `config` value, including `storage.password`, `encryption.local_key`, S3 keys and `hawkbit.password`, into a ConfigMap. It has no `existingSecret` option, and no value to add environment variables or volumes, so the service's environment-variable overrides and its `*_file` credentials cannot be fed from a Kubernetes Secret without patching or wrapping the chart. Until then:",{"_6892":3869,"_42174":3796,"_29767":89190,"_5":21387,"_28235":88983,"_5797":89191},[],"Keep the real values in a values file that is not committed (`-f secrets.values.yaml`), or generate it from your secret manager at deploy time.",{"_6892":3870,"_42174":3796,"_29767":89193,"_5":21387,"_28235":88983,"_5797":89194},[],"Restrict who can read ConfigMaps and Helm release secrets in the namespace.",{"_6892":3871,"_42174":3796,"_29767":89196,"_5":21387,"_28235":88983,"_5797":89197},[],"Prefer credentials that avoid static keys: leave the S3 access keys out to use the AWS default credential chain (IRSA or an instance profile).",{"_6892":3872,"_42174":3796,"_29767":89199,"_5":21387,"_28235":88983,"_5797":89200},[],"Override the placeholder database password the chart ships in `config.storage`.",{"_6892":3873,"_42174":3796,"_29767":89202,"_5":21387,"_28235":88983,"_5797":89203},[],"`helm/updates.yaml` is a values override for the umbrella Lamassu chart, used as `helm upgrade lamassu lamassu/lamassu -f lamassu.yaml -f updates.yaml`. It sets the image, replicas, resources, persistence and `config` of the `updates` service there. Its example resource limit (`500m` CPU) is lower than the chart's: see Resource sizing.",{"_6892":3874,"_42174":3796,"_29767":89205,"_5":21387,"_28235":88987,"_5797":89206},[],"Serving HTTP works on any number of replicas in both modes. What differs is the state each replica needs.",{"_6892":3875,"_42174":3796,"_29767":89208,"_5":21387,"_28235":88987,"_5797":89209},[],"`native`",{"_6892":3876,"_42174":3796,"_29767":89211,"_5":21387,"_28235":88987,"_5797":86482},[],{"_6892":3877,"_42174":3796,"_29767":89213,"_5":21387,"_28235":88987,"_5797":89214},[],"Background work",{"_6892":3878,"_42174":3796,"_29767":89216,"_5":21387,"_28235":88987,"_5797":89217},[],"Elected: the WFX event consumer and the scheduled-launch trigger run on one replica",{"_6892":3879,"_42174":3796,"_29767":89219,"_5":21387,"_28235":88987,"_5797":81871},[],{"_6892":3880,"_42174":3796,"_29767":89221,"_5":21387,"_28235":88987,"_5797":89222},[],"State",{"_6892":3881,"_42174":3796,"_29767":89224,"_5":21387,"_28235":88987,"_5797":89225},[],"Postgres, WFX, the `artifacts`, `builds` and `symkms` stores",{"_6892":3882,"_42174":3796,"_29767":89227,"_5":21387,"_28235":88987,"_5797":89228},[],"Postgres and hawkBit",{"_6892":3883,"_42174":3796,"_29767":89230,"_5":21387,"_28235":88987,"_5797":89231},[],"Local files",{"_6892":3884,"_42174":3796,"_29767":89233,"_5":21387,"_28235":88987,"_5797":89234},[],"Build scratch only (rebuilt by each replica)",{"_6892":3885,"_42174":3796,"_29767":89236,"_5":21387,"_28235":88987,"_5797":81871},[],{"_6892":3886,"_42174":3796,"_29767":89238,"_5":21387,"_28235":88987,"_5797":89239},[],"Extra requirement",{"_6892":3887,"_42174":3796,"_29767":89241,"_5":21387,"_28235":88987,"_5797":89242},[],"S3 stores and leader election",{"_6892":3888,"_42174":3796,"_29767":89244,"_5":21387,"_28235":88987,"_5797":89245},[],"Shared or S3 `symkms.storage` if you use shared-key encryption",{"_6892":3889,"_42174":3796,"_29767":89247,"_5":21387,"_28235":88987,"_5797":89248},[],"To run more than one `native` replica:",{"_6892":3890,"_42174":3796,"_29767":89250,"_5":21387,"_28235":88987,"_5797":89251},[],"**Shared storage.** The default is a `ReadWriteOnce` volume, which cannot be mounted by pods on different nodes, so it limits the deployment to one replica regardless of `replicaCount`. Point `config.artifacts`, `config.builds` and `config.symkms.storage` at S3 and set `persistence.enabled: false`. SymKMS keys also default to local storage, and would not be shared between replicas. The service logs a warning at start-up when build outputs are on local storage. sw-descriptions are stored in Postgres, so nothing local is needed by another replica.",{"_6892":3891,"_42174":3796,"_29767":89253,"_5":21387,"_28235":88987,"_5797":89254},[],"**Leader election.** Leave `leaderElection.enabled: true`. The WFX event consumer advances a campaign's batches on every job completion, and the trigger starts due scheduled launches and repairs interrupted batches. With several replicas and no election, each one counts the same completions and releases the next batch before the current one succeeded.",{"_6892":3892,"_42174":3796,"_29767":89256,"_5":21387,"_28235":88987,"_5797":89257},[],"`leaderElection.mode` (`leader_election.mode` in the file) is:",{"_6892":3893,"_42174":3796,"_29767":89259,"_5":21387,"_28235":88987,"_5797":89086},[],{"_6892":3894,"_42174":3796,"_29767":89261,"_5":21387,"_28235":88987,"_5797":89262},[],"Behaviour",{"_6892":3895,"_42174":3796,"_29767":89264,"_5":21387,"_28235":88987,"_5797":89265},[],"empty (auto)",{"_6892":3896,"_42174":3796,"_29767":89267,"_5":21387,"_28235":88987,"_5797":89268},[],"Kubernetes Leases inside a cluster; otherwise a Postgres advisory lock. This is the default of the binary.",{"_6892":3897,"_42174":3796,"_29767":89270,"_5":21387,"_28235":88987,"_5797":89271},[],"`kubernetes`",{"_6892":3898,"_42174":3796,"_29767":89273,"_5":21387,"_28235":88987,"_5797":89274},[],"Leases, required. Startup fails if the service account cannot use them. This is the chart default.",{"_6892":3899,"_42174":3796,"_29767":89276,"_5":21387,"_28235":88987,"_5797":89277},[],"`database`",{"_6892":3900,"_42174":3796,"_29767":89279,"_5":21387,"_28235":88987,"_5797":89280},[],"A Postgres advisory lock, for when granting RBAC is not an option.",{"_6892":3901,"_42174":3796,"_29767":89282,"_5":21387,"_28235":88987,"_5797":89283},[],"With Leases, one Lease per role is created in the pod's namespace (`lamassu-updates-wfx-event-consumer` and `lamassu-updates-scheduled-launch-trigger`), and `kubectl get lease` shows the pod that leads (`POD_NAME` is the holder). The lease lasts 15 s and is renewed within 10 s, so a failover takes about that long. With the database lock, a standby retries every 15 s and the leader verifies every 5 s that its connection is still alive.",{"_6892":3902,"_42174":3796,"_29767":89285,"_5":21387,"_28235":88987,"_5797":89286},[],"Other multi-replica guarantees: builds and version changes of the same pack take a Postgres lock (a concurrent request answers `409`), schema migrations take one too, and a campaign batch is claimed atomically so it is not released twice. Each replica keeps up to 25 database connections: budget `25 x replicas` against Postgres `max_connections`.",{"_6892":3903,"_42174":3796,"_29767":89288,"_5":21387,"_28235":88987,"_5797":89289},[],"In `hawkbit` mode there is nothing to elect and no local files to share. The chart still mounts the `ReadWriteOnce` volume while `persistence.enabled` is true, so set it to `false` to run replicas on different nodes.",{"_6892":3904,"_42174":3796,"_29767":89291,"_5":21387,"_28235":88987,"_5797":89292},[],"Because the chart uses the `Recreate` strategy, a deploy stops every replica before starting the new ones, even with `replicaCount` above 1.",{"_6892":3905,"_42174":3796,"_29767":89294,"_5":21387,"_28235":88991,"_5797":89295},[],"**CPU** is the lever on per-device build time. A build runs one `swugenerator` per device, and the parallelism is derived from the container's CPU limit, not the node's cores: a `500m` limit collapses it to half a core. The chart's default of `2000m` is a starting point for groups in the hundreds.",{"_6892":3906,"_42174":3796,"_29767":89297,"_5":21387,"_28235":88991,"_5797":89298},[],"**Memory.** Uploads, downloads and non-encrypting builds are streamed, so memory does not grow with the file (the maintainers measured a peak of about 150 MiB resident for a 10 GiB upload and for a 10 GiB download). Encrypting needs the file in memory: `swugenerator` reads an artifact into memory to encrypt it, AES-GCM of `non-swu` packages and `raw` modules works on one buffer, and a store with at-rest encryption enabled decrypts whole objects in memory. Size memory for the largest file you encrypt times the concurrent builds. In `hawkbit` mode, `build_memory_limit_mb` refuses such a build before the pod is killed.",{"_6892":3907,"_42174":3796,"_29767":89300,"_5":21387,"_28235":88991,"_5797":89301},[],"**Disk.** Each in-flight upload is written to a temporary file under `TMPDIR` before it is stored, so overlapping uploads need that much free disk. Build scratch also uses `update_files_base_dir` (`/data` in the chart). Give the volume room for several simultaneous uploads (the umbrella example uses `50Gi`). The chart exposes no environment values, so setting `TMPDIR` to the volume needs a patched or wrapped chart.",{"_6892":3908,"_42174":3796,"_29767":89303,"_5":21387,"_28235":88995,"_5797":89304},[],"`max_artifact_size_mb` (default 10 GiB) caps one uploaded file. Anything in front of the service must allow the same size and keep the connection open as long as the transfer takes: the service itself uses 6-hour read and write timeouts and closes idle connections after 5 minutes. For ingress-nginx:",{"_6892":3909,"_42174":3796,"_29767":89306,"_5":21387,"_28235":88995,"_5797":89307},[],"nginx's default body limit is 1 MiB, which is what rejects \"a few MB\" uploads before they reach the service. A file above the service's own limit gets `413` naming the limit.",{"_6892":3910,"_42174":3796,"_29767":89309,"_5":21387,"_28235":88999,"_5797":89310},[],"What",{"_6892":3911,"_42174":3796,"_29767":89312,"_5":21387,"_28235":88999,"_5797":89313},[],"How",{"_6892":3912,"_42174":3796,"_29767":89315,"_5":21387,"_28235":88999,"_5797":89316},[],"Liveness and readiness",{"_6892":3913,"_42174":3796,"_29767":89318,"_5":21387,"_28235":88999,"_5797":89319},[],"`GET /health` returns `{\"status\":\"ok\"}` without checking Postgres, WFX or hawkBit, so it shows only that the process answers. The chart uses it for both probes, and the Docker image runs it every 30 seconds.",{"_6892":3914,"_42174":3796,"_29767":89321,"_5":21387,"_28235":88999,"_5797":88773},[],{"_6892":3915,"_42174":3796,"_29767":89323,"_5":21387,"_28235":88999,"_5797":89324},[],"`GET /updates/v1/capabilities` shows the active backend and what it supports. It is unauthenticated and has no side effects, but in `hawkbit` mode it asks hawkBit, so do not use it as a probe.",{"_6892":3916,"_42174":3796,"_29767":89326,"_5":21387,"_28235":88999,"_5797":89327},[],"Logs",{"_6892":3917,"_42174":3796,"_29767":89329,"_5":21387,"_28235":88999,"_5797":89330},[],"Written to standard output: the application log (level `app.logs.level`) and an access log of every request. At `debug` the start-up log includes the whole configuration, secrets too.",{"_6892":3918,"_42174":3796,"_29767":89332,"_5":21387,"_28235":88999,"_5797":89333},[],"Shutdown",{"_6892":3919,"_42174":3796,"_29767":89335,"_5":21387,"_28235":88999,"_5797":89336},[],"On `SIGTERM` or `SIGINT` the service stops accepting requests, drains in-flight ones for up to `app.server.shutdown_timeout` (60 s), hands over leadership and, in `native` mode, waits up to 30 s more for a batch dispatch under way. The chart's grace period (120 s) covers this.",{"_6892":3920,"_42174":3796,"_29767":89338,"_5":21387,"_28235":89003,"_5797":89339},[],"The service does not export traces, metrics or logs. Its outgoing HTTP clients (the SymKMS client) and its database layer are instrumented with OpenTelemetry, but no tracer provider or exporter is configured, and there is no metrics endpoint. The `otel/` directory of the repository holds a local development stack (Grafana Alloy with OTLP receivers on 4317 and 4318, Loki, Tempo, Prometheus, Grafana; Jaeger in `otel/jaeger/`) that nothing feeds today. Until exporters are added, monitor the process log and `/health`, and watch Kubernetes events and Leases.",{"_6892":3921,"_42174":3796,"_29767":89341,"_5":21387,"_28235":89006,"_5797":89015},[],{"_6892":3922,"_42174":3796,"_29767":89343,"_5":21387,"_28235":89006,"_5797":89344},[],"Why",{"_6892":3923,"_42174":3796,"_29767":89346,"_5":21387,"_28235":89006,"_5797":89347},[],"Postgres: the `updates` database, plus `wfx` in `native` mode (the device jobs) and `hawkbit` in `hawkbit` mode",{"_6892":3924,"_42174":3796,"_29767":89349,"_5":21387,"_28235":89006,"_5797":89350},[],"Packs, launches, device history and, in `hawkbit` mode, sw-descriptions, signed manifests and staged state",{"_6892":3925,"_42174":3796,"_29767":89352,"_5":21387,"_28235":89006,"_5797":89353},[],"The `artifacts` and `builds` S3 buckets (or the `update_files` volume)",{"_6892":3926,"_42174":3796,"_29767":89355,"_5":21387,"_28235":89006,"_5797":89356},[],"Artifact binaries and build outputs. Builds can be rebuilt from artifacts and the sw-description (stored in Postgres); the artifacts themselves cannot be recreated.",{"_6892":3927,"_42174":3796,"_29767":89358,"_5":21387,"_28235":89006,"_5797":89359},[],"The `symkms` store (S3 bucket or the `sym_keys` volume)",{"_6892":3928,"_42174":3796,"_29767":89361,"_5":21387,"_28235":89006,"_5797":89362},[],"Device and shared encryption keys. If they are lost, packages already delivered cannot be rebuilt identically, and devices cannot decrypt new ones.",{"_6892":3929,"_42174":3796,"_29767":89364,"_5":21387,"_28235":89006,"_5797":89365},[],"`encryption.local_key` (or the AWS KMS key)",{"_6892":3930,"_42174":3796,"_29767":89367,"_5":21387,"_28235":89006,"_5797":89368},[],"Every blob stored with at-rest encryption is unreadable without it. Store it separately from the data.",{"_6892":3931,"_42174":3796,"_29767":89370,"_5":21387,"_28235":89006,"_5797":89371},[],"hawkBit's artifact store (volume or bucket), `hawkbit` mode",{"_6892":3932,"_42174":3796,"_29767":89373,"_5":21387,"_28235":89006,"_5797":89374},[],"The artifact files",{"_6892":3933,"_42174":3796,"_29767":89376,"_5":21387,"_28235":89006,"_5797":89377},[],"Restore the database and the blob stores from the same point in time: a database that references an artifact missing from storage returns errors on download and rebuild. In `hawkbit` mode, also keep the `updates` and `hawkbit` databases consistent: rows of the `updates` database are scoped to the hawkBit instance that wrote them, and are ignored if hawkBit comes back from a different data set.",{"_6892":3934,"_42174":3796,"_29767":89379,"_5":21387,"_28235":89014,"_5797":89380},[],"Take the backups above, mainly the `updates` database.",{"_6892":3935,"_42174":3796,"_29767":89382,"_5":21387,"_28235":89018,"_5797":89383},[],"There are no migration files. At start-up the service renames, creates and migrates its own tables under a Postgres advisory lock, so replicas starting together do not race. Among others it renames the tables and columns of the former \"update pack\" vocabulary to the \"distribution set\" ones, folds the standalone-module table into the module tables, backfills device assignments and converts approval thresholds. See Data model.",{"_6892":3936,"_42174":3796,"_29767":89385,"_5":21387,"_28235":89022,"_5797":89386},[],"Check `GET /health` and `GET /updates/v1/capabilities`, and read the start-up log for migration errors.",{"_6892":3937,"_42174":3796,"_29767":89388,"_5":21387,"_28235":89022,"_5797":89389},[],"There is no automated rollback, and migrations are one-way: an older image does not understand renamed tables. To go back, restore the database and the blob stores from the backup, and run the previous image.",{"_6892":3938,"_42174":3796,"_29767":89391,"_5":21387,"_28235":89025,"_5797":89392},[],"For `hawkbit` mode, hawkBit is a separate service you operate. Its JVM heap is set with `X_MS` and `X_MX` (the image default is `768m` each; `JAVA_OPTS` does not set it), its artifact limits with the `SPRING_SERVLET_MULTIPART_*` and `HAWKBIT_SERVER_SECURITY_DOS_*` variables, and its artifact store with `HAWKBIT_ARTIFACT_STORAGE`. See hawkBit mode.",{"_6892":3939,"_42174":3796,"_29767":89394,"_5":21387,"_28235":89029,"_5797":89395},[],"See Security. In short: put a gateway with TLS and authentication in front of the service, keep `enable_test_endpoints: false`, restrict the SymKMS key routes, keep Postgres, WFX management, the KMS and hawkBit on private networks, and keep secrets out of the repository and the logs.",{"_6892":3940,"_42174":3940,"_5":21817,"_5797":88669,"_42654":89397,"_29767":89398,"_28235":3940},[77248,78697,85231],[],{"_6892":3941,"_42174":3940,"_29767":89400,"_5":21387,"_28235":3940,"_5797":89401},[],"What the service does, how it fits with Lamassu IoT, WFX and hawkBit, and where to start.",{"_6892":3942,"_42174":3940,"_5":42651,"_29767":89403,"_28235":89404,"_5797":89405},[],"/docs/pr-preview/pr-56/platform/updates/overview#what-it-connects-to","What it connects to",{"_6892":3943,"_42174":3940,"_5":42651,"_29767":89407,"_28235":89408,"_5797":89409},[],"/docs/pr-preview/pr-56/platform/updates/overview#choose-your-backend","Choose your backend",{"_6892":3944,"_42174":3940,"_5":42651,"_29767":89411,"_28235":89412,"_5797":89413},[],"/docs/pr-preview/pr-56/platform/updates/overview#where-to-go-next","Where to go next",{"_6892":3945,"_42174":3940,"_29767":89415,"_5":21387,"_28235":3940,"_5797":89416},[],"Lamassu Updates (also called the OTA Update Service) orchestrates over-the-air software updates for IoT fleets. You publish an update, choose which devices receive it, and watch the rollout. The service builds the package that SWUpdate clients install, and can sign and encrypt it.",{"_6892":3946,"_42174":3940,"_29767":89418,"_5":21387,"_28235":3940,"_5797":89419},[],"There is one HTTP API and two interchangeable backends behind it, chosen with the `mode` setting. The backend decides which update server the devices talk to, so the systems around the service depend on it.",{"_6892":3947,"_42174":3940,"_29767":89421,"_5":21387,"_28235":89404,"_5797":85405},[],{"_6892":3948,"_42174":3940,"_29767":89423,"_5":21387,"_28235":89404,"_5797":85298},[],{"_6892":3949,"_42174":3940,"_29767":89425,"_5":21387,"_28235":89404,"_5797":89209},[],{"_6892":3950,"_42174":3940,"_29767":89427,"_5":21387,"_28235":89404,"_5797":86482},[],{"_6892":3951,"_42174":3940,"_29767":89429,"_5":21387,"_28235":89404,"_5797":89430},[],"Lamassu IoT",{"_6892":3952,"_42174":3940,"_29767":89432,"_5":21387,"_28235":89404,"_5797":89433},[],"Device registry (device groups) and KMS. Signing keys live in its KMS",{"_6892":3953,"_42174":3940,"_29767":89435,"_5":21387,"_28235":89404,"_5797":81385},[],{"_6892":3954,"_42174":3940,"_29767":89437,"_5":21387,"_28235":89404,"_5797":89438},[],"Optional: without it, groups are read from the `group:<id>` tags on hawkBit's own targets",{"_6892":3955,"_42174":3940,"_29767":89440,"_5":21387,"_28235":89404,"_5797":85441},[],{"_6892":3956,"_42174":3940,"_29767":89442,"_5":21387,"_28235":89404,"_5797":89443},[],"Job orchestration. Each device update is a WFX job that the device polls",{"_6892":3957,"_42174":3940,"_29767":89445,"_5":21387,"_28235":89404,"_5797":81385},[],{"_6892":3958,"_42174":3940,"_29767":89447,"_5":21387,"_28235":89404,"_5797":89448},[],"Not used",{"_6892":3959,"_42174":3940,"_29767":89450,"_5":21387,"_28235":89404,"_5797":85449},[],{"_6892":3960,"_42174":3940,"_29767":89452,"_5":21387,"_28235":89404,"_5797":89453},[],"Update server. Stores packs, modules and rollouts, and devices poll it",{"_6892":3961,"_42174":3940,"_29767":89455,"_5":21387,"_28235":89404,"_5797":89448},[],{"_6892":3962,"_42174":3940,"_29767":89457,"_5":21387,"_28235":89404,"_5797":81385},[],{"_6892":3963,"_42174":3940,"_29767":89459,"_5":21387,"_28235":89404,"_5797":85414},[],{"_6892":3964,"_42174":3940,"_29767":89461,"_5":21387,"_28235":89404,"_5797":85417},[],{"_6892":3965,"_42174":3940,"_29767":89463,"_5":21387,"_28235":89404,"_5797":81385},[],{"_6892":3966,"_42174":3940,"_29767":89465,"_5":21387,"_28235":89404,"_5797":81385},[],{"_6892":3967,"_42174":3940,"_29767":89467,"_5":21387,"_28235":89404,"_5797":37308},[],{"_6892":3968,"_42174":3940,"_29767":89469,"_5":21387,"_28235":89404,"_5797":89470},[],"Python tool, bundled in the ota repository, that assembles the signed and optionally encrypted `.swu` file",{"_6892":3969,"_42174":3940,"_29767":89472,"_5":21387,"_28235":89404,"_5797":85463},[],{"_6892":3970,"_42174":3940,"_29767":89474,"_5":21387,"_28235":89404,"_5797":85463},[],{"_6892":3971,"_42174":3940,"_29767":89476,"_5":21387,"_28235":89404,"_5797":89477},[],"The Lamassu dashboard is the web interface for this API. It reads its base URL from `LAMASSU_UPDATES_API` in `public/config.js` (when unset it falls back to the main API base URL) and appends `/updates/v1` and `/symkms/v1` itself. It also reads `GET /updates/v1/capabilities` once and hides the features the active backend does not support.",{"_6892":3972,"_42174":3940,"_29767":89479,"_5":21387,"_28235":89408,"_5797":89480},[],"The HTTP API is the same either way. What differs is who stores the data and who the devices talk to.",{"_6892":3973,"_42174":3940,"_29767":89482,"_5":21387,"_28235":89408,"_5797":89483},[],"`native` (default)",{"_6892":3974,"_42174":3940,"_29767":89485,"_5":21387,"_28235":89408,"_5797":86482},[],{"_6892":3975,"_42174":3940,"_29767":89487,"_5":21387,"_28235":89408,"_5797":89488},[],"Stores packs, launches, jobs",{"_6892":3976,"_42174":3940,"_29767":89490,"_5":21387,"_28235":89408,"_5797":89491},[],"This service's Postgres, plus WFX",{"_6892":3977,"_42174":3940,"_29767":89493,"_5":21387,"_28235":89408,"_5797":89494},[],"An Eclipse hawkBit server",{"_6892":3978,"_42174":3940,"_29767":89496,"_5":21387,"_28235":89408,"_5797":89497},[],"Devices poll",{"_6892":3979,"_42174":3940,"_29767":89499,"_5":21387,"_28235":89408,"_5797":85441},[],{"_6892":3980,"_42174":3940,"_29767":89501,"_5":21387,"_28235":89408,"_5797":89502},[],"hawkBit (DDI API)",{"_6892":3981,"_42174":3940,"_29767":89504,"_5":21387,"_28235":89408,"_5797":89505},[],"A pack is built",{"_6892":3982,"_42174":3940,"_29767":89507,"_5":21387,"_28235":89408,"_5797":89508},[],"As a whole, from all its modules' files, into one `.swu`",{"_6892":3983,"_42174":3940,"_29767":89510,"_5":21387,"_28235":89408,"_5797":89511},[],"One `.swu` (or raw deliverable) per module, built in the module catalog",{"_6892":3984,"_42174":3940,"_29767":89513,"_5":21387,"_28235":89408,"_5797":89514},[],"Per-device encryption",{"_6892":3985,"_42174":3940,"_29767":89516,"_5":21387,"_28235":89408,"_5797":87345},[],{"_6892":3986,"_42174":3940,"_29767":89518,"_5":21387,"_28235":89408,"_5797":87348},[],{"_6892":3987,"_42174":3940,"_29767":89520,"_5":21387,"_28235":89408,"_5797":89521},[],"Pick it when",{"_6892":3988,"_42174":3940,"_29767":89523,"_5":21387,"_28235":89408,"_5797":89524},[],"You start from scratch, or need per-device encryption",{"_6892":3989,"_42174":3940,"_29767":89526,"_5":21387,"_28235":89408,"_5797":89527},[],"hawkBit is already your fleet's update backend",{"_6892":3990,"_42174":3940,"_29767":89529,"_5":21387,"_28235":89408,"_5797":89530},[],"Set it with the `mode` field of the configuration. The backends are not equivalent in every feature: see Capabilities and hawkBit mode.",{"_6892":3991,"_42174":3940,"_29767":89532,"_5":21387,"_28235":89412,"_5797":89533},[],"I want to...",{"_6892":3992,"_42174":3940,"_29767":89535,"_5":21387,"_28235":89412,"_5797":89536},[],"Read",{"_6892":3993,"_42174":3940,"_29767":89538,"_5":21387,"_28235":89412,"_5797":89539},[],"Run the whole stack locally",{"_6892":3994,"_42174":3940,"_29767":89541,"_5":21387,"_28235":89412,"_5797":82153},[],{"_6892":3995,"_42174":3940,"_29767":89543,"_5":21387,"_28235":89412,"_5797":89544},[],"Understand the terms (pack, module, launch)",{"_6892":3996,"_42174":3940,"_29767":89546,"_5":21387,"_28235":89412,"_5797":89547},[],"Concepts and Data model",{"_6892":3997,"_42174":3940,"_29767":89549,"_5":21387,"_28235":89412,"_5797":89550},[],"See the components and how data flows",{"_6892":3998,"_42174":3940,"_29767":89552,"_5":21387,"_28235":89412,"_5797":89553},[],"Architecture and Flows",{"_6892":3999,"_42174":3940,"_29767":89555,"_5":21387,"_28235":89412,"_5797":89556},[],"Publish an update and roll it out",{"_6892":4000,"_42174":3940,"_29767":89558,"_5":21387,"_28235":89412,"_5797":88010},[],{"_6892":4001,"_42174":3940,"_29767":89560,"_5":21387,"_28235":89412,"_5797":89561},[],"Try the whole flow with curl",{"_6892":4002,"_42174":3940,"_29767":89563,"_5":21387,"_28235":89412,"_5797":89564},[],"Native or hawkBit",{"_6892":4003,"_42174":3940,"_29767":89566,"_5":21387,"_28235":89412,"_5797":89567},[],"Do it from the web interface",{"_6892":4004,"_42174":3940,"_29767":89569,"_5":21387,"_28235":89412,"_5797":86820},[],{"_6892":4005,"_42174":3940,"_29767":89571,"_5":21387,"_28235":89412,"_5797":86579},[],{"_6892":4006,"_42174":3940,"_29767":89573,"_5":21387,"_28235":89412,"_5797":86579},[],{"_6892":4007,"_42174":3940,"_29767":89575,"_5":21387,"_28235":89412,"_5797":89576},[],"Use an existing hawkBit",{"_6892":4008,"_42174":3940,"_29767":89578,"_5":21387,"_28235":89412,"_5797":85247},[],{"_6892":4009,"_42174":3940,"_29767":89580,"_5":21387,"_28235":89412,"_5797":89581},[],"Sign or encrypt updates",{"_6892":4010,"_42174":3940,"_29767":89583,"_5":21387,"_28235":89412,"_5797":88841},[],{"_6892":4011,"_42174":3940,"_29767":89585,"_5":21387,"_28235":89412,"_5797":89586},[],"Set a config field",{"_6892":4012,"_42174":3940,"_29767":89588,"_5":21387,"_28235":89412,"_5797":89589},[],"Configuration",{"_6892":4013,"_42174":3940,"_29767":89591,"_5":21387,"_28235":89412,"_5797":89592},[],"Call the API",{"_6892":4014,"_42174":3940,"_29767":89594,"_5":21387,"_28235":89412,"_5797":87701},[],{"_6892":4015,"_42174":3940,"_29767":89596,"_5":21387,"_28235":89412,"_5797":89597},[],"Deploy, scale, back up or upgrade it",{"_6892":4016,"_42174":3940,"_29767":89599,"_5":21387,"_28235":89412,"_5797":78457},[],{"_6892":4017,"_42174":3940,"_29767":89601,"_5":21387,"_28235":89412,"_5797":89602},[],"Secure it",{"_6892":4018,"_42174":3940,"_29767":89604,"_5":21387,"_28235":89412,"_5797":87306},[],{"_6892":4019,"_42174":3940,"_29767":89606,"_5":21387,"_28235":89412,"_5797":89607},[],"Fix a problem",{"_6892":4020,"_42174":3940,"_29767":89609,"_5":21387,"_28235":89412,"_5797":81275},[],{"_6892":4021,"_42174":3940,"_29767":89611,"_5":21387,"_28235":89412,"_5797":89612},[],"See what is not supported",{"_6892":4022,"_42174":3940,"_29767":89614,"_5":21387,"_28235":89412,"_5797":89615},[],"Limitations",{"_6892":4023,"_42174":3940,"_29767":89617,"_5":21387,"_28235":89412,"_5797":89618},[],"The source code, sample configurations and Helm chart are in the ota repository.",{"_6892":4024,"_42174":4024,"_5":21817,"_5797":87701,"_42654":89620,"_29767":89622,"_28235":4024},[77248,78697,85231,89621],"Reference",[],{"_6892":4025,"_42174":4024,"_29767":89624,"_5":21387,"_28235":4024,"_5797":89625},[],"Every route of the Lamassu Updates and SymKMS HTTP APIs, with request bodies, status codes and per-backend behaviour.",{"_6892":4026,"_42174":4024,"_5":42651,"_29767":89627,"_28235":89628,"_5797":89629},[],"/docs/pr-preview/pr-56/platform/updates/reference/api#conventions","Conventions",{"_6892":4027,"_42174":4024,"_5":42651,"_29767":89631,"_28235":89632,"_5797":89633},[],"/docs/pr-preview/pr-56/platform/updates/reference/api#status-codes","Status codes",{"_6892":4028,"_42174":4024,"_5":42651,"_29767":89635,"_28235":89636,"_5797":89637},[],"/docs/pr-preview/pr-56/platform/updates/reference/api#downloads","Downloads",{"_6892":4029,"_42174":4024,"_5":42651,"_29767":89639,"_28235":89640,"_5797":89641},[],"/docs/pr-preview/pr-56/platform/updates/reference/api#list-endpoints","List endpoints",{"_6892":4030,"_42174":4024,"_5":42651,"_29767":89643,"_28235":89644,"_5797":89645},[],"/docs/pr-preview/pr-56/platform/updates/reference/api#capabilities-and-workflows","Capabilities and workflows",{"_6892":4031,"_42174":4024,"_5":42651,"_29767":89647,"_28235":89648,"_5797":85567},[],"/docs/pr-preview/pr-56/platform/updates/reference/api#update-packs",{"_6892":4032,"_42174":4024,"_5":42651,"_29767":89650,"_28235":89651,"_5797":89652},[],"/docs/pr-preview/pr-56/platform/updates/reference/api#descriptor-artifacts-and-preconditions","Descriptor, artifacts and preconditions",{"_6892":4033,"_42174":4024,"_5":42651,"_29767":89654,"_28235":89655,"_5797":89656},[],"/docs/pr-preview/pr-56/platform/updates/reference/api#build-and-download","Build and download",{"_6892":4034,"_42174":4024,"_5":42651,"_29767":89658,"_28235":89659,"_5797":89660},[],"/docs/pr-preview/pr-56/platform/updates/reference/api#versions","Versions",{"_6892":4035,"_42174":4024,"_5":42651,"_29767":89662,"_28235":89663,"_5797":89664},[],"/docs/pr-preview/pr-56/platform/updates/reference/api#request-bodies","Request bodies",{"_6892":4036,"_42174":4024,"_5":42651,"_29767":89666,"_28235":89667,"_5797":89668},[],"/docs/pr-preview/pr-56/platform/updates/reference/api#responses","Responses",{"_6892":4037,"_42174":4024,"_5":42651,"_29767":89670,"_28235":89671,"_5797":89672},[],"/docs/pr-preview/pr-56/platform/updates/reference/api#objects","Objects",{"_6892":4038,"_42174":4024,"_5":42651,"_29767":89674,"_28235":89675,"_5797":89676},[],"/docs/pr-preview/pr-56/platform/updates/reference/api#pack","Pack",{"_6892":4039,"_42174":4024,"_5":42651,"_29767":89678,"_28235":89679,"_5797":89680},[],"/docs/pr-preview/pr-56/platform/updates/reference/api#launch","Launch",{"_6892":4040,"_42174":4024,"_5":42651,"_29767":89682,"_28235":89683,"_5797":85620},[],"/docs/pr-preview/pr-56/platform/updates/reference/api#software-module",{"_6892":4041,"_42174":4024,"_5":42651,"_29767":89685,"_28235":89686,"_5797":85629},[],"/docs/pr-preview/pr-56/platform/updates/reference/api#artifact",{"_6892":4042,"_42174":4024,"_5":42651,"_29767":89688,"_28235":89689,"_5797":89690},[],"/docs/pr-preview/pr-56/platform/updates/reference/api#modules-inside-a-pack","Modules inside a pack",{"_6892":4043,"_42174":4024,"_5":42651,"_29767":89692,"_28235":89693,"_5797":89694},[],"/docs/pr-preview/pr-56/platform/updates/reference/api#software-module-catalog","Software module catalog",{"_6892":4044,"_42174":4024,"_5":42651,"_29767":89696,"_28235":89697,"_5797":89664},[],"/docs/pr-preview/pr-56/platform/updates/reference/api#request-bodies-1",{"_6892":4045,"_42174":4024,"_5":42651,"_29767":89699,"_28235":89700,"_5797":89701},[],"/docs/pr-preview/pr-56/platform/updates/reference/api#global-artifacts","Global artifacts",{"_6892":4046,"_42174":4024,"_5":42651,"_29767":89703,"_28235":89704,"_5797":85575},[],"/docs/pr-preview/pr-56/platform/updates/reference/api#launch-campaigns",{"_6892":4047,"_42174":4024,"_5":42651,"_29767":89706,"_28235":89707,"_5797":89708},[],"/docs/pr-preview/pr-56/platform/updates/reference/api#jobs","Jobs",{"_6892":4048,"_42174":4024,"_5":42651,"_29767":89710,"_28235":89711,"_5797":89712},[],"/docs/pr-preview/pr-56/platform/updates/reference/api#device-inventory","Device inventory",{"_6892":4049,"_42174":4024,"_5":42651,"_29767":89714,"_28235":89715,"_5797":89716},[],"/docs/pr-preview/pr-56/platform/updates/reference/api#version-compliance-and-latest-versions","Version compliance and latest versions",{"_6892":4050,"_42174":4024,"_5":42651,"_29767":89718,"_28235":89719,"_5797":89720},[],"/docs/pr-preview/pr-56/platform/updates/reference/api#device-artifact-download-hawkbit-mode","Device artifact download, hawkBit mode",{"_6892":4051,"_42174":4024,"_5":42651,"_29767":89722,"_28235":89723,"_5797":85318},[],"/docs/pr-preview/pr-56/platform/updates/reference/api#symkms",{"_6892":4052,"_42174":4024,"_5":42651,"_29767":89725,"_28235":89726,"_5797":80372},[],"/docs/pr-preview/pr-56/platform/updates/reference/api#next-steps",{"_6892":4053,"_42174":4024,"_29767":89728,"_5":21387,"_28235":4024,"_5797":89729},[],"Reference for the HTTP API of Lamassu Updates, as implemented by the service in `internal/updates/httpapi` (shared by the native and hawkBit backends). Use it to look up a route, a body field or a status code. For worked examples, follow the native or hawkBit curl guide.",{"_6892":4054,"_42174":4024,"_29767":89731,"_5":21387,"_28235":89628,"_5797":89732},[],"The Updates API is served under `/updates/v1`, and SymKMS under `/symkms/v1`. Paths in this page are relative to `/updates/v1` unless they begin with `/health` or `/symkms`. Behind the Lamassu gateway the prefix is typically `/api/updates/v1`, which is what the dashboard calls.",{"_6892":4055,"_42174":4024,"_29767":89734,"_5":21387,"_28235":89628,"_5797":89735},[],"`:groupID` is a Lamassu device group. `:name` is a pack name. `:moduleKey` is `type:name` (for example `os:water-panel`), literal or percent-encoded. In paths a pack is a `distribution-sets` resource (see Concepts).",{"_6892":4056,"_42174":4024,"_29767":89737,"_5":21387,"_28235":89628,"_5797":89738},[],"Topic",{"_6892":4057,"_42174":4024,"_29767":89740,"_5":21387,"_28235":89628,"_5797":89262},[],{"_6892":4058,"_42174":4024,"_29767":89742,"_5":21387,"_28235":89628,"_5797":89743},[],"Bodies",{"_6892":4059,"_42174":4024,"_29767":89745,"_5":21387,"_28235":89628,"_5797":89746},[],"JSON, except uploads, which are `multipart/form-data` with the file in the field `file`",{"_6892":4060,"_42174":4024,"_29767":89748,"_5":21387,"_28235":89628,"_5797":89749},[],"Errors",{"_6892":4061,"_42174":4024,"_29767":89751,"_5":21387,"_28235":89628,"_5797":89752},[],"The body is `{\"err\":\"<message>\"}`",{"_6892":4062,"_42174":4024,"_29767":89754,"_5":21387,"_28235":89628,"_5797":89755},[],"Health",{"_6892":4063,"_42174":4024,"_29767":89757,"_5":21387,"_28235":89628,"_5797":89758},[],"`GET /health` returns `{\"status\":\"ok\"}`, outside `/updates/v1`",{"_6892":4064,"_42174":4024,"_29767":89760,"_5":21387,"_28235":89628,"_5797":89761},[],"Authentication",{"_6892":4065,"_42174":4024,"_29767":89763,"_5":21387,"_28235":89628,"_5797":89764},[],"None in the service: it does not authenticate callers. In a Lamassu deployment the gateway in front of it does. See Security",{"_6892":4066,"_42174":4024,"_29767":89766,"_5":21387,"_28235":89628,"_5797":89767},[],"Upload limit",{"_6892":4067,"_42174":4024,"_29767":89769,"_5":21387,"_28235":89628,"_5797":89770},[],"One file can be up to `max_artifact_size_mb` MiB, 10240 (10 GiB) by default. A larger file answers `413`",{"_6892":4068,"_42174":4024,"_29767":89772,"_5":21387,"_28235":89628,"_5797":89773},[],"Timeouts",{"_6892":4069,"_42174":4024,"_29767":89775,"_5":21387,"_28235":89628,"_5797":89776},[],"A request can read or write for up to 6 hours; an idle connection is closed after 5 minutes. Uploads are streamed to disk, not held in memory",{"_6892":4070,"_42174":4024,"_29767":89778,"_5":21387,"_28235":89628,"_5797":89779},[],"CORS",{"_6892":4071,"_42174":4024,"_29767":89781,"_5":21387,"_28235":89628,"_5797":89782},[],"Any origin and any request header are allowed",{"_6892":4072,"_42174":4024,"_29767":89784,"_5":21387,"_28235":89628,"_5797":89785},[],"The ingress or gateway in front of the service needs its own limits raised to match: see Configuration.",{"_6892":4073,"_42174":4024,"_29767":89787,"_5":21387,"_28235":89632,"_5797":89788},[],"Code",{"_6892":4074,"_42174":4024,"_29767":89790,"_5":21387,"_28235":89632,"_5797":79765},[],{"_6892":4075,"_42174":4024,"_29767":89792,"_5":21387,"_28235":89632,"_5797":89793},[],"`200`",{"_6892":4076,"_42174":4024,"_29767":89795,"_5":21387,"_28235":89632,"_5797":89796},[],"Success",{"_6892":4077,"_42174":4024,"_29767":89798,"_5":21387,"_28235":89632,"_5797":89799},[],"`201`",{"_6892":4078,"_42174":4024,"_29767":89801,"_5":21387,"_28235":89632,"_5797":89802},[],"Created: packs, modules, launches, standalone artifact uploads",{"_6892":4079,"_42174":4024,"_29767":89804,"_5":21387,"_28235":89632,"_5797":89805},[],"`202`",{"_6892":4080,"_42174":4024,"_29767":89807,"_5":21387,"_28235":89632,"_5797":89808},[],"Accepted: `sync-to-latest` and `force-version`",{"_6892":4081,"_42174":4024,"_29767":89810,"_5":21387,"_28235":89632,"_5797":89811},[],"`204`",{"_6892":4082,"_42174":4024,"_29767":89813,"_5":21387,"_28235":89632,"_5797":89814},[],"Deleted, with no body: artifacts, staged files, latest-version records, module files",{"_6892":4083,"_42174":4024,"_29767":89816,"_5":21387,"_28235":89632,"_5797":89817},[],"`206`, `416`",{"_6892":4084,"_42174":4024,"_29767":89819,"_5":21387,"_28235":89632,"_5797":89820},[],"Partial content, or an unsatisfiable range, on downloads",{"_6892":4085,"_42174":4024,"_29767":89822,"_5":21387,"_28235":89632,"_5797":89823},[],"`207`",{"_6892":4086,"_42174":4024,"_29767":89825,"_5":21387,"_28235":89632,"_5797":89826},[],"`sync-to-latest` dispatched some devices and failed others",{"_6892":4087,"_42174":4024,"_29767":89828,"_5":21387,"_28235":89632,"_5797":89829},[],"`302`",{"_6892":4088,"_42174":4024,"_29767":89831,"_5":21387,"_28235":89632,"_5797":89832},[],"A download redirected to a short-lived signed URL",{"_6892":4089,"_42174":4024,"_29767":89834,"_5":21387,"_28235":89632,"_5797":89835},[],"`400`",{"_6892":4090,"_42174":4024,"_29767":89837,"_5":21387,"_28235":89632,"_5797":89838},[],"Invalid input, or an operation not valid in the current state (for example changing a built pack's module composition)",{"_6892":4091,"_42174":4024,"_29767":89840,"_5":21387,"_28235":89632,"_5797":89841},[],"`403`",{"_6892":4092,"_42174":4024,"_29767":89843,"_5":21387,"_28235":89632,"_5797":89844},[],"Forbidden by policy (for example downloading a previous version that the pack does not allow)",{"_6892":4093,"_42174":4024,"_29767":89846,"_5":21387,"_28235":89632,"_5797":89847},[],"`404`",{"_6892":4094,"_42174":4024,"_29767":89849,"_5":21387,"_28235":89632,"_5797":89850},[],"The resource does not exist",{"_6892":4095,"_42174":4024,"_29767":89852,"_5":21387,"_28235":89632,"_5797":89853},[],"`409`",{"_6892":4096,"_42174":4024,"_29767":89855,"_5":21387,"_28235":89632,"_5797":89856},[],"Conflict: the pack version is already built (artifact upload, link or prebuilt upload), the pack name already exists, or another request is working on the same resource",{"_6892":4097,"_42174":4024,"_29767":89858,"_5":21387,"_28235":89632,"_5797":89859},[],"`413`",{"_6892":4098,"_42174":4024,"_29767":89861,"_5":21387,"_28235":89632,"_5797":89862},[],"An uploaded file is over the size limit",{"_6892":4099,"_42174":4024,"_29767":89864,"_5":21387,"_28235":89632,"_5797":89865},[],"`501`",{"_6892":4100,"_42174":4024,"_29767":89867,"_5":21387,"_28235":89632,"_5797":89868},[],"The active backend does not support the operation. See Capabilities",{"_6892":4101,"_42174":4024,"_29767":89870,"_5":21387,"_28235":89636,"_5797":89871},[],"Download routes stream the file and support resuming:",{"_6892":4102,"_42174":4024,"_29767":89873,"_5":21387,"_28235":89636,"_5797":89874},[],"`HEAD` works on every download route and returns the size and `Accept-Ranges: bytes`.",{"_6892":4103,"_42174":4024,"_29767":89876,"_5":21387,"_28235":89636,"_5797":89877},[],"`Range: bytes=...` with a single range answers `206` with `Content-Range`. A range that cannot be satisfied answers `416`. A request with several ranges is answered with the whole file.",{"_6892":4104,"_42174":4024,"_29767":89879,"_5":21387,"_28235":89636,"_5797":89880},[],"With S3 storage and presigning enabled, a `GET` can answer `302` to a signed URL of the object store, with `Cache-Control: no-store`. The caller is authorized first; the store then only checks the signature. A `HEAD` is never redirected. Native mode signs build outputs (`.swu` and packages); hawkBit mode signs the objects of hawkBit's S3 artifact plugin. If signing fails, the service streams the file instead.",{"_6892":4105,"_42174":4024,"_29767":89882,"_5":21387,"_28235":89636,"_5797":89883},[],"`Content-Disposition: attachment` carries the file name.",{"_6892":4106,"_42174":4024,"_29767":89885,"_5":21387,"_28235":89640,"_5797":89886},[],"Routes that return collections share these query parameters:",{"_6892":4107,"_42174":4024,"_29767":89888,"_5":21387,"_28235":89640,"_5797":81379},[],{"_6892":4108,"_42174":4024,"_29767":89890,"_5":21387,"_28235":89640,"_5797":79765},[],{"_6892":4109,"_42174":4024,"_29767":89892,"_5":21387,"_28235":89640,"_5797":89893},[],"`page_size`",{"_6892":4110,"_42174":4024,"_29767":89895,"_5":21387,"_28235":89640,"_5797":89896},[],"Items per page. Default `25`, at most `500`",{"_6892":4111,"_42174":4024,"_29767":89898,"_5":21387,"_28235":89640,"_5797":89899},[],"`bookmark`",{"_6892":4112,"_42174":4024,"_29767":89901,"_5":21387,"_28235":89640,"_5797":89902},[],"Opaque cursor from the previous page",{"_6892":4113,"_42174":4024,"_29767":89904,"_5":21387,"_28235":89640,"_5797":89905},[],"`sort_by`, `sort_mode`",{"_6892":4114,"_42174":4024,"_29767":89907,"_5":21387,"_28235":89640,"_5797":89908},[],"A filterable field, and `asc` (default) or `desc`. A `sort_by` that is not a filterable field is ignored",{"_6892":4115,"_42174":4024,"_29767":89910,"_5":21387,"_28235":89640,"_5797":89911},[],"`filter`",{"_6892":4116,"_42174":4024,"_29767":89913,"_5":21387,"_28235":89640,"_5797":89914},[],"`field[operand]value`, repeatable",{"_6892":4117,"_42174":4024,"_29767":89916,"_5":21387,"_28235":89640,"_5797":89917},[],"Filter operands depend on the field type:",{"_6892":4118,"_42174":4024,"_29767":89919,"_5":21387,"_28235":89640,"_5797":89920},[],"Field type",{"_6892":4119,"_42174":4024,"_29767":89922,"_5":21387,"_28235":89640,"_5797":89923},[],"Operands",{"_6892":4120,"_42174":4024,"_29767":89925,"_5":21387,"_28235":89640,"_5797":89926},[],"String",{"_6892":4121,"_42174":4024,"_29767":89928,"_5":21387,"_28235":89640,"_5797":89929},[],"`eq`, `ne`, `ct` (contains), `nc` (not contains), each with an `_ic` variant for case-insensitive matches",{"_6892":4122,"_42174":4024,"_29767":89931,"_5":21387,"_28235":89640,"_5797":89932},[],"Date",{"_6892":4123,"_42174":4024,"_29767":89934,"_5":21387,"_28235":89640,"_5797":89935},[],"`bf` (before), `eq`, `af` (after)",{"_6892":4124,"_42174":4024,"_29767":89937,"_5":21387,"_28235":89640,"_5797":89938},[],"Number",{"_6892":4125,"_42174":4024,"_29767":89940,"_5":21387,"_28235":89640,"_5797":89941},[],"`eq`, `ne`, `lt`, `le`, `gt`, `ge`",{"_6892":4126,"_42174":4024,"_29767":89943,"_5":21387,"_28235":89640,"_5797":89944},[],"Enum",{"_6892":4127,"_42174":4024,"_29767":89946,"_5":21387,"_28235":89640,"_5797":89947},[],"`eq`, `ne`",{"_6892":4128,"_42174":4024,"_29767":89949,"_5":21387,"_28235":89640,"_5797":89950},[],"For example `GET /groups/g1/distribution-sets?filter=name[ct]firmware&sort_by=name&sort_mode=desc`.",{"_6892":4129,"_42174":4024,"_29767":89952,"_5":21387,"_28235":89640,"_5797":89953},[],"Paginated lists return `{\"next\": \"<bookmark>\", \"list\": [...]}`. Pass `next` as `bookmark` to get the next page; `next` is empty on the last page. Filterable fields per list:",{"_6892":4130,"_42174":4024,"_29767":89955,"_5":21387,"_28235":89640,"_5797":89956},[],"List",{"_6892":4131,"_42174":4024,"_29767":89958,"_5":21387,"_28235":89640,"_5797":89959},[],"Filterable fields",{"_6892":4132,"_42174":4024,"_29767":89961,"_5":21387,"_28235":89640,"_5797":89962},[],"Packs: `.../distribution-sets`, `/distribution-sets`",{"_6892":4133,"_42174":4024,"_29767":89964,"_5":21387,"_28235":89640,"_5797":89965},[],"`group_id`, `name`, `version`, `packaging` (enum), `created_at`",{"_6892":4134,"_42174":4024,"_29767":89967,"_5":21387,"_28235":89640,"_5797":89968},[],"Launches: `/groups/:groupID/launch`",{"_6892":4135,"_42174":4024,"_29767":89970,"_5":21387,"_28235":89640,"_5797":89971},[],"`group_id`, `status` (enum), `workflow_type`, `created_at`, `distribution_set_id`",{"_6892":4136,"_42174":4024,"_29767":89973,"_5":21387,"_28235":89640,"_5797":89974},[],"Version snapshots: `.../versions`, `/distribution-sets/:id/versions`",{"_6892":4137,"_42174":4024,"_29767":89976,"_5":21387,"_28235":89640,"_5797":89977},[],"`version` (number), `created_at`",{"_6892":4138,"_42174":4024,"_29767":89979,"_5":21387,"_28235":89640,"_5797":89980},[],"Fleet artifact catalog: `GET /artifacts`",{"_6892":4139,"_42174":4024,"_29767":89982,"_5":21387,"_28235":89640,"_5797":89983},[],"`name`, `version`, `checksum`, `uploaded_at`",{"_6892":4140,"_42174":4024,"_29767":89985,"_5":21387,"_28235":89640,"_5797":89986},[],"Device pack versions and inventory: `/devices/distribution-sets`, `/devices/:deviceID/distribution-sets`, `.../distribution-set-inventory`",{"_6892":4141,"_42174":4024,"_29767":89988,"_5":21387,"_28235":89640,"_5797":89989},[],"`device_id`, `distribution_set_id`, `distribution_set_name`, `group_id`, `version` (number), `packaging` (enum), `installed_at`",{"_6892":4142,"_42174":4024,"_29767":89991,"_5":21387,"_28235":89640,"_5797":89992},[],"Device update history: `/devices/:deviceID/distribution-set-updates`, `/devices/distribution-set-updates/latest`",{"_6892":4143,"_42174":4024,"_29767":89994,"_5":21387,"_28235":89640,"_5797":89995},[],"`device_id`, `group_id`, `distribution_set_name`, `distribution_set_id`, `launch_id`, `job_id`, `status` (enum), `packaging` (enum), `source`",{"_6892":4144,"_42174":4024,"_29767":89997,"_5":21387,"_28235":89640,"_5797":89998},[],"Latest versions: `.../latest-distribution-sets`",{"_6892":4145,"_42174":4024,"_29767":90000,"_5":21387,"_28235":89640,"_5797":90001},[],"`group_id`, `distribution_set_id`, `distribution_set_name`, `version` (string), `updated_at`",{"_6892":4146,"_42174":4024,"_29767":90003,"_5":21387,"_28235":89640,"_5797":90004},[],"Some lists do not page or filter:",{"_6892":4147,"_42174":4024,"_29767":90006,"_5":21387,"_28235":89640,"_5797":90007},[],"The job lists (`/groups/:groupID/device/:deviceID/jobs`, `.../history`, `/launch/:launchID/jobs`) honour only `page_size` and `bookmark`. The bookmark is a numeric offset.",{"_6892":4148,"_42174":4024,"_29767":90009,"_5":21387,"_28235":89640,"_5797":90010},[],"The module lists, `/updatable-distribution-sets`, the pack-scoped `.../artifact-catalog`, `/version-compliance`, `/version-status` and `/workflows` return everything.",{"_6892":4149,"_42174":4024,"_29767":90012,"_5":21387,"_28235":89640,"_5797":90013},[],"`GET /devices/distribution-set-updates/latest` returns everything, after applying the filters.",{"_6892":4150,"_42174":4024,"_29767":90015,"_5":21387,"_28235":89640,"_5797":90016},[],"In hawkBit mode no list is paged (`next` is always empty). Only the fleet-wide `/devices/distribution-sets` and `/devices/distribution-set-updates/latest` apply `filter`.",{"_6892":4151,"_42174":4024,"_29767":90018,"_5":21387,"_28235":89640,"_5797":90019},[],"Some routes exist in only one backend, or behave differently. Check Capabilities first.",{"_6892":4152,"_42174":4024,"_29767":90021,"_5":21387,"_28235":89644,"_5797":80461},[],{"_6892":4153,"_42174":4024,"_29767":90023,"_5":21387,"_28235":89644,"_5797":80673},[],{"_6892":4154,"_42174":4024,"_29767":90025,"_5":21387,"_28235":89644,"_5797":81388},[],{"_6892":4155,"_42174":4024,"_29767":90027,"_5":21387,"_28235":89644,"_5797":84023},[],{"_6892":4156,"_42174":4024,"_29767":90029,"_5":21387,"_28235":89644,"_5797":90030},[],"`/capabilities`",{"_6892":4157,"_42174":4024,"_29767":90032,"_5":21387,"_28235":89644,"_5797":90033},[],"Active backend and what it supports. See Capabilities",{"_6892":4158,"_42174":4024,"_29767":90035,"_5":21387,"_28235":89644,"_5797":84023},[],{"_6892":4159,"_42174":4024,"_29767":90037,"_5":21387,"_28235":89644,"_5797":90038},[],"`/workflows`",{"_6892":4160,"_42174":4024,"_29767":90040,"_5":21387,"_28235":89644,"_5797":90041},[],"Workflows registered in WFX, as `{\"content\": [...]}`. Empty in hawkBit mode",{"_6892":4161,"_42174":4024,"_29767":90043,"_5":21387,"_28235":89648,"_5797":80461},[],{"_6892":4162,"_42174":4024,"_29767":90045,"_5":21387,"_28235":89648,"_5797":80673},[],{"_6892":4163,"_42174":4024,"_29767":90047,"_5":21387,"_28235":89648,"_5797":81388},[],{"_6892":4164,"_42174":4024,"_29767":90049,"_5":21387,"_28235":89648,"_5797":84591},[],{"_6892":4165,"_42174":4024,"_29767":90051,"_5":21387,"_28235":89648,"_5797":90052},[],"`/groups/:groupID/distribution-sets`",{"_6892":4166,"_42174":4024,"_29767":90054,"_5":21387,"_28235":89648,"_5797":90055},[],"Create a pack",{"_6892":4167,"_42174":4024,"_29767":90057,"_5":21387,"_28235":89648,"_5797":84023},[],{"_6892":4168,"_42174":4024,"_29767":90059,"_5":21387,"_28235":89648,"_5797":90052},[],{"_6892":4169,"_42174":4024,"_29767":90061,"_5":21387,"_28235":89648,"_5797":90062},[],"List a group's packs",{"_6892":4170,"_42174":4024,"_29767":90064,"_5":21387,"_28235":89648,"_5797":84023},[],{"_6892":4171,"_42174":4024,"_29767":90066,"_5":21387,"_28235":89648,"_5797":90067},[],"`/groups/:groupID/updatable-distribution-sets`",{"_6892":4172,"_42174":4024,"_29767":90069,"_5":21387,"_28235":89648,"_5797":90070},[],"The group's built packs, which can be launched",{"_6892":4173,"_42174":4024,"_29767":90072,"_5":21387,"_28235":89648,"_5797":90073},[],"`DELETE`",{"_6892":4174,"_42174":4024,"_29767":90075,"_5":21387,"_28235":89648,"_5797":90076},[],"`/groups/:groupID/distribution-sets/:name`",{"_6892":4175,"_42174":4024,"_29767":90078,"_5":21387,"_28235":89648,"_5797":90079},[],"Delete a pack. Refused with `400` once a launch has dispatched it (native), or while a campaign holds it (hawkBit)",{"_6892":4176,"_42174":4024,"_29767":90081,"_5":21387,"_28235":89648,"_5797":84591},[],{"_6892":4177,"_42174":4024,"_29767":90083,"_5":21387,"_28235":89648,"_5797":90084},[],"`/groups/:groupID/distribution-sets/:name/new`",{"_6892":4178,"_42174":4024,"_29767":90086,"_5":21387,"_28235":89648,"_5797":90087},[],"Create a new version of a pack",{"_6892":4179,"_42174":4024,"_29767":90089,"_5":21387,"_28235":89648,"_5797":84023},[],{"_6892":4180,"_42174":4024,"_29767":90091,"_5":21387,"_28235":89648,"_5797":90092},[],"`/distribution-sets`",{"_6892":4181,"_42174":4024,"_29767":90094,"_5":21387,"_28235":89648,"_5797":90095},[],"Every pack across all groups, including orphaned ones",{"_6892":4182,"_42174":4024,"_29767":90097,"_5":21387,"_28235":89648,"_5797":84023},[],{"_6892":4183,"_42174":4024,"_29767":90099,"_5":21387,"_28235":89648,"_5797":90100},[],"`/distribution-sets/:id/versions`",{"_6892":4184,"_42174":4024,"_29767":90102,"_5":21387,"_28235":89648,"_5797":90103},[],"Version snapshots, by unique ID",{"_6892":4185,"_42174":4024,"_29767":90105,"_5":21387,"_28235":89648,"_5797":90073},[],{"_6892":4186,"_42174":4024,"_29767":90107,"_5":21387,"_28235":89648,"_5797":90108},[],"`/distribution-sets/:id`",{"_6892":4187,"_42174":4024,"_29767":90110,"_5":21387,"_28235":89648,"_5797":90111},[],"Delete a pack by unique ID. The only way to remove an orphaned pack",{"_6892":4188,"_42174":4024,"_29767":90113,"_5":21387,"_28235":89651,"_5797":80461},[],{"_6892":4189,"_42174":4024,"_29767":90115,"_5":21387,"_28235":89651,"_5797":90116},[],"Path (after `/groups/:groupID/distribution-sets/:name`)",{"_6892":4190,"_42174":4024,"_29767":90118,"_5":21387,"_28235":89651,"_5797":81388},[],{"_6892":4191,"_42174":4024,"_29767":90120,"_5":21387,"_28235":89651,"_5797":84591},[],{"_6892":4192,"_42174":4024,"_29767":90122,"_5":21387,"_28235":89651,"_5797":90123},[],"`/descriptor/upload`",{"_6892":4193,"_42174":4024,"_29767":90125,"_5":21387,"_28235":89651,"_5797":90126},[],"Upload the sw-description (file field `file`, up to 1 MiB in native mode). hawkBit mode: `400`, use the catalog route",{"_6892":4194,"_42174":4024,"_29767":90128,"_5":21387,"_28235":89651,"_5797":84023},[],{"_6892":4195,"_42174":4024,"_29767":90130,"_5":21387,"_28235":89651,"_5797":90131},[],"`/descriptor`",{"_6892":4196,"_42174":4024,"_29767":90133,"_5":21387,"_28235":89651,"_5797":90134},[],"Read it, as `text/plain`",{"_6892":4197,"_42174":4024,"_29767":90136,"_5":21387,"_28235":89651,"_5797":84591},[],{"_6892":4198,"_42174":4024,"_29767":90138,"_5":21387,"_28235":89651,"_5797":90139},[],"`/artifact/upload`",{"_6892":4199,"_42174":4024,"_29767":90141,"_5":21387,"_28235":89651,"_5797":90142},[],"Upload a global artifact and link it to the pack (fields `file`, `artifact_name`, `version`). `409` if the pack is already built, which is always the case in hawkBit mode",{"_6892":4200,"_42174":4024,"_29767":90144,"_5":21387,"_28235":89651,"_5797":84591},[],{"_6892":4201,"_42174":4024,"_29767":90146,"_5":21387,"_28235":89651,"_5797":90147},[],"`/artifact/link`",{"_6892":4202,"_42174":4024,"_29767":90149,"_5":21387,"_28235":89651,"_5797":90150},[],"Link an already-uploaded global artifact (body `{\"artifact_id\":\"...\"}`). `409` if the pack is built",{"_6892":4203,"_42174":4024,"_29767":90152,"_5":21387,"_28235":89651,"_5797":90073},[],{"_6892":4204,"_42174":4024,"_29767":90154,"_5":21387,"_28235":89651,"_5797":90155},[],"`/artifact?artifact=<file name>`",{"_6892":4205,"_42174":4024,"_29767":90157,"_5":21387,"_28235":89651,"_5797":90158},[],"Delete a staged build-directory file. Does not unlink a catalog artifact. Answers `204`. hawkBit mode: `400`",{"_6892":4206,"_42174":4024,"_29767":90160,"_5":21387,"_28235":89651,"_5797":84023},[],{"_6892":4207,"_42174":4024,"_29767":90162,"_5":21387,"_28235":89651,"_5797":90163},[],"`/artifacts`",{"_6892":4208,"_42174":4024,"_29767":90165,"_5":21387,"_28235":89651,"_5797":90166},[],"Names of the staged build-directory files, as a bare array",{"_6892":4209,"_42174":4024,"_29767":90168,"_5":21387,"_28235":89651,"_5797":84023},[],{"_6892":4210,"_42174":4024,"_29767":90170,"_5":21387,"_28235":89651,"_5797":90171},[],"`/artifacts/:artifactName`",{"_6892":4211,"_42174":4024,"_29767":90173,"_5":21387,"_28235":89651,"_5797":90174},[],"Download a staged file by name",{"_6892":4212,"_42174":4024,"_29767":90176,"_5":21387,"_28235":89651,"_5797":84023},[],{"_6892":4213,"_42174":4024,"_29767":90178,"_5":21387,"_28235":89651,"_5797":90179},[],"`/artifact-catalog`",{"_6892":4214,"_42174":4024,"_29767":90181,"_5":21387,"_28235":89651,"_5797":90182},[],"Artifacts the pack references",{"_6892":4215,"_42174":4024,"_29767":90184,"_5":21387,"_28235":89651,"_5797":84023},[],{"_6892":4216,"_42174":4024,"_29767":90186,"_5":21387,"_28235":89651,"_5797":90187},[],"`/preconditions`",{"_6892":4217,"_42174":4024,"_29767":90189,"_5":21387,"_28235":89651,"_5797":90190},[],"Read the pack's launch preconditions. Answers the whole pack, with `preconditions`",{"_6892":4218,"_42174":4024,"_29767":90192,"_5":21387,"_28235":89651,"_5797":84032},[],{"_6892":4219,"_42174":4024,"_29767":90194,"_5":21387,"_28235":89651,"_5797":90187},[],{"_6892":4220,"_42174":4024,"_29767":90196,"_5":21387,"_28235":89651,"_5797":90197},[],"Replace the pack's launch preconditions. An empty list clears them. Answers the pack",{"_6892":4221,"_42174":4024,"_29767":90199,"_5":21387,"_28235":89655,"_5797":80461},[],{"_6892":4222,"_42174":4024,"_29767":90201,"_5":21387,"_28235":89655,"_5797":90116},[],{"_6892":4223,"_42174":4024,"_29767":90203,"_5":21387,"_28235":89655,"_5797":81388},[],{"_6892":4224,"_42174":4024,"_29767":90205,"_5":21387,"_28235":89655,"_5797":84591},[],{"_6892":4225,"_42174":4024,"_29767":90207,"_5":21387,"_28235":89655,"_5797":90208},[],"`/swu`",{"_6892":4226,"_42174":4024,"_29767":90210,"_5":21387,"_28235":89655,"_5797":90211},[],"Build the `.swu` (body: see Request bodies). hawkBit mode: `501`, build the modules instead",{"_6892":4227,"_42174":4024,"_29767":90213,"_5":21387,"_28235":89655,"_5797":84591},[],{"_6892":4228,"_42174":4024,"_29767":90215,"_5":21387,"_28235":89655,"_5797":90216},[],"`/package`",{"_6892":4229,"_42174":4024,"_29767":90218,"_5":21387,"_28235":89655,"_5797":90219},[],"Build the `.tar.gz` for a `non-swu` pack. hawkBit mode: `501`",{"_6892":4230,"_42174":4024,"_29767":90221,"_5":21387,"_28235":89655,"_5797":84591},[],{"_6892":4231,"_42174":4024,"_29767":90223,"_5":21387,"_28235":89655,"_5797":90224},[],"`/swu/upload`, `/package/upload`",{"_6892":4232,"_42174":4024,"_29767":90226,"_5":21387,"_28235":89655,"_5797":90227},[],"Attach an externally built deliverable (file field `file`, optional `user`). Both paths are one operation: the pack's packaging decides which file is expected. Native only (`501` in hawkBit mode)",{"_6892":4233,"_42174":4024,"_29767":90229,"_5":21387,"_28235":89655,"_5797":84023},[],{"_6892":4234,"_42174":4024,"_29767":90231,"_5":21387,"_28235":89655,"_5797":90232},[],"`/swu/download`",{"_6892":4235,"_42174":4024,"_29767":90234,"_5":21387,"_28235":89655,"_5797":90235},[],"Download the current shared `.swu`. hawkBit mode: `400` for a pack with several modules, so use `/modules/:moduleKey/artifact/download`",{"_6892":4236,"_42174":4024,"_29767":90237,"_5":21387,"_28235":89655,"_5797":84023},[],{"_6892":4237,"_42174":4024,"_29767":90239,"_5":21387,"_28235":89655,"_5797":90240},[],"`/swu/download/:deviceID`",{"_6892":4238,"_42174":4024,"_29767":90242,"_5":21387,"_28235":89655,"_5797":90243},[],"Download one device's `.swu`. For a per-device encrypted pack it is that device's own file, otherwise the shared one",{"_6892":4239,"_42174":4024,"_29767":90245,"_5":21387,"_28235":89655,"_5797":84023},[],{"_6892":4240,"_42174":4024,"_29767":90247,"_5":21387,"_28235":89655,"_5797":90248},[],"`/swu/download/version/:version`",{"_6892":4241,"_42174":4024,"_29767":90250,"_5":21387,"_28235":89655,"_5797":90251},[],"Download a previous version. Native mode: `403` unless the pack has `allow_previous_version_download`, and `404` without a recorded snapshot. hawkBit mode serves any version",{"_6892":4242,"_42174":4024,"_29767":90253,"_5":21387,"_28235":89655,"_5797":84023},[],{"_6892":4243,"_42174":4024,"_29767":90255,"_5":21387,"_28235":89655,"_5797":90256},[],"`/package/download`, `/package/download/:deviceID`",{"_6892":4244,"_42174":4024,"_29767":90258,"_5":21387,"_28235":89655,"_5797":90259},[],"Same, for `non-swu` packs (`application/gzip`)",{"_6892":4245,"_42174":4024,"_29767":90261,"_5":21387,"_28235":89655,"_5797":84023},[],{"_6892":4246,"_42174":4024,"_29767":90263,"_5":21387,"_28235":89655,"_5797":90264},[],"`/artifacts-archive`",{"_6892":4247,"_42174":4024,"_29767":90266,"_5":21387,"_28235":89655,"_5797":90267},[],"`.tar.gz` of the current version's artifacts",{"_6892":4248,"_42174":4024,"_29767":90269,"_5":21387,"_28235":89655,"_5797":84023},[],{"_6892":4249,"_42174":4024,"_29767":90271,"_5":21387,"_28235":89655,"_5797":90272},[],"`/signature`",{"_6892":4250,"_42174":4024,"_29767":90274,"_5":21387,"_28235":89655,"_5797":90275},[],"Signed manifest for the current version",{"_6892":4251,"_42174":4024,"_29767":90277,"_5":21387,"_28235":89659,"_5797":80461},[],{"_6892":4252,"_42174":4024,"_29767":90279,"_5":21387,"_28235":89659,"_5797":90116},[],{"_6892":4253,"_42174":4024,"_29767":90281,"_5":21387,"_28235":89659,"_5797":81388},[],{"_6892":4254,"_42174":4024,"_29767":90283,"_5":21387,"_28235":89659,"_5797":84023},[],{"_6892":4255,"_42174":4024,"_29767":90285,"_5":21387,"_28235":89659,"_5797":90286},[],"`/versions`",{"_6892":4256,"_42174":4024,"_29767":90288,"_5":21387,"_28235":89659,"_5797":90289},[],"Stored version snapshots",{"_6892":4257,"_42174":4024,"_29767":90291,"_5":21387,"_28235":89659,"_5797":84023},[],{"_6892":4258,"_42174":4024,"_29767":90293,"_5":21387,"_28235":89659,"_5797":90294},[],"`/versions/:version`",{"_6892":4259,"_42174":4024,"_29767":90296,"_5":21387,"_28235":89659,"_5797":90297},[],"One snapshot, with manifest metadata",{"_6892":4260,"_42174":4024,"_29767":90299,"_5":21387,"_28235":89659,"_5797":84023},[],{"_6892":4261,"_42174":4024,"_29767":90301,"_5":21387,"_28235":89659,"_5797":90302},[],"`/versions/:version/signature`",{"_6892":4262,"_42174":4024,"_29767":90304,"_5":21387,"_28235":89659,"_5797":90305},[],"Signed manifest, signature and certificate",{"_6892":4263,"_42174":4024,"_29767":90307,"_5":21387,"_28235":89659,"_5797":84023},[],{"_6892":4264,"_42174":4024,"_29767":90309,"_5":21387,"_28235":89659,"_5797":90310},[],"`/versions/:version/modules`",{"_6892":4265,"_42174":4024,"_29767":90312,"_5":21387,"_28235":89659,"_5797":90313},[],"Modules of that version",{"_6892":4266,"_42174":4024,"_29767":90315,"_5":21387,"_28235":89659,"_5797":84023},[],{"_6892":4267,"_42174":4024,"_29767":90317,"_5":21387,"_28235":89659,"_5797":90318},[],"`/versions/:version/modules/:moduleKey/artifact/download`",{"_6892":4268,"_42174":4024,"_29767":90320,"_5":21387,"_28235":89659,"_5797":90321},[],"A module's deliverable at that version. Native: `501`",{"_6892":4269,"_42174":4024,"_29767":90323,"_5":21387,"_28235":89659,"_5797":84023},[],{"_6892":4270,"_42174":4024,"_29767":90325,"_5":21387,"_28235":89659,"_5797":90326},[],"`/versions/:version/artifacts-archive`",{"_6892":4271,"_42174":4024,"_29767":90328,"_5":21387,"_28235":89659,"_5797":90329},[],"`.tar.gz` of that version's artifacts",{"_6892":4272,"_42174":4024,"_29767":90331,"_5":21387,"_28235":89663,"_5797":86919},[],{"_6892":4273,"_42174":4024,"_29767":90333,"_5":21387,"_28235":89663,"_5797":90334},[],"Body",{"_6892":4274,"_42174":4024,"_29767":90336,"_5":21387,"_28235":89663,"_5797":90337},[],"Create pack",{"_6892":4275,"_42174":4024,"_29767":90339,"_5":21387,"_28235":89663,"_5797":90340},[],"Required: `name`, `version` (semver `x.y.z`), `group_id`. Optional: `type` (`rawfile` or `firmware`), `packaging` (`swu`, the default, or `non-swu`), `allow_previous_version_download`, `modules`, `preconditions`. Each `modules` entry is a new module (`type`, `name`, optional `version` and `delivery_intent`) or an existing one (`source_module_id`). hawkBit mode accepts only `source_module_id` entries, of **built** modules",{"_6892":4276,"_42174":4024,"_29767":90342,"_5":21387,"_28235":89663,"_5797":90343},[],"`POST .../new`",{"_6892":4277,"_42174":4024,"_29767":90345,"_5":21387,"_28235":89663,"_5797":90346},[],"`{\"version\":\"x.y.z\"}`: semver, and greater than the current version, or `400`",{"_6892":4278,"_42174":4024,"_29767":90348,"_5":21387,"_28235":89663,"_5797":90349},[],"`PUT .../preconditions`",{"_6892":4279,"_42174":4024,"_29767":90351,"_5":21387,"_28235":89663,"_5797":90352},[],"`{\"preconditions\":[{\"required_distribution_set_name\":\"...\",\"min_version\":\"1.2.0\"}]}`. Use `required_module_key` (`type:name`) instead of the pack name to target a module. Exactly one of the two per entry, and `min_version` must be `x.y.z`. A device must satisfy every entry",{"_6892":4280,"_42174":4024,"_29767":90354,"_5":21387,"_28235":89663,"_5797":90355},[],"`POST .../swu`, `.../package`",{"_6892":4281,"_42174":4024,"_29767":90357,"_5":21387,"_28235":89663,"_5797":90358},[],"`user`, `encryption_key_name`, `encryption_alg_name`, `sw_desc_encrypted`, `signature_key_id`, `signature_alg_name`, `signature_certificate` (PEM), `selected_artifact_ids`. All optional, but `user` is required with `encryption_key_name`. A body with `encryption_alg_name` only requests per-device encryption. An empty or invalid body builds without encryption. See Signing and encryption",{"_6892":4282,"_42174":4024,"_29767":90360,"_5":21387,"_28235":89663,"_5797":90361},[],"Artifacts reach a build only through `selected_artifact_ids`; without them there is normally nothing staged and the build fails. A build replaces the pack's carried artifact links with the selected ones.",{"_6892":4283,"_42174":4024,"_29767":90363,"_5":21387,"_28235":89667,"_5797":90364},[],"Create routes answer `201` with the object: a pack, a module, or for a launch the launch ID and the precondition outcome. `modules` is an input of pack creation and is not returned on reads.",{"_6892":4284,"_42174":4024,"_29767":90366,"_5":21387,"_28235":89667,"_5797":90367},[],"`DELETE` of a pack answers `200` with `{\"message\": \"...\"}`. `POST .../new`, `.../swu` and `.../package` answer `200` with `{\"message\": \"...\"}`.",{"_6892":4285,"_42174":4024,"_29767":90369,"_5":21387,"_28235":89667,"_5797":90370},[],"Artifact uploads answer `{\"msg\": \"...\", \"artifact\": {...}}`: `201` for `POST /artifacts`, `200` for the pack-scoped and module-scoped uploads.",{"_6892":4286,"_42174":4024,"_29767":90372,"_5":21387,"_28235":89667,"_5797":90373},[],"Descriptor uploads on a pack or on a module in a pack answer `{\"msg\": \"...\"}`.",{"_6892":4287,"_42174":4024,"_29767":90375,"_5":21387,"_28235":89667,"_5797":90376},[],"Module lists answer `{\"modules\": [...]}`. The pack-scoped `.../artifacts` list answers a bare array.",{"_6892":4288,"_42174":4024,"_29767":90378,"_5":21387,"_28235":89667,"_5797":90379},[],"A failed build leaves the pack in status `build_failed`, with the reason in `last_build_error`. It is editable and can be built again.",{"_6892":4289,"_42174":4024,"_29767":90381,"_5":21387,"_28235":89671,"_5797":90382},[],"The field definitions are in `pkg/models/updates.go` in the repository. These are the fields clients read most.",{"_6892":4290,"_42174":4024,"_29767":90384,"_5":21387,"_28235":89675,"_5797":85754},[],{"_6892":4291,"_42174":4024,"_29767":90386,"_5":21387,"_28235":89675,"_5797":79765},[],{"_6892":4292,"_42174":4024,"_29767":90388,"_5":21387,"_28235":89675,"_5797":90389},[],"`id`, `name`, `version`, `group_id`",{"_6892":4293,"_42174":4024,"_29767":90391,"_5":21387,"_28235":89675,"_5797":90392},[],"Identity. The version is semver",{"_6892":4294,"_42174":4024,"_29767":90394,"_5":21387,"_28235":89675,"_5797":86664},[],{"_6892":4295,"_42174":4024,"_29767":90396,"_5":21387,"_28235":89675,"_5797":90397},[],"`rawfile` or `firmware`",{"_6892":4296,"_42174":4024,"_29767":90399,"_5":21387,"_28235":89675,"_5797":88108},[],{"_6892":4297,"_42174":4024,"_29767":90401,"_5":21387,"_28235":89675,"_5797":90402},[],"`swu` or `non-swu`",{"_6892":4298,"_42174":4024,"_29767":90404,"_5":21387,"_28235":89675,"_5797":90405},[],"`status`",{"_6892":4299,"_42174":4024,"_29767":90407,"_5":21387,"_28235":89675,"_5797":90408},[],"`draft`, `built` or `build_failed`",{"_6892":4300,"_42174":4024,"_29767":90410,"_5":21387,"_28235":89675,"_5797":90411},[],"`uri`",{"_6892":4301,"_42174":4024,"_29767":90413,"_5":21387,"_28235":89675,"_5797":90414},[],"Download URI of the built deliverable. Empty until built",{"_6892":4302,"_42174":4024,"_29767":90416,"_5":21387,"_28235":89675,"_5797":90417},[],"`sw-descriptor`",{"_6892":4303,"_42174":4024,"_29767":90419,"_5":21387,"_28235":89675,"_5797":90420},[],"The sw-description text (the key has a hyphen)",{"_6892":4304,"_42174":4024,"_29767":90422,"_5":21387,"_28235":89675,"_5797":90423},[],"`encryption_mode`",{"_6892":4305,"_42174":4024,"_29767":90425,"_5":21387,"_28235":89675,"_5797":90426},[],"Empty, `shared` or `per-device`",{"_6892":4306,"_42174":4024,"_29767":90428,"_5":21387,"_28235":89675,"_5797":90429},[],"`encryption_key_name`, `encryption_alg_name`, `encryption_iv`, `sw_desc_encrypted`",{"_6892":4307,"_42174":4024,"_29767":90431,"_5":21387,"_28235":89675,"_5797":90432},[],"Encryption settings of the last build",{"_6892":4308,"_42174":4024,"_29767":90434,"_5":21387,"_28235":89675,"_5797":90435},[],"`signature_key_id`, `signature_alg_name`, `signature_certificate`",{"_6892":4309,"_42174":4024,"_29767":90437,"_5":21387,"_28235":89675,"_5797":90438},[],"Signing settings of the last build",{"_6892":4310,"_42174":4024,"_29767":90440,"_5":21387,"_28235":89675,"_5797":90441},[],"`built_device_count`, `total_device_count`, `uncovered_devices`",{"_6892":4311,"_42174":4024,"_29767":90443,"_5":21387,"_28235":89675,"_5797":90444},[],"Per-device builds only: coverage, and the devices without a package with a `reason`",{"_6892":4312,"_42174":4024,"_29767":90446,"_5":21387,"_28235":89675,"_5797":88114},[],{"_6892":4313,"_42174":4024,"_29767":90448,"_5":21387,"_28235":89675,"_5797":90449},[],"Whether older versions can be downloaded",{"_6892":4314,"_42174":4024,"_29767":90451,"_5":21387,"_28235":89675,"_5797":88120},[],{"_6892":4315,"_42174":4024,"_29767":90453,"_5":21387,"_28235":89675,"_5797":90454},[],"The pack's launch preconditions",{"_6892":4316,"_42174":4024,"_29767":90456,"_5":21387,"_28235":89675,"_5797":90457},[],"`last_build_error`",{"_6892":4317,"_42174":4024,"_29767":90459,"_5":21387,"_28235":89675,"_5797":90460},[],"Why the last build failed",{"_6892":4318,"_42174":4024,"_29767":90462,"_5":21387,"_28235":89675,"_5797":90463},[],"`locked`",{"_6892":4319,"_42174":4024,"_29767":90465,"_5":21387,"_28235":89675,"_5797":90466},[],"hawkBit mode: the backend froze the composition because the pack was sent to devices",{"_6892":4320,"_42174":4024,"_29767":90468,"_5":21387,"_28235":89675,"_5797":90469},[],"`created_at`, `updated_at`",{"_6892":4321,"_42174":4024,"_29767":90471,"_5":21387,"_28235":89675,"_5797":90472},[],"Timestamps",{"_6892":4322,"_42174":4024,"_29767":90474,"_5":21387,"_28235":89679,"_5797":90475},[],"A launch carries `id`, `group_id`, `name`, `description`, `version`, `exec_date`, `scheduled_at`, `status`, the strategy fields (`workflow_type`, `rollout_type`, `rollout_value`, `test_device_id`, `auto`, `approval_threshold`, `error_threshold`, `weight`), `distribution_set_id`, `distribution_set_name`, the counters `pending_count`, `active_count`, `completed_count`, `failed_count`, `total_devices`, `completed_in_batch`, `test_device_status`, `aborted`, `forced_preconditions` and `precondition_failures`.",{"_6892":4323,"_42174":4024,"_29767":90477,"_5":21387,"_28235":89679,"_5797":90478},[],"`status` is `running` (empty on a native launch that has not changed state yet, which also means running), `paused`, `cancelled` or `completed`. `test_device_status` is `pending`, `active`, `completed`, `failed` or `cancelled`.",{"_6892":4324,"_42174":4024,"_29767":90480,"_5":21387,"_28235":89683,"_5797":85754},[],{"_6892":4325,"_42174":4024,"_29767":90482,"_5":21387,"_28235":89683,"_5797":79765},[],{"_6892":4326,"_42174":4024,"_29767":90484,"_5":21387,"_28235":89683,"_5797":90485},[],"`id`, `key`",{"_6892":4327,"_42174":4024,"_29767":90487,"_5":21387,"_28235":89683,"_5797":90488},[],"Catalog ID and `type:name` key",{"_6892":4328,"_42174":4024,"_29767":90490,"_5":21387,"_28235":89683,"_5797":90491},[],"`type`, `name`, `version`",{"_6892":4329,"_42174":4024,"_29767":90493,"_5":21387,"_28235":89683,"_5797":90494},[],"`type` is `os` or `application`",{"_6892":4330,"_42174":4024,"_29767":90496,"_5":21387,"_28235":89683,"_5797":88583},[],{"_6892":4331,"_42174":4024,"_29767":90498,"_5":21387,"_28235":89683,"_5797":90499},[],"`undecided`, `swu-build`, `swu-prebuilt` or `raw`",{"_6892":4332,"_42174":4024,"_29767":90501,"_5":21387,"_28235":89683,"_5797":90502},[],"`built`, `locked`",{"_6892":4333,"_42174":4024,"_29767":90504,"_5":21387,"_28235":89683,"_5797":90505},[],"Whether its deliverable exists, and whether it is frozen because a version of it has shipped",{"_6892":4334,"_42174":4024,"_29767":90507,"_5":21387,"_28235":89683,"_5797":90508},[],"`artifacts`",{"_6892":4335,"_42174":4024,"_29767":90510,"_5":21387,"_28235":89683,"_5797":90511},[],"The module's files",{"_6892":4336,"_42174":4024,"_29767":90513,"_5":21387,"_28235":89683,"_5797":90514},[],"`encrypted`, `encryption_mode`, `encryption_key_name`, `encryption_alg_name`, `sw_desc_encrypted`, `signature_key_id`, `signature_alg_name`",{"_6892":4337,"_42174":4024,"_29767":90516,"_5":21387,"_28235":89683,"_5797":90517},[],"How it was built",{"_6892":4338,"_42174":4024,"_29767":90519,"_5":21387,"_28235":89683,"_5797":90520},[],"`release_notes`",{"_6892":4339,"_42174":4024,"_29767":90522,"_5":21387,"_28235":89683,"_5797":90523},[],"The operator changelog",{"_6892":4340,"_42174":4024,"_29767":90525,"_5":21387,"_28235":89683,"_5797":90526},[],"`uri`, `created_at`, `updated_at`",{"_6892":4341,"_42174":4024,"_29767":90528,"_5":21387,"_28235":89683,"_5797":90529},[],"Download URI, timestamps",{"_6892":4342,"_42174":4024,"_29767":90531,"_5":21387,"_28235":89686,"_5797":90532},[],"`id`, `name`, `version`, `filename`, `checksum` (SHA-256 of the file), `size` in bytes and `uploaded_at`. The fleet-wide list adds `distribution_sets`: the packs that reference it, each with `distribution_set_id`, `distribution_set_name`, `distribution_set_version` and `group_id`. A file whose name ends in `.swu` or `.tar.gz` must look like one, or the upload answers `400`.",{"_6892":4343,"_42174":4024,"_29767":90534,"_5":21387,"_28235":89689,"_5797":80461},[],{"_6892":4344,"_42174":4024,"_29767":90536,"_5":21387,"_28235":89689,"_5797":90116},[],{"_6892":4345,"_42174":4024,"_29767":90538,"_5":21387,"_28235":89689,"_5797":81388},[],{"_6892":4346,"_42174":4024,"_29767":90540,"_5":21387,"_28235":89689,"_5797":84023},[],{"_6892":4347,"_42174":4024,"_29767":90542,"_5":21387,"_28235":89689,"_5797":90543},[],"`/modules`",{"_6892":4348,"_42174":4024,"_29767":90545,"_5":21387,"_28235":89689,"_5797":90546},[],"List the pack's modules",{"_6892":4349,"_42174":4024,"_29767":90548,"_5":21387,"_28235":89689,"_5797":84591},[],{"_6892":4350,"_42174":4024,"_29767":90550,"_5":21387,"_28235":89689,"_5797":90543},[],{"_6892":4351,"_42174":4024,"_29767":90552,"_5":21387,"_28235":89689,"_5797":90553},[],"Add a module (body: `type`, `name`, optional `version`, `delivery_intent`). Answers `201`. hawkBit mode: `400`, create the module in the catalog",{"_6892":4352,"_42174":4024,"_29767":90555,"_5":21387,"_28235":89689,"_5797":84023},[],{"_6892":4353,"_42174":4024,"_29767":90557,"_5":21387,"_28235":89689,"_5797":90558},[],"`/modules/reusable`",{"_6892":4354,"_42174":4024,"_29767":90560,"_5":21387,"_28235":89689,"_5797":90561},[],"Modules on other packs, offered for import. Each reports `shared` and its source pack",{"_6892":4355,"_42174":4024,"_29767":90563,"_5":21387,"_28235":89689,"_5797":84591},[],{"_6892":4356,"_42174":4024,"_29767":90565,"_5":21387,"_28235":89689,"_5797":90566},[],"`/modules/import`",{"_6892":4357,"_42174":4024,"_29767":90568,"_5":21387,"_28235":89689,"_5797":90569},[],"Compose from an existing module. Answers `201`",{"_6892":4358,"_42174":4024,"_29767":90571,"_5":21387,"_28235":89689,"_5797":84032},[],{"_6892":4359,"_42174":4024,"_29767":90573,"_5":21387,"_28235":89689,"_5797":90574},[],"`/modules/:moduleKey`",{"_6892":4360,"_42174":4024,"_29767":90576,"_5":21387,"_28235":89689,"_5797":90577},[],"Swap the module for another version of itself (body `{\"source_module_id\":\"<catalog id>\"}`). Native: `501`",{"_6892":4361,"_42174":4024,"_29767":90579,"_5":21387,"_28235":89689,"_5797":90073},[],{"_6892":4362,"_42174":4024,"_29767":90581,"_5":21387,"_28235":89689,"_5797":90574},[],{"_6892":4363,"_42174":4024,"_29767":90583,"_5":21387,"_28235":89689,"_5797":90584},[],"Remove a module from the pack",{"_6892":4364,"_42174":4024,"_29767":90586,"_5":21387,"_28235":89689,"_5797":84032},[],{"_6892":4365,"_42174":4024,"_29767":90588,"_5":21387,"_28235":89689,"_5797":90589},[],"`/modules/:moduleKey/release-notes`",{"_6892":4366,"_42174":4024,"_29767":90591,"_5":21387,"_28235":89689,"_5797":90592},[],"Set the operator changelog (body `{\"notes\":\"...\"}`, empty clears it). Allowed on built versions",{"_6892":4367,"_42174":4024,"_29767":90594,"_5":21387,"_28235":89689,"_5797":84591},[],{"_6892":4368,"_42174":4024,"_29767":90596,"_5":21387,"_28235":89689,"_5797":90597},[],"`/modules/:moduleKey/artifact/upload`",{"_6892":4369,"_42174":4024,"_29767":90599,"_5":21387,"_28235":89689,"_5797":90600},[],"Upload a binary onto a module (fields `file`, `artifact_name`, `version`). hawkBit mode: refused, a linked module is frozen",{"_6892":4370,"_42174":4024,"_29767":90602,"_5":21387,"_28235":89689,"_5797":84591},[],{"_6892":4371,"_42174":4024,"_29767":90604,"_5":21387,"_28235":89689,"_5797":90605},[],"`/modules/:moduleKey/artifact/link`",{"_6892":4372,"_42174":4024,"_29767":90607,"_5":21387,"_28235":89689,"_5797":90608},[],"Link a global artifact to the module (body `{\"artifact_id\":\"...\"}`). hawkBit mode: refused",{"_6892":4373,"_42174":4024,"_29767":90610,"_5":21387,"_28235":89689,"_5797":84591},[],{"_6892":4374,"_42174":4024,"_29767":90612,"_5":21387,"_28235":89689,"_5797":90613},[],"`/modules/:moduleKey/descriptor/upload`",{"_6892":4375,"_42174":4024,"_29767":90615,"_5":21387,"_28235":89689,"_5797":90616},[],"A module's own sw-description. Native: `501`. hawkBit mode: `400`, use `POST /softwaremodules/by-id/:moduleID/descriptor`",{"_6892":4376,"_42174":4024,"_29767":90618,"_5":21387,"_28235":89689,"_5797":84591},[],{"_6892":4377,"_42174":4024,"_29767":90620,"_5":21387,"_28235":89689,"_5797":90621},[],"`/modules/:moduleKey/build`",{"_6892":4378,"_42174":4024,"_29767":90623,"_5":21387,"_28235":89689,"_5797":90624},[],"Pack-scoped module build. Always refused: `501` in native mode and `400` in hawkBit mode. Use `POST /softwaremodules/by-id/:moduleID/build`",{"_6892":4379,"_42174":4024,"_29767":90626,"_5":21387,"_28235":89689,"_5797":84023},[],{"_6892":4380,"_42174":4024,"_29767":90628,"_5":21387,"_28235":89689,"_5797":90629},[],"`/modules/:moduleKey/artifact/download`",{"_6892":4381,"_42174":4024,"_29767":90631,"_5":21387,"_28235":89689,"_5797":90632},[],"Download a module's deliverable. Native: `501`",{"_6892":4382,"_42174":4024,"_29767":90634,"_5":21387,"_28235":89689,"_5797":90635},[],"Import body: `source_module_id`, or `source_distribution_set_name` and `module_key` (with optional `source_group_id` and `source_distribution_set_version`). A module's delivery intent must be decided and compatible with the pack's packaging before it can be imported.",{"_6892":4383,"_42174":4024,"_29767":90637,"_5":21387,"_28235":89693,"_5797":90638},[],"Modules that exist independently of any pack. Create one with `POST /softwaremodules`, giving `type`, `name`, `version` and optionally `delivery_intent` (default `undecided`). Use the returned `id` for the `by-id` routes.",{"_6892":4384,"_42174":4024,"_29767":90640,"_5":21387,"_28235":89693,"_5797":80461},[],{"_6892":4385,"_42174":4024,"_29767":90642,"_5":21387,"_28235":89693,"_5797":80673},[],{"_6892":4386,"_42174":4024,"_29767":90644,"_5":21387,"_28235":89693,"_5797":81388},[],{"_6892":4387,"_42174":4024,"_29767":90646,"_5":21387,"_28235":89693,"_5797":84023},[],{"_6892":4388,"_42174":4024,"_29767":90648,"_5":21387,"_28235":89693,"_5797":90649},[],"`/softwaremodules`",{"_6892":4389,"_42174":4024,"_29767":90651,"_5":21387,"_28235":89693,"_5797":90652},[],"Fleet-wide catalog, with the source pack",{"_6892":4390,"_42174":4024,"_29767":90654,"_5":21387,"_28235":89693,"_5797":84591},[],{"_6892":4391,"_42174":4024,"_29767":90656,"_5":21387,"_28235":89693,"_5797":90649},[],{"_6892":4392,"_42174":4024,"_29767":90658,"_5":21387,"_28235":89693,"_5797":90659},[],"Declare a module with no pack yet. Answers `201`. `type`, `name` and `version` are required",{"_6892":4393,"_42174":4024,"_29767":90661,"_5":21387,"_28235":89693,"_5797":90073},[],{"_6892":4394,"_42174":4024,"_29767":90663,"_5":21387,"_28235":89693,"_5797":90664},[],"`/softwaremodules/:moduleKey/versions/:version`",{"_6892":4395,"_42174":4024,"_29767":90666,"_5":21387,"_28235":89693,"_5797":90667},[],"Delete a module that no pack holds. `400` if a pack still holds it",{"_6892":4396,"_42174":4024,"_29767":90669,"_5":21387,"_28235":89693,"_5797":84023},[],{"_6892":4397,"_42174":4024,"_29767":90671,"_5":21387,"_28235":89693,"_5797":90672},[],"`/softwaremodules/by-id/:moduleID`",{"_6892":4398,"_42174":4024,"_29767":90674,"_5":21387,"_28235":89693,"_5797":90675},[],"Read one module",{"_6892":4399,"_42174":4024,"_29767":90677,"_5":21387,"_28235":89693,"_5797":84032},[],{"_6892":4400,"_42174":4024,"_29767":90679,"_5":21387,"_28235":89693,"_5797":90672},[],{"_6892":4401,"_42174":4024,"_29767":90681,"_5":21387,"_28235":89693,"_5797":90682},[],"Update `delivery_intent` and `release_notes`. Send at least one",{"_6892":4402,"_42174":4024,"_29767":90684,"_5":21387,"_28235":89693,"_5797":84591},[],{"_6892":4403,"_42174":4024,"_29767":90686,"_5":21387,"_28235":89693,"_5797":90687},[],"`/softwaremodules/by-id/:moduleID/artifacts`",{"_6892":4404,"_42174":4024,"_29767":90689,"_5":21387,"_28235":89693,"_5797":90690},[],"Upload a file (field `file`). Answers `201` with the artifact",{"_6892":4405,"_42174":4024,"_29767":90692,"_5":21387,"_28235":89693,"_5797":84023},[],{"_6892":4406,"_42174":4024,"_29767":90694,"_5":21387,"_28235":89693,"_5797":90695},[],"`/softwaremodules/by-id/:moduleID/artifacts/:artifactID/download`",{"_6892":4407,"_42174":4024,"_29767":90697,"_5":21387,"_28235":89693,"_5797":90698},[],"Download a stored file",{"_6892":4408,"_42174":4024,"_29767":90700,"_5":21387,"_28235":89693,"_5797":90073},[],{"_6892":4409,"_42174":4024,"_29767":90702,"_5":21387,"_28235":89693,"_5797":90703},[],"`/softwaremodules/by-id/:moduleID/artifacts/:artifactID`",{"_6892":4410,"_42174":4024,"_29767":90705,"_5":21387,"_28235":89693,"_5797":90706},[],"Remove a file. Answers `204`",{"_6892":4411,"_42174":4024,"_29767":90708,"_5":21387,"_28235":89693,"_5797":84591},[],{"_6892":4412,"_42174":4024,"_29767":90710,"_5":21387,"_28235":89693,"_5797":90711},[],"`/softwaremodules/by-id/:moduleID/descriptor`",{"_6892":4413,"_42174":4024,"_29767":90713,"_5":21387,"_28235":89693,"_5797":90714},[],"Upload the sw-description the build reads (field `file`). Answers the module",{"_6892":4414,"_42174":4024,"_29767":90716,"_5":21387,"_28235":89693,"_5797":84591},[],{"_6892":4415,"_42174":4024,"_29767":90718,"_5":21387,"_28235":89693,"_5797":90719},[],"`/softwaremodules/by-id/:moduleID/build`",{"_6892":4416,"_42174":4024,"_29767":90721,"_5":21387,"_28235":89693,"_5797":90722},[],"Build this module's deliverable. hawkBit mode only (`501` in native). Behaviour depends on `delivery_intent`. The body is optional and takes `user`, `encryption_key_name`, `encryption_alg_name`, `sw_desc_encrypted`, `signature_key_id`, `signature_alg_name`, `signature_certificate`",{"_6892":4417,"_42174":4024,"_29767":90724,"_5":21387,"_28235":89693,"_5797":90725},[],"Files are accepted while the delivery is `undecided`. A `swu-build` module takes build inputs and refuses a `.swu`; a `swu-prebuilt` module takes exactly one `.swu`. Choose a compatible delivery intent before importing the module with `source_module_id`. Once a module has shipped (a released pack version holds it, or hawkBit locked it) it is locked: its content is protected, while release notes stay editable. In native mode the pack builds one `.swu` from every module's inputs, and a prebuilt SWU is uploaded to the whole pack rather than imported as a module input.",{"_6892":4418,"_42174":4024,"_29767":90727,"_5":21387,"_28235":89697,"_5797":86919},[],{"_6892":4419,"_42174":4024,"_29767":90729,"_5":21387,"_28235":89697,"_5797":90334},[],{"_6892":4420,"_42174":4024,"_29767":90731,"_5":21387,"_28235":89697,"_5797":90732},[],"`POST .../modules`, `POST /softwaremodules`",{"_6892":4421,"_42174":4024,"_29767":90734,"_5":21387,"_28235":89697,"_5797":90735},[],"`type` (`os` or `application`), `name` (no `/` or `:`), `version`, `delivery_intent`",{"_6892":4422,"_42174":4024,"_29767":90737,"_5":21387,"_28235":89697,"_5797":90738},[],"`POST .../modules/import`",{"_6892":4423,"_42174":4024,"_29767":90740,"_5":21387,"_28235":89697,"_5797":90741},[],"`source_module_id`, or `source_distribution_set_name` and `module_key`",{"_6892":4424,"_42174":4024,"_29767":90743,"_5":21387,"_28235":89697,"_5797":90744},[],"`PUT /softwaremodules/by-id/:moduleID`",{"_6892":4425,"_42174":4024,"_29767":90746,"_5":21387,"_28235":89697,"_5797":90747},[],"`delivery_intent` and/or `release_notes`",{"_6892":4426,"_42174":4024,"_29767":90749,"_5":21387,"_28235":89697,"_5797":90750},[],"Uploads",{"_6892":4427,"_42174":4024,"_29767":90752,"_5":21387,"_28235":89697,"_5797":90753},[],"`multipart/form-data` with the file in `file`. Pack-scoped artifact uploads (`.../artifact/upload`, `.../modules/:moduleKey/artifact/upload`) also take `artifact_name` and `version`. `POST /artifacts` takes `name` and `version`. `POST /softwaremodules/by-id/:moduleID/artifacts` takes only the file",{"_6892":4428,"_42174":4024,"_29767":90755,"_5":21387,"_28235":89700,"_5797":80461},[],{"_6892":4429,"_42174":4024,"_29767":90757,"_5":21387,"_28235":89700,"_5797":80673},[],{"_6892":4430,"_42174":4024,"_29767":90759,"_5":21387,"_28235":89700,"_5797":81388},[],{"_6892":4431,"_42174":4024,"_29767":90761,"_5":21387,"_28235":89700,"_5797":84591},[],{"_6892":4432,"_42174":4024,"_29767":90763,"_5":21387,"_28235":89700,"_5797":90163},[],{"_6892":4433,"_42174":4024,"_29767":90765,"_5":21387,"_28235":89700,"_5797":90766},[],"Upload a standalone artifact (fields `file`, `name`, `version`). hawkBit mode: only staged (discarded after 30 minutes, at the next upload) and cannot be attached to a module, so use `POST /softwaremodules/by-id/:moduleID/artifacts`",{"_6892":4434,"_42174":4024,"_29767":90768,"_5":21387,"_28235":89700,"_5797":84023},[],{"_6892":4435,"_42174":4024,"_29767":90770,"_5":21387,"_28235":89700,"_5797":90163},[],{"_6892":4436,"_42174":4024,"_29767":90772,"_5":21387,"_28235":89700,"_5797":90773},[],"Fleet-wide catalog, with pack references",{"_6892":4437,"_42174":4024,"_29767":90775,"_5":21387,"_28235":89700,"_5797":84023},[],{"_6892":4438,"_42174":4024,"_29767":90777,"_5":21387,"_28235":89700,"_5797":90778},[],"`/artifacts/:id`",{"_6892":4439,"_42174":4024,"_29767":90780,"_5":21387,"_28235":89700,"_5797":90781},[],"One artifact",{"_6892":4440,"_42174":4024,"_29767":90783,"_5":21387,"_28235":89700,"_5797":84023},[],{"_6892":4441,"_42174":4024,"_29767":90785,"_5":21387,"_28235":89700,"_5797":90786},[],"`/artifacts/:id/download`",{"_6892":4442,"_42174":4024,"_29767":90788,"_5":21387,"_28235":89700,"_5797":90789},[],"Download the binary",{"_6892":4443,"_42174":4024,"_29767":90791,"_5":21387,"_28235":89700,"_5797":90073},[],{"_6892":4444,"_42174":4024,"_29767":90793,"_5":21387,"_28235":89700,"_5797":90778},[],{"_6892":4445,"_42174":4024,"_29767":90795,"_5":21387,"_28235":89700,"_5797":90796},[],"Delete. Answers `204`",{"_6892":4446,"_42174":4024,"_29767":90798,"_5":21387,"_28235":89700,"_5797":90799},[],"Both `name` and `version` are optional on upload. `name` defaults to the file name without its extension. A `version`, when given, must be `x.y.z` and higher than every existing version of that name, or the upload answers `400`.",{"_6892":4447,"_42174":4024,"_29767":90801,"_5":21387,"_28235":89704,"_5797":80461},[],{"_6892":4448,"_42174":4024,"_29767":90803,"_5":21387,"_28235":89704,"_5797":80673},[],{"_6892":4449,"_42174":4024,"_29767":90805,"_5":21387,"_28235":89704,"_5797":81388},[],{"_6892":4450,"_42174":4024,"_29767":90807,"_5":21387,"_28235":89704,"_5797":84591},[],{"_6892":4451,"_42174":4024,"_29767":90809,"_5":21387,"_28235":89704,"_5797":90810},[],"`/groups/:groupID/launch`",{"_6892":4452,"_42174":4024,"_29767":90812,"_5":21387,"_28235":89704,"_5797":90813},[],"Create a launch. With `?dry_run=true`, evaluate only",{"_6892":4453,"_42174":4024,"_29767":90815,"_5":21387,"_28235":89704,"_5797":84023},[],{"_6892":4454,"_42174":4024,"_29767":90817,"_5":21387,"_28235":89704,"_5797":90810},[],{"_6892":4455,"_42174":4024,"_29767":90819,"_5":21387,"_28235":89704,"_5797":90820},[],"Launch history",{"_6892":4456,"_42174":4024,"_29767":90822,"_5":21387,"_28235":89704,"_5797":84591},[],{"_6892":4457,"_42174":4024,"_29767":90824,"_5":21387,"_28235":89704,"_5797":90825},[],"`/groups/:groupID/launch/:id/rollout`",{"_6892":4458,"_42174":4024,"_29767":90827,"_5":21387,"_28235":89704,"_5797":90828},[],"Dispatch the next batch",{"_6892":4459,"_42174":4024,"_29767":90830,"_5":21387,"_28235":89704,"_5797":84591},[],{"_6892":4460,"_42174":4024,"_29767":90832,"_5":21387,"_28235":89704,"_5797":90833},[],"`/groups/:groupID/launch/:id/pause`",{"_6892":4461,"_42174":4024,"_29767":90835,"_5":21387,"_28235":89704,"_5797":90836},[],"Pause. The batch in flight finishes",{"_6892":4462,"_42174":4024,"_29767":90838,"_5":21387,"_28235":89704,"_5797":84591},[],{"_6892":4463,"_42174":4024,"_29767":90840,"_5":21387,"_28235":89704,"_5797":90841},[],"`/groups/:groupID/launch/:id/resume`",{"_6892":4464,"_42174":4024,"_29767":90843,"_5":21387,"_28235":89704,"_5797":90844},[],"Resume a paused launch",{"_6892":4465,"_42174":4024,"_29767":90846,"_5":21387,"_28235":89704,"_5797":84591},[],{"_6892":4466,"_42174":4024,"_29767":90848,"_5":21387,"_28235":89704,"_5797":90849},[],"`/groups/:groupID/launch/:id/retry-failed`",{"_6892":4467,"_42174":4024,"_29767":90851,"_5":21387,"_28235":89704,"_5797":90852},[],"Re-queue the failed devices and roll out. `400` when nothing failed",{"_6892":4468,"_42174":4024,"_29767":90854,"_5":21387,"_28235":89704,"_5797":84591},[],{"_6892":4469,"_42174":4024,"_29767":90856,"_5":21387,"_28235":89704,"_5797":90857},[],"`/groups/:groupID/launch/:id/cancel`",{"_6892":4470,"_42174":4024,"_29767":90859,"_5":21387,"_28235":89704,"_5797":90860},[],"Cancel permanently",{"_6892":4471,"_42174":4024,"_29767":90862,"_5":21387,"_28235":89704,"_5797":84591},[],{"_6892":4472,"_42174":4024,"_29767":90864,"_5":21387,"_28235":89704,"_5797":90865},[],"`/groups/:groupID/launch/:id/complete`",{"_6892":4473,"_42174":4024,"_29767":90867,"_5":21387,"_28235":89704,"_5797":90868},[],"Mark complete. hawkBit mode: `501`",{"_6892":4474,"_42174":4024,"_29767":90870,"_5":21387,"_28235":89704,"_5797":84023},[],{"_6892":4475,"_42174":4024,"_29767":90872,"_5":21387,"_28235":89704,"_5797":90873},[],"`/groups/:groupID/launch/:id/strategy`",{"_6892":4476,"_42174":4024,"_29767":90875,"_5":21387,"_28235":89704,"_5797":90876},[],"Read the strategy",{"_6892":4477,"_42174":4024,"_29767":90878,"_5":21387,"_28235":89704,"_5797":90879},[],"`POST` / `PUT`",{"_6892":4478,"_42174":4024,"_29767":90881,"_5":21387,"_28235":89704,"_5797":90873},[],{"_6892":4479,"_42174":4024,"_29767":90883,"_5":21387,"_28235":89704,"_5797":90884},[],"Update the strategy. hawkBit mode: `501`. The launched pack cannot be changed",{"_6892":4480,"_42174":4024,"_29767":90886,"_5":21387,"_28235":89704,"_5797":90887},[],"A launch in another group answers `404`, as if it did not exist.",{"_6892":4481,"_42174":4024,"_29767":90889,"_5":21387,"_28235":89704,"_5797":90890},[],"Create body:",{"_6892":4482,"_42174":4024,"_29767":90892,"_5":21387,"_28235":89704,"_5797":85754},[],{"_6892":4483,"_42174":4024,"_29767":90894,"_5":21387,"_28235":89704,"_5797":81385},[],{"_6892":4484,"_42174":4024,"_29767":90896,"_5":21387,"_28235":89704,"_5797":79765},[],{"_6892":4485,"_42174":4024,"_29767":90898,"_5":21387,"_28235":89704,"_5797":90899},[],"`distribution_set_name`",{"_6892":4486,"_42174":4024,"_29767":90901,"_5":21387,"_28235":89704,"_5797":81396},[],{"_6892":4487,"_42174":4024,"_29767":90903,"_5":21387,"_28235":89704,"_5797":90904},[],"The pack to launch. It must be built",{"_6892":4488,"_42174":4024,"_29767":90906,"_5":21387,"_28235":89704,"_5797":85771},[],{"_6892":4489,"_42174":4024,"_29767":90908,"_5":21387,"_28235":89704,"_5797":81396},[],{"_6892":4490,"_42174":4024,"_29767":90910,"_5":21387,"_28235":89704,"_5797":90911},[],"`direct` or `phased`. The full WFX names (`wfx.workflow.dau.direct`) are accepted. hawkBit mode: `phased` makes a soft action, anything else a forced one",{"_6892":4491,"_42174":4024,"_29767":90913,"_5":21387,"_28235":89704,"_5797":85759},[],{"_6892":4492,"_42174":4024,"_29767":90915,"_5":21387,"_28235":89704,"_5797":81396},[],{"_6892":4493,"_42174":4024,"_29767":90917,"_5":21387,"_28235":89704,"_5797":90918},[],"`fixed` (a device count) or `percentage`",{"_6892":4494,"_42174":4024,"_29767":90920,"_5":21387,"_28235":89704,"_5797":85765},[],{"_6892":4495,"_42174":4024,"_29767":90922,"_5":21387,"_28235":89704,"_5797":81396},[],{"_6892":4496,"_42174":4024,"_29767":90924,"_5":21387,"_28235":89704,"_5797":90925},[],"Greater than 0",{"_6892":4497,"_42174":4024,"_29767":90927,"_5":21387,"_28235":89704,"_5797":85777},[],{"_6892":4498,"_42174":4024,"_29767":90929,"_5":21387,"_28235":89704,"_5797":81448},[],{"_6892":4499,"_42174":4024,"_29767":90931,"_5":21387,"_28235":89704,"_5797":90932},[],"The canary: it goes alone first and must succeed before the rest",{"_6892":4500,"_42174":4024,"_29767":90934,"_5":21387,"_28235":89704,"_5797":85783},[],{"_6892":4501,"_42174":4024,"_29767":90936,"_5":21387,"_28235":89704,"_5797":81448},[],{"_6892":4502,"_42174":4024,"_29767":90938,"_5":21387,"_28235":89704,"_5797":90939},[],"Release the next batch automatically. Default `false`",{"_6892":4503,"_42174":4024,"_29767":90941,"_5":21387,"_28235":89704,"_5797":85789},[],{"_6892":4504,"_42174":4024,"_29767":90943,"_5":21387,"_28235":89704,"_5797":81448},[],{"_6892":4505,"_42174":4024,"_29767":90945,"_5":21387,"_28235":89704,"_5797":90946},[],"Percent of a batch that must succeed before the next one, 0 to 100. 0 means all of it",{"_6892":4506,"_42174":4024,"_29767":90948,"_5":21387,"_28235":89704,"_5797":85795},[],{"_6892":4507,"_42174":4024,"_29767":90950,"_5":21387,"_28235":89704,"_5797":81448},[],{"_6892":4508,"_42174":4024,"_29767":90952,"_5":21387,"_28235":89704,"_5797":90953},[],"Percent of all devices allowed to fail before the launch is cancelled, 0 to 100. 0 means no limit",{"_6892":4509,"_42174":4024,"_29767":90955,"_5":21387,"_28235":89704,"_5797":88225},[],{"_6892":4510,"_42174":4024,"_29767":90957,"_5":21387,"_28235":89704,"_5797":81448},[],{"_6892":4511,"_42174":4024,"_29767":90959,"_5":21387,"_28235":89704,"_5797":90960},[],"Deploy to every device even when preconditions fail. The failures are still recorded",{"_6892":4512,"_42174":4024,"_29767":90962,"_5":21387,"_28235":89704,"_5797":85801},[],{"_6892":4513,"_42174":4024,"_29767":90964,"_5":21387,"_28235":89704,"_5797":81448},[],{"_6892":4514,"_42174":4024,"_29767":90966,"_5":21387,"_28235":89704,"_5797":90967},[],"RFC 3339 start time. Native: the service starts the launch within about 30 seconds of it. hawkBit mode: hawkBit's scheduler starts it",{"_6892":4515,"_42174":4024,"_29767":90969,"_5":21387,"_28235":89704,"_5797":85807},[],{"_6892":4516,"_42174":4024,"_29767":90971,"_5":21387,"_28235":89704,"_5797":81448},[],{"_6892":4517,"_42174":4024,"_29767":90973,"_5":21387,"_28235":89704,"_5797":90974},[],"Display name (defaults to the pack name) and operator notes",{"_6892":4518,"_42174":4024,"_29767":90976,"_5":21387,"_28235":89704,"_5797":85813},[],{"_6892":4519,"_42174":4024,"_29767":90978,"_5":21387,"_28235":89704,"_5797":81448},[],{"_6892":4520,"_42174":4024,"_29767":90980,"_5":21387,"_28235":89704,"_5797":90981},[],"A stored priority hint, 0 to 1000. Nothing enforces it",{"_6892":4521,"_42174":4024,"_29767":90983,"_5":21387,"_28235":89704,"_5797":90984},[],"The strategy update body takes `workflow_type`, `rollout_type`, `rollout_value` (greater than 0), `test_device_id`, `auto`, `approval_threshold` and `error_threshold`. It replaces all of them: an omitted field resets to its zero value, so send the whole strategy.",{"_6892":4522,"_42174":4024,"_29767":90986,"_5":21387,"_28235":89704,"_5797":90987},[],"A create answers `201` with `launch_id`, `precondition_failures`, `forced`, `superseded_devices` and `never_seen_devices`. A dry run answers `200` with `qualifying_devices`, `precondition_failures`, `superseded_devices` and `never_seen_devices`. The last two are filled only in hawkBit mode: devices with an update in flight, which creating the launch cancels, and devices that have never contacted hawkBit.",{"_6892":4523,"_42174":4024,"_29767":90989,"_5":21387,"_28235":89704,"_5797":90990},[],"A launch is refused with `400` when the pack is not built, or when a per-device encrypted pack has devices without a package (dry runs included, and `force_preconditions` does not override it).",{"_6892":4524,"_42174":4024,"_29767":90992,"_5":21387,"_28235":89707,"_5797":80461},[],{"_6892":4525,"_42174":4024,"_29767":90994,"_5":21387,"_28235":89707,"_5797":80673},[],{"_6892":4526,"_42174":4024,"_29767":90996,"_5":21387,"_28235":89707,"_5797":81388},[],{"_6892":4527,"_42174":4024,"_29767":90998,"_5":21387,"_28235":89707,"_5797":84023},[],{"_6892":4528,"_42174":4024,"_29767":91000,"_5":21387,"_28235":89707,"_5797":91001},[],"`/groups/:groupID/device/:deviceID/jobs`",{"_6892":4529,"_42174":4024,"_29767":91003,"_5":21387,"_28235":89707,"_5797":91004},[],"A device's jobs. `404` if the device is not in the group",{"_6892":4530,"_42174":4024,"_29767":91006,"_5":21387,"_28235":89707,"_5797":84023},[],{"_6892":4531,"_42174":4024,"_29767":91008,"_5":21387,"_28235":89707,"_5797":91009},[],"`/groups/:groupID/device/:deviceID/history`",{"_6892":4532,"_42174":4024,"_29767":91011,"_5":21387,"_28235":89707,"_5797":91012},[],"A device's job history. `404` if there is none",{"_6892":4533,"_42174":4024,"_29767":91014,"_5":21387,"_28235":89707,"_5797":84023},[],{"_6892":4534,"_42174":4024,"_29767":91016,"_5":21387,"_28235":89707,"_5797":91017},[],"`/launch/:launchID/jobs`",{"_6892":4535,"_42174":4024,"_29767":91019,"_5":21387,"_28235":89707,"_5797":91020},[],"All jobs of a launch",{"_6892":4536,"_42174":4024,"_29767":91022,"_5":21387,"_28235":89707,"_5797":84032},[],{"_6892":4537,"_42174":4024,"_29767":91024,"_5":21387,"_28235":89707,"_5797":91025},[],"`/jobs/:jobID/transition`",{"_6892":4538,"_42174":4024,"_29767":91027,"_5":21387,"_28235":89707,"_5797":91028},[],"Force a job into a state (body `state`, optional `message`, `progress`, `context`). Registered only when `enable_test_endpoints` is true. For tests only: it does no ownership check",{"_6892":4539,"_42174":4024,"_29767":91030,"_5":21387,"_28235":89711,"_5797":80461},[],{"_6892":4540,"_42174":4024,"_29767":91032,"_5":21387,"_28235":89711,"_5797":80673},[],{"_6892":4541,"_42174":4024,"_29767":91034,"_5":21387,"_28235":89711,"_5797":81388},[],{"_6892":4542,"_42174":4024,"_29767":91036,"_5":21387,"_28235":89711,"_5797":84023},[],{"_6892":4543,"_42174":4024,"_29767":91038,"_5":21387,"_28235":89711,"_5797":91039},[],"`/devices/distribution-sets`",{"_6892":4544,"_42174":4024,"_29767":91041,"_5":21387,"_28235":89711,"_5797":91042},[],"Pack versions across all devices, filterable",{"_6892":4545,"_42174":4024,"_29767":91044,"_5":21387,"_28235":89711,"_5797":84023},[],{"_6892":4546,"_42174":4024,"_29767":91046,"_5":21387,"_28235":89711,"_5797":91047},[],"`/devices/:deviceID/distribution-sets`",{"_6892":4547,"_42174":4024,"_29767":91049,"_5":21387,"_28235":89711,"_5797":91050},[],"Pack versions on one device",{"_6892":4548,"_42174":4024,"_29767":91052,"_5":21387,"_28235":89711,"_5797":84023},[],{"_6892":4549,"_42174":4024,"_29767":91054,"_5":21387,"_28235":89711,"_5797":91055},[],"`/devices/:deviceID/distribution-set-inventory`",{"_6892":4550,"_42174":4024,"_29767":91057,"_5":21387,"_28235":89711,"_5797":91058},[],"The device's packs, each with its artifacts",{"_6892":4551,"_42174":4024,"_29767":91060,"_5":21387,"_28235":89711,"_5797":84023},[],{"_6892":4552,"_42174":4024,"_29767":91062,"_5":21387,"_28235":89711,"_5797":91063},[],"`/devices/:deviceID/distribution-set-updates`",{"_6892":4553,"_42174":4024,"_29767":91065,"_5":21387,"_28235":89711,"_5797":91066},[],"Update history of the device, newest first",{"_6892":4554,"_42174":4024,"_29767":91068,"_5":21387,"_28235":89711,"_5797":84023},[],{"_6892":4555,"_42174":4024,"_29767":91070,"_5":21387,"_28235":89711,"_5797":91071},[],"`/devices/distribution-set-updates/latest`",{"_6892":4556,"_42174":4024,"_29767":91073,"_5":21387,"_28235":89711,"_5797":91074},[],"The newest update attempt for each device and pack, including attempts outside any launch. Filters apply to that attempt, so `status[eq]failed` lists devices whose last update failed",{"_6892":4557,"_42174":4024,"_29767":91076,"_5":21387,"_28235":89715,"_5797":91077},[],"Declare the version devices should be on, then report and correct drift.",{"_6892":4558,"_42174":4024,"_29767":91079,"_5":21387,"_28235":89715,"_5797":80461},[],{"_6892":4559,"_42174":4024,"_29767":91081,"_5":21387,"_28235":89715,"_5797":80673},[],{"_6892":4560,"_42174":4024,"_29767":91083,"_5":21387,"_28235":89715,"_5797":81388},[],{"_6892":4561,"_42174":4024,"_29767":91085,"_5":21387,"_28235":89715,"_5797":84023},[],{"_6892":4562,"_42174":4024,"_29767":91087,"_5":21387,"_28235":89715,"_5797":91088},[],"`/groups/:groupID/latest-distribution-sets`",{"_6892":4563,"_42174":4024,"_29767":91090,"_5":21387,"_28235":89715,"_5797":91091},[],"A group's declared latest versions",{"_6892":4564,"_42174":4024,"_29767":91093,"_5":21387,"_28235":89715,"_5797":84032},[],{"_6892":4565,"_42174":4024,"_29767":91095,"_5":21387,"_28235":89715,"_5797":91096},[],"`/groups/:groupID/latest-distribution-sets/:distributionSetID`",{"_6892":4566,"_42174":4024,"_29767":91098,"_5":21387,"_28235":89715,"_5797":91099},[],"Declare a pack's latest version (body `{\"version\":\"1.2.0\"}`)",{"_6892":4567,"_42174":4024,"_29767":91101,"_5":21387,"_28235":89715,"_5797":90073},[],{"_6892":4568,"_42174":4024,"_29767":91103,"_5":21387,"_28235":89715,"_5797":91096},[],{"_6892":4569,"_42174":4024,"_29767":91105,"_5":21387,"_28235":89715,"_5797":91106},[],"Remove the declaration. Answers `204`",{"_6892":4570,"_42174":4024,"_29767":91108,"_5":21387,"_28235":89715,"_5797":84023},[],{"_6892":4571,"_42174":4024,"_29767":91110,"_5":21387,"_28235":89715,"_5797":91111},[],"`/devices/:deviceID/latest-drift`",{"_6892":4572,"_42174":4024,"_29767":91113,"_5":21387,"_28235":89715,"_5797":91114},[],"A device's drift from its group's latest versions. Optional `?groupID=`",{"_6892":4573,"_42174":4024,"_29767":91116,"_5":21387,"_28235":89715,"_5797":84591},[],{"_6892":4574,"_42174":4024,"_29767":91118,"_5":21387,"_28235":89715,"_5797":91119},[],"`/devices/:deviceID/sync-to-latest`",{"_6892":4575,"_42174":4024,"_29767":91121,"_5":21387,"_28235":89715,"_5797":91122},[],"Force the device to match. Answers `202` with the drift",{"_6892":4576,"_42174":4024,"_29767":91124,"_5":21387,"_28235":89715,"_5797":84591},[],{"_6892":4577,"_42174":4024,"_29767":91126,"_5":21387,"_28235":89715,"_5797":91127},[],"`/devices/:deviceID/force-version`",{"_6892":4578,"_42174":4024,"_29767":91129,"_5":21387,"_28235":89715,"_5797":91130},[],"Launch one device to a version. Answers `202`",{"_6892":4579,"_42174":4024,"_29767":91132,"_5":21387,"_28235":89715,"_5797":84023},[],{"_6892":4580,"_42174":4024,"_29767":91134,"_5":21387,"_28235":89715,"_5797":91135},[],"`/groups/:groupID/version-compliance`",{"_6892":4581,"_42174":4024,"_29767":91137,"_5":21387,"_28235":89715,"_5797":91138},[],"Devices not on the latest version, as `{\"group_id\", \"devices\": [...]}`",{"_6892":4582,"_42174":4024,"_29767":91140,"_5":21387,"_28235":89715,"_5797":84023},[],{"_6892":4583,"_42174":4024,"_29767":91142,"_5":21387,"_28235":89715,"_5797":91143},[],"`/groups/:groupID/version-status`",{"_6892":4584,"_42174":4024,"_29767":91145,"_5":21387,"_28235":89715,"_5797":91146},[],"The full per-device matrix, compliant and outdated, as `{\"group_id\", \"rows\": [...]}`",{"_6892":4585,"_42174":4024,"_29767":91148,"_5":21387,"_28235":89715,"_5797":91149},[],"`sync-to-latest` takes an optional body with `groupID` (also accepted as `?groupID=`), `distribution_set_ids` to limit the packs and `workflow`. If some devices could not be dispatched it answers `207`, or `400` when none were, with `{\"err\": \"...\", \"drift\": {...}}`.",{"_6892":4586,"_42174":4024,"_29767":91151,"_5":21387,"_28235":89715,"_5797":91152},[],"`force-version` takes `distribution_set_id` and `version` (required), `group_id` and `workflow`. The device must be a member of the pack's group. For a `swu` pack `workflow` defaults to `phased`, and for a `non-swu` pack to `download-install`. Native mode accepts only the pack's current version unless the pack has `allow_previous_version_download`, and `sync-to-latest` has the same limit. hawkBit mode ignores `workflow` in both routes.",{"_6892":4587,"_42174":4024,"_29767":91154,"_5":21387,"_28235":89715,"_5797":91155},[],"A drift entry has `distribution_set_id`, `distribution_set_name`, `current_version`, `latest_version`, `in_sync` and `missing`. A `version-status` row has `device_id`, `distribution_set_id`, `distribution_set_name`, `current_version`, `latest_version`, `in_sync` and, when newer than the declared one, `newest_version`.",{"_6892":4588,"_42174":4024,"_29767":91157,"_5":21387,"_28235":89719,"_5797":91158},[],"In hawkBit mode the service also serves hawkBit's device artifact URL, so a gateway can publish it on the same host as the rest of the API:",{"_6892":4589,"_42174":4024,"_29767":91160,"_5":21387,"_28235":89719,"_5797":80461},[],{"_6892":4590,"_42174":4024,"_29767":91162,"_5":21387,"_28235":89719,"_5797":80673},[],{"_6892":4591,"_42174":4024,"_29767":91164,"_5":21387,"_28235":89719,"_5797":81388},[],{"_6892":4592,"_42174":4024,"_29767":91166,"_5":21387,"_28235":89719,"_5797":91167},[],"`GET`, `HEAD`",{"_6892":4593,"_42174":4024,"_29767":91169,"_5":21387,"_28235":89719,"_5797":91170},[],"`<prefix>/:tenant/controller/v1/:controllerId/softwaremodules/:softwareModuleId/artifacts/:filename`",{"_6892":4594,"_42174":4024,"_29767":91172,"_5":21387,"_28235":89719,"_5797":91173},[],"A module's artifact, or its `.MD5SUM` sidecar as `text/plain`",{"_6892":4595,"_42174":4024,"_29767":91175,"_5":21387,"_28235":89719,"_5797":91176},[],"`<prefix>` is the path of `hawkbit.ddi_url`, for example `/api/hawkbit-ddi`. The route is registered only in hawkBit mode. It answers only for modules in the device's assigned or installed set, and `404` otherwise, and `:tenant` must be the configured tenant. With presigning enabled it answers `302` like the other downloads.",{"_6892":4596,"_42174":4024,"_29767":91178,"_5":21387,"_28235":89723,"_5797":91179},[],"Served at `/symkms/v1` by the same process when SymKMS is configured. It stores symmetric keys and binds them to devices. The encrypt, decrypt and MAC bodies and formats are in Signing and encryption. Errors use the same `{\"err\":\"...\"}` body.",{"_6892":4597,"_42174":4024,"_29767":91181,"_5":21387,"_28235":89723,"_5797":80461},[],{"_6892":4598,"_42174":4024,"_29767":91183,"_5":21387,"_28235":89723,"_5797":80673},[],{"_6892":4599,"_42174":4024,"_29767":91185,"_5":21387,"_28235":89723,"_5797":81388},[],{"_6892":4600,"_42174":4024,"_29767":91187,"_5":21387,"_28235":89723,"_5797":84591},[],{"_6892":4601,"_42174":4024,"_29767":91189,"_5":21387,"_28235":89723,"_5797":91190},[],"`/symkms/v1/`",{"_6892":4602,"_42174":4024,"_29767":91192,"_5":21387,"_28235":89723,"_5797":91193},[],"Store a key. Body `user_id`, `algorithm`, `key` (hex or Base64), optional `id`. Answers `201` with `id`, `user_id`, `algorithm`, `created_at`",{"_6892":4603,"_42174":4024,"_29767":91195,"_5":21387,"_28235":89723,"_5797":84023},[],{"_6892":4604,"_42174":4024,"_29767":91197,"_5":21387,"_28235":89723,"_5797":91198},[],"`/symkms/v1/?user_id=`",{"_6892":4605,"_42174":4024,"_29767":91200,"_5":21387,"_28235":89723,"_5797":91201},[],"List a user's keys. `user_id` is required. Paginated, filterable by `user_id`, `algorithm`, `created_at`",{"_6892":4606,"_42174":4024,"_29767":91203,"_5":21387,"_28235":89723,"_5797":90073},[],{"_6892":4607,"_42174":4024,"_29767":91205,"_5":21387,"_28235":89723,"_5797":91206},[],"`/symkms/v1/:keyID?user_id=`",{"_6892":4608,"_42174":4024,"_29767":91208,"_5":21387,"_28235":89723,"_5797":91209},[],"Delete a key. `user_id` is required and must own it",{"_6892":4609,"_42174":4024,"_29767":91211,"_5":21387,"_28235":89723,"_5797":84023},[],{"_6892":4610,"_42174":4024,"_29767":91213,"_5":21387,"_28235":89723,"_5797":91214},[],"`/symkms/v1/:keyID/raw?user_id=`",{"_6892":4611,"_42174":4024,"_29767":91216,"_5":21387,"_28235":89723,"_5797":91217},[],"Raw key material (`key_id`, `key_hex`, `algorithm`). Privileged",{"_6892":4612,"_42174":4024,"_29767":91219,"_5":21387,"_28235":89723,"_5797":84591},[],{"_6892":4613,"_42174":4024,"_29767":91221,"_5":21387,"_28235":89723,"_5797":91222},[],"`/symkms/v1/encrypt`, `/decrypt`",{"_6892":4614,"_42174":4024,"_29767":91224,"_5":21387,"_28235":89723,"_5797":91225},[],"Encrypt or decrypt with a stored key",{"_6892":4615,"_42174":4024,"_29767":91227,"_5":21387,"_28235":89723,"_5797":84591},[],{"_6892":4616,"_42174":4024,"_29767":91229,"_5":21387,"_28235":89723,"_5797":91230},[],"`/symkms/v1/mac`, `/mac/verify`",{"_6892":4617,"_42174":4024,"_29767":91232,"_5":21387,"_28235":89723,"_5797":91233},[],"Compute or verify a MAC (JSON body)",{"_6892":4618,"_42174":4024,"_29767":91235,"_5":21387,"_28235":89723,"_5797":84591},[],{"_6892":4619,"_42174":4024,"_29767":91237,"_5":21387,"_28235":89723,"_5797":91238},[],"`/symkms/v1/mac/file`, `/mac/verify/file`",{"_6892":4620,"_42174":4024,"_29767":91240,"_5":21387,"_28235":89723,"_5797":91241},[],"The same, with the data as an uploaded `file`",{"_6892":4621,"_42174":4024,"_29767":91243,"_5":21387,"_28235":89723,"_5797":84591},[],{"_6892":4622,"_42174":4024,"_29767":91245,"_5":21387,"_28235":89723,"_5797":91246},[],"`/symkms/v1/inventory/:deviceID/keys/:keyID`",{"_6892":4623,"_42174":4024,"_29767":91248,"_5":21387,"_28235":89723,"_5797":91249},[],"Assign a key to a device. Optional body `purpose`, `expires_at` (RFC 3339). Answers `201` with the binding",{"_6892":4624,"_42174":4024,"_29767":91251,"_5":21387,"_28235":89723,"_5797":90073},[],{"_6892":4625,"_42174":4024,"_29767":91253,"_5":21387,"_28235":89723,"_5797":91246},[],{"_6892":4626,"_42174":4024,"_29767":91255,"_5":21387,"_28235":89723,"_5797":91256},[],"Revoke a key from a device",{"_6892":4627,"_42174":4024,"_29767":91258,"_5":21387,"_28235":89723,"_5797":84023},[],{"_6892":4628,"_42174":4024,"_29767":91260,"_5":21387,"_28235":89723,"_5797":91261},[],"`/symkms/v1/inventory/:deviceID`",{"_6892":4629,"_42174":4024,"_29767":91263,"_5":21387,"_28235":89723,"_5797":91264},[],"A device's key bindings. Paginated, filterable by `purpose`, `status`, `assigned_at`",{"_6892":4630,"_42174":4024,"_29767":91266,"_5":21387,"_28235":89723,"_5797":84023},[],{"_6892":4631,"_42174":4024,"_29767":91268,"_5":21387,"_28235":89723,"_5797":91269},[],"`/symkms/v1/inventory/by-key/:keyID`",{"_6892":4632,"_42174":4024,"_29767":91271,"_5":21387,"_28235":89723,"_5797":91272},[],"The devices a key is assigned to, as `key_id` and `device_ids`",{"_6892":4633,"_42174":4024,"_29767":91274,"_5":21387,"_28235":89723,"_5797":84023},[],{"_6892":4634,"_42174":4024,"_29767":91276,"_5":21387,"_28235":89723,"_5797":91277},[],"`/symkms/v1/inventory/:deviceID/key?purpose=`",{"_6892":4635,"_42174":4024,"_29767":91279,"_5":21387,"_28235":89723,"_5797":91280},[],"The device's raw key for a purpose, default `firmware-encryption`. Privileged. `404` without a binding",{"_6892":4636,"_42174":4024,"_29767":91282,"_5":21387,"_28235":89723,"_5797":91283},[],"An empty `purpose` is a wildcard that matches any lookup, and a specific purpose is matched exactly. The routes that return raw key material trust the gateway to authenticate callers: do not expose them without mTLS or scoped tokens. See Security.",{"_6892":4637,"_42174":4024,"_29767":91285,"_5":21387,"_28235":89726,"_5797":91286},[],"Capabilities for what each backend supports",{"_6892":4638,"_42174":4024,"_29767":91288,"_5":21387,"_28235":89726,"_5797":87705},[],{"_6892":4639,"_42174":4024,"_29767":91290,"_5":21387,"_28235":89726,"_5797":87408},[],{"_6892":4640,"_42174":4640,"_5":21817,"_5797":88773,"_42654":91292,"_29767":91293,"_28235":4640},[77248,78697,85231,89621],[],{"_6892":4641,"_42174":4640,"_29767":91295,"_5":21387,"_28235":4640,"_5797":91296},[],"The 22 capability flags of Lamassu Updates, what each backend supports, and how a client reads them.",{"_6892":4642,"_42174":4640,"_5":42651,"_29767":91298,"_28235":91299,"_5797":91300},[],"/docs/pr-preview/pr-56/platform/updates/reference/capabilities#read-the-capabilities","Read the capabilities",{"_6892":4643,"_42174":4640,"_5":42651,"_29767":91302,"_28235":91303,"_5797":91304},[],"/docs/pr-preview/pr-56/platform/updates/reference/capabilities#per-backend-support","Per-backend support",{"_6892":4644,"_42174":4640,"_5":42651,"_29767":91306,"_28235":91307,"_5797":91308},[],"/docs/pr-preview/pr-56/platform/updates/reference/capabilities#conditional-flags-in-hawkbit-mode","Conditional flags in hawkBit mode",{"_6892":4645,"_42174":4640,"_5":42651,"_29767":91310,"_28235":91311,"_5797":91312},[],"/docs/pr-preview/pr-56/platform/updates/reference/capabilities#flags-that-differ-in-meaning","Flags that differ in meaning",{"_6892":4646,"_42174":4640,"_5":42651,"_29767":91314,"_28235":91315,"_5797":91316},[],"/docs/pr-preview/pr-56/platform/updates/reference/capabilities#what-a-client-should-do","What a client should do",{"_6892":4647,"_42174":4640,"_5":42651,"_29767":91318,"_28235":91319,"_5797":80372},[],"/docs/pr-preview/pr-56/platform/updates/reference/capabilities#next-steps",{"_6892":4648,"_42174":4640,"_29767":91321,"_5":21387,"_28235":4640,"_5797":91322},[],"`GET /updates/v1/capabilities` tells a client which backend is active (`native` or `hawkbit&#x60;) and which of 22 features it supports. Read it once and hide what does not apply. An operation the backend does not implement answers &#x2A;*`501 Not Implemented`**, never `500`; a `501` is a permanent property of the deployment, so retrying will not help. The one exception is `GET /workflows`, which answers an empty list in hawkBit mode.",{"_6892":4649,"_42174":4640,"_29767":91324,"_5":21387,"_28235":91299,"_5797":91325},[],"The route takes no parameters and has no side effects. The service serves it without authentication, like `/health`; a gateway in front of it may still require a token.",{"_6892":4650,"_42174":4640,"_29767":91327,"_5":21387,"_28235":91299,"_5797":91328},[],"The response has three fields:",{"_6892":4651,"_42174":4640,"_29767":91330,"_5":21387,"_28235":91299,"_5797":85754},[],{"_6892":4652,"_42174":4640,"_29767":91332,"_5":21387,"_28235":91299,"_5797":81382},[],{"_6892":4653,"_42174":4640,"_29767":91334,"_5":21387,"_28235":91299,"_5797":79765},[],{"_6892":4654,"_42174":4640,"_29767":91336,"_5":21387,"_28235":91299,"_5797":91337},[],"`backend`",{"_6892":4655,"_42174":4640,"_29767":91339,"_5":21387,"_28235":91299,"_5797":34761},[],{"_6892":4656,"_42174":4640,"_29767":91341,"_5":21387,"_28235":91299,"_5797":91342},[],"`native` or `hawkbit`",{"_6892":4657,"_42174":4640,"_29767":91344,"_5":21387,"_28235":91299,"_5797":91345},[],"`supported`",{"_6892":4658,"_42174":4640,"_29767":91347,"_5":21387,"_28235":91299,"_5797":25562},[],{"_6892":4659,"_42174":4640,"_29767":91349,"_5":21387,"_28235":91299,"_5797":91350},[],"One boolean per flag. It always carries all 22 keys, so a missing key means a client/server version skew, not \"supported\"",{"_6892":4660,"_42174":4640,"_29767":91352,"_5":21387,"_28235":91299,"_5797":91353},[],"`unsupported`",{"_6892":4661,"_42174":4640,"_29767":91355,"_5":21387,"_28235":91299,"_5797":91356},[],"array of strings",{"_6892":4662,"_42174":4640,"_29767":91358,"_5":21387,"_28235":91299,"_5797":91359},[],"The flags that are `false`, repeated for convenience, in the order of the table below",{"_6892":4663,"_42174":4640,"_29767":91361,"_5":21387,"_28235":91299,"_5797":91362},[],"An example for a native deployment:",{"_6892":4664,"_42174":4640,"_29767":91364,"_5":21387,"_28235":91303,"_5797":91365},[],"\"Yes\" means supported. \"Conditional\" means it depends on configuration or on the hawkBit server; see the notes after the table.",{"_6892":4665,"_42174":4640,"_29767":91367,"_5":21387,"_28235":91303,"_5797":91368},[],"Capability",{"_6892":4666,"_42174":4640,"_29767":91370,"_5":21387,"_28235":91303,"_5797":33773},[],{"_6892":4667,"_42174":4640,"_29767":91372,"_5":21387,"_28235":91303,"_5797":30159},[],{"_6892":4668,"_42174":4640,"_29767":91374,"_5":21387,"_28235":91303,"_5797":91375},[],"`latest_versions`: declare the latest version per group, plus per-device drift and force-sync",{"_6892":4669,"_42174":4640,"_29767":91377,"_5":21387,"_28235":91303,"_5797":81396},[],{"_6892":4670,"_42174":4640,"_29767":91379,"_5":21387,"_28235":91303,"_5797":81396},[],{"_6892":4671,"_42174":4640,"_29767":91381,"_5":21387,"_28235":91303,"_5797":91382},[],"`version_compliance`: group-wide compliance and version-status reports",{"_6892":4672,"_42174":4640,"_29767":91384,"_5":21387,"_28235":91303,"_5797":81396},[],{"_6892":4673,"_42174":4640,"_29767":91386,"_5":21387,"_28235":91303,"_5797":81396},[],{"_6892":4674,"_42174":4640,"_29767":91388,"_5":21387,"_28235":91303,"_5797":91389},[],"`artifact_signatures`: signed version manifests and the artifacts archive",{"_6892":4675,"_42174":4640,"_29767":91391,"_5":21387,"_28235":91303,"_5797":81396},[],{"_6892":4676,"_42174":4640,"_29767":91393,"_5":21387,"_28235":91303,"_5797":81396},[],{"_6892":4677,"_42174":4640,"_29767":91395,"_5":21387,"_28235":91303,"_5797":91396},[],"`artifact_encryption`: shared-key encryption and KMS signing at build",{"_6892":4678,"_42174":4640,"_29767":91398,"_5":21387,"_28235":91303,"_5797":81396},[],{"_6892":4679,"_42174":4640,"_29767":91400,"_5":21387,"_28235":91303,"_5797":91401},[],"Conditional",{"_6892":4680,"_42174":4640,"_29767":91403,"_5":21387,"_28235":91303,"_5797":91404},[],"`per_device_encryption`: one deliverable per device, each with its own key",{"_6892":4681,"_42174":4640,"_29767":91406,"_5":21387,"_28235":91303,"_5797":81396},[],{"_6892":4682,"_42174":4640,"_29767":91408,"_5":21387,"_28235":91303,"_5797":91409},[],"**No**",{"_6892":4683,"_42174":4640,"_29767":91411,"_5":21387,"_28235":91303,"_5797":91412},[],"`artifact_download_by_name`: fetch a pack's staged file by file name",{"_6892":4684,"_42174":4640,"_29767":91414,"_5":21387,"_28235":91303,"_5797":81396},[],{"_6892":4685,"_42174":4640,"_29767":91416,"_5":21387,"_28235":91303,"_5797":81396},[],{"_6892":4686,"_42174":4640,"_29767":91418,"_5":21387,"_28235":91303,"_5797":91419},[],"`workflows`: choose the WFX workflow per launch",{"_6892":4687,"_42174":4640,"_29767":91421,"_5":21387,"_28235":91303,"_5797":81396},[],{"_6892":4688,"_42174":4640,"_29767":91423,"_5":21387,"_28235":91303,"_5797":91409},[],{"_6892":4689,"_42174":4640,"_29767":91425,"_5":21387,"_28235":91303,"_5797":91426},[],"`launch_strategy_update`: edit the strategy after creation",{"_6892":4690,"_42174":4640,"_29767":91428,"_5":21387,"_28235":91303,"_5797":81396},[],{"_6892":4691,"_42174":4640,"_29767":91430,"_5":21387,"_28235":91303,"_5797":91409},[],{"_6892":4692,"_42174":4640,"_29767":91432,"_5":21387,"_28235":91303,"_5797":91433},[],"`launch_complete`: mark a launch complete early",{"_6892":4693,"_42174":4640,"_29767":91435,"_5":21387,"_28235":91303,"_5797":81396},[],{"_6892":4694,"_42174":4640,"_29767":91437,"_5":21387,"_28235":91303,"_5797":91409},[],{"_6892":4695,"_42174":4640,"_29767":91439,"_5":21387,"_28235":91303,"_5797":91440},[],"`launch_device_assignment`: add devices to a launch after creation (a service operation with no HTTP route)",{"_6892":4696,"_42174":4640,"_29767":91442,"_5":21387,"_28235":91303,"_5797":81396},[],{"_6892":4697,"_42174":4640,"_29767":91444,"_5":21387,"_28235":91303,"_5797":91409},[],{"_6892":4698,"_42174":4640,"_29767":91446,"_5":21387,"_28235":91303,"_5797":91447},[],"`scheduled_launch`: start a launch at a future time",{"_6892":4699,"_42174":4640,"_29767":91449,"_5":21387,"_28235":91303,"_5797":91450},[],"Yes (the service polls)",{"_6892":4700,"_42174":4640,"_29767":91452,"_5":21387,"_28235":91303,"_5797":91453},[],"Yes (hawkBit's own scheduler)",{"_6892":4701,"_42174":4640,"_29767":91455,"_5":21387,"_28235":91303,"_5797":91456},[],"`push_events`: server-pushed job state",{"_6892":4702,"_42174":4640,"_29767":91458,"_5":21387,"_28235":91303,"_5797":81396},[],{"_6892":4703,"_42174":4640,"_29767":91460,"_5":21387,"_28235":91303,"_5797":91461},[],"**No** (poll)",{"_6892":4704,"_42174":4640,"_29767":91463,"_5":21387,"_28235":91303,"_5797":91464},[],"`launch_preconditions`: gate the deployable devices on installed versions",{"_6892":4705,"_42174":4640,"_29767":91466,"_5":21387,"_28235":91303,"_5797":81396},[],{"_6892":4706,"_42174":4640,"_29767":91468,"_5":21387,"_28235":91303,"_5797":81396},[],{"_6892":4707,"_42174":4640,"_29767":91470,"_5":21387,"_28235":91303,"_5797":91471},[],"`campaigns`: plan, start, pause, resume, cancel, retry failed",{"_6892":4708,"_42174":4640,"_29767":91473,"_5":21387,"_28235":91303,"_5797":81396},[],{"_6892":4709,"_42174":4640,"_29767":91475,"_5":21387,"_28235":91303,"_5797":81396},[],{"_6892":4710,"_42174":4640,"_29767":91477,"_5":21387,"_28235":91303,"_5797":91478},[],"`canary_device`: the first batch is one named device",{"_6892":4711,"_42174":4640,"_29767":91480,"_5":21387,"_28235":91303,"_5797":81396},[],{"_6892":4712,"_42174":4640,"_29767":91482,"_5":21387,"_28235":91303,"_5797":81396},[],{"_6892":4713,"_42174":4640,"_29767":91484,"_5":21387,"_28235":91303,"_5797":91485},[],"`device_inventory`: which pack version a device carries, and its update history",{"_6892":4714,"_42174":4640,"_29767":91487,"_5":21387,"_28235":91303,"_5797":81396},[],{"_6892":4715,"_42174":4640,"_29767":91489,"_5":21387,"_28235":91303,"_5797":81396},[],{"_6892":4716,"_42174":4640,"_29767":91491,"_5":21387,"_28235":91303,"_5797":91492},[],"`artifact_catalog`: fleet-wide artifact catalog and per-pack listing",{"_6892":4717,"_42174":4640,"_29767":91494,"_5":21387,"_28235":91303,"_5797":81396},[],{"_6892":4718,"_42174":4640,"_29767":91496,"_5":21387,"_28235":91303,"_5797":81396},[],{"_6892":4719,"_42174":4640,"_29767":91498,"_5":21387,"_28235":91303,"_5797":91499},[],"`prebuilt_deliverable`: attach an externally built file to a pack",{"_6892":4720,"_42174":4640,"_29767":91501,"_5":21387,"_28235":91303,"_5797":81396},[],{"_6892":4721,"_42174":4640,"_29767":91503,"_5":21387,"_28235":91303,"_5797":91409},[],{"_6892":4722,"_42174":4640,"_29767":91505,"_5":21387,"_28235":91303,"_5797":91506},[],"`software_module_composition`: a pack is a composition of typed modules",{"_6892":4723,"_42174":4640,"_29767":91508,"_5":21387,"_28235":91303,"_5797":81396},[],{"_6892":4724,"_42174":4640,"_29767":91510,"_5":21387,"_28235":91303,"_5797":91401},[],{"_6892":4725,"_42174":4640,"_29767":91512,"_5":21387,"_28235":91303,"_5797":91513},[],"`software_module_deliverables`: each module has its own deliverable",{"_6892":4726,"_42174":4640,"_29767":91515,"_5":21387,"_28235":91303,"_5797":91409},[],{"_6892":4727,"_42174":4640,"_29767":91517,"_5":21387,"_28235":91303,"_5797":81396},[],{"_6892":4728,"_42174":4640,"_29767":91519,"_5":21387,"_28235":91303,"_5797":91520},[],"`standalone_software_modules`: create a module with no pack",{"_6892":4729,"_42174":4640,"_29767":91522,"_5":21387,"_28235":91303,"_5797":81396},[],{"_6892":4730,"_42174":4640,"_29767":91524,"_5":21387,"_28235":91303,"_5797":91401},[],{"_6892":4731,"_42174":4640,"_29767":91526,"_5":21387,"_28235":91303,"_5797":91527},[],"`software_module_replace`: swap a module for another version of itself",{"_6892":4732,"_42174":4640,"_29767":91529,"_5":21387,"_28235":91303,"_5797":91409},[],{"_6892":4733,"_42174":4640,"_29767":91531,"_5":21387,"_28235":91303,"_5797":91401},[],{"_6892":4734,"_42174":4640,"_29767":91533,"_5":21387,"_28235":91307,"_5797":91534},[],"**`artifact_encryption`** is reported unsupported only when none of `swugenerator_path`, `symkms_endpoint` and `kms_endpoint` is configured. Each build option still needs its own settings: see Signing and encryption.",{"_6892":4735,"_42174":4640,"_29767":91536,"_5":21387,"_28235":91307,"_5797":91537},[],"**`software_module_composition`, `standalone_software_modules` and `software_module_replace`** depend on the hawkBit server having the pre-seeded `os` and `application` module types and the `os_app` or `app` set type. The service probes this with a 5 second timeout, caches the result for about five minutes and assumes support when hawkBit is unreachable. When the probe fails, all three flags are reported unsupported together.",{"_6892":4736,"_42174":4640,"_29767":91539,"_5":21387,"_28235":91307,"_5797":91540},[],"**`software_module_deliverables`** is always reported supported in hawkBit mode. Building a `swu-build` module still needs a `swugenerator_path`, and without one the build answers `501`.",{"_6892":4737,"_42174":4640,"_29767":91542,"_5":21387,"_28235":91307,"_5797":91543},[],"**`prebuilt_deliverable`**: a hawkBit pack is never built directly. A `swu-prebuilt` catalog module accepts a finished `.swu` instead.",{"_6892":4738,"_42174":4640,"_29767":91545,"_5":21387,"_28235":91311,"_5797":91546},[],"Both backends report `software_module_composition`, but importing a module **links** it in hawkBit mode (both packs share one module) and **copies** it in native mode. The reusable-modules list reports this per candidate in its `shared` field, so a client can tell the operator which one they get. See Concepts.",{"_6892":4739,"_42174":4640,"_29767":91548,"_5":21387,"_28235":91311,"_5797":91549},[],"In native mode a launch dispatches one job per device with a single download URI, so a module has no deliverable of its own: the pack builds one `.swu` from every module's inputs. That is why `software_module_deliverables` and `software_module_replace` are unsupported there.",{"_6892":4740,"_42174":4640,"_29767":91551,"_5":21387,"_28235":91315,"_5797":91552},[],"Call `capabilities` once at start-up and before showing a feature the table marks as backend-dependent.",{"_6892":4741,"_42174":4640,"_29767":91554,"_5":21387,"_28235":91315,"_5797":91555},[],"Treat a `501` on a route as authoritative: hide the action instead of retrying.",{"_6892":4742,"_42174":4640,"_29767":91557,"_5":21387,"_28235":91315,"_5797":91558},[],"Do not infer the backend from the URL. Both serve the same `/updates/v1` routes; see the API reference for which routes answer `501` in which backend.",{"_6892":4743,"_42174":4640,"_29767":91560,"_5":21387,"_28235":91315,"_5797":91561},[],"Re-read the capabilities after changing hawkBit's module types or the build configuration.",{"_6892":4744,"_42174":4640,"_29767":91563,"_5":21387,"_28235":91319,"_5797":87701},[],{"_6892":4745,"_42174":4640,"_29767":91565,"_5":21387,"_28235":91319,"_5797":85247},[],{"_6892":4746,"_42174":4746,"_5":21817,"_5797":91567,"_42654":91568,"_29767":91569,"_28235":4746},"Configuration reference",[77248,78697,85231,89621],[],{"_6892":4747,"_42174":4746,"_29767":91571,"_5":21387,"_28235":4746,"_5797":91572},[],"Every configuration key of Lamassu Updates, its default, which backend reads it, and how to override it with environment variables.",{"_6892":4748,"_42174":4746,"_5":42651,"_29767":91574,"_28235":91575,"_5797":91576},[],"/docs/pr-preview/pr-56/platform/updates/reference/configuration#how-the-configuration-is-loaded","How the configuration is loaded",{"_6892":4749,"_42174":4746,"_5":42651,"_29767":91578,"_28235":91579,"_5797":91580},[],"/docs/pr-preview/pr-56/platform/updates/reference/configuration#which-keys-each-mode-reads","Which keys each mode reads",{"_6892":4750,"_42174":4746,"_5":42651,"_29767":91582,"_28235":91583,"_5797":91584},[],"/docs/pr-preview/pr-56/platform/updates/reference/configuration#general-and-server-settings","General and server settings",{"_6892":4751,"_42174":4746,"_5":42651,"_29767":91586,"_28235":91587,"_5797":91588},[],"/docs/pr-preview/pr-56/platform/updates/reference/configuration#database","Database",{"_6892":4752,"_42174":4746,"_5":42651,"_29767":91590,"_28235":91591,"_5797":91592},[],"/docs/pr-preview/pr-56/platform/updates/reference/configuration#endpoints-of-other-services","Endpoints of other services",{"_6892":4753,"_42174":4746,"_5":42651,"_29767":91594,"_28235":91595,"_5797":91596},[],"/docs/pr-preview/pr-56/platform/updates/reference/configuration#build-and-signing","Build and signing",{"_6892":4754,"_42174":4746,"_5":42651,"_29767":91598,"_28235":91599,"_5797":91600},[],"/docs/pr-preview/pr-56/platform/updates/reference/configuration#upload-limits","Upload limits",{"_6892":4755,"_42174":4746,"_5":42651,"_29767":91602,"_28235":91603,"_5797":91604},[],"/docs/pr-preview/pr-56/platform/updates/reference/configuration#blob-storage-blocks","Blob storage blocks",{"_6892":4756,"_42174":4746,"_5":42651,"_29767":91606,"_28235":91607,"_5797":91608},[],"/docs/pr-preview/pr-56/platform/updates/reference/configuration#storage-storage","Storage (`*.storage`)",{"_6892":4757,"_42174":4746,"_5":42651,"_29767":91610,"_28235":91611,"_5797":91612},[],"/docs/pr-preview/pr-56/platform/updates/reference/configuration#at-rest-encryption-encryption","At-rest encryption (`*.encryption`)",{"_6892":4758,"_42174":4746,"_5":42651,"_29767":91614,"_28235":91615,"_5797":91616},[],"/docs/pr-preview/pr-56/platform/updates/reference/configuration#presigned-downloads-presign","Presigned downloads (`*.presign`)",{"_6892":4759,"_42174":4746,"_5":42651,"_29767":91618,"_28235":91619,"_5797":91620},[],"/docs/pr-preview/pr-56/platform/updates/reference/configuration#hawkbit-block","`hawkbit` block",{"_6892":4760,"_42174":4746,"_5":42651,"_29767":91622,"_28235":91623,"_5797":91624},[],"/docs/pr-preview/pr-56/platform/updates/reference/configuration#environment-variables","Environment variables",{"_6892":4761,"_42174":4746,"_5":42651,"_29767":91626,"_28235":91627,"_5797":91628},[],"/docs/pr-preview/pr-56/platform/updates/reference/configuration#minimal-configurations","Minimal configurations",{"_6892":4762,"_42174":4746,"_5":42651,"_29767":91630,"_28235":91631,"_5797":91632},[],"/docs/pr-preview/pr-56/platform/updates/reference/configuration#symkms-as-its-own-process","SymKMS as its own process",{"_6892":4763,"_42174":4746,"_5":42651,"_29767":91634,"_28235":91635,"_5797":91636},[],"/docs/pr-preview/pr-56/platform/updates/reference/configuration#related-pages","Related pages",{"_6892":4764,"_42174":4746,"_29767":91638,"_5":21387,"_28235":4746,"_5797":91639},[],"Lamassu Updates reads a single YAML file at start-up. This page lists every key the code reads, its default, and which backend (`native` or `hawkbit`) uses it. Keys that appear in the example files but are not read are listed separately so you do not rely on them.",{"_6892":4765,"_42174":4746,"_29767":91641,"_5":21387,"_28235":91575,"_5797":91642},[],"Set the file location with the `OTA_CONFIG_FILE` environment variable. If it is unset, the service reads `/etc/lamassuiot/config.yml`, which is where the Docker image and the Helm chart mount it.",{"_6892":4766,"_42174":4746,"_29767":91644,"_5":21387,"_28235":91575,"_5797":91645},[],"If `OTA_CONFIG_FILE` names a file that cannot be loaded (missing, or invalid YAML), the service logs a warning and &#x2A;*falls back to `/etc/lamassuiot/config.yml`**. In the Docker image that path holds the repository's developer `config.yml`, so a typo in the path can start the service with the wrong settings. If the fallback fails too, the service exits.",{"_6892":4767,"_42174":4746,"_29767":91647,"_5":21387,"_28235":91575,"_5797":91648},[],"The file is read once. Restart the service after any change.",{"_6892":4768,"_42174":4746,"_29767":91650,"_5":21387,"_28235":91575,"_5797":91651},[],"`LAMASSU_CONFIG_FILE`, which the Dockerfile and the Helm chart set, is not read by the code. Only `OTA_CONFIG_FILE` matters.",{"_6892":4769,"_42174":4746,"_29767":91653,"_5":21387,"_28235":91575,"_5797":91654},[],"Any key can be overridden by an environment variable. See Environment variables.",{"_6892":4770,"_42174":4746,"_29767":91656,"_5":21387,"_28235":91575,"_5797":91657},[],"The repository ships three examples:",{"_6892":4771,"_42174":4746,"_29767":91659,"_5":21387,"_28235":91575,"_5797":91660},[],"File",{"_6892":4772,"_42174":4746,"_29767":91662,"_5":21387,"_28235":91575,"_5797":91663},[],"For",{"_6892":4773,"_42174":4746,"_29767":91665,"_5":21387,"_28235":91575,"_5797":91666},[],"`config.yml`",{"_6892":4774,"_42174":4746,"_29767":91668,"_5":21387,"_28235":91575,"_5797":91669},[],"Local development in `native` mode",{"_6892":4775,"_42174":4746,"_29767":91671,"_5":21387,"_28235":91575,"_5797":91672},[],"`config-docker.yml`",{"_6892":4776,"_42174":4746,"_29767":91674,"_5":21387,"_28235":91575,"_5797":91675},[],"The `updates` container of `docker-compose.yml`",{"_6892":4777,"_42174":4746,"_29767":91677,"_5":21387,"_28235":91575,"_5797":91678},[],"`config-hawkbit.yml`",{"_6892":4778,"_42174":4746,"_29767":91680,"_5":21387,"_28235":91575,"_5797":91681},[],"Local development in `hawkbit` mode against the hawkBit of the compose file (host port 8090)",{"_6892":4779,"_42174":4746,"_29767":91683,"_5":21387,"_28235":91575,"_5797":91684},[],"The examples contain values for one developer machine (absolute paths and LAN addresses) and development secrets. Replace all of them, and never reuse their keys or passwords.",{"_6892":4780,"_42174":4746,"_29767":91686,"_5":21387,"_28235":91579,"_5797":85162},[],{"_6892":4781,"_42174":4746,"_29767":91688,"_5":21387,"_28235":91579,"_5797":89209},[],{"_6892":4782,"_42174":4746,"_29767":91690,"_5":21387,"_28235":91579,"_5797":86482},[],{"_6892":4783,"_42174":4746,"_29767":91692,"_5":21387,"_28235":91579,"_5797":91693},[],"`mode`, `app.*`, `storage.*`",{"_6892":4784,"_42174":4746,"_29767":91695,"_5":21387,"_28235":91579,"_5797":81396},[],{"_6892":4785,"_42174":4746,"_29767":91697,"_5":21387,"_28235":91579,"_5797":81396},[],{"_6892":4786,"_42174":4746,"_29767":91699,"_5":21387,"_28235":91579,"_5797":91700},[],"`dms_endpoint`",{"_6892":4787,"_42174":4746,"_29767":91702,"_5":21387,"_28235":91579,"_5797":91703},[],"Yes (required)",{"_6892":4788,"_42174":4746,"_29767":91705,"_5":21387,"_28235":91579,"_5797":91706},[],"Optional",{"_6892":4789,"_42174":4746,"_29767":91708,"_5":21387,"_28235":91579,"_5797":91709},[],"`kms_endpoint`, `sign_script_path`, `swugenerator_path`",{"_6892":4790,"_42174":4746,"_29767":91711,"_5":21387,"_28235":91579,"_5797":81396},[],{"_6892":4791,"_42174":4746,"_29767":91713,"_5":21387,"_28235":91579,"_5797":91714},[],"Yes, only to build or sign",{"_6892":4792,"_42174":4746,"_29767":91716,"_5":21387,"_28235":91579,"_5797":91717},[],"`symkms_endpoint`, `symkms`, `sym_keys_dir`",{"_6892":4793,"_42174":4746,"_29767":91719,"_5":21387,"_28235":91579,"_5797":81396},[],{"_6892":4794,"_42174":4746,"_29767":91721,"_5":21387,"_28235":91579,"_5797":91722},[],"Yes, only for encryption",{"_6892":4795,"_42174":4746,"_29767":91724,"_5":21387,"_28235":91579,"_5797":91725},[],"`max_artifact_size_mb`, `enable_test_endpoints`",{"_6892":4796,"_42174":4746,"_29767":91727,"_5":21387,"_28235":91579,"_5797":81396},[],{"_6892":4797,"_42174":4746,"_29767":91729,"_5":21387,"_28235":91579,"_5797":81396},[],{"_6892":4798,"_42174":4746,"_29767":91731,"_5":21387,"_28235":91579,"_5797":91732},[],"`wfx_endpoint`, `workflow_file`, `update_domain`",{"_6892":4799,"_42174":4746,"_29767":91734,"_5":21387,"_28235":91579,"_5797":81396},[],{"_6892":4800,"_42174":4746,"_29767":91736,"_5":21387,"_28235":91579,"_5797":81448},[],{"_6892":4801,"_42174":4746,"_29767":91738,"_5":21387,"_28235":91579,"_5797":91739},[],"`update_files_base_dir`, `artifacts`, `builds`",{"_6892":4802,"_42174":4746,"_29767":91741,"_5":21387,"_28235":91579,"_5797":81396},[],{"_6892":4803,"_42174":4746,"_29767":91743,"_5":21387,"_28235":91579,"_5797":81448},[],{"_6892":4804,"_42174":4746,"_29767":91745,"_5":21387,"_28235":91579,"_5797":91746},[],"`leader_election`",{"_6892":4805,"_42174":4746,"_29767":91748,"_5":21387,"_28235":91579,"_5797":81396},[],{"_6892":4806,"_42174":4746,"_29767":91750,"_5":21387,"_28235":91579,"_5797":81448},[],{"_6892":4807,"_42174":4746,"_29767":91752,"_5":21387,"_28235":91579,"_5797":86482},[],{"_6892":4808,"_42174":4746,"_29767":91754,"_5":21387,"_28235":91579,"_5797":81448},[],{"_6892":4809,"_42174":4746,"_29767":91756,"_5":21387,"_28235":91579,"_5797":91703},[],{"_6892":4810,"_42174":4746,"_29767":91758,"_5":21387,"_28235":91579,"_5797":91759},[],"`build_memory_limit_mb`",{"_6892":4811,"_42174":4746,"_29767":91761,"_5":21387,"_28235":91579,"_5797":81448},[],{"_6892":4812,"_42174":4746,"_29767":91763,"_5":21387,"_28235":91579,"_5797":81396},[],{"_6892":4813,"_42174":4746,"_29767":91765,"_5":21387,"_28235":91579,"_5797":91766},[],"`mode` is `native` when empty or when it holds any value other than `hawkbit`.",{"_6892":4814,"_42174":4746,"_29767":91768,"_5":21387,"_28235":91583,"_5797":85162},[],{"_6892":4815,"_42174":4746,"_29767":91770,"_5":21387,"_28235":91583,"_5797":81382},[],{"_6892":4816,"_42174":4746,"_29767":91772,"_5":21387,"_28235":91583,"_5797":77635},[],{"_6892":4817,"_42174":4746,"_29767":91774,"_5":21387,"_28235":91583,"_5797":81388},[],{"_6892":4818,"_42174":4746,"_29767":91776,"_5":21387,"_28235":91583,"_5797":91777},[],"`mode`",{"_6892":4819,"_42174":4746,"_29767":91779,"_5":21387,"_28235":91583,"_5797":34761},[],{"_6892":4820,"_42174":4746,"_29767":91781,"_5":21387,"_28235":91583,"_5797":91782},[],"empty (`native`)",{"_6892":4821,"_42174":4746,"_29767":91784,"_5":21387,"_28235":91583,"_5797":91785},[],"`native` or `hawkbit`. See hawkBit mode.",{"_6892":4822,"_42174":4746,"_29767":91787,"_5":21387,"_28235":91583,"_5797":91788},[],"`app.logs.level`",{"_6892":4823,"_42174":4746,"_29767":91790,"_5":21387,"_28235":91583,"_5797":34761},[],{"_6892":4824,"_42174":4746,"_29767":91792,"_5":21387,"_28235":91583,"_5797":91793},[],"`info`",{"_6892":4825,"_42174":4746,"_29767":91795,"_5":21387,"_28235":91583,"_5797":91796},[],"`trace`, `debug`, `info`, `warn`, `error`, `fatal` or `none` (case-insensitive). An unrecognised value becomes `info`. At `info` the start-up log prints a harmless \"unknown log level\" warning. `none` discards all log output.",{"_6892":4826,"_42174":4746,"_29767":91798,"_5":21387,"_28235":91583,"_5797":91799},[],"`app.server.listen_address`",{"_6892":4827,"_42174":4746,"_29767":91801,"_5":21387,"_28235":91583,"_5797":34761},[],{"_6892":4828,"_42174":4746,"_29767":91803,"_5":21387,"_28235":91583,"_5797":91804},[],"empty (all interfaces)",{"_6892":4829,"_42174":4746,"_29767":91806,"_5":21387,"_28235":91583,"_5797":91807},[],"Address to bind. The examples use `0.0.0.0`.",{"_6892":4830,"_42174":4746,"_29767":91809,"_5":21387,"_28235":91583,"_5797":91810},[],"`app.server.port`",{"_6892":4831,"_42174":4746,"_29767":91812,"_5":21387,"_28235":91583,"_5797":24012},[],{"_6892":4832,"_42174":4746,"_29767":91814,"_5":21387,"_28235":91583,"_5797":91815},[],"none (required)",{"_6892":4833,"_42174":4746,"_29767":91817,"_5":21387,"_28235":91583,"_5797":91818},[],"HTTP port. `0` picks a random port. The examples and the chart use `10090`.",{"_6892":4834,"_42174":4746,"_29767":91820,"_5":21387,"_28235":91583,"_5797":91821},[],"`app.server.shutdown_timeout`",{"_6892":4835,"_42174":4746,"_29767":91823,"_5":21387,"_28235":91583,"_5797":10155},[],{"_6892":4836,"_42174":4746,"_29767":91825,"_5":21387,"_28235":91583,"_5797":91826},[],"`60s`",{"_6892":4837,"_42174":4746,"_29767":91828,"_5":21387,"_28235":91583,"_5797":91829},[],"How long to wait for in-flight requests after `SIGTERM` or `SIGINT`. Keep it below the termination grace period of the pod (the chart sets 120 s).",{"_6892":4838,"_42174":4746,"_29767":91831,"_5":21387,"_28235":91583,"_5797":91832},[],"`enable_test_endpoints`",{"_6892":4839,"_42174":4746,"_29767":91834,"_5":21387,"_28235":91583,"_5797":28014},[],{"_6892":4840,"_42174":4746,"_29767":91836,"_5":21387,"_28235":91583,"_5797":91837},[],"`false`",{"_6892":4841,"_42174":4746,"_29767":91839,"_5":21387,"_28235":91583,"_5797":91840},[],"Registers `PUT /updates/v1/jobs/:jobID/transition`, which forges a job state change without ownership checks. Use only in tests; keep it `false` anywhere else.",{"_6892":4842,"_42174":4746,"_29767":91842,"_5":21387,"_28235":91583,"_5797":91843},[],"The service always serves plain HTTP. These keys exist in the configuration structs and in the example files but **are not read**, so setting them has no effect: `app.server.protocol`, `app.server.log_level`, `app.server.health_check` (and the `health_check_logging` of the examples), `app.server.cert_file`, `app.server.key_file` and `app.server.authentication.mutual_tls.*`. Terminate TLS in front of the service. See Security.",{"_6892":4843,"_42174":4746,"_29767":91845,"_5":21387,"_28235":91587,"_5797":85162},[],{"_6892":4844,"_42174":4746,"_29767":91847,"_5":21387,"_28235":91587,"_5797":81382},[],{"_6892":4845,"_42174":4746,"_29767":91849,"_5":21387,"_28235":91587,"_5797":77635},[],{"_6892":4846,"_42174":4746,"_29767":91851,"_5":21387,"_28235":91587,"_5797":81388},[],{"_6892":4847,"_42174":4746,"_29767":91853,"_5":21387,"_28235":91587,"_5797":91854},[],"`storage.provider`",{"_6892":4848,"_42174":4746,"_29767":91856,"_5":21387,"_28235":91587,"_5797":34761},[],{"_6892":4849,"_42174":4746,"_29767":91858,"_5":21387,"_28235":91587,"_5797":33635},[],{"_6892":4850,"_42174":4746,"_29767":91860,"_5":21387,"_28235":91587,"_5797":91861},[],"Only `postgres` exists. The value is not checked.",{"_6892":4851,"_42174":4746,"_29767":91863,"_5":21387,"_28235":91587,"_5797":91864},[],"`storage.hostname`",{"_6892":4852,"_42174":4746,"_29767":91866,"_5":21387,"_28235":91587,"_5797":34761},[],{"_6892":4853,"_42174":4746,"_29767":91868,"_5":21387,"_28235":91587,"_5797":91815},[],{"_6892":4854,"_42174":4746,"_29767":91870,"_5":21387,"_28235":91587,"_5797":91871},[],"Postgres host. In `hawkbit` mode startup fails if it is empty.",{"_6892":4855,"_42174":4746,"_29767":91873,"_5":21387,"_28235":91587,"_5797":91874},[],"`storage.port`",{"_6892":4856,"_42174":4746,"_29767":91876,"_5":21387,"_28235":91587,"_5797":24012},[],{"_6892":4857,"_42174":4746,"_29767":91878,"_5":21387,"_28235":91587,"_5797":91815},[],{"_6892":4858,"_42174":4746,"_29767":91880,"_5":21387,"_28235":91587,"_5797":91881},[],"Postgres port. There is no default.",{"_6892":4859,"_42174":4746,"_29767":91883,"_5":21387,"_28235":91587,"_5797":91884},[],"`storage.username`, `storage.password`",{"_6892":4860,"_42174":4746,"_29767":91886,"_5":21387,"_28235":91587,"_5797":34761},[],{"_6892":4861,"_42174":4746,"_29767":91888,"_5":21387,"_28235":91587,"_5797":33635},[],{"_6892":4862,"_42174":4746,"_29767":91890,"_5":21387,"_28235":91587,"_5797":91891},[],"Credentials.",{"_6892":4863,"_42174":4746,"_29767":91893,"_5":21387,"_28235":91587,"_5797":91894},[],"`storage.log_level`",{"_6892":4864,"_42174":4746,"_29767":91896,"_5":21387,"_28235":91587,"_5797":34761},[],{"_6892":4865,"_42174":4746,"_29767":91898,"_5":21387,"_28235":91587,"_5797":91793},[],{"_6892":4866,"_42174":4746,"_29767":91900,"_5":21387,"_28235":91587,"_5797":91901},[],"Log level of the database layer. SQL statements are logged at `trace`.",{"_6892":4867,"_42174":4746,"_29767":91903,"_5":21387,"_28235":91587,"_5797":91904},[],"The database name is fixed to &#x2A;*`updates`**. There is no key for it. The service creates its tables and migrates them at start-up, but it does not create the database: create `updates` first. In Docker Compose, `init.sql` creates `updates` and `hawkbit`, and `POSTGRES_DB` creates `wfx`.",{"_6892":4868,"_42174":4746,"_29767":91906,"_5":21387,"_28235":91587,"_5797":91907},[],"The connection uses `sslmode=disable`. There is no way to enable TLS towards Postgres from the configuration. Keep the database on a private network.",{"_6892":4869,"_42174":4746,"_29767":91909,"_5":21387,"_28235":91587,"_5797":91910},[],"Each process keeps at most 25 open and 10 idle connections (connections are recycled after 30 minutes, or 5 idle minutes). Budget `25 x replicas` against the `max_connections` of Postgres.",{"_6892":4870,"_42174":4746,"_29767":91912,"_5":21387,"_28235":91591,"_5797":85162},[],{"_6892":4871,"_42174":4746,"_29767":91914,"_5":21387,"_28235":91591,"_5797":77635},[],{"_6892":4872,"_42174":4746,"_29767":91916,"_5":21387,"_28235":91591,"_5797":91917},[],"Mode",{"_6892":4873,"_42174":4746,"_29767":91919,"_5":21387,"_28235":91591,"_5797":81388},[],{"_6892":4874,"_42174":4746,"_29767":91921,"_5":21387,"_28235":91591,"_5797":91700},[],{"_6892":4875,"_42174":4746,"_29767":91923,"_5":21387,"_28235":91591,"_5797":33635},[],{"_6892":4876,"_42174":4746,"_29767":91925,"_5":21387,"_28235":91591,"_5797":91926},[],"Required in `native`, optional in `hawkbit`",{"_6892":4877,"_42174":4746,"_29767":91928,"_5":21387,"_28235":91591,"_5797":91929},[],"Base URL of the Lamassu Device Manager API, for example `http://host:8080/api/devmanager`. It is the source of device groups. Without it in `hawkbit` mode, groups are read from the `group:<id>` tags of the hawkBit targets. The service sends `X-Principal-ID: admin-mode` on these calls.",{"_6892":4878,"_42174":4746,"_29767":91931,"_5":21387,"_28235":91591,"_5797":91932},[],"`kms_endpoint`",{"_6892":4879,"_42174":4746,"_29767":91934,"_5":21387,"_28235":91591,"_5797":33635},[],{"_6892":4880,"_42174":4746,"_29767":91936,"_5":21387,"_28235":91591,"_5797":85420},[],{"_6892":4881,"_42174":4746,"_29767":91938,"_5":21387,"_28235":91591,"_5797":91939},[],"Base URL of the Lamassu KMS API, for example `http://host:8080/api/kms/v1`. Needed to sign. See Signing and encryption.",{"_6892":4882,"_42174":4746,"_29767":91941,"_5":21387,"_28235":91591,"_5797":91942},[],"`symkms_endpoint`",{"_6892":4883,"_42174":4746,"_29767":91944,"_5":21387,"_28235":91591,"_5797":33635},[],{"_6892":4884,"_42174":4746,"_29767":91946,"_5":21387,"_28235":91591,"_5797":85420},[],{"_6892":4885,"_42174":4746,"_29767":91948,"_5":21387,"_28235":91591,"_5797":91949},[],"Base URL of SymKMS, **without** the `/symkms/v1` path. In the monolith it points at the service itself (for example `http://localhost:10090`) and must match `app.server.port`. Empty means encryption is refused.",{"_6892":4886,"_42174":4746,"_29767":91951,"_5":21387,"_28235":91591,"_5797":91952},[],"`wfx_endpoint`",{"_6892":4887,"_42174":4746,"_29767":91954,"_5":21387,"_28235":91591,"_5797":33635},[],{"_6892":4888,"_42174":4746,"_29767":91956,"_5":21387,"_28235":91591,"_5797":89209},[],{"_6892":4889,"_42174":4746,"_29767":91958,"_5":21387,"_28235":91591,"_5797":91959},[],"Base URL of the WFX **management** API (port `8081` inside the Compose network, `9081` on the host). The service appends `/api/wfx/v1/`. Startup fails if WFX cannot be reached. Devices use the WFX client port instead.",{"_6892":4890,"_42174":4746,"_29767":91961,"_5":21387,"_28235":91591,"_5797":91962},[],"`update_domain`",{"_6892":4891,"_42174":4746,"_29767":91964,"_5":21387,"_28235":91591,"_5797":33635},[],{"_6892":4892,"_42174":4746,"_29767":91966,"_5":21387,"_28235":91591,"_5797":89209},[],{"_6892":4893,"_42174":4746,"_29767":91968,"_5":21387,"_28235":91591,"_5797":91969},[],"Public base URL devices use to download builds, for example `http://updates:10090/updates/v1/`. It **must end in `/updates/v1/`, with the trailing slash**: the service appends `groups/...` directly and stores the result as the pack URI. It must be reachable from the devices.",{"_6892":4894,"_42174":4746,"_29767":91971,"_5":21387,"_28235":91595,"_5797":85162},[],{"_6892":4895,"_42174":4746,"_29767":91973,"_5":21387,"_28235":91595,"_5797":77635},[],{"_6892":4896,"_42174":4746,"_29767":91975,"_5":21387,"_28235":91595,"_5797":91917},[],{"_6892":4897,"_42174":4746,"_29767":91977,"_5":21387,"_28235":91595,"_5797":81388},[],{"_6892":4898,"_42174":4746,"_29767":91979,"_5":21387,"_28235":91595,"_5797":88538},[],{"_6892":4899,"_42174":4746,"_29767":91981,"_5":21387,"_28235":91595,"_5797":91982},[],"`swugenerator` on the `PATH` in `native`; unset in `hawkbit`",{"_6892":4900,"_42174":4746,"_29767":91984,"_5":21387,"_28235":91595,"_5797":85420},[],{"_6892":4901,"_42174":4746,"_29767":91986,"_5":21387,"_28235":91595,"_5797":91987},[],"Path to the `swugenerator` binary. In `hawkbit` mode the SWU builder exists only when this is set: without it, `swu-build` modules cannot be built (`501`). Raw-module builds do not need it.",{"_6892":4902,"_42174":4746,"_29767":91989,"_5":21387,"_28235":91595,"_5797":91990},[],"`sign_script_path`",{"_6892":4903,"_42174":4746,"_29767":91992,"_5":21387,"_28235":91595,"_5797":33635},[],{"_6892":4904,"_42174":4746,"_29767":91994,"_5":21387,"_28235":91595,"_5797":85420},[],{"_6892":4905,"_42174":4746,"_29767":91996,"_5":21387,"_28235":91595,"_5797":91997},[],"The signer script swugenerator calls for `.swu` signing, `sign_kms.sh` (`/app/sign_kms.sh` in the image). Signing a `.swu` needs this and `kms_endpoint`; the service refuses a signing request when either is missing.",{"_6892":4906,"_42174":4746,"_29767":91999,"_5":21387,"_28235":91595,"_5797":92000},[],"`workflow_file`",{"_6892":4907,"_42174":4746,"_29767":92002,"_5":21387,"_28235":91595,"_5797":92003},[],"`wfx.workflow.dau.direct.yml` (relative to the working directory)",{"_6892":4908,"_42174":4746,"_29767":92005,"_5":21387,"_28235":91595,"_5797":89209},[],{"_6892":4909,"_42174":4746,"_29767":92007,"_5":21387,"_28235":91595,"_5797":92008},[],"Path of the `direct` WFX workflow. The name &#x2A;*must contain `direct`**: the `phased`, `download-install` and `simple` files are found by replacing that word in the path, and startup fails otherwise. The service uploads the workflows missing in WFX at start-up.",{"_6892":4910,"_42174":4746,"_29767":92010,"_5":21387,"_28235":91595,"_5797":92011},[],"`update_files_base_dir`",{"_6892":4911,"_42174":4746,"_29767":92013,"_5":21387,"_28235":91595,"_5797":33635},[],{"_6892":4912,"_42174":4746,"_29767":92015,"_5":21387,"_28235":91595,"_5797":89209},[],{"_6892":4913,"_42174":4746,"_29767":92017,"_5":21387,"_28235":91595,"_5797":92018},[],"Base directory for build scratch (`in/`) and, until builds are published to the `builds` store, build outputs (`out/`). It also supplies the default `local_dir` of `artifacts` and `builds`.",{"_6892":4914,"_42174":4746,"_29767":92020,"_5":21387,"_28235":91595,"_5797":92021},[],"`sym_keys_dir`",{"_6892":4915,"_42174":4746,"_29767":92023,"_5":21387,"_28235":91595,"_5797":33635},[],{"_6892":4916,"_42174":4746,"_29767":92025,"_5":21387,"_28235":91595,"_5797":85420},[],{"_6892":4917,"_42174":4746,"_29767":92027,"_5":21387,"_28235":91595,"_5797":92028},[],"Fallback directory for SymKMS key storage when `symkms.storage.local_dir` is empty.",{"_6892":4918,"_42174":4746,"_29767":92030,"_5":21387,"_28235":91595,"_5797":91759},[],{"_6892":4919,"_42174":4746,"_29767":92032,"_5":21387,"_28235":91595,"_5797":92033},[],"`0` (no check)",{"_6892":4920,"_42174":4746,"_29767":92035,"_5":21387,"_28235":91595,"_5797":86482},[],{"_6892":4921,"_42174":4746,"_29767":92037,"_5":21387,"_28235":91595,"_5797":92038},[],"Refuses a build that would encrypt a file in memory (about twice its size) above this limit, in MiB, before the process is killed for lack of memory.",{"_6892":4922,"_42174":4746,"_29767":92040,"_5":21387,"_28235":91599,"_5797":85162},[],{"_6892":4923,"_42174":4746,"_29767":92042,"_5":21387,"_28235":91599,"_5797":81382},[],{"_6892":4924,"_42174":4746,"_29767":92044,"_5":21387,"_28235":91599,"_5797":77635},[],{"_6892":4925,"_42174":4746,"_29767":92046,"_5":21387,"_28235":91599,"_5797":81388},[],{"_6892":4926,"_42174":4746,"_29767":92048,"_5":21387,"_28235":91599,"_5797":92049},[],"`max_artifact_size_mb`",{"_6892":4927,"_42174":4746,"_29767":92051,"_5":21387,"_28235":91599,"_5797":24012},[],{"_6892":4928,"_42174":4746,"_29767":92053,"_5":21387,"_28235":91599,"_5797":92054},[],"`10240` (10 GiB)",{"_6892":4929,"_42174":4746,"_29767":92056,"_5":21387,"_28235":91599,"_5797":92057},[],"Largest single uploaded file in MiB: artifact or prebuilt `.swu`. A larger multipart file gets `413` with the message `file \"<name>\" is <n> MiB; the maximum upload size is <m> MiB`. The HTTP body limit is this value plus 1 MiB. Values of `0` or less mean the default.",{"_6892":4930,"_42174":4746,"_29767":92059,"_5":21387,"_28235":91599,"_5797":92060},[],"Uploads are streamed: memory does not grow with the file, but each in-flight upload is written to a temporary file under `TMPDIR` (default `/tmp`) first, so it needs that much free disk. Any proxy in front of the service must accept the same size and keep the connection open: read and write timeouts are 6 hours and idle connections are closed after 5 minutes. See Operations.",{"_6892":4931,"_42174":4746,"_29767":92062,"_5":21387,"_28235":91603,"_5797":92063},[],"Four blocks share one layout, so artifacts, build outputs and key material can each live on local disk or in S3:",{"_6892":4932,"_42174":4746,"_29767":92065,"_5":21387,"_28235":91603,"_5797":92066},[],"Block",{"_6892":4933,"_42174":4746,"_29767":92068,"_5":21387,"_28235":91603,"_5797":91917},[],{"_6892":4934,"_42174":4746,"_29767":92070,"_5":21387,"_28235":91603,"_5797":85935},[],{"_6892":4935,"_42174":4746,"_29767":92072,"_5":21387,"_28235":91603,"_5797":77635},[],{"_6892":4936,"_42174":4746,"_29767":92074,"_5":21387,"_28235":91603,"_5797":90508},[],{"_6892":4937,"_42174":4746,"_29767":92076,"_5":21387,"_28235":91603,"_5797":89209},[],{"_6892":4938,"_42174":4746,"_29767":92078,"_5":21387,"_28235":91603,"_5797":92079},[],"Uploaded artifact binaries",{"_6892":4939,"_42174":4746,"_29767":92081,"_5":21387,"_28235":91603,"_5797":92082},[],"Local, `{update_files_base_dir}/artifacts`",{"_6892":4940,"_42174":4746,"_29767":92084,"_5":21387,"_28235":91603,"_5797":92085},[],"`builds`",{"_6892":4941,"_42174":4746,"_29767":92087,"_5":21387,"_28235":91603,"_5797":89209},[],{"_6892":4942,"_42174":4746,"_29767":92089,"_5":21387,"_28235":91603,"_5797":92090},[],"Build outputs devices download: `.swu` and `.tar.gz`",{"_6892":4943,"_42174":4746,"_29767":92092,"_5":21387,"_28235":91603,"_5797":92093},[],"Local, `{update_files_base_dir}/out`",{"_6892":4944,"_42174":4746,"_29767":92095,"_5":21387,"_28235":91603,"_5797":92096},[],"`symkms`",{"_6892":4945,"_42174":4746,"_29767":92098,"_5":21387,"_28235":91603,"_5797":85420},[],{"_6892":4946,"_42174":4746,"_29767":92100,"_5":21387,"_28235":91603,"_5797":92101},[],"Symmetric keys and device-key assignments",{"_6892":4947,"_42174":4746,"_29767":92103,"_5":21387,"_28235":91603,"_5797":92104},[],"Local, `sym_keys_dir`, or `data` relative to the working directory if both are empty",{"_6892":4948,"_42174":4746,"_29767":92106,"_5":21387,"_28235":91603,"_5797":85402},[],{"_6892":4949,"_42174":4746,"_29767":92108,"_5":21387,"_28235":91603,"_5797":86482},[],{"_6892":4950,"_42174":4746,"_29767":92110,"_5":21387,"_28235":91603,"_5797":92111},[],"Read only, to sign download URLs of hawkBit's S3 bucket (see `hawkbit` block)",{"_6892":4951,"_42174":4746,"_29767":92113,"_5":21387,"_28235":91603,"_5797":81871},[],{"_6892":4952,"_42174":4746,"_29767":92115,"_5":21387,"_28235":91607,"_5797":85162},[],{"_6892":4953,"_42174":4746,"_29767":92117,"_5":21387,"_28235":91607,"_5797":77635},[],{"_6892":4954,"_42174":4746,"_29767":92119,"_5":21387,"_28235":91607,"_5797":81388},[],{"_6892":4955,"_42174":4746,"_29767":92121,"_5":21387,"_28235":91607,"_5797":86664},[],{"_6892":4956,"_42174":4746,"_29767":92123,"_5":21387,"_28235":91607,"_5797":92124},[],"`local`",{"_6892":4957,"_42174":4746,"_29767":92126,"_5":21387,"_28235":91607,"_5797":92127},[],"`local` or `s3`.",{"_6892":4958,"_42174":4746,"_29767":92129,"_5":21387,"_28235":91607,"_5797":92130},[],"`local_dir`",{"_6892":4959,"_42174":4746,"_29767":92132,"_5":21387,"_28235":91607,"_5797":92133},[],"block default above",{"_6892":4960,"_42174":4746,"_29767":92135,"_5":21387,"_28235":91607,"_5797":92136},[],"Directory for `local`. Created with mode `0700`.",{"_6892":4961,"_42174":4746,"_29767":92138,"_5":21387,"_28235":91607,"_5797":92139},[],"`s3_bucket`",{"_6892":4962,"_42174":4746,"_29767":92141,"_5":21387,"_28235":91607,"_5797":33635},[],{"_6892":4963,"_42174":4746,"_29767":92143,"_5":21387,"_28235":91607,"_5797":92144},[],"Required for `s3`. The bucket must exist: the service checks access at start-up and stops if it fails (`S3 bucket \"x\" is not accessible at ...`).",{"_6892":4964,"_42174":4746,"_29767":92146,"_5":21387,"_28235":91607,"_5797":92147},[],"`s3_region`",{"_6892":4965,"_42174":4746,"_29767":92149,"_5":21387,"_28235":91607,"_5797":92150},[],"`us-east-1`",{"_6892":4966,"_42174":4746,"_29767":92152,"_5":21387,"_28235":91607,"_5797":92153},[],"AWS region.",{"_6892":4967,"_42174":4746,"_29767":92155,"_5":21387,"_28235":91607,"_5797":92156},[],"`s3_endpoint`",{"_6892":4968,"_42174":4746,"_29767":92158,"_5":21387,"_28235":91607,"_5797":92159},[],"empty (AWS)",{"_6892":4969,"_42174":4746,"_29767":92161,"_5":21387,"_28235":91607,"_5797":92162},[],"URL of an S3-compatible store such as RustFS or MinIO.",{"_6892":4970,"_42174":4746,"_29767":92164,"_5":21387,"_28235":91607,"_5797":92165},[],"`s3_path_style`",{"_6892":4971,"_42174":4746,"_29767":92167,"_5":21387,"_28235":91607,"_5797":91837},[],{"_6892":4972,"_42174":4746,"_29767":92169,"_5":21387,"_28235":91607,"_5797":92170},[],"Address buckets as `<endpoint>/<bucket>`. Most self-hosted stores need `true`.",{"_6892":4973,"_42174":4746,"_29767":92172,"_5":21387,"_28235":91607,"_5797":92173},[],"`s3_prefix`",{"_6892":4974,"_42174":4746,"_29767":92175,"_5":21387,"_28235":91607,"_5797":27273},[],{"_6892":4975,"_42174":4746,"_29767":92177,"_5":21387,"_28235":91607,"_5797":92178},[],"Keeps every key under a \"folder\" of the bucket. One bucket can hold several stores, hawkBit's artifacts included. A missing trailing `/` is added.",{"_6892":4976,"_42174":4746,"_29767":92180,"_5":21387,"_28235":91607,"_5797":92181},[],"`s3_access_key_id`, `s3_secret_access_key`",{"_6892":4977,"_42174":4746,"_29767":92183,"_5":21387,"_28235":91607,"_5797":33635},[],{"_6892":4978,"_42174":4746,"_29767":92185,"_5":21387,"_28235":91607,"_5797":92186},[],"Static credentials. Set both or neither.",{"_6892":4979,"_42174":4746,"_29767":92188,"_5":21387,"_28235":91607,"_5797":92189},[],"`s3_access_key_id_file`, `s3_secret_access_key_file`",{"_6892":4980,"_42174":4746,"_29767":92191,"_5":21387,"_28235":91607,"_5797":33635},[],{"_6892":4981,"_42174":4746,"_29767":92193,"_5":21387,"_28235":91607,"_5797":92194},[],"The same credentials read from files, for example a mounted Kubernetes Secret. Re-read every minute, so a rotated Secret needs no restart. Set both or neither, and not together with the inline pair.",{"_6892":4982,"_42174":4746,"_29767":92196,"_5":21387,"_28235":91607,"_5797":92197},[],"With no credential set, the AWS default chain applies (environment, IRSA, instance profile).",{"_6892":4983,"_42174":4746,"_29767":92199,"_5":21387,"_28235":91611,"_5797":85162},[],{"_6892":4984,"_42174":4746,"_29767":92201,"_5":21387,"_28235":91611,"_5797":77635},[],{"_6892":4985,"_42174":4746,"_29767":92203,"_5":21387,"_28235":91611,"_5797":81388},[],{"_6892":4986,"_42174":4746,"_29767":92205,"_5":21387,"_28235":91611,"_5797":86664},[],{"_6892":4987,"_42174":4746,"_29767":92207,"_5":21387,"_28235":91611,"_5797":92208},[],"`none`",{"_6892":4988,"_42174":4746,"_29767":92210,"_5":21387,"_28235":91611,"_5797":92211},[],"`none`, `local` or `awskms`.",{"_6892":4989,"_42174":4746,"_29767":92213,"_5":21387,"_28235":91611,"_5797":92214},[],"`local_key`",{"_6892":4990,"_42174":4746,"_29767":92216,"_5":21387,"_28235":91611,"_5797":33635},[],{"_6892":4991,"_42174":4746,"_29767":92218,"_5":21387,"_28235":91611,"_5797":92219},[],"Required for `local`: a hex-encoded 32-byte key.",{"_6892":4992,"_42174":4746,"_29767":92221,"_5":21387,"_28235":91611,"_5797":92222},[],"`awskms_key_id`",{"_6892":4993,"_42174":4746,"_29767":92224,"_5":21387,"_28235":91611,"_5797":33635},[],{"_6892":4994,"_42174":4746,"_29767":92226,"_5":21387,"_28235":91611,"_5797":92227},[],"Required for `awskms`: key ARN or alias.",{"_6892":4995,"_42174":4746,"_29767":92229,"_5":21387,"_28235":91611,"_5797":92230},[],"`awskms_region`",{"_6892":4996,"_42174":4746,"_29767":92232,"_5":21387,"_28235":91611,"_5797":92150},[],{"_6892":4997,"_42174":4746,"_29767":92234,"_5":21387,"_28235":91611,"_5797":92235},[],"Region of the AWS KMS key.",{"_6892":4998,"_42174":4746,"_29767":92237,"_5":21387,"_28235":91611,"_5797":92238},[],"An encrypted object is encrypted and decrypted whole, in memory: with at-rest encryption, reading or writing a 10 GiB artifact needs that much memory, and byte ranges are cut from the decrypted copy. A store with encryption enabled cannot use presigned downloads. For large files, prefer encrypting at the store (for example S3 server-side encryption) instead.",{"_6892":4999,"_42174":4746,"_29767":92240,"_5":21387,"_28235":91615,"_5797":92241},[],"With S3 storage, a download can be answered with `302` to a short-lived signed URL of the store instead of streaming the bytes through the service. The caller is authorized first, as for any download. Native mode signs build outputs (`builds.presign`); `hawkbit` mode signs the objects of hawkBit's S3 plugin (`hawkbit.artifact_store.presign`). Artifact downloads by ID in `native` mode are always streamed.",{"_6892":5000,"_42174":4746,"_29767":92243,"_5":21387,"_28235":91615,"_5797":85162},[],{"_6892":5001,"_42174":4746,"_29767":92245,"_5":21387,"_28235":91615,"_5797":77635},[],{"_6892":5002,"_42174":4746,"_29767":92247,"_5":21387,"_28235":91615,"_5797":81388},[],{"_6892":5003,"_42174":4746,"_29767":92249,"_5":21387,"_28235":91615,"_5797":92250},[],"`enabled`",{"_6892":5004,"_42174":4746,"_29767":92252,"_5":21387,"_28235":91615,"_5797":91837},[],{"_6892":5005,"_42174":4746,"_29767":92254,"_5":21387,"_28235":91615,"_5797":92255},[],"Turns the feature on.",{"_6892":5006,"_42174":4746,"_29767":92257,"_5":21387,"_28235":91615,"_5797":92258},[],"`public_endpoint`",{"_6892":5007,"_42174":4746,"_29767":92260,"_5":21387,"_28235":91615,"_5797":92261},[],"the storage `s3_endpoint`",{"_6892":5008,"_42174":4746,"_29767":92263,"_5":21387,"_28235":91615,"_5797":92264},[],"Origin of the store **as devices reach it**, without a path (for example the gateway that publishes the bucket). It is what gets signed: the signature covers the `Host` header, so a URL signed for an in-cluster address is refused when a device fetches it through the gateway. Required unless devices reach the store at its own endpoint (for example AWS S3).",{"_6892":5009,"_42174":4746,"_29767":92266,"_5":21387,"_28235":91615,"_5797":92267},[],"`ttl`",{"_6892":5010,"_42174":4746,"_29767":92269,"_5":21387,"_28235":91615,"_5797":91826},[],{"_6892":5011,"_42174":4746,"_29767":92271,"_5":21387,"_28235":91615,"_5797":92272},[],"How long a URL can **start** a download. Between `1s` and 7 days. A transfer already under way is not cut when it expires.",{"_6892":5012,"_42174":4746,"_29767":92274,"_5":21387,"_28235":91615,"_5797":92275},[],"`min_remaining`",{"_6892":5013,"_42174":4746,"_29767":92277,"_5":21387,"_28235":91615,"_5797":92278},[],"`min(25s, ttl/2)`",{"_6892":5014,"_42174":4746,"_29767":92280,"_5":21387,"_28235":91615,"_5797":92281},[],"A URL already signed for the same object is handed out again while it has at least this much validity left, so a retry or resume never gets a URL about to expire. Negative signs a fresh URL on every request. Must be lower than `ttl`.",{"_6892":5015,"_42174":4746,"_29767":92283,"_5":21387,"_28235":91615,"_5797":92284},[],"`access_key_id`, `secret_access_key` (or the `_file` variants)",{"_6892":5016,"_42174":4746,"_29767":92286,"_5":21387,"_28235":91615,"_5797":33635},[],{"_6892":5017,"_42174":4746,"_29767":92288,"_5":21387,"_28235":91615,"_5797":92289},[],"The credential that signs. &#x2A;*Required, and it must be a read-only credential different from the storage one.**",{"_6892":5018,"_42174":4746,"_29767":92291,"_5":21387,"_28235":91615,"_5797":92292},[],"At start-up the service refuses to run when the signing credential is the storage credential, when it can write to the bucket (it probes with a write), when the store rejects it (it waits up to 2 minutes for the store to accept it), or when `encryption.type` is not `none` (devices would receive ciphertext). If the store cannot be asked at all, it logs a warning and continues. The device must still be able to resolve and reach `public_endpoint`. See Security.",{"_6892":5019,"_42174":4746,"_29767":92294,"_5":21387,"_28235":91619,"_5797":92295},[],"Used only when `mode: hawkbit`.",{"_6892":5020,"_42174":4746,"_29767":92297,"_5":21387,"_28235":91619,"_5797":85162},[],{"_6892":5021,"_42174":4746,"_29767":92299,"_5":21387,"_28235":91619,"_5797":77635},[],{"_6892":5022,"_42174":4746,"_29767":92301,"_5":21387,"_28235":91619,"_5797":81388},[],{"_6892":5023,"_42174":4746,"_29767":92303,"_5":21387,"_28235":91619,"_5797":92304},[],"`hawkbit.base_url`",{"_6892":5024,"_42174":4746,"_29767":92306,"_5":21387,"_28235":91619,"_5797":91815},[],{"_6892":5025,"_42174":4746,"_29767":92308,"_5":21387,"_28235":91619,"_5797":92309},[],"hawkBit Management API root, for example `http://hawkbit:8080`. Startup fails if it is empty. Calls time out after 30 s; artifact transfers after 6 h.",{"_6892":5026,"_42174":4746,"_29767":92311,"_5":21387,"_28235":91619,"_5797":92312},[],"`hawkbit.username`, `hawkbit.password`",{"_6892":5027,"_42174":4746,"_29767":92314,"_5":21387,"_28235":91619,"_5797":33635},[],{"_6892":5028,"_42174":4746,"_29767":92316,"_5":21387,"_28235":91619,"_5797":92317},[],"Management API Basic Auth credentials.",{"_6892":5029,"_42174":4746,"_29767":92319,"_5":21387,"_28235":91619,"_5797":92320},[],"`hawkbit.tenant`",{"_6892":5030,"_42174":4746,"_29767":92322,"_5":21387,"_28235":91619,"_5797":92323},[],"`DEFAULT`",{"_6892":5031,"_42174":4746,"_29767":92325,"_5":21387,"_28235":91619,"_5797":92326},[],"DDI tenant path segment.",{"_6892":5032,"_42174":4746,"_29767":92328,"_5":21387,"_28235":91619,"_5797":92329},[],"`hawkbit.ddi_url`",{"_6892":5033,"_42174":4746,"_29767":92331,"_5":21387,"_28235":91619,"_5797":92304},[],{"_6892":5034,"_42174":4746,"_29767":92333,"_5":21387,"_28235":91619,"_5797":92334},[],"hawkBit's DDI root **as devices reach it** (for example `https://updates.example.com/api/hawkbit-ddi`). It is used to build the download URLs devices receive, and its path becomes the prefix of the DDI download route this service serves.",{"_6892":5035,"_42174":4746,"_29767":92336,"_5":21387,"_28235":91619,"_5797":85402},[],{"_6892":5036,"_42174":4746,"_29767":92338,"_5":21387,"_28235":91619,"_5797":33635},[],{"_6892":5037,"_42174":4746,"_29767":92340,"_5":21387,"_28235":91619,"_5797":92341},[],"Same shape as the blob storage blocks: `storage` must point to the bucket and `s3_prefix` of hawkBit's S3 artifact plugin, and `presign` enables signed downloads. Without it, artifacts are streamed through hawkBit.",{"_6892":5038,"_42174":4746,"_29767":92343,"_5":21387,"_28235":91619,"_5797":92344},[],"The `storage` (Postgres) block is also required in `hawkbit` mode.",{"_6892":5039,"_42174":4746,"_29767":92346,"_5":21387,"_28235":91623,"_5797":92347},[],"Any key of the file can be overridden by an environment variable: the name is the key path in upper case with dots replaced by underscores. `KMS_ENDPOINT` overrides `kms_endpoint`, `STORAGE_PASSWORD` overrides `storage.password` and `BUILDS_PRESIGN_TTL` overrides `builds.presign.ttl`. The key must exist in the file (an empty value is enough): the loader only considers keys it has read from it.",{"_6892":5040,"_42174":4746,"_29767":92349,"_5":21387,"_28235":91623,"_5797":92350},[],"Variables the code reads besides these overrides:",{"_6892":5041,"_42174":4746,"_29767":92352,"_5":21387,"_28235":91623,"_5797":92353},[],"Variable",{"_6892":5042,"_42174":4746,"_29767":92355,"_5":21387,"_28235":91623,"_5797":81388},[],{"_6892":5043,"_42174":4746,"_29767":92357,"_5":21387,"_28235":91623,"_5797":92358},[],"`OTA_CONFIG_FILE`",{"_6892":5044,"_42174":4746,"_29767":92360,"_5":21387,"_28235":91623,"_5797":92361},[],"Configuration file path.",{"_6892":5045,"_42174":4746,"_29767":92363,"_5":21387,"_28235":91623,"_5797":92364},[],"`POD_NAME`, `POD_NAMESPACE`",{"_6892":5046,"_42174":4746,"_29767":92366,"_5":21387,"_28235":91623,"_5797":92367},[],"Identity and namespace for Kubernetes leader election. The Helm chart sets them. If unset, the hostname and the service-account namespace file are used.",{"_6892":5047,"_42174":4746,"_29767":92369,"_5":21387,"_28235":91623,"_5797":92370},[],"`TMPDIR`",{"_6892":5048,"_42174":4746,"_29767":92372,"_5":21387,"_28235":91623,"_5797":92373},[],"Where uploads and builds write temporary files (Go's temporary directory).",{"_6892":5049,"_42174":4746,"_29767":92375,"_5":21387,"_28235":91623,"_5797":92376},[],"`SERVER_PORT`",{"_6892":5050,"_42174":4746,"_29767":92378,"_5":21387,"_28235":91623,"_5797":92379},[],"Used only by the health check of the Docker image to find the port. Default `10090`.",{"_6892":5051,"_42174":4746,"_29767":92381,"_5":21387,"_28235":91623,"_5797":92382},[],"`AWS_*`",{"_6892":5052,"_42174":4746,"_29767":92384,"_5":21387,"_28235":91623,"_5797":92385},[],"The AWS default credential chain, when an S3 or AWS KMS block has no explicit credential.",{"_6892":5053,"_42174":4746,"_29767":92387,"_5":21387,"_28235":91623,"_5797":92388},[],"For Docker Compose, the `.env` file is read by `docker-compose.yml`, not by the service: `HOST_IP`, `HAWKBIT_ADMIN_PASSWORD`, `HAWKBIT_ARTIFACT_STORAGE` and the `HAWKBIT_ARTIFACT_S3_*` and `LOCAL_S3_*` variables. See `.env.example` in the repository.",{"_6892":5054,"_42174":4746,"_29767":92390,"_5":21387,"_28235":91623,"_5797":92391},[],"With `app.logs.level: debug`, the service writes the whole loaded configuration to the log at start-up, including `storage.password`, `encryption.local_key`, S3 keys and `hawkbit.password`. In `native` mode the `storage` block, password included, is also printed to standard output at every start, whatever the log level. Use `info` or higher anywhere logs are stored or shared, and keep secrets in a secret store, not in the file (see the `*_file` credentials above).",{"_6892":5055,"_42174":4746,"_29767":92393,"_5":21387,"_28235":91627,"_5797":92394},[],"`native` mode needs the database, the endpoints it calls and storage paths. Start from `config-docker.yml`:",{"_6892":5056,"_42174":4746,"_29767":92396,"_5":21387,"_28235":91627,"_5797":92397},[],"`hawkbit` mode needs `mode: hawkbit`, `hawkbit.base_url`, the Management API credentials and the `storage` block. Add the build settings only if you want builds. The keys below are the ones `config-hawkbit.yml` uses:",{"_6892":5057,"_42174":4746,"_29767":92399,"_5":21387,"_28235":91627,"_5797":92400},[],"In `hawkbit` mode the SymKMS routes are registered only when `symkms.storage.type` or `sym_keys_dir` is set. With `symkms_endpoint` set but neither of those, every key lookup would be answered `404` by the service itself.",{"_6892":5058,"_42174":4746,"_29767":92402,"_5":21387,"_28235":91631,"_5797":92403},[],"The `cmd/symkms` binary runs SymKMS alone. Its configuration has only `app` (as above), `symkms` (a storage block) and `sym_keys_dir`. Its key directory defaults to `/data/symmetric_keys` when neither `symkms.storage.local_dir` nor `sym_keys_dir` is set. It serves `/symkms/v1/*` but no `/health` route, and it has the same lack of authentication as the monolith: see Security.",{"_6892":5059,"_42174":4746,"_29767":92405,"_5":21387,"_28235":91635,"_5797":92406},[],"Operations for the Helm values, scaling and backups.",{"_6892":5060,"_42174":4746,"_29767":92408,"_5":21387,"_28235":91635,"_5797":92409},[],"hawkBit mode for what changes in that backend.",{"_6892":5061,"_42174":4746,"_29767":92411,"_5":21387,"_28235":91635,"_5797":92412},[],"Signing and encryption for the keys behind `kms_endpoint` and `symkms`.",{"_6892":5062,"_42174":4746,"_29767":92414,"_5":21387,"_28235":91635,"_5797":92415},[],"Troubleshooting for start-up errors.",{"_6892":5063,"_42174":5063,"_5":21817,"_5797":87306,"_42654":92417,"_29767":92418,"_28235":5063},[77248,78697,85231,88818],[],{"_6892":5064,"_42174":5063,"_29767":92420,"_5":21387,"_28235":5063,"_5797":92421},[],"What Lamassu Updates does and does not protect, and what to put around it before exposing it.",{"_6892":5065,"_42174":5063,"_5":42651,"_29767":92423,"_28235":92424,"_5797":92425},[],"/docs/pr-preview/pr-56/platform/updates/security#summary","Summary",{"_6892":5066,"_42174":5063,"_5":42651,"_29767":92427,"_28235":92428,"_5797":92429},[],"/docs/pr-preview/pr-56/platform/updates/security#what-to-put-in-front-of-it","What to put in front of it",{"_6892":5067,"_42174":5063,"_5":42651,"_29767":92431,"_28235":92432,"_5797":92433},[],"/docs/pr-preview/pr-56/platform/updates/security#how-the-service-identifies-itself-to-others","How the service identifies itself to others",{"_6892":5068,"_42174":5063,"_5":42651,"_29767":92435,"_28235":92436,"_5797":92437},[],"/docs/pr-preview/pr-56/platform/updates/security#routes-to-restrict","Routes to restrict",{"_6892":5069,"_42174":5063,"_5":42651,"_29767":92439,"_28235":92440,"_5797":92441},[],"/docs/pr-preview/pr-56/platform/updates/security#what-the-service-checks","What the service checks",{"_6892":5070,"_42174":5063,"_5":42651,"_29767":92443,"_28235":92444,"_5797":92445},[],"/docs/pr-preview/pr-56/platform/updates/security#presigned-download-urls","Presigned download URLs",{"_6892":5071,"_42174":5063,"_5":42651,"_29767":92447,"_28235":92448,"_5797":92449},[],"/docs/pr-preview/pr-56/platform/updates/security#outbound-connections","Outbound connections",{"_6892":5072,"_42174":5063,"_5":42651,"_29767":92451,"_28235":92452,"_5797":92453},[],"/docs/pr-preview/pr-56/platform/updates/security#secrets","Secrets",{"_6892":5073,"_42174":5063,"_5":42651,"_29767":92455,"_28235":92456,"_5797":85247},[],"/docs/pr-preview/pr-56/platform/updates/security#hawkbit-mode",{"_6892":5074,"_42174":5063,"_5":42651,"_29767":92458,"_28235":92459,"_5797":92460},[],"/docs/pr-preview/pr-56/platform/updates/security#request-limits","Request limits",{"_6892":5075,"_42174":5063,"_29767":92462,"_5":21387,"_28235":5063,"_5797":92463},[],"Lamassu Updates delegates authentication, authorization and TLS to the platform gateway in front of it. This page lists what the service itself enforces, what it does not, and what to configure around it. Read it before exposing the service beyond a trusted network.",{"_6892":5076,"_42174":5063,"_29767":92465,"_5":21387,"_28235":92424,"_5797":78330},[],{"_6892":5077,"_42174":5063,"_29767":92467,"_5":21387,"_28235":92424,"_5797":89222},[],{"_6892":5078,"_42174":5063,"_29767":92469,"_5":21387,"_28235":92424,"_5797":92470},[],"Authentication of API callers",{"_6892":5079,"_42174":5063,"_29767":92472,"_5":21387,"_28235":92424,"_5797":92473},[],"**None in the service.** Every route is open to anyone who can reach the port. The gateway must authenticate.",{"_6892":5080,"_42174":5063,"_29767":92475,"_5":21387,"_28235":92424,"_5797":83401},[],{"_6892":5081,"_42174":5063,"_29767":92477,"_5":21387,"_28235":92424,"_5797":92478},[],"**No roles or per-group permissions.** The service only does structural checks (see What the service checks). The gateway must authorize.",{"_6892":5082,"_42174":5063,"_29767":92480,"_5":21387,"_28235":92424,"_5797":92481},[],"TLS and mTLS (inbound)",{"_6892":5083,"_42174":5063,"_29767":92483,"_5":21387,"_28235":92424,"_5797":92484},[],"**Not implemented.** The service always serves plain HTTP.",{"_6892":5084,"_42174":5063,"_29767":92486,"_5":21387,"_28235":92424,"_5797":92487},[],"TLS to other systems",{"_6892":5085,"_42174":5063,"_29767":92489,"_5":21387,"_28235":92424,"_5797":92490},[],"Postgres: always `sslmode=disable`. KMS: not verified in `native` mode, and the SWU signer script uses `curl -k`. See Outbound connections.",{"_6892":5086,"_42174":5063,"_29767":92492,"_5":21387,"_28235":92424,"_5797":89779},[],{"_6892":5087,"_42174":5063,"_29767":92494,"_5":21387,"_28235":92424,"_5797":92495},[],"Any origin and any header are allowed.",{"_6892":5088,"_42174":5063,"_29767":92497,"_5":21387,"_28235":92424,"_5797":92498},[],"Rate limiting, security headers",{"_6892":5089,"_42174":5063,"_29767":92500,"_5":21387,"_28235":92424,"_5797":92501},[],"None added by the service.",{"_6892":5090,"_42174":5063,"_29767":92503,"_5":21387,"_28235":92424,"_5797":92504},[],"Package signing",{"_6892":5091,"_42174":5063,"_29767":92506,"_5":21387,"_28235":92424,"_5797":92507},[],"Available, through the Lamassu KMS. See Signing and encryption.",{"_6892":5092,"_42174":5063,"_29767":92509,"_5":21387,"_28235":92424,"_5797":92510},[],"Package encryption",{"_6892":5093,"_42174":5063,"_29767":92512,"_5":21387,"_28235":92424,"_5797":92513},[],"Available: shared key or per-device key.",{"_6892":5094,"_42174":5063,"_29767":92515,"_5":21387,"_28235":92424,"_5797":92516},[],"At-rest encryption",{"_6892":5095,"_42174":5063,"_29767":92518,"_5":21387,"_28235":92424,"_5797":92519},[],"Available for artifacts, builds and keys, through the `encryption` block of each storage block.",{"_6892":5096,"_42174":5063,"_29767":92521,"_5":21387,"_28235":92424,"_5797":92522},[],"The `cert_file`, `key_file` and `authentication.mutual_tls.*` keys exist in the configuration structs but are not read, so setting them does nothing.",{"_6892":5097,"_42174":5063,"_29767":92524,"_5":21387,"_28235":92428,"_5797":92525},[],"Run the service behind a gateway or reverse proxy that:",{"_6892":5098,"_42174":5063,"_29767":92527,"_5":21387,"_28235":92428,"_5797":92528},[],"**Terminates TLS** between clients and the service.",{"_6892":5099,"_42174":5063,"_29767":92530,"_5":21387,"_28235":92428,"_5797":92531},[],"**Authenticates and authorizes** callers: operators for the API, and devices for the download routes. A device must only reach its own download paths, so match the device certificate to the `:deviceID` (or `:controllerId`) in the path.",{"_6892":5100,"_42174":5063,"_29767":92533,"_5":21387,"_28235":92428,"_5797":92534},[],"**Restricts the dangerous routes** to the callers that need them (see below).",{"_6892":5101,"_42174":5063,"_29767":92536,"_5":21387,"_28235":92428,"_5797":92537},[],"Keep the service on a private network. Devices need to reach only the download routes and, in `native` mode, the WFX **client** listener. In `hawkbit` mode they talk to hawkBit (and to the signed-URL store) and not to this service, except for the artifact download route described in hawkBit mode.",{"_6892":5102,"_42174":5063,"_29767":92539,"_5":21387,"_28235":92428,"_5797":92540},[],"WFX has a client listener (`8080` in Compose, published as `9080`) and a management listener (`8081`, published as `9081`). Lamassu Updates authenticates neither. Devices need the client listener only: do not expose the management port to devices or untrusted networks.",{"_6892":5103,"_42174":5063,"_29767":92542,"_5":21387,"_28235":92432,"_5797":92543},[],"The service does not forward the caller's identity. Calls to the Lamassu Device Manager and the KMS carry the fixed header `X-Principal-ID: admin-mode`, which the platform's authorization layer accepts for internal callers and which the platform gateway strips from external traffic. The value is not configurable, so point `dms_endpoint` and `kms_endpoint` at internal service addresses, not at a public gateway path that would reject or forward it. SymKMS calls from the service carry no credential.",{"_6892":5104,"_42174":5063,"_29767":92545,"_5":21387,"_28235":92436,"_5797":86919},[],{"_6892":5105,"_42174":5063,"_29767":92547,"_5":21387,"_28235":92436,"_5797":89344},[],{"_6892":5106,"_42174":5063,"_29767":92549,"_5":21387,"_28235":92436,"_5797":92550},[],"`GET /symkms/v1/:keyID/raw`",{"_6892":5107,"_42174":5063,"_29767":92552,"_5":21387,"_28235":92436,"_5797":92553},[],"Returns raw key material.",{"_6892":5108,"_42174":5063,"_29767":92555,"_5":21387,"_28235":92436,"_5797":92556},[],"`GET /symkms/v1/inventory/:deviceID/key`",{"_6892":5109,"_42174":5063,"_29767":92558,"_5":21387,"_28235":92436,"_5797":92559},[],"Returns a device's raw key material. The Updates service uses it during a per-device build.",{"_6892":5110,"_42174":5063,"_29767":92561,"_5":21387,"_28235":92436,"_5797":92562},[],"`POST /symkms/v1/`, `DELETE /symkms/v1/:keyID`, key assignment routes",{"_6892":5111,"_42174":5063,"_29767":92564,"_5":21387,"_28235":92436,"_5797":92565},[],"Create, delete and assign encryption keys.",{"_6892":5112,"_42174":5063,"_29767":92567,"_5":21387,"_28235":92436,"_5797":92568},[],"`POST /symkms/v1/encrypt`, `/decrypt`, `/mac`",{"_6892":5113,"_42174":5063,"_29767":92570,"_5":21387,"_28235":92436,"_5797":92571},[],"Use stored keys on arbitrary data.",{"_6892":5114,"_42174":5063,"_29767":92573,"_5":21387,"_28235":92436,"_5797":92574},[],"`PUT /updates/v1/jobs/:jobID/transition`",{"_6892":5115,"_42174":5063,"_29767":92576,"_5":21387,"_28235":92436,"_5797":92577},[],"Forges a job state change with no ownership check. Registered only when `enable_test_endpoints` is `true`: keep it `false`.",{"_6892":5116,"_42174":5063,"_29767":92579,"_5":21387,"_28235":92436,"_5797":92580},[],"Every `POST`, `PUT` and `DELETE` of `/updates/v1`",{"_6892":5117,"_42174":5063,"_29767":92582,"_5":21387,"_28235":92436,"_5797":92583},[],"Build, launch, cancel and delete. Restrict them to operators.",{"_6892":5118,"_42174":5063,"_29767":92585,"_5":21387,"_28235":92436,"_5797":92586},[],"`GET` of artifacts, descriptors and `artifacts-archive`",{"_6892":5119,"_42174":5063,"_29767":92588,"_5":21387,"_28235":92436,"_5797":92589},[],"Expose firmware sources and sw-descriptions.",{"_6892":5120,"_42174":5063,"_29767":92591,"_5":21387,"_28235":92436,"_5797":92592},[],"Download routes with `:deviceID`",{"_6892":5121,"_42174":5063,"_29767":92594,"_5":21387,"_28235":92436,"_5797":92595},[],"Per-device builds are encrypted with that device's key, but the route itself checks nothing about who asks.",{"_6892":5122,"_42174":5063,"_29767":92597,"_5":21387,"_28235":92440,"_5797":92598},[],"These are defence in depth, not a substitute for the gateway:",{"_6892":5123,"_42174":5063,"_29767":92600,"_5":21387,"_28235":92440,"_5797":92601},[],"A launch is addressed under its group: an operation on a launch through another group's path answers `404`, exactly as for a missing launch, and changes nothing.",{"_6892":5124,"_42174":5063,"_29767":92603,"_5":21387,"_28235":92440,"_5797":92604},[],"Approval and error thresholds must be between 0 and 100.",{"_6892":5125,"_42174":5063,"_29767":92606,"_5":21387,"_28235":92440,"_5797":92607},[],"In `native` mode, pack, group and device identifiers used in paths are validated so they cannot escape the storage directories, and a per-device pack never falls back to the shared build for a device.",{"_6892":5126,"_42174":5063,"_29767":92609,"_5":21387,"_28235":92440,"_5797":92610},[],"An upload under a `.swu` name must really be a SWU: other content is refused with `400`.",{"_6892":5127,"_42174":5063,"_29767":92612,"_5":21387,"_28235":92440,"_5797":92613},[],"An uploaded file larger than `max_artifact_size_mb` is refused with `413`.",{"_6892":5128,"_42174":5063,"_29767":92615,"_5":21387,"_28235":92440,"_5797":92616},[],"In `hawkbit` mode the DDI artifact route serves a file only if the module is assigned to or installed on that device.",{"_6892":5129,"_42174":5063,"_29767":92618,"_5":21387,"_28235":92440,"_5797":92619},[],"Anything that changes a built version is refused (`409`): versions are immutable.",{"_6892":5130,"_42174":5063,"_29767":92621,"_5":21387,"_28235":92444,"_5797":92622},[],"With `presign.enabled`, a download is answered `302` to a short-lived URL of the S3 store. The service authorizes the caller first (the gateway for the static route and, in `hawkbit` mode, the device's assignment); the store then checks only the signature, so **the URL is a bearer capability**: whoever holds it can fetch that one object until it expires. The design keeps that acceptable:",{"_6892":5131,"_42174":5063,"_29767":92624,"_5":21387,"_28235":92444,"_5797":92625},[],"The TTL is short (default 60 s). It bounds when a GET can **start**: a transfer in progress finishes after expiry, and a device that retries or resumes goes back to the static endpoint for a fresh URL. A URL already signed for the same object is reused while it has `min_remaining` validity left (default `min(25s, ttl/2)`); it grants no more than a fresh one.",{"_6892":5132,"_42174":5063,"_29767":92627,"_5":21387,"_28235":92444,"_5797":92628},[],"The signing credential must be **read-only** and different from the storage credential. At start-up the service probes with a write and refuses to run if the credential can write, is the storage's own, or is rejected by the store. A signature covers the method and the key, so a URL cannot be turned into a `PUT` or aimed at another object.",{"_6892":5133,"_42174":5063,"_29767":92630,"_5":21387,"_28235":92444,"_5797":92631},[],"The signed host is the store's **public** origin (`presign.public_endpoint`), because the signature covers the `Host` header.",{"_6892":5134,"_42174":5063,"_29767":92633,"_5":21387,"_28235":92444,"_5797":92634},[],"It cannot be combined with at-rest encryption of the same store (devices would receive ciphertext).",{"_6892":5135,"_42174":5063,"_29767":92636,"_5":21387,"_28235":92444,"_5797":92637},[],"Redirect responses carry `Cache-Control: no-store`. `HEAD` requests are answered by the service, not redirected. If signing fails, the service streams the file instead of failing the update.",{"_6892":5136,"_42174":5063,"_29767":92639,"_5":21387,"_28235":92444,"_5797":92640},[],"Rotate the signing credential by updating the files named by `access_key_id_file` and `secret_access_key_file`: they are re-read every minute.",{"_6892":5137,"_42174":5063,"_29767":92642,"_5":21387,"_28235":92444,"_5797":92643},[],"The store itself must be reachable by devices at the public endpoint, and should accept only the read-only credential on the prefix it serves. Do not publish the store's console or S3 API with default credentials.",{"_6892":5138,"_42174":5063,"_29767":92645,"_5":21387,"_28235":92448,"_5797":92646},[],"Connection",{"_6892":5139,"_42174":5063,"_29767":92648,"_5":21387,"_28235":92448,"_5797":92649},[],"Transport security",{"_6892":5140,"_42174":5063,"_29767":92651,"_5":21387,"_28235":92448,"_5797":85414},[],{"_6892":5141,"_42174":5063,"_29767":92653,"_5":21387,"_28235":92448,"_5797":92654},[],"`sslmode=disable`, not configurable. Keep the database on a private network.",{"_6892":5142,"_42174":5063,"_29767":92656,"_5":21387,"_28235":92448,"_5797":85423},[],{"_6892":5143,"_42174":5063,"_29767":92658,"_5":21387,"_28235":92448,"_5797":92659},[],"The Lamassu platform SDK client with its default settings.",{"_6892":5144,"_42174":5063,"_29767":92661,"_5":21387,"_28235":92448,"_5797":85432},[],{"_6892":5145,"_42174":5063,"_29767":92663,"_5":21387,"_28235":92448,"_5797":92664},[],"`native` mode: certificate verification is **skipped** for the service's own calls, and the SWU signer script uses `curl -k`. `hawkbit` mode: the service's calls verify the certificate, the script still does not. Use an internal address you trust.",{"_6892":5146,"_42174":5063,"_29767":92666,"_5":21387,"_28235":92448,"_5797":85318},[],{"_6892":5147,"_42174":5063,"_29767":92668,"_5":21387,"_28235":92448,"_5797":92669},[],"The scheme of `symkms_endpoint` (normally the service itself, over plain HTTP in the examples), with no credential. Raw key material crosses this connection: keep it on `localhost` or a private network.",{"_6892":5148,"_42174":5063,"_29767":92671,"_5":21387,"_28235":92448,"_5797":92672},[],"hawkBit Management API",{"_6892":5149,"_42174":5063,"_29767":92674,"_5":21387,"_28235":92448,"_5797":92675},[],"HTTP Basic with `hawkbit.username` and `hawkbit.password`. Use HTTPS.",{"_6892":5150,"_42174":5063,"_29767":92677,"_5":21387,"_28235":92448,"_5797":85441},[],{"_6892":5151,"_42174":5063,"_29767":92679,"_5":21387,"_28235":92448,"_5797":92680},[],"The scheme of `wfx_endpoint` (plain HTTP in the examples), to the management listener.",{"_6892":5152,"_42174":5063,"_29767":92682,"_5":21387,"_28235":92452,"_5797":92683},[],"`encryption.local_key`, S3 credentials and database passwords must come from a secret store, not from a file in the repository. The example configurations contain development values only. Prefer the `*_file` form of S3 and presign credentials, which the service re-reads every minute.",{"_6892":5153,"_42174":5063,"_29767":92685,"_5":21387,"_28235":92452,"_5797":92686},[],"The Helm chart renders all of `config` into a ConfigMap. See Operations. Override its placeholder database password.",{"_6892":5154,"_42174":5063,"_29767":92688,"_5":21387,"_28235":92452,"_5797":92689},[],"With `app.logs.level: debug` the service logs the whole configuration, secrets included, and in `native` mode it prints the `storage` block (with its password) to standard output at every start. Use `info` or higher in any environment whose logs are stored.",{"_6892":5155,"_42174":5063,"_29767":92691,"_5":21387,"_28235":92452,"_5797":92692},[],"A lost `encryption.local_key` makes everything stored with it unreadable. See Backup and restore.",{"_6892":5156,"_42174":5063,"_29767":92694,"_5":21387,"_28235":92452,"_5797":92695},[],"Signing keys stay in the Lamassu KMS: the service never holds the private key. Device encryption keys do live in SymKMS (optionally encrypted at rest), because packages must be encrypted with them.",{"_6892":5157,"_42174":5063,"_29767":92697,"_5":21387,"_28235":92452,"_5797":92698},[],"The container image does not drop privileges. Set a `securityContext` that suits your cluster.",{"_6892":5158,"_42174":5063,"_29767":92700,"_5":21387,"_28235":92456,"_5797":92701},[],"The Management API user is a full administrator of hawkBit. Change the default (`admin`) credential, keep the API off the device network and serve it over HTTPS.",{"_6892":5159,"_42174":5063,"_29767":92703,"_5":21387,"_28235":92456,"_5797":92704},[],"Devices authenticate to hawkBit, not to this service. hawkBit 1.1.0 has no anonymous mode: enable a target security token, a gateway token or the reverse-proxy header authenticator, and for the last restrict which addresses may set its headers. Leaving device authentication off, which is acceptable only on a throw-away test stack, lets anything that can reach hawkBit impersonate a device. See hawkBit mode.",{"_6892":5160,"_42174":5063,"_29767":92706,"_5":21387,"_28235":92456,"_5797":92707},[],"hawkBit does not encrypt artifacts at rest. Enable default encryption in the bucket, or use encrypted (shared-key) packages.",{"_6892":5161,"_42174":5063,"_29767":92709,"_5":21387,"_28235":92459,"_5797":92710},[],"A request body can be up to `max_artifact_size_mb` plus 1 MiB (10 GiB by default), and a request can take up to 6 hours, so large uploads work. Streamed uploads use temporary disk under `TMPDIR`. Apply tighter limits at the gateway for callers that are not trusted: there is no rate limiting in the service.",{"_6892":5162,"_42174":5162,"_5":21817,"_5797":88841,"_42654":92712,"_29767":92713,"_28235":5162},[77248,78697,85231,83583],[],{"_6892":5163,"_42174":5162,"_29767":92715,"_5":21387,"_28235":5162,"_5797":92716},[],"Sign deliverables with the Lamassu KMS, encrypt them with a shared or per-device key, and manage device keys in SymKMS.",{"_6892":5164,"_42174":5162,"_5":42651,"_29767":92718,"_28235":92719,"_5797":92720},[],"/docs/pr-preview/pr-56/platform/updates/signing-and-encryption#signing","Signing",{"_6892":5165,"_42174":5162,"_5":42651,"_29767":92722,"_28235":92723,"_5797":92724},[],"/docs/pr-preview/pr-56/platform/updates/signing-and-encryption#set-up-signing","Set up signing",{"_6892":5166,"_42174":5162,"_5":42651,"_29767":92726,"_28235":92727,"_5797":92728},[],"/docs/pr-preview/pr-56/platform/updates/signing-and-encryption#create-the-key-and-a-certificate","Create the key and a certificate",{"_6892":5167,"_42174":5162,"_5":42651,"_29767":92730,"_28235":92731,"_5797":92732},[],"/docs/pr-preview/pr-56/platform/updates/signing-and-encryption#configure-the-service","Configure the service",{"_6892":5168,"_42174":5162,"_5":42651,"_29767":92734,"_28235":92735,"_5797":92736},[],"/docs/pr-preview/pr-56/platform/updates/signing-and-encryption#send-the-signature-fields-in-the-build","Send the signature fields in the build",{"_6892":5169,"_42174":5162,"_5":42651,"_29767":92738,"_28235":92739,"_5797":92740},[],"/docs/pr-preview/pr-56/platform/updates/signing-and-encryption#signed-manifests","Signed manifests",{"_6892":5170,"_42174":5162,"_5":42651,"_29767":92742,"_28235":92743,"_5797":92744},[],"/docs/pr-preview/pr-56/platform/updates/signing-and-encryption#encryption-modes","Encryption modes",{"_6892":5171,"_42174":5162,"_5":42651,"_29767":92746,"_28235":92747,"_5797":92748},[],"/docs/pr-preview/pr-56/platform/updates/signing-and-encryption#algorithms","Algorithms",{"_6892":5172,"_42174":5162,"_5":42651,"_29767":92750,"_28235":92751,"_5797":92752},[],"/docs/pr-preview/pr-56/platform/updates/signing-and-encryption#set-up-per-device-encryption","Set up per-device encryption",{"_6892":5173,"_42174":5162,"_5":42651,"_29767":92754,"_28235":92755,"_5797":92756},[],"/docs/pr-preview/pr-56/platform/updates/signing-and-encryption#create-a-key-per-device","Create a key per device",{"_6892":5174,"_42174":5162,"_5":42651,"_29767":92758,"_28235":92759,"_5797":92760},[],"/docs/pr-preview/pr-56/platform/updates/signing-and-encryption#assign-it-to-the-device","Assign it to the device",{"_6892":5175,"_42174":5162,"_5":42651,"_29767":92762,"_28235":92763,"_5797":92764},[],"/docs/pr-preview/pr-56/platform/updates/signing-and-encryption#put-the-same-key-on-the-device","Put the same key on the device",{"_6892":5176,"_42174":5162,"_5":42651,"_29767":92766,"_28235":92767,"_5797":87479},[],"/docs/pr-preview/pr-56/platform/updates/signing-and-encryption#build",{"_6892":5177,"_42174":5162,"_5":42651,"_29767":92769,"_28235":92770,"_5797":85318},[],"/docs/pr-preview/pr-56/platform/updates/signing-and-encryption#symkms",{"_6892":5178,"_42174":5162,"_5":42651,"_29767":92772,"_28235":92773,"_5797":89664},[],"/docs/pr-preview/pr-56/platform/updates/signing-and-encryption#request-bodies",{"_6892":5179,"_42174":5162,"_29767":92775,"_5":21387,"_28235":5162,"_5797":92776},[],"This page explains how Lamassu Updates protects what it delivers: which keys sign and encrypt a package, how to configure them, and what each backend supports. There are three independent layers.",{"_6892":5180,"_42174":5162,"_29767":92778,"_5":21387,"_28235":5162,"_5797":92779},[],"Layer",{"_6892":5181,"_42174":5162,"_29767":92781,"_5":21387,"_28235":5162,"_5797":92782},[],"Protects",{"_6892":5182,"_42174":5162,"_29767":92784,"_5":21387,"_28235":5162,"_5797":92785},[],"Configured in",{"_6892":5183,"_42174":5162,"_29767":92787,"_5":21387,"_28235":5162,"_5797":92504},[],{"_6892":5184,"_42174":5162,"_29767":92789,"_5":21387,"_28235":5162,"_5797":92790},[],"That the package came from you and is unmodified",{"_6892":5185,"_42174":5162,"_29767":92792,"_5":21387,"_28235":5162,"_5797":92793},[],"A signing key and certificate in the Lamassu KMS, plus `kms_endpoint` and `sign_script_path`",{"_6892":5186,"_42174":5162,"_29767":92795,"_5":21387,"_28235":5162,"_5797":92510},[],{"_6892":5187,"_42174":5162,"_29767":92797,"_5":21387,"_28235":5162,"_5797":92798},[],"The contents of the package in transit and on the device's download path",{"_6892":5188,"_42174":5162,"_29767":92800,"_5":21387,"_28235":5162,"_5797":92801},[],"The build request, plus a key in SymKMS",{"_6892":5189,"_42174":5162,"_29767":92803,"_5":21387,"_28235":5162,"_5797":92516},[],{"_6892":5190,"_42174":5162,"_29767":92805,"_5":21387,"_28235":5162,"_5797":92806},[],"Artifacts, builds and keys stored by the service",{"_6892":5191,"_42174":5162,"_29767":92808,"_5":21387,"_28235":5162,"_5797":92809},[],"The `encryption` block of each blob storage block",{"_6892":5192,"_42174":5162,"_29767":92811,"_5":21387,"_28235":92719,"_5797":92812},[],"Signing is optional. When you ask for it, `swugenerator` calls the configured signer script (`sign_script_path`, which is `sign_kms.sh`), and the script asks the Lamassu KMS (`kms_endpoint`) to sign. The private key never reaches the machine that builds the package.",{"_6892":5193,"_42174":5162,"_29767":92814,"_5":21387,"_28235":92719,"_5797":92815},[],"For `.swu` builds both settings must be set: the service refuses a signing request when either is missing.",{"_6892":5194,"_42174":5162,"_29767":92817,"_5":21387,"_28235":92719,"_5797":92818},[],"Signing a manifest, a `non-swu` package or a hawkBit `raw` module calls the KMS directly from the service and needs only `kms_endpoint`.",{"_6892":5195,"_42174":5162,"_29767":92820,"_5":21387,"_28235":92719,"_5797":92821},[],"Select the key in the build request with `signature_key_id`, `signature_alg_name` (default `RSASSA_PSS_SHA_256`; `-` and `_` are interchangeable) and `signature_certificate` (PEM). The three fields go together: a request with a key but no algorithm or certificate is refused, never built unsigned.",{"_6892":5196,"_42174":5162,"_29767":92823,"_5":21387,"_28235":92727,"_5797":92824},[],"In the Lamassu KMS, create (or choose) the signing key and issue a certificate for it from a CA your devices trust. See Keys and cryptographic engines. The key ID is your `signature_key_id`.",{"_6892":5197,"_42174":5162,"_29767":92826,"_5":21387,"_28235":92731,"_5797":92827},[],"Set `kms_endpoint` and `sign_script_path` (`/app/sign_kms.sh` in the image). `swugenerator` calls the script with the key ID, the KMS URL, the algorithm and the path of the certificate file, which the script requires. The script writes a debug log to `/tmp/sign_kms_debug.log`.",{"_6892":5198,"_42174":5162,"_29767":92829,"_5":21387,"_28235":92735,"_5797":92830},[],"Include `signature_key_id`, `signature_alg_name` and `signature_certificate` in the build body. In `hawkbit` mode they go in the module build body.",{"_6892":5199,"_42174":5162,"_29767":92832,"_5":21387,"_28235":92735,"_5797":92833},[],"SWUpdate verifies a `.swu` with a CMS `SignedData` signature, and the service requires CMS for the manifests it signs itself. A Lamassu KMS that ignores the `Accept` header and answers with a bare signature in a JSON envelope produces a signature no device can verify. Where the service signs itself (version manifests, set manifests, raw-module checksums) it refuses such an answer and the operation fails with `the KMS did not return a PKCS7/CMS signature`. The SWU signer script does not check the format: it unwraps the answer and embeds it, so against a KMS without CMS support a `.swu` build can succeed and still be rejected by a device that sets `public-key-file`. Test one signed build on a real device before you rely on a KMS version.",{"_6892":5200,"_42174":5162,"_29767":92835,"_5":21387,"_28235":92735,"_5797":92836},[],"`sign_kms_nocms.sh` is a variant of the script that takes no certificate. The service's own manifest signing is separate: it always sends the certificate and refuses to sign without one.",{"_6892":5201,"_42174":5162,"_29767":92838,"_5":21387,"_28235":92735,"_5797":92839},[],"TLS towards the KMS: in `native` mode the service's KMS client skips certificate verification, and `sign_kms.sh` calls `curl -k`. In `hawkbit` mode the service's own KMS calls verify the certificate, but the SWU signer script still uses `curl -k`. Reach the KMS over an internal address you trust. See Security.",{"_6892":5202,"_42174":5162,"_29767":92841,"_5":21387,"_28235":92739,"_5797":92842},[],"Each built version also has a **manifest**, an anti-rollback record of what the version contains: name, group, version, packaging, artifacts with their SHA-256, the deliverable and, in `hawkbit` mode, the exact modules and versions that compose the set. A manifest is valid for 5 years (`expires_at`). It is signed with the KMS key when the build carried signing fields, and stored unsigned otherwise (the service logs a warning). If a signing key is configured but the manifest cannot be signed, the build fails.",{"_6892":5203,"_42174":5162,"_29767":92844,"_5":21387,"_28235":92739,"_5797":92845},[],"Read it with:",{"_6892":5204,"_42174":5162,"_29767":92847,"_5":21387,"_28235":92739,"_5797":92848},[],"The response has `manifest` (the exact bytes the signature covers), `signature` (base64 CMS), `algorithm`, `certificate` (PEM), `signed_at` and `expires_at`. In `hawkbit` mode `stale: true` means a signed manifest exists but the set's contents changed since, so the manifest returned describes the set as it is now. The `artifact_signatures` capability reports whether the active backend provides it.",{"_6892":5205,"_42174":5162,"_29767":92850,"_5":21387,"_28235":92743,"_5797":91917},[],{"_6892":5206,"_42174":5162,"_29767":92852,"_5":21387,"_28235":92743,"_5797":92853},[],"What you get",{"_6892":5207,"_42174":5162,"_29767":92855,"_5":21387,"_28235":92743,"_5797":89209},[],{"_6892":5208,"_42174":5162,"_29767":92857,"_5":21387,"_28235":92743,"_5797":86482},[],{"_6892":5209,"_42174":5162,"_29767":92859,"_5":21387,"_28235":92743,"_5797":81871},[],{"_6892":5210,"_42174":5162,"_29767":92861,"_5":21387,"_28235":92743,"_5797":92862},[],"One unencrypted deliverable",{"_6892":5211,"_42174":5162,"_29767":92864,"_5":21387,"_28235":92743,"_5797":81396},[],{"_6892":5212,"_42174":5162,"_29767":92866,"_5":21387,"_28235":92743,"_5797":81396},[],{"_6892":5213,"_42174":5162,"_29767":92868,"_5":21387,"_28235":92743,"_5797":92869},[],"Shared",{"_6892":5214,"_42174":5162,"_29767":92871,"_5":21387,"_28235":92743,"_5797":92872},[],"One deliverable encrypted with one key, served to every device",{"_6892":5215,"_42174":5162,"_29767":92874,"_5":21387,"_28235":92743,"_5797":81396},[],{"_6892":5216,"_42174":5162,"_29767":92876,"_5":21387,"_28235":92743,"_5797":92877},[],"Yes, through the module build endpoints, when the build pipeline is configured",{"_6892":5217,"_42174":5162,"_29767":92879,"_5":21387,"_28235":92743,"_5797":92880},[],"Per-device",{"_6892":5218,"_42174":5162,"_29767":92882,"_5":21387,"_28235":92743,"_5797":92883},[],"One deliverable per device, each encrypted with that device's own key from SymKMS",{"_6892":5219,"_42174":5162,"_29767":92885,"_5":21387,"_28235":92743,"_5797":81396},[],{"_6892":5220,"_42174":5162,"_29767":92887,"_5":21387,"_28235":92743,"_5797":81448},[],{"_6892":5221,"_42174":5162,"_29767":92889,"_5":21387,"_28235":92743,"_5797":92890},[],"The build body decides the mode:",{"_6892":5222,"_42174":5162,"_29767":92892,"_5":21387,"_28235":92743,"_5797":92893},[],"**Shared**: send `user`, `encryption_key_name` and `encryption_alg_name`. A `.swu` build is refused without the algorithm. A `.../package` build picks AES-GCM from the key length and only records the name you send.",{"_6892":5223,"_42174":5162,"_29767":92895,"_5":21387,"_28235":92743,"_5797":92896},[],"**Per-device**: send `encryption_alg_name` **without** `user` or `encryption_key_name`. This holds for `.../package` too: sending the algorithm is what selects per-device mode, and omitting it builds an unencrypted package.",{"_6892":5224,"_42174":5162,"_29767":92898,"_5":21387,"_28235":92743,"_5797":92899},[],"**None**: send neither.",{"_6892":5225,"_42174":5162,"_29767":92901,"_5":21387,"_28235":92743,"_5797":92902},[],"Other build fields: `sw_desc_encrypted` also encrypts the sw-description itself, and `selected_artifact_ids` lists the artifacts the build includes. In `native` mode a `.swu` build with no selected artifacts fails.",{"_6892":5226,"_42174":5162,"_29767":92904,"_5":21387,"_28235":92743,"_5797":92905},[],"In `hawkbit` mode `POST .../swu` returns `501`. Send the same signing and encryption fields to the module build instead: `POST /updates/v1/softwaremodules/by-id/:moduleID/build` (for `swu-build` and `raw` modules). See hawkBit mode.",{"_6892":5227,"_42174":5162,"_29767":92907,"_5":21387,"_28235":92743,"_5797":92908},[],"The sw-description must mark the artifacts to encrypt with `encrypted = true;`. A per-device build is refused when no artifact is marked, because the key alone does nothing.",{"_6892":5228,"_42174":5162,"_29767":92910,"_5":21387,"_28235":92747,"_5797":92911},[],"The `algorithm` of a SymKMS key and the `encryption_alg_name` of a build use these names.",{"_6892":5229,"_42174":5162,"_29767":92913,"_5":21387,"_28235":92747,"_5797":92914},[],"Algorithm",{"_6892":5230,"_42174":5162,"_29767":92916,"_5":21387,"_28235":92747,"_5797":92917},[],"Key length",{"_6892":5231,"_42174":5162,"_29767":92919,"_5":21387,"_28235":92747,"_5797":92920},[],"`AES-128-CBC`, `AES-128-CTR`, `AES-128-GCM`",{"_6892":5232,"_42174":5162,"_29767":92922,"_5":21387,"_28235":92747,"_5797":92923},[],"16 bytes",{"_6892":5233,"_42174":5162,"_29767":92925,"_5":21387,"_28235":92747,"_5797":92926},[],"`AES-192-CBC`, `AES-192-CTR`, `AES-192-GCM`",{"_6892":5234,"_42174":5162,"_29767":92928,"_5":21387,"_28235":92747,"_5797":92929},[],"24 bytes",{"_6892":5235,"_42174":5162,"_29767":92931,"_5":21387,"_28235":92747,"_5797":92932},[],"`AES-256-CBC`, `AES-256-CTR`, `AES-256-GCM`",{"_6892":5236,"_42174":5162,"_29767":92934,"_5":21387,"_28235":92747,"_5797":92935},[],"32 bytes",{"_6892":5237,"_42174":5162,"_29767":92937,"_5":21387,"_28235":92747,"_5797":92938},[],"`ASCON-128`, `ASCON-128A`",{"_6892":5238,"_42174":5162,"_29767":92940,"_5":21387,"_28235":92747,"_5797":92923},[],{"_6892":5239,"_42174":5162,"_29767":92942,"_5":21387,"_28235":92747,"_5797":92943},[],"`ASCON-80PQ`",{"_6892":5240,"_42174":5162,"_29767":92945,"_5":21387,"_28235":92747,"_5797":92946},[],"20 bytes",{"_6892":5241,"_42174":5162,"_29767":92948,"_5":21387,"_28235":92747,"_5797":92949},[],"**SymKMS key names**: matching ignores case, and `_` and `-` are interchangeable (`aes_256_gcm` is stored as `AES-256-GCM`). The separators of the name must still be there: `ascon128a` is not `ASCON-128A`. A key whose length does not match its algorithm is rejected when it is created.",{"_6892":5242,"_42174":5162,"_29767":92951,"_5":21387,"_28235":92747,"_5797":92952},[],"**Build names**: `encryption_alg_name` is passed to `swugenerator` as it is. Case is ignored, but the hyphens are required: `aes-256-gcm` works, `AES_256_GCM` is rejected. If the name differs from the algorithm stored with the key, the service logs a warning and uses the name from the request.",{"_6892":5243,"_42174":5162,"_29767":92954,"_5":21387,"_28235":92747,"_5797":92955},[],"**`non-swu` packages** (`.../package`, and `hawkbit` `raw` modules) are always encrypted with **AES-GCM**, chosen by key length (16, 24 or 32 bytes). The requested name is only recorded, and a 20-byte Ascon-80pq key is refused. The result is `nonce || ciphertext`.",{"_6892":5244,"_42174":5162,"_29767":92957,"_5":21387,"_28235":92747,"_5797":92958},[],"The service generates the IV or nonce. In `native` mode the algorithm and, for shared-key packs, the IV are passed to the device in the WFX job. A per-device build draws a fresh IV for each device and does not record it in the job, so the job carries the algorithm only. The job fields are listed in Connect a device.",{"_6892":5245,"_42174":5162,"_29767":92960,"_5":21387,"_28235":92755,"_5797":92961},[],"In SymKMS, `POST /symkms/v1/` with `user_id`, an `algorithm` from the table and a `key` (hex or base64) of the right length.",{"_6892":5246,"_42174":5162,"_29767":92963,"_5":21387,"_28235":92759,"_5797":92964},[],"`POST /symkms/v1/inventory/:deviceID/keys/:keyID` with a body `{\"purpose\":\"firmware-encryption\"}` and an optional `expires_at` (RFC 3339). A per-device build asks for each device's `firmware-encryption` key.",{"_6892":5247,"_42174":5162,"_29767":92966,"_5":21387,"_28235":92763,"_5797":92967},[],"In the form SWUpdate expects (its `-K` key file, with the key, IV and algorithm).",{"_6892":5248,"_42174":5162,"_29767":92969,"_5":21387,"_28235":92767,"_5797":92970},[],"Send `encryption_alg_name` and no `user` or `encryption_key_name`. The sw-description must mark an artifact `encrypted = true;`.",{"_6892":5249,"_42174":5162,"_29767":92972,"_5":21387,"_28235":92767,"_5797":92973},[],"**Key purposes.** The conventional purposes are `firmware-encryption`, `config-encryption` and `mac-verification`. The purpose is a placeholder: any value is accepted, and a binding with an empty purpose acts as a wildcard that matches any lookup. This is intentional while per-purpose keys are rolled out. An exact (case-insensitive) match wins over a wildcard, and among equals the most recent assignment wins. Expired or revoked bindings are skipped.",{"_6892":5250,"_42174":5162,"_29767":92975,"_5":21387,"_28235":92767,"_5797":92976},[],"**Coverage.** A device with no `firmware-encryption` key is skipped (the reason reads `no firmware-encryption key assigned` for `.swu` builds). The build still succeeds if at least one device was covered, and the pack records the coverage: read `built_device_count`, `total_device_count` and `uncovered_devices` on it. A launch on a pack with uncovered devices is refused with `400`, and there is no override: assign the missing keys and build again. If no device was covered, the build itself fails.",{"_6892":5251,"_42174":5162,"_29767":92978,"_5":21387,"_28235":92767,"_5797":92979},[],"**Cost.** A per-device build runs one `swugenerator` process per device, in parallel up to the CPU available to the container. On a 100 MB artifact, one device costs roughly half a second of encryption, plus about three seconds more if the sw-description asks for gzip compression. Size the container accordingly: see Resource sizing. Builds of the same pack are serialized: a second build or version bump while one runs answers `409`.",{"_6892":5252,"_42174":5162,"_29767":92981,"_5":21387,"_28235":92770,"_5797":92982},[],"SymKMS is the embedded symmetric key service, served by the same process under `/symkms/v1`. It stores keys, assigns them to devices, and can also encrypt, decrypt and compute MACs. Keys are stored in the `symkms` blob store, optionally with at-rest encryption. Create keys with the correct length for their algorithm: random bytes, never a passphrase.",{"_6892":5253,"_42174":5162,"_29767":92984,"_5":21387,"_28235":92770,"_5797":92985},[],"Task",{"_6892":5254,"_42174":5162,"_29767":92987,"_5":21387,"_28235":92770,"_5797":86919},[],{"_6892":5255,"_42174":5162,"_29767":92989,"_5":21387,"_28235":92770,"_5797":92990},[],"Store a key",{"_6892":5256,"_42174":5162,"_29767":92992,"_5":21387,"_28235":92770,"_5797":92993},[],"`POST /symkms/v1/`",{"_6892":5257,"_42174":5162,"_29767":92995,"_5":21387,"_28235":92770,"_5797":92996},[],"List keys of a user",{"_6892":5258,"_42174":5162,"_29767":92998,"_5":21387,"_28235":92770,"_5797":92999},[],"`GET /symkms/v1/?user_id=...`",{"_6892":5259,"_42174":5162,"_29767":93001,"_5":21387,"_28235":92770,"_5797":93002},[],"Delete a key",{"_6892":5260,"_42174":5162,"_29767":93004,"_5":21387,"_28235":92770,"_5797":93005},[],"`DELETE /symkms/v1/:keyID?user_id=...`",{"_6892":5261,"_42174":5162,"_29767":93007,"_5":21387,"_28235":92770,"_5797":93008},[],"Assign or revoke a key for a device",{"_6892":5262,"_42174":5162,"_29767":93010,"_5":21387,"_28235":92770,"_5797":93011},[],"`POST` or `DELETE /symkms/v1/inventory/:deviceID/keys/:keyID`",{"_6892":5263,"_42174":5162,"_29767":93013,"_5":21387,"_28235":92770,"_5797":93014},[],"A device's active key (privileged, returns key material)",{"_6892":5264,"_42174":5162,"_29767":93016,"_5":21387,"_28235":92770,"_5797":93017},[],"`GET /symkms/v1/inventory/:deviceID/key?purpose=...`",{"_6892":5265,"_42174":5162,"_29767":93019,"_5":21387,"_28235":92770,"_5797":93020},[],"Which devices use a key",{"_6892":5266,"_42174":5162,"_29767":93022,"_5":21387,"_28235":92770,"_5797":93023},[],"`GET /symkms/v1/inventory/by-key/:keyID`",{"_6892":5267,"_42174":5162,"_29767":93025,"_5":21387,"_28235":92770,"_5797":93026},[],"A device's key bindings",{"_6892":5268,"_42174":5162,"_29767":93028,"_5":21387,"_28235":92770,"_5797":93029},[],"`GET /symkms/v1/inventory/:deviceID`",{"_6892":5269,"_42174":5162,"_29767":93031,"_5":21387,"_28235":92770,"_5797":93032},[],"Encrypt, decrypt",{"_6892":5270,"_42174":5162,"_29767":93034,"_5":21387,"_28235":92770,"_5797":93035},[],"`POST /symkms/v1/encrypt`, `POST /symkms/v1/decrypt`",{"_6892":5271,"_42174":5162,"_29767":93037,"_5":21387,"_28235":92770,"_5797":93038},[],"MAC and verify",{"_6892":5272,"_42174":5162,"_29767":93040,"_5":21387,"_28235":92770,"_5797":93041},[],"`POST /symkms/v1/mac`, `POST /symkms/v1/mac/verify` (and the `/file` variants)",{"_6892":5273,"_42174":5162,"_29767":93043,"_5":21387,"_28235":92773,"_5797":86919},[],{"_6892":5274,"_42174":5162,"_29767":93045,"_5":21387,"_28235":92773,"_5797":93046},[],"Body (JSON)",{"_6892":5275,"_42174":5162,"_29767":93048,"_5":21387,"_28235":92773,"_5797":92993},[],{"_6892":5276,"_42174":5162,"_29767":93050,"_5":21387,"_28235":92773,"_5797":93051},[],"`user_id`, `algorithm`, `key` (hex or base64; hex is tried first), optional `id`. `user_id`, `algorithm` and `key` are required.",{"_6892":5277,"_42174":5162,"_29767":93053,"_5":21387,"_28235":92773,"_5797":93054},[],"`POST /symkms/v1/encrypt`",{"_6892":5278,"_42174":5162,"_29767":93056,"_5":21387,"_28235":92773,"_5797":93057},[],"`user_id`, `key_name`, `algorithm`, `plaintext` (base64), optional `iv`, optional `format`.",{"_6892":5279,"_42174":5162,"_29767":93059,"_5":21387,"_28235":92773,"_5797":93060},[],"`POST /symkms/v1/decrypt`",{"_6892":5280,"_42174":5162,"_29767":93062,"_5":21387,"_28235":92773,"_5797":93063},[],"`user_id`, `key_name`, `algorithm`, `ciphertext`, `iv`, optional `format`.",{"_6892":5281,"_42174":5162,"_29767":93065,"_5":21387,"_28235":92773,"_5797":93066},[],"`POST /symkms/v1/mac`",{"_6892":5282,"_42174":5162,"_29767":93068,"_5":21387,"_28235":92773,"_5797":93069},[],"`user_id`, `key_name`, `mac_algorithm`, `data` (base64). The MAC is returned as hex.",{"_6892":5283,"_42174":5162,"_29767":93071,"_5":21387,"_28235":92773,"_5797":93072},[],"`POST /symkms/v1/mac/verify`",{"_6892":5284,"_42174":5162,"_29767":93074,"_5":21387,"_28235":92773,"_5797":93075},[],"The same as `/mac`, plus `mac` (hex).",{"_6892":5285,"_42174":5162,"_29767":93077,"_5":21387,"_28235":92773,"_5797":93078},[],"`format` is `ciphertext` (hex, the default), `base64`, or `cms` (`pkcs7` is an alias): a PEM-encoded CMS structure that embeds the algorithm and IV. With `cms`, `decrypt` can omit `algorithm` and `iv`.",{"_6892":5286,"_42174":5162,"_29767":93080,"_5":21387,"_28235":92773,"_5797":93081},[],"The server generates the nonce for GCM, CTR and Ascon: **a caller-supplied `iv` is refused** for those algorithms. Only CBC accepts one (16 bytes). The response carries the `iv` used (hex).",{"_6892":5287,"_42174":5162,"_29767":93083,"_5":21387,"_28235":92773,"_5797":93084},[],"`mac_algorithm` is `HMAC-SHA3-256`, `AES-CMAC` or `ASCON-MAC`. The `/file` variants take the data as `multipart/form-data`.",{"_6892":5288,"_42174":5162,"_29767":93086,"_5":21387,"_28235":92773,"_5797":93087},[],"`GET /symkms/v1/:keyID/raw?user_id=...` and `GET /symkms/v1/inventory/:deviceID/key` return raw key material and are privileged: the Updates service itself calls them during a build. The service has no authentication of its own, so restrict these routes at a gateway. See Security.",{"_6892":5289,"_42174":5162,"_29767":93089,"_5":21387,"_28235":92773,"_5797":93090},[],"The same SymKMS routes can run as their own process (`cmd/symkms`) instead of inside the monolith. See Configuration.",{"_6892":5290,"_42174":5290,"_5":21817,"_5797":81275,"_42654":93092,"_29767":93093,"_28235":5290},[77248,78697,85231,88818],[],{"_6892":5291,"_42174":5290,"_29767":93095,"_5":21387,"_28235":5290,"_5797":93096},[],"Symptoms, likely causes and fixes for start-up errors, API calls, builds, downloads and updates that do not reach devices.",{"_6892":5292,"_42174":5290,"_5":42651,"_29767":93098,"_28235":93099,"_5797":93100},[],"/docs/pr-preview/pr-56/platform/updates/troubleshooting#http-status-codes","HTTP status codes",{"_6892":5293,"_42174":5290,"_5":42651,"_29767":93102,"_28235":93103,"_5797":93104},[],"/docs/pr-preview/pr-56/platform/updates/troubleshooting#starting-the-service","Starting the service",{"_6892":5294,"_42174":5290,"_5":42651,"_29767":93106,"_28235":93107,"_5797":93108},[],"/docs/pr-preview/pr-56/platform/updates/troubleshooting#api-calls","API calls",{"_6892":5295,"_42174":5290,"_5":42651,"_29767":93110,"_28235":93111,"_5797":93112},[],"/docs/pr-preview/pr-56/platform/updates/troubleshooting#builds","Builds",{"_6892":5296,"_42174":5290,"_5":42651,"_29767":93114,"_28235":93115,"_5797":93116},[],"/docs/pr-preview/pr-56/platform/updates/troubleshooting#downloads-and-presigned-urls","Downloads and presigned URLs",{"_6892":5297,"_42174":5290,"_5":42651,"_29767":93118,"_28235":93119,"_5797":93120},[],"/docs/pr-preview/pr-56/platform/updates/troubleshooting#updates-not-reaching-devices","Updates not reaching devices",{"_6892":5298,"_42174":5290,"_5":42651,"_29767":93122,"_28235":93123,"_5797":93124},[],"/docs/pr-preview/pr-56/platform/updates/troubleshooting#scaling-and-background-work","Scaling and background work",{"_6892":5299,"_42174":5290,"_5":42651,"_29767":93126,"_28235":93127,"_5797":93128},[],"/docs/pr-preview/pr-56/platform/updates/troubleshooting#getting-more-information","Getting more information",{"_6892":5300,"_42174":5290,"_29767":93130,"_5":21387,"_28235":5290,"_5797":93131},[],"Diagnose one operation at a time. Note the backend (`GET /updates/v1/capabilities` shows it), the endpoint, the HTTP status and the `err` text of the response body: errors are returned as `{\"err\": \"...\"}`. If your problem is not here, check Limitations first.",{"_6892":5301,"_42174":5290,"_29767":93133,"_5":21387,"_28235":93099,"_5797":85668},[],{"_6892":5302,"_42174":5290,"_29767":93135,"_5":21387,"_28235":93099,"_5797":79765},[],{"_6892":5303,"_42174":5290,"_29767":93137,"_5":21387,"_28235":93099,"_5797":89835},[],{"_6892":5304,"_42174":5290,"_29767":93139,"_5":21387,"_28235":93099,"_5797":93140},[],"The request or the current state of the resource does not allow the operation. The message says what to change.",{"_6892":5305,"_42174":5290,"_29767":93142,"_5":21387,"_28235":93099,"_5797":89841},[],{"_6892":5306,"_42174":5290,"_29767":93144,"_5":21387,"_28235":93099,"_5797":93145},[],"A policy refuses the operation.",{"_6892":5307,"_42174":5290,"_29767":93147,"_5":21387,"_28235":93099,"_5797":89847},[],{"_6892":5308,"_42174":5290,"_29767":93149,"_5":21387,"_28235":93099,"_5797":93150},[],"The resource does not exist. Another group's launch also answers `404`.",{"_6892":5309,"_42174":5290,"_29767":93152,"_5":21387,"_28235":93099,"_5797":89853},[],{"_6892":5310,"_42174":5290,"_29767":93154,"_5":21387,"_28235":93099,"_5797":93155},[],"A conflicting operation is in progress, or the version is already built.",{"_6892":5311,"_42174":5290,"_29767":93157,"_5":21387,"_28235":93099,"_5797":89859},[],{"_6892":5312,"_42174":5290,"_29767":93159,"_5":21387,"_28235":93099,"_5797":93160},[],"A file is larger than `max_artifact_size_mb`.",{"_6892":5313,"_42174":5290,"_29767":93162,"_5":21387,"_28235":93099,"_5797":93163},[],"`500`",{"_6892":5314,"_42174":5290,"_29767":93165,"_5":21387,"_28235":93099,"_5797":93166},[],"An unexpected failure. Some validation errors still answer `500` (see below).",{"_6892":5315,"_42174":5290,"_29767":93168,"_5":21387,"_28235":93099,"_5797":89865},[],{"_6892":5316,"_42174":5290,"_29767":93170,"_5":21387,"_28235":93099,"_5797":93171},[],"The active backend does not support the operation. Read the capabilities.",{"_6892":5317,"_42174":5290,"_29767":93173,"_5":21387,"_28235":93103,"_5797":80915},[],{"_6892":5318,"_42174":5290,"_29767":93175,"_5":21387,"_28235":93103,"_5797":86538},[],{"_6892":5319,"_42174":5290,"_29767":93177,"_5":21387,"_28235":93103,"_5797":93178},[],"Fix",{"_6892":5320,"_42174":5290,"_29767":93180,"_5":21387,"_28235":93103,"_5797":93181},[],"`docker compose up` fails with a network error",{"_6892":5321,"_42174":5290,"_29767":93183,"_5":21387,"_28235":93103,"_5797":93184},[],"The `ota-net` network does not exist",{"_6892":5322,"_42174":5290,"_29767":93186,"_5":21387,"_28235":93103,"_5797":93187},[],"`docker network create ota-net`",{"_6892":5323,"_42174":5290,"_29767":93189,"_5":21387,"_28235":93103,"_5797":93190},[],"Docker build cannot find `lamassuiot/core`",{"_6892":5324,"_42174":5290,"_29767":93192,"_5":21387,"_28235":93103,"_5797":93193},[],"The build context is not the parent of the checkout",{"_6892":5325,"_42174":5290,"_29767":93195,"_5":21387,"_28235":93103,"_5797":93196},[],"Build with the context that contains `ota/`, `lamassuiot/core` and `lamassuiot/sdk`. `docker compose build updates` uses it.",{"_6892":5326,"_42174":5290,"_29767":93198,"_5":21387,"_28235":93103,"_5797":93199},[],"The service ignores `OTA_CONFIG_FILE` and logs a warning",{"_6892":5327,"_42174":5290,"_29767":93201,"_5":21387,"_28235":93103,"_5797":93202},[],"The file could not be loaded, so it fell back to `/etc/lamassuiot/config.yml`",{"_6892":5328,"_42174":5290,"_29767":93204,"_5":21387,"_28235":93103,"_5797":93205},[],"Check the path and the YAML. In the image the fallback is the repository's developer configuration.",{"_6892":5329,"_42174":5290,"_29767":93207,"_5":21387,"_28235":93103,"_5797":93208},[],"`workflow_file \"...\" must contain \"direct\"`",{"_6892":5330,"_42174":5290,"_29767":93210,"_5":21387,"_28235":93103,"_5797":93211},[],"`workflow_file` does not name the `direct` workflow",{"_6892":5331,"_42174":5290,"_29767":93213,"_5":21387,"_28235":93103,"_5797":93214},[],"Point it at `wfx.workflow.dau.direct.yml` or a path containing `direct`.",{"_6892":5332,"_42174":5290,"_29767":93216,"_5":21387,"_28235":93103,"_5797":93217},[],"`failed to list existing WFX workflows`",{"_6892":5333,"_42174":5290,"_29767":93219,"_5":21387,"_28235":93103,"_5797":93220},[],"`wfx_endpoint` is wrong or WFX is down",{"_6892":5334,"_42174":5290,"_29767":93222,"_5":21387,"_28235":93103,"_5797":93223},[],"Use the **management** port (`8081` inside the Compose network, `9081` on the host) and check that `custom-wfx` runs.",{"_6892":5335,"_42174":5290,"_29767":93225,"_5":21387,"_28235":93103,"_5797":93226},[],"Postgres reports that database `updates` does not exist",{"_6892":5336,"_42174":5290,"_29767":93228,"_5":21387,"_28235":93103,"_5797":93229},[],"The database is not created by the service",{"_6892":5337,"_42174":5290,"_29767":93231,"_5":21387,"_28235":93103,"_5797":93232},[],"Create it (Docker Compose does it through `init.sql`).",{"_6892":5338,"_42174":5290,"_29767":93234,"_5":21387,"_28235":93103,"_5797":93235},[],"`mode is \"hawkbit\" but hawkbit.base_url is not configured`",{"_6892":5339,"_42174":5290,"_29767":93237,"_5":21387,"_28235":93103,"_5797":93238},[],"Missing key",{"_6892":5340,"_42174":5290,"_29767":93240,"_5":21387,"_28235":93103,"_5797":93241},[],"Set `hawkbit.base_url`.",{"_6892":5341,"_42174":5290,"_29767":93243,"_5":21387,"_28235":93103,"_5797":93244},[],"`mode is \"hawkbit\" but storage (Postgres) is not configured`",{"_6892":5342,"_42174":5290,"_29767":93246,"_5":21387,"_28235":93103,"_5797":93247},[],"`storage.hostname` is empty",{"_6892":5343,"_42174":5290,"_29767":93249,"_5":21387,"_28235":93103,"_5797":93250},[],"Set the `storage` block.",{"_6892":5344,"_42174":5290,"_29767":93252,"_5":21387,"_28235":93103,"_5797":93253},[],"`S3 bucket \"x\" is not accessible at ...`",{"_6892":5345,"_42174":5290,"_29767":93255,"_5":21387,"_28235":93103,"_5797":93256},[],"Wrong bucket, endpoint or credentials, or the bucket does not exist",{"_6892":5346,"_42174":5290,"_29767":93258,"_5":21387,"_28235":93103,"_5797":93259},[],"Fix the `s3_*` keys of the block named in the error. The bucket must already exist.",{"_6892":5347,"_42174":5290,"_29767":93261,"_5":21387,"_28235":93103,"_5797":93262},[],"`local encryption key must be exactly 32 bytes`",{"_6892":5348,"_42174":5290,"_29767":93264,"_5":21387,"_28235":93103,"_5797":93265},[],"`encryption.local_key` is not 32 bytes of hex",{"_6892":5349,"_42174":5290,"_29767":93267,"_5":21387,"_28235":93103,"_5797":93268},[],"Use 64 hex characters (`openssl rand -hex 32`).",{"_6892":5350,"_42174":5290,"_29767":93270,"_5":21387,"_28235":93103,"_5797":93271},[],"`could not configure leader election: the service account may not ... Leases`",{"_6892":5351,"_42174":5290,"_29767":93273,"_5":21387,"_28235":93103,"_5797":93274},[],"The pod cannot use Leases and `leaderElection.mode` is `kubernetes`",{"_6892":5352,"_42174":5290,"_29767":93276,"_5":21387,"_28235":93103,"_5797":93277},[],"Grant the Role the chart provides (`serviceAccount.create: true`), or set `leaderElection.mode: database`.",{"_6892":5353,"_42174":5290,"_29767":93279,"_5":21387,"_28235":93103,"_5797":93280},[],"`not running inside a Kubernetes cluster`",{"_6892":5354,"_42174":5290,"_29767":93282,"_5":21387,"_28235":93103,"_5797":93283},[],"`leader_election.mode: kubernetes` outside a cluster",{"_6892":5355,"_42174":5290,"_29767":93285,"_5":21387,"_28235":93103,"_5797":93286},[],"Use empty (auto) or `database`.",{"_6892":5356,"_42174":5290,"_29767":93288,"_5":21387,"_28235":93103,"_5797":93289},[],"`builds.presign: ...` or `hawkbit.artifact_store.presign: ...`",{"_6892":5357,"_42174":5290,"_29767":93291,"_5":21387,"_28235":93103,"_5797":93292},[],"The presigned-download settings of that block are invalid",{"_6892":5358,"_42174":5290,"_29767":93294,"_5":21387,"_28235":93103,"_5797":93295},[],"See Downloads and presigned URLs.",{"_6892":5359,"_42174":5290,"_29767":93297,"_5":21387,"_28235":93103,"_5797":93298},[],"The hawkBit container exits",{"_6892":5360,"_42174":5290,"_29767":93300,"_5":21387,"_28235":93103,"_5797":93301},[],"S3 storage is selected for hawkBit and the bucket is unreachable",{"_6892":5361,"_42174":5290,"_29767":93303,"_5":21387,"_28235":93103,"_5797":93304},[],"Fix the S3 settings, or use `HAWKBIT_ARTIFACT_STORAGE=fs`. hawkBit never falls back to local disk silently.",{"_6892":5362,"_42174":5290,"_29767":93306,"_5":21387,"_28235":93103,"_5797":93307},[],"`/health` answers but WFX calls fail",{"_6892":5363,"_42174":5290,"_29767":93309,"_5":21387,"_28235":93103,"_5797":93310},[],"`/health` does not check dependencies",{"_6892":5364,"_42174":5290,"_29767":93312,"_5":21387,"_28235":93103,"_5797":93313},[],"Check `wfx_endpoint` and that WFX is running.",{"_6892":5365,"_42174":5290,"_29767":93315,"_5":21387,"_28235":93103,"_5797":93316},[],"Debug output shows secrets",{"_6892":5366,"_42174":5290,"_29767":93318,"_5":21387,"_28235":93103,"_5797":93319},[],"`app.logs.level: debug` prints the configuration",{"_6892":5367,"_42174":5290,"_29767":93321,"_5":21387,"_28235":93103,"_5797":93322},[],"Use `info`. See Security.",{"_6892":5368,"_42174":5290,"_29767":93324,"_5":21387,"_28235":93107,"_5797":80915},[],{"_6892":5369,"_42174":5290,"_29767":93326,"_5":21387,"_28235":93107,"_5797":86538},[],{"_6892":5370,"_42174":5290,"_29767":93328,"_5":21387,"_28235":93107,"_5797":93178},[],{"_6892":5371,"_42174":5290,"_29767":93330,"_5":21387,"_28235":93107,"_5797":93331},[],"`501 Not Implemented`",{"_6892":5372,"_42174":5290,"_29767":93333,"_5":21387,"_28235":93107,"_5797":93334},[],"The active backend does not support the operation",{"_6892":5373,"_42174":5290,"_29767":93336,"_5":21387,"_28235":93107,"_5797":93337},[],"Read `GET /updates/v1/capabilities`. In `hawkbit` mode, `POST .../swu` and `.../package` always answer `501`: build the modules in the catalog.",{"_6892":5374,"_42174":5290,"_29767":93339,"_5":21387,"_28235":93107,"_5797":93340},[],"`409` `update pack version X is already built; create a new version ...`",{"_6892":5375,"_42174":5290,"_29767":93342,"_5":21387,"_28235":93107,"_5797":93343},[],"You changed a built version",{"_6892":5376,"_42174":5290,"_29767":93345,"_5":21387,"_28235":93107,"_5797":93346},[],"Native mode: `POST .../new` with `{\"version\":\"x.y.z\"}` greater than the current one, then upload the sw-description again (it is not carried over) and give any re-uploaded artifact a higher `version`. `hawkbit` mode: see the next row.",{"_6892":5377,"_42174":5290,"_29767":93348,"_5":21387,"_28235":93107,"_5797":93349},[],"`hawkbit mode: cannot ... here — a software module linked to a distribution set is frozen` (`400`)",{"_6892":5378,"_42174":5290,"_29767":93351,"_5":21387,"_28235":93107,"_5797":93352},[],"Pack-scoped edits are refused in `hawkbit` mode",{"_6892":5379,"_42174":5290,"_29767":93354,"_5":21387,"_28235":93107,"_5797":93355},[],"Unlink the module, change and build it in the catalog, link it again. Or release a new version of the module and create a pack from it under another name: pack names are unique per group, and an `os` module cannot be swapped on an existing pack. See hawkBit mode.",{"_6892":5380,"_42174":5290,"_29767":93357,"_5":21387,"_28235":93107,"_5797":93358},[],"`409` `... is being built or changed by another request; retry when it finishes`",{"_6892":5381,"_42174":5290,"_29767":93360,"_5":21387,"_28235":93107,"_5797":93361},[],"Two builds, or a build and a change, on the same pack or module",{"_6892":5382,"_42174":5290,"_29767":93363,"_5":21387,"_28235":93107,"_5797":93364},[],"Wait and retry. The lock is released when the operation ends or fails.",{"_6892":5383,"_42174":5290,"_29767":93366,"_5":21387,"_28235":93107,"_5797":93367},[],"`409` on create",{"_6892":5384,"_42174":5290,"_29767":93369,"_5":21387,"_28235":93107,"_5797":93370},[],"A pack with that name exists in the group",{"_6892":5385,"_42174":5290,"_29767":93372,"_5":21387,"_28235":93107,"_5797":93373},[],"Pick another name.",{"_6892":5386,"_42174":5290,"_29767":93375,"_5":21387,"_28235":93107,"_5797":93376},[],"`413` `file \"x\" is N MiB; the maximum upload size is M MiB`",{"_6892":5387,"_42174":5290,"_29767":93378,"_5":21387,"_28235":93107,"_5797":93379},[],"The file exceeds `max_artifact_size_mb`",{"_6892":5388,"_42174":5290,"_29767":93381,"_5":21387,"_28235":93107,"_5797":93382},[],"Raise it, and the limits of every proxy in front. See Operations. A proxy answering `413` with its own body (for example nginx's default 1 MiB) is the proxy, not the service.",{"_6892":5389,"_42174":5290,"_29767":93384,"_5":21387,"_28235":93107,"_5797":93385},[],"Upload `400` mentioning content that contradicts the filename",{"_6892":5390,"_42174":5290,"_29767":93387,"_5":21387,"_28235":93107,"_5797":93388},[],"A file named `.swu` is not a SWU",{"_6892":5391,"_42174":5290,"_29767":93390,"_5":21387,"_28235":93107,"_5797":93391},[],"Upload a real `.swu`, or rename the file.",{"_6892":5392,"_42174":5290,"_29767":93393,"_5":21387,"_28235":93107,"_5797":93394},[],"Artifact upload fails with `500` and `version X must be greater than the current latest version`",{"_6892":5393,"_42174":5290,"_29767":93396,"_5":21387,"_28235":93107,"_5797":93397},[],"Artifact names are global, and a name can only be reused with a higher `version`",{"_6892":5394,"_42174":5290,"_29767":93399,"_5":21387,"_28235":93107,"_5797":93400},[],"Give the new file a higher `version`, or a new artifact name.",{"_6892":5395,"_42174":5290,"_29767":93402,"_5":21387,"_28235":93107,"_5797":93403},[],"`Cannot create launch: update pack 'x' has not been built yet` (`400`)",{"_6892":5396,"_42174":5290,"_29767":93405,"_5":21387,"_28235":93107,"_5797":93406},[],"The pack is still a draft",{"_6892":5397,"_42174":5290,"_29767":93408,"_5":21387,"_28235":93107,"_5797":93409},[],"Build it first.",{"_6892":5398,"_42174":5290,"_29767":93411,"_5":21387,"_28235":93107,"_5797":93412},[],"`Cannot create launch: update pack \"x\" is per-device encrypted and only N of M devices have a package` (`400`)",{"_6892":5399,"_42174":5290,"_29767":93414,"_5":21387,"_28235":93107,"_5797":93415},[],"Some devices have no key",{"_6892":5400,"_42174":5290,"_29767":93417,"_5":21387,"_28235":93107,"_5797":93418},[],"Assign the missing keys and build again. There is no override.",{"_6892":5401,"_42174":5290,"_29767":93420,"_5":21387,"_28235":93107,"_5797":93421},[],"`approval_threshold and error_threshold must be between 0 and 100`",{"_6892":5402,"_42174":5290,"_29767":93423,"_5":21387,"_28235":93107,"_5797":93424},[],"Thresholds are percentages",{"_6892":5403,"_42174":5290,"_29767":93426,"_5":21387,"_28235":93107,"_5797":93427},[],"Use `0`-`100`.",{"_6892":5404,"_42174":5290,"_29767":93429,"_5":21387,"_28235":93107,"_5797":93430},[],"`launch X is paused; resume it first` (`400`)",{"_6892":5405,"_42174":5290,"_29767":93432,"_5":21387,"_28235":93107,"_5797":93433},[],"The launch was paused",{"_6892":5406,"_42174":5290,"_29767":93435,"_5":21387,"_28235":93107,"_5797":93436},[],"Call `resume`.",{"_6892":5407,"_42174":5290,"_29767":93438,"_5":21387,"_28235":93107,"_5797":93439},[],"`test device X cannot act as this group's canary: device X does not exist` (`hawkbit` mode)",{"_6892":5408,"_42174":5290,"_29767":93441,"_5":21387,"_28235":93107,"_5797":93442},[],"The canary check runs before the group's devices exist in hawkBit",{"_6892":5409,"_42174":5290,"_29767":93444,"_5":21387,"_28235":93107,"_5797":93445},[],"Run a dry run without `test_device_id` first (`POST .../launch?dry_run=true`), which registers the devices as targets.",{"_6892":5410,"_42174":5290,"_29767":93447,"_5":21387,"_28235":93107,"_5797":93448},[],"The device registry or KMS answers `401`",{"_6892":5411,"_42174":5290,"_29767":93450,"_5":21387,"_28235":93107,"_5797":93451},[],"The service always sends `X-Principal-ID: admin-mode`, and the gateway in between rejects it",{"_6892":5412,"_42174":5290,"_29767":93453,"_5":21387,"_28235":93107,"_5797":93454},[],"Point `dms_endpoint` and `kms_endpoint` at the internal service addresses, or allow that header.",{"_6892":5413,"_42174":5290,"_29767":93456,"_5":21387,"_28235":93111,"_5797":80915},[],{"_6892":5414,"_42174":5290,"_29767":93458,"_5":21387,"_28235":93111,"_5797":86538},[],{"_6892":5415,"_42174":5290,"_29767":93460,"_5":21387,"_28235":93111,"_5797":93178},[],{"_6892":5416,"_42174":5290,"_29767":93462,"_5":21387,"_28235":93111,"_5797":93463},[],"`no sw-descriptor uploaded for update pack \"x\" vN`",{"_6892":5417,"_42174":5290,"_29767":93465,"_5":21387,"_28235":93111,"_5797":93466},[],"The version has no sw-description (each version needs its own)",{"_6892":5418,"_42174":5290,"_29767":93468,"_5":21387,"_28235":93111,"_5797":93469},[],"Upload it.",{"_6892":5419,"_42174":5290,"_29767":93471,"_5":21387,"_28235":93111,"_5797":93472},[],"`failed to read binaries directory` or `binaries directory is empty`",{"_6892":5420,"_42174":5290,"_29767":93474,"_5":21387,"_28235":93111,"_5797":93475},[],"`native` mode: nothing was staged, because the build body has no `selected_artifact_ids`",{"_6892":5421,"_42174":5290,"_29767":93477,"_5":21387,"_28235":93111,"_5797":93478},[],"Pass the artifact IDs. See the publish guide.",{"_6892":5422,"_42174":5290,"_29767":93480,"_5":21387,"_28235":93111,"_5797":93481},[],"`swugenerator failed: exit status N`",{"_6892":5423,"_42174":5290,"_29767":93483,"_5":21387,"_28235":93111,"_5797":93484},[],"The tool rejected its input. Its own message is in the service log",{"_6892":5424,"_42174":5290,"_29767":93486,"_5":21387,"_28235":93111,"_5797":93487},[],"Check the sw-description, the file names it references, the algorithm spelling (`aes-256-gcm`, hyphens required) and the key length.",{"_6892":5425,"_42174":5290,"_29767":93489,"_5":21387,"_28235":93111,"_5797":93490},[],"`signing requested but sign_script_path/kms endpoint are not configured`",{"_6892":5426,"_42174":5290,"_29767":93492,"_5":21387,"_28235":93111,"_5797":93493},[],"A `.swu` was asked to be signed without both settings",{"_6892":5427,"_42174":5290,"_29767":93495,"_5":21387,"_28235":93111,"_5797":93496},[],"Set `sign_script_path` and `kms_endpoint`.",{"_6892":5428,"_42174":5290,"_29767":93498,"_5":21387,"_28235":93111,"_5797":93499},[],"`signing requires key id, algorithm and certificate together`",{"_6892":5429,"_42174":5290,"_29767":93501,"_5":21387,"_28235":93111,"_5797":93502},[],"A partial signature request",{"_6892":5430,"_42174":5290,"_29767":93504,"_5":21387,"_28235":93111,"_5797":93505},[],"Send all three `signature_*` fields.",{"_6892":5431,"_42174":5290,"_29767":93507,"_5":21387,"_28235":93111,"_5797":93508},[],"`failed to sign version manifest: the KMS did not return a PKCS7/CMS signature`",{"_6892":5432,"_42174":5290,"_29767":93510,"_5":21387,"_28235":93111,"_5797":93511},[],"The KMS answered with a bare signature",{"_6892":5433,"_42174":5290,"_29767":93513,"_5":21387,"_28235":93111,"_5797":93514},[],"Use a KMS version that returns CMS. See Signing and encryption.",{"_6892":5434,"_42174":5290,"_29767":93516,"_5":21387,"_28235":93111,"_5797":93517},[],"`symKMS SDK client is not configured`",{"_6892":5435,"_42174":5290,"_29767":93519,"_5":21387,"_28235":93111,"_5797":93520},[],"`symkms_endpoint` is empty",{"_6892":5436,"_42174":5290,"_29767":93522,"_5":21387,"_28235":93111,"_5797":93523},[],"Set it. In `hawkbit` mode also set the `symkms` block so the routes exist.",{"_6892":5437,"_42174":5290,"_29767":93525,"_5":21387,"_28235":93111,"_5797":93526},[],"`failed to fetch key \"k\" via symKMS`",{"_6892":5438,"_42174":5290,"_29767":93528,"_5":21387,"_28235":93111,"_5797":93529},[],"Wrong key ID or `user`, or the endpoint points at another instance",{"_6892":5439,"_42174":5290,"_29767":93531,"_5":21387,"_28235":93111,"_5797":93532},[],"The key belongs to its `user_id`; `symkms_endpoint` must be this instance's own address and port.",{"_6892":5440,"_42174":5290,"_29767":93534,"_5":21387,"_28235":93111,"_5797":93535},[],"Per-device build fails mentioning `encrypted = true`",{"_6892":5441,"_42174":5290,"_29767":93537,"_5":21387,"_28235":93111,"_5797":93538},[],"No artifact in the sw-description is marked `encrypted = true;`",{"_6892":5442,"_42174":5290,"_29767":93540,"_5":21387,"_28235":93111,"_5797":93541},[],"Mark the artifacts to encrypt.",{"_6892":5443,"_42174":5290,"_29767":93543,"_5":21387,"_28235":93111,"_5797":93544},[],"`no devices found for DMS X` or `none of the N devices ... have a key assigned for firmware-encryption`",{"_6892":5444,"_42174":5290,"_29767":93546,"_5":21387,"_28235":93111,"_5797":93547},[],"The group has no devices in the registry, or none has a key",{"_6892":5445,"_42174":5290,"_29767":93549,"_5":21387,"_28235":93111,"_5797":93550},[],"Check the group in Lamassu IoT and `dms_endpoint`; assign `firmware-encryption` keys.",{"_6892":5446,"_42174":5290,"_29767":93552,"_5":21387,"_28235":93111,"_5797":93553},[],"`hawkbit mode: this deployment has no SWU builder configured` (`501`)",{"_6892":5447,"_42174":5290,"_29767":93555,"_5":21387,"_28235":93111,"_5797":93556},[],"`swugenerator_path` is empty",{"_6892":5448,"_42174":5290,"_29767":93558,"_5":21387,"_28235":93111,"_5797":93559},[],"Set it, or upload a prebuilt `.swu` module.",{"_6892":5449,"_42174":5290,"_29767":93561,"_5":21387,"_28235":93111,"_5797":93562},[],"`hawkbit mode: this deployment has no SymKMS configured` or `... no KMS endpoint configured` (`501`)",{"_6892":5450,"_42174":5290,"_29767":93564,"_5":21387,"_28235":93111,"_5797":93565},[],"Encryption or signing asked without `symkms_endpoint` or `kms_endpoint`",{"_6892":5451,"_42174":5290,"_29767":93567,"_5":21387,"_28235":93111,"_5797":93568},[],"Set them.",{"_6892":5452,"_42174":5290,"_29767":93570,"_5":21387,"_28235":93111,"_5797":93571},[],"`software module \"x\" ... is N MB and encrypting it needs about M MB in memory`",{"_6892":5453,"_42174":5290,"_29767":93573,"_5":21387,"_28235":93111,"_5797":93574},[],"`build_memory_limit_mb` refuses the build",{"_6892":5454,"_42174":5290,"_29767":93576,"_5":21387,"_28235":93111,"_5797":93577},[],"Sign without encrypting, split the file, or raise the limit together with the pod's memory.",{"_6892":5455,"_42174":5290,"_29767":93579,"_5":21387,"_28235":93111,"_5797":93580},[],"`... is already built; ... release a new version of it to build again`",{"_6892":5456,"_42174":5290,"_29767":93582,"_5":21387,"_28235":93111,"_5797":93583},[],"A build replaces the module's input files",{"_6892":5457,"_42174":5290,"_29767":93585,"_5":21387,"_28235":93111,"_5797":93586},[],"Create a new version of the module.",{"_6892":5458,"_42174":5290,"_29767":93588,"_5":21387,"_28235":93115,"_5797":80915},[],{"_6892":5459,"_42174":5290,"_29767":93590,"_5":21387,"_28235":93115,"_5797":86538},[],{"_6892":5460,"_42174":5290,"_29767":93592,"_5":21387,"_28235":93115,"_5797":93178},[],{"_6892":5461,"_42174":5290,"_29767":93594,"_5":21387,"_28235":93115,"_5797":93595},[],"`404` `SWU not available for device D on pack \"x\" vN`",{"_6892":5462,"_42174":5290,"_29767":93597,"_5":21387,"_28235":93115,"_5797":93598},[],"The pack is per-device encrypted and has no package for that device (its key was missing at build time, or the pack inherited per-device mode from an earlier version), or the build file is gone from the store",{"_6892":5463,"_42174":5290,"_29767":93600,"_5":21387,"_28235":93115,"_5797":93601},[],"Assign the device's key and build a new version. To avoid inheriting, use a separate pack for each encryption variant (see Limitations).",{"_6892":5464,"_42174":5290,"_29767":93603,"_5":21387,"_28235":93115,"_5797":93604},[],"Startup: `presign needs its own credential`",{"_6892":5465,"_42174":5290,"_29767":93606,"_5":21387,"_28235":93115,"_5797":93607},[],"`presign` is enabled without a signing credential",{"_6892":5466,"_42174":5290,"_29767":93609,"_5":21387,"_28235":93115,"_5797":93610},[],"Set `presign.access_key_id[_file]` and `secret_access_key[_file]`, a read-only pair.",{"_6892":5467,"_42174":5290,"_29767":93612,"_5":21387,"_28235":93115,"_5797":93613},[],"Startup: `the presign credential can WRITE`",{"_6892":5468,"_42174":5290,"_29767":93615,"_5":21387,"_28235":93115,"_5797":93616},[],"The signing credential has write access",{"_6892":5469,"_42174":5290,"_29767":93618,"_5":21387,"_28235":93115,"_5797":93619},[],"Give it a read-only policy on the objects it serves.",{"_6892":5470,"_42174":5290,"_29767":93621,"_5":21387,"_28235":93115,"_5797":93622},[],"Startup: `presign signs with the storage's own credential`",{"_6892":5471,"_42174":5290,"_29767":93624,"_5":21387,"_28235":93115,"_5797":93625},[],"Same key as the storage",{"_6892":5472,"_42174":5290,"_29767":93627,"_5":21387,"_28235":93115,"_5797":93628},[],"Create a separate read-only key.",{"_6892":5473,"_42174":5290,"_29767":93630,"_5":21387,"_28235":93115,"_5797":93631},[],"Startup: `the store does not accept the presign credential`",{"_6892":5474,"_42174":5290,"_29767":93633,"_5":21387,"_28235":93115,"_5797":93634},[],"The store does not know the key, or the signature does not match",{"_6892":5475,"_42174":5290,"_29767":93636,"_5":21387,"_28235":93115,"_5797":93637},[],"Create the user in the store; check region and endpoint.",{"_6892":5476,"_42174":5290,"_29767":93639,"_5":21387,"_28235":93115,"_5797":93640},[],"Startup: `presign cannot be combined with client-side encryption`",{"_6892":5477,"_42174":5290,"_29767":93642,"_5":21387,"_28235":93115,"_5797":93643},[],"`encryption.type` is not `none` on that block",{"_6892":5478,"_42174":5290,"_29767":93645,"_5":21387,"_28235":93115,"_5797":93646},[],"Use store-side encryption, or disable `presign`.",{"_6892":5479,"_42174":5290,"_29767":93648,"_5":21387,"_28235":93115,"_5797":93649},[],"Startup: `presign.public_endpoint must be an http(s) origin`",{"_6892":5480,"_42174":5290,"_29767":93651,"_5":21387,"_28235":93115,"_5797":93652},[],"The value has no scheme, or has a path",{"_6892":5481,"_42174":5290,"_29767":93654,"_5":21387,"_28235":93115,"_5797":93655},[],"Use an origin such as `https://updates.example.com`.",{"_6892":5482,"_42174":5290,"_29767":93657,"_5":21387,"_28235":93115,"_5797":93658},[],"The device gets `403` from the store after the `302`",{"_6892":5483,"_42174":5290,"_29767":93660,"_5":21387,"_28235":93115,"_5797":93661},[],"The URL expired before the device started the GET, the signed `Host` is not what the device used (`public_endpoint` wrong), the signing key cannot read that prefix, or clocks differ",{"_6892":5484,"_42174":5290,"_29767":93663,"_5":21387,"_28235":93115,"_5797":93664},[],"Retry (a fresh URL is issued per request); check `ttl`, `public_endpoint` and the key's policy.",{"_6892":5485,"_42174":5290,"_29767":93666,"_5":21387,"_28235":93115,"_5797":93667},[],"Downloads stream through the service despite `presign`",{"_6892":5486,"_42174":5290,"_29767":93669,"_5":21387,"_28235":93115,"_5797":93670},[],"A `HEAD` request, an artifact download by ID in `native` mode, a store without `presign` for that block, or the signing failed (logged)",{"_6892":5487,"_42174":5290,"_29767":93672,"_5":21387,"_28235":93115,"_5797":93673},[],"Only builds in `native` mode and the S3 plugin objects in `hawkbit` mode are redirected.",{"_6892":5488,"_42174":5290,"_29767":93675,"_5":21387,"_28235":93119,"_5797":84046},[],{"_6892":5489,"_42174":5290,"_29767":93677,"_5":21387,"_28235":93119,"_5797":86538},[],{"_6892":5490,"_42174":5290,"_29767":93679,"_5":21387,"_28235":93119,"_5797":93178},[],{"_6892":5491,"_42174":5290,"_29767":93681,"_5":21387,"_28235":93119,"_5797":93682},[],"Devices cannot download the `.swu` (`native` mode)",{"_6892":5492,"_42174":5290,"_29767":93684,"_5":21387,"_28235":93119,"_5797":93685},[],"`update_domain` is not reachable from the device, or is not the full `.../updates/v1/` base with a trailing slash",{"_6892":5493,"_42174":5290,"_29767":93687,"_5":21387,"_28235":93119,"_5797":93688},[],"Use an address the device can resolve. The Helm chart default lacks `/updates`.",{"_6892":5494,"_42174":5290,"_29767":93690,"_5":21387,"_28235":93119,"_5797":93691},[],"`hawkbit` mode: a device gets `401` from DDI",{"_6892":5495,"_42174":5290,"_29767":93693,"_5":21387,"_28235":93119,"_5797":93694},[],"hawkBit refuses devices that do not authenticate",{"_6892":5496,"_42174":5290,"_29767":93696,"_5":21387,"_28235":93119,"_5797":93697},[],"Enable and use a hawkBit device authenticator. See hawkBit mode.",{"_6892":5497,"_42174":5290,"_29767":93699,"_5":21387,"_28235":93119,"_5797":93700},[],"`hawkbit` mode: a device gets `429`",{"_6892":5498,"_42174":5290,"_29767":93702,"_5":21387,"_28235":93119,"_5797":93703},[],"hawkBit's own DoS filter, which limits how often a device may call it",{"_6892":5499,"_42174":5290,"_29767":93705,"_5":21387,"_28235":93119,"_5797":93706},[],"Slow the polling and feedback of the device.",{"_6892":5500,"_42174":5290,"_29767":93708,"_5":21387,"_28235":93119,"_5797":93709},[],"`hawkbit` mode: the launch stays `running` with no progress",{"_6892":5501,"_42174":5290,"_29767":93711,"_5":21387,"_28235":93119,"_5797":93712},[],"The devices never contacted hawkBit, or they poll a different hawkBit",{"_6892":5502,"_42174":5290,"_29767":93714,"_5":21387,"_28235":93119,"_5797":93715},[],"Check which hawkBit the devices poll, and that the targets exist. A rollout group cannot advance until its devices poll.",{"_6892":5503,"_42174":5290,"_29767":93717,"_5":21387,"_28235":93119,"_5797":93718},[],"`hawkbit` mode: devices are not found in the group",{"_6892":5504,"_42174":5290,"_29767":93720,"_5":21387,"_28235":93119,"_5797":93721},[],"`dms_endpoint` is not set, so groups are the `group:<id>` target tags",{"_6892":5505,"_42174":5290,"_29767":93723,"_5":21387,"_28235":93119,"_5797":93724},[],"Set `dms_endpoint`, or tag the targets.",{"_6892":5506,"_42174":5290,"_29767":93726,"_5":21387,"_28235":93119,"_5797":93727},[],"A `phased` launch stays at `CREATED` (`native` mode)",{"_6892":5507,"_42174":5290,"_29767":93729,"_5":21387,"_28235":93119,"_5797":93730},[],"In the `phased` workflow some steps are made by WFX or an operator",{"_6892":5508,"_42174":5290,"_29767":93732,"_5":21387,"_28235":93119,"_5797":93733},[],"Confirm them through WFX, or use `direct`.",{"_6892":5509,"_42174":5290,"_29767":93735,"_5":21387,"_28235":93119,"_5797":93736},[],"A `non-swu` launch shows SWU states (`native` mode)",{"_6892":5510,"_42174":5290,"_29767":93738,"_5":21387,"_28235":93119,"_5797":93739},[],"It was created with `workflow_type: direct`",{"_6892":5511,"_42174":5290,"_29767":93741,"_5":21387,"_28235":93119,"_5797":93742},[],"Use `download-install`.",{"_6892":5512,"_42174":5290,"_29767":93744,"_5":21387,"_28235":93119,"_5797":93745},[],"The device installs and shows the old version",{"_6892":5513,"_42174":5290,"_29767":93747,"_5":21387,"_28235":93119,"_5797":93748},[],"The payload version was not changed",{"_6892":5514,"_42174":5290,"_29767":93750,"_5":21387,"_28235":93119,"_5797":93751},[],"Bump the version before building.",{"_6892":5515,"_42174":5290,"_29767":93753,"_5":21387,"_28235":93119,"_5797":93754},[],"The device ignores new deployments",{"_6892":5516,"_42174":5290,"_29767":93756,"_5":21387,"_28235":93119,"_5797":93757},[],"SWUpdate keeps the update state of an earlier install as pending test (`ustate=1`) and refuses a new one",{"_6892":5517,"_42174":5290,"_29767":93759,"_5":21387,"_28235":93119,"_5797":93760},[],"Confirm or reset the device's update state. This is a device setting, not a service one.",{"_6892":5518,"_42174":5290,"_29767":93762,"_5":21387,"_28235":93119,"_5797":93763},[],"The device rejects the `.swu` and the error mentions decryption or an invalid image",{"_6892":5519,"_42174":5290,"_29767":93765,"_5":21387,"_28235":93119,"_5797":93766},[],"The `.swu` is unsigned while the device requires a signature, or the signature is not CMS",{"_6892":5520,"_42174":5290,"_29767":93768,"_5":21387,"_28235":93119,"_5797":93769},[],"Sign it with a KMS that returns CMS. A signature failure can be reported as an encryption error.",{"_6892":5521,"_42174":5290,"_29767":93771,"_5":21387,"_28235":93119,"_5797":93772},[],"The device fails to decrypt",{"_6892":5522,"_42174":5290,"_29767":93774,"_5":21387,"_28235":93119,"_5797":93775},[],"The key used to build differs from the device's key, or the algorithm spelling differs",{"_6892":5523,"_42174":5290,"_29767":93777,"_5":21387,"_28235":93119,"_5797":93778},[],"Use the same key and algorithm. Check the assignment in SymKMS.",{"_6892":5524,"_42174":5290,"_29767":93780,"_5":21387,"_28235":93123,"_5797":84046},[],{"_6892":5525,"_42174":5290,"_29767":93782,"_5":21387,"_28235":93123,"_5797":86538},[],{"_6892":5526,"_42174":5290,"_29767":93784,"_5":21387,"_28235":93123,"_5797":93178},[],{"_6892":5527,"_42174":5290,"_29767":93786,"_5":21387,"_28235":93123,"_5797":93787},[],"Pods cannot start on different nodes",{"_6892":5528,"_42174":5290,"_29767":93789,"_5":21387,"_28235":93123,"_5797":93790},[],"The `ReadWriteOnce` volume (both modes while `persistence.enabled` is true)",{"_6892":5529,"_42174":5290,"_29767":93792,"_5":21387,"_28235":93123,"_5797":93793},[],"Set `persistence.enabled: false` and move `artifacts`, `builds` and `symkms` to S3. See Operations.",{"_6892":5530,"_42174":5290,"_29767":93795,"_5":21387,"_28235":93123,"_5797":93796},[],"Campaign batches never advance (`native` mode)",{"_6892":5531,"_42174":5290,"_29767":93798,"_5":21387,"_28235":93123,"_5797":93799},[],"Leader election is failing, or WFX events are not arriving",{"_6892":5532,"_42174":5290,"_29767":93801,"_5":21387,"_28235":93123,"_5797":93802},[],"Check the Leases and the RBAC, or set `leaderElection.mode: database`. The log line `leadership acquired` appears on the leader.",{"_6892":5533,"_42174":5290,"_29767":93804,"_5":21387,"_28235":93123,"_5797":93805},[],"Scheduled launches never start (`native` mode)",{"_6892":5534,"_42174":5290,"_29767":93807,"_5":21387,"_28235":93123,"_5797":93808},[],"The same background work, which runs on the leader",{"_6892":5535,"_42174":5290,"_29767":93810,"_5":21387,"_28235":93123,"_5797":93811},[],"As above.",{"_6892":5536,"_42174":5290,"_29767":93813,"_5":21387,"_28235":93123,"_5797":93814},[],"Per-device builds are slow",{"_6892":5537,"_42174":5290,"_29767":93816,"_5":21387,"_28235":93123,"_5797":93817},[],"The CPU limit",{"_6892":5538,"_42174":5290,"_29767":93819,"_5":21387,"_28235":93123,"_5797":93820},[],"Raise it. See Resource sizing.",{"_6892":5539,"_42174":5290,"_29767":93822,"_5":21387,"_28235":93123,"_5797":93823},[],"The pod is killed during an upload or an encrypted build",{"_6892":5540,"_42174":5290,"_29767":93825,"_5":21387,"_28235":93123,"_5797":93826},[],"Memory limit, or the temporary disk is full",{"_6892":5541,"_42174":5290,"_29767":93828,"_5":21387,"_28235":93123,"_5797":93829},[],"Size memory for the largest file you encrypt, and give `TMPDIR` room.",{"_6892":5542,"_42174":5290,"_29767":93831,"_5":21387,"_28235":93127,"_5797":93832},[],"Raise `app.logs.level` to `debug`, but remember that it prints secrets.",{"_6892":5543,"_42174":5290,"_29767":93834,"_5":21387,"_28235":93127,"_5797":93835},[],"`GET /updates/v1/capabilities` shows the active backend and what it supports.",{"_6892":5544,"_42174":5290,"_29767":93837,"_5":21387,"_28235":93127,"_5797":93838},[],"Each replica logs which one leads (`leadership acquired`, `is the leader, standing by`).",{"_6892":5545,"_42174":5290,"_29767":93840,"_5":21387,"_28235":93127,"_5797":93841},[],"In `hawkbit` mode, inspect what the service created through hawkBit's Management API (port `8090` in Compose, with the Basic Auth credentials of the configuration). Each hawkBit instance has its own data: query the one named in `hawkbit.base_url`.",{"_6892":5546,"_42174":5546,"_5":21817,"_5797":93843,"_42654":93844,"_29767":93845,"_28235":5546},"3.8.0 to 4.0.0",[77248,89011],[],{"_6892":5547,"_42174":5546,"_29767":93847,"_5":21387,"_28235":5546,"_5797":93848},[],"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result.",{"_6892":5548,"_42174":5546,"_5":42651,"_29767":93850,"_28235":93851,"_5797":93852},[],"/docs/pr-preview/pr-56/upgrades/3-8-0-to-4-0-0#architecture-changes","Architecture changes",{"_6892":5549,"_42174":5546,"_5":42651,"_29767":93854,"_28235":93855,"_5797":93856},[],"/docs/pr-preview/pr-56/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_6892":5550,"_42174":5546,"_5":42651,"_29767":93858,"_28235":93859,"_5797":93860},[],"/docs/pr-preview/pr-56/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_6892":5551,"_42174":5546,"_5":42651,"_29767":93862,"_28235":93863,"_5797":93864},[],"/docs/pr-preview/pr-56/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_6892":5552,"_42174":5546,"_5":42651,"_29767":93866,"_28235":93867,"_5797":93868},[],"/docs/pr-preview/pr-56/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_6892":5553,"_42174":5546,"_5":42651,"_29767":93870,"_28235":93871,"_5797":93872},[],"/docs/pr-preview/pr-56/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_6892":5554,"_42174":5546,"_5":42651,"_29767":93874,"_28235":93875,"_5797":93876},[],"/docs/pr-preview/pr-56/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_6892":5555,"_42174":5546,"_5":42651,"_29767":93878,"_28235":93879,"_5797":93880},[],"/docs/pr-preview/pr-56/upgrades/3-8-0-to-4-0-0#helm-chart-and-values","Helm chart and values",{"_6892":5556,"_42174":5546,"_5":42651,"_29767":93882,"_28235":93883,"_5797":93884},[],"/docs/pr-preview/pr-56/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_6892":5557,"_42174":5546,"_5":42651,"_29767":93886,"_28235":93887,"_5797":93888},[],"/docs/pr-preview/pr-56/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_6892":5558,"_42174":5546,"_5":42651,"_29767":93890,"_28235":93891,"_5797":93892},[],"/docs/pr-preview/pr-56/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_6892":5559,"_42174":5546,"_5":42651,"_29767":93894,"_28235":93895,"_5797":93896},[],"/docs/pr-preview/pr-56/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_6892":5560,"_42174":5546,"_5":42651,"_29767":93898,"_28235":93899,"_5797":93900},[],"/docs/pr-preview/pr-56/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_6892":5561,"_42174":5546,"_5":42651,"_29767":93902,"_28235":93903,"_5797":93904},[],"/docs/pr-preview/pr-56/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_6892":5562,"_42174":5546,"_5":42651,"_29767":93906,"_28235":93907,"_5797":93908},[],"/docs/pr-preview/pr-56/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_6892":5563,"_42174":5546,"_5":42651,"_29767":93910,"_28235":93911,"_5797":93912},[],"/docs/pr-preview/pr-56/upgrades/3-8-0-to-4-0-0#data-and-storage","Data and storage",{"_6892":5564,"_42174":5546,"_5":42651,"_29767":93914,"_28235":93915,"_5797":93916},[],"/docs/pr-preview/pr-56/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_6892":5565,"_42174":5546,"_5":42651,"_29767":93918,"_28235":93919,"_5797":93920},[],"/docs/pr-preview/pr-56/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","SQLite storage removed",{"_6892":5566,"_42174":5546,"_5":42651,"_29767":93922,"_28235":93923,"_5797":93924},[],"/docs/pr-preview/pr-56/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_6892":5567,"_42174":5546,"_5":42651,"_29767":93926,"_28235":93927,"_5797":93928},[],"/docs/pr-preview/pr-56/upgrades/3-8-0-to-4-0-0#apis-and-stored-configuration","APIs and stored configuration",{"_6892":5568,"_42174":5546,"_5":42651,"_29767":93930,"_28235":93931,"_5797":93932},[],"/docs/pr-preview/pr-56/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_6892":5569,"_42174":5546,"_5":42651,"_29767":93934,"_28235":93935,"_5797":93936},[],"/docs/pr-preview/pr-56/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_6892":5570,"_42174":5546,"_5":42651,"_29767":93938,"_28235":93939,"_5797":93940},[],"/docs/pr-preview/pr-56/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_6892":5571,"_42174":5546,"_5":42651,"_29767":93942,"_28235":93943,"_5797":93944},[],"/docs/pr-preview/pr-56/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_6892":5572,"_42174":5546,"_5":42651,"_29767":93946,"_28235":93947,"_5797":93948},[],"/docs/pr-preview/pr-56/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_6892":5573,"_42174":5546,"_5":42651,"_29767":93950,"_28235":93951,"_5797":93952},[],"/docs/pr-preview/pr-56/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_6892":5574,"_42174":5546,"_5":42651,"_29767":93954,"_28235":93955,"_5797":93956},[],"/docs/pr-preview/pr-56/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_6892":5575,"_42174":5546,"_5":42651,"_29767":93958,"_28235":93959,"_5797":93960},[],"/docs/pr-preview/pr-56/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_6892":5576,"_42174":5546,"_5":42651,"_29767":93962,"_28235":93963,"_5797":93964},[],"/docs/pr-preview/pr-56/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_6892":5577,"_42174":5546,"_5":42651,"_29767":93966,"_28235":93967,"_5797":93968},[],"/docs/pr-preview/pr-56/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_6892":5578,"_42174":5546,"_5":42651,"_29767":93970,"_28235":93971,"_5797":93972},[],"/docs/pr-preview/pr-56/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_6892":5579,"_42174":5546,"_5":42651,"_29767":93974,"_28235":93975,"_5797":93976},[],"/docs/pr-preview/pr-56/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_6892":5580,"_42174":5546,"_5":42651,"_29767":93978,"_28235":93979,"_5797":93980},[],"/docs/pr-preview/pr-56/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_6892":5581,"_42174":5546,"_5":42651,"_29767":93982,"_28235":93983,"_5797":81275},[],"/docs/pr-preview/pr-56/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_6892":5582,"_42174":5546,"_5":42651,"_29767":93985,"_28235":93986,"_5797":93987},[],"/docs/pr-preview/pr-56/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_6892":5583,"_42174":5546,"_5":42651,"_29767":93989,"_28235":93990,"_5797":93991},[],"/docs/pr-preview/pr-56/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_6892":5584,"_42174":5546,"_29767":93993,"_5":21387,"_28235":5546,"_5797":93994},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_6892":5585,"_42174":5546,"_29767":93996,"_5":21387,"_28235":5546,"_5797":93997},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_6892":5586,"_42174":5546,"_29767":93999,"_5":21387,"_28235":5546,"_5797":94000},[],"Architecture changes: what is different in 4.0.0 and what the upgrade migrates on its own.",{"_6892":5587,"_42174":5546,"_29767":94002,"_5":21387,"_28235":5546,"_5797":94003},[],"Breaking changes: every change that can break a 3.8.0 deployment, who it affects and what to do.",{"_6892":5588,"_42174":5546,"_29767":94005,"_5":21387,"_28235":5546,"_5797":94006},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_6892":5589,"_42174":5546,"_29767":94008,"_5":21387,"_28235":5546,"_5797":94009},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_6892":5590,"_42174":5546,"_29767":94011,"_5":21387,"_28235":5546,"_5797":94012},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_6892":5591,"_42174":5546,"_29767":94014,"_5":21387,"_28235":93855,"_5797":94015},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_6892":5592,"_42174":5546,"_29767":94017,"_5":21387,"_28235":93855,"_5797":94018},[],"PostgreSQL is now the only storage engine. SQLite support is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0.",{"_6892":5593,"_42174":5546,"_29767":94020,"_5":21387,"_28235":93859,"_5797":94021},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_6892":5594,"_42174":5546,"_29767":94023,"_5":21387,"_28235":93859,"_5797":94024},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and VA roles. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_6892":5595,"_42174":5546,"_29767":94026,"_5":21387,"_28235":93863,"_5797":94027},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. The events endpoint can also stream events over Server-Sent Events (SSE); to fan events out across service instances, each Device Manager instance binds its own durable AMQP queue.",{"_6892":5596,"_42174":5546,"_29767":94029,"_5":21387,"_28235":93867,"_5797":94030},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_6892":5597,"_42174":5546,"_29767":94032,"_5":21387,"_28235":93867,"_5797":94033},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_6892":5598,"_42174":5546,"_29767":94035,"_5":21387,"_28235":93867,"_5797":94036},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_6892":5599,"_42174":5546,"_29767":94038,"_5":21387,"_28235":93867,"_5797":94039},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_6892":5600,"_42174":5546,"_29767":94041,"_5":21387,"_28235":93867,"_5797":94042},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_6892":5601,"_42174":5546,"_29767":94044,"_5":21387,"_28235":93871,"_5797":94045},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_6892":5602,"_42174":5546,"_29767":94047,"_5":21387,"_28235":93871,"_5797":94048},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_6892":5603,"_42174":5546,"_29767":94050,"_5":21387,"_28235":93871,"_5797":94051},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_6892":5604,"_42174":5546,"_29767":94053,"_5":21387,"_28235":93871,"_5797":94054},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_6892":5605,"_42174":5546,"_29767":94056,"_5":21387,"_28235":93871,"_5797":94057},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_6892":5606,"_42174":5546,"_29767":94059,"_5":21387,"_28235":93875,"_5797":94060},[],"Change",{"_6892":5607,"_42174":5546,"_29767":94062,"_5":21387,"_28235":93875,"_5797":94063},[],"Who is affected",{"_6892":5608,"_42174":5546,"_29767":94065,"_5":21387,"_28235":93875,"_5797":94066},[],"Severity",{"_6892":5609,"_42174":5546,"_29767":94068,"_5":21387,"_28235":93875,"_5797":84052},[],{"_6892":5610,"_42174":5546,"_29767":94070,"_5":21387,"_28235":93875,"_5797":93884},[],{"_6892":5611,"_42174":5546,"_29767":94072,"_5":21387,"_28235":93875,"_5797":94073},[],"Helm releases with a filesystem KMS engine or local VA CRL storage",{"_6892":5612,"_42174":5546,"_29767":94075,"_5":21387,"_28235":93875,"_5797":94076},[],"High: KMS and VA start on empty volumes",{"_6892":5613,"_42174":5546,"_29767":94078,"_5":21387,"_28235":93875,"_5797":94079},[],"Copy the data into the new volumes",{"_6892":5614,"_42174":5546,"_29767":94081,"_5":21387,"_28235":93875,"_5797":93888},[],{"_6892":5615,"_42174":5546,"_29767":94083,"_5":21387,"_28235":93875,"_5797":94084},[],"Every Helm release",{"_6892":5616,"_42174":5546,"_29767":94086,"_5":21387,"_28235":93875,"_5797":94087},[],"High: `helm upgrade` fails",{"_6892":5617,"_42174":5546,"_29767":94089,"_5":21387,"_28235":93875,"_5797":94090},[],"Remove or rename legacy keys",{"_6892":5618,"_42174":5546,"_29767":94092,"_5":21387,"_28235":93875,"_5797":93892},[],{"_6892":5619,"_42174":5546,"_29767":94094,"_5":21387,"_28235":93875,"_5797":94095},[],"Every deployment",{"_6892":5620,"_42174":5546,"_29767":94097,"_5":21387,"_28235":93875,"_5797":94098},[],"High: without a bootstrap principal there is no administrator",{"_6892":5621,"_42174":5546,"_29767":94100,"_5":21387,"_28235":93875,"_5797":94101},[],"Configure `services.authz`",{"_6892":5622,"_42174":5546,"_29767":94103,"_5":21387,"_28235":93875,"_5797":93896},[],{"_6892":5623,"_42174":5546,"_29767":94105,"_5":21387,"_28235":93875,"_5797":94084},[],{"_6892":5624,"_42174":5546,"_29767":94107,"_5":21387,"_28235":93875,"_5797":94108},[],"High: `helm upgrade` fails on the old keys",{"_6892":5625,"_42174":5546,"_29767":94110,"_5":21387,"_28235":93875,"_5797":94111},[],"Move JWKS and roles into `services.authz`",{"_6892":5626,"_42174":5546,"_29767":94113,"_5":21387,"_28235":93875,"_5797":93916},[],{"_6892":5627,"_42174":5546,"_29767":94115,"_5":21387,"_28235":93875,"_5797":94116},[],"3.8.0 deployments with per-service databases",{"_6892":5628,"_42174":5546,"_29767":94118,"_5":21387,"_28235":93875,"_5797":94119},[],"High: services find no data, or a migration aborts",{"_6892":5629,"_42174":5546,"_29767":94121,"_5":21387,"_28235":93875,"_5797":94122},[],"Clean duplicate CA IDs and empty `engine_id` values first; move data manually outside Helm",{"_6892":5630,"_42174":5546,"_29767":94124,"_5":21387,"_28235":93875,"_5797":93920},[],{"_6892":5631,"_42174":5546,"_29767":94126,"_5":21387,"_28235":93875,"_5797":94127},[],"Deployments on SQLite, `couch_db` or `dynamo_db`",{"_6892":5632,"_42174":5546,"_29767":94129,"_5":21387,"_28235":93875,"_5797":94130},[],"High: the backend no longer starts with them",{"_6892":5633,"_42174":5546,"_29767":94132,"_5":21387,"_28235":93875,"_5797":94133},[],"Move to PostgreSQL before upgrading",{"_6892":5634,"_42174":5546,"_29767":94135,"_5":21387,"_28235":93875,"_5797":94136},[],"Webhooks with file references",{"_6892":5635,"_42174":5546,"_29767":94138,"_5":21387,"_28235":93875,"_5797":94139},[],"DMSs whose webhook mTLS certificate or key were file paths",{"_6892":5636,"_42174":5546,"_29767":94141,"_5":21387,"_28235":93875,"_5797":94142},[],"High: enrollments calling the webhook fail",{"_6892":5637,"_42174":5546,"_29767":94144,"_5":21387,"_28235":93875,"_5797":94145},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_6892":5638,"_42174":5546,"_29767":94147,"_5":21387,"_28235":93875,"_5797":93900},[],{"_6892":5639,"_42174":5546,"_29767":94149,"_5":21387,"_28235":93875,"_5797":94150},[],"Releases with per-service identity overrides or mounted key material",{"_6892":5640,"_42174":5546,"_29767":94152,"_5":21387,"_28235":93875,"_5797":94153},[],"Medium: services cannot read their files",{"_6892":5641,"_42174":5546,"_29767":94155,"_5":21387,"_28235":93875,"_5797":94156},[],"Remove the overrides and fix volume ownership",{"_6892":5642,"_42174":5546,"_29767":94158,"_5":21387,"_28235":93875,"_5797":93904},[],{"_6892":5643,"_42174":5546,"_29767":94160,"_5":21387,"_28235":93875,"_5797":94161},[],"Releases that set `amqp.tls`",{"_6892":5644,"_42174":5546,"_29767":94163,"_5":21387,"_28235":93875,"_5797":94164},[],"Medium: clients connect to the wrong port",{"_6892":5645,"_42174":5546,"_29767":94166,"_5":21387,"_28235":93875,"_5797":94167},[],"Point `amqp.port` at the TLS listener, or disable TLS",{"_6892":5646,"_42174":5546,"_29767":94169,"_5":21387,"_28235":93875,"_5797":93924},[],{"_6892":5647,"_42174":5546,"_29767":94171,"_5":21387,"_28235":93875,"_5797":94172},[],"Installations whose CA keys predate the KMS",{"_6892":5648,"_42174":5546,"_29767":94174,"_5":21387,"_28235":93875,"_5797":94175},[],"Medium: CA keys stay unmanaged",{"_6892":5649,"_42174":5546,"_29767":94177,"_5":21387,"_28235":93875,"_5797":94178},[],"Run the CA-to-KMS migration",{"_6892":5650,"_42174":5546,"_29767":94180,"_5":21387,"_28235":93875,"_5797":94181},[],"Receiver certificate verification",{"_6892":5651,"_42174":5546,"_29767":94183,"_5":21387,"_28235":93875,"_5797":94184},[],"DMSs whose webhook had `validate_server_cert: false`",{"_6892":5652,"_42174":5546,"_29767":94186,"_5":21387,"_28235":93875,"_5797":94187},[],"Medium: credentials go to an unverified receiver",{"_6892":5653,"_42174":5546,"_29767":94189,"_5":21387,"_28235":93875,"_5797":94190},[],"Set `insecure_skip_verify` to `false`",{"_6892":5654,"_42174":5546,"_29767":94192,"_5":21387,"_28235":93875,"_5797":93936},[],{"_6892":5655,"_42174":5546,"_29767":94194,"_5":21387,"_28235":93875,"_5797":94195},[],"Scripts and consoles that edit DMSs through the API",{"_6892":5656,"_42174":5546,"_29767":94197,"_5":21387,"_28235":93875,"_5797":94198},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_6892":5657,"_42174":5546,"_29767":94200,"_5":21387,"_28235":93875,"_5797":94201},[],"Read the DMS before editing and use the new field",{"_6892":5658,"_42174":5546,"_29767":94203,"_5":21387,"_28235":93875,"_5797":93952},[],{"_6892":5659,"_42174":5546,"_29767":94205,"_5":21387,"_28235":93875,"_5797":94206},[],"Consumers that read the device `events` field",{"_6892":5660,"_42174":5546,"_29767":94208,"_5":21387,"_28235":93875,"_5797":94209},[],"Medium: the field disappears",{"_6892":5661,"_42174":5546,"_29767":94211,"_5":21387,"_28235":93875,"_5797":94212},[],"Use the new event endpoints",{"_6892":5662,"_42174":5546,"_29767":94214,"_5":21387,"_28235":93875,"_5797":93908},[],{"_6892":5663,"_42174":5546,"_29767":94216,"_5":21387,"_28235":93875,"_5797":94217},[],"Releases that override `toolbox`, `services.connectors`, ports, probes or scheduling",{"_6892":5664,"_42174":5546,"_29767":94219,"_5":21387,"_28235":93875,"_5797":94220},[],"Low to medium: validation errors or changed defaults",{"_6892":5665,"_42174":5546,"_29767":94222,"_5":21387,"_28235":93875,"_5797":94223},[],"Update the values file",{"_6892":5666,"_42174":5546,"_29767":94225,"_5":21387,"_28235":93875,"_5797":93944},[],{"_6892":5667,"_42174":5546,"_29767":94227,"_5":21387,"_28235":93875,"_5797":94228},[],"Clients that send the DMS ID in the update body",{"_6892":5668,"_42174":5546,"_29767":94230,"_5":21387,"_28235":93875,"_5797":94231},[],"Low: the ID in the URL wins",{"_6892":5669,"_42174":5546,"_29767":94233,"_5":21387,"_28235":93875,"_5797":94234},[],"Send the ID in the URL",{"_6892":5670,"_42174":5546,"_29767":94236,"_5":21387,"_28235":93875,"_5797":93948},[],{"_6892":5671,"_42174":5546,"_29767":94238,"_5":21387,"_28235":93875,"_5797":94239},[],"Consumers that match on certificate `type`",{"_6892":5672,"_42174":5546,"_29767":94241,"_5":21387,"_28235":93875,"_5797":94242},[],"Low: two values are renamed",{"_6892":5673,"_42174":5546,"_29767":94244,"_5":21387,"_28235":93875,"_5797":94245},[],"Adapt consumers",{"_6892":5674,"_42174":5546,"_29767":94247,"_5":21387,"_28235":93875,"_5797":93940},[],{"_6892":5675,"_42174":5546,"_29767":94249,"_5":21387,"_28235":93875,"_5797":94250},[],"Any DMS",{"_6892":5676,"_42174":5546,"_29767":94252,"_5":21387,"_28235":93875,"_5797":94253},[],"Low: informational",{"_6892":5677,"_42174":5546,"_29767":94255,"_5":21387,"_28235":93875,"_5797":94256},[],"Read both blocks before editing",{"_6892":5678,"_42174":5546,"_29767":94258,"_5":21387,"_28235":93883,"_5797":94259},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_6892":5679,"_42174":5546,"_29767":94261,"_5":21387,"_28235":93883,"_5797":94262},[],"Step 4 of the migration guide copies the data.",{"_6892":5680,"_42174":5546,"_29767":94264,"_5":21387,"_28235":93887,"_5797":94265},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_6892":5681,"_42174":5546,"_29767":94267,"_5":21387,"_28235":93891,"_5797":94268},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_6892":5682,"_42174":5546,"_29767":94270,"_5":21387,"_28235":93895,"_5797":94271},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_6892":5683,"_42174":5546,"_29767":94273,"_5":21387,"_28235":93899,"_5797":94274},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_6892":5684,"_42174":5546,"_29767":94276,"_5":21387,"_28235":93899,"_5797":94277},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_6892":5685,"_42174":5546,"_29767":94279,"_5":21387,"_28235":93903,"_5797":94280},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_6892":5686,"_42174":5546,"_29767":94282,"_5":21387,"_28235":93907,"_5797":94283},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_6892":5687,"_42174":5546,"_29767":94285,"_5":21387,"_28235":93907,"_5797":94286},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_6892":5688,"_42174":5546,"_29767":94288,"_5":21387,"_28235":93907,"_5797":94289},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_6892":5689,"_42174":5546,"_29767":94291,"_5":21387,"_28235":93907,"_5797":94292},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_6892":5690,"_42174":5546,"_29767":94294,"_5":21387,"_28235":93907,"_5797":94295},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_6892":5691,"_42174":5546,"_29767":94297,"_5":21387,"_28235":93907,"_5797":94298},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_6892":5692,"_42174":5546,"_29767":94300,"_5":21387,"_28235":93915,"_5797":94301},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_6892":5693,"_42174":5546,"_29767":94303,"_5":21387,"_28235":93915,"_5797":94304},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_6892":5694,"_42174":5546,"_29767":94306,"_5":21387,"_28235":93915,"_5797":94307},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_6892":5695,"_42174":5546,"_29767":94309,"_5":21387,"_28235":93915,"_5797":94310},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_6892":5696,"_42174":5546,"_29767":94312,"_5":21387,"_28235":93915,"_5797":94313},[],"The same KMS migration deletes, with a `NOTICE`, aliases that equal an existing key ID, because identifiers now resolve as a key ID before an alias. Affected aliases are dropped, not redirected.",{"_6892":5697,"_42174":5546,"_29767":94315,"_5":21387,"_28235":93919,"_5797":94316},[],"The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_6892":5698,"_42174":5546,"_29767":94318,"_5":21387,"_28235":93923,"_5797":94319},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_6892":5699,"_42174":5546,"_29767":94321,"_5":21387,"_28235":93923,"_5797":94322},[],"The `key_id` is the certificate's `subject_key_id` (SHA-256 of the public key).",{"_6892":5700,"_42174":5546,"_29767":94324,"_5":21387,"_28235":93923,"_5797":94325},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_6892":5701,"_42174":5546,"_29767":94327,"_5":21387,"_28235":93923,"_5797":94328},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_6892":5702,"_42174":5546,"_29767":94330,"_5":21387,"_28235":93923,"_5797":94331},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_6892":5703,"_42174":5546,"_29767":94333,"_5":21387,"_28235":93923,"_5797":94334},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_6892":5704,"_42174":5546,"_29767":94336,"_5":21387,"_28235":93931,"_5797":94337},[],"Stored webhook configs are rewritten to the current layout and their fields renamed:",{"_6892":5705,"_42174":5546,"_29767":94339,"_5":21387,"_28235":93931,"_5797":94340},[],"Field in 3.8.0",{"_6892":5706,"_42174":5546,"_29767":94342,"_5":21387,"_28235":93931,"_5797":94343},[],"Field in 4.0.0",{"_6892":5707,"_42174":5546,"_29767":94345,"_5":21387,"_28235":93931,"_5797":94346},[],"`validate_server_cert`",{"_6892":5708,"_42174":5546,"_29767":94348,"_5":21387,"_28235":93931,"_5797":94349},[],"`insecure_skip_verify` (value negated)",{"_6892":5709,"_42174":5546,"_29767":94351,"_5":21387,"_28235":93931,"_5797":94352},[],"`oidc`",{"_6892":5710,"_42174":5546,"_29767":94354,"_5":21387,"_28235":93931,"_5797":94355},[],"`jwt_options`",{"_6892":5711,"_42174":5546,"_29767":94357,"_5":21387,"_28235":93931,"_5797":94358},[],"`apikey`",{"_6892":5712,"_42174":5546,"_29767":94360,"_5":21387,"_28235":93931,"_5797":94361},[],"`apikey_options`",{"_6892":5713,"_42174":5546,"_29767":94363,"_5":21387,"_28235":93931,"_5797":94364},[],"`mtls`",{"_6892":5714,"_42174":5546,"_29767":94366,"_5":21387,"_28235":93931,"_5797":94367},[],"`mtls_options`",{"_6892":5715,"_42174":5546,"_29767":94369,"_5":21387,"_28235":93931,"_5797":94370},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. Two cases do need it.",{"_6892":5716,"_42174":5546,"_29767":94372,"_5":21387,"_28235":93931,"_5797":94373},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_6892":5717,"_42174":5546,"_29767":94375,"_5":21387,"_28235":93931,"_5797":94376},[],"**Receiver certificate verification.** A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_6892":5718,"_42174":5546,"_29767":94378,"_5":21387,"_28235":93935,"_5797":94379},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_6892":5719,"_42174":5546,"_29767":94381,"_5":21387,"_28235":93935,"_5797":94382},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_6892":5720,"_42174":5546,"_29767":94384,"_5":21387,"_28235":93935,"_5797":94385},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_6892":5721,"_42174":5546,"_29767":94387,"_5":21387,"_28235":93939,"_5797":94388},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but read both blocks before editing a DMS so that you do not modify one while believing you are editing the other. The console exposes independent editors for both blocks; the DMS guide describes their fields, and you can also edit them through the DMS API.",{"_6892":5722,"_42174":5546,"_29767":94390,"_5":21387,"_28235":93943,"_5797":94391},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_6892":5723,"_42174":5546,"_29767":94393,"_5":21387,"_28235":93947,"_5797":94394},[],"Stored certificate type values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Adapt consumers that read or match on those values.",{"_6892":5724,"_42174":5546,"_29767":94396,"_5":21387,"_28235":93951,"_5797":94397},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_6892":5725,"_42174":5546,"_29767":94399,"_5":21387,"_28235":93951,"_5797":94400},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_6892":5726,"_42174":5546,"_29767":94402,"_5":21387,"_28235":93951,"_5797":94403},[],"`POST /v1/devices/:id/events` creates an event.",{"_6892":5727,"_42174":5546,"_29767":94405,"_5":21387,"_28235":93951,"_5797":94406},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Each Device Manager instance binds a durable AMQP queue named after its service ID, `device-manager-sse-<uuid>`. Queues from crashed or replaced instances linger until removed, so configure an expiration or cleanup policy on the broker.",{"_6892":5728,"_42174":5546,"_29767":94408,"_5":21387,"_28235":93955,"_5797":94409},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_6892":5729,"_42174":5546,"_29767":94411,"_5":21387,"_28235":93959,"_5797":94412},[],"Take a verifiable backup of PostgreSQL and schedule downtime. The upgrade moves every service's data into `pki`.",{"_6892":5730,"_42174":5546,"_29767":94414,"_5":21387,"_28235":93959,"_5797":94415},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_6892":5731,"_42174":5546,"_29767":94417,"_5":21387,"_28235":93959,"_5797":94418},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_6892":5732,"_42174":5546,"_29767":94420,"_5":21387,"_28235":93959,"_5797":94421},[],"Record the names of your local-storage PVCs:",{"_6892":5733,"_42174":5546,"_29767":94423,"_5":21387,"_28235":93959,"_5797":94424},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_6892":5734,"_42174":5546,"_29767":94426,"_5":21387,"_28235":93963,"_5797":94427},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_6892":5735,"_42174":5546,"_29767":94429,"_5":21387,"_28235":93963,"_5797":94430},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_6892":5736,"_42174":5546,"_29767":94432,"_5":21387,"_28235":93963,"_5797":94433},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is read; the connection always uses the global `postgres.hostname`, `postgres.port`, `postgres.username` and `postgres.password` values.",{"_6892":5737,"_42174":5546,"_29767":94435,"_5":21387,"_28235":93963,"_5797":94436},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_6892":5738,"_42174":5546,"_29767":94438,"_5":21387,"_28235":93963,"_5797":94439},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_6892":5739,"_42174":5546,"_29767":94441,"_5":21387,"_28235":93963,"_5797":94442},[],"**Rename `toolbox` to `connectivityTest`:**",{"_6892":5740,"_42174":5546,"_29767":94444,"_5":21387,"_28235":93963,"_5797":94445},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_6892":5741,"_42174":5546,"_29767":94447,"_5":21387,"_28235":93963,"_5797":94448},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_6892":5742,"_42174":5546,"_29767":94450,"_5":21387,"_28235":93963,"_5797":94451},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_6892":5743,"_42174":5546,"_29767":94453,"_5":21387,"_28235":93963,"_5797":94454},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_6892":5744,"_42174":5546,"_29767":94456,"_5":21387,"_28235":93963,"_5797":94457},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_6892":5745,"_42174":5546,"_29767":94459,"_5":21387,"_28235":93963,"_5797":94460},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown.",{"_6892":5746,"_42174":5546,"_29767":94462,"_5":21387,"_28235":93967,"_5797":94463},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_6892":5747,"_42174":5546,"_29767":94465,"_5":21387,"_28235":93967,"_5797":94466},[],"If the deployment uses local KMS or VA storage, those pods fail until you complete step 4, so `--wait` cannot succeed: Helm waits for them to become ready, times out, exits with an error and marks the release `failed`. The hooks have already run by then, and every manifest, including the new StatefulSets and their PVCs, has been applied. Helm does not roll anything back without `--atomic`. Continue with step 4, then re-run the same `helm upgrade` command so it completes and Helm records the release as `deployed`. Both hooks are idempotent, so they are safe to run again.",{"_6892":5748,"_42174":5546,"_29767":94468,"_5":21387,"_28235":93971,"_5797":94469},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_6892":5749,"_42174":5546,"_29767":94471,"_5":21387,"_28235":93971,"_5797":94472},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_6892":5750,"_42174":5546,"_29767":94474,"_5":21387,"_28235":93971,"_5797":94475},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If `claims_ok` prints `ABORT`, the block stops before listing the claims: either a StatefulSet lookup failed, or a new claim resolves to the 3.8.0 claim. In the second case the copy would verify against itself and the final cleanup would delete the live volume. The chart always appends `-kms` and `-va` to the release-scoped name, so a collision means the claims are not what this guide expects; investigate before going on. Item 3 runs the same check and refuses to create the helper pod, so nothing touches the volumes. The check returns instead of calling `exit`, which would close your shell and lose the variables set so far. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_6892":5751,"_42174":5546,"_29767":94477,"_5":21387,"_28235":93971,"_5797":94478},[],"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:",{"_6892":5752,"_42174":5546,"_29767":94480,"_5":21387,"_28235":93971,"_5797":94481},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_6892":5753,"_42174":5546,"_29767":94483,"_5":21387,"_28235":93971,"_5797":94484},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_6892":5754,"_42174":5546,"_29767":94486,"_5":21387,"_28235":93971,"_5797":94487},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_6892":5755,"_42174":5546,"_29767":94489,"_5":21387,"_28235":93971,"_5797":94490},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_6892":5756,"_42174":5546,"_29767":94492,"_5":21387,"_28235":93971,"_5797":94493},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_6892":5757,"_42174":5546,"_29767":94495,"_5":21387,"_28235":93971,"_5797":94496},[],"**Remove the helper and restore the recorded replica counts:**",{"_6892":5758,"_42174":5546,"_29767":94498,"_5":21387,"_28235":93971,"_5797":94499},[],"**Re-run the step 3 `helm upgrade` command.** The KMS and VA pods now start against the copied data, so `--wait` succeeds and the release moves from `failed` to `deployed`.",{"_6892":5759,"_42174":5546,"_29767":94501,"_5":21387,"_28235":93975,"_5797":94502},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_6892":5760,"_42174":5546,"_29767":94504,"_5":21387,"_28235":93975,"_5797":94505},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_6892":5761,"_42174":5546,"_29767":94507,"_5":21387,"_28235":93979,"_5797":94508},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_6892":5762,"_42174":5546,"_29767":94510,"_5":21387,"_28235":93979,"_5797":94511},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_6892":5763,"_42174":5546,"_29767":94513,"_5":21387,"_28235":93979,"_5797":94514},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_6892":5764,"_42174":5546,"_29767":94516,"_5":21387,"_28235":93979,"_5797":94517},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository.",{"_6892":5765,"_42174":5546,"_29767":94519,"_5":21387,"_28235":93979,"_5797":94520},[],"The `goose-lamassu` README still shows per-database examples (`dbname=ca`, `dbname=kms`) and claims the tool validates the database name, and the `ca-to-kms-migration` README still describes the pre-4.0.0 two-database layout. Follow the `dbname=pki` form on this page instead of their examples.",{"_6892":5766,"_42174":5546,"_29767":94522,"_5":21387,"_28235":93983,"_5797":94523},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_6892":5767,"_42174":5546,"_29767":94525,"_5":21387,"_28235":93983,"_5797":94526},[],"**`helm upgrade --wait` times out and `helm status` reports the release as `failed`.** With local KMS or VA storage this is expected on the first run: the new pods cannot become ready before their data is copied. The hooks ran and the manifests and PVCs were applied, so complete step 4 and re-run the same `helm upgrade` command. If other pods are also not ready, check their logs, because something else is wrong.",{"_6892":5768,"_42174":5546,"_29767":94528,"_5":21387,"_28235":93983,"_5797":94529},[],"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait.",{"_6892":5769,"_42174":5546,"_29767":94531,"_5":21387,"_28235":93983,"_5797":94532},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_6892":5770,"_42174":5546,"_29767":94534,"_5":21387,"_28235":93983,"_5797":94535},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted on duplicate CA IDs or missing `engine_id` values. Check the job logs, fix the privileges or the data, and re-run the upgrade.",{"_6892":5771,"_42174":5546,"_29767":94537,"_5":21387,"_28235":93983,"_5797":94538},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_6892":5772,"_42174":5546,"_29767":94540,"_5":21387,"_28235":93983,"_5797":94541},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_6892":5773,"_42174":5546,"_29767":94543,"_5":21387,"_28235":93986,"_5797":94544},[],"After the upgrade, check in this order:",{"_6892":5774,"_42174":5546,"_29767":94546,"_5":21387,"_28235":93986,"_5797":94547},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations.",{"_6892":5775,"_42174":5546,"_29767":94549,"_5":21387,"_28235":93986,"_5797":94550},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_6892":5776,"_42174":5546,"_29767":94552,"_5":21387,"_28235":93986,"_5797":94553},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_6892":5777,"_42174":5546,"_29767":94555,"_5":21387,"_28235":93986,"_5797":94556},[],"**Existing CRLs are served.** `GET /crl/<ca-ski>` on VA returns a previously issued CRL, and new CRLs are issued.",{"_6892":5778,"_42174":5546,"_29767":94558,"_5":21387,"_28235":93986,"_5797":94559},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS.",{"_6892":5779,"_42174":5546,"_29767":94561,"_5":21387,"_28235":93986,"_5797":94562},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_6892":5780,"_42174":5546,"_29767":94564,"_5":21387,"_28235":93986,"_5797":94565},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_6892":5781,"_42174":5546,"_29767":94567,"_5":21387,"_28235":93986,"_5797":94568},[],"**AMQP.** The backend connects to the broker with the expected TLS settings, and the cleanup policy for SSE queues is in place.",{"_6892":5782,"_42174":5546,"_29767":94570,"_5":21387,"_28235":93986,"_5797":94571},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_6892":5783,"_42174":5546,"_29767":94573,"_5":21387,"_28235":93986,"_5797":94574},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_6892":5784,"_42174":5546,"_29767":94576,"_5":21387,"_28235":93986,"_5797":94577},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_6892":5785,"_42174":5546,"_29767":94579,"_5":21387,"_28235":93986,"_5797":94580},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_6892":5786,"_42174":5546,"_29767":94582,"_5":21387,"_28235":93986,"_5797":94583},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_6892":5787,"_42174":5546,"_29767":94585,"_5":21387,"_28235":93986,"_5797":94586},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_6892":5788,"_42174":5546,"_29767":94588,"_5":21387,"_28235":93990,"_5797":94589},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy. These are the fixed 3.8.0 names recorded in step 1; before deleting, confirm that neither is mounted by a running pod, for example with `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, where `Used By` must be `<none>`:",{"_6892":5789,"_42174":5546,"_29767":94591,"_5":21387,"_28235":93990,"_5797":94592},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_6892":5790,"_42174":5546,"_29767":94594,"_5":21387,"_28235":93990,"_5797":94595},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_6892":5791,"_42174":5546,"_29767":94597,"_5":21387,"_28235":93990,"_5797":94598},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_6892":5792,"_42174":5546,"_29767":94600,"_5":21387,"_28235":93990,"_5797":94601},[],"<Card title=\"Configure a DMS\" description=\"Enrollment, re-enrollment and webhook settings.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />","sorting",{"_94604":26064,"_94605":94606,"_94607":94608,"_94609":94610,"_26199":5814,"_117736":5814},"language","sortableProperties",[5797,42174,5,28235],"sortablePropertiesWithTypes",{"_5797":34761,"_42174":34761,"_5":34761,"_28235":34761},"sorts",{"_5797":94611,"_42174":100393,"_5":106174,"_28235":111955},{"_8483":94612,"_94613":94614,"_5":34761},{"_7036":28793,"_7050":24636,"_7056":35587,"_7043":10276,"_16513":12326,"_28242":11085,"_21503":6429,"_13924":6423,"_15089":13414,"_41303":28763,"_41361":8464,"_40752":11874,"_48303":40634,"_40947":17852,"_41421":8419,"_41382":9019,"_48312":6926,"_48315":8079,"_48318":12603,"_41855":6694,"_48323":10483,"_41926":11356,"_41936":5983,"_22115":12773,"_41912":17315,"_41946":9238,"_48331":10566,"_41941":6454,"_40898":36750,"_41956":15476,"_40882":38639,"_42012":5905,"_48338":31520,"_40964":5921